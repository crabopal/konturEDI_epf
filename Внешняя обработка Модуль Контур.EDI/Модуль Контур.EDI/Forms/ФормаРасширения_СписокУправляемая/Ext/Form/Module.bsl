	ЭлементУсловия.ЛевоеЗначение 		= Новый ПолеКомпоновкиДанных("СписокРасширения.Установить");
	ЭлементУсловия.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
	ЭлементУсловия.ПравоеЗначение 		= "установить";
