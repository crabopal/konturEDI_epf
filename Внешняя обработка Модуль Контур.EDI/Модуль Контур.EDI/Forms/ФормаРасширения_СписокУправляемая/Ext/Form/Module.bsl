	НовыйЭлементУО = ЭлементыУсловногоОформления.Добавить();
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", ВариантыШрифтаТекста.АвтоШрифтПолужирныйПодчеркнутый);
	
	ЭлементУсловия 					= НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементУсловия.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("СписокРасширения.Обязательный");	
	ЭлементУсловия.ВидСравнения 	= ВидСравненияКомпоновкиДанных.Равно;
	ЭлементУсловия.ПравоеЗначение 	= Истина;	
	ЭлементУсловия.Использование	= Истина;
		
	ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СписокРасширенияУстановить");
	
	//Установка цвета
	СинийЦвет = Новый Цвет(0, 0, 255);
	ЗеленыйЦвет = Новый Цвет(0, 128, 0);
