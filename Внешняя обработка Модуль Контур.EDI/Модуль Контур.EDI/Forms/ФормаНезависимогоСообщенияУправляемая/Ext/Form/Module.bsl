//{ Настройка автоотправки прайс-листов

&НаКлиенте
Процедура ЗаписатьНастройкиАвтоотправки(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	Если ПроверитьНастройкиАвтоотправки() Тогда
	
		СтруктураНастроек = Новый Структура();
		СтруктураНастроек.Вставить("Наименование", НаименованиеНастройкиАвтоотправки);
		СтруктураНастроек.Вставить("Расписание", РасписаниеНастройкиАвтоотправки);
		СтруктураНастроек.Вставить("ПараметрыПодготовкиСообщения", ПолучитьПараметрыДляАвтоотправкиСообщенияПоРасписанию());
		СтруктураНастроек.Вставить("Партнер", Получатель); 
		
		Закрыть(СтруктураНастроек);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьНастройкиАвтоотправки()
	
	ЕстьОшибки = Не ПроверитьЗаполнениеПолей();
	
	ОшибкиНезаполненныхЗначений = Новый Массив;
	
	Если Не ЗначениеЗаполнено(НаименованиеНастройкиАвтоотправки) Тогда
		ЕстьОшибки = Истина;
		ОшибкиНезаполненныхЗначений.Добавить("- " + ТекстОбязательностиРеквизита("Название настройки"));
	КонецЕсли;
	
	Если РасписаниеНастройкиАвтоотправки = Неопределено Тогда
		ЕстьОшибки = Истина;
		ОшибкиНезаполненныхЗначений.Добавить("- " + ТекстОбязательностиРеквизита("Расписание"));
	КонецЕсли;
	
	Если ОшибкиНезаполненныхЗначений.Количество() > 0 Тогда
		
		ТекстОшибок = "";
		Для каждого Ошибка Из ОшибкиНезаполненныхЗначений Цикл
			ТекстОшибок = ТекстОшибок + Ошибка + Символы.ПС;
		КонецЦикла;
		
		МодульОбъектаКлиент().Предупреждение_КонтурEDI(ТекстОшибок);
		
	КонецЕсли;
	
	Возврат Не ЕстьОшибки;
	
КонецФункции

&НаКлиенте
Процедура РасписаниеНастройкиАвтоотправкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	НастройкаРасписания = РасписаниеНастройкиАвтоотправки;
	
	Если ТипЗнч(НастройкаРасписания) <> Тип("РасписаниеРегламентногоЗадания") Тогда
		НастройкаРасписания = Новый РасписаниеРегламентногоЗадания;
	КонецЕсли;
	
	РедактированиеРасписания = Новый ДиалогРасписанияРегламентногоЗадания(НастройкаРасписания);
	
	Если МодальностьЗапрещена Тогда
		ОбработчикРезультатаРедактирования = Вычислить("Новый ОписаниеОповещения(""ПослеОкончанияРедактированияРасписания"", ЭтаФорма)");
		РедактированиеРасписания.Показать(ОбработчикРезультатаРедактирования);
	ИначеЕсли РедактированиеРасписания.ОткрытьМодально() Тогда
        ПослеОкончанияРедактированияРасписания(РедактированиеРасписания.Расписание);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОкончанияРедактированияРасписания(НастройкаРасписания, ДопПараметры = Неопределено) Экспорт
	
	Если ТипЗнч(НастройкаРасписания) = Тип("РасписаниеРегламентногоЗадания") Тогда 
		РасписаниеНастройкиАвтоотправки = НастройкаРасписания;
		ПредставлениеРасписанияНастройкиАвтоотправки = Строка(НастройкаРасписания);
	КонецЕсли;
	
КонецПроцедуры

