Процедура ОткрытьФайл(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	#Если Не ВебКлиент Тогда
		
		ТекстФайла = ОткрытьФайлВызовСервера();
		
		Если ТекстФайла = Неопределено Тогда
			
			Если ФормаСодержитОшибки Тогда
				ОткрытьПанельОшибокКлиент();
			Иначе
				ЗакрытьПанельОшибокКлиент();
			КонецЕсли;
			
			Возврат;
			
		КонецЕсли;
		
		ТекДок = Новый ТекстовыйДокумент;
		ТекДок.УстановитьТекст(ТекстФайла);
		ИмяВремФайла = ПолучитьИмяВременногоФайла("xml");
		
		ТекДок.Записать(ИмяВремФайла, КодировкаТекста.UTF8);
		          		
		ЗапуститьПриложение(ИмяВремФайла);
				
	#КонецЕсли
		
КонецПроцедуры

&НаСервере
Функция ОткрытьФайлВызовСервера()
	
	ТекстФайла = Неопределено;
	
	ТаблицаОшибок.Очистить();	
	ФормаСодержитОшибки = НЕ ПроверитьЗаполнениеПолей();
	
	ВывестиВОшибкиСостояниеЮЗДО(СтатусыЮЗДО, ТаблицаОшибок, КлассификаторСтатусовДД);
	
	Если НЕ ФормаСодержитОшибки Тогда
		
		ПараметрыСообщения = ПолучитьПараметрыДляПодготовкиСообщения(ТипСообщения);
		ТоварыКопия = РеквизитФормыВЗначение("Товары");
		
		ТекДок = МодульОбъекта().ФайлНезависимогоСообщения(Сообщение, ПараметрыСообщения, ТоварыКопия);
		
		УничтожитьТаблицыЗначенийПроизвольныхРеквизитов();
		
		Если ТекДок <> Неопределено Тогда		
			ТекстФайла = ТекДок.ПолучитьТекст();
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТекстФайла;
	
КонецФункции

