Процедура ОткрытьПанельОшибокКлиент()
	
	Элементы.ГруппаОшибки.Видимость = истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьПанельОшибокКлиент()
	
	Элементы.ГруппаОшибки.Видимость = Ложь;
	
КонецПроцедуры

//кнопки нижней командной панели ----------------------------------------------------------
&НаКлиенте
Процедура ОтправитьСообщение(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	ПроверитьЗаполнениеФормы();
	
	ТабличнаяЧастьЗаполнена = ПроверитьЗаполнениеТабличнойЧасти_КонтурEDI();
	
	Если ФормаСодержитОшибки ИЛИ НЕ ТабличнаяЧастьЗаполнена Тогда
		ОткрытьПанельОшибокКлиент();
		Возврат;
	КонецЕсли;
	
	Если Сообщение.Направление = "Входящее" Тогда
		
		ОбработатьВходящееНезависимоеСообщение_Сервер();
		
	Иначе
		
		ОтправитьСообщениеСервер();
		
	КонецЕсли;
	
	Закрыть();	
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеТабличнойЧасти_КонтурEDI()
	
	Успешно = Истина;
	
	Если Товары.Количество() = 0 Тогда 
		
		МодульОбъектаКлиент().Предупреждение_КонтурEDI("Заполните табличную часть ""Товары""");	
		Успешно = Ложь;
		
	КонецЕсли;
	
	Возврат Успешно;
	
КонецФункции

&НаКлиенте
Процедура Сохранить(Команда)
	
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();	
	СохранитьСообщениеСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСообщение(Команда)
	
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	МодульОбъектаКлиент().ОткрытьФормуПроверкиПароляУчетнойЗаписи(Неопределено, Истина, "ОбработчикПроверкиПароляДляУдаленияСообщения", ЭтаФорма); 
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьВходящееНезависимоеСообщение_Сервер()
	
	ВосстановитьТаблицыЗначенийПроизвольныхРеквизитовИзХранилища();	
	
	ПеренестиПоля1СвСообщение(Сообщение);
	
	МодульОбъекта().ОбработатьВходящееНезависимоеСообщение(Сообщение);
	
	ПоместитьТаблицыЗначенийПроизвольныхРеквизитовВХранилище();
	УничтожитьТаблицыЗначенийПроизвольныхРеквизитов();
	
КонецПроцедуры 

&НаСервере
Процедура ОтправитьСообщениеСервер()
	
	ТоварыКопия = РеквизитФормыВЗначение("Товары");
	СтруктураПараметры = ПолучитьПараметрыДляПодготовкиСообщения(ТипСообщения);
	МодульОбъекта().ОтправитьНезависимоеСообщение(ТипСообщения, ТоварыКопия, СтруктураПараметры);
	
КонецПроцедуры // Отправить()

&НаСервере
Процедура СохранитьСообщениеСервер()
	
	ТоварыКопия = РеквизитФормыВЗначение("Товары");
	
	СтруктураПараметры = ПолучитьПараметрыДляПодготовкиСообщения(ТипСообщения);
	СтруктураПараметры.Вставить("ПроверитьСообщение", Истина);
	
	СообщениеСтруктура = МодульОбъекта().ПодготовитьИсходящееНезависимоеСообщение(ТипСообщения, ТоварыКопия, СтруктураПараметры);
	
	РезультатСохранения = МодульОбъекта().КнопкаФормыСообщенияНажатие("Сохранить", СообщениеСтруктура);
	
	Если РезультатСохранения.СообщениеСохранено = Истина Тогда
		СообщениеСсылка = СообщениеСтруктура.СообщениеСсылка;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыДляАвтоотправкиСообщенияПоРасписанию()
	
	Возврат ПолучитьПараметрыДляПодготовкиСообщения(ТипСообщения);
	
КонецФункции

&НаКлиенте
Процедура ОбработчикПроверкиПароляДляУдаленияСообщения(РезультатПроверкиПароля,ДополнительныеПараметры = Неопределено) Экспорт
	
	Если РезультатПроверкиПароля = Истина Тогда
		
		ТекстВопроса = "Текущее сообщение будет навсегда удалено из 1С. Продолжить?";
		
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить("Да, удалить сообщение");
		СписокКнопок.Добавить("Нет, не удалять");
		
		ИмяОбработчика = "ОбработчикСогласияУдаленияСообщения";
		
		МодульОбъектаКлиент().ПоказатьВопрос_КонтурEDI(ИмяОбработчика, ЭтаФорма, Неопределено, ТекстВопроса, СписокКнопок);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикСогласияУдаленияСообщения(РезультатВопроса,ДополнительныеПараметры = Неопределено) Экспорт

	Если РезультатВопроса = "Да, удалить сообщение" Тогда
		
		УдалитьСообщениеВызовСервера();
		Закрыть(Неопределено);
		
	КонецЕсли;

КонецПроцедуры // ОбработчикСогласияУдаленияСообщения()

&НаСервере
Процедура УдалитьСообщениеВызовСервера()
	
	МодульОбъекта().УдалитьСообщение(Сообщение);

КонецПроцедуры // УдалитьСообщениеВызовСервера()


//кнопки верхней командной панели ---------------------------------------------------------

&НаКлиенте
Процедура ДобавитьЭлемент(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	Если ПустаяСтрока(ПредставлениеПолучателя) Тогда
		МодульОбъектаКлиент().Предупреждение_КонтурEDI(ТекстОбязательностиРеквизита("Партнер"));
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТипЦен) Тогда
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("Признак", "ОдинИлиГруппаТоваров");
		ДопПараметры.Вставить("Команда", Команда);
		ЗадатьВопросПроЗаполнениеТипаЦен(ДопПараметры);
	Иначе
		ВыбратьТовары(Команда.Имя);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадатьВопросПроЗаполнениеТипаЦен(ДопПараметры = Неопределено)
	
	ЗаголовокДиалога	= "Контур.EDI. Заполнение типа цен";
	ТекстВопроса		= "Не выбран тип цен. Заполнить товар(ы) без цен?";
	ОбработчикВопроса 	= "ОбработчикСогласияЗаполненияТоваровБезЦен";
	
	КнопкиВопроса = Новый СписокЗначений;
	КнопкиВопроса.Добавить("Да, заполнить без цен");
	КнопкиВопроса.Добавить("Выбрать тип цен");
	КнопкиВопроса.Добавить("Отмена");

	
	КнопкаПоУмолчанию = "Да, заполнить без цен";
			
	МодульОбъектаКлиент().ПоказатьВопрос_КонтурEDI(ОбработчикВопроса, 
												   ЭтаФорма, 
												   ДопПараметры, 
												   ТекстВопроса, 
												   КнопкиВопроса,
												   ,
												   КнопкаПоУмолчанию, 
												   ЗаголовокДиалога);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьОдинИлиГруппуТоваров(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	ВыбратьТовары(Команда.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьТовары(ЭлементИлиГруппа)
	
	ВыбратьГруппу = (ЭлементИлиГруппа = "ДобавитьГруппу");
	
	ПараметрыФормыВыбораНоменклатуры = Новый Структура;
	
	Если ВыбратьГруппу Тогда 
		ПараметрыФормыВыбораНоменклатуры.Вставить("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Группы);
	иначе //элемент
		ПараметрыФормыВыбораНоменклатуры.Вставить("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Элементы);
		ПараметрыФормыВыбораНоменклатуры.Вставить("РежимВыбора",Истина);
	КонецЕсли;
	
	ИмяФормыВыбора=?(ВыбратьГруппу,"Справочник.Номенклатура.ФормаВыбораГруппы","Справочник.Номенклатура.ФормаВыбора");
	
	МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI(ИмяФормыВыбора, "", ПараметрыФормыВыбораНоменклатуры, ЭтаФорма, "ОбработчикПодбораНоменклатуры", ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВидИлиГруппуВидаНоменклатуры(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	ВыбратьВидНоменклатуры(Команда.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВидНоменклатуры(ВидИлиГруппаВида)
	
	ВыбратьГруппу = (ВидИлиГруппаВида = "ДобавитьНоменклатуруПоГруппеВида");
	
	ПараметрыФормыВыбораВидаНоменклатуры = Новый Структура;
	
	Если ВыбратьГруппу Тогда 
		ПараметрыФормыВыбораВидаНоменклатуры.Вставить("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Группы);
	иначе //элемент
		ПараметрыФормыВыбораВидаНоменклатуры.Вставить("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Элементы);
		ПараметрыФормыВыбораВидаНоменклатуры.Вставить("РежимВыбора",Истина);
	КонецЕсли;
	
	ИмяФормыВыбора = ?(ВыбратьГруппу,"Справочник.ВидыНоменклатуры.ФормаВыбораГруппы", "Справочник.ВидыНоменклатуры.ФормаВыбора");
	
	МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI(ИмяФормыВыбора, "", ПараметрыФормыВыбораВидаНоменклатуры, ЭтаФорма, "ОбработчикПодбораВидаНоменклатуры", ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикПодбораВидаНоменклатуры(ВыбранныйВид, ДопПараметр = Неопределено) Экспорт
	
	Если ВыбранныйВид <> Неопределено Тогда
		
		СтруктураДопПараметры = ИнициализироватьПараметрыЗаполненияТоваров();
		СтруктураДопПараметры.ВидНоменклатуры = ВыбранныйВид;
		СтруктураДопПараметры.ДобавлениеНоменклатуры = Истина;
		
		ЗаполнитьТоварыКлиент(ТипСообщения, СтруктураДопПараметры);
		
	КонецЕсли;

КонецПроцедуры // ОбработчикПодбораНоменклатуры()

&НаКлиенте
Процедура ОбработчикПодбораНоменклатуры(ВыбранаяНоменклатура, ДопПараметр = Неопределено) Экспорт
	
	//один и тот же на элемент и группу
	Если ВыбранаяНоменклатура <> Неопределено Тогда
		
		СтруктураДопПараметры = ИнициализироватьПараметрыЗаполненияТоваров();
		СтруктураДопПараметры.Номенклатура = ВыбранаяНоменклатура;
		СтруктураДопПараметры.ДобавлениеНоменклатуры = Истина;
		
		ЗаполнитьТоварыКлиент(ТипСообщения, СтруктураДопПараметры);
		
	КонецЕсли;

КонецПроцедуры // ОбработчикПодбораНоменклатуры()

&НаКлиенте
Процедура ОбработчикВыбораТипаЦен(Значение, ДопПараметрПереданныйВОбработчик = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(Значение) Тогда 
		ТипЦен = Значение;
		ТипЦенОбработкаВыбораСервер(Значение);
		Если ДопПараметрПереданныйВОбработчик.Признак = "ОдинИлиГруппаТоваров" Тогда
			ВыбратьТовары(ДопПараметрПереданныйВОбработчик.Команда.Имя);
		ИначеЕсли ДопПараметрПереданныйВОбработчик.Признак = "ВсеТовары" Тогда
			ЗаполнитьТоварыКлиент(ТипСообщения);
		КонецЕсли;
	Иначе
		//Пользователь не выбрал элемент справочника
		НоваяСтрока = ТаблицаОшибок.Добавить();
		НоваяСтрока.ТекстОшибки = "Для заполнения цены товара(ов) необходимо выбрать тип цен";
		ОткрытьПанельОшибокКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикСогласияПерезаполненияТЧ(РезультатВопроса,ДопПараметрПереданныйВОбработчик=Неопределено) Экспорт
	
	Если РезультатВопроса = "Да, перезаполнить" Тогда 
		ОбработчикСогласияЗаполнения();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикСогласияЗаполнения(ТолькоОбновить = Ложь)
	
	ДопПараметры = ИнициализироватьПараметрыЗаполненияТоваров();
	ДопПараметры.Вставить("ТолькоОбновить", ТолькоОбновить);
	
	Если Не ЗначениеЗаполнено(ТипЦен) Тогда
		ДопПараметры.Вставить("Признак", "ВсеТовары");
		ЗадатьВопросПроЗаполнениеТипаЦен(ДопПараметры);
	Иначе
		ЗаполнитьТоварыКлиент(ТипСообщения, ДопПараметры);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикСогласияЗаполненияТоваровБезЦен(РезультатВопроса, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если РезультатВопроса = "Выбрать тип цен" Тогда
		
		ИмяСправочникаТипыЦен = ПолучитьИмяСправочникаТипыЦен();
		Если Не ЗначениеЗаполнено(ИмяСправочникаТипыЦен) Тогда
			//Не смогли определить тип справочника
			НоваяСтрока = ТаблицаОшибок.Добавить();
			НоваяСтрока.ТекстОшибки = "Для заполнения цены товара(ов) необходимо выбрать тип цен."
										+ Символы.ПС + "Не определено имя справочника ""Типы цен"" в таблице типов";
			ОткрытьПанельОшибокКлиент();
		Иначе	
			ИмяФормыВыбора = "Справочник." + ИмяСправочникаТипыЦен + ".ФормаВыбора";
			
			МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI(ИмяФормыВыбора, "", , ЭтаФорма, "ОбработчикВыбораТипаЦен", ЭтаФорма, ДополнительныеПараметры);
			
		КонецЕсли;
		
	ИначеЕсли РезультатВопроса = "Да, заполнить без цен" Тогда
		
		Если ДополнительныеПараметры.Признак = "ОдинИлиГруппаТоваров" Тогда
			ВыбратьТовары(ДополнительныеПараметры.Команда.Имя);
		ИначеЕсли ДополнительныеПараметры.Признак = "ВсеТовары" Тогда
			ЗаполнитьТоварыКлиент(ТипСообщения);
		КонецЕсли;
		
	ИначеЕсли РезультатВопроса = "Отмена" Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТаблицуТовары(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	Если Товары.Количество() <> 0 Тогда
	
		ТекстВопроса = "Данные таблицы товаров будут очищены. Продолжить?";
		
		КнопкиВопроса = Новый СписокЗначений;
		КнопкиВопроса.Добавить("Да, очистить");
		КнопкиВопроса.Добавить("Нет, НЕ очищать");
		
		МодульОбъектаКлиент().ПоказатьВопрос_КонтурEDI("ОбработчикОчиститьТЧ", ЭтаФорма,, ТекстВопроса, КнопкиВопроса);
		
	Иначе
		//нечего очищать
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикОчиститьТЧ(РезультатВопроса, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если РезультатВопроса = "Да, очистить" Тогда 
		
		Товары.Очистить();
		
		Обновить_ИнформациюОбОшибках();
				
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КакиеТоварыНеПопадутВТаблицуКнопка(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	ЗаголовокПодсказки = "Какие товары не попадут в таблицу?";
	
	ТекстПодсказки = "При стандартном заполнении не будут добавлены товары:
					|
					| - которые помечены на удаление;
					| - с нулевой ценой для выбранного типа цен;
					| - которые по виду номенклатуры относятся к услугам.
					|
					|Для разработки своего алгоритма заполнения товаров можно
					|воспользоваться событием ""ПолучитьТоварыДляНезависимогоСообщения"" 
					|подключаемого модуля или расширения.";
					
	МодульОбъектаКлиент().Предупреждение_КонтурEDI(ТекстПодсказки,,ЗаголовокПодсказки);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокЮрФизЛицПартнера(Получатель)
		
	СписокЮрФизЛицПартнера = Новый СписокЗначений;
	
	ДанныеПартнера = МодульОбъекта().ТаблицаКэшПартнеровКонтрагентов.НайтиСтроки(Новый Структура("Партнер", Получатель));
	Для Каждого Элемент Из ДанныеПартнера Цикл
		
		Если ЗначениеЗаполнено(Элемент.Контрагент) Тогда
			
			СписокЮрФизЛицПартнера.Добавить(Элемент.Контрагент);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СписокЮрФизЛицПартнера;
	
КонецФункции

&НаКлиенте
Процедура ПредставлениеПолучателяНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Сообщение.Направление = "Исходящее" Тогда
		
		Состояние("Открытие формы выбора партнеров");
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ОткрытаКакВыбор", Истина);
		
		МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI("Партнеры_СписокУправляемая", , ПараметрыФормы, ЭтаФорма, "ОбработчикВыбораПартнера", ЭтаФорма);
		
		СтандартнаяОбработка = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВыбораПартнера(Значение, ДопПараметр = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(Значение) Тогда 
		
		Состояние("Обработка выбора партнера");
		Получатель = Значение;
		
		ОбработчикВыбораПартнераСервер();
		
		Обновить_ИнформациюОбОшибках();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработчикВыбораПартнераСервер()
	
	ПредставлениеПолучателя = МодульОбъекта().ПолучитьПредставлениеЭлементаСправочника(Получатель);
	ЗаполнитьСписокЮрФизЛицПартнера(Получатель);
	ВыбратьЮрФизЛицоПартнераПоУмолчанию(СторонаЮрФизЛицаПартнера);
	ПриИзмененииПолучателя();
	ВосстановитьНастройкиЗаполнения();
	
	Сообщение.Партнер = Получатель;
		
	// ... особенности
	ЗаполнитьОсобенностиСообщенияНаФорме_ОсновнойМодуль();
	МодульОбъекта().ДобавитьУсловноеОформлениеОсобенностейСообщения(ЭтаФорма);
	НужноКонвертироватьОсобенностиВСообщении = МодульОбъекта().НужноКонвертироватьОсобенностиВСообщении(Сообщение);
	 	
КонецПроцедуры

&НаСервере
Процедура ВыбратьЮрФизЛицоПартнераПоУмолчанию(СторонаЮрФизЛицаПартнера)

	Если Элементы[СторонаЮрФизЛицаПартнера].СписокВыбора.Количество() = 1 Тогда
		ЭтаФорма[СторонаЮрФизЛицаПартнера] = Элементы[СторонаЮрФизЛицаПартнера].СписокВыбора.Получить(0).Значение;
	Иначе
		ЭтаФорма[СторонаЮрФизЛицаПартнера] = МодульОбъекта().ПолучитьПустуюСсылкуОбъекта("ЮрФизЛицоСтороннее");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииПолучателя()

	ОбязателенGTIN 	= Не (ЗначениеЗаполнено(Получатель)
						И (МодульОбъекта().ПолучитьЗначениеСвойстваОбъектаEDI(Получатель, "РазрешитьПустыеКодыGTINВИсходящихСообщениях") = Истина));
	//только в этом случае можно говорить о том можно отправить без GTIN
	
	ТипЦен 			= МодульОбъекта().ПолучитьПустуюСсылкуОбъекта("ТипыЦен");
	ЦенаВключаетНДС = Ложь;
	НомерДоговора	= "";
	ДатаДоговора	= Дата(1, 1, 1);
	
	Если ТипСообщения = "PRICELIST" ИЛИ ТипСообщения = "PRICAT" Тогда
		НомерПрайсЛиста = "";
		УстановитьДоступностьКомментария();
	КонецЕсли;
	
КонецПроцедуры

