&НаКлиенте
Процедура ТаблицаОшибокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ТаблицаОшибокДействие" Тогда
		
		ИмяПоля = Элемент.ТекущиеДанные.ИмяПоля;
		
		НайденнаяСтрока = НайтиСтрокуНастройкиСсылокИсправленияОшибок(Элемент.ТекущиеДанные.ИмяПоля);
		                  
		Если Не НайденнаяСтрока = Неопределено Тогда
			
			НоваяМетрика().НажатаНадпись(Поле).Категория("ДействиеНаФормеОшибокСообщения").Метка(НайденнаяСтрока.ТипСсылки).НаФорме(ЭтаФорма).ПоместитьВОчередь();
			
			ОбработчикИсправленияОшибкиКлиент(
			НайденнаяСтрока, 
			ИмяПоля, 
			Элемент.ТекущиеДанные.НомерСтроки, 
			Элемент.ТекущиеДанные.ТекстОшибки);
			
			ОбработчикПослеИсправленияОшибки(ИмяПоля);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикИсправленияОшибкиКлиент(НайденнаяСтрока, ИмяПоля, НомерСтроки, ТекстОшибки) Экспорт
	
	ВыполнитьДействиеДляИсправлениеОшибкиСообщения(ИмяПоля, НайденнаяСтрока.ТипСсылки, НомерСтроки, ТекстОшибки);
	
КонецПроцедуры  

&НаСервере
Процедура ВыполнитьДействиеДляИсправлениеОшибкиСообщения_Сервер(
	СтандартнаяОбработкаEDI, 
	ИмяПоля, 
	ТипСсылки, 
	НомерСтроки = Неопределено, 
	ТекстОшибки = Неопределено) Экспорт 
	
	СтандартнаяОбработкаEDI = Истина;
	
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("ИмяПоля", ИмяПоля);
	ПараметрыПМ.Вставить("ТипСсылки", ТипСсылки);
	ПараметрыПМ.Вставить("КопияСообщения", Сообщение);
	ПараметрыПМ.Вставить("ОригиналСообщения", Сообщение);
	ПараметрыПМ.Вставить("ФормаСообщения", ЭтаФорма);
	
	МодульОбъекта().ОбработкаСобытияПодключаемогоМодуля(
	"ВыполнитьДействиеДляИсправлениеОшибки", СтандартнаяОбработкаEDI, ПараметрыПМ);
	
	Если Не СтандартнаяОбработкаEDI Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте                                             
Функция ВыполнитьДействиеДляИсправлениеОшибкиСообщения(
	ИмяПоля, 
	ТипСсылки, 
	НомерСтроки = Неопределено, 
	ТекстОшибки = Неопределено) Экспорт
	
	СтандартнаяОбработкаEDI = Истина;
	
	ВыполнитьДействиеДляИсправлениеОшибкиСообщения_Сервер(СтандартнаяОбработкаEDI, ИмяПоля, ТипСсылки, НомерСтроки, ТекстОшибки);
	
	Если Не СтандартнаяОбработкаEDI Тогда
		Возврат Неопределено;
	КонецЕсли;
		
//В УФ Неопределено //Для УФ эта клиентская функция определена в ФормаСообщенияУправляемая
	Если ТипСсылки = "НоменклатураСсылка" Тогда
		
		ДанныеСтроки = Товары[НомерСтроки - 1];
		ОткрытьФормуПросмотраСоответствий(ДанныеСтроки);
		
	ИначеЕсли ТипСсылки = "СоответствиеНоменклатуры" Тогда
		
		ДанныеСтроки = Товары[НомерСтроки - 1];
		
		ИдентификаторыТовара = ПолучитьСтруктуруИдентификаторовТовара(ДанныеСтроки, Сообщение.ТипСообщения, КтоМы);
		
		СписокВыбора = СоставитьСписокВыбораПоСтрокеТоваровСервер(
		ИдентификаторыТовара.GTIN,
		ИдентификаторыТовара.КодТовараПартнера,
		ИдентификаторыТовара.КодЕдиницыИзмеренияEDI,
		Партнер);
		
		Если Сообщение.Направление = "Входящее"
			И (СписокВыбора.Количество() = 1 И СписокВыбора.НайтиПоЗначению("Настроить соответствие товаров") <> Неопределено) Тогда
			
			ОткрытьНоменклатура_ЭлементУправляемая();
			
		Иначе 
			
			ОткрытьФормуПросмотраСоответствий(ДанныеСтроки);
			
		КонецЕсли;
		
	КонецЕсли;
		
КонецФункции     

&НаКлиенте
Процедура ОткрытьНоменклатура_ЭлементУправляемая()
	
	ТекСтрока = Элементы.Товары.ТекущиеДанные;
	ИдентификаторыТовара = ПолучитьСтруктуруИдентификаторовТовара(ТекСтрока, Сообщение.ТипСообщения, КтоМы);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Партнер", Партнер);
	ПараметрыФормы.Вставить("Наименование", ТекСтрока.Наименование);
	ПараметрыФормы.Вставить("GTIN", ИдентификаторыТовара.GTIN);
	ПараметрыФормы.Вставить("КодТовараПартнера", ИдентификаторыТовара.КодТовараПартнера);
	ПараметрыФормы.Вставить("КодТовараВнутренний", ИдентификаторыТовара.КодТовараВнутренний);
	ПараметрыФормы.Вставить("КодЕдиницыИзмеренияEDI", ТекСтрока.КодЕдиницыИзмеренияEDI);
	ПараметрыФормы.Вставить("ТипЕдиницы", "");
	
	
	ПараметрыОбработчика = Новый Структура("КодТовараПартнера", ИдентификаторыТовара.КодТовараПартнера);
	
	МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI("Номенклатура_ЭлементУправляемая", , ПараметрыФормы, ЭтаФорма, "ОбработчикПослеИнтерактивнойНастройкиСоответствий", ЭтаФорма, ПараметрыОбработчика);

КонецПроцедуры  

&НаКлиенте
Процедура ОткрытьФормуПросмотраСоответствий(ДанныеСтроки)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Сообщение", Сообщение);
	
	Если Сообщение.Направление = "Входящее" Тогда
		ПараметрыФормы.Вставить("НаименованиеПартнера", ДанныеСтроки.Наименование);
		ИдентификаторыТовара = ПолучитьСтруктуруИдентификаторовТовара(ДанныеСтроки, Сообщение.ТипСообщения, КтоМы);
		ПараметрыФормы.Вставить("ИдентификаторыТовара", ИдентификаторыТовара);
	Иначе
		ПараметрыФормы.Вставить("Документ1С", Неопределено);
		ПараметрыФормы.Вставить("Номенклатура", ДанныеСтроки.Номенклатура);
		ПараметрыФормы.Вставить("ХарактеристикаНоменклатуры", ДанныеСтроки.ХарактеристикаНоменклатуры);
		ПараметрыФормы.Вставить("ЕдиницаИзмерения", ДанныеСтроки.ЕдиницаИзмерения);
	КонецЕсли;
	
	Если Сообщение.Направление = "Исходящее" Тогда
		Обработчик = "ОбработчикПослеИсправленияОшибки";
		ПараметрыОбработчика = Неопределено;
	Иначе
		Обработчик = "ОбработчикПослеИнтерактивнойНастройкиСоответствий";
		ПараметрыОбработчика = Новый Структура("КодТовараПартнера", ДанныеСтроки.КодТовараПоставщика);
	КонецЕсли;
	
	МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI("СопоставлениеНоменклатурыИзКарточкиСообщенияУправляемая",, ПараметрыФормы, ЭтаФорма, Обработчик, ЭтаФорма, ПараметрыОбработчика);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСтруктуруИдентификаторовТовара(ВыбраннаяСтрока, ТипСообщения, КтоМы)
	
	Структура = Новый Структура;
	
	Структура.Вставить("GTIN", ВыбраннаяСтрока.GTIN);
	Структура.Вставить("КодЕдиницыИзмеренияEDI", ВыбраннаяСтрока.КодЕдиницыИзмеренияEDI);
	
	// supplier code & buyer code поменяны местами EDI_An-354
	Если ТипСообщения = "RETDES" 
		ИЛИ КтоМы = "Покупатель" Тогда
		
		Структура.Вставить("КодТовараПартнера", ВыбраннаяСтрока.КодТовараПоставщика);
		Структура.Вставить("КодТовараВнутренний", ВыбраннаяСтрока.КодТовараПокупателя);
		
	Иначе
		
		Структура.Вставить("КодТовараПартнера", ВыбраннаяСтрока.КодТовараПокупателя);
		Структура.Вставить("КодТовараВнутренний", ВыбраннаяСтрока.КодТовараПоставщика);
		
	КонецЕсли;
	
	Возврат Структура;
	
КонецФункции

&НаКлиенте
Процедура ОбработчикПослеИсправленияОшибки(ИмяПоля, ДопПараметр = Неопределено) Экспорт
	          	
	ПроверитьЗаполнениеФормы();
	 		
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОшибокПриАктивизацииЯчейки(Элемент)
	
	ТекущаяСтрока = Элементы.ТаблицаОшибок.ТекущиеДанные;
	
	Если НЕ ТекущаяСтрока = Неопределено Тогда
		
		СделатьАктивнымПоле(ТекущаяСтрока.ИмяПоля, ТекущаяСтрока.ИмяТабличнойЧасти, ТекущаяСтрока.НомерСтроки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СделатьАктивнымПоле(ИмяПоля, ИмяТабличнойЧасти, НомерСтроки)
	
	Если ЗначениеЗаполнено(ИмяТабличнойЧасти) Тогда
		
		ТабличнаяЧасть = Элементы[ИмяТабличнойЧасти];
		
		ЭтаФорма.ТекущийЭлемент = ТабличнаяЧасть;
		
		Если НЕ НомерСтроки = 0 Тогда
			
			ТабличнаяЧасть.ТекущийЭлемент = Элементы.Найти(ИмяТабличнойЧасти + ИмяПоля);
			Выполнить("ТабличнаяЧасть.ТекущаяСтрока	= " + ИмяТабличнойЧасти + "[НомерСтроки-1].ПолучитьИдентификатор()");
			
		КонецЕсли;
		
	Иначе	
		
		Если ЗначениеЗаполнено(ИмяПоля) Тогда
			
			НайденноеПоле = Элементы.Найти(ИмяПоля);
			Если НЕ НайденноеПоле = Неопределено Тогда
				ЭтаФорма.ТекущийЭлемент = НайденноеПоле;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры  

&НаСервере
Функция НайтиСтрокуНастройкиСсылокИсправленияОшибок(ИмяПоля)
	
	ВосстановитьТаблицыЗначенийПроизвольныхРеквизитовИзХранилища();

	НайденнаяСтрока = НастройкаСсылокИсправленияОшибок.Найти(ИмяПоля, "ИмяПоля");
	Если НайденнаяСтрока <> Неопределено Тогда
		
		СтруктураВозврата = Новый Структура;
		СтруктураВозврата.Вставить("ИмяПоля", НайденнаяСтрока.ИмяПоля);
		СтруктураВозврата.Вставить("ТекстСсылки", НайденнаяСтрока.ТекстСсылки);
		СтруктураВозврата.Вставить("ТипСсылки", НайденнаяСтрока.ТипСсылки);
		
	Иначе
		
		СтруктураВозврата = Неопределено;
		
	КонецЕсли;
	
	УничтожитьТаблицыЗначенийПроизвольныхРеквизитов();
	
	Возврат СтруктураВозврата;
	
КонецФункции

&НаКлиенте
Процедура ТоварыПередУдалением(Элемент, Отказ)
	
	Если ФормаСодержитОшибки Тогда
		
		КоличествоОшибок = ТаблицаОшибок.Количество();
		
		ВыделенныеСтрокиТовары = МодульОбъектаКлиент().ВыделенныеСтрокиТаблицыФормы_КонтурEDI(Элемент);
		
		Для Каждого ИД_Строки Из ВыделенныеСтрокиТовары Цикл 
			
			ТекСтрока = Товары.НайтиПоИдентификатору(ИД_Строки);
			
			НомерСтроки = Товары.Индекс(ТекСтрока) + 1;
			
			УдалитьСтрокиИзТаблицыОшибок(НомерСтроки, "Товары");   			
						
			ФормаСодержитОшибки = ТаблицаОшибок.Количество() <> 0;
			
			Если ФормаСодержитОшибки Тогда
				ОткрытьПанельОшибокСервер();
			Иначе
				ЗакрытьПанельОшибокСервер();
			КонецЕсли;
			
		КонецЦикла;   		
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтрокиИзТаблицыОшибок(НомерСтроки, ИмяТабличнойЧасти)
		
	СтрокиТаблицыОшибок = ТаблицаОшибок.НайтиСтроки(Новый Структура("НомерСтроки,ИмяТабличнойЧасти", НомерСтроки, ИмяТабличнойЧасти));
	
	МассивУдаленныхСтрок = Новый Массив;
	
	Для Каждого СтрУдалить Из СтрокиТаблицыОшибок Цикл
		
		МассивУдаленныхСтрок.Добавить(СтрУдалить.НомерСтроки);
		
		ТаблицаОшибок.Удалить(СтрУдалить);
		
	КонецЦикла;
	
	Для Каждого Стр Из ТаблицаОшибок Цикл
		
		Если Стр.ИмяТабличнойЧасти = "Товары"  
			И НомерСтроки < Стр.НомерСтроки Тогда
			
			Стр.НомерСтроки = Стр.НомерСтроки - 1;
			
		КонецЕсли;			
		
	КонецЦикла;

КонецПроцедуры

