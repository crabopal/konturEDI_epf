&НаСервере
Перем МодульОбъекта;

&НаКлиенте
Перем МодульОбъектаКлиент;

&НаСервере
Перем ОсобенностиСообщений;

&НаСервере
Перем МетаданныеСообщения Экспорт;

&НаКлиенте
Перем ОсобенностьВыбранаИзСпискаВыбора;

// СЛУЖЕБНЫЕ {

// Инициализация модуля и его экспортных функций
&НаСервере
Функция МодульОбъекта()
	
	Если МодульОбъекта = Неопределено Тогда
		
		Если Объект.ПараметрыКлиентСервер.КэшироватьОбработкуОбъект Тогда
			МодульОбъекта = МодульОбъектаИзКэша();
		КонецЕсли;
		
		Если МодульОбъекта = Неопределено Тогда
			МодульОбъекта = РеквизитФормыВЗначение("Объект");
			МодульОбъекта.ИнициализироватьПодключаемыеМодули(); // TODO Проверить что из этого используется на формах и перенести в ПараметрыКлиентСервер
			МодульОбъекта.ОбновитьКэшМодуляОбъекта();
		КонецЕсли;
		
	КонецЕсли;	
	
	Возврат МодульОбъекта;
	
КонецФункции

&НаСервере
Функция МодульОбъектаИзКэша()
	
	Результат = Неопределено;
	
	Если ТипЗнч(Объект.ПараметрыКлиентСервер) = Тип("Структура") Тогда
		АдресВХ = Объект.ПараметрыКлиентСервер.АдресаВХ.ОбработкаОбъект;
 		Если ЭтоАдресВременногоХранилища(АдресВХ) Тогда
			Структура = ПолучитьИзВременногоХранилища(АдресВХ);
			Если ТипЗнч(Структура) = Тип("Структура") и Структура.Свойство("ОбработкаОбъект") Тогда
			 	Результат = Структура.ОбработкаОбъект;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция МодульОбъектаКлиент()
	
	Если ТипЗнч(МодульОбъектаКлиент) = Тип("УправляемаяФорма") Тогда
		Возврат МодульОбъектаКлиент;
	КонецЕсли;
	
	ОсновнаяФорма = ОсновнаяФорма();
	Если ТипЗнч(ОсновнаяФорма) = Тип("УправляемаяФорма") Тогда
		МодульОбъектаКлиент = ОсновнаяФорма.МодульОбъектаКлиент();
		Возврат МодульОбъектаКлиент;
	Иначе
		Сообщить("Ошибка! Не удалось получить контекст основной формы.");
	КонецЕсли;
	          	
КонецФункции

&НаКлиенте
Функция ОсновнаяФорма() Экспорт
	
	Если ЭтаФорма.ВладелецФормы = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		Возврат ЭтаФорма.ВладелецФормы.ОсновнаяФорма();
	КонецЕсли;
    	
КонецФункции

&НаКлиенте
Функция НоваяМетрика()
	
	Возврат ОсновнаяФорма().НоваяМетрика();
	
КонецФункции

&НаКлиенте
Функция ТекстОбязательностиРеквизита(ИмяРеквизита)
	Возврат "Не заполнен обязательный реквизит """ + ИмяРеквизита + """.";	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИнициализироватьПараметрыЗаполненияТоваров()
	
	Структура = Новый Структура;
	Структура.Вставить("Номенклатура"			, Неопределено);
	Структура.Вставить("ВидНоменклатуры"		, Неопределено);
	Структура.Вставить("ДобавлениеНоменклатуры"	, Ложь);
	Структура.Вставить("ПеревыборНоменклатуры"	, Ложь);
	
	Возврат Структура;
	
КонецФункции

&НаКлиенте
Функция ПараметрыСоответствияНоменклатуры()

	Структура = Новый Структура;
	Структура.Вставить("GTIN");
	Структура.Вставить("Наименование");
	Структура.Вставить("КодЕдиницыИзмеренияEDI");
	Структура.Вставить("Партнер");
	Структура.Вставить("Номенклатура");
									
    Возврат Структура;
	
КонецФункции

// } СЛУЖЕБНЫЕ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ОбъектПараметрыКлиентСервер", 			Объект.ПараметрыКлиентСервер);
	Параметры.Свойство("ОбъектПараметрыКлиентСерверМетрика", 	Объект.ПараметрыКлиентСерверМетрика);
	
	МодальностьЗапрещена = МодульОбъекта().МодальностьЗапрещена();
	ПутьКФормам = МодульОбъекта().Метаданные().ПолноеИмя() + ".Форма.";
	ИмяКонфигурации1С = МодульОбъекта().ОпределитьКонфигурацию();
	
	ИмяСправочникаНоменклатуры = МодульОбъекта().ПолучитьТипЗначенияОбъекта("Номенклатура",,Истина);
	ИмяРеквизитаЕдиницаИзмерения = МодульОбъекта().ПолучитьИмяРеквизитаВладельцаПоИмениТипа("Номенклатура", "ЕдиницаИзмерения");
	
	ТипСообщения 	= Параметры.ТипСообщения;
	Направление 	= Параметры.Направление;
	
	Если ЗначениеЗаполнено(Параметры.ПереотправляемоеСообщениеСсылка) Тогда
		ПереотправляемоеСообщениеСсылка = Параметры.ПереотправляемоеСообщениеСсылка;
	КонецЕсли;  
	
	РежимНастройкиРасписанияАвтоотправки = Параметры.НастройкаРасписанияАвтоотправки;
	
	ТолькоПросмотрСообщения = (Параметры.ТолькоПросмотр = Истина);
	
	СторонаЮрФизЛицаПартнера = МодульОбъекта().ОпределитьСторонуЮрФизЛица(ТипСообщения, Направление, Истина);
	СторонаЮрФизЛицаОрганизации = МодульОбъекта().ОпределитьСторонуЮрФизЛица(ТипСообщения, Направление, Ложь);
	
	НастройкаФормы = МодульОбъекта().ПолучитьНастройкиФормыНезависимогоСообщения(ТипСообщения, Направление);
	
	НастройкаСсылокИсправленияОшибок = МодульОбъекта().ПолучитьНастройкуВыводаСсылокНаОбъектыСообщения();
  	
	Если ЗначениеЗаполнено(Параметры.СообщениеСсылка) Тогда
		
		СообщениеСсылка = Параметры.СообщениеСсылка;
		Сообщение = МодульОбъекта().ПрочитатьСообщение(СообщениеСсылка, , ТипСообщения, Направление);
		
		АрхивноеСообщение = Сообщение.Свойство("Архив") И Сообщение.Архив = Истина;
		
		Если Сообщение.Направление = "Входящее" И НЕ АрхивноеСообщение Тогда
			МодульОбъекта().КонвертироватьСообщениеEDIв1С(Сообщение);
		КонецЕсли;
		
	ИначеЕсли РежимНастройкиРасписанияАвтоотправки = Истина 
			И Параметры.Свойство("АвтоотправкаПараметрыПодготовкиСообщения") 
			И ТипЗнч(Параметры.АвтоотправкаПараметрыПодготовкиСообщения) = Тип("Структура") Тогда
		
		Сообщение = МодульОбъекта().ПодготовитьИсходящееНезависимоеСообщение(ТипСообщения, 
																			 РеквизитФормыВЗначение("Товары"),
																			 Параметры.АвтоотправкаПараметрыПодготовкиСообщения);
																			 
		Параметры.Свойство("АвтоотправкаНаименованиеНастройки", НаименованиеНастройкиАвтоотправки);
		Параметры.Свойство("АвтоотправкаРасписание", РасписаниеНастройкиАвтоотправки);
		
		Если Не РасписаниеНастройкиАвтоотправки = Неопределено Тогда
			ПредставлениеРасписанияНастройкиАвтоотправки = Строка(РасписаниеНастройкиАвтоотправки);
		КонецЕсли;

	КонецЕсли;
	
	ВыполнитьНастройкиФормы();
	
	ЗаполнитьПоУмолчанию = Ложь;
	
	Если ЗначениеЗаполнено(Сообщение) Тогда
		
		ЗаполнитьОсобенностиСообщенияНаФорме_ОсновнойМодуль();
		
		ЗаполнитьПоляНаФорме();
		ПредставлениеПолучателя = МодульОбъекта().ПолучитьПредставлениеЭлементаСправочника(Получатель);
		        		
	Иначе
		
		ЗаполнитьПоУмолчанию = Истина;
		
		Сообщение =  МодульОбъекта().ПодготовитьИсходящееСообщение(ТипСообщения, Неопределено, Новый Структура);
		
		СтруктураПараметры = ПолучитьПараметрыДляПодготовкиСообщения(ТипСообщения);
		Сообщение = МодульОбъекта().ПодготовитьИсходящееНезависимоеСообщение(ТипСообщения, РеквизитФормыВЗначение("Товары"), СтруктураПараметры);
		
		ЗаполнитьОсобенностиСообщенияНаФорме_ОсновнойМодуль();
		
	КонецЕсли;
	
	Если ЗаполнитьПоУмолчанию Тогда
		ЗаполнитьПоляНаФормеЗначениямиПоУмолчанию();
	КонецЕсли; 
	
	КтоМы = МодульОбъекта().ОпределитьКемМыЯвляемся(Сообщение);

	// ... особенности
	МодульОбъекта().ДобавитьУсловноеОформлениеОсобенностейСообщения(ЭтаФорма);
	НужноКонвертироватьОсобенностиВСообщении = МодульОбъекта().НужноКонвертироватьОсобенностиВСообщении(Сообщение);
	
	УстановитьЗаголовокФормы_КонтурEDI();
	
	ФормаСодержитОшибки = НЕ ПроверитьЗаполнениеПолей();
	
	// ... вызов ПМ
	МодульОбъекта().ПриОткрытииФормыСообщения(Сообщение, ЭтаФорма);
	
	ПоместитьТаблицыЗначенийПроизвольныхРеквизитовВХранилище();	
	УничтожитьТаблицыЗначенийПроизвольныхРеквизитов();
	
	СтруктураИдентификаторовДД = СтруктураИндетификаторовДД_Сервер();
	
КонецПроцедуры

&НаСервере
Процедура УничтожитьТаблицыЗначенийПроизвольныхРеквизитов() Экспорт 
	
	НастройкаСсылокИсправленияОшибок     = Неопределено;  

	Для Каждого ЭлементСтруктуры Из НастройкаФормы Цикл
		Если ТипЗнч(ЭлементСтруктуры.Значение) = Тип("ТаблицаЗначений") Тогда
			НастройкаФормы[ЭлементСтруктуры.Ключ] = Неопределено;	
		КонецЕсли;
	КонецЦикла;

	Для Каждого ЭлементСтруктуры Из Сообщение Цикл
		Если ТипЗнч(ЭлементСтруктуры.Значение) = Тип("ТаблицаЗначений") Или ТипЗнч(ЭлементСтруктуры.Значение) = Тип("ДеревоЗначений") Тогда
			Сообщение[ЭлементСтруктуры.Ключ] = Неопределено;	
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура ПоместитьТаблицыЗначенийПроизвольныхРеквизитовВХранилище() Экспорт
	
	СтруктураВременногоХранилища = Новый Структура;

	Если ТипЗнч(НастройкаСсылокИсправленияОшибок) = Тип("ТаблицаЗначений") Тогда
		СтруктураВременногоХранилища.Вставить("НастройкаСсылокИсправленияОшибок", НастройкаСсылокИсправленияОшибок);
	КонецЕсли;
	
	СтруктураНастройкаФормы = Новый Структура;
	Для Каждого ЭлементСтруктуры Из НастройкаФормы Цикл
		Если ТипЗнч(ЭлементСтруктуры.Значение) = Тип("ТаблицаЗначений") Тогда
			СтруктураНастройкаФормы.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);	
		КонецЕсли;
	КонецЦикла;
	Если СтруктураНастройкаФормы.Количество() > 0 Тогда 
		СтруктураВременногоХранилища.Вставить("НастройкаФормы", СтруктураНастройкаФормы);	
	КонецЕсли;
	
	СтруктураСообщение = Новый Структура;
	Для Каждого ЭлементСтруктуры Из Сообщение Цикл
		Если ТипЗнч(ЭлементСтруктуры.Значение) = Тип("ТаблицаЗначений") Или ТипЗнч(ЭлементСтруктуры.Значение) = Тип("ДеревоЗначений") Тогда
			СтруктураСообщение.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);	
		КонецЕсли;
	КонецЦикла;
	Если СтруктураСообщение.Количество() > 0 Тогда 
		СтруктураВременногоХранилища.Вставить("Сообщение", СтруктураСообщение);
	КонецЕсли;

	Если СтруктураВременногоХранилища.Количество() > 0 Тогда 
		АдресВХПроизвольныеРеквизиты = ПоместитьВоВременноеХранилище(СтруктураВременногоХранилища, ЭтаФорма.УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьТаблицыЗначенийПроизвольныхРеквизитовИзХранилища() Экспорт
	
	// извлечем из ВХ если не инициализированы реквизиты и при этом там хоть что-то есть
	
	Если НЕ ПустаяСтрока(АдресВХПроизвольныеРеквизиты)
	  И (НастройкаСсылокИсправленияОшибок = Неопределено
		ИЛИ Сообщение.Товары = Неопределено) Тогда 
		
		СтруктураВременногоХранилища = ПолучитьИзВременногоХранилища(АдресВХПроизвольныеРеквизиты);
		Если СтруктураВременногоХранилища = Неопределено Тогда 
			ВызватьИсключение "Сервер потерял временное хранилище (откройте форму заново)";
		КонецЕсли;
		
		НастройкаСсылокИсправленияОшибок = СтруктураВременногоХранилища.НастройкаСсылокИсправленияОшибок;
		
		Если СтруктураВременногоХранилища.Свойство("НастройкаФормы") И ТипЗнч(СтруктураВременногоХранилища.НастройкаФормы) = Тип("Структура") Тогда
			Для Каждого ЭлементСтруктуры Из СтруктураВременногоХранилища.НастройкаФормы Цикл
				НастройкаФормы[ЭлементСтруктуры.Ключ] = ЭлементСтруктуры.Значение;							
			КонецЦикла;
		КонецЕсли;		

		Если СтруктураВременногоХранилища.Свойство("Сообщение") И ТипЗнч(СтруктураВременногоХранилища.Сообщение) = Тип("Структура") Тогда
			Для Каждого ЭлементСтруктуры Из СтруктураВременногоХранилища.Сообщение Цикл
				Если ЭлементСтруктуры.Ключ = "Товары" И Не Сообщение.Товары = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Сообщение[ЭлементСтруктуры.Ключ] = ЭлементСтруктуры.Значение;							
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокФормы_КонтурEDI()
	
	Если РежимНастройкиРасписанияАвтоотправки = Истина Тогда
		ЭтаФорма.Заголовок = "Настройка правила формирования ценового листа";
	Иначе
		ПредставлениеТипаСообщения = НастройкаФормы.Заголовок;
		ПредставлениеДатыСообщения = МодульОбъекта().ПолучитьПредставлениеДатыСообщения(Сообщение);
		
		ЭтаФорма.Заголовок = ПредставлениеТипаСообщения + " (" + ТипСообщения + ") " + ПредставлениеДатыСообщения;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьНастройкиФормы()

	ЗаполнитьСпискиВыбораПолей();
	ЗаполнитьСпискиВыбораКолонок();
	УстановитьСвязиПараметровВыбораХарактеристик();
	УстановитьДоступностьЭлементов();
	УстановитьВидимостьЭлементов();
	УстановитьТипыПолей1С();
	УстановитьНадписиЭлементов();
	УстановитьСвойстваЭлементов_КонтурEDI();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСвязиПараметровВыбораХарактеристик()
	
	СвязиПараметровВыбора = Новый Массив;
	
	Если ИмяКонфигурации1С = "УФ_УТ" Тогда 
		СвязиПараметровВыбора.Добавить(Новый СвязьПараметраВыбора("Номенклатура", "Элементы.Товары.ТекущиеДанные.Номенклатура"));
	ИначеЕсли ИмяКонфигурации1С = "УФ_УНФ" Тогда
		СвязиПараметровВыбора.Добавить(Новый СвязьПараметраВыбора("Отбор.Владелец", "Элементы.Товары.ТекущиеДанные.Номенклатура"));
	КонецЕсли;	
	
	Если СвязиПараметровВыбора.Количество() > 0 Тогда
		Элементы.ТоварыХарактеристикаНоменклатуры.СвязиПараметровВыбора = Новый ФиксированныйМассив(СвязиПараметровВыбора);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпискиВыбораПолей()
	
	Если Направление = "Исходящее" Тогда
		
		СпискиВыбораПолей = НастройкаФормы.СпискиВыбораПолей;
		
		Для каждого ТекСписок Из СпискиВыбораПолей Цикл
			ЗаполнитьСписокВыбораЭлемента(Элементы[ТекСписок.Ключ], ТекСписок.Значение);
		КонецЦикла;
		
		СписокЮрФизЛицСвоих = Новый СписокЗначений;
		СписокЮрФизЛицСвоих.ЗагрузитьЗначения(МодульОбъекта().ПолучитьСписокЭлементовСправочника("ЮрФизЛицаСвои").ВыгрузитьКолонку("ЮрФизЛицо"));
		
		ЗаполнитьСписокВыбораЭлемента(Элементы.Отправитель, СписокЮрФизЛицСвоих);
		ЗаполнитьСписокВыбораЭлемента(Элементы[СторонаЮрФизЛицаОрганизации], СписокЮрФизЛицСвоих);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпискиВыбораКолонок()
	
	СпискиВыбораКолонок = НастройкаФормы.СпискиВыбораКолонок;
	
	Для каждого ТекСписок Из СпискиВыбораКолонок Цикл
	    ЗаполнитьСписокВыбораЭлемента(Элементы["Товары" + ТекСписок.Ключ], ТекСписок.Значение);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораЭлемента(Элемент, Список)
	
	Элемент.СписокВыбора.Очистить();
	
	Для каждого Эл Из Список Цикл
		Элемент.СписокВыбора.Добавить(Эл.Значение, Эл.Представление);
	КонецЦикла;	

КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьЭлементов()
	
	// только просмотр	
	
	ЭтоВходящееСообщение = Направление = "Входящее";
		
	Элементы.Отправитель.ТолькоПросмотр 				= ТолькоПросмотрСообщения ИЛИ ЭтоВходящееСообщение;
	Элементы.ПредставлениеПолучателя.ТолькоПросмотр  	= ТолькоПросмотрСообщения ИЛИ ЭтоВходящееСообщение;
	Элементы.Покупатель.ТолькоПросмотр  				= ТолькоПросмотрСообщения ИЛИ ЭтоВходящееСообщение;
	Элементы.Продавец.ТолькоПросмотр  					= ТолькоПросмотрСообщения ИЛИ ЭтоВходящееСообщение;
	Элементы.ТипЦен.ТолькоПросмотр		 				= ТолькоПросмотрСообщения;
	Элементы.СтатусТовараПоУмолчанию.ТолькоПросмотр		= ТолькоПросмотрСообщения;
	Элементы.Товары.ТолькоПросмотр		 				= ТолькоПросмотрСообщения;
	Элементы.ДатаНачалаПериода.ТолькоПросмотр      		= ТолькоПросмотрСообщения;
	Элементы.ДатаОкончанияПериода.ТолькоПросмотр   		= ТолькоПросмотрСообщения;
	Элементы.НомерДоговора.ТолькоПросмотр              	= ТолькоПросмотрСообщения;
	Элементы.ДатаДоговора.ТолькоПросмотр               	= ТолькоПросмотрСообщения;
	Элементы.ДатаИнвентаризации.ТолькоПросмотр      	= ТолькоПросмотрСообщения;
	Элементы.Валюта.ТолькоПросмотр     		 			= ТолькоПросмотрСообщения;
	Элементы.НомерПрайсЛиста.ТолькоПросмотр     		= ТолькоПросмотрСообщения;
	Элементы.ТипПрайсЛиста.ТолькоПросмотр     			= ТолькоПросмотрСообщения;
	Элементы.Склад.ТолькоПросмотр     					= ТолькоПросмотрСообщения;
	
	УстановитьДоступностьКомментария();
	
	// доступность
	
	Элементы.ПодменюДобавить.Доступность 				= Не (ТолькоПросмотрСообщения ИЛИ ЭтоВходящееСообщение);
	Элементы.ТоварыСкопировать.Доступность 				= Не (ТолькоПросмотрСообщения ИЛИ ЭтоВходящееСообщение);
	Элементы.ТоварыИзменить.Доступность 				= Не (ТолькоПросмотрСообщения ИЛИ ЭтоВходящееСообщение);
	Элементы.ТоварыУдалить.Доступность 					= Не (ТолькоПросмотрСообщения ИЛИ ЭтоВходящееСообщение);
	Элементы.ЗаполнитьТовары.Доступность 				= Не (ТолькоПросмотрСообщения ИЛИ ЭтоВходящееСообщение);
	Элементы.ТоварыОчиститьТаблицуТовары.Доступность 	= Не (ТолькоПросмотрСообщения ИЛИ ЭтоВходящееСообщение);
	Элементы.ВыгружатьОстаткиВПрайсЛист.Доступность		= Не (ТолькоПросмотрСообщения ИЛИ ЭтоВходящееСообщение);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьКомментария()
	
	Элементы.Комментарий.ТолькоПросмотр	= ТолькоПросмотрСообщения 
	ИЛИ НЕ МодульОбъекта().ПередаватьКомментарийВИсходящихСообщениях(Направление, ТипСообщения, Получатель);

Конецпроцедуры	

&НаСервере
Процедура УстановитьСвойстваЭлементов_КонтурEDI()
	
	// РежимВыбораИзСписка	
	 		
	Элементы.Отправитель.РежимВыбораИзСписка 				= НЕ Элементы.Отправитель.ТолькоПросмотр;
	Элементы.Покупатель.РежимВыбораИзСписка  				= НЕ Элементы.Покупатель.ТолькоПросмотр;
	Элементы.Продавец.РежимВыбораИзСписка  					= НЕ Элементы.Продавец.ТолькоПросмотр;
	
	// ВыбиратьТип	
	 		
	Элементы.Отправитель.ВыбиратьТип 				= НЕ Элементы.Отправитель.ТолькоПросмотр;
	Элементы.ПредставлениеПолучателя.ВыбиратьТип  	= НЕ Элементы.ПредставлениеПолучателя.ТолькоПросмотр ;
	Элементы.Покупатель.ВыбиратьТип  				= НЕ Элементы.Покупатель.ТолькоПросмотр;
	Элементы.Продавец.ВыбиратьТип  					= НЕ Элементы.Продавец.ТолькоПросмотр;
	
	Если РежимНастройкиРасписанияАвтоотправки = Истина Тогда
		
		Элементы.ГруппаШапка.ОтображатьЗаголовок = Ложь;
		Элементы.ГруппаСодержание.ОтображатьЗаголовок = Истина;
		Элементы.ФормаЗаписатьНастройкиАвтоотправки.КнопкаПоУмолчанию = Истина;
		Элементы.НаименованиеНастройкиАвтоотправки.АвтоОтметкаНезаполненного = Истина;
		Элементы.РасписаниеНастройкиАвтоотправки.АвтоОтметкаНезаполненного = Истина;
		
	КонецЕсли;
	
	МодульОбъекта().УстановитьФорматЭлементаФормы_КонтурEDI(Элементы.ТоварыКоэффициентEDIВ1С);
	
КонецПроцедуры   

&НаСервере
Процедура УстановитьВидимостьЭлементов()
	
	// кнопки
	
	Если НЕ ТипСообщения = "PRICELIST" И НЕ ТипСообщения = "PRICAT" Тогда
		Элементы.КакиеТоварыНеПопадутВТаблицу.Видимость = Ложь;
		Элементы.ПодменюДобавить.Видимость = Ложь;
		Элементы.СтраницаДопИнформация.Видимость = Ложь; 
		Элементы.ФормаСохранить.Видимость = Ложь;
	ИначеЕсли ЗначениеЗаполнено(СообщениеСсылка) Тогда
		Элементы.ФормаУдалитьСообщение.Видимость = Истина;
	КонецЕсли;
	
	Если ТолькоПросмотрСообщения Тогда
		Элементы.ФормаОтправить.Видимость = Ложь;
		Элементы.ФормаСохранить.Видимость = Ложь;
	КонецЕсли;
	
	// видимость полей
	
	НевидимыеПоля = НастройкаФормы.НевидимыеПоля;
	
	Для каждого ИмяПоля Из НевидимыеПоля Цикл
		СделатьНевидимымЭлементФормы(ИмяПоля);	
	КонецЦикла;
	
	// видимость колонок товаров
	
	НевидимыеКолонки = НастройкаФормы.НевидимыеКолонки;
	
	Для каждого ИмяКолонки Из НевидимыеКолонки Цикл
		СделатьНевидимойКолонкуТоваров(ИмяКолонки);	
	КонецЦикла;
	
	Если НЕ МодульОбъекта().ЕстьНеобходимыеМетаданные("Справочники.ВидыНоменклатуры") Тогда 
		Элементы.ТоварыДобавитьНоменклатуруПоВиду.Видимость = Ложь;
		Элементы.ТоварыДобавитьНоменклатуруПоГруппеВида.Видимость = Ложь;
	КонецЕсли;
	
	ПоказатьСкрытьКолонкуСОстаткомИСклад();
	
	Если РежимНастройкиРасписанияАвтоотправки = Истина Тогда
		
		Элементы.НаименованиеНастройкиАвтоотправки.Видимость = Истина;
		Элементы.РасписаниеНастройкиАвтоотправки.Видимость = Истина;
		
		//Основная командная панель
		Для каждого КнопкаКоманднойПанели Из КоманднаяПанель.ПодчиненныеЭлементы Цикл
			КнопкаКоманднойПанели.Видимость = Ложь;
		КонецЦикла;
		
		Элементы.ОткрытьИнструкциюПоРаботеСПрайсЛистом.Видимость = Ложь;
		
		Элементы.ФормаЗаписатьНастройкиАвтоотправки.Видимость = Истина; 
		Элементы.ФормаПроверитьНастройкиАвтоотправки.Видимость = Истина;
		Элементы.ФормаЗакрыть.Видимость = Истина;
		
		//Командная панель таблицы товаров
		Элементы.ПодменюДобавить.Видимость = Ложь;
		Элементы.ЗаполнитьТовары.Видимость = Ложь;
		Элементы.ТоварыОчиститьТаблицуТовары.Видимость = Ложь;
		Элементы.ТоварыИзменить.Видимость = Ложь;
		Элементы.ТоварыУдалить.Видимость = Ложь;
		Элементы.ТоварыСкопировать.Видимость = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СделатьНевидимымЭлементФормы(ИмяЭлементаФормы)
	
	НайденныйЭлемент = Элементы.Найти(ИмяЭлементаФормы);
	
	Если НайденныйЭлемент <> Неопределено Тогда
		НайденныйЭлемент.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СделатьНевидимойКолонкуТоваров(ИмяКолонки)
	
	НайденныйЭлемент = Элементы.Найти("Товары" + ИмяКолонки);
	
	Если НайденныйЭлемент <> Неопределено Тогда
		НайденныйЭлемент.Видимость		= Ложь;
		НайденныйЭлемент.Доступность	= Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТипыПолей1С()
	
	ТипТипыЦен 				= МодульОбъекта().ПолучитьТипЗначенияОбъекта("ТипыЦен");
	ТипВалюта 				= МодульОбъекта().ПолучитьТипЗначенияОбъекта("Валюта");
	ТипЮрФизЛицоСвое 		= МодульОбъекта().ПолучитьТипЗначенияОбъекта("ЮрФизЛицоСвое");
    ТипЮрФизЛицоСтороннее	= МодульОбъекта().ПолучитьТипЗначенияОбъекта("ЮрФизЛицоСтороннее");
	ТипСклад				= МодульОбъекта().ПолучитьТипЗначенияОбъекта("ТочкаДоставкиСвоя");
	
	Если ЗначениеЗаполнено(ТипТипыЦен) Тогда
		
		Элементы.ТипЦен.ОграничениеТипа = Новый ОписаниеТипов(ТипТипыЦен);
		ТипЦен = МодульОбъекта().ПолучитьПустуюСсылкуОбъекта("ТипыЦен");
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТипВалюта) Тогда
		
		Элементы.Валюта.ОграничениеТипа = Новый ОписаниеТипов(ТипВалюта);
		Валюта = МодульОбъекта().ПолучитьПустуюСсылкуОбъекта("Валюта");
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТипЮрФизЛицоСвое) Тогда
		
		Элементы[СторонаЮрФизЛицаОрганизации].ОграничениеТипа = Новый ОписаниеТипов(ТипЮрФизЛицоСвое);
		
		Если Направление = "Исходящее" Тогда
			
			Элементы.Отправитель.ОграничениеТипа = Новый ОписаниеТипов(ТипЮрФизЛицоСвое);
								
			ПустаяСсылкаЮрФизЛицоСвое = МодульОбъекта().ПолучитьПустуюСсылкуОбъекта("ЮрФизЛицоСвое");
			Отправитель = ПустаяСсылкаЮрФизЛицоСвое;
			ЭтаФорма[СторонаЮрФизЛицаОрганизации] = ПустаяСсылкаЮрФизЛицоСвое;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТипЮрФизЛицоСтороннее) Тогда
		
		Элементы[СторонаЮрФизЛицаПартнера].ОграничениеТипа = Новый ОписаниеТипов(ТипЮрФизЛицоСтороннее);
		
		Если Направление = "Исходящее" Тогда 			
						
			ПустаяСсылкаЮрФизЛицоСтороннее = МодульОбъекта().ПолучитьПустуюСсылкуОбъекта("ЮрФизЛицоСтороннее");
			ЭтаФорма[СторонаЮрФизЛицаПартнера] = ПустаяСсылкаЮрФизЛицоСтороннее;    			
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТипСклад) Тогда
		ЭтаФорма.Склад.ТипЗначения = Новый ОписаниеТипов(ТипСклад);
	КонецЕсли;
	
	Если Направление = "Входящее" Тогда
		Элементы.Отправитель.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.КонтурEDI_ДополнительныеСправочники");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьНадписиЭлементов()
	
	Если ТипСообщения = "PRICELIST" ИЛИ ТипСообщения = "PRICAT" Тогда
		
		Элементы.ДатаНачалаПериода.Заголовок = "Дата начала действия цен";
		Элементы.ДатаОкончанияПериода.Заголовок = "Дата окончания действия цен";
		
	ИначеЕсли ТипСообщения = "SLSRPT" ИЛИ ТипСообщения = "INVRPT" Тогда
		
		Элементы.Отправитель.Заголовок = "Отправитель отчета";
		Элементы.Покупатель.Заголовок = "Отчитывающаяся сторона";
		Элементы.Продавец.Заголовок = "Получатель отчета";
		
		Элементы.ДатаНачалаПериода.Заголовок = "Начало периода отчета";
		Элементы.ДатаОкончанияПериода.Заголовок = "Окончание периода отчета";
		
	КонецЕсли;
	
	Если ТипСообщения = "SLSRPT" Тогда	
		Элементы.ТипЦен.Заголовок = "Тип цен закупки";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПереотправляемоеСообщениеСсылка)
		И НЕ ТолькоПросмотрСообщения Тогда
		
		Элементы.ФормаОтправить.Заголовок = "Переотправить сообщение"; 
		
	ИначеЕсли Направление = "Входящее" 
		И НЕ ТолькоПросмотрСообщения Тогда
		
		Элементы.ФормаОтправить.Заголовок = "Обработать сообщение";
		
	КонецЕсли; 	
	
	Если РежимНастройкиРасписанияАвтоотправки = Истина Тогда
		
		Элементы.ГруппаШапка.Заголовок = "Правила формирования";
		Элементы.ГруппаСодержание.Заголовок = "Проверка правил";
		Элементы.ЗаполнитьТовары.Заголовок = "Проверить товары";
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокЮрФизЛицПартнера(Получатель)

   	СписокЮрФизЛицПартнера = ПолучитьСписокЮрФизЛицПартнера(Получатель);
	ЗаполнитьСписокВыбораЭлемента(Элементы[СторонаЮрФизЛицаПартнера], СписокЮрФизЛицПартнера);	
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьНомераСтрок()
	
	НомСтр = 1;
	
	Для Каждого Стр Из Товары Цикл
		Стр.НомерСтроки = НомСтр;
		НомСтр = НомСтр + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНомераСтрокКлиент()
	
	НомСтр = 1;
	
	Для Каждого Стр Из Товары Цикл
		Стр.НомерСтроки = НомСтр;
		НомСтр = НомСтр + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИмяСправочникаТипыЦен()
	
	ИмяСправочникаТипыЦен = МодульОбъекта().ПолучитьТипЗначенияОбъекта("ТипыЦен",,Истина);
	
	Возврат ИмяСправочникаТипыЦен;
	
КонецФункции

//получение и вывод данных ----------------------------------------------------------------

//у нас есть готовое сообщение - нужно распихать его по форме.
//по сути это обратная процедура для: ОтправитьСервер()
&НаСервере
Процедура ЗаполнитьПоляНаФорме()

	//заголовок
	ЭтаФорма.Заголовок = ЭтаФорма.Заголовок + " № " + Сообщение.ДокументEDI.Номер + " от " + Формат(Сообщение.ДокументEDI.Дата, "ДЛФ=Д");
	
	//шапка
	Отправитель = Сообщение.Отправитель1С; 	
	Партнер		= Сообщение.Партнер; 
				
	Если ЗначениеЗаполнено(Сообщение.Получатель1С) И Сообщение.Направление = "Исходящее" Тогда
		Получатель = Сообщение.Получатель1С;
	Иначе
		Получатель = Сообщение.Партнер;
	КонецЕсли;
	
	ЗаполнитьСписокЮрФизЛицПартнера(Получатель);
	
	Продавец 	= Сообщение.Продавец1С;
	Покупатель 	= Сообщение.Покупатель1С;
	
	Если ТипСообщения = "PRICELIST" ИЛИ ТипСообщения = "PRICAT" Тогда
		ДатаНачалаПериода		= Сообщение.ДатаНачалаДействияЦен;
		ДатаОкончанияПериода 	= Сообщение.ДатаОкончанияДействияЦен;
		НомерПрайсЛиста 		= Сообщение.ДокументEDI.Номер;
		Комментарий			 	= Сообщение.Комментарий;
		ТипПрайсЛиста 			= Сообщение.ТипПрайсЛиста;
		Если НЕ ЗначениеЗаполнено(ТипПрайсЛиста) Тогда
			ТипПрайсЛиста 		= "Catalogue";
		КонецЕсли;	
	ИначеЕсли ТипСообщения = "SLSRPT" 
		ИЛИ ТипСообщения = "INVRPT" Тогда
		ДатаНачалаПериода		= Сообщение.ДатаНачалаПериодаОтчета;
		ДатаОкончанияПериода 	= Сообщение.ДатаОкончанияПериодаОтчета;
	
	КонецЕсли;
	
	Если ТипСообщения = "INVRPT" Тогда
		ДатаИнвентаризации		= Сообщение.ДатаИнвентаризации;
		
	КонецЕсли;
	
	Валюта = Сообщение.Валюта1С;
	
	Если ЗначениеЗаполнено(Сообщение.Контракт.Номер) Тогда 
		НомерДоговора 	= Сообщение.Контракт.Номер;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Сообщение.Контракт.Дата) Тогда 
		ДатаДоговора 	= Сообщение.Контракт.Дата;
	КонецЕсли;	
	
	Если Сообщение.Свойство("ТипЦен") Тогда //для совместимости со старыми сообщениями
		ТипЦен = Сообщение.ТипЦен;
	КонецЕсли;
	
	Если Сообщение.Свойство("ВыгружатьОстаткиВПрайсЛист") Тогда 
        ВыгружатьОстаткиВПрайсЛист = Сообщение.ВыгружатьОстаткиВПрайсЛист;
        ПоказатьСкрытьКолонкуСОстаткомИСклад();
    КонецЕсли;
    
    Если Сообщение.Свойство("Склад")  Тогда 
        Склад = Сообщение.Склад;
	КонецЕсли;
	
	МодульОбъекта().ПересчитатьТоварыСообщения(Сообщение.Товары, Получатель, "В1С", Сообщение);
	
	ПересчитыватьКоличество = (Сообщение.Направление = "Входящее");
	
	// товары
	Для Каждого Строка Из Сообщение.Товары Цикл
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
		ПересчитатьСтрокуТоваров(НоваяСтрока,,ПересчитыватьКоличество);
	КонецЦикла;
	
	ОбновитьНомераСтрок();
	
	//описание ошибки
	Если ЗначениеЗаполнено(ПереотправляемоеСообщениеСсылка)
		И ЗначениеЗаполнено(Сообщение.СообщениеСсылка.ОписаниеОшибки) Тогда
		СообщениеСсылка = Сообщение.СообщениеСсылка;
		ОписаниеОшибки = СообщениеСсылка.ОписаниеОшибки;
		НоваяСтрока = ТаблицаОшибок.Добавить();
		НоваяСтрока.ТекстОшибки = ОписаниеОшибки;
		ФормаСодержитОшибки = Истина;
	КонецЕсли;

КонецПроцедуры // ЗаполнитьПоляНаФорме()

&НаСервере
Процедура ЗаполнитьПоляНаФормеЗначениямиПоУмолчанию()
	
	Валюта = МодульОбъекта().ВалютаУчета_КонтурEDI();
	
	Если Элементы.Отправитель.СписокВыбора.Количество() = 1 Тогда
		Отправитель = Элементы.Отправитель.СписокВыбора.Получить(0).Значение;
		ЭтаФорма[СторонаЮрФизЛицаОрганизации] = Отправитель;
	КонецЕсли;
	
	Если ТипСообщения = "PRICELIST" ИЛИ ТипСообщения = "PRICAT" Тогда
		СтатусТовараПоУмолчанию = "Changed";		
		ТипПрайсЛиста = "Catalogue";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОткрытьПанельОшибокСервер()
	
	Элементы.ГруппаОшибки.Видимость = истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗакрытьПанельОшибокСервер()
	
	Элементы.ГруппаОшибки.Видимость = Ложь;
	
КонецПроцедуры

