&НаСервере
Функция ПолучитьКлиентскийКодОбработчикаНажатияКнопки(ИмяКоманды)
	
	СтандартнаяОбработкаEDI = Истина;	
	
	ПараметрыПМ = Новый Структура("ИмяКоманды,Сообщение,Параметры,Форма",
	ИмяКоманды, Сообщение, Параметры, ЭтаФорма);
	
	КлиентскийКодОбработчика = 
	МодульОбъекта().ОбработкаСобытияПодключаемогоМодуля("ПолучениеКодаКлиентскогоОбработчика", СтандартнаяОбработкаEDI, ПараметрыПМ);
	
	Если ЗначениеЗаполнено(СокрЛП(КлиентскийКодОбработчика)) Тогда 
		Возврат КлиентскийКодОбработчика;
	Иначе
		Возврат неопределено;
	КонецЕсли;
	
КонецФункции 

// если мы хотим в режиме запрета модальности спросить что-то у пользователя, то его ответ требуется положить в обработчик
&НаКлиенте
Процедура ОбработчикИнтерактивногоДействияДобавленнойкнопки(РезультатКлиента, ИмяКоманды) Экспорт
	
	АкцепторДобавленнойКнопкиСервер(ИмяКоманды, РезультатКлиента);	
	
КонецПроцедуры 

&НаСервере
Процедура АкцепторДобавленнойКнопкиСервер(ИмяКоманды, РезультатКлиента = Неопределено)
	
	ВосстановитьТаблицыЗначенийПроизвольныхРеквизитовИзХранилища();   
	
	СтандартнаяОбработкаEDI = Истина;

	ПараметрыПМ = Новый Структура("ИмяКоманды,Сообщение,Параметры,Форма,РезультатКлиента", 
	ИмяКоманды, Сообщение, Параметры, ЭтаФорма, РезультатКлиента);
	
	МодульОбъекта().ОбработкаСобытияПодключаемогоМодуля("КнопкаФормыСообщенияНажатие", СтандартнаяОбработкаEDI, ПараметрыПМ);
	
	УничтожитьТаблицыЗначенийПроизвольныхРеквизитов();
	
КонецПроцедуры

&НаКлиенте                                
Процедура ОбработкаОповещения(ИмяСобытияОповещения, Параметр, Источник)
	
	// ждем  Параметр.ИмяКоманды, Параметр.Результат
	Если ИмяСобытияОповещения = "ОповещениеИзПодключаемогоМодуля" Тогда 
		АкцепторДобавленнойКнопкиСервер(Параметр.ИмяКоманды, Параметр.Результат)
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьНоменклатуруПоВиду(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();
	
	Если ПустаяСтрока(ПредставлениеПолучателя) Тогда
		МодульОбъектаКлиент().Предупреждение_КонтурEDI(ТекстОбязательностиРеквизита("Партнер"));
		Возврат;
	КонецЕсли;
	
	ВыбратьВидНоменклатуры(Команда.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроанализироватьСостояниеЮЗ()
	
	Если (Сообщение.ТипСообщения = "PRICAT" ИЛИ Сообщение.ТипСообщения = "PRICELIST")
		И ЗначениеЗаполнено(Сообщение.СообщениеСсылка) 
		И Сообщение.Направление = "Исходящее" Тогда 
				
		Если ЗначениеЗаполнено(СтруктураИдентификаторовДД.boxId) И 
			ЗначениеЗаполнено(СтруктураИдентификаторовДД.messageId) Тогда
			
			Состояние("Получение статусов из Диадока...");
			
			Если СтатусыЮЗДО = Неопределено Тогда
				
				ОсновнаяФорма().МодульОбменКлиент().СброситьПроверкиДанныхАвторизации();
				
				СтатусыЮЗДО = 
				ОсновнаяФорма().МодульОбменКлиент().
				УзнатьСостояниепоСФ(Сообщение.Отправитель1С,СтруктураИдентификаторовДД.boxId,СтруктураИдентификаторовДД.messageId);
				
				ОсновнаяФорма().МодульОбменКлиент().СброситьПарольКонтейнераДанныхАвторизации();
				
			КонецЕсли;
			
			Если СтатусыЮЗДО.Успешно=Ложь Тогда 
				
				НоваяСтрока = ТаблицаОшибок.Добавить();
				НоваяСтрока.ТекстОшибки = "Не удалось получить статус из Диадок.";
				НоваяСтрока.Действие 	= "Информация";
				НоваяСтрока.ИмяПоля		= "СтатусДиадок";
				
				НоваяСтрока = ТаблицаОшибок.Добавить();
				НоваяСтрока.ТекстОшибки = СтатусыЮЗДО.ОписаниеОшибки;
				НоваяСтрока.Действие 	= "Информация";
				НоваяСтрока.ИмяПоля		= "СтатусДиадок";
				
				СтатусыЮЗДО = Неопределено;
				
			Иначе
				
				КлассификаторСтатусовДД = ОсновнаяФорма().ПолучитьКлассификаторСтатусовДД();
				
				ВывестиВОшибкиСостояниеЮЗДО(СтатусыЮЗДО, ТаблицаОшибок, КлассификаторСтатусовДД);
				
			КонецЕсли; 
			
			Состояние("");
			
		КонецЕсли; 				
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СтруктураИндетификаторовДД_Сервер()
		                                           
	СтруктураИдентификаторовДД = МодульОбъекта().ПолучитьСписокСвойствEDI("boxId,messageId", Сообщение.СообщениеСсылка);
	
	Возврат СтруктураИдентификаторовДД;

КонецФункции 

&НаКлиентеНаСервереБезКонтекста
Процедура ВывестиВОшибкиСостояниеЮЗДО(СтатусыЮЗДО, ТаблицаОшибок, КлассификаторСтатусовДД) //они не являются ошибками, это уведомления
	
	Если СтатусыЮЗДО <> Неопределено И КлассификаторСтатусовДД <> Неопределено Тогда
				
		МассивСвойств = Новый СписокЗначений;
		МассивСвойств.Добавить("СтатусСФ", "Статус СФ");
		МассивСвойств.Добавить("СтатусТорг12", "Статус Торг12");
		МассивСвойств.Добавить("СтатусУПД", "Статус");
		МассивСвойств.Добавить("КомментарийКЗапросуУточнения", "Комментарий к запросу уточнения");
		МассивСвойств.Добавить("КомментарийКОтказуВПодписи", "Комментарий к отказу");
		МассивСвойств.Добавить("КомментарийКЗапросуАннулированияСФ", "Запрос аннулирования СФ");
		МассивСвойств.Добавить("КомментарийКЗапросуАннулированияТОРГ12", "Запрос аннулирования Торг12");
		МассивСвойств.Добавить("КомментарийКЗапросуАннулированияУПД", "Запрос аннулирования УПД");
		МассивСвойств.Добавить("СтатусАннулированияСФ", "Статус аннулирования СФ");   
		МассивСвойств.Добавить("СтатусАннулированияТорг12", "Статус аннулирования Торг12");
		МассивСвойств.Добавить("СтатусАннулированияУПД", "Статус аннулирования УПД");
		
		Для Каждого СвойствоДокумента Из МассивСвойств Цикл
			
			ЗначениеСвойства = "";
			СтатусыЮЗДО.Свойство(СвойствоДокумента.Значение, ЗначениеСвойства);
			
			Если ЗначениеСвойства <> "" И ЗначениеСвойства <> Неопределено Тогда
				
				ТекстОшибки = "";
				
				Если Лев(СвойствоДокумента.Значение,11) = "Комментарий" Тогда
					
					ТекстОшибки = СвойствоДокумента.Представление+": """ + ЗначениеСвойства + """";
					
				Иначе
					
					ПсевдонимСтатуса = КлассификаторСтатусовДД.НайтиПоЗначению(ЗначениеСвойства);
					Если ПсевдонимСтатуса <> Неопределено Тогда 
						
						ТекстОшибки = СвойствоДокумента.Представление + ": " + ПсевдонимСтатуса.Представление;
						
					КонецЕсли;
					
				КонецЕсли;
				
				Если ТекстОшибки <> "" 
					И ТаблицаОшибок.НайтиСтроки(Новый Структура("ТекстОшибки", ТекстОшибки)).Количество() = 0 Тогда
					
					НоваяСтрока = ТаблицаОшибок.Добавить();
					НоваяСтрока.ТекстОшибки = ТекстОшибки;
					НоваяСтрока.ИмяПоля		= "СтатусДиадок";
					НоваяСтрока.Действие	= "Информация";
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры // ВывестиСостояниеЮЗДО()

//{ Центр поддержки

&НаКлиенте
Процедура ПомощьЦентрПоддержкиОшибкиСообщения(Команда)
	
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();
	
	ОбращениеВЦентрПоддержкиПоОшибкам();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбращениеВЦентрПоддержкиПоОшибкам() Экспорт
	
	ДопКонтекстДляЦентраПоддержки = Новый Структура;
	ДопКонтекстДляЦентраПоддержки.Вставить("МассивОшибок", МассивОшибокСообщения_КонтурEDI());
	ДопКонтекстДляЦентраПоддержки.Вставить("Сообщение", Сообщение);
			
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ПараметрыСессии", МодульОбъектаКлиент().СформироватьПараметрыЦентраПоддержки(ДопКонтекстДляЦентраПоддержки));
	
	МодульОбъектаКлиент().ОткрытьЦентрПоддержки(ДопПараметры);
	
КонецПроцедуры 

&НаКлиенте
Функция МассивОшибокСообщения_КонтурEDI()
	
	МассивОшибок = Новый Массив;
	
	Для Каждого СтрокаОшибки Из ТаблицаОшибок Цикл
		
		Если МассивОшибок.Найти(СтрокаОшибки.ТекстОшибки) = Неопределено Тогда
			
			МассивОшибок.Добавить(СтрокаОшибки.ТекстОшибки);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивОшибок;
	
КонецФункции 

