&НаКлиенте
Процедура ПроверитьЗаполнениеФормы()
	
	ФормаСодержитОшибки = НЕ ПроверитьЗаполнениеПолей();
	
КонецПроцедуры

&НаСервере
Функция ПроверитьЗаполнениеПолей() Экспорт
	
	Если Сообщение.Направление = "Исходящее" И Не ТолькоПросмотрСообщения Тогда
		
		СтруктураПараметры = ПолучитьПараметрыДляПодготовкиСообщения(ТипСообщения);
		Сообщение = МодульОбъекта().ПодготовитьИсходящееНезависимоеСообщение(Сообщение.ТипСообщения, РеквизитФормыВЗначение("Товары"), СтруктураПараметры);
		Если ЗначениеЗаполнено(СообщениеСсылка) Тогда
			Сообщение.СообщениеСсылка = СообщениеСсылка;
		КонецЕсли;
	КонецЕсли;   
	
	ВосстановитьТаблицыЗначенийПроизвольныхРеквизитовИзХранилища();
	
	ТаблицаОшибок.Очистить();
	
	ЕстьОшибкиВПрикрепленных = Ложь;
	
	// смотрим на статусное сообщение
	ОтразитьОшибкиИзСтатусногоСообщения_Сервер(); 	   
	
	КопияСообщения = МодульОбъекта().ПолучитьКопиюСообщения(Сообщение);
	
	Если Сообщение.Направление = "Входящее" Тогда
		
		ПеренестиПоля1СвСообщение(КопияСообщения);		
				
	КонецЕсли;
			
	РезультатПроверки = МодульОбъекта().ПроверитьПоляСообщения(КопияСообщения);
	
	Если РежимНастройкиРасписанияАвтоотправки = Истина И РезультатПроверки.Успешно = Ложь Тогда
		
		ОтборОшибокТоваров = Новый Структура("ИмяТабличнойЧасти", "Товары");
		ОшибкиТоваров = РезультатПроверки.СписокОшибок.НайтиСтроки(ОтборОшибокТоваров);
		СтрокаОшибкиЗаполненияТоваров = Неопределено;
		
		Для каждого ОшибкаТоваров Из ОшибкиТоваров Цикл
			Если МодульОбъекта().КонтурСтандарт_СтрНайти_(ОшибкаТоваров.ТекстОшибки, "должна быть заполнена") > 0 Тогда
				СтрокаОшибкиЗаполненияТоваров = ОшибкаТоваров;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не СтрокаОшибкиЗаполненияТоваров = Неопределено Тогда
			РезультатПроверки.СписокОшибок.Удалить(СтрокаОшибкиЗаполненияТоваров);
		КонецЕсли;
		
		Если РезультатПроверки.СписокОшибок.Количество() = 0 Тогда
			РезультатПроверки.Успешно = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ РезультатПроверки.Успешно Тогда
		
		ПеренестиСписокОшибокНаФорму(РезультатПроверки);
		
	КонецЕсли;
	
	ВывестиВОшибкиСостояниеЮЗДО(СтатусыЮЗДО, ТаблицаОшибок, КлассификаторСтатусовДД);
	
	ЕстьОшибки = Ложь;
	
	Для Каждого Ошибка Из ТаблицаОшибок Цикл 
		Если Ошибка.Действие <> "Информация" Тогда
			ЕстьОшибки = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ТаблицаОшибок.Количество() = 0 Тогда
		ЗакрытьПанельОшибокСервер();
	Иначе
		ОткрытьПанельОшибокСервер();
	КонецЕсли;
			
	КопияСообщения = Неопределено;
	ПоместитьТаблицыЗначенийПроизвольныхРеквизитовВХранилище();
	УничтожитьТаблицыЗначенийПроизвольныхРеквизитов();
	
	Возврат РезультатПроверки.Успешно И НЕ ЕстьОшибки;
	
КонецФункции

&НаСервере
Процедура ОтразитьОшибкиИзСтатусногоСообщения_Сервер()

	 МодульОбъекта().ОтразитьОшибкиИзСтатусногоСообщения(Сообщение, ТаблицаОшибок);

КонецПроцедуры 

&НаСервере
Процедура ПеренестиСписокОшибокНаФорму(РезультатПроверки)
		
	СписокОшибок = РезультатПроверки.СписокОшибок;
	
	СписокКоманд = Элементы.ТаблицаОшибокКоманднаяПанель.ПодчиненныеЭлементы;
	СписокКоманд.ТаблицаОшибокОткрытьИнструкциюСопоставленияТоваров.Видимость = Ложь;
	
	НайденнаяСтрока = СписокОшибок.Найти("Номенклатура", "ИмяПоля");
	
	Если НайденнаяСтрока <> Неопределено Тогда
		СписокКоманд.ТаблицаОшибокОткрытьИнструкциюСопоставленияТоваров.Видимость = Истина;
	КонецЕсли;
		
	Для Каждого Стр Из СписокОшибок Цикл
		
		НоваяСтрока = ТаблицаОшибок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		
		НайденнаяСтрока = НастройкаСсылокИсправленияОшибок.Найти(Стр.ИмяПоля, "ИмяПоля");
		
		Если Не НайденнаяСтрока = Неопределено Тогда
			НоваяСтрока.Действие = НайденнаяСтрока.ТекстСсылки;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Стр.ИмяТабличнойЧасти) Тогда
			
			Поле = Элементы.Найти(Стр.ИмяПоля);
			Если Не Поле = Неопределено Тогда
				Поле.ЦветФона = WebЦвета.ЛососьСветлый;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.ИмяТабличнойЧасти) 
			И НЕ Стр.ИмяПоля = Стр.ИмяТабличнойЧасти Тогда
			
			ТекКолонка = Элементы.Найти(Стр.ИмяТабличнойЧасти + Стр.ИмяПоля); // это поле формы а не колонка
			
			Если НЕ ТекКолонка = Неопределено 
				И ТекКолонка.Видимость = Ложь Тогда
				
				ТекКолонка.Видимость	= Истина;
				ТекКолонка.Доступность	= Истина;
				
			КонецЕсли;
		 			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПеренестиПоля1СвСообщение(ТекСообщение)
	
	ТекСообщение.Продавец1С 		= Продавец;
	ТекСообщение.Покупатель1С 		= Покупатель;
	ТекСообщение.Валюта1С			= Валюта;
	
	ТекСообщение.Отправитель1С		= Отправитель;
	ТекСообщение.Получатель1С		= Получатель;
	
	ПереформироватьЕдиницыИзмерения = Ложь;
	
	сч = 0;
	
	Для каждого Стр Из Товары Цикл
		
		ТекСтрокаТоваров = ТекСообщение.Товары[сч];
 		ЗаполнитьЗначенияСвойств(ТекСтрокаТоваров, Стр);
		
		Если ТипЗнч(ТекСтрокаТоваров.ЕдиницаИзмерения) <> ТипЗнч(Стр.ЕдиницаИзмерения) Тогда
			ПереформироватьЕдиницыИзмерения = Истина;
		КонецЕсли;
		
		сч = сч + 1;
		
	КонецЦикла;
	
	Если ПереформироватьЕдиницыИзмерения Тогда  
		// ... заменить тип единицы измерения интерактивными действиями
		
		ТекСообщение.Товары.Колонки.Удалить(ТекСообщение.Товары.Колонки.ЕдиницаИзмерения);
		ТекСообщение.Товары.Колонки.Добавить("ЕдиницаИзмерения");
		
		сч = 0;
		Для каждого Стр Из Товары Цикл
			
			ТекСтрокаТоваров = ТекСообщение.Товары[сч];
			ТекСтрокаТоваров.ЕдиницаИзмерения = Стр.ЕдиницаИзмерения;
			сч = сч + 1;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ТекСообщение.Направление = "Входящее" Тогда
		
		ТекСообщение.Партнер = Отправитель;
		
	Иначе
		
		ТекСообщение.Партнер = Получатель;
		
	КонецЕсли;
	
	
КонецПроцедуры

//обработчики табличной части ---------------------------------------------------------

&НаКлиенте
Процедура ПодготовитьВывестиПредупреждениеПользователю(ОписаниеОшибки, ПеревыборНоменклатуры = Ложь)
	
	ЗаголовокПодсказки 	= "Контур.EDI. Заполнение товаров сообщения " + ТипСообщения;
	ТекстПодсказки 		= ОписаниеОшибки;
	
	Если ПеревыборНоменклатуры Тогда  
		
		СтрокаПоиска = "Товары не добавлены, проверьте, что они не попадают в следующие категории:";
		СтрокаЗамены = "Товар не выбран, проверьте, что он не попадает в следующие категории:";	
		
		ТекстПодсказки = СтрЗаменить(ОписаниеОшибки, СтрокаПоиска, СтрокаЗамены);
		
	КонецЕсли;
	
	МодульОбъектаКлиент().Предупреждение_КонтурEDI(ТекстПодсказки,,ЗаголовокПодсказки);
	
КонецПроцедуры

&НаКлиенте
Функция ПрайсЛистВходящий()

	Возврат (ТипСообщения = "PRICAT" ИЛИ ТипСообщения = "PRICELIST") И Направление = "Входящее";

КонецФункции

&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ИмяКолонки = Поле.Имя;
	
	Если ИмяКолонки = "ТоварыНоменклатура"
		ИЛИ ИмяКолонки = "ТоварыЕдиницаИзмерения"
		ИЛИ ИмяКолонки = "ТоварыКоэффициентEDIВ1С"
		ИЛИ ИмяКолонки = "ТоварыКодЕдиницыИзмеренияEDI" Тогда
		
		СтандартнаяОбработка = Ложь;
				
		ТекСтрока = Элементы.Товары.ТекущиеДанные;
			
		ДопПараметры = ПараметрыСоответствияНоменклатуры();
		
		ЗаполнитьЗначенияСвойств(ДопПараметры, ТекСтрока, "GTIN,КодЕдиницыИзмеренияEDI,Наименование,Номенклатура");
		
		ДопПараметры.Вставить("КодТовараСторонний");
		ДопПараметры.Вставить("КодТовараСвой");
		
		Если Направление = "Входящее" Тогда
			ДопПараметры.КодТовараСторонний	= ТекСтрока.КодТовараПоставщика;
			ДопПараметры.КодТовараСвой		= ТекСтрока.КодТовараПокупателя;
		Иначе  			
			ДопПараметры.КодТовараСторонний	= ТекСтрока.КодТовараПокупателя;
			ДопПараметры.КодТовараСвой		= ТекСтрока.КодТовараПоставщика;
		КонецЕсли;
			
		ДопПараметры.Вставить("Партнер"		, Сообщение.Партнер);
		ДопПараметры.Вставить("Продавец1С"	, Продавец); 
		ДопПараметры.Вставить("Покупатель1С", Покупатель);		
		ДопПараметры.Вставить("ТипСообщения", ТипСообщения);
		ДопПараметры.Вставить("Направление"	, Направление);
		
		СписокВыбора = ПолучитьСписокВыбораПоСтрокеТовара(ДопПараметры);
			
		МодульОбъектаКлиент().ВыбратьИзМеню_КонтурEDI("ОбработчикВыбораСоответствияИзМеню", ЭтаФорма, ДопПараметры, СписокВыбора); 
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокВыбораПоСтрокеТовара(ПараметрыПоискаСоответствий)

	Возврат МодульОбъекта().СоставитьСписокВыбораПоСтрокеТоваров(ПараметрыПоискаСоответствий.GTIN, 
																 ПараметрыПоискаСоответствий.КодТовараСторонний, 
																 ПараметрыПоискаСоответствий.Партнер, 
																 ПараметрыПоискаСоответствий.Направление, 
																 ПараметрыПоискаСоответствий);

КонецФункции 

&НаКлиенте
Процедура МетрикаВыборДействияПоСтрокеТоваровСообщения(ВыбранноеЗначение)
	
	ТекущееПолеТаблицы = Элементы.Товары.ТекущийЭлемент;	

	КонтекстКлиентМетрика = НоваяМетрика().Категория("ВыборДействияПоСтрокеТоваровСообщения").ПолеВводаОбработкаВыбора(ТекущееПолеТаблицы);
		
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		КонтекстКлиентМетрика.ДобавитьПеременную("ВыбранноеДействие", ВыбранноеЗначение.Действие);
	Иначе
		КонтекстКлиентМетрика.ДобавитьПеременную("ВыбранноеДействие", ВыбранноеЗначение);
	КонецЕсли;
	
	КонтекстКлиентМетрика.НаФорме(ЭтаФорма).ПоместитьВОчередь();

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВыбораСоответствияИзМеню(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МетрикаВыборДействияПоСтрокеТоваровСообщения(ВыбранноеЗначение.Значение);
	
	ИдентификаторСтроки = Элементы.Товары.ТекущаяСтрока;
	
	Если ВыбранноеЗначение.Значение = "Настроить соответствие товаров" Тогда
		
		Если ПрайсЛистВходящий() И НЕ ЗначениеЗаполнено(Партнер) Тогда
			
			ТекстПредупреждения = "Для установки соответствий номенклатуры в форму должен быть передан партнер.";
			МодульОбъектаКлиент().Предупреждение_КонтурEDI(ТекстПредупреждения);
			
		Иначе
						
			ПараметрыФормы = ПараметрыСоответствияНоменклатуры();
			
			ЗаполнитьЗначенияСвойств(ПараметрыФормы, ДополнительныеПараметры);
			
			ПараметрыФормы.Вставить("КодТовараПартнера", ДополнительныеПараметры.КодТовараСторонний);
			
			МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI("Номенклатура_ЭлементУправляемая",
														 ,
														 ПараметрыФормы,
														 ЭтаФорма,
														 "ОбработчикПослеИнтерактивнойНастройкиСоответствий",
														 ЭтаФорма,
														 ПараметрыФормы);
														 
		КонецЕсли;
				
	ИначеЕсли ВыбранноеЗначение.Значение.Действие = "СоздатьНовинку" Тогда
		
		УникальныйИдентификторНовойСсылки = Новый УникальныйИдентификатор;
		
		ФормаОбъекта = ПолучитьФорму("Справочник." + ИмяСправочникаНоменклатуры + ".Форма.ФормаЭлемента");
		
		ДанныеФормы	= ФормаОбъекта.Объект;			
		
		ЗаполнитьНовуюНоменклатуру_НаСервере(ДанныеФормы, ИдентификаторСтроки, УникальныйИдентификторНовойСсылки);
		
		КопироватьДанныеФормы(ДанныеФормы, ФормаОбъекта.Объект);
		
		ПараметрыОповещения = Новый Структура;
		ПараметрыОповещения.Вставить("СтруктураТовара"						, ВыбранноеЗначение.Значение);
		ПараметрыОповещения.Вставить("СтруктураСоответствия"				, ДополнительныеПараметры);
		ПараметрыОповещения.Вставить("ИдентификаторСтроки"					, Элементы.Товары.ТекущаяСтрока);
		ПараметрыОповещения.Вставить("УникальныйИдентификторНовойСсылки"	, УникальныйИдентификторНовойСсылки);
		ПараметрыОповещения.Вставить("ФормаОбъекта"							, ФормаОбъекта);
		
		Если МодальностьЗапрещена Тогда
			ФормаОбъекта.ОписаниеОповещенияОЗакрытии = Вычислить("Новый ОписаниеОповещения(""ОбработчикПослеСозданияНовойНоменклатуры_Клиент"", ЭтаФорма, ПараметрыОповещения)");
			ФормаОбъекта.Открыть();  			
		Иначе
			ФормаОбъекта.ОткрытьМодально();
			ОбработчикПослеСозданияНовойНоменклатуры_Клиент(Неопределено, ПараметрыОповещения);
		КонецЕсли;
		
	Иначе
		
		РезультатОбработчика = ОбработчикПослеВыбораСоответствияНаСервере(ВыбранноеЗначение.Значение, ИдентификаторСтроки);
		
		Если НЕ РезультатОбработчика.Успешно Тогда 
			ПодготовитьВывестиПредупреждениеПользователю(РезультатОбработчика.ОписаниеОшибки, Истина);	
		КонецЕсли;
		
		Обновить_ИнформациюОбОшибках();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНовуюНоменклатуру_НаСервере(ДанныеФормы, ИдентификаторСтроки, УникальныйИдентификторНовойСсылки) Экспорт
	
	НоменклатураОбъект = ДанныеФормыВЗначение(ДанныеФормы, Тип("СправочникОбъект." + ИмяСправочникаНоменклатуры));
	
	СтрокаТоваров = Товары.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	МодульОбъекта().ЗаполнитьНовуюНоменклатуру_КонтурEDI(НоменклатураОбъект, Сообщение, СтрокаТоваров, УникальныйИдентификторНовойСсылки, ИмяСправочникаНоменклатуры);
			
	ЗначениеВДанныеФормы(НоменклатураОбъект, ДанныеФормы);  	
	
КонецПроцедуры

&НаСервере
Функция НеобходимоОбновитьДанныеПоНоменклатуре(ДанныеСоответствия, СтрокаТаблицы)
	
	ПустаяСсылкаХарактеристики = МодульОбъекта().ПолучитьПустуюСсылкуОбъекта("ХарактеристикаНоменклатуры");
	
	Если ДанныеСоответствия.ХарактеристикаНоменклатуры = Неопределено И ПустаяСсылкаХарактеристики <> Неопределено Тогда		
		ДанныеСоответствия.ХарактеристикаНоменклатуры = ПустаяСсылкаХарактеристики;
	КонецЕсли;  
	
	Возврат ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) 
			И (ДанныеСоответствия.Номенклатура <> СтрокаТаблицы.Номенклатура 
				ИЛИ ДанныеСоответствия.ХарактеристикаНоменклатуры <> СтрокаТаблицы.ХарактеристикаНоменклатуры);
	
КонецФункции
			
&НаСервере
Функция ОбработчикПослеВыбораСоответствияНаСервере(ДанныеСоответствия, ИдентификаторСтроки)
	
	Результат = Новый Структура("Успешно, ОписаниеОшибки", Истина, "");
	
	СтрокаТаблицы = Товары.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если НеобходимоОбновитьДанныеПоНоменклатуре(ДанныеСоответствия, СтрокаТаблицы) Тогда
		
		ДопПараметры = ИнициализироватьПараметрыЗаполненияТоваров();
		ДопПараметры.Номенклатура = ДанныеСоответствия.Номенклатура;
		ДопПараметры.ПеревыборНоменклатуры = Истина;
		
		ДопПараметры.Вставить("СтрокаТаблицы"		, СтрокаТаблицы);
		ДопПараметры.Вставить("ДанныеСоответствия"	, ДанныеСоответствия);
		
		Результат = ЗаполнитьТоварыСервер(ТипСообщения, ДопПараметры);
		
	Иначе 	
		
		ПересчитатьСтрокуТоваров(СтрокаТаблицы,,, Истина);
		
		СписокСвойств = СписокСвойствСтроки_КонтурEDI("ХарактеристикаНоменклатуры");
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеСоответствия, СписокСвойств);
		
		ПересчитатьСтрокуТоваров(СтрокаТаблицы);
	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура СохранитьСоответствияНоменклатуры_Сервер(СтруктураТовара, ДопПараметры)

	СписокНоменклатуры = Новый ТаблицаЗначений;
	
	Колонки = "Артикул,Код,Номенклатура,ХарактеристикаНоменклатуры,ЕдиницаИзмерения,
			  |Основной,ЕдиницаEDI,ДействиеПересчета,КоэффициентEDIВ1С,Контрагент,Договор";
	
	МодульОбъекта().ДобавитьКолонкиВТаблицуЗначений(СписокНоменклатуры, Колонки);
	
	СтрокаНоменклатуры = СписокНоменклатуры.Добавить();
	СтрокаНоменклатуры.Номенклатура					= СтруктураТовара.Номенклатура;
	СтрокаНоменклатуры.ХарактеристикаНоменклатуры	= СтруктураТовара.ХарактеристикаНоменклатуры;
	СтрокаНоменклатуры.ЕдиницаИзмерения				= СтруктураТовара.ЕдиницаИзмерения;
	СтрокаНоменклатуры.ЕдиницаEDI					= ДопПараметры.КодЕдиницыИзмеренияEDI;
	
	ТекущееСоответствие = Новый Структура;
	ТекущееСоответствие.Вставить("GTIN",				ДопПараметры.GTIN);
	ТекущееСоответствие.Вставить("КодТовараПартнера",	ДопПараметры.КодТовараСторонний);
						
	РезультатСохранения = МодульОбъекта().СоответствиеТоваров_Сохранить(СписокНоменклатуры,
																		ДопПараметры.GTIN,
																		ДопПараметры.КодТовараСторонний,
																		ДопПараметры.Наименование,
																		ДопПараметры.Партнер,
																		ТекущееСоответствие,
																		СтруктураТовара.ТипЕдиницы);
	  
КонецПроцедуры
																	
&НаКлиенте
Процедура ОбработчикПослеСозданияНовойНоменклатуры_Клиент(Результат, ДопПараметры) Экспорт
	
	НоменклатураСсылка = Неопределено;
	
	Если ДопПараметры.Свойство("ФормаОбъекта") 
		И ТипЗнч(ДопПараметры.ФормаОбъекта) = Тип("УправляемаяФорма") Тогда
		
		НоменклатураСсылка = ДопПараметры.ФормаОбъекта.Объект.Ссылка;
		
	КонецЕсли;
	
	ДопПараметры.Вставить("ФормаОбъекта", Неопределено);
	
	ОбработчикПослеСозданияНовойНоменклатуры(НоменклатураСсылка, ДопПараметры);
	
	ПроверитьЗаполнениеФормы();
	
	Если ФормаСодержитОшибки Тогда
		ОткрытьПанельОшибокКлиент();
	Иначе
		ЗакрытьПанельОшибокКлиент();
	КонецЕсли;

КонецПроцедуры 

&НаСервере
Процедура ОбработчикПослеСозданияНовойНоменклатуры(Номенклатура, ДопПараметры) Экспорт
	  	
	СтрокаТоваров = Товары.НайтиПоИдентификатору(ДопПараметры.ИдентификаторСтроки);
	
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		
		ТаблицаТоваров = Новый ТаблицаЗначений;
		МодульОбъекта().ДобавитьКолонкиВТаблицуЗначений(
		ТаблицаТоваров, "GTIN,КодТовараСторонний,КодТовараСвой,КодЕдиницыИзмеренияEDI", МодульОбъекта().ОписаниеТипаСтрока_КонтурEDI(100));
		
		СтрокаТоваровДляПоиска = ТаблицаТоваров.Добавить();
		СтрокаТоваровДляПоиска.GTIN						= ДопПараметры.СтруктураСоответствия.GTIN;
		СтрокаТоваровДляПоиска.КодТовараСторонний		= ДопПараметры.СтруктураСоответствия.КодТовараСторонний;
		СтрокаТоваровДляПоиска.КодТовараСвой			= ДопПараметры.СтруктураСоответствия.КодТовараСвой;
		СтрокаТоваровДляПоиска.КодЕдиницыИзмеренияEDI	= ДопПараметры.СтруктураСоответствия.КодЕдиницыИзмеренияEDI;
		
		РезультатПодбора = МодульОбъекта().КонвертироватьТоварыEDIв1С(ТаблицаТоваров, ДопПараметры.СтруктураСоответствия, Истина);
		
		Если РезультатПодбора.Количество() > 0 Тогда
			Номенклатура = РезультатПодбора[0].Номенклатура;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		
		Структура = Новый Структура("Номенклатура");
		
		Структура.Вставить("Номенклатура", 					Номенклатура);
		Структура.Вставить("ХарактеристикаНоменклатуры",	Неопределено);
		
		Если ЗначениеЗаполнено(ИмяРеквизитаЕдиницаИзмерения) Тогда
			ЕдиницаИзмерения = Номенклатура[ИмяРеквизитаЕдиницаИзмерения];
		Иначе
			ЕдиницаИзмерения = Неопределено;
		КонецЕсли;
		
		Структура.Вставить("ЕдиницаИзмерения", ЕдиницаИзмерения);
		
		Структура.Вставить("ТипЕдиницы",					"");
		Структура.Вставить("КоэффициентEDIВ1С",				ДопПараметры.СтруктураТовара.КоэффициентEDIВ1С);
		
		СохранитьСоответствияНоменклатуры_Сервер(Структура, ДопПараметры.СтруктураСоответствия);
		
		ЗаполнитьЗначенияСвойств(СтрокаТоваров, Структура, "Номенклатура,ЕдиницаИзмерения,КоэффициентEDIВ1С");
						
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикПослеИнтерактивнойНастройкиСоответствий(ВыбранноеЗначение, ДопПараметры) Экспорт
	
	ТекСтрока = Элементы.Товары.ТекущиеДанные;
	ИдентификаторТекСтроки = ТекСтрока.ПолучитьИдентификатор();
	ОбработчикПослеИнтерактивнойНастройкиСоответствийСервер(ИдентификаторТекСтроки, ДопПараметры.КодТовараПартнера);
	
	ПроверитьЗаполнениеФормы();
	
	Если ФормаСодержитОшибки Тогда
		ОткрытьПанельОшибокКлиент();
	Иначе
		ЗакрытьПанельОшибокКлиент();
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ОбработчикПослеИнтерактивнойНастройкиСоответствийСервер(ИдентификаторТекСтроки, КодТовараПартнера)
	
	ВыбраннаяСтрока = Товары.НайтиПоИдентификатору(ИдентификаторТекСтроки);
	
	СоответствиеТоваров = МодульОбъекта().СоответствиеТоваров_НайтиНоменклатуру(ВыбраннаяСтрока.GTIN, КодТовараПартнера, Получатель);
	
	Для каждого Стр Из СоответствиеТоваров Цикл
		
		Если Стр.Номенклатура = ВыбраннаяСтрока.Номенклатура 
			ИЛИ Не ЗначениеЗаполнено(ВыбраннаяСтрока.Номенклатура) Тогда
			
			ПересчитатьСтрокуТоваров(ВыбраннаяСтрока,,, Истина);
			
			ЗаполнитьЗначенияСвойств(ВыбраннаяСтрока, Стр, "Номенклатура,ЕдиницаИзмерения,КоэффициентEDIВ1С");
			
			ВыбраннаяСтрока.КодЕдиницыИзмеренияEDI 	= Стр.ЕдиницаEDI;
						
			ПересчитатьСтрокуТоваров(ВыбраннаяСтрока);
			
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СоставитьСписокВыбораПоСтрокеТоваровСервер(GTIN, КодТовараПартнера, КодЕдиницыИзмеренияEDI, Партнер)
	
	СписокВыбора = МодульОбъекта().СоставитьСписокВыбораСоответствийПоТовару(GTIN, КодТовараПартнера, КодЕдиницыИзмеренияEDI, Партнер);
	Возврат СписокВыбора;
	
КонецФункции

&НаКлиенте
Процедура ТоварыПослеУдаления(Элемент)
	
	ОбновитьНомераСтрокКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		Элементы.Товары.ТекущиеДанные.НомерСтроки = ЭтаФорма.Товары.Количество();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ИмяКолонки 	= Элемент.ТекущийЭлемент.Имя;
	ТекСтрока 	= Элемент.ТекущиеДанные;

	Если ИмяКолонки = "ТоварыЦенаБезНДС" 
		ИЛИ ИмяКолонки = "ТоварыЦенаСНДС" Тогда
		ПересчитатьЦенуПослеИнтерактивногоРедактированияКлиент(ИмяКолонки, ТекСтрока);
	КонецЕсли;	 	

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьЦенуПослеИнтерактивногоРедактированияКлиент(ИмяКолонки, ТекСтрока)

	ИдентификаторСтроки = ТекСтрока.ПолучитьИдентификатор();
	ПересчитатьЦенуПослеИнтерактивногоРедактированияСервер(ИмяКолонки, ИдентификаторСтроки)	

КонецПроцедуры

&НаСервере
Процедура ПересчитатьЦенуПослеИнтерактивногоРедактированияСервер(ИмяКолонки, ИдентификаторСтроки)

	Строка = Товары.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если ИмяКолонки = "ТоварыЦенаБезНДС" Тогда 
		ПересчитатьЦенуСНДС(Строка);	
	ИначеЕсли ИмяКолонки = "ТоварыЦенаСНДС" Тогда
		ПересчитатьЦенуБезНДС(Строка);	
	КонецЕсли;
	
 	ПересчитатьСтрокуТоваров(Строка,, Ложь);

КонецПроцедуры

&НаСервере
Процедура ПересчитатьЦенуСНДС(Строка)
	
	СтавкаНДС = МодульОбъекта().ПолучитьСтавкуНДС_КонтурEDI(Строка.СтавкаНДС1С);
	Строка.ЦенаСНДС = Окр((Строка.ЦенаБезНДС * (100 + СтавкаНДС)) / 100, 2, 1);
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьЦенуБезНДС(Строка)

	СтавкаНДС = МодульОбъекта().ПолучитьСтавкуНДС_КонтурEDI(Строка.СтавкаНДС1С);
	Строка.ЦенаБезНДС = Окр((Строка.ЦенаСНДС * 100) / (100 + СтавкаНДС), 2, 1);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТовары(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	Если ПустаяСтрока(ПредставлениеПолучателя) Тогда
		МодульОбъектаКлиент().Предупреждение_КонтурEDI(ТекстОбязательностиРеквизита("Партнер"));
		Возврат;
	КонецЕсли;
	
	Если Товары.Количество() <> 0 Тогда
		
		ТекстВопроса = "Данные таблицы товаров будут очищены. Продолжить?";
		
		КнопкиВопроса = Новый СписокЗначений;
		КнопкиВопроса.Добавить("Да, перезаполнить");
		КнопкиВопроса.Добавить("Нет, не перезаполнять");
		
		МодульОбъектаКлиент().ПоказатьВопрос_КонтурEDI("ОбработчикСогласияПерезаполненияТЧ", ЭтаФорма, , ТекстВопроса, КнопкиВопроса);
		
	Иначе
		ОбработчикСогласияЗаполнения();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыДляПодготовкиСообщения(ТипСообщения, ДопПараметры = Неопределено)
	
	СтруктураПараметры = Новый Структура;
	
	СтруктураПараметры.Вставить("Сообщение", 				Сообщение);
	СтруктураПараметры.Вставить("Отправитель", 				Отправитель);
	СтруктураПараметры.Вставить("Получатель", 				Получатель);
	СтруктураПараметры.Вставить("Покупатель", 				Покупатель); 
	СтруктураПараметры.Вставить("Продавец", 				Продавец);
	СтруктураПараметры.Вставить("Партнер", 					Получатель);
	СтруктураПараметры.Вставить("ДатаНачалаПериода", 		ДатаНачалаПериода);
	СтруктураПараметры.Вставить("ДатаОкончанияПериода", 	ДатаОкончанияПериода);
	СтруктураПараметры.Вставить("ТипЦен", 					ТипЦен);
	СтруктураПараметры.Вставить("ЦенаВключаетНДС", 			ЦенаВключаетНДС);
	СтруктураПараметры.Вставить("ОбязателенGTIN",			ОбязателенGTIN);
	СтруктураПараметры.Вставить("Валюта", 					Валюта);
	СтруктураПараметры.Вставить("НомерДоговора", 			НомерДоговора);
	СтруктураПараметры.Вставить("ДатаДоговора", 			ДатаДоговора);
	СтруктураПараметры.Вставить("Склад",                         Склад);
    СтруктураПараметры.Вставить("ВыгружатьОстаткиВПрайсЛист",    ВыгружатьОстаткиВПрайсЛист);
	
	ТолькоОбновить = ДопПараметры <> Неопределено И ДопПараметры.Свойство("ТолькоОбновить") И ДопПараметры.ТолькоОбновить = Истина;
	
	Если ТолькоОбновить Тогда  		
		ТабТовары = РеквизитФормыВЗначение("Товары");  		
		СтруктураПараметры.Вставить("Номенклатура", ТабТовары.ВыгрузитьКолонку("Номенклатура"));  		
	Иначе      		
		СтруктураПараметры.Вставить("Номенклатура", Неопределено); 		
	КонецЕсли;
	
	Если ТипСообщения = "PRICELIST" Тогда
		
		СтруктураПараметры.Вставить("СтатусТовараПоУмолчанию", 	СтатусТовараПоУмолчанию);
		СтруктураПараметры.Вставить("НомерПрайсЛиста", 			СокрЛП(НомерПрайсЛиста));
		СтруктураПараметры.Вставить("Комментарий", 				Комментарий);
		СтруктураПараметры.Вставить("ТипПрайсЛиста", 			СокрЛП(ТипПрайсЛиста));
		
	ИначеЕсли ТипСообщения = "INVRPT" Тогда 
		СтруктураПараметры.Вставить("ДатаИнвентаризации", 		ДатаИнвентаризации);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПереотправляемоеСообщениеСсылка) Тогда
		СтруктураПараметры.Вставить("ПереотправляемоеСообщениеСсылка", ПереотправляемоеСообщениеСсылка);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СообщениеСсылка) Тогда
		СтруктураПараметры.Вставить("СообщениеСсылка", СообщениеСсылка);	
	КонецЕсли;
	
	Если ДопПараметры <> Неопределено 
		И ТипЗнч(ДопПараметры) = Тип("Структура") Тогда
		Для каждого Эл Из ДопПараметры Цикл
			СтруктураПараметры.Вставить(Эл.Ключ, Эл.Значение);		
		КонецЦикла;
	КонецЕсли;
	
	Если Не РежимНастройкиРасписанияАвтоотправки = Истина Тогда
		СтруктураПараметры.Вставить("Особенности", РеквизитФормыВЗначение("Особенности"));
		СтруктураПараметры.Вставить("ЭтаФорма", ЭтаФорма);
	КонецЕсли;
	
	Возврат СтруктураПараметры;
	
КонецФункции	

&НаКлиенте
Процедура ЗаполнитьТоварыКлиент(ТипСообщения, ДопПараметры = Неопределено)

	Результат = ЗаполнитьТоварыСервер(ТипСообщения, ДопПараметры);
	
	Если НЕ Результат.Успешно Тогда		
		ПодготовитьВывестиПредупреждениеПользователю(Результат.ОписаниеОшибки);
	КонецЕсли;
	
	ОбновитьНомераСтрокКлиент();
	
	Обновить_ИнформациюОбОшибках();

КонецПроцедуры

&НаСервере
Функция ЗаполнитьТоварыСервер(ТипСообщения, ДопПараметры = Неопределено)
	
	СохранитьНастройкиЗаполнения();
	
	Результат = Новый Структура("Успешно, ОписаниеОшибки", Ложь, "");
		
	СтруктураПараметры = ПолучитьПараметрыДляПодготовкиСообщения(ТипСообщения, ДопПараметры);
	РезультатПолучения = МодульОбъекта().ПолучитьТоварыДляНезависимогоСообщения(ТипСообщения, СтруктураПараметры);
	
	ДобавлениеНоменклатуры = Ложь;
	ПеревыборНоменклатуры = Ложь;
    
	Если ДопПараметры <> Неопределено Тогда
		
		ДопПараметры.Свойство("ПеревыборНоменклатуры"	, ПеревыборНоменклатуры);
		ДопПараметры.Свойство("ДобавлениеНоменклатуры"	, ДобавлениеНоменклатуры);
		
	КонецЕсли;

	Если НЕ ДобавлениеНоменклатуры И НЕ ПеревыборНоменклатуры Тогда
		Товары.Очистить();
	КонецЕсли;
	
	Если РезультатПолучения.Успешно Тогда
		
		Если ПеревыборНоменклатуры Тогда
			
			ОбновитьДанныеСтрокиТаблицыТоваров(ДопПараметры, РезультатПолучения.Товары);
			
		Иначе
			
			Для каждого Стр Из РезультатПолучения.Товары Цикл
				
				НоваяСтрока = Товары.Добавить();	
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
				
				ПересчитатьСтрокуТоваров(НоваяСтрока);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Результат, РезультатПолучения);
	
	Возврат Результат;

КонецФункции // ЗаполнитьТоварыСервер()

&НаСервере
Функция СписокСвойствСтроки_КонтурEDI(ИсключаяСвойства = Неопределено)

	СписокСвойств = "Номенклатура,ХарактеристикаНоменклатуры,ЕдиницаИзмерения,КодЕдиницыИзмеренияEDI,КоэффициентEDIВ1С";
	
	МассивСвойств = МодульОбъекта().КонтурСтандарт_РазложитьСтрокуВМассивСлов(СписокСвойств, ",");	
	
	Массив = Новый Массив;
	
	Для каждого Элемент Из МассивСвойств Цикл 		
		
		Если Найти(ИсключаяСвойства, Элемент) > 0 Тогда
			Продолжить;	
		КонецЕсли;
		
		Массив.Добавить(Элемент);
		
	КонецЦикла;
	
	Возврат МодульОбъекта().КонтурСтандарт_СтрСоединить_(Массив, ",");
	
КонецФункции

&НаСервере
Процедура ОбновитьДанныеСтрокиТаблицыТоваров(ДополнительныеПараметры, ТаблицаТоваров)
	
	ТекСтрокаТаблицы = ДополнительныеПараметры.СтрокаТаблицы;
	ДанныеСоответствия = ДополнительныеПараметры.ДанныеСоответствия;
	
	ПараметрыОтбора = ПараметрыОтбораСтрокПоСоответствию_КонтурEDI(ТекСтрокаТаблицы, ДанныеСоответствия);
	
	МассивСтрок = ТаблицаТоваров.НайтиСтроки(ПараметрыОтбора);
	
	СписокСвойств = СписокСвойствСтроки_КонтурEDI();
	
	Для каждого Стр Из МассивСтрок Цикл
		
		Если Направление = "Входящее" Тогда
			
			ЗаполнитьЗначенияСвойств(ТекСтрокаТаблицы, Стр, СписокСвойств);
			
			ТекСтрокаТаблицы.КодТовараПокупателя = Стр.КодТовараПоставщика;
			
		Иначе
			ЗаполнитьЗначенияСвойств(ТекСтрокаТаблицы, Стр);
		КонецЕсли;                         
		
		Если ТекСтрокаТаблицы.ЕдиницаИзмерения <> ДанныеСоответствия.ЕдиницаИзмерения Тогда
			
			СвойстваСоответствия = СписокСвойствСтроки_КонтурEDI("Номенклатура,ХарактеристикаНоменклатуры");
			
			ЗаполнитьЗначенияСвойств(ТекСтрокаТаблицы, ДанныеСоответствия, СвойстваСоответствия);
			
		КонецЕсли;
		
		ПересчитатьСтрокуТоваров(ТекСтрокаТаблицы);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПараметрыОтбораСтрокПоСоответствию_КонтурEDI(СтрокаТаблицы, ДанныеСоответствия)
	
	Результат = Новый Структура;
	Результат.Вставить("GTIN"			, СтрокаТаблицы.GTIN);
	Результат.Вставить("Номенклатура"	, ДанныеСоответствия.Номенклатура);
		
	Если Направление = "Входящее" Тогда 
		Результат.Вставить("КодТовараПокупателя", СтрокаТаблицы.КодТовараПоставщика);
	Иначе
		Результат.Вставить("КодТовараПокупателя", СтрокаТаблицы.КодТовараПокупателя);	
	КонецЕсли;
	
	Если ДанныеСоответствия.ХарактеристикаНоменклатуры <> Неопределено Тогда			
		Результат.Вставить("ХарактеристикаНоменклатуры", ДанныеСоответствия.ХарактеристикаНоменклатуры);			
	КонецЕсли;
	
	Если СтрокаТаблицы.ЕдиницаИзмерения = ДанныеСоответствия.ЕдиницаИзмерения Тогда
		Результат.Вставить("ЕдиницаИзмерения", ДанныеСоответствия.ЕдиницаИзмерения);	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПересчитатьСтрокуТоваров(Строка = Неопределено, ИдентификаторТекСтроки = Неопределено, ПересчитыватьКоличество = Истина, ОбратныйПересчет = Ложь)
	
	СтрокаДляПересчета = Неопределено;
	
	Если НЕ ИдентификаторТекСтроки = Неопределено Тогда
		СтрокаДляПересчета = Товары.НайтиПоИдентификатору(ИдентификаторТекСтроки);
	ИначеЕсли Не Строка = Неопределено Тогда
		СтрокаДляПересчета = Строка;	
	Иначе
		Возврат;
	КонецЕсли;	
	
	Если Сообщение.Направление = "Входящее" Тогда
		НаправлениеПересчета = "В1С";
	Иначе
		НаправлениеПересчета = "ВEDI";
	КонецЕсли;
	
	Если ОбратныйПересчет Тогда
		Если НаправлениеПересчета = "ВEDI" Тогда
			НаправлениеПересчета = "В1С";
		Иначе
			НаправлениеПересчета = "ВEDI";
		КонецЕсли;
	КонецЕсли;
	
	МодульОбъекта().ПересчитатьСтрокуТоваровНезависимогоСообщения(СтрокаДляПересчета, НаправлениеПересчета, ПересчитыватьКоличество);
			
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиЗаполнения()

	КлючОбъекта  = "КонтурEDI/НастройкиЗаполненияНезависимогоСообщения";
	КлючНастроек = ТипСообщения + "/" + СтрЗаменить(ПредставлениеПолучателя, """", "");
	
	ХранилищеОбщихНастроек.Сохранить(КлючОбъекта, КлючНастроек, ПолучитьСтруктуруНастроекДляСохранения());

КонецПроцедуры

&НаСервере
Процедура ВосстановитьНастройкиЗаполнения()

	КлючОбъекта  = "КонтурEDI/НастройкиЗаполненияНезависимогоСообщения";
	КлючНастроек = ТипСообщения + "/" + СтрЗаменить(ПредставлениеПолучателя, """", "");
	
	НастройкиДляВосстановления = Неопределено;
    НастройкиДляВосстановления = ХранилищеОбщихНастроек.Загрузить(КлючОбъекта, КлючНастроек);

	Если НЕ НастройкиДляВосстановления = Неопределено Тогда
		Для каждого Эл Из НастройкиДляВосстановления Цикл
			Если ЗначениеЗаполнено(Эл.Значение) И Найти(Строка(Эл.Значение),"Объект не найден") = 0  Тогда
				ЭтаФорма[Эл.Ключ] = Эл.Значение;
			КонецЕсли;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ТипЦен) Тогда
			ТипЦенОбработкаВыбораСервер(ТипЦен);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктуруНастроекДляСохранения()
	
	СтруктураНастроек = Новый Структура;
	
	СтруктураНастроек.Вставить("Отправитель", 		Отправитель);
	СтруктураНастроек.Вставить("Получатель", 		Получатель);
	СтруктураНастроек.Вставить("Покупатель", 		Покупатель);
	СтруктураНастроек.Вставить("Продавец", 			Продавец);
	СтруктураНастроек.Вставить("ТипЦен", 			ТипЦен);
	СтруктураНастроек.Вставить("НомерДоговора", 	НомерДоговора);
	СтруктураНастроек.Вставить("ДатаДоговора", 		ДатаДоговора);
	
	Если ТипСообщения = "PRICELIST" ИЛИ ТипСообщения = "PRICAT" Тогда
		СтруктураНастроек.Вставить("СтатусТовараПоУмолчанию", 	СтатусТовараПоУмолчанию);
	КонецЕсли;
	
	Возврат СтруктураНастроек;
	
КонецФункции

