&НаКлиенте
Процедура Метрика_ОбновлениеМодуля(КонтекстОбновленияМодуля, ТекстОшибки = "", ТипОбновления = "Полуавтоматически") Экспорт
	
	// Метод присутствует в клиентском и серверном модулях
	
	НоваяМетрика = НоваяМетрика();
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		НоваяМетрика = НоваяМетрика.Ошибка("АвтообновлениеМодуля", ТекстОшибки);
	Иначе
		НоваяМетрика = НоваяМетрика.Информация("АвтообновлениеМодуля", "");
	КонецЕсли;
	
	Переменные = Новый Соответствие;
	Переменные.Вставить("НоваяВерсия"	, КонтекстОбновленияМодуля.НоваяВерсия);
	Переменные.Вставить("СтараяВерсия"	, КонтекстОбновленияМодуля.Версия);
	Переменные.Вставить("ТипОбновления" , ТипОбновления);
	
	Для Каждого КлючЗначение Из КонтекстОбновленияМодуля Цикл
		
		Переменные.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		
	КонецЦикла;
	
	НоваяМетрика.ДобавитьПеременные(Метрика_ИзвлечьИзВХ("КонтекстМодуля"));
	
	Для Каждого Переменная Из Переменные Цикл
		НоваяМетрика = НоваяМетрика.ДобавитьПеременную(Переменная.Ключ, Переменная.Значение);
	КонецЦикла;                      
	
	НоваяМетрика.Отправить();
	
КонецПроцедуры

// РАБОТА С ФАЙЛАМИ {

&НаКлиенте
Процедура ОткрытьДиалогВыбораФайла_КонтурEDI(ИмяОбработчика,
												КонтекстОбработчика,
												ПараметрыОбработчика = Неопределено,
												МножественныйВыбор = Ложь,
												Фильтр = Неопределено, 
												Заголовок = Неопределено, 
												РежимДиалога = Неопределено, 
												ПолучаемыеФайлы = Неопределено)  Экспорт
	
	Если РежимДиалога = Неопределено Тогда
		РежимДиалога = РежимДиалогаВыбораФайла.Открытие;
	КонецЕсли;
	
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(РежимДиалога);
	
	ДиалогОткрытияФайла.МножественныйВыбор    = МножественныйВыбор;
	ДиалогОткрытияФайла.Фильтр                = Фильтр; 
	ДиалогОткрытияФайла.Заголовок             = Заголовок;
	
	Если ТипЗнч(ПараметрыОбработчика) = Тип("Структура") Тогда
		ПараметрыОбработчика.Вставить("ДиалогВыбораФайла", ДиалогОткрытияФайла);
	Иначе
		ПараметрыОбработчика = Новый Структура("ДиалогВыбораФайла", ДиалогОткрытияФайла);
	КонецЕсли;
	
	ЭтоРежимПолученияФайлов = ПолучаемыеФайлы <> Неопределено И РежимДиалога <> РежимДиалогаВыбораФайла.Открытие;
	
	ИсполняемыеОператоры = Новый Структура;
	ИсполняемыеОператоры.Вставить("НачатьПолучениеФайлов"	, "НачатьПолучениеФайлов(ОписаниеОповещения, ПолучаемыеФайлы, ДиалогОткрытияФайла, Истина);");
	ИсполняемыеОператоры.Вставить("НачатьПомещениеФайлов"	, "НачатьПомещениеФайлов(ОписаниеОповещения, ДиалогОткрытияФайла, Истина, УникальныйИдентификатор);");
	
	Если ПараметрыКлиентСервер.МодальностьЗапрещена Тогда
		
		Алгоритм = "ОписаниеОповещения = Новый ОписаниеОповещения(ИмяОбработчика, КонтекстОбработчика, ПараметрыОбработчика);" + Символы.ПС;
		Алгоритм = Алгоритм + ?(ЭтоРежимПолученияФайлов, ИсполняемыеОператоры.НачатьПолучениеФайлов, ИсполняемыеОператоры.НачатьПомещениеФайлов);
		
	Иначе
		
		Если ЭтоРежимПолученияФайлов Тогда
			ПолучитьФайлы(ПолучаемыеФайлы,, ДиалогОткрытияФайла, Истина);
		Иначе
			
			ПолучаемыеФайлы = Новый Массив;
			
			Если ДиалогОткрытияФайла.Выбрать() Тогда
				ОбработатьРезультатВыбораФайла(ПолучаемыеФайлы, ДиалогОткрытияФайла.ВыбранныеФайлы);
			КонецЕсли;
			
		КонецЕсли;
		
		Алгоритм = "КонтекстОбработчика." + ИмяОбработчика + "(ПолучаемыеФайлы, ПараметрыОбработчика);";
		
	КонецЕсли;
	
	Выполнить(Алгоритм);

КонецПроцедуры // ОткрытьДиалогВыбораФайла_КонтурEDI()

&НаКлиенте
Процедура ОбработатьРезультатВыбораФайла(ПолучаемыеФайлы, РезультатВыбораФайла)
	
	Для каждого ПутьКВыбранномуФайлу Из РезультатВыбораФайла Цикл
		
		ДвоичныеДанные				= Новый ДвоичныеДанные(ПутьКВыбранномуФайлу);
		АдресВоВременномХранилище	= ПоместитьВоВременноеХранилище(ДвоичныеДанные);
		
		ОписаниеФайла = Новый ОписаниеПередаваемогоФайла(ПутьКВыбранномуФайлу, АдресВоВременномХранилище);
		
		ПолучаемыеФайлы.Добавить(ОписаниеФайла);
		
	КонецЦикла;
	
КонецПроцедуры

//Для получения пути выбранного файла без помещения во временное хранилище
&НаКлиенте
Процедура ВыбратьФайл_КонтурEDI(ИмяОбработчика,
								КонтекстОбработчика,
								РежимДиалога,
								Заголовок = "",
								НачальноеИмя = "",
								Фильтр = Неопределено,
								МножественныйВыбор = Ложь,
								Расширение = "",
								ДопПараметры = Неопределено) Экспорт
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалога);
	ДиалогВыбораФайла.ПолноеИмяФайла = НачальноеИмя;
	ДиалогВыбораФайла.Заголовок = Заголовок;
	ДиалогВыбораФайла.Фильтр = Фильтр;
	ДиалогВыбораФайла.МножественныйВыбор = МножественныйВыбор;
	ДиалогВыбораФайла.Расширение = Расширение;
	
	Если ПараметрыКлиентСервер.МодальностьЗапрещена Тогда
		Алгоритм = "ДиалогВыбораФайла.Показать(Новый ОписаниеОповещения(""" + ИмяОбработчика + """, КонтекстОбработчика, ДопПараметры))";
		Выполнить(Алгоритм);
	Иначе
		Если ДиалогВыбораФайла.Выбрать() Тогда	
			Алгоритм = "КонтекстОбработчика." + ИмяОбработчика + "(ДиалогВыбораФайла.ПолноеИмяФайла, ДопПараметры)";
			Выполнить(Алгоритм);
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Функция ВернутьКаталогВыбранногоФайл_КонтурEDI(Знач ИмяФайла)  Экспорт

    Каталог = "";
    
    ПутьКФайлуРазложенныйВМассив = EDI_РазложитьСтрокуВМассивСлов(ИмяФайла, "\");
    
    КоличествоЧастейПути = ПутьКФайлуРазложенныйВМассив.Количество();
    
    Если КоличествоЧастейПути > 0 Тогда 
        
        ИндексПоследнейЧасти = КоличествоЧастейПути-1;
        
        ПутьКФайлуРазложенныйВМассив.Удалить(ИндексПоследнейЧасти); 
        
        Для каждого ЧастьПути Из ПутьКФайлуРазложенныйВМассив Цикл
            Каталог = Каталог + ЧастьПути+"\";
        КонецЦикла;
    КонецЕсли;
    
    Возврат Каталог ;
     
КонецФункции // ВернутьКаталогВыбранногоФайл_КонтурEDI()

&НаКлиенте
Процедура ФайлСуществует_КонтурEDI(ИмяОбработчика,КонтекстОбработчика,Знач ПутьКФайлу,ПараметрыОбработчика = Неопределено) Экспорт
    
    Файл = Новый Файл(ПутьКФайлу);
    Если ПараметрыКлиентСервер.МодальностьЗапрещена Тогда
        Алгоритм =                 "ОписаниеОповещения = Новый ОписаниеОповещения(ИмяОбработчика, КонтекстОбработчика,ПараметрыОбработчика);" + Символы.ПС;
        Алгоритм = Алгоритм +     "Файл.НачатьПроверкуСуществования(ОписаниеОповещения);"; 
    Иначе         
        Алгоритм = "КонтекстОбработчика." + ИмяОбработчика + "(Файл.Существует(), ПараметрыОбработчика);";
    КонецЕсли;
    
    Выполнить(Алгоритм);
    
КонецПроцедуры  

