Функция ОбщийМодуль1С_КонтурEDI(Имя) Экспорт
	
	КлючКЭШ = "ОбщийМодуль1С_" + Имя;
	
	Модуль = Кэш_Прочитать(КлючКЭШ);
	
	Если Модуль = Неопределено Тогда
		
		Попытка
			
			Модуль = Вычислить(Имя);
			
		Исключение
			
			Модуль = Неопределено;
			
		КонецПопытки;
		
		Кэш_Поместить(КлючКЭШ, Модуль);
		
	КонецЕсли;
		
	Возврат Модуль;
	
