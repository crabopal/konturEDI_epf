&НаКлиенте
Функция Криптография_Расшифровать(ИсходныеДанные, Сертификат = Неопределено, ПарольДоступаКЗакрытомуКлючу = Неопределено) Экспорт
	
	Результат = КриптографияПереопределяемый_Расшифровать(ИсходныеДанные, Сертификат, ПарольДоступаКЗакрытомуКлючу);
	
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВариантыНастройки = Криптография_ВариантыНастройкиПоТипуПлатформы();
	
	Для Каждого ВариантНастройки Из ВариантыНастройки Цикл
		
		Попытка	
			
			Результат = Криптография_РасшифроватьКонтент(ИсходныеДанные, Сертификат, ПарольДоступаКЗакрытомуКлючу, ВариантНастройки);
			
			Прервать;
			
		Исключение  
			
			ТекстОшибки = ОписаниеОшибки();
			
			Если ВариантыНастройки.Найти(ВариантНастройки) = ВариантыНастройки.ВГраница() 
				ИЛИ Криптография_ЕстьБлокирующиеОшибки(ТекстОшибки) Тогда
				ВызватьИсключение ТекстОшибки;	
			КонецЕсли;
			
			ВариантНастройкиИзТекстаОшибки = Криптография_ОбработатьВариантНастройкиИзТекстаОшибки(ТекстОшибки);
			
			Если НЕ ВариантНастройкиИзТекстаОшибки = Неопределено Тогда
				Результат = Криптография_РасшифроватьКонтент(ИсходныеДанные, Сертификат, ПарольДоступаКЗакрытомуКлючу, ВариантНастройкиИзТекстаОшибки);   
				Прервать;	
			КонецЕсли;
			
		КонецПопытки;		
		
	КонецЦикла; 	 
	
	Возврат Результат;
	
КонецФункции 

&НаКлиенте
Функция Криптография_НайтиПоОтпечатку(Отпечаток) Экспорт
	
	ПараметрыПоиска = Криптография_ПараметрыПоискаСертификатов();
	
	Сертификат = Криптография_ПолучитьДанныеСертификата(Отпечаток, ПараметрыПоиска);
		
	Возврат Сертификат;
	
КонецФункции

&НаКлиенте
Функция Криптография_Подписать(ИсходныеДанные, ОтпечатокСертификата, ПарольДоступаКЗакрытомуКлючу = "") Экспорт
		
	Результат = КриптографияПереопределяемый_Подписать(ИсходныеДанные, ОтпечатокСертификата, ПарольДоступаКЗакрытомуКлючу);
	
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	МенеджерНастроек = Криптография_МенеджерНастроек();
	
	// Получаем сертификат	
	СтруктураСертификата = Криптография_НайтиПоОтпечатку(ОтпечатокСертификата);	
	СертификатКриптографии = Новый СертификатКриптографии(СтруктураСертификата.ДвоичныеДанные);
	
	ОтпечатокСертификатаСтрокой = СтруктураСертификата.Отпечаток;
	
	ВариантыНастройки = Криптография_ВариантыНастройкиПоТипуПлатформы();
	
	ВариантНастройкиСертификата = МенеджерНастроек.ВариантыНастройкиСертификатов.Получить(ОтпечатокСертификатаСтрокой);
	
	Если НЕ ВариантНастройкиСертификата = Неопределено Тогда
		ВариантыНастройки.Вставить(0, ВариантНастройкиСертификата);	
	КонецЕсли;
	
	Для Каждого ВариантНастройки Из ВариантыНастройки Цикл
		
		Попытка	
			
			Результат = Криптография_ПодписатьКонтент(ИсходныеДанные, СертификатКриптографии, ПарольДоступаКЗакрытомуКлючу, ВариантНастройки);
			
			МенеджерНастроек.ВариантыНастройкиСертификатов.Вставить(ОтпечатокСертификатаСтрокой, ВариантНастройки);
			
			Прервать;
			
		Исключение  
			
			ТекстОшибки = ОписаниеОшибки();
			
			Если ВариантыНастройки.Найти(ВариантНастройки) = ВариантыНастройки.ВГраница() 
				ИЛИ Криптография_ЕстьБлокирующиеОшибки(ТекстОшибки) Тогда
				ВызватьИсключение ТекстОшибки;	
			КонецЕсли;
			
			ВариантНастройкиИзТекстаОшибки = Криптография_ОбработатьВариантНастройкиИзТекстаОшибки(ТекстОшибки);
			
			Если НЕ ВариантНастройкиИзТекстаОшибки = Неопределено Тогда
				Результат = Криптография_ПодписатьКонтент(ИсходныеДанные, СертификатКриптографии, ПарольДоступаКЗакрытомуКлючу, ВариантНастройкиИзТекстаОшибки);   
				МенеджерНастроек.ВариантыНастройкиСертификатов.Вставить(ОтпечатокСертификатаСтрокой, ВариантНастройкиИзТекстаОшибки);
				Прервать;	
			КонецЕсли;
			
		КонецПопытки;		
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Криптография_ПолучитьСертификатыДляПодписиШифрования(ТолькоДействующие = Истина) Экспорт
	
	Результат = Новый Массив;
	
	ПараметрыПоиска = Криптография_ПараметрыПоискаСертификатов();
	
	ХранилищеСертификатовКриптографии = Криптография_ПолучитьХранилищеСертификатов(ПараметрыПоиска.Тип, ПараметрыПоиска.Расположение);
	
	КоллекцияСертификатовХранилища = ХранилищеСертификатовКриптографии.ПолучитьВсе();
	
	Для Каждого Сертификат Из КоллекцияСертификатовХранилища Цикл
		
		Если Сертификат.ИспользоватьДляПодписи = Ложь 
			ИЛИ Сертификат.ИспользоватьДляШифрования = Ложь Тогда
			Продолжить;	
		КонецЕсли;
		
		Если ТолькоДействующие
			И КонецДня(Сертификат.ДатаОкончания) < ТекущаяДата() Тогда
			Продолжить;
		КонецЕсли;
		
		РеквизитыСертификата = Криптография_НовыйОписаниеСертификата(Сертификат);
		Результат.Добавить(РеквизитыСертификата);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

