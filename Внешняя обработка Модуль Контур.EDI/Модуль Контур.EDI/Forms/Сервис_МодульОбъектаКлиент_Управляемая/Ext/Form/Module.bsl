КонецПроцедуры

&НаКлиенте
Функция ПостроительСхем_ПолучитьСхему(ХранилищеСхем, Имя)  
	
	ПолученнаяСхема = ХранилищеСхем.Получить(Имя);
	
	Если ПолученнаяСхема = Неопределено Тогда
		
		ВызватьИсключение "Указанной схемы " + Имя + " не существует в хранилище схем";
		
	КонецЕсли;
	
	Возврат КонтурСтандарт_СкопироватьРекурсивно(ПолученнаяСхема);
	
КонецФункции

&НаКлиенте
Функция ПостроительСхем_ПривестиПоСхеме(ХранилищеСхем, Схема, ОбъектКонвертации = Неопределено, ЛокальныеИмена = Ложь) Экспорт
	
	СоздаваемыйОбъект = Неопределено;
	
	Если ТипЗнч(Схема) = Тип("Строка") Тогда
		СхемаДляРаботы = ПостроительСхем_ПолучитьСхему(ХранилищеСхем, Схема);	
	Иначе
		СхемаДляРаботы = КонтурСтандарт_СкопироватьРекурсивно(Схема);	
	КонецЕсли;
		
	Если СхемаДляРаботы.Свойство("__Ссылка") Тогда 
		СхемаДляРаботы = ПостроительСхем_ПолучитьСхему(ХранилищеСхем, СхемаДляРаботы.__Ссылка);	
	КонецЕсли; 	
		
	ОписаниеТипа = Новый ОписаниеТипов(СхемаДляРаботы.Тип);
		
	СоздаваемыйОбъект = ОписаниеТипа.ПривестиЗначение();
	
	Если СхемаДляРаботы.Тип = "Структура" Тогда
		
		Для Каждого Свойство Из СхемаДляРаботы.Свойства Цикл
			
			СоставСвойства = Свойство.Значение;
			
			Если ЛокальныеИмена 
				И СоставСвойства.Свойство("ЛокальноеИмя") 
				И НЕ ПустаяСтрока(СоставСвойства.ЛокальноеИмя) Тогда 
				
				ИмяСвойства = СоставСвойства.ЛокальноеИмя;
				
			Иначе
				
				ИмяСвойства = Свойство.Ключ;

			КонецЕсли;
			
			ЗначениеСвойства = Неопределено;	
			
			Если ОбъектКонвертации = Неопределено Тогда 
				Если СоставСвойства.Свойство("ПоУмолчанию") Тогда
					
					ЗначениеСвойства = СоставСвойства.ПоУмолчанию; 
					
				Иначе      
					
					ЗначениеСвойства = ПостроительСхем_ПривестиПоСхеме(ХранилищеСхем, СоставСвойства, Неопределено, ЛокальныеИмена);
	
				КонецЕсли;
			Иначе  
				
				Если НЕ ПустаяСтрока(СоставСвойства.ЛокальноеИмя) И ОбъектКонвертации.Свойство(СоставСвойства.ЛокальноеИмя) Тогда
					
					ЗначениеСвойства = ПостроительСхем_ПривестиПоСхеме(ХранилищеСхем, СоставСвойства, ОбъектКонвертации[СоставСвойства.ЛокальноеИмя], ЛокальныеИмена);
					
				ИначеЕсли ОбъектКонвертации.Свойство(Свойство.Ключ) Тогда
					
					ЗначениеСвойства = ПостроительСхем_ПривестиПоСхеме(ХранилищеСхем, СоставСвойства, ОбъектКонвертации[Свойство.Ключ], ЛокальныеИмена);
					
				Иначе
					
					ЗначениеСвойства = ПостроительСхем_ПривестиПоСхеме(ХранилищеСхем, СоставСвойства, Неопределено, ЛокальныеИмена);
					
				КонецЕсли; 
				
			КонецЕсли;
			
			СоздаваемыйОбъект.Вставить(ИмяСвойства, ЗначениеСвойства);
			
		КонецЦикла;
		
		
	ИначеЕсли СхемаДляРаботы.Тип = "Массив" Тогда
		
		Если ОбъектКонвертации = Неопределено Тогда
			
		Иначе
			
			Для Каждого Элемент Из ОбъектКонвертации Цикл
				
				СозданныйЭлемент = ПостроительСхем_ПривестиПоСхеме(ХранилищеСхем, СхемаДляРаботы.ЭлементыМассива, Элемент, ЛокальныеИмена);
				
				Если НЕ СозданныйЭлемент = Неопределено Тогда
					
					СоздаваемыйОбъект.Добавить(СозданныйЭлемент); 
					
				КонецЕсли;
			
			КонецЦикла; 
			
		КонецЕсли;
		
	ИначеЕсли Найти("Число,Строка,Булево,Неопределено", СхемаДляРаботы.Тип) Тогда
		
		Если ОбъектКонвертации = Неопределено Тогда       
			
		Иначе
			
			Если СхемаДляРаботы.Свойство("Перечисление")   Тогда
				
				Если НЕ ПустаяСтрока(ОбъектКонвертации) И СхемаДляРаботы.Перечисление.Найти(ОбъектКонвертации) <> Неопределено Тогда  
					
					СоздаваемыйОбъект = ОбъектКонвертации;
					
				Иначе
							
					СоздаваемыйОбъект = Неопределено;	
					
				КонецЕсли;
				
			Иначе
				
				СоздаваемыйОбъект = ОбъектКонвертации; 
				
			КонецЕсли;	
			
		КонецЕсли;
		
	ИначеЕсли СхемаДляРаботы.Тип = Неопределено Тогда
		
		СоздаваемыйОбъект = ОбъектКонвертации;
		
	КонецЕсли;
	
	Возврат СоздаваемыйОбъект;
	
КонецФункции

&НаКлиенте
Процедура ПостроительСхем_ДобавитьСвойство(Схема, ВложеннаяСхема, Имя, ЛокальноеИмя = Неопределено, ПоУмолчанию = Неопределено, ЭлементыМассива = Неопределено) Экспорт
	
	ВложеннаяСхема = ПостроительСхем_НовыйСхема(ВложеннаяСхема);
	
	Если ЛокальноеИмя <> Неопределено Тогда         
		
		ВложеннаяСхема.Вставить("ЛокальноеИмя", ЛокальноеИмя); 
		
	КонецЕсли;                       
	
	Если ЭлементыМассива <> Неопределено Тогда   
		
		ВложеннаяСхема.Вставить("ЭлементыМассива", ПостроительСхем_НовыйСхема(ЭлементыМассива));
		
	КонецЕсли;
	
	Если ПоУмолчанию <> Неопределено Тогда  
		
		ВложеннаяСхема.Вставить("ПоУмолчанию", ПоУмолчанию);
		
	КонецЕсли;
	
	ФиксированнаяВложеннаяСхема = Новый ФиксированнаяСтруктура(ВложеннаяСхема); 	
	
	Схема.Свойства.Вставить(Имя, ФиксированнаяВложеннаяСхема);
	
КонецПроцедуры

&НаКлиенте
Функция ПостроительСхем_НовыйСхема(Тип = Неопределено, Перечисление = Ложь) Экспорт
	
	Схема = Новый Структура;
	
	Схема.Вставить("Тип", Тип);
	
	Если Тип = "Структура" Тогда  
		
		Схема.Вставить("Свойства", Новый Соответствие);	
		Схема.Вставить("Обязательны", Новый Массив);
		
	ИначеЕсли Тип = "Массив" Тогда
		
		Схема.Вставить("ЭлементыМассива");
		
	ИначеЕсли Найти("Число,Булево,Строка,Неопределено",Тип) = 0 Тогда
		
		Схема.Удалить("Тип");
		Схема.Вставить("__Ссылка", Тип);     
		
	ИначеЕсли Найти("Число,Булево,Строка,Неопределено",Тип) Тогда
		
		Если Перечисление Тогда
			Схема.Вставить("Перечисление", Новый Массив);	
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Схема;	
	
КонецФункции

