// Функция создает новый отбор компоновки данных
//
// Возвращаемое значение:
//   ОтборКомпоновкиДанных - Созданный отбор компоновки данных
&НаКлиенте
Функция КонтурСКД_НовыйОтборКомпоновкиДанных() Экспорт
	
	Попытка
		Отбор = Новый(Тип("ОтборКомпоновкиДанных"));
	Исключение
		КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
		Отбор = КомпоновщикНастроек.Настройки.Отбор;
	КонецПопытки;

	Возврат Отбор;
	
КонецФункции

// Функция создает новый элемент отбора компоновки данных.
//
// Параметры:
//   ОтборКомопновки - ОтборКомпоновкиДанных - Отбор компоновки данных, в который добавляется элемент отбора
//   ЛевоеЗначение - ПолеКомпоновкиДанных, Строка - Левое значение отбора, можно указать поле компоновки или путь к данным
//   ПравоеЗначение - Произвольный - Правое значение отбора
//   ВидСравнения - ВидСравненияКомпоновкиДанных - Вид сравнения отбора, по умолчанию будет установлено Равно или ВСписке (при указании коллекции в правом значении)
//
// Возвращаемое значение:
//   ЭлементОтбораКомпоновкиДанных - Созданный элемент отбора компоновки данных
&НаКлиенте
Функция КонтурСКД_НовыйЭлементОтбораКомпоновки(ОтборКомопновки, ЛевоеЗначение = Неопределено, ПравоеЗначение = Неопределено, ВидСравнения = Неопределено) Экспорт
	
	ЭлементОтбора = ОтборКомопновки.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	
	Если ЛевоеЗначение <> Неопределено Тогда
		Если ТипЗнч(ЛевоеЗначение) = Тип("ПолеКомпоновкиДанных") Тогда
			ЭлементОтбора.ЛевоеЗначение = ЛевоеЗначение;
		Иначе
			ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ЛевоеЗначение);
		КонецЕсли;
	КонецЕсли;
	
	ЭлементОтбора.ПравоеЗначение = ПравоеЗначение;
			
	Если ВидСравнения = Неопределено Тогда
		
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		
		Если ТипЗнч(ПравоеЗначение) = Тип("Массив") ИЛИ ТипЗнч(ПравоеЗначение) = Тип("СписокЗначений") Тогда
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		КонецЕсли;
		
	Иначе
		ЭлементОтбора.ВидСравнения = ВидСравнения;
	КонецЕсли;
	
	Возврат ЭлементОтбора;
	
КонецФункции

// Функция создает новую группу отбора компоновки данных.
//
// Параметры:
//   ОтборКомпоновки - ОтборКомпоновкиДанных - Отбор компоновки данных, в который добавляется группа отбора
//   ТипГруппы - ТипГруппыЭлементовОтбораКомпоновкиДанных - Тип группы отбора
//
// Возвращаемое значение:
//   ГруппаЭлементовОтбораКомпоновкиДанных - Созданная группа отбора компоновки данных
&НаКлиенте
Функция КонтурСКД_НоваяГруппаОтбораКомпоновки(ОтборКомпоновки, ТипГруппы = Неопределено) Экспорт
	
	ГруппаОтбора = ОтборКомпоновки.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));	
	
	Если ТипГруппы <> Неопределено Тогда
		ГруппаОтбора.ТипГруппы = ТипГруппы;
	КонецЕсли;
	
	Возврат ГруппаОтбора;
	
КонецФункции

// Функция рекурсивно копирует отбор компоновки данных из одного объекта в другой.
//
// Параметры:
//   ОтборПриемник - ОтборКомпоновкиДанных - Отбор, в который будет скопированы данные из источника
//   ОтборИсточник - ОтборКомпоновкиДанных - Отбор, из которого будет скопированы данные в приемник 
&НаКлиенте
Процедура КонтурСКД_СкопироватьОтборКомпоновкиДанныхРекурсивно(ОтборПриемник, ОтборИсточник) Экспорт
	
	Для Каждого ЭлементИсточника Из ОтборИсточник.Элементы Цикл
		
		Если ТипЗнч(ЭлементИсточника) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			
			НовыйЭлементПриемника = КонтурСКД_НоваяГруппаОтбораКомпоновки(ОтборПриемник);
			ЗаполнитьЗначенияСвойств(НовыйЭлементПриемника, ЭлементИсточника);
			КонтурСКД_СкопироватьОтборКомпоновкиДанныхРекурсивно(НовыйЭлементПриемника, ЭлементИсточника);
			
		Иначе
			
			Если Не ЗначениеЗаполнено(ЭлементИсточника.ЛевоеЗначение) Тогда
				Продолжить;
			КонецЕсли;
			
			НовыйЭлементПриемника = КонтурСКД_НовыйЭлементОтбораКомпоновки(ОтборПриемник, ЭлементИсточника.ЛевоеЗначение, ЭлементИсточника.ПравоеЗначение);
			ЗаполнитьЗначенияСвойств(НовыйЭлементПриемника, ЭлементИсточника);
						
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
