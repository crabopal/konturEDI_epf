&НаКлиенте
Функция КонтурСтандарт_ЗначениеJSON(ЗначениеJSON)
	
	Значение = ЗначениеJSON;
	
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		
		Если Найти(Значение, "T")= 11 Тогда

			Попытка   
				
				Если КонтурСтандарт_ДоступныЗаписьЧтениеJSON() Тогда
					
					Значение = Вычислить("ПрочитатьДатуJSON(ЗначениеJSON, ФорматДатыJSON.ISO)");   
					
				Иначе
					
					Значение = КонтурСтандарт_КонвертироватьДатуISO(ЗначениеJSON);
					
				КонецЕсли; 
				
			Исключение   
				// не удалось конвертировать дату	
			КонецПопытки;
			
			
		КонецЕсли;
				
	КонецЕсли;  
	
	Возврат Значение;
	
КонецФункции

&НаКлиенте
Функция КонтурСтандарт_КонвертироватьДатуISO(Дата) Экспорт
		
	Если ПустаяСтрока(Дата) Тогда 
		АвтоконвертированнаяДата = Дата(1, 1, 1);
	Иначе
		Попытка
			АвтоконвертированнаяДата = XMLЗначение(Тип("Дата"), Дата);
			
			Миллисекунды = Сред(Дата, 21);
			Миллисекунды = СокрЛП(СтрЗаменить(Миллисекунды, "Z", ""));
			
			Если НЕ ПустаяСтрока(Миллисекунды) Тогда
				
				ЧислоМиллисекунд = Число(Миллисекунды);
				
				Если ЧислоМиллисекунд >= 500 Тогда
					
					АвтоконвертированнаяДата = АвтоконвертированнаяДата - 1;
					
				КонецЕсли;
				
			КонецЕсли;
		Исключение  
			ВызватьИсключение "Не удалось конвертировать дату ISO8601 в дату 1С"	
		КонецПопытки;
		
	КонецЕсли; 
		
	Возврат АвтоконвертированнаяДата;
	
КонецФункции 

&НаКлиенте
Функция КонтурСтандарт_ХешированиеFNV1A128(Знач Данные)
	
	Перем Хеш, Байт, Бит;
	
	_РежимОтладки = Ложь;
	
	Если _РежимОтладки Тогда
		FNV_size = Pow(2, 128);
		FNV_prime = 309485009821345068724781371;
		Хеш = 144066263297769815596495629667062367629;

		ДанныеСтроки = XMLСтрока(Данные);
		
		Для НомерСимвола = 1 По СтрДлина(ДанныеСтроки) Цикл
			Байт = КодСимвола(ДанныеСтроки, НомерСимвола);
			
			Число1 = Хеш;
			Число2 = Байт;
			
			Бит = 1;
			Результат = 0;
			Пока Число1 <> 0 И Число2 <> 0 Цикл
				Результат = Бит * (((Число1 % 2) + (Число2 % 2)) % 2) + Результат;
				Бит = Бит * 2;
				Число1 = Цел(Число1 / 2);
				Число2 = Цел(Число2 / 2);
			КонецЦикла;
			
			Хеш = Результат + Макс(Число1, Число2) * Бит;
			
			Хеш = (Хеш * FNV_prime) % FNV_size;
				
		КонецЦикла;
	Иначе     
		FNV_size = Pow(2, 128);		FNV_prime = 309485009821345068724781371;		Хеш = 144066263297769815596495629667062367629;		ДанныеСтроки = XMLСтрока(Данные);				Для НомерСимвола = 1 По СтрДлина(ДанныеСтроки) Цикл			Байт = КодСимвола(ДанныеСтроки, НомерСимвола);						Число1 = Хеш;			Число2 = Байт;						Бит = 1;			Результат = 0;			Пока Число1 <> 0 И Число2 <> 0 Цикл				Результат = Бит * (((Число1 % 2) + (Число2 % 2)) % 2) + Результат;				Бит = Бит * 2;				Число1 = Цел(Число1 / 2);				Число2 = Цел(Число2 / 2);			КонецЦикла;						Хеш = Результат + Макс(Число1, Число2) * Бит;						Хеш = (Хеш * FNV_prime) % FNV_size;						КонецЦикла;	
	КонецЕсли;
		
	Возврат КонтурСтандарт_ЧислоВСистемеСчисления(Хеш, 16);
	
КонецФункции

