Функция Криптография_ИнициализироватьМенеджерКриптографии(ПарольДоступаКЗакрытомуКлючу = Неопределено, ПараметрыСозданияМенеджераКриптографии = Неопределено) Экспорт
	
	Если ПараметрыСозданияМенеджераКриптографии = Неопределено Тогда
		ВариантНастройки = Криптография_ПодходящийВариантНастройкиКриптографии();	
	Иначе
		ВариантНастройки = ПараметрыСозданияМенеджераКриптографии;
	КонецЕсли;
	
	Если ВариантНастройки = Неопределено Тогда
		ВызватьИсключение "Не удалось инициализировать менеджер криптографии по причине: не найден подходящий криптопровайдер на устройстве";	
	КонецЕсли;
	
	Попытка
		ПараметрыКонструктора = Новый Массив;
		ПараметрыКонструктора.Добавить(ВариантНастройки.ИмяМодуляКриптографии);
		ПараметрыКонструктора.Добавить(ВариантНастройки.ПутьМодуляКриптографии);
		ПараметрыКонструктора.Добавить(ВариантНастройки.ТипМодуляКриптографии);
		
		МенеджерКриптографии = Новый("МенеджерКриптографии", ПараметрыКонструктора);
	Исключение    
		ТекстОшибки = ОписаниеОшибки();
		ВызватьИсключение "Не удалось инициализировать менеджер криптографии по причине: " + ТекстОшибки;	
	КонецПопытки; 
		
	Криптография_УстановитьПарольДоступаКЗакрытомуКлючу(МенеджерКриптографии, ПарольДоступаКЗакрытомуКлючу);
	
	Возврат МенеджерКриптографии;
	
КонецФункции

