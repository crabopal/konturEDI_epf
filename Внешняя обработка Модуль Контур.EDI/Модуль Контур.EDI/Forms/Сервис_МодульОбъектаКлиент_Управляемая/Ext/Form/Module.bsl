&НаКлиенте
Функция НовыйМассив(Знач1, Знач2 = "4bd67c947236e", Знач3 = "4bd67c947236e", Знач4 = "4bd67c947236e", Знач5 = "4bd67c947236e") Экспорт
	
	//Метод присутствует в клиентском и серверном модулях
	
	Результат = Новый Массив;
	
	Результат.Добавить(Знач1);
	
	ЗначениеПоУмолчанию = "4bd67c947236e";
	
	Если Знач2 <> ЗначениеПоУмолчанию Тогда
		Результат.Добавить(Знач2);		
	КонецЕсли;
	Если Знач3 <> ЗначениеПоУмолчанию Тогда
		Результат.Добавить(Знач3);		
	КонецЕсли;
	Если Знач4 <> ЗначениеПоУмолчанию Тогда
		Результат.Добавить(Знач4);		
	КонецЕсли;
	Если Знач5 <> ЗначениеПоУмолчанию Тогда
		Результат.Добавить(Знач5);		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ВерсияПрограмногоПродуктаРавнаИлиВыше(СтрокаВерсии1, СтрокаВерсии2) Экспорт
	
	//Метод присутствует в клиентском и серверном модулях
	
	//СтрокаВерсии1 - версия программного продукта, СтрокаВерсии2 - эталонная версия
	
	Массив1 = EDI_РазложитьСтрокуВМассивСлов(СтрокаВерсии1, ".");
	Массив2 = EDI_РазложитьСтрокуВМассивСлов(СтрокаВерсии2, ".");
	
	МаксИндекс1 = Массив1.ВГраница();
	МаксИндекс2 = Массив2.ВГраница();
	МаксИндекс = Макс(МаксИндекс1, МаксИндекс2);
		
	Для К = 0 По МаксИндекс Цикл
		
		Строка1 = ?(К <= МаксИндекс1, Массив1[К], "0");
		Строка2 = ?(К <= МаксИндекс2, Массив2[К], "0");
		
		Длина1 = СтрДлина(Строка1);
		Длина2 = СтрДлина(Строка2);
				
		МодульРазницы = Макс(Длина1 - Длина2, Длина2 - Длина1);
		Для КК = 1 По МодульРазницы Цикл			
			Если Длина1 > Длина2 Тогда
				Строка2 = "0" + Строка2;
			Иначе
				Строка1 = "0" + Строка1;
			КонецЕсли;			
		КонецЦикла;
		
		Если Строка1 > Строка2 Тогда
			Возврат Истина;
		ИначеЕсли Строка1 < Строка2 Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
		
КонецФункции

// Возвращает разделитель пути, используемого в операционной системе
// 
// Возвращаемое значение:
//  Строка
//
&НаКлиенте
Функция РазделительПути()
	
	// Метод присутствует в клиентском и серверном модулях
	
	СистемнаяИнформация	 = Новый СистемнаяИнформация;
	ВерсияПриложения	 = СистемнаяИнформация.ВерсияПриложения;
	ТипОС				 = СистемнаяИнформация.ТипПлатформы;
	
	Если ВерсияПрограмногоПродуктаРавнаИлиВыше(ВерсияПриложения, "8.3.3") Тогда
		
		Результат = Вычислить("ПолучитьРазделительПути()");
		
	Иначе
		
		ЭтоLinux = Найти(НРег(ТипОС), НРег("Linux")) > 0;
		
		Если ЭтоLinux Тогда
			Результат = "/";
		Иначе
			Результат = "\";
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Объединяет части пути через разделитель
//
&НаКлиенте
Функция ОбъединитьПути(П1, П2, П3 = Неопределено, П4 = Неопределено)
	
	// Метод присутствует в клиентском и серверном модулях
	
	Результат = П1;
	
	РазделительПути = РазделительПути();
	
	ЧастиПути = НовыйМассив(П2, П3, П4);
	
	Для Каждого Элемент Из ЧастиПути Цикл
		
		Если Не ЗначениеЗаполнено(Элемент) Тогда
			Прервать;
		КонецЕсли;
		
		Если Прав(Результат, 1) <> РазделительПути Тогда
			Результат = Результат + РазделительПути;
		КонецЕсли;
		
		Результат = Результат + Элемент;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Получает уникальное имя файла
//
// Параметры:
//  Расширение - Строка - расширение файла
// 
// Возвращаемое значение:
//  Строка - уникальное имя файла
//
&НаКлиенте
Функция УникальноеИмяФайла(Расширение = Неопределено)
	
	// Метод присутствует в клиентском и серверном модулях
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
	
	Файл = Новый Файл(ИмяВременногоФайла);
	
	Результат = Файл.Имя;
	
	Возврат Результат;
	
КонецФункции

// Подставляет параметры в строку, максимальное число параметров - 5.
//
// Параметры:
//  ШаблонСтроки - Строка - шаблон содержащий маркеры подстановки вида: "%1..%N"
//                        . Нумерация маркеров начинается с 1.
//                          N не может быть более 5.
//  Параметр<n>  - Строка - подставляемые параметры.
//
// Возвращаемое значение:
//   Строка - строка шаблона с подставленными параметрами.
//
&НаКлиенте
Функция ШаблонСтр(ШаблонСтроки, Параметр1
	, Параметр2 = Неопределено
	, Параметр3 = Неопределено
	, Параметр4 = Неопределено
	, Параметр5 = Неопределено) Экспорт
	
	Результат = СтрЗаменить(ШаблонСтроки, "%1", Параметр1);
	Результат = СтрЗаменить(Результат	, "%2", Параметр2);
	Результат = СтрЗаменить(Результат	, "%3", Параметр3);
	Результат = СтрЗаменить(Результат	, "%4", Параметр4);
	Результат = СтрЗаменить(Результат	, "%5", Параметр5);
	
	Возврат Результат;
	
КонецФункции

// Возвращает двоичные данные модуля
//
// Параметры:
//  РасположениеМодуля - Структура - см. функцию НовоеОписаниеРасположенияМодуля()
//
&НаКлиенте
Функция ДвоичныеДанныеТекущейОбработки(РасположениеМодуля) Экспорт
	
	ВнешняяОбработка = РасположениеМодуля.Ссылка;
	ПутьКФайлу		 = РасположениеМодуля.ПутьКФайлу;
	Местоположение	 = РасположениеМодуля.Местоположение;
	
	РасположенияМодуля = ПеречисленияEDI_ВариантыРасположенияМодуля();
	
	ДвоичныеДанные = Неопределено;
	
	Если Местоположение = РасположенияМодуля.Файл Тогда
		
		ДвоичныеДанные	 = Новый ДвоичныеДанные(ПутьКФайлу);
		
	ИначеЕсли Местоположение = РасположенияМодуля.Справочник
		И Не ВнешняяОбработка = Неопределено Тогда
		
		ДвоичныеДанные	 = ДвоичныеДанныеОбработкиИзСправочникаВнешнихОбработок(ВнешняяОбработка);
		
	Иначе
		
		ДвоичныеДанные = Неопределено;
		
	КонецЕсли;
	
	Возврат ДвоичныеДанные;
	
КонецФункции
	
&НаСервере
Функция ДвоичныеДанныеОбработкиИзФайла(ПутьКФайлу)
	
	ДвоичныеДанные	 = Новый ДвоичныеДанные(ПутьКФайлу);
	Возврат ДвоичныеДанные;
	
КонецФункции
	
&НаСервере
Функция ДвоичныеДанныеОбработкиИзСправочникаВнешнихОбработок(ВнешняяОбработка)
	
	ДвоичныеДанные	 = МодульОбъекта().ФайлОбработкиИзСправочникаВнешнихОбработок(ВнешняяОбработка);
	Возврат ДвоичныеДанные;
	
КонецФункции

// Подключает новую версию модуля в метаданные сеанса
//
// Параметры:
//  РасположениеМодуля - Структура - см. функцию НовоеОписаниеРасположенияМодуля()
//
&НаКлиенте
Процедура ПодключитьНовуюВерсиюМодуля(РасположениеМодуля, ПутьКМодулю) Экспорт
	
	РасположенияМодуля = ПеречисленияEDI_ВариантыРасположенияМодуля();
	
	Если РасположениеМодуля = РасположенияМодуля.Файл Тогда
		
		ПодключитьОбработкуМодуляИзФайла(ПутьКМодулю);
		
	ИначеЕсли РасположениеМодуля = РасположенияМодуля.Справочник Тогда
		
		ПодключитьОбработкуМодуляИзСправочника(ПутьКМодулю);
		
	Иначе
		
		ТекстОшибки = ШаблонСтр(НСтр(
		"ru = 'Не удалось подключить внешнюю обработку модуля!
		|Некорректное расположение модуля: %1'"), РасположениеМодуля);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьОбработкуМодуляИзФайла(ПутьКФайлу)
	
	ДвоичныеДанные	 = Новый ДвоичныеДанные(ПутьКФайлу);
	АдресВХ			 = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
	
	ПодключитьОбработкуМодуляИзФайлаНаСервере(ПутьКФайлу, АдресВХ);
	
КонецПроцедуры

&НаСервере
Процедура ПодключитьОбработкуМодуляИзФайлаНаСервере(ПутьКФайлу, АдресВХ)
	
	Файл = Новый Файл(ПутьКФайлу);
	
	Если Файл.Существует() Тогда
		// Если у сервера есть доступ к файлу
		МодульОбъекта().ВнешниеОбработки_СоздатьБезПредупреждений(ПутьКФайлу);
	Иначе
		МодульОбъекта().ВнешниеОбработки_ПодключитьБезПредупреждений(АдресВХ);
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура ПодключитьОбработкуМодуляИзСправочника(ВнешняяОбработка)
	
	ДвоичныеДанные	 = МодульОбъекта().ФайлОбработкиИзСправочникаВнешнихОбработок(ВнешняяОбработка);
	АдресВХ			 = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
	
	МодульОбъекта().ВнешниеОбработки_ПодключитьБезПредупреждений(АдресВХ);
	
КонецПроцедуры



// Получает новую версию модуля из сервиса обновлений
// и обновляет его в справочнике внешних обработок
//
// Параметры:
//  ВнешняяОбработка - СправочникСсылка - элемент в справочнике внешних обработок,
//                                        в который нужно записать файл модуля;
//  НоваяВерсия 	 - Строка           - номер версии контента;
//
&НаСервере
Процедура ВыполнитьОбновлениеМодуляВСправочнике(ВнешняяОбработка, НоваяВерсия)
	
	МодульОбъекта().ВыполнитьОбновлениеМодуляВСправочнике(ВнешняяОбработка, НоваяВерсия);
	
КонецПроцедуры  

&НаСервере
Процедура ВыполнитьОбновлениеМодуляВРасширении(НоваяВерсия, ТипКонтента)
	
    МодульОбъекта().ВыполнитьОбновлениеМодуляВРасширении(НоваяВерсия, ТипКонтента);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЦентрПоддержки(ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") 
		И ДополнительныеПараметры.Свойство("ПараметрыСессии") Тогда
		
		ПараметрыСессии = ДополнительныеПараметры.ПараметрыСессии;
		
	Иначе
		
		ПараметрыСессии = СформироватьПараметрыЦентраПоддержки(ДополнительныеПараметры);
		
	КонецЕсли;
	
	РезультатОткрытия = Новый Структура();
	РезультатОткрытия.Вставить("БраузерОткрылся", Ложь);
	РезультатОткрытия.Вставить("ТекстОшибки", "");
	
	ЦентрПоддержки().ОткрытьЦентрПоддержки(ПараметрыСессии, "чат", РезультатОткрытия);
    Метрика_ОбработатьРезультатОткрытияПоддержки("ОткрытьЦентрПоддержки", РезультатОткрытия);		
	
КонецПроцедуры

&НаСервере
Процедура Метрика_ОбработатьРезультатОткрытияПоддержки(Место,РезультатОткрытия);
	
	КонтурEDI = МодульОбъекта();
	Если РезультатОткрытия.БраузерОткрылся Тогда
		КонтурEDI.Метрика_Информация(Место, "Браузер открылся", РезультатОткрытия, Истина);
	Иначе         
		КонтурEDI.Метрика_Ошибка(Место, РезультатОткрытия.ТекстОшибки, , РезультатОткрытия, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СформироватьПараметрыЦентраПоддержки(ДопКонтекстДляЦентраПоддержки = Неопределено) Экспорт
	
	Возврат СформироватьПараметрыЦентраПоддержкиНаСервере(ДопКонтекстДляЦентраПоддержки);
	
КонецФункции  

&НаСервере
Функция СформироватьПараметрыЦентраПоддержкиНаСервере(ДопКонтекстДляЦентраПоддержки = Неопределено)
	
	Возврат МодульОбъекта().СформироватьПараметрыЦентраПоддержки(ДопКонтекстДляЦентраПоддержки);
	
КонецФункции

&НаКлиенте
Функция ДополнительныйМодуль(ИмяМодуля) Экспорт
	
	ФормаКлиент = Кэш_Прочитать("Модуль_" + ИмяМодуля);
	
	Если ФормаКлиент <> Неопределено Тогда 
		
		Возврат ФормаКлиент;
		
	КонецЕсли;

	ИмяФормаКлиент = ПолучитьКлиентскийМодульДополнительногоМодуля(ИмяМодуля);
	ПараметрыФормы = Новый Структура("АдресВременногоХранилищаОсновногоМодуля", Объект.ПараметрыКлиентСервер.АдресаВХ.ОбработкаОбъект);
	ФормаКлиент = ПолучитьФорму(ИмяФормаКлиент, ПараметрыФормы, ЭтаФорма);
	
	Кэш_Поместить("Модуль_" + ИмяМодуля, ФормаКлиент);
	
	Возврат ФормаКлиент;
	
КонецФункции

&НаСервере
Функция ПолучитьКлиентскийМодульДополнительногоМодуля(НазваниеМодуля) 
	
	 ДополнительныйМодуль_КонтурEDI = МодульОбъекта().ДополнительныйМодуль(НазваниеМодуля);
	 Возврат ДополнительныйМодуль_КонтурEDI.Метаданные().ПолноеИмя() + ".Форма.МодульОбъектаКлиент";
	
КонецФункции

&НаКлиенте
Функция ПолучитьЗначениеПеременнойСреды(Имя)
	
	Результат = Неопределено;
	
	Попытка
		
		Информация = Новый СистемнаяИнформация;	
		Если Найти(НРег(Информация.ТипПлатформы), "windows") Тогда
			WshShell	= Новый COMobject("wscript.shell");
	    	Результат	= WshShell.ExpandEnvironmentStrings("%"+Имя+"%");
		Иначе	
			Результат = ПолучитьЗначениеПеременнойLinux(Имя);	
		КонецЕсли;		
		
	Исключение
		
		_ОписаниеОшибки = ОписаниеОшибки();
		ТекстСообщения = 	"Не удалось получить значение переменной окружения <%1> по причине:
							|	" + _ОписаниеОшибки;
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%1", Имя);
		
	КонецПопытки;
		
	Если Результат = Неопределено Тогда
		
		ТекстСообщения = "Переменная окружения <%1> не найдена";
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%1", Имя);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПолучитьЗначениеПеременнойLinux(ИмяПеременнойСреды)
	
	ЗначениеВыражения = "";	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	
	КомандаСистемы("sh -c 'env | grep ^" + ИмяПеременнойСреды + "= > " + ИмяВременногоФайла + "'");
	
	Попытка 
		Чтение = Новый ЧтениеТекста(ИмяВременногоФайла);
		Стр = Чтение.ПрочитатьСтроку();
		Пока Стр <> Неопределено Цикл 
			//Найдем ключ и значение
			Индекс = Найти(Стр, "=");
			Если Индекс > 0 Тогда 
				Ключ = Нрег(Лев(Стр, Индекс - 1));
				Если ВРег(Ключ) = ВРег(ИмяПеременнойСреды) Тогда 
					ЗначениеВыражения = Сред(Стр, Индекс + 1);
					Прервать;					
				КонецЕсли;
			КонецЕсли;
			Стр = Чтение.ПрочитатьСтроку();
		КонецЦикла;
	Исключение 
	КонецПопытки;
	
	Возврат ЗначениеВыражения;
	
КонецФункции

//}} Дополнительные модули


&НаКлиенте
Функция Представление_ФИО(Фамилия, Имя, Отчество) Экспорт
	
	Возврат "" + Фамилия + " " + Имя + ?(ЗначениеЗаполнено(Отчество), " " + Отчество, "");
	
КонецФункции

&НаКлиенте
Функция Представление_ИННКПП(ИНН, КПП = "", Разделитель = "/") Экспорт
	
	Результат = "";
	
	Если ЗначениеЗаполнено(ИНН) Тогда
		Если ЗначениеЗаполнено(КПП) Тогда
			Результат = Результат + "ИНН" + Разделитель + "КПП: " + ИНН + Разделитель + КПП;
		Иначе
			Результат = Результат + "ИНН: " + ИНН;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Представление_МашиночитаемаяДоверенность_Представитель(МашиночитаемаяДоверенность) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ФИО");
	Результат.Вставить("ИНН");
	Результат.Вставить("Организация", Новый Структура("Наименование,ИННКПП"));
	
	Представитель = МашиночитаемаяДоверенность.Представитель;
	Организация = Представитель.Организация;
	
	ФИО = Представитель.ФИО;
	
	Фамилия = ФИО.Фамилия;
	Имя = ФИО.Имя;
	Отчество = ФИО.Отчество;
	
	Результат.ФИО = Представление_ФИО(Фамилия, Имя, Отчество);
	Результат.ИНН = Представление_ИННКПП(Представитель.ИНН);
	Результат.Организация.Наименование = Организация.Наименование;
	Результат.Организация.ИННКПП = Представление_ИННКПП(Организация.ИНН, Организация.КПП, "-");
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Представление_МашиночитаемаяДоверенность_Доверитель(МашиночитаемаяДоверенность) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Наименование");
	Результат.Вставить("Тип");
	Результат.Вставить("ИННКПП");
	
	Доверитель = МашиночитаемаяДоверенность.Доверитель;
	ТипДоверителя = МашиночитаемаяДоверенность.Доверитель.Тип;
	
	Если Врег(ТипДоверителя) = Врег("UnknownIssuerType") ИЛИ Врег(ТипДоверителя) = Врег("Неизвестно") Тогда
		
		Результат.Наименование = "<< Неизвестно >>";
		Результат.Тип = "Неизвестно";
		Результат.ИННКПП = "";
		
		Возврат Результат;
		
	ИначеЕсли Врег(ТипДоверителя) = Врег("IndividualEntity") ИЛИ Врег(ТипДоверителя) = Врег("ИндивидуальныйПредприниматель") Тогда 
		
		ИндивидуальныйПредприниматель = Доверитель.ИндивидуальныйПредприниматель;
		
		Результат.Наименование = ИндивидуальныйПредприниматель.Наименование;
		Результат.Тип = "Индивидуальный предприниматель";
		Результат.ИННКПП = Представление_ИННКПП(ИндивидуальныйПредприниматель.ИНН, "", "-");
		
		Возврат Результат;
		
	ИначеЕсли Врег(ТипДоверителя) = Врег("ForeignEntity") ИЛИ Врег(ТипДоверителя) = Врег("ИностраннаяОрганизация") Тогда
		
		ИностраннаяОрганизация = Доверитель.ИностраннаяОрганизация;
		
		Результат.Наименование = ИностраннаяОрганизация.Наименование;
		Результат.Тип = "Иностранная организация";
		Результат.ИННКПП = Представление_ИННКПП(ИностраннаяОрганизация.ИНН, ИностраннаяОрганизация.КПП, "-");
		
		Возврат Результат;
		
	ИначеЕсли Врег(ТипДоверителя) = Врег("PhysicalEntity") ИЛИ Врег(ТипДоверителя) = Врег("ФизическоеЛицо") Тогда
		
		ФизическоеЛицо = Доверитель.ФизическоеЛицо;
		
		ФИО = ФизическоеЛицо.ФИО;
		
		Фамилия = ФИО.Фамилия;
		Имя = ФИО.Имя;
		Отчество = ФИО.Отчество;
		
		Результат.Наименование = Представление_ФИО(Фамилия, Имя, Отчество);
		Результат.Тип = "Физическое лицо";
		Результат.ИННКПП = Представление_ИННКПП(ФизическоеЛицо.ИНН, "", "-");
		
		Возврат Результат;
		
	ИначеЕсли Врег(ТипДоверителя) = Врег("LegalEntity") ИЛИ Врег(ТипДоверителя) = Врег("ЮридическоеЛицо") Тогда 
		
		ЮридическоеЛицо = Доверитель.ЮридическоеЛицо; 
		
		Результат.Наименование = ЮридическоеЛицо.Наименование;
		Результат.Тип = "Юридическое лицо";
		Результат.ИННКПП = Представление_ИННКПП(ЮридическоеЛицо.ИНН, ЮридическоеЛицо.КПП, "-");
		
		Возврат Результат;

		
	Иначе
		
		Результат.Наименование = "<< Неизвестно >>";
		Результат.Тип = "Неизвестно";
		Результат.ИННКПП = "";
		
		Возврат Результат;
		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция Представление_МашиночитаемаяДоверенность_ФормаСписка(МашиночитаемаяДоверенность) Экспорт
	
	Доверитель = Представление_МашиночитаемаяДоверенность_Доверитель(МашиночитаемаяДоверенность);
	Представитель = Представление_МашиночитаемаяДоверенность_Представитель(МашиночитаемаяДоверенность);
	
	Представление = "" + Доверитель.Наименование + "
	|" + Доверитель.ИННКПП + "
	|" + Представитель.ФИО;
	
	Возврат Представление;
	
