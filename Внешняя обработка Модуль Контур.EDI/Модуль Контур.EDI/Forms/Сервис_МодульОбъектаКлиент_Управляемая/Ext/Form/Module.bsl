&НаКлиенте
Функция Криптография_НовыйМенеджерНастроек()

	МенеджерНастроек = Новый Структура;
	
	МенеджерНастроек.Вставить("ПодходящийВариантНастройкиКриптографии");
	МенеджерНастроек.Вставить("КэшСертификатов", Новый Соответствие);
	МенеджерНастроек.Вставить("ВариантыНастройкиСертификатов", Новый Соответствие);
	
	Возврат МенеджерНастроек;
	
КонецФункции

&НаКлиенте
Процедура Криптография_УстановитьПарольДоступаКЗакрытомуКлючу(МенеджерКриптографии, ПарольДоступаКЗакрытомуКлючу)
	
	Если ЗначениеЗаполнено(ПарольДоступаКЗакрытомуКлючу) Тогда
		МенеджерКриптографии.ПарольДоступаКЗакрытомуКлючу = ПарольДоступаКЗакрытомуКлючу; 	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция Криптография_ПодходящийВариантНастройкиКриптографии()
	
	МенеджерНастроек = Криптография_МенеджерНастроек();
	
	Если МенеджерНастроек.ПодходящийВариантНастройкиКриптографии = Неопределено Тогда
		
		ВариантыНастройки = Криптография_ВариантыНастройкиПоТипуПлатформы();	
				
		Для Каждого ВариантНастройки Из ВариантыНастройки Цикл
			
			Попытка
				
				ПараметрыКонструктора = Новый Массив;
				ПараметрыКонструктора.Добавить(ВариантНастройки.ИмяМодуляКриптографии);
				ПараметрыКонструктора.Добавить(ВариантНастройки.ПутьМодуляКриптографии);
				ПараметрыКонструктора.Добавить(ВариантНастройки.ТипМодуляКриптографии);
				
				МенеджерКриптографии = Новый("МенеджерКриптографии", ПараметрыКонструктора);
				
				МенеджерНастроек.ПодходящийВариантНастройкиКриптографии = ВариантНастройки;
				
				Прервать;
				
			Исключение
				
				_ОписаниеОшибки = ОписаниеОшибки();
				
			КонецПопытки;

		КонецЦикла;  
		
	КонецЕсли;
	
	Возврат МенеджерНастроек.ПодходящийВариантНастройкиКриптографии;

КонецФункции

&НаКлиенте
Функция Криптография_ВариантыНастройкиПоТипуПлатформы(ТипПлатформы = Неопределено) Экспорт
	
	ТипыМодулейКриптографии = Новый Массив;
	
	ВариантыНастройки = Криптография_ВариантыНастройкиКриптографии();
	
	Если ТипПлатформы = Неопределено Тогда
		СистемнаяИнформация = КонтурСтандарт_НовыйСистемнаяИнформация();
		ТипПлатформыСтрокой = НРег(СистемнаяИнформация.ТипПлатформы);
	Иначе
		ТипПлатформыСтрокой = НРег(ТипПлатформы);
	КонецЕсли;
	
	Если Найти(ТипПлатформыСтрокой, "windows") Тогда

		ТипыМодулейКриптографии.Добавить(ВариантыНастройки.КриптоПроГОСТ2012);
		ТипыМодулейКриптографии.Добавить(ВариантыНастройки.КриптоПроГОСТ2012SystemCSP);
		ТипыМодулейКриптографии.Добавить(ВариантыНастройки.КриптоПроГОСТ2001);
		ТипыМодулейКриптографии.Добавить(ВариантыНастройки.КриптоПроГОСТ2012Усиленый);
		ТипыМодулейКриптографии.Добавить(ВариантыНастройки.КриптоПроФКН);
		ТипыМодулейКриптографии.Добавить(ВариантыНастройки.КриптоПроРутокен);
		ТипыМодулейКриптографии.Добавить(ВариантыНастройки.ВИПНетГОСТ2012);
		ТипыМодулейКриптографии.Добавить(ВариантыНастройки.ВИПНетГОСТ2001);
		ТипыМодулейКриптографии.Добавить(ВариантыНастройки.ВИПНетГОСТ2012Усиленый);
		
	ИначеЕсли Найти(ТипПлатформыСтрокой, "linux") Тогда	

		ПутьМодуляКриптографии = Криптография_ПутиМодуляКриптографии();	

		ТипыМодулейКриптографии.Добавить(ВариантыНастройки.КриптоПроГОСТ_2012_Linux_x64);	
		ТипыМодулейКриптографии.Добавить(ВариантыНастройки.КриптоПроГОСТ_2012_SystemCSP_Linux_x64);
		ТипыМодулейКриптографии.Добавить(ВариантыНастройки.КриптоПроГОСТ_2012_Усиленый_Linux_x64);
	    ТипыМодулейКриптографии.Добавить(ВариантыНастройки.КриптоПроГОСТ34_10_2001_Linux_x64);
	  	ТипыМодулейКриптографии.Добавить(ВариантыНастройки.КриптоПроГОСТ34_10_2001_Linux_x32);
		
	ИначеЕсли Найти(ТипПлатформыСтрокой, "macos") Тогда     
		
		ПутьМодуляКриптографии = Криптография_ПутиМодуляКриптографии();

		ТипыМодулейКриптографии.Добавить(ВариантыНастройки.КриптоПроГОСТ_2012_macOS);
		ТипыМодулейКриптографии.Добавить(ВариантыНастройки.КриптоПроГОСТ_2001_macOS);
		
	КонецЕсли;
	
	Возврат ТипыМодулейКриптографии;
	
КонецФункции 

&НаКлиенте
