//	Булево - функции доступны
&НаКлиенте
Функция КонтурСтандарт_ДоступныРасширенияКонфигурации() Экспорт
	
	// полноценная работа расширений с версии 8.3.9
	Возврат КонтурСтандарт_ВерсияРежимСовместимостиНеНижеУказанной("8.3.9"); 
	
КонецФункции

// Определяет доступны ли функции работы с наборами типов расширения (Платформа >= 8.3.20)
//
// Возвращаемое значение:
//	Булево - функции доступны
//
&НаКлиенте
Функция КонтурСтандарт_ДоступныНаборыТиповРасширения() Экспорт
	
	Возврат КонтурСтандарт_ВерсияРежимСовместимостиНеНижеУказанной("8.3.20");	
	
КонецФункции

// Определяет, является ли переданное значение структурой или фиксированной структурой.
// 
// Параметры:
//  Значение - Произвольный - значение, которое нужно проверить.
// 
// Возвращаемое значение:
//   Булево - Истина, если переданое значение является структрой или фиксированной структурой.
//
&НаКлиенте
Функция КонтурСтандарт_ЭтоСтруктура(Значение) Экспорт
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если Значение = Неопределено Тогда
		
		Результат = Ложь;
		
	ИначеЕсли ТипЗначения = Тип("Структура") Тогда
		
		Результат = Истина;
		
	ИначеЕсли ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		
		Результат = Истина;
		
	Иначе
		
		Результат = Ложь;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверят наличие и получает значение по указанному имени свойства из структуры или соответствия.
// 
// Параметры:
//  Структура - Структура, Соответствие - коллекция для поиска.
//	Ключ - Строка - имя свойства искомого значения
//  ЗначениеПоУмолчанию - значение по умолчанию возвращаемое, если нет свойства в коллекции 
// 
// Возвращаемое значение:
//   Произвольный - значение полученное из коллекции либо значение по умолчанию.
//
&НаКлиенте
Функция КонтурСтандарт_ЗначениеПоКлючу(Структура, Ключ, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Если ТипЗнч(Структура) = Тип("Структура") И Структура.Свойство(Ключ) Тогда
		Значение = Структура[Ключ];
	ИначеЕсли ТипЗнч(Структура) = Тип("Соответствие") И Структура.Получить(Ключ) <> Неопределено Тогда
		Значение = Структура.Получить(Ключ);
	Иначе
		Значение = ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

// Преобразует дату по формату "yyyy-MM-ddTHH:mm:ss+00:00" в строку.
// 
// Параметры:
//  ДатаВремя - Дата - значение, которое нужно преобразовать в строку.
// 
// Возвращаемое значение:
//   Строка - Преобразованная дата по формату.
//
&НаКлиенте
Функция КонтурСтандарт_ДатаВФормате_ISO8601(ДатаВремя) Экспорт
	
	ФорматнаяСтрока = "ДФ=yyyy-MM-ddTHH:mm:ss+00:00; ДП=1970-01-01T00:00:00+00:00";
	Возврат Формат(ДатаВремя, ФорматнаяСтрока);
	
КонецФункции // ДатаВФормате_ISO8601()

// Проверят что текущая версия платформы не ниже указнной.
// 
// Параметры:
//  Версия - Строка - строка версии платформы в формате "X.X.XX.XXXX"/"Х.Х.ХХ".
// 
// Возвращаемое значение:
//   Булево - результат сравнения версий.
//
&НаКлиенте
Функция КонтурСтандарт_ВерсияПлатформыНеНижеУказанной(Версия) Экспорт
	
	МенеджерНастроек = КонтурСтандарт_МенеджерНастроек();
	
	РезультатСравнения = МенеджерНастроек.РезультатФункции_ВерсияПлатформыНеНижеУказанной.Получить(Версия);
	
	Если РезультатСравнения = Неопределено Тогда
		
		СистемнаяИнформация = КонтурСтандарт_НовыйСистемнаяИнформация();
		
	  	РезультатСравнения = (КонтурСтандарт_СравнитьВерсии(СистемнаяИнформация.ВерсияПриложения, Версия) >= 0);
		
		МенеджерНастроек.РезультатФункции_ВерсияПлатформыНеНижеУказанной.Вставить(Версия, РезультатСравнения);
		
	КонецЕсли;
	
	Возврат РезультатСравнения; 
	
КонецФункции

// Проверят что текущая версия совместимости конфигурации не ниже указнной.
// 
// Параметры:
//  Версия - Строка - строка версии платформы в формате "X.X.XX.XXXX"/"Х.Х.ХХ".
//
// Возвращаемое значение:
//   Булево - результат сравнения версий.
//
&НаКлиенте
Функция КонтурСтандарт_ВерсияРежимСовместимостиНеНижеУказанной(Версия) Экспорт 
	
	ВерсияРежимаСовместимости = КонтурСтандарт_РежимСовместимостиСтрокой_Сервер();	
	                                         
	Если ВерсияРежимаСовместимости = "НеИспользовать"
		ИЛИ ВерсияРежимаСовместимости = "DontUse" Тогда 
		                                
		Возврат КонтурСтандарт_ВерсияПлатформыНеНижеУказанной(Версия); 
		
	КонецЕсли;
	
	МенеджерНастроек = КонтурСтандарт_МенеджерНастроек();
	
	РезультатСравнения = МенеджерНастроек.РезультатФункции_ВерсияРежимСовместимостиНеНижеУказанной.Получить(Версия);
	
	Если РезультатСравнения = Неопределено Тогда
		
		ВерсияРежимаСовместимости = СтрЗаменить(ВерсияРежимаСовместимости, "Версия", "");
		ВерсияРежимаСовместимости = СтрЗаменить(ВерсияРежимаСовместимости, "Version", "");
		ВерсияРежимаСовместимости = СтрЗаменить(ВерсияРежимаСовместимости, "_", ".");
		
		РезультатСравнения = (КонтурСтандарт_СравнитьВерсии(ВерсияРежимаСовместимости, Версия) >= 0);  
		
		МенеджерНастроек.РезультатФункции_ВерсияРежимСовместимостиНеНижеУказанной.Вставить(Версия, РезультатСравнения);
		
	КонецЕсли;
	
	Возврат РезультатСравнения;  
	
КонецФункции

// Определяет режим эксплуатации информационной базы файловый (Истина) или серверный (Ложь).
// При проверке используется СтрокаСоединенияИнформационнойБазы, которую можно указать явно.
//
// См. ОбщегоНазначения.ИнформационнаяБазаФайловая
//
// Параметры:
//  СтрокаСоединенияИнформационнойБазы - Строка - параметр используется, если
//                 нужно проверить строку соединения не текущей информационной базы.
//
// Возвращаемое значение:
//  Булево - Истина, если файловая.
//
&НаКлиенте
Функция КонтурСтандарт_ИнформационнаяБазаФайловая(Знач СтрокаСоединенияИнформационнойБазы = "") Экспорт
	
	Если ПустаяСтрока(СтрокаСоединенияИнформационнойБазы) Тогда
		СтрокаСоединенияИнформационнойБазы =  СтрокаСоединенияИнформационнойБазы();
	КонецЕсли;
	Возврат Найти(Врег(СтрокаСоединенияИнформационнойБазы), "FILE=") = 1;
	
КонецФункции    

// Разбивает строку на несколько строк, используя заданный набор разделителей.
// Если параметр РазделителиСлов не задан, то разделителем слов считается любой из символов, 
// не относящихся к символам латиницы, кириллицы, цифры, подчеркивания.
//
// Параметры:
//  Значение        - Строка - исходная строка, которую необходимо разложить на слова.
//  РазделителиСлов - Строка - перечень символов-разделителей. Например, ".,;".
//
// Возвращаемое значение:
//  Массив - список слов.
//
// Пример:
//  СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов("один-@#два2_!три") возвратит массив значений: "один",
//  "два2_", "три"; СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов("один-@#два2_!три", "#@!_") возвратит массив
//  значений: "один-", "два2", "три".
//
&НаКлиенте
Функция КонтурСтандарт_РазложитьСтрокуВМассивСлов(Знач Строка, РазделителиСлов="", РазделительКакЕдиныйСимвол = Ложь) Экспорт
	
	Слова = Новый Массив;
	
	ДлинаРазделителя = СтрДлина(РазделителиСлов);
	
	Если ДлинаРазделителя = 1 ИЛИ РазделительКакЕдиныйСимвол Тогда
		
		НайденныйСимвол = Найти(Строка,РазделителиСлов);
		Пока НайденныйСимвол>0 Цикл
			Слова.Добавить(СокрЛП(Лев(Строка,НайденныйСимвол + ДлинаРазделителя - 2)));
			Строка = Сред(Строка,НайденныйСимвол + ДлинаРазделителя);
			НайденныйСимвол = Найти(Строка,РазделителиСлов);
		КонецЦикла;
		
		Если НЕ ПустаяСтрока(Строка) Тогда
			Слова.Добавить(СокрЛП(Строка));
		КонецЕсли;
		
	Иначе
		
		Для Сч = 1 По СтрДлина(РазделителиСлов) Цикл
			Строка = СтрЗаменить(Строка,Сред(РазделителиСлов,Сч,1),Символы.ПС);
		КонецЦикла;
		
		Для Сч=1 По СтрЧислоСтрок(Строка) Цикл
			ТекСлово = СокрЛП(СтрПолучитьСтроку(Строка,Сч));
			Если ТекСлово<>"" Тогда
				Слова.Добавить(СокрЛП(ТекСлово));
			КонецЕсли;	
		КонецЦикла;	
		
	КонецЕсли;
	
	Возврат Слова;
	
КонецФункции 

// Проверят что переданная строка содержит цифры.
// 
// Параметры:
//  Стр - Строка - проверяемая строка .
// 
// Возвращаемое значение:
//   Булево - результат проверки.
//
&НаКлиенте
Функция КонтурСтандарт_ЕстьЦифрыВСтроке(Стр) Экспорт
	
	Для к = 1 По СтрДлина(Стр) Цикл 
		Если Найти("0123456789",Сред(Стр,к,1))<>0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
			
КонецФункции

// Кодирует строку в соответствии с выбранным способом кодирования.
// 
// Параметры:
//  Строка - Строка - Кодируемая строка.
//  пСпособКодированияСтроки - Строка - см. метод КонтурСтандарт_СпособКодированияСтроки
//
// Возвращаемое значение:
//   Строка - результат кодирования.
//
&НаКлиенте
Функция КонтурСтандарт_КодироватьСтроку_(пСтрока, пСпособКодированияСтроки) Экспорт 
	
	Если КонтурСтандарт_ДоступныБазовыеСтроковыеФункции() Тогда  
		
		Если НЕ пСпособКодированияСтроки = КонтурСтандарт_СпособКодированияСтроки().URLВКодировкеURL
			И НЕ пСпособКодированияСтроки = КонтурСтандарт_СпособКодированияСтроки().КодировкаURL Тогда
			
			ВызватьИсключение "Неверно задан способ кодирования строки";
			
		КонецЕсли;

		Возврат Вычислить("КодироватьСтроку(пСтрока, СпособКодированияСтроки[пСпособКодированияСтроки])");
		
	Иначе
		
		Возврат КонтурСтандарт_URLEncode(пСтрока, пСпособКодированияСтроки = КонтурСтандарт_СпособКодированияСтроки().КодировкаURL);
		
	КонецЕсли;
	
КонецФункции    

// Раскодирует строку, закодированную в соответствии с указанным способом кодирования.
// 
// Параметры:
//  Строка - Строка - Закодированная строка.
//  пСпособКодированияСтроки - Строка - способ, которым была закодирована исходная строка. см. метод КонтурСтандарт_СпособКодированияСтроки
//
// Возвращаемое значение:
//   Строка - раскодированная исходная строка.
//
&НаКлиенте
Функция КонтурСтандарт_РаскодироватьСтроку_(пСтрока, пСпособКодированияСтроки) Экспорт
	
	Если КонтурСтандарт_ДоступныБазовыеСтроковыеФункции() Тогда
		
		Если НЕ пСпособКодированияСтроки = КонтурСтандарт_СпособКодированияСтроки().URLВКодировкеURL
			И НЕ пСпособКодированияСтроки = КонтурСтандарт_СпособКодированияСтроки().КодировкаURL Тогда
			
			ВызватьИсключение "Неверно задан способ кодирования строки";
			
		КонецЕсли;
		
		Возврат Вычислить("РаскодироватьСтроку(пСтрока, СпособКодированияСтроки[пСпособКодированияСтроки])");	
		
	Иначе
		
		Возврат КонтурСтандарт_URLDecode(пСтрока);
		
	КонецЕсли;
	
КонецФункции

// Варианты кодирования строк.
// 
// Возвращаемое значение:
//   Строка - "URLВКодировкеURL", "КодировкаURL".
//
&НаКлиенте
Функция КонтурСтандарт_СпособКодированияСтроки() Экспорт
	
	Структура = Новый Структура(); 
	
	Структура.Вставить("URLВКодировкеURL", "URLВКодировкеURL");
	Структура.Вставить("КодировкаURL", "КодировкаURL");
	                                    
	Возврат Структура; 
	
КонецФункции

// Преобразует переданное число в указанную систему счисления.
// 
// Параметры:
//  Данные - Число - преобразуемое число.
//  Основание - Число - число системы счисления
//
// Возвращаемое значение:
//   Строка - результат преобразования в указанную систему счисления.
//
&НаКлиенте
Функция КонтурСтандарт_ЧислоВСистемеСчисления(Знач Данные, Основание) Экспорт
	
	Словарь = КонтурСтандарт_СловарьСистемыСчисления();
	
	Результат = "";
	Пока Данные > 0 Цикл
		Результат = XMLСтрока(Словарь.Получить(Данные % Основание)) + Результат;

		Данные = Цел(Данные/Основание);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Преобразует переданную строку системы счисления в число.
// 
// Параметры:
//  Данные - Строка - преобразуемые данные в системе счисления.
//  Основание - Число - число системы счисления
//
// Возвращаемое значение:
//   Число - результат преобразования в указанную систему счисления.
//
&НаКлиенте
Функция КонтурСтандарт_ЧислоИзСистемыСчисления(Знач Данные, Основание) Экспорт
	
	Словарь = КонтурСтандарт_СловарьСистемыСчисления();
	ДанныеСтроки = XMLСтрока(ВРег(Данные));
	
	Результат = 0;
	
	Длина = СтрДлина(ДанныеСтроки);
	Для Разряд = 0 По СтрДлина(ДанныеСтроки) - 1 Цикл
		
		ЧислоСловаря = Словарь.Получить(Сред(ДанныеСтроки, Длина - Разряд, 1));
		
		Если ЧислоСловаря >= Основание Тогда
			ВызватьИсключение "Недопустимый символ в данных " + Сред(ДанныеСтроки, Длина - Разряд, 1);	
		КонецЕсли;
		
		Результат = Результат + ЧислоСловаря * Pow(Основание, Разряд);   
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Создаёт объект ФабрикаXDTO по переданному описанию xsd-схемы
//
// Параметры:
//  СтрокаXML - Строка - xml-текст xsd-схемы.
//
// Возвращаемое значение:
//   ФабрикаXDTO - объект ФабрикаXDTO по переданной xsd-схеме.
//
&НаКлиенте
Функция КонтурСтандарт_ФабрикаXDTO(СтрокаXML) Экспорт
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(СтрокаXML);
	
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
	
	ПостроительСхемXML = Новый ПостроительСхемXML;
	СхемаXML = ПостроительСхемXML.СоздатьСхемуXML(ДокументDOM);
	
	НаборСхемXML = Новый НаборСхемXML;
	НаборСхемXML.Добавить(СхемаXML);
	
	Результат = Новый ФабрикаXDTO(НаборСхемXML);
	
	Возврат Результат;
	
КонецФункции		  

// Возвращает пустой объект XDTO по переданному типу пакета XDTO фабрики
//
// Параметры:
//  Фабрика - ФабрикаXDTO - фабрика.
//  ТипПакетаXDTO - Строка - имя пакета XDTO.
//  ПространствоИмен - Строка - имя пространства имен.
//
// Возвращаемое значение:
//   ОбъектXDTO - пустой объект ОбъектXDTO по переданному типу пакета. 
//
&НаКлиенте
Функция КонтурСтандарт_ПолучитьПустойОбъектXDTO(Фабрика, ТипПакетаXDTO, ПространствоИмен = "http://www.w3.org/2001/XMLSchema") Экспорт
	
	Результат = Неопределено;

	ЧастиПути = КонтурСтандарт_РазложитьСтрокуВМассивСлов(ТипПакетаXDTO, ".");
	
	ТипОбъекта = Фабрика.Тип(ПространствоИмен, ЧастиПути[0]);
	
	ЧастиПути.Удалить(0);
	
	Коллекция = ТипОбъекта.Свойства;
	
	Пока ЗначениеЗаполнено(ЧастиПути) Цикл
		
		Если Коллекция = Неопределено Тогда
			ТипОбъекта = Неопределено;
			Прервать;
		КонецЕсли;
		
		Свойство = Коллекция.Получить(ЧастиПути[0]);
		
		Если Свойство = Неопределено Тогда
			ТипОбъекта = Неопределено;
			Прервать;
		КонецЕсли;
		
		ТипОбъекта = Свойство.Тип;
		
		ЧастиПути.Удалить(0);
		
		Попытка
			Коллекция = ТипОбъекта.Свойства;
		Исключение
			Прервать;
		КонецПопытки;
		
	КонецЦикла;
	
	Если ТипОбъекта <> Неопределено Тогда
		Результат = Фабрика.Создать(ТипОбъекта);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет наличие реквизита в объекте XDTO и устанавливает значение реквизита
//
// Параметры:
//  Элемент - ОбъектXDTO - объект XDTO.
//  ИмяРеквизита - Строка - имя реквизита.
//  ЗначениеРеквизита - Произвольный - значение реквизита.
//
&НаКлиенте
Процедура КонтурСтандарт_УстановитьЗначениеXDTO(Элемент, ИмяРеквизита, ЗначениеРеквизита) Экспорт
	
	Если ЗначениеРеквизита = Неопределено
		Или ЗначениеРеквизита = Null Тогда
		Возврат;
	КонецЕсли;
	
	Элемент[ИмяРеквизита] = ЗначениеРеквизита;
	
КонецПроцедуры

// Конвертирует объект XDTO в строку XML
//
// Параметры:
//  Фабрика - ФабрикаXDTO - фабрика.
//  ОбъектXDTO - объект XDTO - объект XDTO.
//  ТипКодировки - Строка - тип кодировки.
//
// Возвращаемое значение:
//   Строка - строка XML преобразованного объекта XDTO. 
//
&НаКлиенте
Функция КонтурСтандарт_ОбъектXDTO_В_СтрокаXML(Фабрика, ОбъектXDTO, ТипКодировки = "windows-1251") Экспорт
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку(ТипКодировки);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	Фабрика.ЗаписатьXML(ЗаписьXML, ОбъектXDTO,,,, НазначениеТипаXML.Неявное);
	
	СтрокаXML = ЗаписьXML.Закрыть();
	
	Возврат СтрокаXML;	
	
КонецФункции

// Создаёт дочерний объект в переданном объекте XDTO по имени и указанной фабрике
//
// Параметры:
//  Фабрика - ФабрикаXDTO - фабрика.
//  Родитель - ОбъектXDTO - объект XDTO.
//  ИмяЭлемента - Строка - имя элемента.
//  ЗначениеЭлемента - Произвольный - значение элемента.
//
// Возвращаемое значение:
//   ОбъектXDTO - созданный объект. 
//
&НаКлиенте
Функция КонтурСтандарт_НовыйДочернийОбъектXDTO(Фабрика, Родитель, ИмяЭлемента, ЗначениеЭлемента = Неопределено) Экспорт
	
	СвойствоДочернего	 = Родитель.Тип().Свойства.Получить(ИмяЭлемента);
	ТипДочернего		 = СвойствоДочернего.Тип;
	ЭтоСписок			 = СвойствоДочернего.ВерхняяГраница <> 1;
	
	Если ЗначениеЭлемента = Неопределено Тогда
		Результат = Фабрика.Создать(ТипДочернего);
	Иначе
		Результат = Фабрика.Создать(ТипДочернего, ЗначениеЭлемента);
	КонецЕсли;
	
	Если ЭтоСписок Тогда
		Родитель[ИмяЭлемента].Добавить(Результат);
	Иначе
		Родитель[ИмяЭлемента] = Результат;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает преобразованные данные JSON
//
// Параметры:
//  Строка                       - Строка         - Строка, содержащая текст в формате JSON.
//  ПрочитатьВСоответствие       - Булево         - Если установлено Истина, чтение объекта JSON будет выполнено
//
// Возвращаемое значение:
//  Структура, Соответствие - преобразованные данные JSON в типы «1С:Предприятия».
//
&НаКлиенте
Функция КонтурСтандарт_ЗначениеИзСтрокиJSON(Знач Строка, ПрочитатьВСоответствие = Ложь) Экспорт 
	
	Если ТипЗнч(Строка) = Тип("ДвоичныеДанные") Тогда
		Строка = КонтурСтандарт_ПолучитьСтрокуИзДвоичныхДанных_(Строка);	
	КонецЕсли;
	
	Если КонтурСтандарт_ДоступныЗаписьЧтениеJSON() Тогда 
		
		ЧтениеJSON = Вычислить("Новый ЧтениеJSON");
		ЧтениеJSON.УстановитьСтроку(Строка);	
		
		Результат = Вычислить("ПрочитатьJSON(ЧтениеJSON, " + XMLСтрока(ПрочитатьВСоответствие) + ", , , ""КонтурСтандарт_ФункцияВосстановленияJSON"", ЭтаФорма)");	
		
	Иначе   
		
		Результат = КонтурСтандарт_ПрочитатьJSON_Совместимость(Строка, ПрочитатьВСоответствие);
		
	КонецЕсли;   
	
	Возврат Результат;
	
КонецФункции

// Возвращает сериализованное значение в формат JSON
//
// Параметры:
//  Значение - Произвольный	 - Объект записи JSON. Меняет состояние потока записи.
//                             Представляет собой значение произвольного типа.
//
// Возвращаемое значение:
//  Строка - возвращает сериализованное <Значение> в формат JSON.
//
&НаКлиенте
Функция КонтурСтандарт_ЗначениеВСтрокуJSON(Значение) Экспорт 
	        
	Если КонтурСтандарт_ДоступныЗаписьЧтениеJSON() Тогда 
		
		НастройкиСериализации = Вычислить("Новый НастройкиСериализацииJSON");
		НастройкиСериализации.ВариантЗаписиДаты		 = Вычислить("ВариантЗаписиДатыJSON.УниверсальнаяДата");	
		НастройкиСериализации.ФорматСериализацииДаты = Вычислить("ФорматДатыJSON.ISO");
		НастройкиСериализации.СериализовыватьМассивыКакОбъекты = Ложь;
		
		ЗаписьJSON = Вычислить("Новый ЗаписьJSON");
		ЗаписьJSON.УстановитьСтроку();
		
		Выполнить("ЗаписатьJSON(ЗаписьJSON, Значение, НастройкиСериализации)");	
		
		Результат = ЗаписьJSON.Закрыть();	
		
	Иначе   
		
		Результат = КонтурСтандарт_ЗаписатьJSON_Совместимость(Значение);
		
	КонецЕсли;
	
	Возврат Результат; 
	
КонецФункции

// Возвращает дату преобразованную из тиков
//
// Параметры:
//  Ticks - Число	 - количество в тиках.
//
// Возвращаемое значение:
//  Дата - дата преобразованная из числа тиков.
//
&НаКлиенте
Функция КонтурСтандарт_Ticks_To_Date(Ticks) Экспорт
	
	КоличествоТиковВМиллисекунде = 10000;
	КоличествоМиллисекундВСекунде = 1000;
	
	Результат = XMLЗначение(Тип("Дата"), XMLСтрока('00010101' + Ticks / (КоличествоТиковВМиллисекунде * КоличествоМиллисекундВСекунде)));
	
	Возврат Результат;
	
КонецФункции

// Возвращает количество тиков из даты
//
// Параметры:
//  Date - Дата	- дата и время.
//
// Возвращаемое значение:
//  Число - возвращает преобразованное значение даты в тиках.
//
&НаКлиенте
Функция КонтурСтандарт_Date_To_Ticks(Date) Экспорт
	
	КоличествоТиковВМиллисекунде = 10000;
	КоличествоМиллисекундВСекунде = 1000;

	Результат = Формат((Дата(Date) - '00010101') * КоличествоТиковВМиллисекунде * КоличествоМиллисекундВСекунде, "ЧГ=");
	
	Возврат Результат;
	
КонецФункции

// Возвращает разность массивов. Разностью двух массивов является массив, содержащий
// все элементы первого массива, не существующие во втором массиве.
//
// Параметры:
//  Массив - Массив - массив элементов, из которого необходимо выполнить вычитание;
//  МассивВычитания - Массив - массив элементов, который будет вычитаться.
// 
// Возвращаемое значение:
//  Массив - разностью двух массивов.
//
// Пример:
//	//А = [1, 3, 5, 7];
//	//В = [3, 7, 9];
//	Результат = ОбщегоНазначенияКлиентСервер.РазностьМассивов(А, В);
//	//Результат = [1, 5];
//
&НаКлиенте
Функция КонтурСтандарт_РазностьМассивов(Знач Массив, Знач МассивВычитания) Экспорт
	
	Результат = Новый Массив;
	Для Каждого Элемент Из Массив Цикл
		Если МассивВычитания.Найти(Элемент) = Неопределено Тогда
			Результат.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

// Конструктор объекта ОписаниеОповещения
//
// Параметры:
//  ИмяПроцедуры - Строка - имя экспортируемой процедуры модуля
//  Модуль - ФормаКлиентскогоПриложения - для вызова метода модуля указанной формы
//         - КомандаКомандногоИнтерфейса - для вызова метода модуля команды командного интерфейса
//         - ОбщийМодуль - для вызова метода общего неглобального модуля
//  ДополнительныеПараметры - Произвольный - значение любого типа, которое будет передано в вызываемую функцию
//  ИмяПроцедурыОбработкиОшибки - Строка - имя экспортируемой процедуры модуля, которая будет вызвана при ошибке
//  МодульОбработкиОшибки - см. Модуль - аналогичный модуль для обработки ошибки
//
// Возвращаемое значение:
//   ОписаниеОповещения, ФиксированнаяСтруктура - Описание оповещения
//
&НаКлиенте
Функция КонтурСтандарт_ОписаниеОповещения(ИмяПроцедуры, Модуль,
		ДополнительныеПараметры = Неопределено,
		ИмяПроцедурыОбработкиОшибки = Неопределено,
		МодульОбработкиОшибки = Неопределено) Экспорт
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(ИмяПроцедуры);
	МассивПараметров.Добавить(Модуль);
	МассивПараметров.Добавить(ДополнительныеПараметры);
	
	Если ИмяПроцедурыОбработкиОшибки <> Неопределено
		И МодульОбработкиОшибки <> Неопределено Тогда
		МассивПараметров.Добавить(ИмяПроцедурыОбработкиОшибки);
		МассивПараметров.Добавить(МодульОбработкиОшибки);
	КонецЕсли;
	
	Попытка
		ОписаниеОповещения = Новый(Тип("ОписаниеОповещения"), МассивПараметров);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();

		ОписаниеОповещения = Новый Структура;
		ОписаниеОповещения.Вставить("ИмяПроцедуры", ИмяПроцедуры);
		ОписаниеОповещения.Вставить("Модуль", Модуль);
		ОписаниеОповещения.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
		ОписаниеОповещения.Вставить("ИмяПроцедурыОбработкиОшибки", ИмяПроцедурыОбработкиОшибки);
		ОписаниеОповещения.Вставить("МодульОбработкиОшибки", МодульОбработкиОшибки);
		ОписаниеОповещения = Новый ФиксированнаяСтруктура(ОписаниеОповещения);
	КонецПопытки;
	
	Возврат ОписаниеОповещения;
	
КонецФункции // ОписаниеОповещения

// Запускает выполнение процедуры (или функции), описанной в параметре <ВыполняемоеОповещение>.
//
// Параметры:
//  ВыполняемоеОповещение - ОписаниеОповещения - Содержит описание процедуры, вызов которой будет произведен
//  Результат - Произвольный - Значение, которое будет передано в процедуру, описанную
//    параметром <ВыполняемоеОповещение>. Необязательный, значение по умолчанию Ложь.
//
&НаКлиенте
Процедура КонтурСтандарт_ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат = Null) Экспорт
	
	Если ВыполняемоеОповещение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ВыполняемоеОповещение) = Тип("ФиксированнаяСтруктура") Тогда
		Если Результат = Null Тогда
			МассивПараметров = Неопределено;
		Иначе
			МассивПараметров = Новый Массив;
			МассивПараметров.Добавить(Результат);
		КонецЕсли;
		КонтурСтандарт_ВыполнитьОбработкуОповещенияСлужебный(ВыполняемоеОповещение, МассивПараметров);
	Иначе
		Выполнить("ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);");
	КонецЕсли;
	
КонецПроцедуры // ВыполнитьОбработкуОповещенияЛок

&НаКлиенте
Процедура КонтурСтандарт_ВыполнитьОбработкуОповещенияСлужебный(ВыполняемоеОповещение, МассивПараметров = Неопределено)
	
	Если ВыполняемоеОповещение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивСтрокаПараметров = Новый Массив;
	Если ТипЗнч(МассивПараметров) = Тип("Массив")
		ИЛИ ТипЗнч(МассивПараметров) = Тип("ФиксированныйМассив") Тогда
		Для Сч = 0 По МассивПараметров.ВГраница() Цикл
			МассивСтрокаПараметров.Добавить("МассивПараметров[" + Формат(Сч, "ЧН=0; ЧГ=0") + "]");
		КонецЦикла;
	КонецЕсли;
	МассивСтрокаПараметров.Добавить("ВыполняемоеОповещение.ДополнительныеПараметры");
	СтрокаПараметров = КонтурСтандарт_СтрСоединить_(МассивСтрокаПараметров, ", ");
	
	Скрипт = "ВыполняемоеОповещение.Модуль.%1(%2)";
	Скрипт = СтрЗаменить(Скрипт, "%1", ВыполняемоеОповещение.ИмяПроцедуры);
	Скрипт = СтрЗаменить(Скрипт, "%2", СтрокаПараметров);
	
	Выполнить(Скрипт);
	
КонецПроцедуры // ВыполнитьОбработкуОповещенияСлужебный

// #КонецОбласти

// #Область Служебный_интерфейс

&НаКлиенте
Функция КонтурСтандарт_НовыйМенеджерНастроек()
	
	МенеджерНастроек = Новый Структура;
	
    МенеджерНастроек.Вставить("РезультатФункции_ВерсияПлатформыНеНижеУказанной");
	МенеджерНастроек.Вставить("РезультатФункции_ВерсияРежимСовместимостиНеНижеУказанной");
	
	Возврат МенеджерНастроек;
	
КонецФункции

&НаКлиенте
Функция КонтурСтандарт_СтрРазделить_Совместимость(Строка, Разделитель, ВключатьПустые = Истина)
	
	ПропускатьПустыеСтроки = НЕ ВключатьПустые;	
	Результат = Новый Массив;
	
	НачалоСтроки = 1;
	
	Для Позиция = 1 По СтрДлина(Строка) Цикл 
		Символ = Сред(Строка, Позиция, 1);
		Если Найти(Разделитель, Символ) > 0 Тогда
			Результат.Добавить(Сред(Строка, НачалоСтроки, Позиция - НачалоСтроки));	
			НачалоСтроки = Позиция + 1;
		КонецЕсли;
	КонецЦикла;
	
	Значение = Сред(Строка, НачалоСтроки, Позиция - НачалоСтроки);
	Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Значение) Тогда
		Результат.Добавить(Значение);
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция КонтурСтандарт_РежимСовместимостиСтрокой_Сервер()
	
	Возврат Строка(Метаданные.РежимСовместимости);	
	
КонецФункции

// Вставляет параметры в строку, учитывая, что в параметрах могут использоваться подстановочные слова %1, %2 и т.д. 
&НаКлиенте
Функция КонтурСтандарт_ПодставитьПараметрыСПроцентом(Знач СтрокаПодстановки, Знач Параметр1, Знач Параметр2 = Неопределено, Знач Параметр3 = Неопределено,	
													Знач Параметр4 = Неопределено, Знач Параметр5 = Неопределено, Знач Параметр6 = Неопределено,
													Знач Параметр7 = Неопределено, Знач Параметр8 = Неопределено, Знач Параметр9 = Неопределено,
													Знач Параметр10 = Неопределено)
	
	Результат = "";
	Позиция = КонтурСтандарт_СтрНайти_(СтрокаПодстановки, "%");
		
	КартаПараметров = Новый Соответствие;
	КартаПараметров.Вставить("1", Параметр1);
	КартаПараметров.Вставить("(1)", Параметр1);
	КартаПараметров.Вставить("2", Параметр2);
	КартаПараметров.Вставить("(2)", Параметр2);
	КартаПараметров.Вставить("3", Параметр3);
	КартаПараметров.Вставить("(3)", Параметр3);
	КартаПараметров.Вставить("4", Параметр4);
	КартаПараметров.Вставить("(4)", Параметр4);
	КартаПараметров.Вставить("5", Параметр5);
	КартаПараметров.Вставить("(5)", Параметр5);
	КартаПараметров.Вставить("6", Параметр6);
	КартаПараметров.Вставить("(6)", Параметр6);
	КартаПараметров.Вставить("7", Параметр7);
	КартаПараметров.Вставить("(7)", Параметр7);
	КартаПараметров.Вставить("8", Параметр8);
	КартаПараметров.Вставить("(8)", Параметр8);
	КартаПараметров.Вставить("9", Параметр9);
	КартаПараметров.Вставить("(9)", Параметр9);
	КартаПараметров.Вставить("10", Параметр10);
	КартаПараметров.Вставить("(10)", Параметр10);

	Пока Позиция > 0 Цикл
		Результат = Результат + Лев(СтрокаПодстановки, Позиция - 1);
		СимволПослеПроцента = Сред(СтрокаПодстановки, Позиция + 1, 1);
		Если СимволПослеПроцента = "(" Тогда
			СимволПослеПроцента = Сред(СтрокаПодстановки, Позиция + 1, КонтурСтандарт_СтрНайти_(СтрокаПодстановки, ")", , Позиция) - Позиция);
		КонецЕсли;
		Если Сред(СтрокаПодстановки, Позиция + 1 + 1, 1) = "0" Тогда
			СимволПослеПроцента = СимволПослеПроцента + "0";
		КонецЕсли;
		ПодставляемыйПараметр = КартаПараметров.Получить(СимволПослеПроцента);
		Если ПодставляемыйПараметр = Неопределено Тогда
			СтрокаПодстановки = Сред(СтрокаПодстановки, Позиция + СтрДлина(СимволПослеПроцента) + 1);
		Иначе
			Результат = Результат + ПодставляемыйПараметр;
			СтрокаПодстановки = Сред(СтрокаПодстановки, Позиция + СтрДлина(СимволПослеПроцента) + 1);
		КонецЕсли;
		Позиция = КонтурСтандарт_СтрНайти_(СтрокаПодстановки, "%");
	КонецЦикла;
	
	Результат = Результат + СтрокаПодстановки;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция КонтурСтандарт_СкопироватьСтруктуру(СтруктураИсточник, ФиксироватьДанные) 
	
	СтруктураРезультат = Новый Структура;
	
	Для Каждого КлючИЗначение Из СтруктураИсточник Цикл
		СтруктураРезультат.Вставить(КлючИЗначение.Ключ, 
		КонтурСтандарт_СкопироватьРекурсивно(КлючИЗначение.Значение, ФиксироватьДанные));
	КонецЦикла;
	
	Если ФиксироватьДанные = Истина 
		Или ФиксироватьДанные = Неопределено
		И ТипЗнч(СтруктураИсточник) = Тип("ФиксированнаяСтруктура") Тогда 
		Возврат Новый ФиксированнаяСтруктура(СтруктураРезультат);
	КонецЕсли;
	
	Возврат СтруктураРезультат;
	
КонецФункции

