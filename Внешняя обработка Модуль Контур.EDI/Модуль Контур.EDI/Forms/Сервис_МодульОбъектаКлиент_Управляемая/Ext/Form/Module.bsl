// Метод для создания и инициализации структуры данных авторизации в API Диадок.
// В зависимости от выбранного типа авторизации заполняет структуру соответствующими полями.
//
// Параметры:
//   ТипАвторизации - Строка - Тип авторизации, значение из метода КонтурДиадокAPI_ТипыАвторизации.
//
// Возвращаемое значение:
//   Структура - Структура, содержащая поля для авторизации в зависимости от типа:
//     * ТипАвторизации - Строка - Выбранный тип авторизации.
//     Для типа "ЛогинПароль":
//       ** Логин  - Строка - Логин пользователя.
//       ** Пароль - Строка - Пароль пользователя.
//       ** Токен  - Строка - Токен доступа (заполняется после авторизации).
//     Для типа "Сертификат":
//       ** Отпечаток           - Строка - Отпечаток сертификата.
//       ** Расположение        - Строка - Путь к файлу сертификата.
//       ** ПарольЗакрытогоКлюча - Строка - Пароль к закрытому ключу.
//       ** ДвоичныеДанные      - ДвоичныеДанные, Неопределено - Данные сертификата в двоичном виде.
//       ** Токен               - Строка - Токен доступа (заполняется после авторизации).
//     Для типа "ИдентификаторСессии":
//       ** ИдентификаторСессии - Строка - Идентификатор активной сессии.
//       ** Токен               - Строка - Токен доступа (заполняется после авторизации).
//
&НаКлиенте
Функция КонтурДиадокAPI_НовыйДанныеАвторизации(ТипАвторизации) Экспорт
	
	ДанныеАвторизацииДиадок = Новый Структура("ТипАвторизации");
	ТипыАвторизации = КонтурДиадокAPI_ТипыАвторизации();               
	
	Если ТипАвторизации = ТипыАвторизации.ЛогинПароль Тогда
		
		ДанныеАвторизацииДиадок.ТипАвторизации = ТипыАвторизации.ЛогинПароль;	
		ДанныеАвторизацииДиадок.Вставить("Логин", "");
		ДанныеАвторизацииДиадок.Вставить("Пароль", "");
		ДанныеАвторизацииДиадок.Вставить("Токен", "");
		
	ИначеЕсли ТипАвторизации = ТипыАвторизации.Сертификат Тогда
		
		ДанныеАвторизацииДиадок.ТипАвторизации = ТипыАвторизации.Сертификат;	
		ДанныеАвторизацииДиадок.Вставить("Отпечаток", "");
		ДанныеАвторизацииДиадок.Вставить("Расположение", "");
		ДанныеАвторизацииДиадок.Вставить("ПарольЗакрытогоКлюча", "");
		ДанныеАвторизацииДиадок.Вставить("ДвоичныеДанные", Неопределено);
		ДанныеАвторизацииДиадок.Вставить("Токен", "");
		
	ИначеЕсли ТипАвторизации = ТипыАвторизации.ИдентификаторСессии Тогда
		
		ДанныеАвторизацииДиадок.ТипАвторизации = ТипыАвторизации.ИдентификаторСессии;	
		ДанныеАвторизацииДиадок.Вставить("ИдентификаторСессии", "");
		ДанныеАвторизацииДиадок.Вставить("Токен", "");
		
	Иначе
		
		ВызватьИсключение "Задан некорректный способ авторизации";
		
	КонецЕсли;
	
    Возврат ДанныеАвторизацииДиадок;
	
КонецФункции

// Метод возвращает структуру, содержащую доступные типы авторизации для работы с API Диадок.
//
// Возвращаемое значение:
//   Структура - Содержит ключи и соответствующие им строковые значения типов авторизации:
//     * ЛогинПароль        - Строка - Авторизация по логину и паролю.
//     * Сертификат         - Строка - Авторизация по сертификату.
//     * ИдентификаторСессии - Строка - Авторизация по идентификатору сессии.
//
&НаКлиенте
Функция КонтурДиадокAPI_ТипыАвторизации() Экспорт
	
	ТипыАвторизации = Новый Структура;
	
	ТипыАвторизации.Вставить("ЛогинПароль", 		"password");
	ТипыАвторизации.Вставить("Сертификат", 			"certificate");
	ТипыАвторизации.Вставить("ИдентификаторСессии", "sid");
	
	Возврат ТипыАвторизации;
	
КонецФункции

// Метод для получения авторизационного токена в API Диадок.
// Поддерживает три способа авторизации: по логину и паролю, по сертификату и по идентификатору сессии.
// При авторизации по сертификату возвращает подтверждение авторизации после расшифровки ответа.
// В случае HTTP ответа отличного от "200", выбрасывает исключение.
//
// Параметры:
