	ПараметрыМетода.ТелоЗапроса 				= ТелоЗапроса;
	ПараметрыМетода.ОтветВЛокальныхИменах 		= ОтветВЛокальныхИменах;
	
	Результат = КонтурДиадокAPI_ВызватьФункциюAPIНаСервере("КонтурДиадокAPI_ПодготовитьДокументыКПодписанию", ПараметрыМетода);
	
