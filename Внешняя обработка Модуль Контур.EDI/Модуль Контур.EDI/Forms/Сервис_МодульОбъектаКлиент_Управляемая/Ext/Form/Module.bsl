	ВариантыНастройки = Новый Структура;
	
	// Windows
	
	КриптоПроГОСТ2012 			= Криптография_НовыйВариантНастройкиКриптографии(80, "Crypto-Pro GOST R 34.10-2012 Cryptographic Service Provider");
	КриптоПроГОСТ2012SystemCSP 	= Криптография_НовыйВариантНастройкиКриптографии(80, "Crypto-Pro GOST R 34.10-2012 System CSP");
