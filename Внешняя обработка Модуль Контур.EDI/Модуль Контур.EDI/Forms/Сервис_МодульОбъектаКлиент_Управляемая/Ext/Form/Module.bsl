// Получает новую версию модуля из сервиса обновлений
// и записывает его файл на диске
//
// Параметры:
//  ПутьКФайлу - Строка - путь к файлу на диске,
//               в который нужно записать новую версию модуля;
//  ОписаниеОбновления - Структура - см. функцию НовоеОписаниеОбновленияМодуля();
//
&НаКлиенте
Процедура ВыполнитьОбновлениеМодуляВФайлНаДиске(ПутьКФайлу, НоваяВерсия)
		
	ПараметрыМетода = Новый Структура("Версия", НоваяВерсия);
	
	ФайлНовойВерсии = ВыполнитьМетодМодуляОбъекта("Функция", "СкачатьКонтентВерсии_КонтурEDI", ПараметрыМетода).ДвоичныеДанные;
	
	ФайлНовойВерсии.Записать(ПутьКФайлу);
	
КонецПроцедуры

// Проверяет наличие файла модуля и возможность записи в его каталог
//
// Параметры:
//  ПутьКФайлу - Строка - путь к файлу модуля
// 
// Возвращаемое значение:
//  Строка - описание ошибки
//
&НаКлиенте
Функция ПроверитьВозможностьОбновленияФайлаМодуля(ПутьКФайлу) Экспорт
	
	// Метод присутствует в клиентском и серверном модулях
	
	ТекстОшибки = "";
	
	Файл = Новый Файл(ПутьКФайлу);
	Каталог	 = Файл.Путь;
	ИмяФайла = Файл.Имя;
	
	Если Файл.Существует() Тогда
		
		Попытка
			ПутьКТестовомуФайлу = Каталог + Новый УникальныйИдентификатор;
			СоздатьКаталог(ПутьКТестовомуФайлу);
			УдалитьФайлы(ПутьКТестовомуФайлу);
		Исключение
			Ошибка		 = ИнформацияОбОшибке();
			ТекстОшибки	 = НСтр("ru = 'Ошибка! Не удалось записать файл в каталог, где находится модуль. Возможно нет прав.'");
		КонецПопытки;
		
	Иначе
		ТекстОшибки = НСтр("ru = 'Ошибка! Не найден файл модуля.'");
	КонецЕсли;
	
	Возврат ТекстОшибки;
	
КонецФункции

