// Скачивает новую версию файла модуля из сервиса обновлений
// и записывает его на диск или в справочник внешних обработок
//
// Параметры:
//  КонтекстОбновленияМодуля - Структура - см. функцию КонтекстОбновленияМодуля_КонтурEDI();
//
&НаКлиенте
Процедура ВыполнитьОбновлениеМодуля(КонтекстОбновленияМодуля, ТипОбновления = "Полуавтоматически") Экспорт
	
	// Метод присутствует в клиентском и серверном модулях
	
	РасположенияМодуля = ПеречисленияEDI_ВариантыРасположенияМодуля();
	ПутьКМодулю = КонтекстОбновленияМодуля.ПутьКМодулю;
	НоваяВерсия = КонтекстОбновленияМодуля.НоваяВерсия;	
	ТипКонтента = КонтекстОбновленияМодуля.ТипКонтента;	
	Расположение = КонтекстОбновленияМодуля.Расположение;
	
	Если Расположение = РасположенияМодуля.Файл Тогда
		
		ВыполнитьОбновлениеМодуляВФайлНаДиске(ПутьКМодулю, НоваяВерсия);
		
	ИначеЕсли Расположение = РасположенияМодуля.Справочник Тогда
		
		ВыполнитьОбновлениеМодуляВСправочнике(ПутьКМодулю, НоваяВерсия);
		
	ИначеЕсли Расположение = РасположенияМодуля.Расширение Тогда
		
		ВыполнитьОбновлениеМодуляВРасширении(НоваяВерсия, ТипКонтента);
		
	Иначе
		
		ТекстОшибки = ШаблонСтр(НСтр(
		"ru = 'Не удалось обновить модуль!
		|Некорректное расположение модуля: %1'"), Расположение);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	УстановитьПризнакМодульБылОбновленАвтоматически();	
	
	Метрика_ОбновлениеМодуля(КонтекстОбновленияМодуля,, ТипОбновления);
	
КонецПроцедуры

