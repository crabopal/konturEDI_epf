КонецФункции

&НаКлиенте
Функция Криптография_ПолучитьДанныеСертификата(ОтпечатокСертификата, ПараметрыПоиска)
	
	Если НЕ ТипЗнч(ОтпечатокСертификата) = Тип("ДвоичныеДанные") Тогда
		
		КлючКэшаСертификатов = ОтпечатокСертификата;
		Отпечаток = КонтурСтандарт_ПолучитьДвоичныеДанныеИзHexСтроки_(ОтпечатокСертификата);
		
	Иначе      
		
		КлючКэшаСертификатов = КонтурСтандарт_ПолучитьHexСтрокуИзДвоичныхДанных_(ОтпечатокСертификата);
		Отпечаток = ОтпечатокСертификата; 
		
	КонецЕсли;
	
	МенеджерНастроек = Криптография_МенеджерНастроек();
	
	СертификатКриптографии = МенеджерНастроек.КэшСертификатов.Получить(КлючКэшаСертификатов); 
	
	Если СертификатКриптографии = Неопределено Тогда
	
		ХранилищеСертификатовКриптографии = Криптография_ПолучитьХранилищеСертификатов(ПараметрыПоиска.Тип, ПараметрыПоиска.Расположение);

		СертификатКриптографии = ХранилищеСертификатовКриптографии.НайтиПоОтпечатку(Отпечаток);
		
		МенеджерНастроек.КэшСертификатов.Вставить(КлючКэшаСертификатов, СертификатКриптографии);
		
	КонецЕсли;	
	
	Результат = Криптография_НовыйОписаниеСертификата(СертификатКриптографии, Истина);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Криптография_НовыйОписаниеСертификата(СертификатКриптографии, ДобавлятьДвоичныеДанные = Истина)
	
	Результат = Новый Структура();
	
	Результат.Вставить("Отпечаток", КонтурСтандарт_ПолучитьHexСтрокуИзДвоичныхДанных_(СертификатКриптографии.Отпечаток));
	Результат.Вставить("ОткрытыйКлюч", КонтурСтандарт_ПолучитьHexСтрокуИзДвоичныхДанных_(СертификатКриптографии.ОткрытыйКлюч));
	Результат.Вставить("СерийныйНомер", КонтурСтандарт_ПолучитьHexСтрокуИзДвоичныхДанных_(СертификатКриптографии.СерийныйНомер));
	Результат.Вставить("Издатель", КонтурСтандарт_СкопироватьРекурсивно(СертификатКриптографии.Издатель, Ложь));
	
	Результат.Вставить("Субъект", КонтурСтандарт_СкопироватьРекурсивно(СертификатКриптографии.Субъект, Ложь));
	
	Если СертификатКриптографии.Субъект.Свойство("OGRN") Тогда
		Результат.Субъект.Вставить("ОГРН", СертификатКриптографии.Субъект.OGRN);
	ИначеЕсли СертификатКриптографии.Субъект.Свойство("OID1_2_643_100_1") Тогда
		Результат.Субъект.Вставить("ОГРН", СертификатКриптографии.Субъект.OID1_2_643_100_1);
	КонецЕсли;
	
	Если СертификатКриптографии.Субъект.Свойство("SNILS") Тогда
		Результат.Субъект.Вставить("СНИЛС", СертификатКриптографии.Субъект.SNILS);
	ИначеЕсли СертификатКриптографии.Субъект.Свойство("OID1_2_643_100_3") Тогда
		Результат.Субъект.Вставить("СНИЛС", СертификатКриптографии.Субъект.OID1_2_643_100_3);
	КонецЕсли;
	
	Если СертификатКриптографии.Субъект.Свойство("INN") Тогда
		Результат.Субъект.Вставить("ИНН", СертификатКриптографии.Субъект.INN);
	ИначеЕсли СертификатКриптографии.Субъект.Свойство("OID1_2_643_3_131_1_1") Тогда
		Результат.Субъект.Вставить("ИНН", СертификатКриптографии.Субъект.OID1_2_643_3_131_1_1);
	КонецЕсли;
	
	Результат.Вставить("Версия", СертификатКриптографии.Версия);
	Результат.Вставить("ИспользоватьДляПодписи", СертификатКриптографии.ИспользоватьДляПодписи);
	Результат.Вставить("ИспользоватьДляШифрования", СертификатКриптографии.ИспользоватьДляШифрования);
	Результат.Вставить("ДатаНачала", СертификатКриптографии.ДатаНачала);
	Результат.Вставить("ДатаОкончания", СертификатКриптографии.ДатаОкончания);
	Результат.Вставить("РасширенныеСвойства", Новый Структура(СертификатКриптографии.РасширенныеСвойства));
	Результат.Вставить("ДвоичныеДанные", Неопределено);
	Результат.Вставить("АлгоритмКлюча", "");
	
	Если ДобавлятьДвоичныеДанные Тогда
		
		Результат.ДвоичныеДанные = СертификатКриптографии.Выгрузить();	
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Криптография_ОтпечатокСертификатаСтрокой(ОтпечатокСертификата)
	
	Если НЕ ТипЗнч(ОтпечатокСертификата) = Тип("ДвоичныеДанные") Тогда
		ОтпечатокСтрокой = ОтпечатокСертификата;
	Иначе      
		ОтпечатокСтрокой = КонтурСтандарт_ПолучитьHexСтрокуИзДвоичныхДанных_(ОтпечатокСертификата);		
	КонецЕсли;
	
	Возврат ОтпечатокСтрокой; 
	
КонецФункции

&НаКлиенте
Функция Криптография_ЕстьБлокирующиеОшибки(ТекстОшибки)
	
	ТекстОшибкиНРег = НРег(ТекстОшибки);
	
	ЭтоОшибкаПароляКонтейнера = Найти(ТекстОшибкиНРег, "неправильный пароль доступа к закрытому ключу")
							ИЛИ Найти(ТекстОшибкиНРег, "контекст был получен в ограниченном режиме")
							ИЛИ Найти(ТекстОшибкиНРег, "incorrect access password to a private key")
							ИЛИ Найти(ТекстОшибкиНРег, "ошибка при установке параметра модуля криптографии")
							ИЛИ Найти(ТекстОшибкиНРег, "ошибка при расшифровании криптографических данных");
							
	Если ЭтоОшибкаПароляКонтейнера Тогда
		ТекстОшибки = "Неправильный пароль доступа к закрытому ключу";
	КонецЕсли;
	
	Возврат ЭтоОшибкаПароляКонтейнера;
		
КонецФункции

&НаКлиенте
Функция Криптография_ОбработатьВариантНастройкиИзТекстаОшибки(ТекстОшибки)
	
	ВариантНастройкиИзТекстаОшибки = Неопределено;
	
	ТекстОшибкиНРег = НРег(ТекстОшибки);

	Если Найти(ТекстОшибкиНРег, "сертификат, связанный с закрытым ключом, указывает на модуль криптографии, отличный от текущего") Тогда
		
		ВариантыНастроек = Криптография_ВариантыНастройкиПоТипуПлатформы(); 	
		
		Для Каждого ВариантНастроек Из ВариантыНастроек Цикл
			
			Если Найти(ТекстОшибкиНРег, НРег(ВариантНастроек.ИмяМодуляКриптографии))
				И Найти(ТекстОшибкиНРег, НРег(ВариантНастроек.ТипМодуляКриптографии)) Тогда
				
				ВариантНастройкиИзТекстаОшибки = ВариантНастроек;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ВариантНастройкиИзТекстаОшибки = Неопределено Тогда
			
			ВызватьИсключение ТекстОшибки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ВариантНастройкиИзТекстаОшибки;
	
КонецФункции

&НаКлиенте
Функция Криптография_РасшифроватьКонтент(ИсходныеДанные, СертификатКриптографии = Неопределено, ПарольДоступаКЗакрытомуКлючу = Неопределено, ВариантНастройки = Неопределено)
	
