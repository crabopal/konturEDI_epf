	    ОписаниеОшибки = ОписаниеОшибки();
		Если Найти(ОписаниеОшибки, КонтурДиадокAPI_ИдентификаторОшибкиОбновитьТокенАвторизации()) > 0 Тогда
			КонтурДиадокAPI_ОбновитьТокенАвторизации(ПараметрыМетода.ДанныеАвторизацииДиадок);
			Результат = КонтурДиадокAPI_ВыполнитьСервернуюФункцию(ИмяМетода, ПараметрыМетода);
		Иначе
			ВызватьИсключение;
		КонецЕсли;		
	КонецПопытки;	
	
	Возврат Результат;
	
КонецФункции

// Осуществляет попытку преобразования объекта в структуру, описанной схемой.  
// Список всех доступных схем см. КонтурEDIAPI_ИнициализироватьСхемы  
//
// Параметры:
//   Схема - Строка - Имя схемы по которой следует привести объект.	
//   ОбъектКонвертации - Структура - Входная структура для приведения по схеме 
//   ЛокальныеИмена - Булево - флаг отвечающий за локализацию ключей структуры ответа метода
//
// Возвращаемое значение:
//   Структура - приведенная модель по переданному объекту и схеме  
//
&НаКлиенте
Функция КонтурДиадокAPI_Привести(Схема, ОбъектКонвертации, ЛокальныеИмена = Ложь) Экспорт  
	
	МенеджерНастроек = КонтурДиадокAPI_МенеджерНастроек();
	ХранилищеСхем	 = МенеджерНастроек.ХранилищеСхем;
	
	ПриведенныйОбъект = Неопределено;
	
	Если Схема = "PowerOfAttorneyToPost" 
		И НЕ ОбъектКонвертации = Неопределено Тогда  
		
		ПриведенныйОбъект = КонтурДиадокAPI_Привести_PowerOfAttorneyToPost(ХранилищеСхем, Схема, ОбъектКонвертации, ЛокальныеИмена);			
		
	ИначеЕсли Схема = "PowerOfAttorneyToRegister"
		И НЕ ОбъектКонвертации = Неопределено Тогда
		
		ПриведенныйОбъект = КонтурДиадокAPI_Привести_PowerOfAttorneyToRegister(ХранилищеСхем, Схема, ОбъектКонвертации, ЛокальныеИмена);	
		
	Иначе
		
		ПриведенныйОбъект = ПостроительСхем_ПривестиПоСхеме(ХранилищеСхем, Схема, ОбъектКонвертации, ЛокальныеИмена);
		
	КонецЕсли;	
	
	Возврат ПриведенныйОбъект; 
	
КонецФункции

// Осуществляет попытку создать структуру, описанной схемой.  
//
// Параметры:
//   Схема - Строка - Имя схемы по которой следует создать структуру.	
//   ЛокальныеИмена - Булево - флаг отвечающий за локализацию ключей структуры ответа метода
//
// Возвращаемое значение:
//   Структура - приведенная модель по схеме  
//
&НаКлиенте
Функция КонтурДиадокAPI_СоздатьПоСхеме(Схема, ЛокальныеИмена = Ложь) Экспорт
	
	МенеджерНастроек = КонтурДиадокAPI_МенеджерНастроек();
	ХранилищеСхем	 = МенеджерНастроек.ХранилищеСхем;
	
	СозданныйОбъект = Неопределено;
	
	СозданныйОбъект = ПостроительСхем_ПривестиПоСхеме(ХранилищеСхем, Схема, Неопределено, ЛокальныеИмена);
	
	Возврат СозданныйОбъект; 
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЙ ИНТЕРФЕЙС

&НаКлиенте
Процедура КонтурДиадокAPI_ОбновитьТокенАвторизации(ДанныеАвторизацииДиадок)
		
	ДанныеАвторизацииДиадок.Токен = "";
		
	КонтурДиадокAPI_ЗаписатьТокенВКэш(ДанныеАвторизацииДиадок);	
	
	КонтурДиадокAPI_УстановитьТокенДляЗапроса(ДанныеАвторизацииДиадок);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтурДиадокAPI_УстановитьТокенДляЗапроса(ДанныеАвторизацииДиадок)
	
	ТипыАвторизации = КонтурДиадокAPI_ТипыАвторизации();
	
	Если ДанныеАвторизацииДиадок.ТипАвторизации = ТипыАвторизации.Сертификат И ДанныеАвторизацииДиадок.Расположение = "сервер" Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеАвторизацииДиадок.Токен) Тогда
		
		ДанныеАвторизацииДиадок.Токен = КонтурДиадокAPI_ПрочитатьТокенИзКэша(ДанныеАвторизацииДиадок);	
			
		Если ПустаяСтрока(ДанныеАвторизацииДиадок.Токен) Тогда
			
			ЗашифрованныйКонтент = КонтурДиадокAPI_Авторизоваться(ДанныеАвторизацииДиадок);
			
			Если ДанныеАвторизацииДиадок.ТипАвторизации = ТипыАвторизации.Сертификат Тогда
				РасшифрованныйТокен = Криптография_Расшифровать(ЗашифрованныйКонтент, , ДанныеАвторизацииДиадок.ПарольЗакрытогоКлюча);
				ДанныеАвторизацииДиадок.Токен = КонтурСтандарт_Base64Строка(РасшифрованныйТокен);    
			ИначеЕсли ДанныеАвторизацииДиадок.ТипАвторизации = ТипыАвторизации.ЛогинПароль Тогда
				ДанныеАвторизацииДиадок.Токен 	= ЗашифрованныйКонтент;	
			Иначе         
				ВызватьИсключение "КонтурДиадокAPI: Неизвестный тип авторизации для получения токена";	
			КонецЕсли;
			
			КонтурДиадокAPI_ЗаписатьТокенВКэш(ДанныеАвторизацииДиадок);	
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КонтурДиадокAPI_ЗаписатьТокенВКэш(ДанныеАвторизацииДиадок)
	
	МенеджерНастроек = КонтурДиадокAPI_МенеджерНастроек();
	
	КлючНастроек = КонтурДиадокAPI_КлючНастроекТокенаПоДаннымАвторизации(ДанныеАвторизацииДиадок);

	МенеджерНастроек.КэшТокенов.Вставить(КлючНастроек, ДанныеАвторизацииДиадок.Токен);

КонецПроцедуры

&НаКлиенте
Функция КонтурДиадокAPI_ПрочитатьТокенИзКэша(ДанныеАвторизацииДиадок)
	
	МенеджерНастроек = КонтурДиадокAPI_МенеджерНастроек();
	
	КлючНастроек = КонтурДиадокAPI_КлючНастроекТокенаПоДаннымАвторизации(ДанныеАвторизацииДиадок);
	
	Токен = МенеджерНастроек.КэшТокенов.Получить(КлючНастроек);
	
	Возврат ?(Токен = Неопределено, "", Токен); 

КонецФункции

&НаКлиенте
Функция КонтурДиадокAPI_КлючНастроекТокенаПоДаннымАвторизации(ДанныеАвторизацииДиадок)
	
	ТипыАвторизации = КонтурДиадокAPI_ТипыАвторизации();
	
	КлючНастроек = Неопределено;
	
	Если ДанныеАвторизацииДиадок.ТипАвторизации = ТипыАвторизации.ЛогинПароль Тогда
		КлючНастроек = ДанныеАвторизацииДиадок.Логин;	
	ИначеЕсли ДанныеАвторизацииДиадок.ТипАвторизации = ТипыАвторизации.Сертификат Тогда
		КлючНастроек = ДанныеАвторизацииДиадок.Отпечаток;	
	ИначеЕсли ДанныеАвторизацииДиадок.ТипАвторизации = ТипыАвторизации.ИдентификаторСессии Тогда
		КлючНастроек = ДанныеАвторизацииДиадок.ИдентификаторСессии;		
	Иначе	
		КлючНастроек = "";	
	КонецЕсли;
	
	Возврат КлючНастроек;
	
КонецФункции

&НаКлиенте
Функция КонтурДиадокAPI_ИдентификаторОшибкиОбновитьТокенАвторизации()

	Возврат "DIADOC_API_ERROR_REFRESH_TOKEN_CLIENT";
	
КонецФункции

&НаСервере
Функция КонтурДиадокAPI_ВыполнитьСервернуюФункцию(Знач ИмяМетода, Знач ПараметрыМетода = Неопределено)

	Результат = Неопределено;
	
	МодульОбъекта = МодульОбъекта();
	
	СтрокаПараметров = "";
	Если ЗначениеСоответствуетТипу(ПараметрыМетода, "Структура") Тогда
		Для Каждого Параметр Из ПараметрыМетода Цикл
			СтрокаПараметров = СтрокаПараметров + ?(ПустаяСтрока(СтрокаПараметров), "", ",") + "ПараметрыМетода." + Параметр.Ключ;				
		КонецЦикла;
	КонецЕсли;
	
	ТекстВычислить = "МодульОбъекта." + ИмяМетода + "(" + СтрокаПараметров + ")";
	
	Результат = Вычислить(ТекстВычислить);	
	                                                                            
	Возврат Результат;

КонецФункции


////////////////////////////////////////////////////////////////////////
// Специфичная обработка приведения схем моделей

&НаКлиенте
Функция КонтурДиадокAPI_Привести_PowerOfAttorneyToPost(ХранилищеСхем, Схема, ОбъектКонвертации, ЛокальныеИмена = Ложь)
	
	ПриведенныйОбъект = ПостроительСхем_ПривестиПоСхеме(ХранилищеСхем, Схема, ОбъектКонвертации, ЛокальныеИмена);
	
	Если ЗначениеЗаполнено(ПриведенныйОбъект.Content.Content.Content)
		И ЗначениеЗаполнено(ПриведенныйОбъект.Content.Signature.Content) Тогда
		
		ПриведенныйОбъект.Удалить("FullId");
		ПриведенныйОбъект.Удалить("UseDefault");
		ПриведенныйОбъект.Удалить("SendAsFile");
		
	ИначеЕсли ЗначениеЗаполнено(ПриведенныйОбъект.FullId.RegistrationNumber)
		И ЗначениеЗаполнено(ПриведенныйОбъект.FullId.IssuerInn)
		И ЗначениеЗаполнено(ПриведенныйОбъект.FullId.RepresentativeInn) Тогда
		
		ПриведенныйОбъект.Удалить("Content");
		ПриведенныйОбъект.Удалить("UseDefault");
		
	ИначеЕсли ПриведенныйОбъект.UseDefault = Истина Тогда
		
		ПриведенныйОбъект.Удалить("FullId");
		ПриведенныйОбъект.Удалить("Content");
		
	Иначе
		
		ПриведенныйОбъект = Неопределено;
		
	КонецЕсли;
	
	Возврат ПриведенныйОбъект;
	
КонецФункции

&НаКлиенте
Функция КонтурДиадокAPI_Привести_PowerOfAttorneyToRegister(ХранилищеСхем, Схема, ОбъектКонвертации, ЛокальныеИмена = Ложь)
	
	ПриведенныйОбъект = ПостроительСхем_ПривестиПоСхеме(ХранилищеСхем, Схема, ОбъектКонвертации, ЛокальныеИмена);
	
	Если ЗначениеЗаполнено(ПриведенныйОбъект.Content.Content.Content)
		И ЗначениеЗаполнено(ПриведенныйОбъект.Content.Signature.Content) Тогда
		
		ПриведенныйОбъект.Удалить("FullId");
		
	ИначеЕсли ЗначениеЗаполнено(ПриведенныйОбъект.FullId.RegistrationNumber)
		И ЗначениеЗаполнено(ПриведенныйОбъект.FullId.IssuerInn)
		И ЗначениеЗаполнено(ПриведенныйОбъект.FullId.RepresentativeInn) Тогда
		
		ПриведенныйОбъект.Удалить("Content");
		
	Иначе
		
		ПриведенныйОбъект = Новый Структура;
		
	КонецЕсли;
	
	Возврат ПриведенныйОбъект;
	
КонецФункции

// #КонецОбласти

// #Область АутентификацияНаУФ

&НаКлиенте
Функция КлиентАутентификации(Организация = Неопределено)

	ПараметрыФормы = Новый Структура("Организация", Организация);
    КлиентАутентификации = ПолучитьФорму_КонтурEDI("Аутентификатор_Клиент", , ПараметрыФормы, ВладелецФормы);
	
	Возврат КлиентАутентификации;

КонецФункции

&НаКлиенте
Процедура АутентификацияНаКлиенте(ФормаОповещения, Организация = Неопределено) Экспорт

    Аутентификатор = КлиентАутентификации(Организация);
	ДополнительныеПараметры = Новый Соответствие;
	Оповещение = КонтурСтандарт_ОписаниеОповещения("ПослеАутентификации", ФормаОповещения, ДополнительныеПараметры);
	Аутентификатор.НачатьПолучениеСессии(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура СформироватьМетрикиФормыАутентификации(ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(ДополнительныеПараметры) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФормыАутентификации = "Аутентификатор_Клиент";
	ФормаАутентификации = КлиентАутентификации();

	СтэкДействий = ДополнительныеПараметры.Получить("Стэк");
	Если СтэкДействий <> Неопределено И ТипЗнч(СтэкДействий) = Тип("Массив") Тогда
		Для Каждого Действие Из СтэкДействий Цикл
			Если Действие = "ОткрытаФорма" Тогда
				ОсновнаяФорма().ПриОткрытииФормы(ФормаАутентификации, ИмяФормыАутентификации);
			ИначеЕсли Действие = "ЗакрытаФорма" Тогда
				ОсновнаяФорма().ПриЗакрытииФормы(ФормаАутентификации, ИмяФормыАутентификации);
			ИначеЕсли Действие = "БраузерОткрылся" Тогда
				НоваяМетрика().Информация("Аутентификация", "Браузер открылся").НаФорме(ФормаАутентификации).ПоместитьВОчередь();
			ИначеЕсли Лев(Действие, СтрДлина("Аутентификация")) = "Аутентификация" Тогда
				_ПортальныйИд = Сред(Действие, СтрДлина("Аутентификация")+2);
				НоваяМетрика().Информация("Аутентификация", _ПортальныйИд).НаФорме(ФормаАутентификации).ПоместитьВОчередь();
			Иначе	
				Кнопка = Новый Структура("Имя", Действие);
    			НоваяМетрика().НажатаКнопка(Кнопка).НаФорме(ФормаАутентификации).ПоместитьВОчередь();
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
		
	СтэкОшибок = ДополнительныеПараметры.Получить("Ошибки");
	Если СтэкОшибок <> Неопределено И ТипЗнч(СтэкОшибок) = Тип("Массив") Тогда
		Для Каждого Ошибка Из СтэкОшибок Цикл
			Если ТипЗнч(Ошибка) = Тип("ИнформацияОбОшибке") Тогда
				Ошибка = Ошибка.Описание;
			КонецЕсли;
			НоваяМетрика().Ошибка("Аутентификация", Ошибка).НаФорме(ФормаАутентификации).ПоместитьВОчередь();
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

