	Результат = КонтурДиадокAPI_ВызватьФункциюAPIНаСервере("КонтурДиадокAPI_ДоверенностиПользователя", ПараметрыМетода);
	
	Возврат Результат;
	
КонецФункции

// Метод для получения информации об организации в системе Диадок.
// Поиск организации может выполняться по одному из критериев: идентификатор организации,
// идентификатор ящика, идентификатор участника ЭДО или ИНН (с возможным уточнением по КПП).
// В случае HTTP ответа отличного от "200", выбрасывает исключение.
//
// Параметры:
//   ДанныеАвторизацииДиадок  - Структура - см. метод КонтурДиадокAPI_НовыйДанныеАвторизации.
//   ИдентификаторОрганизации - Строка - Идентификатор организации в Диадок (необязательный).
//   ИдентификаторЯщика       - Строка - Идентификатор ящика организации в Диадок (необязательный).
//   ИдентификаторУчастникаЭДО - Строка - Идентификатор участника электронного документооборота (необязательный).
//   ИННОрганизации           - Строка - ИНН организации (необязательный).
//   КППОрганизации           - Строка - КПП организации, используется для уточнения при поиске по ИНН (необязательный).
//   ОтветВЛокальныхИменах    - Булево - Признак приведения имен свойств ответа к локальному формату (по умолчанию Ложь).
//
// Возвращаемое значение:
//   Структура - См. свойства в методе КонтурДиадокAPI_Схема_Organization.
//
&НаКлиенте
Функция КонтурДиадокAPI_Организации(ДанныеАвторизацииДиадок, ИдентификаторОрганизации = "", ИдентификаторЯщика = "", ИдентификаторУчастникаЭДО = "", ИННОрганизации = "", КППОрганизации = "", ОтветВЛокальныхИменах = Ложь) Экспорт
	
	ПараметрыМетода = Новый Структура("ДанныеАвторизацииДиадок,ИдентификаторОрганизации,ИдентификаторЯщика,ИдентификаторУчастникаЭДО,ИННОрганизации,КППОрганизации,ОтветВЛокальныхИменах");
	ПараметрыМетода.ДанныеАвторизацииДиадок 	= ДанныеАвторизацииДиадок;
	ПараметрыМетода.ИдентификаторОрганизации 	= ИдентификаторОрганизации;
	ПараметрыМетода.ИдентификаторЯщика 			= ИдентификаторЯщика;
	ПараметрыМетода.ИдентификаторУчастникаЭДО 	= ИдентификаторУчастникаЭДО;
	ПараметрыМетода.ИННОрганизации 				= ИННОрганизации;
	ПараметрыМетода.КППОрганизации 				= КППОрганизации;
	ПараметрыМетода.ОтветВЛокальныхИменах 		= ОтветВЛокальныхИменах;
	
	Результат = КонтурДиадокAPI_ВызватьФункциюAPIНаСервере("КонтурДиадокAPI_Организации", ПараметрыМетода);
	
	Возврат Результат;
	
КонецФункции

// Метод для получения содержимого и метаинформации сообщения из ящика Диадок.
// Позволяет получить полную информацию о сообщении, включая вложенные документы, подписи и статусы.
// В случае HTTP ответа отличного от "200", выбрасывает исключение.
//
// Параметры:
//   ДанныеАвторизацииДиадок     - Структура - см. метод КонтурДиадокAPI_НовыйДанныеАвторизации.
//   ИдентификаторЯщика          - Строка - Идентификатор ящика организации в Диадок.
//   ИдентификаторСообщения      - Строка - Идентификатор сообщения.
//   ИдентификаторСущности       - Строка - Идентификатор конкретной сущности (документа) внутри сообщения (необязательный).
//   ТипВозвращаемойПодписи      - Строка - Тип возвращаемой подписи для документов (необязательный).
//   ВозвращатьСодержимоеСущностей - Булево - Признак включения содержимого сущностей в ответ (по умолчанию Истина).
//   ОтветВЛокальныхИменах       - Булево - Признак приведения имен свойств ответа к локальному формату (по умолчанию Ложь).
//
// Возвращаемое значение:
//   Структура - См. свойства в методе КонтурДиадокAPI_Схема_Message.
//
&НаКлиенте
Функция КонтурДиадокAPI_СодержимоеСообщения(ДанныеАвторизацииДиадок, ИдентификаторЯщика, ИдентификаторСообщения, ИдентификаторСущности = "", ТипВозвращаемойПодписи = "", ВозвращатьСодержимоеСущностей = Истина, ОтветВЛокальныхИменах = Ложь) Экспорт

	ПараметрыМетода = Новый Структура("ДанныеАвторизацииДиадок,ИдентификаторЯщика,ИдентификаторСообщения,ИдентификаторСущности,ТипВозвращаемойПодписи,ВозвращатьСодержимоеСущностей,ОтветВЛокальныхИменах");
	ПараметрыМетода.ДанныеАвторизацииДиадок 		= ДанныеАвторизацииДиадок;
	ПараметрыМетода.ИдентификаторЯщика 				= ИдентификаторЯщика;
	ПараметрыМетода.ИдентификаторСообщения 			= ИдентификаторСообщения;
	ПараметрыМетода.ИдентификаторСущности 			= ИдентификаторСущности;
	ПараметрыМетода.ТипВозвращаемойПодписи 			= ТипВозвращаемойПодписи;
	ПараметрыМетода.ВозвращатьСодержимоеСущностей 	= ВозвращатьСодержимоеСущностей;
	ПараметрыМетода.ОтветВЛокальныхИменах 			= ОтветВЛокальныхИменах;
	
	Результат = КонтурДиадокAPI_ВызватьФункциюAPIНаСервере("КонтурДиадокAPI_СодержимоеСообщения", ПараметрыМетода);
	
	Возврат Результат;
	
КонецФункции

// Метод для подготовки документов к подписанию в системе Диадок.
