// Структура для хранения настроек и кэша функционально блока
// Возвращаемое значение:
//	 Структура - настройки функционального блока
&НаКлиенте
Функция КонтурСтандарт_МенеджерНастроек() Экспорт
	
	МенеджерНастроек = Кэш_Прочитать("КонтурСтандарт_МенеджерНастроек");
	
	Если МенеджерНастроек = Неопределено Тогда

		МенеджерНастроек = КонтурСтандарт_НовыйМенеджерНастроек();
		
		МенеджерНастроек.РезультатФункции_ВерсияПлатформыНеНижеУказанной = Новый Соответствие;
		МенеджерНастроек.РезультатФункции_ВерсияРежимСовместимостиНеНижеУказанной = Новый Соответствие;
 		
		Кэш_Поместить("КонтурСтандарт_МенеджерНастроек", МенеджерНастроек); 
		
	КонецЕсли;
	
	Возврат МенеджерНастроек;
	
КонецФункции

// Находит первое вхождение искомой строки как подстроки в исходной строке. Сравнение выполняется с учетом регистра.
//
// Параметры:
//   Строка - Строка - исходная строка
//	 ПодстрокаПоиска - Строка - искомая подстрока
//	 НаправлениеПоиска - Строка - см. КонтурСтандарт_НаправлениеПоискаСКонца, КонтурСтандарт_НаправлениеПоискаСНачала
//	 НачальнаяПозиция - Число - указывает позицию в строке, с которой начинается поиск.
//	 НомерВхождения - Число - указывает номер вхождения искомой подстроки в исходной строке.
//
// Возвращаемое значение:
//   Число, Неопределено - Позиция первого знака найденной подстроки. Нумерация символов в строке начинается с 1. 
//   Если строка не содержит указанной подстроки, то возвращается 0.
&НаКлиенте
Функция КонтурСтандарт_СтрНайти_(Знач Строка, Знач ПодстрокаПоиска, Направление = "СНачала", НачальнаяПозиция = 1, НомерВхождения = 1) Экспорт
	
	Если НЕ Направление = КонтурСтандарт_НаправлениеПоискаСКонца() Тогда
		
		Направление = КонтурСтандарт_НаправлениеПоискаСНачала();
		
	КонецЕсли;
	
	Если НачальнаяПозиция = Неопределено Тогда 
		
		Если Направление = КонтурСтандарт_НаправлениеПоискаСКонца() Тогда 
			
			НачальнаяПозиция = СтрДлина(Строка);
			
		Иначе                               

			НачальнаяПозиция = 1;
			
		КонецЕсли; 
		
	КонецЕсли;
	
	Если КонтурСтандарт_ДоступныБазовыеСтроковыеФункции() Тогда
				
		Возврат Вычислить("СтрНайти(Строка, ПодстрокаПоиска, НаправлениеПоиска[Направление], НачальнаяПозиция, НомерВхождения)");	
		 
	Иначе

		Если Строка = "" и ПодстрокаПоиска = "" Тогда
			// чтобы отрабатывало как в платформе
			Если Направление = КонтурСтандарт_НаправлениеПоискаСКонца() Тогда
				Если НомерВхождения = 1 Тогда
					Возврат 1;
				Иначе
					Возврат 0;
				КонецЕсли;
			Иначе
				Возврат Мин(НомерВхождения, ?(НачальнаяПозиция = Неопределено, 1, НачальнаяПозиция));
			КонецЕсли;
		КонецЕсли;
		
		Позиция = НачальнаяПозиция;
		Если Направление = КонтурСтандарт_НаправлениеПоискаСКонца() Тогда
			Строка = КонтурСтандарт_СтрРазвернуть_(Строка);
			ПодстрокаПоиска = КонтурСтандарт_СтрРазвернуть_(ПодстрокаПоиска); 
			Позиция = Макс(1, СтрДлина(Строка)-Позиция-СтрДлина(ПодстрокаПоиска)+2);
		КонецЕсли;
		
		Результат = 0;
		Вхождение = 0;
		ДлинаСтроки = СтрДлина(Строка);
		ДлинаПодстроки = СтрДлина(ПодстрокаПоиска);
		
		Пока Позиция <> ДлинаСтроки + 1 Цикл	
			Если Сред(Строка, Позиция, ДлинаПодстроки) = ПодстрокаПоиска Тогда
				Результат = Позиция;
				Вхождение = Вхождение + 1;
				Если Вхождение = НомерВхождения Тогда
					Прервать;
				КонецЕсли;
			КонецЕсли;	
			Позиция = Позиция + 1;	
		КонецЦикла;
		
		Если Направление = КонтурСтандарт_НаправлениеПоискаСКонца() И Результат <> 0 Тогда
			Сдвиг = 2;
			Результат = ДлинаСтроки - ДлинаПодстроки - Результат + Сдвиг;	
		КонецЕсли;
		
		Возврат Результат; 
		
	КонецЕсли;

КонецФункции

// Определяет направление поиска подстроки в строке.
