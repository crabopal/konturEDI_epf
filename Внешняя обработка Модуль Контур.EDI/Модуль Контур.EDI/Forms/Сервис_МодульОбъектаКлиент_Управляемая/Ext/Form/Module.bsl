	Возврат ВариантыНастройки;
	
КонецФункции

&НаКлиенте
Функция Криптография_ПутиМодуляКриптографии()
	
	ПутиМодуляКриптографии = Новый Массив;  
	
	ПутиМодуляКриптографии.Добавить("/opt/cprocsp/lib/amd64/libcapilite.so");
	ПутиМодуляКриптографии.Добавить("/opt/cprocsp/lib/amd64/libcapi10.so");
	ПутиМодуляКриптографии.Добавить("/opt/cprocsp/lib/amd64/libcapi20.so");
	ПутиМодуляКриптографии.Добавить("/opt/cprocsp/lib/libcapi10.dylib");
	ПутиМодуляКриптографии.Добавить("/opt/cprocsp/lib/libcapi20.dylib");
	ПутиМодуляКриптографии.Добавить("/opt/cprocsp/lib/libcapi10.4.dylib");
	ПутиМодуляКриптографии.Добавить("/opt/cprocsp/lib/libcapi20.4.dylib");
	ПутиМодуляКриптографии.Добавить("/opt/cprocsp/lib/ia32/libcapi10.so");
	ПутиМодуляКриптографии.Добавить("/opt/cprocsp/lib/ia32/libcapi20.so");
	
	Возврат КонтурСтандарт_СтрСоединить_(ПутиМодуляКриптографии, ":");	
	
КонецФункции

