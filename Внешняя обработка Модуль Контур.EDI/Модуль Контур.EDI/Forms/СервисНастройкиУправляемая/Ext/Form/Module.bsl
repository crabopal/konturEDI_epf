	КонецЕсли;
	
	Результат = ПроверитьОбновленияРасширенийНаСервере();
	
	Если НЕ Результат.Успешно Тогда 
		СообщитьПользователю_ФормаСервисНастройки(Результат.ОписаниеОшибки);
		Возврат;		
	КонецЕсли;
	
