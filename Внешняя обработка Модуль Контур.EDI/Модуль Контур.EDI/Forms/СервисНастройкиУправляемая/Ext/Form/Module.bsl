КонецПроцедуры  

&НаКлиенте
Процедура ОткрытьФормуВыбораСертификатаИДоверенности()
	
	// Предложим выбрать сертификат через специальную форму
	Состояние("Подготовка выбора сертификата...",0);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ОбъектПараметрыКлиентСервер", Объект.ПараметрыКлиентСервер);
	ПараметрыФормы.Вставить("Организация", Элементы.СписокСертификатов.ТекущиеДанные.Организация);
	
	Доверенность = Элементы.СписокСертификатов.ТекущиеДанные.Доверенность;
	ТребуетсяДоверенность = Элементы.СписокСертификатов.ТекущиеДанные.ТребуетсяДоверенность;
	ИгнорируемыеОшибкиДоверенности = Элементы.СписокСертификатов.ТекущиеДанные.ИгнорируемыеОшибкиДоверенности;
	
	Если ЗначениеЗаполнено(Элементы.СписокСертификатов.ТекущиеДанные.СвойстваСертификата) Тогда
	
		Отпечаток = Элементы.СписокСертификатов.ТекущиеДанные.СвойстваСертификата.Отпечаток;
		Расположение = Элементы.СписокСертификатов.ТекущиеДанные.Расположение;
		
		Если Расположение = "сервер" Тогда
			ДанныеАвторизацииСертификата = МодульОбменКлиент().ПолучитьСтруктуруДанныхАвторизации();
			ДанныеАвторизацииСертификата.Отпечаток = Отпечаток;
			ДанныеАвторизацииСертификата.Расположение = Расположение;
			РеквизитыСертификата = ПолучитьРеквизитыСертификатаНаСервере(ДанныеАвторизацииСертификата);
		Иначе	
			РеквизитыСертификата = МодульОбменКлиент().ПолучитьРеквизитыСертификатаНаКлиенте(Отпечаток);
		КонецЕсли;
		
	Иначе
		
		РеквизитыСертификата = Неопределено;
		
	КонецЕсли;
		
	ПараметрыФормы.Вставить("Доверенность", Доверенность);
	ПараметрыФормы.Вставить("ТребуетсяДоверенность", ТребуетсяДоверенность);
	ПараметрыФормы.Вставить("Сертификат", РеквизитыСертификата);
	ПараметрыФормы.Вставить("Контекст", "Форма_ОбщиеНастройки");
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Действие", 				"ВыборСертификата");
	ДопПараметры.Вставить("ФинальныйОбработчик", 	"Оповестить_КонтурEDI_ПроверкаСертификата");
	ДопПараметры.Вставить("ЗапомнитьВыбор", 		Ложь);
	ДопПараметры.Вставить("НомерПопытки", 			1);
	ДопПараметры.Вставить("Успешно", 				Ложь); 
	ДопПараметры.Вставить("Контекст", 				"Форма_ОбщиеНастройки");
	ДопПараметры.Вставить("ОписаниеОшибки", 		"");
	ДопПараметры.Вставить("ТребуетсяДоверенность", ТребуетсяДоверенность);
	ДопПараметры.Вставить("ИгнорируемыеОшибкиДоверенности", ИгнорируемыеОшибкиДоверенности);
	
	ПараметрыФормы.Вставить("ДопПараметры", ДопПараметры); 
	
	МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI("ФормаВыбора_СертификатДоверенность_Управляемая", , ПараметрыФормы, ЭтаФорма, "ПослеВыбораСертификатДоверенность", МодульОбменКлиент(), ДопПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПанельНастроекПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница.Имя = "СтраницаЭДО" И СписокСертификатов.Количество() = 0 Тогда 
		
		Состояние("Строю список сертификатов");
		ЗаполнитьСертификатыПоУмолчаниюКлиент();
		
	КонецЕсли;
		
КонецПроцедуры

