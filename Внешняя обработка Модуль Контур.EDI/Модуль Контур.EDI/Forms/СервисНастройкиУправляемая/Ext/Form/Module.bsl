Функция МассивСертификатовНаСервере(ТолькоДействующиеСертификаты)
	
	Возврат МодульОбъекта().МассивСертификатов_КонтурEDI(ТолькоДействующиеСертификаты);	
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьСертификатыПоУмолчаниюКлиент()
	
	//Сходить за текущими сертами
	ТолькоДействующиеСертификаты = Ложь;
	МассивСертификатов = ОсновнаяФорма().МодульОбменКлиент().МассивСертификатовНаКлиенте(ТолькоДействующиеСертификаты);
	
	Для Каждого СертификатНаСервере Из МассивСертификатовНаСервере(ТолькоДействующиеСертификаты) Цикл
		МассивСертификатов.Добавить(СертификатНаСервере);
	КонецЦикла;
	
	МассивОрганизаций = Новый Массив;
	Для Каждого Строка Из СписокНазначенныхСертификатов Цикл
		МассивОрганизаций.Добавить(Строка.Организация);
	КонецЦикла;
	
	ПредставлениеОрганизации = ПредставлениеОрганизации(МассивОрганизаций);
	//УчетныеЗаписиДиадок = УчетныеЗаписиДиадок(МассивОрганизаций);
	
	Для Каждого НазначенныйОтпечаток Из СписокНазначенныхСертификатов Цикл
		НоваяСтрокаСертификата = СписокСертификатов.Добавить();
		Организация = НазначенныйОтпечаток.Организация;
		НоваяСтрокаСертификата.Организация = НазначенныйОтпечаток.Организация;
		НоваяСтрокаСертификата.ПредставлениеОрганизации = ПредставлениеОрганизации[Организация];
		НоваяСтрокаСертификата.ОрганизацияКартинка = Истина;
		
		
		Для каждого СуществующийСертификат Из МассивСертификатов Цикл
			Если СуществующийСертификат.Отпечаток = НазначенныйОтпечаток.Отпечаток
			   И СуществующийСертификат.Расположение = НазначенныйОтпечаток.Расположение Тогда
				ЗаполнитьЗначенияСвойств(НоваяСтрокаСертификата, СуществующийСертификат);
				ЗаполнитьЗначенияСвойств(НоваяСтрокаСертификата, НазначенныйОтпечаток);
				НоваяСтрокаСертификата.ПредставлениеСертификата = МодульОбменКлиент().ПредставлениеСертификатаНаФорме(СуществующийСертификат);
				НоваяСтрокаСертификата.СертификатКартинка = Истина;
				
				Если ЗначениеЗаполнено(НазначенныйОтпечаток.Доверенность) Тогда
					ЗаполнитьПредставлениеДоверенности(НоваяСтрокаСертификата, НазначенныйОтпечаток.Доверенность);
				КонецЕсли;
				НоваяСтрокаСертификата.Доверенность = НазначенныйОтпечаток.Доверенность;
				
				Если ЗначениеЗаполнено(НазначенныйОтпечаток.СвойстваСертификата) Тогда
					ЗаполнитьПредставлениеСертификата(НоваяСтрокаСертификата, НазначенныйОтпечаток.СвойстваСертификата);	
					НоваяСтрокаСертификата.СвойстваСертификата = НазначенныйОтпечаток.СвойстваСертификата;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(НоваяСтрокаСертификата.Расположение) Тогда
			НоваяСтрокаСертификата.РасположениеПользовательское = ?(НоваяСтрокаСертификата.Расположение = "клиент", "локально", "на сервере");
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(НоваяСтрокаСертификата.ОкончаниеПериодаДействия) Тогда
			НоваяСтрокаСертификата.ОсталосьДней = РассчитатьОсталосьДнейДействияСертификата(НоваяСтрокаСертификата.ОкончаниеПериодаДействия);
		КонецЕсли;            
		
		Если ЗначениеЗаполнено(НоваяСтрокаСертификата.СвойстваСертификата) Тогда
			
			ДанныеАвторизации = МодульОбменКлиент().ПолучитьСтруктуруДанныхАвторизации();
			ЗаполнитьЗначенияСвойств(ДанныеАвторизации, НоваяСтрокаСертификата);
			ДанныеАвторизации.ТипАвторизации = "Сертификат";
			ДанныеАвторизации.ПарольКонтейнера = ПолучитьПарольКонтейнераСертификатаСервер(ДанныеАвторизации.Организация, ДанныеАвторизации.Отпечаток);
			
			НоваяСтрокаСертификата.ДанныеАвторизации = ДанныеАвторизации;

			СертификатКвалифицированный = МодульОбменКлиент().СертификатКвалифицированный(ДанныеАвторизации);
			
			Если СертификатКвалифицированный = Неопределено Тогда				
				НоваяСтрокаСертификата.ТребуетсяДоверенность = "Неопределено";
				Продолжить;				
			КонецЕсли;
						
			НоваяСтрокаСертификата.СтатусСертификата = НоваяСтрокаСертификата.СтатусСертификата + " " + ?(СертификатКвалифицированный, "Квалифицированный", "Неквалифицированный");
			
			Если НЕ ЗначениеЗаполнено(НоваяСтрокаСертификата.Доверенность) Тогда 
				НоваяСтрокаСертификата.ТребуетсяДоверенность = МодульОбменКлиент().ДляСертификатаНеобходимаДоверенность(ДанныеАвторизации);
			КонецЕсли;
		
		КонецЕсли;
       	
	КонецЦикла;
	
КонецПроцедуры

