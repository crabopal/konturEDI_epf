&НаКлиенте
Процедура ПроверитьСоединение(Команда)                   
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	Если НЕ (ИспользоватьСистемныеНастройкиПрокси ИЛИ ЗначениеЗаполнено(СерверПрокси) И ЗначениеЗаполнено(ПортПрокси)) Тогда 
		
		ТекстСообщения = "Не заполнены параметры прокси для проверки соединения.";
		
	Иначе 
		
		ЕстьСоединение = ПроверитьСоединениеНаСервере();
		
		Если ЕстьСоединение Тогда
			ТекстСообщения = "Проверка соединения прошла успешно.";
		Иначе
			ТекстСообщения = "Не удалось установить соединение, проверьте параметры прокси.";
		КонецЕсли;  
		
	КонецЕсли;
	
	МодульОбъектаКлиент().СообщениеПользователю_КонтурEDI(ТекстСообщения, УникальныйИдентификатор);
	
КонецПроцедуры

//настройки отправки прайслистов по расписанию 

&НаКлиенте
Процедура РасписаниеОтправкиПрайслистовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
	ПараметрыФормыНастройки = Новый Структура;
	ПараметрыФормыНастройки.Вставить("ТипСообщения", "PRICELIST");
	ПараметрыФормыНастройки.Вставить("Направление", "Исходящее");
	ПараметрыФормыНастройки.Вставить("НастройкаРасписанияАвтоотправки", Истина);
	
	МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI("ФормаНезависимогоСообщенияУправляемая", , ПараметрыФормыНастройки, ЭтаФорма, "ОбработчикПослеЗакрытияНастройкиРасписанияПрайсЛиста", ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикПослеЗакрытияНастройкиРасписанияПрайсЛиста(РезультатЗакрытия = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если РезультатЗакрытия = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") 
		И ДополнительныеПараметры.Свойство("СтрокаНастройки") Тогда
		
		СтрокаНастройки = ДополнительныеПараметры.СтрокаНастройки;
		
	Иначе
		
		СтрокаНастройки = РасписаниеОтправкиПрайслистов.Добавить();
		СтрокаНастройки.РасписаниеВключено = Истина;
		СтрокаНастройки.ОтправленУспешно = Истина;
		
	КонецЕсли;
		
	СтрокаНастройки.Расписание = РезультатЗакрытия.Расписание;
	СтрокаНастройки.РасписаниеПредставление = Строка(РезультатЗакрытия.Расписание);
	СтрокаНастройки.НаименованиеНастройки = РезультатЗакрытия.Наименование;
	СтрокаНастройки.ПараметрыПодготовкиСообщения = РезультатЗакрытия.ПараметрыПодготовкиСообщения;
	СтрокаНастройки.Партнер = РезультатЗакрытия.Партнер;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкиАвтоотправкиПрайслистов()
	
	ТаблицаНастроекАвтоотправки = МодульОбъекта().ПолучитьНастройкиАвтоотправкиПрайслистов();
	
	Для каждого НастройкаАвтоотправки Из ТаблицаНастроекАвтоотправки Цикл
		
		СтрокаНастройки = РасписаниеОтправкиПрайслистов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаНастройки, НастройкаАвтоотправки);
		
		СтрокаНастройки.РасписаниеПредставление = Строка(НастройкаАвтоотправки.Расписание);
		
		Если Не СтрокаНастройки.ДатаПоследнейОтправки = Неопределено Тогда
			
			ПредставлениеДатыОтправки = Строка(СтрокаНастройки.ДатаПоследнейОтправки);
			
			Если СтрокаНастройки.ОтправленУспешно = Ложь Тогда
				ПредставлениеДатыОтправки = ПредставлениеДатыОтправки + " (не отправлен, были ошибки)";
			КонецЕсли;
			
			СтрокаНастройки.ДатаПоследнейОтправкиПредставление = ПредставлениеДатыОтправки;
			
		КонецЕсли;		
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиАвтоотправкиПрайслистов()

	ТаблицаНастроекАвтоотправки = РасписаниеОтправкиПрайслистов.Выгрузить();
	
	МодульОбъекта().СохранитьНастройкиАвтоотправкиПрайслистов(ТаблицаНастроекАвтоотправки);
	
КонецПроцедуры

&НаКлиенте
Процедура РасписаниеОтправкиПрайслистовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ОткрытьНастройкуАвтоотправкиПрайслиста();
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьНастройкуАвтоотправкиПрайслиста(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	ОткрытьНастройкуАвтоотправкиПрайслиста();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройкуАвтоотправкиПрайслиста()
	
	ДанныеСтроки = Элементы.РасписаниеОтправкиПрайслистов.ТекущиеДанные;
	
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормыНастройки = Новый Структура;
	ПараметрыФормыНастройки.Вставить("ТипСообщения", "PRICELIST");
	ПараметрыФормыНастройки.Вставить("Направление", "Исходящее");
	ПараметрыФормыНастройки.Вставить("НастройкаРасписанияАвтоотправки", Истина);
	ПараметрыФормыНастройки.Вставить("АвтоотправкаПараметрыПодготовкиСообщения", ДанныеСтроки.ПараметрыПодготовкиСообщения);
	ПараметрыФормыНастройки.Вставить("АвтоотправкаРасписание", ДанныеСтроки.Расписание);
	ПараметрыФормыНастройки.Вставить("АвтоотправкаНаименованиеНастройки", ДанныеСтроки.НаименованиеНастройки);
	
	ПараметрыОбработчика = Новый Структура("СтрокаНастройки", ДанныеСтроки);
	
	МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI("ФормаНезависимогоСообщенияУправляемая", , ПараметрыФормыНастройки, ЭтаФорма, "ОбработчикПослеЗакрытияНастройкиРасписанияПрайсЛиста", ЭтаФорма, ПараметрыОбработчика);
	
КонецПроцедуры

&НаКлиенте
Процедура РасписаниеОтправкиПрайслистовПриАктивизацииСтроки(Элемент)
	
	Если Не Элемент.ТекущиеДанные = Неопределено Тогда
		Элементы.РасписаниеОтправкиПрайслистовИзменить.Доступность = Истина;
		Элементы.РасписаниеОтправкиПрайслистовПоказатьОшибкиОтправки.Доступность = Не Элемент.ТекущиеДанные.ОтправленУспешно;
	Иначе
		Элементы.РасписаниеОтправкиПрайслистовИзменить.Доступность = Ложь;
		Элементы.РасписаниеОтправкиПрайслистовПоказатьОшибкиОтправки.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОшибкиАвтоотправкиПрайслиста(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	ДанныеСтроки = Элементы.РасписаниеОтправкиПрайслистов.ТекущиеДанные;
	
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СписокОшибок = ПолучитьМассивОшибокАвтоотправки(ДанныеСтроки.СписокОшибок);
	
	Если СписокОшибок.Количество() > 0 Тогда
		
		ТекстПредупреждения = "Для детального анализа ошибок выполните тестовое заполнение в настройках отправки ценового листа." + Символы.ПС + Символы.ПС + "Ошибки:";
		
		Для каждого ТекстОшибки Из СписокОшибок Цикл
			ТекстПредупреждения = ТекстПредупреждения + Символы.ПС + " - " + ТекстОшибки;
		КонецЦикла;
		
	Иначе
		ТекстПредупреждения = "Сообщение не было отправлено. Ошибки не зарегистрированы, для анализа причин попробуйте отправить прайс-лист вручную.";
	КонецЕсли;
	
	МодульОбъектаКлиент().Предупреждение_КонтурEDI(ТекстПредупреждения);	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьМассивОшибокАвтоотправки(СписокОшибокХранилище)
	
	СписокОшибок = Новый Массив;
    
	Если ТипЗнч(СписокОшибокХранилище) = Тип("ХранилищеЗначения") Тогда
		СписокОшибок = СписокОшибокХранилище.Получить();
	КонецЕсли;
	
	Возврат СписокОшибок;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Настройка определения типов продукции

&НаКлиенте
Процедура СтраницыПрочихНастроекПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если Не ТипыПродукцииНастройкиИнициализированы И ТекущаяСтраница.Имя = "ГруппаПравилаОпределенияТиповПродукции" Тогда 
		ЗаполнитьНастройкиОпределенияТиповПродукции();
		УстановитьВидимостьПолейНастройкиТиповПродукции();
		ТипыПродукцииНастройкиИнициализированы = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкиОпределенияТиповПродукции() 
	
	ЗаполнитьСписокВыбораТиповПродукции();
	ИнициализироватьКомпоновщикНастроекОпределенияТиповПродукции();
	ТипыПродукцииДоступенРежимПоДанным1С = МодульОбъекта().ДоступноОпределениеТипаПродукцииПоДанным1С();
	ВосстановитьСохраненныеНастройкиОпределенияТиповПродукции();
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьСписокВыбораТиповПродукции()

	КолонкаТипПродукции = Элементы.ТипыПродукцииУсловияОпределенияТипПродукции;
	КолонкаТипПродукции.СписокВыбора.Очистить();
	
	ЗначенияПеречисления = МодульОбъекта().ПолучитьСписокЗначенийПеречисленияEDI("ТипыПродукции");
	Для каждого ТипПродукции Из ЗначенияПеречисления Цикл
		КолонкаТипПродукции.СписокВыбора.Добавить(ТипПродукции.Значение, ТипПродукции.Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьКомпоновщикНастроекОпределенияТиповПродукции()
	
	СхемаКомпоновки = МодульОбъекта().СхемаКомпоновкиЗапросСправочникНоменклатуры();
	ТипыПродукцииКомпоновщикНастроек = МодульОбъекта().КонтурСКД_НовыйКомпоновщикНастроек(СхемаКомпоновки,
																						  Неопределено,
																						  УникальныйИдентификатор);
																						  
КонецПроцедуры
																					  
&НаСервере
Процедура ВосстановитьСохраненныеНастройкиОпределенияТиповПродукции()
	
	СохраненныеНастройки = МодульОбъекта().НастройкиОпределенияТиповПродукции();
	
	ТипыПродукцииРежимОпределения = СохраненныеНастройки.Режим;
		
	Для каждого УсловиеОпределения Из СохраненныеНастройки.УсловияОпределения Цикл
		СтрокаУсловий = ТипыПродукцииУсловияОпределения.Добавить();
		СтрокаУсловий.ТипПродукции = УсловиеОпределения.ТипПродукции;
		СтрокаУсловий.Отбор = УсловиеОпределения.Отбор;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиОпределенияТиповПродукции()
	
	Если Не ТипыПродукцииНастройкиИнициализированы Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиОпределенияТиповПродукции = ТекущиеНастройкиОпределенияТиповПродукции();
	МодульОбъекта().СохранитьНастройкиОпределенияТиповПродукции(НастройкиОпределенияТиповПродукции);
	
КонецПроцедуры

&НаСервере
Функция ТекущиеНастройкиОпределенияТиповПродукции()
	
	НастройкиОпределенияТиповПродукции = МодульОбъекта().НовыйНастройкиОпределенияТиповПродукции();
	НастройкиОпределенияТиповПродукции.Режим = ТипыПродукцииРежимОпределения;
	
	Для каждого СтрокаУсловий Из ТипыПродукцииУсловияОпределения Цикл
		УсловиеОпределения = МодульОбъекта().НовыйУсловиеОпределенияТипаПродукции(СтрокаУсловий.ТипПродукции, СтрокаУсловий.Отбор);
		НастройкиОпределенияТиповПродукции.УсловияОпределения.Добавить(УсловиеОпределения);
	КонецЦикла;
	
	Возврат НастройкиОпределенияТиповПродукции;
	
КонецФункции

&НаКлиенте
Процедура УстановитьВидимостьПолейНастройкиТиповПродукции()
	
	ДоступнаНастройкаУсловий = ТипыПродукцииРежимОпределения = "ПроизвольныеУсловия";
	ДоступнаПроверкаУсловий = ТипыПродукцииРежимОпределения <> "Отключено";
	
	Элементы.ГруппаУсловияОпределенияТиповПродукции.Доступность = ДоступнаНастройкаУсловий;
	Элементы.ТипыПродукцииПроверитьУсловия.Доступность = ДоступнаПроверкаУсловий;
	Элементы.ТипыПродукцииРежимПоДанным1С.Видимость = ТипыПродукцииДоступенРежимПоДанным1С;
		
КонецПроцедуры

&НаКлиенте
Процедура ТипыПродукцииПроверитьУсловия(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	ОтчетПоТипамПродукции = СформироватьОтчетПоТипамПродукции();
	ОтчетПоТипамПродукции.Показать("Типы продукции номенклатуры");	
	
КонецПроцедуры

&НаСервере
Функция СформироватьОтчетПоТипамПродукции()
	
	НастройкиОпределенияТиповПродукции = ТекущиеНастройкиОпределенияТиповПродукции();
	ОтчетПоТипамПродукции = МодульОбъекта().ОтчетПоУстановленнымУсловиямОпределенияТипаПродукции(НастройкиОпределенияТиповПродукции);
	
	Возврат ОтчетПоТипамПродукции;
	
КонецФункции

&НаКлиенте
Процедура ТипыПродукцииРежимПриИзменении(Элемент)
	
	УстановитьВидимостьПолейНастройкиТиповПродукции();	
	
КонецПроцедуры

&НаКлиенте
Процедура ТипыПродукцииУсловияОпределенияУсловиеОпределенияНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущаяСтрока = Элементы.ТипыПродукцииУсловияОпределения.ТекущиеДанные;
	ОтборСДоступнымиПолямиОтбора = ТипыПродукцииКомпоновщикНастроек.Настройки.Отбор;
	ОтборСДоступнымиПолямиОтбора.Элементы.Очистить();

	МодульОбъектаКлиент().КонтурСКД_СкопироватьОтборКомпоновкиДанныхРекурсивно(ОтборСДоступнымиПолямиОтбора, ТекущаяСтрока.Отбор);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КомпоновщикНастроек", ТипыПродукцииКомпоновщикНастроек);
	
	ПараметрыОбработчика = Новый Структура;
	ПараметрыОбработчика.Вставить("ТекущаяСтрока", ТекущаяСтрока); 
	
	МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI("Сервис_РедакторОтбораКомпоновкиДанныхУправляемая",
												 Неопределено,
												 ПараметрыФормы,
												 ЭтаФорма,
												 "ПослеРедактированияОтбораТипаПродукции",
												 ЭтаФорма,
												 ПараметрыОбработчика);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеРедактированияОтбораТипаПродукции(Отбор, ДополнительныеПараметры) Экспорт
	
	Если Отбор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОтборБезПривязкиККомпоновщику = МодульОбъектаКлиент().КонтурСКД_НовыйОтборКомпоновкиДанных();    
	МодульОбъектаКлиент().КонтурСКД_СкопироватьОтборКомпоновкиДанныхРекурсивно(ОтборБезПривязкиККомпоновщику, Отбор);
	ДополнительныеПараметры.ТекущаяСтрока.Отбор = ОтборБезПривязкиККомпоновщику;	
	
КонецПроцедуры
