&НаКлиенте
Процедура ОчиститьСертификатПоУмолчанию()
	
	ТекСтрока = Элементы.СписокСертификатов.ТекущиеДанные;
	ТекСтрока.НаименованиеОрганизацииСубъекта	= "";
	ТекСтрока.НаименованиеСубъекта				= "";
	ТекСтрока.НаименованиеУдостоверяющегоЦентра	= "";
	ТекСтрока.Отпечаток							= "";
	ТекСтрока.НачалоПериодаДействия				= Дата(1,1,1);
	ТекСтрока.ОкончаниеПериодаДействия			= Дата(1,1,1);
	ТекСтрока.Расположение						= "";
	ТекСтрока.РасположениеПользовательское		= "";
	ТекСтрока.ОсталосьДней						= 0;
	
	ТекСтрока.Доверенность = Неопределено;
	ТекСтрока.ДоверенностьКартинка = Ложь;
	ТекСтрока.ДоверенностьКартинкаФайл = Ложь;
	ТекСтрока.ДоверенностьПредставление = "";
	ТекСтрока.КритичныйСтатусДоверенности = Ложь;
	ТекСтрока.КритичныйСтатусСертификата = Ложь;
	ТекСтрока.КритичныйСтатусУчетнойЗаписи = Ложь;
	ТекСтрока.ПредставлениеСертификата = "";
	ТекСтрока.СвойстваСертификата = Неопределено;
	ТекСтрока.СертификатКартинка = Ложь;
	ТекСтрока.СтатусДоверенности = "";
	ТекСтрока.СтатусСертификата = "";
	ТекСтрока.СтатусУчетнойЗаписи = "";
	ТекСтрока.УчетнаяЗаписьКартинка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокСертификатовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьФормуВыбораСертификатаИДоверенности();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "КонтурEDI_ПроверкаСертификата" Тогда
		
		Если Параметр.Успешно = Истина Тогда 
			ОчиститьСертификатПоУмолчанию();
			ТекущиеДанные = Элементы.СписокСертификатов.ТекущиеДанные;
			ЗаполнитьЗначенияСвойств(ТекущиеДанные, Параметр.РеквизитыСертификата);
			
			ТекущиеДанные.РасположениеПользовательское = ?(Параметр.Расположение = "клиент", "локально", "на сервере");
			
			Доверенность = Неопределено;
			Если Параметр.Свойство("Доверенность", Доверенность) Тогда
				Если ЗначениеЗаполнено(Доверенность) Тогда
					ЗаполнитьПредставлениеДоверенности(ТекущиеДанные, Доверенность);				
					ТекущиеДанные.Доверенность = Доверенность;
				КонецЕсли;
			КонецЕсли;
			ЗаполнитьПредставлениеСертификата(ТекущиеДанные, Параметр.РеквизитыСертификата.СвойстваСертификата);
			ТекущиеДанные.ТребуетсяДоверенность = Параметр.ТребуетсяДоверенность;
			ТекущиеДанные.ИгнорируемыеОшибкиДоверенности = Параметр.ИгнорируемыеОшибкиДоверенности; 
			
			ТекущиеДанные.СвойстваСертификата = Параметр.РеквизитыСертификата.СвойстваСертификата;
			ТекущиеДанные.ОсталосьДней = РассчитатьОсталосьДнейДействияСертификата(ТекущиеДанные.ОкончаниеПериодаДействия);
			
			Если ЗначениеЗаполнено(ТекущиеДанные.СвойстваСертификата) Тогда 
				
				ТекущиеДанные.ДанныеАвторизации = МодульОбменКлиент().ПолучитьСтруктуруДанныхАвторизации();
				ЗаполнитьЗначенияСвойств(ТекущиеДанные.ДанныеАвторизации, ТекущиеДанные);
				ТекущиеДанные.ДанныеАвторизации.ТипАвторизации = "Сертификат";
				
				СертификатКвалифицированный = МодульОбменКлиент().СертификатКвалифицированный(ТекущиеДанные.ДанныеАвторизации);
							
				Если СертификатКвалифицированный <> Неопределено Тогда
					ТекущиеДанные.СтатусСертификата = ТекущиеДанные.СтатусСертификата + " " + ?(СертификатКвалифицированный, "Квалифицированный", "Неквалифицированный");
				КонецЕсли;

				Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Доверенность) Тогда 
					ТекущиеДанные.ТребуетсяДоверенность = МодульОбменКлиент().ДляСертификатаНеобходимаДоверенность(ТекущиеДанные.ДанныеАвторизации);
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			Сообщить(Параметр.ОписаниеОшибки);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПредставлениеДоверенности(ТекущиеДанные, Новый_Доверенность) 
	
	ТекущиеДанные.ДоверенностьПредставление = МодульОбъектаКлиент().Представление_МашиночитаемаяДоверенность_ФормаСписка(Новый_Доверенность);

	Если Новый_Доверенность.СрокДействия > ТекущаяДата() Тогда
		ТекущиеДанные.СтатусДоверенности = "Действует до " + Формат(Новый_Доверенность.СрокДействия, "ДЛФ=ДД");
	Иначе
		ТекущиеДанные.СтатусДоверенности = "Срок действия истёк";
	КонецЕсли;

	ТекущиеДанные.КритичныйСтатусДоверенности = Ложь;
	ТекущиеДанные.ДоверенностьКартинка = Истина;
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПредставлениеСертификата(ТекущиеДанные, СвойстваСертификата)
	
	ТекущиеДанные.ПредставлениеСертификата = ПредставлениеСертификата(СвойстваСертификата);
	
	СтатусСертификата = "";
	Если ЗначениеЗаполнено(СвойстваСертификата.ДатаОкончания) Тогда
		Если СвойстваСертификата.ДатаОкончания > ТекущаяДата() Тогда
			СтатусСертификата = "Действует до " + Формат(СвойстваСертификата.ДатаОкончания, "ДЛФ=ДД");
		Иначе
			СтатусСертификата = "Срок действия истёк";
		КонецЕсли;
		
		ТекущиеДанные.ОкончаниеПериодаДействия = СвойстваСертификата.ДатаОкончания;
	КонецЕсли;
	
	ТекущиеДанные.СтатусСертификата = СтатусСертификата;
	ТекущиеДанные.КритичныйСтатусСертификата = ЗначениеЗаполнено(СвойстваСертификата.ДатаОкончания) И РассчитатьОсталосьДнейДействияСертификата(СвойстваСертификата.ДатаОкончания) <= 30;
	ТекущиеДанные.СертификатКартинка = Истина;
	
КонецПроцедуры

&НаКлиенте
Функция ПредставлениеСертификата(СвойстваСертификата)
	
	ФИО = СокрЛП(Строка(СвойстваСертификата.Субъект.Фамилия) + " " + Строка(СвойстваСертификата.Субъект.Имя) + " " + Строка(СвойстваСертификата.Субъект.Отчество));
	ИНН = СокрЛП(?(ЗначениеЗаполнено(СвойстваСертификата.Субъект.ИННЮЛ), СвойстваСертификата.Субъект.ИННЮЛ, СвойстваСертификата.Субъект.ИНН));
	НаименованиеОрганизацииСубъекта = ?(ЗначениеЗаполнено(СвойстваСертификата.Субъект.Организация), СвойстваСертификата.Субъект.Организация, ФИО); 	
	
	Представление = ?(ЗначениеЗаполнено(НаименованиеОрганизацииСубъекта), НаименованиеОрганизацииСубъекта, "<Неизвестно>") + Символы.ПС;
	
	ДанныеДляЗаполнения = Новый Массив;
	Если ЗначениеЗаполнено(ИНН) Тогда
		ДанныеДляЗаполнения.Добавить("ИНН: " + ИНН);
	Иначе
		ДанныеДляЗаполнения.Добавить("ИНН: <Неизвестно>");			
	КонецЕсли;
	Если ЗначениеЗаполнено(ФИО) Тогда
		ДанныеДляЗаполнения.Добавить(ФИО);
	КонецЕсли;
	
	Для Каждого Строка Из ДанныеДляЗаполнения Цикл
		Представление = Представление + Строка + Символы.ПС;			
	КонецЦикла;
	
	Возврат Представление;
	
КонецФункции

&НаКлиенте
Процедура ПриЗакрытии()
	
	ОсновнаяФорма = ОсновнаяФорма();
	
	Если ОсновнаяФорма <> Неопределено Тогда
		
		ОсновнаяФорма.ПриЗакрытииФормы(ЭтаФорма, "СервисНастройкиУправляемая");
		
	КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьРасширенияИзФайла(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
			
	МодульОбъектаКлиент().ВыбратьФайл_КонтурEDI("УстановитьРасширенияИзФайла",
												ЭтаФорма,
												РежимДиалогаВыбораФайла.Открытие,
												
												"Выберите файл для сохранения расширений",
												"КонтурEDI_Расширения.zip");
		
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьРасширенияИзФайла(РезультатВыбораФайла, ДопПараметры = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(РезультатВыбораФайла) Тогда
		Возврат;	
	КонецЕсли;
	Если ТипЗнч(РезультатВыбораФайла) = Тип("Массив") Тогда
		ФайлДляЗагрузки = РезультатВыбораФайла[0];
	Иначе
		ФайлДляЗагрузки = РезультатВыбораФайла;
	КонецЕсли;
	
	//Может быть выбран как xml конкретного расширения, так и архив с несколькими расширениями	
	Если СтрЧислоВхождений(ФайлДляЗагрузки, ".xml") Тогда
		
		Если СтрЧислоВхождений(ФайлДляЗагрузки, "\content.xml") Тогда
			УстановитьРасширениеИзФайла(ФайлДляЗагрузки, Ложь);
		Иначе
			МодульОбъектаКлиент().СообщениеПользователю_КонтурEDI(
			"Ошибка выбора файла:" + Символы.ПС + "Имя файла расширения не ""content.xml""."
			, ЭтаФорма.УникальныйИдентификатор);
		КонецЕсли;
		
	ИначеЕсли СтрЧислоВхождений(ФайлДляЗагрузки, ".zip") Тогда
		
		КаталогВыгрузкиРасширений = КаталогВременныхФайлов() + "ВыгрузкаРасширений";	
		Файл = Новый Файл(КаталогВыгрузкиРасширений);
		Если Файл.Существует() Тогда
			УдалитьФайлы(КаталогВыгрузкиРасширений);	
		КонецЕсли;	
		СоздатьКаталог(КаталогВыгрузкиРасширений);
	
		ЧтениеZipФайла = Новый ЧтениеZipФайла(ФайлДляЗагрузки);
		ЧтениеZipФайла.ИзвлечьВсе(КаталогВыгрузкиРасширений + "\", РежимВосстановленияПутейФайловZIP.Восстанавливать);
		
		ПоискРасширения = НайтиФайлы(КаталогВыгрузкиРасширений, "content.xml", Истина);
		Если ПоискРасширения.Количество() = 0 Тогда
			
			МодульОбъектаКлиент().СообщениеПользователю_КонтурEDI(
			"Ошибка выбора файла:" + Символы.ПС + "В архиве не найдены файлы расширения ""content.xml""."
			, ЭтаФорма.УникальныйИдентификатор);
			
			Возврат;
			
		Иначе
			
			Для Каждого НайденныйФайлРасширения Из ПоискРасширения Цикл
				УстановитьРасширениеИзФайла(НайденныйФайлРасширения.ПолноеИмя);	
			КонецЦикла;
			
		КонецЕсли;
		
		УдалитьФайлы(КаталогВыгрузкиРасширений);
		
	Иначе
		
		МодульОбъектаКлиент().СообщениеПользователю_КонтурEDI(
		"Ошибка выбора файла:" + Символы.ПС + "Файл должен иметь расширение "".zip"" или имя ""content.xml""."
		, ЭтаФорма.УникальныйИдентификатор);
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьРасширениеИзФайла(ФайлРасширения, ЗагружатьДопФайлы = Истина) Экспорт
	
	ДДРасширения = Новый ДвоичныеДанные(ФайлРасширения);
	
	МассивДанныхДопФайлов = Новый Массив;
	Если ЗагружатьДопФайлы Тогда
		КаталогПоиска = МодульОбъектаКлиент().ВернутьКаталогВыбранногоФайл_КонтурEDI(ФайлРасширения);
		ДопФайлы = НайтиФайлы(КаталогПоиска, "*.*");
		Для Каждого ДопФайл Из ДопФайлы Цикл
			Если ДопФайл.Расширение = "" ИЛИ ДопФайл.ПолноеИмя = ФайлРасширения Или ДопФайл.Имя = "Для типовых.txt" Тогда
				Продолжить;	
			КонецЕсли;
			ДД = Новый ДвоичныеДанные(ДопФайл.ПолноеИмя);
			МассивДанныхДопФайлов.Добавить(Новый Структура("ИмяФайла, ДвоичныеДанные", ДопФайл.Имя, ДД));  
		КонецЦикла;
	КонецЕсли;
	
	ПараметрыВыполненияЗагрузки         = Новый Структура;
	ПараметрыВыполненияЗагрузки.Вставить("ДанныеРаширения", ДДРасширения);
	ПараметрыВыполненияЗагрузки.Вставить("ДанныеДопФайлов", МассивДанныхДопФайлов);
	
	РезультатУстановки = МодульОбъектаКлиент().ВыполнитьМетодМодуляОбъекта("Функция", "ЗагрузитьРасширение", Новый Структура("ПараметрыВыполненияЗагрузки",ПараметрыВыполненияЗагрузки));
	
	Если Не РезультатУстановки.Успешно Тогда            
        Сообщить(РезультатУстановки.ОписаниеОшибки);            
    Иначе
		ЗаполнитьИнформациюОРасширениях();
		ПодключитьОбработчикОжидания("ПозиционироватьНаПоследнююСтрокуСпискаРасширения", 0.1 , Истина);
        Сообщить("Расширение успешно загружено в модуль - " + Строка(РезультатУстановки.РасширениеСсылка));
    КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокРасширенияПриАктивизацииСтроки(Элемент)
	
	Если Элементы.ПанельНастроек.ТекущаяСтраница = Неопределено Тогда 
	 	Возврат;
	КонецЕсли;
	Если Элементы.ПанельНастроек.ТекущаяСтраница.Имя = "СтраницаРасширения" Тогда 
		УстановитьДоступностьРасширения();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокРасширенияПриАктивизацииЯчейки(Элемент)
	
	ТекущаяСтрока = Элементы.СписокРасширения.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элемент.ТекущийЭлемент.Имя = "СписокРасширенияКартинка"
		И ТекущаяСтрока.Обновить Тогда
		
		 Идентификатор = ТекущаяСтрока.Идентификатор;
		 
		 РезультатОбновления = ОбновитьРасширениеСервер(ТекущаяСтрока.Ссылка);
		 Если Не РезультатОбновления.Успешно Тогда
			 СообщитьПользователю_ФормаСервисНастройки(РезультатОбновления.ОписаниеОшибки);
		 Иначе
			 ЗаполнитьИнформациюОРасширениях();
		 КонецЕсли;		
		 
		 ПозиционироватьНаСтрокуРасширения(Идентификатор);		 
		
	КонецЕсли;
	    	
КонецПроцедуры

&НаКлиенте
Процедура ВключитьВыключитьРасширение()
	
	Состояние("Переключаю...");
	 		
	//активируем/деактивируем расширения
	ТекСтрока = Элементы.СписокРасширения.ТекущиеДанные;
	
	ТекСтрока.Использование = Не ТекСтрока.Использование;
	ТекСтрока.Иконка = ?(ТекСтрока.Иконка=1,0,1);
	
	РезультатВключения = ВключитьРасширениеСервер(ТекСтрока.Ссылка, ТекСтрока.Использование);
	
	ТекСтрока = Элементы.СписокРасширения.ТекущиеДанные;
	Если Не РезультатВключения.Успешно Тогда
		ТекСтрока.Использование = Не ТекСтрока.Использование;
		ТекСтрока.Иконка = ?(ТекСтрока.Иконка=1,0,1);
		Сообщить("Не удалось " + ?(ТекСтрока.Использование, "выключить", "включить") + " расширение: """ + РезультатВключения.ОписаниеОшибки + """.");
	КонецЕсли;
	ТекСтрока.НеОткрыватьИнтерфейс = Истина; //не открываем интерфейс, когда позиционируемся на колонке наименование и срабатывает выбор строки
	Состояние(?(ТекСтрока.Использование=Истина,"Включено!","Выключено!"));
	
	// перенесем фокус на колонку Наименование
	Элементы.СписокРасширения.ТекущийЭлемент = Элементы.СписокРасширенияНаименование;

КонецПроцедуры

&НаСервере
Функция ОбновитьРасширениеСервер(Ссылка)
	
	Результат = МодульОбъекта().ОбновитьРасширение(Ссылка);
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПереименоватьРасширение(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	ТекущаяСтрока = Элементы.СписокРасширения.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Идентификатор = ТекущаяСтрока.Идентификатор;
	
	ТекНаименование = ТекущаяСтрока.Наименование;
	Подсказка = "Введите новое имя расширения";
	Длина = 50;
	Многострочность = Ложь;
	
	ДопПараметрДляПередачиВОбработчик = Новый Структура("Ссылка,Идентификатор" , ТекущаяСтрока.Ссылка, Идентификатор);
	
	Если Объект.ПараметрыКлиентСервер.МодальностьЗапрещена Тогда 
		Выполнить("ПоказатьВводСтроки(Новый ОписаниеОповещения(""Обработчик_ПереименоватьРасширение"", ЭтаФорма, ДопПараметрДляПередачиВОбработчик), ТекНаименование, Подсказка, Длина , Многострочность)"); 
	Иначе
		Если ВвестиСтроку(ТекНаименование, Подсказка) Тогда
			Обработчик_ПереименоватьРасширение(ТекНаименование, ДопПараметрДляПередачиВОбработчик);	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ПереименоватьРасширение(Наименование, ДопПараметрОбработчика = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Наименование) Тогда 
		Возврат;
	КонецЕсли;
	
	Если ДопПараметрОбработчика.Свойство("Ссылка") И
		ЗначениеЗаполнено(ДопПараметрОбработчика.Ссылка) Тогда 
		
		Результат = ПереименоватьРасширениеСервер(ДопПараметрОбработчика.Ссылка, Наименование);
		
		Если НЕ Результат.Успешно Тогда 
			
			СообщитьПользователю_ФормаСервисНастройки(Результат.ОписаниеОшибки);
			Возврат;
			
		КонецЕсли;
		
	ЗаполнитьИнформациюОРасширениях();
	
	ПозиционироватьНаСтрокуРасширения(ДопПараметрОбработчика.Идентификатор)
	КонецЕсли;	
	
КонецПроцедуры 

&НаКлиенте
Процедура ПозиционироватьНаПоследнююСтрокуСпискаРасширения() Экспорт
	
	КоличествоРасширений = СписокРасширения.Количество();
	
	Если НЕ КоличествоРасширений = 0 Тогда 
		ИндексПоследнейСтроки = КоличествоРасширений - 1 ;
		ПоследняяСтрока = СписокРасширения.Получить(ИндексПоследнейСтроки);
		
		Элементы.СписокРасширения.ТекущаяСтрока = ПоследняяСтрока.ПолучитьИдентификатор();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПозиционироватьНаСтрокуРасширения(Идентификатор)
	
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда 
		Возврат;
