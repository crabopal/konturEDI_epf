&НаКлиенте
Процедура ДеревоНастроекДокументовСообщенийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Элементы.ДеревоНастроекДокументовСообщений.ТекущийЭлемент.Имя = "ДеревоНастроекДокументовСообщенийЗначение" 
		И Элементы.ДеревоНастроекДокументовСообщений.ТекущиеДанные.ЭтоГруппа Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоНастроекДокументовСообщенийПередНачаломИзменения(Элемент, Отказ)
	
	Если Элементы.ДеревоНастроекДокументовСообщений.ТекущийЭлемент.Имя = "ДеревоНастроекДокументовСообщенийЗначение" 
		И Элементы.ДеревоНастроекДокументовСообщений.ТекущиеДанные.ЭтоГруппа Тогда
		Отказ = Истина;
	КонецЕсли;	
	
	Если Элементы.ДеревоНастроекДокументовСообщений.ТекущийЭлемент.Имя = "ДеревоНастроекДокументовСообщенийЗначение"  
		И ТипЗнч(Элементы.ДеревоНастроекДокументовСообщений.ТекущиеДанные.Значение) = Тип("Булево") Тогда
		Элемент.ТекущиеДанные.Значение = Не Элемент.ТекущиеДанные.Значение;
		Отказ = Истина;
	КонецЕсли;  
	
	Если Элементы.ДеревоНастроекДокументовСообщений.ТекущийЭлемент.Имя = "ДеревоНастроекДокументовСообщенийЗначение"
		И Элементы.ДеревоНастроекДокументовСообщений.ТекущиеДанные.НастройкаИД = "НеСоздаватьЗаказыБезСвоихТД" Тогда
		
		ИдентификаторСтроки = НайтиИдентификаторЭлементаДереваПоКолонкеПоиска(ДеревоНастроек, "НастройкаИД", Элементы.ДеревоНастроекДокументовСообщений.ТекущиеДанные.НастройкаИД);
		Если ИдентификаторСтроки >= 0 Тогда
			НайденныйЭлемент = ДеревоНастроек.НайтиПоИдентификатору(ИдентификаторСтроки);
			НайденныйЭлемент.Значение = Элемент.ТекущиеДанные.Значение; 
		КонецЕсли;
		Отказ = Истина; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция НайтиИдентификаторЭлементаДереваПоКолонкеПоиска(ДеревоЗначений, КолонкаПоиска, ЗначениеПоиска)
	
	ЭлементыДерева = ДеревоЗначений.ПолучитьЭлементы();
	Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
		Если ЭлементДерева[КолонкаПоиска] = ЗначениеПоиска Тогда
			Возврат ЭлементДерева.ПолучитьИдентификатор();	
		Иначе
			НайденныйИдентификаторСтроки = НайтиИдентификаторЭлементаДереваПоКолонкеПоиска(ЭлементДерева, КолонкаПоиска, ЗначениеПоиска); 
			Если НайденныйИдентификаторСтроки >= 0 Тогда
				Возврат НайденныйИдентификаторСтроки; 	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат -1;	
	
КонецФункции

&НаКлиенте
Процедура ИмяШаблонаПоставщикОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
