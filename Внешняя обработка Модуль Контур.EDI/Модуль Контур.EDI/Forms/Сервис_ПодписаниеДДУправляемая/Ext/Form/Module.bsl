КонецФункции 

&НаКлиенте
Процедура СброситьПроверкиДанныхАвторизации() Экспорт
	
	Для каждого Строка Из ТаблицаАвторизации Цикл
		
		Строка.ЛогинПарольДДПроверен 			= Ложь;
		Строка.СертификатПроверен 				= Ложь;
		Строка.ВалидацияЛогинаПароляДДПройдена 	= Ложь;
		Строка.ВалидацияСертификатаПройдена 	= Ложь;
		Строка.ВалидацияДоверенностиПройдена 	= Ложь;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьПарольКонтейнераДанныхАвторизации() Экспорт
	
	ОбновитьДанныеАвторизации("ПарольКонтейнера", "");
	
	Для каждого Строка Из ТаблицаАвторизации Цикл
		Строка.ПарольКонтейнера	= "";
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьСчетаФактуры()
	
	мРабочийКаталог = КаталогВременныхФайлов();
	Прогресс = 0;
	Всего = СчетаФактурыНаПодписание.Количество();
	
	МассивПодписанныхСчетФактур = Новый Массив;
	
	Для Каждого СтрокаСчетФактура Из СчетаФактурыНаПодписание Цикл
		
		Прогресс = Прогресс + 1;
		ТекПроцент = Цел((Прогресс * 100 / Всего)); 
		Состояние("Подписание в Диадок: " + Прогресс + " из " + Всего, ТекПроцент);
		
		Отказ = Ложь;
		НазначенныеДанныеАвторизации = Новый_НазначенныеДанныеАвторизации(СтрокаСчетФактура, Отказ);
		
		Если Отказ = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		MessageId = СтрокаСчетФактура.MessageId;
		BoxId 	  = СтрокаСчетФактура.BoxId;
		
		СчетФактураСсылка = СтрокаСчетФактура.Ссылка;
		
		operationID = ПолучитьИлиСоздать_Diadoc_operationID(СчетФактураСсылка);		
		
		Попытка
			Message = ПолучитьMessage(BoxId, MessageId, НазначенныеДанныеАвторизации);
		Исключение
			ОписаниеОшибки = ОписаниеОшибки();
			ЗафиксироватьОшибку_НеУдалосьПолучитьДокументыДляПодписанияСчетФактуры(СтрокаСчетФактура, ОписаниеОшибки);
			Продолжить;
		КонецПопытки;
		
		ЭтоЧерновик 			  = Message.IsDraft; 
		СтрокаСчетФактура.IsDraft = ЭтоЧерновик;
		
		Попытка
			PrepareDocumentsToSignResponse = ПолучитьPatchedEntities(Message, BoxId, MessageId, НазначенныеДанныеАвторизации, ЭтоЧерновик);
		Исключение                                                                         
			ОписаниеОшибки = ОписаниеОшибки();
			ЗафиксироватьОшибку_НеУдалосьЗаполнитьПодписанта(СтрокаСчетФактура, ОписаниеОшибки);
			Продолжить;
		КонецПопытки;
		
		Если НЕ ЭтоЧерновик Тогда
			
			MessagePatchToPost = МодульОбъектаКлиент().КонтурДиадокAPI_СоздатьПоСхеме("MessagePatchToPostV2");
			
			MessagePatchToPost.BoxId 	 = BoxId;
			MessagePatchToPost.MessageId = MessageId;
			
			PowerOfAttorneyToPost = PowerOfAttorneyToPost(НазначенныеДанныеАвторизации);	
			
			Для Каждого DocumentPatchedContent Из PrepareDocumentsToSignResponse.DocumentPatchedContents Цикл
				
				Content = DocumentPatchedContent.Content;
				Контент = Base64Значение(Content);
				
				Попытка
					Подпись = ПодписатьКонтент(Контент, НазначенныеДанныеАвторизации);				
				Исключение
					ОписаниеОшибки = ОписаниеОшибки();
					ЗафиксироватьОшибку_НеУдалосьПодписатьСчетФактуру(СтрокаСчетФактура, ОписаниеОшибки);
					Продолжить;
				КонецПопытки;
				
				DocumentSignature = МодульОбъектаКлиент().КонтурДиадокAPI_СоздатьПоСхеме("DocumentSignature");
				
				DocumentSignature.ParentEntityId 	= DocumentPatchedContent.DocumentId.EntityId;
				DocumentSignature.Signature 	 	= Подпись;
				DocumentSignature.PatchedContentId 	= DocumentPatchedContent.PatchedContentId; 
				DocumentSignature.PowerOfAttorney  	= PowerOfAttorneyToPost; 
				
				MessagePatchToPost.Signatures.Добавить(DocumentSignature);
				
			КонецЦикла;
			
			Попытка
				MessagePatch = PostMessagePatch(MessagePatchToPost, operationID, НазначенныеДанныеАвторизации);
			Исключение
				ОписаниеОшибки = ОписаниеОшибки();
				ЗафиксироватьОшибку_НеУдалосьОтправитьДокумент(СтрокаСчетФактура, ОписаниеОшибки);
				Продолжить;
			КонецПопытки;
			
			
			// ?
			СтрокаСчетФактура.MessageId_new						= MessagePatch.MessageId;
			СтрокаСчетФактура.invoiceId_new						= СтрокаСчетФактура.invoiceId;
			СтрокаСчетФактура.UniversalTransferDocumentId_new	= СтрокаСчетФактура.UniversalTransferDocumentId;
			СтрокаСчетФактура.torg12Id_new						= СтрокаСчетФактура.torg12Id;
			
			СтруктураПодписанныхСчетФактур = Новый Структура("Ссылка, messageId_new, torg12Id_new, invoiceId_new, UniversalTransferDocumentId_new, isDraft");
			ЗаполнитьЗначенияСвойств(СтруктураПодписанныхСчетФактур, СтрокаСчетФактура);
			МассивПодписанныхСчетФактур.Добавить(СтруктураПодписанныхСчетФактур); 
			
		Иначе
			
			DraftToSend = МодульОбъектаКлиент().КонтурДиадокAPI_СоздатьПоСхеме("DraftToSend");
			
			DraftToSend.BoxId 	= BoxId;
			DraftToSend.DraftId = MessageId;
			
			PowerOfAttorneyToPost = PowerOfAttorneyToPost(НазначенныеДанныеАвторизации);	
			
			Для Каждого DocumentPatchedContent Из PrepareDocumentsToSignResponse.DocumentPatchedContents Цикл
				
				Content = DocumentPatchedContent.Content;
				Контент = Base64Значение(Content);
				
				Подпись = ПодписатьКонтент(Контент, НазначенныеДанныеАвторизации);				
				
				DocumentSenderSignature = МодульОбъектаКлиент().КонтурДиадокAPI_СоздатьПоСхеме("DocumentSenderSignature");
				
				DocumentSenderSignature.ParentEntityId 		= DocumentPatchedContent.DocumentId.EntityId;
				DocumentSenderSignature.Signature 	 		= Подпись;
				DocumentSenderSignature.PatchedContentId 	= DocumentPatchedContent.PatchedContentId; 
				DocumentSenderSignature.PowerOfAttorney  	= PowerOfAttorneyToPost; 
				
				DraftToSend.DocumentSignatures.Добавить(DocumentSenderSignature);
				
			КонецЦикла;
			
			Попытка
				Message = ОтправитьSendDraft(DraftToSend, НазначенныеДанныеАвторизации, operationID);
			Исключение
				ОписаниеОшибки = ОписаниеОшибки();
				ЗафиксироватьОшибку_НеУдалосьОтправитьДокумент(СтрокаСчетФактура, ОписаниеОшибки);
				Продолжить;
			КонецПопытки;
			
			
			// ? 
			СтрокаСчетФактура.MessageId_new = Message.MessageId;
			
			Для Каждого Entity из Message.Entities Цикл
				Если Entity.AttachmentType = "Invoice" или Entity.AttachmentType="InvoiceCorrection" Тогда 
					СтрокаСчетФактура.InvoiceId_new = Entity.EntityId;
				ИначеЕсли Entity.AttachmentType="XmlTorg12" Тогда 
					СтрокаСчетФактура.torg12Id_new = Entity.EntityId;
				ИначеЕсли Entity.AttachmentType = "UniversalTransferDocument" или Entity.AttachmentType = "UniversalTransferDocumentRevision" Тогда 
					СтрокаСчетФактура.UniversalTransferDocumentId_new = Entity.EntityId;
				ИначеЕсли Entity.AttachmentType = "UniversalCorrectionDocument" или Entity.AttachmentType = "UniversalCorrectionDocumentRevision" Тогда 
					СтрокаСчетФактура.UniversalTransferDocumentId_new = Entity.EntityId;
				КонецЕсли;
			КонецЦикла;
			
			СтруктураПодписанныхСчетФактур = Новый Структура("Ссылка, messageId_new, torg12Id_new, invoiceId_new, UniversalTransferDocumentId_new, isDraft");
			ЗаполнитьЗначенияСвойств(СтруктураПодписанныхСчетФактур, СтрокаСчетФактура);
			МассивПодписанныхСчетФактур.Добавить(СтруктураПодписанныхСчетФактур);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ВыполнитьОбработкуПодписанныхДокументов_КонтурEDI(МассивПодписанныхСчетФактур);
	
	Состояние("Подписание в Диадок: завершено");
	
КонецПроцедуры 

&НаКлиенте
Функция Новый_НазначенныеДанныеАвторизации(СчетФактура, Отказ)
	
	СтруктураСобытия = СобытиеСертификаты_НазначитьСертификат(СчетФактура);
	
	Если СтруктураСобытия.Переопределено Тогда 
		
		НазначенныеДанныеАвторизации = ПолучитьСтруктуруДанныхАвторизации();
		НазначенныеДанныеАвторизации.Организация = СтруктураСобытия.Организация;
		НазначенныеДанныеАвторизации.Отпечаток = СтруктураСобытия.Сертификат.Отпечаток;
		НазначенныеДанныеАвторизации.ПарольКонтейнера = СтруктураСобытия.Сертификат.Пароль;
		НазначенныеДанныеАвторизации.Расположение = СтруктураСобытия.Сертификат.Расположение;
		НазначенныеДанныеАвторизации.ТребуетсяДоверенность = СтруктураСобытия.Доверенность.ИспользоватьПоУмолчанию;
		НазначенныеДанныеАвторизации.ТипАвторизации = "Сертификат";
		
		СтруктураСобытия.Доверенность.Вставить("ДвоичныеДанныеДоверенности", СтруктураСобытия.ДвоичныеДанныеДоверенности);
		СтруктураСобытия.Доверенность.Вставить("ДвоичныеДанныеПодписи", СтруктураСобытия.ДвоичныеДанныеПодписи);
		
		НазначенныеДанныеАвторизации.Доверенность = СтруктураСобытия.Доверенность;
		
	Иначе 
		
		Если НЕ СчетФактура.Организация = ДанныеАвторизации.Организация Тогда
			ИнициализироватьДанныеАвторизации(СчетФактура.Организация);
		КонецЕсли;
		
		НазначенныеДанныеАвторизации = ДанныеАвторизации;
		
		Если ПропускСертификатаПоОрганизации(СчетФактура.Организация) Тогда
			Отказ = Истина;
			Возврат НазначенныеДанныеАвторизации;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НазначенныеДанныеАвторизации.Доверенность) Тогда
		СпособПередачиМашиночитаемойДоверенности = СпособПередачиМашиночитаемойДоверенности(СчетФактура.Ссылка);
		НазначенныеДанныеАвторизации.Вставить("СпособПередачиДоверенности", СпособПередачиМашиночитаемойДоверенности);
	КонецЕсли;
	
	ЕстьДоверенностьПоУмолчаниюВДиадок = ЗначениеЗаполнено(ДоверенностьПоУмолчанию(НазначенныеДанныеАвторизации));
	НазначенныеДанныеАвторизации.Вставить("ЕстьДоверенностьПоУмолчаниюВДиадок", ЕстьДоверенностьПоУмолчаниюВДиадок);	
	
	Возврат НазначенныеДанныеАвторизации;
	
КонецФункции

&НаКлиенте
Функция ПодписатьКонтент(Контент, ДанныеАвторизации)
	
	АдресФайлаДляПодписи = ПоместитьВоВременноеХранилище(Контент, Новый УникальныйИдентификатор);
	
	Для Сч = 1 По 2 Цикл
		
		Если ДанныеАвторизации.Расположение = "сервер" Тогда
			РезультатПодписания = ПолучитьПодписьФайлаДокументаНаСервере(АдресФайлаДляПодписи, ДанныеАвторизации);
		Иначе	
			РезультатПодписания = ПолучитьПодписьФайлаДокументаНаКлиенте(АдресФайлаДляПодписи, ДанныеАвторизации.Отпечаток, ДанныеАвторизации.ПарольКонтейнера);
		КонецЕсли;	
		
		Если ОбработкаИсключенияТипМодуляКриптографии(РезультатПодписания.ОписаниеОшибки, ДанныеАвторизации) Тогда
			Продолжить; // еще раз, уже с нужным типом модуля криптографии
		Иначе
			Прервать;
		КонецЕсли;	
		
	КонецЦикла;
	
	Если РезультатПодписания.Успешно = Истина Тогда
		Возврат РезультатПодписания.ШифрованнаяПодпись;
	Иначе
		ВызватьИсключение РезультатПодписания.ОписаниеОшибки;
	КонецЕсли;
	
КонецФункции

