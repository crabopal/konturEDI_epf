&НаКлиенте
Функция СвойствоСтруктуры(СложнаяСтруктура, ИерархияСвойств, ЗначениеПоУмолчанию = Неопределено)
	
	Результат = ЗначениеПоУмолчанию;
	
	Если Не ЗначениеЗаполнено(ИерархияСвойств) Или СложнаяСтруктура = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПростыеКлючи = EDI_РазложитьСтрокуВМассивСлов(ИерархияСвойств, ".", Ложь);
	
	ЗначениеПолучено = Ложь;
	ТекущееЗначение   = Неопределено;
	ТекущаяСтруктура = СложнаяСтруктура;
	
	ВГраница = ПростыеКлючи.ВГраница();
	
	Для Сч = 0 По ВГраница Цикл
		
		ТекущийКлюч = ПростыеКлючи[Сч];
		
		Если ТекущаяСтруктура.Свойство(ТекущийКлюч, ТекущееЗначение) Тогда
			
			Если Сч = ВГраница Тогда
				
				ЗначениеПолучено = Истина;
				
			ИначеЕсли ТипЗнч(ТекущееЗначение) = Тип("Структура") Тогда
				
				ТекущаяСтруктура = ТекущееЗначение;
				
			Иначе
				Прервать;
			КонецЕсли;
			
		Иначе
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеПолучено Тогда
		Результат = ТекущееЗначение;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция EDI_РазложитьСтрокуВМассивСлов(Знач Строка, РазделителиСлов="", РазделительКакЕдиныйСимвол = Ложь) Экспорт
	
	Слова = Новый Массив;
	
	ДлинаРазделителя = СтрДлина(РазделителиСлов);
	
	Если ДлинаРазделителя = 1 ИЛИ РазделительКакЕдиныйСимвол Тогда
		
		НайденныйСимвол = Найти(Строка,РазделителиСлов);
		Пока НайденныйСимвол>0 Цикл
			Слова.Добавить(СокрЛП(Лев(Строка,НайденныйСимвол + ДлинаРазделителя - 2)));
			Строка = Сред(Строка,НайденныйСимвол + ДлинаРазделителя);
			НайденныйСимвол = Найти(Строка,РазделителиСлов);
		КонецЦикла;
		
		Если НЕ ПустаяСтрока(Строка) Тогда
			Слова.Добавить(СокрЛП(Строка));
		КонецЕсли;
		
	Иначе
		
		Для Сч = 1 По СтрДлина(РазделителиСлов) Цикл
			Строка = СтрЗаменить(Строка,Сред(РазделителиСлов,Сч,1),Символы.ПС);
		КонецЦикла;
		
		Для Сч=1 По СтрЧислоСтрок(Строка) Цикл
			ТекСлово = СокрЛП(СтрПолучитьСтроку(Строка,Сч));
			Если ТекСлово<>"" Тогда
				Слова.Добавить(СокрЛП(ТекСлово));
			КонецЕсли;	
		КонецЦикла;	
		
	КонецЕсли;
	
	Возврат Слова;
	
КонецФункции

&НаКлиенте
Функция ПолучитьEntitiesДляПодписания(MessageЧерновик)
	
	EntitiesДляПодписания = Новый Массив;
	
	Для каждого EntityЧерновика Из MessageЧерновик.Entities Цикл
		Если EntityЧерновика.Свойство("DocumentInfo") Тогда 
			EntitiesДляПодписания.Добавить(EntityЧерновика);
		КонецЕсли;
	КонецЦикла;
	
	Возврат EntitiesДляПодписания;
	
КонецФункции

&НаКлиенте
Функция ПолучитьPatchedEntities(Message, BoxId, MessageId, ДанныеАвторизации, IsDraft)
	
	PrepareDocumentsToSignRequest = МодульОбъектаКлиент().КонтурДиадокAPI_СоздатьПоСхеме("PrepareDocumentsToSignRequest");
	PrepareDocumentsToSignRequest.BoxId = BoxId;
	
	КэшКонтентаПодписантов = Новый Структура;	
	
	Для каждого Entity Из Message.Entities Цикл
		
		Если Entity.DocumentInfo.DocumentType = "UnknownDocumentType" Тогда
			Продолжить;
		КонецЕсли;
		
		EntityId = Entity.EntityId;
		SignerContent = ПолучитьКонтентПодписанта(Entity, КэшКонтентаПодписантов, ДанныеАвторизации, BoxId);
		
		Если IsDraft Тогда
			
			DraftDocumentToPatch = МодульОбъектаКлиент().КонтурДиадокAPI_СоздатьПоСхеме("DraftDocumentToPatch");
			
			DraftDocumentToPatch.DocumentId.MessageId = MessageId; 
			DraftDocumentToPatch.DocumentId.EntityId  = EntityId; 
			DraftDocumentToPatch.SignerContent = SignerContent;
			
			PrepareDocumentsToSignRequest.DraftDocuments.Добавить(DraftDocumentToPatch);
			
		Иначе     
			
			DocumentToPatch = МодульОбъектаКлиент().КонтурДиадокAPI_СоздатьПоСхеме("DocumentToPatch");
			
			DocumentToPatch.DocumentId.MessageId = MessageId; 
			DocumentToPatch.DocumentId.EntityId  = EntityId;
			DocumentToPatch.SignerContent = SignerContent;
			
			PrepareDocumentsToSignRequest.Documents.Добавить(DocumentToPatch);
			
		КонецЕсли;
		
	КонецЦикла; 
	
	PrepareDocumentsToSignResponse = ВыполнитьPrepareDocumentsToSign(PrepareDocumentsToSignRequest, ДанныеАвторизации);	
	
	Возврат PrepareDocumentsToSignResponse; 	
	
КонецФункции

&НаКлиенте
Функция ПолучитьКонтентПодписанта(Entity, КэшКонтентаПодписантов, ДанныеАвторизации, BoxId) 
	
	КонтентПодписанта = Неопределено;
	
	ФорматПодписанта = "Формат820";
	
	Если Entity.Свойство("ContentTypeId") И Найти(Entity.ContentTypeId, "970") > 0 Тогда
		ФорматПодписанта = "Формат970";
	КонецЕсли;
	
	Если КэшКонтентаПодписантов.Свойство(ФорматПодписанта, КонтентПодписанта) Тогда
		Возврат КонтентПодписанта;
	КонецЕсли;
	
	Если ФорматПодписанта = "Формат970" Тогда
		КонтентПодписанта = SignerContent970(ДанныеАвторизации, BoxId);
	Иначе
		КонтентПодписанта = SignerContent(ДанныеАвторизации, BoxId);
	КонецЕсли;
	
	КэшКонтентаПодписантов.Вставить(ФорматПодписанта, КонтентПодписанта);
	
	Возврат КонтентПодписанта;
	
КонецФункции

&НаКлиенте
Функция ПолучитьИННЯщикаДиадокНаКлиенте(ИдентификаторЯщика, ДанныеАвторизации)
	
	Если КэшИННЯщикаДиадок = Неопределено Тогда
		КэшИННЯщикаДиадок = Новый Соответствие;
	КонецЕсли;
	
	ИНН = КэшИННЯщикаДиадок.Получить(ИдентификаторЯщика);
	
	Если Не ЗначениеЗаполнено(ИНН) Тогда
	
		Попытка
			ЯщикДиадок = ПолучитьИнформациюОЯщикеДиадок(ИдентификаторЯщика, ДанныеАвторизации);
			ИНН = ЯщикДиадок.Organization.Inn;
		Исключение
			ИНН = Неопределено;
		КонецПопытки;
		
		Если Не ЗначениеЗаполнено(ИНН) Тогда
			ИНН = ПолучитьЗначениеСвойстваОбъектаEDI_Сервер(ДанныеАвторизации.Организация, "DiadocOrgInn");	
		КонецЕсли;
		
		КэшИННЯщикаДиадок.Вставить(ИдентификаторЯщика, ИНН);
		
	КонецЕсли;
	
	Возврат ИНН;
	
КонецФункции

