&НаКлиенте
Процедура ОтправитьСлужебныеУниверсальныеСообщения() Экспорт 
	
	СброситьПроверкиДанныхАвторизации();	
	МассивОрганизаций = ВернутьМассивОрганизаций();
	ОтправлятьИоП = ПолучитьФункциональнуюОпциюEDI_НаСервере("SendIopWithSus",Истина);
	Для каждого Организация Из МассивОрганизаций Цикл
		
		ЗаполнитьТаблицуАвторизацииПоУмолчанию();
		
		СброситьПроверкиДанныхАвторизации();	
		ИнициализироватьДанныеАвторизации(Организация);
		
		Если ДанныеАвторизации.ТипАвторизации <> "ЛогинПароль" Тогда  
			ОбновитьДанныеАвторизации("ТипАвторизации", "Сертификат");
		КонецЕсли;
		
		Если Не СертификатПоОрганизацииНазначен(Организация) Тогда 
			Продолжить;
		КонецЕсли;	
		
		//Поиск ящика Диадока
		ИдентификаторОрганизацииДиадок = ИдентификаторОрганизацииДиадок_Сервер(ДанныеАвторизации);
		ИдентификаторЯщикаДиадок = ИдентификаторЯщикаДиадок(ДанныеАвторизации,ИдентификаторОрганизацииДиадок);  
		
		НазначенныеДанныеАвторизации = ДанныеАвторизации;  
		ДанныеАвторизацииДиадок = МодульОбъектаКлиент().ДанныеАвторизацииДляКонтурДиадокAPI(НазначенныеДанныеАвторизации);
		
		DD_МассивСтруктур = МодульОбъектаКлиент().КонтурДиадокAPI_СписокДокументовПолный(ДанныеАвторизацииДиадок, ИдентификаторЯщикаДиадок, "Any.OutboundHaveToCreateReceipt");
		
		ПолучитьТаблицуДляОтправкиСлужебныхУниверсальныхСообщений_НаСервере(DD_МассивСтруктур); 
		
		Если СчетаФактурыДляОтправкиИзвещений.Количество() = 0 Тогда 
			Продолжить
		КонецЕсли;    
		
		Прогресс = 0;
		Всего = СчетаФактурыДляОтправкиИзвещений.Количество();  
		ТекОрганизация = Организация;
		
		Для каждого СтрокаСЧФ Из СчетаФактурыДляОтправкиИзвещений Цикл
			
			Прогресс = Прогресс + 1;
			ТекПроцент = Цел((Прогресс * 100 / Всего)); 
			Состояние("Отправка извещений в Диадок: " + Прогресс + " из " + Всего +  " , по организации " + СтрокаСЧФ.Организация, ТекПроцент); 
			Если ОтправлятьИоП Тогда 
				СтруктураСобытия = СобытиеСертификаты_НазначитьСертификат(СтрокаСЧФ);
				
				Если СтруктураСобытия.Переопределено Тогда 
					
					НазначенныеДанныеАвторизации = ПолучитьСтруктуруДанныхАвторизации();
					НазначенныеДанныеАвторизации.Организация = СтруктураСобытия.Организация;
					НазначенныеДанныеАвторизации.Отпечаток = СтруктураСобытия.Сертификат.Отпечаток;
					НазначенныеДанныеАвторизации.ПарольКонтейнера = СтруктураСобытия.Сертификат.Пароль;
					НазначенныеДанныеАвторизации.Расположение = СтруктураСобытия.Сертификат.Расположение;
					НазначенныеДанныеАвторизации.ТребуетсяДоверенность = СтруктураСобытия.Доверенность.ИспользоватьПоУмолчанию;
					НазначенныеДанныеАвторизации.ТипАвторизации = "Сертификат";
					
					СтруктураСобытия.Доверенность.Вставить("ДвоичныеДанныеДоверенности", СтруктураСобытия.ДвоичныеДанныеДоверенности);
					СтруктураСобытия.Доверенность.Вставить("ДвоичныеДанныеПодписи", СтруктураСобытия.ДвоичныеДанныеПодписи);
					
					НазначенныеДанныеАвторизации.Доверенность = СтруктураСобытия.Доверенность;
					
					
				ИначеЕсли ТекОрганизация <> СтрокаСЧФ.Организация Тогда
					
					ТекОрганизация = СтрокаСЧФ.Организация;
					ИнициализироватьДанныеАвторизации(ТекОрганизация);
					ОбновитьДанныеАвторизации("ТипАвторизации", "Сертификат"); 
					
					Если Не СертификатПоОрганизацииНазначен(ТекОрганизация) Тогда //TODO при необходимости выбора сертификата и доверенности - использовать МожемПодписатьДокументыСертификатом
						Продолжить;
					КонецЕсли;
					
					Если Не ДанныеАвторизации.СертификатПроверен Тогда //TODO при необходимости ПроверкаСертификатаВФНС - использовать ОбработчикПроверкиПодписанияСертификатом
						
						ПарольКонтейнера = "";
						РезультатПроверки = ПроверитьВыбранныйСертификат(ДанныеАвторизации.Организация, ДанныеАвторизации.Отпечаток, ДанныеАвторизации.Расположение, ДанныеАвторизации.СертификатДействуетПо, ПарольКонтейнера);
						
						Если РезультатПроверки.Успешно = Ложь
							И ОшибкаНеправильныйПарольКонтейнера(РезультатПроверки.ОписаниеОшибки) Тогда
							
							ПарольКонтейнера = ПолучитьПарольКонтейнераСертификатаСервер(ДанныеАвторизации.Организация, ДанныеАвторизации.Отпечаток);
							РезультатПроверки = ПроверитьВыбранныйСертификат(ДанныеАвторизации.Организация, ДанныеАвторизации.Отпечаток, ДанныеАвторизации.Расположение, ДанныеАвторизации.СертификатДействуетПо, ПарольКонтейнера);
							
						КонецЕсли;
						
						ОбновитьДанныеАвторизации("СертификатПроверен", Истина);
						
						Если РезультатПроверки.Успешно = Истина Тогда
							ОбновитьДанныеАвторизации("ПарольКонтейнера", ПарольКонтейнера);
							ОбновитьДанныеАвторизации("ВалидацияСертификатаПройдена", Истина);
						Иначе
							ОбновитьДанныеАвторизации("ВалидацияСертификатаПройдена", Ложь);
						КонецЕсли;
						
					КонецЕсли;
					
					НазначенныеДанныеАвторизации = ДанныеАвторизации;
					
				КонецЕсли;
				
				Если ПропускСертификатаПоОрганизации(НазначенныеДанныеАвторизации.Организация) Тогда
					Продолжить; 
				КонецЕсли;
				
				Если ЗначениеЗаполнено(НазначенныеДанныеАвторизации.Доверенность) Тогда
					СпособПередачиМашиночитаемойДоверенности = СпособПередачиМашиночитаемойДоверенности(СтрокаСЧФ.Ссылка);
					НазначенныеДанныеАвторизации.Вставить("СпособПередачиДоверенности", СпособПередачиМашиночитаемойДоверенности);
				КонецЕсли;
				
				ЕстьДоверенностьПоУмолчаниюВДиадок = ЗначениеЗаполнено(ДоверенностьПоУмолчанию(НазначенныеДанныеАвторизации));
				НазначенныеДанныеАвторизации.Вставить("ЕстьДоверенностьПоУмолчаниюВДиадок", ЕстьДоверенностьПоУмолчаниюВДиадок);
			КонецЕсли;
			
			ДанныеДокумента = Новый Структура("boxId, messageId, Ссылка, Организация, ДокументПредставление");
			ЗаполнитьЗначенияСвойств(ДанныеДокумента, СтрокаСЧФ);
			
			СформироватьИОтправитьСлужебноеУниверсальноеСообщение(НазначенныеДанныеАвторизации,ДанныеДокумента,ОтправлятьИоП);
			
		КонецЦикла;	
	КонецЦикла;
	
	СброситьПарольКонтейнераДанныхАвторизации(); 
	
КонецПроцедуры  

&НаКлиенте
Процедура СформироватьИОтправитьСлужебноеУниверсальноеСообщение(ДанныеАвторизации,ДанныеДокумента,ОтправлятьИоП)  
		
		Попытка
			Message = ПолучитьMessage(ДанныеДокумента.boxId, ДанныеДокумента.messageId, ДанныеАвторизации, Ложь);
		Исключение                                                                                  
			ОписаниеОшибки = ОписаниеОшибки();
			ЗафиксироватьОшибку_НеУдалосьПолучитьДокументыДляФормированияИзвещений(ДанныеДокумента, ОписаниеОшибки);
			Возврат;
		КонецПопытки;
		
		СписокParentEntityIdИзвещенийДляОтправки = ПолучитьСписокParentEntityIdИзвещенийДляОтправки(Message);
		
		Если СписокParentEntityIdИзвещенийДляОтправки.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		messageId = ДанныеДокумента.messageId;
		boxId = ДанныеДокумента.boxId; 
		
		MessagePatchToPost = МодульОбъектаКлиент().КонтурДиадокAPI_СоздатьПоСхеме("MessagePatchToPostV2");
		MessagePatchToPost.BoxId 	 = boxId;
		MessagePatchToPost.MessageId = messageId;
		
		Если ОтправлятьИоП Тогда 
			SignerContent = SignerContentИоП(ДанныеАвторизации);
			PowerOfAttorneyToPost = PowerOfAttorneyToPost(ДанныеАвторизации); 
		КонецЕсли; 
		
		Для каждого ЭлементСпискаЗначений Из СписокParentEntityIdИзвещенийДляОтправки Цикл
			
			AttachmentId = ЭлементСпискаЗначений.Значение;
			СтруктураПараметровСУС = ВернутьПараметрыСуС(ДанныеАвторизации);
			СтрокаXML = ЗаписатьСлужебноеУниверсальноеСообщение_НаСервере(СтруктураПараметровСУС);  
			Попытка 
				UniversalMessage = GenerateUniversalMessage(
				boxId,
				messageId,
				AttachmentId,
				СтрокаXML,
				ДанныеАвторизации); 
			Исключение 
				ОписаниеОшибки = ОписаниеОшибки();
				ЗафиксироватьОшибку_НеУдалосьСформироватьИзвещения(ДанныеДокумента, ОписаниеОшибки);
				Возврат;
			КонецПопытки;
			
			UniversalMessageAttachment = МодульОбъектаКлиент().КонтурДиадокAPI_СоздатьПоСхеме("UniversalMessageAttachment");
			UniversalMessageAttachment.ParentEntityId = AttachmentId;
			UniversalMessageAttachment.CodeGroup = Лев(СтруктураПараметровСУС.Код, 1);
			UniversalMessageAttachment.UniversalMessageContent.Content = Base64Строка(UniversalMessage);  
			
			MessagePatchToPost.UniversalMessages.Добавить(UniversalMessageAttachment); 
			Если ОтправлятьИоП Тогда 
				ReceiptGenerationRequestV2 = МодульОбъектаКлиент().КонтурДиадокAPI_СоздатьПоСхеме("ReceiptGenerationRequestV2");
				
				ReceiptGenerationRequestV2.MessageId 		= messageId;
				ReceiptGenerationRequestV2.AttachmentId 	= AttachmentId;
				ReceiptGenerationRequestV2.SignerContent 	= SignerContent;
				
				Попытка
					ДвоичныеДанныеИзвещения = GenerateReceiptXml(boxId, ReceiptGenerationRequestV2, ДанныеАвторизации);
				Исключение
					ОписаниеОшибки = ОписаниеОшибки();
					ЗафиксироватьОшибку_НеУдалосьСформироватьИзвещения(ДанныеДокумента, ОписаниеОшибки);
					Возврат;
				КонецПопытки;
				
				Попытка
					Подпись = ПодписатьКонтент(ДвоичныеДанныеИзвещения, ДанныеАвторизации);
				Исключение
					ОписаниеОшибки = ОписаниеОшибки();
					ЗафиксироватьОшибку_НеУдалосьПодписатьИзвещения(ДанныеДокумента, ОписаниеОшибки);
					Возврат;
				КонецПопытки;
				
				ReceiptAttachment = МодульОбъектаКлиент().КонтурДиадокAPI_СоздатьПоСхеме("ReceiptAttachment");
				
				ReceiptAttachment.ParentEntityId = AttachmentId; 
				ReceiptAttachment.SignedContent.Content = Base64Строка(ДвоичныеДанныеИзвещения);
				ReceiptAttachment.SignedContent.Signature = Подпись;
				ReceiptAttachment.SignedContent.PowerOfAttorney = PowerOfAttorneyToPost;
				
				MessagePatchToPost.Receipts.Добавить(ReceiptAttachment);
			КонецЕсли;
		КонецЦикла;
		
		Если MessagePatchToPost.UniversalMessages.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		Попытка
			MessagePatch = PostMessagePatch(MessagePatchToPost, , ДанныеАвторизации);
		Исключение
			ОписаниеОшибки = ОписаниеОшибки();
			ЗафиксироватьОшибку_НеУдалосьОтправитьИзвещения(ДанныеДокумента, ОписаниеОшибки);
			Возврат;
		КонецПопытки;
		
		ЗаписатьДопРеквизитыСообщенияInvoiceReceiptIdСервер(MessagePatch, СписокParentEntityIdИзвещенийДляОтправки, ДанныеДокумента.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Функция GenerateUniversalMessage(ИдентификаторЯщика, messageId, attachmentId, СтрокаXML,ДанныеАвторизации)	
	
	ДанныеАвторизацииДиадок = МодульОбъектаКлиент().ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизации);
	Результат = МодульОбъектаКлиент().КонтурДиадокAPI_СгенерироватьУниверсальноеСообщение(ДанныеАвторизацииДиадок, ИдентификаторЯщика, messageId, attachmentId, СтрокаXML);
	
	Возврат Результат;
	
КонецФункции	

&НаКлиенте
Функция ВернутьПараметрыСуС(ДанныеАвторизации)
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Код"				, "1999");
	СтруктураПараметров.Вставить("ТекстСообщения"	, "");
	Отправитель = Новый Структура;
	Отправитель.Вставить("ДанныеПоУмолчанию"		, "false");//ДанныеПоУмолчанию
	Отправитель.Вставить("Фамилия"					, ДанныеАвторизации.СвойстваСертификата.Субъект.Фамилия);
	Отправитель.Вставить("Имя"						, ДанныеАвторизации.СвойстваСертификата.Субъект.Имя);
	Отправитель.Вставить("Отчество"					, ДанныеАвторизации.СвойстваСертификата.Субъект.Отчество); 
	СтруктураПараметров.Вставить("Отправитель"		, Отправитель); 
	
	Возврат СтруктураПараметров; 
	
КонецФункции

&НаСервере
Функция ПолучитьФункциональнуюОпциюEDI_НаСервере(ИмяОпции,ЗначениеПоУмолчанию = Ложь) 
	Возврат МодульОбъекта().ПолучитьФункциональнуюОпциюEDI(ИмяОпции,ЗначениеПоУмолчанию);
КонецФункции	 

&НаСервере
Функция ЗаписатьСлужебноеУниверсальноеСообщение_НаСервере(СтруктураПараметров)  
	Возврат МодульОбъекта().ЗаписатьСлужебноеУниверсальноеСообщение(СтруктураПараметров);
КонецФункции

&НаСервере
Процедура ПолучитьТаблицуДляОтправкиСлужебныхУниверсальныхСообщений_НаСервере(МассивСтруктур)  
	СчетаФактурыДляОтправкиИзвещений.Загрузить(МодульОбъекта().ПолучитьТаблицуДляОтправкиСлужебныхУниверсальныхСообщений(МассивСтруктур));
КонецПроцедуры	

&НаСервере
Функция ВернутьМассивОрганизаций()    
	Возврат МодульОбъекта().ПолучитьСписокЭлементовСправочника("ЮрФизЛицаСвои").ВыгрузитьКолонку("ЮрФизЛицо");
КонецФункции    

&НаКлиенте
Функция GenerateReceiptXml(boxId, ReceiptGenerationRequestV2, ДанныеАвторизации) 
	
	ДанныеАвторизацииДиадок = МодульОбъектаКлиент().ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизации);
	Результат = МодульОбъектаКлиент().КонтурДиадокAPI_СгенерироватьИзвещениеОПолучении_V2(ДанныеАвторизацииДиадок, boxId, ReceiptGenerationRequestV2);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПолучитьСписокParentEntityIdТитуловПолучателя(Message)
	
	СписокParentEntityId = Новый СписокЗначений;
	
	МассивAttachmentType = РазложитьСтрокуВМассивСлов_КонтурСВ("Title,UniversalTransferDocumentBuyerTitle,UniversalCorrectionDocumentBuyerTitle", ",");	
	
	Для каждого Entity Из Message.Entities Цикл
		Если МассивAttachmentType.Найти(Entity.AttachmentType) <> Неопределено Тогда
			СписокParentEntityId.Добавить(Entity.EntityId, Entity.AttachmentType);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокParentEntityId;
	
КонецФункции // ПолучитьСписокParentEntityIdТитуловПолучателя()

&НаКлиенте
Функция ПолучитьСписокParentEntityIdИзвещенийДляОтправки(Message)
	
	СписокParentEntityId = ПолучитьСписокParentEntityIdТитуловПолучателя(Message);
	
	Для каждого Entity Из Message.Entities Цикл
		Если Прав(Entity.AttachmentType,7) = "Receipt" Тогда
			НайденныйЭлемент = СписокParentEntityId.НайтиПоЗначению(Entity.ParentEntityId);
			Если НЕ НайденныйЭлемент = Неопределено Тогда
				СписокParentEntityId.Удалить(НайденныйЭлемент);	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокParentEntityId;
	
КонецФункции // ПолучитьСписокParentEntityIdИзвещенийДляОтправки()

&НаКлиенте
Функция СохранитьТекстИзвещенияВФайл(entityId, ТекстИзвещения, ПутьКФайлу)
	
	ВременныйФайл = Новый Файл(ПутьКФайлу);
	Если ВременныйФайл.Существует() Тогда
		УдалитьФайлы(ВременныйФайл.ПолноеИмя); //Если такой файл уже есть в temp, значит, он остался от предыдущей сессии, когда чо-то пошло не так. Удалим его.
	КонецЕсли;
	ТД = Новый ТекстовыйДокумент;
	ТД.УстановитьТекст(ТекстИзвещения);
	ТД.Записать(ПутьКФайлу, "windows-1251");
	
	Возврат ТД;
	
КонецФункции

&НаСервере
Процедура ЗаписатьДопРеквизитыСообщенияInvoiceReceiptIdСервер(MessagePatch, СписокParentEntityId, СообщениеСсылка)
	
	Если MessagePatch.Свойство("Entities") И ТипЗнч(MessagePatch.Entities) = Тип("Массив") Тогда
		Для каждого Entity Из MessagePatch.Entities Цикл
			Если Прав(Entity.AttachmentType,7) = "Receipt" Тогда
				
				НайденныйЭлемент = СписокParentEntityId.НайтиПоЗначению(Entity.ParentEntityId);
				Если НЕ НайденныйЭлемент = Неопределено Тогда
					МодульОбъекта().ЗаписатьДопРеквизитСправочника_КонтурEDI(СообщениеСсылка, "InvoiceReceiptEntityId_HaveToCreateReceipt", Entity.EntityId);
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;		
	КонецЕсли;
	
КонецПроцедуры

