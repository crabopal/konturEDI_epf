&НаКлиенте
Функция ПолучитьMessage(BoxId, MessageId, ДанныеАвторизации, ВозвращатьСодержимоеСущностей = Истина)
	
	ДанныеАвторизацииДиадок = МодульОбъектаКлиент().ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизации);
	Результат = МодульОбъектаКлиент().КонтурДиадокAPI_СодержимоеСообщения(ДанныеАвторизацииДиадок, BoxId, MessageId, "", "", ВозвращатьСодержимоеСущностей);
	
	Возврат Результат;
		
КонецФункции

&НаСервере
Функция ПолучитьПодписьФайлаДокументаНаСервере(АдресФайла, ДанныеАвторизации)
	Возврат МодульОбъекта().ПолучитьПодписьФайлаДокумента_КонтурEDI(АдресФайла, ДанныеАвторизации);
КонецФункции	

&НаКлиенте
Функция ПолучитьПодписьФайлаДокументаНаКлиенте(АдресФайла, Отпечаток, ПарольКонтейнера = "") Экспорт
	
	//серверный аналог функции расположен в модуле объекта
	Результат = ИнициализироватьСтруктуруРезультатаФункции();
	
	Попытка
		
		Если ЭтоАдресВременногоХранилища(АдресФайла) Тогда
			
			ПутьКФайлу = ПолучитьИмяВременногоФайла();
			Файл = ПолучитьИзВременногоХранилища(АдресФайла);
			Файл.Записать(ПутьКФайлу);
			
			Контент = ПутьКФайлу;
			
		Иначе     
			
			Контент = АдресФайла;				
			
		КонецЕсли;
		
		Подпись = МодульОбъектаКлиент().Криптография_Подписать(Контент, Отпечаток, ПарольКонтейнера);
		ШифрованнаяПодпись = Base64Строка(Подпись);
		
		Результат.Успешно = Истина;
		Результат.Вставить("ШифрованнаяПодпись", ШифрованнаяПодпись);
		
	Исключение
		
		Результат.ОписаниеОшибки = ОписаниеОшибки();
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция СохранитьКонтентВложения(BoxId, MessageId, EntityId, ДанныеАвторизации, ПутьКФайлу)
	
	Результат = ИнициализироватьСтруктуруРезультатаФункции();
	
	ИспользоватьСохраненныйТокен = Истина;
	
	ДвоичныеДанные = ДвоичныеДанныеКонтентаEntity(BoxId, EntityId, MessageId, ДанныеАвторизации, ИспользоватьСохраненныйТокен);     
	
	Если ДвоичныеДанные <> Неопределено Тогда
		
		ДвоичныеДанные.Записать(ПутьКФайлу);
		
		ФайлКонтентаВложения = Новый Файл(ПутьКФайлу);
		Если Не ФайлКонтентаВложения.Существует() Тогда
			ВызватьИсключение "не удалось сохранить файл на диск";
		КонецЕсли;
		
		Результат.Успешно = Истина;
		
	КонецЕсли;
	
	Возврат Результат;	
	
КонецФункции

&НаКлиенте
Функция ДвоичныеДанныеКонтентаEntity(BoxId, EntityId, MessageId, Знач ДанныеАвторизации, ИспользоватьСохраненныйТокен)
	
	ДанныеАвторизацииДиадок = МодульОбъектаКлиент().ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизации);
	Результат = МодульОбъектаКлиент().КонтурДиадокAPI_СодержимоеСущности(ДанныеАвторизацииДиадок, BoxId, MessageId, EntityId);
	
	Возврат Результат;
		
КонецФункции


&НаКлиенте
Функция ИнициализироватьСтруктуруРезультатаФункции()
	
	СтруктураРезультата = Новый Структура();
	
	СтруктураРезультата.Вставить("Успешно",			Ложь);
	СтруктураРезультата.Вставить("ОписаниеОшибки",	"");
	
	Возврат СтруктураРезультата;
	
КонецФункции

