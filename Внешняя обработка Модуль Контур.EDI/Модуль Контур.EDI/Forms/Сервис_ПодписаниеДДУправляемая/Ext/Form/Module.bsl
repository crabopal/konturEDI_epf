&НаКлиенте
Функция ПредставлениеСертификатаНаФорме(СвойстваСертификата) Экспорт
	
	ФИО = СокрЛП(Строка(СвойстваСертификата.Субъект.Фамилия) + " " + Строка(СвойстваСертификата.Субъект.Имя) + " " + Строка(СвойстваСертификата.Субъект.Отчество));
	ИНН = СокрЛП(?(ЗначениеЗаполнено(СвойстваСертификата.Субъект.ИННЮЛ), СвойстваСертификата.Субъект.ИННЮЛ, СвойстваСертификата.Субъект.ИНН));
	НаименованиеОрганизацииСубъекта = ?(ЗначениеЗаполнено(СвойстваСертификата.Субъект.Организация), СвойстваСертификата.Субъект.Организация, ФИО); 	
	НаименованиеОрганизацииСубъекта = ?(ЗначениеЗаполнено(НаименованиеОрганизацииСубъекта), НаименованиеОрганизацииСубъекта, "<Неизвестно>");
	
	ДанныеДляЗаполнения = Новый Массив;
	Если ЗначениеЗаполнено(ИНН) Тогда
		ДанныеДляЗаполнения.Добавить("ИНН: " + ИНН);
	Иначе
		ДанныеДляЗаполнения.Добавить("ИНН: <Неизвестно>");			
	КонецЕсли;
	Если ЗначениеЗаполнено(ФИО) Тогда
		ДанныеДляЗаполнения.Добавить(ФИО);
	КонецЕсли;
	Если ЗначениеЗаполнено(СвойстваСертификата.ДатаОкончания) И РассчитатьОсталосьДнейДействияСертификата(СвойстваСертификата.ДатаОкончания) <= 30 Тогда
		ДанныеДляЗаполнения.Добавить("Действует до " + Формат(СвойстваСертификата.ДатаОкончания, "ДЛФ=ДД"));
	КонецЕсли;
	
	Представление = "" + НаименованиеОрганизацииСубъекта + "
	|";
	Для Каждого Строка Из ДанныеДляЗаполнения Цикл
		Представление = Представление + Строка + Символы.ПС;			
	КонецЦикла;
	
	Возврат Представление;
	
КонецФункции


&НаКлиенте
Функция РассчитатьОсталосьДнейДействияСертификата(ОкончаниеПериодаДействия)
	
