// Инициализация модуля и его экспортных функций
&НаСервере
Функция МодульОбъекта()
	
	Если МодульОбъекта = Неопределено Тогда
		
		Если Объект.ПараметрыКлиентСервер.КэшироватьОбработкуОбъект Тогда
			МодульОбъекта = МодульОбъектаИзКэша();
		КонецЕсли;
		
		Если МодульОбъекта = Неопределено Тогда
			МодульОбъекта = РеквизитФормыВЗначение("Объект");
			МодульОбъекта.ИнициализироватьПодключаемыеМодули(); // TODO Проверить что из этого используется на формах и перенести в ПараметрыКлиентСервер
			МодульОбъекта.ОбновитьКэшМодуляОбъекта();
		КонецЕсли;
		
	КонецЕсли;	
	
	Возврат МодульОбъекта;
	
КонецФункции

&НаСервере
Функция МодульОбъектаИзКэша()
	
	Результат = Неопределено;
	
	Если ТипЗнч(Объект.ПараметрыКлиентСервер) = Тип("Структура") Тогда
		АдресВХ = Объект.ПараметрыКлиентСервер.АдресаВХ.ОбработкаОбъект;
		Если ЭтоАдресВременногоХранилища(АдресВХ) Тогда
			Структура = ПолучитьИзВременногоХранилища(АдресВХ);
			Если ТипЗнч(Структура) = Тип("Структура") и Структура.Свойство("ОбработкаОбъект") Тогда
				Результат = Структура.ОбработкаОбъект;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция МодульОбъектаКлиент()
	
	Если ТипЗнч(МодульОбъектаКлиент) = Тип("УправляемаяФорма") Тогда
		Возврат МодульОбъектаКлиент;
	КонецЕсли;
	
	ОсновнаяФорма = ОсновнаяФорма();
	Если ТипЗнч(ОсновнаяФорма) = Тип("УправляемаяФорма") Тогда
		МодульОбъектаКлиент = ОсновнаяФорма.МодульОбъектаКлиент();
		Возврат МодульОбъектаКлиент;
	Иначе
		Сообщить("Ошибка! Не удалось получить контекст основной формы.");
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ОсновнаяФорма() Экспорт
	
	Если Не ЭтаФорма.ВладелецФормы = Неопределено Тогда
		Возврат ЭтаФорма.ВладелецФормы.ОсновнаяФорма();
	КонецЕсли;
	
	ОсновнаяФорма = Неопределено;
	ИдентификаторОсновнойФормы = ЭтаФорма.Объект.ПараметрыКлиентСервер.IDОсновнойФормы;
	
	Попытка
		ОткрытыеОкнаКлиентскогоПриложения = ПолучитьОкна();
		Для каждого ОкноКлиентскогоПриложения Из ОткрытыеОкнаКлиентскогоПриложения Цикл
			
			Для каждого ФормаОкна Из ОкноКлиентскогоПриложения.Содержимое Цикл
				Если ФормаОкна.УникальныйИдентификатор = ИдентификаторОсновнойФормы Тогда
					ОсновнаяФорма = ФормаОкна;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если Не ОсновнаяФорма = Неопределено Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
	Исключение
		ОсновнаяФорма = Неопределено;
	КонецПопытки;
		
	Возврат ОсновнаяФорма;
	
КонецФункции

&НаКлиенте
Функция НоваяМетрика()
	
	Возврат ОсновнаяФорма().НоваяМетрика();
	
КонецФункции

&НаКлиенте
Функция МодульОбменКлиент()
	
	Возврат ЭтаФорма;
	
КонецФункции

&НаКлиенте
Процедура ПоместитьВоВХ(Имя,Значение)
	
	ПоместитьВоВременноеХранилище(Значение, Объект.ПараметрыКлиентСервер.АдресаВХ[Имя]);
	
КонецПроцедуры

&НаКлиенте
Функция ИзвлечьИзВХ(Имя)
	
	АдресВХ = Объект.ПараметрыКлиентСервер.АдресаВХ[Имя];
	
	Если Не ЭтоАдресВременногоХранилища(АдресВХ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПолучитьИзВременногоХранилища(АдресВХ);
	
КонецФункции

// } СЛУЖЕБНЫЕ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ОбъектПараметрыКлиентСервер", 			Объект.ПараметрыКлиентСервер);
	Параметры.Свойство("ОбъектПараметрыКлиентСерверМетрика", 	Объект.ПараметрыКлиентСерверМетрика);
		
	ЗаполнитьТаблицуАвторизацииПоУмолчанию();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	//Форма не предусмотрена для интерактивного показа пользователю
	Этаформа.Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьПереданныеСообщения() Экспорт //переданные в ВХ 
	
	СформироватьСчетаФактурыНаПодписание();
	СброситьПроверкиДанныхАвторизации();
	СпроситьНедостающиеСертификатыДляПодписиИПодписатьСчетаФактуры();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФоновыйРежим(Режим = Истина) Экспорт
	
	ФоновыйРежим = Режим;
	
КонецПроцедуры	

// Для перехода на версию 4.03.019.01

&НаКлиенте
Процедура ПроставитьСрокДействияСертификатов() Экспорт
	
	МассивСертификатовДляОбновления = ПолучитьМассивСертификатовДляОбновленияСервер();
	
	Для каждого Сертификат Из МассивСертификатовДляОбновления Цикл
		
		Если Сертификат.Расположение = "сервер" Тогда
			ДанныеАвторизацииСертификата = ПолучитьСтруктуруДанныхАвторизации();
			ДанныеАвторизацииСертификата.Отпечаток = Сертификат.Отпечаток;
			ДанныеАвторизацииСертификата.Расположение = Сертификат.Расположение;
			РеквизитыСертификата = ПолучитьРеквизитыСертификатаНаСервере(ДанныеАвторизацииСертификата);
		Иначе	
			РеквизитыСертификата = ПолучитьРеквизитыСертификатаНаКлиенте(Сертификат.Отпечаток);
		КонецЕсли;	
		
		Если РеквизитыСертификата = Неопределено Тогда
			// Не смогли прочитать реквизиты, попробуем в другой раз
			Возврат;
		КонецЕсли;
		Сертификат.СертификатДействуетПо = РеквизитыСертификата.ОкончаниеПериодаДействия;
	КонецЦикла;
	
	СохранитьСрокДействияСертификатовСервер(МассивСертификатовДляОбновления);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивСертификатовДляОбновленияСервер()
	
	МассивСертификатовДляОбновления = Новый Массив;
	
	ВсеСохраненныеСертификаты = МодульОбъекта().ПолучитьТаблицуСохраненныхСертификатов();
	НайденныеСтроки = ВсеСохраненныеСертификаты.НайтиСтроки(Новый Структура("СертификатДействуетПо", Дата(1, 1, 1)));
	
	Для каждого Строка Из НайденныеСтроки Цикл
		
		СертификатСтруктура = Новый Структура("Ссылка, Отпечаток, Расположение, СертификатДействуетПо", 
		Строка.Ссылка, 
		Строка.Отпечаток,
		Строка.Расположение,
		Строка.СертификатДействуетПо);
		МассивСертификатовДляОбновления.Добавить(СертификатСтруктура);
		
	КонецЦикла;
	
	Возврат МассивСертификатовДляОбновления;
	
КонецФункции // ПолучитьМассивСертификатовДляСохраненияСервер()

&НаСервере
Процедура СохранитьСрокДействияСертификатовСервер(МассивСертификатовДляОбновления)
	
	Для каждого Сертификат Из МассивСертификатовДляОбновления Цикл
		
		МодульОбъекта().ЗаписатьДопРеквизитСправочника_КонтурEDI(Сертификат.Ссылка, "СертификатДействуетПо", Сертификат.СертификатДействуетПо);
		
	КонецЦикла;
	
	МодульОбъекта().УстановитьКонстантуEDI("СрокДействияСертификатовПроставлен", Истина);
	
КонецПроцедуры

// Для перехода на версию 4.03.019.01


//Вспомогательные
&НаСервере
Процедура СформироватьСчетаФактурыНаПодписание()
	
	//соберем идентификаторы СФ которые будем подписывать
	СчетаФактурыНаПодписание.Загрузить(МодульОбъекта().ПолучитьТаблицуСчетовФактурНаПодписание(МодульОбъекта().ИзвлечьИзВХ("Диадок_МассивСообщенийДляПодписания")));
	ЗаполнитьТаблицуАвторизацииПоУмолчанию();
	
КонецПроцедуры

&НаКлиенте
Процедура СпроситьНедостающиеСертификатыДляПодписиИПодписатьСчетаФактуры() //возможен неоднократный вызов для простановки сертифткатов
	
	ТекОрганизация = Неопределено;
	
	Для Каждого СтрокаСЧФ Из СчетаФактурыНаПодписание Цикл // СчетаФактурыНаПодписание отсортированы по Организации в методе ПолучитьТаблицуСчетовФактурНаПодписание
		
		Если СобытиеСертификаты_НазначитьСертификат(СтрокаСЧФ).Переопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекОрганизация <> СтрокаСЧФ.Организация Тогда
			
			ТекОрганизация = СтрокаСЧФ.Организация;
			ИнициализироватьДанныеАвторизации(ТекОрганизация);
			ОбновитьДанныеАвторизации("ТипАвторизации", "Сертификат"); 
			
			Если ПропускСертификатаПоОрганизации(ТекОрганизация) Тогда
				// по какой-то причине не удалось выбрать сертификат или не прошли проверку с сертификатом
				Продолжить; 
			КонецЕсли;
			
			Если НЕ МожемПодписатьДокументыСертификатом(ТекОрганизация, ДанныеАвторизации, "СпроситьНедостающиеСертификатыДляПодписиИПодписатьСчетаФактуры()") Тогда
				Возврат;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	// Все сертификаты выбраны (или не выбраны, если пользователь отказался выбирать)
	
	ПодписатьСчетаФактуры();
	СброситьПарольКонтейнераДанныхАвторизации();
	
КонецПроцедуры

&НаКлиенте
Функция СобытиеСертификаты_НазначитьСертификат(СтрокаСчетаФактурыНаПодписание)
	
	Результат = Новый Структура;
	Результат.Вставить("Организация", СтрокаСчетаФактурыНаПодписание.Организация);
	Результат.Вставить("СообщениеСсылка", СтрокаСчетаФактурыНаПодписание.Ссылка);
	Результат.Вставить("Сертификат", Новый Структура("Отпечаток, Расположение, Пароль",, "клиент", ""));
	Результат.Вставить("Доверенность", Новый Структура("РегистрационныйНомер, Доверитель, ИспользоватьПоУмолчанию",,, Ложь));
	Результат.Вставить("ДвоичныеДанныеДоверенности", Неопределено); 
	Результат.Вставить("ДвоичныеДанныеПодписи", Неопределено);
	
	СтандартнаяОбработкаEDI = Истина;
	ОсновнаяФорма().ОбработкаСобытияПодключаемогоМодуляКлиент("Сертификаты_НазначитьСертификат", СтандартнаяОбработкаEDI, Результат);
	
	Результат.Вставить("Переопределено", СтандартнаяОбработкаEDI = Ложь);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция МожемПодписатьДокументыСертификатом(Организация, ДанныеАвторизации, ФинальныйОбработчик)
	
	Если НЕ СертификатПоОрганизацииНазначен(Организация) Тогда 
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ОбъектПараметрыКлиентСервер", Объект.ПараметрыКлиентСервер);
		ПараметрыФормы.Вставить("Организация", Организация);
		ПараметрыФормы.Вставить("ПоказыватьФлагЗапомнитьВыбор", Истина);
		
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("Действие", 				"ВыборСертификата");
		ДопПараметры.Вставить("Организация", 			Организация);
		ДопПараметры.Вставить("Отпечаток",   			"");
		ДопПараметры.Вставить("Расположение",   		"");
		ДопПараметры.Вставить("СертификатДействуетПо",  Дата(1, 1, 1));
		ДопПараметры.Вставить("ЗапомнитьВыбор", 		Ложь);
		ДопПараметры.Вставить("НомерПопытки", 			1);
		ДопПараметры.Вставить("Успешно", 				Ложь);
		ДопПараметры.Вставить("ОписаниеОшибки", 		"");
		ДопПараметры.Вставить("ФинальныйОбработчик", 	ФинальныйОбработчик);
		ДопПараметры.Вставить("ИгнорируемыеОшибкиДоверенности", "");
		
		ПараметрыФормы.Вставить("ДопПараметры", ДопПараметры); 
		
		Если Не ФоновыйРежим Тогда
			МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI("ФормаВыбора_СертификатДоверенность_Управляемая", , ПараметрыФормы, ЭтаФорма, "ПослеВыбораСертификатДоверенность", ЭтаФорма, ДопПараметры);
		КонецЕсли;
		
		Возврат Ложь; //не готовы подписывать, сначала надо выбрать сертификат
		
	ИначеЕсли ДанныеАвторизации.СертификатПроверен = Ложь Тогда
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("Действие",	 			"ПроверкаПодписания");
		ДопПараметры.Вставить("Организация", 			ДанныеАвторизации.Организация);
		ДопПараметры.Вставить("Отпечаток",   			ДанныеАвторизации.Отпечаток);
		ДопПараметры.Вставить("Расположение",   		ДанныеАвторизации.Расположение);
		ДопПараметры.Вставить("СертификатДействуетПо",  ДанныеАвторизации.СертификатДействуетПо);
		ДопПараметры.Вставить("ЗапомнитьВыбор", 		Ложь);
		ДопПараметры.Вставить("НомерПопытки", 			1);
		ДопПараметры.Вставить("Успешно", 				Ложь);
		ДопПараметры.Вставить("ОписаниеОшибки", 		"");
		ДопПараметры.Вставить("ФинальныйОбработчик", 	ФинальныйОбработчик);
		ДопПараметры.Вставить("Доверенность", 			ДанныеАвторизации.Доверенность);
		ДопПараметры.Вставить("СвойстваСертификата", 	ДанныеАвторизации.СвойстваСертификата);
		ДопПараметры.Вставить("ИгнорируемыеОшибкиДоверенности", ДанныеАвторизации.ИгнорируемыеОшибкиДоверенности);
		
		ОбработчикВыбораСертификата(ДанныеАвторизации.ПарольКонтейнера, ДопПараметры);
		
		Возврат Ложь; //не готовы подписывать, сначала надо проверить сертификат
		
	ИначеЕсли ЗначениеЗаполнено(ДанныеАвторизации.Доверенность) И НЕ ДанныеАвторизации.ВалидацияДоверенностиПройдена Тогда
		
		Возврат Ложь; //не готовы подписывать, доверенность не прошла валидацию		
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции 

&НаКлиенте
Процедура ПослеВыбораСертификатДоверенность(ВыбранноеЗначение, ДополнительныеПараметры = Неопределено) Экспорт 
	
	Если ВыбранноеЗначение <> Неопределено Тогда
		
		ОбработчикВыбораСертификата(ВыбранноеЗначение.ФинальныйОбработчик, ВыбранноеЗначение);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВыбораСертификата(ВыбранноеЗначение, ДопПараметры) Экспорт
	
	Если ДопПараметры.Действие = "ВыборСертификата" Тогда
		
		Если ВыбранноеЗначение = Неопределено Тогда
			
			// пользователь отказался от выбора сертификата
			ОбновитьДанныеАвторизации("СертификатПроверен", 			Истина);
			ОбновитьДанныеАвторизации("ВалидацияСертификатаПройдена", 	Ложь);
			ДопПараметры.Вставить("ОписаниеОшибки", "Выбор сертификата отменен");
			ВыполнитьКомандуФинальногоОбработчикаВыбораСертификата(ДопПараметры.ФинальныйОбработчик, ДопПараметры);
			
		Иначе
			
			ИнициализироватьДанныеАвторизации(ВыбранноеЗначение.Организация);
			СброситьДанныеАвторизацииСертификата();
			
			ОбновитьДанныеАвторизации("ТипАвторизации", "Сертификат"); 
			ОбновитьДанныеАвторизации("Расположение", ВыбранноеЗначение.Расположение);
			
			ДопПараметры.Вставить("Действие",				"ПроверкаПодписания");
			ДопПараметры.Вставить("Организация",  			ВыбранноеЗначение.Организация);
			ДопПараметры.Вставить("Отпечаток",  			ВыбранноеЗначение.Отпечаток);
			ДопПараметры.Вставить("Расположение",  			ВыбранноеЗначение.Расположение);
			ДопПараметры.Вставить("СертификатДействуетПо",  ВыбранноеЗначение.СертификатДействуетПо);
			ДопПараметры.Вставить("ЗапомнитьВыбор", 		ВыбранноеЗначение.ЗапомнитьВыбор);
			ДопПараметры.Вставить("НомерПопытки", 			1);
			ДопПараметры.Вставить("Успешно", 				Ложь);
			ДопПараметры.Вставить("ОписаниеОшибки", 		"");
			ДопПараметры.Вставить("РеквизитыСертификата", 	ВыбранноеЗначение.РеквизитыСертификата); 
			
			ОбработчикВыбораСертификата(ДанныеАвторизации.ПарольКонтейнера, ДопПараметры);
			
			Возврат;
			
		КонецЕсли;
		
	ИначеЕсли ДопПараметры.Действие = "ПроверкаПодписания" Тогда
		
		Если ВыбранноеЗначение = Неопределено Тогда
			
			// пользователь отказался от выбора сертификата
			ОбновитьДанныеАвторизации("СертификатПроверен", 			Истина);
			ОбновитьДанныеАвторизации("ВалидацияСертификатаПройдена", 	Ложь);
			ДопПараметры.Вставить("ОписаниеОшибки", "Ввод пароля отменен");
			ВыполнитьКомандуФинальногоОбработчикаВыбораСертификата(ДопПараметры.ФинальныйОбработчик, ДопПараметры);
			
		Иначе
			
			ОбработчикПроверкиПодписанияСертификатом(ВыбранноеЗначение, ДопПараметры);
			
			Возврат;
			
		КонецЕсли;
		
	ИначеЕсли ДопПараметры.Действие = "ПовторныйВыборСертификата" Тогда
		
		// выбор сертификата завершился ошибкой, предложим выбрать еще раз
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ОбъектПараметрыКлиентСервер", 	Объект.ПараметрыКлиентСервер);
		ПараметрыФормы.Вставить("Организация", 					ДопПараметры.Организация);
		
		РеквизитыСертификата = Неопределено;
		ДопПараметры.Свойство("РеквизитыСертификата", РеквизитыСертификата);
		ПараметрыФормы.Вставить("Сертификат", 					РеквизитыСертификата);
		
		Если Найти(ДопПараметры.ФинальныйОбработчик, "СпроситьНедостающиеСертификатыДляПодписиИПодписатьСчетаФактуры()") > 0 Тогда
			ПараметрыФормы.Вставить("ПоказыватьФлагЗапомнитьВыбор", Истина);
		КонецЕсли;
		
		ДопПараметры.Вставить("Действие", 				"ВыборСертификата");
		ДопПараметры.Вставить("НомерПопытки", 			1);
		
		МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI("Сертификаты_СписокУправляемая", , ПараметрыФормы, ЭтаФорма, "ОбработчикВыбораСертификата", ЭтаФорма, ДопПараметры);
		
		Возврат;
		
	ИначеЕсли ДопПараметры.Действие = "ПроверкаСертификатаВФНС" Тогда
		
		ОбработчикПроверкиСертификатаВФНС(ДопПараметры);
		Возврат;
		
	ИначеЕсли ДопПараметры.Действие = "ПроверкаНеобходимостиМЧД" Тогда
		
		ОбработчикПроверкиНеобходимостиМЧД(ДопПараметры);
		Возврат;
		
	ИначеЕсли ДопПараметры.Действие = "ВыборМЧД" Тогда
		
		ОбработчикВыбораМЧД(ДопПараметры);
		Возврат;
		
	ИначеЕсли ДопПараметры.Действие = "ВалидацияМЧД" Тогда
		
		ОбработчикВалидацииМЧД(ВыбранноеЗначение, ДопПараметры);
		Возврат;		
		
	ИначеЕсли ДопПараметры.Действие = "ЗавершениеПроверки" Тогда
		
		Если ЗначениеЗаполнено(ДанныеАвторизации.Доверенность) И Не ДанныеАвторизации.ВалидацияДоверенностиПройдена
			И ДопПараметры.Свойство("ОшибкиДоверенности") И ДопПараметры.ОшибкиДоверенности = ДопПараметры.ИгнорируемыеОшибкиДоверенности Тогда
			ОбновитьДанныеАвторизации("ВалидацияДоверенностиПройдена", Истина);
		КонецЕсли;	
		
		ВыполнитьКомандуФинальногоОбработчикаВыбораСертификата(ДопПараметры.ФинальныйОбработчик, ДопПараметры);
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Функция ДоверенностьПоУмолчанию(ДанныеАвторизации) Экспорт
	
	ИдентификаторОрганизацииДиадок = ИдентификаторОрганизацииДиадок_Сервер(ДанныеАвторизации);
	ИдентификаторЯщикаДиадок = ИдентификаторЯщикаДиадок(ДанныеАвторизации, ИдентификаторОрганизацииДиадок);               
	ИдентификаторПользователя = ОписаниеПользователяДиадок(ДанныеАвторизации).UserId;
	
	СписокДоверенностей = ПолучитьСписокМЧДСотрудника(ДанныеАвторизации, ИдентификаторЯщикаДиадок, ИдентификаторПользователя);
	
	Для Каждого СтруктураДоверенности Из СписокДоверенностей Цикл 
		Если СтруктураДоверенности.ПоУмолчанию = Истина Тогда
			Возврат СтруктураДоверенности.МашиночитаемаяДоверенность;
		КонецЕсли;		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Процедура ОбработчикВыбораМЧД(ДопПараметры) Экспорт
	
	ИдентификаторОрганизацииДиадок = ИдентификаторОрганизацииДиадок_Сервер(ДанныеАвторизации);
	ИдентификаторЯщикаДиадок = ИдентификаторЯщикаДиадок(ДанныеАвторизации, ИдентификаторОрганизацииДиадок);               
	ИдентификаторПользователя = ОписаниеПользователяДиадок(ДанныеАвторизации).UserId;
	
	СписокДоверенностей = ПолучитьСписокМЧДСотрудника(ДанныеАвторизации, ИдентификаторЯщикаДиадок, ИдентификаторПользователя);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СписокДоверенностей", СписокДоверенностей);
	ПараметрыФормы.Вставить("ДанныеАвторизации", ДанныеАвторизации);
	ПараметрыФормы.Вставить("ИдентификаторОрганизацииДиадок", ИдентификаторОрганизацииДиадок);
	ПараметрыФормы.Вставить("ИдентификаторЯщикаДиадок", ИдентификаторЯщикаДиадок);
	ПараметрыФормы.Вставить("ИдентификаторПользователя", ИдентификаторПользователя);
	ПараметрыФормы.Вставить("ОбъектПараметрыКлиентСервер", Объект.ПараметрыКлиентСервер);
	
	Если ДопПараметры.Свойство("РеквизитыСертификата") Тогда
		ПараметрыФормы.Вставить("РеквизитыСертификата", ДопПараметры.РеквизитыСертификата);
	КонецЕсли;
	
	Если ДопПараметры.Свойство("Контекст") И ДопПараметры.Контекст = "ФормаВыбора" Тогда
		ПараметрыФормы.Вставить("Контекст", "ФормаВыбора");
	КонецЕсли;
	
	МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI("ДоверенностиСписок_Управляемая", , ПараметрыФормы, ЭтаФорма, "ОбработчикВалидацииМЧД", ЭтаФорма, ДопПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВалидацииМЧД(Доверенность, ДопПараметры) Экспорт
	
	ДопПараметры.Вставить("Доверенность", Доверенность);	
	
	ПараметрыКонтекста = Новый Структура;
	ПараметрыКонтекста.Вставить("Доверенность", Доверенность);
	ПараметрыКонтекста.Вставить("ОшибкиДоверенности", "");
	ПараметрыКонтекста.Вставить("ДопПараметры", ДопПараметры);
	
	Если Доверенность = Неопределено Тогда
		Оповестить("ПослеВыбораДоверенности", ПараметрыКонтекста, ЭтаФорма); 
		Возврат;
	КонецЕсли;
	
	ИдентификаторОрганизацииДиадок = ИдентификаторОрганизацииДиадок_Сервер(ДанныеАвторизации);
	ИдентификаторЯщикаДиадок = ИдентификаторЯщикаДиадок(ДанныеАвторизации, ИдентификаторОрганизацииДиадок); 
		
	РезультатПроверкиМашиночитаемойДоверенности = ПредварительнаяПроверкаМЧД(ДанныеАвторизации, ИдентификаторЯщикаДиадок, Доверенность.СоставнойИдентификатор, Неопределено);

	Ошибки = ОшибкиВалидацииМЧД(РезультатПроверкиМашиночитаемойДоверенности);
	
	Если Не ПустаяСтрока(Ошибки) Тогда
		
		ПараметрыКонтекста.Вставить("ОшибкиДоверенности", Ошибки);
		
		ОбновитьДанныеАвторизации("ВалидацияДоверенностиПройдена", Ошибки = ДопПараметры.ИгнорируемыеОшибкиДоверенности);
		
		ДопПараметры.Вставить("ОшибкиДоверенности", Ошибки);
		
	Иначе
		
		ОбновитьДанныеАвторизации("ВалидацияДоверенностиПройдена", Истина);
		
		ДопПараметры.Вставить("ОшибкиДоверенности", "");
		
	КонецЕсли;
	
	ОбновитьДанныеАвторизации("Доверенность", Доверенность);		
	Оповестить("ПослеВыбораДоверенности", ПараметрыКонтекста, ЭтаФорма); 
	
	ФормаОткрыта = ДопПараметры.Свойство("Форма_СертификатыДоверенности_Открыта") И ДопПараметры.Форма_СертификатыДоверенности_Открыта = Истина; 
	
	Если ДанныеАвторизации.ВалидацияДоверенностиПройдена И Не ФормаОткрыта Тогда
		ДопПараметры.Вставить("Действие", "ЗавершениеПроверки");
	Иначе
		ДопПараметры.Вставить("Действие", "ПроверкаНеобходимостиМЧД");	
	КонецЕсли;
	
	ОбработчикВыбораСертификата(Неопределено, ДопПараметры);
	
КонецПроцедуры

&НаКлиенте
Функция ОшибкиВалидацииМЧД(РезультатПроверкиМашиночитаемойДоверенности)
	
	Ошибки = "";
	
	ТекстОшибки = РезультатПроверкиМашиночитаемойДоверенности.СтатусПроверки.ОшибкаОперации.Текст;
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		Ошибки = " - " + ТекстОшибки + Символы.ПС;	
	КонецЕсли;	
	
	Если РезультатПроверкиМашиночитаемойДоверенности.СтатусПроверки.ПротоколВалидации.РезультатПроверкиВалидации.Количество() > 0 Тогда
		Для Каждого РезультатПроверкиВалидации Из РезультатПроверкиМашиночитаемойДоверенности.СтатусПроверки.ПротоколВалидации.РезультатПроверкиВалидации Цикл
			
			ТекстОшибки = РезультатПроверкиВалидации.Ошибка.Текст;
			Если Не ПустаяСтрока(ТекстОшибки) Тогда
				Ошибки = Ошибки + " - " + ТекстОшибки + Символы.ПС;	
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;	
	
	Если ПустаяСтрока(Ошибки) И РезультатПроверкиМашиночитаемойДоверенности.СтатусПроверки.Ошибки.Количество() > 0 Тогда
		
		ПараметрыФормы = Новый Структура;
		
		Для Каждого Ошибка Из РезультатПроверкиМашиночитаемойДоверенности.СтатусПроверки.Ошибки Цикл // устарело
			
			Ошибки = Ошибки + " - " + Ошибка.Текст + Символы.ПС;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Не ПустаяСтрока(Ошибки) Тогда
		
		Ошибки = РезультатПроверкиМашиночитаемойДоверенности.СтатусПроверки.ТекстСтатуса + "
		|
		|" + Ошибки;
		
	КонецЕсли;
	
	Возврат Ошибки;
	
КонецФункции

&НаКлиенте
Функция ПривязкаМЧДСотруднику(ДанныеАвторизации, ИдентификаторЯщика, ИдентификаторПользователя, СоставнойИдентификаторМЧД) Экспорт
	
	PowerOfAttorneyFullId = МодульОбъектаКлиент().КонтурДиадокAPI_Привести("PowerOfAttorneyFullId", СоставнойИдентификаторМЧД);
	
	ДанныеАвторизацииДиадок = МодульОбъектаКлиент().ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизации);
	Результат = МодульОбъектаКлиент().КонтурДиадокAPI_ПривязатьСотрудникаКДоверенности(ДанныеАвторизацииДиадок, ИдентификаторЯщика, ИдентификаторПользователя, PowerOfAttorneyFullId, Истина);
	
	Возврат Результат;
		
КонецФункции

&НаКлиенте
Функция ЗарегистрироватьДоверенность(ДанныеАвторизации, ИдентификаторЯщика, МашиночитаемаяДоверенностьДляРегистрации) Экспорт
	
	PowerOfAttorneyToRegister = МодульОбъектаКлиент().КонтурДиадокAPI_Привести("PowerOfAttorneyToRegister", МашиночитаемаяДоверенностьДляРегистрации);
	
	ДанныеАвторизацииДиадок = МодульОбъектаКлиент().ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизации);
	Результат = МодульОбъектаКлиент().КонтурДиадокAPI_ЗарегистрироватьДоверенность(ДанныеАвторизацииДиадок, ИдентификаторЯщика, PowerOfAttorneyToRegister, Истина);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПроверитьРегистрациюДоверенности(ДанныеАвторизации, ИдентификаторЯщика, TaskId) Экспорт
	
	ДанныеАвторизацииДиадок = МодульОбъектаКлиент().ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизации);
	Результат = МодульОбъектаКлиент().КонтурДиадокAPI_ПроверитьРегистрациюДоверенности(ДанныеАвторизацииДиадок, ИдентификаторЯщика, TaskId, Истина);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПредварительнаяПроверкаМЧД(ДанныеАвторизации, ИдентификаторЯщика, СоставнойИдентификаторМЧД, Сертификат) Экспорт
	
	СоставнойИдентификатор = МодульОбъектаКлиент().КонтурДиадокAPI_Привести("PowerOfAttorneyFullId", СоставнойИдентификаторМЧД); 
	ДанныеАвторизацииДиадок = МодульОбъектаКлиент().ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизации);
	
	РезультатПроверкиМашиночитаемойДоверенности = МодульОбъектаКлиент().КонтурДиадокAPI_ПредварительнаяПроверкаДоверенности(ДанныеАвторизацииДиадок, ИдентификаторЯщика, СоставнойИдентификатор, ДанныеАвторизацииДиадок.Отпечаток, Истина);

	Возврат РезультатПроверкиМашиночитаемойДоверенности;
	
КонецФункции

&НаКлиенте
Функция ПолучитьСписокМЧДСотрудника(ДанныеАвторизации, ИдентификаторЯщикаДиадок, ИдентификаторПользователя, ТолькоАктуальные = Истина) Экспорт
	     
	ДанныеАвторизацииДиадок = МодульОбъектаКлиент().ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизации);
	СписокМЧДСотрудника = МодульОбъектаКлиент().КонтурДиадокAPI_ДоверенностиПользователя(ДанныеАвторизацииДиадок, ИдентификаторЯщикаДиадок, ИдентификаторПользователя, ТолькоАктуальные, Истина);
	
	МашиночитаемыеДоверенностиСотрудника = СписокМЧДСотрудника.МашиночитаемыеДоверенности;
	
	Для Каждого ТекущаяМЧД Из МашиночитаемыеДоверенностиСотрудника Цикл
		МашиночитаемаяДоверенностьСотрудника = ТекущаяМЧД.МашиночитаемаяДоверенность;
		МашиночитаемаяДоверенностьСотрудника.ДатаНачала = МодульОбъектаКлиент().КонтурСтандарт_Ticks_to_Date(МашиночитаемаяДоверенностьСотрудника.ДатаНачала.КоличествоТиков); 	
		МашиночитаемаяДоверенностьСотрудника.СрокДействия = МодульОбъектаКлиент().КонтурСтандарт_Ticks_to_Date(МашиночитаемаяДоверенностьСотрудника.СрокДействия.КоличествоТиков); 				
	КонецЦикла;
	
	Возврат МашиночитаемыеДоверенностиСотрудника;
	
КонецФункции

Функция ПеременнаяСодержитСвойство(Переменная, ИмяСвойства, Свойство = Неопределено, СвойствоЗаполнено = Ложь) Экспорт
	
	GUIDПроверка = Новый УникальныйИдентификатор;
	
	СтруктураПроверка = Новый Структура;
	СтруктураПроверка.Вставить(ИмяСвойства, GUIDПроверка);
	
	ЗаполнитьЗначенияСвойств(СтруктураПроверка, Переменная);
	
	
	Если СтруктураПроверка[ИмяСвойства] = GUIDПроверка Тогда
		
		Возврат Ложь;
		
	Иначе
		
		Свойство = Переменная[ИмяСвойства];
		
		Если СвойствоЗаполнено = Истина Тогда
			
			Возврат ЗначениеЗаполнено(Свойство);
			
		Иначе
			
			Возврат Истина;
			
		КонецЕсли;
		
	КонецЕсли;		
	
КонецФункции

&НаКлиенте
Функция TimeStampToDate(TimeStamp)
	Возврат Дата('00010101')+ TimeStamp / 10000000;
КонецФункции

&НаКлиенте
Функция Новый_Доверенность() Экспорт
	
	Новый_Доверенность = Новый Структура;
	Новый_Доверенность.Вставить("Идентификатор");
	Новый_Доверенность.Вставить("НаименованиеОрганизации");
	Новый_Доверенность.Вставить("ИННОрганизации");
	Новый_Доверенность.Вставить("КППОрганизации");
	Новый_Доверенность.Вставить("ДатаВыдачи");
	Новый_Доверенность.Вставить("СрокДействия");
	Новый_Доверенность.Вставить("ДоверенноеЛицоФамилия");
	Новый_Доверенность.Вставить("ДоверенноеЛицоИмя");
	Новый_Доверенность.Вставить("ДоверенноеЛицоОтчество");
	Новый_Доверенность.Вставить("ДоверенноеЛицоФИО");  
	
	Новый_Доверенность.Вставить("КраткоеПредставление");
	Новый_Доверенность.Вставить("ПолноеПредставление"); 
	
	Новый_Доверенность.Вставить("ДвоичныеДанныеДоверенности");
	Новый_Доверенность.Вставить("ДвоичныеДанныеПодписи");
	
	Возврат Новый_Доверенность;
	
КонецФункции

&НаКлиенте
Процедура ОбработчикПроверкиНеобходимостиМЧД(ДопПараметры)
	
	ПараметрыКонтекста = Новый Структура;
	ПараметрыКонтекста.Вставить("ДопПараметры");	
	ПараметрыКонтекста.Вставить("Доверенность");
	ПараметрыКонтекста.Вставить("ТребуетсяДоверенность");
	ПараметрыКонтекста.Вставить("Сертификат");	
	
	Если ДанныеАвторизации.Расположение = "сервер" Тогда
		РеквизитыСертификата = ПолучитьРеквизитыСертификатаНаСервере(ДанныеАвторизации);
	Иначе	
		РеквизитыСертификата = ПолучитьРеквизитыСертификатаНаКлиенте(ДанныеАвторизации.Отпечаток);
	КонецЕсли;
	
	ПараметрыКонтекста.Сертификат = РеквизитыСертификата;
	
	ДоверенностьНазначена = Ложь;
	
	Если ДопПараметры.Свойство("Доверенность") И ЗначениеЗаполнено(ДопПараметры.Доверенность) Тогда
		ПараметрыКонтекста.Доверенность = ДопПараметры.Доверенность;
		ДоверенностьНазначена = Истина;
	КонецЕсли;
	
	ТребуетсяДоверенность = ДляСертификатаНеобходимаДоверенность(ДанныеАвторизации);
	
	ПараметрыКонтекста.ТребуетсяДоверенность = ТребуетсяДоверенность;
	ПараметрыКонтекста.ДопПараметры = ДопПараметры;
	
	Если НЕ ДоверенностьНазначена И ТребуетсяДоверенность = Истина Тогда
		ДоверенностьПоУмолчанию = ДоверенностьПоУмолчанию(ДанныеАвторизации);
		Если ДоверенностьПоУмолчанию <> Неопределено Тогда
			ДопПараметры.Вставить("Доверенность", ДоверенностьПоУмолчанию);
			ОбновитьДанныеАвторизации("Доверенность", ДоверенностьПоУмолчанию);
			ПараметрыКонтекста.Доверенность = ДопПараметры.Доверенность;
			
			ДопПараметры.Вставить("Действие",	"ВалидацияМЧД");		
			ОбработчикВыбораСертификата(ДоверенностьПоУмолчанию, ДопПараметры);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	
	ФормаОткрыта = ДопПараметры.Свойство("Форма_СертификатыДоверенности_Открыта") И ДопПараметры.Форма_СертификатыДоверенности_Открыта = Истина; 
	НадоОткрытьФорму = (ДопПараметры.Свойство("Контекст") И ДопПараметры.Контекст = "Форма_ОбщиеНастройки") 
	ИЛИ (НЕ ДоверенностьНазначена И ТребуетсяДоверенность <> Ложь И ДоверенностьПоУмолчанию = Неопределено)
	ИЛИ (ДоверенностьНазначена И НЕ ДанныеАвторизации.ВалидацияДоверенностиПройдена);
	
	Если ФормаОткрыта Тогда
		
		Оповестить("ПослеПроверкиСертификата", ПараметрыКонтекста, ЭтаФорма);
		
	ИначеЕсли НадоОткрытьФорму И Не ФоновыйРежим Тогда 
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ОбъектПараметрыКлиентСервер", 	Объект.ПараметрыКлиентСервер);
		ПараметрыФормы.Вставить("Организация", 					ДанныеАвторизации.Организация);
		ПараметрыФормы.Вставить("ПоказыватьФлагЗапомнитьВыбор", Истина);
		ПараметрыФормы.Вставить("Сертификат", 					РеквизитыСертификата);
		ПараметрыФормы.Вставить("ТребуетсяДоверенность", 		ПараметрыКонтекста.ТребуетсяДоверенность);
		ПараметрыФормы.Вставить("Доверенность", 				ПараметрыКонтекста.Доверенность);
		
		ПараметрыФормы.Вставить("ДопПараметры", 				ДопПараметры); 
		
		Если ДопПараметры.Свойство("ОшибкиДоверенности") Тогда
			ПараметрыФормы.Вставить("ОшибкиДоверенности", 		ДопПараметры.ОшибкиДоверенности);
		КонецЕсли;	
		
		МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI("ФормаВыбора_СертификатДоверенность_Управляемая", , ПараметрыФормы, ЭтаФорма, "ПослеВыбораСертификатДоверенность", ЭтаФорма, ДопПараметры);
		
		Оповестить("ПослеПроверкиСертификата", ПараметрыКонтекста, ЭтаФорма);
		
	Иначе
		ДопПараметры.Вставить("Действие", "ЗавершениеПроверки");		
		ОбработчикВыбораСертификата(Неопределено, ДопПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СертификатКвалифицированный(ДанныеАвторизации) Экспорт
	
	Результат = Неопределено;
	ДанныеАвторизацииДиадок = МодульОбъектаКлиент().ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизации);
	
	Попытка
		ИдентификаторОрганизацииДиадок = ИдентификаторОрганизацииДиадок_Сервер(ДанныеАвторизации);
		ИдентификаторЯщикаДиадок = ИдентификаторЯщикаДиадок(ДанныеАвторизации, ИдентификаторОрганизацииДиадок);
		Ответ = МодульОбъектаКлиент().КонтурДиадокAPI_ПроверкаКвалифицированностиСертификата(ДанныеАвторизацииДиадок, ИдентификаторЯщикаДиадок, ДанныеАвторизацииДиадок.Отпечаток);	
		Результат = Ответ.IsValid;	
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		ТекстСообщения = МодульОбъектаКлиент().КонтурСтандарт_СтрШаблон_("По организации ""%1"" не удалось проверить сертификат на квалифицированность по причине:%2%3", Строка(ДанныеАвторизации.Организация), Символы.ПС, ОписаниеОшибки);		
		МодульОбъектаКлиент().СообщениеПользователю_КонтурEDI(ТекстСообщения, УникальныйИдентификатор);
	КонецПопытки;
		
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ДляСертификатаНеобходимаДоверенность(ДанныеАвторизации) Экспорт
	
	Результат = Ложь;
	
	ИдентификаторОрганизацииДиадок = ИдентификаторОрганизацииДиадок_Сервер(ДанныеАвторизации);
	ИдентификаторЯщикаДиадок = ИдентификаторЯщикаДиадок(ДанныеАвторизации, ИдентификаторОрганизацииДиадок);
	
	Попытка
		ДанныеАвторизацииДиадок = МодульОбъектаКлиент().ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизации);
		СертификатыДиадок = МодульОбъектаКлиент().КонтурДиадокAPI_ИнформацияОСертификатах(ДанныеАвторизацииДиадок, ИдентификаторЯщикаДиадок);
	Исключение
		_ОписаниеОшибки = ОписаниеОшибки();
		ТекстСообщения = "Не удалось получить информацию о необходимости доверенности для сертификата по причине: 
		|" + _ОписаниеОшибки;
		МодульОбъектаКлиент().СообщениеПользователю_КонтурEDI(ТекстСообщения);
		
		Возврат "Неопределено"; // внимание, функция возвращает не только булево 
		
	КонецПопытки;

	DiadocOrgInn = ПолучитьЗначениеСвойстваОбъектаEDI_Сервер(ДанныеАвторизации.Организация, "DiadocOrgInn");
	
	Для Каждого СертификатДиадок Из СертификатыДиадок.Certificates Цикл
		
		Результат = (Врег(ДанныеАвторизации.Отпечаток) = Врег(СертификатДиадок.Thumbprint) И СертификатДиадок.Inn <> DiadocOrgInn);
		
		Если Результат Тогда
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбработчикПроверкиСертификатаВФНС(ДопПараметры)
	
	ДанныеАвторизацииДиадок = МодульОбъектаКлиент().ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизации);
	
	ИдентификаторОрганизацииДиадок = ИдентификаторОрганизацииДиадок_Сервер(ДанныеАвторизации);
	ИдентификаторЯщикаДиадок = ИдентификаторЯщикаДиадок(ДанныеАвторизации, ИдентификаторОрганизацииДиадок);
	
	Попытка
		РезультатПроверки = МодульОбъектаКлиент().КонтурДиадокAPI_СертификатИспользуетсяДляПодписания(ДанныеАвторизацииДиадок, ИдентификаторЯщикаДиадок, ДанныеАвторизацииДиадок.Отпечаток);
	Исключение       
		ОписаниеОшибки = ОписаниеОшибки();
		Если Найти(ОписаниеОшибки, "is not registered in FNS") > 0 Тогда
			Ответ = МодульОбъектаКлиент().КонтурДиадокAPI_ЗарегистрироватьСертификатФНС(ДанныеАвторизацииДиадок, ИдентификаторЯщикаДиадок, ДанныеАвторизацииДиадок.Отпечаток);
		КонецЕсли;
	КонецПопытки;
	
	// доверенность назначена	
	Если ДопПараметры.Свойство("Доверенность") И ЗначениеЗаполнено(ДопПараметры.Доверенность) Тогда
		
		ДопПараметры.Вставить("Действие",	"ВалидацияМЧД");		
		ОбработчикВыбораСертификата(ДопПараметры.Доверенность, ДопПараметры);
		
	Иначе
		
		ДопПараметры.Вставить("Действие",	"ПроверкаНеобходимостиМЧД");		
		ОбработчикВыбораСертификата(Неопределено, ДопПараметры);
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Функция ОписаниеПользователяДиадок(ДанныеАвторизации)     
   
	ДанныеАвторизацииДиадок = МодульОбъектаКлиент().ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизации);
	Результат = МодульОбъектаКлиент().КонтурДиадокAPI_ИнформацияТекущегоПользователя(ДанныеАвторизацииДиадок);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ИдентификаторЯщикаДиадок(ДанныеАвторизации, ИдентификаторОрганизацииДиадок)
	
	Организация = ДанныеАвторизации.Организация;	
	DiadocBoxId = ПолучитьЗначениеСвойстваОбъектаEDI_Сервер(Организация, "DiadocBoxId");
	
	Если НЕ ЗначениеЗаполнено(DiadocBoxId) Тогда
		
		ОписаниеОрганизации = ОписаниеОрганизацииДиадок(ДанныеАвторизации, ИдентификаторОрганизацииДиадок);
		DiadocBoxId = ОписаниеОрганизации.Boxes[0].BoxId;
		УстановитьЗначениеСвойстваОбъекта_Сервер(Организация, "DiadocBoxId", DiadocBoxId);		
		
	КонецЕсли;
	
	Возврат DiadocBoxId;	
	
КонецФункции


