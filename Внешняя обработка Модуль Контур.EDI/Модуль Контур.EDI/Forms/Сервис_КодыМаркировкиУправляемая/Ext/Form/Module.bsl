&НаКлиенте
Процедура КодыМаркировкиПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	Если ТолькоПросмотрКодов Тогда
		Возврат;
	КонецЕсли;

	СтрокиКУдалению = Новый Массив;
	
	ВыделенныеСтрокиКодыМаркировки = МодульОбъектаКлиент().ВыделенныеСтрокиТаблицыФормы_КонтурEDI(Элементы.КодыМаркировки);
		
	Для каждого ИдентификаторСтроки Из ВыделенныеСтрокиКодыМаркировки Цикл
		
		СтрокаДерева = КодыМаркировки.НайтиПоИдентификатору(ИдентификаторСтроки);
		
		Если СтрокаДерева.ПолучитьРодителя() = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиКУдалению.Добавить(СтрокаДерева);
		
	КонецЦикла;
	
	Если СтрокиКУдалению.Количество() > 0 Тогда
		
		КодыМаркировкиОтредактированыВручную = Истина;
		
	КонецЕсли;
	
	Для каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
		СтрокаКУдалению.ПолучитьРодителя().ПолучитьЭлементы().Удалить(СтрокаКУдалению);
	КонецЦикла;
	
	ВыделенныеСтрокиКодыМаркировки = МодульОбъектаКлиент().ВыделенныеСтрокиТаблицыФормы_КонтурEDI(Элементы.КодыМаркировки);	
	ВыделенныеСтрокиКодыМаркировки.Очистить();
	
КонецПроцедуры

