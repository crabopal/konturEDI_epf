Процедура ЗагрузитьИзДокумента1С(Команда)
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	ЗагрузитьИзДокумента1СНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьИзДокумента1СНаСервере()
	
	Если Не ЭтоАдресВременногоХранилища(АдресСообщения) Тогда
		Возврат;
	КонецЕсли;
	
	Сообщение = ПолучитьИзВременногоХранилища(АдресСообщения);
	КопияСообщения = МодульОбъекта().ПолучитьКопиюСообщения(Сообщение);
	
	МодульОбъекта().ДополнитьСообщениеКодамиМаркировки(КопияСообщения, Новый Структура);
	МодульОбъекта().ДозаполнитьАртикулКодПолноеНаименованиеВТаблицеТоваров(КопияСообщения.Товары);
	
	Если МодульОбъекта().ПеременнаяСодержитСвойство(КопияСообщения, "ТранспортныеУпаковки") Тогда
		ТранспортныеУпаковки = КопияСообщения.ТранспортныеУпаковки;
	Иначе
		ТранспортныеУпаковки = Новый ДеревоЗначений;
	КонецЕсли;
	
	ТаблицаКодов = МодульОбъекта().РазвернутаяТаблицаКодовМаркировки_КонтурEDI(КопияСообщения.Товары, ТранспортныеУпаковки, Истина, ИмяКолонкиКодовВСообщении);
	АдресКодовМаркировкиТоваров = ПоместитьВоВременноеХранилище(ТаблицаКодов, ЭтаФорма.УникальныйИдентификатор);
	
	ЗаполнитьДанныеФормы();	

	КодыМаркировкиОтредактированыВручную = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура КодыМаркировкиПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если Не ОтменаРедактирования Тогда
		КодыМаркировкиОтредактированыВручную = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьРасхождения(Команда)
	
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	АктивнаяСтрокаАналитики = Элементы.КодыМаркировки.ТекущиеДанные.ПолучитьРодителя();
	Если АктивнаяСтрокаАналитики = Неопределено Тогда
		АктивнаяСтрокаАналитики = Элементы.КодыМаркировки.ТекущиеДанные;
	КонецЕсли;
	
	НомерАктивнойСтроки = АктивнаяСтрокаАналитики.НомерСтроки;
	
	Кнопка = Элементы.КодыМаркировкиПоказыватьРасхождения;
	Кнопка.Пометка = Не Кнопка.Пометка;
	
	Если Кнопка.Пометка Тогда
		ВосстановитьДеревоИзХранилища(ДеревоРасхождений, НомерАктивнойСтроки);
	Иначе
		ВосстановитьДеревоИзХранилища(ДеревоВсехКодов, НомерАктивнойСтроки);
	КонецЕсли;
	
	РазвернутьДерево();
	
КонецПроцедуры
