&НаСервере
Процедура ВыполнитьДействиеДляИсправлениеОшибкиСообщения_Сервер(СтандартнаяОбработкаEDI, ИмяПоля, ТипСсылки, НомерСтроки = Неопределено, ТекстОшибки = Неопределено) Экспорт 
	
	СтандартнаяОбработкаEDI = Истина;
	
	МодульОбъекта().ОбработкаСобытияПодключаемогоМодуля("ВыполнитьДействиеДляИсправлениеОшибки", СтандартнаяОбработкаEDI, Новый Структура("ИмяПоля, ТипСсылки, КопияСообщения, ОригиналСообщения, ФормаСообщения", ИмяПоля, ТипСсылки, Сообщение, Сообщение, ЭтаФорма));
	
	Если Не СтандартнаяОбработкаEDI Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуПросмотраСоответствий(ДанныеСтроки)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Сообщение", Сообщение);
	
	Если Сообщение.Направление = "Входящее" Тогда
		ПараметрыФормы.Вставить("НаименованиеПартнера", ДанныеСтроки.Наименование);
		ИдентификаторыТовара = ПолучитьСтруктуруИдентификаторовТовара(ДанныеСтроки, Сообщение.ТипСообщения, КтоМы);
		ПараметрыФормы.Вставить("ИдентификаторыТовара", ИдентификаторыТовара);
	Иначе	
		ПараметрыФормы.Вставить("Документ1С", Документ1С);
		ПараметрыФормы.Вставить("Номенклатура", ДанныеСтроки.Номенклатура);
		ПараметрыФормы.Вставить("ХарактеристикаНоменклатуры", ДанныеСтроки.ХарактеристикаНоменклатуры);
		ПараметрыФормы.Вставить("ЕдиницаИзмерения", ДанныеСтроки.ЕдиницаИзмерения);
	КонецЕсли;
	
	Если Сообщение.Направление = "Исходящее" Тогда
		Обработчик = "ОбработчикПослеИсправленияОшибки"
	Иначе
		Обработчик = "ОбработчикПослеИнтерактивнойНастройкиСоответствий"
	КонецЕсли;
	
	МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI("СопоставлениеНоменклатурыИзКарточкиСообщенияУправляемая",, ПараметрыФормы, ЭтаФорма, Обработчик, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте                                             
Функция ВыполнитьДействиеДляИсправлениеОшибкиСообщения(ИмяПоля, ТипСсылки, НомерСтроки = Неопределено, ТекстОшибки = Неопределено) Экспорт
	
	СтандартнаяОбработкаEDI = Истина;
	
	ВыполнитьДействиеДляИсправлениеОшибкиСообщения_Сервер(СтандартнаяОбработкаEDI, ИмяПоля, ТипСсылки ,НомерСтроки, ТекстОшибки);
	
	Если Не СтандартнаяОбработкаEDI Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	//В УФ Неопределено //Для УФ эта клиентская функция определена в ФормаСообщенияУправляемая
	Если ТипСсылки = "КарточкаКонтрагента" Тогда
		
		Если ИмяПоля = "Грузополучатель1С" Тогда
			Если ЭтаФорма.Сообщение.ТипСообщения = "ORDERS" Тогда
				Если Найти(ТекстОшибки,"не указана связь с точкой доставк")>0 или Найти(ТекстОшибки,"не указана связь с юр.")>0 Тогда
					
					//Открыть форму ТД
					Состояние("Открываю точку доставки",75);
					
					ПараметрыФормы = Новый Структура;
					ПараметрыФормы.Вставить("СсылкаТочкиДоставки", ЭтаФорма.Сообщение.Грузополучатель1С);
					МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI("ТочкиДоставкиСторонние_ЭлементУправляемая", , ПараметрыФормы, ЭтаФорма, "ОбработчикРедактированияТочкиДоставкиСторонней", ЭтаФорма);
					
					Возврат Неопределено;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		//выше - была ТД но без соотв.
		
		//ниже - не было самой ТД
		Если Прав(ИмяПоля,3) = "EDI" Тогда
			ИмяПоляКонтрагента = Лев(ИмяПоля,СтрДлина(ИмяПоля)-3);
		ИначеЕсли Прав(ИмяПоля,2) = "1С" Тогда
			ИмяПоляКонтрагента = Лев(ИмяПоля,СтрДлина(ИмяПоля)-2);
		Иначе 
			ИмяПоляКонтрагента = ИмяПоля;
		КонецЕсли;
		
		//открыть форму контрагента для интерактивных действий пользователя
		ОткрытьФормуКонтрагента(ИмяПоляКонтрагента);
		
	ИначеЕсли ТипСсылки = "Документ1С" Тогда
		
		//Сообщение.ДокументСсылка.ПолучитьФорму().ОткрытьМодально();
		
	ИначеЕсли ТипСсылки = "НоменклатураСсылка" Тогда
		
		ДанныеСтроки = Товары[НомерСтроки - 1];
		ОткрытьФормуПросмотраСоответствий(ДанныеСтроки);
		
	ИначеЕсли ТипСсылки = "СоответствиеНоменклатуры" Тогда
		
		ДанныеСтроки = Товары[НомерСтроки - 1];
			
		ИдентификаторыТовара = ПолучитьСтруктуруИдентификаторовТовара(ДанныеСтроки, Сообщение.ТипСообщения, КтоМы);
		
		СписокВыбора = СоставитьСписокВыбораПоСтрокеТоваровСервер(
		ИдентификаторыТовара.GTIN,
		ИдентификаторыТовара.КодТовараПартнера,
		ИдентификаторыТовара.КодЕдиницыИзмеренияEDI,
		Отправитель1С); 
		
		Если Сообщение.Направление = "Входящее"
			И (СписокВыбора.Количество() = 1 И СписокВыбора.НайтиПоЗначению("Настроить соответствие товаров") <> Неопределено) Тогда
			
			ОткрытьНоменклатура_ЭлементУправляемая();
			
		Иначе
			
			ОткрытьФормуПросмотраСоответствий(ДанныеСтроки);
			
		КонецЕсли;
		
	ИначеЕсли ТипСсылки = "ДокументДиадок" Тогда
		
		ОткрытьЭлектронныеДокументыВВебДиадок(Сообщение.СообщениеСсылка, Документ1С);
		 
	ИначеЕсли ТипСсылки = "КодыМаркировки" Тогда
		
		ОткрытьФормуКодовМаркировки(0);
		
	ИначеЕсли ТипСсылки = "КодыМаркировкиВУпаковках" Тогда
		
		ОткрытьФормуРаспределенияКодовМаркировки();
		
	ИначеЕсли ТипСсылки = "ДоверенностиДокумента" Тогда
		
		ОткрытьФормуПросмотраДоверенностей();
		
	ИначеЕсли ТипСсылки = "ДокументУчетаМаркировка" Тогда
		
		ОткрытьФормуДокументаУчетаМаркировка();
		
	ИначеЕсли ТипСсылки = "СообщениеСОшибкой" Тогда 
		
		МодульОбъектаКлиент().Предупреждение_КонтурEDI(Сообщение.ОписаниеОшибки,,"Произошла ошибка чтения сообщения"); 
		
	КонецЕсли;
		
КонецФункции 

&НаКлиенте
Процедура ОткрытьСообщениеВМониторинге(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	СсылкаНаСообщениеВМониторинге = ПолучитьЗначениеДопРеквизитаСправочника_КонтурEDIНаСервере(Сообщение.СообщениеСсылка, "СсылкаНаСообщениеВМониторинге");

	Если ЗначениеЗаполнено(СсылкаНаСообщениеВМониторинге) Тогда
		
		ЗапуститьПриложение(СсылкаНаСообщениеВМониторинге);	
	
	Иначе
		
		ТекстПредупреждения = 	"Не удалось найти ссылку на данное сообщение в мониторинге.
								|Попробуйте зайти в мониторинг через ваш веб-браузер.";
		МодульОбъектаКлиент().Предупреждение_КонтурEDI(ТекстПредупреждения);
		
	КонецЕсли;	
	
КонецПроцедуры

