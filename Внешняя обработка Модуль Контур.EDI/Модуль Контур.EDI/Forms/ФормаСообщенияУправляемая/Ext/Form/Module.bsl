&НаСервере
Функция ПодготовитьСтруктуруИзмененныхРеквизитов()
	
	ИзмененныеРеквизиты = Новый Структура;
	
	Для Каждого ИзмененныйРеквизит Из ТаблицаИзмененныхРеквизитов Цикл
		ИзмененныеРеквизиты.Вставить(ИзмененныйРеквизит.Наименование, ИзмененныйРеквизит.Значение); 
	КонецЦикла;
	
	Возврат ИзмененныеРеквизиты;
	
КонецФункции

//пробегает по таблице значений Дубли и смотрит, были ли созданы по этим сообщениям документы
//если такой документ был создан, и в единственном экземпляре, то функция перепривяжет его к последнему сообщению
//а все остальные пометит как уже загруженные. В списке документов все равно будет светиться только одно из них
&НаСервере
Функция ПерепривязатьСообщенияИнтерактивно()
	
	ВосстановитьТаблицыЗначенийПроизвольныхРеквизитовИзХранилища();
	
	ПеренестиПоля1СвСообщение(Сообщение);
	МодульОбъекта().СохранитьСообщение(Сообщение);
	
	МодульОбъекта().МагическиОбработатьДублиORDERS(Сообщение,"НоваяВерсия",,Ложь);
	КопияСообщения = МодульОбъекта().ПрочитатьСообщение(Сообщение.СообщениеСсылка,,Сообщение.ТипСообщения,"Входящее");
	
	Если ЗначениеЗаполнено(КопияСообщения) Тогда
		
		КопияТоваров = Товары.Выгрузить();
		Сообщение = КопияСообщения;
		Сообщение.Документ1С = Сообщение.ДокументСсылка;
		ЗаполнитьПоляНаФорме();
		
		Товары.Загрузить(КопияТоваров);
		
		ПоместитьТаблицыЗначенийПроизвольныхРеквизитовВХранилище();
		УничтожитьТаблицыЗначенийПроизвольныхРеквизитов();
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция УдалитьВиртуальныеORDERS(ВиртуальныеORDERS)
	
	Если ВиртуальныеORDERS.Количество() <= 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		Для Каждого Стр Из ВиртуальныеORDERS Цикл
			
			Стр.Документ.ПолучитьОбъект().УстановитьПометкуУдаления(Истина);
			
			Если Стр.ЭтоТекущийДокумент Тогда
				СообщениеОбъект_ORDERS = МодульОбъекта().ПолучитьОбъектСообщения(Стр.ORDERS);
				СообщениеОбъект_ORDERS.Документ = Неопределено;
				МодульОбъекта().СохранитьОбъектСообщения(СообщениеОбъект_ORDERS);
			Иначе
				МодульОбъекта().УдалитьСообщение(Стр.ORDERS,,"#v");
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Стр.ORDRSP) Тогда
				МодульОбъекта().УдалитьСообщение(Стр.ORDRSP,,"#v");
			КонецЕсли;
			
		КонецЦикла;	
		Документ1С = Неопределено;
		Сообщение.Документ1С = Неопределено;
		Сообщение.ДокументСсылка = Неопределено;
		
		Если ТранзакцияАктивна() Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
		
	Исключение
		
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		
		ТекстОшибки = "Не удалось перезаполнить документ 1С - " + ОписаниеОшибки();
		МодульОбъекта().ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);
		МодульОбъекта().Сообщить_КонтурEDI(ТекстОшибки);
		ВызватьИсключение ТекстОшибки;				
		
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ПерезаполнитьДокумент1С(ПараметрыПерезаполнения = Неопределено)
	
	ВосстановитьТаблицыЗначенийПроизвольныхРеквизитовИзХранилища();
	
	ПеренестиПоля1СвСообщение(Сообщение);
	
	Если НЕ ЗначениеЗаполнено(Сообщение.ДокументСсылка) Тогда
		Сообщение.ДокументСсылка = Сообщение.Документ1С;
	КонецЕсли;
	
	Результат = ПерезаполнитьДокумент1С_ПереопределяемаяЧасть(ПараметрыПерезаполнения); 
	
	Если Результат.Успешно Тогда
		СообщениеОбъект = МодульОбъекта().ПолучитьОбъектСообщения(Сообщение.СообщениеСсылка);
		МодульОбъекта().СохранитьОбъектСообщения(СообщениеОбъект, Сообщение);
	КонецЕсли;
	
	ПоместитьТаблицыЗначенийПроизвольныхРеквизитовВХранилище();
	УничтожитьТаблицыЗначенийПроизвольныхРеквизитов();

	Если Результат.Успешно Тогда
		
		Если Сообщение.ТипСообщения = "ORDERS" Тогда
			МодульОбъекта().УстановитьСтатусСообщения(Сообщение.СообщениеСсылка,
													  Сообщение.ДокументСсылка,
													  Сообщение.ТипСообщения,
													  "ВходящийЗагружен");
		КонецЕсли;
		
	Иначе
		
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = "Не удалось перезаполнить документ!";
		СообщениеПользователю.Сообщить();
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Результат.Успешно;   
	
КонецФункции

&НаСервере
Функция ПерезаполнитьДокумент1С_ПереопределяемаяЧасть(ПараметрыПерезаполнения = Неопределено)
	
	Результат = Новый Структура("Успешно,ТекстОшибки", Истина, "");
	
	// ... вызов события пм
	СтандартнаяОбработкаEDI = Истина;
	
	ПараметрыПМ = 
	Новый Структура("Документ1С, Сообщение, Результат", Документ1С, Сообщение, Результат);
	
	МодульОбъекта().ОбработкаСобытияПодключаемогоМодуля("ПерезаполнитьДокумент1С", СтандартнаяОбработкаEDI, ПараметрыПМ);
	
	Если Не СтандартнаяОбработкаEDI = Истина Тогда
		
		Возврат Результат;
		
	КонецЕсли; 
	
	// ... стандартная обработка  	
	ПервоначальнаяЗагрузкаСообщения = Ложь;
	
	Если ЗначениеЗаполнено(Документ1С) Тогда
		
		Если ПараметрыПерезаполнения = Неопределено Тогда
			ВиртуальныеORDERS = МодульОбъекта().ПолучитьВиртуальныеСвязанныеORDERS(Документ1С);
		Иначе
			ВиртуальныеORDERS = ПараметрыПерезаполнения.ВиртуальныеORDERS;
		КонецЕсли;
		
		ПервоначальнаяЗагрузкаСообщения = УдалитьВиртуальныеORDERS(ВиртуальныеORDERS);
			
	Иначе
		ПервоначальнаяЗагрузкаСообщения = Истина;
	КонецЕсли;			
	
	РезультатПриемкиСообщения = МодульОбъекта().ПринятьВходящееСообщение(Сообщение,ПервоначальнаяЗагрузкаСообщения);
	
	Результат.Успешно = РезультатПриемкиСообщения.Успешно;
	
	Возврат Результат;

КонецФункции	

&НаСервере
Процедура УничтожитьТаблицыЗначенийПроизвольныхРеквизитов() Экспорт
	
	НастройкаСсылокИсправленияОшибок     = Неопределено;  

	Для Каждого ЭлементСтруктуры Из НастройкаФормы Цикл
		Если ТипЗнч(ЭлементСтруктуры.Значение) = Тип("ТаблицаЗначений") Тогда
			НастройкаФормы[ЭлементСтруктуры.Ключ] = Неопределено;	
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ЭлементСтруктуры Из Сообщение Цикл
		Если ТипЗнч(ЭлементСтруктуры.Значение) = Тип("ТаблицаЗначений") Или ТипЗнч(ЭлементСтруктуры.Значение) = Тип("ДеревоЗначений") Тогда
			Сообщение[ЭлементСтруктуры.Ключ] = Неопределено;	
		КонецЕсли;
	КонецЦикла;

	Если Сообщение.Свойство("Транспортировка") Тогда
		Сообщение.Транспортировка.ДатаВремяПрибытия = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПоместитьТаблицыЗначенийПроизвольныхРеквизитовВХранилище() Экспорт
	
	СтруктураВременногоХранилища = Новый Структура;

	Если ТипЗнч(НастройкаСсылокИсправленияОшибок) = Тип("ТаблицаЗначений") Тогда
		СтруктураВременногоХранилища.Вставить("НастройкаСсылокИсправленияОшибок", НастройкаСсылокИсправленияОшибок);
	КонецЕсли;

	СтруктураНастройкаФормы = Новый Структура;
	Для Каждого ЭлементСтруктуры Из НастройкаФормы Цикл
		Если ТипЗнч(ЭлементСтруктуры.Значение) = Тип("ТаблицаЗначений") Тогда
			СтруктураНастройкаФормы.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);	
		КонецЕсли;
	КонецЦикла;
	Если СтруктураНастройкаФормы.Количество() > 0 Тогда 
		СтруктураВременногоХранилища.Вставить("НастройкаФормы", СтруктураНастройкаФормы);
	КонецЕсли;
	
	СтруктураСообщение = Новый Структура;
	Для Каждого ЭлементСтруктуры Из Сообщение Цикл
		Если ТипЗнч(ЭлементСтруктуры.Значение) = Тип("ТаблицаЗначений") Или ТипЗнч(ЭлементСтруктуры.Значение) = Тип("ДеревоЗначений") Тогда
			СтруктураСообщение.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);	
		КонецЕсли;
	КонецЦикла;
	Если СтруктураСообщение.Количество() > 0 Тогда 
		СтруктураВременногоХранилища.Вставить("Сообщение", СтруктураСообщение);	
	КонецЕсли;
		
	Если СтруктураВременногоХранилища.Количество() > 0 Тогда 
		АдресВХПроизвольныеРеквизиты = ПоместитьВоВременноеХранилище(СтруктураВременногоХранилища, ЭтаФорма.УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьТаблицыЗначенийПроизвольныхРеквизитовИзХранилища() Экспорт
	
	//извлечем из ВХ если не инициализированы реквизиты и при этом там хоть что-то есть
	
	ВосстановитьТаблицы = НебходимоВосстановитьТаблицы();  
	
	Если ВосстановитьТаблицы Тогда 
		
		СтруктураВременногоХранилища = ПолучитьИзВременногоХранилища(АдресВХПроизвольныеРеквизиты);
		Если СтруктураВременногоХранилища = Неопределено Тогда 
			ВызватьИсключение "Сервер потерял временное хранилище (откройте форму заново)";
		КонецЕсли;
		
		НастройкаСсылокИсправленияОшибок		= СтруктураВременногоХранилища.НастройкаСсылокИсправленияОшибок;

		Если Сообщение.Свойство("ТранспортныеУпаковки") Тогда
			Сообщение.ТранспортныеУпаковки = РеквизитФормыВЗначение("ТранспортныеУпаковки");
		КонецЕсли;
				
		Если СтруктураВременногоХранилища.Свойство("НастройкаФормы") И ТипЗнч(СтруктураВременногоХранилища.НастройкаФормы) = Тип("Структура") Тогда
			Для Каждого ЭлементСтруктуры Из СтруктураВременногоХранилища.НастройкаФормы Цикл
				НастройкаФормы[ЭлементСтруктуры.Ключ] = ЭлементСтруктуры.Значение;							
			КонецЦикла;				
		КонецЕсли;
		
		Если СтруктураВременногоХранилища.Свойство("Сообщение") И ТипЗнч(СтруктураВременногоХранилища.Сообщение) = Тип("Структура") Тогда
			Для Каждого ЭлементСтруктуры Из СтруктураВременногоХранилища.Сообщение Цикл
				Если ЭлементСтруктуры.Ключ = "ТранспортныеУпаковки" И Не (ТипСообщения = "ORDERS" ИЛИ ТипСообщения = "ORDRSP") Тогда
					Продолжить;
				КонецЕсли;
				Сообщение[ЭлементСтруктуры.Ключ] = ЭлементСтруктуры.Значение;							
			КонецЦикла;
		КонецЕсли;

		ПриВосстановленииТоваровСообщения(); 
		
		Если Сообщение.Свойство("Транспортировка") Тогда
			Сообщение.Транспортировка.ДатаВремяПрибытия = Транспортировка;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НебходимоВосстановитьТаблицы()
	
	ВосстановитьТаблицы = НЕ ПустаяСтрока(АдресВХПроизвольныеРеквизиты)
	И (НастройкаСсылокИсправленияОшибок 	 = Неопределено
	ИЛИ НастройкаФормы.ОбязательныеПоля 	 = Неопределено
	ИЛИ НастройкаФормы.КнопкиКоманднойПанели = Неопределено
	ИЛИ НастройкаФормы.КнопкиДопРеквизитов 	 = Неопределено)
	ИЛИ Сообщение.Товары					 = Неопределено
	ИЛИ (Сообщение.Свойство("Фасовка") И Сообщение.Фасовка = Неопределено)  
	ИЛИ (Сообщение.Свойство("ТранспортныеУпаковки") И Сообщение.ТранспортныеУпаковки = Неопределено)  
	ИЛИ (Сообщение.Свойство("ТочкиСамовывоза") И Сообщение.ТочкиСамовывоза = Неопределено)
	ИЛИ (Сообщение.Свойство("Прослеживаемость") И Сообщение.Прослеживаемость = Неопределено);
	
	Возврат ВосстановитьТаблицы;

КонецФункции

&НаСервере
Процедура ПриВосстановленииТоваровСообщения()
		
	Если Сообщение.ТипСообщения = "ORDRSP" Тогда	
		
		ИндексСтроки = 0;
		
		Для каждого Стр Из Товары Цикл 
			
			СтрокаСообщения = Сообщение.Товары.Получить(ИндексСтроки);
			
			СтрокаСообщения.Комментарий = Стр.Комментарий; 
			
			ИндексСтроки = ИндексСтроки + 1;	
			
		КонецЦикла;	
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КнопкаВыборВерсииНажатие(ИмяКоманды)
	
	СписокКнопок = ПолучитьСписокИменКнопокДублей();	
	МодульОбъектаКлиент().ВыбратьИзМеню_КонтурEDI("ОбработчикВыбораВерсии", ЭтаФорма, Неопределено, СписокКнопок, Элементы.СуммаВсего);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВыбораВерсии(ВыбраннаяВерсия = Неопределено,ДопПараметр = Неопределено)Экспорт
	
	Если ВыбраннаяВерсия<>Неопределено Тогда
		
		Если Лев(ВыбраннаяВерсия.Значение,6)="Версия" Тогда
			
			ГУИДСообщения = СтрЗаменить(Сред(ВыбраннаяВерсия.Значение,8),"_","-");
			ОбработчикВыбораВерсииСервер(ГУИДСообщения);
			ПриОткрытии(ложь);
			
		ИначеЕсли ВыбраннаяВерсия.Значение = "СравнитьВерсии" Тогда
			
			ВыбратьВерсиюИПоказатьСравнение();
			
		КонецЕсли;
	КонецЕсли;	

КонецПроцедуры // ОбработчикВыбораВерсии()

&НаКлиенте
Процедура ВыбратьВерсиюИПоказатьСравнение()
	
	ПараметрыСравнения = Новый Структура;
	ПараметрыСравнения.Вставить("ТекущаяВерсия", Сообщение.СообщениеСсылка);
	ПараметрыСравнения.Вставить("ПредставлениеТекущейВерсии");
	ПараметрыСравнения.Вставить("ВерсияДляСравнения");
	ПараметрыСравнения.Вставить("ПредставлениеВерсииДляСравнения");
	
	СписокВерсийДляВыбора = Новый СписокЗначений;
	
	Для каждого СтрокаВерсии Из ВерсииСообщения Цикл
		Если СтрокаВерсии.Ссылка = Сообщение.СообщениеСсылка Тогда
			ПараметрыСравнения.ПредставлениеТекущейВерсии = СтрокаВерсии.Представление;
		КонецЕсли;
		СписокВерсийДляВыбора.Добавить(СтрокаВерсии.Ссылка,СтрокаВерсии.Представление);
	КонецЦикла;
	
	КоличествоВерсий = СписокВерсийДляВыбора.Количество();
	Если КоличествоВерсий = 1 Тогда 
		ПоказатьФормуРасхождений(СписокВерсийДляВыбора[0], ПараметрыСравнения);
	Иначе
		
		ПоследняяВерсияВСписке = СписокВерсийДляВыбора[КоличествоВерсий - 1];
		ЗаголовокОкнаВыбора = "Выберите версию для сравнения с текущей";
		
		МодульОбъектаКлиент().ПоказатьВыборЭлемента_КонтурEDI("ПоказатьФормуРасхождений", 
															   ЭтаФорма, 
															   ПараметрыСравнения, 
															   СписокВерсийДляВыбора,
															   ПоследняяВерсияВСписке,
															   ЗаголовокОкнаВыбора);
				
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьФормуРасхождений(ВыбраннаяВерсияДляСравнения, ПараметрыСравнения) Экспорт
	
	Если ВыбраннаяВерсияДляСравнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыСравнения.ВерсияДляСравнения = ВыбраннаяВерсияДляСравнения.Значение;
	ПараметрыСравнения.ПредставлениеВерсииДляСравнения = ВыбраннаяВерсияДляСравнения.Представление;
	
	ПараметрыФормыРасхождений = Новый Структура;
	ПараметрыФормыРасхождений.Вставить("ВидРасхождения", "РасхожденияВерсийЗаказа");
	ПараметрыФормыРасхождений.Вставить("Заказ",	Сообщение.СообщениеСсылка);
	ПараметрыФормыРасхождений.Вставить("Параметры",	ПараметрыСравнения);
			
	МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI("Сервис_ПросмотрРасхожденийУправляемая", , ПараметрыФормыРасхождений, ЭтаФорма, , , , РежимОткрытияОкнаФормы.Независимый);

КонецПроцедуры

&НаСервере
Процедура ОбработчикВыбораВерсииСервер(ГУИДСообщения)
	
	СсылкаВыбранногоСообщения = Справочники.КонтурEDI_Сообщения.ПолучитьСсылку(Новый УникальныйИдентификатор(ГУИДСообщения));
	ВыбранноеСообщение = МодульОбъекта().ПрочитатьСообщение(СсылкаВыбранногоСообщения,,Сообщение.ТипСообщения,"Входящее");
	
	Если ЗначениеЗаполнено(ВыбранноеСообщение) Тогда
		
		МодульОбъекта().КонвертироватьСообщениеEDIв1С(ВыбранноеСообщение);    //взято из оф - а в тут наверно можно выпилить
		
		ВыбранноеСообщение.СообщениеСсылка = СсылкаВыбранногоСообщения;
		Сообщение = ВыбранноеСообщение;
		Сообщение.Документ1С = СсылкаВыбранногоСообщения.Документ;
				
		Параметры.СообщениеСсылка	= СсылкаВыбранногоСообщения; 
		Параметры.Документ1С		= СсылкаВыбранногоСообщения.Документ;
		
		ПроизвестиПервоначальноеЗаполнениеПолейНаФорме();
		ПоместитьТаблицыЗначенийПроизвольныхРеквизитовВХранилище();	
		УничтожитьТаблицыЗначенийПроизвольныхРеквизитов();
		ДозаполнитьАртикулКодПолноеНаименованиеТЧТовары();
		
	КонецЕсли;
	
КонецПроцедуры // ()

&НаСервере
Функция ПолучитьСписокИменКнопокДублей()
		
	СписокКнопок = Новый СписокЗначений;
		
	Для Каждого ВерсияСообщения Из ВерсииСообщения Цикл
				
		ИмяКнопки = "Версия_" + СтрЗаменить(ВерсияСообщения.УникальныйИдентификатор,"-","_");
		НоваяКнопка = СписокКнопок.Добавить(ИмяКнопки,ВерсияСообщения.Представление);
		
		Если ВерсияСообщения.Ссылка = Сообщение.СообщениеСсылка Тогда
			НоваяКнопка.Картинка = БиблиотекаКартинок.СформироватьОтчет;
		КонецЕсли;
		
	КонецЦикла;
	
	НоваяКнопка = СписокКнопок.Добавить("СравнитьВерсии","Сравнить версии",,БиблиотекаКартинок.Отчет);
		
	Возврат СписокКнопок;		
	
КонецФункции

&НаКлиенте
Процедура КнопкаДействияФормыВыборВерсииНажатие(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	ПерепривязатьСообщенияИнтерактивно();  
	
	ПараметрыОбработкиВерсий = ПодготовитьПараметрыОбработкиВерсий();
	РеквизитыВопросаПользователю = РеквизитыВопросаПриОбработкеВерсий(ПараметрыОбработкиВерсий);
	
	МодульОбъектаКлиент().ПоказатьВопрос_КонтурEDI("ОбработчикВыбораДействияНадДокументом1С",
												    ЭтаФорма,
												    ПараметрыОбработкиВерсий,
												    РеквизитыВопросаПользователю.ТекстВопроса,
												    РеквизитыВопросаПользователю.СписокКнопок);
														
КонецПроцедуры

&НаКлиенте
Функция РеквизитыВопросаПриОбработкеВерсий(ПараметрыОбработкиВерсий)
	
	СписокКнопок = Новый СписокЗначений;
	КнопкаОтветаДа 		= СписокКнопок.Добавить(КодВозвратаДиалога.Да, "Да");
	КнопкаОтветаНет 	= СписокКнопок.Добавить(КодВозвратаДиалога.Нет, "Нет");
	КнопкаОтветаОтмена	= СписокКнопок.Добавить(КодВозвратаДиалога.Отмена, "Отмена");
	
	Если Не ПараметрыОбработкиВерсий.ЗаполненДокумент1С Тогда
		
		ТекстВопроса = "Создать документ 1С?";
		СписокКнопок.Удалить(КнопкаОтветаНет);
		
	ИначеЕсли ПараметрыОбработкиВерсий.ЕстьВиртуальныеORDERS Тогда 
		
		ТекстВопроса = "Следующие документы будут помечены на удаление:";
		Для Каждого Стр Из ПараметрыОбработкиВерсий.ВиртуальныеORDERS Цикл
			ТекстВопроса = ТекстВопроса + Символы.ПС + Стр.Документ;
		КонецЦикла;
		
		ТекстВопроса = ТекстВопроса + Символы.ПС + "Вместо них будут созданы новые документы. Продолжить?";
		КнопкаОтветаДа.Представление = "Да, пересоздать документы";
		КнопкаОтветаНет.Представление = "Нет, игнорировать изменения";
		
	Иначе	
		
		ТекстВопроса = "Документ " + Документ1С + " будет перезаполнен. Продолжить?";
		КнопкаОтветаДа.Представление = "Да, перезаполнить";
		КнопкаОтветаНет.Представление = "Нет, игнорировать изменения";
		
	КонецЕсли;

	РеквизитыВопроса = Новый Структура;
	РеквизитыВопроса.Вставить("ТекстВопроса", ТекстВопроса);
	РеквизитыВопроса.Вставить("СписокКнопок", СписокКнопок);
	
	Возврат РеквизитыВопроса;
	
КонецФункции

&НаСервере
Функция ПодготовитьПараметрыОбработкиВерсий()
	
	ЗаполненДокумент1С = ЗначениеЗаполнено(Документ1С);
	
	ПараметрыОбработкиВерсий = Новый Структура;
	ПараметрыОбработкиВерсий.Вставить("ЗаполненДокумент1С", ЗаполненДокумент1С);
	ПараметрыОбработкиВерсий.Вставить("ПервоначальнаяЗагрузкаСообщения", Не ЗаполненДокумент1С);
	
	Если ЗаполненДокумент1С Тогда
		ВиртуальныеORDERS = МодульОбъекта().ПолучитьВиртуальныеСвязанныеORDERS(Документ1С);
	Иначе
		ВиртуальныеORDERS = Новый Массив;
	КонецЕсли;
	
	Если ВиртуальныеORDERS.Количество() > 1 Тогда 
		ПараметрыОбработкиВерсий.Вставить("ВиртуальныеORDERS", МодульОбъекта().ТаблицаЗначенийВМассив_КонтурEDI(ВиртуальныеORDERS));
		ПараметрыОбработкиВерсий.Вставить("ЕстьВиртуальныеORDERS", Истина);
		ПараметрыОбработкиВерсий.ПервоначальнаяЗагрузкаСообщения = Истина;
	Иначе
		ПараметрыОбработкиВерсий.Вставить("ВиртуальныеORDERS", Новый Массив);
		ПараметрыОбработкиВерсий.Вставить("ЕстьВиртуальныеORDERS", Ложь);
	КонецЕсли;
	
	Возврат ПараметрыОбработкиВерсий;
	
КонецФункции

&НаКлиенте
Процедура ОбработчикВыбораДействияНадДокументом1С(ВыбранноеЗначение = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ВыбранноеЗначение = КодВозвратаДиалога.Да Тогда
		
		Если ПерезаполнитьДокумент1С(ДополнительныеПараметры) Тогда
			ЗакрытиеРазрешено = Истина;
			ЭтаФорма.Закрыть(Неопределено);
		КонецЕсли;
		
	ИначеЕсли ВыбранноеЗначение = КодВозвратаДиалога.Нет Тогда
		
		ОбработатьИгнорированиеНовойВерсии(ДополнительныеПараметры.ВиртуальныеORDERS);
		ЗакрытиеРазрешено = Истина;
		ЭтаФорма.Закрыть(Неопределено);
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИгнорированиеНовойВерсии(ВиртуальныеORDERS)
	
	ВосстановитьТаблицыЗначенийПроизвольныхРеквизитовИзХранилища();
	
	Если Сообщение.ТипСообщения = "ORDERS" Тогда
		МодульОбъекта().УстановитьСтатусСообщения(Сообщение.СообщениеСсылка,
												  Сообщение.ДокументСсылка,
												  Сообщение.ТипСообщения,
												  "ВходящийЗагружен");
	КонецЕсли;
	
	Для Каждого ВиртуальныйORDERS Из ВиртуальныеORDERS Цикл
		МодульОбъекта().УстановитьСтатусСообщения(ВиртуальныйORDERS.ORDERS,
												  ВиртуальныйORDERS.Документ,
												  "ORDERS",
												  "ВходящийЗагружен");
	КонецЦикла;	
	
	УничтожитьТаблицыЗначенийПроизвольныхРеквизитов();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПроизвольныеПараметрыФормы(ПараметрыДействия)
	 
	 ПроизвольныеПараметры = Параметры.ПроизвольныеПараметры;
	 
	 Если НЕ ПроизвольныеПараметры = Неопределено Тогда
		 
		 Для Каждого ПроизвольныйПараметр Из ПроизвольныеПараметры Цикл
			 ПараметрыДействия.Вставить(ПроизвольныйПараметр.Ключ,	ПроизвольныйПараметр.Значение);
		 КонецЦикла;
		 
	 КонецЕсли;
 
 КонецПроцедуры // ДобавитьПроизвольныеПараметрыФормы() 

//Обработчики команд нажатия кнопок - реализация иная чем в ОФ в связи с тем что в обработчик передается имя команды а не элемент формы
//so, создадим все возможные команды которые могут случиться в форме и в них пропишем обработчики а выводить или нет саму кнопку будем решать при создании на сервере
//точно так же будем придумыва
&НаКлиенте
Процедура КнопкаДействияФормыНажатие_Клиент(ИмяКоманды)
		
	ПараметрыПМ = Новый Структура("Сообщение, ТранспортныеУпаковки, Форма, ИмяКоманды", Сообщение, ТранспортныеУпаковки, ЭтаФорма, ИмяКоманды);
	
	СтандартнаяОбработкаEDI = Истина;
	ОсновнаяФорма().ОбработкаСобытияПодключаемогоМодуляКлиент("КнопкаДействияФормыНажатие_Клиент", СтандартнаяОбработкаEDI, ПараметрыПМ);
	
	Если СтандартнаяОбработкаEDI = Истина Тогда
		
		РезультатДействия = КнопкаДействияФормыНажатие(ИмяКоманды);
		
		Если НужноПромаркироватьУпаковкиSSCCКодом(ИмяКоманды, ОтправлятьДанныеОбУпаковках) = Истина Тогда
			РазвернутьВсеУровниТранспортныхУпаковок();
		КонецЕсли;
		
		//для печати паллетных листов
		Если ТипЗнч(РезультатДействия) = Тип("ТабличныйДокумент") Тогда
			
			РезультатДействия.Показать();
			
		ИначеЕсли РезультатДействия <> Неопределено 
			и РезультатДействия.ЗакрытьФорму
			и ЭтаФорма.Открыта() Тогда
			
			ЗакрытиеРазрешено = Истина;
			ЭтаФорма.Закрыть(Параметры.СообщениеСсылка);
			
		КонецЕсли;
		
	КонецЕсли; 

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НужноПромаркироватьУпаковкиSSCCКодом(ИмяКоманды, ОтправлятьДанныеОбУпаковках)
	
	МассивКоманд = Новый Массив;
	МассивКоманд.Добавить("ОтправитьУведомлениеОбОтгрузке");
	МассивКоманд.Добавить("Сохранить");
	МассивКоманд.Добавить("ОтправитьСчетФактуру");
	
	НужноПромаркироватьУпаковкиSSCCКодом = (ОтправлятьДанныеОбУпаковках = Истина 
		И МассивКоманд.Найти(ИмяКоманды) <> Неопределено);
		
	Возврат НужноПромаркироватьУпаковкиSSCCКодом;
	
КонецФункции

&НаСервере
Функция КнопкаДействияФормыНажатие(ИмяКоманды)
	
	РезультатДействия = Новый Структура("ЗакрытьФорму", Ложь);
	
	СвойстваКнопки = ПолучитьСвойстваКнопки(ИмяКоманды); 
	
	ПроверкаПолей = (НЕ СвойстваКнопки = Неопределено);
	
	Если ПроверкаПолей И СвойстваКнопки.ПроверятьПоля Тогда
		
		Если НЕ ПроверитьЗаполнениеПолей() Тогда
			
			ОткрытьПанельОшибокСервер();  			
			ПроверкаПолей = Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПроверкаПолей Тогда 		
		
		ВосстановитьТаблицыЗначенийПроизвольныхРеквизитовИзХранилища();
		
		Попытка
		
			Если СвойстваКнопки.СохранятьСоответствия Тогда
				
				ПеренестиПоля1СвСообщение(Сообщение); 
				
			КонецЕсли; 		
			
			Если НужноПромаркироватьУпаковкиSSCCКодом(ИмяКоманды, ОтправлятьДанныеОбУпаковках) = Истина Тогда
				
				ДеревоТранспортныхУпаковок = РеквизитФормыВЗначение("ТранспортныеУпаковки");
				МодульОбъекта().ПромаркироватьУпаковкиКодомSSCC(ДеревоТранспортныхУпаковок, Сообщение.Продавец1С, Сообщение);
				Сообщение.ТранспортныеУпаковки = ДеревоТранспортныхУпаковок;
				ЗначениеВРеквизитФормы(ДеревоТранспортныхУпаковок, "ТранспортныеУпаковки");

			КонецЕсли;
					
			Действие = ОпределитьДействиеПоОсновнойКнопке(ИмяКоманды);    
			
			Если Действие = "ПерезаполнитьДокумент1С" Тогда
				
				Если ПерезаполнитьДокумент1С() Тогда 				
					РезультатДействия.ЗакрытьФорму = Истина;  								
				КонецЕсли;  
				
			ИначеЕсли Действие = "ВыбратьТекущуюВерсию" Тогда
				
				ПерепривязатьСообщенияИнтерактивно();
				
				Если ПерезаполнитьДокумент1С() Тогда
					РезультатДействия.ЗакрытьФорму = Истина;
				КонецЕсли;
				
			ИначеЕсли Действие = "ОсновноеДействие" Тогда 
				
				РезультатДействия = МодульОбъекта().КнопкаФормыСообщенияНажатие(ИмяКоманды,Сообщение, ПараметрыДействия); //КонвертироватьПарамтрыФормыВСтруктуруСервер());
				
				Если РезультатДействия.СозданДокумент = Истина Тогда
					
					Документ1С = РезультатДействия.СсылкаНаДокумент;
					
				КонецЕсли;  			
				
			КонецЕсли;
		
		Исключение
			
			УничтожитьТаблицыЗначенийПроизвольныхРеквизитов(); 
			ТекстОшибки = "Не удалось выполнить действие на форме - " + ИмяКоманды + " - " + ОписаниеОшибки();
			МодульОбъекта().ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);
			ВызватьИсключение ТекстОшибки;
		
		КонецПопытки;
		
		ПоместитьТаблицыЗначенийПроизвольныхРеквизитовВХранилище();
		УничтожитьТаблицыЗначенийПроизвольныхРеквизитов(); 
		
	КонецЕсли;
	
	Возврат РезультатДействия;
	
КонецФункции

&НаСервере
Функция ОпределитьДействиеПоОсновнойКнопке(Знач ИмяКоманды)
	
	Действие = "ОсновноеДействие";
	
	Элемент = ОпределитьКнопкуЭлементФормыПоИмениКоманды(ИмяКоманды);
	
	Если ИмяКоманды = "СоздатьЗаказ" 
		И Элемент <> Неопределено
		И Элемент.Заголовок = "Перезаполнить заказ" Тогда
		
		Действие = "ПерезаполнитьДокумент1С";
		
	КонецЕсли;
	
	Если ИмяКоманды = "СоздатьЗаказ"
		И Элемент <> Неопределено
		И Элемент.Заголовок = "Обработать новую версию" Тогда
		
		Действие = "ВыбратьТекущуюВерсию";
		
	КонецЕсли;
	
	Если НЕ ТипЗнч(ПараметрыДействия) = Тип("Структура") Тогда
		ПараметрыДействия = Новый Структура();
	КонецЕсли;		
	
	ПараметрыДействия.Вставить("ОтправитьСообщениеИзФормы",	Истина);
	ПараметрыДействия.Вставить("Сообщение",					Сообщение);
	ПараметрыДействия.Вставить("Объект",					МодульОбъекта());
	ПараметрыДействия.Вставить("ОтправкаТолькоALCRPT",		ОтправкаТолькоALCRPT);
	ПараметрыДействия.Вставить("ИзмененныеРеквизиты",		ПодготовитьСтруктуруИзмененныхРеквизитов());
	
	ДобавитьПроизвольныеПараметрыФормы(ПараметрыДействия);
	
	Если ИмяКоманды = "ОтправитьОтветНаЗаказ" и ПараметрыДействия.Свойство("ВходящийЗаказ")Тогда  //костылек на отмену заказа через спец кнопку
		
		ПараметрыДействия.ВходящийЗаказ = МодульОбъекта().ПрочитатьСообщение(ПараметрыДействия.ВходящийЗаказ,,"ORDERS","Входящее");
		
	КонецЕсли;       			
	
	СтандартнаяОбработкаEDI = Истина;
	РезультатДействия = МодульОбъекта().ОбработкаСобытияПодключаемогоМодуля("КнопкаФормыСообщенияНажатие",СтандартнаяОбработкаEDI,Новый Структура("ИмяКоманды,Сообщение,Параметры,Форма,РезультатКлиента",ИмяКоманды,Сообщение,Параметры,ЭтаФорма,Неопределено));
	
	Если СтандартнаяОбработкаEDI = Ложь Тогда
		Действие = "НеСтандартнаяОбработкаДействия";
	КонецЕсли;
	
	Возврат Действие;

КонецФункции

&НаСервере
Функция ПолучитьСвойстваКнопки(ИмяКоманды)
	
	Перем КнопкиКоманднойПанели, СвойстваКнопки;
	
	СтруктураВременногоХранилища = ПолучитьИзВременногоХранилища(АдресВХПроизвольныеРеквизиты);
	КнопкиКоманднойПанели	= СтруктураВременногоХранилища.НастройкаФормы.КнопкиКоманднойПанели;
	
	СвойстваКнопки = КнопкиКоманднойПанели.Найти(ИмяКоманды,"Имя");
	Возврат СвойстваКнопки;

КонецФункции

&НаСервере
Функция КонвертироватьПарамтрыФормыВСтруктуруСервер()
    //только ключевые
	Сконвертированнаятруктура=Новый Структура;
	
	Сконвертированнаятруктура.Вставить("Документ1С",Параметры.Документ1С);
	Сконвертированнаятруктура.Вставить("КодДействия",Параметры.КодДействия);
	Сконвертированнаятруктура.Вставить("МодальностьЗапрещена",Объект.ПараметрыКлиентСервер.МодальностьЗапрещена);
	Сконвертированнаятруктура.Вставить("РежимРаботы",Параметры.РежимРаботы);
	Сконвертированнаятруктура.Вставить("СообщениеСсылка",Параметры.СообщениеСсылка);
	Сконвертированнаятруктура.Вставить("ТипСообщения",Параметры.ТипСообщения);
	Сконвертированнаятруктура.Вставить("ОтправкаТолькоALCRPT",ОтправкаТолькоALCRPT);    //добавим сервисный реквизит, костыльно смотрится - //метка рефакторинг
	//добавить произвольные параметры если там структура - опять же смотрится костыльно - //метка рефакторинг
	
	Если Параметры.ПроизвольныеПараметры<>Неопределено Тогда
		Если Параметры.ПроизвольныеПараметры.Свойство("Статус") Тогда 
			Сконвертированнаятруктура.Вставить("Статус",		Параметры.ПроизвольныеПараметры.Статус);
		КонецЕсли;
		Если Параметры.ПроизвольныеПараметры.Свойство("ВходящийЗаказ") Тогда
			
			СообщениеЗаказ = МодульОбъекта().ПрочитатьСообщение(Параметры.ПроизвольныеПараметры.ВходящийЗаказ,,"ORDERS","Входящее");
			МодульОбъекта().КонвертироватьСообщениеEDIв1С(СообщениеЗаказ);
			
			Сконвертированнаятруктура.Вставить("ВходящийЗаказ",	СообщениеЗаказ);
		КонецЕсли;
	КонецЕсли;
	
	
	Возврат Сконвертированнаятруктура;
	
