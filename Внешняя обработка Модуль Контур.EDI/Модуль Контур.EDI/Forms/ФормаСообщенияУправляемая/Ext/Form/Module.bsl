&НаКлиенте
Процедура ТипыМаркируемойПродукцииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СписокЗначенийВыбора = ПолныйСписокТиповМаркируемойПродукции();
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СписокЗначенийВыбора", СписокЗначенийВыбора);
	ПараметрыФормы.Вставить("ВыборНесколькихЗначений", Истина);
	ПараметрыФормы.Вставить("МодальностьЗапрещена", Параметры.МодальностьЗапрещена);
	
	МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI("УниверсальнаяФормаВыбораУправляемая",
												 Неопределено,
												 ПараметрыФормы,
												 ЭтаФорма,
												 "ОбработкаВыбораТиповМаркируемойПродукции",
												 ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораТиповМаркируемойПродукции(РезультатВыбораТиповПродукции, ДополнительныеРеквизиты = Неопределено) Экспорт
	
	Если Не ТипЗнч(РезультатВыбораТиповПродукции) = Тип("СписокЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	ТипыМаркируемойПродукции.Очистить();
	
	Для каждого ТипПродукции Из РезультатВыбораТиповПродукции Цикл
		
		Если ТипПродукции.Пометка = Истина Тогда
			ТипыМаркируемойПродукции.Добавить(ТипПродукции.Значение, ТипПродукции.Представление, Истина);
		КонецЕсли;
		
	КонецЦикла;
	
	Сообщение.ТипыМаркируемойПродукции = ТипыМаркируемойПродукции.Скопировать();
	
КонецПроцедуры

&НаКлиенте
Функция ПолныйСписокТиповМаркируемойПродукции()
	                                                                        
	ПеречислениеТипыМаркированнойПродукции = КлассификаторПеречислений().Получить("ТипыМаркированнойПродукцииСписокЗначений");
	
	Если ПеречислениеТипыМаркированнойПродукции = Неопределено Тогда
		ПолныйСписокТипов = Новый СписокЗначений;
	Иначе
		ПолныйСписокТипов = ПеречислениеТипыМаркированнойПродукции.Скопировать()
	КонецЕсли;
		
	Для каждого ТипПродукции Из ТипыМаркируемойПродукции Цикл
		
		ТипПродукцииВПолномСписке = ПолныйСписокТипов.НайтиПоЗначению(ТипПродукции.Значение);
		
		Если ТипПродукцииВПолномСписке = Неопределено Тогда
			ПолныйСписокТипов.Добавить(ТипПродукции.Значение, ТипПродукции.Представление, Истина);
		Иначе
			ТипПродукцииВПолномСписке.Пометка = Истина;
		КонецЕсли;
				
	КонецЦикла;
	
	Возврат ПолныйСписокТипов;
	
КонецФункции

&НаКлиенте
Процедура КомментарийПриИзменении(Элемент)
	
	Если Сообщение.Направление = "Исходящее" Тогда
		
		Элементы.Комментарий.ЦветФона = WebЦвета.Белый;
		
		Сообщение.Вставить("Комментарий", Комментарий);
				
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьОтгрузку(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	ПараметрыФормы = Новый Структура("СообщениеСсылка",			Сообщение.СообщениеСсылка); 
	ПараметрыФормы.Вставить("Документ1С",						Сообщение.Документ1С);
	ПараметрыФормы.Вставить("ТипСообщения",						Сообщение.ТипСообщения);
	ПараметрыФормы.Вставить("Направление",						Сообщение.Направление);
	ПараметрыФормы.Вставить("ТолькоПросмотр",					Ложь);
	ПараметрыФормы.Вставить("КодДействия",						"Отправить_");
	ПараметрыФормы.Вставить("РежимРаботы",						Параметры.РежимРаботы);
	ПараметрыФормы.Вставить("АдресХранилища",					Объект.ПараметрыКлиентСервер.АдресаВХ.ОбработкаОбъект);
	ПараметрыФормы.Вставить("ПараметрыАвтотестирования",		Параметры.ПараметрыАвтотестирования);
	ПараметрыФормы.Вставить("ПереотправляемоеСообщениеСсылка",	Сообщение.СообщениеСсылка);
	
	Если Параметры.ПроизвольныеПараметры = Неопределено Тогда 
		ПроизвольныеПараметры = Новый Структура;
	Иначе
		ПроизвольныеПараметры = Параметры.ПроизвольныеПараметры;	
	КонецЕсли;
	
	ПроизвольныеПараметры.Вставить("Статус", "Отменить");
	
	ПараметрыФормы.Вставить("ПроизвольныеПараметры", ПроизвольныеПараметры);
	
	МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI("ФормаСообщенияУправляемая", , ПараметрыФормы, ЭтаФорма, "ОбработчикПослеЗакрытияКарточкиПереотправкиСообщения", ЭтаФорма);

КонецПроцедуры

&НаСервере
Функция ПоместитьТаблицуКодовМаркировкиВсехТоваровНаСервере(ВключатьТоварыБезКодов = Ложь, ИмяКолонкиКодов = "КодыМаркировки")
	
	Попытка
		
		ТаблицаТоваров = РеквизитФормыВЗначение("Товары");
		ДеревоУпаковок = РеквизитФормыВЗначение("ТранспортныеУпаковки");
		
		ТаблицаКодов = МодульОбъекта().РазвернутаяТаблицаКодовМаркировки_КонтурEDI(ТаблицаТоваров, 
																				   ДеревоУпаковок, 
																				   ВключатьТоварыБезКодов, 
																				   ИмяКолонкиКодов);
																				   
		АдресВоВХ = ПоместитьВоВременноеХранилище(ТаблицаКодов, ЭтаФорма.УникальныйИдентификатор);
		
	Исключение
		
		УничтожитьТаблицыЗначенийПроизвольныхРеквизитов();
		ТекстОшибки = "Не удалось поместить коды маркировки товаров сообщения - " + ОписаниеОшибки();
		МодульОбъекта().ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);
		ВызватьИсключение ТекстОшибки;				
		
	КонецПопытки;
	
	Возврат АдресВоВХ;
	
КонецФункции

&НаСервере
Функция ПоместитьТаблицуКодовМаркировкиТоваровУпаковкиНаСервере(ИдентификаторСтрокиУпаковки)
	
	Попытка
	
		ВосстановитьТаблицыЗначенийПроизвольныхРеквизитовИзХранилища();
		
		ВыбраннаяУпаковка = ТранспортныеУпаковки.НайтиПоИдентификатору(ИдентификаторСтрокиУпаковки);
		КоллекцияТоваровУпаковки = ВыбраннаяУпаковка.ПолучитьЭлементы();
		ТранспортныеУпаковкиДерево = РеквизитФормыВЗначение("ТранспортныеУпаковки");
		
		АдресВоВХ = МодульОбъекта().ПоместитьТаблицуКодовМаркировкиТоваровУпаковки(
			Сообщение.Товары, ТранспортныеУпаковкиДерево, КоллекцияТоваровУпаковки, ЭтаФорма.УникальныйИдентификатор);
		
		УничтожитьТаблицыЗначенийПроизвольныхРеквизитов();
	
	Исключение
		
		УничтожитьТаблицыЗначенийПроизвольныхРеквизитов();
		ТекстОшибки = "Не удалось поместить коды маркировки товаров упаковки - " + ОписаниеОшибки();
		МодульОбъекта().ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);
		ВызватьИсключение ТекстОшибки;				
		
	КонецПопытки;
	
	Возврат АдресВоВХ;
	
КонецФункции

&НаКлиенте
Процедура РазместитьКаждыйТоварВОтдельнойУпаковке(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	Если ТранспортныеУпаковки.ПолучитьЭлементы().Количество() > 0 Тогда
		
		ТекстВопроса = "Текущее распределение товаров по транспортным упаковкам будет очищено и перезаполнено. Продолжить?" ;
		ИмяОбработчика = "РазместитьКаждыйТоварВОтдельнойУпаковкеОбработкаВопроса";
		ПараметрыОбработчика = Неопределено;
		
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить("Да, перезаполнить");
		СписокКнопок.Добавить("Нет");
	
		МодульОбъектаКлиент().ПоказатьВопрос_КонтурEDI(ИмяОбработчика, ЭтаФорма, ПараметрыОбработчика, ТекстВопроса, СписокКнопок);

	Иначе
		
		РазместитьКаждыйТоварВОтдельнойУпаковкеЗавершение();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РазместитьКаждыйТоварВОтдельнойУпаковкеОбработкаВопроса(РезультатВопроса, ДопПараметры = Неопределено) Экспорт
	
	Если РезультатВопроса = "Да, перезаполнить" Тогда
		
		РазместитьКаждыйТоварВОтдельнойУпаковкеЗавершение();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РазместитьКаждыйТоварВОтдельнойУпаковкеЗавершение()
	
	ТранспортныеУпаковки.ПолучитьЭлементы().Очистить();
	ОбновитьДанныеРазмещения();
	
	МассовоеДействие = Истина;
	
	Для каждого СтрокаТовара Из ТоварныеПозиции Цикл
	
		СтрокаУпаковки = ДобавитьНовуюУпаковку(,,,МассовоеДействие);
		РазместитьТоварнуюПозицию(СтрокаТовара, СтрокаУпаковки, МассовоеДействие);
	
	КонецЦикла;
	
	ПронумероватьУпаковкиСквознымПорядковымНомером();
	ПроименоватьУпаковки(ТранспортныеУпаковки.ПолучитьЭлементы());
	
	ОбновитьДанныеРазмещения("РазместитьКаждыйТоварВОтдельнойУпаковкеЗавершение");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПредставлениеКодовМаркировкиТранспортныхУпаковок(ДеревоТранспортныхУпаковок, ТолькоПросмотрСообщения)
	
	Для каждого Упаковка Из ДеревоТранспортныхУпаковок.ПолучитьЭлементы() Цикл
		
		КодыУпаковки = КодыМаркировкиУпаковкиТоваров(Упаковка);
		КоличествоКодовУпаковки = КодыУпаковки.Количество();
		
		Если ЗначениеЗаполнено(КоличествоКодовУпаковки)
			ИЛИ ТолькоПросмотрСообщения = Истина Тогда
			
			ПредставлениеКодов = "Выбрано: " + Строка(КоличествоКодовУпаковки);
			
		Иначе
			
			ПредставлениеКодов = "Коды не выбраны";
			
		КонецЕсли;
		
		Упаковка.КодыМаркировкиПредставление = ПредставлениеКодов;
	
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Функция КодыМаркировкиУпаковкиТоваров(Упаковка)
	
	КодыМаркировкиУпаковки = Новый СписокЗначений;
	
	Для каждого Товар Из Упаковка.ПолучитьЭлементы() Цикл
		
		КодыМаркировкиТовара = Товар.КодыМаркировки;
		
		Если НЕ ЗначениеЗаполнено(КодыМаркировкиТовара) Тогда
			Продолжить;
		КонецЕсли;
		
		КодыМаркировкиУпаковки = МодульОбъектаКлиент().ОбъединитьСпискиЗначений(КодыМаркировкиУпаковки, КодыМаркировкиТовара);
		
	КонецЦикла;

	Возврат КодыМаркировкиУпаковки;
	
КонецФункции

&НаКлиенте
Процедура КодыМаркировкиУпаковок(Команда)               
	
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();
	
	ОткрытьФормуРаспределенияКодовМаркировки();
												 
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуРаспределенияКодовМаркировки()
	
	ПараметрыФормы = ПолучитьПараметрыФормыКодовМаркировки();
		
	МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI("Сервис_КодыМаркировкиВУпаковкахУправляемая",
												 ,
												 ПараметрыФормы,
												 ЭтаФорма,
												 "ОбработчикЗакрытияФормыКодовМаркировки",
												 ЭтаФорма);

	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуПросмотраДоверенностей() Экспорт
	
	ПараметрыФормы = ПараметрыФормыИнформацииОДоверенностях();
	МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI("Сервис_ПодробнаяИнформация_Управляемая",, ПараметрыФормы, ЭтаФорма,, ЭтаФорма);	
    
КонецПроцедуры

&НаСервере
Функция ПараметрыФормыИнформацииОДоверенностях()
	
	ПредставлениеДоверенностейТабличныйДокумент = МодульОбъекта().Представление_МашиночитаемыеДоверенностиСообщения_ТабличныйДокумент(ДоверенностиСообщения);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок",	"Данные МЧД");
	ПараметрыФормы.Вставить("ПодробнаяИнформацияТабличныйДокумент", ПредставлениеДоверенностейТабличныйДокумент);
	ПараметрыФормы.Вставить("УровеньГруппировокПриОткрытии", 1);
	
	Возврат ПараметрыФормы;
	
КонецФункции

//{ Центр поддержки

&НаКлиенте
Процедура ПомощьЦентрПоддержкиОшибкиСообщения(Команда)
	
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();
	
	ОбращениеВЦентрПоддержкиПоОшибкам();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбращениеВЦентрПоддержкиПоОшибкам() Экспорт
	
	ДопКонтекстДляЦентраПоддержки = Новый Структура;
	ДопКонтекстДляЦентраПоддержки.Вставить("МассивОшибок", МассивОшибокСообщения_КонтурEDI());
	ДопКонтекстДляЦентраПоддержки.Вставить("Сообщение", Сообщение);
			
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ПараметрыСессии", МодульОбъектаКлиент().СформироватьПараметрыЦентраПоддержки(ДопКонтекстДляЦентраПоддержки));
	
	МодульОбъектаКлиент().ОткрытьЦентрПоддержки(ДопПараметры);
	
КонецПроцедуры 

&НаКлиенте
Функция МассивОшибокСообщения_КонтурEDI()
	
	МассивОшибок = Новый Массив;
	
	Для Каждого СтрокаОшибки Из ТаблицаОшибок Цикл
		
		Если МассивОшибок.Найти(СтрокаОшибки.ТекстОшибки) = Неопределено Тогда
			
			МассивОшибок.Добавить(СтрокаОшибки.ТекстОшибки);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивОшибок;
	
КонецФункции 


//}   

&НаКлиенте
Процедура ОткрытьФормуДокументаУчетаМаркировка()
	
	ОбщийМодуль_ВзаимодействиеКонтурМаркировкаКлиент = МодульОбъектаКлиент().ОбщийМодуль1С_КонтурEDI("ВзаимодействиеКонтурМаркировкаКлиент");
	
	Если ОбщийМодуль_ВзаимодействиеКонтурМаркировкаКлиент <> Неопределено Тогда 
		ДокументСодержащийКоды = ОпределитьДокументСодержащийКодыМаркировки();	
		
		Попытка
		    МодульМаркировкиКлиент = ОбщийМодуль_ВзаимодействиеКонтурМаркировкаКлиент.МодульМаркировкиКлиент();
			ДокументУчета = МодульМаркировкиКлиент.НайтиИлиСоздатьДокументУчетаПоДокументу1С(ДокументСодержащийКоды, ЭтаФорма);
			
			ПослеЗакрытия = Новый Структура("Обработчик,Модуль,ДопПараметры");
			ПослеЗакрытия.Обработчик 	= "ОбработчикПослеИсправленияОшибки";
			ПослеЗакрытия.Модуль 		= ЭтаФорма;
			МодульМаркировкиКлиент.ОткрытьФормуДокументаУчета(ДокументУчета, ЭтаФорма, ПослеЗакрытия);
		Исключение
			Попытка
				ОбщийМодуль_ВзаимодействиеКонтурМаркировкаКлиент.ОткрытьФормуДокументаУчетаПоДокументу1С(ДокументСодержащийКоды, ЭтаФорма);
			Исключение
				ОбщийМодуль_ВзаимодействиеКонтурМаркировкаКлиент.ОткрытьФормуДокументаУчетаПоДокументу1С(ДокументСодержащийКоды);
			КонецПопытки;
		КонецПопытки;

	КонецЕсли;   			

КонецПроцедуры

