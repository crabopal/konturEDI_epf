Функция КонтурЛогистика_ПользовательИмеетПравоКПодсистеме() 
	Возврат КонтурЛогистика_ИнтеграцияКонтурСервер().УТекПользователяЕстьПраваКПодсистеме();	
КонецФункции

&НаСервере
Функция КонтурЛогистика_ЕстьПрограммныйИнтерфейсСервер()
	
	МодульКонтурЛогистика_ИнтеграцияКонтурСервер = КонтурЛогистика_ИнтеграцияКонтурСервер();
	ЕстьПрограммныйИнтерфейс = МодульКонтурЛогистика_ИнтеграцияКонтурСервер <> Неопределено;
	
	Возврат ЕстьПрограммныйИнтерфейс;
	
КонецФункции

&НаСервере
Функция КонтурЛогистика_ИнтеграцияКонтурСервер()
	
	МодульКонтурЛогистика_ИнтеграцияКонтурСервер = 
	МодульОбъекта().ОбщийМодуль1С_КонтурEDI("КонтурЛогистика_ИнтеграцияКонтурСервер");
	Возврат МодульКонтурЛогистика_ИнтеграцияКонтурСервер;

КонецФункции

&НаСервере
Процедура КонтурЛогистика_ОбновитьСостояниеЭлементаФормы()
	
	Если КонтурЛогистика_ЕстьПрограммныйИнтерфейсСервер() Тогда
		
		РезультатСтруктура = КонтурЛогистика_СостояниеПоДокументамНаСервере();
		
		Элементы.КонтурЛогистика_ОткрытьПеревозочные.Заголовок = РезультатСтруктура.Заголовок;
		Элементы.КонтурЛогистика_ОткрытьПеревозочные.Картинка = РезультатСтруктура.Картинка;
		ЭтаФорма.Команды.КонтурЛогистика_ОткрытьПеревозочные.Подсказка = РезультатСтруктура.Подсказка;
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Функция КонтурЛогистика_СостояниеПоДокументамНаСервере()
	
	ИсходныеДокументы = КонтурЛогистика_ИсходныеДокументы(Сообщение);
	СтруктураЗадач = КонтурЛогистика_ИнтеграцияКонтурСервер().СостояниеЭПД(ИсходныеДокументы);
	
	Возврат СтруктураЗадач;
	
КонецФункции

&НаСервере
Процедура КонтурЛогистика_НастроитьЭлементыФормы()
	
	Если Сообщение.ТипСообщения = "DESADV"
		ИЛИ Сообщение.ТипСообщения = "INVOIC" Тогда
		
		ЕстьДоступКПодсистеме = КонтурЛогистика_ЕстьПрограммныйИнтерфейсСервер()
									И КонтурЛогистика_ПользовательИмеетПравоКПодсистеме();
									
		Если ЕстьДоступКПодсистеме Тогда
			КонтурЛогистика_ОбновитьСостояниеЭлементаФормы();
			Элементы.КонтурЛогистика_ОткрытьПеревозочные.Видимость = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

////////// Выгрузка данных для диагностики
