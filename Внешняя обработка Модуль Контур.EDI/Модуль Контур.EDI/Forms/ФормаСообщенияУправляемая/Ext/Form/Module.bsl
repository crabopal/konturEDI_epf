&НаКлиенте
Процедура СохранитьФайлаАрхиваВЛокальныйКаталогЗавершение(ВыбранныеФайлы, ДополнительныеПараметры)  Экспорт
	
	УдалитьИзВременногоХранилища(ДополнительныеПараметры.АдресВременногоХранилища);
	
	ИмяФайла = ДополнительныеПараметры.ДиалогВыбораФайла.ПолноеИмяФайла;
	
	Файл = Новый Файл(ИмяФайла);
	
	Если Файл.Существует() Тогда
		Сообщить(НСтр("ru = 'Файл архива сохранен в каталог: '") + ИмяФайла);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СохранитьФайлаАрхиваВЛокальныйКаталог_КонтурEDI(ФайлАрхива)
	
	Если НЕ ЭтоАдресВременногоХранилища(ФайлАрхива.АдресВременногоХранилища) Тогда
		
		ТекстПредупреждения = НСтр("ru = 'Не удалось получить файл с данными. Причина: Отсутствует адрес файла во временном хранилище.'");
		
		МодульОбъектаКлиент().Предупреждение_КонтурEDI(ТекстПредупреждения);
				
		Возврат;
		
	КонецЕсли;
	
	ЗаголовокДиалога = "Укажите каталог, в который нужно сохранить файл архива.";
	Фильтр			 = "Файл архива (*.zip)|*.zip";
	
	ОписаниеФайлаАрхива = Новый ОписаниеПередаваемогоФайла(ФайлАрхива.Имя, 
												  		   ФайлАрхива.АдресВременногоХранилища);
	
	ПолучаемыеФайлы = Новый Массив; 		
	ПолучаемыеФайлы.Добавить(ОписаниеФайлаАрхива);
	
	МодульОбъектаКлиент().ОткрытьДиалогВыбораФайла_КонтурEDI("СохранитьФайлаАрхиваВЛокальныйКаталогЗавершение", 
															  ЭтаФорма,
															  ФайлАрхива,, 
															  Фильтр, 
															  ЗаголовокДиалога, 
															  РежимДиалогаВыбораФайла.Сохранение, 
															  ПолучаемыеФайлы);	
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьДанныеЦепочкиДокументаСообщенияНаСервере()
	
	ВосстановитьТаблицыЗначенийПроизвольныхРеквизитовИзХранилища();
	
	ДокументСсылка = ОпределитьДокументДляПоискаСвязанныхСообщений(Сообщение);
			
	РезультатПодготовки = МодульОбъекта().Диагностика_ПодготовитьДанныеЦепочкиДокументаСообщения(ДокументСсылка, Сообщение);
	
	УничтожитьТаблицыЗначенийПроизвольныхРеквизитов();
	
	Возврат РезультатПодготовки;
	
КонецФункции

&НаКлиенте
Процедура ВыгрузитьДанныеДляДиагностики(Команда)
	
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	РезультатПодготовки = ПодготовитьДанныеЦепочкиДокументаСообщенияНаСервере();
	
	Если РезультатПодготовки.Успешно Тогда
		СохранитьФайлаАрхиваВЛокальныйКаталог_КонтурEDI(РезультатПодготовки.ФайлАрхива);
	Иначе
		МодульОбъектаКлиент().Предупреждение_КонтурEDI(РезультатПодготовки.ТекстОшибки);		
	КонецЕсли;
	
КонецПроцедуры


ВнешнееХранилище = Ложь;
