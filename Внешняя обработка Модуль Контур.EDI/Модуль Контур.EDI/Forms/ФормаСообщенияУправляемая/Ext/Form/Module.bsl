		СписокТипов.Добавить(Тип("ДокументСсылка.ВозвратТоваровОтКлиента")); 
		МодульОбъектаКлиент().ПоказатьВыборЭлемента_КонтурEDI("ОбработкаВыбораТипаДанных", ЭтаФорма, , СписокТипов, , "Выбор типа документа");
