&НаКлиенте
Процедура ДействиеКонтактыНажатие(Элемент)               
              
	НоваяМетрика().НажатаКнопка(Элемент).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	ПредставлениеКонтакты = Элементы.ПредставлениеКонтакты.Заголовок;
	
	СтруктураПараметров	= Новый Структура;
	СтруктураПараметров.Вставить("Заголовок"			, "Контакты по заказу");
	СтруктураПараметров.Вставить("ПодробнаяИнформация"	, ПредставлениеКонтакты);
		
	МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI("Сервис_ПодробнаяИнформация_Управляемая", , СтруктураПараметров, ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПредставлениеКонтактногоЛицаПоЗаказу()
