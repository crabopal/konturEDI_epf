&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)//!!
	
	ИмяКолонки = Поле.Имя;
	
	Если Сообщение.Направление = "Входящее" Тогда
		Если ИмяКолонки = "ТоварыНоменклатура" 
			ИЛИ ИмяКолонки = "ТоварыЕдиницаИзмерения" 
			ИЛИ ИмяКолонки = "ТоварыХарактеристикаНоменклатуры" Тогда
			
			ДанныеСтроки = Элемент.ТекущиеДанные;
						
			ИдентификаторыТовара = ПолучитьСтруктуруИдентификаторовТовара(ДанныеСтроки, Сообщение.ТипСообщения, КтоМы);
			
			СписокВыбора = СоставитьСписокВыбораПоСтрокеТоваровСервер(
			ИдентификаторыТовара.GTIN,
			ИдентификаторыТовара.КодТовараПартнера,
			ИдентификаторыТовара.КодЕдиницыИзмеренияEDI,
			Отправитель1С); 
			
			Если (СписокВыбора.Количество() = 1 И СписокВыбора.НайтиПоЗначению("Настроить соответствие товаров") <> Неопределено) Тогда
				
				ОткрытьНоменклатура_ЭлементУправляемая();
				
			ИначеЕсли ЗначениеЗаполнено(ДанныеСтроки.Номенклатура) ИЛИ КтоМы = "Покупатель" Тогда
								
				ПараметрыОбработчика = Неопределено;
				МодульОбъектаКлиент().ВыбратьИзМеню_КонтурEDI("ОбработчикВыбораСоответствияИзМеню", ЭтаФорма, ПараметрыОбработчика, СписокВыбора, Элемент);
				
			Иначе
				
				ОткрытьФормуПросмотраСоответствий(ДанныеСтроки);
				
			КонецЕсли;
			
			СтандартнаяОбработка = Ложь;
			
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяКолонки = "ТоварыНомерГТДEDI" Тогда
		Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.НомерГТДEDI) Тогда 
			Попытка
				ТекстГТД = ПолучитьНомераГТДПоСтроке(Элемент.ТекущиеДанные.НомерСтроки);
				Если Параметры.МодальностьЗапрещена Тогда 
					Выполнить("ПоказатьПредупреждение(,ТекстГТД,,""Номера ГТД"")");
				Иначе
					Предупреждение(ТекстГТД,,"Номера ГТД");
				КонецЕсли;
			Исключение
			УничтожитьТаблицыЗначенийПроизвольныхРеквизитов();
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	Если ИмяКолонки = "ТоварыКоличествоКВозвратуИПричина1С" Тогда
		Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.КоличествоКВозвратуИПричина1С) Тогда 
			Попытка
				ТекстКоличествоКВозвратуИПричины1С = ПолучитьКоличествоКВозвратуИПричины1С(Элемент.ТекущиеДанные.НомерСтроки);
				Если Параметры.МодальностьЗапрещена Тогда 
					Выполнить("ПоказатьПредупреждение(,ТекстКоличествоКВозвратуИПричины1С,,""Количество к возврату"")");
				Иначе
					Предупреждение(ТекстКоличествоКВозвратуИПричины1С,,"Количество к возврату");
				КонецЕсли;
			Исключение
				УничтожитьТаблицыЗначенийПроизвольныхРеквизитов();
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	Если ИмяКолонки = "ТоварыНеЗагружать" Тогда
		Элемент.ТекущиеДанные.НеЗагружать = НЕ Элемент.ТекущиеДанные.НеЗагружать;
		ПроверитьЗаполнениеПолей();
	КонецЕсли;
	
	Если ИмяКолонки = "ТоварыКодыМаркировкиПредставление"
		ИЛИ ИмяКолонки = "ТоварыКодыМаркировкиДоПредставление" 
		ИЛИ ИмяКолонки = "ТоварыКодыМаркировкиПослеПредставление" Тогда
		
		ИмяКолонкиКодов = СтрЗаменить(ИмяКолонки, "Товары", "");
		ИмяКолонкиКодов = СтрЗаменить(ИмяКолонкиКодов, "Представление", "");
		
		ОткрытьФормуКодовМаркировки(Элементы.Товары.ТекущиеДанные.НомерСтроки, ИмяКолонкиКодов)
				
	КонецЕсли;
	
	Если НЕ ТолькоПросмотрСообщения Тогда
		// покажем меню выбора для списка значений	
		
		ПутьКДаннымКолонки = Сред(ИмяКолонки, 7);
		
		Если ИмяКолонки = "ТоварыЗапрашиваемоеДействие" Тогда 
			
			СтандартнаяОбработка = Ложь;
			МодульОбъектаКлиент().ВыбратьИзМеню_КонтурEDI("ОбработчикВыбораЗапрашиваемоеДействие", ЭтаФорма, , Поле.СписокВыбора, Поле);
			
		ИначеЕсли ИмяКолонки = "ТоварыПричинаВозврата" Тогда 
			
			СтандартнаяОбработка = Ложь;
			МодульОбъектаКлиент().ВыбратьИзМеню_КонтурEDI("ОбработчикВыбораПричинаВозврата", ЭтаФорма, , Поле.СписокВыбора, Поле);
			
		ИначеЕсли ИмяКолонки = "ТоварыРешениеПоВозврату" Тогда
			
			СтандартнаяОбработка = Ложь;
			МодульОбъектаКлиент().ВыбратьИзМеню_КонтурEDI("ОбработчикВыбораРешенияПоВозврату", ЭтаФорма, , Поле.СписокВыбора, Поле);
			
		ИначеЕсли ДоступенВыборИзМенюОсобенностиТоваров(Поле, ПутьКДаннымКолонки) Тогда // здесь должны быть только особенности, но проверим на всякий случай
			
			СтандартнаяОбработка = Ложь;
			
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("ИмяКолонки", ИмяКолонки);
			МодульОбъектаКлиент().ВыбратьИзМеню_КонтурEDI("ОбработчикВыбораОсобенностиТоваров", ЭтаФорма, ДопПараметры, Поле.СписокВыбора, Поле);
			
		ИначеЕсли Элемент.ТекущиеДанные <> Неопределено
			И ТипЗнч(Элемент.ТекущиеДанные[ПутьКДаннымКолонки]) = Тип("СписокЗначений")
			И ЗначениеЗаполнено(Поле.ОграничениеТипа) Тогда
			
			Элемент.ТекущиеДанные[ПутьКДаннымКолонки].ТипЗначения = Поле.ОграничениеТипа;

		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ДоступенВыборИзМенюОсобенностиТоваров(Поле, ПутьКДаннымКолонки)
	
	Результат = МодульОбъектаКлиент().ПеременнаяСодержитСвойство(Поле, "СписокВыбора",, Истина)
										И ИдентификаторыОсобенностейСообщения.НайтиПоЗначению(ПутьКДаннымКолонки) <> Неопределено 
										И Поле.РедактированиеТекста = Ложь;
										
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуКодовМаркировки(НомерСтроки, ИмяКолонки = "КодыМаркировки") Экспорт
	
	ПараметрыФормы = ПолучитьПараметрыФормыКодовМаркировки(ИмяКолонки);
	ПараметрыФормы.СтрокаПозиционирования = НомерСтроки;
	
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ИмяКолонкиКодовМаркировки", ИмяКолонки);
	
	МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI("Сервис_КодыМаркировкиУправляемая",
												 ,
												 ПараметрыФормы,
												 ЭтаФорма,
												 "ОбработчикЗакрытияФормыКодовМаркировки",
												 ЭтаФорма,
												 ПараметрыОповещения);

	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыФормыКодовМаркировки(ИмяКолонки = "КодыМаркировки")
	
	ПараметрыФормы = МодульОбъекта().СтруктураПараметровФормыПросмотраКодовМаркировки();
	ПараметрыФормы.КодыМаркировкиОтредактированыВручную = Ложь;
	ПараметрыФормы.ИмяКолонкиКодовВСообщении = ИмяКолонки;
	
	ВосстановитьТаблицыЗначенийПроизвольныхРеквизитовИзХранилища();
	
	ДеревоУпаковок = РеквизитФормыВЗначение("ТранспортныеУпаковки");

	ПараметрыФормы.АдресКодовМаркировкиТоваров = ПоместитьТаблицуКодовМаркировкиВсехТоваровНаСервере(Истина, ИмяКолонки);
	ПараметрыФормы.АдресДереваУпаковок = ПоместитьВоВременноеХранилище(ДеревоУпаковок, ЭтаФорма.УникальныйИдентификатор);
	ПараметрыФормы.АдресСообщения = ПоместитьКопиюСообщенияВВХ();
	
	Если МодульОбъекта().ПеременнаяСодержитСвойство(Сообщение, "КодыМаркировкиОтредактированыВручную") Тогда
		ПараметрыФормы.КодыМаркировкиОтредактированыВручную = Сообщение.КодыМаркировкиОтредактированыВручную;
	КонецЕсли;
	
	ТолькоПросмотрКодов = Истина;
		
	Если Не ТолькоПросмотрСообщения 
		И Не Сообщение.Направление = "Входящее" Тогда
			
		ТолькоПросмотрКодов = Ложь;
			
	КонецЕсли;
	
	ПараметрыФормы.ТолькоПросмотр = ТолькоПросмотрКодов;
	
	УничтожитьТаблицыЗначенийПроизвольныхРеквизитов();
	
	Возврат ПараметрыФормы;
	
КонецФункции

&НаКлиенте
Процедура ОбработчикЗакрытияФормыКодовМаркировки(РезультатЗакрытия, ДопПараметры = Неопределено) Экспорт
	
	Если Не РезультатЗакрытия = Неопределено Тогда
		
		ИмяКолонкиКодовМаркировки = "КодыМаркировки";
		
		Если ЗначениеЗаполнено(ДопПараметры) И ДопПараметры.Свойство("ИмяКолонкиКодовМаркировки") Тогда
			ИмяКолонкиКодовМаркировки = ДопПараметры.ИмяКолонкиКодовМаркировки;
		КонецЕсли;
		
		ОбработатьРезультатРедактированияКодовМаркировки(РезультатЗакрытия, ИмяКолонкиКодовМаркировки);
		ЗаполнитьПредставлениеКодовМаркировкиТранспортныхУпаковок(ТранспортныеУпаковки, ТолькоПросмотрСообщения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьРезультатРедактированияКодовМаркировки(РезультатРедактирования, КолонкаКодовМаркировки = "КодыМаркировки")
	
	ТаблицаТоваров = РеквизитФормыВЗначение("Товары");
	ТаблицаТранспортныхУпаковок = РеквизитФормыВЗначение("ТранспортныеУпаковки");
	
	Если ТипЗнч(РезультатРедактирования) = Тип("Структура") Тогда
		Сообщение.Вставить("КодыМаркировкиОтредактированыВручную", РезультатРедактирования.КодыМаркировкиОтредактированыВручную);
		РазвернутаяТаблицаКодов = РезультатРедактирования.РазвернутаяТаблицаКодовМаркировки;
	Иначе
		РазвернутаяТаблицаКодов = РезультатРедактирования;
	КонецЕсли;
	
	Для каждого СтрокаТоваров Из ТаблицаТоваров Цикл
		СтрокаТоваров[КолонкаКодовМаркировки].Очистить();
	КонецЦикла;
	
	Для каждого СтрокаУпаковки Из ТаблицаТранспортныхУпаковок.Строки Цикл
		Для каждого СтрокаТовара Из СтрокаУпаковки.Строки Цикл
			СтрокаТовара[КолонкаКодовМаркировки].Очистить();
		КонецЦикла;
	КонецЦикла;
	
	Для каждого ЗаписьРезультата Из РазвернутаяТаблицаКодов Цикл
		
		СтрокаТоваров = ТаблицаТоваров.Найти(ЗаписьРезультата.НомерСтроки, "НомерСтроки");
		Если Не СтрокаТоваров = Неопределено Тогда
			СтрокаТоваров[КолонкаКодовМаркировки].Добавить(ЗаписьРезультата.КодМаркировки, ЗаписьРезультата.ВидКодаМаркировки);
		КонецЕсли;
		
		ОтборСтрокТранспортныхУпаковок = Новый Структура;
		ОтборСтрокТранспортныхУпаковок.Вставить("НомерУпаковки", ЗаписьРезультата.НомерУпаковки);
		ОтборСтрокТранспортныхУпаковок.Вставить("НомерСтроки",ЗаписьРезультата.НомерСтроки);
		
		СтрокиТоваровУпаковок = ТаблицаТранспортныхУпаковок.Строки.НайтиСтроки(ОтборСтрокТранспортныхУпаковок,Истина);
		
		Для каждого СтрокаТовара Из СтрокиТоваровУпаковок Цикл
			СтрокаТовара.КодыМаркировки.Добавить(ЗаписьРезультата.КодМаркировки, ЗаписьРезультата.ВидКодаМаркировки);
		КонецЦикла;
		
	КонецЦикла;
	
	Для каждого СтрокаТовара Из ТаблицаТоваров Цикл
		СтрокаТовара[КолонкаКодовМаркировки + "Представление"]= МодульОбъекта().ПредставлениеКодовМаркировки(СтрокаТовара[КолонкаКодовМаркировки]);
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ТаблицаТоваров, "Товары");
	ЗначениеВРеквизитФормы(ТаблицаТранспортныхУпаковок, "ТранспортныеУпаковки");
	
	ВосстановитьТаблицыЗначенийПроизвольныхРеквизитовИзХранилища();
	ПеренестиПоля1СвСообщение(Сообщение);
	
	ПоместитьТаблицыЗначенийПроизвольныхРеквизитовВХранилище();
	УничтожитьТаблицыЗначенийПроизвольныхРеквизитов(); 
	
	Сообщение.СодержитОшибки = НЕ ПроверитьЗаполнениеПолей();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВыбораОсобенностиТоваров(ВыбранноеЗначение, ДопПараметры = Неопределено) Экспорт
	
	Если ВыбранноеЗначение = Неопределено
		ИЛИ ДопПараметры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы.Товары.ТекущиеДанные;
	ИмяКолонки = Сред(ДопПараметры.ИмяКолонки, 7);
	ТекДанные[ИмяКолонки] =  ВыбранноеЗначение.Значение;
	ПеренестиОсобенностиИПерепроверитьСообщение();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВыбораПричинаВозврата(ВыбранноеЗначение, Параметры = Неопределено) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы.Товары.ТекущиеДанные;
	ТекДанные.ПричинаВозврата = ВыбранноеЗначение.Представление;
	ОбработчикВыбораПричинаВозвратаСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВыбораРешенияПоВозврату(ВыбранноеЗначение, Параметры = Неопределено) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы.Товары.ТекущиеДанные;
	ТекДанные.РешениеПоВозврату = ВыбранноеЗначение.Значение;
	ТекДанные.Количество 		= ?(ТекДанные.РешениеПоВозврату = "В возврате отказано", 0, ТекДанные.КоличествоПредложеноКВозврату);
	ОбработчикВыбораРешенияПоВозвратуСервер();
	
КонецПроцедуры

&НаСервере
Процедура ОбработчикВыбораПричинаВозвратаСервер()
	
	ВосстановитьТаблицыЗначенийПроизвольныхРеквизитовИзХранилища();
	
	ВремТовары = РеквизитФормыВЗначение("Товары");
	Сообщение.Товары.ЗагрузитьКолонку(ВремТовары.ВыгрузитьКолонку("ПричинаВозврата"), "ПричинаВозврата");
	
	ПоместитьТаблицыЗначенийПроизвольныхРеквизитовВХранилище();
	УничтожитьТаблицыЗначенийПроизвольныхРеквизитов();
	
	Сообщение.СодержитОшибки = НЕ ПроверитьЗаполнениеПолей();
	
КонецПроцедуры

&НаСервере
Процедура ОбработчикВыбораРешенияПоВозвратуСервер()
	
	ВосстановитьТаблицыЗначенийПроизвольныхРеквизитовИзХранилища();
	
	ВремТовары = РеквизитФормыВЗначение("Товары");
	Сообщение.Товары.ЗагрузитьКолонку(ВремТовары.ВыгрузитьКолонку("РешениеПоВозврату"), "РешениеПоВозврату");
	Сообщение.Товары.ЗагрузитьКолонку(ВремТовары.ВыгрузитьКолонку("Количество"), 		"Количество");
	
	ПоместитьТаблицыЗначенийПроизвольныхРеквизитовВХранилище();
	УничтожитьТаблицыЗначенийПроизвольныхРеквизитов();
	
	Сообщение.СодержитОшибки = НЕ ПроверитьЗаполнениеПолей();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВыбораЗапрашиваемоеДействие(ВыбранноеЗначение, Параметры = Неопределено) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы.Товары.ТекущиеДанные;
	ТекДанные.ЗапрашиваемоеДействие = ВыбранноеЗначение.Представление;
	ОбработчикВыбораЗапрашиваемоеДействиеСервер();
	
КонецПроцедуры

&НаСервере
Процедура ОбработчикВыбораЗапрашиваемоеДействиеСервер()
	
	ВосстановитьТаблицыЗначенийПроизвольныхРеквизитовИзХранилища();
	
	ВремТовары = РеквизитФормыВЗначение("Товары");
	Сообщение.Товары.ЗагрузитьКолонку(ВремТовары.ВыгрузитьКолонку("ЗапрашиваемоеДействие"), "ЗапрашиваемоеДействие");
	
	ПоместитьТаблицыЗначенийПроизвольныхРеквизитовВХранилище();
	УничтожитьТаблицыЗначенийПроизвольныхРеквизитов();
	
	Сообщение.СодержитОшибки = НЕ ПроверитьЗаполнениеПолей();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикПослеИнтерактивнойНастройкиСоответствий(ВыбранноеЗначение, Параметры) Экспорт
	
	ТекСтрока = Элементы.Товары.ТекущиеДанные;
	ИдентификаторТекСтроки = ТекСтрока.ПолучитьИдентификатор();
	
	ОбработчикПослеИнтерактивнойНастройкиСоответствийСервер(ИдентификаторТекСтроки);
	
	ЗаполнитьТоварнуюГруппуТаблицыТоваровВызовСервера();
		
КонецПроцедуры

&НаСервере
Процедура ОбработчикПослеИнтерактивнойНастройкиСоответствийСервер(ИдентификаторТекСтроки)
	
	ВыбраннаяСтрока = Товары.НайтиПоИдентификатору(ИдентификаторТекСтроки);
	ИдентификаторыТовара = ПолучитьСтруктуруИдентификаторовТовара(ВыбраннаяСтрока, Сообщение.ТипСообщения, КтоМы);
	
	РезультатПолученияСоответствий = 
	МодульОбъекта().НайтиВозможныеСоответствияТовара_ВходящееСообщение(
	ИдентификаторыТовара.GTIN, 
	ИдентификаторыТовара.КодТовараПартнера, 
	ИдентификаторыТовара.КодЕдиницыИзмеренияEDI,
	Сообщение.Партнер);
	
	СоответствиеТоваров = РезультатПолученияСоответствий.ТаблицаСоответствий;
	
	Если НЕ ЗначениеЗаполнено(ВыбраннаяСтрока.Номенклатура) Тогда
				
		УстановитьОсновноеСоответствиеВСтрокуТоваров(ВыбраннаяСтрока, СоответствиеТоваров); 
		
	Иначе
		
		ПоискУстановленногоСоответствия = Новый Структура("Номенклатура,ХарактеристикаНоменклатуры,ЕдиницаИзмерения,КоэффициентEDIВ1С");
		ЗаполнитьЗначенияСвойств(ПоискУстановленногоСоответствия, ВыбраннаяСтрока);
		
		НайденныеСоответствия = СоответствиеТоваров.НайтиСтроки(ПоискУстановленногоСоответствия);
		
		Если НайденныеСоответствия.Количество() = 0 Тогда
			
			ВыбраннаяСтрока.Номенклатура = Неопределено;
			ВыбраннаяСтрока.ХарактеристикаНоменклатуры = Неопределено;
			ВыбраннаяСтрока.ЕдиницаИзмерения = Неопределено;
			ВыбраннаяСтрока.КоэффициентEDIВ1С = 0;      			
			
			УстановитьОсновноеСоответствиеВСтрокуТоваров(ВыбраннаяСтрока, СоответствиеТоваров);
			
		КонецЕсли;
		
	КонецЕсли;
		
	ПроверитьЗаполнениеПолей();
	
	//дозаполним код, артикул, ПолноеНаименование
	ДозаполнитьАртикулКодПолноеНаименованиеТЧТовары();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОсновноеСоответствиеВСтрокуТоваров(Знач ВыбраннаяСтрока, Знач СоответствиеТоваров)
	
	Перем ЗаполняемыеСвойства, СтрокаСоответствий, ТекстПересчета;
	
	Для Каждого СтрокаСоответствий Из СоответствиеТоваров Цикл
		
		Если СтрокаСоответствий.ПолеНесоответствия = Неопределено Тогда
			
			ЗаполняемыеСвойства = "Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения, КоэффициентEDIВ1С, ТипЕдиницы";
			ЗаполнитьЗначенияСвойств(ВыбраннаяСтрока, СтрокаСоответствий, ЗаполняемыеСвойства);
			
			ТекстПересчета = МодульОбъекта().ТекстПересчета_КонтурEDI(СтрокаСоответствий.ЕдиницаИзмерения, СтрокаСоответствий.ЕдиницаEDI, СтрокаСоответствий.КоэффициентEDIВ1С);
			
			ВыбраннаяСтрока.ТекстПересчета = ТекстПересчета;
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВыбораСоответствияИзМеню(ВыбранноеЗначение, ДопПараметры) Экспорт//!
	
	Если НЕ ВыбранноеЗначение = Неопределено Тогда
		Если ВыбранноеЗначение.Значение = "Настроить соответствие товаров" Тогда
			
			ОткрытьНоменклатура_ЭлементУправляемая(); 
						
		Иначе
			
			СтруктураТовара = ВыбранноеЗначение.Значение;
			
			ЗаполнитьЗначенияСвойств(Элементы.Товары.ТекущиеДанные,СтруктураТовара,"Номенклатура,ХарактеристикаНоменклатуры,ЕдиницаИзмерения,КоэффициентEDIВ1С,ТипЕдиницы,ТекстПересчета");
			
			ОчиститьСообщения();//на рефакторинг - перетащить к пометкам
			ПроверитьЗаполнениеПолей();
			
			//дозаполним код, артикул, ПолноеНаименование
			ДозаполнитьАртикулКодПолноеНаименованиеТЧТовары();
			
			ЗаполнитьТоварнуюГруппуТаблицыТоваровВызовСервера();
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНоменклатура_ЭлементУправляемая()
	
	ТекСтрока = Элементы.Товары.ТекущиеДанные;
	ИдентификаторыТовара = ПолучитьСтруктуруИдентификаторовТовара(ТекСтрока, Сообщение.ТипСообщения, КтоМы);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Партнер", Отправитель1С);
	ПараметрыФормы.Вставить("Наименование", ТекСтрока.Наименование);
	ПараметрыФормы.Вставить("GTIN", ИдентификаторыТовара.GTIN);
	ПараметрыФормы.Вставить("КодТовараПартнера", ИдентификаторыТовара.КодТовараПартнера);
	ПараметрыФормы.Вставить("КодТовараВнутренний", ИдентификаторыТовара.КодТовараВнутренний);
	ПараметрыФормы.Вставить("КодЕдиницыИзмеренияEDI", ТекСтрока.КодЕдиницыИзмеренияEDI);
	
	Если ЗначениеЗаполнено(ТекСтрока.ТипЕдиницы) Тогда
		ПараметрыФормы.Вставить("ТипЕдиницы", ТекСтрока.ТипЕдиницы);
	КонецЕсли;
	
	МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI("Номенклатура_ЭлементУправляемая", , ПараметрыФормы, ЭтаФорма, "ОбработчикПослеИнтерактивнойНастройкиСоответствий", ЭтаФорма);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТоварнуюГруппуТаблицыТоваровВызовСервера()

	МодульОбъекта().ОбработкаСобытияПодключаемогоМодуля("ЗаполнитьТоварнуюГруппуТаблицыТоваров",,Новый Структура("Сообщение,Товары",Сообщение,Товары));

КонецПроцедуры // ЗаполнитьТоварнуюГруппуТаблицыТоваровВызовСервера()


&НаКлиенте
Процедура ОбработчикПослеВводаДаты(ВыбраннаяДата, ПараметрыЗакрытия) Экспорт
	Если НЕ ВыбраннаяДата = Неопределено Тогда
		
		//+для АТАК
		Если Сообщение.Свойство("ДатаПоставкиФактическая") Тогда
			ДатаПоставкиФактическая = ВыбраннаяДата;
			Сообщение.ДатаПоставкиФактическая = ВыбраннаяДата;
			Элементы.ПредставлениеДатыПоставки.Заголовок = МодульОбъектаКлиент().ПолучитьПредставлениеДатыПоставки_КонтурEDI(Сообщение.ДатаПоставкиФактическая);
		КонецЕсли;
		//-
			
		Если Сообщение.ТипСообщения = "ORDRSP" 
			И Не ВыбраннаяДата = Сообщение.ДатаПоставки
			И ЗначениеЗаполнено(Сообщение.ДокументСсылка) Тогда
			ДополнитьТаблицуИзмененныхРеквизитов("ДатаПоставки", ВыбраннаяДата);
			ПерезаполнитьИсходящееСообщение();
		Иначе	
			ДатаПоставки = ВыбраннаяДата;
			Сообщение.ДатаПоставки = ВыбраннаяДата;
			Элементы.ПредставлениеДатыПоставки.Заголовок = МодульОбъектаКлиент().ПолучитьПредставлениеДатыПоставки_КонтурEDI(Сообщение.ДатаПоставки);
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

