&НаСервере
Перем МодульОбъекта;

&НаКлиенте
Перем МодульОбъектаКлиент;

// СЛУЖЕБНЫЕ {

&НаСервере
Функция ПутьКФормамМеркурий()

	Возврат СтрЗаменить(МодульОбъекта().ВнешнийМодульМеркурий, "ВнешняяОбработкаОбъект", "ВнешняяОбработка") + ".Форма.";

КонецФункции

&НаКлиенте
Функция МодульМеркурийКлиент()

	ПутьКФормамМеркурий = ПутьКФормамМеркурий();
	
	ПараметрыФ = Объект.ПараметрыКлиентСервер;
	ПараметрыФ.Вставить("ПутьКФормамМеркурий", ПутьКФормамМеркурий);

	Если Не ПутьКФормам = Неопределено Тогда
		Возврат ПолучитьФорму(ПутьКФормамМеркурий + "КлиентскийМодульEDI_Управляемая", ПараметрыФ);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Инициализация модуля и его экспортных функций
&НаСервере
Функция МодульОбъекта()
	
	Если МодульОбъекта = Неопределено Тогда
		
		Если Объект.ПараметрыКлиентСервер.КэшироватьОбработкуОбъект Тогда
			МодульОбъекта = МодульОбъектаИзКэша();
		КонецЕсли;
		
		Если МодульОбъекта = Неопределено Тогда
			МодульОбъекта = РеквизитФормыВЗначение("Объект");
			МодульОбъекта.ИнициализироватьПодключаемыеМодули(); // TODO Проверить что из этого используется на формах и перенести в ПараметрыКлиентСервер
			МодульОбъекта.ОбновитьКэшМодуляОбъекта();
		КонецЕсли;
		
	КонецЕсли;	
	
	Возврат МодульОбъекта;
	
КонецФункции

&НаСервере
Функция МодульОбъектаИзКэша()
	
	Результат = Неопределено;
	
	Если ТипЗнч(Объект.ПараметрыКлиентСервер) = Тип("Структура") Тогда
		АдресВХ = Объект.ПараметрыКлиентСервер.АдресаВХ.ОбработкаОбъект;
 		Если ЭтоАдресВременногоХранилища(АдресВХ) Тогда
			Структура = ПолучитьИзВременногоХранилища(АдресВХ);
			Если ТипЗнч(Структура) = Тип("Структура") и Структура.Свойство("ОбработкаОбъект") Тогда
			 	Результат = Структура.ОбработкаОбъект;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция МодульОбъектаКлиент()
	
	Если ТипЗнч(МодульОбъектаКлиент) = Тип("УправляемаяФорма") Тогда
		Возврат МодульОбъектаКлиент;
	КонецЕсли;
	
	ОсновнаяФорма = ОсновнаяФорма();
	Если ТипЗнч(ОсновнаяФорма) = Тип("УправляемаяФорма") Тогда
		МодульОбъектаКлиент = ОсновнаяФорма.МодульОбъектаКлиент();
		Возврат МодульОбъектаКлиент;
	Иначе
		Сообщить("Ошибка! Не удалось получить контекст основной формы.");
	КонецЕсли;
	          	
КонецФункции

&НаКлиенте
Функция ОсновнаяФорма() Экспорт
	
	Если ЭтаФорма.ВладелецФормы = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		Возврат ЭтаФорма.ВладелецФормы.ОсновнаяФорма();
	КонецЕсли;
    	
КонецФункции

&НаКлиенте
Функция НоваяМетрика()
	
	Возврат ОсновнаяФорма().НоваяМетрика();
	
КонецФункции

// } СЛУЖЕБНЫЕ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ОбъектПараметрыКлиентСервер", 			Объект.ПараметрыКлиентСервер);
	Параметры.Свойство("ОбъектПараметрыКлиентСерверМетрика", 	Объект.ПараметрыКлиентСерверМетрика);
	
	ДокументСсылка 	= Параметры.ДокументСсылка;
	СообщениеСсылка = Параметры.СообщениеСсылка;
		
    ОбновитьДеревоДокументов();
	
	Если ДеревоДокументов.ПолучитьЭлементы().Количество() = 0 
		И ДеревоПредыдущихЗаказов.ПолучитьЭлементы().Количество() = 0 Тогда
		
		Сообщить("Не удалось найти связанные сообщения!");
		Отказ = Истина;
		СтандартнаяОбработка = Ложь;
		
	КонецЕсли;
	
	Параметры.МодальностьЗапрещена= МодульОбъекта().МодальностьЗапрещена();

	Элементы.СтраницаПредварительныеЗаказы.Видимость = (ДеревоПредыдущихЗаказов.ПолучитьЭлементы().Количество() > 0);
	
	Если ДеревоДокументов.ПолучитьЭлементы().Количество() = 0 И Элементы.СтраницаПредварительныеЗаказы.Видимость Тогда
		Элементы.Панель1.ТекущаяСтраница =  Элементы.СтраницаПредварительныеЗаказы;
	КонецЕсли;
	
	ПутьКФормам = МодульОбъекта().Метаданные().ПолноеИмя() + ".Форма.";
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДеревоДокументов()
	
	ДокументСсылка 	= Параметры.ДокументСсылка;
	СообщениеСсылка = Параметры.СообщениеСсылка;
	
	Если ЗначениеЗаполнено(ДокументСсылка) Тогда
		ДеревоДокументов1 = МодульОбъекта().ПолучитьСвязанныеСообщения(СообщениеСсылка, ДокументСсылка);
		
		УстановитьИконкиПодстрок(ДеревоДокументов1); 
		
		ЗначениеВРеквизитФормы(ДеревоДокументов1, "ДеревоДокументов");
		
		
		Если МодульОбъекта().НастройкиМодуля.МыПоставщик И ЗначениеЗаполнено(ДокументСсылка)
				И ТипЗнч(ДокументСсылка) = Тип(МодульОбъекта().ПолучитьТипЗначенияОбъекта("ВходящийЗаказПокупателя"))
				Тогда
				//покажем вторую закладку и кнопку
				Элементы.ДеревоДокументовКоманднаяПанельСообщенийОтвязатьДокумент.Доступность = Истина;
				Элементы.СтраницаДокументыДляПривязки.Видимость = Истина;
				
				ДатаНач = ДокументСсылка.Дата;
				ДатаКон = ДокументСсылка.Дата;
				
				КоманднаяПанельПохожихДокументовОбновитьСервер();
			Иначе                          
				//скроем вторую закладку и кнопку
				Элементы.ДеревоДокументовКоманднаяПанельСообщенийОтвязатьДокумент.Доступность = Ложь;
				Элементы.СтраницаДокументыДляПривязки.Видимость = Ложь;
			КонецЕсли;
		КонецЕсли;  	
	    
	
	Если Не ЗначениеЗаполнено(СообщениеСсылка) Тогда
		
		СтруктураПредыдущегоСообщения = МодульОбъекта().ПолучитьПредыдущееВходящееСообщение(,ДокументСсылка);
		
		Если ЗначениеЗаполнено(СтруктураПредыдущегоСообщения) Тогда
			СообщениеСсылка = СтруктураПредыдущегоСообщения.СообщениеСсылка;
		КонецЕсли;   		
		
	КонецЕсли;  
	
	ДеревоПредыдущихЗаказовЗначение = Неопределено;
	
	Если ЗначениеЗаполнено(СообщениеСсылка) Тогда
		
		Если Найти(СообщениеСсылка.Статус, "Предварительный") = 0 Тогда
			
			ДеревоПредыдущихЗаказовЗначение = МодульОбъекта().ПолучитьДеревоПредыдущихЗаказов(СообщениеСсылка, ДокументСсылка); 
			
			Элементы.СтраницаПредварительныеЗаказы.Заголовок = "Предварительные заказы";  
			
		Иначе
		
			Если СообщениеСсылка.ТипСообщения = "ORDERS" Тогда
				СтруктураСообщения = МодульОбъекта().ПрочитатьСообщение(СообщениеСсылка); 
			Иначе
				СообщениеСсылкаORDERS = МодульОбъекта().НайтиСообщениеДокумента(СообщениеСсылка.Документ, "ORDERS");
				СтруктураСообщения = МодульОбъекта().ПрочитатьСообщение(СообщениеСсылкаORDERS);
			КонецЕсли; 		
			
			Если ТипЗнч(СтруктураСообщения) = Тип("Структура")
				И СтруктураСообщения.Свойство("ОсновнойЗаказДляПредварительных") 
				И ТипЗнч(СтруктураСообщения.ОсновнойЗаказДляПредварительных) = Тип("СправочникСсылка.КонтурEDI_Сообщения")
				И ЗначениеЗаполнено(СтруктураСообщения.ОсновнойЗаказДляПредварительных) Тогда
				
				ОсновнойORDERSСсылка = СтруктураСообщения.ОсновнойЗаказДляПредварительных;
				ДокументORDERSСсылка = ОсновнойORDERSСсылка.Документ;
				
				ДеревоПредыдущихЗаказовЗначение = МодульОбъекта().ПолучитьСвязанныеСообщения(ОсновнойORDERSСсылка, ДокументORDERSСсылка);
				
				Элементы.СтраницаПредварительныеЗаказы.Заголовок = "Основной заказ";
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

	Если ТипЗнч(ДеревоПредыдущихЗаказовЗначение) = Тип("ДеревоЗначений") Тогда
		
		УстановитьИконкиПодстрок(ДеревоПредыдущихЗаказовЗначение);  	
		ЗначениеВРеквизитФормы(ДеревоПредыдущихЗаказовЗначение, "ДеревоПредыдущихЗаказов");
		
	КонецЕсли;      
	
КонецПроцедуры

&НаСервере
Процедура КоманднаяПанельПохожихДокументовОбновитьСервер()
	
	ТаблицаПохожихДокументов1 = МодульОбъекта().ПолучитьТаблицуДокументовДляПривязки_к_ORDERS(ДокументСсылка,ДатаНач,ДатаКон);
	ЗначениеВРеквизитФормы(ТаблицаПохожихДокументов1, "ТаблицаПохожихДокументов");

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДерево(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	ОбновитьДеревоДокументов();
	
	РазвернутьУзлыДерева();
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьУзлыДерева()
    КоллекцияЭлементовДерева =  ДеревоДокументов.ПолучитьЭлементы();
                                    
    //Развернуть дерево 
 
    Для Каждого Строка Из КоллекцияЭлементовДерева Цикл    
        ИдентификаторСтроки = Строка.ПолучитьИдентификатор();
        Элементы.ДеревоДокументов.Развернуть(ИдентификаторСтроки, Истина);
    КонецЦикла;   
КонецПроцедуры

&НаКлиенте
Процедура ДеревоДокументовПредставлениеОткрытие(Элемент, СтандартнаяОбработка)
	
	ТекДанные = Элементы.ДеревоДокументов.ТекущиеДанные;
	ОткрытьФормуТекущейСтроки(ТекДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЭлемент(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	ТекДанные = Элементы.ДеревоДокументов.ТекущиеДанные;
	ОткрытьФормуТекущейСтроки(ТекДанные);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьИконкиПодстрок(Дерево)
Для Каждого Подстрока Из Дерево.Строки Цикл

//обработка подстроки 
  	Если Подстрока.Вид = "Сообщение" Тогда
		Если Подстрока.Направление = "Входящее" Тогда
			Подстрока.Иконка=0;
		Иначе
			Подстрока.Иконка=1;
		КонецЕсли;
		//Если Подстрока.Ссылка = СообщениеСсылка Тогда
		//	УСЛОВНОЕ ОФОРМЛЕНИЕ			
		//КонецЕсли;
	ИначеЕсли Подстрока.Вид = "ГруппаСообщений" Тогда
			Подстрока.Иконка=5;
	ИначеЕсли Подстрока.Вид = "Документ" Тогда
		Если Подстрока.Проведен = Истина Тогда
			Подстрока.Иконка=2;
		ИначеЕсли Подстрока.ПометкаУдаления = Истина Тогда
			Подстрока.Иконка=4;
		Иначе
			Подстрока.Иконка=3;
		КонецЕсли;
		//Если Подстрока.Ссылка = Параметры.ДокументСсылка и не ЗначениеЗаполнено(Параметры.СообщениеСсылка) Тогда
		//	УСЛОВНОЕ ОФОРМЛЕНИЕ			
		//КонецЕсли;
	КонецЕсли;	

//
УстановитьИконкиПодстрок(Подстрока);

КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоДокументовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элементы.ДеревоДокументов.ТекущиеДанные;
	
	ОткрытьФормуТекущейСтроки(ТекДанные);
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуТекущейСтроки(ТекДанные)
	
	Если НЕ ТекДанные = Неопределено Тогда
		Если ТекДанные.Иконка = 2
			или ТекДанные.Иконка = 3
			или ТекДанные.Иконка = 4
			Тогда  //документ
			
			НоваяМетрика().Категория("СвязанныеСообщения").Выбор("Документ").НаФорме(ЭтаФорма)
			.ДобавитьПеременную("Документ.Представление", ТекДанные.Представление).ПоместитьВОчередь();
			
			Состояние("Открываю форму документа");
			Если Параметры.МодальностьЗапрещена Тогда
				Выполнить("ПоказатьЗначение(,ТекДанные.Ссылка)"); 
			Иначе
				ОткрытьЗначение(ТекДанные.Ссылка);
			КонецЕсли;

		Иначе
			НоваяМетрика().Категория("СвязанныеСообщения").Выбор("Сообщение").НаФорме(ЭтаФорма)
			.ДобавитьПеременную("Сообщение.Представление", ТекДанные.Представление).ПоместитьВОчередь();
			
			Если ЗначениеЗаполнено(ТекДанные.Ссылка) Тогда
				Если ТипСообщенияДоступенСервер(ТекДанные.ТипСообщения) Тогда
					
					Состояние("Открываю форму сообщения");
					СсылкаНаСообщение = ТекДанные.Ссылка;	
					
					Если Лев(ТекДанные.ТипСообщения,2) = "M_" Тогда // Это сообщение Меркурия
						ВыбраннаяСтрока = Новый Структура;
						ВыбраннаяСтрока.Вставить("ТребуемоеДействие", 	"Распечатать ВСД");
						ВыбраннаяСтрока.Вставить("СообщениеСсылка", 	СсылкаНаСообщение);
						ВыбраннаяСтрока.Вставить("ТипСообщения", 		ТекДанные.ТипСообщения);
						ВыбраннаяСтрока.Вставить("Документ", 			ПолучитьРеквизитСсылки(СсылкаНаСообщение,"Документ"));
						
						ФормаМеркурийКлиент = МодульМеркурийКлиент();
						Если Не ФормаМеркурийКлиент = Неопределено Тогда
							ФормаМеркурийКлиент.ОткрытьКарточкуМеркурий(ВыбраннаяСтрока);
						КонецЕсли;
					Иначе
						ПараметрыФормы = Новый Структура;
						ПараметрыФормы.Вставить("СообщениеСсылка",	СсылкаНаСообщение);
						ПараметрыФормы.Вставить("ТипСообщения",		ПолучитьРеквизитСсылки(СсылкаНаСообщение,"ТипСообщения"));
						ПараметрыФормы.Вставить("Направление",		ПолучитьРеквизитСсылки(СсылкаНаСообщение,"Направление"));
						ПараметрыФормы.Вставить("Документ1С",		ПолучитьРеквизитСсылки(СсылкаНаСообщение,"Документ"));
						ПараметрыФормы.Вставить("РежимРаботы",		Параметры.РежимРаботы);
						ПараметрыФормы.Вставить("ТолькоПросмотр",	истина);
						
						МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI("ФормаСообщенияУправляемая", , ПараметрыФормы, ЭтаФорма);
					КонецЕсли;
					
				Иначе
					ТекстПредупреждения = "Недостаточно прав для работы с сообщением";
					Если Параметры.МодальностьЗапрещена Тогда 
						Выполнить("ПоказатьПредупреждение(,ТекстПредупреждения,,""Контур.EDI"")");
					Иначе
						Предупреждение(ТекстПредупреждения,,"Контур.EDI");
					КонецЕсли;
				КонецЕсли;	
			КонецЕсли;	
			
			ОбновитьДеревоДокументов();
			РазвернутьУзлыДерева();
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ТипСообщенияДоступенСервер(ТипСообщения)
	
	Возврат МодульОбъекта().ТипСообщенияДоступенПользователюEDI(ТипСообщения);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьРеквизитСсылки(СсылкаНаСообщение,ИмяРеквизита)
	ЗначениеРеквизита=неопределено;
	Выполнить("ЗначениеРеквизита=СсылкаНаСообщение."+ИмяРеквизита);
	Возврат ЗначениеРеквизита;
	
КонецФункции


&НаКлиенте
Процедура КоманднаяПанельПохожихДокументовОткрыть(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	ОткрытьПохожиеДокументы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПохожиеДокументы()
	
	Если Элементы.ТаблицаПохожихДокументов.ТекущиеДанные<>Неопределено и ЗначениеЗаполнено(Элементы.ТаблицаПохожихДокументов.ТекущиеДанные.Ссылка) тогда
		
		ТекСсылка = Элементы.ТаблицаПохожихДокументов.ТекущиеДанные.Ссылка;
		Если Параметры.МодальностьЗапрещена Тогда
			Выполнить("ПоказатьЗначение(,ТекСсылка)"); 
		Иначе
			ОткрытьЗначение(ТекСсылка);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТипЗначенияОбъектаВызовСервера(НазваниеОбъектаEDI)
	Возврат МодульОбъекта().ПолучитьТипЗначенияОбъекта(НазваниеОбъектаEDI);
КонецФункции

&НаКлиенте
Процедура КоманднаяПанельСообщенийОтвязатьДокумент(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	ТекСтрока = Элементы.ДеревоДокументов.ТекущиеДанные;
	
	Если НЕ ТекСтрока = Неопределено Тогда
		
		ТипВходящийЗаказПокупателя = ПолучитьТипЗначенияОбъектаВызовСервера("ВходящийЗаказПокупателя");
		
		Если ТекСтрока.Вид = "Документ"
			И ЗначениеЗаполнено(ТипВходящийЗаказПокупателя)
			И ТипЗнч(ТекСтрока.Ссылка) = Тип(ТипВходящийЗаказПокупателя) Тогда
			
			ОтвязываемыйДокумент = ТекСтрока.Ссылка;
			
			Если ОтвязываемыйДокумент=ДокументСсылка Тогда
				ТекстПредупреждения="Нельзя отвязывать текущий документ";
				Если Параметры.МодальностьЗапрещена Тогда 
					Выполнить("ПоказатьПредупреждение(,ТекстПредупреждения,,""Контур.EDI"")");
				Иначе
					Предупреждение(ТекстПредупреждения,,"Контур.EDI");
				КонецЕсли;
				Возврат;
			КонецЕсли;	
			
			ТекстВопроса ="Отвязать от данного заказа документ "+ОтвязываемыйДокумент+"?";
			КнопкиВопроса=новый СписокЗначений;
			КнопкиВопроса.Добавить("Отвязать");
			КнопкиВопроса.Добавить("Отмена");
			ДопПараметрДляПередачиВОбработчик=новый Структура;
			ДопПараметрДляПередачиВОбработчик.Вставить("ОтвязываемыйДокумент",ОтвязываемыйДокумент);
			РезультатВопроса = Неопределено;
			
			Если Параметры.МодальностьЗапрещена Тогда
				Выполнить("ПоказатьВопрос(Новый ОписаниеОповещения(""ОбработчикСогласияОтвязкиДокумента"", ЭтаФорма, ДопПараметрДляПередачиВОбработчик), ТекстВопроса, КнопкиВопроса,,,""Контур.EDI"")");
			Иначе
				РезультатВопроса = Вопрос(ТекстВопроса, КнопкиВопроса,,,"Контур.EDI");
				ОбработчикСогласияОтвязкиДокумента(РезультатВопроса,ДопПараметрДляПередачиВОбработчик);
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикСогласияОтвязкиДокумента(РезультатВопроса,ДопПараметрДляПередачиВОбработчик) Экспорт
	
	Если РезультатВопроса="Отвязать" Тогда 	
		ОтвязываемыйДокумент=ДопПараметрДляПередачиВОбработчик.ОтвязываемыйДокумент;
		УбратьВиртуальныйORDERSВызовСервера(ОтвязываемыйДокумент);
		
	КонецЕсли;
	
	ОбновитьДеревоДокументов();
	
КонецПроцедуры

&НаСервере
Процедура УбратьВиртуальныйORDERSВызовСервера(ОтвязываемыйДокумент)
	
	ТабВиртуальныхСообщений = МодульОбъекта().ПолучитьВиртуальныеСвязанныеORDERS(ОтвязываемыйДокумент);
	
	Если ТабВиртуальныхСообщений.Количество()=1 Тогда
		Сообщить("Это единственный привязанный документ, его невозможно отвязать");
		Возврат;
	КонецЕсли;	
	МодульОбъекта().УбратьВиртуальныйORDERS(ОтвязываемыйДокумент);
	
КонецПроцедуры // УбратьВиртуальныйORDERSВызовСервера()

&НаКлиенте
Процедура ОбновитьПохожиеДокументы()
	
	Состояние("Строю список похожих документов 1С за период...",50,,);
	КоманднаяПанельПохожихДокументовОбновитьСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура КоманднаяПанельПохожихДокументовОбновить(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	ОбновитьПохожиеДокументы();
	
КонецПроцедуры

&НаКлиенте
Процедура КоманднаяПанельСообщенийПривязатьНакладную(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	ТекСтрока = Элементы.ТаблицаПохожихДокументов.ТекущиеДанные;
	
	Если ТекСтрока=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДокументДляПривязки = ТекСтрока.Ссылка;
	//создаем копию ORDERS.
	
	ДобавитьВиртуальныйORDERSВызовСервера(ДокументСсылка,ДокументДляПривязки);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьВиртуальныйORDERSВызовСервера(ТекущийДокумент,ДокументДляПривязки) Экспорт//ТекущийДокумент,ПривязываемыйДокумент
	
	СтруктураРезультата = Новый Структура;
	СтруктураРезультата.Вставить("Успешно", Истина);
	СтруктураРезультата.Вставить("ОписаниеОшибки", "");
	
	Сообщение = МодульОбъекта().ПрочитатьСообщение(СообщениеСсылка);
	
	Если Сообщение.Направление = "Входящее" Тогда  
		
		МодульОбъекта().КонвертироватьСообщениеEDIв1С(Сообщение,Истина);
		
	КонецЕсли;
	
	Если НЕ МодульОбъекта().НайтиСообщениеДокумента(ДокументДляПривязки, Сообщение.ТипСообщения) = Неопределено Тогда
		
		СтруктураРезультата.ОписаниеОшибки = "К данному документу уже привязано другое сообщение " + Сообщение.ТипСообщения;
		СтруктураРезультата.Успешно = Ложь;
		
	Иначе
		
		РезультатПроверки = МодульОбъекта().ОбработкаСобытияПодключаемогоМодуля("ПередСвязываниемСообщенияСДокументомЧерезФорму", ,
		Новый Структура("Документ, Сообщение, Форма", 
		ДокументДляПривязки, Сообщение, Сообщение));
		
		Если РезультатПроверки <> Неопределено
			И НЕ РезультатПроверки.Успешно Тогда
			
			СтруктураРезультата.ОписаниеОшибки = РезультатПроверки.ОписаниеОшибки;
			
		КонецЕсли;
		
	КонецЕсли;     
	
	Если СтруктураРезультата <> Неопределено
		И НЕ СтруктураРезультата.Успешно Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтруктураРезультата.ОписаниеОшибки;
		Сообщение.Сообщить();
		
		Возврат;
		
	КонецЕсли;
	
	МодульОбъекта().ДобавитьВиртуальныйORDERS(ТекущийДокумент,ДокументДляПривязки);
	
	ОбновитьДеревоДокументов();//перерисовать
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачПриИзменении(Элемент)
	Если ДатаНач>ДатаКон Тогда 
		ДатаНач = ДатаКон;
	КонецЕсли;	
	
	ОбновитьПохожиеДокументы();
КонецПроцедуры

&НаКлиенте
Процедура ДатаКонПриИзменении(Элемент)
	Если ДатаКон<ДатаНач Тогда 
		ДатаКон = ДатаНач;
	КонецЕсли;	
	
	ОбновитьПохожиеДокументы();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПохожихДокументовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПохожихДокументовПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПохожихДокументовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ОткрытьПохожиеДокументы();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОсновнаяФорма().ПриОткрытииФормы(ЭтаФорма, "Сервис_СвязанныеСообщенияУправляемая");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	
	ОсновнаяФорма = ОсновнаяФорма();
	
	Если ОсновнаяФорма <> Неопределено Тогда
		
		ОсновнаяФорма.ПриЗакрытииФормы(ЭтаФорма, "Сервис_СвязанныеСообщенияУправляемая");
		
	КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПредварительныйЗаказ(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
		
	ТекДанные = Элементы.ДеревоПредыдущихЗаказов.ТекущиеДанные;
	
	ОткрытьФормуТекущейСтроки(ТекДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПредыдущихЗаказовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элементы.ДеревоПредыдущихЗаказов.ТекущиеДанные;
	
	ОткрытьФормуТекущейСтроки(ТекДанные);
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры


