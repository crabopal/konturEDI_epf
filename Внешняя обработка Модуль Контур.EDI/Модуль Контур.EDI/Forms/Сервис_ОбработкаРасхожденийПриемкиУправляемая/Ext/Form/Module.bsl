&НаКлиенте
Функция ЕстьВсеСоответствия()
	//если у нас нет хотя бы одного соответствия товаров, то мы не сможем корректно заполнить реализацию, возврат или КСФ
	ФлагОтмены = Ложь;
	Для Каждого Стр1 Из Таб.ПолучитьЭлементы() Цикл
		Если Стр1.ГруппаНоменклатур Тогда
		Для Каждого Стр2 Из Стр1.ПолучитьЭлементы() Цикл
			Если ТипЗнч(Стр2.Номенклатура)<>Тип("СправочникСсылка.Номенклатура") 
				Или Не ЗначениеЗаполнено(Стр2.Номенклатура) Тогда
				ФлагОтмены = Истина;
				Сообщить("Не назначено соответствие для наименования сети: "+Стр2.Номенклатура);
			КонецЕсли;	
		КонецЦикла;	
		
		ИначеЕсли ТипЗнч(Стр1.Номенклатура)<>Тип("СправочникСсылка.Номенклатура") 
			Или Не ЗначениеЗаполнено(Стр1.Номенклатура) Тогда
			ФлагОтмены = Истина;
			Сообщить("Не назначено соответствие для наименования сети: "+Стр1.Номенклатура);
		КонецЕсли;	
	КонецЦикла;	
	Возврат Не ФлагОтмены;
КонецФункции	

&НаКлиенте
Функция Автотесты_ПолучитьКодСледующегоШага()
	
	Код = Неопределено;
	
	СтруктураПараметров = ПолучитьИзВременногоХранилища(Параметры.ПараметрыАвтотестирования);

	Для Каждого Стр Из СтруктураПараметров.ВыполняемыйКод Цикл
		
		Если Стр.Выполнено Тогда
			Продолжить;
		КонецЕсли;
		Если Стр.ФормаОбработки = "ФормаОбработкиРасхождений" Тогда
			Код = Стр.ВыполняемыйКод;
			Прервать;
		Иначе
			Прервать;//есть невыполненный код в другой форме
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Код;
	
КонецФункции

&НаКлиенте
Процедура Автотесты_ПометитьПоследнийШагКакВыполненный()
	
	Код = Неопределено;
	
	СтруктураПараметров = ПолучитьИзВременногоХранилища(Параметры.ПараметрыАвтотестирования);
	Для Каждого Стр Из СтруктураПараметров.ВыполняемыйКод Цикл
		
		Если Стр.Выполнено Тогда
			Продолжить;
		КонецЕсли;
		Если Стр.ФормаОбработки = "ФормаОбработкиРасхождений" Тогда
			Стр.Выполнено = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(СтруктураПараметров,Параметры.ПараметрыАвтотестирования);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьАвтотесты()
	
	Пока Истина Цикл
		
		Код = Автотесты_ПолучитьКодСледующегоШага();
		
		Если Код = Неопределено Тогда
			
			Прервать;
			
		Иначе
			
			Выполнить(Код);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	ОсновнаяФорма = ОсновнаяФорма();
	
	Если ОсновнаяФорма <> Неопределено Тогда
		ОсновнаяФорма.ПриЗакрытииФормы(ЭтаФорма, "Сервис_ОбработкаРасхожденийПриемкиУправляемая");
	КонецЕсли 
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуКодовМаркировки(НомерСтроки) Экспорт
	
	ПараметрыФормы = ПолучитьПараметрыФормыКодовМаркировки();
	ПараметрыФормы.СтрокаПозиционирования = НомерСтроки;
	
	МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI("Сервис_КодыМаркировкиУправляемая",
												 ,
												 ПараметрыФормы,
												 ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыФормыКодовМаркировки()
	
	ПараметрыФормы = МодульОбъекта().СтруктураПараметровФормыПросмотраКодовМаркировки();
	ПараметрыФормы.ТолькоПросмотр = Истина;
	ПараметрыФормы.ПросмотрРасхождений = Истина;
	ПараметрыФормы.КодыМаркировкиОтредактированыВручную = Ложь;
	ПараметрыФормы.СкрытьУпаковки = Истина;
	ПараметрыФормы.ИмяКолонкиКодовВСообщении = " принятые партнером: " + Документ;
	
	Если Не ЭтоАдресВременногоХранилища(АдресКодовМаркировкиВВх) 
		ИЛИ Не ЭтоАдресВременногоХранилища(АдресРасхожденийКодовМаркировкиВВх) Тогда

		ПоместитьТаблицуКодовМаркировкиВВХ();
		
	КонецЕсли;
		
	ПараметрыФормы.АдресКодовМаркировкиТоваров = АдресКодовМаркировкиВВх;
	ПараметрыФормы.АдресРасхождений = АдресРасхожденийКодовМаркировкиВВх;
	
	Возврат ПараметрыФормы;
	
КонецФункции

&НаСервере
Процедура ПоместитьТаблицуКодовМаркировкиВВХ()
	
	ТаблицаКодовМаркировки = МодульОбъекта().ИнициализироватьТаблицуКодовМаркировки_КонтурEDI();
		
	ТаблицаРасхожденийКодовМаркировки = ТаблицаКодовМаркировки.Скопировать();
	ТаблицаРасхожденийКодовМаркировки.Колонки.Добавить("ЕстьВОтгрузке");
	ТаблицаРасхожденийКодовМаркировки.Колонки.Добавить("ЕстьВПриемке");
	ТаблицаРасхожденийКодовМаркировки.Колонки.Добавить("СуммаДляОтбора");
	
	СвойстваДляКопирования = "НомерСтроки, Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения, СерияНоменклатуры";
	
	ДеревоТоваров = ПолучитьИзВременногоХранилища(ДеревоСоВсемиТоварами);
	
	Для каждого Строка Из ДеревоТоваров.Строки Цикл
		
		Если Не ЗначениеЗаполнено(Строка.КодыМаркировкиПринято) Тогда
			
			СтрокаТовараБезКодаМаркировки = ТаблицаКодовМаркировки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТовараБезКодаМаркировки, Строка, СвойстваДляКопирования);

		Иначе
			
			Для каждого КодМаркировки Из Строка.КодыМаркировкиПринято Цикл
				
				СтрокаКодаМаркировки = ТаблицаКодовМаркировки.Добавить();
				
				ЗаполнитьЗначенияСвойств(СтрокаКодаМаркировки, Строка, СвойстваДляКопирования);
				
				СтрокаКодаМаркировки.Артикул = "";
				СтрокаКодаМаркировки.Наименование = Строка(Строка.Номенклатура);
				СтрокаКодаМаркировки.Код = КодМаркировки.Значение;
				СтрокаКодаМаркировки.Вид = КодМаркировки.Представление;
				
				СтрокаРасхождений = ТаблицаРасхожденийКодовМаркировки.Добавить();
				
				ЗаполнитьЗначенияСвойств(СтрокаРасхождений, СтрокаКодаМаркировки);
				
				СтрокаРасхождений.ЕстьВПриемке = 1;
				СтрокаРасхождений.СуммаДляОтбора = 1;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Для каждого КодМаркировки Из Строка.КодыМаркировкиВНакладной Цикл
			
			СтрокаРасхождений = ТаблицаРасхожденийКодовМаркировки.Добавить();
			
			ЗаполнитьЗначенияСвойств(СтрокаРасхождений, Строка, СвойстваДляКопирования);
			
			СтрокаРасхождений.Артикул = "";
			СтрокаРасхождений.Наименование = Строка(Строка.Номенклатура);
			СтрокаРасхождений.Код = КодМаркировки.Значение;
			СтрокаРасхождений.Вид = КодМаркировки.Представление;
			СтрокаРасхождений.ЕстьВОтгрузке = 1;
			СтрокаРасхождений.СуммаДляОтбора = 1;
			
		КонецЦикла;
		
	КонецЦикла;
	
	КолонкиДляСвертки = "Обработан,НомерСтроки,Артикул,Наименование,Номенклатура,ХарактеристикаНоменклатуры,ЕдиницаИзмерения,СерияНоменклатуры,Код,Вид";
	КолонкиДляСуммирования = "ЕстьВОтгрузке, ЕстьВПриемке, СуммаДляОтбора";
	
	ТаблицаРасхожденийКодовМаркировки.Свернуть(КолонкиДляСвертки, КолонкиДляСуммирования);
	
	ОтборСтрокСРасхождениями = Новый Структура;
	ОтборСтрокСРасхождениями.Вставить("СуммаДляОтбора", 1);
	
	СтрокиСРасхождениями = ТаблицаРасхожденийКодовМаркировки.НайтиСтроки(ОтборСтрокСРасхождениями);
	
	Если СтрокиСРасхождениями.Количество() > 0 Тогда
		ТаблицаРасхожденийКодовМаркировки = ТаблицаРасхожденийКодовМаркировки.Скопировать(СтрокиСРасхождениями);
	Иначе
		ТаблицаРасхожденийКодовМаркировки.Очистить();
	КонецЕсли;
		
	АдресКодовМаркировкиВВх = ПоместитьВоВременноеХранилище(ТаблицаКодовМаркировки, УникальныйИдентификатор);
	АдресРасхожденийКодовМаркировкиВВх = ПоместитьВоВременноеХранилище(ТаблицаРасхожденийКодовМаркировки, УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервере
Процедура ПоместитьДеревоВХранилище(ДеревоРасхождений)
	
	КопияДерева = ДеревоРасхождений.Скопировать();
	
	ОтборСтрокБезРасхождений = Новый Структура;
	ОтборСтрокБезРасхождений.Вставить("ЕстьРасхождения", Ложь);
	СтрокиБезРасхождений = КопияДерева.Строки.НайтиСтроки(ОтборСтрокБезРасхождений);
	
	Для каждого Строка Из СтрокиБезРасхождений Цикл
		КопияДерева.Строки.Удалить(Строка);
	КонецЦикла;
	
	ДеревоСРасхождениями = ПоместитьВоВременноеХранилище(КопияДерева, УникальныйИдентификатор);
	ДеревоСоВсемиТоварами = ПоместитьВоВременноеХранилище(ДеревоРасхождений, УникальныйИдентификатор);

КонецПроцедуры

&НаСервере
Процедура ВосстановитьДеревоИзХранилища(АдресДерева)
	
	Если ЭтоАдресВременногоХранилища(АдресДерева) Тогда
		
		ДеревоИзХранилища = ПолучитьИзВременногоХранилища(АдресДерева);
		ЗначениеВРеквизитФормы(ДеревоИзХранилища, "Таб");
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицуКодовМаркировкиПриемки()
	
	Если Не ЭтоАдресВременногоХранилища(АдресКодовМаркировкиВВх) Тогда
		ПоместитьТаблицуКодовМаркировкиВВХ();
	КонецЕсли;
	
	ТаблицаКодовМаркировки = ПолучитьИзВременногоХранилища(АдресКодовМаркировкиВВх);
	
	Возврат ТаблицаКодовМаркировки;
	
КонецФункции

