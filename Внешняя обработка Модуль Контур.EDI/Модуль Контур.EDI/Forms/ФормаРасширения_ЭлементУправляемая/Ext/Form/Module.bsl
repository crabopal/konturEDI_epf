&НаСервере
Функция АдресХранилищаИсходниковРедактораКода1С()
	
	Кэшировать 				= Истина;
	ИскатьНаСервере 		= Ложь; 
	ИскатьВОсновномМодуле 	= Истина;
	ИскатьВоВнешнемМодуле 	= Ложь;
	
	ДанныеМакета = МодульОбъекта().ПолучитьМакет_КонтурEDI("РедакторКода1С",
															"zip",
															Кэшировать,
															ИскатьНаСервере,
															ИскатьВОсновномМодуле,
															ИскатьВоВнешнемМодуле);
															
	Возврат ПоместитьВоВременноеХранилище(ДанныеМакета, УникальныйИдентификатор);
	
КонецФункции

&НаКлиенте
Процедура ИзвлечьИсходникиРедактораКода1С()
	
	ИмяКаталога = КаталогВременныхФайлов();	
	КаталогИсходников = ИмяКаталога + "bsl_console\";
	Файл = Новый Файл(КаталогИсходников);
	ИндексныйФайл = Новый Файл(КаталогИсходников + "index.html"); 
	Если НЕ Файл.Существует() ИЛИ НЕ ИндексныйФайл.Существует() Тогда
		УдалитьФайлы(КаталогИсходников, "*.*");
		ИмяФайла = КаталогИсходников + "bsl_console.zip";
		АдресМакета = АдресХранилищаИсходниковРедактораКода1С();
		ДанныеМакета = ПолучитьИзВременногоХранилища(АдресМакета);
		ДанныеМакета.Записать(ИмяФайла);
		Попытка
			Файл = Новый ЧтениеZipФайла(ИмяФайла);
			Файл.ИзвлечьВсе(КаталогИсходников);
			
		Исключение
			ИсходникиЗагружены = Ложь;
			Возврат;
		КонецПопытки;
	КонецЕсли;  
	
	ТочкаВхода = КаталогИсходников + "index.html";
	КодHTML = ТочкаВхода;
	ИсходникиЗагружены = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура КонсольСформирована(Элемент)
	
	Если ИсходникиЗагружены Тогда
		
		Попытка
			ИнициализацияРедактора();
			
			Если Элементы.События.ТекущаяСтрока = Неопределено Тогда
				Элементы.События.ТекущаяСтрока = 0;		
			КонецЕсли;
			
			ТекущаяСтрока = Элементы.События.ТекущиеДанные;
			Если ТекущаяСтрока = Неопределено И Не События.Количество() = 0 Тогда
				ТекущаяСтрока = События[0];
				ТекущееСобытие = ТекущаяСтрока.Имя;
				ТекстСобытия   = ТекущаяСтрока.Код;
			Иначе 
				ТекстСобытия = ПолучитьТекстСобытия();	
			КонецЕсли;
			
            ИспользуетсяРедакторКода = Истина; 
            УстановитьТекстСобытия(ТекстСобытия);
			
		Исключение
			КодHTML = "";
			ИспользуетсяРедакторКода = Ложь;
			ИсходникиЗагружены = Ложь;
		КонецПопытки;
		УстановитьДоступность();
	КонецЕсли;
	
КонецПроцедуры 

