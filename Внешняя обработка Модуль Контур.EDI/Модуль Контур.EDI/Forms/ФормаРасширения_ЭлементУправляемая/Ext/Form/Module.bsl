&НаКлиенте
Процедура УстановитьТекстСобытия(ТекстСобытия)
	
	Если ИспользуетсяРедакторКода Тогда
		Если ВключенРежимСравнения() Тогда
			РедакторКода1С().editor.getModifiedEditor().setValue(ТекстСобытия);		
		Иначе
			РедакторКода1С().eraseText();
			РедакторКода1С().setText(ТекстСобытия, Неопределено, Ложь);	
		КонецЕсли;
	Иначе  
		Код.УстановитьТекст(ТекстСобытия);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьТекстСобытия()
	
	ТекстСобытия = "";
	
	Если ИспользуетсяРедакторКода Тогда
		Если ВключенРежимСравнения() Тогда
			ТекстСобытия = РедакторКода1С().editor.getModifiedEditor().getValue();
		Иначе
			ТекстСобытия = РедакторКода1С().getText();
		КонецЕсли;
	Иначе  
		ТекстСобытия = Код.ПолучитьТекст();
	КонецЕсли;
	
	Возврат ТекстСобытия;
	
КонецФункции

&НаКлиенте
Процедура УстановитьГраницыВыделенияСобытия(НачалоСтроки, НачалоКолонки, КонецСтроки, КонецКолонки)
	
	Если ИспользуетсяРедакторКода Тогда
		РедакторКода1С().setSelection(НачалоСтроки, НачалоКолонки, КонецСтроки, КонецКолонки);
	Иначе
		Элементы.Код.УстановитьГраницыВыделения(НачалоСтроки, НачалоКолонки, КонецСтроки, КонецКолонки);		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьРежимСравнения(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	Если ИспользуетсяРедакторКода Тогда
		
		Если НЕ ВключенРежимСравнения() Тогда
			ТекущаяСтрока = Элементы.События.ТекущиеДанные;
			Если ТекущаяСтрока <> Неопределено Тогда
				УстановитьТекстСравненияСобытия(ТекущаяСтрока.ИсходныйКод);	
			КонецЕсли;	
		Иначе
			УстановитьТекстСравненияСобытия("");	
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТекстСравненияСобытия(ИсходныйКод)
	
	Если ИспользуетсяРедакторКода Тогда
		Если ЗначениеЗаполнено(ИсходныйКод) Тогда
			КодСобытия = ПолучитьТекстСобытия();
			РедакторКода1С().originalText = ИсходныйКод;
			РедакторКода1С().compare(КодСобытия, Истина, Истина);
		Иначе
			КодСобытия = ПолучитьТекстСобытия();
			РедакторКода1С().originalText = КодСобытия;
			РедакторКода1С().compare();
			РедакторКода1С().setLanguageMode("bsl");
			РедакторКода1С().minimap(Истина);
		КонецЕсли;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Функция ВключенРежимСравнения()
	
	РежимСравнения = Ложь;
	
	Если ИспользуетсяРедакторКода Тогда
		РежимСравнения = РедакторКода1С().editor.navi <> Неопределено;	
	КонецЕсли;
	
	Возврат РежимСравнения;
	
КонецФункции

&НаКлиенте
Процедура КодHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	ОбработатьСобытиеРедактора(ДанныеСобытия.Event.eventData1C);
КонецПроцедуры   

&НаКлиенте
Процедура ОбработатьСобытиеРедактора(Событие)
	
	Если Событие <> Неопределено Тогда
		
		ИмяСобытия = Событие.event;
		
		Если ИмяСобытия = "EVENT_QUERY_CONSTRUCT" Тогда
			ВызватьКонструкторЗапроса(Событие.params);
		КонецЕсли;
		
		Если ИмяСобытия = "EVENT_FORMAT_CONSTRUCT" Тогда
			ВызватьКонструкторФорматнойСтроки(Событие.params);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииКонструктораФорматнойСтроки(ФорматнаяСтрока, ДопПараметры) Экспорт
	
	Если ФорматнаяСтрока <> Неопределено Тогда	
		ФорматнаяСтрока = СтрЗаменить(ФорматнаяСтрока, "'", "");
		ФорматнаяСтрока = """" + ФорматнаяСтрока + """";
		РедакторКода1С().setText(ФорматнаяСтрока, ДопПараметры, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКонструкторФорматнойСтроки(ФорматнаяСтрока, ДопПараметры)
	
	Конструктор = Новый КонструкторФорматнойСтроки();
	Попытка			
		Конструктор.Текст = ФорматнаяСтрока;
	Исключение
		Инфо = ИнформацияОбОшибке();
		МодульОбъектаКлиент().Предупреждение_КонтурEDI("Ошибка в тексте форматной строки:" + Символы.ПС + Инфо.Причина.Описание);
		Возврат;
	КонецПопытки;
	
	Если Объект.ПараметрыКлиентСервер.МодальностьЗапрещена Тогда
		Оповещение = Вычислить("Новый ОписаниеОповещения(""ПриЗакрытииКонструктораФорматнойСтроки"", ЭтаФорма, ДопПараметры)");
		Конструктор.Показать(Оповещение);	
	Иначе  
		Конструктор.ОткрытьМодально();
		ПриЗакрытииКонструктораФорматнойСтроки(Конструктор.Текст, ДопПараметры); 	
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ВопросСоздатьНовуюФорматнуюСтроку(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОткрытьКонструкторФорматнойСтроки("", Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВызватьКонструкторФорматнойСтроки(ПараметрыСтроки)
	
	Если ПараметрыСтроки = Неопределено Тогда
		ТекстВопроса = "Форматная строка не найдена." + Символы.ПС + "Создать новую форматную строку?";
		МодульОбъектаКлиент().ПоказатьВопрос_КонтурEDI("ВопросСоздатьНовуюФорматнуюСтроку", ЭтаФорма, , ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ФорматнаяСтрока = СтрЗаменить(СтрЗаменить(ПараметрыСтроки.text, "|", ""), """", "");
		ОткрытьКонструкторФорматнойСтроки(ФорматнаяСтрока, ПараметрыСтроки.range);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииКонструктораЗапросов(Текст, ДопПараметры) Экспорт
	
	Если Текст <> Неопределено Тогда
		
		Если Не РедакторКода1С().queryMode Тогда
			Текст = СтрЗаменить(Текст, Символы.ПС, Символы.ПС + "|");
			Текст = СтрЗаменить(Текст, """", """""");
			Текст = """" + Текст + """";
		КонецЕсли;
		
		РедакторКода1С().setText(Текст, ДопПараметры, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКонструкторЗапроса(Текст, ДопПараметры)
	
	Попытка
		Конструктор = Вычислить("Новый КонструкторЗапроса()");
	Исключение
		МодульОбъектаКлиент().Предупреждение_КонтурEDI("Открытие конструктора запроса не поддерживается");
		Возврат;
	КонецПопытки;
	
	Если ЗначениеЗаполнено(Текст) Тогда
		Попытка
			Конструктор.Текст = Текст;
		Исключение
			Инфо = ИнформацияОбОшибке();
			МодульОбъектаКлиент().Предупреждение_КонтурEDI("Ошибка в тексте запроса:" + Символы.ПС + Инфо.Причина.Описание);
			Возврат;
		КонецПопытки;
	КонецЕсли;
	
	Попытка
		Оповещение = Вычислить("Новый ОписаниеОповещения(""ПриЗакрытииКонструктораЗапросов"", ЭтаФорма, ДопПараметры)");
		Конструктор.Показать(Оповещение);		
	Исключение
		МодульОбъектаКлиент().Предупреждение_КонтурEDI("Открытие конструктора запроса не поддерживается");	
	КонецПопытки;       
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросСоздатьНовыйЗапрос(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОткрытьКонструкторЗапроса("", Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПодготовитьТекстЗапроса(Текст)
	
	ТекстЗапроса = СтрЗаменить(Текст, "|", "");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, """""", "$");	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, """", "");	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "$", """");
	
	Возврат ТекстЗапроса;
	
КонецФункции

&НаКлиенте
Процедура ВызватьКонструкторЗапроса(ПараметрыЗапроса)
		
	Если ПараметрыЗапроса = Неопределено Тогда
		ТекстВопроса = "Не найден текст запроса." + Символы.ПС + "Создать новый запрос?";
		МодульОбъектаКлиент().ПоказатьВопрос_КонтурEDI("ВопросСоздатьНовыйЗапрос", ЭтаФорма, , ТекстВопроса, РежимДиалогаВопрос.ДаНет);  
	Иначе
		ТекстЗапроса = ПодготовитьТекстЗапроса(ПараметрыЗапроса.text);
		ОткрытьКонструкторЗапроса(ТекстЗапроса, ПараметрыЗапроса.range);
	КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Процедура ПереключитьРедактор(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	Если ИспользуетсяРедакторКода Тогда
		
		ТекстСобытия = ПолучитьТекстСобытия();
		
		ИсходникиЗагружены = Ложь;		
		ИспользуетсяРедакторКода = Ложь;	
		
		УстановитьТекстСобытия(ТекстСобытия);
		
	Иначе 
		
		ИсходникиЗагружены = Истина;	
		
	КонецЕсли;      
	
	УстановитьДоступность();
	
КонецПроцедуры 
