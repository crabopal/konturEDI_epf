Процедура ИнициализацияРедактора()
	
	РедакторКода1С().init(Объект.ПараметрыКлиентСервер.ВерсияПлатформы1С);
	РедакторКода1С().setOption("autoResizeEditorLayout", Истина);
	РедакторКода1С().setOption("renderQueryDelimiters", Истина);
	РедакторКода1С().setOption("generateModificationEvent", Истина);
