	Элементы.ТоварыКодЕдиницыИзмеренияEDI.Видимость 	= Видимость;
	Элементы.ТоварыХарактеристикаНоменклатуры.Видимость = ЕстьХарактеристикаНоменклатуры И Видимость;
	Элементы.ТоварыМестонахождениеТовара1С.Видимость 	= Видимость;
	Элементы.ТоварыЗаказанноеКоличество.Видимость 		= Видимость;
	Элементы.ТоварыДоставленноеКоличество.Видимость 	= Видимость;
	Элементы.ТоварыПринятоеКоличество.Видимость			= Видимость;
	Элементы.ТоварыОстатокНаНачалоПериода.Видимость 	= Видимость;
	Элементы.ТоварыОстатокНаКонецПериода.Видимость 		= Видимость;
	Элементы.ТоварыПродажиЗаПериод.Видимость 			= Видимость;
	Элементы.ТоварыЦенаБезНДС.Видимость 				= Видимость;
	Элементы.ТоварыЦенаСНДС.Видимость 					= Видимость;
	
	Элементы.ТоварыТекущийОстатокРасчетный.Видимость    	 = Видимость;
	Элементы.ТоварыЗаказанноеКоличествоРасчетный.Видимость 	 = Видимость;
	Элементы.ТоварыДоставленноеКоличествоРасчетный.Видимость = Видимость;
	Элементы.ТоварыПринятоеКоличествоРасчетный.Видимость 	 = Видимость;
	Элементы.ТоварыОстатокНаНачалоПериодаРасчетный.Видимость = Видимость;
	Элементы.ТоварыОстатокНаКонецПериодаРасчетный.Видимость = Видимость;
	Элементы.ТоварыПродажиЗаПериодРасчетный.Видимость 		 = Видимость;
	Элементы.ТоварыЦенаБезНДСРасчетная.Видимость 			 = Видимость;
	Элементы.ТоварыЦенаСНДСРасчетная.Видимость 				 = Видимость;
	    
КонецПроцедуры

&НаСервере
Функция ОткрытьXMLСообщенияВызовСервера()
	
	_Товары = РеквизитФормыВЗначение("Товары");
	ТоварыКопия = _Товары.Скопировать();
	
	СтруктураПараметры = ПолучитьПараметрыДляПодготовкиСообщения();
	МассивСообщений = МодульОбъекта().ПолучитьМассивСообщенийINVRPTПоТочкамДоставки(ТоварыКопия, СтруктураПараметры);
	
	ПолученныйРезультат = Новый Массив;
	
	Для Каждого ИсходящееСообщение ИЗ МассивСообщений Цикл 
		
		РезультатКонвертации = МодульОбъекта().КонвертироватьИсходящееСообщениеПоНовому(ИсходящееСообщение);
		
		Если НЕ РезультатКонвертации.Успешно Тогда 
			
			Для каждого СтрокаОшибки из РезультатКонвертации.ТаблицаОшибок Цикл
				
				Сообщить(СтрокаОшибки.ТекстОшибки);
				
			КонецЦикла;
			
			Продолжить;
		КонецЕсли;
		
		ТекДок = Новый ТекстовыйДокумент;
		ТекДок.Прочитать(РезультатКонвертации.ПутьКФайлу, КодировкаТекста.UTF8);
		ПолученныйРезультат.Добавить(ТекДок.ПолучитьТекст());		
		
	КонецЦикла;
	
	Возврат ПолученныйРезультат;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФайл(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	Если ПроверитьЗаполнение() = Ложь ИЛИ ПроверитьЗаполнениеТабличнойЧасти_КонтурEDI() = Ложь Тогда 
		Возврат;
	КонецЕсли;
	
	Результат = ОткрытьXMLСообщенияВызовСервера();
	
	Для Каждого ТекстФайла Из Результат Цикл 
		
		ТекДок = Новый ТекстовыйДокумент;
		ТекДок.УстановитьТекст(ТекстФайла);
		ИмяВремФайла = ПолучитьИмяВременногоФайла("xml");
		
		ТекДок.Записать(ИмяВремФайла,КодировкаТекста.UTF8);
		
		ЗапуститьПриложение(ИмяВремФайла);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеДействияФормыОтправить(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	Если ПроверитьЗаполнение() = Ложь ИЛИ ПроверитьЗаполнениеТабличнойЧасти_КонтурEDI() = Ложь Тогда 
		Возврат;
	КонецЕсли;
	
	Если НесколькоТочекДоставки = Истина И ПолучитьСоответствиеТочкаДоставкиСкладыОстатков().Количество() = 0 Тогда 
		
		Вопрос_ОтправлятьСообщениеЕслиНеУказаныТочкиДоставки();
		Возврат;
		
	КонецЕсли;
	
	НачалоОтправкиСообщения();
	
КонецПроцедуры

&НаКлиенте
Процедура НачалоОтправкиСообщения()
	
	СтруктураПараметры = ПолучитьПараметрыДляПодготовкиСообщения();
	КоличествоСоответствий = СтруктураПараметры.СоответствиеТочкаДоставкиСкладыОстатков.Количество();
	
	Результат = ПроверитьНаличиеТоваровПоВыбраннымСкладам(СтруктураПараметры.СоответствиеТочкаДоставкиСкладыОстатков);
	
	Если Результат.Успешно = Ложь Тогда 
		
		СтруктураПараметры.Вставить("МассивТочекДоставокСПустымиТоварами", Результат.МассивТочекДоставокСПустымиТоварами);
		Вопрос_ЕстьВозможныеСообщенияСПустымиТоварами(СтруктураПараметры, Результат.ОписаниеОшибки);
		
	Иначе		
		
		Если КоличествоСоответствий > 1 Тогда 
			
			Вопрос_БудетОтправленоНесколькоСообщеений(СтруктураПараметры);
			
		Иначе
			
			ОтправитьСообщение(СтруктураПараметры);
			Закрыть();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОтправитьСообщение(СтруктураПараметры)
	
	_Товары = РеквизитФормыВЗначение("Товары");
	ТоварыКопия = _Товары.Скопировать();
	
	Если ЗначениеЗаполнено(СообщениеСсылка) Тогда 
		
		СтруктураПараметры.Вставить("СообщениеСсылка", СообщениеСсылка);		
		
	КонецЕсли;
	
	МодульОбъекта().ОтправитьНезависимоеСообщение("INVRPT", ТоварыКопия, СтруктураПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФормуБезПримененияДействия(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	ЭтаФорма.Закрыть(СообщениеСсылка);
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьОдинИлиГруппуТоваров(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	Если НЕ ЗначениеЗаполнено(Партнер) Тогда 
		
		МодульОбъектаКлиент().Предупреждение_КонтурEDI("Не заполнено поле ""Партнер""");
		
		Возврат;
		
	КонецЕсли;
	
	ВыбратьГруппу = (Команда.Имя = "ДобавитьГруппу");
	
	ПараметрыФормыВыбораНоменклатуры = Новый Структура;
	
	Если ВыбратьГруппу Тогда 
		ПараметрыФормыВыбораНоменклатуры.Вставить("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Группы);
	Иначе
		ПараметрыФормыВыбораНоменклатуры.Вставить("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Элементы);
		ПараметрыФормыВыбораНоменклатуры.Вставить("РежимВыбора",Истина);
	КонецЕсли;
	
	ТипНоменклатуры = ПолучитьТипЗначенияОбъекта_НаСервере("Номенклатура",,Истина);
	ИмяФормыВыбора= ?(ВыбратьГруппу, "Справочник." + ТипНоменклатуры + ".ФормаВыбораГруппы", "Справочник." + ТипНоменклатуры + ".ФормаВыбора");
	
	МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI(ИмяФормыВыбора, "", ПараметрыФормыВыбораНоменклатуры, ЭтаФорма, "ПослеПодбораНоменклатуры", ЭтаФорма);

КонецПроцедуры

&НаСервере
Функция МыПоставщик()
	
	СмоглиОпределитьПартнера =  МодульОбъекта().ОпределитьПартнера(Новый Структура("ТипЗначения, ЮрФизЛицо, Сообщение","ЮрФизЛицо", Продавец, Сообщение));
	
	Если ЗначениеЗаполнено(СмоглиОпределитьПартнера) Тогда 
		Возврат Ложь
	Иначе 
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ТочкаДоставкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	НастройкиПартнера = ПолучитьСписокСвойствEDI_НаСервере("ПартнерКакТорговаяСеть,ПартнерКакПоставщик", Партнер);
	ПартнерСеть         = НастройкиПартнера.ПартнерКакТорговаяСеть = Истина;
	ПартнерПоставщик    = НастройкиПартнера.ПартнерКакПоставщик    = Истина;
	ПартнерДистрибьютор = ПартнерСеть И ПартнерПоставщик;
	
	Если ПартнерДистрибьютор И ЕстьТочкиДоставкиСторонние И ЕстьТочкиДоставкиСвои Тогда
		
		Вопрос_КакиеТочкиДоставкиНеобходимоПодобрать();
		
	ИначеЕсли ПартнерСеть И ЕстьТочкиДоставкиСторонние Тогда 
		
		ЗаполнитьСписокЗначенийТочкаДоставки_НаСервере("ТочкиДоставкиСторонние", Партнер);
		ПоказатьВыборИзУниверсальнойФормы(Элементы.ТочкаДоставки);
		
	ИначеЕсли ЕстьТочкиДоставкиСвои Тогда
		
		ЗаполнитьСписокЗначенийТочкаДоставки_НаСервере("ТочкиДоставкиСвои");
		ПоказатьВыборИзУниверсальнойФормы(Элементы.ТочкаДоставки);
		
	Иначе 
									
		МодульОбъектаКлиент().Предупреждение_КонтурEDI("Точек доставки не обнаружено!");
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокЗначенийТочкаДоставки_НаСервере(НазваниеСправочника, _Партнер = Неопределено)
	
	Если НазваниеСправочника = "ТочкиДоставкиСвои" Тогда 
		
		СписокЭлементовСправочника = МодульОбъекта().ПолучитьСписокЭлементовСправочника(НазваниеСправочника);
		НазваниеКолонки = "ТочкаДоставки";
		
	Иначе 
		
		СписокЭлементовСправочника = МодульОбъекта().ПолучитьСписокЭлементовСправочника(НазваниеСправочника, _Партнер);
		НазваниеКолонки = "Ссылка";
		
	КонецЕсли;
	
	МассивТочекДоставок = СписокЭлементовСправочника.ВыгрузитьКолонку(НазваниеКолонки);
	СписокЗначенийТочекДоставок = Новый СписокЗначений;
	СписокЗначенийТочекДоставок.ЗагрузитьЗначения(МассивТочекДоставок);
	
	ЗаполнитьСписокВыбораЭлемента("ТочкаДоставки", СписокЗначенийТочекДоставок) 
	
КонецПроцедуры

&НаКлиенте
Процедура ПродавецНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	КтоЯвляетсяПродавцом = ПолучитьПродавцаПоКонтрагентуИОрганизации_НаСервере(Контрагент, Организация, Истина);
	
	Если КтоЯвляетсяПродавцом = "Организация" Тогда 
		
		ЗаполнитьСписокВыбораЭлемента("Продавец", Элементы.Организация.СписокВыбора); 
		ПоказатьВыборИзУниверсальнойФормы(Элементы.Продавец);
		
	ИначеЕсли КтоЯвляетсяПродавцом = "Контрагент" Тогда 
		
		ЗаполнитьСписокВыбораЭлемента("Продавец", Элементы.Контрагент.СписокВыбора); 
		ПоказатьВыборИзУниверсальнойФормы(Элементы.Продавец);
		
	Иначе
		
		Вопрос_КтоЯвляетсяПродавцом();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЗначенияЭлементов()
	
	Если НЕ ЗначениеЗаполнено(Партнер) Тогда 
		
		Контрагент    = Неопределено;
		Продавец 	  = Неопределено;
		ТочкаДоставки = Неопределено;
		СкладОстатков = Неопределено;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда 
		
		Продавец      = Неопределено; 
		ТочкаДоставки = Неопределено;
		СкладОстатков = Неопределено;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда 
		
		Продавец = Неопределено; 
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТочкаДоставки) Тогда 
		
		СкладОстатков = Неопределено;
		
	КонецЕсли;
	
	ОбновитьДоступностьЭлементов();	
	
КонецПроцедуры

&НаКлиенте
Процедура ПартнерОткрытие(Элемент, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Партнер) = Ложь Тогда 
		
		Возврат; 
		
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СсылкаНаПартнера", Партнер);
	
	МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI("Партнеры_ЭлементУправляемая", , ПараметрыФормы, ЭтаФорма, "ПослеОткрытииКарточкиПартнера", ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОткрытииКарточкиПартнера(Параметр, ДополнительныеПараметры = Неопределено) Экспорт 
	
	 УниверсальныйПриИзменении(Элементы.Партнер);
	
КонецПроцедуры

&НаКлиенте
Процедура СкладОстатковНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТипСкладОстатков = ПолучитьТипЗначенияОбъекта_НаСервере("ТочкаДоставкиСвоя",,Истина);
	ИмяФормыВыбора = "Справочник." + ТипСкладОстатков + ".ФормаВыбора";
	
	ПараметрыФормыВыбора = Новый Структура;
	ПараметрыФормыВыбора.Вставить("РежимВыбора", Истина);
	
	МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI(ИмяФормыВыбора, "", ПараметрыФормыВыбора, ЭтаФорма, "ОбработчикПослеВыбораСкладОстатков", ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикПослеВыбораСкладОстатков(ВыбранноеЗначение, ДополнительныеПараметры = Неопределено) Экспорт 
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда 
		
		СкладОстатков = ВыбранноеЗначение;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если ТолькоПросмотрСообщения = Истина Тогда 
		
		Возврат;                                              
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Партнер) Тогда 
		
		МодульОбъектаКлиент().Предупреждение_КонтурEDI("Не заполнено поле ""Партнер""");
		
		Возврат;
		
	КонецЕсли;
	
	ИмяКолонки = Поле.Имя;
	
	Если ИмяКолонки = "ТоварыНоменклатура"
		ИЛИ ИмяКолонки = "ТоварыЕдиницаИзмерения"
		ИЛИ ИмяКолонки = "ТоварыНаименование"
		ИЛИ ИмяКолонки = "ТоварыКодЕдиницыИзмеренияEDI" 
		ИЛИ ИмяКолонки = "ТоварыХарактеристикаНоменклатуры" 
		ИЛИ ИмяКолонки = "ТоварыКоэффициентEDIВ1С"
		Тогда
		
		СтандартнаяОбработка = Ложь;
		ТекСтрока = Элементы.Товары.ТекущиеДанные;
		
		Если МыПоставщик() Тогда 
			
			КодТовараПартнера = ТекСтрока.КодТовараПокупателя;
			
		Иначе
			
		    КодТовараПартнера = ТекСтрока.КодТовараПоставщика;
			
		КонецЕсли;
		
		СписокВыбора = СоставитьСписокВыбораПоСтрокеТоваров(ТекСтрока.GTIN, КодТовараПартнера, Партнер);
		
		МодульОбъектаКлиент().ВыбратьИзМеню_КонтурEDI("ПослеВыбораСоответствияИзМеню",ЭтаФорма,,СписокВыбора,Элемент);
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СоставитьСписокВыбораПоСтрокеТоваров(GTIN, КодТовараПартнера, Партнер)
	
	СоответствиеТоваров = МодульОбъекта().СоответствиеТоваров_НайтиНоменклатуру(GTIN, КодТовараПартнера, Партнер);
	
	СписокВыбора = Новый СписокЗначений;
	Для Каждого Стр Из СоответствиеТоваров Цикл
		
		СтруктураТовара = Новый Структура();
		
		СтруктураТовара.Вставить("Номенклатура",				Стр.Номенклатура);
		СтруктураТовара.Вставить("ХарактеристикаНоменклатуры",	Стр.ХарактеристикаНоменклатуры);
		СтруктураТовара.Вставить("ЕдиницаИзмерения",			Стр.ЕдиницаИзмерения);
		СтруктураТовара.Вставить("КодЕдиницыИзмеренияEDI",		Стр.ЕдиницаEDI);
		СтруктураТовара.Вставить("КоэффициентEDIВ1С",			Стр.КоэффициентEDIВ1С);
		
		Представление = СокрЛП(Стр.Номенклатура);
		Если ЗначениеЗаполнено(Стр.ХарактеристикаНоменклатуры) Тогда
			Представление = Представление+", "+СокрЛП(Стр.ХарактеристикаНоменклатуры);
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.ЕдиницаИзмерения) Тогда
			Представление = Представление + ", " + СокрЛП(Стр.ЕдиницаИзмерения);
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.ЕдиницаEDI) Тогда
			Представление = Представление + ", " + СокрЛП(Стр.ЕдиницаEDI);
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.КоэффициентEDIВ1С) Тогда
			Представление = Представление + ", коэф. " + СокрЛП(Стр.КоэффициентEDIВ1С);
		КонецЕсли;
		
		СписокВыбора.Добавить(СтруктураТовара, Представление);
		
	КонецЦикла;
	
	СписокВыбора.Добавить("Настроить соответствие товаров",,,);
	
	Возврат СписокВыбора;
	
КонецФункции

&НаСервере
Процедура ПересчитатьСтрокуТоваровСервер(Строка = Неопределено, ИдентификаторТекСтроки = Неопределено, Направление = "ВEDI")
	
	СтрокаДляПересчета = Неопределено;
	
	Если НЕ ИдентификаторТекСтроки = Неопределено Тогда
		СтрокаДляПересчета = Товары.НайтиПоИдентификатору(ИдентификаторТекСтроки);
	ИначеЕсли Не Строка = Неопределено Тогда
		СтрокаДляПересчета = Строка;	
	Иначе
		Возврат;
	КонецЕсли;	

	МодульОбъекта().ПересчитатьСтрокуТоваровНезависимогоСообщения(СтрокаДляПересчета, Направление);	
		
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтрокуТоваровКлиент(ТекСтрока, Направление = "ВEDI")

	ИдентификаторТекСтроки = ТекСтрока.ПолучитьИдентификатор();
	ПересчитатьСтрокуТоваровСервер(, ИдентификаторТекСтроки, Направление);	
		
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТабличнуюЧасть(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	Вопрос_ОчисткаТоваров("ПослеВопросаОбОчисткеТоваров_ОчиститьТовары");
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыХарактеристикаНоменклатурыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	ПараметрыФормыВыбора = Новый Структура;
	ДополнительныеПараметры = Новый Структура("ТекущиеДанные", ТекущиеДанные);
	
	Если ИмяКонфигурации1С = "УФ_УТ" Тогда 
		
		ПараметрыФормыВыбора.Вставить("ТекущийЭлемент"  , ТекущиеДанные.ХарактеристикаНоменклатуры);
		ПараметрыФормыВыбора.Вставить("Номенклатура"    , ТекущиеДанные.Номенклатура);
		
	ИначеЕсли ИмяКонфигурации1С = "УФ_УНФ" Тогда
		
		ОтборХарактеристик = Новый Структура;
		ОтборХарактеристик.Вставить("Владелец",ТекущиеДанные.Номенклатура);
		ПараметрыФормыВыбора.Вставить("Отбор"  , ОтборХарактеристик);
		ПараметрыФормыВыбора.Вставить("ТекущаяСтрока"  , ТекущиеДанные.ХарактеристикаНоменклатуры);
		                               
	Иначе
		Возврат; //на БП30 нет характеристик
	КонецЕсли;
	
	МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI("Справочник.ХарактеристикиНоменклатуры.ФормаВыбора", "", ПараметрыФормыВыбора, ЭтаФорма, "ДобавитьХарактеристикуЗавершение", ЭтаФорма, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьХарактеристикуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ТекущиеДанные = ДополнительныеПараметры.ТекущиеДанные;
	
	Характеристика = Результат;
	Если Характеристика = Неопределено Тогда
		Возврат;
	Иначе
		ТекущиеДанные.ХарактеристикаНоменклатуры = Характеристика;	
	КонецЕсли;
	
КонецПроцедуры

