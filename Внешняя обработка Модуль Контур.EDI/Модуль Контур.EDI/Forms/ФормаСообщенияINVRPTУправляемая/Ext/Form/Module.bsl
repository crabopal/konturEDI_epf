&НаСервере
Функция ПолучитьПараметрыДляПодготовкиСообщения(ДополнительныеПараметры = Неопределено)
	
	СтруктураПараметры = Новый Структура;
	
	СтруктураПараметры.Вставить("Сообщение",	                Сообщение);
	СтруктураПараметры.Вставить("Организация",                  Организация);
	СтруктураПараметры.Вставить("Партнер",                   	Партнер);
	СтруктураПараметры.Вставить("Контрагент",                   Контрагент); 
	СтруктураПараметры.Вставить("ТочкаДоставки",                ТочкаДоставки);
	СтруктураПараметры.Вставить("ДатаНачалаПериода",            ПериодОтчета.ДатаНачала);
	СтруктураПараметры.Вставить("ДатаОкончанияПериода",         ПериодОтчета.ДатаОкончания);
	СтруктураПараметры.Вставить("ДатаИнвентаризации",         	ДатаИнвентаризации);
	СтруктураПараметры.Вставить("ВыгружатьЦены",         		ВыгружатьЦены);
	СтруктураПараметры.Вставить("Валюта",         				Валюта);
	СтруктураПараметры.Вставить("ТипЦен",         				ТипЦен);
	СтруктураПараметры.Вставить("Продавец",         			Продавец);
	СтруктураПараметры.Вставить("ДокументНомер",         		ДокументНомер);
	СтруктураПараметры.Вставить("ДокументДата",         		ДокументДата);
	
	Если ТипЗнч(Сообщение) = Тип("Структура")
		И Сообщение.Свойство("ID") 
		И ЗначениеЗаполнено(Сообщение.ID) Тогда 
		
	СтруктураПараметры.Вставить("ID", Сообщение.ID);
	
	КонецЕсли;
	
	МыПоставщик = МыПоставщик();
	МыТорговаяСеть = НЕ МыПоставщик;
	
	СтруктураПараметры.Вставить("МыПоставщик",         			МыПоставщик);
	СтруктураПараметры.Вставить("МыТорговаяСеть",         		МыТорговаяСеть);
	
	СтруктураПараметры.Вставить("СоответствиеТочкаДоставкиСкладыОстатков", ПолучитьСоответствиеТочкаДоставкиСкладыОстатков());
	
	Если ДополнительныеПараметры <> Неопределено 
		И ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
		
		Для каждого Элемент Из ДополнительныеПараметры Цикл
			
			СтруктураПараметры.Вставить(Элемент.Ключ, Элемент.Значение);
			
		КонецЦикла;
		
	КонецЕсли;
 
	Возврат СтруктураПараметры;
	
КонецФункции

&НаСервере
Функция ПолучитьСоответствиеТочкаДоставкиСкладыОстатков() 
	
	Результат = Новый Массив;
	
	тДерево = РеквизитФормыВЗначение("СоответствиеТочкаДоставкиСкладыОстатков");
	
	Для Каждого СтрокаДерева1Уровень ИЗ тДерево.Строки Цикл
		
		Если ЗначениеЗаполнено(СтрокаДерева1Уровень.Значение) Тогда
			
			МассивСкладовОстатков = Новый Массив;
			
			Для Каждого СтрокаДерева2Уровень ИЗ СтрокаДерева1Уровень.Строки Цикл
				
				Если ЗначениеЗаполнено(СтрокаДерева2Уровень.Значение) Тогда
					
					МассивСкладовОстатков.Добавить(СтрокаДерева2Уровень.Значение);
					
				КонецЕсли;
				
			КонецЦикла;
			
			Соответствие = Новый Структура("ТочкаДоставки, СкладыОстатков", СтрокаДерева1Уровень.Значение, МассивСкладовОстатков);
			Результат.Добавить(Соответствие);		 
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Результат.Количество() = 0 Тогда 
		
		Если ЗначениеЗаполнено(ТочкаДоставки) Тогда
			
			МассивСкладовОстатков = Новый Массив;

			Если ЗначениеЗаполнено(СкладОстатков) Тогда
				
				МассивСкладовОстатков.Добавить(СкладОстатков);
				
			КонецЕсли;
			
			Соответствие = Новый Структура("ТочкаДоставки, СкладыОстатков", ТочкаДоставки, МассивСкладовОстатков);
			Результат.Добавить(Соответствие);		 
			
		КонецЕсли;
		
	КонецЕсли;
			
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьСкладыОстатковТочкиДоставкиСервер(_ТочкаДоставки)
	
	Возврат МодульОбъекта().ПолучитьСкладыОстатковТочкиДоставки(ТочкаДоставки);
	
КонецФункции

&НаСервере 
Функция ПолучитьАдресВнешнегоХранилищаДляТаблицыВыбора(Знач СписокВыбора, НазваниеКолонкиБезПробелов = "Значение") 
	
	ТаблицаВыбора = Новый ТаблицаЗначений;
	МодульОбъекта().ДобавитьКолонкиВТаблицуЗначений(ТаблицаВыбора, НазваниеКолонкиБезПробелов);
	
	Для Каждого ЭлементВыбора Из СписокВыбора Цикл 
		
		НоваяСтрока = ТаблицаВыбора.Добавить();
		НоваяСтрока[НазваниеКолонкиБезПробелов] = ЭлементВыбора.Значение;
		
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаВыбора);
	
КонецФункции 

&НаСервере
Процедура ЗаполнитьДеревоСоответствий(МассивТочекДоставок)
	
	_СоответствиеТочкаДоставкиСкладыОстатков = РеквизитФормыВЗначение("СоответствиеТочкаДоставкиСкладыОстатков");
	
	Для каждого Значение ИЗ МассивТочекДоставок Цикл
		
		ПараметрыОтбора = Новый Структура("Значение", Значение);
		
		НайденныеСтроки = _СоответствиеТочкаДоставкиСкладыОстатков.Строки.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			
			Сообщить("Точка доставки - """ + Значение + """ уже добавлена!");			
			Продолжить;
			
		КонецЕсли;
		
		НоваяСтрокаТочкиДоставки = _СоответствиеТочкаДоставкиСкладыОстатков.Строки.Добавить();
		НоваяСтрокаТочкиДоставки.Значение = Значение;
		
		МассивСкладовОстатков = МодульОбъекта().ПолучитьСкладыОстатковТочкиДоставки(Значение);
		
		Для Каждого СкладОстатковТочкиДоставки ИЗ МассивСкладовОстатков Цикл 
			
			НоваяСтрокаСкладыОстатков = НоваяСтрокаТочкиДоставки.Строки.Добавить();
			НоваяСтрокаСкладыОстатков.Значение = СкладОстатковТочкиДоставки;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(_СоответствиеТочкаДоставкиСкладыОстатков, "СоответствиеТочкаДоставкиСкладыОстатков");

	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТовары(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	Если НЕ ЗначениеЗаполнено(Партнер) Тогда 
		
		МодульОбъектаКлиент().Предупреждение_КонтурEDI("Не заполнено поле ""Партнер""");
		
		Возврат;
		
	КонецЕсли;
	
	Если Товары.Количество() <> 0 Тогда
		
		Вопрос_ОчисткаТоваров("ПослеВопросаОбОчисткеТоваров_ЗаполнитьТовары");
		
	Иначе 
		
		Результат = ЗаполнитьТоварыСервер();
		
		Если НЕ Результат.Успешно Тогда
			
			МодульОбъектаКлиент().Предупреждение_КонтурEDI(Результат.ОписаниеОшибки);			
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьТоварыСервер(ДополнительныеПараметры = Неопределено)
	
	Если ДополнительныеПараметры = Неопределено
		ИЛИ ДополнительныеПараметры.Свойство("Номенклатура") = Ложь Тогда

		Товары.Очистить();
		
	КонецЕсли;
	
	СтруктураПараметры = ПолучитьПараметрыДляПодготовкиСообщения(ДополнительныеПараметры);
	РезультатПолучения = МодульОбъекта().ПолучитьТоварыДляНезависимогоСообщения("INVRPT", СтруктураПараметры);
	
	Если РезультатПолучения.Успешно Тогда
		
		Для каждого Стр Из РезультатПолучения.Товары Цикл
			
			НоваяСтрока = Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);

			ПересчитатьСтрокуТоваровСервер(НоваяСтрока);
			
		КонецЦикла;
		
	КонецЕсли;
	
	ВозвращаемаяСтруктура = Новый Структура;
	ВозвращаемаяСтруктура.Вставить("Успешно", РезультатПолучения.Успешно);
	ВозвращаемаяСтруктура.Вставить("ОписаниеОшибки", РезультатПолучения.ОписаниеОшибки);
	
	Возврат ВозвращаемаяСтруктура;
	
КонецФункции

&НаКлиенте
Процедура ПодборСвоиТочкиДоставки(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	ИмяОткрываемойФормы = "Справочник." + ПолучитьТипЗначенияОбъекта_НаСервере("ТочкаДоставкиСвоя", , Истина) + ".ФормаВыбора";
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Ложь);
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	
	ВладелецФормы_ = Элементы.СоответствиеТочкаДоставкиСкладыОстатков;
	Уникальность = ЭтаФорма;
		
	ОткрытьФорму(ИмяОткрываемойФормы, ПараметрыФормы, ВладелецФормы_, Уникальность);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборСторонниеТочкиДоставки(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	Если НЕ ЗначениеЗаполнено(Партнер) Тогда 
		
		МодульОбъектаКлиент().Предупреждение_КонтурEDI("Не заполнен ""Партнер""!");
		Возврат;
		
	КонецЕсли;
	
	ИмяОткрываемойФормы = "Справочник.КонтурEDI_ТочкиДоставки.ФормаВыбора";
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", Новый Структура("Партнер", Партнер));
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Ложь);
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	
	ВладелецФормы_ = Элементы.СоответствиеТочкаДоставкиСкладыОстатков;
	Уникальность = ЭтаФорма;
		
	ОткрытьФорму(ИмяОткрываемойФормы, ПараметрыФормы, ВладелецФормы_, Уникальность);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбОчисткеТоваров_ЗаполнитьТовары(ВыбранноеЗначение, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ВыбранноеЗначение = КодВозвратаДиалога.Да Тогда
		
		Результат = ЗаполнитьТоварыСервер();
		
		Если НЕ Результат.Успешно Тогда
			
			МодульОбъектаКлиент().Предупреждение_КонтурEDI(Результат.ОписаниеОшибки);			
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбОчисткеТоваров_ОчиститьТовары(ВыбранноеЗначение, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ВыбранноеЗначение = КодВозвратаДиалога.Да Тогда
		
		Товары.Очистить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияОтправки(ВыбранноеЗначение, ДополнительныеПараметры = Неопределено) Экспорт 
	
	Если ВыбранноеЗначение = КодВозвратаДиалога.Да Тогда 
		
		НачалоОтправкиСообщения();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораЗначения(ВыбранноеЗначение, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда 
		
		ЗначениеВыбора = ПолучитьРезультатВыбораИзУниверсальнойФормы_НаСервере(ВыбранноеЗначение, ДополнительныеПараметры.Элемент.Имя);
		ЭтаФорма[ДополнительныеПараметры.Элемент.Имя] = ЗначениеВыбора;
		УниверсальныйПриИзменении(ДополнительныеПараметры.Элемент);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте 
Процедура ПослеПредупрежденияОПустыхТоварах(ВыбранноеЗначение, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ВыбранноеЗначение <> КодВозвратаДиалога.Да Тогда 
		
		Возврат; 
		
	КонецЕсли;
	
	МассивТочекДоставокСПустымиТоварами = ДополнительныеПараметры.МассивТочекДоставокСПустымиТоварами;
	
	НаборСоответствие = Новый Массив;
	
	Для Каждого Соответствие Из ДополнительныеПараметры.СоответствиеТочкаДоставкиСкладыОстатков Цикл 
		
		_ТочкаДоставки = Соответствие.ТочкаДоставки;
		
		Если МассивТочекДоставокСПустымиТоварами.Найти(_ТочкаДоставки) = Неопределено Тогда 
			
			НаборСоответствие.Добавить(Соответствие);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДополнительныеПараметры.Вставить("СоответствиеТочкаДоставкиСкладыОстатков", НаборСоответствие); 
	КоличествоПолученныхСоответствий = НаборСоответствие.Количество();
	
	Если КоличествоПолученныхСоответствий > 1 Тогда 
		
		Вопрос_БудетОтправленоНесколькоСообщеений(ДополнительныеПараметры);		
	
	ИначеЕсли КоличествоПолученныхСоответствий = 0 Тогда
		
		МодульОбъектаКлиент().Предупреждение_КонтурEDI("Нет товаров для отправки");		
		
	Иначе 
		
		ОтправитьСообщение(ДополнительныеПараметры);
		Закрыть();
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияОтправкиНесколькихСообщений(ВыбранноеЗначение, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ВыбранноеЗначение <> КодВозвратаДиалога.Да Тогда 
		
		Возврат; 
		
	КонецЕсли;
	
	ОтправитьСообщение(ДополнительныеПараметры);
	Закрыть();
	
	
КонецПроцедуры

&НаКлиенте 
Процедура ПослеВыбораТипаПродавца(ВыбранноеЗначение, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ВыбранноеЗначение = "Наша организация" Тогда 

		ЗаполнитьСписокВыбораЭлемента("Продавец", Элементы.Организация.СписокВыбора); 
		
	ИначеЕсли ВыбранноеЗначение = "Контрагент" Тогда 
		
		ЗаполнитьСписокВыбораЭлемента("Продавец", Элементы.Контрагент.СписокВыбора); 
		
	Иначе 
		
		Возврат;
		
	КонецЕсли;
	
	ПоказатьВыборИзУниверсальнойФормы(Элементы.Продавец);
	
КонецПроцедуры

&НаКлиенте 
Процедура ПослеВыбораТипаПодбораТочкиДоставки(ВыбранноеЗначение, ДополнительныеПараметры = Неопределено) Экспорт 
	
	Если ВыбранноеЗначение = "Свои точки доставки" Тогда
		
		НазваниеСправочника = "ТочкиДоставкиСвои";
		
	ИначеЕсли ВыбранноеЗначение = "Сторонние точки доставки" Тогда 
		
		НазваниеСправочника = "ТочкиДоставкиСторонние";
		
	Иначе 
		
		Возврат;
		
	КонецЕсли;
	
	ЗаполнитьСписокЗначенийТочкаДоставки_НаСервере(НазваниеСправочника, Партнер);
	ПоказатьВыборИзУниверсальнойФормы(Элементы.ТочкаДоставки);
	
КонецПроцедуры 

&НаКлиенте
Процедура ПослеВыбораСоответствияИзМеню(ВыбранноеЗначение, ДопПараметры) Экспорт
	
	Если НЕ ВыбранноеЗначение = Неопределено Тогда
		
		ТекСтрока = Элементы.Товары.ТекущиеДанные;
		
		Если МыПоставщик() Тогда 
			
			КодТовараПартнера = ТекСтрока.КодТовараПокупателя;
			
		Иначе
			
			КодТовараПартнера = ТекСтрока.КодТовараПоставщика;
			
		КонецЕсли;

		
		Если ВыбранноеЗначение.Значение = "Настроить соответствие товаров" Тогда
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Партнер",		Партнер);
			ПараметрыФормы.Вставить("GTIN",			ТекСтрока.GTIN);
			ПараметрыФормы.Вставить("Наименование", ТекСтрока.Наименование);
			ПараметрыФормы.Вставить("КодТовараПартнера", КодТовараПартнера);
			ПараметрыФормы.Вставить("КодЕдиницыИзмеренияEDI", ТекСтрока.КодЕдиницыИзмеренияEDI);
			
			МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI("Номенклатура_ЭлементУправляемая", , ПараметрыФормы, ЭтаФорма, "ПослеИнтерактивнойНастройкиСоответствий", ЭтаФорма);
			
		Иначе
			ПересчитатьСтрокуТоваровКлиент(ТекСтрока, "В1С");
			
			СтруктураТовара = ВыбранноеЗначение.Значение;
			ЗаполнитьЗначенияСвойств(ТекСтрока, СтруктураТовара, "Номенклатура,ЕдиницаИзмерения,КодЕдиницыИзмеренияEDI,КоэффициентEDIВ1С");

			ПересчитатьСтрокуТоваровКлиент(ТекСтрока, "ВEDI");	
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеИнтерактивнойНастройкиСоответствий(ВыбранноеЗначение, ДопПараметры) Экспорт
	
	ТекСтрока = Элементы.Товары.ТекущиеДанные;
	ИдентификаторТекСтроки = ТекСтрока.ПолучитьИдентификатор();
	ПослеИнтерактивнойНастройкиСоответствий_Сервер(ИдентификаторТекСтроки);//передать идентификатор строки
		
КонецПроцедуры

&НаСервере
Процедура ПослеИнтерактивнойНастройкиСоответствий_Сервер(ИдентификаторТекСтроки)     //найти строку по идентификатору
	
	ВыбраннаяСтрока = Товары.НайтиПоИдентификатору(ИдентификаторТекСтроки);
	
	Если МыПоставщик() Тогда 
		
		КодТовараПартнера = ВыбраннаяСтрока.КодТовараПокупателя;
		
	Иначе
		
		КодТовараПартнера = ВыбраннаяСтрока.КодТовараПоставщика;
		
	КонецЕсли;

	
	СоответствиеТоваров = МодульОбъекта().СоответствиеТоваров_НайтиНоменклатуру(ВыбраннаяСтрока.GTIN, КодТовараПартнера, Партнер);
	
	Для каждого Стр Из СоответствиеТоваров Цикл
		Если Стр.Номенклатура = ВыбраннаяСтрока.Номенклатура Тогда
			ПересчитатьСтрокуТоваровСервер(ВыбраннаяСтрока,, "В1С");	
			
			ВыбраннаяСтрока.Номенклатура 			= Стр.Номенклатура;
			ВыбраннаяСтрока.ЕдиницаИзмерения 		= Стр.ЕдиницаИзмерения;
			ВыбраннаяСтрока.КодЕдиницыИзмеренияEDI 	= Стр.ЕдиницаEDI;
			ВыбраннаяСтрока.КоэффициентEDIВ1С 		= Стр.КоэффициентEDIВ1С;
			
			ПересчитатьСтрокуТоваровСервер(ВыбраннаяСтрока,, "ВEDI");	
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодбораНоменклатуры(ВыбранаяНоменклатура, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ВыбранаяНоменклатура <> Неопределено Тогда
		
		СтруктураДопПараметры = Новый Структура("Номенклатура", ВыбранаяНоменклатура);
		Результат = ЗаполнитьТоварыСервер(СтруктураДопПараметры);
		
		Если НЕ Результат.Успешно Тогда
			
			МодульОбъектаКлиент().Предупреждение_КонтурEDI(Результат.ОписаниеОшибки);			
			
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПроверитьНаличиеТоваровПоВыбраннымСкладам(ПроверяемоеСоответствие)
	
	Результат = Новый Структура("Успешно,ОписаниеОшибки,МассивТочекДоставокСПустымиТоварами", Истина, "");
	
	_Товары = РеквизитФормыВЗначение("Товары");
	
	МассивТочекДоставокСПустымиТоварами = Новый Массив;
	
	Для Каждого Соответствие Из ПроверяемоеСоответствие Цикл
		
		_ТочкаДоставки = Соответствие.ТочкаДоставки;
		_СкладыОстатков = Соответствие.СкладыОстатков;
		
		ПолученныеТовары = МодульОбъекта().ОтфильтроватьТаблицуТоваровПоСкладам(_Товары, _СкладыОстатков); 
		
		Если ПолученныеТовары.Количество() = 0
			И МассивТочекДоставокСПустымиТоварами.Найти(_ТочкаДоставки) = Неопределено Тогда
			
			МассивТочекДоставокСПустымиТоварами.Добавить(_ТочкаДоставки);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивТочекДоставокСПустымиТоварами.Количество() <> 0 Тогда 
		
		Результат.Успешно = Ложь;
		
		ТекстОшибки = "Для указанных точек доставки, не найдены товары, которые соответствуют выбранным складам остатков:
					  |
					  |";
		
		Для Каждого ТочкаДоставкиСПустымиТоварами Из МассивТочекДоставокСПустымиТоварами Цикл
			
			ТекстОшибки = ТекстОшибки + " - " + ТочкаДоставкиСПустымиТоварами + Символы.ПС; 
			
		КонецЦикла;
		
		ТекстОшибки = ТекстОшибки + "
									 |по данным точкам доставки сообщение отправлено не будет.";
		
		Результат.ОписаниеОшибки = ТекстОшибки;
		
	КонецЕсли;
	
	Результат.МассивТочекДоставокСПустымиТоварами = МассивТочекДоставокСПустымиТоварами;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПроверитьЗаполнениеТабличнойЧасти_КонтурEDI()
	
	Если Товары.Количество() = 0 Тогда 
		
		МодульОбъектаКлиент().Предупреждение_КонтурEDI("Заполните табличную часть ""Товары""");	
		Возврат Ложь;
		
	КонецЕсли;
	
	Успешно = Истина;
	
	Для Каждого СтрокаТовары Из Товары Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаТовары.GTIN)
			И НЕ ЗначениеЗаполнено(СтрокаТовары.КодТовараПокупателя)
			И НЕ ЗначениеЗаполнено(СтрокаТовары.КодТовараПоставщика) Тогда 
			
			Индекс = Товары.Индекс(СтрокаТовары);
			Сообщить = Новый СообщениеПользователю;
			Сообщить.Текст = "Заполните хотя бы один идентификатор товара 
							 | - GTIN 
							 | - Код товара покупателя
							 | - Код товара поставщика";
			
			Сообщить.Поле = "Товары["+Индекс+"].GTIN";
			Сообщить.Сообщить();
			
			Успешно = Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Успешно;
	
КонецФункции 

// Универсальный Акцептор Нажатия Доавбленной Кнопки
&НаКлиенте
Процедура АкцепторДобавленнойКнопки(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	// Действия, которые нужно выполнить на клиенте, например что-то спросить
	КлиентскийКодОбработчика = ПолучитьКлиентскийКодОбработчикаНажатияКнопки(Команда.Имя);
	
	Если КлиентскийКодОбработчика <> Неопределено Тогда 
		// в этот момент мы знаем Команда.Имя и можем выполнить нужный код внутри КлиентскийКодОбработчика смотри описание функции ПолучитьКлиентскийКодОбработчикаНажатияКнопки
		// для дальнейшей передачи на сервер для обработки Использовать  ОбработчикИнтерактивногоДействияДобавленнойкнопки(РезультатДействия,ИмяКоманды)
		Выполнить(КлиентскийКодОбработчика); 	
	КонецЕсли;
	
	// Вне зависимости от наличия клиентского обработчика выполняем серверную процедуру	
	АкцепторДобавленнойКнопкиСервер(Команда.Имя);
	
КонецПроцедуры

