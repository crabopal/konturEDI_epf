Функция ПолучитьРезультатВыбораИзУниверсальнойФормы_НаСервере(АдресВХ, Имя = "", Единственный = Истина)
	
	ПолученноеЗначение = МодульОбъекта().ПолучитьРезультатВыбораИзУниверсальнойФормы(АдресВХ);
	
	Если ЗначениеЗаполнено(ПолученноеЗначение)
		И ПолученноеЗначение.Количество() > 0 Тогда
		
		Если Единственный = Истина Тогда
			
			Возврат ПолученноеЗначение[0][Имя];
			
		Иначе 
			
			Возврат ПолученноеЗначение;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
