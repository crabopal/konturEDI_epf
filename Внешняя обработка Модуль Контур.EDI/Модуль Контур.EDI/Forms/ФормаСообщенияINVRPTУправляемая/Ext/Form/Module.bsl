&НаКлиенте
Процедура НесколькоТочекДоставкиПриИзменении(Элемент)
	
	ВидимостьЭлементовПриРазделенииПоСкладам(НесколькоТочекДоставки);
	
	Если НесколькоТочекДоставки = Ложь Тогда 
		
		Элементы.СкладОстатков.Доступность = Ложь;	
		
	КонецЕсли;

	
КонецПроцедуры

&НаКлиенте
Процедура ВидимостьЭлементовПриРазделенииПоСкладам(Видимость = Истина) 
	
	Элементы.ГруппаСтраницаТочкиДоставкиСклады.Видимость = Видимость;
	
	ТочкаДоставки = Неопределено;
	СкладОстатков = Неопределено;
	
	Элементы.ТочкаДоставки.Доступность = НЕ Видимость;
	Элементы.СкладОстатков.Доступность = НЕ Видимость;	
	
	ОбновитьЕстьТочкиДоставкиИДоступностьКнопокПодбор();
	
	Если Видимость = Истина Тогда 
		
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницаТочкиДоставкиСклады;
		
	Иначе 
		
		ОчиститьДеревоСоответствиеТочкаДоставкиСкладыОстатков();
		
	КонецЕсли;		

КонецПроцедуры

&НаСервере
Процедура ОчиститьДеревоСоответствиеТочкаДоставкиСкладыОстатков()
	
   тДерево = РеквизитФормыВЗначение("СоответствиеТочкаДоставкиСкладыОстатков");
 
   тДерево.Строки.Очистить();
 
   ЗначениеВРеквизитФормы(тДерево, "СоответствиеТочкаДоставкиСкладыОстатков");
   
КонецПроцедуры

&НаКлиенте
Процедура СоответствиеТочкаДоставкиСкладыОстатковОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	МассивВыбранныхЗначений = ВыбранноеЗначение;
	
	Если НЕ ЗначениеЗаполнено(МассивВыбранныхЗначений) Тогда 
		
		Возврат;
		
	КонецЕсли;
	
	ЗаполнитьДеревоСоответствий(МассивВыбранныхЗначений);
	
КонецПроцедуры

&НаКлиенте
Процедура Подробно(Команда)               
              
	НоваяМетрика().НажатаКнопка(Команда).НаФорме(ЭтаФорма).ПоместитьВОчередь();             
	
	Видимость = НЕ (Элементы.ТоварыПодробно.Пометка = Истина);
	
	Подробно_ВидимостьКолонок(Видимость);
	
	Элементы.ТоварыПодробно.Пометка = Видимость;
	
