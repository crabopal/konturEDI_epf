Процедура ОбработкаОповещения(ИмяСобытияОповещения, Параметр, Источник)
	                                      //ждем  Параметр.ИмяКоманды, Параметр.Результат
	Если ИмяСобытияОповещения = "ОповещениеИзПодключаемогоМодуля" Тогда 
		АкцепторДобавленнойКнопкиСервер(Параметр.ИмяКоманды,Параметр.Результат)
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура УниверсальныйНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элемент.СписокВыбора.Количество() = 0 Тогда
		
		Если Элемент.Имя = "Партнер" Тогда 
			
			ТекстОшибки = "Не найдены партнеры, работающие с INVRPT. 
			|Проверьте настройки партнеров.";
			
		ИначеЕсли Элемент.Имя = "Организация" Тогда
			
			ТекстОшибки = "Не найдены наши организации. 
			|Проверьте ""Структура компании"" в общий настройках.";
			
		ИначеЕсли Элемент.Имя = "Контрагент" Тогда 
			
			ТекстОшибки = "Не найдены контрагенты партнера. 
			|Проверьте настройки партнера.";
			
		Иначе 
			
			ТекстОшибки = "Не найдены значения выбора."
			
		КонецЕсли;
		
		МодульОбъектаКлиент().Предупреждение_КонтурEDI(ТекстОшибки);
		
		Возврат;
		
	КонецЕсли;
	
	ПоказатьВыборИзУниверсальнойФормы(Элемент);	
	
КонецПроцедуры

&НаКлиенте
Процедура УниверсальныйПриИзменении(Элемент)
	
	Если Элемент.Имя = "Партнер" Тогда
		
		ОбновитьПолеКонтрагент();
		ОбновитьПолеПродавец();
		ОбновитьПолеТочкаДоставки();
		ОбновитьПолеСкладОстатков();
		ОчиститьДеревоСоответствиеТочкаДоставкиСкладыОстатков();
		Товары.Очистить();
		
		ОбновитьЕстьТочкиДоставкиИДоступностьКнопокПодбор();
		
		
	ИначеЕсли Элемент.Имя = "Организация" Тогда 
		
		ОбновитьПолеПродавец();
		
	ИначеЕсли Элемент.Имя = "Контрагент" Тогда 
		
		ОбновитьПолеПродавец();
		
	ИначеЕсли Элемент.Имя = "ТочкаДоставки" Тогда 
		
		ОбновитьПолеСкладОстатков();
		
	КонецЕсли;
	
	ОчиститьЗначенияЭлементов();
	ОбновитьДоступностьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВыборИзУниверсальнойФормы(Элемент)
	
	АдресВнешнегоХранилища = ПолучитьАдресВнешнегоХранилищаДляТаблицыВыбора(Элемент.СписокВыбора, Элемент.Имя);
	
	ИмяОткрываемойФормы  = "УниверсальнаяФормаВыбораУправляемая"; 
	ПолныйПутьКФорме 	 = Неопределено;
	ПараметрыФормы 		 = Новый Структура("АдресТаблицыВХранилище", АдресВнешнегоХранилища);
	ВладелецФормы_ 		 = ЭтаФорма; 
	ИмяОбработчика 		 = "ПослеВыбораЗначения"; 
	КонтекстОбработчика  = ЭтаФорма; 
	ПараметрыОбработчика = Новый Структура("Элемент", Элемент);
	
	МодульОбъектаКлиент().ОткрытьФорму_КонтурEDI(ИмяОткрываемойФормы,
												 ПолныйПутьКФорме,
												 ПараметрыФормы,
												 ВладелецФормы_,
												 ИмяОбработчика,
												 КонтекстОбработчика,
												 ПараметрыОбработчика);
	
КонецПроцедуры

