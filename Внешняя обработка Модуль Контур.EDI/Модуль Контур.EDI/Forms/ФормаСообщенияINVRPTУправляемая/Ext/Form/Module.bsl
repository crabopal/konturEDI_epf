&НаКлиенте
Перем ЕстьТочкиДоставкиСторонние;

&НаКлиенте
Перем ЕстьТочкиДоставкиСвои;

&НаСервере
Перем МодульОбъекта;

&НаКлиенте
Перем МодульОбъектаКлиент;

// СЛУЖЕБНЫЕ {

&НаСервере
Функция МодульОбъекта()
	
	Если МодульОбъекта = Неопределено Тогда
		
		Если Объект.ПараметрыКлиентСервер.КэшироватьОбработкуОбъект Тогда
			МодульОбъекта = МодульОбъектаИзКэша();
		КонецЕсли;
		
		Если МодульОбъекта = Неопределено Тогда
			МодульОбъекта = РеквизитФормыВЗначение("Объект");
			МодульОбъекта.ИнициализироватьПодключаемыеМодули();
			МодульОбъекта.ОбновитьКэшМодуляОбъекта();
		КонецЕсли;
		
	КонецЕсли;	
	
	Возврат МодульОбъекта;
	
КонецФункции

&НаСервере
Функция МодульОбъектаИзКэша()
	
	Результат = Неопределено;
	
	Если ТипЗнч(Объект.ПараметрыКлиентСервер) = Тип("Структура") Тогда
		АдресВХ = Объект.ПараметрыКлиентСервер.АдресаВХ.ОбработкаОбъект;
 		Если ЭтоАдресВременногоХранилища(АдресВХ) Тогда
			Структура = ПолучитьИзВременногоХранилища(АдресВХ);
			Если ТипЗнч(Структура) = Тип("Структура") и Структура.Свойство("ОбработкаОбъект") Тогда
			 	Результат = Структура.ОбработкаОбъект;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция МодульОбъектаКлиент()
	
	Если ТипЗнч(МодульОбъектаКлиент) = Тип("УправляемаяФорма") Тогда
		Возврат МодульОбъектаКлиент;
	КонецЕсли;
	
	ОсновнаяФорма = ОсновнаяФорма();
	Если ТипЗнч(ОсновнаяФорма) = Тип("УправляемаяФорма") Тогда
		МодульОбъектаКлиент = ОсновнаяФорма.МодульОбъектаКлиент();
		Возврат МодульОбъектаКлиент;
	Иначе
		Сообщить("Ошибка! Не удалось получить контекст основной формы.");
	КонецЕсли;
	          	
КонецФункции

&НаКлиенте
Функция ОсновнаяФорма() Экспорт
	
	Если ЭтаФорма.ВладелецФормы = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		Возврат ЭтаФорма.ВладелецФормы.ОсновнаяФорма();
	КонецЕсли;
    	
КонецФункции

&НаКлиенте
Функция НоваяМетрика()
	
	Возврат ОсновнаяФорма().НоваяМетрика();
	
КонецФункции

// } СЛУЖЕБНЫЕ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ОбъектПараметрыКлиентСервер",        Объект.ПараметрыКлиентСервер);
	Параметры.Свойство("ОбъектПараметрыКлиентСерверМетрика", Объект.ПараметрыКлиентСерверМетрика);
	
	ТолькоПросмотрСообщения = (Параметры.ТолькоПросмотр = Истина);

	Если ЗначениеЗаполнено(Сообщение) Тогда
		
		ТипСообщения 	= Сообщение.ТипСообщения;
		Направление 	= Сообщение.Направление;
		
	Иначе 
		
		ТипСообщения = "INVRPT";
		Параметры.Свойство("Направление", Направление);
						
		Сообщение = МодульОбъекта().ПолучитьСтруктуруСообщения(ТипСообщения, Направление);
		
	КонецЕсли;

	НастройкаФормы = МодульОбъекта().ПолучитьНастройкиФормыНезависимогоСообщения(ТипСообщения, Параметры.Направление);
	ВыполнитьНастройкиФормы(); 
	
	Если Параметры.Свойство("СообщениеСсылка") И ЗначениеЗаполнено(Параметры.СообщениеСсылка) Тогда
		
		СообщениеСсылка = Параметры.СообщениеСсылка;
		Сообщение = МодульОбъекта().ПрочитатьСообщение(СообщениеСсылка,, ТипСообщения, Параметры.Направление);
		
		СообщениеОбъект = МодульОбъекта().ПолучитьОбъектСообщения(СообщениеСсылка);
		ТекстОшибки = СообщениеОбъект.ОписаниеОшибки;
		
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда 
			
			Элементы.ГруппаОписаниеОшибки.Видимость = Истина;
			Элементы.ОписаниеОшибки.Заголовок = ТекстОшибки;
			
		КонецЕсли;

		ЗаполнитьПоляНаФорме();
		
	КонецЕсли;
	
	МодульОбъекта().ПриОткрытииФормыСообщения(Сообщение,ЭтаФорма);
	
	ПоместитьТаблицыЗначенийПроизвольныхРеквизитовВХранилище();	
	УничтожитьТаблицыЗначенийПроизвольныхРеквизитов();
	
	УстановитьЗаголовокФормы_КонтурEDI();
	
 КонецПроцедуры
 
 &НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ТолькоПросмотрСообщения = Ложь Тогда
		
		ОбновитьЕстьТочкиДоставкиИДоступностьКнопокПодбор();
		
	КонецЕсли;
	
	УстановитьДоступностьЭлементов();
	
	Если ТолькоПросмотрСообщения = Ложь Тогда 
		
		ОбновитьЗначенияПолей();
		ОбновитьДоступностьЭлементов();
		
	КонецЕсли;
	
	ОсновнаяФорма().ПриОткрытииФормы(ЭтаФорма, "ФормаСообщенияINVRPTУправляемая");

КонецПроцедуры 

&НаСервере
Процедура УничтожитьТаблицыЗначенийПроизвольныхРеквизитов() Экспорт 
	
	Для Каждого ЭлементСтруктуры Из НастройкаФормы Цикл
		Если ТипЗнч(ЭлементСтруктуры.Значение) = Тип("ТаблицаЗначений") Тогда
			НастройкаФормы[ЭлементСтруктуры.Ключ] = Неопределено;	
		КонецЕсли;
	КонецЦикла;

	Для Каждого ЭлементСтруктуры Из Сообщение Цикл
		Если ТипЗнч(ЭлементСтруктуры.Значение) = Тип("ТаблицаЗначений") Или ТипЗнч(ЭлементСтруктуры.Значение) = Тип("ДеревоЗначений") Тогда
			Сообщение[ЭлементСтруктуры.Ключ] = Неопределено;	
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура ПоместитьТаблицыЗначенийПроизвольныхРеквизитовВХранилище() Экспорт
	
	СтруктураВременногоХранилища = Новый Структура;
	
	СтруктураНастройкаФормы = Новый Структура;
	
	Для Каждого ЭлементСтруктуры Из НастройкаФормы Цикл
		Если ТипЗнч(ЭлементСтруктуры.Значение) = Тип("ТаблицаЗначений") Тогда
			СтруктураНастройкаФормы.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);	
		КонецЕсли;
	КонецЦикла;
	
	Если СтруктураНастройкаФормы.Количество() > 0 Тогда 
		СтруктураВременногоХранилища.Вставить("НастройкаФормы", СтруктураНастройкаФормы);	
	КонецЕсли;
	
	СтруктураСообщение = Новый Структура;
	
	Для Каждого ЭлементСтруктуры Из Сообщение Цикл
		Если ТипЗнч(ЭлементСтруктуры.Значение) = Тип("ТаблицаЗначений") Или ТипЗнч(ЭлементСтруктуры.Значение) = Тип("ДеревоЗначений") Тогда
			СтруктураСообщение.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);	
		КонецЕсли;
	КонецЦикла;
	
	Если СтруктураСообщение.Количество() > 0 Тогда 
		СтруктураВременногоХранилища.Вставить("Сообщение", СтруктураСообщение);
	КонецЕсли;

	Если СтруктураВременногоХранилища.Количество() > 0 Тогда 
		АдресВХПроизвольныеРеквизиты = ПоместитьВоВременноеХранилище(СтруктураВременногоХранилища, ЭтаФорма.УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьНастройкиФормы()

	ЗаполнитьСпискиВыбораПолей();
	ЗаполнитьСпискиВыбораКолонок();
	УстановитьТипыПолей1С();
	МодульОбъекта().УстановитьФорматЭлементаФормы_КонтурEDI(Элементы.ТоварыКоэффициентEDIВ1С);
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпискиВыбораПолей()
	
	СпискиВыбораПолей = НастройкаФормы.СпискиВыбораПолей;
	
	Для каждого ТекСписок Из СпискиВыбораПолей Цикл
	    ЗаполнитьСписокВыбораЭлемента(ТекСписок.Ключ, ТекСписок.Значение);
	КонецЦикла;
	
КонецПроцедуры

 &НаСервере
Процедура ЗаполнитьСпискиВыбораКолонок()
	
	СпискиВыбораКолонок = НастройкаФормы.СпискиВыбораКолонок;
	
	Для каждого ТекСписок Из СпискиВыбораКолонок Цикл
		
	    ЗаполнитьСписокВыбораЭлемента("Товары" + ТекСписок.Ключ, ТекСписок.Значение);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораЭлемента(ИмяЭлемента, Знач Список)
	
	Элемент = Элементы[ИмяЭлемента];
	
	Элемент.СписокВыбора.Очистить();
	
	Для каждого Эл Из Список Цикл
		
		Элемент.СписокВыбора.Добавить(Эл.Значение, Эл.Представление);
		
	КонецЦикла;
	
	Количество = Элемент.СписокВыбора.Количество();
	
	ВложенныйРеквизит = Найти(Элемент.ПутьКДанным, ".") <> 0;
	
	Если Количество = 1 И НЕ ВложенныйРеквизит Тогда
		
		ЭтаФорма[Элемент.ПутьКДанным] = Элемент.СписокВыбора.Получить(0).Значение;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоляНаФорме()
	
	ЭтаФорма.Заголовок = ЭтаФорма.Заголовок + " № " + Сообщение.ДокументEDI.Номер + " от " + Формат(Сообщение.ДокументEDI.Дата, "ДЛФ=Д");
	
	ДокументДата  = Сообщение.ДокументEDI.Дата;
	ДокументНомер = Сообщение.ДокументEDI.Номер;
	
	Сообщение.Свойство("Партнер", Партнер);
	
	МыПоставщик = МодульОбъекта().ОпределитьКемМыЯвляемся(Сообщение) = "Поставщик"; 
	МыТорговаяСеть = НЕ МыПоставщик;
	
	Если МыПоставщик Тогда
		
		Контрагент = Сообщение.Покупатель1С;
		Организация = Сообщение.Продавец1С;
		
	Иначе 
		
		Контрганет = Сообщение.Продавец1С;
		Организация = Сообщение.Покупатель1С;
		
	КонецЕсли;
	
	Сообщение.Свойство("ДатаИнвентаризации", ДатаИнвентаризации);
	
	ПериодОтчета = Новый СтандартныйПериод;
	ПериодОтчета.ДатаНачала = Сообщение.ДатаНачалаПериодаОтчета;
	ПериодОтчета.ДатаОкончания = Сообщение.ДатаОкончанияПериодаОтчета; 
	
	Сообщение.Свойство("ТочкаДоставки1С", ТочкаДоставки);
	Сообщение.Свойство("Продавец1С",  Продавец);
	Сообщение.Свойство("Валюта1С", Валюта);
	Сообщение.Свойство("ТипЦен", ТипЦен);
	
	Для Каждого Строка Из Сообщение.Товары Цикл  
		
		ПересчитатьСтрокуТоваровСервер(Строка, , "В1С");
		
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
		
		ПересчитатьСтрокуТоваровСервер(НоваяСтрока, , "ВEDI");
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТипыПолей1С()
	
	ТипТипыЦен 					  = МодульОбъекта().ПолучитьТипЗначенияОбъекта("ТипыЦен");
	ТипВалюта 					  = МодульОбъекта().ПолучитьТипЗначенияОбъекта("Валюта");
	ТипНоменклатуры 		      = МодульОбъекта().ПолучитьТипЗначенияОбъекта("Номенклатура");
	ТипЕдиницыИзмерения     	  = МодульОбъекта().ПолучитьТипЗначенияОбъекта("ЕдиницаИзмерения");
	ТипХарактеристикаНоменклатуры = МодульОбъекта().ПолучитьТипЗначенияОбъекта("ХарактеристикаНоменклатуры");
	//ТипСкладОстатков 			  = МодульОбъекта().ПолучитьТипЗначенияОбъекта("ТочкаДоставкиСвоя");
	
	Если ЗначениеЗаполнено(ТипТипыЦен) Тогда
		
		Элементы.ТипЦен.ОграничениеТипа = Новый ОписаниеТипов(ТипТипыЦен);
		ТипЦен = МодульОбъекта().ПолучитьПустуюСсылкуОбъекта("ТипыЦен");
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТипВалюта) Тогда
		
		Элементы.Валюта.ОграничениеТипа = Новый ОписаниеТипов(ТипВалюта);
		Валюта = МодульОбъекта().ПолучитьПустуюСсылкуОбъекта("Валюта");
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТипНоменклатуры) Тогда
		
		Элементы.ТоварыНоменклатура.ОграничениеТипа = Новый ОписаниеТипов(ТипНоменклатуры);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТипЕдиницыИзмерения) Тогда
		
		Элементы.ТоварыЕдиницаИзмерения.ОграничениеТипа = Новый ОписаниеТипов(ТипЕдиницыИзмерения);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТипХарактеристикаНоменклатуры) Тогда
		
		Элементы.ТоварыХарактеристикаНоменклатуры.ОграничениеТипа = Новый ОписаниеТипов(ТипХарактеристикаНоменклатуры);
		ЕстьХарактеристикаНоменклатуры = Истина;
		
	Иначе 
		
		ЕстьХарактеристикаНоменклатуры = Ложь;
		Элементы.ТоварыХарактеристикаНоменклатуры.Видимость = Ложь;
	
	КонецЕсли;
	
	//Если ЗначениеЗаполнено(ТипСкладОстатков) Тогда 
	//	
	//	Элементы.СкладОстатков.ОграничениеТипа = Новый ОписаниеТипов(ТипСкладОстатков);
	//	
	//КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокФормы_КонтурEDI()
	
	ПредставлениеТипаСообщения = НастройкаФормы.Заголовок;
	ПредставлениеДатыСообщения = МодульОбъекта().ПолучитьПредставлениеДатыСообщения(Сообщение);
	
	ЭтаФорма.Заголовок = ПредставлениеТипаСообщения + " (" + ТипСообщения + ") " + ПредставлениеДатыСообщения;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьЭлементов()
	
	Элементы.ДокументНомер.ТолькоПросмотр 		   = ТолькоПросмотрСообщения;
	Элементы.ДокументДата.ТолькоПросмотр 		   = ТолькоПросмотрСообщения;
	Элементы.Партнер.ТолькоПросмотр 			   = ТолькоПросмотрСообщения;
	Элементы.Организация.ТолькоПросмотр 		   = ТолькоПросмотрСообщения;
	Элементы.Контрагент.ТолькоПросмотр			   = ТолькоПросмотрСообщения;
	Элементы.Продавец.ТолькоПросмотр 			   = ТолькоПросмотрСообщения;
	Элементы.ТочкаДоставки.ТолькоПросмотр 		   = ТолькоПросмотрСообщения;
	Элементы.НесколькоТочекДоставки.ТолькоПросмотр = ТолькоПросмотрСообщения;
	Элементы.СкладОстатков.ТолькоПросмотр 	       = ТолькоПросмотрСообщения;
	Элементы.ПериодОтчета.ТолькоПросмотр 		   = ТолькоПросмотрСообщения;
	Элементы.ДатаИнвентаризации.ТолькоПросмотр     = ТолькоПросмотрСообщения;
	
	Элементы.ПодменюДобавить.Видимость 					   = НЕ ТолькоПросмотрСообщения;
	Элементы.ТоварыЗаполнитьТовары.Видимость 			   = НЕ ТолькоПросмотрСообщения;
	Элементы.ФормаОсновныеДействияФормыОтправить.Видимость = НЕ ТолькоПросмотрСообщения;
	Элементы.ГруппаСтраницаТочкиДоставкиСклады.Видимость   = НЕ ТолькоПросмотрСообщения;
	
	Элементы.СкладОстатков.Видимость 		= НЕ ТолькоПросмотрСообщения;
	Элементы.НадписьСкладОстатков.Видимость = НЕ ТолькоПросмотрСообщения;
	Элементы.НесколькоТочекДоставки.Видимость = НЕ ТолькоПросмотрСообщения;
	Элементы.ЗагрушкаОтступ.Видимость = НЕ ТолькоПросмотрСообщения;
	Элементы.ТоварыОчиститьТабличнуюЧасть.Видимость = НЕ ТолькоПросмотрСообщения;
	
	
	
	Элементы.Товары.ТолькоПросмотр = ТолькоПросмотрСообщения;
	Элементы.СоответствиеТочкаДоставкиСкладыОстатков.ТолькоПросмотр = ТолькоПросмотрСообщения;
	
	Если ТолькоПросмотрСообщения = Ложь Тогда 
		
		ВидимостьЭлементовПриРазделенииПоСкладам(Ложь);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьЭлементов()
	
	Если НЕ ТолькоПросмотрСообщения Тогда 
		
		ПартнерЗаполнен 	 = ЗначениеЗаполнено(Партнер);
		КонтрагентЗаполнен 	 = ЗначениеЗаполнено(Контрагент);
		ОрганизацияЗаполнена = ЗначениеЗаполнено(Организация);
		ПродавецЗаполнен 	 = ЗначениеЗаполнено(Продавец);
		ТочкаДоставкиЗаполнена = ЗначениеЗаполнено(ТочкаДоставки);
		
		Элементы.Контрагент.Доступность 			= ПартнерЗаполнен;
		Элементы.Продавец.Доступность 				= ПартнерЗаполнен И ОрганизацияЗаполнена И КонтрагентЗаполнен;
		Элементы.ТочкаДоставки.Доступность 			= ПартнерЗаполнен И ОрганизацияЗаполнена И КонтрагентЗаполнен И ПродавецЗаполнен И НЕ НесколькоТочекДоставки;
		Элементы.СкладОстатков.Доступность 			= ПартнерЗаполнен И ОрганизацияЗаполнена И КонтрагентЗаполнен И ПродавецЗаполнен И ТочкаДоставкиЗаполнена И НЕ НесколькоТочекДоставки;
		Элементы.НесколькоТочекДоставки.Доступность = ПартнерЗаполнен И ОрганизацияЗаполнена И КонтрагентЗаполнен И ПродавецЗаполнен;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПолеТочкаДоставки()
	
	ТочкаДоставки = Неопределено;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПолеСкладОстатков()
	
	МассивСкладовОстатков = ПолучитьСкладыОстатковТочкиДоставкиСервер(ТочкаДоставки);
	
	Если МассивСкладовОстатков.Количество() = 1 Тогда 
		
		СкладОстатков = МассивСкладовОстатков[0];
		
	ИначеЕсли МассивСкладовОстатков.Количество() > 1 Тогда
		
		МассивТочекДоставок = Новый Массив; 
		МассивТочекДоставок.Добавить(ТочкаДоставки);
		
		ЗаполнитьДеревоСоответствий(МассивТочекДоставок);
		
		НесколькоТочекДоставки = Истина;
		ВидимостьЭлементовПриРазделенииПоСкладам(Истина);
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЕстьТочкиДоставкиИДоступностьКнопокПодбор()
	
	ЕстьТочкиДоставкиСвои = ЕстьЭлементыВСправочнике_НаСервере("ТочкиДоставкиСвои");
	
	Если ЗначениеЗаполнено(Партнер) Тогда 
		
		ЕстьТочкиДоставкиСторонние = ЕстьЭлементыВСправочнике_НаСервере("ТочкиДоставкиСторонние", Партнер);
		
		НастройкиПартнера = ПолучитьСписокСвойствEDI_НаСервере("ПартнерКакТорговаяСеть,ПартнерКакПоставщик", Партнер);
		
		ПартнерСеть 		= НастройкиПартнера.ПартнерКакТорговаяСеть = Истина;
		ПартнерПоставщик 	= НастройкиПартнера.ПартнерКакПоставщик = Истина;
		ПартнерДистрибьютор = ПартнерСеть И ПартнерПоставщик;
		
	Иначе 
		
		ЕстьТочкиДоставкиСторонние = Ложь; 
		ПартнерСеть 			   = Ложь;
		ПартнерПоставщик 		   = Ложь;
		ПартнерДистрибьютор		   = Ложь;
		
	КонецЕсли;
	
	Элементы.СоответствиеТочкаДоставкиСкладыОстатковПодборСвоиТочкиДоставки.Доступность = (ПартнерДистрибьютор ИЛИ ПартнерПоставщик) И ЕстьТочкиДоставкиСвои;
	Элементы.СоответствиеТочкаДоставкиСкладыОстатковПодборСторонниеТочкиДоставки.Доступность = (ПартнерДистрибьютор ИЛИ ПартнерСеть) И ЕстьТочкиДоставкиСторонние;
	
КонецПроцедуры

