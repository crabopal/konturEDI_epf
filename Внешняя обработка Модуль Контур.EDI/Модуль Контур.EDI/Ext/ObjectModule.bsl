Функция Отчетность_НеотраженнаяСтатистика_ПолучитьСообщения() Экспорт
	
	Если НЕ ЕстьНеобходимыеМетаданные("РегистрыСведений.КонтурEDI_Статистика") Тогда 
		Возврат Новый Массив;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст  = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_Сообщения.Ссылка КАК Сообщение
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения.ДополнительныеРеквизиты КАК КонтурEDI_СообщенияДополнительныеРеквизиты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|		ПО КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка = КонтурEDI_Сообщения.Ссылка
	|		И КонтурEDI_СообщенияДополнительныеРеквизиты.ИмяРеквизита = ""НеОтраженаСтатистика""
	|		И КонтурEDI_СообщенияДополнительныеРеквизиты.Значение = ИСТИНА
	|		И (КонтурEDI_Сообщения.ТипСообщения В (&ТипСообщения))";
	
	Запрос.УстановитьПараметр("ТипСообщения", МассивТиповСообщенийEDIДляОтраженияСтатистики());
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Сообщение");
	
КонецФункции

Функция Отчетность_НеотраженнаяСтатистика_ПолучитьКоличествоСообщений() Экспорт 
	
	Если НЕ ЕстьНеобходимыеМетаданные("РегистрыСведений.КонтурEDI_Статистика") Тогда 
		Возврат 0;
	КонецЕсли;
	
	МассивСообщений = Отчетность_НеотраженнаяСтатистика_ПолучитьСообщения();
	Возврат МассивСообщений.Количество();
		
КонецФункции

Процедура Отчетность_НеотраженнаяСтатистика_Рассчитать() Экспорт
	
	МассивНеотраженныхСообщений = Отчетность_НеотраженнаяСтатистика_ПолучитьСообщения();
	МассивИзмененныхСообщений = Отчетность_ИзмененнаяСтатистика_ПолучитьСообщения();
	
	ВсегоЗаписей = МассивНеотраженныхСообщений.Количество() + МассивИзмененныхСообщений.Количество();

	Если ВсегоЗаписей = 0 Тогда
		Возврат;
	КонецЕсли;
	
	сч = 0;
	
	ДлительнаяОперация_Начать();

	ПараметрыОтраженияСтатистики = Отчетность_ПараметрыОтраженияСтатистики();
	Отчетность_ЗаполнитьПараметрыОтраженияСтатистики(ПараметрыОтраженияСтатистики);
	
	ИДВиртуальныхORDERS = Отчетность_ПолучитьИдентификаторыВиртуальныхORDERS(МассивНеотраженныхСообщений);
	ИдентификаторыОбработанныхСообщений = Новый Массив;
	
    Для Каждого Сообщение ИЗ МассивНеотраженныхСообщений Цикл
	
		#Если Клиент Тогда
		Сч = Сч + 1;
		Состояние("Выполняется расчет статистики: " + Сч + " из " + ВсегоЗаписей);
		#КонецЕсли
		
		Если Не ИдентификаторыОбработанныхСообщений.Найти(Сообщение.ID) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ИдентификаторыОбработанныхСообщений.Добавить(Сообщение.ID);
        
		СообщениеОбъект = Сообщение.ПолучитьОбъект();
		ПараметрыОтраженияСтатистики.ЕстьВиртуальныеORDERS = Не ИДВиртуальныхORDERS.Найти(СообщениеОбъект.ID) = Неопределено;
		
		Отчетность_ОтразитьСтатистикуСообщения(СообщениеОбъект, ПараметрыОтраженияСтатистики);
		
	КонецЦикла;
	
	ИДВиртуальныхORDERS = Отчетность_ПолучитьИдентификаторыВиртуальныхORDERS(МассивИзмененныхСообщений);
	ИдентификаторыОбработанныхСообщений = Новый Массив;

	Для каждого Сообщение Из МассивИзмененныхСообщений Цикл
		
		#Если Клиент Тогда
		сч = сч+1;
		Состояние("Выполняется расчет статистики: "+сч+" из "+ВсегоЗаписей);
		#КонецЕсли
		
		Если Не ИдентификаторыОбработанныхСообщений.Найти(Сообщение.ID) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ИдентификаторыОбработанныхСообщений.Добавить(Сообщение.ID);
		
		СообщениеОбъект = Сообщение.ПолучитьОбъект();
		ПараметрыОтраженияСтатистики.ЕстьВиртуальныеORDERS = Не ИДВиртуальныхORDERS.Найти(СообщениеОбъект.ID) = Неопределено;

		Отчетность_ОтразитьСтатистикуСообщения(СообщениеОбъект, ПараметрыОтраженияСтатистики);
		
	КонецЦикла;
	
	ДлительнаяОперация_Завершить();
	
КонецПроцедуры

