Функция Аутентификатор_ХранилищеПоУмолчанию() Экспорт

	Результат = ЭтотОбъект;
	
	Возврат Результат;
		
КонецФункции

Функция Аутентификатор_ХранилищеЭтоОбработка(Значение)
	
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КоличествоЭлементов = 2;
	МассивЗначений = КонтурСтандарт_СтрРазделить_(Значение, ".");
	Если МассивЗначений.Количество() <> КоличествоЭлементов Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат МассивЗначений[0] = "DataProcessorObject" 
		Или МассивЗначений[0] = "ExternalDataProcessorObject"
		Или МассивЗначений[0] = "DataProcessorManager";
		
КонецФункции

Функция Аутентификатор_ХранилищеЭтоСправочник(Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Метаданные.Справочники.Найти(Значение) <> Неопределено;
	
КонецФункции

Функция Аутентификатор_ХранилищеЭтоРегистрСведений(Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Метаданные.РегистрыСведений.Найти(Значение) <> Неопределено;
	
КонецФункции

Функция Аутентификатор_ХранилищеЭтоОбщийМодуль(Значение)
	
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если КонтурСтандарт_СтрНайти_(Значение, ".") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Метаданные.ОбщиеМодули.Найти(Значение) <> Неопределено;
		
КонецФункции

