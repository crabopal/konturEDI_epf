	КолонкиВнешнейТаблицы.Колонки.Добавить("ДоступныеЗначения");
	КолонкиВнешнейТаблицы.Колонки.Добавить("ШиринаКолонки");
	
	Возврат КолонкиВнешнейТаблицы;
	
КонецФункции

Процедура ДобавитьОписаниеКолонкиВнешнейТаблицы(ВнешняяТаблица, Идентификатор, Заголовок, ПроверкаНеЗаполненныхЗначений = Ложь, ДоступныеЗначения = Неопределено,  ШиринаКолонки = 50) Экспорт
	
	ОписаниеКолонки = ВнешняяТаблица.Добавить();
	ОписаниеКолонки.Идентификатор = Идентификатор;
	ОписаниеКолонки.Заголовок = Заголовок;
	ОписаниеКолонки.ПроверкаНеЗаполненныхЗначений = ПроверкаНеЗаполненныхЗначений;
	ОписаниеКолонки.ДоступныеЗначения = ДоступныеЗначения;
	ОписаниеКолонки.ШиринаКолонки = ШиринаКолонки;
	
КонецПроцедуры

Функция СформироватьОписаниеВнешнейТаблицы(КолонкиВнешнейТаблицы) Экспорт
	
	ТекстОписания = "Необходимо скопировать данные в таблицу из внешнего файла (Excel, Word и пр.) через буфер обмена.
					|Порядок колонок: ";
	
	Для каждого КолонкаВнешнейТаблицы из КолонкиВнешнейТаблицы Цикл
		
		ТекстОписания = ТекстОписания + " """ + КолонкаВнешнейТаблицы.Заголовок + """";
		ТекстУточнений = "";
		
		Если ЗначениеЗаполнено(КолонкаВнешнейТаблицы.ДоступныеЗначения) Тогда
			
			ТекстДоступныхЗначений = "принимает значения: ";
			Для каждого ДоступноеЗначение Из КолонкаВнешнейТаблицы.ДоступныеЗначения Цикл
				ТекстДоступныхЗначений = ТекстДоступныхЗначений + ДоступноеЗначение + ", ";
			КонецЦикла;
			
			ТекстУточнений = ТекстУточнений + ", " + Лев(ТекстДоступныхЗначений, СтрДлина(ТекстДоступныхЗначений) - 2);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекстУточнений) Тогда
			ТекстУточнений = " (" + Сред(ТекстУточнений, 3) + ")";
		КонецЕсли;
		
		ТекстОписания = ТекстОписания + ТекстУточнений + ",";
		
	КонецЦикла;
	
	ТекстОписания = Лев(ТекстОписания, СтрДлина(ТекстОписания) - 1);
	
	Возврат ТекстОписания;
	
КонецФункции

Процедура ЗаполнитьШапкуТаблицыВнешнихДанных(ТабличныйДокумент, КолонкиВнешнейТаблицы) Экспорт
	
	ТабличныйДокумент.Очистить();
	
	Для СчетчикКолонок = 0 По КолонкиВнешнейТаблицы.Количество() - 1 Цикл
		
		НастройкаКолонки = КолонкиВнешнейТаблицы[СчетчикКолонок];
		КоординатаКолонки = "C" + Формат(СчетчикКолонок + 1,"ЧГ=");
		
		ОбластьЗаголовка = ТабличныйДокумент.Область("R1" + КоординатаКолонки);
		ОбластьЗаголовка.Текст = НастройкаКолонки.Заголовок;
		Если НастройкаКолонки.ПроверкаНеЗаполненныхЗначений = Истина Тогда
			ОбластьЗаголовка.Текст = ОбластьЗаголовка.Текст + " (обязательно)";
		КонецЕсли;
		ОбластьЗаголовка.ЦветФона = Новый Цвет(239,239,239);
		
		ОбластьКолонки = ТабличныйДокумент.Область(КоординатаКолонки);
		ОбластьКолонки.ШиринаКолонки = НастройкаКолонки.ШиринаКолонки;
		
		Если НастройкаКолонки.ПроверкаНеЗаполненныхЗначений Тогда
			ЕстьОбязательныеПоля = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

