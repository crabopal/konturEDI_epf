	НайденнаяСтрока = ТаблицаКодовРегионов().Найти(КодРегионаСтрокой,"КодСтрока");
	Если НЕ НайденнаяСтрока = Неопределено Тогда
		Возврат НайденнаяСтрока.КодЧисло;
	Иначе
		Возврат "";
