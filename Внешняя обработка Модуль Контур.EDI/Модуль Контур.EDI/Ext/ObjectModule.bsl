Функция ВыполнитьPrepareDocumentsToSign(PrepareDocumentsToSignRequest, ДанныеАвторизации)
	
	ДанныеАвторизацииДиадок = ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизации);
	Результат = КонтурДиадокAPI_ПодготовитьДокументыКПодписанию(ДанныеАвторизацииДиадок, PrepareDocumentsToSignRequest);
	
	Возврат Результат;
			
КонецФункции

Функция НайтиPatchedEntity(PatchedEntities, EntityId)

	Entity = Неопределено;
	
	Для каждого PatchedEntity Из PatchedEntities Цикл
		Если PatchedEntity.DocumentId.EntityId = EntityId Тогда
			Entity = PatchedEntity;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
    Возврат Entity;
	
КонецФункции

Функция ПодписатьPatchedEntity(PatchedEntity, МассивСтруктур, ДанныеАвторизации)
	
	Результат = ИнициализироватьСтруктуруРезультатаФункции();
	
	ПутьКФайлу = мРабочийКаталог + PatchedEntity.DocumentId.EntityId;
	ВременныйФайл = Новый Файл(ПутьКФайлу);
	Если ВременныйФайл.Существует() Тогда
		УдалитьФайлы(ВременныйФайл.ПолноеИмя); //Если такой файл уже есть в temp, значит, он остался от предыдущей сессии, когда чо-то пошло не так. Удалим его.
	КонецЕсли;
	ФайлДляПодписи = Base64Значение(PatchedEntity.Content);
	ФайлДляПодписи.Записать(ПутьКФайлу);
	АдресФайлаДляПодписи = ПоместитьВоВременноеХранилище(ФайлДляПодписи, Новый УникальныйИдентификатор);

	Для Сч = 1 По 2 Цикл
	
		РезультатПодписания = ПолучитьПодписьФайлаДокумента_КонтурEDI(АдресФайлаДляПодписи, ДанныеАвторизации);
		
		Если ОбработкаИсключенияТипМодуляКриптографии(РезультатПодписания.ОписаниеОшибки, ДанныеАвторизации) Тогда
			Продолжить; // еще раз, уже с нужным типом модуля криптографии
		Иначе
			Прервать;
		КонецЕсли;	
		
	КонецЦикла;		
	
	Если Не РезультатПодписания.Успешно Тогда
		Результат.ОписаниеОшибки = РезультатПодписания.ОписаниеОшибки;
		Возврат Результат;
	Иначе
		Результат.Успешно = Истина;
	КонецЕсли;
	
	Signature = РезультатПодписания.ШифрованнаяПодпись;

	DocumentSignature = Новый Структура;
	DocumentSignature.Вставить("ParentEntityId", 	PatchedEntity.DocumentId.EntityId);
	DocumentSignature.Вставить("Signature",			Signature);
	DocumentSignature.Вставить("PatchedContentId",	PatchedEntity.PatchedContentId);
	
	ДобавитьИнформациюОбМЧД(DocumentSignature, ДанныеАвторизации);
    
	МассивСтруктур.Добавить(DocumentSignature);

	Возврат Результат;
	
КонецФункции

Функция ПолучитьEntitiesДляПодписания(MessageЧерновик)
	
	EntitiesДляПодписания = Новый Массив;
	
	Для каждого EntityЧерновика Из MessageЧерновик.Entities Цикл
		Если EntityЧерновика.Свойство("DocumentInfo") Тогда 
			EntitiesДляПодписания.Добавить(EntityЧерновика);
        КонецЕсли;
	КонецЦикла;
	
	Возврат EntitiesДляПодписания;
	
КонецФункции

Функция ПолучитьPatchedEntities(Message, BoxId, MessageId, ДанныеАвторизации, IsDraft)
	
	PrepareDocumentsToSignRequest = КонтурДиадокAPI_СоздатьПоСхеме("PrepareDocumentsToSignRequest");
	PrepareDocumentsToSignRequest.BoxId = BoxId;
	
	КэшКонтентаПодписантов = Новый Структура;
	
	Для каждого Entity Из Message.Entities Цикл
		
		Если Entity.DocumentInfo.DocumentType = "UnknownDocumentType" Тогда
			Продолжить;
		КонецЕсли;
		
		EntityId = Entity.EntityId;
		SignerContent = ПолучитьКонтентПодписанта(Entity, КэшКонтентаПодписантов, ДанныеАвторизации, BoxId);
		
		Если IsDraft Тогда
			
			DraftDocumentToPatch = КонтурДиадокAPI_СоздатьПоСхеме("DraftDocumentToPatch");
			
			DraftDocumentToPatch.DocumentId.MessageId = MessageId; 
			DraftDocumentToPatch.DocumentId.EntityId  = EntityId; 
			DraftDocumentToPatch.SignerContent = SignerContent;
			
			PrepareDocumentsToSignRequest.DraftDocuments.Добавить(DraftDocumentToPatch);
			
		Иначе     
			
			DocumentToPatch = КонтурДиадокAPI_СоздатьПоСхеме("DocumentToPatch");
			
			DocumentToPatch.DocumentId.MessageId = MessageId; 
			DocumentToPatch.DocumentId.EntityId  = EntityId;
			DocumentToPatch.SignerContent = SignerContent;
			
			PrepareDocumentsToSignRequest.Documents.Добавить(DocumentToPatch);
			
		КонецЕсли;
		
	КонецЦикла; 
	
	PrepareDocumentsToSignResponse = ВыполнитьPrepareDocumentsToSign(PrepareDocumentsToSignRequest, ДанныеАвторизации);	
	
	Возврат PrepareDocumentsToSignResponse; 	

КонецФункции                       

Функция ПолучитьКонтентПодписанта(Entity, КэшКонтентаПодписантов, ДанныеАвторизации, BoxId) 
	
	КонтентПодписанта = Неопределено;
	
	ФорматПодписанта = "Формат820";

	Если Entity.Свойство("ContentTypeId") И КонтурСтандарт_СтрНайти_(Entity.ContentTypeId, "970") > 0 Тогда
		ФорматПодписанта = "Формат970";
	КонецЕсли;
	
	Если КэшКонтентаПодписантов.Свойство(ФорматПодписанта, КонтентПодписанта) Тогда
		Возврат КонтентПодписанта;
	КонецЕсли;
	
	Если ФорматПодписанта = "Формат970" Тогда
		КонтентПодписанта = SignerContent970(ДанныеАвторизации, BoxId);
	Иначе
		КонтентПодписанта = SignerContent(ДанныеАвторизации, BoxId);
	КонецЕсли;
	
	КэшКонтентаПодписантов.Вставить(ФорматПодписанта, КонтентПодписанта);
	
	Возврат КонтентПодписанта;
	
КонецФункции

Процедура ДобавитьИнформациюОбМЧД(СтруктураПриемник, ДанныеАвторизации, ТолькоИдентификаторы = Ложь) 
	
	PowerOfAttorneyToPost = PowerOfAttorneyToPost(ДанныеАвторизации);
	
	СтруктураПриемник.Вставить("PowerOfAttorney", PowerOfAttorneyToPost);
	
КонецПроцедуры

Функция PowerOfAttorneyToPost(ДанныеАвторизации)
	
	МашиночитаемаяДоверенностьДляОтправки = МашиночитаемаяДоверенностьДляОтправки(ДанныеАвторизации);

	PowerOfAttorneyToPost = КонтурДиадокAPI_Привести("PowerOfAttorneyToPost", МашиночитаемаяДоверенностьДляОтправки);
	
	Возврат PowerOfAttorneyToPost;
	
КонецФункции

Функция СвойствоСтруктуры(СложнаяСтруктура, ИерархияСвойств, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Результат = ЗначениеПоУмолчанию;
	
	Если Не ЗначениеЗаполнено(ИерархияСвойств) Или СложнаяСтруктура = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПростыеКлючи = EDI_РазложитьСтрокуВМассивСлов(ИерархияСвойств, ".", Ложь);
	
	ЗначениеПолучено = Ложь;
	ТекущееЗначение   = Неопределено;
	ТекущаяСтруктура = СложнаяСтруктура;
	
	ВГраница = ПростыеКлючи.ВГраница();
	
	Для Сч = 0 По ВГраница Цикл
		
		ТекущийКлюч = ПростыеКлючи[Сч];
		
		Если ТекущаяСтруктура.Свойство(ТекущийКлюч, ТекущееЗначение) Тогда
			
			Если Сч = ВГраница Тогда
				
				ЗначениеПолучено = Истина;
				
			ИначеЕсли ТипЗнч(ТекущееЗначение) = Тип("Структура") Тогда
				
				ТекущаяСтруктура = ТекущееЗначение;
				
			Иначе
				Прервать;
			КонецЕсли;
			
		Иначе
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеПолучено Тогда
		Результат = ТекущееЗначение;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//-------------------------------------------------------------------------------------------------
