Функция СоответствиеПеречисленийEDI1C_ТипПродукции_КлючВидовПродукции()
	
	СоответствиеПеречислений_КлючВидовПродукции = Новый Соответствие;
	СоответствиеПеречислений_ВидПродукции = СоответствиеПеречисленийEDI1С_ТипПродукции_СпрВидПродукцииИС();
	
	КлючиВидовПродукции = Справочники.КлючиВидовПродукцииИС.Выбрать();
	
	Пока КлючиВидовПродукции.Следующий() Цикл
		
		ВидПродукцииГИСМТ = КлючиВидовПродукции.ВидПродукцииГИСМТ;
		
		Если ЗначениеЗаполнено(ВидПродукцииГИСМТ) И СоответствиеПеречислений_ВидПродукции[ВидПродукцииГИСМТ] <> Неопределено Тогда
			ТипПродукцииEDI = СоответствиеПеречислений_ВидПродукции[ВидПродукцииГИСМТ];
			СоответствиеПеречислений_КлючВидовПродукции.Вставить(КлючиВидовПродукции.Ссылка, ТипПродукцииEDI);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СоответствиеПеречислений_КлючВидовПродукции;
	
КонецФункции

Функция УсловияОпределенияТипаПродукции_ВидПродукцииИС()
	
	УсловияОпределения = ЭДО_Кэш_Прочитать("УсловияОпределнияТипаПродукции_ВидПродукцииИС");
	
	Если УсловияОпределения <> Неопределено Тогда
		Возврат УсловияОпределения;
	КонецЕсли;
	
	УсловияОпределения = Новый Массив;
	
	ПолеОтбора = Новый ПолеКомпоновкиДанных("Номенклатура.ВидПродукцииИС");
	
	Для каждого ЭлементСопоставления Из СоответствиеПеречисленийEDI1С_ТипПродукции_ВидПродукцииИС() Цикл

		ЗначениеПеречисленияEDI = ЭлементСопоставления.Значение;
