// #Область СтроковыеФункции


// Преобразует исходную строку в число без вызова исключений.
//
// Параметры:
//   Значение - Строка - строка, которую необходимо привести к числу.
//                       Например, "10", "+10", "010", вернет 10;
//                                 "-10",вернет -10;
//                                 "10,2", "10.2",вернет 10.2;
//                                 "000", "0", вернет 0;
//                                 "10текст" "(10), 10-", вернет то, что указано в ЗначениеВСлучаеОшибкиПреобразования.
//	
//   ЗначениеВСлучаеОшибкиПреобразования - любой - значение, которое будет возвращено, если строку не получилось преобразовать к числу.
//												  Значение по умолчанию - Неопределено.	
//   
//   ПустаяСтрокаКакНоль - Булево - если передано значение Истина и в параметр Значение передана пустая строка, то функция вернет 0. 
//									Если передано значение Ложь, то функция вернет то, что указано в ЗначениеВСлучаеОшибкиПреобразования.
//									Значение по умолчанию - Ложь.
// Возвращаемое значение:
//   Число, Неопределено - полученное число, либо Неопределено, если строка не является числом.
//
Функция СтрокаВЧисло_КонтурEDI(Знач Значение, ЗначениеВСлучаеОшибкиПреобразования = Неопределено, ПустаяСтрокаКакНоль = Ложь) Экспорт
	
	Значение  = СтрЗаменить(Значение, " ", "");
	
	Результат = ЗначениеВСлучаеОшибкиПреобразования;
	
	Если ПустаяСтрока(Значение) Тогда
		
		Если ПустаяСтрокаКакНоль Тогда
			Результат = 0;
		КонецЕсли;	
				
	Иначе
		
		СтрокаБезНулей = СтрЗаменить(Значение, "0", "");
		Если ПустаяСтрока(СтрокаБезНулей) Или СтрокаБезНулей = "-" Тогда
			Результат = 0
		Иначе
			
			ТипЧисло  = Новый ОписаниеТипов("Число");
			Результат = ТипЧисло.ПривестиЗначение(Значение);
			
			Если Результат = 0 Тогда
				Результат = ЗначениеВСлучаеОшибкиПреобразования;
			КонецЕсли; 			
			
		КонецЕсли;
				
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти //СтроковыеФункции        


