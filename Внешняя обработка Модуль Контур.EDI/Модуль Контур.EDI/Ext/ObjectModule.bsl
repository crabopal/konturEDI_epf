// Метод для получения информации об организации в системе Диадок.
// Поиск организации может выполняться по одному из критериев: идентификатор организации,
// идентификатор ящика, идентификатор участника ЭДО или ИНН (с возможным уточнением по КПП).
// В случае HTTP ответа отличного от "200", выбрасывает исключение.
//
// Параметры:
//   ДанныеАвторизацииДиадок  - Структура - см. метод КонтурДиадокAPI_НовыйДанныеАвторизации.
//   ИдентификаторОрганизации - Строка - Идентификатор организации в Диадок (необязательный).
//   ИдентификаторЯщика       - Строка - Идентификатор ящика организации в Диадок (необязательный).
//   ИдентификаторУчастникаЭДО - Строка - Идентификатор участника электронного документооборота (необязательный).
//   ИННОрганизации           - Строка - ИНН организации (необязательный).
//   КППОрганизации           - Строка - КПП организации, используется для уточнения при поиске по ИНН (необязательный).
//   ОтветВЛокальныхИменах    - Булево - Признак приведения имен свойств ответа к локальному формату (по умолчанию Ложь).
//
// Возвращаемое значение:
//   Структура - См. свойства в методе КонтурДиадокAPI_Схема_Organization.
//
Функция КонтурДиадокAPI_Организации(Знач ДанныеАвторизацииДиадок, ИдентификаторОрганизации = "", ИдентификаторЯщика = "", ИдентификаторУчастникаЭДО = "", ИННОрганизации = "", КППОрганизации = "", ОтветВЛокальныхИменах = Ложь) Экспорт
	
	КонтурДиадокAPI_УстановитьТокенДляЗапроса(ДанныеАвторизацииДиадок);
	
	МенеджерНастроек = КонтурДиадокAPI_МенеджерНастроек();

	ПараметрыСервиса = КонтурДиадокAPI_GetOrganization();
	
	Если ЗначениеЗаполнено(ИдентификаторОрганизации) Тогда
		
		ПараметрыСервиса.Параметры.orgId = ИдентификаторОрганизации; 	
		
	ИначеЕсли ЗначениеЗаполнено(ИдентификаторЯщика) Тогда
		
		ПараметрыСервиса.Параметры.boxId = ИдентификаторЯщика;
		
	ИначеЕсли ЗначениеЗаполнено(ИдентификаторУчастникаЭДО) Тогда
		
		ПараметрыСервиса.Параметры.fnsParticipantId = ИдентификаторУчастникаЭДО;
		
	ИначеЕсли ЗначениеЗаполнено(ИННОрганизации) Тогда
		
		ПараметрыСервиса.Параметры.inn = ИННОрганизации;	
		
		Если ЗначениеЗаполнено(КППОрганизации) Тогда
			
			ПараметрыСервиса.Параметры.kpp = КППОрганизации;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// BSLLS:DeletingCollectionItem-off
	Для Каждого КлючЗначение Из ПараметрыСервиса.Параметры Цикл
		
		Если НЕ ЗначениеЗаполнено(КлючЗначение.Значение) Тогда
			
			ПараметрыСервиса.Параметры.Удалить(КлючЗначение.Ключ);	
			
		КонецЕсли;
		
	КонецЦикла;
	// BSLLS:DeletingCollectionItem-on
	
	ДополнительныеПараметры = Новый Структура("Заголовки", ПараметрыСервиса.Заголовки);
	
	Ответ = КонтурДиадокAPI_Get(ДанныеАвторизацииДиадок, ПараметрыСервиса.URL, ПараметрыСервиса.Параметры, ДополнительныеПараметры, МенеджерНастроек.Сессия); 	
	
	ПодготовленныйОтветКлиента = КонтурДиадокAPI_ОбработатьРезультатHTTPЗапроса(ПараметрыСервиса, Ответ);
	
	Возврат КонтурДиадокAPI_Привести("Organization", ПодготовленныйОтветКлиента.Результат, ОтветВЛокальныхИменах);
	
КонецФункции

// Метод для получения содержимого конкретной сущности (документа) из сообщения в ящике Диадок.
// Возвращает двоичные данные документа в исходном формате (XML).
// В случае HTTP ответа отличного от "200", выбрасывает исключение.
//
// Параметры:
//   ДанныеАвторизацииДиадок - Структура - см. метод КонтурДиадокAPI_НовыйДанныеАвторизации.
//   ИдентификаторЯщика      - Строка - Идентификатор ящика организации в Диадок.
//   ИдентификаторСообщения  - Строка - Идентификатор сообщения, содержащего сущность.
//   ИдентификаторСущности   - Строка - Идентификатор запрашиваемой сущности (документа).
