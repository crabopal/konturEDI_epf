// Функция создает новую схему компоновки данных.
//
// Возвращаемое значение:
//   СхемаКомпоновкиДанных - новый экземпляр схемы компоновки данных
Функция КонтурСКД_НовыйСхемаКомпоновки() Экспорт
	
	Возврат Новый СхемаКомпоновкиДанных;
	
КонецФункции

// Функция создает новый источник данных для схемы компоновки данных.
//
// Параметры:
//   СхемаКомпоновки - СхемаКомпоновкиДанных - Схема компоновки данных, к которой добавляется источник данных
//   ИмяИсточникаДанных - Строка - Имя нового источника данных
//   ТипИсточникаДанных - Строка - Тип источника данных
//   СтрокаСоединения - Строка - Строка соединения с источником данных
//
// Возвращаемое значение:
//   ИсточникДанных -  ИсточникДанныхСхемыКомпоновкиДанных - Созданный источник данных
Функция КонтурСКД_НовыйИсточникДанных(СхемаКомпоновки, 
									  ИмяИсточникаДанных = "ИсточникПоУмолчанию", 
									  ТипИсточникаДанных = "Local",
									  СтрокаСоединения = "") Экспорт
	
	ИсточникДанных = СхемаКомпоновки.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя = ИмяИсточникаДанных;
	ИсточникДанных.ТипИсточникаДанных = ТипИсточникаДанных;
	ИсточникДанных.СтрокаСоединения = СтрокаСоединения;
	
	Возврат ИсточникДанных;
	
КонецФункции

// Функция создает новый набор данных запроса для схемы компоновки данных.
//
// Параметры:
//   СхемаКомпоновки - СхемаКомпоновкиДанных - Схема компоновки данных, к которой добавляется набор данных
//   ТекстЗапроса - Строка - Текст запроса
//   ИмяНабораДанных - Строка - Имя нового набора данных
//   ИмяИсточникаДанных - Строка - Имя источника данных
//   АвтоЗаполнениеДоступныхПолей - Булево - Флаг автозаполнения доступных полей
//
// Возвращаемое значение:
//   НаборДанных - НаборДанныхЗапросСхемыКомпоновкиДанных - Созданный набор данных запроса
Функция КонтурСКД_НовыйНаборДанныхЗапрос(СхемаКомпоновки,
										 ТекстЗапроса,
										 ИмяНабораДанных = "НаборПоУмолчанию",
										 ИмяИсточникаДанных = "ИсточникПоУмолчанию",
										 АвтоЗаполнениеДоступныхПолей = Истина) Экспорт
										 
	НаборДанных = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанных.Имя = ИмяНабораДанных;
	НаборДанных.Запрос = ТекстЗапроса;
	НаборДанных.ИсточникДанных = ИмяИсточникаДанных;
	НаборДанных.АвтоЗаполнениеДоступныхПолей = АвтоЗаполнениеДоступныхПолей;
	
	Возврат НаборДанных;	
	
КонецФункции

// Функция создает новое поле набора данных для схемы компоновки данных.
//
// Параметры:
//   НаборДанных - НаборДанныхЗапросСхемыКомпоновкиДанных - Набор данных, к которому добавляется поле
//   ПутьКДанным - Строка - Путь к данным в источнике данных
//   Заголовок - Строка - Заголовок поля
//
// Возвращаемое значение:
//   ПолеНабора - ПолеНабораДанныхСхемыКомпоновкиДанных - Созданное поле набора данных
Функция КонтурСКД_НовыйПолеНабораДанных(НаборДанных, 
										ПутьКДанным, 
										Заголовок = Неопределено) Экспорт
										
	ПолеНабора = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
	ПолеНабора.ПутьКДанным = ПутьКДанным;
	ПолеНабора.Поле = ПутьКДанным;
	
	Если Заголовок <> Неопределено Тогда
		ПолеНабора.Заголовок = Заголовок;
	КонецЕсли;
	
	Возврат ПолеНабора;
	
КонецФункции

// Функция возвращает или создает настройки компоновки по умолчанию для схемы компоновки данных.
//
// Параметры:
//   СхемаКомпоновки - СхемаКомпоновкиДанных - Схема компоновки данных, для которой устанавливаются настройки
//
// Возвращаемое значение:
//   НастройкиКомпоновкиДанных - Настройки компоновки данных по умолчанию
Функция КонтурСКД_НастройкиКомопновкиПоУмолчанию(СхемаКомпоновки) Экспорт
	
	Если СхемаКомпоновки.НастройкиПоУмолчанию = Неопределено Тогда
		СхемаКомпоновки.НастройкиПоУмолчанию = Новый НастройкиКомпоновкиДанных;
	КонецЕсли;	
	
	Возврат СхемаКомпоновки.НастройкиПоУмолчанию;	
	
КонецФункции

// Функция создает новую группировку компоновки данных.
//
// Параметры:
//   ГруппировкаРодитель - ГруппировкаКомпоновкиДанных, НастройкиКомпоновкиДанных  - Родительская группа, в которую добавляется новая группа
//   ДобавитьАвтоВыбранноеПоле - Булево - Флаг необходимости добавить автоматически выбранное поле
//
// Возвращаемое значение:
//   ГруппировкаКомпоновкиДанных - Созданная группа компоновки данных
Функция КонтурСКД_НовыйГруппировкаКомпоновкиДанных(ГруппировкаРодитель, ДобавитьАвтоВыбранноеПоле = Ложь) Экспорт
	
	НастройкаГруппировки = ГруппировкаРодитель.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	
	Если ДобавитьАвтоВыбранноеПоле Тогда
		КонтурСКД_НовыйАвтоВыбранноеПолеКомпоновки(НастройкаГруппировки);	
	КонецЕсли;
	
	Возврат НастройкаГруппировки;
	
КонецФункции

// Функция создает новое автоматически выбранное поле компоновки данных.
//
// Параметры:
//   ГруппировкаКомпоновки - ГруппировкаКомпоновкиДанных - Группа компоновки данных, в которую добавляется поле
//
// Возвращаемое значение:
//   АвтоВыбранноеПолеКомпоновкиДанных - Созданное автоматически выбранное поле компоновки данных
Функция КонтурСКД_НовыйАвтоВыбранноеПолеКомпоновки(ГруппировкаКомпоновки) Экспорт
	
	ВыбранноеПоле = ГруппировкаКомпоновки.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	Возврат ВыбранноеПоле;
	
КонецФункции

// Функция создает новое выбранное поле компоновки данных.
//
// Параметры:
//   ГруппировкаКомпоновки - ГруппировкаКомпоновкиДанных - Группа компоновки данных, в которую добавляется поле
//   ПутьКДаннымПоля - Строка - Путь к данным в источнике данных
//   Заголовок - Строка - Заголовок поля
//
// Возвращаемое значение:
//   ВыбранноеПолеКомпоновкиДанных - Созданное выбранное поле компоновки данных
Функция КонтурСКД_НовыйВыбранноеПолеКомпоновки(ГруппировкаКомпоновки, ПутьКДаннымПоля, Заголовок = Неопределено) Экспорт
	
	ВыбранноеПоле = ГруппировкаКомпоновки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных(ПутьКДаннымПоля);
	
	Если Заголовок <> Неопределено Тогда
		ВыбранноеПоле.Заголовок = Заголовок;
	КонецЕсли;
	
	Возврат ВыбранноеПоле;
	
КонецФункции

// Функция создает новое пользовательское поле выбора компоновки данных.
//
// Параметры:
//   НастройкиКомпоновки - НастройкиКомпоновкиДанных - Настройки компоновки данных, в которые добавляется поле
//   Заголовок - Строка - Заголовок поля
//
// Возвращаемое значение:
//   ПользовательскоеПолеВыборКомпоновкиДанных - Созданное пользовательское поле выбора компоновки данных
Функция КонтурСКД_НовыйПользовательскоеПолеВыбор(НастройкиКомпоновки, Заголовок = Неопределено) Экспорт
	
	ПользовательскоеПоле = НастройкиКомпоновки.ПользовательскиеПоля.Элементы.Добавить(Тип("ПользовательскоеПолеВыборКомпоновкиДанных"));
	
