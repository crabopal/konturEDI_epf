Функция ПрочитатьСообщениеXDTO(ИсточникДанных,ТипСообщения,Направление)
	
	СообщениеEDI = ПолучитьСтруктуруСообщения(ТипСообщения,Направление);
	
	// получаем объект XDTO из XML
	ТекстXML=Новый ТекстовыйДокумент;
	ТекстXML.Прочитать(ИсточникДанных);
	
	ТекстXML = ТекстXML.ПолучитьТекст();
	
	ТекстXML=(СтрЗаменить(ТекстXML,
		"<eDIMessage ",
		"<eDIMessage xmlns="""+xmlПространствоИменСообщений()+""" xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" "
		));
		
	Чтение=Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ТекстXML);
	Чтение.ПерейтиКСодержимому();
	
	СтруктураТиповФабрики = ПолучитьСтруктуруТиповФабрики(ФабрикаXDTO_EdiXml());
	
	Попытка
		Данные = ФабрикаXDTO_EdiXml().ПрочитатьXML(Чтение,СтруктураТиповФабрики.eDIMessageType);  
	Исключение
		Чтение.Закрыть();    
		
		СообщениеEDI.Вставить("ОписаниеОшибки",ОписаниеОшибки());
		СообщениеEDI.Вставить("ИнформацияОбОшибке",ИнформацияОбОшибке());
		СообщениеEDI.Вставить("Статус","ВходящийОшибкаЧтенияФайла");
		
		Возврат СообщениеEDI;  
		
	КонецПопытки;  
	
	Чтение.Закрыть();
	
	// помещаем все теги в структуру сообщения
	
	ЗаполнитьСообщениеEDIизXDTO(Данные,СообщениеEDI,ТипСообщения,Направление);
	
	ОбработкаСобытияПодключаемогоМодуля("ПослеЧтенияСообщения_XDTO",,Новый Структура("Сообщение,Данные",СообщениеEDI,Данные));
	
	Возврат СообщениеEDI;
	
КонецФункции

//альтернативный вариант, не лучший, но позволяет перейти на XDTO очень быстро.
Функция ПрочитатьСообщениеXDTO_2(ИсточникДанных,ТипСообщения,Направление)
	
	ТекстXML=Новый ТекстовыйДокумент;
	ТекстXML.Прочитать(ИсточникДанных);
	ТекстXML = ТекстXML.ПолучитьТекст();			
	
	ТекстXML = СтрЗаменить(ТекстXML,
	"<eDIMessage xmlns=""http://edi.kontur.ru/1c/ediXml"" xmlns:xsd=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" ",
	"<eDIMessage ");
	
	ТекстXML = СтрЗаменить(ТекстXML,
	"<eDIMessage xmlns=""http://edi.kontur.ru/1c/ediXml"" xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" ",
	"<eDIMessage ");
	
	ТекстXML = СтрЗаменить(ТекстXML,
	"<eDIMessage ",
	"<eDIMessage xmlns="""+xmlПространствоИменСообщений()+""" xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" "
	);
		
	Чтение=Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ТекстXML);
	
	СообщениеEDI = ПолучитьСтруктуруСообщения(ТипСообщения,Направление);
	
	Если ДлительнаяОперация = Истина тогда
		_ТипEDIMessage = КэшДлительнойОперации.Получить("ТипEDIMessage");
		Если _ТипEDIMessage = Неопределено Тогда
			_ТипEDIMessage = ФабрикаXDTO_EdiXml().Тип(xmlПространствоИменСообщений(),"eDIMessageType");
	        КэшДлительнойОперации.Вставить("ТипEDIMessage",_ТипEDIMessage);
		КонецЕсли;
	Иначе
		_ТипEDIMessage = ФабрикаXDTO_EdiXml().Тип(xmlПространствоИменСообщений(),"eDIMessageType");
	КонецЕсли;
	
 	Чтение.ПерейтиКСодержимому();
	Попытка 
		Данные=ФабрикаXDTO_EdiXml().ПрочитатьXML(Чтение,_ТипEDIMessage); 
	Исключение
		Чтение.Закрыть();  
		
		СообщениеEDI.Вставить("ОписаниеОшибки",ОписаниеОшибки());
		СообщениеEDI.Вставить("ИнформацияОбОшибке",ИнформацияОбОшибке());
		СообщениеEDI.Вставить("Статус","ВходящийОшибкаЧтенияФайла"); 

		Возврат СообщениеEDI; 
		
	КонецПопытки;
	Чтение.Закрыть();
	
	// помещаем все теги в структуру сообщения
	
	СоответствиеПутей = Новый Соответствие;
	
	БуферXML = ПодготовитьБуферXML("Документ" ,ТипСообщения);
	Маппинг = ПолучитьМаппингПолейXML("Документ", ТипСообщения, СоответствиеПутей);//это маппинг полей XML и полей промежуточного буфера.

	Если ДлительнаяОперация = Истина Тогда // оставим возможность отключить новый парсер
		РазобратьXDTOРекурсивно_Новый(Данные,Маппинг,"Структура",БуферXML,"",ТипСообщения,СоответствиеПутей);
	Иначе	
		РаспарситьXDTOРекурсивно(Данные,Маппинг,"Структура",БуферXML,"",ТипСообщения);//здесь Сообщение - это промежуточный буфер, в который мы сгружаем дерево XML
	КонецЕсли;
	
	//проблема: в терминах XDTO преобразования дат выполняются сами собой. Чисел - тоже.
	//а даты еще и смещаются при наличии Z на конце
	Попытка 
		ЗаполнитьСообщениеEDI(БуферXML,СообщениеEDI,ТипСообщения,Направление);
	Исключение 
		
		СообщениеEDI.Вставить("ОписаниеОшибки",ОписаниеОшибки());
		СообщениеEDI.Вставить("ИнформацияОбОшибке",ИнформацияОбОшибке());
		СообщениеEDI.Вставить("Статус","ВходящийОшибкаЧтенияФайла"); 
		
		Возврат СообщениеEDI; 
		
	КонецПопытки;

	ОбработкаСобытияПодключаемогоМодуля("ПослеЧтенияСообщения_XDTO",,Новый Структура("Сообщение,Данные",СообщениеEDI,Данные));
		
	Возврат СообщениеEDI;
	
КонецФункции

Функция ПолучитьСтруктуруТиповФабрики(ФабрикаXDTO_EdiXml) Экспорт
	
	СтруктураТипов = Новый Структура;
	
	Для Каждого Пакет Из ФабрикаXDTO_EdiXml.Пакеты Цикл
		Если Найти(ВРЕГ(Пакет.URIПространстваИмен),".KONTUR.RU")>0 Тогда //берем только наши фабрики
			Для Сч=0 По Пакет.Количество()-1 Цикл
				Свойство = Пакет.Получить(Сч);
				СтруктураТипов.Вставить(Свойство.Имя,Свойство);
			КонецЦикла;	
			
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат СтруктураТипов;
	
КонецФункции	

Функция ПрочитатьСообщениеПоНовому(ИсточникДанных,ТипСообщения,Направление)
	
	Если ТипСообщения = "reports" Тогда
		
		Параметры = Новый Структура;
		Параметры.Вставить("ИсточникДанных", ИсточникДанных);
		// TODO на рефакторинг: единственное место, где мы обращаемся к ПолучитьСтруктуруСообщения_ и РазобратьXML
		// только для REPORTS
		РезультатКонвертации = КонвертироватьВходящееСообщение_REPORTS(Параметры, "reports");
		
		Возврат РезультатКонвертации.Шапка;
					
	КонецЕсли;
		
	Если ТипСообщения = "ALCRPT" Тогда
		
		СообщениеEDI = ПрочитатьСообщениеXDTO(ИсточникДанных, ТипСообщения, Направление);
		
	Иначе
		
		СообщениеEDI = ПрочитатьСообщениеXDTO_2(ИсточникДанных, ТипСообщения, Направление);
		
	КонецЕсли;
	
	ЧтениеИзФайла = ТипЗнч(ИсточникДанных) = Тип("Строка");
	
	Если ЧтениеИзФайла Тогда
		СообщениеEDI.ПутьКФайлу = ИсточникДанных;
	КонецЕсли;
	
	ОбработкаСобытияПодключаемогоМодуля("ПослеЧтенияСообщенияИзФайла", ,
		Новый Структура("Сообщение", СообщениеEDI));
			
	Возврат СообщениеEDI;
	
КонецФункции

// XDTO и XML

//Заполнение всего сообщения EdiMessage, точка входа
Процедура xmlЗаписатьEdiMessage(ЗаписьХМЛ,Сообщение)
		
	Тип = ФабрикаXDTO_EdiXml().Тип(xmlПространствоИменСообщений(), "eDIMessageType");
	EdiMessage = СоздатьПустойОбъектXDTO(ФабрикаXDTO_EdiXml(), Тип);  //Разобраться уже наконец с deliveryInfo!
	
	СтруктураПараметровПМ = Новый Структура("EdiMessage,Сообщение", EdiMessage, Сообщение);
	ОбработкаСобытияПодключаемогоМодуля("ПередЗаполнением_EdiMessage_XDTO", , СтруктураПараметровПМ);
	
	Если ЭтоТипНезависимогоСообщения(Сообщение.ТипСообщения) Тогда
		
		xmlЗаписатьНезависимоеEdiMessage_XDTO(EdiMessage, Сообщение);
		
	ИначеЕсли ЭтоТипЛогистическогоСообщения(Сообщение.ТипСообщения) Тогда
		
		xmlЗаписатьПеревозкуEdiMessage_XDTO(EdiMessage, Сообщение);
		
	Иначе
		
		xmlЗаписатьEdiMessage_XDTO(EdiMessage,Сообщение);
		
	КонецЕсли;
	
	СтруктураПараметровПМ = Новый Структура("EdiMessage,Сообщение", EdiMessage, Сообщение);
	ОбработкаСобытияПодключаемогоМодуля("ПослеЗаполнения_EdiMessage_XDTO", , СтруктураПараметровПМ);
	//Здесь аккуратней, при SSCC разбивка по паллетам меняет таб.часть сообщения
	
	ФабрикаXDTO_EdiXml().ЗаписатьXML(ЗаписьХМЛ, EdiMessage, "eDIMessage");
	
КонецПроцедуры

// Логистические сообщения
Процедура xmlЗаписатьПеревозкуEdiMessage_XDTO(EdiMessage, Сообщение)
	
	Если Сообщение.ТипСообщения = "IFTMBC" Тогда
		ЗаполнитьОбъектСообщения_IFTMBC(EdiMessage, Сообщение);
	ИначеЕсли Сообщение.ТипСообщения = "IFTMBF" Тогда
		ЗаполнитьОбъектСообщения_IFTMBF(EdiMessage, Сообщение);
	КонецЕсли;
	
КонецПроцедуры

// Заполнение объекта XDTO IFTMBC
Процедура ЗаполнитьОбъектСообщения_IFTMBC(СообщениеОбъект, Сообщение)
	
	xmlСоздатьДочернийЭлементXDTO(СообщениеОбъект, "interchangeHeader");
	xmlЗаписатьInterchangeHeader_XDTO(СообщениеОбъект.interchangeHeader, Сообщение);
	
	СообщениеОбъект.id = Сообщение.id;
	
	//сам документ
	bookingConfirmation = xmlСоздатьДочернийЭлементXDTO(СообщениеОбъект, "bookingConfirmation");
	xmlЗаписатьДанныеДокумента_XDTO(bookingConfirmation, Сообщение.ДокументEDI.Номер, Сообщение.ДокументEDI.Дата);
	bookingConfirmation.status = Сообщение.Статус;
	
	xmlЗаполнитьDocumentIdentificator(bookingConfirmation, "firmBooking", 	Сообщение, "ЗаказПеревозкиEDI");
	
	xmlЗаполнитьЗначениеXDTO(bookingConfirmation, "estimatedExportDateTime", 	Сообщение.ДатаПоставки);	
	xmlЗаполнитьЗначениеXDTO(bookingConfirmation, "totalPackagesQuantity", 		Сообщение.КоличествоУпаковок);	
	xmlЗаписатьQuantityType_XDTO(bookingConfirmation, "totalPackagesGrossWeight", Сообщение.ВесУпаковокБрутто.Количество, Сообщение.ВесУпаковокБрутто.КодЕдиницыИзмерения);
	
	ВыгружатьТолькоОрганизацию = Истина;

	Если ЗначениеЗаполнено(Сообщение.ПродавецEDI.GLN) Тогда
		xmlСоздатьДочернийЭлементXDTO(bookingConfirmation,		"seller");
		xmlЗаписатьContractor_XDTO(bookingConfirmation.seller,	"seller", 	Сообщение.ПродавецEDI, 	ВыгружатьТолькоОрганизацию);
	КонецЕсли;

	Если ЗначениеЗаполнено(Сообщение.ПокупательEDI.GLN) Тогда
		xmlСоздатьДочернийЭлементXDTO(bookingConfirmation,		"buyer");
		xmlЗаписатьContractor_XDTO(bookingConfirmation.buyer,	"buyer", 	Сообщение.ПокупательEDI, 	ВыгружатьТолькоОрганизацию);
	КонецЕсли;	

	Если ЗначениеЗаполнено(Сообщение.ПеревозчикEDI.GLN) Тогда
		xmlСоздатьДочернийЭлементXDTO(bookingConfirmation,		"carrier");
		xmlЗаписатьContractor_XDTO(bookingConfirmation.carrier,	"carrier", 	Сообщение.ПеревозчикEDI, 	ВыгружатьТолькоОрганизацию);
	КонецЕсли;
	
	deliveryInfo = xmlСоздатьДочернийЭлементXDTO(bookingConfirmation, "deliveryInfo");
	
	Если ЗначениеЗаполнено(Сообщение.ГрузоотправительEDI.GLN)
		ИЛИ ЗначениеЗаполнено(Сообщение.ТарифНаПеревозку) Тогда
		
		xmlСоздатьДочернийЭлементXDTO(deliveryInfo,		"despatchParty");
		
		Если ЗначениеЗаполнено(Сообщение.ГрузоотправительEDI.GLN) Тогда
			xmlЗаписатьContractor_XDTO(deliveryInfo.despatchParty,	"despatchParty", 	Сообщение.ГрузоотправительEDI, 	ВыгружатьТолькоОрганизацию);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Сообщение.ТарифНаПеревозку) Тогда
			tariffInfo = xmlСоздатьДочернийЭлементXDTO(deliveryInfo.despatchParty, "tariffInfo");
			xmlЗаполнитьЗначениеXDTO(tariffInfo, "typeOfTariff", 	Сообщение.ТарифНаПеревозку.ТипТарифа);	
			xmlЗаполнитьЗначениеXDTO(tariffInfo, "tariffRegion", 	Сообщение.ТарифНаПеревозку.РегионТарифа);	
			xmlЗаполнитьЗначениеXDTO(tariffInfo, "plannedAmount", 	Сообщение.ТарифНаПеревозку.ПлановаяСтоимость);	
		КонецЕсли;
		
	КонецЕсли;

	transportation = xmlСоздатьДочернийЭлементXDTO(deliveryInfo, "transportation");
	
	xmlЗаполнитьЗначениеXDTO(transportation, "transportMode", 			Сообщение.ИнформацияОТранспорте.РежимПеревозки);	
	xmlЗаполнитьЗначениеXDTO(transportation, "tailLift", 				Сообщение.ИнформацияОТранспорте.НаличиеГидроборта);	
	xmlЗаполнитьЗначениеXDTO(transportation, "truckCapacity", 			Сообщение.ИнформацияОТранспорте.Грузоподъемность);	
	xmlЗаполнитьЗначениеXDTO(transportation, "numberOfPalletPlaces", 	Сообщение.ИнформацияОТранспорте.КоличествоПаллетоМест);	
	xmlЗаполнитьЗначениеXDTO(transportation, "typeOfTransportCode", 	Сообщение.ИнформацияОТранспорте.ТипТранспортногоСредства);	
	xmlЗаполнитьЗначениеXDTO(transportation, "voyageNumber", 			Сообщение.ИнформацияОТранспорте.НомерРейса);	
	xmlЗаполнитьЗначениеXDTO(transportation, "vehicleNumber", 			Сообщение.ИнформацияОТранспорте.НомерТранспортногоСредства);	
	xmlЗаполнитьЗначениеXDTO(transportation, "vehicleBrand", 			Сообщение.ИнформацияОТранспорте.МаркаТранспортногоСредства);	
	xmlЗаполнитьЗначениеXDTO(transportation, "nameOfCarrier", 			Сообщение.ИнформацияОТранспорте.ИмяВодителя);	
	xmlЗаполнитьЗначениеXDTO(transportation, "phoneOfCarrier", 			Сообщение.ИнформацияОТранспорте.ТелефонВодителя);	
	xmlЗаполнитьЗначениеXDTO(transportation, "driverLicenseNumber", 	Сообщение.ИнформацияОТранспорте.НомерЛицензииВодителя);	
	xmlЗаполнитьЗначениеXDTO(transportation, "commentForTransport", 	Сообщение.ИнформацияОТранспорте.Комментарий);	

КонецПроцедуры

// Заполнение объекта XDTO IFTMBF
Процедура ЗаполнитьОбъектСообщения_IFTMBF(СообщениеОбъект, Сообщение)
	
	xmlСоздатьДочернийЭлементXDTO(СообщениеОбъект, "interchangeHeader");
	xmlЗаписатьInterchangeHeader_XDTO(СообщениеОбъект.interchangeHeader, Сообщение);
	
