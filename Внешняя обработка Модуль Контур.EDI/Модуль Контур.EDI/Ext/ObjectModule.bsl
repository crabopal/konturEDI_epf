	ПараметрыСобытия.Вставить("Раздел", "");
	ПараметрыСобытия.Вставить("Имя", "");
	ПараметрыСобытия.Вставить("Описание", "");
	ПараметрыСобытия.Вставить("Параметры", Новый Структура);
	ПараметрыСобытия.Вставить("НаличиеВозвращаемогоЗначения", Ложь);
	ПараметрыСобытия.Вставить("ТипВозвращаемогоЗначения", Неопределено);
	ПараметрыСобытия.Вставить("ОписаниеВозвращаемогоЗначения", "");
	ПараметрыСобытия.Вставить("НаличиеСтандартнойОбработкиEDI", Ложь);
		
	Возврат ПараметрыСобытия;
	
КонецФункции

