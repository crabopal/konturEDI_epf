	Возврат КонтурEDIAPI_Привести("BoxesInfo", ПодготовленныйОтветКлиента.Результат, ОтветВЛокальныхИменах); 
   	
КонецФункции

// Метод для получения предложений продления пакетов, доступных организации.  
// В случае HTTP ответа отличного от "200", выбрасывает исключение.
//
// Параметры:
//   ДанныеАвторизацииEDI - Структура - см. метод КонтурEDIAPI_НовыйДанныеАвторизации.	
//   partyId - Строка - Идентификатор организации 
//
// Возвращаемое значение:
//   Структура - См. свойства в методе КонтурEDIAPI_Схема_RenewalOffers 
//
Функция КонтурEDIAPI_ПредложенияПродления(Знач ДанныеАвторизацииEDI, partyId, ОтветВЛокальныхИменах = Ложь) Экспорт 
	
	КонтурEDIAPI_УстановитьТокенДляЗапроса(ДанныеАвторизацииEDI);
	
	МенеджерНастроек = КонтурEDIAPI_МенеджерНастроек();
	
	ПараметрыСервиса =  КонтурEDIAPI_GetRenewalOffers();                     
	ПараметрыСервиса.Параметры.partyId = partyId; 
	
	Ответ = КонтурEDIAPI_Get(ДанныеАвторизацииEDI, ПараметрыСервиса.URL, ПараметрыСервиса.Параметры, , МенеджерНастроек.Сессия);
	
	ПодготовленныйОтветКлиента = КонтурEDIAPI_ОбработатьРезультатHTTPЗапроса(ПараметрыСервиса, Ответ);	
	
	Возврат КонтурEDIAPI_Привести("RenewalOffers", ПодготовленныйОтветКлиента.Результат, ОтветВЛокальныхИменах); 
	
КонецФункции

// Осуществляет попытку преобразования объекта в структуру, описанной схемой.  
// Список всех доступных схем см. КонтурEDIAPI_ИнициализироватьСхемы  
//
// Параметры:
//   Схема - Строка - Имя схемы по которой следует привести объект.	
//   ОбъектКонвертации - Структура - Входная структура для приведения по схеме 
//   ЛокальныеИмена - Булево - флаг отвечающий за локализацию ключей структуры ответа метода
//
// Возвращаемое значение:
//   Структура - приведенная модель по переданному объекту и схеме  
//
Функция КонтурEDIAPI_Привести(Схема, ОбъектКонвертации, ЛокальныеИмена = Ложь) Экспорт  
	
	МенеджерНастроек = КонтурEDIAPI_МенеджерНастроек();
	ХранилищеСхем	 = МенеджерНастроек.ХранилищеСхем; 
	
	ПриведенныйОбъект = Неопределено;
	
	Если Схема = "MessageBoxEventBatch" Тогда
		
		ПриведенныйОбъект = КонтурEDIAPI_Привести_MessageBoxEventBatch(ХранилищеСхем, Схема, ОбъектКонвертации, ЛокальныеИмена);
				
	ИначеЕсли Схема = "MessageBoxEvent" И НЕ ОбъектКонвертации = Неопределено И КонтурСтандарт_ЭтоСтруктура(ОбъектКонвертации) Тогда
		
		ПриведенныйОбъект = КонтурEDIAPI_Привести_MessageBoxEvent(ХранилищеСхем, Схема, ОбъектКонвертации, ЛокальныеИмена);	
		
	Иначе
		
		ПриведенныйОбъект = ПостроительСхем_ПривестиПоСхеме(ХранилищеСхем, Схема, ОбъектКонвертации, ЛокальныеИмена);	
	  	
	КонецЕсли;
	
	Возврат ПриведенныйОбъект; 
	
КонецФункции

// Осуществляет попытку создать структуру, описанной схемой.  
//
// Параметры:
//   Схема - Строка - Имя схемы по которой следует создать структуру.	
//   ЛокальныеИмена - Булево - флаг отвечающий за локализацию ключей структуры ответа метода
//
// Возвращаемое значение:
//   Структура - приведенная модель по схеме  
//
Функция КонтурEDIAPI_СоздатьПоСхеме(Схема, ЛокальныеИмена = Ложь) Экспорт
	
	МенеджерНастроек = КонтурEDIAPI_МенеджерНастроек();
	ХранилищеСхем	 = МенеджерНастроек.ХранилищеСхем;	
	
	СозданныйОбъект = Неопределено;
	
	СозданныйОбъект = ПостроительСхем_ПривестиПоСхеме(ХранилищеСхем, Схема, Неопределено, ЛокальныеИмена);
	
	Возврат СозданныйОбъект; 
	
КонецФункции

Функция КонтурEDIAPI_ИнтернетРесурсДоступен() Экспорт
	
	МенеджерНастроек = КонтурEDIAPI_МенеджерНастроек();
	
	Если МенеджерНастроек.ИнтернетРесурсДоступен = Ложь
		И (МенеджерНастроек.ДатаПроверкиРесурса = Неопределено
		ИЛИ НачалоМинуты(ТекущаяДата()) > НачалоМинуты(МенеджерНастроек.ДатаПроверкиРесурса)) Тогда
		
		МенеджерНастроек.ИнтернетРесурсДоступен = Неопределено;		
		
	КонецЕсли;
	
	ИнтернетРесурсДоступен = МенеджерНастроек.ИнтернетРесурсДоступен;
	
	Если ИнтернетРесурсДоступен = Неопределено Тогда
		
		АдресРесурса = КонтурEDIAPI_АдресСервера();
		АдресРесурса = КонтурСтандарт_СтрШаблон_("https://%1", АдресРесурса);
		
		Таймаут = 10;
		МаксимальноеКоличествоПовторов = 0;
		ДополнительныеПараметры = Новый Структура("Таймаут,МаксимальноеКоличествоПовторов", Таймаут, МаксимальноеКоличествоПовторов);
			
		Попытка
			Ответ = КонтурEDIAPI_Get(Неопределено, АдресРесурса, , ДополнительныеПараметры, МенеджерНастроек.Сессия);
			
			КодыСостоянияHTTP = КлиентHTTP_КодыСостоянияHTTP(); 			
			ИнтернетРесурсДоступен = (КодыСостоянияHTTP.ОК_200 <= Ответ.КодСостояния И Ответ.КодСостояния < КодыСостоянияHTTP.НеверныйЗапрос_400);
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			ИнтернетРесурсДоступен = Ложь;
		КонецПопытки;
		
		МенеджерНастроек.ИнтернетРесурсДоступен = ИнтернетРесурсДоступен;
		МенеджерНастроек.ДатаПроверкиРесурса = ТекущаяДата();
		
	КонецЕсли;
	
	Возврат ИнтернетРесурсДоступен;
	
КонецФункции

