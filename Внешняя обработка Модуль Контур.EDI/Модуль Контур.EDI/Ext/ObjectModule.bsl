Функция ФоновыеЗаданияКонтурEDI_ЭтоВнешняяОбработкаФайл()
	
	РасположениеМодуля = ОпределитьРасположениеМодуля_КонтурEDI();
	ВариантыРасположенияМодуля = ПеречисленияEDI_ВариантыРасположенияМодуля();
	
	Возврат РасположениеМодуля = ВариантыРасположенияМодуля.Файл;
	
КонецФункции

Функция ФоновыеЗаданияКонтурEDI_ИнициализироватьМодульКонтурEDI(Идентификатор)
	
	Метрика_ВремяНачала = Метрика_ОтметкаВремени();
	
	ПараметрыКлиентСервер = ИнициализироватьПараметрыКлиентСервер();
	ИнициализироватьПодключаемыеМодули();
	ЗаполнитьКонтекстноЗависимыеПараметрыКлиентСервер(ПараметрыКлиентСервер);
	
	КоличествоДнейВОсновномСпискеПриОткрытии =ПолучитьКонстантуEDI("КоличествоДнейВОсновномСпискеПриОткрытии");
	ЗаписыватьОшибкиВЖурналРегистрации = ПолучитьКонстантуEDI("ЗаписыватьОшибкиВЖурналРегистрации");
	
	ПараметрыКлиентСервер.ЗаписыватьОшибкиВЖурналРегистрации = ?(ЗаписыватьОшибкиВЖурналРегистрации = Неопределено, Истина, ЗаписыватьОшибкиВЖурналРегистрации);
	ПараметрыКлиентСервер.КоличествоДнейВОсновномСпискеПриОткрытии	= ?(ТипЗнч(КоличествоДнейВОсновномСпискеПриОткрытии) = Тип("Число"), КоличествоДнейВОсновномСпискеПриОткрытии, 5);
	
	ПараметрыКлиентСерверМетрика = Метрика_ИнициализироватьПараметрыКлиентСервер();
	
	Метрика_ИдЗамера = Метрика_НовыйУИД();
	Метрика_НачатьЗамер(Метрика_ИдЗамера, Идентификатор, Метрика_ВремяНачала);
	Метрика_НачалоСеанса();
	Метрика_КонтекстМодуля("session");
	
	Если НастройкиМодуля = Неопределено Тогда 
		НастройкиМодуля = ПолучитьНастройкиМодуля();
	КонецЕсли;
	
	Возврат Метрика_ИдЗамера;

КонецФункции

Процедура ФоновыеЗаданияКонтурEDI_ФинализироватьМодульКонтурEDI(Метрика_ИдЗамера, Идентификатор)
	
	Метрика_КонецСеанса();
	Метрика_ЗакончитьЗамер(Метрика_ИдЗамера, Идентификатор, , , , , , Ложь);
	
	ФинализироватьПодключаемыеМодули();

КонецПроцедуры

