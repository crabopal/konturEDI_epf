Функция ОсновнаяФормаОФ() Экспорт
	
	ОсновнаяФорма = ЭДО_Кэш_Прочитать("ОсновнаяФорма");
	Если ОсновнаяФорма = Неопределено Тогда
		ОсновнаяФорма = ПолучитьФорму("ОсновнойИнтерфейс");
		ЭДО_Кэш_Поместить("ОсновнаяФорма",ОсновнаяФорма);	
	КонецЕсли;
	
	Возврат ОсновнаяФорма;
		
КонецФункции


Процедура ДобавитьКнопкуКоманднойПанелиПодключаемыйМодуль(ФормаСообщения, ИмяКнопки, НадписьНаКнопке, КартинкаКнопки = Неопределено) Экспорт
	
	КнопкиКоманднойПанели = ФормаСообщения.НастройкаФормы.КнопкиКоманднойПанели;
	
	ДобавитьКнопку = Истина;
	
	#Если Клиент Тогда
				
		Если ФормаСообщения.ЭлементыФормы.ОсновныеДействияФормы.Кнопки.Найти(ИмяКнопки) = Неопределено Тогда 		
			
			ДействиеКнопки 			= Новый Действие("КнопкаДействияФормыНажатие");
			КнопкиСписка 			= ФормаСообщения.ЭлементыФормы.ОсновныеДействияФормы.Кнопки;
			НоваяКнопка 			= КнопкиСписка.Добавить(ИмяКнопки, ТипКнопкиКоманднойПанели.Действие, НадписьНаКнопке, ДействиеКнопки);
			НоваяКнопка.Картинка 	= ?(ЗначениеЗаполнено(КартинкаКнопки),КартинкаКнопки,БиблиотекаКартинок.ВыбратьИзСписка);
			НоваяКнопка.Отображение = ОтображениеКнопкиКоманднойПанели.НадписьКартинка;
			КоличествоКнопок 		= КнопкиСписка.Количество();
			КнопкиСписка.Сдвинуть(КнопкиСписка[КоличествоКнопок - 1], -КоличествоКнопок + 1);
			
			ДобавитьКнопкуФормыСообщения(КнопкиКоманднойПанели, "Кнопка", ИмяКнопки, НадписьНаКнопке, Ложь, , "ЭлементФормы", , Ложь);
			
		КонецЕсли;  
		
	#Иначе
			
		Если ФормаСообщения.Команды.Найти(ИмяКнопки) = Неопределено Тогда 
			
			Команда			= ФормаСообщения.Команды.Добавить(ИмяКнопки);
			Команда.Действие 	= "АкцепторДобавленнойКнопки";
			Команда.Заголовок 	= НадписьНаКнопке;
			Команда.Отображение	= ОтображениеКнопки.КартинкаИТекст;
			Команда.Картинка 	= ?(ЗначениеЗаполнено(КартинкаКнопки), КартинкаКнопки, БиблиотекаКартинок.ВыбратьИзСписка);
			
			Если ПараметрыКлиентСервер.ТекущийВариантИнтерфейса = "Версия8_5" Тогда
				Команда.НазначениеДействия = Вычислить("НазначениеДействияКомандыФормы.Завершение");		
			КонецЕсли;
			
			НоваяКнопка = ФормаСообщения.Элементы.Добавить(ИмяКнопки, Тип("КнопкаФормы"), ФормаСообщения.КоманднаяПанель.ПодчиненныеЭлементы.ГруппаКнопокПодключаемогоМодуля);
			НоваяКнопка.ИмяКоманды = Команда.Имя;
			
			ДобавитьКнопкуФормыСообщения(КнопкиКоманднойПанели, "Кнопка", ИмяКнопки, НадписьНаКнопке, Ложь, , "ЭлементФормы", , Ложь);
			
		КонецЕсли;
		
	#КонецЕсли      	
		
КонецПроцедуры

Процедура ДобавитьКнопкуФормыСообщения(ТаблицаКнопок, ВидКнопки, Имя = Неопределено, Представление = Неопределено, ПроверятьПоля = Ложь, СохранятьСоответствия = Ложь, ИсточникКартинки = Неопределено, ИмяКартинки =  Неопределено, КнопкаПоУмолчанию = Ложь, Видимость = Истина) Экспорт
	
	НоваяСтрока = ТаблицаКнопок.Добавить();
	
	НоваяСтрока.ВидКнопки			= ВидКнопки;
	НоваяСтрока.Имя					= Имя;
	НоваяСтрока.Представление		= Представление;
	НоваяСтрока.ПроверятьПоля		= ПроверятьПоля;
	НоваяСтрока.СохранятьСоответствия = СохранятьСоответствия;
	НоваяСтрока.ИсточникКартинки	= ИсточникКартинки;
	НоваяСтрока.ИмяКартинки			= ИмяКартинки;
	НоваяСтрока.КнопкаПоУмолчанию	= КнопкаПоУмолчанию;
	НоваяСтрока.Видимость			= Видимость;
	
КонецПроцедуры

Функция ПолучитьЗаголовокФормыСообщения(ТипСообщения, Направление, СтатусСсылки = Неопределено) Экспорт
	
	ПодЗаголовок = ""; 
	
	Если ЗначениеЗаполнено(СтатусСсылки) Тогда
		ПодЗаголовок = ?(Найти(СтатусСсылки, "ПредварительныйЗаказ"), " (предварительный)", "");
	КонецЕсли;
	
	Заголовок = "";
	
	Если ТипСообщения = "ORDERS" И Направление = "Входящее" Тогда
		Заголовок = "Входящий заказ покупателя";
	ИначеЕсли ТипСообщения = "ORDERS" И Направление = "Исходящее" Тогда
		Заголовок = "Исходящий заказ поставщику";
	ИначеЕсли ТипСообщения = "PORDERS" И Направление = "Исходящее" Тогда
		Заголовок = "Исходящий обратный заказ";
	ИначеЕсли ТипСообщения = "ORDRSP" И Направление = "Входящее" Тогда
		Заголовок = "Входящий ответ на заказ";
	ИначеЕсли ТипСообщения = "ORDRSP" И Направление = "Исходящее" Тогда
		Заголовок = "Исходящий ответ на заказ";
	ИначеЕсли ТипСообщения = "DESADV" И Направление = "Входящее" Тогда
		Заголовок = "Входящее уведомление об отгрузке";
	ИначеЕсли ТипСообщения = "DESADV" И Направление = "Исходящее" Тогда
		Заголовок = "Исходящее уведомление об отгрузке";
	ИначеЕсли ТипСообщения = "RECADV" И Направление = "Входящее" Тогда
		Заголовок = "Входящее уведомление о приемке";
	ИначеЕсли ТипСообщения = "RECADV" И Направление = "Исходящее" Тогда
		Заголовок = "Исходящее уведомление о приемке";
	ИначеЕсли ТипСообщения = "INVOIC" И Направление = "Входящее" Тогда
		Заголовок = "Входящий счет-фактура";
	ИначеЕсли ТипСообщения = "INVOIC" И Направление = "Исходящее" Тогда
		Заголовок = "Исходящий счет-фактура";
	ИначеЕсли ТипСообщения = "COINVOIC" И Направление = "Исходящее" Тогда
		Заголовок = "Исходящий корректировочный счет-фактура";
	ИначеЕсли ТипСообщения = "RETANN" И Направление = "Входящее" Тогда
		Заголовок = "Входящее уведомление о возврате";
	ИначеЕсли ТипСообщения = "RETANN" И Направление = "Исходящее" Тогда
		Заголовок = "Исходящее уведомление о возврате";
	ИначеЕсли ТипСообщения = "RETINS" И Направление = "Исходящее" Тогда
		Заголовок = "Исходящий ответ на уведомление о возврате";
	ИначеЕсли ТипСообщения = "RETDES" И Направление = "Входящее" Тогда
		Заголовок = "Входящее уведомление об отгрузке возврата";
	ИначеЕсли ТипСообщения = "RETDES" И Направление = "Исходящее" Тогда
		Заголовок = "Исходящее уведомление об отгрузке возврата";
	ИначеЕсли ТипСообщения = "RETREC" И Направление = "Исходящее" Тогда
		Заголовок = "Исходящее уведомление о приемке возврата";
	ИначеЕсли (ТипСообщения = "PRICELIST" ИЛИ ТипСообщения = "PRICAT") И Направление = "Входящее" Тогда
		Заголовок = "Входящий ценовой лист";
	ИначеЕсли (ТипСообщения = "PRICELIST" ИЛИ ТипСообщения = "PRICAT") И Направление = "Исходящее" Тогда
		Заголовок = "Исходящий ценовой лист";
	ИначеЕсли ТипСообщения = "SLSRPT" И Направление = "Входящее" Тогда
		Заголовок = "Входящий отчет о продажах";
	ИначеЕсли ТипСообщения = "SLSRPT" И Направление = "Исходящее" Тогда
		Заголовок = "Исходящий отчет о продажах";
	ИначеЕсли ТипСообщения = "INVRPT" И Направление = "Входящее" Тогда
		Заголовок = "Входящий отчет об инвентаризации";
	ИначеЕсли ТипСообщения = "INVRPT" И Направление = "Исходящее" Тогда
		Заголовок = "Исходящий отчет об инвентаризации";
	ИначеЕсли ТипСообщения = "IFTMBF" И Направление = "Входящее" Тогда
		Заголовок = "Входящий заказ перевозки";
	ИначеЕсли ТипСообщения = "IFTMBF" И Направление = "Исходящее" Тогда
		Заголовок = "Исходящий заказ перевозки";
	ИначеЕсли ТипСообщения = "IFTMBC" И Направление = "Входящее" Тогда
		Заголовок = "Входящий ответ на заказ перевозки";
	ИначеЕсли ТипСообщения = "IFTMBC" И Направление = "Исходящее" Тогда
		Заголовок = "Исходящий ответ на заказ перевозки";
	Иначе
		Заголовок = СокрЛП(ТипСообщения) + " (" + НРег(Направление) + ")";
	КонецЕсли;
	
	Заголовок = Заголовок + ПодЗаголовок;
	
	Возврат Заголовок;
	
КонецФункции

Функция ПолучитьКнопкиДопРеквизитовСообщения(ТипСообщения,Направление,СтатусСообщения = "")

	ТаблицаКнопок = Новый ТаблицаЗначений;
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаКнопок,"ИмяКнопки, Представление");
	
	НастройкиДопРеквизитов = ПолучитьНастройкиОсновныхРеквизитов();
	
	ПоискОсновныхРеквизитов = Новый Структура("ИмяГруппыРеквизитов", ""); 
	
	ДопРеквизиты = НастройкиДопРеквизитов.НайтиСтроки(ПоискОсновныхРеквизитов);
	
	Для Каждого ДопРеквизит Из ДопРеквизиты Цикл
		ТипыСообщений = EDI_РазложитьСтрокуВМассивСлов(ДопРеквизит.ТипыСообщений, ";");
		
		Если ТипыСообщений.Найти(ТипСообщения) <> Неопределено Тогда
			 Кнопка = ТаблицаКнопок.Добавить();
			 
			 Кнопка.ИмяКнопки     = ДопРеквизит.ИмяРеквизита;
			 Кнопка.Представление = ДопРеквизит.ПредставлениеРеквизита;
		КонецЕсли;		
	КонецЦикла;
	
	Возврат ТаблицаКнопок;
	
КонецФункции   

Функция ПолучитьКнопкиКоманднойПанелиФормыСообщения(ТипСообщения,Направление,СтатусСообщения = "")
	
	ТаблицаКнопок = Новый ТаблицаЗначений;
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаКнопок,"ВидКнопки,Имя,Представление,ПроверятьПоля,СохранятьСоответствия,ИсточникКартинки,ИмяКартинки,КнопкаПоУмолчанию,Видимость");
	
	Если Направление = "Исходящее" Тогда
		ДобавитьКнопкуФормыСообщения(ТаблицаКнопок,"Кнопка","ПропуститьИсходящееСообщение","Пропустить сообщение", Истина, ,"ЭлементФормы", "КартинкаПропустить", Истина);
	КонецЕсли;
	
	Если ТипСообщения = "PORDERS" Тогда
		
		Если Направление = "Исходящее" Тогда
			
			ДобавитьКнопкуФормыСообщения(ТаблицаКнопок,"Кнопка", "ОтправитьОбратныйЗаказ", "Отправить обратный заказ", Истина,,"ЭлементФормы","КартинкаОтправитьСообщения",Истина);
			
		ИначеЕсли Направление = "Входящее" Тогда
			
			ДобавитьКнопкуФормыСообщения(ТаблицаКнопок,"Кнопка", "СоздатьЗаказПоставщику", "Создать заказ поставщику", Истина, Истина,"ЭлементФормы","КартинкаОтправитьСообщения",Истина);
			
		КонецЕсли;
		
		ДобавитьКнопкуФормыСообщения(ТаблицаКнопок,"Разделитель");
	
	ИначеЕсли ТипСообщения = "RETANN" Тогда
		
		// RETANN пока реализован только на стороне поставщика
		Если Направление = "Входящее" Тогда
			
			Если ЗначениеЗаполнено(СтатусСообщения) И (ВРег(СтатусСообщения) = "CANCELED" ИЛИ ВРег(СтатусСообщения) = "ОТМЕНА" ИЛИ ВРег(СтатусСообщения) = "ЗАМЕНА" ИЛИ ВРег(СтатусСообщения) = "REPLACE") Тогда
				
				ДобавитьКнопкуФормыСообщения(ТаблицаКнопок,"Кнопка",	"ОбработатьНовуюВерсиюВозврата",		"Обработать новую версию",	Истина	, Истина, "ЭлементФормы",	"КартинкаГалочка",Истина);
				ДобавитьКнопкуФормыСообщения(ТаблицаКнопок,"Кнопка",	"ОтметитьКакОбработанное",				"Отметить как обработанное",	Истина	, Истина, "ЭлементФормы",	"КартинкаГалочка",Ложь,Ложь);
				ДобавитьКнопкуФормыСообщения(ТаблицаКнопок,"Кнопка",	"ПометитьНаУдаление",					"Пометить на удаление",	Истина	, Истина, "ЭлементФормы",	"КартинкаГалочка",Ложь,Ложь);
				ДобавитьКнопкуФормыСообщения(ТаблицаКнопок,"Кнопка",	"ЗагрузитьВозврат",		"Загрузить возврат товара",	Истина	, Истина, "ЭлементФормы",	"КартинкаГалочка",Истина, Ложь);
				
			Иначе
				
				ДобавитьКнопкуФормыСообщения(ТаблицаКнопок,"Кнопка",	"ЗагрузитьВозврат",		"Загрузить возврат товара",	Истина	, Истина, "ЭлементФормы",	"КартинкаГалочка",Истина);
				
			КонецЕсли;
			
		ИначеЕсли Направление = "Исходящее" Тогда
			
			ДобавитьКнопкуФормыСообщения(ТаблицаКнопок,"Кнопка", "ОтправитьУведомлениеОВозврате", "Отправить уведомление о возврате", Истина,,"ЭлементФормы","КартинкаОтправитьСообщения",Истина);
			
		КонецЕсли;
		
	ИначеЕсли ТипСообщения = "RETINS" Тогда
		
		// RETINS пока реализован только на стороне поставщика
		Если Направление = "Исходящее" Тогда
			ДобавитьКнопкуФормыСообщения(ТаблицаКнопок,	"Кнопка", "ОтправитьОтветНаУведомлениеОВозврате", "Отправить ответ на уведомление о возврате", Истина, Истина, "ЭлементФормы", "КартинкаОтправитьСообщения", Истина);
		КонецЕсли;

	ИначеЕсли ТипСообщения = "RETDES" Тогда
		
		// RETDES пока реализован только на стороне поставщика
		Если Направление = "Входящее" Тогда
			ДобавитьКнопкуФормыСообщения(ТаблицаКнопок,"Кнопка",	"ЗагрузитьУведомлениеОбОтгрузкеВозврата",		"Загрузить уведомление об отгрузке возврата",	Истина	, Истина, "ЭлементФормы",	"КартинкаГалочка",Истина);
		ИначеЕсли Направление = "Исходящее" Тогда 
			ДобавитьКнопкуФормыСообщения(ТаблицаКнопок,"Кнопка",	"ОтправитьУведомлениеОбОтгрузкеВозврата",		"Отправить уведомление об отгрузке возврата",	Истина	, Истина, "ЭлементФормы",	"КартинкаОтправитьСообщения",Истина);
		КонецЕсли;

	ИначеЕсли ТипСообщения = "RETREC" Тогда
		
		// RETREC пока реализован только на стороне торговой сети
		Если Направление = "Исходящее" Тогда
			ДобавитьКнопкуФормыСообщения(ТаблицаКнопок,"Кнопка",	"ОтправитьУведомлениеОПриемкеВозврата",			"Отправить уведомление о приемке возврата",		Истина	,	,"ЭлементФормы",	"КартинкаОтправитьСообщения",Истина);
		КонецЕсли;
		
	ИначеЕсли ТипСообщения = "ORDERS" Тогда
		Если Направление = "Входящее" Тогда
			
			Если ИмяКонфигурации1С = "БП" ИЛИ ПолучитьТипЗначенияОбъекта("ВходящийЗаказПокупателя",,Истина) = "РеализацияТоваровУслуг" Тогда
				ДобавитьКнопкуФормыСообщения(ТаблицаКнопок,"Кнопка",	"СоздатьЗаказ",		"Создать реализацию товаров",	Истина	, Истина, "ЭлементФормы",	"КартинкаГалочка",Истина);	
			Иначе
				ДобавитьКнопкуФормыСообщения(ТаблицаКнопок,"Кнопка",	"СоздатьЗаказ",		"Создать заказ покупателя",	Истина	, Истина, "ЭлементФормы",	"КартинкаГалочка",Истина);	
			КонецЕсли;
			
			//ДобавитьКнопкуФормыСообщения(ТаблицаКнопок,"Кнопка",	"ОтклонитьЗаказ",	"Отклонить заказ",					,		, "ЭлементФормы",	"КартинкаОтмена");
			//ДобавитьКнопкуФормыСообщения(ТаблицаКнопок,"Разделитель");
			
		ИначеЕсли Направление = "Исходящее" Тогда
			
