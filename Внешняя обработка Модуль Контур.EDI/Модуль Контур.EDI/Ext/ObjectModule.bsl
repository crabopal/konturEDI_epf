// Метод для предварительной проверки наличия и действительности машиночитаемой доверенности (МЧД) для указанного сертификата.
// Проверяет, зарегистрирована ли доверенность на владельца сертификата и действительна ли она для работы в указанном ящике.
// В случае HTTP ответа отличного от "200", выбрасывает исключение.
//
// Параметры:
//   ДанныеАвторизацииДиадок - Структура - см. метод КонтурДиадокAPI_НовыйДанныеАвторизации.
//   ИдентификаторЯщика      - Строка - Идентификатор ящика организации в Диадок.
//	 ИдентификаторМЧД        - Структура - см. метод КонтурДиадокAPI_Схема_PowerOfAttorneyFullId 
//   Отпечаток               - Строка - Отпечаток сертификата доверенного лица.
//   ОтветВЛокальныхИменах   - Булево - Признак приведения имен свойств ответа к локальному формату (по умолчанию Ложь).
//
// Возвращаемое значение:
//   Структура - См. свойства в методе КонтурДиадокAPI_Схема_PowerOfAttorneyPrevalidateResult.
//
Функция КонтурДиадокAPI_ПредварительнаяПроверкаДоверенности(Знач ДанныеАвторизацииДиадок, ИдентификаторЯщика, ИдентификаторМЧД, Отпечаток, ОтветВЛокальныхИменах = Ложь) Экспорт
	
	КонтурДиадокAPI_УстановитьТокенДляЗапроса(ДанныеАвторизацииДиадок);
	
	МенеджерНастроек = КонтурДиадокAPI_МенеджерНастроек();

	ПараметрыСервиса = КонтурДиадокAPI_PrevalidatePowerOfAttorney();
	
	ПараметрыСервиса.Параметры.boxId = ИдентификаторЯщика;
	
	Если ЗначениеЗаполнено(ДанныеАвторизацииДиадок.ДвоичныеДанные) Тогда
		ДанныеСертификата =	ДанныеАвторизацииДиадок.ДвоичныеДанные;
	ИначеЕсли КонтурДиадокAPI_СертификатДоступенНаСервере(ДанныеАвторизацииДиадок) Тогда
		Сертификат = КонтурДиадокAPIПереопределяемый_НайтиПоОтпечатку(ДанныеАвторизацииДиадок);
		ДанныеСертификата = Сертификат.ДвоичныеДанные;
	Иначе
		ВызватьИсключение "Не удалось определить данные сертификата";
	КонецЕсли;
			
	ТелоЗапроса = КонтурДиадокAPI_СоздатьПоСхеме("PowerOfAttorneyPrevalidateRequestV2");
	ТелоЗапроса.FullId = ИдентификаторМЧД;
	ТелоЗапроса.ConfidantCertificate.Content.Content = КонтурСтандарт_Base64Строка(ДанныеСертификата);
	
	ДополнительныеПараметры = Новый Структура("Заголовки,ПараметрыЗапроса, Json", ПараметрыСервиса.Заголовки, ПараметрыСервиса.Параметры, ТелоЗапроса);
	
	Ответ = КонтурДиадокAPI_Post(ДанныеАвторизацииДиадок, ПараметрыСервиса.URL, Неопределено, ДополнительныеПараметры, МенеджерНастроек.Сессия); 	
	
	ПодготовленныйОтветКлиента = КонтурДиадокAPI_ОбработатьРезультатHTTPЗапроса(ПараметрыСервиса, Ответ);
	
	Возврат КонтурДиадокAPI_Привести("PowerOfAttorneyPrevalidateResult", ПодготовленныйОтветКлиента.Результат, ОтветВЛокальныхИменах);
	
КонецФункции

// Метод для получения содержимого и метаинформации сообщения из ящика Диадок.
// Позволяет получить полную информацию о сообщении, включая вложенные документы, подписи и статусы.
// В случае HTTP ответа отличного от "200", выбрасывает исключение.
//
// Параметры:
//   ДанныеАвторизацииДиадок     - Структура - см. метод КонтурДиадокAPI_НовыйДанныеАвторизации.
//   ИдентификаторЯщика          - Строка - Идентификатор ящика организации в Диадок.
//   ИдентификаторСообщения      - Строка - Идентификатор сообщения.
//   ИдентификаторСущности       - Строка - Идентификатор конкретной сущности (документа) внутри сообщения (необязательный).
//   ТипВозвращаемойПодписи      - Строка - Тип возвращаемой подписи для документов (необязательный).
//   ВозвращатьСодержимоеСущностей - Булево - Признак включения содержимого сущностей в ответ (по умолчанию Истина).
//   ОтветВЛокальныхИменах       - Булево - Признак приведения имен свойств ответа к локальному формату (по умолчанию Ложь).
//
// Возвращаемое значение:
//   Структура - См. свойства в методе КонтурДиадокAPI_Схема_Message.
//
Функция КонтурДиадокAPI_СодержимоеСообщения(Знач ДанныеАвторизацииДиадок, ИдентификаторЯщика, ИдентификаторСообщения, ИдентификаторСущности = "", ТипВозвращаемойПодписи = "", ВозвращатьСодержимоеСущностей = Истина, ОтветВЛокальныхИменах = Ложь) Экспорт
	
	КонтурДиадокAPI_УстановитьТокенДляЗапроса(ДанныеАвторизацииДиадок);
	
	МенеджерНастроек = КонтурДиадокAPI_МенеджерНастроек();

	ПараметрыСервиса = КонтурДиадокAPI_GetMessage();
	
	ПараметрыСервиса.Параметры.boxId = ИдентификаторЯщика;
	ПараметрыСервиса.Параметры.messageId = ИдентификаторСообщения;
	
	Если ЗначениеЗаполнено(ИдентификаторСущности) Тогда
		ПараметрыСервиса.Параметры.entityId = ИдентификаторСущности;	
	Иначе
		ПараметрыСервиса.Параметры.Удалить("entityId");		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТипВозвращаемойПодписи) Тогда
		ПараметрыСервиса.Параметры.originalSignature = ТипВозвращаемойПодписи;	
	Иначе
		ПараметрыСервиса.Параметры.Удалить("originalSignature");		
	КонецЕсли;

	ПараметрыСервиса.Параметры.injectEntityContent = XMLСтрока(ВозвращатьСодержимоеСущностей);
	
	ДополнительныеПараметры = Новый Структура("Заголовки", ПараметрыСервиса.Заголовки);
	
	Ответ = КонтурДиадокAPI_Get(ДанныеАвторизацииДиадок, ПараметрыСервиса.URL, ПараметрыСервиса.Параметры, ДополнительныеПараметры, МенеджерНастроек.Сессия); 	
	
	ПодготовленныйОтветКлиента = КонтурДиадокAPI_ОбработатьРезультатHTTPЗапроса(ПараметрыСервиса, Ответ);
	
	Возврат КонтурДиадокAPI_Привести("Message", ПодготовленныйОтветКлиента.Результат, ОтветВЛокальныхИменах);
	
КонецФункции

