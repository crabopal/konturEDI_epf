Процедура ПредложитьОбновитьОбъектыМетаданныхКонтурEDI(ТекстВопроса = Неопределено, ОбновлениеСохранено = Ложь, ПутьКФайлу = "", ВыводитьПредупреждение = Истина) Экспорт
	#Если Клиент Тогда
		
	ОбновлениеСохранено = Ложь;	
		
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		
		Если НЕ (Вопрос(ТекстВопроса,РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да) Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;

	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогВыбора.Заголовок		= "Укажите файл, в который нужно сохранить обновление для вашей конфигурации";
	ДиалогВыбора.Фильтр			= "Файл конфигурации 1С (*.cf)|*.cf";      
	ДиалогВыбора.ПолноеИмяФайла = "КонтурEDI_upd.cf";
	
	Если ДиалогВыбора.Выбрать() Тогда      
		
		ПутьКФайлу = ДиалогВыбора.ПолноеИмяФайла;
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	ИмяМакетаОбновления = "ОбновлениеДляХраненияДанных";
	ПолучитьМакет(ИмяМакетаОбновления).Записать(ПутьКФайлу);
	
	ОбновлениеСохранено = Истина;
	
	#КонецЕсли
КонецПроцедуры

Функция ПреобразоватьСохраненноеЗначение(Значение,ЗначениеСтрока)
	
	ТекЗначение = Значение;
		
	Если ТипЗнч(Значение) = Тип("COMОбъект") Тогда
		ТекЗначение = СоединениеСХранилищем.ЗначениеВСтрокуВнутр(Значение);
	ИначеЕсли ЗначениеЗаполнено(Значение) Тогда
		Если Лев(Значение,3)="{""#" Тогда
			ТекЗначение = ЗначениеИзСтрокиВнутр(Значение);
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(ЗначениеСтрока) Тогда
		ТекЗначение = ЗначениеСтрока;
		Если Лев(ЗначениеСтрока,3)="{""#" Тогда
			ТекЗначение = ЗначениеИзСтрокиВнутр(ЗначениеСтрока);
		КонецЕсли;	
	КонецЕсли;
	
	Возврат ТекЗначение;
	
КонецФункции

Функция ЭтоПредставлениеМассива(Строка)
	
	Если СтрДлина(Строка)>40 Тогда
		
		Массив = Новый Массив();
		ПредставлениеМассива = ЗначениеВСтрокуВнутр(Массив);
		
		// сравниваем на начало представления строк вида {"#",51e7a0d2-530b-11d4-b98a-008048da3034
		
		Если Лев(Строка,41)=Лев(ПредставлениеМассива,41) Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ЕстьНеобходимыеМетаданные(СтрокаМетаданных, НеИскатьВоВХ = Ложь) Экспорт
	
	ЕстьНеобходимыеМетаданные = ЭДО_Кэш_Прочитать(СтрокаМетаданных);
	
	Если ЕстьНеобходимыеМетаданные = Неопределено Тогда
		
		ЕстьНеобходимыеМетаданные = Истина;
		
		Если ВнешнееХранилище И НеИскатьВоВХ = Ложь Тогда
			ТекПолеМетаданных = СоединениеСХранилищем.Метаданные;
		Иначе
			ТекПолеМетаданных = Метаданные;
		КонецЕсли;
		
		МассивИмен = EDI_РазложитьСтрокуВМассивСлов(СтрокаМетаданных,".");
		
		КоличествоИмен = МассивИмен.Количество();
		
		// КоличествоИмен = 2 для проверки наличия объекта, например 					Справочники.КонтурEDI_Сообщения
		// КоличествоИмен = 4 для проверки наличия реквизита\ресурса и т.д., например	Справочники.КонтурEDI_Сообщения.Реквизиты.Организация
		// КоличествоИмен = 6 для проверки наличия реквизита таб. части, например		Справочники.КонтурEDI_Сообщения.ТабличныеЧасти.ДополнительныеРеквизиты.Реквизиты.ЗначениеСтрока
		Если НЕ (КоличествоИмен = 2 ИЛИ КоличествоИмен = 4 ИЛИ КоличествоИмен = 6) Тогда
			ЕстьНеобходимыеМетаданные = Ложь;
		КонецЕсли;
		
		Если ЕстьНеобходимыеМетаданные Тогда
			КоличествоПоисков = КоличествоИмен/2;
			Для н = 1 По КоличествоПоисков Цикл
				ТекПолеМетаданных = ТекПолеМетаданных[МассивИмен[н*2-2]].Найти(МассивИмен[н*2-1]);
				Если ТекПолеМетаданных = Неопределено Тогда
					ЕстьНеобходимыеМетаданные =  Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		ЭДО_Кэш_Поместить(СтрокаМетаданных, ЕстьНеобходимыеМетаданные);
		
	КонецЕсли;
	
	Возврат ЕстьНеобходимыеМетаданные;	
	
КонецФункции

Функция ПолучитьОбъектМетаданных_КонтурEDI(СтрокаМетаданных, НеИскатьВоВХ = Ложь) Экспорт
	
	Если ВнешнееХранилище И НеИскатьВоВХ = Ложь Тогда
		ТекПолеМетаданных = СоединениеСХранилищем.Метаданные;
	Иначе
		ТекПолеМетаданных = Метаданные;
	КонецЕсли;
	
	МассивИмен = EDI_РазложитьСтрокуВМассивСлов(СтрокаМетаданных,".");

	КоличествоИмен = МассивИмен.Количество();
	
	// КоличествоИмен = 2 для проверки наличия объекта, например 					Справочники.КонтурEDI_Сообщения
	// КоличествоИмен = 4 для проверки наличия реквизита\ресурса и т.д., например	Справочники.КонтурEDI_Сообщения.Реквизиты.Организация
	// КоличествоИмен = 6 для проверки наличия реквизита таб. части, например		Справочники.КонтурEDI_Сообщения.ТабличныеЧасти.ДополнительныеРеквизиты.Реквизиты.ЗначениеСтрока
	
	Если НЕ (КоличествоИмен = 2 ИЛИ КоличествоИмен = 4 ИЛИ КоличествоИмен = 6) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КоличествоПоисков = КоличествоИмен/2;
	Для н = 1 По КоличествоПоисков Цикл
		ТекПолеМетаданных = ТекПолеМетаданных[МассивИмен[н*2-2]].Найти(МассивИмен[н*2-1]);
		Если ТекПолеМетаданных = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТекПолеМетаданных;	
	
КонецФункции

Функция ПолучитьФункциональнуюОпцию_КонтурEDI(Имя)
	
	Если ЕстьНеобходимыеМетаданные("ФункциональныеОпции." + Имя) Тогда
		Возврат ПолучитьФункциональнуюОпцию(Имя);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
				
КонецФункции

Процедура ДополнитьСообщениеСохраненнымиДанными(Сообщение, Параметры)
		
	ПереотправляемоеСообщениеСсылка = Неопределено;
	ПроверитьСвойствоПоляВСтруктуре(Параметры, "ПереотправляемоеСообщениеСсылка", ПереотправляемоеСообщениеСсылка);
	
	СообщениеСсылка = Неопределено;
	ПроверитьСвойствоПоляВСтруктуре(Параметры, "СообщениеСсылка", СообщениеСсылка);
	
	Если ЗначениеЗаполнено(ПереотправляемоеСообщениеСсылка) Тогда
		СуществующееСообщениеСсылка = ПереотправляемоеСообщениеСсылка;
	ИначеЕсли ЗначениеЗаполнено(СообщениеСсылка) И Сообщение.Документ1С = СообщениеСсылка.Документ Тогда
		СуществующееСообщениеСсылка = СообщениеСсылка;
	Иначе
		СуществующееСообщениеСсылка = Неопределено;
	КонецЕсли;	        	
		
	Если ЗначениеЗаполнено(СуществующееСообщениеСсылка) Тогда
		
		СуществующееСообщение = ПрочитатьСообщение(СуществующееСообщениеСсылка);
		
		Если ЗначениеЗаполнено(СуществующееСообщение)
			И СуществующееСообщение.ТипСообщения = Сообщение.ТипСообщения Тогда
			
			Сообщение.ДатаПоставки = СуществующееСообщение.ДатаПоставки;
			Сообщение.Комментарий = СуществующееСообщение.Комментарий;
			
			Если СуществующееСообщениеСсылка.ТребуемоеДействие = "ОбработатьСохраненноеСообщение" Тогда
				Сообщение.Статус = СуществующееСообщение.Статус;
			КонецЕсли;
			
			Если (Сообщение.ТипСообщения = "DESADV" ИЛИ Сообщение.ТипСообщения = "INVOIC")
				И СообщениеСодержитТранспортныеУпаковки(СуществующееСообщение) Тогда
				
				// восстановим транспортные упаковки из сохраненного сообщения
				Сообщение.ТранспортныеУпаковки  = СуществующееСообщение.ТранспортныеУпаковки.Скопировать();  
				
				// скорректируем транспортные упаковки сформированного сообщения
				СкорректироватьСоставУпаковокПоТоварнымПозициям(СуществующееСообщение, Сообщение); 			
				
			КонецЕсли;
			
			Если Сообщение.Свойство("ТипыМаркируемойПродукции") 
				И СуществующееСообщение.Свойство("ТипыМаркируемойПродукции")
				И ТипЗнч(СуществующееСообщение.ТипыМаркируемойПродукции) = Тип("СписокЗначений")
				И Сообщение.ТипыМаркируемойПродукции.Количество() = 0 Тогда
				
				Сообщение.ТипыМаркируемойПродукции = СуществующееСообщение.ТипыМаркируемойПродукции.Скопировать();
				
			КонецЕсли;
			
			// при сравнении состава товаров сохраненного и сформированного сообщений
			// дополним ссылкой на существующее сообщение (здесь может быть и ссылка и строка(80))
			Сообщение.СообщениеСсылка 	= СуществующееСообщениеСсылка;
			
			// дополним сообщение другими сохраненными данными {
			
			// сохраненные особенности
			ДополнитьСообщениеСохраненнымиОсобенностями(Сообщение, СуществующееСообщение);
			
			// } дополним сообщение другими сохраненными данными
			
		КонецЕсли;
		
	КонецЕсли;
	
	// приведем структуру сообщения в соответствие с маппингом
	// дополним рекурсивно старые сообщения новыми полями во вложенных структурах, таблицах, деревьях
	Эталон = ПолучитьСтруктуруСообщения(Сообщение.ТипСообщения, Сообщение.Направление);
	ДополнитьСтруктуруСообщенияИзЭталона(Сообщение, Эталон);
	КонвертироватьУстаревшиеСтруктурыСообщения(Сообщение);

КонецПроцедуры

Процедура АктуализироватьСообщение(Сообщение, Параметры = Неопределено) Экспорт 
	
	Если НЕ ЗначениеЗаполнено(Сообщение.Документ1С) Тогда 
		Возврат;
	КонецЕсли;
	
	СообщениеСтарое = Сообщение;
	
	Если ПеременнаяСодержитСвойство(СообщениеСтарое, "Статус") Тогда
		Параметры.Вставить("Статус", СообщениеСтарое.Статус);
	КонецЕсли;
	
	СообщениеНовое = ПодготовитьИсходящееСообщение(СообщениеСтарое.ТипСообщения, СообщениеСтарое.Документ1С, Параметры);
	
	ДополнитьСообщениеСохраненнымиОсобенностями(СообщениеНовое, СообщениеСтарое);
	ДополнитьСообщениеПолямиЗаполняемымиНаФорме(СообщениеНовое, СообщениеСтарое);
	
	СообщениеСсылка = Неопределено;
	Если ПеременнаяСодержитСвойство(Сообщение, "СообщениеСсылка", СообщениеСсылка, Истина) Тогда
		
		СообщениеНовое.Вставить("СообщениеСсылка", СообщениеСсылка);
		
	КонецЕсли;

	РезультатПроверки = ПроверитьПоляСообщения(СообщениеНовое);
	СообщениеНовое.СодержитОшибки =  НЕ РезультатПроверки.Успешно;
	
	Сообщение = СообщениеНовое;
		
КонецПроцедуры

Процедура ДополнитьСообщениеПолямиЗаполняемымиНаФорме(СообщениеНовое, СообщениеСтарое)
	
	МассивПолей = Новый Массив;
	МассивПолей.Добавить("ЗапрашиваемоеДействие");
	МассивПолей.Добавить("ПричинаВозврата");
	МассивПолей.Добавить("ВесНетто");
	МассивПолей.Добавить("КодЕдиницыИзмеренияНетто");
	МассивПолей.Добавить("ВесБрутто");
	МассивПолей.Добавить("КодЕдиницыИзмеренияБрутто");
	МассивПолей.Добавить("НомерНакладной");
	МассивПолей.Добавить("ДатаНакладной");
	МассивПолей.Добавить("ПричинаРешения");
	МассивПолей.Добавить("ПричинаРешенияОтПокупателя");
	МассивПолей.Добавить("РешениеПоВозврату");
	
	Если ПеременнаяСодержитСвойство(СообщениеСтарое, "КодыМаркировкиОтредактированыВручную") 
		И СообщениеСтарое.КодыМаркировкиОтредактированыВручную = Истина
		И ОтправлятьКодыМаркировки(СообщениеНовое) Тогда
		
		СообщениеНовое.Вставить("КодыМаркировкиОтредактированыВручную", Истина);
		МассивПолей.Добавить("КодыМаркировки");
		
	КонецЕсли;
	
	МассивНайденныхРанееСтрок = Новый Массив;
	
	Если СообщениеСтарое.Товары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СовпадающиеКолонкиТаблицСообщений = Неопределено;
	
	Если Не СообщениеНовое.ТипСообщения = СообщениеСтарое.ТипСообщения Тогда
		СовпадающиеКолонкиТаблицСообщений = СовпадающиеКолонкиТаблицЗначений(СообщениеСтарое.Товары, СообщениеНовое.Товары);
	КонецЕсли;
		
	Для каждого Строка Из СообщениеНовое.Товары Цикл
		
		СтруктураПоиска = ПолучитьСтруктуруПоискаСтрокиСообщенияEDI(Строка, СовпадающиеКолонкиТаблицСообщений); 
		
		ИсходнаяСтрока = ОднозначноОпределитьСоответствиеСтрокиВТаблице(
							СообщениеСтарое.Товары, 
							СтруктураПоиска, 
							ВариантыПоискаТовараВСообщении(СтруктураПоиска));
		
		Если ИсходнаяСтрока = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ МассивНайденныхРанееСтрок.Найти(ИсходнаяСтрока) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		МассивНайденныхРанееСтрок.Добавить(ИсходнаяСтрока);
		
		Для Каждого Поле из МассивПолей Цикл 
			
			Если ПеременнаяСодержитСвойство(Строка, Поле) 
				И (НЕ ЗначениеЗаполнено(Строка[Поле])
					ИЛИ Поле = "КодыМаркировки")
				И ПеременнаяСодержитСвойство(ИсходнаяСтрока, Поле) 
				И ЗначениеЗаполнено(ИсходнаяСтрока[Поле]) Тогда 
				
				Строка[Поле] = ИсходнаяСтрока[Поле];				
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция СообщениеСодержитТранспортныеУпаковки(Сообщение) Экспорт
	
	Результат = ПроверитьСвойствоПоляВСтруктуре(Сообщение, "ТранспортныеУпаковки")
		И ТипЗнч(Сообщение.ТранспортныеУпаковки) = Тип("ДеревоЗначений") 	
		И Сообщение.ТранспортныеУпаковки.Строки.Количество() > 0;
									
	Возврат Результат;
	
КонецФункции

Функция ОтправлятьДанныеОТранспортныхУпаковках(Сообщение) Экспорт
	
	ОтправлятьДанныеОбУпаковках = (ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, "ОтправлятьДанныеОбУпаковках") = Истина);
	
	Результат = (Сообщение.ТипСообщения = "DESADV" ИЛИ Сообщение.ТипСообщения = "INVOIC")
		И Сообщение.Направление = "Исходящее"
		И ОтправлятьДанныеОбУпаковках;

	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьСвойстваСтрокДереваЗначенийРекурсивно(ДеревоЗначенийПриемник, ДеревоЗначенийИсточник) Экспорт
	
	Для каждого СтрокаДереваИсточника Из ДеревоЗначенийИсточник.Строки Цикл
		
		СтрокаДереваПриемника = ДеревоЗначенийПриемник.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДереваПриемника, СтрокаДереваИсточника);
		ЗаполнитьСвойстваСтрокДереваЗначенийРекурсивно(СтрокаДереваПриемника, СтрокаДереваИсточника);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДополнитьСообщениеСохраненнымиОсобенностями(Сообщение, СохраненноеСообщение)
	
	Если ПолучитьКонстантуEDI("ЗаполнятьОсобенностиСохраненнымиЗначениями") = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	МассивПростыхОсобенностейТоваров = Новый Массив;
	
	Для каждого ОсобенностьСообщения Из ОсобенностиСообщений Цикл
		
		Если НЕ ОсобенностьЕстьВСообщении(ОсобенностьСообщения,Сообщение) Тогда
			Продолжить;
		КонецЕсли;
		Если ОсобенностьСообщения.НеСохранятьВСообщение Тогда
			Продолжить;
		КонецЕсли;
		
		ПолныйПутьОсобенности = ПолучитьПолныйПутьОсобенностиСообщения(ОсобенностьСообщения);
		
		Если ЭтоОсобенностьТоваров(ОсобенностьСообщения)
			И НЕ ОсобенностьСообщения.Идентификатор = "Товары" Тогда
			
			Идентификатор = ОсобенностьСообщения.Идентификатор; 
			Если ОсобенностьСообщения.Ревенство1СEDI = Неопределено Тогда
				Идентификатор = Идентификатор + "1С";		
			КонецЕсли;
			
			ЭтоОсобенностьСложногоТипа = ЭтоОсобенностьСложногоТипа(ОсобенностьСообщения.ТипЗначенияEDI);
			
			Если ЭтоОсобенностьСложногоТипа 
				ИЛИ (ЗначениеЗаполнено(ОсобенностьСообщения.ИмяСтруктуры)
				И ЗначениеЗаполнено(ОсобенностьСообщения.ИмяТаблицы)) Тогда
				
				МассивНайденныхРанееСтрок = Новый Массив;
				
				СопадающиеКолонкиТаблицСообщений = Неопределено;
				
				Если Не Сообщение.ТипСообщения = СохраненноеСообщение.ТипСообщения Тогда
					СопадающиеКолонкиТаблицСообщений = СовпадающиеКолонкиТаблицЗначений(Сообщение.Товары, СохраненноеСообщение.Товары);	
				КонецЕсли;
				
				Для каждого Строка Из Сообщение.Товары Цикл
					
					СтруктураПоиска = ПолучитьСтруктуруПоискаСтрокиСообщенияEDI(Строка, СопадающиеКолонкиТаблицСообщений); 
					
					ИсходнаяСтрока = ОднозначноОпределитьСоответствиеСтрокиВТаблице(
										СохраненноеСообщение.Товары, 
										СтруктураПоиска, 
										ВариантыПоискаТовараВСообщении(СтруктураПоиска));
					
					Если ИсходнаяСтрока = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					Если НЕ МассивНайденныхРанееСтрок.Найти(ИсходнаяСтрока) = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					МассивНайденныхРанееСтрок.Добавить(ИсходнаяСтрока);
					ЗначениеОсобенности = Неопределено;
					
					Если ЭтоОсобенностьСложногоТипа Тогда
						ПерезаполнитьЗначениеСогласноЕгоТипу(Строка[Идентификатор], ИсходнаяСтрока[Идентификатор]);
					ИначеЕсли ПроверитьСвойствоПоляВСтруктуре(ИсходнаяСтрока[ОсобенностьСообщения.ИмяТаблицы], Идентификатор, ЗначениеОсобенности) Тогда
						ПеренестиЗначениеВПолеСтруктуры(Строка[ОсобенностьСообщения.ИмяТаблицы], Идентификатор, ЗначениеОсобенности);
					КонецЕсли;
			КонецЦикла;		
				
			ИначеЕсли НЕ Сообщение.Товары.Колонки.Найти(Идентификатор) = Неопределено
				И НЕ СохраненноеСообщение.Товары.Колонки.Найти(Идентификатор) = Неопределено Тогда
				МассивПростыхОсобенностейТоваров.Добавить(Идентификатор);
			КонецЕсли;
			
		Иначе
			
			ЗначениеОсобенности = Неопределено;
			
			Если ПроверитьСвойствоПоляВСтруктуре(СохраненноеСообщение, ПолныйПутьОсобенности, ЗначениеОсобенности) Тогда
           		ПеренестиЗначениеВПолеСтруктуры(Сообщение, ПолныйПутьОсобенности, ЗначениеОсобенности);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивПростыхОсобенностейТоваров.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаОсобенностейТоваров = "";
	Для каждого ИдентификаторОсобенности Из МассивПростыхОсобенностейТоваров Цикл
		СтрокаОсобенностейТоваров = СтрокаОсобенностейТоваров + "," + ИдентификаторОсобенности;	
	КонецЦикла;
	СтрокаОсобенностейТоваров = Сред(СтрокаОсобенностейТоваров, 2);
	
	МассивНайденныхРанееСтрок = Новый Массив;	
	
	СовпадающиеКолонкиТаблицТоваров = Неопределено;
	
	Если Не Сообщение.ТипСообщения = СохраненноеСообщение.ТипСообщения Тогда
		СовпадающиеКолонкиТаблицТоваров = СовпадающиеКолонкиТаблицЗначений(Сообщение.Товары, СохраненноеСообщение.Товары);
	КонецЕсли;
	
	Для каждого Строка Из Сообщение.Товары Цикл
		
		СтруктураПоиска = ПолучитьСтруктуруПоискаСтрокиСообщенияEDI(Строка, СовпадающиеКолонкиТаблицТоваров); 		
				
		ИсходнаяСтрока = ОднозначноОпределитьСоответствиеСтрокиВТаблице(
							СохраненноеСообщение.Товары, 
							СтруктураПоиска, 
							ВариантыПоискаТовараВСообщении(СтруктураПоиска));
		
		Если ИсходнаяСтрока = Неопределено Тогда
			Продолжить;
		КонецЕсли;
 		Если НЕ МассивНайденныхРанееСтрок.Найти(ИсходнаяСтрока) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		МассивНайденныхРанееСтрок.Добавить(ИсходнаяСтрока);

		ЗаполнитьЗначенияСвойств(Строка, ИсходнаяСтрока, СтрокаОсобенностейТоваров);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСтруктуруПоискаСтрокиСообщенияEDI(Строка, СписокСвойств = Неопределено) 
	
	Если СписокСвойств = Неопределено Тогда
		СписокСвойств = МассивСвойствДляПоискаСтроки();   
	КонецЕсли;
		
	СтруктураПоиска = Новый Структура;
	
	Для Каждого Свойство Из СписокСвойств Цикл
		Если ПеременнаяСодержитСвойство(Строка, Свойство) Тогда
			СтруктураПоиска.Вставить(Свойство, Строка[Свойство]);  
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтруктураПоиска;

КонецФункции

Функция МассивСвойствДляПоискаСтроки()
	
	МассивСвойств = ЭДО_Кэш_Прочитать("МассивСвойствДляПоискаСтроки");
	
	Если МассивСвойств = Неопределено Тогда
		
		МассивСвойств = Новый Массив;
		МассивСвойств.Добавить("Номенклатура");
		МассивСвойств.Добавить("ХарактеристикаНоменклатуры");
		МассивСвойств.Добавить("ЕдиницаИзмерения");
		МассивСвойств.Добавить("СерияНоменклатуры");
		МассивСвойств.Добавить("Страна1С");
		МассивСвойств.Добавить("НомерГТД1С");
		МассивСвойств.Добавить("КонечныйГрузополучательGLN");
		МассивСвойств.Добавить("Количество"); 
		МассивСвойств.Добавить("КоличествоДо");
		МассивСвойств.Добавить("КоличествоПосле");
		МассивСвойств.Добавить("GTIN");
		МассивСвойств.Добавить("КодТовараПокупателя");
		МассивСвойств.Добавить("КодТовараПоставщика");
		
		ЭДО_Кэш_Поместить("МассивСвойствДляПоискаСтроки", МассивСвойств);
		
	КонецЕсли;
	
	Возврат МассивСвойств;
	
КонецФункции

// Функция для поиска максимально точного совпадения строк в произвольной таблице значений по вариантам поиска
//
// Параметры
//  ТаблицаПоиска  	-	ТаблицаЗначений - таблица, в которой будем искать строки.
//  СтруктураПоиска	-	Структура 		- структура с исходными данными для поиска,
//											по ней будем строить отборы согласно вариантам поиска.
//  ВариантыПоиска	- 	Массив			- массив, состоящий из строк для формирования структур отборов с разделителем - ",".
//
// Возвращаемое значение:
//   Массив 		- массив найденных строк в таблице с минимальным количеством найденных строк, более 0
//
Функция НайтиСтрокиВТаблицеПоВариантамПоиска(ТаблицаПоиска, СтруктураПоиска, ВариантыПоиска) Экспорт
	
	ВариантСМинимальнымКоличествомСтрок = Новый Массив;
	
	МинимальноеКоличествоНайденныхСтрок = 0;
	КоличествоВариантов = ВариантыПоиска.Количество();
	
	Для Каждого СписокПолей Из ВариантыПоиска Цикл 
				
		ТекущаяСтруктураПоиска = Новый Структура(СписокПолей);
				
        ЗаполнитьЗначенияСвойств(ТекущаяСтруктураПоиска, СтруктураПоиска, СписокПолей);
		
		НайденныеСтроки 			= ТаблицаПоиска.НайтиСтроки(ТекущаяСтруктураПоиска);
		КоличествоНайденныхСтрок 	= НайденныеСтроки.Количество();
		
		Если КоличествоНайденныхСтрок = 1 Тогда
			
			Возврат НайденныеСтроки;
			
		ИначеЕсли МинимальноеКоличествоНайденныхСтрок = 0
			ИЛИ КоличествоНайденныхСтрок < МинимальноеКоличествоНайденныхСтрок Тогда
			
			МинимальноеКоличествоНайденныхСтрок	= КоличествоНайденныхСтрок;
			ВариантСМинимальнымКоличествомСтрок = НайденныеСтроки;    
			
		КонецЕсли;
				
	КонецЦикла;
	
	Возврат ВариантСМинимальнымКоличествомСтрок;
	
КонецФункции

Функция ВариантыПоискаВТаблице_КонтурEDI(Таблица, СписокСвойств) Экспорт
				
	КоличествоСвойств = СписокСвойств.Количество();
	
	ВариантыПоиска = Новый Массив;
	
	ПредыдущееЗначениеВарианта = "";
	
	ИндексСвойства = 0;
	
	ДобавитьСвойствоВСтекВариантовПоиска_КонтурEDI(ИндексСвойства, СписокСвойств, ВариантыПоиска, Таблица.Колонки);
			
	Возврат ВариантыПоиска;

КонецФункции

Процедура ДобавитьСвойствоВСтекВариантовПоиска_КонтурEDI(ИндексСвойства, СписокСвойств, ВариантыПоиска, КолонкиТаблицы = Неопределено)
	
	Если ИндексСвойства < СписокСвойств.Количество() Тогда	
		
		КоличествоВариантов = ВариантыПоиска.Количество();
		
		Если КоличествоВариантов <> 0 Тогда
			ПредыдущееЗначениеВарианта = ВариантыПоиска[0];
		Иначе
			ПредыдущееЗначениеВарианта = "";
		КонецЕсли;
		
		Свойство = СписокСвойств[ИндексСвойства];
		
		Если ЗначениеЗаполнено(Свойство) 
			И (КолонкиТаблицы = Неопределено ИЛИ ПеременнаяСодержитСвойство(КолонкиТаблицы, Свойство)) Тогда
			
			Если ЗначениеЗаполнено(ПредыдущееЗначениеВарианта) Тогда
				Разделитель = ",";
			Иначе
				Разделитель = "";
			КонецЕсли;
			
			ЗначениеВарианта = ПредыдущееЗначениеВарианта + Разделитель + Свойство;
			
			ВариантыПоиска.Вставить(0, ЗначениеВарианта);
								
		КонецЕсли;
		
		ИндексСвойства = ИндексСвойства + 1;
		
		ДобавитьСвойствоВСтекВариантовПоиска_КонтурEDI(ИндексСвойства, СписокСвойств, ВариантыПоиска, КолонкиТаблицы);
		
	КонецЕсли;

КонецПроцедуры

Функция ОднозначноОпределитьСоответствиеСтрокиВТаблице(ТаблицаПоиска, СтруктураПоиска, ВариантыПоиска) Экспорт
	
	Результат = Неопределено;
	
	ВариантСМинимальнымКоличествомСтрок = НайтиСтрокиВТаблицеПоВариантамПоиска(ТаблицаПоиска, СтруктураПоиска, ВариантыПоиска);
	КоличествоНайденныхСтрок = ВариантСМинимальнымКоличествомСтрок.Количество();
	
	Если КоличествоНайденныхСтрок = 1 Тогда
		Результат = ВариантСМинимальнымКоличествомСтрок[0];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВариантыПоискаТовараВСообщении(СтруктураПоиска = Неопределено)
	
	ВариантыПоиска = Новый Массив;
	
	Если СтруктураПоиска = Неопределено ИЛИ ПеременнаяСодержитСвойство(СтруктураПоиска, "Количество") Тогда
		ПолеКоличество = ",Количество";
	ИначеЕсли ПеременнаяСодержитСвойство(СтруктураПоиска, "КоличествоДо") Тогда
		ПолеКоличество = ",КоличествоДо";
	ИначеЕсли ПеременнаяСодержитСвойство(СтруктураПоиска, "КоличествоПосле") Тогда
		ПолеКоличество = ",КоличествоПосле";
	Иначе
		ПолеКоличество = "";
	КонецЕсли;
	
	КлючСоответствияEDI = "GTIN,КодТовараПокупателя,КодТовараПоставщика";
	КлючАналитики1С = "Номенклатура,ХарактеристикаНоменклатуры,ЕдиницаИзмерения";
	ДопПоля1С = "СерияНоменклатуры,Страна1С,НомерГТД1С";       
	
	ВариантыПоиска.Добавить(КлючСоответствияEDI + "," + КлючАналитики1С + "," + ДопПоля1С + ПолеКоличество);
	ВариантыПоиска.Добавить(КлючСоответствияEDI + "," + КлючАналитики1С + "," + ДопПоля1С);
	ВариантыПоиска.Добавить(КлючСоответствияEDI + "," + КлючАналитики1С + ПолеКоличество);
	ВариантыПоиска.Добавить(КлючСоответствияEDI + "," + КлючАналитики1С);
	
	ВариантыПоиска.Добавить(КлючАналитики1С + "," + ДопПоля1С + ПолеКоличество);
	ВариантыПоиска.Добавить(КлючАналитики1С + "," + ДопПоля1С);
	ВариантыПоиска.Добавить(КлючАналитики1С + ПолеКоличество);
	ВариантыПоиска.Добавить(КлючАналитики1С);
	
	ВариантыПоиска.Добавить(КлючСоответствияEDI);	
	
	Возврат ВариантыПоиска;
	
КонецФункции

Функция ПодготовитьВариантыПоискаСтрокиТоваров(ОбязательныеПоля, ПеременныеПоля) 
	
	ВариантыПоиска = Новый Массив;
	
	СтрокаОбязательныхПолей = EDI_СоединитьСтрокуИзМассиваСлов(ОбязательныеПоля, ",");
	
	СтрокаПеременныхПолейНакопительно = "" + СтрокаОбязательныхПолей;
		
	Для Каждого Поле Из ПеременныеПоля Цикл
		
		СтрокаПеременныхПолейНакопительно = СтрокаПеременныхПолейНакопительно + "," + Поле;		
		
		ВариантыПоиска.Вставить(0, СтрокаПеременныхПолейНакопительно);
		
	КонецЦикла;
	
	ВариантыПоиска.Добавить(СтрокаОбязательныхПолей);
			
	Возврат ВариантыПоиска;
	
КонецФункции

Функция ЭтоОсобенностьТоваров(Особенность) Экспорт
	
	Возврат (НЕ Найти(Особенность.Путьxml,"lineItem.") = 0 ИЛИ Особенность.ИмяТаблицы = "Товары");
	
КонецФункции

Процедура СкорректироватьСоставУпаковокПоТоварнымПозициям(СохраненноеСообщение, Сообщение);

	//процедура исключает из упаковок те позиции, у которых:
	// - изменилось количество или
	// - изменилось наличие самих товаров или
	// - изменилась позиция с списке товаров или
	// - не совпадает хотя бы один из идентификаторов (GTIN, КТПокупателя, КТПоставщика).
	
	_Товары   = СохраненноеСообщение.Товары;
	Товары 	  = Сообщение.Товары;
	
	Партнер = Сообщение.Партнер;
	НастройкаСинхронизации	= ПолучитьСписокСвойствEDI("СинхронизироватьТоварыТолькоПоGTIN,СинхронизироватьТоварыТолькоПоКодуПартнера", Партнер);
	
	Если НастройкаСинхронизации.СинхронизироватьТоварыТолькоПоGTIN = Истина Тогда 
		
		ПоляСравнения = "GTIN,Количество";
		
	ИначеЕсли НастройкаСинхронизации.СинхронизироватьТоварыТолькоПоКодуПартнера = Истина Тогда 
		
		ПоляСравнения = "КодТовараПокупателя,Количество";
	
	Иначе
		
		ПоляСравнения = "GTIN,КодТовараПокупателя,Количество";

	КонецЕсли;
	
	КоличествоТовары = Товары.Количество();
	
	//обойдем все сохраненные товары
	_НомерПозиции = 1;
	Для Каждого _СтрокаТовар Из _Товары Цикл
		
		//попробуем для каждого из них по номеру позиции получить соответствующий в текущих товарах
		ИсключитьПозицию = Ложь;
		
		Если НЕ _НомерПозиции > КоличествоТовары Тогда
			
			СтрокаТовар = Товары.Получить(_НомерПозиции-1);
			
			Для каждого ПолеСравнения из EDI_РазложитьСтрокуВМассивСлов(ПоляСравнения, ",") Цикл 
				
				Если СтрокаТовар[ПолеСравнения] <> _СтрокаТовар[ПолеСравнения] Тогда 
					
					ИсключитьПозицию = Истина;
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе	
			
			ИсключитьПозицию = Истина;
			
		КонецЕсли;
		
		//находим и удаляем изменившиеся позиции
		Если ИсключитьПозицию Тогда
			ИсключаемыеПозиции = Сообщение.ТранспортныеУпаковки.Строки.НайтиСтроки(Новый Структура("НомерСтроки",_НомерПозиции),Истина);
			Для Каждого ИсключаемаяПозиция Из ИсключаемыеПозиции Цикл
				ИсключаемаяПозиция.Родитель.Строки.Удалить(ИсключаемаяПозиция);
			КонецЦикла;
		КонецЕсли;
		
		_НомерПозиции = _НомерПозиции + 1;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьОписаниеСобытийПодключаемогоМодуляРасширений() Экспорт
	
	// инициализируем
	ТаблицаСобытий = СобытияПодключаемогоМодуля_КонтурEDI(); 
	
	ТаблицаПараметров = ТаблицаПараметровСобытийПодключаемогоМодуляРасширений_КонтурEDI();
	
	Для Каждого Событие Из ТаблицаСобытий Цикл
		
		Для Каждого Параметр Из Событие.Параметры Цикл
			
			ОписаниеПараметра = ТаблицаПараметров.Найти(Параметр.Ключ, "Имя");
			
			СтруктураПараметра = Новый Структура("Имя,Тип,Описание,Представление");
			СтруктураПараметра.Имя = Параметр.Ключ;
			СтруктураПараметра.Описание = Параметр.Ключ;
			СтруктураПараметра.Представление = Параметр.Ключ;
			
			Если Не ОписаниеПараметра = Неопределено Тогда
				         			
				ЗаполнитьЗначенияСвойств(СтруктураПараметра, ОписаниеПараметра); 				
				
			КонецЕсли;
			
			Событие.Параметры.Вставить(Параметр.Ключ, СтруктураПараметра);
			
		КонецЦикла;
		
	КонецЦикла;
			
	Возврат ТаблицаСобытий;
	
КонецФункции

Функция ПолучитьТаблицуСвойстваРасширений() Экспорт
	
	ТаблицаОписанияСвойств = Новый ТаблицаЗначений;
	
	ТаблицаОписанияСвойств.Колонки.Добавить("Представление");
	ТаблицаОписанияСвойств.Колонки.Добавить("Наименование");
	ТаблицаОписанияСвойств.Колонки.Добавить("ИмяРеквизита");
	
	НоваяСтрока = ТаблицаОписанияСвойств.Добавить();
	НоваяСтрока.Представление = "Идентификатор:";
	НоваяСтрока.Наименование = "Идентификатор";
	НоваяСтрока.ИмяРеквизита = "Значение";
	НоваяСтрока = ТаблицаОписанияСвойств.Добавить();
	НоваяСтрока.Представление = "Версия:";
	НоваяСтрока.Наименование = "ВерсияРасширения";
	НоваяСтрока.ИмяРеквизита = "Значение";
	НоваяСтрока = ТаблицаОписанияСвойств.Добавить();
	НоваяСтрока.Представление = "Версия модуля:";
	НоваяСтрока.Наименование = "РекомендуемаяВерсияМодуля";
	НоваяСтрока.ИмяРеквизита = "Значение";
	НоваяСтрока = ТаблицаОписанияСвойств.Добавить();
	НоваяСтрока.Представление = "Обязательный:";
	НоваяСтрока.Наименование = "Обязательный";
	НоваяСтрока.ИмяРеквизита = "Значение";
	НоваяСтрока = ТаблицаОписанияСвойств.Добавить();
	НоваяСтрока.Представление = "Есть интерфейс:";
	НоваяСтрока.Наименование = "Интерфейс";
	НоваяСтрока.ИмяРеквизита = "Значение";

	Возврат ТаблицаОписанияСвойств;
	
КонецФункции

Процедура ПоказатьСвойстваРасширения(ТабДокумент,РасширениеСсылка)Экспорт
	
	Если РасширениеСсылка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементРасширение = ПолучитьЭлементСправочника("Расширения",РасширениеСсылка);
	
	ТаблицаСвойства = Новый ТаблицаЗначений;
	ТаблицаСвойства.Колонки.Добавить("Наименование", ОписаниеТипаСтрока_КонтурEDI(20));
	ТаблицаСвойства.Колонки.Добавить("Значение", 	 ОписаниеТипаСтрока_КонтурEDI(500));
	
	ТаблицаОписанияСвойств = ПолучитьТаблицуСвойстваРасширений();
	Реквизиты = ЭлементРасширение.ДополнительныеРеквизиты;
	
	Для Каждого ОписаниеСвойства Из ТаблицаОписанияСвойств Цикл
		Реквизит = Реквизиты.Найти(ОписаниеСвойства.Наименование,"ИмяРеквизита");
		Если Не Реквизит = Неопределено Тогда
			НовоеСвойство = ТаблицаСвойства.Добавить();
			НовоеСвойство.Наименование 	= ОписаниеСвойства.Представление;
			НовоеСвойство.Значение 		= Строка(Реквизит[ОписаниеСвойства.ИмяРеквизита]);
		КонецЕсли;
	КонецЦикла;
	
	Построитель = Новый ПостроительОтчета(); 
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТаблицаСвойства);
	Построитель.ТекстЗаголовка = "Свойства расширения """ + ЭлементРасширение.Наименование + """"; 
	Построитель.Вывести(ТабДокумент);
	
КонецПроцедуры

Функция ПолучитьМассивСобытийРасширений(Сортировать = Ложь)
	
	Если ДлительнаяОперация = Истина Тогда
		МассивСобытийРасширений = КэшДлительнойОперации.Получить("МассивСобытийРасширений");
		Если НЕ МассивСобытийРасширений = Неопределено Тогда
			Возврат МассивСобытийРасширений;
		КонецЕсли;
	КонецЕсли;
	
	ТаблицаСобытий = СобытияПодключаемогоМодуляРасширений_КонтурEDI();
	
	Если Сортировать Тогда
		ТаблицаСобытий.Сортировать("Имя");
	КонецЕсли;
	
	МассивСобытийРасширений = ТаблицаСобытий.ВыгрузитьКолонку("Имя");
	
	Возврат МассивСобытийРасширений;
	
КонецФункции

Процедура ОтправитьПодготовленноеСообщение(СообщениеСсылка)
		
	СообщениеОбъект = ПолучитьОбъектСообщения(СообщениеСсылка);
	
	МассивСтатусов = Новый Массив;
	МассивСтатусов.Добавить(Врег("Отправлен"));
	МассивСтатусов.Добавить(Врег("Доставлен"));
	
	Если СообщениеОбъект.Заблокирован() ИЛИ МассивСтатусов.Найти(Врег(СообщениеОбъект.Статус)) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		СообщениеОбъект.Заблокировать();
	Исключение
		Возврат;
	КонецПопытки;
	
	Сообщение = ПрочитатьСообщение(СообщениеСсылка,,,"Исходящее");
	РезультатКонвертации = КонвертироватьИсходящееСообщениеПоНовому(Сообщение);
	
	Если НЕ РезультатКонвертации.Успешно Тогда
		СообщениеОбъект.Разблокировать();
		ОповеститьОбОшибках(РезультатКонвертации);
		Возврат;
	КонецЕсли;
	
	РезультатОтправки = ПередатьСообщениеНаСервер(РезультатКонвертации);
	
	Если РезультатОтправки.Успешно = Истина Тогда
		ПослеОтправкиИсходящегоСообщения(Сообщение,РезультатОтправки);
	Иначе
		ОповеститьОбОшибках(РезультатОтправки);
	КонецЕсли;
		
	СообщениеОбъект.Разблокировать();
		
КонецПроцедуры

Функция ОпределитьЗначениеНастройкиГрузополучательИзЮрФизЛицаТД(Партнер) Экспорт
	
	ИмяЗаполняемогоРеквизитаЮрФизЛицомИзТД = ПолучитьЗначениеСвойстваОбъектаEDI(Партнер, "ИмяЗаполняемогоРеквизитаЮрФизЛицомИзТД");
		
	Если Не ЗначениеЗаполнено(ИмяЗаполняемогоРеквизитаЮрФизЛицомИзТД) Или ИмяЗаполняемогоРеквизитаЮрФизЛицомИзТД = "Не выбран" Тогда
		ГрузополучательИзЮрФизЛицаТД = ПараметрыПользователяEDI.ГрузополучательИзЮрФизЛицаТД <> Ложь;
	Иначе 
		ГрузополучательИзЮрФизЛицаТД = ИмяЗаполняемогоРеквизитаЮрФизЛицомИзТД = "Грузополучатель";
	КонецЕсли;
	
	Возврат ГрузополучательИзЮрФизЛицаТД; 
	
КонецФункции

