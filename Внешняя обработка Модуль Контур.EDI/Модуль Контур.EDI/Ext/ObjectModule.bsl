	КонецЕсли;
	
	Возврат ТекстЗапроса;

КонецФункции // УФ_УТ_ПолучитьТекстЗапросаТоваровКорректировкиРеализации()

Функция БП_ПолучитьТекстЗапросаТоваровКорректировкиРеализации(ТипСообщения="COINVOIC",ДокументСсылка)
	
	Если ДокументСсылка.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки 
		И ТипЗнч(ДокументСсылка.ДокументРеализации) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	КорректировкаРеализацииТовары.НомерСтроки,
		               |	КорректировкаРеализацииТовары.Номенклатура,
		               |	Неопределено КАК ХарактеристикаНоменклатуры,
		               |	КорректировкаРеализацииТовары.Номенклатура.БазоваяЕдиницаИзмерения КАК ЕдиницаИзмерения,
		               |	КорректировкаРеализацииТовары.Номенклатура.Наименование КАК Наименование,
		               |	КорректировкаРеализацииТовары.Номенклатура.НаименованиеПолное КАК НаименованиеПолное,
		               |	КорректировкаРеализацииТовары.Цена,
		               |	КорректировкаРеализацииТовары.СтавкаНДС,
		               |	"""" КАК СерияНоменклатуры,
		               |	КорректировкаРеализацииТовары.СтранаПроисхождения КАК Страна,
		               |	ЕСТЬNULL(КорректировкаРеализацииТовары.НомерГТД.Код, ЕСТЬNULL(КорректировкаРеализацииТовары.Номенклатура.НомерГТД.Код, """")) КАК НомерГТД,
		               |	КорректировкаРеализацииТовары.Количество КАК Количество,
		               |	КорректировкаРеализацииТовары.Сумма КАК Сумма,
		               |	КорректировкаРеализацииТовары.СуммаНДС,
		               |	NULL КАК ТипЕдиницы
		               |ИЗ
		               |	Документ.КорректировкаРеализации.Товары КАК КорректировкаРеализацииТовары
		               |ГДЕ
		               |	КорректировкаРеализацииТовары.Ссылка В(&Ссылка)" ;

		
	// корректировочная СФ	
	Иначе
	
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	КорректировкаРеализацииТовары.НомерСтроки,
		               |	КорректировкаРеализацииТовары.Номенклатура,
		               |	Неопределено КАК ХарактеристикаНоменклатуры,
		               |	КорректировкаРеализацииТовары.Номенклатура.БазоваяЕдиницаИзмерения КАК ЕдиницаИзмерения,
		               |	КорректировкаРеализацииТовары.Номенклатура.Наименование КАК Наименование,
		               |	КорректировкаРеализацииТовары.Номенклатура.НаименованиеПолное КАК НаименованиеПолное,
		               |	КорректировкаРеализацииТовары.Цена,
		               |	КорректировкаРеализацииТовары.ЦенаДоКорректировки,
		               |	КорректировкаРеализацииТовары.СтавкаНДС,
		               |	"""" КАК СерияНоменклатуры,
		               |	КорректировкаРеализацииТовары.СтавкаНДС КАК СтавкаНДСДоКорректировки,
		               |	КорректировкаРеализацииТовары.СтранаПроисхождения КАК Страна,
		               |	ЕСТЬNULL(КорректировкаРеализацииТовары.НомерГТД.Код, ЕСТЬNULL(КорректировкаРеализацииТовары.Номенклатура.НомерГТД.Код, """")) КАК НомерГТД,
		               |	КорректировкаРеализацииТовары.Количество,
		               |	КорректировкаРеализацииТовары.КоличествоДоКорректировки,
		               |	КорректировкаРеализацииТовары.Сумма,
		               |	КорректировкаРеализацииТовары.СуммаДоКорректировки,
		               |	КорректировкаРеализацииТовары.СуммаНДС,
		               |	КорректировкаРеализацииТовары.СуммаНДСДоКорректировки
		               |ИЗ
		               |	Документ.КорректировкаРеализации.Товары КАК КорректировкаРеализацииТовары
		               |ГДЕ
		               |	КорректировкаРеализацииТовары.Ссылка В(&Ссылка)" ;
	
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции // УФ_УТ_ПолучитьТекстЗапросаТоваровКорректировкиРеализации()

Функция УФ_УТ_ПолучитьТекстЗапросаТоваровКорректировкиРеализации(ТипСообщения="COINVOIC",ДокументСсылка) 
	
	// исправительная СФ
	Если ТипСообщения="INVOIC" Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	КорректировкаРеализацииТовары.НомерСтроки,
		               |	КорректировкаРеализацииТовары.Номенклатура,
		               |	КорректировкаРеализацииТовары.Характеристика КАК ХарактеристикаНоменклатуры,
		               |	ВЫБОР
					   |		КОГДА КорректировкаРеализацииТовары.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиНоменклатуры.ПустаяСсылка)
					   |			ТОГДА КорректировкаРеализацииТовары.Номенклатура.ЕдиницаИзмерения
					   |		ИНАЧЕ КорректировкаРеализацииТовары.Упаковка
					   |	КОНЕЦ КАК ЕдиницаИзмерения,
		               |	КорректировкаРеализацииТовары.Номенклатура.Наименование КАК Наименование,
		               |	КорректировкаРеализацииТовары.Номенклатура.НаименованиеПолное КАК НаименованиеПолное,
		               |	КорректировкаРеализацииТовары.Цена,
		               |	КорректировкаРеализацииТовары.СтавкаНДС,
		               |	ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка) КАК СерияНоменклатуры,
		               |	ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка) КАК Страна,
		               |	"""" КАК НомерГТД,
		               |	КорректировкаРеализацииТовары.КоличествоУпаковок КАК Количество,
		               |	КорректировкаРеализацииТовары.Сумма КАК Сумма,
		               |	КорректировкаРеализацииТовары.СуммаНДС,
		               |	NULL КАК ТипЕдиницы
		               |ИЗ
		               |	Документ.КорректировкаРеализации.Товары КАК КорректировкаРеализацииТовары
		               |ГДЕ
		               |	КорректировкаРеализацииТовары.Ссылка В(&Ссылка)" ;

		
	// корректировочная СФ	
	Иначе 
	//ТипСообщения="COINVOIC"
	//из-за особенностей варанта хранения данных о корректировке - часть пеолей невозможно вытащить простым запросом. Не будем городить сложный запрос, лучше сделаем детальный обход после извлечения данных
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	КорректировкаРеализацииТовары.НомерСтроки,
		               |	КорректировкаРеализацииТовары.Номенклатура,
		               |	КорректировкаРеализацииТовары.Характеристика КАК ХарактеристикаНоменклатуры,
		               |	ВЫБОР
					   |		КОГДА КорректировкаРеализацииТовары.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиНоменклатуры.ПустаяСсылка)
					   |			ТОГДА КорректировкаРеализацииТовары.Номенклатура.ЕдиницаИзмерения
					   |		ИНАЧЕ КорректировкаРеализацииТовары.Упаковка
					   |	КОНЕЦ КАК ЕдиницаИзмерения,
		               |	КорректировкаРеализацииТовары.Номенклатура.Наименование КАК Наименование,
		               |	КорректировкаРеализацииТовары.Номенклатура.НаименованиеПолное КАК НаименованиеПолное,
		               |	КорректировкаРеализацииТовары.СтавкаНДС,
		               |	ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка) КАК СерияНоменклатуры,
		               |	ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка) КАК Страна,
		               |	"""" КАК НомерГТД,
		               |	КорректировкаРеализацииТовары.КоличествоУпаковок КАК Количество,
		               |	КорректировкаРеализацииТовары.СуммаСНДС КАК Сумма,
		               |	КорректировкаРеализацииТовары.СуммаНДС,
					   |	0 КАК Цена,
					   |	0 КАК ЦенаДоКорректировки,
					   |	0 КАК СтавкаНДСДоКорректировки,
					   |	0 КАК КоличествоДоКорректировки,
					   |	0 КАК СуммаДоКорректировки,
					   |	0 КАК СуммаНДСДоКорректировки
		               |ИЗ
		               |	Документ.КорректировкаРеализации.Расхождения КАК КорректировкаРеализацииТовары
		               |ГДЕ
		               |	КорректировкаРеализацииТовары.Ссылка В(&Ссылка)" ;
	
	КонецЕсли;
	
	Если ОпределитьРелизКонфигурации() = "11.2" Тогда //рефакторинг
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"УпаковкиНоменклатуры","УпаковкиЕдиницыИзмерения");	
	КонецЕсли;
			   
	Возврат ТекстЗапроса;

КонецФункции // УФ_УТ_ПолучитьТекстЗапросаТоваровКорректировкиРеализации()

Функция УФ_УНФ_ТекстЗапросаПоСвязаннымКоррИспрСФ()
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КорректировкаРеализации.ДокументОснование КАК Реализация,
	|	КорректировкаРеализации.Ссылка КАК КорректировкаРеализации,
	|	СчетФактураВыданныйДокументыОснования.Ссылка КАК СчетФактура
	|ИЗ
	|	Документ.КорректировкаРеализации КАК КорректировкаРеализации
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактура.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	|		ПО (СчетФактураВыданныйДокументыОснования.ДокументОснование = КорректировкаРеализации.Ссылка)
	|ГДЕ
	|	КорректировкаРеализации.ДокументОснование В(&ДокументыРеализации)
	|ИТОГИ ПО
	|	Реализация,
	|	КорректировкаРеализации,
	|	СчетФактура";	
	Возврат ТекстЗапроса;
	
КонецФункции // УФ_ТекстЗапросаПоСвязанным()

Функция УФ_УНФ_СформироватьТекстЗапросаДляОтправкиКоррИспрINVOIC()

	Если ЕстьНеобходимыеМетаданные("Документы.СчетФактура.Реквизиты.ДокументОснование") Тогда
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетФактураВыданныйДокумент.Ссылка КАК Документ,
		|	ТаблицаКэшПартнеровКонтрагентов.Партнер КАК Партнер,
		|	ВЫБОР
		|		КОГДА СчетФактураВыданныйДокумент.Исправление = ИСТИНА
		|				И КорректировкаРеализации.ДокументОснование ССЫЛКА Документ.РасходнаяНакладная
		|			ТОГДА ""Отправить счет-фактуру""
		|		ИНАЧЕ ""Отправить корректировочный счет-фактуру""
		|	КОНЕЦ КАК ТребуемоеДействие,
		|	ВЫБОР
		|		КОГДА СчетФактураВыданныйДокумент.Исправление = ИСТИНА                                             
		|				И КорректировкаРеализации.ДокументОснование ССЫЛКА Документ.РасходнаяНакладная
		|			ТОГДА ""INVOIC""
		|		ИНАЧЕ ""COINVOIC""
		|	КОНЕЦ КАК ТипСообщения,
		|	СчетФактура_ИсходнойСФ.Ссылка КАК СчетФактураИсходнойСФ_Ссылка
		|ПОМЕСТИТЬ ВТ_Документы_КоррИспрСФ
		|ИЗ
		|	Документ.КорректировкаРеализации КАК КорректировкаРеализации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаКэшПартнеровКонтрагентов КАК ТаблицаКэшПартнеровКонтрагентов
		|		ПО (ТаблицаКэшПартнеровКонтрагентов.Контрагент = КорректировкаРеализации.Контрагент)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактура КАК СчетФактураВыданныйДокумент
		|		ПО (СчетФактураВыданныйДокумент.ДокументОснование = КорректировкаРеализации.Ссылка)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактура КАК СчетФактура_ИсходнойСФ
		|		ПО (СчетФактура_ИсходнойСФ.ДокументОснование = КорректировкаРеализации.ДокументОснование)
		|ГДЕ
		|	КорректировкаРеализации.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И КорректировкаРеализации.Проведен
		|	И КорректировкаРеализации.ДокументОснование ССЫЛКА Документ.РасходнаяНакладная
		|	И ВЫБОР
		|			КОГДА СчетФактураВыданныйДокумент.Исправление
		|				ТОГДА ТаблицаКэшПартнеровКонтрагентов.INVOIC
		|						И НЕ ТаблицаКэшПартнеровКонтрагентов.НеОтправлять_I_INVOIC
		|			ИНАЧЕ ТаблицаКэшПартнеровКонтрагентов.COINVOIC
		|		КОНЕЦ
		|	И НЕ СчетФактураВыданныйДокумент.ПометкаУдаления
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Партнер,
		|	Документ,
		|	ТипСообщения";
	Иначе
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаКэшПартнеровКонтрагентов.Партнер КАК Партнер,
		|	ВЫБОР
		|		КОГДА СчетФактураВыданныеДокумент.Ссылка.Исправление = ИСТИНА
		|				И КорректировкаРеализации.ДокументОснование ССЫЛКА Документ.РасходнаяНакладная
		|			ТОГДА ""Отправить счет-фактуру""
		|		ИНАЧЕ ""Отправить корректировочный счет-фактуру""
		|	КОНЕЦ КАК ТребуемоеДействие,
		|	ВЫБОР
		|		КОГДА СчетФактураВыданныеДокумент.Ссылка.Исправление = ИСТИНА
		|				И КорректировкаРеализации.ДокументОснование ССЫЛКА Документ.РасходнаяНакладная
		|			ТОГДА ""INVOIC""
		|		ИНАЧЕ ""COINVOIC""
		|	КОНЕЦ КАК ТипСообщения,
		|	СчетФактура_ИсходнойСФ.Ссылка КАК СчетФактураИсходнойСФ_Ссылка,
		|	СчетФактураВыданныеДокумент.Ссылка КАК Документ
		|ПОМЕСТИТЬ ВТ_Документы_КоррИспрСФ
		|ИЗ
		|	Документ.СчетФактура.ДокументыОснования КАК СчетФактура_ИсходнойСФ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации КАК КорректировкаРеализации
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаКэшПартнеровКонтрагентов КАК ТаблицаКэшПартнеровКонтрагентов
		|			ПО (ТаблицаКэшПартнеровКонтрагентов.Контрагент = КорректировкаРеализации.Контрагент)
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактура.ДокументыОснования КАК СчетФактураВыданныеДокумент
		|			ПО (СчетФактураВыданныеДокумент.ДокументОснование = КорректировкаРеализации.Ссылка)
		|		ПО (СчетФактура_ИсходнойСФ.ДокументОснование = КорректировкаРеализации.ДокументОснование)
		|ГДЕ
		|	КорректировкаРеализации.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И КорректировкаРеализации.Проведен
		|	И КорректировкаРеализации.ДокументОснование ССЫЛКА Документ.РасходнаяНакладная
		|	И ВЫБОР
		|			КОГДА СчетФактураВыданныеДокумент.Ссылка.Исправление
		|				ТОГДА ТаблицаКэшПартнеровКонтрагентов.INVOIC
		|						И НЕ ТаблицаКэшПартнеровКонтрагентов.НеОтправлять_I_INVOIC
		|			ИНАЧЕ ТаблицаКэшПартнеровКонтрагентов.COINVOIC
		|		КОНЕЦ
		|	И НЕ СчетФактураВыданныеДокумент.Ссылка.ПометкаУдаления
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Партнер,
		|	ТипСообщения";
	КонецЕсли;
	
	Если НЕ ОснованиеINVOICСчетФактура() Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "СчетФактура_ИсходнойСФ.Ссылка КАК СчетФактураИсходнойСФ_Ссылка", "СчетФактура_ИсходнойСФ.ДокументОснование КАК СчетФактураИсходнойСФ_Ссылка");
	КонецЕсли;
	
	Возврат ТекстЗапроса;

КонецФункции // УФ_УНФ_СформироватьТекстЗапросаДляОтправкиКоррИспрINVOIC()

Функция УФ_УНФ_ПолучитьТекстЗапросаТоваровКорректировкиРеализации(ТипСообщения="COINVOIC",ДокументСсылка)

	// исправительная СФ
	Если ТипСообщения="INVOIC" Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	КорректировкаРеализацииТовары.НомерСтроки КАК НомерСтроки,
		               |	КорректировкаРеализацииТовары.Номенклатура КАК Номенклатура,
		               |	КорректировкаРеализацииТовары.Характеристика КАК ХарактеристикаНоменклатуры,
		               |	КорректировкаРеализацииТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		               |	КорректировкаРеализацииТовары.Номенклатура.Наименование КАК Наименование,
		               |	КорректировкаРеализацииТовары.Номенклатура.НаименованиеПолное КАК НаименованиеПолное,
		               |	КорректировкаРеализацииТовары.Цена КАК Цена,
		               |	КорректировкаРеализацииТовары.СтавкаНДС КАК СтавкаНДС,
		               |	НЕОПРЕДЕЛЕНО КАК СерияНоменклатуры,
		               |	КорректировкаРеализацииТовары.СтранаПроисхождения КАК Страна,
		               |	ЕСТЬNULL(КорректировкаРеализацииТовары.НомерГТД.Код, """") КАК НомерГТД,
		               |	КорректировкаРеализацииТовары.Количество КАК Количество,
		               |	КорректировкаРеализацииТовары.Сумма КАК Сумма,
		               |	КорректировкаРеализацииТовары.СуммаНДС КАК СуммаНДС,
		               |	NULL КАК ТипЕдиницы
		               |ИЗ
		               |	Документ.КорректировкаРеализации.Запасы КАК КорректировкаРеализацииТовары
		               |ГДЕ
		               |	КорректировкаРеализацииТовары.Ссылка В(&Ссылка)" ;

		
	// корректировочная СФ	
	Иначе 
	//ТипСообщения="COINVOIC"
	//из-за особенностей варанта хранения данных о корректировке - часть пеолей невозможно вытащить простым запросом. Не будем городить сложный запрос, лучше сделаем детальный обход после извлечения данных
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	КорректировкаРеализацииТовары.НомерСтроки КАК НомерСтроки,
		               |	КорректировкаРеализацииТовары.Номенклатура КАК Номенклатура,
		               |	КорректировкаРеализацииТовары.Характеристика КАК ХарактеристикаНоменклатуры,
		               |	КорректировкаРеализацииТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		               |	КорректировкаРеализацииТовары.Номенклатура.Наименование КАК Наименование,
		               |	КорректировкаРеализацииТовары.Номенклатура.НаименованиеПолное КАК НаименованиеПолное,
		               |	КорректировкаРеализацииТовары.СтавкаНДС КАК СтавкаНДС,
		               |	НЕОПРЕДЕЛЕНО КАК СерияНоменклатуры,
		               |	КорректировкаРеализацииТовары.СтранаПроисхождения КАК Страна,
		               |	ЕСТЬNULL(КорректировкаРеализацииТовары.НомерГТД.Код, """") КАК НомерГТД,
		               |	КорректировкаРеализацииТовары.Количество КАК Количество,
		               |	КорректировкаРеализацииТовары.Сумма КАК Сумма,
		               |	КорректировкаРеализацииТовары.СуммаНДС КАК СуммаНДС,
		               |	КорректировкаРеализацииТовары.Цена КАК Цена,
		               |	КорректировкаРеализацииТовары.ЦенаДоКорректировки КАК ЦенаДоКорректировки,
		               |	КорректировкаРеализацииТовары.СтавкаНДС КАК СтавкаНДСДоКорректировки,
		               |	КорректировкаРеализацииТовары.КоличествоДоКорректировки КАК КоличествоДоКорректировки,
		               |	КорректировкаРеализацииТовары.СуммаДоКорректировки КАК СуммаДоКорректировки,
		               |	КорректировкаРеализацииТовары.СуммаНДСДоКорректировки КАК СуммаНДСДоКорректировки
		               |ИЗ
		               |	Документ.КорректировкаРеализации.Запасы КАК КорректировкаРеализацииТовары
		               |ГДЕ
		               |	КорректировкаРеализацииТовары.Ссылка В(&Ссылка)" ;
	
	КонецЕсли;
			   
	Возврат ТекстЗапроса;

КонецФункции // УФ_УТ_ПолучитьТекстЗапросаТоваровКорректировкиРеализации()

Функция УФ_УТ_ПолучитьТекстЗапросаТоваровВозвратТоваровОтПокупателя(ДокументСсылка)
		
	ТекстЗапроса = "ВЫБРАТЬ
	               |	докВозвратТоваров.Ссылка КАК Ссылка,
	               |	докВозвратТоваров.МоментВремени КАК МоментВремени,
	               |	докВозвратТоваров.ДокументРеализации КАК ДокументРеализации
	               |ПОМЕСТИТЬ ВТ_ТекущийВозвратТоваров
	               |ИЗ
	               |	Документ.ВозвратТоваровОтКлиента КАК докВозвратТоваров
	               |ГДЕ
	               |	докВозвратТоваров.Ссылка = &Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	докВозвратТоваров.Ссылка,
	               |	докВозвратТоваров.ДокументРеализации,
	               |	докВозвратТоваров.МоментВремени
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПредыдущиеВозвратыТоваров.ДокументРеализации КАК ДокументРеализации,
	               |	ТаблицаТоварыПредыдущихВозвратов.Номенклатура КАК Номенклатура,
	               |	ТаблицаТоварыПредыдущихВозвратов.Характеристика КАК Характеристика,
	               |	СУММА(ТаблицаТоварыПредыдущихВозвратов.Сумма) КАК Сумма,
	               |	СУММА(ВЫБОР
	               |			КОГДА ТаблицаТоварыПредыдущихВозвратов.КоличествоУпаковок = 0
	               |				ТОГДА ТаблицаТоварыПредыдущихВозвратов.Количество
	               |			ИНАЧЕ ТаблицаТоварыПредыдущихВозвратов.КоличествоУпаковок
	               |		КОНЕЦ) КАК Количество,
	               |	СУММА(ТаблицаТоварыПредыдущихВозвратов.СуммаНДС) КАК СуммаНДС
	               |ПОМЕСТИТЬ ВТ_ТоварыПредыдущихВозвратов
	               |ИЗ
	               |	ВТ_ТекущийВозвратТоваров КАК ВТ_ТекущийВозвратТоваров
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВозвратТоваровОтКлиента КАК ПредыдущиеВозвратыТоваров
	               |		ПО ВТ_ТекущийВозвратТоваров.ДокументРеализации = ПредыдущиеВозвратыТоваров.ДокументРеализации
	               |			И ВТ_ТекущийВозвратТоваров.МоментВремени > ПредыдущиеВозвратыТоваров.МоментВремени
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВозвратТоваровОтКлиента.Товары КАК ТаблицаТоварыПредыдущихВозвратов
	               |		ПО (ТаблицаТоварыПредыдущихВозвратов.Ссылка = ПредыдущиеВозвратыТоваров.Ссылка)
	               |ГДЕ
	               |	НЕ ПредыдущиеВозвратыТоваров.ПометкаУдаления
	               |	И ПредыдущиеВозвратыТоваров.Проведен
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПредыдущиеВозвратыТоваров.ДокументРеализации,
	               |	ТаблицаТоварыПредыдущихВозвратов.Номенклатура,
	               |	ТаблицаТоварыПредыдущихВозвратов.Характеристика
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	РеализацияТоваровУслугТовары.Ссылка КАК Ссылка,
	               |	РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура,
	               |	РеализацияТоваровУслугТовары.Характеристика КАК Характеристика,
	               |	ВЫБОР
	               |		КОГДА РеализацияТоваровУслугТовары.КоличествоУпаковок = 0
	               |				И РеализацияТоваровУслугТовары.Количество = 0
	               |			ТОГДА 0
	               |		КОГДА &СуммаВключаетНДС
	               |			ТОГДА РеализацияТоваровУслугТовары.СуммаСНДС / ВЫБОР
	               |					КОГДА РеализацияТоваровУслугТовары.КоличествоУпаковок = 0
	               |						ТОГДА РеализацияТоваровУслугТовары.Количество
	               |					ИНАЧЕ РеализацияТоваровУслугТовары.КоличествоУпаковок
	               |				КОНЕЦ
	               |		ИНАЧЕ (РеализацияТоваровУслугТовары.СуммаСНДС - РеализацияТоваровУслугТовары.СуммаНДС) / ВЫБОР
	               |				КОГДА РеализацияТоваровУслугТовары.КоличествоУпаковок = 0
	               |					ТОГДА РеализацияТоваровУслугТовары.Количество
	               |				ИНАЧЕ РеализацияТоваровУслугТовары.КоличествоУпаковок
	               |			КОНЕЦ
	               |	КОНЕЦ КАК ЦенаДоКорректировки,
	               |	РеализацияТоваровУслугТовары.СтавкаНДС КАК СтавкаНДСДоКорректировки,
	               |	СУММА(ВЫБОР
	               |			КОГДА РеализацияТоваровУслугТовары.КоличествоУпаковок = 0
	               |				ТОГДА РеализацияТоваровУслугТовары.Количество
	               |			ИНАЧЕ РеализацияТоваровУслугТовары.КоличествоУпаковок
	               |		КОНЕЦ) КАК КоличествоДоКорректировки,
	               |	СУММА(ВЫБОР
	               |			КОГДА &СуммаВключаетНДС
	               |				ТОГДА РеализацияТоваровУслугТовары.СуммаСНДС
	               |			ИНАЧЕ РеализацияТоваровУслугТовары.СуммаСНДС - РеализацияТоваровУслугТовары.СуммаНДС
	               |		КОНЕЦ) КАК СуммаДоКорректировки,
	               |	СУММА(РеализацияТоваровУслугТовары.СуммаНДС) КАК СуммаНДСДоКорректировки
	               |ПОМЕСТИТЬ ВТ_ТоварыРеализации
	               |ИЗ
	               |	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТекущийВозвратТоваров КАК ВТ_ТекущийВозвратТоваров
	               |		ПО (ВТ_ТекущийВозвратТоваров.ДокументРеализации = РеализацияТоваровУслугТовары.Ссылка)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РеализацияТоваровУслугТовары.Ссылка,
	               |	РеализацияТоваровУслугТовары.Номенклатура,
	               |	РеализацияТоваровУслугТовары.Характеристика,
	               |	РеализацияТоваровУслугТовары.СтавкаНДС,
	               |	ВЫБОР
	               |		КОГДА РеализацияТоваровУслугТовары.КоличествоУпаковок = 0
	               |				И РеализацияТоваровУслугТовары.Количество = 0
	               |			ТОГДА 0
	               |		КОГДА &СуммаВключаетНДС
	               |			ТОГДА РеализацияТоваровУслугТовары.СуммаСНДС / ВЫБОР
	               |					КОГДА РеализацияТоваровУслугТовары.КоличествоУпаковок = 0
	               |						ТОГДА РеализацияТоваровУслугТовары.Количество
	               |					ИНАЧЕ РеализацияТоваровУслугТовары.КоличествоУпаковок
	               |				КОНЕЦ
	               |		ИНАЧЕ (РеализацияТоваровУслугТовары.СуммаСНДС - РеализацияТоваровУслугТовары.СуммаНДС) / ВЫБОР
	               |				КОГДА РеализацияТоваровУслугТовары.КоличествоУпаковок = 0
	               |					ТОГДА РеализацияТоваровУслугТовары.Количество
	               |				ИНАЧЕ РеализацияТоваровУслугТовары.КоличествоУпаковок
	               |			КОНЕЦ
	               |	КОНЕЦ	
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаТоварыРеализации.Ссылка КАК ДокументРеализации,
	               |	ТаблицаТоварыРеализации.Номенклатура КАК Номенклатура,
	               |	ТаблицаТоварыРеализации.Характеристика КАК Характеристика,
	               |	ТаблицаТоварыРеализации.ЦенаДоКорректировки КАК ЦенаДоКорректировки,
	               |	ТаблицаТоварыРеализации.СтавкаНДСДоКорректировки КАК СтавкаНДСДоКорректировки,
	               |	СУММА(ВЫБОР
	               |			КОГДА ТаблицаТоварыПредыдущихВозвратов.Количество ЕСТЬ NULL
	               |				ТОГДА ТаблицаТоварыРеализации.КоличествоДоКорректировки
	               |			ИНАЧЕ ТаблицаТоварыРеализации.КоличествоДоКорректировки - ТаблицаТоварыПредыдущихВозвратов.Количество
	               |		КОНЕЦ) КАК КоличествоДоКорректировки,
	               |	СУММА(ВЫБОР
	               |			КОГДА ТаблицаТоварыПредыдущихВозвратов.Сумма ЕСТЬ NULL
	               |				ТОГДА ТаблицаТоварыРеализации.СуммаДоКорректировки
	               |			ИНАЧЕ ТаблицаТоварыРеализации.СуммаДоКорректировки - ТаблицаТоварыПредыдущихВозвратов.Сумма
	               |		КОНЕЦ) КАК СуммаДоКорректировки,
	               |	СУММА(ВЫБОР
	               |			КОГДА ТаблицаТоварыПредыдущихВозвратов.СуммаНДС ЕСТЬ NULL
	               |				ТОГДА ТаблицаТоварыРеализации.СуммаНДСДоКорректировки
	               |			ИНАЧЕ ТаблицаТоварыРеализации.СуммаНДСДоКорректировки - ТаблицаТоварыПредыдущихВозвратов.СуммаНДС
	               |		КОНЕЦ) КАК СуммаНДСДоКорректировки
	               |ПОМЕСТИТЬ ВТ_ТоварыПредыдущихДокументов
	               |ИЗ
	               |	ВТ_ТоварыРеализации КАК ТаблицаТоварыРеализации
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТоварыПредыдущихВозвратов КАК ТаблицаТоварыПредыдущихВозвратов
	               |		ПО (ТаблицаТоварыПредыдущихВозвратов.ДокументРеализации = ТаблицаТоварыРеализации.Ссылка)
	               |			И (ТаблицаТоварыПредыдущихВозвратов.Номенклатура = ТаблицаТоварыРеализации.Номенклатура)
	               |			И (ВЫБОР
	               |				КОГДА ТаблицаТоварыПредыдущихВозвратов.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	               |					ТОГДА ИСТИНА
	               |				ИНАЧЕ ТаблицаТоварыПредыдущихВозвратов.Характеристика = ТаблицаТоварыРеализации.Характеристика
	               |			КОНЕЦ)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТаблицаТоварыРеализации.Ссылка,
	               |	ТаблицаТоварыРеализации.Номенклатура,
	               |	ТаблицаТоварыРеализации.Характеристика,
	               |	ТаблицаТоварыРеализации.ЦенаДоКорректировки,
	               |	ТаблицаТоварыРеализации.СтавкаНДСДоКорректировки
	               |;
	               |
	               |//////////////////////////////////////////////////////////////////////////////// 
	               |ВЫБРАТЬ
	               |	ТаблицаТоваровТекущийВозврат.Номенклатура КАК Номенклатура,
	               |	ТаблицаТоваровТекущийВозврат.Характеристика КАК Характеристика,
	               |	ВЫБОР
	               |		КОГДА ТаблицаТоваровТекущийВозврат.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	               |			ТОГДА ТаблицаТоваровТекущийВозврат.Номенклатура.ЕдиницаИзмерения
	               |		ИНАЧЕ ТаблицаТоваровТекущийВозврат.Упаковка
	               |	КОНЕЦ КАК ЕдиницаИзмерения,
	               |	ВЫБОР
	               |		КОГДА ТаблицаТоваровТекущийВозврат.КоличествоУпаковок = 0
	               |			ТОГДА ТаблицаТоваровТекущийВозврат.Количество
	               |		ИНАЧЕ ТаблицаТоваровТекущийВозврат.КоличествоУпаковок
	               |	КОНЕЦ КАК Количество,
	               |	ТаблицаТоваровТекущийВозврат.Сумма КАК Сумма,
	               |	ТаблицаТоваровТекущийВозврат.Цена КАК Цена,
	               |	ТаблицаТоваровТекущийВозврат.СтавкаНДС КАК СтавкаНДС,
	               |	ТаблицаТоваровТекущийВозврат.СуммаНДС КАК СуммаНДС,
	               |	ВТ_ТекущийВозвратТоваров.ДокументРеализации КАК ДокументРеализации
	               |ПОМЕСТИТЬ ВТ_ТоварыТекущегоВозврата
	               |ИЗ
