Функция ОбъектХраненияНастроекСервисОбновлений()
	
	ОбъектВиртуальногоСправочника = Неопределено;
	ИмяВиртуальногоСправочника = "НастройкиСервисОбновлений";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	КонтурEDI_ДополнительныеСправочники.Ссылка Как Ссылка
				|ИЗ
				|	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
				|ГДЕ
				| КонтурEDI_ДополнительныеСправочники.ИмяСправочника = &ИмяСправочника";
			
	Запрос.УстановитьПараметр("ИмяСправочника", ИмяВиртуальногоСправочника);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		ОбъектВиртуальногоСправочника = Справочники.КонтурEDI_ДополнительныеСправочники.СоздатьЭлемент();
		ОбъектВиртуальногоСправочника.Наименование 		= "Настройки сервис обновлений (служебный)";
		ОбъектВиртуальногоСправочника.ИмяСправочника 	= ИмяВиртуальногоСправочника;
	Иначе
		ПерваяСтрокаЗапроса = Результат.Выгрузить()[0];	
		ОбъектВиртуальногоСправочника = ПерваяСтрокаЗапроса.Ссылка.ПолучитьОбъект();	
	КонецЕсли; 
	
	Возврат ОбъектВиртуальногоСправочника;
	
КонецФункции

Процедура ЗаписатьКлючДоступаКлиентаСервисОбновлений(ИмяПродукта, КлючДоступаКлиента)
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	ОбъектХраненияНастроек = ОбъектХраненияНастроекСервисОбновлений();
	ДопРеквизиты = ОбъектХраненияНастроек.ДополнительныеРеквизиты;
	
	ИмяРеквизита = КонтурСтандарт_СтрШаблон_("КлючДоступа_%1", ИмяПродукта);		
	
	НайденнаяСтрока = ДопРеквизиты.Найти(ИмяРеквизита, "ИмяРеквизита");
	
	Если НайденнаяСтрока = Неопределено Тогда
		НайденнаяСтрока = ДопРеквизиты.Добавить();
		НайденнаяСтрока.ИмяРеквизита = ИмяРеквизита;
	КонецЕсли; 
	
	НайденнаяСтрока.ЗначениеХранилищеЗначения = Новый ХранилищеЗначения(КлючДоступаКлиента);
	
	ОбъектХраненияНастроек.Записать();
	
КонецПроцедуры 

Функция КлючДоступаКлиентаСервисОбновлений(ИмяПродукта)
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	КлючДоступа = "";
	
	ОбъектХраненияНастроек = ОбъектХраненияНастроекСервисОбновлений();
	ДопРеквизиты = ОбъектХраненияНастроек.ДополнительныеРеквизиты; 
	
	ИмяРеквизита = КонтурСтандарт_СтрШаблон_("КлючДоступа_%1", ИмяПродукта);
	НайденнаяСтрока = ДопРеквизиты.Найти(ИмяРеквизита, "ИмяРеквизита");
	Если НайденнаяСтрока <> Неопределено Тогда
		КлючДоступа = НайденнаяСтрока.ЗначениеХранилищеЗначения.Получить();
		Если КлючДоступа = Неопределено Тогда
			КлючДоступа = "";
		КонецЕсли;	
	КонецЕсли;
	
	Возврат КлючДоступа;
	
КонецФункции

