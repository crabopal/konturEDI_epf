	Если Результат = Неопределено Тогда
		
		//переинициализируем кэш
		Результат = ПолучитьВеткуСКДИзШаблонаЗапросов();
		
		ЭДО_Кэш_Поместить("КэшШаблоновЗапросов", Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

