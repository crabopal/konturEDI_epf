Функция ХранилищеСессий_ПроверитьДоступ(Пользователь)
	
	Если Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь().Имя Тогда
		Результат = Истина;
	Иначе
		// BSLLS:SetPrivilegedMode-off
		УстановитьПривилегированныйРежим(Истина);
		// BSLLS:SetPrivilegedMode-on
		Результат = ПравоДоступа("АдминистрированиеДанных", Метаданные);
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат Результат;
			
КонецФункции

