Функция КлиентСервисОбновлений_СоздатьИзменитьНастройкиБазы(Настройки) Экспорт
	
	МенеджерНастроек = КлиентСервисОбновлений_МенеджерНастроек();
	
	ПараметрыСервиса = КлиентСервисОбновлений_CreateUpdateCustomerProductSetting(МенеджерНастроек.ИмяПродукта, МенеджерНастроек.ИдентификаторИБ, МенеджерНастроек.ТестовоеОкружение);
	
	ТелоЗапроса = КлиентСервисОбновлений_Привести("CustomerProductSettingsListPostRequest");
	
	Для Каждого ТекНастройка Из Настройки Цикл

		МодельНастройка = КлиентСервисОбновлений_Привести("CustomerProductSettingPostRequest");
		
		МодельНастройка.key   =	ТекНастройка.Ключ;
		МодельНастройка.value =	ТекНастройка.Значение;
		
		ТелоЗапроса.settings.Добавить(МодельНастройка);
		
	КонецЦикла;
	
	Ответ = КлиентСервисОбновлений_PostJson(ПараметрыСервиса.URL, ТелоЗапроса, МенеджерНастроек.Сессия, "CreateUpdateCustomerProductSetting"); 
		
	ПодготовленныйОтветКлиента = КлиентСервисОбновлений_ОбработатьРезультатHTTPЗапроса(ПараметрыСервиса, Ответ);	
	
	Если НЕ ПодготовленныйОтветКлиента.Успешно Тогда
		КлиентСервисОбновлений_ТелоОписаниеОшибки(Ответ, ПодготовленныйОтветКлиента.ОписаниеОшибки); 		
	КонецЕсли;

	Возврат КлиентСервисОбновлений_Привести("CustomerProductSettingsListUpdateResponse", ПодготовленныйОтветКлиента.Результат); 
	
КонецФункции

Функция КлиентСервисОбновлений_УдалитьНастройкуБазы(ИдентификаторНастройки) Экспорт
	
	МенеджерНастроек = КлиентСервисОбновлений_МенеджерНастроек();
	
	ПараметрыСервиса = КлиентСервисОбновлений_DeleteCustomerProductSetting(МенеджерНастроек.ИмяПродукта, МенеджерНастроек.ИдентификаторИБ, ИдентификаторНастройки, МенеджерНастроек.ТестовоеОкружение);
	
	ПараметрыСервиса.Параметры.key = ИдентификаторНастройки; 
	
	КлиентСервисОбновлений_УдалитьПустыеПараметры(ПараметрыСервиса.Параметры);
	
	ДополнительныеПараметры = Новый Структура("ПараметрыЗапроса", ПараметрыСервиса.Параметры); 
	
	Ответ = КлиентHTTP_Delete(ПараметрыСервиса.URL, ,ДополнительныеПараметры , МенеджерНастроек.Сессия);
	
	ПодготовленныйОтветКлиента = КлиентСервисОбновлений_ОбработатьРезультатHTTPЗапроса(ПараметрыСервиса, Ответ);	
	
	Если НЕ ПодготовленныйОтветКлиента.Успешно Тогда
		КлиентСервисОбновлений_ТелоОписаниеОшибки(Ответ, ПодготовленныйОтветКлиента.ОписаниеОшибки); 		
	КонецЕсли;
	
	Возврат Истина; 
	
КонецФункции

Функция КлиентСервисОбновлений_СписокПлагинов(ТипПлагина = Неопределено, Количество = Неопределено, ХешРодителя = Неопределено, МенеджерНастроек = Неопределено) Экспорт
	
	Если МенеджерНастроек = Неопределено Тогда
		МенеджерНастроек = КлиентСервисОбновлений_МенеджерНастроек();
	КонецЕсли;
	
	КлиентСервисОбновлений_УстановитьЗаголовокАвторизации(МенеджерНастроек);
	
	ПараметрыСервиса = КлиентСервисОбновлений_GetPlugins(МенеджерНастроек.ИмяПродукта, МенеджерНастроек.ИдентификаторИБ, МенеджерНастроек.ТестовоеОкружение);
	
	Если ТипПлагина <> Неопределено Тогда
		ПараметрыСервиса.Параметры.plugin_type  = ТипПлагина;	
	КонецЕсли;
	
	Если Количество <> Неопределено Тогда
		ПараметрыСервиса.Параметры.count 		= Количество;	
	КонецЕсли;
	
	Если ХешРодителя <> Неопределено Тогда
		ПараметрыСервиса.Параметры.parent_md5hash = ХешРодителя;	
	КонецЕсли;
  
	ПараметрыСервиса.Параметры.order 		= "updated desc";

	
	КлиентСервисОбновлений_УдалитьПустыеПараметры(ПараметрыСервиса.Параметры);
	
	Ответ = КлиентHTTP_Get(ПараметрыСервиса.URL, ПараметрыСервиса.Параметры , , МенеджерНастроек.Сессия);
	
	ПодготовленныйОтветКлиента = КлиентСервисОбновлений_ОбработатьРезультатHTTPЗапроса(ПараметрыСервиса, Ответ);	
	
	Если НЕ ПодготовленныйОтветКлиента.Успешно Тогда
		КлиентСервисОбновлений_ТелоОписаниеОшибки(Ответ, ПодготовленныйОтветКлиента.ОписаниеОшибки); 		
	КонецЕсли;
		
	Возврат КлиентСервисОбновлений_Привести("PluginsGetResponseV4", ПодготовленныйОтветКлиента.Результат);
		
КонецФункции 

