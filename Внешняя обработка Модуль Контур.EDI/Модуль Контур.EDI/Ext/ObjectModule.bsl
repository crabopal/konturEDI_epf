КонецФункции 

Функция МожноПолучитьСвойствоИзКэшаДлительнойОперации(ИмяСвойства)
	
	 СписокИсключенийОсновныхСвойств = СписокИсключенийОсновныхСвойствОбъектовEDI();
	 
	 Возврат (СписокИсключенийОсновныхСвойств.Найти(ИмяСвойства) = Неопределено)
	
КонецФункции

Функция СписокИсключенийОсновныхСвойствОбъектовEDI()

	СписокСвойств = Новый Массив();
	
	СписокСвойств.Добавить("НомерПоследнейУпаковкиSSCC");
	СписокСвойств.Добавить("ПоследнийSSCCКод");
	
	Возврат СписокСвойств;

КонецФункции

Процедура УстановитьОбъектПоЗначениюСвойстваВКэшДлительнойОперации(Объект, ИмяСвойства, Знач Значение)
	
	Если Не ДлительнаяОперация = Истина ИЛИ Не МожноПолучитьСвойствоИзКэшаДлительнойОперации(ИмяСвойства) Тогда
		Возврат;
	КонецЕсли;
	
	ОсновныеСвойстваОбъектов = КэшДлительнойОперации.Получить("КэшСвойствОбъектов");
	
	Если ОсновныеСвойстваОбъектов = Неопределено Тогда
		ОсновныеСвойстваОбъектов = ТаблицаОсновныхСвойствОбъектов_КонтурEDI();
		КэшДлительнойОперации.Вставить("КэшСвойствОбъектов", ОсновныеСвойстваОбъектов);
	КонецЕсли;
	
	НайденныеСвойстваОбъектов = ОсновныеСвойстваОбъектов.НайтиСтроки(Новый Структура("ИмяСвойства,Значение", ИмяСвойства, Значение));
	
	Если НайденныеСвойстваОбъектов.Количество() > 0 Тогда	
		ЗначениеСвойстваОбъекта = НайденныеСвойстваОбъектов[0];
	Иначе
		ЗначениеСвойстваОбъекта = ОсновныеСвойстваОбъектов.Добавить();
		
		ЗначениеСвойстваОбъекта.ИмяСвойства = ИмяСвойства;
		ЗначениеСвойстваОбъекта.Значение = Значение;
	КонецЕсли;
	
	ЗначениеСвойстваОбъекта.Объект = Объект;
	
	КэшДлительнойОперации.Вставить("КэшСвойствОбъектов", ОсновныеСвойстваОбъектов);
	
КонецПроцедуры

Функция ПолучитьЗначениеСвойстваОбъектаEDI(Объект, ИмяСвойства) Экспорт
	
	Если НЕ ЕстьОбъектыХраненияДанных_КонтурEDI() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	МожноПолучитьСвойствоИзКэша = МожноПолучитьСвойствоИзКэшаДлительнойОперации(ИмяСвойства); 
	
	Если ДлительнаяОперация = Истина 
		И МожноПолучитьСвойствоИзКэша Тогда
		
		ТаблицаСвойствОбъектов = КэшДлительнойОперации.Получить("КэшСвойствОбъектов");
		Если ТаблицаСвойствОбъектов = Неопределено Тогда
			
			ТаблицаСвойствОбъектов = ТаблицаОсновныхСвойствОбъектов_КонтурEDI();
						
			КэшДлительнойОперации.Вставить("КэшСвойствОбъектов",ТаблицаСвойствОбъектов);
			
		КонецЕсли;
		
		НайденныеСтроки = ТаблицаСвойствОбъектов.НайтиСтроки(Новый Структура("Объект,ИмяСвойства",Объект,ИмяСвойства));
		Если НайденныеСтроки.Количество()>0 Тогда
			Возврат НайденныеСтроки[0].Значение;
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	//+ Костыль для длинных токенов
	Если ИмяСвойства="Токен" Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтурEDI_ДополнительныеРеквизиты.Значение
		|ИЗ
		|	РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеРеквизиты
		|ГДЕ
		|	(КонтурEDI_ДополнительныеРеквизиты.Свойство = ""Токен_01""
		|			ИЛИ КонтурEDI_ДополнительныеРеквизиты.Свойство = ""Токен_02"")
		|	И КонтурEDI_ДополнительныеРеквизиты.Объект = &Объект
		|
		|УПОРЯДОЧИТЬ ПО
		|	КонтурEDI_ДополнительныеРеквизиты.Свойство";
		
		Запрос.УстановитьПараметр("Свойство",	ИмяСвойства);
		Запрос.УстановитьПараметр("Объект",		Объект);
		
		Значение = "";
		ТабЗапроса = Запрос.Выполнить().Выгрузить();
		Для Каждого СтрокаРезультата Из ТабЗапроса Цикл
			Значение=Значение+СокрЛП(СтрокаРезультата.Значение);
		КонецЦикла;	
		
		Возврат Значение;
				
	КонецЕсли;	

	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	КонтурEDI_ДополнительныеРеквизиты.Значение,
	|	КонтурEDI_ДополнительныеРеквизиты.ЗначениеСтрока
	|ИЗ
	|	РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеРеквизиты
	|ГДЕ
	|	КонтурEDI_ДополнительныеРеквизиты.Свойство = &Свойство
	|	И КонтурEDI_ДополнительныеРеквизиты.Объект = &Объект";
	
	Если НЕ ЕстьМетаданныеХраненияОрганизации = Истина Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"КонтурEDI_ДополнительныеРеквизиты.ЗначениеСтрока",""""" КАК ЗначениеСтрока");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Свойство",	ИмяСвойства);
	Запрос.УстановитьПараметр("Объект",		Объект);
	
	ТекЗначение = Неопределено;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		ТекЗначение = Выборка.Значение;

	КонецЕсли;
	
	Если ИмяСвойства = "ПарольУчетнойЗаписи" Тогда
		
		ДопРеквизит = Объект.ДополнительныеРеквизиты.Найти("Пароль", "ИмяРеквизита"); 
		
		Если ДопРеквизит <> Неопределено Тогда
			ЗначениеИзХранилища = ДопРеквизит.ЗначениеХранилищеЗначения.Получить();
			
			ТекЗначение = ЗначениеИзХранилища;
		КонецЕсли;
	КонецЕсли;
	
	Если ДлительнаяОперация = Истина
		И МожноПолучитьСвойствоИзКэша Тогда
		
		НоваяСтрока = ТаблицаСвойствОбъектов.Добавить();
		
		НоваяСтрока.Объект = Объект;
		НоваяСтрока.ИмяСвойства = ИмяСвойства;
		НоваяСтрока.Значение = ТекЗначение;
		
		КэшДлительнойОперации.Вставить("КэшСвойствОбъектов", ТаблицаСвойствОбъектов);
		
	КонецЕсли;
	
	Возврат ТекЗначение;
	
КонецФункции

Функция НайтиОбъектПоЗначениюСвойства(ИмяСвойства, Знач Значение, Партнер = Неопределено) Экспорт 
	
	МожноПолучитьСвойствоИзКэша = МожноПолучитьСвойствоИзКэшаДлительнойОперации(ИмяСвойства);
	
	Если ДлительнаяОперация = Истина
		И МожноПолучитьСвойствоИзКэша Тогда
		
		ТаблицаОбъектов = КэшДлительнойОперации.Получить("КэшСвойствОбъектов");
		Если ТаблицаОбъектов = Неопределено Тогда
			
			ТаблицаОбъектов = ТаблицаОсновныхСвойствОбъектов_КонтурEDI();
			
			КэшДлительнойОперации.Вставить("КэшСвойствОбъектов", ТаблицаОбъектов);
			
		КонецЕсли;
		
		НайденныеСтроки = ТаблицаОбъектов.НайтиСтроки(Новый Структура("ИмяСвойства,Значение",ИмяСвойства,Значение));
		Если НайденныеСтроки.Количество()>0 Тогда
			Возврат НайденныеСтроки[0].Объект;
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
		
	Если ИмяСвойства = "GLN_ТочкиДоставки" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	КонтурEDI_ТочкиДоставки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурEDI_ТочкиДоставки КАК КонтурEDI_ТочкиДоставки
		|ГДЕ
		|	КонтурEDI_ТочкиДоставки.GLN = &GLN";
		
		Запрос.УстановитьПараметр("GLN", Значение);	

	ИначеЕсли ИмяСвойства = "ЮрФизЛицо_ТочкиДоставки" 
		  ИЛИ ИмяСвойства = "СвойСправочник_ТочкиДоставки" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	КонтурEDI_ТочкиДоставки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурEDI_ТочкиДоставки КАК КонтурEDI_ТочкиДоставки
		|ГДЕ
		|	КонтурEDI_ТочкиДоставки.СвязанныйСправочник1 = &ЮрФизЛицо";
					   
		Запрос.УстановитьПараметр("ЮрФизЛицо", Значение);	
		
		Если ИмяСвойства = "СвойСправочник_ТочкиДоставки" Тогда
			Запрос.Текст=СтрЗаменить(Запрос.Текст,"СвязанныйСправочник1","СвязанныйСправочник2");//Для своего справочника точек доставки используется второй слот
			Если ЗначениеЗаполнено(Партнер) Тогда 
				Запрос.Текст = Запрос.Текст + " И КонтурEDI_ТочкиДоставки.Партнер = &Партнер";
				Запрос.УстановитьПараметр("Партнер",Партнер);  
			КонецЕсли;
		КонецЕсли;

	ИначеЕсли ИмяСвойства = "GLN_Партнера" Тогда
		
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Возврат Неопределено;	
		КонецЕсли;
				
		//У партнеров могут быть GLN-синонимы
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	КонтурEDI_ДополнительныеРеквизиты.Объект КАК Ссылка
		|ИЗ
		|	РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеРеквизиты
		|ГДЕ
		|	(КонтурEDI_ДополнительныеРеквизиты.Свойство = ""GLN_Партнера""
		|				И КонтурEDI_ДополнительныеРеквизиты.Значение = &Значение
		|			ИЛИ КонтурEDI_ДополнительныеРеквизиты.Свойство = ""GLN_Партнера_Синонимы""
		|				И КонтурEDI_ДополнительныеРеквизиты.Значение ПОДОБНО &Синоним)";
		
		Запрос.УстановитьПараметр("Значение", Значение);
		Запрос.УстановитьПараметр("Синоним", "%"+Значение+"%");
		
	ИначеЕсли ИмяСвойства = "GLN_Организации" Тогда
		
		//У наших юр.лиц тоже могут быть GLN-синонимы
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	КонтурEDI_ДополнительныеРеквизиты.Объект КАК Ссылка
		|ИЗ
		|	РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеРеквизиты
		|ГДЕ
		|	(КонтурEDI_ДополнительныеРеквизиты.Свойство = ""GLN_Организации""
		|				И КонтурEDI_ДополнительныеРеквизиты.Значение = &Значение
		|			ИЛИ КонтурEDI_ДополнительныеРеквизиты.Свойство = ""GLN_Организации_Синонимы""
		|				И КонтурEDI_ДополнительныеРеквизиты.Значение ПОДОБНО &Синоним)";
		
		Запрос.УстановитьПараметр("Значение", Значение);
		Запрос.УстановитьПараметр("Синоним", "%"+Значение+"%");
					
	Иначе

		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	КонтурEDI_ДополнительныеРеквизиты.Объект КАК Ссылка
		|ИЗ
		|	РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеРеквизиты
		|ГДЕ
		|	КонтурEDI_ДополнительныеРеквизиты.Свойство = &Свойство
		|	И КонтурEDI_ДополнительныеРеквизиты.Значение = &Значение";
		
		Запрос.УстановитьПараметр("Свойство", ИмяСвойства);
		Запрос.УстановитьПараметр("Значение", Значение);
		
	КонецЕсли;
			
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		НайденныйОбъект = Неопределено;
		
	Иначе
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		НайденныйОбъект = Выборка.Ссылка;
		
	КонецЕсли;
			
	Если ДлительнаяОперация = Истина
		И МожноПолучитьСвойствоИзКэша Тогда
		
		НоваяСтрока = ТаблицаОбъектов.Добавить();
		
		НоваяСтрока.Объект = НайденныйОбъект;
		НоваяСтрока.ИмяСвойства = ИмяСвойства;
		НоваяСтрока.Значение = Значение;
		
		КэшДлительнойОперации.Вставить("КэшСвойствОбъектов", ТаблицаОбъектов);
		
	КонецЕсли;
	
	Возврат НайденныйОбъект;
	
КонецФункции

Функция УстановитьЗначениеСвойстваОбъекта(Объект, ИмяСвойства,Знач Значение,Отказ = Ложь) Экспорт 

	//+ Костыль для длинных токенов
	//в будущем убрать
	Если ИмяСвойства = "Токен" Тогда
		//Разбить токен на 2 части по 255 байт
		//Пока предполагаем, что в 510 байт он уложится
		//Каждую часть записать отдельно - можно этой же функцией
		
		УстановитьЗначениеСвойстваОбъекта(Объект,"Токен_01",Лев(Значение,255));
		УстановитьЗначениеСвойстваОбъекта(Объект,"Токен_02",Сред(Значение,256));
		
	ИначеЕсли ИмяСвойства = "ПарольУчетнойЗаписи" Тогда
		
		СправочникОбъект = Объект.ПолучитьОбъект();
		
		ДопРеквизит = ПолучитьСтрокуРеквизитаДопСправочника_КонтурEDI(СправочникОбъект, "Пароль");
		ДопРеквизит.ЗначениеХранилищеЗначения = Новый ХранилищеЗначения(Значение, Новый СжатиеДанных(9));
		
		Попытка
			СправочникОбъект.Записать();
		Исключение
			Сообщить_КонтурEDI(ОписаниеОшибки());
			Отказ = Истина;
		КонецПопытки;
		
	Иначе
		
		ЗначениеНеограниченнаяСтрока = "";
		
		Если ТипЗнч(Значение) = Тип("Строка") Тогда
			Если СтрДлина(Значение)>255 Тогда
				ЗначениеНеограниченнаяСтрока = Значение;
				Значение = "";
			КонецЕсли;
		КонецЕсли;
		
		Запись = РегистрыСведений.КонтурEDI_ДополнительныеРеквизиты.СоздатьМенеджерЗаписи();
		
		Запись.Объект			= Объект;
		Запись.Свойство			= ИмяСвойства;
		Запись.Значение			= Значение;
		
		Если ЕстьМетаданныеХраненияОрганизации = Истина Тогда
			Запись.ЗначениеСтрока = ЗначениеНеограниченнаяСтрока;
		КонецЕсли;	
		
		Попытка
			Запись.Записать();
		Исключение
			Сообщить_КонтурEDI(ОписаниеОшибки());
			Отказ = Истина;
		КонецПопытки;
		
	КонецЕсли;	
	
	Если Отказ = Истина Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

Процедура УдалитьЗначениеСвойстваОбъекта(Объект, ИмяСвойства, Отказ = Ложь) Экспорт 

		
	Запись = РегистрыСведений.КонтурEDI_ДополнительныеРеквизиты.СоздатьМенеджерЗаписи();
	Запись.Объект	= Объект;
	
	Запись.Свойство = ИмяСвойства;
	
	Попытка
		Запись.Прочитать();
		Запись.Удалить();
	Исключение
		Сообщить_КонтурEDI(ОписаниеОшибки());
		Отказ = Истина;
	КонецПопытки;
	
КонецПроцедуры

//оставлено для совместимости со старыми ПМ, не рекомендуется к использованию
Процедура УстановитьГлобальноеСвойство(ИмяСвойства,Значение) Экспорт
	
	УстановитьЗначениеСвойстваОбъекта(Неопределено,ИмяСвойства,Значение);
	
КонецПроцедуры

//оставлено для совместимости со старыми ПМ, не рекомендуется к использованию
Функция ПолучитьГлобальноеСвойство(ИмяСвойства) Экспорт
	Возврат ПолучитьЗначениеСвойстваОбъектаEDI(Неопределено,ИмяСвойства);
КонецФункции

//Ускорение функции получитьЗначениеСвойстваОбъекта
Функция ПолучитьСписокСвойствEDI(Свойства, Объект = Неопределено) Экспорт
	
	МассивСвойств = Новый Массив;
	Если ТипЗнч(Свойства) = Тип("Строка") Тогда
		МассивСвойств = EDI_РазложитьСтрокуВМассивСлов(Свойства,"," + Символы.ПС);		
	Иначе
		МассивСвойств = Свойства;
	КонецЕсли;
	
	Результат = Новый Структура;
	Для Каждого Свойство из МассивСвойств Цикл
		Результат.Вставить(Свойство);
	КонецЦикла;	
	
	Если НЕ ЕстьОбъектыХраненияДанных_КонтурEDI() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ДлительнаяОперация = Истина Тогда
		
		ТаблицаСвойствОбъектов = КэшДлительнойОперации.Получить("КэшСвойствОбъектов");
		
		Если ТаблицаСвойствОбъектов = Неопределено Тогда
			
			ТаблицаСвойствОбъектов = ТаблицаОсновныхСвойствОбъектов_КонтурEDI();
			
			КэшДлительнойОперации.Вставить("КэшСвойствОбъектов", ТаблицаСвойствОбъектов);
			
		КонецЕсли;
		
		НайденныеСвойстваПоОбъекту = 
		ТаблицаСвойствОбъектов.НайтиСтроки(Новый Структура("Объект", Объект));
		
		Для Каждого ЗначенияСвойств Из НайденныеСвойстваПоОбъекту Цикл
			//... проверим является ли строка ИмяСвойства корректными для структуры
			Попытка
				ЕстьКорректноеСвойство =  Результат.Свойство(ЗначенияСвойств.ИмяСвойства);
			Исключение
				Продолжить;
			КонецПопытки;

			Если ЕстьКорректноеСвойство 
				И МожноПолучитьСвойствоИзКэшаДлительнойОперации(ЗначенияСвойств.ИмяСвойства) Тогда
				
				Результат.Вставить(ЗначенияСвойств.ИмяСвойства, ЗначенияСвойств.Значение);
				
				ИндексВМассиве = МассивСвойств.Найти(ЗначенияСвойств.ИмяСвойства);
				
				Если ИндексВМассиве <> Неопределено Тогда
					МассивСвойств.Удалить(ИндексВМассиве);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла; 
		
		Если МассивСвойств.Количество() = 0 Тогда
			Возврат Результат;
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_ДополнительныеРеквизиты.Свойство КАК Свойство,
	|	КонтурEDI_ДополнительныеРеквизиты.Значение КАК Значение,
	|	КонтурEDI_ДополнительныеРеквизиты.ЗначениеСтрока
	|ИЗ
	|	РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеРеквизиты
	|ГДЕ
	|	КонтурEDI_ДополнительныеРеквизиты.Свойство В (&Свойства)
	|	И КонтурEDI_ДополнительныеРеквизиты.Объект = &Объект";
	
	Если НЕ ЕстьМетаданныеХраненияОрганизации = Истина Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"КонтурEDI_ДополнительныеРеквизиты.ЗначениеСтрока",""""" КАК ЗначениеСтрока");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Свойства",	МассивСвойств);
	Запрос.УстановитьПараметр("Объект",		Объект);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Значение = ПреобразоватьСохраненноеЗначение(Выборка.Значение, Выборка.ЗначениеСтрока);
		
		Результат[Выборка.Свойство] = Значение;
		
		Если ДлительнаяОперация = Истина 
			И МожноПолучитьСвойствоИзКэшаДлительнойОперации(Выборка.Свойство) Тогда
			
			НоваяСтрока = ТаблицаСвойствОбъектов.Добавить();
			
			НоваяСтрока.Объект = Объект;
			НоваяСтрока.ИмяСвойства = Выборка.Свойство;
			НоваяСтрока.Значение =  Значение;
			
		КонецЕсли;
		
	КонецЦикла;	
	
	Если Результат.Свойство("ПарольУчетнойЗаписи") Тогда
		
		Пароль = ПолучитьЗначениеСвойстваОбъектаEDI(Объект, "ПарольУчетнойЗаписи");
		
		Если Пароль <> Неопределено Тогда
			Результат["ПарольУчетнойЗаписи"] = Пароль;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДлительнаяОперация = Истина Тогда
		
		КэшДлительнойОперации.Вставить("КэшСвойствОбъектов", ТаблицаСвойствОбъектов);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	

// Функция - Возвращает значения свойств объектов EDI из регистра КонтурEDI_ДополнительныеРеквизиты
//
// Параметры:
//  Свойства - Строка,Массив - Список идентификаторов свойств объектов
//  Объекты	 - Массив,Произвольный - Список объектов по которому необходимо получить значения свойств
// 
// Возвращаемое значение:
//  Соответствие - Ключ - переданный объект, Значение - структура (Идентификатор свойства - Значение). Если свойство у объекта не задано, то в структуре будет Неопределено.
//
Функция ПолучитьЗначенияСвойствОбъектовEDI(Свойства, Объекты) Экспорт
	
	МассивСвойств = Новый Массив;
	Если ТипЗнч(Свойства) = Тип("Строка") Тогда
		МассивСвойств = EDI_РазложитьСтрокуВМассивСлов(Свойства,"," + Символы.ПС);
	Иначе
		МассивСвойств = Свойства;
	КонецЕсли;
	
	МассивОбъектов = Новый Массив;
	Если Не ТипЗнч(Объекты) = Тип("Массив") Тогда
		МассивОбъектов.Добавить(Объекты);
	Иначе
		МассивОбъектов = Объекты;
	КонецЕсли;
	
	СтруктураСвойств = Новый Структура;
	Для каждого Свойство Из МассивСвойств Цикл
		СтруктураСвойств.Вставить(Свойство);
	КонецЦикла;
	
	ЗначенияСвойствОбъектов = Новый Соответствие;
	Для каждого Объект Из МассивОбъектов Цикл
		НезаполненныеСвойства = ПолучитьКопиюСтруктуры(СтруктураСвойств);
		ЗначенияСвойствОбъектов.Вставить(Объект, НезаполненныеСвойства);
	КонецЦикла;
	
	Запрос = ИнициализироватьЗапрос_КонтурEDI();
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КонтурEDI_ДополнительныеРеквизиты.Объект КАК Объект,
	               |	КонтурEDI_ДополнительныеРеквизиты.Свойство,
	               |	КонтурEDI_ДополнительныеРеквизиты.Значение
	               |ИЗ
	               |	РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеРеквизиты
	               |ГДЕ
	               |	КонтурEDI_ДополнительныеРеквизиты.Объект В(&Объекты)
	               |	И КонтурEDI_ДополнительныеРеквизиты.Свойство В(&Свойства)
	               |ИТОГИ ПО
	               |	Объект";
	Запрос.УстановитьПараметр("Объекты", МассивОбъектов);
	Запрос.УстановитьПараметр("Свойства", МассивСвойств);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат ЗначенияСвойствОбъектов;
	КонецЕсли;
	
	ВыборкаОбъекты = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаОбъекты.Следующий() Цикл
		
		ЗначенияСвойств = ЗначенияСвойствОбъектов[ВыборкаОбъекты.Объект];
		
		ВыборкаСвойства = ВыборкаОбъекты.Выбрать();
		Пока ВыборкаСвойства.Следующий() Цикл
			ЗначенияСвойств[ВыборкаСвойства.Свойство] = ВыборкаСвойства.Значение;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ЗначенияСвойствОбъектов;
	
КонецФункции

//сохраняет внешний файл в базу. ИмяФайлаНаДиске - полный путь к файлу. 
//ИмяФайлаВБазе - имя, по которому потом этот файл можно из базы извлечь
//возвращает Истина, если сохранение удалось, иначе - Ложь.
Функция СохранитьФайлВБазу(ИмяФайлаНаДиске,ИмяФайлаВБазе) Экспорт
	Синоним = Метаданные.Синоним;
	ИмяСохраненнойНастройки = ИмяФайлаВБазе;
	Хранилище = Новый ХранилищеЗначения(Новый ДвоичныеДанные(ИмяФайлаНаДиске));
	
	Если Найти(Синоним, "ТКПТ") > 0 
		ИЛИ Найти(Синоним, "Управление торговлей, редакция 10.2") //в УТ 10.2 нет внешних обработок
		Тогда
		
		Возврат Ложь;
		
	ИначеЕсли Найти(Синоним, "Бухгалтерия предприятия") > 0 
		ИЛИ Найти(Синоним, "Бухгалтерия сельскохозяйственного предприятия") > 0 
		ИЛИ Найти(Синоним, "Бухгалтерия хлебобулочного и кондитерского предприятия, редакция 3") > 0 Тогда
		
		Если Метаданные.Справочники.Найти("СохраненныеНастройки") = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Ссылка = Неопределено;
		Если ПолучитьФайлИзБазы(ИмяФайлаВБазе, Ссылка)<>Неопределено Тогда
			СпрОбъект=Ссылка.ПолучитьОбъект();
		Иначе	
			СпрОбъект=Справочники.СохраненныеНастройки.СоздатьЭлемент();
		КонецЕсли;
		
		СпрОбъект.Наименование = ИмяСохраненнойНастройки;
		СпрОбъект.ХранилищеНастроек = Хранилище;
		
		Попытка
			//а вдруг прав не хватит?
			СпрОбъект.Записать();
		Исключение
			Возврат Ложь;
		КонецПопытки;	
		
	Иначе//УТ, КА, УПП, .... надо проверить все конфиги!!!
		Ссылка = Неопределено;
		
		Если Метаданные.Справочники.Найти("ХранилищеДополнительнойИнформации") = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Если ПолучитьФайлИзБазы(ИмяФайлаВБазе, Ссылка) <> Неопределено Тогда
			СпрОбъект = Ссылка.ПолучитьОбъект();
		Иначе	
			СпрОбъект = Справочники.ХранилищеДополнительнойИнформации.СоздатьЭлемент();
		КонецЕсли;
		
		СпрОбъект.Наименование = ИмяСохраненнойНастройки;
		СпрОбъект.Хранилище = Хранилище;
		Попытка
			//а вдруг прав не хватит?
			СпрОбъект.Записать();
		Исключение
			Возврат Ложь;
		КонецПопытки;	
		
	КонецЕсли;	
	
	Возврат Истина;
КонецФункции	

//возвращает объект ДвоичныеДанные по имени файла или Неопределено, 
//если такого файла нет или если хранение файлов в данной конфигурации не поддерживается
//СсылканаСправочник - получает ссылку на справочник, содержащий сохраненный файл, если такой уже есть в базе
Функция ПолучитьФайлИзБазы(ИмяФайлаВБазе,СсылкаНаСправочник=Неопределено) Экспорт

	Синоним = Метаданные.Синоним;
	
	Если Найти(Синоним, "ТКПТ") > 0 Тогда

		Возврат Неопределено;
		
	ИначеЕсли Найти(Синоним, "Бухгалтерия предприятия") > 0 
		ИЛИ Найти(Синоним, "Бухгалтерия сельскохозяйственного предприятия") > 0 
		ИЛИ Найти(Синоним, "Бухгалтерия хлебобулочного и кондитерского предприятия, редакция 3") > 0 Тогда
		
		Если Метаданные.Справочники.Найти("СохраненныеНастройки") = Неопределено 
			ИЛИ Метаданные.Перечисления.Найти("ТипыНастроек") = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СохраненныеНастройки.Ссылка,
		|	СохраненныеНастройки.ХранилищеНастроек как Хранилище
		|ИЗ
		|	Справочник.СохраненныеНастройки КАК СохраненныеНастройки
		|ГДЕ
		|	СохраненныеНастройки.ТипНастройки = Значение(Перечисление.ТипыНастроек.)
		|	И СохраненныеНастройки.Наименование = &Наименование"
		);
		Запрос.УстановитьПараметр("Наименование", ИмяФайлаВБазе);
		Выб = Запрос.Выполнить().Выбрать();
		Если Выб.Следующий() Тогда
			СсылкаНаСправочник = Выб.Ссылка;
			Возврат Выб.Хранилище.Получить();
		Иначе
			Возврат Неопределено;
		КонецЕсли;	
		
	ИначеЕсли Найти(Синоним, "Управление торговлей, редакция 10.2") Тогда
		Возврат Неопределено; //в УТ 10.2 нет внешних обработок	
		
	Иначе
		
		Если Метаданные.Справочники.Найти("ХранилищеДополнительнойИнформации") = Неопределено 
			Или Метаданные.Перечисления.Найти("ВидыДополнительнойИнформацииОбъектов") = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ Первые 1
		|	ХранилищеДополнительнойИнформации.Ссылка,
		|	ХранилищеДополнительнойИнформации.Хранилище
		|ИЗ
		|	Справочник.ХранилищеДополнительнойИнформации КАК ХранилищеДополнительнойИнформации
		|ГДЕ
		|	ХранилищеДополнительнойИнформации.ВидДанных = Значение(Перечисление.ВидыДополнительнойИнформацииОбъектов.)
		|	И ХранилищеДополнительнойИнформации.Наименование = &Наименование"
		);
		Запрос.УстановитьПараметр("Наименование", ИмяФайлаВБазе);
		Выб = Запрос.Выполнить().Выбрать();
		Если Выб.Следующий() Тогда
			СсылкаНаСправочник = Выб.Ссылка;
			Возврат Выб.Хранилище.Получить();
		Иначе
			Возврат Неопределено;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Неопределено;
КонецФункции	

//***************************************************************
// Управление деревом настроек (той частью, которая заполняется из макета НастройкиПараметры)

Функция ПолучитьТекстЯчейкиОбласти(Область, Строка, Колонка) Экспорт
	
	ИмяОбласти = "R" + Формат(Строка, "ЧГ=0") + "C" + Формат(Колонка, "ЧГ=0");
	
	ТекущаяОбластьТабДокумента = Область.ПолучитьОбласть(ИмяОбласти).ТекущаяОбласть;
	
	Если Не ТекущаяОбластьТабДокумента = Неопределено Тогда
		ТекстЯчейки = ТекущаяОбластьТабДокумента.Текст;
	Иначе
		ТекстЯчейки = Область.Область(ИмяОбласти).Текст;
	КонецЕсли;	
	
	Возврат Строка(ТекстЯчейки);
	
КонецФункции	

//находит в макете из параметра Макет область ИмяСписка, и из первой колонки этой области вытаскивает список возможных значений
Функция ПолучитьСписокЗначенийИзМакета(Макет, ИмяСписка, ОсновнаяОбласть = Неопределено)
	
	Если Макет.Области.Найти(ИмяСписка) = Неопределено Тогда
		
		Область = ОсновнаяОбласть.ПолучитьОбласть(ИмяСписка);
		
	Иначе 
		
		Область = Макет.ПолучитьОбласть(ИмяСписка);
	
	КонецЕсли;	
	
	СписокЗначенийСписка = Новый СписокЗначений;
	
	Для Счетчик = 1 По Область.ВысотаТаблицы Цикл
		
		СписокЗначенийСписка.Добавить(ПолучитьТекстЯчейкиОбласти(Область, Счетчик, 1));
		
	КонецЦикла;
	
	Возврат СписокЗначенийСписка;
	
КонецФункции	

//создает дерево настроек
//ВидНастроек может принимать значения: 
//Общие
//Партнеры
//Меркурий
Процедура СоздатьДеревоНастроек(ДеревоНастроек, ВидНастроек, СтруктураСвойствДереваНастроек) Экспорт
	
	ПоддерживаемыеВидыНастроек = Новый Массив;
	ПоддерживаемыеВидыНастроек.Добавить("Общие");
	ПоддерживаемыеВидыНастроек.Добавить("Партнеры");
	ПоддерживаемыеВидыНастроек.Добавить("Меркурий");
	
	Если ПоддерживаемыеВидыНастроек.Найти(ВидНастроек) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СоответствиеГруппДереваНастроек = Новый Соответствие;
	СоответствиеГруппДереваНастроек.Вставить("", ДеревоНастроек);
	
	ДанныеДерева = Новый Структура("СоответствиеГруппДереваНастроек, СтруктураСвойствДереваНастроек", 
									СоответствиеГруппДереваНастроек, СтруктураСвойствДереваНастроек);
									
	ЗаполнитьДеревоНастроек(ДанныеДерева, ВидНастроек); 
	ЗаполнитьКастомныеНастройки(ДанныеДерева, ВидНастроек);
	
КонецПроцедуры

Процедура ДобавитьНастройкуВДерево(ДанныеДерева, Идентификатор, Представление, ЭтоГруппа = Ложь, Родитель = "", РежимНастройки = Неопределено, Тип_ = Неопределено, ЗначениеПоУмолчанию = Неопределено, Подсказка = Неопределено) Экспорт
		
	Если (РежимНастройки = "Покупатель" И НЕ НастройкиМодуля.МыТорговаяСеть)
		ИЛИ (РежимНастройки = "Поставщик" И НЕ НастройкиМодуля.МыПоставщик) Тогда		
		Возврат;
	КонецЕсли;
	
	СоответствиеГруппДереваНастроек = ДанныеДерева.СоответствиеГруппДереваНастроек;
	СтруктураСвойствДереваНастроек = ДанныеДерева.СтруктураСвойствДереваНастроек;
	
	МассивСлов = EDI_РазложитьСтрокуВМассивСлов(Идентификатор, "#");
	Если МассивСлов.Количество() > 1 Тогда
		Если МассивСлов[0] <> ИмяКонфигурации1С Тогда
			Возврат;
		КонецЕсли;
		Идентификатор = МассивСлов[1];
	КонецЕсли;
	
	Если Идентификатор = "COINVOIC" Тогда
		Если НЕ ЕстьКоррИспрСФ Тогда
			Возврат;
		КонецЕсли;
		
		Если СтруктураСвойствДереваНастроек = Неопределено ИЛИ 
			СтруктураСвойствДереваНастроек.Свойство("ТорговаяСеть") И 
			СтруктураСвойствДереваНастроек.ТорговаяСеть = Ложь Тогда

			Возврат;

		КонецЕсли;
	КонецЕсли;
	
	СтрокаРодитель = СоответствиеГруппДереваНастроек[Родитель];
	Если СтрокаРодитель = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	НоваяСтрокаНастройки = СтрокаРодитель.Строки.Добавить();
	
	НоваяСтрокаНастройки.ЭтоГруппа				=	ЭтоГруппа;
	НоваяСтрокаНастройки.НастройкаИД			=	Идентификатор;
	НоваяСтрокаНастройки.НастройкаНаименование	=	Представление;
	НоваяСтрокаНастройки.Подсказка				=	Подсказка;
	
	Если ЭтоГруппа Тогда
		СоответствиеГруппДереваНастроек.Вставить(Идентификатор, НоваяСтрокаНастройки);
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Тип_) = Тип("СписокЗначений") Тогда
		//вытащим список доступных значений из того же макета, из отдельной области
		НоваяСтрокаНастройки.ОписаниеТипа = Новый ОписаниеТипов("СписокЗначений");
		НоваяСтрокаНастройки.Список = ЗначениеВСтрокуВнутр(Тип_);	
	ИначеЕсли Тип_ = "Метаданные.Справочники" Тогда
		НоваяСтрокаНастройки.ОписаниеТипа =	Новый ОписаниеТипов("СписокЗначений");
		СписокМетаданных = Новый СписокЗначений;
		СписокМетаданных.Добавить("", "<ОЧИСТИТЬ>");
		
		Для Каждого ЭлМетаданных Из Метаданные.Справочники Цикл
			НовЭлементСписка = СписокМетаданных.Добавить(ЭлМетаданных.Имя, ЭлМетаданных.Синоним);
		КонецЦикла;	
		НоваяСтрокаНастройки.Список = ЗначениеВСтрокуВнутр(СписокМетаданных);
	Иначе	
		
		Попытка
			ОписаниеТипа =	Новый ОписаниеТипов(Тип_);
		Исключение
			ОписаниеТипа =	Неопределено;
		КонецПопытки;
		
		НоваяСтрокаНастройки.ОписаниеТипа =	ОписаниеТипа; 
		
	КонецЕсли;	
	
	ЗначениеНастройки = Неопределено;
	ЕстьСохраненноеСвойство = (НЕ СтруктураСвойствДереваНастроек = Неопределено) 
								И СтруктураСвойствДереваНастроек.Свойство(НоваяСтрокаНастройки.НастройкаИД, ЗначениеНастройки) 
								И ЗначениеНастройки <> Неопределено;
	Если (ЕстьСохраненноеСвойство И ЗначениеЗаполнено(ЗначениеНастройки)) ИЛИ (ЕстьСохраненноеСвойство И Тип_ = "Число") Тогда
		НоваяСтрокаНастройки.Значение = ЗначениеНастройки;
	ИначеЕсли НоваяСтрокаНастройки.ОписаниеТипа <> Неопределено Тогда
		
		//Берем значение по-умолчанию
		Если ЗначениеЗаполнено(ЗначениеПоУмолчанию) Тогда
			Если Найти(Тип_, "СправочникСсылка") Тогда
				ЗначениеПоУмолчанию = Вычислить(ЗначениеПоУмолчанию);		
			КонецЕсли;
			Если ТипЗнч(Тип_) = Тип("СписокЗначений") И Тип_.Количество() Тогда
				ТипЗначенияСписка = Новый ОписаниеТипов(КонтурСтандарт_МассивЗначений(ТипЗнч(Тип_[0].Значение)));
				НоваяСтрокаНастройки.Значение = ТипЗначенияСписка.ПривестиЗначение(ЗначениеПоУмолчанию);	
			Иначе
				НоваяСтрокаНастройки.Значение = НоваяСтрокаНастройки.ОписаниеТипа.ПривестиЗначение(ЗначениеПоУмолчанию);//если в макете в колонке "ЗначениеПоУмолчанию" пусто, то получим пустое значение данного типа	
			КонецЕсли;
		Иначе	
			НоваяСтрокаНастройки.Значение = НоваяСтрокаНастройки.ОписаниеТипа.ПривестиЗначение(Неопределено);//получим пустое значение нужного типа
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция СписокИменРеквизитовЗаполняемыхЮрФизЛицомТочкиДоставки()
	
	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.Добавить("Не выбран");
	СписокЗначений.Добавить("Контрагент");
	СписокЗначений.Добавить("Грузополучатель");
	
	Возврат СписокЗначений;
	
КонецФункции

Функция СписокСпособПередачиМашиночитаемойДоверенности()
	
	Список = Новый СписокЗначений;
	Список.Добавить("Метаинформацией");
	Список.Добавить("Файлом");
	Список.Добавить("Контентом (не поддерживается)");
	
	Возврат Список;
	
КонецФункции

Функция СписокПоискПредварительногоЗаказа()
	
	Список = Новый СписокЗначений;
	Список.Добавить("Не искать");
	Список.Добавить("Заказ не закрыт, дата заказа меньше даты основного заказа");
	Список.Добавить("Номер предварительного заказа равен номеру основного заказа");
	Список.Добавить("Номер предварительного заказа передается в основном заказе");
	
	Возврат Список;
	
КонецФункции

Функция СписокДокументовДляСозданияДокумента()  
	
	Список = Новый СписокЗначений;
	Список.Добавить("Не выбрано");
