Функция КонтурДиадокAPI_Схема_SignerPowers()

	Схема = ПостроительСхем_НовыйСхема("Строка", Истина);

	// лицо, ответственное за подписание счетов-фактур
	Схема.Перечисление.Добавить("InvoiceSigner");
	
	// лицо, совершившее сделку, операцию
	Схема.Перечисление.Добавить("PersonMadeOperation");
	
	// лицо, совершившее сделку, операцию и ответственное за её оформление
	Схема.Перечисление.Добавить("MadeAndSignOperation");
	
	// лицо, ответственное за оформление свершившегося события;
	Схема.Перечисление.Добавить("PersonDocumentedOperation");
	
	// лицо, совершившее сделку, операцию и ответственное за подписание счетов-фактур;
	Схема.Перечисление.Добавить("MadeOperationAndSignedInvoice");
	
	// лицо, совершившее сделку, операцию и ответственное за её оформление и за подписание счетов-фактур;
	Схема.Перечисление.Добавить("MadeAndResponsibleForOperationAndSignedInvoice");
	
	// лицо, ответственное за оформление свершившегося события и за подписание счетов-фактур;
	Схема.Перечисление.Добавить("ResponsibleForOperationAndSignerForInvoice");
	
	// председатель комиссии
	Схема.Перечисление.Добавить("ChairmanCommission");
	
	// член комиссии
	Схема.Перечисление.Добавить("MemberCommission");
	
	// лицо, в полномочия которого входит утверждение документа, оформляющего событие (факт хозяйственной жизни)
	Схема.Перечисление.Добавить("PersonApprovedDocument");	
	
	// лицо, в полномочия которого входит подтверждение оформленного события (факта хозяйственной жизни)
	Схема.Перечисление.Добавить("PersonConfirmedDocument");
	
	// лицо, в полномочия которого входит согласование документа, оформляющего событие (факт хозяйственной жизни)
	Схема.Перечисление.Добавить("PersonAgreedOnDocument");
	
	// лицо с иными полномочиями
	Схема.Перечисление.Добавить("PersonOtherPower");                                      

	Возврат Схема;

