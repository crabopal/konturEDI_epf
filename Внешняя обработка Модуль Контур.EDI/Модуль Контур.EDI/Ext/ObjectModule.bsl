// Получает уникальное имя файла
//
// Параметры:
//  Расширение - Строка - расширение файла
// 
// Возвращаемое значение:
//  Строка - уникальное имя файла
//
Функция УникальноеИмяФайла(Расширение = Неопределено)
	
	// Метод присутствует в клиентском и серверном модулях
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
	
	Файл = Новый Файл(ИмяВременногоФайла);
	
	Результат = Файл.Имя;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьКраткоеИмяУправляемойФормы(УправляемаяФорма) Экспорт
		
	Результат = "";
	
	ПолноеИмя = УправляемаяФорма.ИмяФормы;
	МассивЧастей = EDI_РазложитьСтрокуВМассивСлов(ПолноеИмя, ".");
	
	ИндексКраткогоИмени = МассивЧастей.ВГраница();
	Если ИндексКраткогоИмени > 0 Тогда
		Результат = МассивЧастей[ИндексКраткогоИмени];
	КонецЕсли;
	
	Возврат Результат;	
	
КонецФункции

Процедура ПриСозданииФормыНаСервере(Форма) Экспорт
	
	ИмяФормы = Форма.КраткоеИмяФормы;
	
	ОбработкаСобытияПодключаемогоМодуля("ПриСозданииФормыНаСервере", , Новый Структура("Форма, ИмяФормы", Форма, ИмяФормы));
	
КонецПроцедуры

Функция ПризнакМодифицированности(ДвоичныеДанныеОбработки) Экспорт
	
	ПризнакМодифицированностиМодуля = ПеречисленияEDI_ПризнакиМодифицированностиКонтента();
	
	Если ДвоичныеДанныеОбработки = Неопределено Тогда
		Возврат ПризнакМодифицированностиМодуля.Неизвестно;
	КонецЕсли;
	
	ХэшСуммаТиповогоМодуля = ХэшСуммаТиповогоМодуля();
	
	Если ЗначениеЗаполнено(ХэшСуммаТиповогоМодуля) И ДвоичныеДанныеОбработки <> Неопределено Тогда
		ХэшСуммаТекущегоМодуля = ХэшСумма(ДвоичныеДанныеОбработки);	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ХэшСуммаТиповогоМодуля) И ЗначениеЗаполнено(ХэшСуммаТекущегоМодуля) Тогда
		Если Врег(ХэшСуммаТиповогоМодуля) = Врег(ХэшСуммаТекущегоМодуля) Тогда
			ПризнакМодифицированности = ПризнакМодифицированностиМодуля.НеИзменен;
		Иначе
			ПризнакМодифицированности = ПризнакМодифицированностиМодуля.Изменен;
		КонецЕсли;
	Иначе
		ПризнакМодифицированности = ПризнакМодифицированностиМодуля.Неизвестно;	
	КонецЕсли;
	
	Если ЕстьОбъектыХраненияДанных_КонтурEDI() Тогда
		УстановитьПривилегированныйРежим(Истина);
	    УстановитьКонстантуEDI("МодульEDIИзменен", ПризнакМодифицированности);
	КонецЕсли;
	
	Возврат ПризнакМодифицированности; 
			
КонецФункции

Функция ИспользуемоеИмяФайлаТекущейОбработки() Экспорт
	
	Результат = ЗначениеКоллекцииПоКлючу(ЭтотОбъект, "ИспользуемоеИмяФайла", "");
	
	Возврат Результат;
	
КонецФункции

Функция РежимИспользованияОбработки() Экспорт
		
	Результат = "";
	
	ИмяФайла = ИспользуемоеИмяФайлаТекущейОбработки();
	
	ИмяФайлаОтсутствует = ПустаяСтрока(ИмяФайла);
	ИмяФайлаСодержитРасширениеEpf = (Прав(НРег(ИмяФайла), 4) = ".epf");
	ИмяФайлаСодержитКаталогВременныхФайлов = (Найти(ИмяФайла, КаталогВременныхФайлов()) > 0);
	ИмяФайлаСодержитАдресВременногоХранилища = СтрокаСодержитАдресВременногоХранилища(ИмяФайла);
	
	РасположенияМодуля = ПеречисленияEDI_ВариантыРасположенияМодуля();
		
	Если ИмяФайлаОтсутствует Тогда
		
		Если МодульЗапущенИзРасширенияКонтурEDI() Тогда
			
			Результат = РасположенияМодуля.Расширение;	
			
		Иначе
			
			Результат = РасположенияМодуля.Конфигурация;	
			
		КонецЕсли;
		
		
	ИначеЕсли ИмяФайлаСодержитАдресВременногоХранилища или
			  ИмяФайлаСодержитКаталогВременныхФайлов Тогда
			  
		Результат = РасположенияМодуля.Справочник;
		
	ИначеЕсли ИмяФайлаСодержитРасширениеEpf Тогда
		
		Результат = РасположенияМодуля.Файл;
		
	Иначе 
		
		Результат = РасположенияМодуля.Неизвестно;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтрокаСодержитАдресВременногоХранилища(Строка)
	
	Результат = Ложь;
	
	Если ЭтоАдресВременногоХранилища(Строка) Тогда
		Результат = Истина;
		Возврат Результат;
	КонецЕсли;
	
	ПрефиксыАдресовВХ = Новый Массив;
	ПрефиксыАдресовВХ.Добавить("e1cib\tempstorage\"); // windows
	ПрефиксыАдресовВХ.Добавить("e1cib\data\");
	ПрефиксыАдресовВХ.Добавить("e1cib/tempstorage/"); // linux
	ПрефиксыАдресовВХ.Добавить("e1cib/data/");
	
	Для Каждого Префикс Из ПрефиксыАдресовВХ Цикл
		Если Найти(Строка, Префикс) = 1 Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Ищет подходящую ссылку, в котором содержится файл обработки модуля
// подходящей версии
//
// Параметры:
//  ВерсияМодуля - Строка - версия модуля, которую нужно найти в справочнике
// 
// Возвращаемое значение:
//  СправочникСсылка
//
Функция СсылкаНаМодульИзСправочникаВнешнихОбработок(ВерсияМодуля)
	
	Если ПараметрыКлиентСервер.ТипИспользуемыхФорм = "Обычные" Тогда
		Результат = СсылкаНаВнешнююОбработку_ОФ(ВерсияМодуля);
	Иначе
		Результат = СсылкаНаВнешнююОбработку_УФ(ВерсияМодуля);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает файл обработки из справочника внешних обработок
//
// Параметры:
//  ВнешняяОбработка - СправочникСсылка - элемент в справочнике внешних обработок,
//                                        из которого нужно получить файл
// 
// Возвращаемое значение:
//  ДвоичныеДанные - двоичные данные файла обработки
//
Функция ФайлОбработкиИзСправочникаВнешнихОбработок(ВнешняяОбработка) Экспорт
	
	Если ПараметрыКлиентСервер.ТипИспользуемыхФорм = "Обычные" Тогда
		ИмяРеквизита = "ХранилищеВнешнейОбработки";
	Иначе
		ИмяРеквизита = "ХранилищеОбработки";
	КонецЕсли;
	
	ХранилищеОбработки = ПолучитьЗначениеРеквизитаОбъекта_КонтурEDI(ВнешняяОбработка, ИмяРеквизита);
	
	Результат = ХранилищеОбработки.Получить();
	
	Возврат Результат;
	
КонецФункции

// Проверяет наличие файла модуля и возможность записи в его каталог
//
// Параметры:
//  ПутьКФайлу - Строка - путь к файлу модуля
// 
// Возвращаемое значение:
//  Строка - описание ошибки
//
Функция ПроверитьВозможностьОбновленияФайлаМодуля(ПутьКФайлу) Экспорт
	
	// Метод присутствует в клиентском и серверном модулях
	
	ТекстОшибки = "";
	
	Файл = Новый Файл(ПутьКФайлу);
	Каталог	 = Файл.Путь;
	ИмяФайла = Файл.Имя;
	
	Если Файл.Существует() Тогда
		
		УникальнаяЧасть		 = УникальноеИмяФайла("txt");
		ОбщаяЧасть			 = "KonturEDI_WriteTest";
		ИмяТестовогоФайла	 = ОбщаяЧасть + "_" + УникальнаяЧасть;
		ПутьКТестовомуФайлу	 = ОбъединитьПути(Каталог, ИмяТестовогоФайла);
		
		Попытка
			
			Запись = Новый ЗаписьТекста(ПутьКТестовомуФайлу);
			Запись.Записать("Тест записи файла перед обновлением " + ИмяФайла);
			Запись.Закрыть();
			
		Исключение
			Ошибка		 = ИнформацияОбОшибке();
			ТекстОшибки	 = НСтр("ru = 'Ошибка! Не удалось записать файл в каталог, где находится модуль. Возможно нет прав.'");
		КонецПопытки;                  
		
		Попытка
			УдалитьФайлы(ПутьКТестовомуФайлу);
		Исключение
			Ошибка = ИнформацияОбОшибке();
		КонецПопытки;
		
	Иначе
		ТекстОшибки = НСтр("ru = 'Ошибка! Не найден файл модуля.'");
	КонецЕсли;
	
	Возврат ТекстОшибки;
	
КонецФункции

// Возвращает разделитель пути, используемого в операционной системе
// 
// Возвращаемое значение:
//  Строка
//
Функция РазделительПути()
	
	// Метод присутствует в клиентском и серверном модулях
	
	СистемнаяИнформация	 = Новый СистемнаяИнформация;
	ВерсияПриложения	 = СистемнаяИнформация.ВерсияПриложения;
	ТипОС				 = СистемнаяИнформация.ТипПлатформы;
	
	Если ВерсияПрограмногоПродуктаРавнаИлиВыше(ВерсияПриложения, "8.3.3") Тогда
		
		Результат = Вычислить("ПолучитьРазделительПути()");
		
	Иначе
		
		ЭтоLinux = Найти(НРег(ТипОС), НРег("Linux")) > 0;
		
		Если ЭтоLinux Тогда
			Результат = "/";
		Иначе
			Результат = "\";
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Объединяет части пути через разделитель
//
Функция ОбъединитьПути(П1, П2, П3 = Неопределено, П4 = Неопределено)
	
	// Метод присутствует в клиентском и серверном модулях
	
	Результат = П1;
	
	РазделительПути = РазделительПути();
	
	ЧастиПути = НовыйМассив(П2, П3, П4);
	
	Для Каждого Элемент Из ЧастиПути Цикл
		
		Если Не ЗначениеЗаполнено(Элемент) Тогда
			Прервать;
		КонецЕсли;
		
		Если Прав(Результат, 1) <> РазделительПути Тогда
			Результат = Результат + РазделительПути;
		КонецЕсли;
		
		Результат = Результат + Элемент;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Проверяет возможность записи элемента справочника внешних обработок
// с правами текущего пользователя
//
// Параметры:
//  ВнешняяОбработка - СправочникСсылка - элемент в справочнике внешних обработок,
//                                        в котором хранится модуль;
// 
// Возвращаемое значение:
//  Строка - описание ошибки
//
Функция ПроверитьВозможностьОбновленияЭлементаСправочникаМодуля(ВнешняяОбработка) Экспорт
	
	ТекстОшибки = "";
	
	Если ВнешняяОбработка <> Неопределено Тогда
	
		Попытка
			
			УстановитьПривилегированныйРежим(Истина);
			
			ОбъектСправочника = ВнешняяОбработка.ПолучитьОбъект();
			ОбъектСправочника.ОбменДанными.Загрузка = Истина;
			ОбъектСправочника.Записать();
			
		Исключение
			Ошибка		 = ИнформацияОбОшибке();
			ТекстОшибки	 = НСтр("ru = 'Ошибка! Не удалось записать элемент справочника модуля. Возможно нет прав.'");
		КонецПопытки;
	
	Иначе
		ТекстОшибки = НСтр("ru = 'Ошибка! Не определен элемент справочника модуля.'");	
	КонецЕсли;
	
	Возврат ТекстОшибки;
	
КонецФункции

Функция СведенияОВнешнейОбработкеИзФайла(ДвоичныеДанные)
	
	Если ЭтоОбычноеПриложение() Тогда
		Результат = СведенияОВнешнейОбработкеИзФайла_ЧерезВременныйФайл(ДвоичныеДанные);
	Иначе
		Результат = СведенияОВнешнейОбработкеИзФайла_ЧерезВременноеХранилище(ДвоичныеДанные);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СведенияОВнешнейОбработкеИзФайла_ЧерезВременныйФайл(ДвоичныеДанные)
	
	ИмяФайла = ПолучитьИмяВременногоФайла();
	
	ДвоичныеДанные.Записать(ИмяФайла);
	
	ОбъектОбработки	 = ВнешниеОбработки_СоздатьБезПредупреждений(ИмяФайла);
	Результат		 = ОбъектОбработки.СведенияОВнешнейОбработке();
	
	УдалитьФайлы(ИмяФайла);
	
	Возврат Результат;
	
КонецФункции

Функция СведенияОВнешнейОбработкеИзФайла_ЧерезВременноеХранилище(ДвоичныеДанные)
	
	ИмяТекущейОбработки	 = ПараметрыКлиентСервер.СинонимМодуля;
	ИмяНовойОбработки	 = ИмяТекущейОбработки + "_ДляЧтенияСведений";
	АдресОбработки		 = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
	
	ВнешниеОбработки_ПодключитьБезПредупреждений(АдресОбработки, ИмяНовойОбработки);
	
	ОбъектОбработки = ВнешниеОбработки_СоздатьПоИмени(ИмяНовойОбработки);
	
	Результат = ОбъектОбработки.СведенияОВнешнейОбработке();
	
	Возврат Результат;
	
КонецФункции

// Возвращает описание защиты от опасных действий
// с отключенным предупреждением об опасных действиях
// 
// Возвращаемое значение:
//  ОписаниеЗащитыОтОпасныхДействий
//
Функция ОписаниеЗащитыБезПредупреждений()
	
	Результат = Новый("ОписаниеЗащитыОтОпасныхДействий");
	
	Результат.ПредупреждатьОбОпасныхДействиях = Ложь;
	
	Возврат Результат;
	
КонецФункции

// Подключает внешнюю обработку в метаданные сеанса без предупреждения об опасных действиях
//
// Параметры:
//  АдресОбработки - Строка - адрес двоичных данных обработки во временном хранилище;
//  ИмяОбработки   - Строка - (необязательный) имя обработки, с которым она будет подключена;
//
// Возвращаемое значение:
//  Строка - имя подключенной внешней обработки
//
Функция ВнешниеОбработки_ПодключитьБезПредупреждений(АдресОбработки, ИмяОбработки = Неопределено) Экспорт
	
	БезопасныйРежим = Ложь;
	
	Если ЕстьЗащитаОтОпасныхДействий() Тогда
		
		Результат = ВнешниеОбработки.Подключить(АдресОбработки, ИмяОбработки, БезопасныйРежим, ОписаниеЗащитыБезПредупреждений());
		
	Иначе
		
		Результат = ВнешниеОбработки.Подключить(АдресОбработки, ИмяОбработки, БезопасныйРежим);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Создает по имени заранее подключенную внешнюю обработку
//
// Параметры:
//  ИмяОбработки - Строка - имя, по которому обработка была подключена в метаданные сеанса
//
// Возвращаемое значение:
//  ОбработкаОбъект - объект созданной внешней обработки
//
Функция ВнешниеОбработки_СоздатьПоИмени(ИмяОбработки)
	
	БезопасныйРежим = Ложь;
	
	Результат = ВнешниеОбработки.Создать(ИмяОбработки, БезопасныйРежим);
	
	Возврат Результат;
	
КонецФункции

// Создает объект внешней обработки без предупреждения об опасных действиях
//
// Параметры:
//  ДанныеФайла - ДвоичныеДанные - двоичные данные внешней обработки;
//              - Строка         - путь к файлу внешней обработки;
//
// Возвращаемое значение:
//  ОбработкаОбъект - объект созданной внешней обработки
//
Функция ВнешниеОбработки_СоздатьБезПредупреждений(ДанныеФайла, ИмяОбработки = Неопределено) Экспорт
	
	// В обычном приложении, создание внешней обработки всегда выполняется через файл
	
	ЭтоПутьКФайлу = ТипЗнч(ДанныеФайла) = Тип("Строка");
	
	Если ЭтоПутьКФайлу Тогда
		ПутьКФайлу = ДанныеФайла;
	Иначе
		ДвоичныеДанные = ДанныеФайла;
	КонецЕсли;
	
	Если ЭтоПутьКФайлу Или ЭтоОбычноеПриложение() Тогда
		
		Если ЭтоПутьКФайлу Тогда
			
			Результат = ВнешниеОбработки_СоздатьИзФайла(ПутьКФайлу);
			
		Иначе
			
			ИмяВремФайла = ПолучитьИмяВременногоФайла("epf");
			
			ДвоичныеДанные.Записать(ИмяВремФайла);
			
			Результат = ВнешниеОбработки_СоздатьИзФайла(ИмяВремФайла);
			
			УдалитьФайлы(ИмяВремФайла);
			
		КонецЕсли;
		
	Иначе
		
		АдресОбработки	 = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
		ИмяОбработки	 = ВнешниеОбработки_ПодключитьБезПредупреждений(АдресОбработки, ИмяОбработки);
		Результат		 = ВнешниеОбработки_СоздатьПоИмени(ИмяОбработки);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет наличие механизма платформы, предупреждающего об опасных действиях.
//
// Возвращаемое значение:
//  Булево - Истина, если механизм предупреждений безопасности есть
//
Функция ЕстьЗащитаОтОпасныхДействий()
	
	Свойства = Новый Структура("ЗащитаОтОпасныхДействий, UnsafeOperationProtection");
	ЗаполнитьЗначенияСвойств(Свойства, ПользователиИнформационнойБазы.ТекущийПользователь());
	
	Если Свойства.ЗащитаОтОпасныхДействий <> Неопределено
		Или Свойства.UnsafeOperationProtection <> Неопределено Тогда
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Создает внешнюю обработку из файла на диске
//
// Параметры:
//  ПутьКФайлу - Строка - путь к файлу обработки
//
// Возвращаемое значение:
//  ОбработкаОбъект - объект созданной внешней обработки
//
Функция ВнешниеОбработки_СоздатьИзФайла(ПутьКФайлу)
	
	БезопасныйРежим	 = Ложь;
	ВерсияПриложения = ПараметрыКлиентСервер.ВерсияПлатформы1С;
	Приложение_8311	 = ВерсияПрограмногоПродуктаРавнаИлиВыше(ВерсияПриложения, "8.3.11");
	ЕстьЗащита		 = ЕстьЗащитаОтОпасныхДействий();
	
	Если Приложение_8311 И ЕстьЗащита Тогда
		
		Результат = ВнешниеОбработки.Создать(ПутьКФайлу, БезопасныйРежим, ОписаниеЗащитыБезПредупреждений());
		
	Иначе
		
		Результат = ВнешниеОбработки.Создать(ПутьКФайлу, БезопасныйРежим);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДвоичныеДанныеОбработкиПоСсылке(СсылкаНаМодуль = Неопределено) Экспорт
	
	ДвоичныеДанные = Неопределено;

	Если Не ЗначениеЗаполнено(СсылкаНаМодуль) Тогда
		СсылкаНаМодуль = ПолучитьСсылкуВнешнейОбработкиДляАвтоматическогоОбновления();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СсылкаНаМодуль) Тогда
		
		ИмяРеквизитаХранения = ПолучитьИмяРеквизитаХраненияОбработки_КонтурEDI(СсылкаНаМодуль);			
		ДвоичныеДанные = СсылкаНаМодуль[ИмяРеквизитаХранения].Получить();
		
	Иначе
		
		ДвоичныеДанные = Неопределено;
		
	КонецЕсли;
	
	Возврат ДвоичныеДанные; 
	
КонецФункции

Функция ДвоичныеДанныеТекущегоМодуля() Экспорт
	
	КлючКэша = "РезультатФункции_ДвоичныеДанныеТекущегоМодуля";
	
	ДвоичныеДанныеТекущегоМодуля = ЭДО_Кэш_Прочитать(КлючКэша);
	Если НЕ ДвоичныеДанныеТекущегоМодуля = Неопределено Тогда
		Возврат ДвоичныеДанныеТекущегоМодуля;
	КонецЕсли;
	
	Попытка
		ДвоичныеДанныеТекущегоМодуля = ИзвлечьИзВХ("ОбработкаОбъектДвоичныеДанные");
		
		Если ДвоичныеДанныеТекущегоМодуля = Неопределено Тогда
			
			РасположениеМодуля 	= ОпределитьРасположениеМодуля_КонтурEDI();
			ПутьКМодулю			= ОпределитьПутьКМодулю_КонтурEDI(РасположениеМодуля);
			
			Если ТипЗнч(ПутьКМодулю) = Тип("Строка") Тогда	
				ДвоичныеДанныеТекущегоМодуля = Новый ДвоичныеДанные(ПутьКМодулю);			
			Иначе	
				ДвоичныеДанныеТекущегоМодуля = ФайлОбработкиИзСправочникаВнешнихОбработок(ПутьКМодулю);		
			КонецЕсли;
			
		КонецЕсли;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	ЭДО_Кэш_Поместить(КлючКэша, ДвоичныеДанныеТекущегоМодуля);
	
	Возврат ДвоичныеДанныеТекущегоМодуля;
	
КонецФункции

// Возвращает хэш-сумму контента, рассчитанную по алгоритму хэширования MD5.
//
// Параметры:
//	 Контент - ДвоичныеДанные, Строка - Содержит контент, хэш-сумму которого нужно рассчитать
//
// Возвращаемое значение:
//	 Строка	- рассчитанная  хэш-сумма
//
Функция ХэшСумма(Контент)
	
	Если ТипЗнч(Контент) = Тип("Строка") Тогда
				
		ДвоичныеДанныеКонтента = КонтурСтандарт_ПолучитьДвоичныеДанныеИзСтроки_(Контент);
		
	Иначе 
		
		ДвоичныеДанныеКонтента = Контент;
		
	КонецЕсли;

	Если КонтурСтандарт_ВерсияПлатформыНеНижеУказанной("8.3.1") Тогда
		
		ПараметрыКонструктора = Новый Массив;  
		ПараметрыКонструктора.Добавить(ПредопределенноеЗначение("ХешФункция.MD5"));
		
		ХешированиеДанных = Новый(Тип("ХешированиеДанных"), ПараметрыКонструктора);
		
		ХешированиеДанных.Добавить(ДвоичныеДанныеКонтента);
		
		Результат = СтрЗаменить(ХешированиеДанных.ХешСумма, " ", "");
		
	Иначе
		
		НовыйКонтент = Новый Структура("hex");
		hash_type = "MD5";
		
		Попытка

			ХэшСумма = КонтурПлагин().РассчитатьХэш(ДвоичныеДанныеКонтента, НовыйКонтент,, hash_type);	
			Результат = ВРег(ХэшСумма);	
			
		Исключение
			
			Результат = Неопределено;
			ТекстОшибки = "Не удалось определить хэш сумму " + ?(ТипЗнч(Контент)=Тип("Строка"), "строки данных", "модуля") + " по причине: " + ОписаниеОшибки();
			ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Предупреждение, ТекстОшибки);
			
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Результат; 
	
КонецФункции

Функция ХэшСуммаТиповогоМодуля()
	
	НомерРелиза_КонтурEDI = ПараметрыКлиентСервер.ОписаниеВерсии.МажорМинорПатч;
	
	Попытка
		
		Ответ = КлиентСервисОбновлений_ИнформацияКонтентаВерсии(НомерРелиза_КонтурEDI);
		
		MD5Типовой = Ответ.md5hash;
		
	Исключение    
		
		MD5Типовой = "";  
		
	КонецПопытки;
		
	Возврат MD5Типовой;
		
КонецФункции

Функция ХэшСуммаТекущегоМодуля()
	
	КлючКэша = "РезультатФункции_ХэшСуммаТекущегоМодуля";
	
	ХэшСуммаТекущегоМодуля = ЭДО_Кэш_Прочитать(КлючКэша);
	
	Если НЕ ХэшСуммаТекущегоМодуля = Неопределено Тогда
		Возврат ХэшСуммаТекущегоМодуля;
	КонецЕсли;
	
	Попытка

		ДвоичныеДанныеОбработки = ДвоичныеДанныеТекущегоМодуля();

		ХэшСуммаТекущегоМодуля = ХэшСумма(ДвоичныеДанныеОбработки);
		
		ЭДО_Кэш_Поместить(КлючКэша, ХэшСуммаТекущегоМодуля);
		
	Исключение 
		ТекстОшибки = ОписаниеОшибки();
		ХэшСуммаТекущегоМодуля = "";
	КонецПопытки;
	
	Возврат ХэшСуммаТекущегоМодуля;
	
КонецФункции

Функция ХэшСуммаИсправленногоМодуля()
	
	Попытка 
		
		ТипПлагина = "plugin-dd-standard";
		
		Ответ = КлиентСервисОбновлений_СписокПлагинов(ТипПлагина, 1);
		
		Если Ответ.count > 0 Тогда
			ХэшСуммаИсправленногоМодуля = Ответ.plugins[0].hash_md5;
		КонецЕсли;
		
	Исключение    
		
		ХэшСуммаИсправленногоМодуля = "";  
		
	КонецПопытки;
		
	Возврат ХэшСуммаИсправленногоМодуля;
		
КонецФункции 

//Определяем из записи регистра КонтурEDI_ДополнительныеРеквизиты + кэшируем в том числе как переменную модуля т.к. функция будет вызываться при каждой отправке сообщения
//Запись попадает в регистр в отдельный момент. (периодически мы проверяем модуль на изменения)
Функция МодульEDIИзменен() Экспорт
	//Эдем состояния:
	//"Неизвестно"
	//"Изменен"
	//"Не изменен"
	
	МодульEDIИзменен = ПолучитьКонстантуEDI("МодульEDIИзменен");
	Если МодульEDIИзменен = Неопределено Тогда
		МодульEDIИзменен = "Неизвестно";	
	КонецЕсли;
				
	Возврат МодульEDIИзменен; 
	
КонецФункции // МодульEDIИзменен()

// Ищет подходящую ссылку в справочнике внешних обработок
//
// Параметры:
//  ВариантыНаименований - Массив - возможные наименования обработки, которую нужно найти,
//                             см. функцию СсылкаНаМодульИзСправочникаВнешнихОбработок(ВерсияМодуля);
//  ТребуемаяВерсия 	 - Строка - версия обработки, которую нужно найти,
//                             см. функцию ПолучитьНомерРелиза_Контур();
// 
// Возвращаемое значение:
//  СправочникСсылка.ВнешниеОбработки - подходящий элемент справочника;
//  Неопределено - если найти подходящий элемент справочника не удалось;
//
Функция СсылкаНаВнешнююОбработку_ОФ(ТребуемаяВерсия)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Неопределено;
	
	ИмяСправочника = "ВнешниеОбработки";
	
	Если Не ЕстьНеобходимыеМетаданные("Справочники."+ИмяСправочника) Тогда
		Возврат Результат;
	КонецЕсли;
	
	УсловиеНеЭтоГруппа = "ИСТИНА";
	Если СправочникМожетСодержатьГруппы(ИмяСправочника) Тогда						   
		УсловиеНеЭтоГруппа	= "НЕ Т.ЭтоГруппа";
	КонецЕсли;
	
	ВариантыНаименований = ВариантыНаименованийМодуляВСправочникеВнешнихОбработок();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Т.Ссылка
	|ИЗ
	|	Справочник.ВнешниеОбработки КАК Т
	|ГДЕ
	|	&УсловиеНеЭтоГруппа
	|	И НЕ Т.ПометкаУдаления
	|	И (Т.Наименование В (&ВариантыНаименований) ИЛИ &УсловиеКомментарий)
	|	И &УсловиеВидОбработки");
	
	Если ЕстьНеобходимыеМетаданные("Справочники.ВнешниеОбработки.Реквизиты.ВидОбработки")
		И ЕстьНеобходимыеМетаданные("Перечисления.ВидыДополнительныхВнешнихОбработок", Истина) Тогда
		УсловиеВидОбработки = "Т.ВидОбработки = ЗНАЧЕНИЕ(Перечисление.ВидыДополнительныхВнешнихОбработок.Обработка)";
	Иначе
		УсловиеВидОбработки = "Истина";
	КонецЕсли;
	
	Если ЕстьНеобходимыеМетаданные("Справочники.ВнешниеОбработки.Реквизиты.КомментарийКФайлуИсточнику") Тогда 
		УсловиеКомментарий = "Т.КомментарийКФайлуИсточнику ПОДОБНО ""%КонтурEDI%""";
	Иначе
		УсловиеКомментарий = "Ложь";
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеВидОбработки", УсловиеВидОбработки);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеНеЭтоГруппа", УсловиеНеЭтоГруппа);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКомментарий", УсловиеКомментарий);
	
	Запрос.УстановитьПараметр("ВариантыНаименований", ВариантыНаименований);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			ДвоичныеДанные		 	= ФайлОбработкиИзСправочникаВнешнихОбработок(Выборка.Ссылка);
			СведенияОбОбработке	 	= СведенияОВнешнейОбработкеИзФайла(ДвоичныеДанные);
			НаименованиеОбработки	= СведенияОбОбработке.Наименование;
			ВерсияОбработки		 	= СведенияОбОбработке.Версия;
		Исключение
			Ошибка = ИнформацияОбОшибке();
		КонецПопытки;
		
		ВерсииСовпадают = (ВерсияОбработки = ТребуемаяВерсия);
		НаименованияСовпадают = (ВариантыНаименований.Найти(НаименованиеОбработки) <> Неопределено);		
		Если ВерсииСовпадают и НаименованияСовпадают Тогда
			Результат = Выборка.Ссылка;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьМодифицированностьМодуля(РасположениеМодуля) Экспорт
	
	ДвоичныеДанныеОбработки = ДвоичныеДанныеТекущейОбработки(РасположениеМодуля);
	
	ПризнакМодифицированности = "Неизвестно";
	
	Если ЗначениеЗаполнено(ДвоичныеДанныеОбработки) Тогда
	
		ПризнакМодифицированности = ПризнакМодифицированности(ДвоичныеДанныеОбработки);	

	КонецЕсли;
	
	Возврат ПризнакМодифицированности;
	
КонецФункции

// Возвращает двоичные данные модуля
//
// Параметры:
//  РасположениеМодуля - Структура - см. функцию НовоеОписаниеРасположенияМодуля()
//
Функция ДвоичныеДанныеТекущейОбработки(РасположениеМодуля) Экспорт
	
	ВнешняяОбработка = РасположениеМодуля.Ссылка;
	ПутьКФайлу		 = РасположениеМодуля.ПутьКФайлу;
	Местоположение	 = РасположениеМодуля.Местоположение;
	
	РасположенияМодуля = ПеречисленияEDI_ВариантыРасположенияМодуля();
	
	ДвоичныеДанные = Неопределено;
	
	Если Местоположение = РасположенияМодуля.Файл Тогда
		
		Файл = Новый Файл(ПутьКФайлу);
		
		Если Файл.Существует() Тогда
			
			ДвоичныеДанные	 = Новый ДвоичныеДанные(ПутьКФайлу);
			
		Иначе
			
			ДвоичныеДанные = Неопределено;
			
		КонецЕсли;		
		
	ИначеЕсли Местоположение = РасположенияМодуля.Справочник
		И Не ВнешняяОбработка = Неопределено Тогда
		
		ДвоичныеДанные	 = ФайлОбработкиИзСправочникаВнешнихОбработок(ВнешняяОбработка);
		
	Иначе
		
		ДвоичныеДанные = Неопределено;
		
	КонецЕсли;
	
	Возврат ДвоичныеДанные;
	
КонецФункции

// Ищет подходящую ссылку в справочнике дополнительных отчетов и обработок
//
// Параметры:
//  ВариантыНаименований     - Массив - возможные наименование обработки, которую нужно найти,
//                             см. функцию СсылкаНаМодульИзСправочникаВнешнихОбработок(ВерсияМодуля);
//  ТребуемаяВерсия - Строка - версия обработки, которую нужно найти,
//                             см. функцию ПолучитьНомерРелиза_Контур();
// 
// Возвращаемое значение:
//  СправочникСсылка.ДополнительныеОтчетыИОбработки - подходящий элемент справочника;
//  Неопределено - если найти подходящий элемент справочника не удалось;
//
Функция СсылкаНаВнешнююОбработку_УФ(ТребуемаяВерсия)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Неопределено;
	
	ИмяСправочника = "ДополнительныеОтчетыИОбработки";
	
	Если Не ЕстьНеобходимыеМетаданные("Справочники." + ИмяСправочника) Тогда
		Возврат Результат;
	КонецЕсли;
	
	УсловиеНеЭтоГруппа = "ИСТИНА";
	Если СправочникМожетСодержатьГруппы(ИмяСправочника) Тогда						   
		УсловиеНеЭтоГруппа	= "НЕ Т.ЭтоГруппа";
	КонецЕсли;
	
	УсловиеПоНаименованию = "Т.Наименование В (&ВариантыНаименований)";
	Если ЕстьНеобходимыеМетаданные("Справочники." + ИмяСправочника + ".Реквизиты.ИмяОбъекта") Тогда
		УсловиеПоНаименованию = "(Т.Наименование В (&ВариантыНаименований)
								 |			ИЛИ Т.ИмяОбъекта В (&ВариантыИмен))";	
	КонецЕсли;
	
	ВариантыИмен = ВариантыИменВнешнейОбработки();
	ВариантыНаименований = ВариантыНаименованийМодуляВСправочникеВнешнихОбработок();
		
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Т.Ссылка,
	|	Т.Версия
	|ИЗ
	|	Справочник.ДополнительныеОтчетыИОбработки КАК Т
	|ГДЕ
	|	&УсловиеНеЭтоГруппа
	|	И НЕ Т.ПометкаУдаления
	|	И &УсловиеПоНаименованию
	|	И Т.Публикация = ЗНАЧЕНИЕ(Перечисление.ВариантыПубликацииДополнительныхОтчетовИОбработок.Используется)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ 
	|	Т.Ссылка,
	|	Т.Версия
	|ИЗ
	|	Справочник.ДополнительныеОтчетыИОбработки КАК Т
	|ГДЕ
	|	&УсловиеНеЭтоГруппа
	|	И НЕ Т.ПометкаУдаления
	|	И &УсловиеПоНаименованию
	|	И Т.Публикация = ЗНАЧЕНИЕ(Перечисление.ВариантыПубликацииДополнительныхОтчетовИОбработок.РежимОтладки)");
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеНеЭтоГруппа", УсловиеНеЭтоГруппа);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоНаименованию", УсловиеПоНаименованию);
	Запрос.УстановитьПараметр("ВариантыНаименований", ВариантыНаименований);
	Запрос.УстановитьПараметр("ВариантыИмен", ВариантыИмен);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Версия = ТребуемаяВерсия Тогда
			Результат = Выборка.Ссылка;
			Прервать;
		КонецЕсли;
		
		Попытка
			ДвоичныеДанные		 	= ФайлОбработкиИзСправочникаВнешнихОбработок(Выборка.Ссылка);
			СведенияОбОбработке	 	= СведенияОВнешнейОбработкеИзФайла(ДвоичныеДанные);
			НаименованиеОбработки	= СведенияОбОбработке.Наименование;
			ВерсияОбработки		 	= СведенияОбОбработке.Версия;
		Исключение
			Ошибка = ИнформацияОбОшибке();
		КонецПопытки;
		
		ВерсииСовпадают = (ВерсияОбработки = ТребуемаяВерсия);
		НаименованияСовпадают = (ВариантыНаименований.Найти(НаименованиеОбработки) <> Неопределено);
		Если ВерсииСовпадают и НаименованияСовпадают Тогда
			Результат = Выборка.Ссылка;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СправочникМожетСодержатьГруппы(ИмяСправочника)
	
	МетаданныеСправочника = Метаданные.Справочники[ИмяСправочника];
	ИерархияГиЭ = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов;
	
	Возврат МетаданныеСправочника.Иерархический И МетаданныеСправочника.ВидИерархии = ИерархияГиЭ;
	
КонецФункции

Функция ВариантыИменВнешнейОбработки()
	
	Результат = Новый Массив;
	
	Результат.Добавить("КонтурEDI");
	Результат.Добавить("Контур.EDI");
	
	Возврат Результат;
	
КонецФункции

Функция ВариантыНаименованийМодуляВСправочникеВнешнихОбработок()
	
	Результат = Новый Массив;
	
	// на ОФ наименование берется из синонима обработки
	
	// на УФ наименование получается из поля Наименование результата функции СведенияОВнешнейОбработке()
	
	Результат.Добавить("Модуль Контур.EDI");
	Результат.Добавить("КонтурEDI");
	Результат.Добавить("Контур.EDI");
	Результат.Добавить(СинонимОбработки());
	
	Возврат Результат;
	
КонецФункции

// Определяет в каком приложении запущена обработка
//
// Возвращаемое значение:
//  Булево - Истина, если обработка запущена в толстом клиенте в режиме обычного приложения
//
Функция ЭтоОбычноеПриложение()
	
	Результат = Ложь;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Результат = Истина;
	#КонецЕсли
	
	Возврат Результат;
	
КонецФункции

//}} Работа с признаком модифицированности модуля

//{{ Работа с расширением конфигурации КонтурEDI

// Проверяет возможность запуска обработки как внешней обработки.
// Обработку запрещено запускать как внешнюю, если метаданные добавлены через расширение конфигурации.
//
// Возвращаемое значение:
//  РезультатПроверки - Структура.
//     * РазрешеноЗапуститьМодуль - Булево - Ложь, если модуль запускается как внешняя обработка и метаданные добавлены через расширение конфигурации
//     * ТекстОшибки        - Строка
//
Функция РазрешеноЗапуститьМодульКакВнешнююОбработку() Экспорт
	
	РезультатПроверки = Новый Структура("РазрешеноЗапуститьМодуль, ТекстОшибки", Истина, "");

	Если МодульЗапущенКакВнешняяОбработка_КонутрEDI() И ЕстьРасширениеКонфигурацииКонтурEDI() И НЕ КонтурСтандарт_ДоступныНаборыТиповРасширения() Тогда
		
		РезультатПроверки.РазрешеноЗапуститьМодуль = Ложь;
		РезультатПроверки.ТекстОшибки = 
		"Модуль КонтурEDI встроен в конфигурацию через расширение. 
		|Нельзя открыть модуль как внешнюю обработку.
		|Запускайте встроенную в конфигурацию обработку КонтурEDI.";
		
	КонецЕсли;
	
	Возврат РезультатПроверки;	
	
КонецФункции

// Проверяет запущен ли модуль как внещняя обработка. 
//
// Возвращаемое значение: 
// 	Булево - Истина, если модуль запущен как внешняя обработка.
//
Функция МодульЗапущенКакВнешняяОбработка_КонутрEDI()
	
	ПолноеИмяОбработки = Метаданные().ПолноеИмя();
	
	МодульЗапущенКакВнешняяОбработка = Найти(ПолноеИмяОбработки, "ВнешняяОбработка") <> 0;
	
	Возврат МодульЗапущенКакВнешняяОбработка;

КонецФункции

// Проверяет наличие расширения коннфигурации: "КонтурEDI". 
//
// Возвращаемое значение: 
// 	Булево - Истина, если расширение конфигурации "КонтурEDI" есть.
//
Функция ЕстьРасширениеКонфигурацииКонтурEDI()
	
	РасширениеКонтурEDI = РасширениеКонфигурацииКонтурEDI(); 
	
	РасширениеНайдено = (РасширениеКонтурEDI <> Неопределено);
	
	Возврат РасширениеНайдено;
	
КонецФункции

// Проверяет наличие расширения коннфигурации: "КонтурEDI". 
//
// Возвращаемое значение: 
// 	РасширениеКонфигурации  - найденное расширение конфигурации "КонтурEDI".
// 	Неопределено 			- если расширение не найдено.
//
Функция РасширениеКонфигурацииКонтурEDI()
	
	РасширениеКонтурEDI = Неопределено;
	
	Если ЕстьПоддрежкаРасширенийКонфигурации_КонутрEDI() Тогда 
		
		ПоискРасширения = Новый Структура;
		ПоискРасширения.Вставить("Имя", "КонтурEDI");
		
		УстановитьПривилегированныйРежим(Истина);
		Попытка
			НайденныеРасширения = Вычислить("РасширенияКонфигурации.Получить(ПоискРасширения)");
		Исключение
			НайденныеРасширения = Неопределено;
		КонецПопытки;
		УстановитьПривилегированныйРежим(Ложь);
		
		Если НайденныеРасширения <> Неопределено 
			И НайденныеРасширения.Количество() >  0 Тогда
			
			РасширениеКонтурEDI = НайденныеРасширения[0];
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РасширениеКонтурEDI;

КонецФункции

// Проверяет возможность обратится к РасширенияКонфигурации. 
//
// Возвращаемое значение: 
// 	Булево - Истина, если версия совместимости конфигурация больше или равно "Версия 8.3.5".
//
Функция ЕстьПоддрежкаРасширенийКонфигурации_КонутрEDI()
	
	ВерсияРежимаСовместимости = ВерсияРежимаСовместимостиКонфигурации_КонтурEDI(); 
	
	ВерсияСовместимостиРазобранная = РазобратьВерсиюСтрокой_КонтурEDI(ВерсияРежимаСовместимости);
	
	ЕстьПоддрежкаРасширенийКонфигурации = 
	ВерсияСовместимостиРазобранная.Основная = 8
	И ВерсияСовместимостиРазобранная.Младшая = 3
	И ВерсияСовместимостиРазобранная.Релиз >= 6;
	
	Возврат ЕстьПоддрежкаРасширенийКонфигурации;

КонецФункции

// Получает версию совместимости конфигурации в строку вида: "8.3.5". 
//
// Возвращаемое значение: 
// 	Строка - В случае режима совместимости "НеИспользовать" вернется "НеИспользовать".
//			 В случае наличия версии совместимости, вернется строка вида "8.3.5".
//
Функция ВерсияРежимаСовместимостиКонфигурации_КонтурEDI()
	
	ВерсияРежимаСовместимости = Строка(Метаданные.РежимСовместимости);
	
	ВерсияРежимаСовместимости = СтрЗаменить(ВерсияРежимаСовместимости, "Версия", "");
	ВерсияРежимаСовместимости = СтрЗаменить(ВерсияРежимаСовместимости, "Version", "");
	ВерсияРежимаСовместимости = СтрЗаменить(ВерсияРежимаСовместимости, "_", ".");
	
	ВерсияРежимаСовместимости = СокрЛП(ВерсияРежимаСовместимости);
	
	Возврат ВерсияРежимаСовместимости;

КонецФункции

Функция МодульЗапущенИзРасширенияКонтурEDI()
	
	ИмяКэша = "МодульЗапущенИзРасширенияКонтурEDI";
	
	Результат =  ЭДО_Кэш_Прочитать(ИмяКэша);
	
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Ложь;
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	
	Если СравнитьВерсииПрограммногоПродукта(СистемнаяИнформация.ВерсияПриложения,"8.3.8",3) = ВидСравнения.Больше 
		И НЕ МодульЗапущенКакВнешняяОбработка_КонутрEDI() Тогда
		
		РасширениеОбработки = Метаданные().РасширениеКонфигурации();
		
		Если РасширениеОбработки <> Неопределено Тогда
			
			ИмяРасширенияКонтурEDI = ИмяРасширенияКонфигурацииКонтурEDI();			
			Результат = (РасширениеОбработки.Имя = ИмяРасширенияКонтурEDI);
		
		КонецЕсли;
		
	КонецЕсли;
	
	ЭДО_Кэш_Поместить(ИмяКэша, Результат);
	
	Возврат Результат;	
	
КонецФункции   

Функция ИмяРасширенияКонфигурацииКонтурEDI()  
	
	Возврат "КонтурEDI";
	
КонецФункции

//}} Работа с расширением конфигурации КонтурEDI

Функция ПолучитьИзСтроки(Строка, КодировкаТекста_ = "UTF-8", ЗаписатьBOM = Ложь) Экспорт
	
	Попытка
		
		ДвоичныеДанные = Вычислить("ПолучитьДвоичныеДанныеИзСтроки(Строка, КодировкаТекста_, ЗаписатьBOM)");
		
	Исключение
		
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
		
		Если ЗаписатьBOM Тогда
			ЗаписьТекста = Новый ЗаписьТекста(ИмяВременногоФайла, КодировкаТекста_);	
		Иначе	
			ЗаписьТекста = Новый ЗаписьТекста(ИмяВременногоФайла, КодировкаТекста.ANSI);	
		КонецЕсли;
		ЗаписьТекста.Закрыть();
		
		ЗаписьТекста = Новый ЗаписьТекста(ИмяВременногоФайла, КодировкаТекста_,, Истина);
		ЗаписьТекста.Записать(Строка);
		ЗаписьТекста.Закрыть();
		
		ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
		
		УдалитьФайлы(ИмяВременногоФайла);
		
	КонецПопытки;
	
	Возврат ДвоичныеДанные;
	
КонецФункции

//{{ Дополнительные модули 

Функция ЦентрПоддержки() Экспорт
	
	Результат = ЭДО_Кэш_Прочитать("Модуль_ЦентрПоддержки");
	
	Если Результат <> Неопределено Тогда 
		
		Возврат Результат;
		
	КонецЕсли;
	
	Модуль_ЦентрПоддержки = ДополнительныйМодуль("ЦентрПоддержки");
	Модуль_ЦентрПоддержки.Инит("edi-1C", ЭтотОбъект, ЭтотОбъект, ЭтоТестовыйAPI()); 
	
	ЭДО_Кэш_Поместить("Модуль_ЦентрПоддержки", Модуль_ЦентрПоддержки);
	
	Возврат Модуль_ЦентрПоддержки;
	
КонецФункции

Функция КонтурПлагин() Экспорт
	Возврат ДополнительныйМодуль("КонтурПлагин");
КонецФункции

Функция ДополнительныйМодуль(Знач ИмяМодуля) Экспорт
	
	Возврат ПолучитьМодуль(ИмяМодуля);
	
КонецФункции

Функция ПолучитьМодуль(ИмяМодуля) Экспорт
	
	ИмяКешаМодуля = "Модуль_" + ИмяМодуля;
	
	Результат = ЭДО_Кэш_Прочитать(ИмяКешаМодуля);
	
	Если Результат <> Неопределено Тогда 
		
		Возврат Результат;
		
	КонецЕсли;

	Результат = СоздатьМодуль(ИмяМодуля);
	
	Если Результат <> Неопределено Тогда
		
		ИнициализироватьМодуль(Результат);
		
	КонецЕсли;
	                      
	ЭДО_Кэш_Поместить(ИмяКешаМодуля, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция СоздатьМодуль(ИмяМодуля)
	
	Результат = Неопределено;
	
	СетевойКаталогОтладки = ПолучитьСетевойКаталогОтладки();
	
	Если РежимОтладкиВключен() И ПроверитьСуществованиеФайлаКаталога(СетевойКаталогОтладки) Тогда	
		
		ПутьКФайлу = ОбъединитьПути(СетевойКаталогОтладки, "libs", "Модуль_" + ИмяМодуля + ".epf"); 
		
		Результат = СоздатьМодульИзФайлаНаДиске(ИмяМодуля, ПутьКФайлу);	
		
	ИначеЕсли МодульЗапущенИзРасширенияКонтурEDI() Тогда  
		
		Результат = СоздатьМодульИзКонфигурации(ИмяМодуля);		
		
	Иначе  
		
		Результат = СоздатьМодульИзМакета(ИмяМодуля);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции    

Функция СоздатьМодульИзФайлаНаДиске(ИмяМодуля, ПутьКФайлу)
	
	Результат = Неопределено;
	
	Если НЕ ПроверитьСуществованиеФайлаКаталога(ПутьКФайлу) Тогда
		
		ДвоичныеДанные = ДанныеМакетаМодуля(ИмяМодуля);	
		
		ДвоичныеДанные.Записать(ПутьКФайлу);	
		
	КонецЕсли;
	
	Результат = ВнешниеОбработки_СоздатьБезПредупреждений(ПутьКФайлу);
	
	Возврат Результат;
	
КонецФункции

Функция СоздатьМодульИзКонфигурации(ИмяМодуля)
	
	Результат = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(ИмяМодуля) Тогда
		Возврат Результат;
	КонецЕсли;
	 
	ИмяОбработки = "КонтурEDI" + ИмяМодуля;
	
	Если ЕстьНеобходимыеМетаданные("Обработки." + ИмяОбработки) Тогда
		Результат = Обработки[ИмяОбработки].Создать();
	Иначе
		Результат = СоздатьМодульИзМакета(ИмяМодуля);
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

Функция СоздатьМодульИзМакета(ИмяМодуля)  
	
	Результат = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(ИмяМодуля) Тогда
		Возврат Результат;
	КонецЕсли;
	 
	ДвоичныеДанные = ДанныеМакетаМодуля(ИмяМодуля);
	
	БезопасноеИмяОбработки = ИмяМодуля + СтрЗаменить(Новый УникальныйИдентификатор(), "-", "");
	
	Результат = ВнешниеОбработки_СоздатьБезПредупреждений(ДвоичныеДанные, БезопасноеИмяОбработки);
	
	Возврат Результат;  
	
КонецФункции

Функция РежимОтладкиВключен()     
	
	Возврат ПолучитьКонстантуEDI("ИспользоватьРежимОтладки") = Истина; 
	
КонецФункции 

Функция ПолучитьСетевойКаталогОтладки() 
	
	Возврат ПолучитьКонстантуEDI("СетевойКаталогОтладки");
	
КонецФункции

Функция ДанныеМакетаМодуля(ИмяМодуля)
	
	ДанныеМакета = ПолучитьМакет("Модуль_" + ИмяМодуля);
	
	Возврат ДанныеМакета;
	
КонецФункции

// Создает новую версию модуля по указанному расположению
//
// Параметры:
//  РасположениеМодуля - Структура - см. функцию НовоеОписаниеРасположенияМодуля()
//	ПутьКМодулю - Строка, Ссылка - путь к модуля на диске, ссылка на элемент справочника дополнительных обработок
//
// Возвращаемое значение:
//  ОбработкаОбъект - объект обработки новой версии модуля
//
Функция СоздатьНовуюВерсиюМодуля(РасположениеМодуля, ПутьКМодулю) Экспорт
	
	РасположенияМодуля = ПеречисленияEDI_ВариантыРасположенияМодуля();
	
	Если РасположениеМодуля = РасположенияМодуля.Файл Тогда
		
		Результат = ВнешниеОбработки_СоздатьБезПредупреждений(ПутьКМодулю);
		
	ИначеЕсли РасположениеМодуля = РасположенияМодуля.Справочник Тогда
		
		ДвоичныеДанные = ФайлОбработкиИзСправочникаВнешнихОбработок(ПутьКМодулю);
		
		Результат = ВнешниеОбработки_СоздатьБезПредупреждений(ДвоичныеДанные);
		
	Иначе
		
		ТекстОшибки = ШаблонСтр(НСтр(
		"ru = 'Не удалось подключить внешнюю обработку модуля!
		|Некорректное расположение модуля: %1'"), РасположениеМодуля);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Подставляет параметры в строку, максимальное число параметров - 5.
//
// Параметры:
//  ШаблонСтроки - Строка - шаблон содержащий маркеры подстановки вида: "%1..%N"
//                        . Нумерация маркеров начинается с 1.
//                          N не может быть более 5.
//  Параметр<n>  - Строка - подставляемые параметры.
//
// Возвращаемое значение:
//   Строка - строка шаблона с подставленными параметрами.
//
Функция ШаблонСтр(ШаблонСтроки, Параметр1
	, Параметр2 = Неопределено
	, Параметр3 = Неопределено
	, Параметр4 = Неопределено
	, Параметр5 = Неопределено) Экспорт
	
	Результат = СтрЗаменить(ШаблонСтроки, "%1", Параметр1);
	Результат = СтрЗаменить(Результат	, "%2", Параметр2);
	Результат = СтрЗаменить(Результат	, "%3", Параметр3);
	Результат = СтрЗаменить(Результат	, "%4", Параметр4);
	Результат = СтрЗаменить(Результат	, "%5", Параметр5);
	
	Возврат Результат;
	
КонецФункции

Процедура ИнициализироватьМодуль(Модуль)
	
	СтруктураЗаполнения = Новый Структура("МодульОбъектаОсновногоМодуля, АдресВременногоХранилищаОсновногоМодуля", ЭтотОбъект, ПараметрыКлиентСервер.АдресаВХ.ОбработкаОбъект);  
	ЗаполнитьЗначенияСвойств(Модуль, СтруктураЗаполнения);
	
КонецПроцедуры

