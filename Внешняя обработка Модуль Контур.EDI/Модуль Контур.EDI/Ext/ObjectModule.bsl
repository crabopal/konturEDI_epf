Функция Расширения_ПроверитьОбновленияРасширений() Экспорт
	
	Результат = Новый Структура("Успешно,ОписаниеОшибки,ТаблицаДанныхОбУстановленныхРасширениях", Ложь, "");
	
	ТолькоРекомендованные = Ложь;
	Партнер 			  = Неопределено;	
	ДляПоставщика 		  = НастройкиМодуля.МыПоставщик;
	ДляСети  			  = НастройкиМодуля.МыТорговаяСеть;
	
	РезультатДанныеОРасширениях = ПолучитьДанныеОРасширенияхССервера(ТолькоРекомендованные, Партнер, ДляПоставщика, ДляСети);
	
	Если Не РезультатДанныеОРасширениях.Успешно Тогда
		Результат.ОписаниеОшибки = "Не удалось получить данные о расширениях: """ + РезультатДанныеОРасширениях.ОписаниеОшибки + """.";
		Возврат Результат;
	КонецЕсли;
	
	ДанныеОРасширениях = РезультатДанныеОРасширениях.ДанныеОРасширениях;
	
	ТаблицаДанныхОбУстановленныхРасширениях = ПолучитьДанныеОбУстановленныхРасширениях();
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаДанныхОбУстановленныхРасширениях, "Обновить", Новый ОписаниеТипов("Булево"));
	
	Для каждого УстановленноеРасширение из ТаблицаДанныхОбУстановленныхРасширениях Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("Идентификатор", УстановленноеРасширение.Идентификатор);
		Отбор.Вставить("Установить", "обновить");
		
		НайденныеСтроки =  ДанныеОРасширениях.НайтиСтроки(Отбор);
		
		Если НЕ НайденныеСтроки.Количество() = 0 Тогда 
			УстановленноеРасширение.Обновить = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Результат.ТаблицаДанныхОбУстановленныхРасширениях = ТаблицаДанныхОбУстановленныхРасширениях;
	Результат.Успешно = Истина;
	
	Возврат Результат;	
	
КонецФункции

Функция Расширения_ВосстановитьИсходныйКод(РасширениеСсылка) Экспорт
	
	Результат = Новый Структура("Успешно,ОписаниеОшибки", Ложь, "");
	
	Если НЕ ЗначениеЗаполнено(РасширениеСсылка) Тогда 
		Результат.ОписаниеОшибки = "В Функцию Расширения_ВосстановитьИсходныйКод передан неверный параметр";
		Возврат Результат;
	КонецЕсли;
	
	ТаблицаДопРеквизитовРасширения = ИнициализироватьТаблицуДополнительныхРеквизитовРасширения();
	ДополнительныеРеквизиты = РасширениеСсылка.ДополнительныеРеквизиты;

	Отбор = Новый Структура;
	Отбор.Вставить("ИмяРеквизита", "ИсходныйИсполняемыйКод"); 
	НайденныеСтрокиИсходногоКода = ДополнительныеРеквизиты.НайтиСтроки(Отбор);
	Для каждого СтрокаКода из НайденныеСтрокиИсходногоКода Цикл 
		СтрокаИсполняемогоКода = ТаблицаДопРеквизитовРасширения.Добавить();
		СтрокаИсполняемогоКода.ИмяРеквизита = "ИсполняемыйКод";
		СтрокаИсполняемогоКода.Значение = СтрокаКода.Значение;
		СтрокаИсполняемогоКода.ЗначениеСтрока = СтрокаКода.ЗначениеСтрока;	
	КонецЦикла;
	
	Попытка
		СохранитьЭлементСправочника("Расширения", РасширениеСсылка, ТаблицаДопРеквизитовРасширения);  
		Результат.Успешно = Истина;
	Исключение 
		
		_ОписаниеОшибки = ОписаниеОшибки();
		
		Результат.Успешно = Ложь;
		Результат.ОписаниеОшибки = _ОписаниеОшибки;		
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция Расширения_ВосстановитьАрхивнуюВерсию(РасширениеСсылка) Экспорт
	
	Результат = Новый Структура("Успешно,ОписаниеОшибки", Ложь, "");
	
	Если НЕ ЗначениеЗаполнено(РасширениеСсылка) Тогда 
		Результат.ОписаниеОшибки = "В Функцию Расширения_ВосстановитьИзСохраненноеВерсии передан неверный параметр";
		Возврат Результат;
	КонецЕсли;
	
	СохраненноеРасширениеСсылка = Расширения_ПолучитьАрхивнуюВерсию(РасширениеСсылка);
	
	Если СохраненноеРасширениеСсылка = Неопределено Тогда
		Результат.ОписаниеОшибки = "Не найденна сохраненная версия для расширения """ + РасширениеСсылка.Наименование + """";
		Возврат Результат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		СохраненноеРасширениеОбъект = ПреобразоватьЗначениеДляВнешнегоХранилища(СохраненноеРасширениеСсылка).ПолучитьОбъект();
		СохраненноеРасширениеОбъект.ИмяСправочника = "Расширения";
		СохраненноеРасширениеОбъект.Записать();
		
		ЗаписатьДопРеквизитСправочника_КонтурEDI(СохраненноеРасширениеОбъект.Ссылка, "Использование", Истина);
		
		Результат = УдалитьРасширение(РасширениеСсылка);
		
		Если НЕ Результат.Успешно Тогда
			ВызватьИсключение "Не удалось удалить расширение - " + Результат.ОписаниеОшибки;
		КонецЕсли;
		
	    Если ТранзакцияАктивна() Тогда
	        ЗафиксироватьТранзакцию();
	    КонецЕсли;
		
	Исключение 
		
	    Если ТранзакцияАктивна() Тогда
	        ОтменитьТранзакцию();
		КонецЕсли;
		_ОписаниеОшибки = ОписаниеОшибки();
		
		Результат.Успешно = Ложь;
		Результат.ОписаниеОшибки = _ОписаниеОшибки;		
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция Расширения_Переименовать(РасширениеСсылка, Наименование) Экспорт 
	
	Результат = Новый Структура("Успешно,ОписаниеОшибки", Ложь, "");
	
	Если НЕ ЗначениеЗаполнено(РасширениеСсылка) Тогда 
		Результат.ОписаниеОшибки = "В Функцию Расширения_Переименовать передан неверный параметр";
		Возврат Результат;
	КонецЕсли;
	
	Попытка 
		
		СправочникОбъект = ПреобразоватьЗначениеДляВнешнегоХранилища(РасширениеСсылка).ПолучитьОбъект();
		СправочникОбъект.Наименование = Наименование;
		СправочникОбъект.Записать();
		
		Результат.Успешно = Истина;
		
	Исключение 
		
		_ОписаниеОшибки = ОписаниеОшибки();
		
		Результат.Успешно = Ложь;
		Результат.ОписаниеОшибки = _ОписаниеОшибки;		
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция Расширения_АрхивироватьТекущуюВерсию(РасширениеСсылка) Экспорт
	
	Результат = Новый Структура("Успешно,ОписаниеОшибки", Ложь, "");
	
	Если НЕ ЗначениеЗаполнено(РасширениеСсылка) Тогда 
		Результат.ОписаниеОшибки = "В Функцию Расширения_СохранитьТекущуюВерсию передан неверный параметр";
		Возврат Результат;
	КонецЕсли;
	
	Идентификатор = ПолучитьЗначениеДопРеквизитаСправочника_КонтурEDI(РасширениеСсылка, "Идентификатор");
	
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда 
		Результат.ОписаниеОшибки = "Расширение " + РасширениеСсылка.Наименование + " не имеет идентификатора";
		Возврат Результат;
	КонецЕсли;

	СохраненнаяВерсияРасширенияСсылка = Расширения_ПолучитьАрхивнуюВерсию(РасширениеСсылка);
	
	НачатьТранзакцию();
	Попытка
		
		Если НЕ СохраненнаяВерсияРасширенияСсылка = Неопределено Тогда 
			
			Результат = УдалитьРасширение(СохраненнаяВерсияРасширенияСсылка);
			
			Если НЕ Результат.Успешно Тогда
				ВызватьИсключение "Не удалось удалить расширение - " + Результат.ОписаниеОшибки;
			КонецЕсли;
			
		КонецЕсли;
		
		РасширениеОбъект = ПреобразоватьЗначениеДляВнешнегоХранилища(РасширениеСсылка).ПолучитьОбъект();
		
		КопияРасширениеОбъект = РасширениеОбъект.Скопировать();
		КопияРасширениеОбъект.ИмяСправочника = "#Расширения";
		КопияРасширениеОбъект.Записать();
		
		ДатаСохранения = Формат(ТекущаяДатаСеанса(), "ДФ=""дд ММММ гггг 'г.' ЧЧ:мм:сс""");
		
		ЗаписатьДопРеквизитСправочника_КонтурEDI(КопияРасширениеОбъект.Ссылка, "Использование", Ложь);
		ЗаписатьДопРеквизитСправочника_КонтурEDI(КопияРасширениеОбъект.Ссылка, "ДатаСохранения", ДатаСохранения);
		
		Результат.Успешно = Истина;
		
	    Если ТранзакцияАктивна() Тогда
	        ЗафиксироватьТранзакцию();
		КонецЕсли;
		
	Исключение 
		
	    Если ТранзакцияАктивна() Тогда
	        ОтменитьТранзакцию();
		КонецЕсли;
		
		_ОписаниеОшибки = ОписаниеОшибки();
		
		Результат.Успешно = Ложь;
		Результат.ОписаниеОшибки = _ОписаниеОшибки;		
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция Расширения_ПолучитьАрхивнуюВерсию(РасширениеСсылка) Экспорт 
	
	Если НЕ ЗначениеЗаполнено(РасширениеСсылка) Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КонтурEDI_ДополнительныеСправочники.Ссылка
	               |ИЗ
	               |	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК КонтурEDI_ДопРеквизит_Идентификатор
	               |		ПО КонтурEDI_ДополнительныеСправочники.Ссылка = КонтурEDI_ДопРеквизит_Идентификатор.Ссылка
	               |			И (КонтурEDI_ДопРеквизит_Идентификатор.ИмяРеквизита = ""Идентификатор"")
	               |			И (КонтурEDI_ДопРеквизит_Идентификатор.Значение = &Идентификатор)
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК КонтурEDI_ДопРеквизиты_Использование
	               |		ПО КонтурEDI_ДополнительныеСправочники.Ссылка = КонтурEDI_ДопРеквизиты_Использование.Ссылка
	               |			И (КонтурEDI_ДопРеквизиты_Использование.ИмяРеквизита = ""Использование"")
	               |			И (КонтурEDI_ДопРеквизиты_Использование.Значение = ЛОЖЬ)
	               |ГДЕ
	               |	КонтурEDI_ДополнительныеСправочники.ИмяСправочника = ""#Расширения""
	               |	И НЕ КонтурEDI_ДополнительныеСправочники.ПометкаУдаления";
	
	Идентификатор = ПолучитьЗначениеДопРеквизитаСправочника_КонтурEDI(РасширениеСсылка, "Идентификатор");
	
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе 
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Параметры функции избыточны, но оставлены для обратной совместимости
Функция УстановитьРасширение(Наименование,Идентификатор,Интерфейс,Знач РасширениеСсылка = Неопределено, Использование = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(РасширениеСсылка) Тогда
		Возврат ОбновитьРасширение(РасширениеСсылка);
	КонецЕсли;
	
	РезультатЗагрузки = ЗагрузитьРасширениеИзБиблиотеки(Идентификатор);
	Если Не РезультатЗагрузки.Успешно Тогда
		Возврат РезультатЗагрузки;
	КонецЕсли;
	
	ДанныеРасширения = РезультатЗагрузки.ДанныеРасширения;
	
	Если Не Использование = Неопределено Тогда
		СтрокаДанных = ДанныеРасширения.Найти("Использование","ИмяРеквизита");
		Если СтрокаДанных <> Неопределено Тогда
			СтрокаДанных.Значение = Использование;		
		КонецЕсли;
	КонецЕсли;

	РезультатЗагрузки = ЗагрузитьДопФайлыРасширенияИзБиблиотеки(Идентификатор, ДанныеРасширения);
	Если Не РезультатЗагрузки.Успешно Тогда
		Возврат РезультатЗагрузки;
	КонецЕсли;
	
	РезультатУстановки = Новый Структура("Успешно,ОписаниеОшибки", Ложь, "");
	
	СохранитьЭлементСправочника("Расширения", РасширениеСсылка, ДанныеРасширения);
	Если РасширениеСсылка = Неопределено Тогда
		РезультатУстановки.ОписаниеОшибки = "Не удалось записать расширение в базу данных.";
		Возврат РезультатУстановки;
	КонецЕсли;
	
	ОбновитьКэшИсполняемогоКодаРасширений();
	
	ОбработкаСобытияПодключаемогоМодуля("ПослеУстановкиРасширения",,Новый Структура("РасширениеСсылка, Успешно", РасширениеСсылка, Истина));
	
	РезультатУстановки.Успешно = Истина;
	
	Возврат РезультатУстановки;
	
КонецФункции

Функция ОбновитьРасширение(РасширениеСсылка) Экспорт
	
	РеквизитыУстановленногоРасширения = ПолучитьЗначенияРеквизитовРасширения(РасширениеСсылка, Ложь, Ложь);
	Идентификатор = РеквизитыУстановленногоРасширения.Идентификатор;
	
	РезультатАрхивирования = Расширения_АрхивироватьТекущуюВерсию(РасширениеСсылка);
	Если Не РезультатАрхивирования.Успешно Тогда 
		Возврат РезультатАрхивирования;
	КонецЕсли;
	
	РезультатЗагрузки = ЗагрузитьРасширениеИзБиблиотеки(Идентификатор);
	Если Не РезультатЗагрузки.Успешно Тогда
		Возврат РезультатЗагрузки;
	КонецЕсли;
	
	ДанныеРасширения = РезультатЗагрузки.ДанныеРасширения;
	
	ВерсияРасширения = "";
	
	Для Каждого СтрокаДанных из ДанныеРасширения Цикл
		Если СтрокаДанных.ИмяРеквизита = "Использование" Тогда
			СтрокаДанных.Значение = РеквизитыУстановленногоРасширения.Использование;
		ИначеЕсли СтрокаДанных.ИмяРеквизита = "ПорядокВыполнения" Тогда
			СтрокаДанных.Значение = РеквизитыУстановленногоРасширения.ПорядокВыполнения;
		ИначеЕсли СтрокаДанных.ИмяРеквизита = "ВерсияРасширения" Тогда
			ВерсияРасширения = СтрокаДанных.Значение;
		КонецЕсли;
	КонецЦикла;
	
	РезультатЗагрузки = ЗагрузитьДопФайлыРасширенияИзБиблиотеки(Идентификатор, ДанныеРасширения);
	Если Не РезультатЗагрузки.Успешно Тогда
		Возврат РезультатЗагрузки;
	КонецЕсли;
	
	РезультатУстановки = Новый Структура("Успешно,ОписаниеОшибки", Ложь, "");
	
	Попытка
	
		УстановитьПривилегированныйРежим(Истина);
		СохранитьЭлементСправочника("Расширения", РасширениеСсылка, ДанныеРасширения);
		
	Исключение   
		
		РезультатУстановки.ОписаниеОшибки = ОписаниеОшибки();
		Возврат РезультатУстановки;	
		
	КонецПопытки; 
	
	Если РасширениеСсылка = Неопределено Или Не ПолучитьВерсиюРасширения(РасширениеСсылка) = ВерсияРасширения Тогда
		РезультатУстановки.ОписаниеОшибки = "Не удалось записать расширение в базу данных.";
		Возврат РезультатУстановки;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ОбновитьКэшИсполняемогоКодаРасширений();
	
	ОбработкаСобытияПодключаемогоМодуля("ПослеУстановкиРасширения",,Новый Структура("РасширениеСсылка, Успешно", РасширениеСсылка, Истина));
	
	РезультатУстановки.Успешно = Истина;
	
	Возврат РезультатУстановки;
	
КонецФункции	

Функция ВерсияМодуляНижеРекомендуемой(РекомендуемаяВерсияМодуля) Экспорт
	
	ТекущаяВерсияМодуля = ПараметрыКлиентСервер.ОписаниеВерсии.ПолнаяСемантикВерсия;
	
	КоличествоРазрядовСравнения = 3;
	РезультатСравнения = СравнитьВерсииПрограммногоПродукта(ТекущаяВерсияМодуля, РекомендуемаяВерсияМодуля, КоличествоРазрядовСравнения);
	
	ВерсияМодуляНижеРекомендуемой = (РезультатСравнения = ВидСравнения.Меньше);
	
	Возврат ВерсияМодуляНижеРекомендуемой;
		
КонецФункции

Функция ЗагрузитьРасширениеИзБиблиотеки(Идентификатор) Экспорт
	
	Результат = Новый Структура("Успешно,ОписаниеОшибки,ДанныеРасширения",Ложь,"",Неопределено);
	
	МассивИменФайлов = Новый Массив;
	МассивИменФайлов.Добавить(Идентификатор+"/content.xml");
	МассивИменФайлов.Добавить("extension.xsl");
	
	РезультатЗагрузки = ЗагрузитьФайлыРасширенийВЛокальныйКаталог(МассивИменФайлов);
	
	Если Не РезультатЗагрузки.Успешно Тогда
		Результат.ОписаниеОшибки = РезультатЗагрузки.ОписаниеОшибки;
		Возврат Результат;
	ИначеЕсли РезультатЗагрузки.МассивЗагруженныхФайлов.Количество() = 0 Тогда
		Результат.ОписаниеОшибки = "Не получены файлы расширения.";
		Возврат Результат;
	ИначеЕсли РезультатЗагрузки.МассивЗагруженныхФайлов.Количество() = 1 Тогда
		Результат.ОписаниеОшибки = "Не удалось загрузить один или несколько файлов.";
		Возврат Результат;
	КонецЕсли;
	
	ИмяФайлаСписка = РезультатЗагрузки.МассивЗагруженныхФайлов[0];
	ИмяФайлаXSL	   = РезультатЗагрузки.МассивЗагруженныхФайлов[1];
	
	РезультатЧтения = ПрочитатьXMLпоXSL(ИмяФайлаСписка, ИмяФайлаXSL);
			
	Если Не РезультатЧтения.Успешно Тогда
		Результат.ОписаниеОшибки = "Не удалось прочитать данные о расширении.";
		Возврат Результат;
	КонецЕсли;
	
	ДанныеРасширения = РезультатЧтения.ДанныеЧтения;
	
	СтрокаДанных = ДанныеРасширения.Найти("РекомендуемаяВерсияМодуля","ИмяРеквизита");
	Если СтрокаДанных <> Неопределено Тогда
		РекомендуемаяВерсияМодуля = СтрокаДанных.Значение;
		Если ВерсияМодуляНижеРекомендуемой(РекомендуемаяВерсияМодуля) Тогда
			Результат.Успешно = Ложь;
			Результат.ОписаниеОшибки = "Текущая версия модуля Контур.EDI ниже рекомендуемой для расширения версии " + РекомендуемаяВерсияМодуля;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	РезультатКонвертации = КонвертироватьДанныеРасширения(Идентификатор,ДанныеРасширения);
	
	Если Не РезультатКонвертации.Успешно Тогда
		Результат.ОписаниеОшибки = "Не удалось конвертировать данные расширения.";
		Возврат Результат;
	КонецЕсли;

	Результат.Успешно = Истина;
	Результат.ДанныеРасширения = РезультатКонвертации.ТаблицаДанныеРасширения;
	
	Возврат Результат;
	
КонецФункции

// загружаем интерфейс и доп. файлы (если они есть)
Функция ЗагрузитьДопФайлыРасширенияИзБиблиотеки(Идентификатор, ДанныеРасширения) Экспорт
	
	РезультатЗагрузки = Новый Структура("Успешно,ОписаниеОшибки,МассивЗагруженныхФайлов", Ложь, "", Новый Массив);
	
	ДанныеОДопФайлах 		= ДанныеРасширения.НайтиСтроки(Новый Структура("ИмяРеквизита","Файл"));
	ДанныеОИнтерфейсе 		= ДанныеРасширения.НайтиСтроки(Новый Структура("ИмяРеквизита","Интерфейс"));
	МассивИменФайлов 		= Новый Массив;
	
	Если Не ДанныеОДопФайлах.Количество() = 0 Тогда
		Для Каждого Элемент Из ДанныеОДопФайлах Цикл
			МассивИменФайлов.Добавить(Идентификатор+"/"+Элемент.Значение);	
		КонецЦикла;
	КонецЕсли;
	Если Не ДанныеОИнтерфейсе.Количество() = 0 И ДанныеОИнтерфейсе[0].Значение = Истина Тогда
		МассивИменФайлов.Добавить(Идентификатор+"/"+"interface.epf");	
	КонецЕсли;
	
	Если Не МассивИменФайлов.Количество() = 0 Тогда
		РезультатЗагрузки = ЗагрузитьФайлыРасширенийВЛокальныйКаталог(МассивИменФайлов);
		Если Не РезультатЗагрузки.Успешно Тогда
			Возврат РезультатЗагрузки;
		ИначеЕсли РезультатЗагрузки.МассивЗагруженныхФайлов.Количество() = 0 Тогда
			РезультатЗагрузки.ОписаниеОшибки = "Не получены дополнительные файлы расширения.";
			Возврат РезультатЗагрузки;
		КонецЕсли;
	КонецЕсли;
	
	//Преобразуем колонку ЗначениеХранилищеЗначения, получив двоичные данные файлов 
	ДанныеРасширения.Колонки.Добавить("ДвоичныеДанные");
	Для Каждого СтрокаДанныхРасширения Из ДанныеРасширения Цикл		
		Если ЗначениеЗаполнено(СтрокаДанныхРасширения.ЗначениеХранилищеЗначения) Тогда
			СтрокаДанныхРасширения.ДвоичныеДанные = Новый ДвоичныеДанные(СтрокаДанныхРасширения.ЗначениеХранилищеЗначения);	
		КонецЕсли;		
	КонецЦикла;
	ДанныеРасширения.Колонки.Удалить("ЗначениеХранилищеЗначения");
	ДанныеРасширения.Колонки.Найти("ДвоичныеДанные").Имя = "ЗначениеХранилищеЗначения";
	
	РезультатЗагрузки.Успешно = Истина;
	
	Возврат РезультатЗагрузки;
	
КонецФункции

Функция ПолучитьВерсиюРасширения(РасширениеСсылка) Экспорт
	
	РеквизитыРасширения = ПолучитьЗначенияРеквизитовРасширения(РасширениеСсылка, Ложь, Ложь);	
	
	Возврат РеквизитыРасширения.ВерсияРасширения;

КонецФункции

Функция УдалитьРасширение(РасширениеСсылка, ИнтерактивноеУдаление = Ложь) Экспорт
	
	РезультатУдаления = Новый Структура("Успешно,ОписаниеОшибки",Ложь,"");
	
	РезультатОбработки = ОбработкаСобытияПодключаемогоМодуля("ПередУдалениемРасширения",,Новый Структура("РасширениеСсылка", РасширениеСсылка));
	Если Не РезультатОбработки = Неопределено Тогда
		Если РезультатОбработки.Свойство("Отказ") И РезультатОбработки.Отказ = Истина Тогда
			Если РезультатОбработки.Свойство("Описание") И ЗначениеЗаполнено(РезультатОбработки.Описание) Тогда
				РезультатУдаления.ОписаниеОшибки = РезультатОбработки.Описание; 	
			КонецЕсли;
			Возврат РезультатУдаления;
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		Если НЕ ИнтерактивноеУдаление Тогда
			// BSLLS:SetPrivilegedMode-off
			УстановитьПривилегированныйРежим(Истина);
			// BSLLS:SetPrivilegedMode-on
		КонецЕсли;
		УдалитьЭлементСправочника("Расширения",РасширениеСсылка);
		РезультатУдаления.Успешно = Истина;
	Исключение
		_ОписаниеОшибки = ОписаниеОшибки();
		РезультатУдаления.ОписаниеОшибки = _ОписаниеОшибки;
	КонецПопытки;
	
	Если ПривилегированныйРежим() Тогда
		// BSLLS:SetPrivilegedMode-off
		УстановитьПривилегированныйРежим(Ложь);
		// BSLLS:SetPrivilegedMode-on
	КонецЕсли;
	
	Возврат РезультатУдаления;
	
КонецФункции

// Обновляет расширения, которые находит по переданным идентификаторам/идентификатору
//
// Параметры:
//  	ИдентификаторыРасширения - Массив,Строка - Идентификатор(строка) или Идентификаторы(массив) расширений, которые нужно удалить
// Возвращаемое значение:
//		РезультатОбновления - Соответствие
//			* Ключ - Идентификатор расширения
//			* Значение - Структура
//    			* ЕстьВБазе - Булево - Флаг о том, что расширение есть в базе
//				* Обновлен - Булево - Флаг, о том, что успешно прошло обновление расширения
//				* Описание - Строка - Описание процесса обновления: текст ошибки при обновлении.
Функция ОбновитьРасширенияПоИдентификаторам(ИдентификаторыРасширения)
	
	РезультатОбновления = Новый Соответствие;
	
	Если ТипЗнч(ИдентификаторыРасширения) = Тип("Массив") Тогда
		
		Для Каждого Идентификатор Из ИдентификаторыРасширения Цикл
			
			СтатусОбновленияРасширения = Новый Структура("ЕстьВБазе,Обновлен,Описание", Ложь, Ложь, "");
			РезультатОбновления.Вставить(Идентификатор, СтатусОбновленияРасширения);
			
		КонецЦикла;
		
	Иначе
		
		СтатусОбновленияРасширения = Новый Структура("ЕстьВБазе,Обновлен,Описание", Ложь, Ложь, "");
		РезультатОбновления.Вставить(ИдентификаторыРасширения, СтатусОбновленияРасширения);
		
	КонецЕсли;
	 	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.Ссылка,
	|	КонтурEDI_ДополнительныеСправочники.Наименование,
	|	КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.Значение КАК Идентификатор
	|ПОМЕСТИТЬ табРасширенияДляОбновления
	|ИЗ
	|	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты
	|		ПО КонтурEDI_ДополнительныеСправочники.Ссылка = КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.Ссылка
	|			И (КонтурEDI_ДополнительныеСправочники.ИмяСправочника = ""Расширения"")
	|			И (КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.ИмяРеквизита = ""Идентификатор"")
	|			И (КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.Значение В (&ИдентификаторыРасширения))
	|ГДЕ
	|	КонтурEDI_ДополнительныеСправочники.ИмяСправочника = ""Расширения""
	|
	|СГРУППИРОВАТЬ ПО
	|	КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.Ссылка,
	|	КонтурEDI_ДополнительныеСправочники.Наименование,
	|	КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.Значение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	табРасширенияДляОбновления.Ссылка,
	|	табРасширенияДляОбновления.Наименование,
	|	табИнтерфейс.Значение КАК Интерфейс,
	|	табРасширенияДляОбновления.Идентификатор,
	|	ЕСТЬNULL(табПорядокВыполнения.Значение, 0) КАК ПорядокВыполнения,
	|	ЕСТЬNULL(табИспользование.Значение, ЛОЖЬ) КАК Использование
	|ИЗ
	|	табРасширенияДляОбновления КАК табРасширенияДляОбновления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК табИнтерфейс
	|		ПО табРасширенияДляОбновления.Ссылка = табИнтерфейс.Ссылка
	|			И (табИнтерфейс.ИмяРеквизита = ""Интерфейс"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК табПорядокВыполнения
	|		ПО табРасширенияДляОбновления.Ссылка = табПорядокВыполнения.Ссылка
	|			И (табПорядокВыполнения.ИмяРеквизита = ""ПорядокВыполнения"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК табИспользование
	|		ПО табРасширенияДляОбновления.Ссылка = табИспользование.Ссылка
	|			И (табИспользование.ИмяРеквизита = ""Использование"")";
	
	Запрос.УстановитьПараметр("ИдентификаторыРасширения", ИдентификаторыРасширения);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать(); 		
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СтатусОбновленияРасширения = РезультатОбновления[ВыборкаДетальныеЗаписи.Идентификатор];
		СтатусОбновленияРасширения.ЕстьВБазе = Истина;
		
		Попытка
			
			Результат = ОбновитьРасширение(ВыборкаДетальныеЗаписи.Ссылка);
			
			Если Не Результат.Успешно Тогда
				СтатусОбновленияРасширения.Описание = Результат.ОписаниеОшибки;
			КонецЕсли;
			
			СтатусОбновленияРасширения.Обновлен = Результат.Успешно;
			
		Исключение
			
			ИнформацияОбОшибке = ИнформацияОбОшибке();   			
			
			СтатусОбновленияРасширения.Обновлен = Ложь;
			СтатусОбновленияРасширения.Описание = ИнформацияОбОшибке.Описание; 			
			
		КонецПопытки;
		
		РезультатОбновления[ВыборкаДетальныеЗаписи.Идентификатор] = СтатусОбновленияРасширения;
		
	КонецЦикла;  
	
	Возврат РезультатОбновления;

КонецФункции       

// Удаляет расширения, которые находит по переданным идентификаторам/идентификатору
//
// Параметры:
//  ИдентификаторыРасширения - Массив,Строка - Идентификатор(строка) или Идентификаторы(массив) расширений, которые нужно удалить
//
Процедура УдалитьРасширенияПоИдентификаторам(ИдентификаторыРасширения)
	 	
	РасширенияПоИдентификаторам = РасширенияПоИдентификаторам_КонтурEDI(ИдентификаторыРасширения); 
	
	Для Каждого РасширениеСсылка Из РасширенияПоИдентификаторам Цикл
		
		УдалитьРасширение(РасширениеСсылка);
		
	КонецЦикла;

КонецПроцедуры

// Получает массив ссылок на расширения по переданным идентификаторам
//
// Параметры:
//  ИдентификаторыРасширения - Массив,Строка - Идентификатор(строка) или Идентификаторы(массив) расширений, которые нужно удалить
//
//Возвращаемое значение
//  Массив со ссылками на расширения в справочнике КонтурEDI_ДополнительныеСправочники
Функция РасширенияПоИдентификаторам_КонтурEDI(ИдентификаторыРасширения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.Ссылка
	|ИЗ
	|	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты
	|		ПО КонтурEDI_ДополнительныеСправочники.Ссылка = КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.Ссылка
	|			И (КонтурEDI_ДополнительныеСправочники.ИмяСправочника = ""Расширения"")
	|			И (КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.ИмяРеквизита = ""Идентификатор"")
	|			И (КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.Значение В (&ИдентификаторыРасширения))
	|ГДЕ
	|	КонтурEDI_ДополнительныеСправочники.ИмяСправочника = ""Расширения""
	|
	|СГРУППИРОВАТЬ ПО
	|	КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.Ссылка";
	
	Запрос.УстановитьПараметр("ИдентификаторыРасширения", ИдентификаторыРасширения);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	РасширенияПоИдентификаторам = Новый Массив;
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		 		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			РасширенияПоИдентификаторам.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат РасширенияПоИдентификаторам;

КонецФункции

//настройки расширений
Функция ПолучитьДанныеОРасширенияхССервера(ТолькоРекомендуемые = Ложь, Партнер = Неопределено, ДляПоставщика = Ложь, ДляСети = Ложь, ЧастьНазвания = "") Экспорт
			
	РезультатПолученияДанных = Новый Структура("Успешно,ОписаниеОшибки,ДанныеОРасширениях",Ложь,"",Неопределено);
	
	//загружаем файл-список расширений
	МассивИменФайлов = Новый Массив;
	МассивИменФайлов.Добавить("list.xml");
	МассивИменФайлов.Добавить("list.xsl");
	
	РезультатЗагрузки = ЗагрузитьФайлыРасширенийВЛокальныйКаталог(МассивИменФайлов);
	
	Если Не РезультатЗагрузки.Успешно Тогда
		РезультатПолученияДанных.ОписаниеОшибки = РезультатЗагрузки.ОписаниеОшибки;
		Возврат РезультатПолученияДанных;
	ИначеЕсли РезультатЗагрузки.МассивЗагруженныхФайлов.Количество() = 0 Тогда
		РезультатПолученияДанных.ОписаниеОшибки = "Не удалось загрузить один или несколько файлов.";
		Возврат РезультатПолученияДанных;
	КонецЕсли;
	
	ИмяФайлаСписка = РезультатЗагрузки.МассивЗагруженныхФайлов[0];
	ИмяФайлаXSL	   = РезультатЗагрузки.МассивЗагруженныхФайлов[1];
	
	РезультатЧтения = ПрочитатьXMLпоXSL(ИмяФайлаСписка, ИмяФайлаXSL);

	Если Не РезультатЧтения.Успешно Тогда
		РезультатПолученияДанных.ОписаниеОшибки = РезультатЧтения.ОписаниеОшибки;
		Возврат РезультатПолученияДанных;
	КонецЕсли;
	
	ФайлСписка = Новый Файл(ИмяФайлаСписка);
	ФайлXSL = Новый Файл(ИмяФайлаXSL);
	
	Попытка
		УдалитьФайлы(ФайлСписка.Путь,ФайлСписка.Имя);
		УдалитьФайлы(ФайлXSL.Путь,ФайлXSL.Имя);
	Исключение
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Предупреждение, "Не удалось удалить временные файлы при установке расширения - " + ОписаниеОшибки());	
	КонецПопытки;
	
	ФайлСписка = Неопределено;
	ФайлXSL = Неопределено;
	
	ТаблицаДанныеСписка = РезультатЧтения.ДанныеЧтения;

	//получаем данные об установленных расширениях
	ИсключитьКастомныеРасширения = Истина;
	ТаблицаУстановленныеРасширения = ПолучитьДанныеОбУстановленныхРасширениях(ИсключитьКастомныеРасширения);
		
	//дополним данные списка расширений информацией об установленных расширениях
	ДополнитьДанныеСпискаРасширений(ТаблицаДанныеСписка, ТаблицаУстановленныеРасширения);
	
	//дополнить данные списка информацией о загрузке/обновлении
	УстановитьДанныеДействий(ТаблицаДанныеСписка);
	
	//отсортируем: сначала новые, потом установленные, затем кастомные и по наименованию
	ТаблицаДанныеСписка.Сортировать("Наименование");
	
	РезультатПолученияДанных.Успешно = Истина;
	
	ТаблицаДанныеСписка.Колонки.Добавить("ТипРасширения");
	
	ФильтрованныеДанные = ОтфильтроватьПодходящиеРасширения(ТаблицаДанныеСписка, ТолькоРекомендуемые, Партнер, ДляПоставщика, ДляСети, ЧастьНазвания);
	
	РезультатПолученияДанных.ДанныеОРасширениях = ФильтрованныеДанные;
	
	Возврат РезультатПолученияДанных;
	
КонецФункции

Функция ОтфильтроватьПодходящиеРасширения(ТаблицаДанныеСписка, ТолькоРекомендуемые, Партнер, ДляПоставщика, ДляСети, ЧастьНазвания)
	
	МассивПодходящихСтрок = Новый Массив;
	МассивПсевдонимовТекСетей = ПолучитьМассивПсевдонимовТекущихСетей();
	// для поиска по подстроке приведем к нижнему регистру
	ЧастьНазвания = Нрег(ЧастьНазвания);
	ПсевдонимПартнера = ?(ЗначениеЗаполнено(Партнер), ПолучитьЗначениеСвойстваОбъектаEDI(Партнер, "КодСети"), Неопределено);
	
	Для Каждого СтрокаРасширения Из ТаблицаДанныеСписка Цикл
		
		СтрокаРасширения.ТипРасширения = "3. Общие для всех режимов и конфигураций"; //Дефолт
		
		// ~~~~~~~ У расширения указана конфиуграция  ~~~~~~~
		Если СтрокаРасширения.Конфигурации.Количество() > 0 Тогда 
			Если СтрокаРасширения.Конфигурации.НайтиПоЗначению(ИмяКонфигурации1С) = Неопределено Тогда
				СтрокаРасширения.ТипРасширения = "Не подходящая конфигурация 1С";
				Продолжить //не подошла по указанной непустой конфигурации
			Иначе
				СтрокаРасширения.ТипРасширения = "2. Для вашей конфигурации";
			КонецЕсли;
		КонецЕсли;
		
		// ~~~~~~~ У расширения указан РежимФорм  ~~~~~~~
		#Если Клиент Тогда
			РежимФорм = "ОФ";
		#Иначе
			РежимФорм = "УФ";
		#КонецЕсли
		Если СтрокаРасширения.ТипФорм.НайтиПоЗначению(РежимФорм) = Неопределено 
			И СтрокаРасширения.ТипФорм.Количество() > 0 Тогда 
			СтрокаРасширения.ТипРасширения = "Не подходящий режим УФ/ОФ";
			Продолжить //не подошла по указанному непустому режиму
		КонецЕсли;
		
		// ~~~~~~~ У расширения указаны конкретные сети  ~~~~~~~
		Если СтрокаРасширения.ТорговыеСети.Количество() > 0 Тогда 
			ЕстьСеть = Ложь;
			Для Каждого Эл Из СтрокаРасширения.ТорговыеСети Цикл
				Если НЕ МассивПсевдонимовТекСетей.Найти(Эл.Значение) = Неопределено Тогда
					ЕстьСеть = Истина;
					СтрокаРасширения.ТипРасширения = "1. Для ваших торговых сетей";
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Не ЕстьСеть Тогда
				СтрокаРасширения.ТипРасширения = "Не подходящие сети";
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ (ДляПоставщика И ДляСети) Тогда
			
			// ~~~~~~~ Установлен отбор ДляПоставщика  ~~~~~~~
			Если ДляПоставщика И НЕ СтрокаРасширения.ДляПоставщика Тогда
				Продолжить;
			КонецЕсли;
			// ~~~~~~~ Установлен отбор ДляСети  ~~~~~~~
			Если ДляСети И НЕ СтрокаРасширения.ДляСети Тогда
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		// ~~~~~~~ Установлен отбор ТолькоРекомендуемые  ~~~~~~~
		Если ТолькоРекомендуемые И НЕ СтрокаРасширения.Обязательный Тогда
			Продолжить;
		КонецЕсли;
		
		// ~~~~~~~ Установлен отбор Партнер  ~~~~~~~
		Если ЗначениеЗаполнено(Партнер)
			И СтрокаРасширения.ТорговыеСети.НайтиПоЗначению(ПсевдонимПартнера) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		// ~~~~~~~ Установлен отбор ЧастьНазвания  ~~~~~~~
		НаименованиеРасширения 	= НРег(СтрокаРасширения.Наименование);
		ОписаниеРасширения 		= НРег(СтрокаРасширения.ОписаниеПолное);
		
		Если НЕ ЧастьНазвания = "" 
			И (Найти(НаименованиеРасширения, ЧастьНазвания) = 0 
			И Найти(ОписаниеРасширения, ЧастьНазвания) = 0) Тогда
			Продолжить;
		КонецЕсли;
		
		МассивПодходящихСтрок.Добавить(СтрокаРасширения);
	КонецЦикла;
	
	Возврат ТаблицаДанныеСписка.Скопировать(МассивПодходящихСтрок);
КонецФункции

Функция ПолучитьМассивПсевдонимовТекущихСетей()
	
	Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КонтурEDI_ДополнительныеРеквизиты.Значение
	               |ИЗ
	               |	РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеРеквизиты
	               |ГДЕ
	               |	КонтурEDI_ДополнительныеРеквизиты.Свойство = ""КодСети""
	               |	И КонтурEDI_ДополнительныеРеквизиты.Значение <> """"";
	
	Результат = Запрос.Выполнить();
	Возврат Результат.Выгрузить().ВыгрузитьКолонку("Значение");	
	
КонецФункции // ПолучитьПсевдонимыТекущихСетей()

Процедура УстановитьДанныеДействий(ТаблицаДанныеСписка)
	
	Для Каждого СтрокаСписка Из ТаблицаДанныеСписка Цикл
		
		Если СтрокаСписка.Устаревшее = Истина и ЗначениеЗаполнено(СтрокаСписка.ТекВерсияРасширения) Тогда
			СтрокаСписка.Установить = "удалить";
		ИначеЕсли СтрокаСписка.Устаревшее = Истина и НЕ ЗначениеЗаполнено(СтрокаСписка.ТекВерсияРасширения) Тогда
			СтрокаСписка.Установить = "устарело";
		ИначеЕсли Не ЗначениеЗаполнено(СтрокаСписка.ТекВерсияРасширения) Тогда
			СтрокаСписка.Установить = "установить";
		ИначеЕсли СтрокаСписка.ВерсияРасширения > СтрокаСписка.ТекВерсияРасширения Тогда
			СтрокаСписка.Установить = "обновить";
		Иначе
			СтрокаСписка.Установить = "подключен";
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДополнитьДанныеСпискаРасширений(ТаблицаДанныеСписка, ТаблицаУстановленныеРасширения)
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаУстановленныеРасширения, "Обработан,ДляПоставщика,ДляСети", Новый ОписаниеТипов("Булево")); 
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаУстановленныеРасширения, "Конфигурации,ТипФорм,ТорговыеСети", Новый ОписаниеТипов("СписокЗначений")); 
	
	//дополняем информацию по установленным расширениям
	Для Каждого СтрокаСписка Из ТаблицаДанныеСписка Цикл
		
		СтрокаУстановлено = ТаблицаУстановленныеРасширения.Найти(СтрокаСписка.Идентификатор, "Идентификатор");
		Если СтрокаУстановлено = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаСписка.Использование 	= СтрокаУстановлено.Использование;
		СтрокаСписка.Ссылка 		= СтрокаУстановлено.Ссылка;
		СтрокаСписка.Настройка		= СтрокаУстановлено.Настройка;
		
		Для Каждого КолонкаСписка Из ТаблицаДанныеСписка.Колонки Цикл
			Если Лев(КолонкаСписка.Имя,3) = "Тек" Тогда
				СтрокаСписка[КолонкаСписка.Имя] = СтрокаУстановлено[СтрЗаменить(КолонкаСписка.Имя,"Тек","")];	
			КонецЕсли;
		КонецЦикла;
		
		СтрокаУстановлено.Обработан = Истина;
		
	КонецЦикла;
	
	// Не дополняем информацию по расширениям, созданным самостоятельно
		
КонецПроцедуры

Функция ПолучитьТаблицуНастроекРасширения(Знач РасширениеСсылка) Экспорт
	
	Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.ИмяРеквизита КАК СТРОКА(50)) КАК Имя,
	|	ВЫРАЗИТЬ(КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.Значение КАК СТРОКА(100)) КАК Вариант,
	|	КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.ЗначениеСтрока КАК Значение
	|ИЗ
	|	Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты
	|ГДЕ
	|	КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.Ссылка = &РасширениеСсылка
	|	И КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.ИмяРеквизита ПОДОБНО ""Настройка"" + ""%""";
	
	Запрос.УстановитьПараметр("РасширениеСсылка", ПреобразоватьЗначениеДляВнешнегоХранилища(РасширениеСсылка));
	Если ВнешнееХранилище Тогда
		ТаблицаНастроек = ПолучитьТаблицуИзВнешнейБазы(Запрос.Выполнить().Выгрузить());
	Иначе
		ТаблицаНастроек = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
 	
	Возврат ТаблицаНастроек;
	
КонецФункции

Функция ИнициализироватьТаблицуНастроекРасширения() Экспорт
	
	ТаблицаНастроек = Новый ТаблицаЗначений;
	ТаблицаНастроек.Колонки.Добавить("Имя");
	ТаблицаНастроек.Колонки.Добавить("Вариант");
	ТаблицаНастроек.Колонки.Добавить("Значение");
	
	Возврат ТаблицаНастроек;
	
КонецФункции

Функция СохранитьНастройкиРасширения(РасширениеСсылка, ТаблицаНастроек) Экспорт
	
	РезультатСохранения = Новый Структура("Успешно,ОписаниеОшибки",Ложь,"");
	
	Если РасширениеСсылка = Неопределено 					 или
		 Не ТипЗнч(ТаблицаНастроек) = Тип("ТаблицаЗначений") или
		 ТаблицаНастроек.Количество() = 0 					 Тогда 
		РезультатСохранения.ОписаниеОшибки = "Не удалось сохранить настройки: переданы некорректные данные.";
		Возврат РезультатСохранения;
	КонецЕсли;
	
	СтруктураЭлемента = ИнициализироватьТаблицуДополнительныхРеквизитовРасширения();
	Для Каждого Строка Из ТаблицаНастроек Цикл
		Настройка = СтруктураЭлемента.Добавить();
		Настройка.ИмяРеквизита 		= Строка.Имя;
		Настройка.Значение 	  		= Строка.Вариант;
		Настройка.ЗначениеСтрока    = Строка.Значение;
	КонецЦикла;
	
	Попытка
		СохранитьЭлементСправочника("Расширения",РасширениеСсылка,СтруктураЭлемента);
		РезультатСохранения.Успешно = Истина;
	Исключение
		_ОписаниеОшибки = ОписаниеОшибки();
		РезультатСохранения.ОписаниеОшибки = "Не удалось сохранить настройки: " + _ОписаниеОшибки + ".";
	КонецПопытки;
	
	Возврат РезультатСохранения;
			
КонецФункции

Функция СохранитьРасширение(Форма,Управляемая=ложь) Экспорт
	
	РезультатСохранения = Новый Структура("Успешно,ОписаниеОшибкиСохранения,ТаблицаОшибокПроверки,Идентификатор",Ложь,"","");
	
	РезультатПроверки = ПроверитьКорректностьДанныхРасширения(Форма,Управляемая);
	Если Не РезультатПроверки.Успешно Тогда
		РезультатСохранения.ТаблицаОшибокПроверки = РезультатПроверки.ТаблицаОшибок;
		Возврат РезультатСохранения;
	КонецЕсли;
	
	ТаблицаДанныеРасширения = ИнициализироватьТаблицуДополнительныхРеквизитовРасширения();
	
	ИдентификаторРасширения = Неопределено;
	
	Если Форма.РасширениеСсылка = Неопределено Тогда
		
		//добавляем данные нового события
		Идентификатор = ТаблицаДанныеРасширения.Добавить();
		Идентификатор.ИмяРеквизита 				= "Идентификатор";
		Идентификатор.Значение 					= Формат(ТекущаяДата(),"ДФ=ггггММддЧЧммсс");;
		НаименованиеРасширения = ТаблицаДанныеРасширения.Добавить();
		НаименованиеРасширения.ИмяРеквизита 	= "Наименование";
		НаименованиеРасширения.Значение 		= Форма.Наименование;
		ВерсияРасширения = ТаблицаДанныеРасширения.Добавить();
		ВерсияРасширения.ИмяРеквизита 			= "ВерсияРасширения";
		ВерсияРасширения.Значение 				= "0.0";
		РекомендуемаяВерсияМодуля = ТаблицаДанныеРасширения.Добавить();
		РекомендуемаяВерсияМодуля.ИмяРеквизита 	= "РекомендуемаяВерсияМодуля";
		РекомендуемаяВерсияМодуля.Значение 		= "0.00.000.00";
		Обязательный = ТаблицаДанныеРасширения.Добавить();
		Обязательный.ИмяРеквизита 				= "Обязательный";
		Обязательный.Значение 					= Ложь;
		Интерфейс = ТаблицаДанныеРасширения.Добавить();
		Интерфейс.ИмяРеквизита 					= "Интерфейс";
		Интерфейс.Значение 						= Ложь;
		ПорядокВыполнения = ТаблицаДанныеРасширения.Добавить();
		ПорядокВыполнения.ИмяРеквизита 			= "ПорядокВыполнения";
		ПорядокВыполнения.Значение 				= ПолучитьСледующийПорядокВыполненияРасширения();
		Использование = ТаблицаДанныеРасширения.Добавить();
		Использование.ИмяРеквизита 				= "Использование";
		Использование.Значение 					= Истина;
		
		ИдентификаторРасширения	= Идентификатор.Значение;
		
	КонецЕсли;
	
	//добавляем даные обработчиков событий
	Для Каждого Событие Из Форма.События Цикл
		НовыйРеквизит = ТаблицаДанныеРасширения.Добавить();
		НовыйРеквизит.ИмяРеквизита 		= "ИсполняемыйКод";
		НовыйРеквизит.Значение 			= Событие.Имя;
		НовыйРеквизит.ЗначениеСтрока 	= Событие.Код;
	КонецЦикла;
	
	//добавляем данные описания
	НовыйРеквизит = ТаблицаДанныеРасширения.Добавить();
	НовыйРеквизит.ИмяРеквизита 		= "ОписаниеПолное";
	НовыйРеквизит.ЗначениеСтрока 	= Форма.ОписаниеПолное;
	
	СохранитьЭлементСправочника("Расширения",Форма.РасширениеСсылка,ТаблицаДанныеРасширения);
	Если Форма.РасширениеСсылка = Неопределено Тогда
		РезультатСохранения.ОписаниеОшибкиСохранения = "Не удалось записать расширение в базу данных.";
		Возврат РезультатСохранения;
	КонецЕсли;
		
	РезультатСохранения.Успешно 		= Истина;
	РезультатСохранения.Идентификатор	= ИдентификаторРасширения;
	
	Возврат РезультатСохранения;
	 
КонецФункции

Функция ПроверитьКорректностьДанныхРасширения(Форма,Управляемая=Ложь) Экспорт
			
	ТаблицаОшибок = Новый ТаблицаЗначений;
	ТаблицаОшибок.Колонки.Добавить("ОписаниеОшибки");
	
	РезультатПроверки = Новый Структура("Успешно,ТаблицаОшибок",Ложь,ТаблицаОшибок);
		
	//наличие наименование
	Если Не ЗначениеЗаполнено(Форма.Наименование) Тогда
		НоваяСтрока = ТаблицаОшибок.Добавить();
		НоваяСтрока.ОписаниеОшибки = "Не заполнено поле ""Наименование"".";
		РезультатПроверки.Успешно = Ложь;
		//Форма.ЭлементыФормы.Наименование.ЦветФонаПоля = WebЦвета.СветлоРозовый;
		УстановитьЦветЭлементаФормы(Форма,"Наименование",Ложь,Управляемая);
	Иначе
		//Форма.ЭлементыФормы.Наименование.ЦветФонаПоля = WebЦвета.Белый;
		УстановитьЦветЭлементаФормы(Форма,"Наименование",Истина,Управляемая);
	КонецЕсли;
	
	//наличие обработчиков
	Если Форма.События.Количество() = 0 Тогда
		НоваяСтрока = ТаблицаОшибок.Добавить();
		НоваяСтрока.ОписаниеОшибки = "Расширение не содержит ни одного события.";
		РезультатПроверки.Успешно = Ложь;
		//Форма.ЭлементыФормы.События.ЦветФонаПоля = WebЦвета.СветлоРозовый;
		УстановитьЦветЭлементаФормы(Форма,"События",Ложь,Управляемая);
	Иначе
		//Форма.ЭлементыФормы.События.ЦветФонаПоля = WebЦвета.Белый;
		УстановитьЦветЭлементаФормы(Форма,"События",Истина,Управляемая);
	КонецЕсли;
	
	//наличие описания
	Если Не ЗначениеЗаполнено(Форма.ОписаниеПолное) Тогда
		НоваяСтрока = ТаблицаОшибок.Добавить();
		НоваяСтрока.ОписаниеОшибки = "Не заполнено поле ""Описание"".";
		РезультатПроверки.Успешно = Ложь;
		//Форма.ЭлементыФормы.ОписаниеПолное.ЦветФонаПоля = WebЦвета.СветлоРозовый;
		УстановитьЦветЭлементаФормы(Форма,"ОписаниеПолное",Ложь,Управляемая);
	Иначе
		//Форма.ЭлементыФормы.ОписаниеПолное.ЦветФонаПоля = WebЦвета.Белый;
		УстановитьЦветЭлементаФормы(Форма,"ОписаниеПолное",Истина,Управляемая);
	КонецЕсли;
	
	Если ТаблицаОшибок.Количество() = 0 Тогда
		РезультатПроверки.Успешно = Истина;
	Иначе
		РезультатПроверки.ТаблицаОшибок = ТаблицаОшибок;
	КонецЕсли;
	
	Возврат РезультатПроверки;
	
КонецФункции

Процедура УстановитьЦветЭлементаФормы(Форма,ИмяЭлемента,Хороший=Истина,Управляемая=Ложь)Экспорт
	
	Если Управляемая Тогда
		Элемент=Форма.Элементы.Найти(ИмяЭлемента);	
		Если Элемент<>Неопределено Тогда
			Элемент.ЦветФона = ?(Хороший,WebЦвета.Белый,WebЦвета.СветлоРозовый);
		КонецЕсли;
	Иначе
		Элемент=Форма.ЭлементыФормы.Найти(ИмяЭлемента);	
		Если Элемент<>Неопределено Тогда
			Элемент.ЦветФонаПоля = ?(Хороший,WebЦвета.Белый,WebЦвета.СветлоРозовый);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Автоматически обновляет типовые неизмененные расширения в случае такой возможности и необходимости
Процедура АвтообновлениеРасширений() Экспорт

	Если Не ПроверитьВозможностьАвтообновленияРасширений() Тогда
		Возврат;
	КонецЕсли;
	
	РезультатПроверки = ПроверитьНеобходимостьАвтообновленияРасширений();
	
	Если Не РезультатПроверки.Успешно Тогда
		Возврат;
	КонецЕсли;

	Состояние_КонтурEDI("Выполняется автообновления расширений...");
	
	РезультатАвтообновления = Новый Структура();
	РезультатАвтообновления.Вставить("Успешно", Истина);
	РезультатАвтообновления.Вставить("ТекстОшибки", "");
	
	ОбновленныеРасширения = Новый Массив;

	Для Каждого Расширение Из РезультатПроверки.ТаблицаАвтообновляемыхРасширений Цикл
		
		Попытка
			РезультатОбновления = ОбновитьРасширение(Расширение.Ссылка);
			
			Если РезультатОбновления.Успешно Тогда
				ОбновленныеРасширения.Добавить(Расширение.Идентификатор);
			КонецЕсли;
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();   			
			РезультатОбновления = Новый Структура("Успешно, ОписаниеОшибки", Ложь, ИнформацияОбОшибке.Описание); 			
		КонецПопытки;
		
		Если Не РезультатОбновления.Успешно Тогда
			РезультатАвтообновления.ТекстОшибки = РезультатАвтообновления.ТекстОшибки  + "Не удалось обновить расширение " 
												+ Расширение.Идентификатор + Символы.ПС + РезультатОбновления.ОписаниеОшибки + Символы.ПС;
		КонецЕсли;	
		
		РезультатАвтообновления.Успешно = РезультатАвтообновления.Успешно И РезультатОбновления.Успешно;
				
	КонецЦикла;
	
	Если ОбновленныеРасширения.Количество() > 0 Тогда
		РезультатАвтообновления.Вставить("ОбновленныеРасширения", ОбновленныеРасширения);
	КонецЕсли;
	
	Метрика_ОбработатьРезультатАвтообновления("АвтообновлениеРасширений", РезультатАвтообновления);
	
	Состояние_КонтурEDI("");
	
КонецПроцедуры

Функция АвтообновлениеРасширенийВключено() Экспорт
	
	АвтообновлениеРасширений = ПолучитьКонстантуEDI("АвтообновлениеРасширений");
	
	Если АвтообновлениеРасширений = Истина Тогда
		Возврат Истина;                     
	ИначеЕсли АвтообновлениеРасширений = Ложь Тогда
		Возврат Ложь;
	Иначе
		Возврат Не ПараметрыКлиентСервер.ДоменПользователяКонтур;
	КонецЕсли;
	
КонецФункции

Функция ПроверитьВозможностьАвтообновленияРасширений()
	
	Если Не ЕстьОбъектыХраненияДанных_КонтурEDI() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не АвтообновлениеРасширенийВключено()Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ПроверитьНаличиеМетаданныхХраненияРасширений() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ПроверитьВозможностьОбновленияЭлементаСправочникаРасширений() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПроверитьВозможностьОбновленияЭлементаСправочникаРасширений()
	
	УстановитьПривилегированныйРежим(Истина);
	
	НачатьТранзакцию();
	
	Попытка
		
		ЭлементСправочника = Справочники.КонтурEDI_ДополнительныеСправочники.СоздатьЭлемент();
		ЭлементСправочника.ИмяСправочника = "Расширения";
		ЭлементСправочника.Наименование = "Проверка возможности записи и удаления элемента справочника";
		ЭлементСправочника.Записать();
		ЭлементСправочника.Удалить();
		
		РезультатПроверки = Истина;
		
	Исключение
		
		РезультатПроверки = Ложь;
		
	КонецПопытки;
	
	Если ТранзакцияАктивна() Тогда
		ОтменитьТранзакцию();
	КонецЕсли;
				
	Возврат РезультатПроверки;	
	
КонецФункции
	
Функция ПроверитьНеобходимостьАвтообновленияРасширений()

	РезультатПроверки = Расширения_ПроверитьОбновленияРасширений();
		
	Если РезультатПроверки.Успешно Тогда
		
		ТаблицаАвтообновляемыхРасширений = РезультатПроверки.ТаблицаДанныхОбУстановленныхРасширениях.Скопировать(Новый Структура("Обновить, Измененное", Истина, Ложь));
		
		Если ТаблицаАвтообновляемыхРасширений.Количество() > 0 Тогда
			РезультатПроверки.Вставить("ТаблицаАвтообновляемыхРасширений", ТаблицаАвтообновляемыхРасширений);
		Иначе
			РезультатПроверки.Успешно = Ложь;
		КонецЕсли;
		
		РезультатПроверки.Удалить("ТаблицаДанныхОбУстановленныхРасширениях");
		
	КонецЕсли;
	
	Возврат РезультатПроверки;
	
КонецФункции

