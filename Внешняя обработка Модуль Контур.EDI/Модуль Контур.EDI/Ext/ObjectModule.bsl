Функция КриптографияПереопределяемый_МенеджерНастроек()
	
	КлючКэша = "Криптография_МенеджерНастроек"; 
	
	МенеджерНастроек = ЭДО_Кэш_Прочитать(КлючКэша);
	
	Если МенеджерНастроек = Неопределено Тогда
		
		МенеджерНастроек = Криптография_НовыйМенеджерНастроек();
		
		ЭДО_Кэш_Поместить(КлючКэша, МенеджерНастроек); 
		
	КонецЕсли;
	
	
    Возврат МенеджерНастроек;

КонецФункции

Функция КриптографияПереопределяемый_Подписать(ИсходныеДанные, ОтпечатокСертификата, ПарольДоступаКЗакрытомуКлючу = Неопределено, Расположение = "сервер")
	Перем ДанныеАвторизации;
	
	Результат = Неопределено;
	
	Если НЕ ЭтоУФ() И НЕ Расположение = ВариантРасположенияКриптографииКлиент() И МодульСервернойКриптографииДоступен() Тогда
		
		ДанныеАвторизации = ПолучитьСтруктуруДанныхАвторизации();
		ДанныеАвторизации.Отпечаток 		= ОтпечатокСертификата;
		ДанныеАвторизации.ПарольКонтейнера 	= ПарольДоступаКЗакрытомуКлючу;
		ДанныеАвторизации.Расположение 		= Расположение;
		
		ДанныеАвторизации.Вставить("ПутьМодуляКриптографии", Криптография_ПутиМодуляКриптографии());
		
		ДополнитьСтруктуруНастройкамиКриптографииДляСервера(ДанныеАвторизации);
		
		Если ЭтоАдресВременногоХранилища(ИсходныеДанные) Тогда
			АдресВоВременномХранилище = ИсходныеДанные;
		Иначе
			Если ТипЗнч(ИсходныеДанные) = Тип("Строка") Тогда
				ДвоичныеИсходныеДанные = Новый ДвоичныеДанные(ИсходныеДанные);
			Иначе
				ДвоичныеИсходныеДанные = ИсходныеДанные
			КонецЕсли;
			АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеИсходныеДанные);
		КонецЕсли;
		
		РезультатПодписания = ИнициализироватьСтруктуруРезультатаФункции(Ложь);
			
		Для Повтор = 1 По 2 Цикл
			РезультатПодписания = МодульСервернойКриптографии().ПолучитьПодписьФайлаДокумента(АдресВоВременномХранилище, ДанныеАвторизации, РезультатПодписания);
			
			Если НЕ РезультатПодписания.Успешно Тогда 				
				ВариантНастройки = Криптография_ОбработатьВариантНастройкиИзТекстаОшибки(РезультатПодписания.ОписаниеОшибки);
				
				Если ВариантНастройки <> Неопределено Тогда
					ДанныеАвторизации.ТипМодуляКриптографии = ВариантНастройки.ТипМодуляКриптографии;
					ДанныеАвторизации.ИмяМодуляКриптографии = ВариантНастройки.ИмяМодуляКриптографии;
                    Продолжить;
				Иначе
					ВызватьИсключение РезультатПодписания.ОписаниеОшибки;	
				КонецЕсли;
			Иначе
				Прервать;
			КонецЕсли;
		КонецЦикла;		
		
		Результат = Base64Значение(РезультатПодписания.ШифрованнаяПодпись);
		
	КонецЕсли;
		
	Возврат Результат;

КонецФункции

Функция КриптографияПереопределяемый_Расшифровать(ИсходныеДанные, Сертификат = Неопределено, ПарольДоступаКЗакрытомуКлючу  = Неопределено, Расположение = "сервер")
	Перем ДанныеАвторизации;
	
	Результат = Неопределено;
	
	Если НЕ ЭтоУФ() И НЕ Расположение = ВариантРасположенияКриптографииКлиент() И МодульСервернойКриптографииДоступен() Тогда
		
		ДанныеАвторизации = ПолучитьСтруктуруДанныхАвторизации();
		ДанныеАвторизации.ПарольКонтейнера 	= ПарольДоступаКЗакрытомуКлючу;
		ДанныеАвторизации.Расположение 		= Расположение;
		
		ДанныеАвторизации.Вставить("ПутьМодуляКриптографии", Криптография_ПутиМодуляКриптографии());
		
		ДополнитьСтруктуруНастройкамиКриптографииДляСервера(ДанныеАвторизации);
		
		Попытка
			Результат = МодульСервернойКриптографии().РасшифроватьЗашифрованныйТокен(ИсходныеДанные, ДанныеАвторизации);
		Исключение	
			ОписаниеОшибки = ОписаниеОшибки();
			ВариантНастройки = Криптография_ОбработатьВариантНастройкиИзТекстаОшибки(ОписаниеОшибки);
			
			Если ВариантНастройки <> Неопределено Тогда
				ДанныеАвторизации.ТипМодуляКриптографии = ВариантНастройки.ТипМодуляКриптографии;
				ДанныеАвторизации.ИмяМодуляКриптографии = ВариантНастройки.ИмяМодуляКриптографии;
				Результат = МодульСервернойКриптографии().РасшифроватьЗашифрованныйТокен(ИсходныеДанные, ДанныеАвторизации);
			Иначе
				ВызватьИсключение ОписаниеОшибки;
			КонецЕсли;
			
		КонецПопытки;			
		
		Результат = Base64Значение(Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КриптографияПереопределяемый_НайтиПоОтпечатку(Отпечаток, Расположение = "сервер")
	Перем ДанныеАвторизации;
	
	Результат = Неопределено;
	
	Если НЕ ЭтоУФ() И НЕ Расположение = ВариантРасположенияКриптографииКлиент() И МодульСервернойКриптографииДоступен() Тогда	
		
		ДанныеАвторизации = ПолучитьСтруктуруДанныхАвторизации();
		ДанныеАвторизации.Расположение 		= Расположение;
		ДанныеАвторизации.Отпечаток			= Отпечаток;
		ДанныеАвторизации.Вставить("ПутьМодуляКриптографии", Криптография_ПутиМодуляКриптографии());
		
		ДополнитьСтруктуруНастройкамиКриптографииДляСервера(ДанныеАвторизации);	
		
		Результат = МодульСервернойКриптографии().ПолучитьСертификат1СПоОтпечаткуСтруктура(ДанныеАвторизации);
		
		ДанныеСертификата = МодульСервернойКриптографии().ПолучитьСертификат1СПоОтпечаткуBase64(ДанныеАвторизации);
		Результат.Вставить("ДвоичныеДанные", Base64Значение(ДанныеСертификата));
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КриптографияПереопределяемый_ПолучитьСертификатыДляПодписиШифрования(ТолькоДействующие, Расположение)

	Результат = Неопределено;
	
	Если Расположение = ВариантРасположенияКриптографииСервер() И МодульСервернойКриптографииДоступен() Тогда
		
		НастройкиКриптографии = Новый Структура;
		ДополнитьСтруктуруНастройкамиКриптографииДляСервера(НастройкиКриптографии);
		
		Результат = МодульСервернойКриптографии().МассивСертификатов(НастройкиКриптографии, ТолькоДействующие); 
		
	ИначеЕсли ЭтоУФ() И EDI_ИнформационнаяБазаФайловая() Тогда
		
		Результат = Новый Массив;
		
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

