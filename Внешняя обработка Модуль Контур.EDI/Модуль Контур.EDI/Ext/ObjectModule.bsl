Процедура ДобавитьОбязательноеПоле_НакладнаяEDI(Сообщение, ТаблицаОбязательныхПолей)
	
	НакладнаяEDI_Обязательна = 
	(Сообщение.ТипСообщения = "RECADV" И ПолучитьКонстантуEDI("РазрешитьПустойDespatchId_В_RECADV") <> Истина)
	ИЛИ Сообщение.ТипСообщения = "RETANN" 
	ИЛИ Сообщение.ТипСообщения = "RETDES";
	
	Если НакладнаяEDI_Обязательна Тогда
		
		ДобавитьОбязательноеПоле(ТаблицаОбязательныхПолей, "НакладнаяEDI.Номер");
		ДобавитьОбязательноеПоле(ТаблицаОбязательныхПолей, "НакладнаяEDI.Дата");
		
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьОбязательноеПоле_ЗаказEDI(Сообщение, ТаблицаОбязательныхПолей)
	
	ЗаказEDI_Обязателен = 
	НЕ Сообщение.ТипСообщения = "ORDERS" 
	И НЕ Сообщение.ТипСообщения = "PORDERS" 
	И НЕ Сообщение.ТипСообщения = "RETINS"
	И НЕ Сообщение.ТипСообщения = "PRICELIST"
	И НЕ Сообщение.ТипСообщения = "PRICAT"
	И НЕ Сообщение.ТипСообщения = "SLSRPT"
	И НЕ Сообщение.ТипСообщения = "INVRPT"
	И НЕ Сообщение.ТипСообщения = "IFTMBC";
	
	Если ЗаказEDI_Обязателен Тогда
		
		ДобавитьОбязательноеПоле(ТаблицаОбязательныхПолей, "ЗаказEDI.Номер");
		
		Если НЕ Сообщение.ТипСообщения = "RETREC" Тогда
			ДобавитьОбязательноеПоле(ТаблицаОбязательныхПолей, "ЗаказEDI.Дата");
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьОбязательноеПоле_КодТовараПокупателя(Сообщение, ТаблицаОбязательныхПолей)
	
