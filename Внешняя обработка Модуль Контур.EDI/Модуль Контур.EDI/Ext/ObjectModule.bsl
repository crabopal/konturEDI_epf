Функция ПодготовитьБуферXML(ИмяСтруктуры,ТипСообщения)
	
	СтруктураДокумента = ПолучитьМаппингПолейXML(ИмяСтруктуры,ТипСообщения);//это вызывается повторно
	
	Если ДлительнаяОперация = Истина Тогда
		БуферХМЛ = КэшДлительнойОперации.Получить("БуферХМЛ");
		Если БуферХМЛ = Неопределено Тогда
			БуферХМЛ = Новый Соответствие;
			КэшДлительнойОперации.Вставить("БуферХМЛ", БуферХМЛ);
		КонецЕсли;
		СтрокаСтруктуры = БуферХМЛ.Получить(ТипСообщения);
		Если НЕ СтрокаСтруктуры = Неопределено Тогда
			Возврат ЗначениеИзСтрокиВнутр(СтрокаСтруктуры);
		КонецЕсли;
	КонецЕсли;
	
	Структура = Новый Структура();
	
	Для Каждого Стр Из СтруктураДокумента Цикл
		
		ЗначениеПоля = "";
		
		Если НЕ Стр.ИмяСтруктуры = Неопределено Тогда
			
			ОписаниеПоля = ПолучитьМаппингПолейXML(Стр.ИмяСтруктуры,ТипСообщения);
			
			Если Стр.ЭтоСписок Тогда
				
				ЗначениеПоля = Новый ТаблицаЗначений;
				Для Каждого СтрПоля ИЗ ОписаниеПоля Цикл
					ЗначениеПоля.Колонки.Добавить(СтрПоля.ИмяПоля);
				КонецЦикла;
				
			Иначе	
				
				ЗначениеПоля = Новый Структура();
				Для Каждого СтрПоля Из ОписаниеПоля Цикл
					ЗначениеПоля.Вставить(СтрПоля.ИмяПоля);
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Структура.Вставить(Стр.ИмяПоля,ЗначениеПоля);
		
	КонецЦикла;
	
	Если ДлительнаяОперация = Истина Тогда
        БуферХМЛ.Вставить(ТипСообщения,ЗначениеВСтрокуВнутр(Структура));
	КонецЕсли;
		
	Возврат Структура;
	
КонецФункции

Функция ПодготовитьВложенныйБуферXML(ИмяСтруктуры,ТипСообщения)
	
	ОписаниеПоляВлож = ПолучитьМаппингПолейXML(ИмяСтруктуры,ТипСообщения);
	ЗначениеПоляВлож = Новый ТаблицаЗначений;
	Для Каждого СтрПоляВлож ИЗ ОписаниеПоляВлож Цикл
		ЗначениеПоляВлож.Колонки.Добавить(СтрПоляВлож.ИмяПоля);
	КонецЦикла;
	Возврат ЗначениеПоляВлож;
	
КонецФункции

Процедура ЗаполнитьЮрФизЛицо(ЮрФизЛицоXML,ЮрФизЛицоEDI)
	
	ЮрФизЛицоEDI.GLN					= ЮрФизЛицоXML.GLN;
	ЮрФизЛицоEDI.Наименование			= ЮрФизЛицоXML.Наименование;
	ЮрФизЛицоEDI.Фамилия				= ЮрФизЛицоXML.Фамилия;
	ЮрФизЛицоEDI.Имя					= ЮрФизЛицоXML.Имя;
	ЮрФизЛицоEDI.Отчество				= ЮрФизЛицоXML.Отчество;
	ЮрФизЛицоEDI.Телефон				= ЮрФизЛицоXML.Телефон;
	ЮрФизЛицоEDI.Банк					= ЮрФизЛицоXML.Банк;
	ЮрФизЛицоEDI.БИК					= ЮрФизЛицоXML.БИК;
	ЮрФизЛицоEDI.НомерСчета				= ЮрФизЛицоXML.НомерСчета;
	ЮрФизЛицоEDI.КоррСчет				= ЮрФизЛицоXML.КоррСчет;
	ЮрФизЛицоEDI.Руководитель			= ЮрФизЛицоXML.Руководитель;
	ЮрФизЛицоEDI.ГлавныйБухгалтер		= ЮрФизЛицоXML.ГлавныйБухгалтер;
	ЮрФизЛицоEDI.КодВСистемеПокупателя	= ЮрФизЛицоXML.КодВСистемеПокупателя;
	ЮрФизЛицоEDI.ТипЛокализации			= ЮрФизЛицоXML.ТипЛокализации;
	
	Если ЗначениеЗаполнено(ЮрФизЛицоXML.КодРегиона) ИЛИ ЗначениеЗаполнено(ЮрФизЛицоXML.Улица) Тогда
		ЮрФизЛицоEDI.Адрес.ВидАдреса = "Российский";
	КонецЕсли;
	
	ЮрФизЛицоEDI.Адрес.Город = ЮрФизЛицоXML.Город;
	ЮрФизЛицоEDI.Адрес.Дом = ЮрФизЛицоXML.Дом;
	ЮрФизЛицоEDI.Адрес.Индекс = ЮрФизЛицоXML.Индекс;
	ЮрФизЛицоEDI.Адрес.Квартира = ЮрФизЛицоXML.Квартира;
	ЮрФизЛицоEDI.Адрес.Корпус = ЮрФизЛицоXML.Корпус;
	ЮрФизЛицоEDI.Адрес.НаселенныйПункт = ЮрФизЛицоXML.НаселенныйПункт;
	ЮрФизЛицоEDI.Адрес.Район = ЮрФизЛицоXML.Район;
	ЮрФизЛицоEDI.Адрес.Регион = ЮрФизЛицоXML.КодРегиона;
	ЮрФизЛицоEDI.Адрес.Улица = ЮрФизЛицоXML.Улица;
	
	Если ЗначениеЗаполнено(ЮрФизЛицоXML.Наименование) ИЛИ ЗначениеЗаполнено(ЮрФизЛицоXML.ИНН_ЮЛ) ИЛИ ЗначениеЗаполнено(ЮрФизЛицоXML.КПП) Тогда
		ЮрФизЛицоEDI.Вид = "ЮрЛицо";
		ЮрФизЛицоEDI.ИНН = ЮрФизЛицоXML.ИНН_ЮЛ;
		ЮрФизЛицоEDI.КПП = ЮрФизЛицоXML.КПП;
	Иначе
		ЮрФизЛицоEDI.Вид = "ФизЛицо";
		ЮрФизЛицоEDI.ИНН = ЮрФизЛицоXML.ИНН_ФЛ;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьЗначениеСвойстваXDTO(ОбъектXDTO,ИмяСвойства) Экспорт
	
	ТекЗначение = Неопределено;
	Если НЕ ОбъектXDTO.Свойства().Получить(ИмяСвойства) = Неопределено Тогда
		Возврат ОбъектXDTO[ИмяСвойства];
	КонецЕсли;
	
	Возврат ТекЗначение;
	
КонецФункции

Процедура ЗаполнитьЮрФизЛицоXDTO(ЮрФизЛицоEDI,ЮрФизЛицоXDTO)

	Если ЮрФизЛицоXDTO = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЮрФизЛицоEDI.GLN = ЮрФизЛицоXDTO.GLN;
	
	Если НЕ ПолучитьЗначениеСвойстваXDTO(ЮрФизЛицоXDTO,"organization") = Неопределено Тогда
		
		ЮрФизЛицоEDI.Вид = "ЮрЛицо";
		ЮрФизЛицоEDI.Наименование	= ПолучитьЗначениеСвойстваXDTO(ЮрФизЛицоXDTO.organization,"name");
		ЮрФизЛицоEDI.ИНН			= ПолучитьЗначениеСвойстваXDTO(ЮрФизЛицоXDTO.organization,"inn");
		ЮрФизЛицоEDI.КПП			= ПолучитьЗначениеСвойстваXDTO(ЮрФизЛицоXDTO.organization,"kpp");
		
	КонецЕсли;
	
	Если НЕ ПолучитьЗначениеСвойстваXDTO(ЮрФизЛицоXDTO,"selfEmployed") = Неопределено Тогда
		
		Если НЕ ПолучитьЗначениеСвойстваXDTO(ЮрФизЛицоXDTO.selfEmployed,"inn") = Неопределено Тогда
			
			ЮрФизЛицоEDI.Вид = "ФизЛицо";
			ЮрФизЛицоEDI.ИНН = ПолучитьЗначениеСвойстваXDTO(ЮрФизЛицоXDTO.selfEmployed,"inn");
			
			Если НЕ ПолучитьЗначениеСвойстваXDTO(ЮрФизЛицоXDTO.selfEmployed,"fullName") = Неопределено Тогда
				
				ЮрФизЛицоEDI.Фамилия			= ПолучитьЗначениеСвойстваXDTO(ЮрФизЛицоXDTO.selfEmployed.fullName,"lastName");
				ЮрФизЛицоEDI.Имя				= ПолучитьЗначениеСвойстваXDTO(ЮрФизЛицоXDTO.selfEmployed.fullName,"firstName");
				ЮрФизЛицоEDI.Отчество			= ПолучитьЗначениеСвойстваXDTO(ЮрФизЛицоXDTO.selfEmployed.fullName,"middleName");
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;	
	
	Если НЕ ПолучитьЗначениеСвойстваXDTO(ЮрФизЛицоXDTO,"foreignOrganization") = Неопределено Тогда
		
		ИНН				= ПолучитьЗначениеСвойстваXDTO(ЮрФизЛицоXDTO.foreignOrganization,"tin");
		Наименование	= ПолучитьЗначениеСвойстваXDTO(ЮрФизЛицоXDTO.foreignOrganization,"name");
		
		Если ЗначениеЗаполнено(ИНН) ИЛИ ЗначениеЗаполнено(Наименование) Тогда
			
			ЮрФизЛицоEDI.Вид	= "Нерезидент";
			ЮрФизЛицоEDI.ИНН	= ИНН;
			ЮрФизЛицоEDI.Наименование = Наименование;
			
			ЮрФизЛицоEDI.Адрес.ВидАдреса = "Иностранный";
			ЮрФизЛицоEDI.Адрес.КодСтраны = ПолучитьЗначениеСвойстваXDTO(ЮрФизЛицоXDTO.foreignOrganization,"countryCode");
			
		КонецЕсли;
			
	КонецЕсли;
	
	Если НЕ ЮрФизЛицоEDI.Адрес.ВидАдреса = "Иностранный" Тогда
		
		Если НЕ ПолучитьЗначениеСвойстваXDTO(ЮрФизЛицоXDTO,"russianAddress") = Неопределено Тогда
			
			ЮрФизЛицоEDI.Адрес.ВидАдреса = "Российский";
			ЮрФизЛицоEDI.Адрес.Город			= ПолучитьЗначениеСвойстваXDTO(ЮрФизЛицоXDTO.russianAddress,"city");
			ЮрФизЛицоEDI.Адрес.Дом				= ПолучитьЗначениеСвойстваXDTO(ЮрФизЛицоXDTO.russianAddress,"house");
			ЮрФизЛицоEDI.Адрес.Корпус			= ПолучитьЗначениеСвойстваXDTO(ЮрФизЛицоXDTO.russianAddress,"block");
			ЮрФизЛицоEDI.Адрес.Индекс			= ПолучитьЗначениеСвойстваXDTO(ЮрФизЛицоXDTO.russianAddress,"postalCode");
			ЮрФизЛицоEDI.Адрес.Квартира			= ПолучитьЗначениеСвойстваXDTO(ЮрФизЛицоXDTO.russianAddress,"flat");
			ЮрФизЛицоEDI.Адрес.НаселенныйПункт	= ПолучитьЗначениеСвойстваXDTO(ЮрФизЛицоXDTO.russianAddress,"settlement");
			ЮрФизЛицоEDI.Адрес.Район			= ПолучитьЗначениеСвойстваXDTO(ЮрФизЛицоXDTO.russianAddress,"district");
			ЮрФизЛицоEDI.Адрес.Регион			= ПолучитьЗначениеСвойстваXDTO(ЮрФизЛицоXDTO.russianAddress,"regionISOCode");
			ЮрФизЛицоEDI.Адрес.Улица			= ПолучитьЗначениеСвойстваXDTO(ЮрФизЛицоXDTO.russianAddress,"street");
			
		КонецЕсли;
		
	КонецЕсли;
		
	ЮрФизЛицоEDI.КодВСистемеПокупателя	= ПолучитьЗначениеСвойстваXDTO(ЮрФизЛицоXDTO,"additionalIdentificator");
	
	// kns {метка} добавить доп. информацию 
	
	//ЮрФизЛицоEDI.Телефон			= ЮрФизЛицоXML.Телефон;
	//ЮрФизЛицоEDI.Банк				= ЮрФизЛицоXML.Банк;
	//ЮрФизЛицоEDI.БИК				= ЮрФизЛицоXML.БИК;
	//ЮрФизЛицоEDI.НомерСчета			= ЮрФизЛицоXML.НомерСчета;
	//ЮрФизЛицоEDI.Руководитель		= ЮрФизЛицоXML.Руководитель;
	//ЮрФизЛицоEDI.ГлавныйБухгалтер	= ЮрФизЛицоXML.ГлавныйБухгалтер;
	
КонецПроцедуры

//В СообщениеXML на входе подается Структура вида "Документ,Получатель,..."
//В СообщениеEDI помещает структуру вида "ДокументEDI, Документ1С, ПолучательEDI, Получатель1С, ...". (поля с суффиксом 1С пока пустые).
Процедура ЗаполнитьСообщениеEDI(СообщениеXML,СообщениеEDI,ТипСообщения,Направление)
	
	СообщениеEDI.ID = СообщениеXML.ID;
	
	СообщениеEDI.ТипСообщения = ТипСообщения;
	СообщениеEDI.Направление  = Направление;
	
	//creationDateTime
	//Заполняем в структуру время создания в стандарте UTC (для сравнения МСК = (UTC+3)) 
	СообщениеEDI.ДатаСоздания = ДатаXML_в_ДатаВремя1С(СообщениеXML.ДатаСоздания);
	
    СообщениеEDI.ДокументEDI.Номер	= СообщениеXML.НомерДокумента;
	СообщениеEDI.ДокументEDI.Дата	= ДатаXML_в_Дата1С(СообщениеXML.ДатаДокумента);
	
	Если СообщениеEDI.Свойство("ТТНвЕГАИС") И СообщениеXML.Свойство("ТТНвЕГАИС") Тогда
		ЗаполнитьЗначенияСвойств(СообщениеEDI.ТТНвЕГАИС, СообщениеXML.ТТНвЕГАИС); 
	КонецЕсли;
	
	Если СообщениеEDI.Свойство("ФиксацияВЕГАИС") И СообщениеXML.Свойство("ФиксацияВЕГАИС") Тогда
		ЗаполнитьЗначенияСвойств(СообщениеEDI.ФиксацияВЕГАИС, СообщениеXML.ФиксацияВЕГАИС); 
	КонецЕсли;
	
	Если СообщениеEDI.Свойство("Контракт") Тогда 
		Если СообщениеXML.Контракты.Количество() > 0 Тогда
			СообщениеXML.НомерКонтракта = СообщениеXML.Контракты[0].НомерКонтракта;
			СообщениеXML.ДатаКонтракта 	= СообщениеXML.Контракты[0].ДатаКонтракта;
		КонецЕсли;
    	СообщениеEDI.Контракт.Номер	= СообщениеXML.НомерКонтракта;
		СообщениеEDI.Контракт.Дата	= ДатаXML_в_Дата1С(СообщениеXML.ДатаКонтракта);
	КонецЕсли;
	
	Если СообщениеEDI.Свойство("КрайняяДатаПриемки") И СообщениеXML.Свойство("КрайняяДатаПриемки") Тогда 
		СообщениеEDI.КрайняяДатаПриемки = ДатаXML_в_ДатаВремя1С(СообщениеXML.КрайняяДатаПриемки);
	КонецЕсли;	
	Если СообщениеEDI.Свойство("КрайняяДатаБронирования") И СообщениеXML.Свойство("КрайняяДатаБронирования") Тогда 
		СообщениеEDI.КрайняяДатаБронирования = ДатаXML_в_ДатаВремя1С(СообщениеXML.КрайняяДатаБронирования);
	КонецЕсли;	
	Если СообщениеEDI.Свойство("КрайняяДатаОтвета") И СообщениеXML.Свойство("КрайняяДатаОтвета") Тогда 
		СообщениеEDI.КрайняяДатаОтвета = ДатаXML_в_ДатаВремя1С(СообщениеXML.КрайняяДатаОтвета);
	КонецЕсли;	
		
	Если СообщениеEDI.Свойство("СуммаТоваровВсего") И СообщениеXML.Свойство("СуммаТоваровВсего") Тогда
		СообщениеEDI.СуммаТоваровВсего = ?(СообщениеXML.СуммаТоваровВсего = Неопределено, 0 , СообщениеXML.СуммаТоваровВсего);
	КонецЕсли;
	
	Если СообщениеEDI.Свойство("СуммаТоваровВсегоБезНДС") И СообщениеXML.Свойство("СуммаТоваровВсегоБезНДС") Тогда
		СообщениеEDI.СуммаТоваровВсегоБезНДС = ?(СообщениеXML.СуммаТоваровВсегоБезНДС = Неопределено, 0 , СообщениеXML.СуммаТоваровВсегоБезНДС);
	КонецЕсли;
	
	Если СообщениеEDI.Свойство("СуммаТоваровНДС") И СообщениеXML.Свойство("СуммаТоваровНДС") Тогда
		СообщениеEDI.СуммаТоваровНДС = ?(СообщениеXML.СуммаТоваровНДС = Неопределено, 0 , СообщениеXML.СуммаТоваровНДС);
	КонецЕсли;

	СообщениеEDI.ДатаПоставки		= ДатаXML_в_ДатаВремя1С(СообщениеXML.ДатаВремяПоставки);
	//+Для Магнита
	Если ТипСообщения = "ORDERS" Тогда
		СообщениеEDI.ДатаВывозаОтПоставщика	= ДатаXML_в_ДатаВремя1С(СообщениеXML.ДатаВывозаОтПоставщика);
		//Еще для Магнита Признак самовывоза E1C_in-29815
		Для каждого Стр Из СообщениеXML.ТочкиСамовывоза Цикл
			НоваяСтрока = СообщениеEDI.ТочкиСамовывоза.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Стр);
		КонецЦикла;
		СообщениеEDI.ОтветственныйЗаДоставку	= СообщениеXML.ОтветственныйЗаДоставку;
	КонецЕсли;	
	//-
	
	Если СообщениеEDI.ТипСообщения = "ORDRSP"
		ИЛИ СообщениеEDI.ТипСообщения = "DESADV" Тогда
		
		СообщениеEDI.ДатаОтгрузки	= ДатаXML_в_ДатаВремя1С(СообщениеXML.ДатаОтгрузки);
		
		Если НЕ СообщениеXML.Транспортировка.Количество() = 0 Тогда
			ПерваяСтрока = СообщениеXML.Транспортировка[0];
			СписокСвойств = "РежимПеревозки,ИмяВодителя,НомерТранспортногоСредства,МаркаТранспортногоСредства";
			ЗаполнитьЗначенияСвойств(СообщениеEDI.Транспортировка, ПерваяСтрока, СписокСвойств);
		КонецЕсли;
			
	КонецЕсли;
	
	Если СообщениеEDI.ТипСообщения = "IFTMBF" 
		ИЛИ СообщениеEDI.ТипСообщения = "IFTMBC" Тогда
		
		ЗаполнитьЮрФизЛицо(СообщениеXML.Перевозчик,			СообщениеEDI.ПеревозчикEDI);
		
		СообщениеEDI.ЭкспедиционныйЗаказEDI.Номер		= СообщениеXML.НомерЭкспедиционногоЗаказа;
		СообщениеEDI.ЭкспедиционныйЗаказEDI.Дата		= ДатаXML_в_Дата1С(СообщениеXML.ДатаЭкспедиционногоЗаказа);
		СообщениеEDI.ЗаказПеревозкиEDI.Номер			= СообщениеXML.НомерЗаказаПеревозки;
		СообщениеEDI.ЗаказПеревозкиEDI.Дата				= ДатаXML_в_Дата1С(СообщениеXML.ДатаЗаказаПеревозки);
	
		СообщениеEDI.ДатаВремяСовершенияДоверенности 		= ДатаXML_в_ДатаВремя1С(СообщениеXML.ДатаВремяСовершенияДоверенности);
		СообщениеEDI.КатегорииТовара			 			= СообщениеXML.КатегорииТовара;
		СообщениеEDI.ОсобыеУказания 						= СообщениеXML.ОсобыеУказания;
		
		СообщениеEDI.ВесУпаковокБрутто.Количество 			= СообщениеXML.ВесУпаковокБрутто.Количество;
		СообщениеEDI.ВесУпаковокБрутто.КодЕдиницыИзмерения 	= СообщениеXML.ВесУпаковокБрутто.КодЕдиницыИзмерения;
		СообщениеEDI.КоличествоУпаковок 					= СообщениеXML.КоличествоУпаковок;
		
		СписокСвойств = "ТипТарифа,РегионТарифа,ПлановаяСтоимость";
		ЗаполнитьЗначенияСвойств(СообщениеEDI.ТарифНаПеревозку, СообщениеXML.ТарифНаПеревозку, СписокСвойств);
		
		СписокСвойств = "РежимПеревозки,НаличиеГидроборта,Грузоподъемность,КоличествоПаллетоМест,ТипТранспортногоСредства,НомерРейса," +
						"НомерТранспортногоСредства,МаркаТранспортногоСредства,ИмяВодителя,ТелефонВодителя,НомерЛицензииВодителя,Комментарий";
		ЗаполнитьЗначенияСвойств(СообщениеEDI.ИнформацияОТранспорте, СообщениеXML.ИнформацияОТранспорте);
		
		Для каждого Стр Из СообщениеXML.Грузополучатели Цикл
			
			НоваяСтрока = СообщениеEDI.Грузополучатели.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр, , "ДатаВремяДоставки");
			НоваяСтрока.ГрузополучательEDI = ПолучитьСтруктуруПоляСообщения("ЮрФизЛицо");
			ЗаполнитьЮрФизЛицо(Стр.Грузополучатель,	НоваяСтрока.ГрузополучательEDI);
			НоваяСтрока.ДатаВремяДоставки = ДатаXML_в_ДатаВремя1С(Стр.ДатаВремяДоставки);
			
		КонецЦикла;
	
	КонецЕсли;
	
	Если СообщениеEDI.Свойство("НомерПриемкиПокупателя") И СообщениеXML.Свойство("НомерПриемкиПокупателя") Тогда
		СообщениеEDI.НомерПриемкиПокупателя	= СообщениеXML.НомерПриемкиПокупателя;
	КонецЕсли;	
	
	Если ТипСообщения = "PRICELIST" Тогда 
		СообщениеEDI.ДатаНачалаДействияЦен = СообщениеXML.ДатаНачалаДействияЦен;
		СообщениеEDI.ДатаОкончанияДействияЦен = СообщениеXML.ДатаОкончанияДействияЦен;
	КонецЕсли;
	
	СообщениеEDI.НомерСерииЗаказов	= СообщениеXML.НомерСерииЗаказов;
	
	СообщениеEDI.ЗаказEDI.Номер		= СообщениеXML.НомерЗаказа;
	СообщениеEDI.ЗаказEDI.Дата		= ДатаXML_в_Дата1С(СообщениеXML.ДатаЗаказа);
	СообщениеEDI.НакладнаяEDI.Номер = СообщениеXML.НомерНакладной;
	СообщениеEDI.НакладнаяEDI.Дата	= ДатаXML_в_Дата1С(СообщениеXML.ДатаНакладной);
	СообщениеEDI.ПриемкаEDI.Номер	= СообщениеXML.НомерПриемки;
	СообщениеEDI.ПриемкаEDI.Дата	= ДатаXML_в_Дата1С(СообщениеXML.ДатаПриемки);
	СообщениеEDI.СчетФактураEDI.Номер	= СообщениеXML.НомерСчетФактуры;
	СообщениеEDI.СчетФактураEDI.Дата	= ДатаXML_в_Дата1С(СообщениеXML.ДатаСчетФактуры);
	Если ТипСообщения = "ORDERS" Тогда
		СообщениеEDI.ОбратныйЗаказEDI.Номер	= СообщениеXML.НомерОбратногоЗаказа;
		СообщениеEDI.ОбратныйЗаказEDI.Дата	= ДатаXML_в_Дата1С(СообщениеXML.ДатаОбратногоЗаказа);
		СообщениеEDI.КонтактноеЛицоФИО	= СообщениеXML.КонтактноеЛицоФИО;
		СообщениеEDI.КонтактноеЛицоТелефон	= СообщениеXML.КонтактноеЛицоТелефон;
		СообщениеEDI.КонтактноеЛицоЭлПочта	= СообщениеXML.КонтактноеЛицоЭлПочта;
	КонецЕсли;
	
	Если (ТипСообщения = "ORDERS") или (ТипСообщения = "ORDRSP") Тогда
		
		//врата	
		массив=СообщениеXML.Транспортировка.ВыгрузитьКолонку("ДатаВремяПрибытия");
		Для й=1 по массив.Количество() Цикл
			Если ЗначениеЗаполнено(массив[й-1]) Тогда 
				СообщениеEDI.Транспортировка.ДатаВремяПрибытия.Добавить(массив[й-1]);
			КонецЕсли;
		КонецЦикла;
		
		Если ТипСообщения = "ORDERS" тогда
			СообщениеEDI.Транспортировка.ДатаВремяПрибытия.ЗаполнитьПометки(Истина);
		конецесли;
		
		//ТипТС	
		массив=СообщениеXML.Транспортировка.ВыгрузитьКолонку("ТипТранспортногоСредства");
		Для й=1 по массив.Количество() Цикл
			Если ЗначениеЗаполнено(массив[й-1]) Тогда 
				СообщениеEDI.Транспортировка.ТипТранспортногоСредства.Добавить(массив[й-1]);
			КонецЕсли;
		КонецЦикла;
		
		// ВремяНачалаПогрузки
		массив = СообщениеXML.Транспортировка.ВыгрузитьКолонку("ВремяНачалаПогрузки");
		Для й=1 по массив.Количество() Цикл
			Если ЗначениеЗаполнено(массив[й-1]) Тогда 
				СообщениеEDI.Транспортировка.ВремяНачалаПогрузки.Добавить(ДатаXML_в_ДатаВремя1С(массив[й-1]));
			КонецЕсли;
		КонецЦикла;
		
		// ВремяОкончанияПогрузки
		массив = СообщениеXML.Транспортировка.ВыгрузитьКолонку("ВремяОкончанияПогрузки");
		Для й=1 по массив.Количество() Цикл
			Если ЗначениеЗаполнено(массив[й-1]) Тогда 
				СообщениеEDI.Транспортировка.ВремяОкончанияПогрузки.Добавить(ДатаXML_в_ДатаВремя1С(массив[й-1]));
			КонецЕсли;
		КонецЦикла;
		
		//// ТранспортныеУпаковки
		//Для каждого Строка Из СообщениеXML.ТранспортныеУпаковки Цикл
		//	НоваяСтрока = СообщениеEDI.ТранспортныеУпаковки.Строки.Добавить();
		//	НоваяСтрока.ТипУпаковки = Строка.ТипУпаковки;
		//	НоваяСтрока.Количество = Строка.Количество;
		//	НоваяСтрока.ВесБрутто  
		//	НоваяСтрока.ВесНетто
		//КонецЦикла;
		
	КонецЕсли;
	
	Если ТипСообщения = "DELFOR" Тогда
		
		ЗаполнитьЗначенияСвойств(СообщениеEDI, СообщениеXML,, "ДатаСоздания");
		
		СообщениеEDI.ДлительностьГрафика = ПолучитьПредставлениеПеречисленияEDI(СообщениеXML.ДлительностьГрафика, "ДлительностьГрафикаDELFOR");
		
		СообщениеEDI.НомерДоговора = СообщениеXML.НомерКонтракта;
		СообщениеEDI.ДатаДоговора = СообщениеXML.ДатаКонтракта;
		
		Если СообщениеEDI.НачалоДействияГрафика = "" Тогда
			СообщениеEDI.НачалоДействияГрафика = Дата(1,1,1);	
		КонецЕсли;
		Если СообщениеEDI.ОкончаниеДействияГрафика = "" Тогда
			СообщениеEDI.ОкончаниеДействияГрафика = Дата(1,1,1);	
		КонецЕсли;
			
		Для Каждого ТочкаДоставки Из СообщениеXML.ТочкиДоставки Цикл
			GLNТочки = ТочкаДоставки.ТорговаяТочкаGLN;
			Для Каждого ГрафикТочкиДоставки Из ТочкаДоставки.Графики Цикл
				НстрГрафиков = СообщениеEDI.Графики.Добавить();
				НстрГрафиков.ТорговаяТочкаGLN = GLNТочки;
				ЗаполнитьЗначенияСвойств(НстрГрафиков, ГрафикТочкиДоставки);
				
				Если НЕ ЗначениеЗаполнено(НстрГрафиков.НачалоДействияГрафика) Тогда//Реквизит может быть заполнен только в шапке
					НстрГрафиков.НачалоДействияГрафика = СообщениеEDI.НачалоДействияГрафика; 	
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(НстрГрафиков.ОкончаниеДействияГрафика) Тогда//Реквизит может быть заполнен только в шапке
					НстрГрафиков.ОкончаниеДействияГрафика = СообщениеEDI.ОкончаниеДействияГрафика; 	
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ГрафикТочкиДоставки.ВремяПоставкиС) Тогда
					Попытка
						НстрГрафиков.ВремяПоставкиС = Дата("01.01.0001 " + ГрафикТочкиДоставки.ВремяПоставкиС + ":00");
					Исключение
						ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось преобразовать дату для DELFOR - " + ОписаниеОшибки());	
					КонецПопытки;
				КонецЕсли;
				Если ЗначениеЗаполнено(ГрафикТочкиДоставки.ВремяПоставкиДо) Тогда
					Попытка
						НстрГрафиков.ВремяПоставкиДо = Дата("01.01.0001 " + ГрафикТочкиДоставки.ВремяПоставкиДо + ":00");
					Исключение
						ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось преобразовать дату для DELFOR - " + ОписаниеОшибки());	
					КонецПопытки;
				КонецЕсли;
				Если ЗначениеЗаполнено(ГрафикТочкиДоставки.ЗаказыПринимаютсяДо) Тогда
					Попытка
						НстрГрафиков.ЗаказыПринимаютсяДо = Дата("01.01.0001 " + ГрафикТочкиДоставки.ЗаказыПринимаютсяДо + ":00");
					Исключение
						ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось преобразовать дату для DELFOR - " + ОписаниеОшибки());	
					КонецПопытки;
				КонецЕсли;
							
				НстрГрафиков.РегулярностьВНеделях = ПолучитьПредставлениеПеречисленияEDI(ГрафикТочкиДоставки.РегулярностьВНеделях, "РегулярностьВНеделяхDELFOR");
				НстрГрафиков.РегулярностьВДнях = ПолучитьПредставлениеПеречисленияEDI(ГрафикТочкиДоставки.РегулярностьВДнях, "ДниНедели");
				
				Если НЕ ЗначениеЗаполнено(ГрафикТочкиДоставки.ДлительностьГрафика) Тогда//Реквизит может быть заполнен только в шапке
					ГрафикТочкиДоставки.ДлительностьГрафика = СообщениеEDI.ДлительностьГрафика;	
				КонецЕсли;
				НстрГрафиков.ДлительностьГрафика = ПолучитьПредставлениеПеречисленияEDI(ГрафикТочкиДоставки.ДлительностьГрафика, "ДлительностьГрафикаDELFOR");
								
				Если СообщениеXML.ТипDELFOR = "Schedule" Тогда	
					НстрГрафиков.СтатусГрафика = ПолучитьПредставлениеПеречисленияEDI(ГрафикТочкиДоставки.СтатусГрафика, "СтатусГрафикаDELFOR");				
				ИначеЕсли СообщениеXML.ТипDELFOR = "Response" Тогда//Признак согласования в EDI хранится в том же поле, что и статус графика
					НстрГрафиков.СтатусСогласования = ПолучитьПредставлениеПеречисленияEDI(ГрафикТочкиДоставки.СтатусГрафика, "СтатусГрафикаDELFOR");
				КонецЕсли;
						
			КонецЦикла;
		КонецЦикла;
		
	КонецЕсли;
	
	// ТранспортныеУпаковки
	Если СообщениеXML.Свойство("ТранспортныеУпаковки") и СообщениеXML.ТранспортныеУпаковки.Количество() > 0 Тогда
		В_ТоварахНетНомераУпаковки = (СообщениеXML.Товары.Колонки.Найти("НомерУпаковки") = Неопределено);
		
		Для каждого Строка Из СообщениеXML.ТранспортныеУпаковки Цикл
			Если НЕ Строка.НомерРодителя = Неопределено ИЛИ Строка.НомерУпаковки = Неопределено Тогда 
				НоваяСтрока = СообщениеEDI.ТранспортныеУпаковки.Строки.Добавить();
				
				Если ЗначениеЗаполнено(Строка.ТипУпаковки) Тогда
					НоваяСтрока.ТипУпаковки = Строка.ТипУпаковки;
				Иначе
					НоваяСтрока.ТипУпаковки	= "201";
				КонецЕсли;
				
				НоваяСтрока.Количество 	= Строка.Количество;
				НоваяСтрока.SSCC        = Строка.SSCC;
				
				Если Строка.ИзмерениеТранспортныхУпаковок = Неопределено Тогда
					ВесНетто	= Строка.ВесНетто;
					ВесБрутто	= Строка.ВесБрутто;
				Иначе  					
					ВесНетто	= 0;
					ВесБрутто	= 0;
					Для Каждого СтрокаИзмерения Из Строка.ИзмерениеТранспортныхУпаковок Цикл
						Если ЗначениеЗаполнено(СтрокаИзмерения.ВесНетто) Тогда 
							ВесНетто	= ВесНетто + СтрокаИзмерения.ВесНетто; 
						КонецЕсли;
						Если ЗначениеЗаполнено(СтрокаИзмерения.ВесБрутто) Тогда 
							ВесБрутто	= ВесБрутто + СтрокаИзмерения.ВесБрутто;
						КонецЕсли;
					КонецЦикла;
					
					Если НЕ Строка.ИзмерениеТранспортныхУпаковок.Количество() = 0 Тогда 
						ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка.ИзмерениеТранспортныхУпаковок[0]);
					КонецЕсли;
					
				КонецЕсли;
				НоваяСтрока.ВесНетто	= ВесНетто;
				НоваяСтрока.ВесБрутто	= ВесБрутто;
				
				НомерСтроки = 1;
				Для каждого Позиция Из СообщениеXML.Товары Цикл
					Если В_ТоварахНетНомераУпаковки ИЛИ Формат(Позиция.НомерУпаковки,"ЧРГ=; ЧГ=") = Формат(Строка.НомерУпаковки,"ЧРГ=; ЧГ=") Тогда 
						СтрокаУпаковки = НоваяСтрока.Строки.Добавить();
						
						ЗаполнитьЗначенияСвойств(СтрокаУпаковки,Позиция);
						СтрокаУпаковки.СоставУпаковки	= Позиция.Наименование;
						СтрокаУпаковки.НомерСтроки		= НомерСтроки;
					КонецЕсли;
					НомерСтроки = НомерСтроки + 1;
				КонецЦикла;	
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	СообщениеEDI.ОтправительEDI.GLN = СообщениеXML.Отправитель;
	СообщениеEDI.ПолучательEDI.GLN	= СообщениеXML.Получатель;
	СообщениеEDI.ВалютаEDI			= СообщениеXML.Валюта;
	СообщениеEDI.СуммаВсего 		= СообщениеXML.СуммаВсего;
	СообщениеEDI.СуммаВсегоБезНДС	= СообщениеXML.СуммаВсегоБезНДС;
	СообщениеEDI.СуммаВсегоНДС		= СообщениеXML.СуммаВсегоНДС;
	
	СообщениеEDI.Статус				= СообщениеXML.Статус;
	
	СообщениеEDI.ПромоНомер			= СообщениеXML.ПромоНомер;
	СообщениеEDI.Комментарий		= СообщениеXML.Комментарий;
	
	ЗаполнитьЮрФизЛицо(СообщениеXML.Продавец,			СообщениеEDI.ПродавецEDI);
	ЗаполнитьЮрФизЛицо(СообщениеXML.Покупатель,			СообщениеEDI.ПокупательEDI);
	ЗаполнитьЮрФизЛицо(СообщениеXML.Плательщик,			СообщениеEDI.ПлательщикEDI);
	ЗаполнитьЮрФизЛицо(СообщениеXML.Грузоотправитель,	СообщениеEDI.ГрузоотправительEDI);
	ЗаполнитьЮрФизЛицо(СообщениеXML.Грузополучатель,	СообщениеEDI.ГрузополучательEDI);
	
	Если СообщениеEDI.Свойство("КонечныйГрузополучательEDI") Тогда
		ЗаполнитьЮрФизЛицо(СообщениеXML.КонечныйГрузополучатель,	СообщениеEDI.КонечныйГрузополучательEDI);
	КонецЕсли;
	Если СообщениеEDI.Свойство("ПромежуточныйГрузополучательEDI") Тогда
		ЗаполнитьЮрФизЛицо(СообщениеXML.ПромежуточныйГрузополучатель,	СообщениеEDI.ПромежуточныйГрузополучательEDI);
	КонецЕсли;
	
	ДопИнформацияСообщенияXML = Неопределено;	
		
	Если ПроверитьСвойствоПоляВСтруктуре(СообщениеXML, "ДополнительнаяИнформация", ДопИнформацияСообщенияXML) Тогда	
		ЗаполнитьДополнительнуюИнформациюВходящегоСообщения_КонтурEDI(СообщениеEDI.ДополнительнаяИнформация, ДопИнформацияСообщенияXML);
	КонецЕсли;
	
	ЕстьКолонкаФасовка 					= НЕ СообщениеXML.Товары.Колонки.Найти("Фасовка") = Неопределено; 
	ЕстьКолонкаДополнительнаяИнформация = НЕ СообщениеXML.Товары.Колонки.Найти("ДополнительнаяИнформация") = Неопределено; 
	
	ЗаполнитьОсобенностиШапки(СообщениеEDI, СообщениеXML, ТипСообщения, Направление);
	
	сч = 0;
	
	Для каждого Стр Из СообщениеXML.Товары Цикл
		
		сч = сч+1;
		
		НоваяСтрока = СообщениеEDI.Товары.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Стр);
		
		Если ТипСообщения = "PRICELIST" Тогда 
			
			Попытка
				НоваяСтрока.СрокГодности = ДатаXML_в_Дата1С(Стр.СрокГодности);
			Исключение
				Попытка 
					НоваяСтрока.СрокГодности = Число(Стр.СрокГодности);
				Исключение
					НоваяСтрока.СрокГодности = 0;
				КонецПопытки;
			КонецПопытки;
				
		КонецЕсли;
		
		НоваяСтрока.КодЕдиницыИзмеренияEDI	= Стр.КодЕдиницыИзмерения;
		Если Направление = "Исходящее" И СтрСодержит_КонтурEDI("ORDRSP,DESADV,INVOIC", СокрЛП(ТипСообщения)) Тогда
			НоваяСтрока.GTIN					= Стр.GTIN;
		Иначе
			НоваяСтрока.GTIN					= ПривестиGTIN(Стр.GTIN);
		КонецЕсли;
		//Сюда вставить типединицы
		НоваяСтрока.СтавкаНДСEDI			= Стр.СтавкаНДС;
		НоваяСтрока.Статус					= Стр.Статус;
		
		НоваяСтрока.СтранаEDI	= Стр.КодСтраны;
		НоваяСтрока.НомерГТДEDI = Стр.НомерГТД;
		
		Если ТипСообщения = "RECADV" Тогда
			НоваяСтрока.КоличествоКВозвратуИПричинаEDI = Стр.КоличествоКВозвратуИПричина;
		КонецЕсли;
		
		Если ЕстьКолонкаФасовка
			И ЗначениеЗаполнено(Стр.Фасовка) Тогда
			НовыйУИД = Новый УникальныйИдентификатор;
			НоваяСтрока.ФасовкаТовара = НовыйУИД;
			Для каждого Строка Из Стр.Фасовка Цикл
				СтрокаФасовки = СообщениеEDI.Фасовка.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаФасовки, Строка);
				СтрокаФасовки.ФасовкаТовара = НовыйУИД;
			КонецЦикла;
		КонецЕсли;
		Если ЕстьКолонкаДополнительнаяИнформация
			И ЗначениеЗаполнено(Стр.ДополнительнаяИнформация) Тогда
			
			НоваяСтрока.ДополнительнаяИнформация = Новый Структура;
			ЗаполнитьДополнительнуюИнформациюВходящегоСообщения_КонтурEDI(НоваяСтрока.ДополнительнаяИнформация, Стр.ДополнительнаяИнформация);
			
		КонецЕсли;
		
		ЗаполнитьКодыМаркировкиВСтрокеВходящегоСообщения(НоваяСтрока, Стр);
		
		НоваяСтрока.НомерСтроки = сч;
		
	КонецЦикла;
		
КонецПроцедуры

Процедура ЗаполнитьДополнительнуюИнформациюВходящегоСообщения_КонтурEDI(ДопИнформацияСообщенияEDI, ДопИнформацияСообщенияXML)
		
	Для Каждого Строка Из ДопИнформацияСообщенияXML Цикл
		
		ТекущееИмяКлюча = Строка.Ключ;
		НовыйИмяКлюча = КонтурСтандарт_УдалитьНедопустимыеСимволы(ТекущееИмяКлюча);
				
		ДопИнформацияСообщенияEDI.Вставить(НовыйИмяКлюча, Строка.Значение);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКодыМаркировкиВСтрокеВходящегоСообщения(СтрокаСообщения, СтрокаСообщенияБуфера)
	
	Если ЗначениеЗаполнено(СтрокаСообщенияБуфера.КодыМаркировки) Тогда
		
		Для каждого Строка Из СтрокаСообщенияБуфера.КодыМаркировки Цикл
		
			ВидКода = ПолучитьПредставлениеПеречисленияEDI(Строка.Вид, "ВидыКодовМаркировки");
			СтрокаСообщения.КодыМаркировки.Добавить(Строка.Код, ВидКода);
		
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьОсобенностиШапки(СообщениеEDI, СообщениеXML, ТипСообщения, Направление)
	
	Для каждого ОсобенностьСообщения Из ОсобенностиСообщений Цикл
		
		Если НЕ ОсобенностьСообщения.ТипыСообщения = "" 
			И Найти(ОсобенностьСообщения.ТипыСообщения, ТипСообщения) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ОсобенностьСообщения.Направление = "" 
			И Найти(ОсобенностьСообщения.Направление, Направление) = 0 Тогда
			Продолжить;
		КонецЕсли;
		ЭтоРеквизитТоваров = НЕ Найти(ОсобенностьСообщения.Путьxml, "lineItem.") = 0;
		Если ЭтоРеквизитТоваров Тогда
			Продолжить;
		КонецЕсли;
		Если ОсобенностьСообщения.Ревенство1СEDI = Неопределено
			ИЛИ Врег(ОсобенностьСообщения.Ревенство1СEDI) = "1С" Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ОсобенностьСообщения.Путьxml) Тогда
			Продолжить;
		КонецЕсли;
		
		ПолныйПутьОсобенности = ПолучитьПолныйПутьОсобенностиСообщения(ОсобенностьСообщения);
							
		ЗначениеСвойстваСообщения = Неопределено;
		Если ПроверитьСвойствоПоляВСтруктуре(СообщениеEDI, ПолныйПутьОсобенности)
			И ПроверитьСвойствоПоляВСтруктуре(СообщениеXML, ПолныйПутьОсобенности, ЗначениеСвойстваСообщения) Тогда
			ПеренестиЗначениеВПолеСтруктуры(СообщениеEDI, ПолныйПутьОсобенности, ЗначениеСвойстваСообщения);	
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьЗначениеПеречисленияEDI(Представление, ИмяПеречисления = "") Экспорт
	
	Значение = "";
	
	Если НЕ ЗначениеЗаполнено(Представление)
		ИЛИ НЕ ЗначениеЗаполнено(ИмяПеречисления) Тогда
		Возврат Значение;
	КонецЕсли;
	
	СоответствиеПеречисленийEDI = ПолучитьКлассификаторПеречисленийEDI();
	СоответствиеПредставлений = СоответствиеПеречисленийEDI[ИмяПеречисления + "Представления"];

	Если НЕ СоответствиеПредставлений = Неопределено Тогда
		Результат = СоответствиеПредставлений[Нрег(Представление)];
		Если НЕ Результат = Неопределено Тогда
			Значение = Результат;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

Функция ПолучитьПредставлениеПеречисленияEDI(Значение, ИмяПеречисления = "") Экспорт
	
	Представление = "";
	
	Если НЕ ЗначениеЗаполнено(Значение)
		ИЛИ НЕ ЗначениеЗаполнено(ИмяПеречисления) Тогда
		Возврат Представление;
	КонецЕсли;
	
	СоответствиеПеречисленийEDI = ПолучитьКлассификаторПеречисленийEDI();
	СоответствиеЗначений = СоответствиеПеречисленийEDI[ИмяПеречисления + "Значения"];

	Если НЕ СоответствиеЗначений = Неопределено Тогда
		Результат = СоответствиеЗначений[Нрег(Значение)];
		Если НЕ Результат = Неопределено Тогда
			Представление = Результат;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции

Функция ПолучитьСписокЗначенийПеречисленияEDI(ИмяПеречисления = "") Экспорт
	
	СписокЗначений = Новый СписокЗначений();
	
	Если НЕ ЗначениеЗаполнено(ИмяПеречисления) Тогда
		Возврат СписокЗначений;
	КонецЕсли;
	
	СоответствиеПеречисленийEDI = ПолучитьКлассификаторПеречисленийEDI();
	НайденныйСписокЗначений = СоответствиеПеречисленийEDI[ИмяПеречисления + "СписокЗначений"];
	
	Если НЕ НайденныйСписокЗначений = Неопределено Тогда
		СписокЗначений = НайденныйСписокЗначений;
	КонецЕсли;
	
	Возврат СписокЗначений;
	
КонецФункции

Функция ПреобразоватьСтатус(Статус)
	
	СоответствиеСтатусов = Новый Соответствие;
	СоответствиеСтатусов.Вставить("УТОЧНЕН",  "Changed");
	СоответствиеСтатусов.Вставить("ОТКЛОНЕН", "Rejected");
	СоответствиеСтатусов.Вставить("ПОДТВЕРЖДЕН", "Accepted");
	СоответствиеСтатусов.Вставить("ОТМЕНЕН", "Canceled");
	
	Результат = СоответствиеСтатусов[Врег(Статус)];
	
	Если Результат = Неопределено Тогда
		Возврат Статус;
	Иначе
		Возврат Результат;
	КонецЕсли;
	
КонецФункции
 
