// #Область ВзаимодействиеСКонтурЛогистика

// Получает имя внешней обработки мастера установки Контур.Логистика. 
// Обработка будет загружена и подключена в информационную базу.
//
// Возвращаемое значение:
//   Строка - имя внешней обработки мастера установки Контур.Логистика.
//
Функция КонтурЛогистика_ПодключитьИнтерфейсМастераУстановки() Экспорт
	
	РезультатЗагрузкиМастераУстановкиЛогистики = КонтурЛогистика_РезультатЗагрузкиМастераУстановки();

	МастерУстановкиКонтурЛогистикаСсылка = РезультатЗагрузкиМастераУстановкиЛогистики.МастерУстановкиКонтурЛогистикаСсылка;
	
	Если МастерУстановкиКонтурЛогистикаСсылка = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	НавигационнаяСсылкаВХ = 
	ПолучитьНавигационнуюСсылку(МастерУстановкиКонтурЛогистикаСсылка, 
	"ДополнительныеРеквизиты.ЗначениеХранилищеЗначения", РезультатЗагрузкиМастераУстановкиЛогистики.НомерСтрокиРеквизитаИнтерфейс - 1); 	
	
	ИдентификаторСправочника = КонтурЛогистика_ИдентификаторСправочникаМастераУстановки();
	
	Если КонтурEDI_ВерсияПлатформы()="81" Тогда
		ИмяПодключеннойОбработки = ВнешниеОбработки.Подключить(НавигационнаяСсылкаВХ, ИдентификаторСправочника);
	Иначе
		
		ОбъектОписанияЗащиты = Вычислить("Новый ОписаниеЗащитыОтОпасныхДействий");
		ОбъектОписанияЗащиты.ПредупреждатьОбОпасныхДействиях = Ложь;
		
		ИмяПодключеннойОбработки =  Вычислить("ВнешниеОбработки.Подключить(НавигационнаяСсылкаВХ, ИдентификаторСправочника, Ложь, ОбъектОписанияЗащиты)");
		
	КонецЕсли;
	
	Возврат ИмяПодключеннойОбработки; 
	
КонецФункции

// Получает результат инициализации внешней обработки. 
// Обработка будет загружена и подключена в информационную базу.
//
// Возвращаемое значение:
//   Структура - см. КонтурЛогистика_РезультатИнициализацииВнешнейОбработки.
//
Функция КонтурЛогистика_РезультатСозданияИнтерфейсаМастераУстановки() Экспорт
	
	РезультатИнициализации = КонтурЛогистика_РезультатИнициализацииВнешнейОбработки();
	
	РезультатЗагрузкиМастераУстановкиЛогистики = КонтурЛогистика_РезультатЗагрузкиМастераУстановки();
	
	Если РезультатЗагрузкиМастераУстановкиЛогистики.МастерУстановкиКонтурЛогистикаСсылка = Неопределено Тогда
		Возврат РезультатИнициализации;
	КонецЕсли;
	
	ИмяФайла = ПолучитьИмяВременногоФайла("epf");
	РезультатЗагрузкиМастераУстановкиЛогистики.ЗначениеХранилищеЗначения.Получить().Записать(ИмяФайла);
	
	Попытка
		Если КонтурEDI_ВерсияПлатформы()="81" Тогда
			Интерфейс = ВнешниеОбработки.Создать(СокрЛП(ИмяФайла));
		Иначе
			Попытка
				
				ОбъектОписанияЗащиты = Вычислить("Новый ОписаниеЗащитыОтОпасныхДействий");
				ОбъектОписанияЗащиты.ПредупреждатьОбОпасныхДействиях = Ложь;
				Интерфейс = Вычислить("ВнешниеОбработки.Создать(СокрЛП(ИмяФайла), Ложь, ОбъектОписанияЗащиты);");
				
			Исключение
				Интерфейс = ВнешниеОбработки.Создать(СокрЛП(ИмяФайла),Ложь);
			КонецПопытки;
			
		КонецЕсли;
	
	Исключение
		РезультатИнициализации.ОписаниеОшибки = "Не удалось инициализировать интерфейс расширения.";
		Возврат РезультатИнициализации;
	КонецПопытки;
	
	РезультатИнициализации.Успешно = Истина;
	РезультатИнициализации.Интерфейс = Интерфейс;
	
	Возврат РезультатИнициализации;	
	
КонецФункции

