Процедура КлиентСервисОбновлений_УстановитьКлючAPI(КлючAPI)
	
	МенеджерНастроек = КлиентСервисОбновлений_МенеджерНастроек();
	
	Если Не ПустаяСтрока(КлючAPI) Тогда 
		
		МенеджерНастроек.Сессия.Заголовки.Вставить("X-Kontur-Apikey", КлючAPI);
		
	Иначе 
		
		МенеджерНастроек.Сессия.Заголовки.Удалить("X-Kontur-Apikey");  
		
	КонецЕсли;
	
КонецПроцедуры 

Процедура КлиентСервисОбновлений_УстановитьТокен(Токен)
	
	МенеджерНастроек = КлиентСервисОбновлений_МенеджерНастроек();

	Если Не ПустаяСтрока(Токен) Тогда 
		
		МенеджерНастроек.Сессия.Заголовки.Вставить("Authorization", Токен);
		
	Иначе 
		
		МенеджерНастроек.Сессия.Заголовки.Удалить("Authorization");  
		
	КонецЕсли;
	
КонецПроцедуры 

Функция КлиентСервисОбновлений_НовыйФайл()
	
	Структура = Новый Структура;
	
	Структура.Вставить("ИмяФайла", "");
	Структура.Вставить("ДвоичныеДанные", Base64Значение(""));
	
	Возврат Структура;
	
КонецФункции
           
Функция КлиентСервисОбновлений_ПолучитьИмяФайлаИзЗаголовка(ContentDisposition)
	
	ИмяФайла = "";
	
	ПараметрыЗаголовка = КонтурСтандарт_ПараметрыИзСтроки(ContentDisposition); 
	
	Если ПараметрыЗаголовка.Свойство("filename") Тогда
		
		ИмяФайла = КонтурСтандарт_РаскодироватьСтроку_(ПараметрыЗаголовка.filename, "КодировкаURL");   
		
	КонецЕсли;
	
	Возврат ИмяФайла; 
	
КонецФункции  

Процедура КлиентСервисОбновлений_УдалитьПустыеПараметры(ПараметрыЗапроса)
	
	// BSLLS:DeletingCollectionItem-off
	Для Каждого ТекПара Из ПараметрыЗапроса Цикл  
		
		Если ТекПара.Значение = Неопределено Тогда
			
			ПараметрыЗапроса.Удалить(ТекПара.Ключ);
			
		КонецЕсли;       
		
	КонецЦикла;
	// BSLLS:DeletingCollectionItem-on 
	
КонецПроцедуры

Функция КлиентСервисОбновлений_ОбработатьРезультатHTTPЗапроса(ПараметрыСервиса, РезультатHTTP) 
	
	ТипыОтветаСервиса = КлиентСервисОбновлений_ТипыОтветаСервиса();
	
	ОтветСервиса = Новый Структура("Успешно, Результат, ОписаниеОшибки");
	
	ДопустимыеКодыОтвета	= ПараметрыСервиса.ДопустимыеКодыОтвета;
	
	ОтветСервиса.Успешно = ДопустимыеКодыОтвета.Найти(Число(РезультатHTTP.КодСостояния)) <> Неопределено;
	
	Если ОтветСервиса.Успешно Тогда
		
		Если ПараметрыСервиса.ТипОтвета = ТипыОтветаСервиса.JSON Тогда 
			
			Результат = КлиентHTTP_КакJson(РезультатHTTP, Ложь);
			
		ИначеЕсли ПараметрыСервиса.ТипОтвета = ТипыОтветаСервиса.BASE64 Тогда
			
			Результат = Base64Значение(КлиентHTTP_КакТекст(РезультатHTTP));		  
			
		ИначеЕсли ПараметрыСервиса.ТипОтвета = ТипыОтветаСервиса.STRING Тогда
			
			Результат = КлиентHTTP_КакТекст(РезультатHTTP);
			
		Иначе   
			ContentDisposition = РезультатHTTP.Заголовки["Content-Disposition"];
			Если ContentDisposition <> Неопределено И Найти(ContentDisposition, "filename")	Тогда
				
				Результат = КлиентСервисОбновлений_НовыйФайл();
				Результат.ИмяФайла 			= КлиентСервисОбновлений_ПолучитьИмяФайлаИзЗаголовка(ContentDisposition);
				Результат.ДвоичныеДанные 	= РезультатHTTP.Тело;   
				
			Иначе
				
				Результат = РезультатHTTP.Тело;	
				
			КонецЕсли;
		КонецЕсли;
		
		ОтветСервиса.Результат = Результат;
		
	Иначе                     
		
		ОтветСервиса.ОписаниеОшибки = КлиентHTTP_КакТекст(РезультатHTTP);		  
		
	КонецЕсли;
	
	Возврат ОтветСервиса;
	
КонецФункции

////////////////////////////////////////////////////////////////////////
// Специфичная обработка приведения схем моделей

Функция КлиентСервисОбновлений_Привести_VersionDto(ХранилищеСхем, Схема, ОбъектКонвертации, ЛокальныеИмена = Ложь)
	
	ПриведенныйОбъект = ПостроительСхем_ПривестиПоСхеме(ХранилищеСхем, Схема, ОбъектКонвертации, ЛокальныеИмена);	
	
	ПолеКонтент = ?(ПриведенныйОбъект.Свойство("content"), ПриведенныйОбъект.content, ПриведенныйОбъект.Контент);
	
	Если НЕ ПолеКонтент = Неопределено И КонтурСтандарт_ЭтоСтруктура(ПолеКонтент) Тогда
		
		Для Каждого ТекКонтент Из ПолеКонтент Цикл
			
			ПолеКонтент[ТекКонтент.Ключ] = ПостроительСхем_ПривестиПоСхеме(ХранилищеСхем, "ContentDto", ТекКонтент.Значение, ЛокальныеИмена);	
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ПриведенныйОбъект;
	
КонецФункции

