Функция КонвертироватьСтавкуНДС_1СвEDI(Значение, Числом = Ложь) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Значение) Тогда 
		Возврат ?(Числом, 0 , Неопределено);
	КонецЕсли;
	
	КлючДляКэша = ?(Числом, "СтавкаНДСЧислом", "СтавкаНДССтрокой");
	СоответствиеСтавокНДС_КЭШ = ЭДО_Кэш_Прочитать(КлючДляКэша);
	
	Если СоответствиеСтавокНДС_КЭШ = Неопределено Тогда
		СоответствиеСтавокНДС_КЭШ = Новый Соответствие;
	Иначе
		РезультатСтавкаНДС = СоответствиеСтавокНДС_КЭШ[Значение];
	КонецЕсли;
	
	Если НЕ РезультатСтавкаНДС = Неопределено Тогда
     	Возврат РезультатСтавкаНДС;
	КонецЕсли;
		
	СтандартнаяОбработкаEDI = Истина;
	ПараметрыСобытияПМ = Новый Структура;
	ПараметрыСобытияПМ.Вставить("Значение", 		Значение);
	ПараметрыСобытияПМ.Вставить("СтавкаНДСЧислом", 	Числом);
	
	РезультатСтавкаНДС = ОбработкаСобытияПодключаемогоМодуля("КонвертироватьСтавкуНДС_1СвEDI", СтандартнаяОбработкаEDI, ПараметрыСобытияПМ);
	
	Если СтандартнаяОбработкаEDI Тогда
		
		СтруктураПредопределенныхСтавокНДС = ПолучитьСтруктуруПредопределенныхСтавокНДС();
		
		Если СтруктураПредопределенныхСтавокНДС.МетаданныеМенеджерСтавкаНДС = Неопределено Тогда
			
			ТекстОшибки = "Не удалось определить тип объекта СтавкаНДС.
			|Проверьте пожалуйста в Подключаемом модуле макет ""ТипыОбъектов"".";
			
			Сообщить_КонтурEDI(ТекстОшибки);
			
			Возврат Неопределено;
		КонецЕсли;
		
		МетаданныеМенеджерСтавкаНДС	= СтруктураПредопределенныхСтавокНДС.МетаданныеМенеджерСтавкаНДС;	
		КоллекцияСтавкиНДС			= СтруктураПредопределенныхСтавокНДС.КоллекцияСтавкиНДС;
		ТипМетаданных				= СтруктураПредопределенныхСтавокНДС.ТипМетаданных; 
		ТипМетаданныхСтавкаНДС		= СтруктураПредопределенныхСтавокНДС.ТипМетаданныхСтавкаНДС;
		
		// Попробуем найти по перечеслению, либо по предопределеннным значениям, если это справочник.
		Если Числом Тогда
			СоответствиеЗначенияСтавкиНДС	= СтруктураПредопределенныхСтавокНДС.СоответствиеЗначенияСтавкиНДСЧислу;
		Иначе
			СоответствиеЗначенияСтавкиНДС	= СтруктураПредопределенныхСтавокНДС.СоответствиеЗначенияСтавкиНДССтроке;
		КонецЕсли;
		
		РезультатСтавкаНДС = СоответствиеЗначенияСтавкиНДС[Значение]; 
		
		// Если у нас перечисление и мы не смогли найти, то тут наши полномочия все
		Если РезультатСтавкаНДС = Неопределено 
			И ТипМетаданных = "Перечисления" Тогда
			
			ТекстОшибки = "Не удалось определить объект СтавкаНДС.
			|Вам необходимо использовать Подключаемый модуль или расширение для конвертации в объект EDI
			|ИмяСобытия - КонвертироватьЗначение1СвEDI ; ТипПоля1C - СтавкаНДС.";
			
			Сообщить_КонтурEDI(ТекстОшибки);
			
			Возврат Неопределено;
		КонецЕсли;
		
		ПравилаФорматированияЧисла = "ЧРД=.; ЧН=0";
		
		Если РезультатСтавкаНДС = Неопределено 
			И ЕстьНеобходимыеМетаданные(ТипМетаданных + "." + ТипМетаданныхСтавкаНДС + ".Реквизиты.НеОблагается") 
			И Значение.НеОблагается = Истина Тогда
			РезультатСтавкаНДС = ?(Числом, 0, "NOT_APPLICABLE");
		КонецЕсли;
		
		Если РезультатСтавкаНДС = Неопределено 
			И ЕстьНеобходимыеМетаданные(ТипМетаданных + "." + ТипМетаданныхСтавкаНДС + ".Реквизиты.Ставка") Тогда
			РезультатСтавкаНДС = ?(Числом, Число(Значение.Ставка), Формат(Значение.Ставка, ПравилаФорматированияЧисла));
		КонецЕсли;
		
		// Дальше идет специфика некоторых конфигураций (ТКПТ, Альфа-Авто)
		Если РезультатСтавкаНДС = Неопределено И Значение = КоллекцияСтавкиНДС["ОсновнаяСтавкаНДС22"] Тогда
			РезультатСтавкаНДС = ?(Числом, 22, "22");	
		КонецЕсли;
		
		Если РезультатСтавкаНДС = Неопределено И Значение = КоллекцияСтавкиНДС["ОсновнаяСтавкаНДС20"] Тогда
			РезультатСтавкаНДС = ?(Числом, 20, "20");	
		КонецЕсли;
		
		Если РезультатСтавкаНДС = Неопределено И Значение = КоллекцияСтавкиНДС["ОсновнаяСтавкаНДС"] Тогда
			СтавкаЧислом = ?(ДействуетСтавка22Процента(), 22, 20); 	
			РезультатСтавкаНДС = ?(Числом, СтавкаЧислом, Формат(СтавкаЧислом, ПравилаФорматированияЧисла));
		КонецЕсли;
		
		// Не удалось найти
		Если РезультатСтавкаНДС = Неопределено Тогда
			ТекстОшибки = "Не удалось определить объект СтавкаНДС.
			|Вам необходимо использовать Подключаемый модуль или расширение для конвертации в объект EDI
			|ИмяСобытия - КонвертироватьЗначение1СвEDI ; ТипПоля1C - СтавкаНДС.";
			
			Сообщить_КонтурEDI(ТекстОшибки);  		
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ РезультатСтавкаНДС = Неопределено Тогда
			
		СоответствиеСтавокНДС_КЭШ.Вставить(Значение, РезультатСтавкаНДС);
		ЭДО_Кэш_Поместить(КлючДляКэша, СоответствиеСтавокНДС_КЭШ);

	КонецЕсли;
	
	Возврат РезультатСтавкаНДС;
	
КонецФункции

Функция КонвертироватьСтавкуНДС_EDIв1С(Значение) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КлючДляКэша = "СтавкаНДСЗначение";
	СоответствиеСтавокНДС_КЭШ = ЭДО_Кэш_Прочитать(КлючДляКэша);
	
	Если СоответствиеСтавокНДС_КЭШ = Неопределено Тогда
		СоответствиеСтавокНДС_КЭШ = Новый Соответствие;
	Иначе
		РезультатСтавкаНДС = СоответствиеСтавокНДС_КЭШ[Значение];
	КонецЕсли;
	
	Если НЕ РезультатСтавкаНДС = Неопределено Тогда
     	Возврат РезультатСтавкаНДС;
	КонецЕсли;
	
	СтандартнаяОбработкаEDI = Истина;
	ПараметрыСобытияПМ = Новый Структура;
	ПараметрыСобытияПМ.Вставить("Значение", 	Значение);
	
	РезультатСтавкаНДС = ОбработкаСобытияПодключаемогоМодуля("КонвертироватьСтавкуНДС_EDIв1С", СтандартнаяОбработкаEDI, ПараметрыСобытияПМ);
	
	Если СтандартнаяОбработкаEDI Тогда
	
		СтруктураПредопределенныхСтавокНДС = ПолучитьСтруктуруПредопределенныхСтавокНДС();
		
		Если СтруктураПредопределенныхСтавокНДС.МетаданныеМенеджерСтавкаНДС = Неопределено Тогда
			
			ТекстОшибки = "Не удалось определить тип объекта СтавкаНДС.
			|Проверьте пожалуйста в Подключаемом модуле макет ""ТипыОбъектов"".";
			
			Сообщить_КонтурEDI(ТекстОшибки);
			
			Возврат Неопределено;
		КонецЕсли; 
	
		МетаданныеМенеджерСтавкаНДС	= СтруктураПредопределенныхСтавокНДС.МетаданныеМенеджерСтавкаНДС;	
		КоллекцияСтавкиНДС			= СтруктураПредопределенныхСтавокНДС.КоллекцияСтавкиНДС;
		ТипМетаданных				= СтруктураПредопределенныхСтавокНДС.ТипМетаданных; 
		ТипМетаданныхСтавкаНДС		= СтруктураПредопределенныхСтавокНДС.ТипМетаданныхСтавкаНДС;
		
		// Попробуем найти по перечеслению, либо по предопределеннным значениям, если это справочник.
		СоответствиеСтрокиСтавкиНДСПредопределенномуИмени = ПолучитьСоответствиеСтрокиСтавкиНДСПредопределенномуИмени();
		ПредопределенноеИмя = СоответствиеСтрокиСтавкиНДСПредопределенномуИмени[Значение];
		
		Если НЕ ПредопределенноеИмя = Неопределено Тогда
			РезультатСтавкаНДС = КоллекцияСтавкиНДС[ПредопределенноеИмя];	
		КонецЕсли; 
		
		// Если у нас перечисление и мы не смогли найти, то тут наши полномочия все
		Если РезультатСтавкаНДС = Неопределено 
			И ТипМетаданных = "Перечисления" Тогда
			
			ТекстОшибки = "Не удалось определить объект СтавкаНДС.
			|Вам необходимо использовать Подключаемый модуль или расширение для конвертации в объект 1С
			|ИмяСобытия - КонвертироватьЗначениеEDIв1С ; ТипПоляEDI - СтавкаНДС.";
			
			Сообщить_КонтурEDI(ТекстОшибки);
			
			Возврат Неопределено;
		КонецЕсли;
		
		Если РезультатСтавкаНДС = Неопределено 
			И (Значение = "БезНДС" ИЛИ Значение = "NOT_APPLICABLE") 
			И ЕстьНеобходимыеМетаданные(ТипМетаданных + "." + ТипМетаданныхСтавкаНДС + ".Реквизиты.НеОблагается") Тогда
			РезультатСтавкаНДС = МетаданныеМенеджерСтавкаНДС.НайтиПоРеквизиту("НеОблагается" , Истина); 
		КонецЕсли;
		
		Если РезультатСтавкаНДС = Неопределено
			И ЕстьНеобходимыеМетаданные("Справочники.СтавкиНДС")
			И ЕстьНеобходимыеМетаданные("Справочники.СтавкиНДС.Реквизиты.Ставка") Тогда
			
			СоответствиеЗначенийРассчетныхСтавокНДС = ПолучитьСоответствиеЗначенийРассчетныхСтавокНДСПоПредопределенномуИмени();
			ЗначениеСтавкиЧислом = СоответствиеЗначенийРассчетныхСтавокНДС[Значение];
			Если ЗначениеСтавкиЧислом = Неопределено Тогда
				
				ЭтоРасчетнаяСтавка = Ложь;
				
				СоответствиеПредопределенногоИмениСтавкиНДСЧислу = ПолучитьСоответствиеПредопределенногоИмениСтавкиНДСЧислу();
				ЗначениеСтавкиЧислом = СоответствиеПредопределенногоИмениСтавкиНДСЧислу[ПредопределенноеИмя]
				
			Иначе
				ЭтоРасчетнаяСтавка = Истина;
			КонецЕсли;
			
			Если ЗначениеСтавкиЧислом = Неопределено Тогда
				ЗначениеСтавкиЧислом = КонтурСтандарт_СтрокаВЧисло(Значение);
			КонецЕсли;
			
			Если ТипЗнч(ЗначениеСтавкиЧислом) = Тип("Число") Тогда
				
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	СтавкиНДС.Ссылка КАК Ссылка,
				|	&ПолеРасчетнаяСтавка
				|ИЗ
				|	Справочник.СтавкиНДС КАК СтавкиНДС
				|ГДЕ
				|	СтавкиНДС.Ставка = &ЗначениеСтавки";
				
				Запрос.УстановитьПараметр("ЗначениеСтавки", ЗначениеСтавкиЧислом);
				
				Если ЕстьНеобходимыеМетаданные("Справочники.СтавкиНДС.Реквизиты.Расчетная") Тогда
					ТекстПолеРасчетнаяСтавка = "СтавкиНДС.Расчетная КАК РасчетнаяСтавка";
				ИначеЕсли ЕстьНеобходимыеМетаданные("Справочники.СтавкиНДС.Реквизиты.РасчетнаяСтавка") Тогда
					ТекстПолеРасчетнаяСтавка = "СтавкиНДС.РасчетнаяСтавка КАК РасчетнаяСтавка";
				Иначе
					ТекстПолеРасчетнаяСтавка = "Неопределено КАК РасчетнаяСтавка";
				КонецЕсли;
				
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеРасчетнаяСтавка", ТекстПолеРасчетнаяСтавка);
				
				Результат = Запрос.Выполнить().Выбрать();
				
				Пока Результат.Следующий() Цикл 
					
					РезультатСтавкаНДС = Результат.Ссылка;
					
					Если Результат.РасчетнаяСтавка = ЭтоРасчетнаяСтавка Тогда
						Прервать;
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли; 

		КонецЕсли;
		
		// Дальше идет специфика некоторых конфигураций (ТКПТ, Альфа-Авто)
		Если РезультатСтавкаНДС = Неопределено И Значение = "22" И НЕ КоллекцияСтавкиНДС["ОсновнаяСтавкаНДС22"] = Неопределено Тогда
			РезультатСтавкаНДС = КоллекцияСтавкиНДС["ОсновнаяСтавкаНДС22"];	
		КонецЕсли; 
		
		Если РезультатСтавкаНДС = Неопределено И Значение = "20" И НЕ КоллекцияСтавкиНДС["ОсновнаяСтавкаНДС20"] = Неопределено Тогда
			РезультатСтавкаНДС = КоллекцияСтавкиНДС["ОсновнаяСтавкаНДС20"];	
		КонецЕсли;
		
		Если РезультатСтавкаНДС = Неопределено 
			И НЕ КоллекцияСтавкиНДС["ОсновнаяСтавкаНДС"] = Неопределено
			И (Значение = "22" ИЛИ Значение = "20") Тогда
			
			РезультатСтавкаНДС = КоллекцияСтавкиНДС["ОсновнаяСтавкаНДС"];

		КонецЕсли;
		
		// Не удалось найти
		Если РезультатСтавкаНДС = Неопределено Тогда
			ТекстОшибки = "Не удалось определить объект СтавкаНДС.
			|Вам необходимо использовать Подключаемый модуль или расширение для конвертации в объект 1С
			|ИмяСобытия - КонвертироватьЗначениеEDIв1С ; ТипПоляEDI - СтавкаНДС.";
			
			Сообщить_КонтурEDI(ТекстОшибки);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ РезультатСтавкаНДС = Неопределено Тогда
			
		СоответствиеСтавокНДС_КЭШ.Вставить(Значение, РезультатСтавкаНДС);
		ЭДО_Кэш_Поместить(КлючДляКэша, СоответствиеСтавокНДС_КЭШ);
		
	КонецЕсли;
	
	Возврат РезультатСтавкаНДС;

КонецФункции

Функция ДействуетСтавка22Процента()
	
	ДатаСеанса = ТекущаяДатаСеанса();
	ДатаВступленияВСилуЗакона = '20260101';
	
	Возврат (ДатаСеанса > ДатаВступленияВСилуЗакона);
	
КонецФункции

Процедура ЗаполнитьСтавкуНДСВСтрокеТовараДокумента(СтрокаТоваровСообщения = Неопределено, СтрокаТоваровДокумента, Период = Неопределено, СтрокаСоответствий = Неопределено) Экспорт
	
	Если СтрокаТоваровСообщения <> Неопределено Тогда
		
		Если ЗначениеЗаполнено(СтрокаТоваровСообщения.СтавкаНДС1С) Тогда       
			СтрокаТоваровДокумента.СтавкаНДС = СтрокаТоваровСообщения.СтавкаНДС1С;
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТоваровДокумента.СтавкаНДС )
			И ЗначениеЗаполнено(СтрокаТоваровСообщения.ЦенаБезНДС)                                
			И ЗначениеЗаполнено(СтрокаТоваровСообщения.ЦенаСНДС  ) Тогда
			
			СтавкаНДС = Окр((СтрокаТоваровСообщения.ЦенаСНДС * 100) / СтрокаТоваровСообщения.ЦенаБезНДС - 100 , 0);
			
			СтавкаНДС1С = КонвертироватьСтавкуНДС_EDIв1С(Строка(СтавкаНДС));
			
			СтрокаТоваровДокумента.СтавкаНДС   = СтавкаНДС1С;
			СтрокаТоваровСообщения.СтавкаНДС1С = СтавкаНДС1С;
			Возврат;	
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтрокаТоваровДокумента.СтавкаНДС)
		И ЕстьНеобходимыеМетаданные("Справочники.СтавкиНДС")
		И ЕстьРеквизитОбъекта_Контур(СтрокаТоваровДокумента.Номенклатура, "ВидСтавкиНДС") Тогда
		
		Если НЕ ЗначениеЗаполнено(Период) Тогда 
			Период = ТекущаяДатаСеанса();
		КонецЕсли;
		
		МетаданныеМенеджерСтавкаНДС = Вычислить("Справочники.СтавкиНДС");
		СтавкаНДС1С = МетаданныеМенеджерСтавкаНДС.СтавкаНДС(СтрокаТоваровДокумента.Номенклатура.ВидСтавкиНДС, Период);
		
		СтрокаТоваровДокумента.СтавкаНДС   = СтавкаНДС1С;
		
		Если НЕ СтрокаТоваровСообщения = Неопределено Тогда 
			СтрокаТоваровСообщения.СтавкаНДС1С = СтавкаНДС1С;
		КонецЕсли;
		
		Возврат; 
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтрокаТоваровДокумента.СтавкаНДС)
		И ЕстьНеобходимыеМетаданные("Перечисления.СтавкиНДС")
		И ЕстьРеквизитОбъекта_Контур(СтрокаТоваровДокумента.Номенклатура, "ВидСтавкиНДС") Тогда
		
		Если НЕ ЗначениеЗаполнено(Период) Тогда 
			Период = ТекущаяДатаСеанса();
		КонецЕсли;
		
		МетаданныеМенеджерСтавкаНДС = Вычислить("Перечисления.СтавкиНДС");
		СтавкаНДС1С = МетаданныеМенеджерСтавкаНДС.СтавкаНДС(СтрокаТоваровДокумента.Номенклатура.ВидСтавкиНДС, Период);
		
		СтрокаТоваровДокумента.СтавкаНДС   = СтавкаНДС1С;
		
		Если НЕ СтрокаТоваровСообщения = Неопределено Тогда 
			СтрокаТоваровСообщения.СтавкаНДС1С = СтавкаНДС1С;
		КонецЕсли;
		
		Возврат; 
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтрокаТоваровДокумента.СтавкаНДС)
		  И ЕстьРеквизитОбъекта_Контур(СтрокаТоваровДокумента.Номенклатура, "СтавкаНДС")
		  И ЗначениеЗаполнено(СтрокаТоваровДокумента.Номенклатура.СтавкаНДС) Тогда 
		
		СтавкаНДС1С = СтрокаТоваровДокумента.Номенклатура.СтавкаНДС; 
		
		СтрокаТоваровДокумента.СтавкаНДС   = СтавкаНДС1С;
		
		Если СтрокаТоваровСообщения <> Неопределено Тогда 
			СтрокаТоваровСообщения.СтавкаНДС1С = СтавкаНДС1С;
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтрокаТоваровДокумента.СтавкаНДС)
		И СтрокаСоответствий <> Неопределено Тогда 
		
		ЦенаБезНДСПринято = Неопределено;
		ЦенаСНДСПринято = Неопределено;
		
		Если ПеременнаяСодержитСвойство(СтрокаСоответствий, "ЦенаБезНДСПринято", ЦенаБезНДСПринято, Истина)
			И ПеременнаяСодержитСвойство(СтрокаСоответствий, "ЦенаСНДСПринято", ЦенаСНДСПринято, Истина) Тогда
			
			СтавкаНДС = Окр((ЦенаСНДСПринято * 100) / ЦенаБезНДСПринято - 100 , 0);
			
			СтавкаНДС1С = КонвертироватьСтавкуНДС_EDIв1С(Строка(СтавкаНДС));
			
			СтрокаТоваровДокумента.СтавкаНДС   = СтавкаНДС1С;
			Возврат;	
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ДопПараметрыСтрокиДокумента_КонтурEDI(Документ, ЭтоВозврат = Ложь) Экспорт
	
	ДопПараметрыСтроки = Новый Структура;  	
	ДопПараметрыСтроки.Вставить("СуммаВключаетНДС");
	ДопПараметрыСтроки.Вставить("Склад");

	ЗаполнитьЗначенияСвойств(ДопПараметрыСтроки, Документ);
	
	ДопПараметрыСтроки.СуммаВключаетНДС = ПолучитьРеквизитДокументаДляСообщения(Документ, "СуммаВключаетНДС"); 
	
	ДопПараметрыСтроки.Вставить("ЭтоВозврат", ЭтоВозврат);
	
	Возврат ДопПараметрыСтроки; 
	
КонецФункции

Функция ПараметрыЗаполненияСтрокиДокумента_КонтурEDI(СтрокаДокумента, СтрокаОснование, ДопПараметрыСтроки, Суффикс1 = "", Суффикс2 = "") Экспорт
	
	// параметры для заполнения строки
	ПараметрыСтроки = Новый Структура("Номенклатура,ХарактеристикаНоменклатуры,ЕдиницаИзмерения,СерияНоменклатуры,Количество,Цена");
	
	// ... основные свойства
	ЗаполнитьЗначенияСвойств(ПараметрыСтроки, СтрокаОснование);
	
	Если ПеременнаяСодержитСвойство(СтрокаДокумента, "Характеристика") Тогда
		
		ПараметрыСтроки.Вставить("Характеристика", СтрокаОснование.ХарактеристикаНоменклатуры);
		
	КонецЕсли;
	
	Если ПеременнаяСодержитСвойство(СтрокаДокумента, "Склад") Тогда
		
		Если ЗначениеЗаполнено(СтрокаДокумента.Склад) Тогда
			ПараметрыСтроки.Вставить("Склад", СтрокаДокумента.Склад);
		ИначеЕсли ЗначениеЗаполнено(ДопПараметрыСтроки.Склад) Тогда
			ПараметрыСтроки.Вставить("Склад", ДопПараметрыСтроки.Склад);
		КонецЕсли;	
		
	КонецЕсли;
	
	// ... упаковка
	ЕстьУпаковка = ПеременнаяСодержитСвойство(СтрокаДокумента, "Упаковка");
	
	Если ЕстьУпаковка Тогда
		
		ВладелецУпаковки = Неопределено;
		ЕстьВладелец = ПеременнаяСодержитСвойство(СтрокаОснование.ЕдиницаИзмерения, "Владелец", ВладелецУпаковки);
		
		ЗаполнитьУпаковку = НЕ ЕстьВладелец ИЛИ (ВладелецУпаковки = СтрокаОснование.Номенклатура);
		
	Иначе
		
		ЗаполнитьУпаковку = Ложь;
		
	КонецЕсли;
	
	Если ЗаполнитьУпаковку Тогда

		ПараметрыСтроки.Вставить("Упаковка", СтрокаОснование.ЕдиницаИзмерения);

	КонецЕсли;
		
	// ... количество
	Если ПеременнаяСодержитСвойство(ДопПараметрыСтроки, "ЭтоВозврат") И ДопПараметрыСтроки.ЭтоВозврат Тогда


		ПараметрыСтроки.Количество = СтрокаОснование["Количество" + Суффикс2] - СтрокаОснование["Количество" + Суффикс1];
		
	Иначе
		
		ПараметрыСтроки.Количество = СтрокаОснование["Количество" + Суффикс1];
		
	КонецЕсли;
		
	Если ПеременнаяСодержитСвойство(СтрокаДокумента, "КоличествоУпаковок") Тогда
		
		ПараметрыСтроки.Вставить("КоличествоУпаковок", ПараметрыСтроки.Количество);
		
	КонецЕсли;
	
	Если ПеременнаяСодержитСвойство(СтрокаДокумента, "Коэффициент") Тогда
		
		ПараметрыСтроки.Вставить("Коэффициент", 1);
		
		Коэффициент = 1;
		
		Если ПеременнаяСодержитСвойство(ПараметрыСтроки.ЕдиницаИзмерения, "Коэффициент", Коэффициент) Тогда
			
			ПараметрыСтроки.Вставить("Коэффициент", Коэффициент); 
			
		КонецЕсли;
		
	КонецЕсли;	
	 	
	Если ПеременнаяСодержитСвойство(СтрокаДокумента, "КоличествоБазовое") Тогда
		
		ПараметрыСтроки.Вставить("КоличествоБазовое", ПараметрыСтроки.Количество);
		
	КонецЕсли;
	
	Если ПеременнаяСодержитСвойство(СтрокаДокумента, "КоличествоЕдиницИзмерения") Тогда
		
		ПараметрыСтроки.Вставить("КоличествоЕдиницИзмерения", ПараметрыСтроки.Количество);
		
	КонецЕсли;
	
	// ... цена 		
	ЦенаИзСтрокиСоответствий = ЦенаИзСтрокиТаблицыEDI_КонтурEDI(СтрокаОснование, ДопПараметрыСтроки.СуммаВключаетНДС, Суффикс1);
	
	Если ЗначениеЗаполнено(ЦенаИзСтрокиСоответствий) Тогда
		
		ПараметрыСтроки.Цена = ЦенаИзСтрокиСоответствий; 
		
	ИначеЕсли СтрокаДокумента <> Неопределено Тогда
		
		ПараметрыСтроки.Цена = СтрокаДокумента.Цена;
		
	Иначе
		
		ПараметрыСтроки.Цена = 0;
		
	КонецЕсли;
	
	Если ПеременнаяСодержитСвойство(СтрокаДокумента, "ОтражатьТоварныйУчет")  Тогда
		
		ПараметрыСтроки.Вставить("ОтражатьТоварныйУчет", Истина);
		
	КонецЕсли;
	
	Возврат ПараметрыСтроки;

КонецФункции

Функция ЦенаИзСтрокиТаблицыEDI_КонтурEDI(СтрокаТаблицы, СуммаВключаетНДС, Суффикс = "") Экспорт
			
	Если СуммаВключаетНДС Тогда
		Цена = СтрокаТаблицы["ЦенаСНДС" + Суффикс];	
		Сумма = СтрокаТаблицы["СуммаСНДС" + Суффикс];
	Иначе
		Цена = СтрокаТаблицы["ЦенаБезНДС" + Суффикс];
		Сумма = СтрокаТаблицы["СуммаБезНДС" + Суффикс];
	КонецЕсли;
	
	Если Цена = 0 
		И ЗначениеЗаполнено(СтрокаТаблицы["Количество" + Суффикс]) Тогда
		
		Цена = Сумма / СтрокаТаблицы["Количество" + Суффикс];
		
	КонецЕсли;
	
	Возврат Цена;

КонецФункции

Процедура ЗаполнитьСтрокуДокумента_КонтурEDI(Док, СтрокаДокумента, ПараметрыСтроки, СтрокаОснование, СтрокаСоответствий) Экспорт
	
	Если СтрокаОснование <> Неопределено Тогда
		
		ЗаполнитьЗначенияСвойств(СтрокаДокумента, СтрокаОснование);
		
		ИзмененияКоличества = ИзменилосьКоличествоВСтрокеДокумента_КонтурEDI(ПараметрыСтроки, СтрокаДокумента);  
		
		ИзменениеЦены = ИзмениласьЦенаВСтрокеДокумента_КонтурEDI(ПараметрыСтроки, СтрокаДокумента);  

	Иначе
		
		ЗаполнитьЗначенияСвойств(СтрокаДокумента, ПараметрыСтроки);
		
		ПриИзмененииНоменклатурыВСтрокеДокумента_КонтурEDI(СтрокаДокумента, Док);
		
		ЗаполнитьСтавкуНДСВСтрокеТовараДокумента(Неопределено, СтрокаДокумента, Док.Дата, СтрокаСоответствий);
		
		ИзмененияКоличества = Истина;
		
		ИзменениеЦены = Истина;
		
	КонецЕсли;
	
	// ... заполнить строку по параметрам
	ЗаполнитьЗначенияСвойств(СтрокаДокумента, ПараметрыСтроки);
	
	// ... дополнить строку	
	Если ИмяКонфигурации1С = "УФ_УТ" Тогда

		Если СтрокаДокумента.Номенклатура.ЕдиницаИзмерения <> СтрокаСоответствий.ЕдиницаИзмерения Тогда
			СтрокаДокумента.Упаковка = СтрокаСоответствий.ЕдиницаИзмерения;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаДокумента.Упаковка) Тогда 
			СтрокаДокумента.Количество = СтрокаДокумента.КоличествоУпаковок;
		Иначе
			
			Если ОпределитьРелизКонфигурации() >= "11.2" Тогда
				
				СтруктураДействий = Новый Структура;
				СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
				
				ОбработкаТабличнойЧастиСервер_ОбработатьСтрокуТЧ(СтрокаДокумента, СтруктураДействий, Неопределено);
				
			Иначе
				
				СтрокаДокумента.Количество = СтрокаДокумента.КоличествоУпаковок * СтрокаДокумента.Упаковка.Коэффициент;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
		 	
	Если ИзмененияКоличества ИЛИ ИзменениеЦены Тогда	
		
		// ... в случае изменений пересчитать строку
		ПересчитатьСтрокуДокумента(СтрокаДокумента, Док);   
		
	КонецЕсли;

КонецПроцедуры

Функция ИзмениласьЦенаВСтрокеДокумента_КонтурEDI(ПараметрыСтроки, СтрокаДокумента)
	
	ИзменениеЦены = СтрокаДокумента.Цена <> ПараметрыСтроки.Цена;
	
	Возврат ИзменениеЦены;

КонецФункции

Функция ИзменилосьКоличествоВСтрокеДокумента_КонтурEDI(ПараметрыСтроки, СтрокаДокумента)
	
	ИзмененияКоличества = 
	СтрокаДокумента.Количество <> ПараметрыСтроки.Количество
	ИЛИ (ПеременнаяСодержитСвойство(СтрокаДокумента, "КоличествоУпаковок") И СтрокаДокумента.КоличествоУпаковок <> ПараметрыСтроки.КоличествоУпаковок);
	
	Возврат ИзмененияКоличества;

КонецФункции

Процедура ОчиститьТабЧастьДокумента_КонтурEDI(ТабличнаяЧасть) Экспорт
	
	Если ТабличнаяЧасть <> Неопределено Тогда
		ТабличнаяЧасть.Очистить(); 
	КонецЕсли; 	
		
КонецПроцедуры

Функция СоздатьКорректировкуПоРезультатамПриемки_КонтурEDI(_Таб, ДокументОснование, ВозвратОбъекта = Ложь, ДокументКорректировки = Неопределено) Экспорт
	
	Если ДокументКорректировки = Неопределено Тогда
		ДокументКорректировки = Документы.КорректировкаРеализации.СоздатьДокумент();
	КонецЕсли;

	ДокументКорректировки.Заполнить(ДокументОснование);
	ДокументКорректировки.Дата = ТекущаяДатаСеанса();  
	
	Если ПеременнаяСодержитСвойство(ДокументКорректировки, "ВидОперации") И 
		ЕстьНеобходимыеМетаданные("Перечисления.ВидыОперацийИсправленияПоступленияРеализации.ЗначенияПеречисления.СогласованноеИзменение") Тогда
		
		Выполнить("ДокументКорректировки.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение");
		
	ИначеЕсли ПеременнаяСодержитСвойство(ДокументКорректировки, "ВидКорректировки") И 
		ЕстьНеобходимыеМетаданные("Перечисления.ХозяйственныеОперации.ЗначенияПеречисления.КорректировкаПоСогласованиюСторон") Тогда
		
		Выполнить("ДокументКорректировки.ВидКорректировки = Перечисления.ХозяйственныеОперации.КорректировкаПоСогласованиюСторон");
			
	КонецЕсли;
	
	Если ПеременнаяСодержитСвойство(ДокументКорректировки, "Ответственный") Тогда
		
		Ответственный = Неопределено;
		
		Если ПеременнаяСодержитСвойство(ПараметрыСеанса, "ТекущийПользователь") Тогда
			
			Ответственный = ПараметрыСеанса.ТекущийПользователь;
			
		КонецЕсли;
		
		Если НЕ Ответственный = Неопределено Тогда
			
			ДокументКорректировки.Ответственный = Ответственный;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ТаблицыДокумента = ТаблицыДокумента_КонтурEDI(ДокументКорректировки);
	
	ОчиститьТабЧастьДокумента_КонтурEDI(ТаблицыДокумента.ТоварыДокумента); 
	ОчиститьТабЧастьДокумента_КонтурEDI(ТаблицыДокумента.УслугиДокумента); 
	
	ЕстьСтрокиУслуг = Ложь;
				
	Суффикс = "Принято";
		
	ДопПараметрыСтрокиДокумента = ДопПараметрыСтрокиДокумента_КонтурEDI(ДокументКорректировки);
	
	СтрокиДляСортировки = Новый Соответствие;
	
	Для Каждого СтрокаСоответствий Из _Таб Цикл
		
		Если ИмяКонфигурации1С = "УФ_УТ"
			И СтрокаСоответствий["Количество" + Суффикс] = 0 Тогда
			
			 Продолжить;
			
		КонецЕсли;
						
		РезультатПоискаСтроки = 
		ПоискСтрокиВДокументе_КонтурEDI(СтрокаСоответствий, ТаблицыДокумента, ДопПараметрыСтрокиДокумента.СуммаВключаетНДС, Истина);
		
		Если РезультатПоискаСтроки.НашлиВТаре Тогда
			Продолжить;	
		КонецЕсли;     
		
		НайденнаяСтрока = РезультатПоискаСтроки.НайденнаяСтрока;
		
		ТабличнаяЧастьСтроки = РезультатПоискаСтроки.ТабличнаяЧастьСтроки;
		
		Если ТабличнаяЧастьСтроки = Неопределено Тогда
			ТабличнаяЧастьСтроки = ТаблицыДокумента.ТоварыДокумента;
		КонецЕсли;
		
		ЕстьСтрокиУслуг = ЕстьСтрокиУслуг ИЛИ РезультатПоискаСтроки.НашлиВУслугах;
	
		// ... добавить строку
		СтрокаДокумента = ТабличнаяЧастьСтроки.Добавить();
		
		// ... параметры для ввода строки
		
		СвойстваСтрокиДляСортировки = Новый Структура("ТабличнаяЧастьСтроки,НомерСтроки");
		СвойстваСтрокиДляСортировки.ТабличнаяЧастьСтроки = ТабличнаяЧастьСтроки;
		
		Если НайденнаяСтрока = Неопределено Тогда
			
			ПараметрыСтроки = ПараметрыЗаполненияСтрокиДокумента_КонтурEDI(СтрокаДокумента, СтрокаСоответствий, ДопПараметрыСтрокиДокумента, Суффикс); 	
			  			
		Иначе
			
			ПараметрыСтроки = ПараметрыЗаполненияСтрокиДокумента_КонтурEDI(НайденнаяСтрока, СтрокаСоответствий, ДопПараметрыСтрокиДокумента, Суффикс);
			    						
			СвойстваСтрокиДляСортировки.НомерСтроки = НайденнаяСтрока.НомерСтроки;  			 			
			
		КонецЕсли; 
		
		СтрокиДляСортировки.Вставить(СтрокаДокумента, СвойстваСтрокиДляСортировки);
		
		// ... заполнить строку по параметрам
		ЗаполнитьСтрокуДокумента_КонтурEDI(ДокументКорректировки, СтрокаДокумента, ПараметрыСтроки, НайденнаяСтрока, СтрокаСоответствий);
		
	КонецЦикла;
	
	Для Каждого ЭлементСортировки Из СтрокиДляСортировки Цикл
		
		СтрокаДокумента = ЭлементСортировки.Ключ;
		ТабличнаяЧастьСтроки = ЭлементСортировки.Значение.ТабличнаяЧастьСтроки;
		
		Если ЭлементСортировки.Значение.НомерСтроки <> Неопределено Тогда
			НомерСтроки = ЭлементСортировки.Значение.НомерСтроки;
		Иначе
			НомерСтроки = ТабличнаяЧастьСтроки.Количество();
		КонецЕсли; 		
		
		Если НомерСтроки <= ТабличнаяЧастьСтроки.Количество() Тогда
        	ТабличнаяЧастьСтроки.Сдвинуть(СтрокаДокумента, НомерСтроки - СтрокаДокумента.НомерСтроки);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЕстьСтрокиУслуг = Ложь И ТаблицыДокумента.УслугиДокумента <> Неопределено Тогда
		ТаблицыДокумента.УслугиДокумента.Загрузить(ТаблицыДокумента.КопияУслуг);
	КонецЕсли;
	
	Если ИмяКонфигурации1С = "УФ_УТ"  Тогда
		
		Если РелизКонфигурации1С = "11.1" Тогда 
			
			ДокументКорректировки.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.КорректировкаПоСогласованиюСторон;
					
			ПеременнаяСодержитСвойство(ПланыВидовХарактеристик.СтатьиРасходов, "СебестоимостьПродаж", ДокументКорректировки.СтатьяРасходов);
			ПеременнаяСодержитСвойство(ПланыВидовХарактеристик.СтатьиРасходов, "РазницыСтоимостиВозвратаИФактическойСтоимостиТоваров", ДокументКорректировки.СтатьяРасходов); 
								
		Иначе
			
			ДокументКорректировки.СтатьяРасходов = ПланыВидовХарактеристик.СтатьиРасходов.СебестоимостьПродаж;
			
		КонецЕсли;
		
		Попытка

			Если Не ЗначениеЗаполнено(ДокументКорректировки.ДокументОснование) Тогда
				ДокументКорректировки.ДокументОснование = ДокументОснование;	
			КонецЕсли;	
			
			Документы.КорректировкаРеализации.ЗаполнитьРасхождения(ДокументКорректировки);

		Исключение
			
			ДокументКорректировки.ЗаполнитьРасхождения(); 
			
			Попытка 
				
				МодульНоменклатураСервер = Вычислить("НоменклатураСервер");
				
				ПараметрыУказанияСерий = МодульНоменклатураСервер.ПараметрыУказанияСерий(ДокументКорректировки, Документы.КорректировкаРеализации);
				
				Если ПеременнаяСодержитСвойство(ПараметрыУказанияСерий, "Расхождения") Тогда
					МодульНоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(ДокументКорректировки, ПараметрыУказанияСерий.Расхождения); 
				Иначе
					ПараметрыУказанияСерий.ИмяТЧТовары = "Расхождения";
					ПараметрыУказанияСерий.ИмяТЧСерии  = "Расхождения";
					МодульНоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(ДокументКорректировки, ПараметрыУказанияСерий); 
				КонецЕсли;
					
				СтруктураДействий = Новый Структура;
				СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
				КэшированныеЗначения = ОбработкаТабличнойЧастиКлиентСервер_ПолучитьСтруктуруКэшируемыеЗначения();
				   				
				ОбработкаТабличнойЧастиСервер_ОбработатьТЧ(ДокументКорректировки.Расхождения, СтруктураДействий, КэшированныеЗначения);

			Исключение
				
			КонецПопытки;
			
		КонецПопытки;   
		
		ДокументКорректировки.АналитикаРасходов = ДокументКорректировки.Партнер;
		
		Для Каждого Строкарасхождений Из ДокументКорректировки.Расхождения Цикл
			
			Если СтрокаРасхождений.Количество < 0 Тогда
				СтрокаРасхождений.ВариантОтражения = Перечисления.ВариантыОтраженияКорректировокРеализаций.УменьшитьРеализациюУвеличитьСкладскиеОстатки;
			ИначеЕсли СтрокаРасхождений.Количество > 0 Тогда
				СтрокаРасхождений.ВариантОтражения = Перечисления.ВариантыОтраженияКорректировокРеализаций.УвеличитьРеализациюУменьшитьСкладскиеОстатки;
			ИначеЕсли Не ЗначениеЗаполнено(СтрокаРасхождений.ВариантОтражения) Тогда
				СтрокаРасхождений.ВариантОтражения = Перечисления.ВариантыОтраженияКорректировокРеализаций.СписатьНаРасходы;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ВозвратОбъекта Тогда
		
		Возврат ДокументКорректировки;
		
	Иначе
		
		Попытка
			ДокументКорректировки.Записать(РежимЗаписиДокумента.Проведение);    		
		Исключение
			ДокументКорректировки.Записать();
		КонецПопытки;     	
		
		Возврат ДокументКорректировки.Ссылка;
		
	КонецЕсли;

КонецФункции

Функция СоздатьВозвратПоРезультатамПриемки_КонтурEDI(_Таб, ДокументОснование, ВозвратОбъекта = Ложь, ДокументВозврата = Неопределено) Экспорт
	
	Если ДокументВозврата = Неопределено Тогда
		ДокументВозврата = Документы[ПолучитьТипЗначенияОбъекта("ВходящийВозврат",,Истина)].СоздатьДокумент();
	КонецЕсли;
	
	ДокументВозврата.Дата = ТекущаяДатаСеанса();
	
	ТаблицыДокумента = ТаблицыДокумента_КонтурEDI(ДокументВозврата, Истина, Истина);

	ОчиститьТабЧастьДокумента_КонтурEDI(ТаблицыДокумента.ТоварыДокумента); 
	ОчиститьТабЧастьДокумента_КонтурEDI(ТаблицыДокумента.ТараДокумента);
	ОчиститьТабЧастьДокумента_КонтурEDI(ТаблицыДокумента.УслугиДокумента);
	
	ДокументВозврата.Заполнить(ДокументОснование);
	
	Если ИмяКонфигурации1С = "ДалионУМ" Тогда
		
		ДокументВозврата.УчитыватьНДС 		= ДокументОснование.УчитыватьНДС;
		ДокументВозврата.СуммаВключаетНДС 	= ДокументОснование.СуммаВключаетНДС;
		
	КонецЕсли;

	СписокОшибок = "";
	ЗаполнитьТоварыДокумента_Возврат(ДокументВозврата, _Таб, СписокОшибок);
	
	Если Не ЗначениеЗаполнено(СписокОшибок) Тогда
		
		Если Имяконфигурации1С = "УФ_УТ" Тогда 
			
			Если ДокументВозврата.РасшифровкаПлатежа.Количество() = 1 Тогда
				
				СтрокаТаблицы = ДокументВозврата.РасшифровкаПлатежа[0];
				СтрокаТаблицы.Сумма = ДокументВозврата.Товары.Итог("СуммаСНДС");
				СтрокаТаблицы.СуммаВзаиморасчетов = 0;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ВозвратОбъекта Тогда
			
			СсылкаНаДокумент = ДокументВозврата;
			
		Иначе
			
			Попытка
				ДокументВозврата.Записать(РежимЗаписиДокумента.Проведение);    		
			Исключение
				ДокументВозврата.Записать();
			КонецПопытки;     	
			
			СсылкаНаДокумент = ДокументВозврата.Ссылка;  
			
		КонецЕсли;
				
	Иначе
		
		Сообщить("Не удалось создать документ возврата от покупателя");
		Сообщить(СписокОшибок);
		
		СсылкаНаДокумент = Неопределено;
		
	КонецЕсли;
	
	Возврат СсылкаНаДокумент;

КонецФункции

Процедура ЗаполнитьТоварыДокумента_Возврат(Док, ТабСоответствий, СписокОшибок)
			
	ТаблицыДокумента = ТаблицыДокумента_КонтурEDI(Док, Истина, Истина);

	ОчиститьТабЧастьДокумента_КонтурEDI(ТаблицыДокумента.ТоварыДокумента); 
	ОчиститьТабЧастьДокумента_КонтурEDI(ТаблицыДокумента.ТараДокумента);
	ОчиститьТабЧастьДокумента_КонтурEDI(ТаблицыДокумента.УслугиДокумента); 
	
	ЕстьСтрокиУслуг = Ложь;
	ЕстьСтрокиТары = Ложь;
			
	Суффикс1 = "Принято";
	Суффикс2 = "ВНакладной";
	ЭтоВозврат = Истина;

	ДопПараметрыСтрокиДокумента = ДопПараметрыСтрокиДокумента_КонтурEDI(Док, ЭтоВозврат);
	 	
	Для Каждого СтрокаСоответствий Из ТабСоответствий Цикл
		
		// ... поиск строки
		РезультатПоискаСтроки = ПоискСтрокиВДокументе_КонтурEDI(СтрокаСоответствий, ТаблицыДокумента, ДопПараметрыСтрокиДокумента.СуммаВключаетНДС, Истина);
		
		НайденнаяСтрока = РезультатПоискаСтроки.НайденнаяСтрока;
		
		ТабличнаяЧастьСтроки = РезультатПоискаСтроки.ТабличнаяЧастьСтроки;
		
		Если ТабличнаяЧастьСтроки = Неопределено Тогда
			ТабличнаяЧастьСтроки = ТаблицыДокумента.ТоварыДокумента;
		КонецЕсли;
		
		ЕстьСтрокиУслуг = ЕстьСтрокиУслуг ИЛИ РезультатПоискаСтроки.НашлиВУслугах;
		ЕстьСтрокиТары = ЕстьСтрокиТары ИЛИ РезультатПоискаСтроки.НашлиВТаре;
		
		Если НЕ НайденнаяСтрока = Неопределено Тогда
			
			Если СтрокаСоответствий.КоличествоПринято < СтрокаСоответствий.КоличествоВНакладной Тогда
				
				// ... добавить строку
				СтрокаДокумента = ТабличнаяЧастьСтроки.Добавить();
				
				// ... параметры для ввода строки
				Если НайденнаяСтрока = Неопределено Тогда
					ПараметрыСтроки = ПараметрыЗаполненияСтрокиДокумента_КонтурEDI(СтрокаДокумента, СтрокаСоответствий, ДопПараметрыСтрокиДокумента, Суффикс1, Суффикс2); 	
				Иначе
					ПараметрыСтроки = ПараметрыЗаполненияСтрокиДокумента_КонтурEDI(НайденнаяСтрока, СтрокаСоответствий, ДопПараметрыСтрокиДокумента, Суффикс1, Суффикс2);
				КонецЕсли;
				
				// ... заполнить строку по параметрам
				ЗаполнитьСтрокуДокумента_КонтурEDI(Док, СтрокаДокумента, ПараметрыСтроки, НайденнаяСтрока, СтрокаСоответствий);  
				
			ИначеЕсли СтрокаСоответствий.КоличествоПринято > СтрокаСоответствий.КоличествоВНакладной Тогда
				
				Если СписокОшибок <> "" Тогда
					СписокОшибок = СписокОшибок + Символы.ПС;
				КонецЕсли;
				
				СписокОшибок =
				СписокОшибок +
				"Товар """ + 
				СтрокаСоответствий.Номенклатура + 
				""" принят сетью в количестве " + 
				СтрокаСоответствий.КоличествоПринято + 
				", а отгружался в количестве " + 
				СтрокаСоответствий.КоличествоВНакладной + 
				".";
				
			КонецЕсли;
			
		ИначеЕсли НЕ СтрокаСоответствий.КоличествоПринято = 0 Тогда
			
			Если СписокОшибок <> "" Тогда
				СписокОшибок = СписокОшибок + Символы.ПС;
			КонецЕсли;
			
			СписокОшибок = 
			СписокОшибок +
			"Товар """ +
			СтрокаСоответствий.Номенклатура + 
			""" принят сетью, но не отгружался, либо расхождения по товару уже обработаны.";
			
		КонецЕсли;
			
	КонецЦикла;//по строкам
	
	Если ЕстьСтрокиУслуг = Ложь И ТаблицыДокумента.УслугиДокумента <> Неопределено Тогда
		ТаблицыДокумента.УслугиДокумента.Загрузить(ТаблицыДокумента.КопияУслуг);
	КонецЕсли;
	
	Если ЕстьСтрокиТары = Ложь И ТаблицыДокумента.ТараДокумента <> Неопределено Тогда
		ТаблицыДокумента.ТараДокумента.Загрузить(ТаблицыДокумента.КопияТары);
	КонецЕсли;   
	
КонецПроцедуры

Процедура ЗаполнитьТоварыДокументаПоПриемке_Реализация_Заказ(Док, ТабСоответствий, ВариантЗаполнения) Экспорт
	
	СтандартнаяОбработкаEDI = Истина;
	
	ПараметрыПМ = Новый Структура(
	"ДокументОбъект,ТаблицаТоваров,ВариантЗаполнения", 
	Док, ТабСоответствий, ВариантЗаполнения);
	
	ОбработкаСобытияПодключаемогоМодуля("ЗаполнитьТоварыДокумента_Реализация", СтандартнаяОбработкаEDI, ПараметрыПМ);
			
	Если СтандартнаяОбработкаEDI = Ложь Тогда
		Возврат;
	КонецЕсли;	
		
	ТаблицыДокумента = ТаблицыДокумента_КонтурEDI(Док, Истина, Истина);
	
	ОчиститьТабЧастьДокумента_КонтурEDI(ТаблицыДокумента.ТоварыДокумента); 
	ОчиститьТабЧастьДокумента_КонтурEDI(ТаблицыДокумента.ТараДокумента);
	ОчиститьТабЧастьДокумента_КонтурEDI(ТаблицыДокумента.УслугиДокумента);
	
	ЕстьСтрокиУслуг = Ложь;
	ЕстьСтрокиТары = Ложь;
			
	Суффикс = "Принято";
	  			  
	МассивСтрокДляСвоихЦен = Новый Массив; 
	
	ДопПараметрыСтрокиДокумента = ДопПараметрыСтрокиДокумента_КонтурEDI(Док);
		
	Для Каждого СтрокаСоответствий Из ТабСоответствий Цикл
					
		// ... поиск строки
		РезультатПоискаСтроки = 
		ПоискСтрокиВДокументе_КонтурEDI(СтрокаСоответствий, ТаблицыДокумента, ДопПараметрыСтрокиДокумента.СуммаВключаетНДС, Истина);
		
		НайденнаяСтрока = РезультатПоискаСтроки.НайденнаяСтрока;
		
		ТабличнаяЧастьСтроки = РезультатПоискаСтроки.ТабличнаяЧастьСтроки;
		
		Если ТабличнаяЧастьСтроки = Неопределено Тогда
			ТабличнаяЧастьСтроки = ТаблицыДокумента.ТоварыДокумента;
		КонецЕсли;
		
		ЕстьСтрокиУслуг = ЕстьСтрокиУслуг ИЛИ РезультатПоискаСтроки.НашлиВУслугах;
		ЕстьСтрокиТары = ЕстьСтрокиТары ИЛИ РезультатПоискаСтроки.НашлиВТаре;
		
		// ... не добавлять строку с нулевым количеством
		Если СтрокаСоответствий.КоличествоПринято <= 0 Тогда
			
			Продолжить;
			
		КонецЕсли;

		// ... добавить строку
		СтрокаДокумента = ТабличнаяЧастьСтроки.Добавить();
		
		// ... параметры для ввода строки
		Если НайденнаяСтрока = Неопределено Тогда
			ПараметрыСтроки = ПараметрыЗаполненияСтрокиДокумента_КонтурEDI(СтрокаДокумента, СтрокаСоответствий, ДопПараметрыСтрокиДокумента, Суффикс); 	
		Иначе
			ПараметрыСтроки = ПараметрыЗаполненияСтрокиДокумента_КонтурEDI(НайденнаяСтрока, СтрокаСоответствий, ДопПараметрыСтрокиДокумента, Суффикс);
		КонецЕсли;
		
		// ... заполнить строку по параметрам
		ЗаполнитьСтрокуДокумента_КонтурEDI(Док, СтрокаДокумента, ПараметрыСтроки, НайденнаяСтрока, СтрокаСоответствий); 
				
		Если НайденнаяСтрока = Неопределено Тогда
			
			МассивСтрокДляСвоихЦен.Добавить(СтрокаДокумента);
			
		КонецЕсли;
				
	КонецЦикла;
	
	ТипЦен = Неопределено;
		 
	Если ПеременнаяСодержитСвойство(Док, "ТипЦен") Тогда
		ТипЦен = Док.ТипЦен;
	ИначеЕсли ПеременнаяСодержитСвойство(Док, "ВидЦен") Тогда
		ТипЦен = Док.ВидЦен;
	ИначеЕсли ПеременнаяСодержитСвойство(Док, "КатегорияЦен") Тогда
		ТипЦен = Док.КатегорияЦен;		
	КонецЕсли;  
	
	Если ЕстьСтрокиУслуг = Ложь И ТаблицыДокумента.УслугиДокумента <> Неопределено Тогда
		ТаблицыДокумента.УслугиДокумента.Загрузить(ТаблицыДокумента.КопияУслуг);
	КонецЕсли;
	
	Если ЕстьСтрокиТары = Ложь И ТаблицыДокумента.ТараДокумента <> Неопределено Тогда
		ТаблицыДокумента.ТараДокумента.Загрузить(ТаблицыДокумента.КопияТары);
	КонецЕсли;  
	
	ЗаполнитьСтрокиТаблицыСвоимиЦенами(МассивСтрокДляСвоихЦен, ТипЦен, Док.Дата, Ложь, Истина, Док);
	
	Если ВариантЗаполнения = "Заказ" И ИмяКонфигурации1С = "УФ_УТ" 
		И ЕстьРеквизитОбъекта_Контур(Док, "ВариантОбеспечения", "Товары")
		И ПолучитьФункциональнуюОпцию_КонтурEDI("ИспользоватьПострочнуюОтгрузкуВЗаказеКлиента") = Ложь Тогда
		
		ВариантОбеспеченияУстановлен = Ложь;
		ТекстыОшибок = Новый Массив;
		
		Попытка
			
			ОбщийМодуль_ПродажиСервер = ОбщийМодуль1С_КонтурEDI("ПродажиСервер");
			ОбщийМодуль_ОбеспечениеКлиентСервер = ОбщийМодуль1С_КонтурEDI("ОбеспечениеКлиентСервер");
			
			ВариантыОбеспечения = ОбщийМодуль_ПродажиСервер.ВариантыОбеспеченияПоУмолчанию(Док.Соглашение, Док.Статус);
			
			СтруктураДействий = Новый Структура();
			ПараметрыДействия = ОбщийМодуль_ОбеспечениеКлиентСервер.ПараметрыДействияПроверитьЗаполнитьОбеспечение(ВариантыОбеспечения);
			СтруктураДействий.Вставить("ПроверитьЗаполнитьОбеспечениеВДокументеПродажи", ПараметрыДействия);
			
			ОбработкаТабличнойЧастиСервер_ОбработатьТЧ(Док.Товары, СтруктураДействий, Неопределено);
			
			ВариантОбеспеченияУстановлен = Истина;
			
		Исключение
			
			ТекстыОшибок.Добавить(ОписаниеОшибки());
			
		КонецПопытки;
		
		Если Не ВариантОбеспеченияУстановлен Тогда
			
			Попытка
				
				СтруктураДействий = Новый Структура();
				ПараметрыДокумента = Документы.ЗаказКлиента.ПараметрыДокументаДляДействийОбеспечения(Док);
				
				ОбщийМодуль_ОбеспечениеВДокументахКлиентСервер = ОбщийМодуль1С_КонтурEDI("ОбеспечениеВДокументахКлиентСервер");
				ОбщийМодуль_ОбеспечениеВДокументахКлиентСервер.ДобавитьДействияОбеспечения(
					СтруктураДействий,
					"ВариантОбеспечения",
					ПараметрыДокумента);
				
				ОбработкаТабличнойЧастиСервер_ОбработатьТЧ(Док.Товары, СтруктураДействий, Неопределено);
				
				ВариантОбеспеченияУстановлен = Истина;
				
			Исключение
				
				ТекстыОшибок.Добавить(ОписаниеОшибки());
				
			КонецПопытки;
			
		КонецЕсли;
		
		Если Не ВариантОбеспеченияУстановлен Тогда
			
			ТекстыОшибок.Вставить(0, "Не удалось заполнить обеспечение в документе 'Заказ клиента':");
			ТекстОшибкиОбщий = КонтурСтандарт_СтрСоединить_(ТекстыОшибок, Символы.ПС);
			ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстОшибкиОбщий);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ЗаполнитьТоварыДокументаПоУточнениюЗаказа(ДокументСсылка, СообщениеСсылка, ТаблицаСравнения = Неопределено) Экспорт
	
	Результат = ИнициализироватьСтруктуруРезультатаФункции(Ложь);
	
	НачатьТранзакцию();
	
	Попытка 
		
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
		Сообщение = СообщениеСсылка.Хранилище.Получить();
		
		СтандартнаяОбработкаEDI = Истина;
		
		ПараметрыПМ = Новый Структура;
		ПараметрыПМ.Вставить("ДокументОбъект", ДокументОбъект);
		ПараметрыПМ.Вставить("Сообщение", Сообщение);
		ПараметрыПМ.Вставить("Результат", Результат);
		ПараметрыПМ.Вставить("ТаблицаСравнения", ТаблицаСравнения);
		
		ОбработкаСобытияПодключаемогоМодуля("ЗаполнитьТоварыДокументаПоУточнениюЗаказа", СтандартнаяОбработкаEDI, ПараметрыПМ);
		
		ЗаписатьДокумент = Истина;
		
		Если СтандартнаяОбработкаEDI = Истина Тогда
		
			Если ИмяКонфигурации1С = "ТКПТ" Тогда
				
				ЗаполнитьТоварыДокументаПоУточнениюЗаказа_ТКПТ(ДокументОбъект, ТаблицаСравнения);
				
			ИначеЕсли ИмяКонфигурации1С = "УТ_10_3" Тогда
				
				ЗаполнитьТоварыДокументаПоУточнениюЗаказа_УТ_10_3(ДокументОбъект, Сообщение);
							
			ИначеЕсли ИмяКонфигурации1С = "УФ_УТ" Тогда
				
				ЗаполнитьТоварыДокументаПоУточнениюЗаказа_УФ_УТ(ДокументОбъект, Сообщение);
				
			Иначе
				
				ЗаписатьДокумент = Ложь;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗаписатьДокумент Тогда
			ДокументОбъект.Записать();
		КонецЕсли;
		
		Результат.Успешно = Истина; 
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
	
		Результат.Успешно = Ложь;
		Результат.ОписаниеОшибки = "Не удалось перенести уточнение заказа в документ " + ДокументСсылка + " по причине:
					   				|" + ОписаниеОшибки();
		
		Метрика_Ошибка("ЗаполнитьТоварыДокументаПоУточнениюЗаказа", Результат.ОписаниеОшибки, ИнформацияОбОшибке(), Неопределено, Истина);
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьТоварыДокументаПоУточнениюЗаказа_ТКПТ(ДокументОбъект, ТаблицаСравнения)
	
	ТабЧастьЗаказ = ДокументОбъект.Товары;
	Для Каждого СтрокаСравнения Из ТаблицаСравнения Цикл
		Если Не (СтрокаСравнения.КоличествоЗаказали = СтрокаСравнения.КоличествоПодтвердили) Тогда
			СтрокаТабЧастиЗаказа = ТабЧастьЗаказ.Найти(СтрокаСравнения.Номенклатура,"Номенклатура");
			Если Не СтрокаТабЧастиЗаказа = Неопределено Тогда
				СтрокаТабЧастиЗаказа.КоличествоФактическое = СтрокаСравнения.КоличествоПодтвердили;	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТоварыДокументаПоУточнениюЗаказа_УТ_10_3(ДокументОбъект, Сообщение)
	
	ИмяТабЧастиТовары = "Товары";
	ИмяТабЧастиУслуги = "Услуги";
	
	НастройкиРаботыСУслугами = ПолучитьСписокСвойствEDI("РаботаСУслугами,ЗагружатьУслугиВТабЧастьУслуги",Сообщение.Партнер);
	ОбщийМодульОбработкаТабличныхЧастейМетаданные = Метаданные.ОбщиеМодули.Найти("ОбработкаТабличныхЧастей");
	
	Если ОбщийМодульОбработкаТабличныхЧастейМетаданные = Неопределено
		ИЛИ ОбщийМодульОбработкаТабличныхЧастейМетаданные.Глобальный Тогда
		ОбщийМодульОбработкаТабличныхЧастей = Неопределено;
	Иначе
		ОбщийМодульОбработкаТабличныхЧастей = ОбщийМодуль1С_КонтурEDI("ОбработкаТабличныхЧастей");
	КонецЕсли;
	
	ТипЕдиницыИзмерения 			= ПолучитьТипЗначенияОбъекта("ЕдиницаИзмерения",,Истина);   
	ЕстьКоэффициент 				= ЕстьРеквизитОбъекта_Контур(ДокументОбъект,"Коэффициент",ИмяТабЧастиТовары) И 
									  ЕстьНеобходимыеМетаданные("Справочники." +ТипЕдиницыИзмерения+ ".Реквизиты.Коэффициент");

	
	СуммаВключаетНДС = ПолучитьРеквизитДокументаДляСообщения(ДокументОбъект.Ссылка, "СуммаВключаетНДС", Сообщение);
	
	ДокументОбъект[ИмяТабЧастиТовары].Очистить();
	
	Если НастройкиРаботыСУслугами.РаботаСУслугами = Истина 
		И НастройкиРаботыСУслугами.ЗагружатьУслугиВТабЧастьУслуги = Истина Тогда
		
		ДокументОбъект[ИмяТабЧастиУслуги].Очистить();
		
	КонецЕсли;
	
	ПересчитатьТоварыСообщения(Сообщение.Товары, Сообщение.Отправитель1С, "В1С", Сообщение);
	
	Для Каждого СтрокаСообщения Из Сообщение.Товары Цикл
		
		Если СтрокаСообщения.Статус = "Отклонен" ИЛИ СтрокаСообщения.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаСообщения.ТипЕдиницы = "Services" И Не НастройкиРаботыСУслугами.РаботаСУслугами = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаСообщения.ТипЕдиницы = "Services" И НастройкиРаботыСУслугами.ЗагружатьУслугиВТабЧастьУслуги = Истина Тогда
			ИмяТабЧасти = ИмяТабЧастиУслуги;
		Иначе
			ИмяТабЧасти = ИмяТабЧастиТовары;
		КонецЕсли;
		
		СтрокаДокумента = ДокументОбъект[ИмяТабЧасти].Добавить();
		СтрокаДокумента.Номенклатура = СтрокаСообщения.Номенклатура;
		
		Если ИмяТабЧасти = ИмяТабЧастиТовары Тогда
			СтрокаДокумента.ЕдиницаИзмерения = СтрокаСообщения.ЕдиницаИзмерения;
			Если ЕстьКоэффициент Тогда 
				СтрокаДокумента.Коэффициент	= СтрокаДокумента.ЕдиницаИзмерения.Коэффициент;
			КонецЕсли;    
			СтрокаДокумента.ХарактеристикаНоменклатуры = СтрокаСообщения.ХарактеристикаНоменклатуры;
		КонецЕсли;
		
		СтрокаДокумента.Количество = СтрокаСообщения.Количество;
		
		ЗаполнитьНедостающиеПоляСтрокиТоваров(СтрокаСообщения);
		
		Если СуммаВключаетНДС = Истина Тогда
			СтрокаДокумента.Цена = СтрокаСообщения.ЦенаСНДС;
		Иначе
			СтрокаДокумента.Цена = СтрокаСообщения.ЦенаБезНДС;
		КонецЕсли;
		
		ЗаполнитьСтавкуНДСВСтрокеТовараДокумента(СтрокаСообщения, СтрокаДокумента, ДокументОбъект.Дата);
		
		Если Не ОбщийМодульОбработкаТабличныхЧастей = Неопределено Тогда
			
			Если ПеременнаяСодержитСвойство(СтрокаДокумента, "ЕдиницаИзмеренияМест") Тогда
				ОбщийМодульОбработкаТабличныхЧастей.ЗаполнитьЕдиницуМестТабЧасти(СтрокаДокумента, ДокументОбъект, Ложь);
			КонецЕсли;
			
			ОбщийМодульОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрокаДокумента, ДокументОбъект);
			ОбщийМодульОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрокаДокумента, ДокументОбъект);
			
			Если ИмяТабЧасти = ИмяТабЧастиУслуги Тогда
				ОбщийМодульОбработкаТабличныхЧастей.ЗаполнитьСодержаниеТабЧасти(СтрокаДокумента, ДокументОбъект);	
			КонецЕсли;
			
		ИначеЕсли Не ОбщийМодульОбработкаТабличныхЧастейМетаданные = Неопределено Тогда
			
			Выполнить("РассчитатьСуммуТабЧасти(СтрокаДокумента, ДокументОбъект);");
			Выполнить("РассчитатьСуммуНДСТабЧасти(СтрокаДокумента, ДокументОбъект);");
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаДокумента.КоличествоМест) Тогда
			СтрокаДокумента.КоличествоМест = СтрокаДокумента.Количество;
			СтрокаДокумента.ЕдиницаИзмеренияМест = СтрокаДокумента.ЕдиницаИзмерения;
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура ЗаполнитьТоварыДокументаПоУточнениюЗаказа_УФ_УТ(ДокументОбъект, Сообщение)
	
	РаботаСУслугами = ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, "РаботаСУслугами");
	ОбщийМодульЦенообразование = ОбщийМодуль1С_КонтурEDI("Ценообразование");
	ОбщийМодульЦенообразованиеКлиентСервер = ОбщийМодуль1С_КонтурEDI("ЦенообразованиеКлиентСервер");
	
	СуммаВключаетНДС = ПолучитьРеквизитДокументаДляСообщения(ДокументОбъект.Ссылка, "СуммаВключаетНДС", Сообщение); 
	
	ПересчитатьТоварыСообщения(Сообщение.Товары, Сообщение.Отправитель1С, "В1С", Сообщение);
	
	ДокументОбъект.Товары.Очистить();

	Для Каждого СтрокаСообщения Из Сообщение.Товары Цикл

		Если СтрокаСообщения.Статус = "Отклонен" ИЛИ СтрокаСообщения.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаСообщения.ТипЕдиницы = "Services" И Не РаботаСУслугами = Истина Тогда
			Продолжить;
		КонецЕсли;

		СтрокаДокумента = ДокументОбъект.Товары.Добавить();
			
		СтрокаДокумента.Номенклатура		= СтрокаСообщения.Номенклатура;
		СтрокаДокумента.Характеристика		= СтрокаСообщения.ХарактеристикаНоменклатуры;
		СтрокаДокумента.Упаковка			= СтрокаСообщения.ЕдиницаИзмерения;
		СтрокаДокумента.КоличествоУпаковок	= СтрокаСообщения.Количество;
		
		СтрокаДокумента.Склад = ДокументОбъект.Склад;
		
		Если Не ЗначениеЗаполнено(СтрокаДокумента.Упаковка) Тогда
			
			СтрокаДокумента.Количество = СтрокаСообщения.Количество;
			
		ИначеЕсли РелизКонфигурации1С = "11.2" И (Не ОбщийМодульОбработкаТабличнойЧасти_УФ_УТ("ОбработкаТабличнойЧастиСервер") = Неопределено) Тогда
			
			СтруктураДействий = Новый Структура;
											
			СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
			СтруктураДействий.Вставить("ПроверитьЗаполнитьУпаковкуПоВладельцу", СтрокаДокумента.Упаковка);
					
			ОбработкаТабличнойЧастиСервер_ОбработатьСтрокуТЧ(СтрокаДокумента, СтруктураДействий, Неопределено);
			
		Иначе
			
			СтрокаДокумента.Количество = СтрокаСообщения.Количество * ПолучитьКоэффициентУпаковкиУФ_УТ(СтрокаДокумента.Упаковка);
			
		КонецЕсли;

		ЗаполнитьСтавкуНДСВСтрокеТовараДокумента(СтрокаСообщения, СтрокаДокумента, ДокументОбъект.Дата);
		ЗаполнитьНедостающиеПоляСтрокиТоваров(СтрокаСообщения);
		
		Если СуммаВключаетНДС Тогда
			СтрокаДокумента.Цена = СтрокаСообщения.ЦенаСНДС;
		Иначе        
			СтрокаДокумента.Цена = СтрокаСообщения.ЦенаБезНДС;
		КонецЕсли;	
		
		Попытка
			СтрокаДокумента.СуммаНДС = ОбщийМодульЦенообразование.РассчитатьСуммуНДС(СтрокаДокумента.Сумма, СтрокаДокумента.СтавкаНДС, СуммаВключаетНДС);
		Исключение
			СтрокаДокумента.СуммаНДС = ОбщийМодульЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(СтрокаДокумента.Сумма, СтрокаДокумента.СтавкаНДС, СуммаВключаетНДС);
		КонецПопытки;
		
		ОбщийМодульЦенообразование.ПересчитатьСуммыВСтроке(СтрокаДокумента,Ложь,Ложь,Ложь,СуммаВключаетНДС);
		
	КонецЦикла;	
	
КонецПроцедуры

Функция ОпределитьПартнераСообщения(Сообщение) Экспорт
	
	//перенаправление в функцию ОпределитьПартнера(Параметры) 
	Возврат ОпределитьПартнера(Новый Структура("ТипЗначения,Сообщение","Сообщение",Сообщение));	
	
КонецФункции

//}}}


//{{{ Конвертации из 1С в EDI

Процедура КонвертироватьСообщение1СвEDI(Сообщение) Экспорт
	
	КонвертироватьШапкуСообщения1СвEDI(Сообщение);
	
	Если Сообщение.ТипСообщения = "IFTMBF"
		ИЛИ Сообщение.ТипСообщения = "IFTMBC" Тогда
		КонвертироватьТабличнуюЧастьСообщения1СвEDI(Сообщение, "Грузополучатели");
	ИначеЕсли Сообщение.ТипСообщения = "DELFOR" Тогда
		КонвертироватьТабличнуюЧастьСообщения1СвEDI(Сообщение, "Графики");	
	Иначе	
		КонвертироватьТабличнуюЧастьСообщения1СвEDI(Сообщение, "Товары");
	КонецЕсли;
	
	Если Сообщение.ТипСообщения = "ALCRPT" Тогда
		
	//	ЗаполнитьАлкогольныеРеквизиты(Сообщение); //пока заполняем только в ПМ
		
		РезультатЗаполнения = ОбработкаСобытияПодключаемогоМодуля("ЗаполнитьАлкогольныеРеквизиты",,
				Новый Структура("Сообщение",
				Сообщение));
		
		СтарНастройкаСвоиРеквизиты =  ПараметрыПользователяEDI.НеБратьСвоиАдресаИз1С;
		ПараметрыПользователяEDI.НеБратьСвоиАдресаИз1С = Ложь;
		СтарНастройкаЧужиеРеквизиты =  ПараметрыПользователяEDI.НеБратьАдресаПартнераИз1С;
		ПараметрыПользователяEDI.НеБратьАдресаПартнераИз1С = Ложь;
		
		Для Каждого Стр ИЗ Сообщение.Товары Цикл
			Если ЗначениеЗаполнено(Стр.АлкоПроизводитель1С) Тогда
				Стр.АлкоПроизводительEDI			= КонвертироватьЗначение1СвEDI(Стр.АлкоПроизводитель1С,				"ЮрФизЛицоСтороннее","ЮрФизЛицо");
			КонецЕсли;
			Если ЗначениеЗаполнено(Стр.АлкоИностранныйПроизводитель1С) Тогда
				Стр.АлкоИностранныйПроизводительEDI = КонвертироватьЗначение1СвEDI(Стр.АлкоИностранныйПроизводитель1С,	"ЮрФизЛицоСтороннее","ЮрФизЛицо");
			КонецЕсли;
			Если ЗначениеЗаполнено(Стр.Страна1С) Тогда
				Стр.СтранаEDI = КонвертироватьЗначение1СвEDI(Стр.Страна1С,	"Страна","Страна");
			КонецЕсли;
			Если ЗначениеЗаполнено(Стр.НомерГТД1С) Тогда
				Стр.НомерГТДEDI = КонвертироватьЗначение1СвEDI(Стр.НомерГТД1С,	"НомерГТД","НомерГТД");
			КонецЕсли;
		КонецЦикла;
		
		ПараметрыПользователяEDI.НеБратьСвоиАдресаИз1С = СтарНастройкаСвоиРеквизиты;
		ПараметрыПользователяEDI.НеБратьАдресаПартнераИз1С = СтарНастройкаЧужиеРеквизиты;
		
	КонецЕсли;
	
	СтандартнаяОбработкаEDI = Истина;

	РезультатПМ = ОбработкаСобытияПодключаемогоМодуля("ПослеКонвертацииСообщения1СвEDI",СтандартнаяОбработкаEDI,
			Новый Структура("Сообщение",
			Сообщение));
			
	Если РезультатПМ <> Неопределено Тогда
		Сообщение = РезультатПМ;
	КонецЕсли;	
	
	Если СтандартнаяОбработкаEDI Тогда
	
		ПослеКонвертацииСообщения1СвEDI(Сообщение);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура КонвертироватьШапкуСообщения1СвEDI(Сообщение)
	
	МетаданныеСообщения = ПолучитьМетаданныеСообщения(Сообщение.ТипСообщения, Сообщение.Направление);	
	ДополнитьМетаданныеПоСообщению(МетаданныеСообщения, Сообщение);
	
	Для каждого ПолеСообщения Из МетаданныеСообщения Цикл
		
		Если ПолеСообщения.ИмяТаблицы = Неопределено Тогда
			
			Если ПолеСообщения.Принадлежность = Неопределено Тогда
				
				Если ПолеСообщения.ВидСтруктурыEDI = Неопределено Тогда
					ТипEDI = ПолеСообщения.ТипEDI;
				Иначе
					ТипEDI = ПолеСообщения.ВидСтруктурыEDI;
				КонецЕсли;
				
				Если ТипEDI = "Заказ" ИЛИ ТипEDI = "Накладная" ИЛИ ТипEDI = "Приемка" Тогда
					Если НЕ ЗначениеЗаполнено(ПолеСообщения.Тип1С) Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				
				РезультатКонвертации = КонвертироватьЗначение1СвEDI(Сообщение[ПолеСообщения.ИмяПоля+"1С"],ПолеСообщения.Тип1С,ТипEDI,Сообщение);
				
				Если НЕ РезультатКонвертации = Неопределено Тогда
					
					Сообщение[ПолеСообщения.ИмяПоля + "EDI"] = РезультатКонвертации;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция КонвертироватьЗначение1СвEDI(Значение,Тип1С,ТипEDI,Сообщение =  Неопределено) Экспорт
	
	СтандартнаяОбработкаEDI = Истина;
	
	РезультатКонвертации = ОбработкаСобытияПодключаемогоМодуля("КонвертироватьЗначение1СвEDI",СтандартнаяОбработкаEDI,
			Новый Структура("Значение1С, ТипПоля1C, ТипПоляEDI, Сообщение",
			Значение, Тип1С, ТипEDI, Сообщение));

	Если Не СтандартнаяОбработкаEDI Тогда
		
		Возврат РезультатКонвертации;
		
	КонецЕсли;
	
	Если ТипEDI = "ЮрФизЛицо" Тогда
		
		НеБратьСвоиАдресаИз1С = (ПараметрыПользователяEDI.НеБратьСвоиАдресаИз1С = Истина);
		НеБратьАдресаПартнераИз1С = (ПараметрыПользователяEDI.НеБратьАдресаПартнераИз1С = Истина);
		
		Если Тип1С = "ЮрФизЛицоСвое" Тогда
			Возврат ПреобразоватьЮрФизЛицо_1С_в_EDI(Значение,"Юридический", НеБратьСвоиАдресаИз1С);
		ИначеЕсли Тип1С = "Грузоотправитель"  ИЛИ Тип1С = "ТочкаДоставкиСвоя" Тогда
			Возврат ПреобразоватьЮрФизЛицо_1С_в_EDI(Значение,"Фактический", НеБратьСвоиАдресаИз1С);
		ИначеЕсли Тип1С = "ЮрФизЛицоСтороннее" Тогда
			Возврат ПреобразоватьЮрФизЛицо_1С_в_EDI(Значение,"Юридический", НеБратьАдресаПартнераИз1С);
		ИначеЕсли Тип1С = "ТочкаДоставкиСторонняя" Тогда
			Возврат ПреобразоватьЮрФизЛицо_1С_в_EDI(Значение,"Фактический", НеБратьАдресаПартнераИз1С, "ТочкаДоставкиСторонняя",Сообщение);
		ИначеЕсли Тип1С = "Производитель" Тогда
			Возврат ПреобразоватьЮрФизЛицо_1С_в_EDI(Значение, "Юридический");
		ИначеЕсли Тип1С = "ТочкаДоставкиINVRPT" Тогда 
			Если ТипЗнч(Значение) = Тип("СправочникСсылка.КонтурEDI_ТочкиДоставки") Тогда 
				Возврат ПреобразоватьЮрФизЛицо_1С_в_EDI(Значение,"Фактический", НеБратьАдресаПартнераИз1С);
			Иначе
				Возврат ПреобразоватьЮрФизЛицо_1С_в_EDI(Значение,"Фактический", НеБратьСвоиАдресаИз1С);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Тип1С = "ВходящийЗаказПокупателя" 
		Или Тип1С = "ВходящийОбратныйЗаказ" Тогда
		//здесь номер и дату будем брать из входящего сообщения по данному документу
		Если ТипEDI = "ОбратныйЗаказ"
			Или ТипEDI = "Заказ" Тогда
			
			СтруктураДатаНомер = Новый Структура("Номер,Дата");
			
			Если Значение <> Неопределено Тогда
				Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
				Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	КонтурEDI_Сообщения.НомерДокумента,
				|	КонтурEDI_Сообщения.ДатаДокумента
				|ИЗ
				|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
				|ГДЕ
				|	КонтурEDI_Сообщения.ТипСообщения = &ТипСообщения
				|	И КонтурEDI_Сообщения.Направление = &Направление
				|	И КонтурEDI_Сообщения.Документ = &Документ";
				
				Запрос.УстановитьПараметр("Направление",  "Входящее");
				Запрос.УстановитьПараметр("ТипСообщения", ?(Тип1С = "ВходящийОбратныйЗаказ","PORDERS","ORDERS"));
				Запрос.УстановитьПараметр("Документ",	  ПреобразоватьЗначениеДляВнешнегоХранилища(Значение));
				
				РезультатЗапроса = Запрос.Выполнить();
				Если Не РезультатЗапроса.Пустой() Тогда
					Выборка = РезультатЗапроса.Выбрать();
					Выборка.Следующий();
					СтруктураДатаНомер.Номер	= Выборка.НомерДокумента;
					СтруктураДатаНомер.Дата		= Выборка.ДатаДокумента;
				КонецЕсли;
			КонецЕсли;
			
			Возврат СтруктураДатаНомер;	
			
		КонецЕсли;
		
	ИначеЕсли Тип1С = "ИсходящийОбратныйЗаказ" 
		Или Тип1С = "ИсходящийОтветНаЗаказ" 
		Или Тип1С = "ИсходящийЗаказПоставщику"
		Или Тип1С = "ИсходящийОтветНаУведомлениеОВозврате"
		Или Тип1С = "ИсходящееУведомлениеОПриемкеВозврата"
		Или Тип1С = "ИсходящееУведомлениеОПриемке"
		Или Тип1С = "ИсходящийВозврат"
		Или Тип1С = "ИсходящееУведомлениеОбОтгрузкеВозврата" Тогда

		Если ТипEDI = "Документ"
			Или ТипEDI = "ОбратныйЗаказ" 
			Или ТипEDI = "Заказ"
			Или ТипEDI = "Приемка" Тогда
			
			СтруктураДатаНомер = Новый Структура("Номер,Дата");
			Если ЗначениеЗаполнено(Значение) Тогда
				СтруктураДатаНомер.Номер	= Значение.Номер;
				СтруктураДатаНомер.Дата		= Значение.Дата;
			КонецЕсли;
			
			Возврат СтруктураДатаНомер;
			
		КонецЕсли;
		
	ИначеЕсли Тип1С = "ИсходящееУведомлениеОбОтгрузке"
		Или Тип1С = "ИсходящийСчетФактура" 		
		ИЛИ Тип1С = "ИсправляемыйДокументРеализации" 
		ИЛИ Тип1С = "ИсправляемыйСчетФактура" Тогда
			
		Если Тип1С = "ИсправляемыйДокументРеализации"
			ИЛИ Тип1С = "ИсправляемыйСчетФактура" Тогда
			
			СтруктураДокументаEDI = Новый Структура("Номер,Дата,Исправление,НомерИсправления,ДатаИсправления,ДиадокID");
			
		ИначеЕсли Тип1С = "ИсходящийСчетФактура" Тогда
			
			СтруктураДокументаEDI = Новый Структура("Номер,Дата,Исправление,НомерИсправления,ДатаИсправления");
			
		Иначе
			
			СтруктураДокументаEDI = Новый Структура("Номер,Дата");
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Значение) Тогда
			Возврат СтруктураДокументаEDI;
		КонецЕсли;
		
		Если Тип1С = "ИсправляемыйДокументРеализации"
			ИЛИ Тип1С = "ИсправляемыйСчетФактура" Тогда
			
			ИсходныйДокумент = Неопределено;
			
			Если Тип1С = "ИсправляемыйСчетФактура" И Не Сообщение = Неопределено И ПеременнаяСодержитСвойство(Сообщение, "Документ1С") Тогда
				ИсходныйДокумент = ПолучитьПредыдущийСчетФактуру_КонтурEDI(Сообщение.Документ1С, Сообщение);
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ИсходныйДокумент) Тогда
				ИсходныйДокумент = Значение;
			КонецЕсли;
			
			ИсходныеID = ПолучитьСписокСвойствEDI("messageID,invoiceId,UniversalTransferDocumentId", ИсходныйДокумент);
			
			Если ЗначениеЗаполнено(СокрЛП(ИсходныеID.messageID)) 
				И (ЗначениеЗаполнено(СокрЛП(ИсходныеID.invoiceId))
				ИЛИ ЗначениеЗаполнено(СокрЛП(ИсходныеID.UniversalTransferDocumentId))) Тогда
				
				ИдентификаторКорректируемогоДокумента = "";
				
				Если ЗначениеЗаполнено(ИсходныеID.UniversalTransferDocumentId) Тогда 
					ИдентификаторКорректируемогоДокумента = ИсходныеID.UniversalTransferDocumentId;
				ИначеЕсли ЗначениеЗаполнено(ИсходныеID.invoiceId) Тогда
					ИдентификаторКорректируемогоДокумента = ИсходныеID.invoiceId;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ИдентификаторКорректируемогоДокумента) Тогда 
					СтруктураДокументаEDI.ДиадокID = СокрЛП(ИсходныеID.messageID) + ":" + ИдентификаторКорректируемогоДокумента;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Если (Тип1С = "ИсходящийСчетФактура"
			ИЛИ Тип1С = "ИсправляемыйСчетФактура") Тогда
			
			ТипИсходящийКСФ = ПолучитьТипЗначенияОбъекта("ИсходящийКСФ");
			ТипДокументаСчетФактура = ПолучитьТипЗначенияОбъекта("ТипДокументаСчетФактура");
			
			ИсправлениеСчетаФактуры = ПолучитьРеквизитДокументаДляСообщения(Значение, "ИсправлениеСчетаФактуры");
			
			Если ИсправлениеСчетаФактуры = Истина Тогда
				
				СтруктураДокументаEDI.Исправление = Истина;
				
				Если ЗначениеЗаполнено(ТипДокументаСчетФактура) И ТипЗнч(Значение) = Тип(ТипДокументаСчетФактура) Тогда
					
					НомерИсправления = Значение.НомерИсправления;
					ДатаИсправления = Значение.Дата;
					
					СтруктураНомерИДатаДокумента = ПолучитьНомерИДатуИсправляемогоСчетаФактуры(Значение);
					
					НомерДокумента = СтруктураНомерИДатаДокумента.Номер;
					ДатаДокумента = СтруктураНомерИДатаДокумента.Дата;
					
				ИначеЕсли ЗначениеЗаполнено(ТипИсходящийКСФ) И ТипЗнч(Значение) = Тип(ТипИсходящийКСФ) Тогда
					
					Если ПеременнаяСодержитСвойство(Значение, "НомерИсправления") Тогда
						НомерИсправления = Значение.НомерИсправления;
					Иначе
						// нужно самостоятельно определить и заполнить	
						НомерИсправления = 0;
					КонецЕсли;
					
					ДатаИсправления = Значение.Дата;
					
					ИсправляемыйДокументРеализации = ПолучитьРеквизитДокументаДляСообщения(Значение, "ДокументОснованиеКорректировки");

					НомерДокумента = ПолучитьНомерНаПечать_КонтурEDI(ИсправляемыйДокументРеализации);
					ДатаДокумента = ИсправляемыйДокументРеализации.Дата;
					
				Иначе
					
					Возврат СтруктураДокументаEDI;
					
				КонецЕсли;
				
				СтруктураДокументаEDI.НомерИсправления = НомерИсправления;
				СтруктураДокументаEDI.ДатаИсправления = ДатаИсправления;
				
				СтруктураДокументаEDI.Номер = НомерДокумента;
				СтруктураДокументаEDI.Дата = ДатаДокумента;
				
				Возврат СтруктураДокументаEDI;
				
			КонецЕсли;
			
		КонецЕсли;
			
		НомерДокумента = ПолучитьНомерНаПечать_КонтурEDI(Значение);
		ДатаДокумента = Значение.Дата;
		
		Если Не ЗначениеЗаполнено(НомерДокумента) Тогда
			НомерДокумента = СокрЛП(Значение.Номер);//заполним напрямую
		КонецЕсли;
		
		СтруктураДокументаEDI.Номер	= НомерДокумента;
		СтруктураДокументаEDI.Дата	= ДатаДокумента;
		
		Возврат СтруктураДокументаEDI;
		
	ИначеЕсли Тип1С = "ВходящееУведомлениеОбОтгрузке" Тогда
		//TODO продумать возможность брать данные из входящего сообщения. Видимо, расчет был на работу без входящего DESADV на стороне сети.
		Если ТипEDI = "Накладная" Тогда
			
			СтруктураДатаНомер = Новый Структура("Номер,Дата");
			
			Если ИмяКонфигурации1С = "ТКПТ" Тогда
				СтруктураДатаНомер.Номер	= Значение.ВхДокНомер;
				СтруктураДатаНомер.Дата		= Значение.ВхДокДата;
			ИначеЕсли ИмяКонфигурации1С = "АСТОР" Тогда
				СтруктураДатаНомер.Номер	= Значение.НомерДокумента;
				СтруктураДатаНомер.Дата		= Значение.ДатаДокумента;
			ИначеЕсли ИмяКонфигурации1С = "ДалионУМ" Тогда
				СтруктураДатаНомер.Номер	= Значение.ВходящийНомер;
				СтруктураДатаНомер.Дата		= Значение.ДатаСчетаФактуры;
			ИначеЕсли ИмяКонфигурации1С = "ШтрихМ_РС" Тогда
				СтруктураДатаНомер.Номер	= Значение.ВходящийНомерДокумента;
				СтруктураДатаНомер.Дата		= Значение.ВходящаяДатаДокумента;
			Иначе
				СтруктураДатаНомер.Номер	= Значение.НомерВходящегоДокумента;
				СтруктураДатаНомер.Дата		= Значение.ДатаВходящегоДокумента;
			КонецЕсли;
			
			Возврат СтруктураДатаНомер;
			
		КонецЕсли;
		
	ИначеЕсли Тип1С = "ПодразделениеСвое" Тогда
		
		//очень древний код, рассчитанный на работу с Подразделениями в окне "Структура компании"
		//вместо этого в 044 релизе появилась работа с несколькими GLN, и отправителя теперь будем определять по организации
		СтруктураУчастникОбмена = Новый Структура("GLN");
		
		// новая настройка для регулирования GLN отправителя
		Если НЕ ПолучитьКонстантуEDI("ИспользоватьОсновнойGLNДляОтправки") = Ложь
				И ОпределитьКемМыЯвляемся(Сообщение) = "Покупатель" Тогда
			СтруктураУчастникОбмена.GLN = ПолучитьКонстантуEDI("GLN_Основной");
			Возврат СтруктураУчастникОбмена;
		КонецЕсли;
		
		//получим список организаций
		СписокЮрЛиц = ПолучитьСписокЭлементовСправочника("ЮрФизЛицаСвои");
		НужнаяСтрока = СписокЮрЛиц.Найти(Сообщение.Отправитель1С,"ЮрФизЛицо");
		Если НЕ НужнаяСтрока = Неопределено Тогда
			СтруктураУчастникОбмена.GLN = НужнаяСтрока.GLN;
		КонецЕсли;

		Возврат СтруктураУчастникОбмена;
		
	ИначеЕсли Тип1С = "ПодразделениеСтороннее" Тогда
		
		GLN = "";
		
		ИсходящийRETDES = Сообщение.ТипСообщения = "RETDES" И Сообщение.Направление = "Исходящее";
		
		Если ОпределитьКемМыЯвляемся(Сообщение) = "Поставщик" ИЛИ ИсходящийRETDES Тогда
			
			Партнер = ОпределитьПартнера(Новый Структура("ТипЗначения, ЮрФизЛицо, Сообщение", "ЮрФизЛицо",Сообщение.Покупатель1С, Сообщение));
			
		Иначе
			
			Партнер = ОпределитьПартнера(Новый Структура("ТипЗначения, ЮрФизЛицо, Сообщение", "ЮрФизЛицо",Сообщение.Продавец1С, Сообщение));
			
		КонецЕсли;
		
		Если Партнер = Неопределено 
			И ЗначениеЗаполнено(Сообщение.Партнер) Тогда
			Партнер = Сообщение.Партнер;
		КонецЕсли;
		
		Если НЕ Партнер = Неопределено Тогда
			
			Если НЕ ЗначениеЗаполнено(Сообщение.Получатель1С) Тогда
				Сообщение.Получатель1С = Партнер;
			КонецЕсли;
			
			GLN = ПолучитьЗначениеСвойстваОбъектаEDI(Партнер,"GLN_Партнера");
			
		КонецЕсли;
		
		СтруктураУчастникОбмена = Новый Структура("GLN");
		
		СтруктураУчастникОбмена.GLN = GLN;
		
		Возврат СтруктураУчастникОбмена;
		
	ИначеЕсли Тип1С = "Валюта" Тогда
		
		ВалютаEDI = Строка(Значение);
		
		Если Значение = Неопределено 
			ИЛИ ТипЗнч(Значение) = Тип("Строка")
			ИЛИ НЕ ПеременнаяСодержитСвойство(Значение, "Наименование", ВалютаEDI, Истина) Тогда
			
			ВалютаEDI = "RUB"; 
			
		Иначе
			
			СписокВалют = ЗагрузитьКлассификаторИзМакета("Валюта");
			Если СписокВалют.НайтиПоЗначению(ВалютаEDI) = Неопределено Тогда
				ВалютаEDI = "RUB"; 
			КонецЕсли;
			
		КонецЕсли;
		
		Возврат ВалютаEDI;
		
	ИначеЕсли Тип1С = "КодЕдиницы" Тогда
		
		Попытка
			Если Значение<>Неопределено Тогда
				Если Найти(Значение,"кг")<>0 Тогда
					Возврат "KGM";
				Иначе
					Возврат "PCE";
				КонецЕсли;
			КонецЕсли;
		Исключение
			Возврат "PCE";
		КонецПопытки;
		
		Возврат "PCE";
		
	ИначеЕсли Тип1С = "СтавкаНДС" Тогда
		
		Возврат КонвертироватьСтавкуНДС_1СвEDI(Значение);		
		
	ИначеЕсли Тип1С = "Страна" Тогда
		
		Если НЕ ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		КонецЕсли;
		
		ЕстьРеквизитКодАльфа2 = ЕстьРеквизитОбъекта_Контур(Значение,"КодАльфа2");
		
		Если ЕстьРеквизитКодАльфа2
			И ЗначениеЗаполнено(Значение.КодАльфа2) Тогда
			//В некоторых типовых конфигурациях присутствует поле "КодАльфа2" в справочнике "КлассификаторыСтранМира"
			//Если так, воспользуемся им.
			Возврат Значение.КодАльфа2;
			
		Иначе	//поищем по классификатору
			
			СписокАльфа2	= ЗагрузитьКлассификаторИзМакета("КодСтраныАльфа2");
			КодАльфа2		= СписокАльфа2.НайтиПоЗначению(Значение.Код);
			
			Возврат ?(КодАльфа2 = Неопределено, "", КодАльфа2.Представление);
			
		КонецЕсли;
		
	ИначеЕсли Тип1С = "НомерГТД" Тогда
		
		Возврат СокрЛП(Значение);
		
	ИначеЕсли Тип1С = "Договор" Тогда
		
		Если ЗначениеЗаполнено(Значение)
			И Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(Значение))
			И ЕстьРеквизитОбъекта_Контур(Значение,"Дата")
			И ЕстьРеквизитОбъекта_Контур(Значение,"Номер")
		Тогда
			СтруктураДатаНомер = Новый Структура("Номер,Дата",Значение.Номер,Значение.Дата);
		ИначеЕсли ЗначениеЗаполнено(Значение)
				И Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(Значение))
				И ЕстьРеквизитОбъекта_Контур(Значение,"ДатаДоговора")
				И ЕстьРеквизитОбъекта_Контур(Значение,"НомерДоговора")
		Тогда
			СтруктураДатаНомер = Новый Структура("Номер,Дата",Значение.НомерДоговора,Значение.ДатаДоговора);
		Иначе
			//например, в БП 1.6 нет таких реквизитов у Договора
			СтруктураДатаНомер = Новый Структура("Номер,Дата");
		КонецЕсли;	
		
		Возврат СтруктураДатаНомер;
		
	ИначеЕсли Тип1С = "КаналСбыта" Тогда
		
		Если Значение = "Оптовик" Тогда
			Возврат "Wholesaler";
		ИначеЕсли Значение = "Розничный магазин" Тогда
			Возврат "Store";
		ИначеЕсли Значение = "Торговая сеть" Тогда
			Возврат "NetRetail";
		КонецЕсли;
		
	ИначеЕсли Тип1С = "КонтактнаяИнформацияФизЛица" Тогда
		
		Структура = Новый Структура("ФИООтветственного, Телефон, Факс, Email");
		
		Если ЗначениеЗаполнено(Значение) Тогда
			Структура.Вставить("ФИООтветственного", Значение.Наименование);
		КонецЕсли;
		
		Возврат Структура;		
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьПредыдущийСчетФактуру_КонтурEDI(СчетФактураКорректировки, Сообщение)
	
	ТипИсходящийКСФ = ПолучитьТипЗначенияОбъекта("ИсходящийКСФ");
	
	Если ЗначениеЗаполнено(ТипИсходящийКСФ) И ТипЗнч(СчетФактураКорректировки) = Тип(ТипИсходящийКСФ) Тогда 
		Корректировка = СчетФактураКорректировки;
		СчетФактураКорректировки = ПолучитьРеквизитДокументаДляСообщения(Корректировка, "СчетФактураДокументаОснования");
	Иначе
		Корректировка = ПолучитьРеквизитДокументаДляСообщения(СчетФактураКорректировки, "ДокументОснованиеСчетаФактуры");
	КонецЕсли;
	
	ИмяКонфигурацииДляЗапроса = ПолучитьИмяКонфигурацииДляЗапроса();
	
	Если ИмяКонфигурацииДляЗапроса = "УФ_УТ" Тогда
		
		ПредыдущееСообщение = ПолучитьПредыдущееСообщение_КонтурEDI(Сообщение);
		Возврат ?(ЗначениеЗаполнено(ПредыдущееСообщение),ПредыдущееСообщение.Документ1С,Неопределено);
				
	Иначе
		
		ОснованиеКорректировки = ПолучитьРеквизитДокументаДляСообщения(Корректировка, "ДокументОснованиеКорректировки");
		ПредыдущийСчетФактура = ПолучитьРеквизитДокументаДляСообщения(ОснованиеКорректировки, "СчетФактураДокументаОснования");
		
		Возврат ПредыдущийСчетФактура;
		
	КонецЕсли;
		
КонецФункции

Функция ПолучитьНомерИДатуИсправляемогоСчетаФактуры(СчетФактураСсылка)

	Результат = Новый Структура("Номер,Дата");
	
	ИсправлениеКорректировки = ПолучитьРеквизитДокументаДляСообщения(СчетФактураСсылка, "Корректировочный");

	Если ИмяКонфигурации1С = "УФ_УТ" Тогда
		
		Если ИсправлениеКорректировки = Истина Тогда
			ИсправляемыйСчетФактура = СчетФактураСсылка.СчетФактураОснование;
		Иначе
			ИсправляемыйСчетФактура = ПолучитьРеквизитДокументаДляСообщения(СчетФактураСсылка, "ИсправляемыйСчетФактура");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИсправляемыйСчетФактура) Тогда
			Результат.Номер = ПолучитьНомерНаПечать_КонтурEDI(ИсправляемыйСчетФактура);
			Результат.Дата	= ИсправляемыйСчетФактура.Дата;
		КонецЕсли;
	
	ИначеЕсли ИмяКонфигурации1С = "УФ_ДалионТРЕНД" Тогда
		
		ИсправляемыйСчетФактура = ПолучитьЗначениеРеквизитаОбъекта_КонтурEDI(СчетФактураСсылка, "СчетФактураОснование");
		
		Если ЗначениеЗаполнено(ИсправляемыйСчетФактура) Тогда
			Результат.Номер = ПолучитьНомерНаПечать_КонтурEDI(ИсправляемыйСчетФактура);
			Результат.Дата	= ИсправляемыйСчетФактура.Дата;
		КонецЕсли;
	
	Иначе

		Если ИсправлениеКорректировки = Истина Тогда
			Результат.Номер = СчетФактураСсылка.НомерИсправляемогоКорректировочногоДокумента;
			Результат.Дата	= СчетФактураСсылка.ДатаИсправляемогоКорректировочногоДокумента;
		Иначе
			Результат.Номер = СчетФактураСсылка.НомерИсходногоДокумента;
			Результат.Дата	= СчетФактураСсылка.ДатаИсходногоДокумента;
		КонецЕсли;
		
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция КонвертироватьТовары1СвEDI(
	ТаблицаТоваров, 
	Партнер, 
	ДокументТоваров = Неопределено, 
	ТипСообщения = Неопределено, 
	Источник = "", 
	ЭтоОбратнаяОтгрузка = Ложь, 
	Сообщение = Неопределено,
	МыПоставщик = Неопределено)	
	
	// ... определить нужные переменные
	Если ТипСообщения = Неопределено Тогда		
		
		МыПоставщик = Истина;
		ИскатьТоварПоШК = Ложь;
		
	ИначеЕсли МыПоставщик <> Неопределено Тогда
		
		ИскатьТоварПоШК = НЕ МыПоставщик;
		
	Иначе 
		
		ДляОпределения = Новый Структура("Направление, ТипСообщения", "Исходящее", ТипСообщения) ;
		МыПоставщик = (ОпределитьКемМыЯвляемся(ДляОпределения) = "Поставщик");	
		ИскатьТоварПоШК = НЕ МыПоставщик; 
		
	КонецЕсли; 
	
	// ... получить и подготовить таблицу соответствий
	ТаблицаСоответствий = ПолучитьТаблицуСоответствийДляТоваров1С(ТаблицаТоваров.Скопировать(), Партнер, ИскатьТоварПоШК);
	
	// ... получить и подготовить таблицу товаров входящего сообщения 	
	Если Сообщение = Неопределено Тогда
		СтруктураДляПоискаПредыдущихСообщений = Новый Структура("ТипСообщения,Направление,Документ1С", ТипСообщения, "Исходящее", ДокументТоваров);
	Иначе
		СтруктураДляПоискаПредыдущихСообщений = Сообщение;
	КонецЕсли;
	
	Если ТипСообщения = "COINVOIC" Тогда
		
		ТипыСообщений = Новый Массив;
		ТипыСообщений.Добавить("COINVOIC");
		ТипыСообщений.Добавить("INVOIC");
		
		МассивПредыдущихINVOIC_COINVOIC = МассивПредыдущихСообщений_КонтурEDI(СтруктураДляПоискаПредыдущихСообщений, ТипыСообщений);
		ТаблицаТоваровВходящегоСообщения = ПолучитьТаблицуТоваровИсходногоСообщенияCOINVOIC_КонтурEDI(МассивПредыдущихINVOIC_COINVOIC);
		
	ИначеЕсли (Источник = "ОбработкаРасхожденийПриемки" ИЛИ Источник = "ПодготовитьУведомлениеОбОтгрузке_ДляОбработкиРасхождений") 
		И НЕ Сообщение = Неопределено Тогда
		
		ТаблицаТоваровВходящегоСообщения = ПолучитьТаблицуТоваровИсходногоСообщения_КонтурEDI(Сообщение);
		
	Иначе
		
		ВходящееСообщение = ПолучитьПредыдущееСообщение_КонтурEDI(СтруктураДляПоискаПредыдущихСообщений, Источник);
		ТаблицаТоваровВходящегоСообщения = ПолучитьТаблицуТоваровИсходногоСообщения_КонтурEDI(ВходящееСообщение);
		
	КонецЕсли;
	
	// ... вызвать событие пм для кастомного заполнения по входящему сообщению
	Если ТаблицаТоваровВходящегоСообщения.Количество() > 0 Тогда
		
		СтандартнаяОбработкаEDI = Истина;
		ПараметрыПМ = Новый Структура;
		ПараметрыПМ.Вставить("ТипСообщения",		ТипСообщения);
		ПараметрыПМ.Вставить("ДокументТоваров",		ДокументТоваров);
		ПараметрыПМ.Вставить("ТаблицаТоваров",		ТаблицаТоваров);
		ПараметрыПМ.Вставить("ТаблицаСоответствий",	ТаблицаСоответствий);
		ПараметрыПМ.Вставить("ТаблицаТоваровВходящегоСообщения", ТаблицаТоваровВходящегоСообщения);
		
		ТаблицаТоваровПМ = ОбработкаСобытияПодключаемогоМодуля("ЗаполнитьТаблицуТоваровПоВходящемуСообщению",СтандартнаяОбработкаEDI,ПараметрыПМ);
		Если НЕ СтандартнаяОбработкаEDI Тогда
			Возврат ТаблицаТоваровПМ;
		КонецЕсли;
		
	КонецЕсли; 
	
	// ... выполнить сопоставление
	НастройкаТолькоПоШК					= ПолучитьЗначениеСвойстваОбъектаEDI(Партнер, "СинхронизироватьТоварыТолькоПоGTIN");
	НастройкаТолькоПоВнутреннемуКоду	= ПолучитьЗначениеСвойстваОбъектаEDI(Партнер, "СинхронизироватьТоварыТолькоПоКодуПартнера");
	
	ИменаРеквизитовКлюча = ИменаРеквизитовДляКлючаПоискаРеквизитов(НастройкаТолькоПоШК, НастройкаТолькоПоВнутреннемуКоду, ЭтоОбратнаяОтгрузка, МыПоставщик);
	
	ПараметрыСопоставления = ПараметрыСопоставления_КонтурEDI();
	
	ПараметрыСопоставления.ТаблицаТоваров					= ТаблицаТоваров;
	ПараметрыСопоставления.ТаблицаСоответствий				= ТаблицаСоответствий;
	ПараметрыСопоставления.ТаблицаТоваровВходящегоСообщения = ТаблицаТоваровВходящегоСообщения;
	
	ПараметрыСопоставления.ИменаРеквизитовКлюча	= ИменаРеквизитовКлюча;
	ПараметрыСопоставления.МыПоставщик			= МыПоставщик;
	ПараметрыСопоставления.ТипСообщения			= ТипСообщения;
	
	Попытка
		
		ВыполнитьСопоставлениеТоваров_КонтурEDI(ПараметрыСопоставления); 
		
	Исключение 
		
		_ОписаниеОшибки = ОписаниеОшибки();
		
		ТекстОшибки = КонтурСтандарт_СтрШаблон_("Не удалось выполнить сопоставление товаров в сообщении %1 №%2 по причине: %3", 
		Сообщение.ТипСообщения, 
		Сообщение.ДокументEDI.Номер,  
		_ОписаниеОшибки);
		Сообщить_КонтурEDI(ТекстОшибки);
		
	КонецПопытки;
	
	ПослеКонвертироватьТовары1СвEDI(ТаблицаТоваров, Партнер, ЭтоОбратнаяОтгрузка);
	
	Возврат ТаблицаТоваров;
	
КонецФункции

Процедура ПослеКонвертироватьТовары1СвEDI(ТаблицаТоваров, Партнер, ЭтоОбратнаяОтгрузка)
		
	// ... обработать необходимость отправки кода поставщика
	НеОтправлятьКодПоставщика = (ПолучитьЗначениеСвойстваОбъектаEDI(Партнер, "НеОтправлятьКодПоставщика") = Истина);
	
	Если НеОтправлятьКодПоставщика = Истина Тогда
		
		Если ЭтоОбратнаяОтгрузка Тогда
			
			Если НЕ ТаблицаТоваров.Колонки.Найти("КодТовараПокупателя") = Неопределено Тогда
				ТаблицаТоваров.ЗаполнитьЗначения("", "КодТовараПокупателя"); 
			КонецЕсли;
			
		Иначе
			
			Если НЕ ТаблицаТоваров.Колонки.Найти("КодТовараПоставщика") = Неопределено Тогда
				ТаблицаТоваров.ЗаполнитьЗначения("", "КодТовараПоставщика"); 
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры  

Процедура ВыполнитьСопоставлениеТоваров_КонтурEDI(ПараметрыСопоставления) Экспорт

	// ... определить нужные для алгоритма переменные
	МыПоставщик = ПараметрыСопоставления.МыПоставщик;
	
	ЭтоОбратнаяОтгрузка = ЭтоОбратнаяОтгрузка(ПараметрыСопоставления.ТипСообщения); 

	ЭтоОтгрузка = (МыПоставщик И НЕ ЭтоОбратнаяОтгрузка) ИЛИ (НЕ МыПоставщик И ЭтоОбратнаяОтгрузка);
	
	ЭтоEDI_В_1С = ПараметрыСопоставления.ЭтоEDI_В_1С = Истина;
	
	СтандартнаяОбработкаEDI = Истина;
	ОбработкаСобытияПодключаемогоМодуля("ВыполнитьСопоставлениеТоваров",СтандартнаяОбработкаEDI,ПараметрыСопоставления);
	Если Не СтандартнаяОбработкаEDI Тогда
		Возврат;
	КонецЕсли;
	
	// ... получить таблицу сопоставления. 
	// ... Либо уже переданы. Либо получить соединение таблиц: ТаблицаТоваров, ТаблицаСоответствий, ТаблицаТоваровВходящегоСообщения
	Если ПараметрыСопоставления.Свойство("ВозможныеСопоставления") Тогда
		
		ВозможныеСопоставления = ПараметрыСопоставления.ВозможныеСопоставления;		
		
	Иначе
		
		ВозможныеСопоставления = ТаблицаВозможныхСопоставлений(
		ПараметрыСопоставления.ТаблицаТоваров, 
		ПараметрыСопоставления.ТаблицаСоответствий, 
		ПараметрыСопоставления.ТаблицаТоваровВходящегоСообщения,     																
		ПараметрыСопоставления.ИменаРеквизитовКлюча,
		ПараметрыСопоставления.МыПоставщик,
		ЭтоEDI_В_1С);	
		
	КонецЕсли;
	
	ПорогКоличестваСтрокБезИндексирования = 100;
	
	Если ПараметрыСопоставления.ТаблицаТоваровВходящегоСообщения.Количество() > ПорогКоличестваСтрокБезИндексирования
		Или ВозможныеСопоставления.Количество() > ПорогКоличестваСтрокБезИндексирования Тогда
		
		ПараметрыСопоставления.ТаблицаТоваровВходящегоСообщения.Индексы.Добавить("УИД_СтрокиТовара");
		ВозможныеСопоставления.Индексы.Добавить("УИД_СтрокиДокумента");
		
	КонецЕсли;
	
	ВозможныеСопоставления.Сортировать("Приоритет Убыв, КоличествоВДокументе1С Убыв, КоличествоВоВходящем Убыв"); 	
	
	КэшНесопоставленныхСтрок = Новый Соответствие;
	
	// ... обойти возможные сопоставления. 
	// при обходе находим строку товаров документа и строку входящего сообщения.
	// при необходимости разбиваем строку документа
	// сопоставляем строку документа со строкой входящего сообщения.
	Для Каждого ДанныеСопоставления Из ВозможныеСопоставления Цикл
		
		// ... определить можем ли сопоставить со строкой исходного сообщения
		// признаки: УИД_СтрокиПредыдущегоСообщения и УИД_СтрокиДокумента указывают, 
		// что строке товаров подобралась строка исходного сообщения.
		Если Не ЗначениеЗаполнено(ДанныеСопоставления.УИД_СтрокиПредыдущегоСообщения) 
			ИЛИ Не ЗначениеЗаполнено(ДанныеСопоставления.УИД_СтрокиДокумента) Тогда  			
			Продолжить; 			
		КонецЕсли;
		
		// ... определить строку таблицы товаров, которую будем сопоставлять
		СтрокаТоваров = Неопределено;		
		
		СтрокиТоваров = КэшНесопоставленныхСтрок.Получить(ДанныеСопоставления.УИД_СтрокиДокумента);
		
		Если СтрокиТоваров = Неопределено Тогда
			СтрокиТоваров = ПараметрыСопоставления.ТаблицаТоваров.НайтиСтроки(Новый Структура("УИД_СтрокиДокумента", ДанныеСопоставления.УИД_СтрокиДокумента));
		КонецЕсли;
		
		Для Каждого СтрокаТоваров Из СтрокиТоваров Цикл			
			Если СтрокаТоваров.КоличествоНеСопоставлено <> 0 Тогда
				Прервать;
			КонецЕсли;  			
		КонецЦикла;
				
		Если НетВозможностиСопоставления(СтрокаТоваров) Тогда
			Продолжить;
		КонецЕсли;
		
		// ... проверить на МногиеКоМногим
	 	Если ДанныеСопоставления.МногиеКоМногим = Истина Тогда 			
			СтрокаТоваров.МногиеКоМногим = Истина;
			Продолжить;  			
		КонецЕсли;
				
		// ... найти строку входящего
		СтрокаВходящегоСообщения = 
		ПараметрыСопоставления.ТаблицаТоваровВходящегоСообщения.Найти(ДанныеСопоставления.УИД_СтрокиПредыдущегоСообщения, "УИД_СтрокиТовара");
		
		Если СтрокаВходящегоСообщения = Неопределено 
			ИЛИ (СтрокаВходящегоСообщения.КоличествоНеСопоставлено = 0) Тогда
			Продолжить;
		КонецЕсли;		
						
		// ... разбить строку при необходимости (есть несопоставленное количество и строка сопоставлена с другим соответствием)				
		РазбитьСтроку = ОпределитьНеобходимостьРазбитьСтрокуТоваров_КонтурEDI(
		ДанныеСопоставления, 
		СтрокаВходящегоСообщения, 
		СтрокаТоваров, 
		ПараметрыСопоставления.ИменаРеквизитовКлюча,
		ПараметрыСопоставления.ТипСообщения);
		
		Если РазбитьСтроку Тогда 					
									
			СтрокаТоваров = РазбитьСтрокуТоваровДокумента(СтрокаТоваров, ПараметрыСопоставления.ТаблицаТоваров, СтрокаВходящегоСообщения, СтрокиТоваров);
							
			Если ПеременнаяСодержитСвойство(СтрокаТоваров, "УИД_СтрокиТовара") И ЗначениеЗаполнено(СтрокаТоваров.УИД_СтрокиТовара) Тогда
				
				СтрокаТоваров.УИД_СтрокиТовара = УИД_СтрокиТовара_КонтурEDI(ПараметрыСопоставления.ТаблицаТоваров.Количество() + 1,
																			ПараметрыСопоставления.ТипСообщения);
																			
			КонецЕсли;
			
			СтрокаВозможныхСопоставлений = ВозможныеСопоставления.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаВозможныхСопоставлений, ДанныеСопоставления);
			
		КонецЕсли;
		 						
		ПеренестиДанныеСопоставленияВСтрокуТоваров(
		ДанныеСопоставления, 
		СтрокаТоваров, 
		ЭтоEDI_В_1С, 
		ЭтоОтгрузка, 
		СтрокаВходящегоСообщения);
				
		// ... сделать пометки о ходе сопоставления		
		КоличествоСопоставить_1C = Окр(СтрокаВходящегоСообщения.КоличествоНеСопоставлено*ДанныеСопоставления.КоэффициентEDIВ1С_Расчетный, 3);		
		КоличествоСопоставить_EDI = СтрокаВходящегоСообщения.КоличествоНеСопоставлено;
		
		// ... обычное количество 			
		КоличествоСопоставленоЗаИтерацию_EDI = 
		Мин(КоличествоСопоставить_EDI, Окр(СтрокаТоваров.КоличествоНеСопоставлено/ДанныеСопоставления.КоэффициентEDIВ1С_Расчетный, 3));
		
		КоличествоСопоставленоЗаИтерацию_1C = 
		Мин(КоличествоСопоставить_1C, СтрокаТоваров.КоличествоНеСопоставлено);
		
		СтрокаТоваров.КоличествоНеСопоставлено = 
		Макс(СтрокаТоваров.КоличествоНеСопоставлено - КоличествоСопоставленоЗаИтерацию_1C, 0); 
		
		СтрокаВходящегоСообщения.КоличествоНеСопоставлено = 
		Макс(СтрокаВходящегоСообщения.КоличествоНеСопоставлено - КоличествоСопоставленоЗаИтерацию_EDI, 0);
		
		// ... количество до корректировки  		
		КоличествоДоСопоставленоЗаИтерацию_EDI = 
		Мин(КоличествоСопоставить_EDI, Окр(СтрокаТоваров.КоличествоДоНеСопоставлено/ДанныеСопоставления.КоэффициентEDIВ1С_Расчетный, 3));
		
		КоличествоДоСопоставленоЗаИтерацию_1C = 
		Мин(КоличествоСопоставить_1C, СтрокаТоваров.КоличествоДоНеСопоставлено);
		
		СтрокаТоваров.КоличествоДоНеСопоставлено = 
		Макс(СтрокаТоваров.КоличествоДоНеСопоставлено - КоличествоДоСопоставленоЗаИтерацию_1C, 0);
		
		Если КоличествоСопоставленоЗаИтерацию_EDI = 0 Тогда
			
			СтрокаВходящегоСообщения.КоличествоНеСопоставлено = 
			Макс(СтрокаВходящегоСообщения.КоличествоНеСопоставлено - КоличествоДоСопоставленоЗаИтерацию_EDI, 0);
			
		КонецЕсли;
		
		Если СтрокаТоваров.КоличествоНеСопоставлено = 0 И СтрокаТоваров.КоличествоДоНеСопоставлено = 0 Тогда
			СтрокиТоваров.Удалить(СтрокиТоваров.Найти(СтрокаТоваров));
		КонецЕсли;
		
		КэшНесопоставленныхСтрок.Вставить(ДанныеСопоставления.УИД_СтрокиДокумента, СтрокиТоваров);
		
	КонецЦикла;
	
	// ... проверить все ли сопоставлено и досопоставить. 
	// неспоставлеными должны остаться строки, которым не нашлось входящих строк. 	
	НеСопоставленныеСтроки = ПараметрыСопоставления.ТаблицаТоваров.НайтиСтроки(Новый Структура("Пометка_о_сопоставлении,МногиеКоМногим", Ложь, Ложь));
	Для Каждого СтрокаТоваров Из НеСопоставленныеСтроки Цикл
		
		Если СтрокаТоваров.Пометка_о_сопоставлении = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеСопоставления = ВозможныеСопоставления.Найти(СтрокаТоваров.УИД_СтрокиДокумента, "УИД_СтрокиДокумента");
		
		Если ДанныеСопоставления <> Неопределено Тогда
			
			СтрокаТоваров.УИД_СтрокиПредыдущегоСообщения = ДанныеСопоставления.УИД_СтрокиПредыдущегоСообщения;
			СтрокаТоваров.УИД_СтрокиПервоначальногоСообщения = ДанныеСопоставления.УИД_СтрокиПервоначальногоСообщения;
			
			СтрокаВходящегоСообщения = 
			ПараметрыСопоставления.ТаблицаТоваровВходящегоСообщения.Найти(ДанныеСопоставления.УИД_СтрокиПредыдущегоСообщения, "УИД_СтрокиТовара");
						
			ПеренестиДанныеСопоставленияВСтрокуТоваров(
			ДанныеСопоставления, 
			СтрокаТоваров, 
			ЭтоEDI_В_1С, 
			ЭтоОтгрузка,
			СтрокаВходящегоСообщения);  
			
		КонецЕсли;
		
	КонецЦикла; 
	 
	ПараметрыСопоставления.ТаблицаТоваров.Сортировать("УИД_СтрокиПервоначальногоСообщения, УИД_СтрокиПредыдущегоСообщения, НомерСтроки");
	
КонецПроцедуры

Функция НетВозможностиСопоставления(СтрокаТоваров)
	
	Если СтрокаТоваров = Неопределено Тогда
		
		НетВозможностиСопоставления = Истина;
		
	ИначеЕсли СтрокаТоваров.КоличествоНеСопоставлено = 0 
		И СтрокаТоваров.КоличествоДоНеСопоставлено = 0  Тогда
		
		НетВозможностиСопоставления = Истина;
		
	Иначе
		
		НетВозможностиСопоставления = Ложь;
		
	КонецЕсли;
	
	Возврат НетВозможностиСопоставления;

КонецФункции

Процедура ПеренестиДанныеСопоставленияВСтрокуТоваров(
	ДанныеСопоставления, 
	СтрокаТоваров, 
	ЭтоEDI_В_1С, 
	ЭтоОтгрузка,
	СтрокаПредыдущегоСообщения = Неопределено)
	
	// ... указать приоритет возможного сопоставления
	СтрокаТоваров.ПриоритетВозможногоСопоставления = ДанныеСопоставления.Приоритет;
	
	// ... сопоставить строку
	СтрокаТоваров.УИД_СтрокиПредыдущегоСообщения = ДанныеСопоставления.УИД_СтрокиПредыдущегоСообщения;
	СтрокаТоваров.УИД_СтрокиПервоначальногоСообщения = ДанныеСопоставления.УИД_СтрокиПервоначальногоСообщения;
	
	Если НЕ ЗначениеЗаполнено(СтрокаТоваров.УИД_СтрокиПервоначальногоСообщения)
		И ЕстьКолонкаСтрокиТаблицы_КонтурEDI(СтрокаТоваров, "УИД_СтрокиТовара") Тогда  	
		
		СтрокаТоваров.УИД_СтрокиПервоначальногоСообщения = СтрокаТоваров.УИД_СтрокиТовара;
		
	КонецЕсли;
	
	СтрокаТоваров.СтрокаВходящегоСообщения = СтрокаПредыдущегоСообщения;
	
	СтрокаТоваров.Пометка_о_сопоставлении = Истина;
	
	Если ЭтоEDI_В_1С Тогда
		
		СтрокаТоваров.Номенклатура = ДанныеСопоставления.Номенклатура;
		СтрокаТоваров.ХарактеристикаНоменклатуры = Неопределено;
		СтрокаТоваров.ЕдиницаИзмерения = Неопределено;
		
		Если ЗначениеЗаполнено(ДанныеСопоставления.ХарактеристикаНоменклатуры) Тогда
			СтрокаТоваров.ХарактеристикаНоменклатуры = ДанныеСопоставления.ХарактеристикаНоменклатуры;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеСопоставления.ЕдиницаИзмерения) Тогда
			СтрокаТоваров.ЕдиницаИзмерения = ДанныеСопоставления.ЕдиницаИзмерения;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТоваров.Наименование) 
			И ЕстьКолонкаСтрокиТаблицы_КонтурEDI(ДанныеСопоставления, "Наименование")
			И ЗначениеЗаполнено(ДанныеСопоставления.Наименование) Тогда
			СтрокаТоваров.Наименование = ДанныеСопоставления.Наименование;
		КонецЕсли;
		
	Иначе	
		
		Если ЗначениеЗаполнено(ДанныеСопоставления.GTIN) Тогда
			СтрокаТоваров.GTIN = ПривестиGTIN(ДанныеСопоставления.GTIN);
		КонецЕсли;
		
		Если ЭтоОтгрузка Тогда
			СтрокаТоваров.КодТовараПокупателя = ДанныеСопоставления.КодТовараСторонний;  
			СтрокаТоваров.КодТовараПоставщика = ДанныеСопоставления.КодТовараСвой;
		Иначе
			СтрокаТоваров.КодТовараПокупателя = ДанныеСопоставления.КодТовараСвой;
			СтрокаТоваров.КодТовараПоставщика = ДанныеСопоставления.КодТовараСторонний;
		КонецЕсли;
		
		СтрокаТоваров.КодЕдиницыИзмеренияEDI = ДанныеСопоставления.КодЕдиницыИзмеренияEDI;		
		
		Если ЕстьКолонкаСтрокиТаблицы_КонтурEDI(ДанныеСопоставления, "Наименование")
			И ЗначениеЗаполнено(ДанныеСопоставления.Наименование) Тогда
			СтрокаТоваров.Наименование = ДанныеСопоставления.Наименование;
		КонецЕсли;
	
	КонецЕсли;
	
	СтрокаТоваров.КоэффициентEDIВ1С = ДанныеСопоставления.КоэффициентEDIВ1С;
	СтрокаТоваров.ТипЕдиницы = ДанныеСопоставления.ТипЕдиницы;
	
	ЗаполнитьСвойстваСтрокиПоСтрокеПредыдущегоСообщения(СтрокаПредыдущегоСообщения, СтрокаТоваров, ЭтоОтгрузка);

КонецПроцедуры

Процедура ЗаполнитьСвойстваСтрокиПоСтрокеПредыдущегоСообщения(СтрокаПредыдущегоСообщения, СтрокаТоваров, ЭтоОтгрузка)
		
	Если СтрокаПредыдущегоСообщения <> Неопределено Тогда
		    		
		Если ЭтоОтгрузка Тогда
			СтрокаТоваров.КодТовараПокупателя = СтрокаПредыдущегоСообщения.КодТовараПокупателя;  
		Иначе
			СтрокаТоваров.КодТовараПоставщика = СтрокаПредыдущегоСообщения.КодТовараПоставщика;
		КонецЕсли; 		
		
		Если ЕстьКолонкаСтрокиТаблицы_КонтурEDI(СтрокаТоваров, "СтрокаВходящегоСообщения") Тогда
			
			СтрокаТоваров.СтрокаВходящегоСообщения = СтрокаПредыдущегоСообщения; 
			
		КонецЕсли;
		
		Если ЕстьКолонкаСтрокиТаблицы_КонтурEDI(СтрокаТоваров, "КодТовараВнутренний") 
			И ЕстьКолонкаСтрокиТаблицы_КонтурEDI(СтрокаПредыдущегоСообщения, "КодТовараВнутренний") Тогда
			
			СтрокаТоваров.КодТовараВнутренний = СтрокаПредыдущегоСообщения.КодТовараВнутренний;
			
		КонецЕсли;
		
		Если ЕстьКолонкаСтрокиТаблицы_КонтурEDI(СтрокаПредыдущегоСообщения, "Наименование")
			И ЗначениеЗаполнено(СтрокаПредыдущегоСообщения.Наименование) Тогда
			
			СтрокаТоваров.Наименование = СтрокаПредыдущегоСообщения.Наименование;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры 

Функция ОпределитьНеобходимостьРазбитьСтрокуТоваров_КонтурEDI(
	ДанныеСопоставления, 
	СтрокаВходящегоСообщения, 
	СтрокаТоваров,
	ИменаРеквизитовКлюча,
	ТипСообщения)   
		
	СопоставленоСДругойСтрокой = 
	(ЗначениеЗаполнено(СтрокаТоваров.СтрокаВходящегоСообщения) 
	И СтрокаТоваров.СтрокаВходящегоСообщения <> СтрокаВходящегоСообщения);
	
	СопоставленоСДругимКлючем = Ложь;
	
	Для Каждого РеквизитКлюча Из ИменаРеквизитовКлюча Цикл
		
		Если РеквизитКлюча.Обязательный Тогда
			
			СопоставленоСДругимКлючем = 
			СопоставленоСДругимКлючем 
			ИЛИ СтрокаСопоставленаСДругимКлючем(ДанныеСопоставления, РеквизитКлюча, СтрокаТоваров);
			
		КонецЕсли;
						
	КонецЦикла;
	
	ЕстьДругоеСопоставлениеВСтроке = СопоставленоСДругойСтрокой ИЛИ СопоставленоСДругимКлючем;     				 
	
	Если ЕстьДругоеСопоставлениеВСтроке Тогда
		
		Если ТипСообщения = "COINVOIC" Тогда
			
			РазбитьСтроку = 
			СтрокаТоваров.КоличествоНеСопоставлено <> 0
			ИЛИ СтрокаТоваров.КоличествоДоНеСопоставлено <> 0; 
			
		Иначе
			
			РазбитьСтроку = 
			СтрокаТоваров.КоличествоНеСопоставлено <> 0;
			
		КонецЕсли;
		
	Иначе
		
		РазбитьСтроку = Ложь;
		
	КонецЕсли;
	
	Возврат РазбитьСтроку;

КонецФункции

Функция СтрокаСопоставленаСДругимКлючем(ДанныеСопоставления, РеквизитКлюча, СтрокаТоваров)
	
	Возврат ЗначениеЗаполнено(СтрокаТоваров[РеквизитКлюча.Имя]) 
	И СокрЛП(СтрокаТоваров[РеквизитКлюча.Имя]) <> СокрЛП(ДанныеСопоставления[РеквизитКлюча.ИмяВСоответствиях]);

КонецФункции

Функция РазбитьСтрокуТоваровДокумента(СтрокаТоваров, ТаблицаТоваров, СтрокаВходящегоСообщения, КэшНесопоставленныхСтрок = Неопределено)
	
	КоличествоВНовойСтроке = СтрокаТоваров.КоличествоНеСопоставлено;
	КоличествоДоВНовойСтроке = СтрокаТоваров.КоличествоДоНеСопоставлено;
	
	ЭтоКорректировка = ЕстьКолонкаСтрокиТаблицы_КонтурEDI(СтрокаТоваров, "КоличествоДоКорректировки");
	
	// создать новую строку
	НоваяСтрокаТоваров = ТаблицаТоваров.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрокаТоваров, СтрокаТоваров);
	
	// скорректировать старую строку
	СтароеКоличество = СтрокаТоваров.Количество;
	СтрокаТоваров.Количество = СтрокаТоваров.Количество - КоличествоВНовойСтроке;
		
	// ... пересчитать цены и суммы в старой строке
	
		
	ЕстьСуммаНДС = ЕстьКолонкаСтрокиТаблицы_КонтурEDI(СтрокаТоваров, "СуммаНДС");
	
	СоответствияРеквизитовСуммИЦен = Новый Соответствие;
	СоответствияРеквизитовСуммИЦен.Вставить("Сумма", "Цена");
	СоответствияРеквизитовСуммИЦен.Вставить("СуммаБезНДС", "ЦенаБезНДС");
		
	Если КоличествоВНовойСтроке <> 0 Тогда
		
		Для Каждого Стр Из СоответствияРеквизитовСуммИЦен Цикл
			Если ЕстьКолонкаСтрокиТаблицы_КонтурEDI(СтрокаТоваров, Стр.Ключ) Тогда
				СтрокаТоваров[Стр.Ключ] = Окр(СтрокаТоваров.Количество*СтрокаТоваров[Стр.Значение], 2, 1);
			КонецЕсли;  		
		КонецЦикла;
		
		// ... пересчитать сумму ндс в старой строке	
		Если ЕстьСуммаНДС Тогда
			
			ЕстьСтавкаНДС = ЕстьКолонкаСтрокиТаблицы_КонтурEDI(СтрокаТоваров, "СтавкаНДС");
			
			Если ЕстьСтавкаНДС Тогда
				
				СтавкаНДС = КонвертироватьСтавкуНДС_1СвEDI(СтрокаТоваров.СтавкаНДС, Истина);
				
				Если СтрокаТоваров.СуммаВключаетНДС Тогда
					СуммаБезНДС	= Окр((СтрокаТоваров.Сумма * 100) / (100 + СтавкаНДС), 2, 1);
					СуммаСНДС	= СтрокаТоваров.Сумма;
				Иначе
					СуммаСНДС	= Окр((СтрокаТоваров.Сумма * (100 + СтавкаНДС)) / 100, 2, 1);
					СуммаБезНДС = СтрокаТоваров.Сумма;
				КонецЕсли;
				
				СтрокаТоваров.СуммаНДС = СуммаСНДС - СуммаБезНДС;
				
			ИначеЕсли СтароеКоличество <> 0 Тогда
				
				СтрокаТоваров.СуммаНДС = Окр(СтрокаТоваров.Количество*СтрокаТоваров.СуммаНДС/СтароеКоличество, 2, 1);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

	
	// ... пересчитать количество, цены и суммы до корректировки в старой строке    
	Если ЭтоКорректировка Тогда
		
		СтрокаТоваров.КоличествоДоКорректировки	= СтрокаТоваров.КоличествоДоКорректировки - КоличествоДоВНовойСтроке;
		
		Если КоличествоДоВНовойСтроке <> 0 Тогда
			
			Если СтрокаТоваров.КоличествоДоКорректировки = СтрокаТоваров.Количество
				И СтрокаТоваров.ЦенаДоКорректировки = СтрокаТоваров.Цена Тогда
				
				СтрокаТоваров.СуммаДоКорректировки = СтрокаТоваров.Сумма;
				
				Если ЕстьКолонкаСтрокиТаблицы_КонтурEDI(СтрокаТоваров, "СуммаНДСДоКорректировки") Тогда
					СтрокаТоваров.СуммаНДСДоКорректировки = СтрокаТоваров.СуммаНДС;
				КонецЕсли;
				
			Иначе
				
				СтрокаТоваров.СуммаДоКорректировки = Окр(СтрокаТоваров.КоличествоДоКорректировки*СтрокаТоваров.ЦенаДоКорректировки, 2, 1);			
				
				Если ЕстьКолонкаСтрокиТаблицы_КонтурEDI(СтрокаТоваров, "СуммаНДСДоКорректировки") Тогда
					
					СтавкаНДСДоКорректировки = КонвертироватьСтавкуНДС_1СвEDI(СтрокаТоваров.СтавкаНДСДоКорректировки, Истина);
					
					Если СтрокаТоваров.СуммаВключаетНДС Тогда
						СуммаБезНДСДоКорректировки	= Окр((СтрокаТоваров.СуммаДоКорректировки * 100) / (100 + СтавкаНДСДоКорректировки), 2, 1);
						СуммаСНДСДоКорректировки	= СтрокаТоваров.СуммаДоКорректировки;
					Иначе
						СуммаСНДСДоКорректировки	= Окр((СтрокаТоваров.СуммаДоКорректировки * (100 + СтавкаНДСДоКорректировки)) / 100, 2, 1);
						СуммаБезНДСДоКорректировки = СтрокаТоваров.СуммаДоКорректировки;
					КонецЕсли;
					
					СтрокаТоваров.СуммаНДСДоКорректировки = СуммаСНДСДоКорректировки - СуммаБезНДСДоКорректировки;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли; 
		
	// скорректировать новую строку 
	// ... пересчитать количество в новой строке
	НоваяСтрокаТоваров.Количество = КоличествоВНовойСтроке; 
	
	// ... пересчитать цены и суммы в новой строке
	Для Каждого Стр Из СоответствияРеквизитовСуммИЦен Цикл 		
		
		Если ЕстьКолонкаСтрокиТаблицы_КонтурEDI(НоваяСтрокаТоваров, Стр.Ключ)
			И Не НоваяСтрокаТоваров[Стр.Ключ] = 0 Тогда
			НоваяСтрокаТоваров[Стр.Ключ] = НоваяСтрокаТоваров[Стр.Ключ] - СтрокаТоваров[Стр.Ключ]; 
		КонецЕсли;
		
	КонецЦикла;
	
	// ... пересчитать сумму ндс в новой строке
	Если ЕстьСуммаНДС И Не НоваяСтрокаТоваров.СуммаНДС = 0 Тогда
		НоваяСтрокаТоваров.СуммаНДС = НоваяСтрокаТоваров.СуммаНДС - СтрокаТоваров.СуммаНДС;
	КонецЕсли;
	
	// ... пересчитать количество, цены и суммы до корректировки в новой строке
	Если ЭтоКорректировка Тогда
		
		НоваяСтрокаТоваров.КоличествоДоКорректировки = КоличествоДоВНовойСтроке;
		НоваяСтрокаТоваров.СуммаДоКорректировки	= НоваяСтрокаТоваров.СуммаДоКорректировки - СтрокаТоваров.СуммаДоКорректировки;
				
		Если ЕстьКолонкаСтрокиТаблицы_КонтурEDI(НоваяСтрокаТоваров, "СуммаНДСДоКорректировки") Тогда
			НоваяСтрокаТоваров.СуммаНДСДоКорректировки = НоваяСтрокаТоваров.СуммаНДСДоКорректировки - СтрокаТоваров.СуммаНДСДоКорректировки;
		КонецЕсли;
		 		
	КонецЕсли;
	
	НоваяСтрокаТоваров.КоличествоНеСопоставлено	= СтрокаТоваров.КоличествоНеСопоставлено;  
	НоваяСтрокаТоваров.КоличествоДоНеСопоставлено = СтрокаТоваров.КоличествоДоНеСопоставлено;
	
	СтрокаТоваров.КоличествоНеСопоставлено = 0;
	СтрокаТоваров.КоличествоДоНеСопоставлено = 0;
	
	Если Не КэшНесопоставленныхСтрок = Неопределено Тогда
		
		ИндексСопоставленнойСтрокиВКэше = КэшНесопоставленныхСтрок.Найти(СтрокаТоваров);
		Если ИндексСопоставленнойСтрокиВКэше = Неопределено Тогда
			КэшНесопоставленныхСтрок.Добавить(НоваяСтрокаТоваров);
		Иначе
			КэшНесопоставленныхСтрок[ИндексСопоставленнойСтрокиВКэше] = НоваяСтрокаТоваров;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат НоваяСтрокаТоваров;

КонецФункции

Функция ТаблицаВозможныхСопоставлений(
	ТаблицаТоваров, 
	ТаблицаСоответствий, 
	ТаблицаТоваровВходящегоСообщения, 
	ИменаРеквизитовКлюча, 
	МыПоставщик, 
	ЭтоEDI_В_1С) Экспорт   
	
	// ... создание запроса
	// Цель запроса:  
	// 1) Соединить таблицу соответствий и таблицу входящего сообщения по GTIN - КодПокупателя.
	// 2) Полученную таблицу соединить с товарами по номенклатуре - характеристике - единице.
	// 3) В полученной таблице сделать пометки сопоставлении.
	// Итог: Таблица возможных соответствий. 	
	
	ИмяСправочникаНоменклатура = ПолучитьТипЗначенияОбъекта("Номенклатура", Ложь, Истина);
	Если ЗначениеЗаполнено(ИмяСправочникаНоменклатура) Тогда
		ПустаяНоменклатура = Справочники[ИмяСправочникаНоменклатура].ПустаяСсылка();
	Иначе
		ПустаяНоменклатура = Неопределено;
	КонецЕсли;    	
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ТаблицаТоваров", 					ТаблицаТоваров); 
	Запрос.УстановитьПараметр("ТаблицаСоответствий", 				ТаблицаСоответствий); 
	Запрос.УстановитьПараметр("ТаблицаТоваровВходящегоСообщения",	ТаблицаТоваровВходящегоСообщения); 
	Запрос.УстановитьПараметр("ИспользоватьХарактеристики",			НастройкиМодуля.ИспользоватьХарактеристикиНоменклатуры);
	Запрос.УстановитьПараметр("ПустаяНоменклатура",					ПустаяНоменклатура);
		
	Если ЭтоEDI_В_1С Тогда    
		
		// ... этот параметр указывает: в приоритете брать номенклатуру из сопоставления или из исходного сообщения
		// важно для случая 3pl оператора, когда неважно в каком мы режиме, мы всегда подчиняемся поклажедателю.
		// но так как пока нет полноценной поддержки 3pl, то считать что мы главные только в режиме сети.
		// это задел на будущее
		МыГлавныеВКонтекстеСделки = НЕ МыПоставщик;
		
		Запрос.Текст =
		ТекстЗапросаДляПолученияВозможныхСопоставлений_EDI_1C_КонтурEDI(ТаблицаТоваров, ИменаРеквизитовКлюча, МыГлавныеВКонтекстеСделки);
		
	Иначе
		
		Запрос.Текст = 
		ТекстЗапросаДляПолученияВозможныхСопоставлений_1C_EDI_КонтурEDI(ТаблицаТоваров, ИменаРеквизитовКлюча);
		
	КонецЕсли;
			
	// ... выполнение запроса
	ВозможныеСопоставления = Запрос.Выполнить().Выгрузить();	
	
	// ... проверить на неоднозначное сопоставление
	ПроверитьНаНеоднозначноеСопоставление_КонтурEDI(ВозможныеСопоставления, ИменаРеквизитовКлюча);  	
					
	Возврат ВозможныеСопоставления;	
			
КонецФункции

Процедура ПроверитьНаНеоднозначноеСопоставление_КонтурEDI(ВозможныеСопоставления, ИменаРеквизитовКлюча)
	
	// ... добавить колонку колонку-индикатор неоднозначного сопоставления
	ДобавитьКолонкиВТаблицуЗначений(ВозможныеСопоставления, "МногиеКоМногим", Новый ОписаниеТипов("Булево"));
	
	ПроверятьНа_МногиеКоМногим = Ложь;
	
	Если НЕ ПроверятьНа_МногиеКоМногим Тогда
		
		Возврат;
		
	КонецЕсли;
	
	// ... поместить в запрос для получения данных
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	табВозможныеСопоставления.Номенклатура,
	|	табВозможныеСопоставления.ХарактеристикаНоменклатуры,
	|	&ПолеGTIN КАК GTIN,
	|	&ПолеКодТовараСторонний КАК КодТовараСторонний,
	|	табВозможныеСопоставления.УИД_СтрокиПредыдущегоСообщения
	|ПОМЕСТИТЬ табВозможныеСопоставления
	|ИЗ
	|	&ВозможныеСопоставления КАК табВозможныеСопоставления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	табВозможныеСопоставления.Номенклатура,
	|	табВозможныеСопоставления.ХарактеристикаНоменклатуры,
	|	табВозможныеСопоставления.GTIN,
	|	табВозможныеСопоставления.КодТовараСторонний
	|ПОМЕСТИТЬ табТолькоВходящиеСопоставления
	|ИЗ
	|	табВозможныеСопоставления КАК табВозможныеСопоставления
	|ГДЕ
	|	табВозможныеСопоставления.УИД_СтрокиПредыдущегоСообщения <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	табВозможныеСопоставления.Номенклатура,
	|	табВозможныеСопоставления.ХарактеристикаНоменклатуры,
	|	табВозможныеСопоставления.GTIN,
	|	табВозможныеСопоставления.КодТовараСторонний
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	табТолькоВходящиеСопоставления_Основное.Номенклатура,
	|	табТолькоВходящиеСопоставления_Основное.ХарактеристикаНоменклатуры,
	|	ВЫБОР
	|		КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ табТолькоВходящиеСопоставления_Основное.GTIN) > 1
	|				ИЛИ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ табТолькоВходящиеСопоставления_Основное.КодТовараСторонний) > 1
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЕстьНеоднозначноеСопоставление
	|ПОМЕСТИТЬ табАнализТоваров
	|ИЗ
	|	табТолькоВходящиеСопоставления КАК табТолькоВходящиеСопоставления_Основное
	|
	|СГРУППИРОВАТЬ ПО
	|	табТолькоВходящиеСопоставления_Основное.Номенклатура,
	|	табТолькоВходящиеСопоставления_Основное.ХарактеристикаНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	табТолькоВходящиеСопоставления_Основное.GTIN,
	|	табТолькоВходящиеСопоставления_Основное.КодТовараСторонний,
	|	ВЫБОР
	|		КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ табТолькоВходящиеСопоставления_Основное.Номенклатура) > 1
	|				ИЛИ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ табТолькоВходящиеСопоставления_Основное.ХарактеристикаНоменклатуры) > 1
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЕстьНеоднозначноеСопоставление
	|ПОМЕСТИТЬ табАнализСоответствий
	|ИЗ
	|	табТолькоВходящиеСопоставления КАК табТолькоВходящиеСопоставления_Основное
	|
	|СГРУППИРОВАТЬ ПО
	|	табТолькоВходящиеСопоставления_Основное.GTIN,
	|	табТолькоВходящиеСопоставления_Основное.КодТовараСторонний
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	табТолькоВходящиеСопоставления.Номенклатура,
	|	табТолькоВходящиеСопоставления.ХарактеристикаНоменклатуры
	|ИЗ
	|	табТолькоВходящиеСопоставления КАК табТолькоВходящиеСопоставления
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ табАнализТоваров КАК табАнализТоваров
	|		ПО табТолькоВходящиеСопоставления.Номенклатура = табАнализТоваров.Номенклатура
	|			И табТолькоВходящиеСопоставления.ХарактеристикаНоменклатуры = табАнализТоваров.ХарактеристикаНоменклатуры
	|			И (табАнализТоваров.ЕстьНеоднозначноеСопоставление = ИСТИНА)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ табАнализСоответствий КАК табАнализСоответствий
	|		ПО табТолькоВходящиеСопоставления.GTIN = табАнализСоответствий.GTIN
	|			И табТолькоВходящиеСопоставления.КодТовараСторонний = табАнализСоответствий.КодТовараСторонний
	|			И (табАнализСоответствий.ЕстьНеоднозначноеСопоставление = ИСТИНА)";
	
	Запрос.УстановитьПараметр("ВозможныеСопоставления", ВозможныеСопоставления);
	
	ПолеGTIN = """""";
	ПолеКодТовараСторонний = """""";
	
	Для Каждого ИмяРеквизитов Из ИменаРеквизитовКлюча Цикл
		
		Если ИмяРеквизитов.Обязательный 
			И ИмяРеквизитов.ИмяВСоответствиях = "GTIN" Тогда
			
			ПолеGTIN = "табВозможныеСопоставления.GTIN";
			
		КонецЕсли;
		
		Если ИмяРеквизитов.Обязательный 
			И ИмяРеквизитов.ИмяВСоответствиях = "КодТовараСторонний" Тогда
			
			ПолеКодТовараСторонний = "табВозможныеСопоставления.КодТовараСторонний";
			
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеGTIN", ПолеGTIN);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеКодТовараСторонний", ПолеКодТовараСторонний);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Для Каждого НеоднозначныйТовар Из Результат Цикл
		
		ПоискВОсновнойТаблице = Новый Структура("Номенклатура,ХарактеристикаНоменклатуры", 
		НеоднозначныйТовар.Номенклатура, НеоднозначныйТовар.ХарактеристикаНоменклатуры);
		
		СтрокиВозможныхСопоставлений = ВозможныеСопоставления.НайтиСтроки(ПоискВОсновнойТаблице);
		
		Для Каждого СтрокаВозможныхСопоставлений Из СтрокиВозможныхСопоставлений Цикл
			СтрокаВозможныхСопоставлений.МногиеКоМногим = Истина;
		КонецЦикла;		
		
	КонецЦикла;   	
	
КонецПроцедуры

Функция ТекстЗапросаДляПолученияВозможныхСопоставлений_EDI_1C_КонтурEDI(ТаблицаТоваров, ИменаРеквизитовКлюча, МыГлавныеВРазрезеСделки)
	
	Текст = "";
	
	Текст = Текст + Текст_ВТ_ТаблицаТоваров_КонтурEDI(ТаблицаТоваров) + ПереходКСледующейТаблице();   	
		
	Текст = Текст + Текст_ВТ_ТаблицаСоответствий() + ПереходКСледующейТаблице();
		
	Текст = Текст + Текст_ВТ_ТаблицаТоваровВходящегоСообщения() + ПереходКСледующейТаблице();
	
	Текст = Текст + Текст_ВТ_СоединениеСоответствий_и_ВходящегоСообщения(МыГлавныеВРазрезеСделки) + ПереходКСледующейТаблице();
		
	Текст = Текст + Текст_ВТ_ПодготовкаДанных(МыГлавныеВРазрезеСделки) + ПереходКСледующейТаблице();
	
	Текст = Текст + ТекстВыводаТаблицыВозможныхСопоставлений(МыГлавныеВРазрезеСделки);
			
	ЗаменитьПоляПоИменамРеквизитовКлюча_КонтурEDI(ИменаРеквизитовКлюча, Текст, МыГлавныеВРазрезеСделки); 
		
	Возврат Текст;

КонецФункции

Функция ТекстЗапросаДляПолученияВозможныхСопоставлений_1C_EDI_КонтурEDI(ТаблицаТоваров, ИменаРеквизитовКлюча)
		
	Текст = "";
	
	Текст = Текст + Текст_ВТ_ТаблицаТоваров_КонтурEDI(ТаблицаТоваров) + ПереходКСледующейТаблице();   	
		
	Текст = Текст + Текст_ВТ_ТаблицаСоответствий() + ПереходКСледующейТаблице();
		
	Текст = Текст + Текст_ВТ_ТаблицаТоваровВходящегоСообщения() + ПереходКСледующейТаблице();
	
	Текст = Текст + Текст_ВТ_СоединениеСоответствий_и_ВходящегоСообщения_1C_EDI() + ПереходКСледующейТаблице();
	
	Текст = Текст + Текст_ВТ_ПодготовкаДанных_1C_EDI() + ПереходКСледующейТаблице();
		
	Текст = Текст + Текст_ВТ_ОпределениеХарактеристики_1C_EDI() + ПереходКСледующейТаблице();

	Текст = Текст + ТекстВыводаТаблицыВозможныхСопоставлений_1C_EDI();
	
	// ... определить тип "характеристика номенклатуры"
	ЗаменитьПолеХарактеристикаВЗапросе_КонтурEDI(Текст);       
		 			
	ЗаменитьПоляПоИменамРеквизитовКлюча_1С_EDI_КонтурEDI(ИменаРеквизитовКлюча, Текст);  
			
	Возврат Текст;

КонецФункции

Процедура ЗаменитьПоляПоИменамРеквизитовКлюча_1С_EDI_КонтурEDI(ИменаРеквизитовКлюча, Текст)
	
	// ... определить в завимости от ключевых полей (GTIN, код товара покупателя и т.д.):
	// 1. по каким полям сопоставлять соответствия и входящее сообщение 	
	// 2. поля проверки сопоставленности с данной строкой входящего сообщения
	// 3. организовать использование данных из входящего в первую очередь
	ПоляДляСоединенияТаблицыСоответствийИВходящегоСообщения	= "ИСТИНА ";
	ПоляПроверкаСопоставленияСоСтрокойВходящегоСообщения = "ИСТИНА "; 	
	ПолеКодТовараСвой = "ВТ_ТаблицаСоответствий.КодТовараСвой";
	ПолеКодТовараСторонний = "ВТ_ТаблицаСоответствий.КодТовараСторонний";
	
	Для Каждого ИмяРеквизитов Из ИменаРеквизитовКлюча Цикл		
		
		Если ИмяРеквизитов.Обязательный = Истина Тогда
			
			ПоляДляСоединенияТаблицыСоответствийИВходящегоСообщения = ПоляДляСоединенияТаблицыСоответствийИВходящегоСообщения + 
			" И ВТ_ТаблицаСоответствий." + ИмяРеквизитов.ИмяВСоответствиях + " = ВТ_ТаблицаТоваровВходящегоСообщения." + ИмяРеквизитов.Имя; 
			
			ПоляПроверкаСопоставленияСоСтрокойВходящегоСообщения = ПоляПроверкаСопоставленияСоСтрокойВходящегоСообщения + 
			" И ВТ_ТаблицаТоваров.Товары" + ИмяРеквизитов.Имя + " = ВТ_СоединениеСоответствий_и_ВходящегоСообщения." + ИмяРеквизитов.ИмяВСоответствиях;
									
		КонецЕсли;    	
		
	КонецЦикла;
	
	Текст = СтрЗаменить(Текст, "&ПоляДляСоединенияТаблицыСоответствийИВходящегоСообщения",	ПоляДляСоединенияТаблицыСоответствийИВходящегоСообщения);
	Текст = СтрЗаменить(Текст, "&ПоляПроверкаСопоставленияСоСтрокойВходящегоСообщения",	ПоляПроверкаСопоставленияСоСтрокойВходящегоСообщения);
	Текст = СтрЗаменить(Текст, "&ПолеКодТовараСвой", ПолеКодТовараСвой);
	Текст = СтрЗаменить(Текст, "&ПолеКодТовараСторонний", ПолеКодТовараСторонний);

КонецПроцедуры

Функция ТекстВыводаТаблицыВозможныхСопоставлений_1C_EDI()
	
	ТекстВыводаТаблицыВозможныхСопоставлений_1C_EDI =  
	"ВЫБРАТЬ
	|	ВТ_ПодготовкаДанных.УИД_СтрокиДокумента,
	|	ВТ_ПодготовкаДанных.Номенклатура,
	|	ВТ_ПодготовкаДанных.ЕдиницаИзмерения,
	|	ВТ_ПодготовкаДанных.ХарактеристикаНоменклатуры,
	|	ВТ_ПодготовкаДанных.СерияНоменклатуры,
	|	ВТ_ПодготовкаДанных.СерияНоменклатурыВходящееСообщение,
	|	ВТ_ПодготовкаДанных.GTIN,
	|	ВТ_ПодготовкаДанных.КодТовараСторонний,
	|	ВТ_ПодготовкаДанных.КодЕдиницыИзмеренияEDI,
	|	ВТ_ПодготовкаДанных.КодТовараСвой,
	|	ВТ_ПодготовкаДанных.ТипЕдиницы,
	|	ВЫРАЗИТЬ(СУММА(ВТ_ПодготовкаДанных.КоличествоВДокументе1С) КАК Число(25, 10)) КАК КоличествоВДокументе1С,
	|	ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный,
	|	ВТ_ПодготовкаДанных.КоэффициентEDIВ1С,
	|	ВТ_ПодготовкаДанных.ЦенаВДокументе1С,
	|	ВТ_ПодготовкаДанных.КоличествоВоВходящем КАК КоличествоВоВходящем,
	|	ВТ_ПодготовкаДанных.УИД_СтрокиПредыдущегоСообщения,
	|	ВТ_ПодготовкаДанных.ДругиеРеквизиты,
	|	ВЫРАЗИТЬ(СУММА(ВЫБОР
	|			КОГДА НЕ ВТ_ПодготовкаДанных.СопоставленоСЭтойСтрокой
	|				ТОГДА 0
	|			КОГДА ВЫРАЗИТЬ(ВТ_ПодготовкаДанных.КоличествоВоВходящем * ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный КАК Число(25, 10)) < ВТ_ПодготовкаДанных.КоличествоВДокументе1С 
	|				ТОГДА ВЫРАЗИТЬ(ВТ_ПодготовкаДанных.КоличествоВоВходящем * ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный КАК Число(25, 10))
	|			ИНАЧЕ ВТ_ПодготовкаДанных.КоличествоВДокументе1С
	|		КОНЕЦ / ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный) КАК Число(25, 10)) КАК СопоставленоПересчитанное,
	|	ВЫРАЗИТЬ(СУММА(ВЫБОР
	|			КОГДА НЕ ВТ_ПодготовкаДанных.СопоставленоСЭтойСтрокой
	|				ТОГДА 0
	|			КОГДА ВЫРАЗИТЬ(ВТ_ПодготовкаДанных.КоличествоВоВходящем * ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный КАК Число(25, 10)) < ВТ_ПодготовкаДанных.КоличествоВДокументе1С
	|				ТОГДА ВЫРАЗИТЬ(ВТ_ПодготовкаДанных.КоличествоВоВходящем * ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный КАК Число(25, 10))
	|			ИНАЧЕ ВТ_ПодготовкаДанных.КоличествоВДокументе1С
	|		КОНЕЦ) КАК Число(25, 10)) КАК СопоставленоСДаннымСоответствием,
	|	ВТ_ПодготовкаДанных.Наименование,
	|	ВЫБОР
	|		КОГДА ВЫРАЗИТЬ(СУММА(ВЫРАЗИТЬ(ВТ_ПодготовкаДанных.КоличествоВоВходящем КАК Число(25, 10)) * ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный) КАК Число(25, 10)) <> ВЫРАЗИТЬ(СУММА(ВТ_ПодготовкаДанных.КоличествоВДокументе1С) КАК Число(25, 10))
	|			ТОГДА 10
	|		ИНАЧЕ 20
	|	КОНЕЦ + ВЫБОР
	|		КОГДА ВЫРАЗИТЬ(СУММА(ВЫРАЗИТЬ(ВТ_ПодготовкаДанных.КоличествоВоВходящем КАК Число(25, 10)) * ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный) КАК Число(25, 10)) = ВЫРАЗИТЬ(СУММА(ВТ_ПодготовкаДанных.КоличествоДоКорректировкиВДокументе1С) КАК Число(25, 10))
	|			ТОГДА 20
	|		ИНАЧЕ 0
	|	КОНЕЦ + ВЫБОР
	|		КОГДА ВЫРАЗИТЬ(МАКСИМУМ(ВЫРАЗИТЬ(ВТ_ПодготовкаДанных.ЦенаВДокументе1С_ВходящееСообщение / ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный КАК Число(25, 10))) КАК Число(25, 10)) = ВЫРАЗИТЬ(МАКСИМУМ(ВТ_ПодготовкаДанных.ЦенаВДокументе1С) КАК Число(25, 10))
	|			ТОГДА 100
	|		ИНАЧЕ 0
	|	КОНЕЦ + ВЫБОР
	|		КОГДА ВТ_ПодготовкаДанных.СерияНоменклатуры <> """"
	|				И ВТ_ПодготовкаДанных.СерияНоменклатуры = ВТ_ПодготовкаДанных.СерияНоменклатурыВходящееСообщение
	|			ТОГДА 200
	|		ИНАЧЕ 0
	|	КОНЕЦ + МАКСИМУМ(ВТ_ПодготовкаДанных.ОценкаПодбораСоответствия) КАК Приоритет,
	|	ВТ_ПодготовкаДанных.УИД_СтрокиПервоначальногоСообщения
	|ИЗ
	|	ВТ_ПодготовкаДанных КАК ВТ_ПодготовкаДанных
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОпределениеХарактеристики КАК ВТ_ОпределениеХарактеристики
	|		ПО ВТ_ПодготовкаДанных.Номенклатура = ВТ_ОпределениеХарактеристики.Номенклатура
	|			И ВТ_ПодготовкаДанных.ЕдиницаИзмерения = ВТ_ОпределениеХарактеристики.ЕдиницаИзмерения
	|			И ВТ_ПодготовкаДанных.ХарактеристикаНоменклатуры = ВТ_ОпределениеХарактеристики.ХарактеристикаНоменклатуры
	|			И ВТ_ПодготовкаДанных.ХарактеристикаНоменклатурыСоответствий = ВТ_ОпределениеХарактеристики.ХарактеристикаНоменклатурыСоответствий
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПодготовкаДанных.УИД_СтрокиДокумента,
	|	ВТ_ПодготовкаДанных.Номенклатура,
	|	ВТ_ПодготовкаДанных.ЕдиницаИзмерения,
	|	ВТ_ПодготовкаДанных.ХарактеристикаНоменклатуры,
	|	ВТ_ПодготовкаДанных.СерияНоменклатуры,
	|	ВТ_ПодготовкаДанных.СерияНоменклатурыВходящееСообщение,
	|	ВТ_ПодготовкаДанных.GTIN,
	|	ВТ_ПодготовкаДанных.КодТовараСторонний,
	|	ВТ_ПодготовкаДанных.КодЕдиницыИзмеренияEDI,
	|	ВТ_ПодготовкаДанных.КодТовараСвой,
	|	ВТ_ПодготовкаДанных.ТипЕдиницы,
	|	ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный,
	|	ВТ_ПодготовкаДанных.КоэффициентEDIВ1С,
	|	ВТ_ПодготовкаДанных.ЦенаВДокументе1С,
	|	ВТ_ПодготовкаДанных.КоличествоВоВходящем,
	|	ВТ_ПодготовкаДанных.УИД_СтрокиПредыдущегоСообщения,
	|	ВТ_ПодготовкаДанных.ДругиеРеквизиты,
	|	ВТ_ПодготовкаДанных.Наименование,
	|	ВТ_ПодготовкаДанных.УИД_СтрокиПервоначальногоСообщения";
	
	Возврат ТекстВыводаТаблицыВозможныхСопоставлений_1C_EDI;

КонецФункции

Функция Текст_ВТ_ОпределениеХарактеристики_1C_EDI()
	  		
	Текст_ВТ_ОпределениеХарактеристики =  
	"ВЫБРАТЬ
	|	ВТ_ПодготовкаДанных.Номенклатура,
	|	ВТ_ПодготовкаДанных.ЕдиницаИзмерения,
	|	ВТ_ПодготовкаДанных.ХарактеристикаНоменклатуры,
	|	МАКСИМУМ(ВТ_ПодготовкаДанных.ХарактеристикаНоменклатурыСоответствий) КАК ХарактеристикаНоменклатурыСоответствий
	|ПОМЕСТИТЬ ВТ_ОпределениеХарактеристики
	|ИЗ
	|	ВТ_ПодготовкаДанных КАК ВТ_ПодготовкаДанных
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПодготовкаДанных.Номенклатура,
	|	ВТ_ПодготовкаДанных.ЕдиницаИзмерения,
	|	ВТ_ПодготовкаДанных.ХарактеристикаНоменклатуры";
	
	Возврат Текст_ВТ_ОпределениеХарактеристики;

КонецФункции

Функция Текст_ВТ_ПодготовкаДанных_1C_EDI()
	
	Текст_ВТ_ПодготовкаДанных_1C_EDI = 
	"ВЫБРАТЬ
	|	ВТ_ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ВТ_ТаблицаТоваров.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВТ_ТаблицаТоваров.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ВТ_ТаблицаТоваров.СерияНоменклатуры,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.СерияНоменклатуры КАК СерияНоменклатурыВходящееСообщение,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.GTIN,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.КодТовараСторонний,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.КодЕдиницыИзмеренияEDI,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.КодТовараСвой,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.ТипЕдиницы,
	|	ВТ_ТаблицаТоваров.КоличествоВДокументе1С КАК КоличествоВДокументе1С,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.КоэффициентEDIВ1С_Расчетный,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.КоэффициентEDIВ1С,
	|	ВТ_ТаблицаТоваров.ЦенаВДокументе1С,
	|	ВТ_ТаблицаТоваров.УИД_СтрокиДокумента,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.КоличествоВоВходящем КАК КоличествоВоВходящем,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.УИД_СтрокиПредыдущегоСообщения КАК УИД_СтрокиПредыдущегоСообщения,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.ДругиеРеквизиты КАК ДругиеРеквизиты,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ВТ_СоединениеСоответствий_и_ВходящегоСообщения.УИД_СтрокиПредыдущегоСообщения = ВТ_ТаблицаТоваров.УИД_СтрокиПредыдущегоСообщения
	|					ИЛИ ВТ_СоединениеСоответствий_и_ВходящегоСообщения.УИД_СтрокиПредыдущегоСообщения = """"
	|						И &ПоляПроверкаСопоставленияСоСтрокойВходящегоСообщения
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК СопоставленоСЭтойСтрокой,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.Наименование,
	|	ВЫБОР
	|		КОГДА ВТ_ТаблицаТоваров.СуммаВключаетНДС
	|			ТОГДА ВТ_СоединениеСоответствий_и_ВходящегоСообщения.ЦенаСНДС
	|		ИНАЧЕ ВТ_СоединениеСоответствий_и_ВходящегоСообщения.ЦенаБезНДС
	|	КОНЕЦ КАК ЦенаВДокументе1С_ВходящееСообщение,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатурыСоответствий,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.УИД_СтрокиПервоначальногоСообщения,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.ОценкаПодбораСоответствия,
	|	ВТ_ТаблицаТоваров.КоличествоДоКорректировкиВДокументе1С
	|ПОМЕСТИТЬ ВТ_ПодготовкаДанных
	|ИЗ
	|	ВТ_ТаблицаТоваров КАК ВТ_ТаблицаТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СоединениеСоответствий_и_ВходящегоСообщения КАК ВТ_СоединениеСоответствий_и_ВходящегоСообщения
	|		ПО ВТ_ТаблицаТоваров.Номенклатура = ВТ_СоединениеСоответствий_и_ВходящегоСообщения.Номенклатура
	|			И ВТ_ТаблицаТоваров.ЕдиницаИзмерения = ВТ_СоединениеСоответствий_и_ВходящегоСообщения.ЕдиницаИзмерения
	|			И (НЕ &ИспользоватьХарактеристики
	|				ИЛИ ВТ_ТаблицаТоваров.ХарактеристикаНоменклатуры = ВТ_СоединениеСоответствий_и_ВходящегоСообщения.ХарактеристикаНоменклатуры
	|				ИЛИ ВТ_СоединениеСоответствий_и_ВходящегоСообщения.ХарактеристикаНоменклатуры = НЕОПРЕДЕЛЕНО
	|				ИЛИ ВТ_СоединениеСоответствий_и_ВходящегоСообщения.ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ТаблицаТоваров.УИД_СтрокиДокумента,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.УИД_СтрокиПредыдущегоСообщения,
	|	ВТ_ТаблицаТоваров.СерияНоменклатуры,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.СерияНоменклатуры,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.КодТовараСвой,
	|	ВТ_ТаблицаТоваров.ЕдиницаИзмерения,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.ДругиеРеквизиты,
	|	ВТ_ТаблицаТоваров.Номенклатура,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.ТипЕдиницы,
	|	ВТ_ТаблицаТоваров.ЦенаВДокументе1С,
	|	ВТ_ТаблицаТоваров.ХарактеристикаНоменклатуры,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.КодТовараСторонний,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.GTIN,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.КодЕдиницыИзмеренияEDI,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.КоэффициентEDIВ1С_Расчетный,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.КоэффициентEDIВ1С,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.КоличествоВоВходящем,
	|	ВТ_ТаблицаТоваров.КоличествоВДокументе1С,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.Наименование,
	|	ВЫБОР
	|		КОГДА ВТ_ТаблицаТоваров.СуммаВключаетНДС
	|			ТОГДА ВТ_СоединениеСоответствий_и_ВходящегоСообщения.ЦенаСНДС
	|		ИНАЧЕ ВТ_СоединениеСоответствий_и_ВходящегоСообщения.ЦенаБезНДС
	|	КОНЕЦ,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.ХарактеристикаНоменклатуры,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.УИД_СтрокиПервоначальногоСообщения,
	|	ВТ_СоединениеСоответствий_и_ВходящегоСообщения.ОценкаПодбораСоответствия,
	|	ВТ_ТаблицаТоваров.КоличествоДоКорректировкиВДокументе1С";
	
	Возврат Текст_ВТ_ПодготовкаДанных_1C_EDI;

КонецФункции

Функция Текст_ВТ_СоединениеСоответствий_и_ВходящегоСообщения_1C_EDI()
		
	Текст_ВТ_СоединениеСоответствий_и_ВходящегоСообщения_1C_EDI =  
	"ВЫБРАТЬ
	|	ВТ_ТаблицаСоответствий.Номенклатура,
	|	ВТ_ТаблицаСоответствий.ЕдиницаИзмерения,
	|	ВТ_ТаблицаСоответствий.ХарактеристикаНоменклатуры,
	|	ЕСТЬNULL(ВТ_ТаблицаТоваровВходящегоСообщения.GTIN, ВТ_ТаблицаСоответствий.GTIN) КАК GTIN,
	|	&ПолеКодТовараСвой КАК КодТовараСвой,
	|	&ПолеКодТовараСторонний КАК КодТовараСторонний,
	|	ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI КАК КодЕдиницыИзмеренияEDI,
	|	ВТ_ТаблицаСоответствий.КоэффициентEDIВ1С_Расчетный,
	|	ВТ_ТаблицаСоответствий.КоэффициентEDIВ1С,
	|	ВТ_ТаблицаСоответствий.ТипЕдиницы,
	|	ЕСТЬNULL(ВТ_ТаблицаТоваровВходящегоСообщения.Количество, 0) КАК КоличествоВоВходящем,
	|	ВЫБОР
	|		КОГДА ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI = """"
	|				ИЛИ ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI = ВТ_ТаблицаТоваровВходящегоСообщения.КодЕдиницыИзмеренияEDI
	|			ТОГДА ЕСТЬNULL(ВТ_ТаблицаТоваровВходящегоСообщения.УИД_СтрокиТовара, """")
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК УИД_СтрокиПредыдущегоСообщения,
	|	ЕСТЬNULL(ВТ_ТаблицаТоваровВходящегоСообщения.СерияНоменклатуры, """") КАК СерияНоменклатуры,
	|	ЕСТЬNULL(ВТ_ТаблицаТоваровВходящегоСообщения.ДругиеРеквизиты, """") КАК ДругиеРеквизиты,
	|	ЕСТЬNULL(ВТ_ТаблицаТоваровВходящегоСообщения.Наименование, ВТ_ТаблицаСоответствий.Наименование) КАК Наименование,
	|	ЕСТЬNULL(ВТ_ТаблицаТоваровВходящегоСообщения.ЦенаСНДС, 0) КАК ЦенаСНДС,
	|	ЕСТЬNULL(ВТ_ТаблицаТоваровВходящегоСообщения.ЦенаБезНДС, 0) КАК ЦенаБезНДС,
	|	ВЫБОР
	|		КОГДА ВТ_ТаблицаТоваровВходящегоСообщения.УИД_СтрокиТовара ЕСТЬ НЕ NULL 
	|				И (ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI = ВТ_ТаблицаТоваровВходящегоСообщения.КодЕдиницыИзмеренияEDI
	|					ИЛИ ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI = """")
	|			ТОГДА 100
	|		ИНАЧЕ 0
	|	КОНЕЦ + ВЫБОР
	|		КОГДА ВТ_ТаблицаСоответствий.КоэффициентEDIВ1С_Расчетный = 0
	|			ТОГДА 0
	|		КОГДА 1 / ВТ_ТаблицаСоответствий.КоэффициентEDIВ1С_Расчетный <= 1
	|			ТОГДА 10 + 1 / ВТ_ТаблицаСоответствий.КоэффициентEDIВ1С_Расчетный
	|		ИНАЧЕ 10 + ВТ_ТаблицаСоответствий.КоэффициентEDIВ1С_Расчетный / 1000
	|	КОНЕЦ + ЕСТЬNULL(ВТ_ТаблицаСоответствий.ОсновноеСоответствие, 0) КАК ОценкаПодбораСоответствия,
	|	ВЫБОР
	|		КОГДА ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI = """"
	|				ИЛИ ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI = ВТ_ТаблицаТоваровВходящегоСообщения.КодЕдиницыИзмеренияEDI
	|			ТОГДА ЕСТЬNULL(ВТ_ТаблицаТоваровВходящегоСообщения.УИД_СтрокиПервоначальногоСообщения, """")
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК УИД_СтрокиПервоначальногоСообщения
	|ПОМЕСТИТЬ ВТ_СоединениеСоответствий_и_ВходящегоСообщения
	|ИЗ
	|	ВТ_ТаблицаСоответствий КАК ВТ_ТаблицаСоответствий
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТаблицаТоваровВходящегоСообщения КАК ВТ_ТаблицаТоваровВходящегоСообщения
	|		ПО (&ПоляДляСоединенияТаблицыСоответствийИВходящегоСообщения)";
	
	Возврат Текст_ВТ_СоединениеСоответствий_и_ВходящегоСообщения_1C_EDI;

КонецФункции

Процедура ЗаменитьПолеХарактеристикаВЗапросе_КонтурEDI(Текст)
	
	ТипХарактеристики = ПолучитьТипЗначенияОбъекта("ХарактеристикаНоменклатуры", Истина); 
	
	Если Не ЗначениеЗаполнено(ТипХарактеристики) Тогда
		Текст = СтрЗаменить(Текст, "ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)", "НЕОПРЕДЕЛЕНО");
	КонецЕсли;
	
	Текст = СтрЗаменить(Текст, "Справочник.ХарактеристикиНоменклатуры", ТипХарактеристики);

КонецПроцедуры

Функция ТекстВыводаТаблицыВозможныхСопоставлений(МыГлавныеВРазрезеСделки)
	
	Если МыГлавныеВРазрезеСделки Тогда
		
		ТекстВыводаТаблицыВозможныхСопоставлений = 
		"ВЫБРАТЬ
		|	ВТ_ПодготовкаДанных.УИД_СтрокиДокумента КАК УИД_СтрокиДокумента,
		|	ВТ_ПодготовкаДанных.Номенклатура КАК Номенклатура,
		|	ВТ_ПодготовкаДанных.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ВТ_ПодготовкаДанных.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ВТ_ПодготовкаДанных.СерияНоменклатуры КАК СерияНоменклатуры,
		|	ВТ_ПодготовкаДанных.GTIN КАК GTIN,
		|	ВТ_ПодготовкаДанных.КодТовараСторонний КАК КодТовараСторонний,
		|	ВТ_ПодготовкаДанных.КодЕдиницыИзмеренияEDI КАК КодЕдиницыИзмеренияEDI,
		|	ВТ_ПодготовкаДанных.КодТовараСвой КАК КодТовараСвой,
		|	ВТ_ПодготовкаДанных.ТипЕдиницы КАК ТипЕдиницы,
		|	ВЫРАЗИТЬ(СУММА(ВТ_ПодготовкаДанных.КоличествоВДокументе1С) КАК ЧИСЛО(25,10)) КАК КоличествоВДокументе1С,
		|	ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный КАК КоэффициентEDIВ1С_Расчетный,
		|	ВТ_ПодготовкаДанных.КоэффициентEDIВ1С КАК КоэффициентEDIВ1С,
		|	ВТ_ПодготовкаДанных.ЦенаВДокументе1С КАК ЦенаВДокументе1С,
		|	ВЫРАЗИТЬ(СУММА(ВТ_ПодготовкаДанных.КоличествоДоКорректировкиВДокументе1С) КАК ЧИСЛО(25,10)) КАК КоличествоДоКорректировкиВДокументе1С,
		|	ВТ_ПодготовкаДанных.ЦенаДоКорректировкиВДокументе1С КАК ЦенаДоКорректировкиВДокументе1С,
		|	ВЫРАЗИТЬ(ВТ_ПодготовкаДанных.КоличествоВоВходящем КАК ЧИСЛО(25,10)) КАК КоличествоВоВходящем,
		|	ВТ_ПодготовкаДанных.УИД_СтрокиПредыдущегоСообщения КАК УИД_СтрокиПредыдущегоСообщения,
		|	ВТ_ПодготовкаДанных.ДругиеРеквизиты КАК ДругиеРеквизиты,
		|	ВЫРАЗИТЬ(СУММА(ВЫБОР
		|			КОГДА НЕ ВТ_ПодготовкаДанных.СопоставленоСЭтойСтрокой
		|				ТОГДА 0
		|			КОГДА ВТ_ПодготовкаДанных.КоличествоВоВходящем * ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный < ВТ_ПодготовкаДанных.КоличествоВДокументе1С
		|				ТОГДА ВТ_ПодготовкаДанных.КоличествоВоВходящем * ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный
		|			ИНАЧЕ ВТ_ПодготовкаДанных.КоличествоВДокументе1С
		|		КОНЕЦ / ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный) КАК ЧИСЛО(25,10)) КАК СопоставленоПересчитанное,
		|	ВЫРАЗИТЬ(СУММА(ВЫБОР
		|			КОГДА НЕ ВТ_ПодготовкаДанных.СопоставленоСЭтойСтрокой
		|				ТОГДА 0
		|			КОГДА ВТ_ПодготовкаДанных.КоличествоВоВходящем * ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный < ВТ_ПодготовкаДанных.КоличествоВДокументе1С
		|				ТОГДА ВТ_ПодготовкаДанных.КоличествоВоВходящем * ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный
		|			ИНАЧЕ ВТ_ПодготовкаДанных.КоличествоВДокументе1С
		|		КОНЕЦ) КАК ЧИСЛО(25,10)) КАК СопоставленоСДаннымСоответствием,
		|	ВТ_ПодготовкаДанных.Наименование КАК Наименование,
		|	ВЫБОР
		|		КОГДА ВТ_ПодготовкаДанных.ЕстьСтрокаВИсходномСообщении = ИСТИНА
		|				И ВТ_ПодготовкаДанных.ХаркаВСоответствияхРавнаХаркеИсходногоСообщения = ИСТИНА
		|			ТОГДА 1
		|		КОГДА ВТ_ПодготовкаДанных.ЕстьСтрокаВИсходномСообщении = ИСТИНА
		|			ТОГДА 2
		|		ИНАЧЕ 3
		|	КОНЕЦ + ВЫБОР
		|		КОГДА МАКСИМУМ(ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный) = 1
		|			ТОГДА 1
		|		ИНАЧЕ 2
		|	КОНЕЦ + ВЫБОР
		|		КОГДА МАКСИМУМ(ВТ_ПодготовкаДанных.ЦенаВДокументе1С_ВходящееСообщение / ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный) = МАКСИМУМ(ВТ_ПодготовкаДанных.ЦенаВДокументе1С)
		|			ТОГДА 1
		|		ИНАЧЕ 2
		|	КОНЕЦ + ВЫБОР
		|		КОГДА ВЫРАЗИТЬ(СУММА(ВТ_ПодготовкаДанных.КоличествоВоВходящем * ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный) КАК ЧИСЛО(25,10)) = ВЫРАЗИТЬ(СУММА(ВТ_ПодготовкаДанных.КоличествоВДокументе1С) КАК ЧИСЛО(25,10))
		|			ТОГДА 1
		|		ИНАЧЕ 2
		|	КОНЕЦ + ВТ_ПодготовкаДанных.ОценкаПодбораСоответствия КАК Приоритет,
		|	ВТ_ПодготовкаДанных.УИД_СтрокиПервоначальногоСообщения
		|ИЗ
		|	ВТ_ПодготовкаДанных КАК ВТ_ПодготовкаДанных
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ПодготовкаДанных.УИД_СтрокиДокумента,
		|	ВТ_ПодготовкаДанных.Номенклатура,
		|	ВТ_ПодготовкаДанных.ЕдиницаИзмерения,
		|	ВТ_ПодготовкаДанных.ХарактеристикаНоменклатуры,
		|	ВТ_ПодготовкаДанных.СерияНоменклатуры,
		|	ВТ_ПодготовкаДанных.GTIN,
		|	ВТ_ПодготовкаДанных.КодТовараСторонний,
		|	ВТ_ПодготовкаДанных.КодЕдиницыИзмеренияEDI,
		|	ВТ_ПодготовкаДанных.КодТовараСвой,
		|	ВТ_ПодготовкаДанных.ТипЕдиницы,
		|	ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный,
		|	ВТ_ПодготовкаДанных.КоэффициентEDIВ1С,
		|	ВТ_ПодготовкаДанных.ЦенаВДокументе1С,
		|	ВТ_ПодготовкаДанных.ЦенаДоКорректировкиВДокументе1С,
		|	ВТ_ПодготовкаДанных.КоличествоВоВходящем,
		|	ВТ_ПодготовкаДанных.УИД_СтрокиПредыдущегоСообщения,
		|	ВТ_ПодготовкаДанных.ДругиеРеквизиты,
		|	ВТ_ПодготовкаДанных.Наименование,
		|	ВТ_ПодготовкаДанных.ЕстьСтрокаВИсходномСообщении,
		|	ВТ_ПодготовкаДанных.УИД_СтрокиПервоначальногоСообщения,
		|	ВТ_ПодготовкаДанных.ХаркаВСоответствияхРавнаХаркеИсходногоСообщения,
		|	ВТ_ПодготовкаДанных.ОценкаПодбораСоответствия
		|
		|УПОРЯДОЧИТЬ ПО
		|	УИД_СтрокиПредыдущегоСообщения УБЫВ";
		
	Иначе
		
		ТекстВыводаТаблицыВозможныхСопоставлений = 
		"ВЫБРАТЬ
		|	ВТ_ПодготовкаДанных.УИД_СтрокиДокумента КАК УИД_СтрокиДокумента,
		|	ВТ_ПодготовкаДанных.Номенклатура КАК Номенклатура,
		|	ВТ_ПодготовкаДанных.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ВТ_ПодготовкаДанных.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ВТ_ПодготовкаДанных.СерияНоменклатуры КАК СерияНоменклатуры,
		|	ВТ_ПодготовкаДанных.GTIN КАК GTIN,
		|	ВТ_ПодготовкаДанных.КодТовараСторонний КАК КодТовараСторонний,
		|	ВТ_ПодготовкаДанных.КодЕдиницыИзмеренияEDI КАК КодЕдиницыИзмеренияEDI,
		|	ВТ_ПодготовкаДанных.КодТовараСвой КАК КодТовараСвой,
		|	ВТ_ПодготовкаДанных.ТипЕдиницы КАК ТипЕдиницы,
		|	ВЫРАЗИТЬ(СУММА(ВТ_ПодготовкаДанных.КоличествоВДокументе1С) КАК ЧИСЛО(25,10)) КАК КоличествоВДокументе1С,
		|	ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный КАК КоэффициентEDIВ1С_Расчетный,
		|	ВТ_ПодготовкаДанных.КоэффициентEDIВ1С КАК КоэффициентEDIВ1С,
		|	ВТ_ПодготовкаДанных.ЦенаВДокументе1С КАК ЦенаВДокументе1С,
		|	ВЫРАЗИТЬ(СУММА(ВТ_ПодготовкаДанных.КоличествоДоКорректировкиВДокументе1С) КАК ЧИСЛО(25,10)) КАК КоличествоДоКорректировкиВДокументе1С,
		|	ВТ_ПодготовкаДанных.ЦенаДоКорректировкиВДокументе1С КАК ЦенаДоКорректировкиВДокументе1С,
		|	ВЫРАЗИТЬ(ВТ_ПодготовкаДанных.КоличествоВоВходящем КАК ЧИСЛО(25,10)) КАК КоличествоВоВходящем,
		|	ВТ_ПодготовкаДанных.УИД_СтрокиПредыдущегоСообщения КАК УИД_СтрокиПредыдущегоСообщения,
		|	ВТ_ПодготовкаДанных.ДругиеРеквизиты КАК ДругиеРеквизиты,
		|	ВЫРАЗИТЬ(СУММА(ВЫБОР
		|			КОГДА НЕ ВТ_ПодготовкаДанных.СопоставленоСЭтойСтрокой
		|				ТОГДА 0
		|			КОГДА ВТ_ПодготовкаДанных.КоличествоВоВходящем * ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный < ВТ_ПодготовкаДанных.КоличествоВДокументе1С
		|				ТОГДА ВТ_ПодготовкаДанных.КоличествоВоВходящем * ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный
		|			ИНАЧЕ ВТ_ПодготовкаДанных.КоличествоВДокументе1С
		|		КОНЕЦ / ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный) КАК ЧИСЛО(25,10)) КАК СопоставленоПересчитанное,
		|	ВЫРАЗИТЬ(СУММА(ВЫБОР
		|			КОГДА НЕ ВТ_ПодготовкаДанных.СопоставленоСЭтойСтрокой
		|				ТОГДА 0
		|			КОГДА ВТ_ПодготовкаДанных.КоличествоВоВходящем * ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный < ВТ_ПодготовкаДанных.КоличествоВДокументе1С
		|				ТОГДА ВТ_ПодготовкаДанных.КоличествоВоВходящем * ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный
		|			ИНАЧЕ ВТ_ПодготовкаДанных.КоличествоВДокументе1С
		|		КОНЕЦ) КАК ЧИСЛО(25,10)) КАК СопоставленоСДаннымСоответствием,
		|	ВТ_ПодготовкаДанных.Наименование КАК Наименование,
		|	ВЫБОР
		|		КОГДА ВЫРАЗИТЬ(СУММА(ВТ_ПодготовкаДанных.КоличествоВоВходящем * ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный) КАК ЧИСЛО(25,10)) <> ВЫРАЗИТЬ(СУММА(ВТ_ПодготовкаДанных.КоличествоВДокументе1С) КАК ЧИСЛО(25,10))
		|			ТОГДА 1
		|		ИНАЧЕ 2
		|	КОНЕЦ + ВЫБОР
		|		КОГДА МАКСИМУМ(ВТ_ПодготовкаДанных.ЦенаВДокументе1С_ВходящееСообщение / ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный) = МАКСИМУМ(ВТ_ПодготовкаДанных.ЦенаВДокументе1С)
		|			ТОГДА 100
		|		ИНАЧЕ 0
		|	КОНЕЦ + ВТ_ПодготовкаДанных.ОценкаПодбораСоответствия КАК Приоритет,
		|	ВТ_ПодготовкаДанных.УИД_СтрокиПервоначальногоСообщения
		|ИЗ
		|	ВТ_ПодготовкаДанных КАК ВТ_ПодготовкаДанных
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ПодготовкаДанных.УИД_СтрокиДокумента,
		|	ВТ_ПодготовкаДанных.Номенклатура,
		|	ВТ_ПодготовкаДанных.ЕдиницаИзмерения,
		|	ВТ_ПодготовкаДанных.ХарактеристикаНоменклатуры,
		|	ВТ_ПодготовкаДанных.СерияНоменклатуры,
		|	ВТ_ПодготовкаДанных.GTIN,
		|	ВТ_ПодготовкаДанных.КодТовараСторонний,
		|	ВТ_ПодготовкаДанных.КодЕдиницыИзмеренияEDI,
		|	ВТ_ПодготовкаДанных.КодТовараСвой,
		|	ВТ_ПодготовкаДанных.ТипЕдиницы,
		|	ВТ_ПодготовкаДанных.КоэффициентEDIВ1С_Расчетный,
		|	ВТ_ПодготовкаДанных.КоэффициентEDIВ1С,
		|	ВТ_ПодготовкаДанных.ЦенаВДокументе1С,
		|	ВТ_ПодготовкаДанных.ЦенаДоКорректировкиВДокументе1С,
		|	ВТ_ПодготовкаДанных.КоличествоВоВходящем,
		|	ВТ_ПодготовкаДанных.УИД_СтрокиПредыдущегоСообщения,
		|	ВТ_ПодготовкаДанных.ДругиеРеквизиты,
		|	ВТ_ПодготовкаДанных.Наименование,
		|	ВТ_ПодготовкаДанных.УИД_СтрокиПервоначальногоСообщения,
		|	ВТ_ПодготовкаДанных.ОценкаПодбораСоответствия";
		
	КонецЕсли;

	Возврат ТекстВыводаТаблицыВозможныхСопоставлений;

КонецФункции

Функция Текст_ВТ_ПодготовкаДанных(МыГлавныеВРазрезеСделки)
	
	Если МыГлавныеВРазрезеСделки Тогда
		
		Текст_ВТ_ПодготовкаДанных = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(ВТ_СоединениеСоответствий_и_ВходящегоСообщения.Номенклатура, ВТ_ТаблицаТоваров.Номенклатура) КАК Номенклатура,
