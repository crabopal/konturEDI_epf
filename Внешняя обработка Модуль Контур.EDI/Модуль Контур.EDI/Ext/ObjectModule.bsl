	НедоступныеОрганизации = Неопределено;
	Если ЗначениеЗаполнено(ПараметрыПользователяEDI.НедоступныеОрганизации) Тогда
		НедоступныеОрганизации = ПараметрыПользователяEDI.НедоступныеОрганизации;
	КонецЕсли;
	НедоступныеПартнеры = Неопределено;
	Если ЗначениеЗаполнено(ПараметрыПользователяEDI.НедоступныеПартнеры) Тогда
		НедоступныеПартнеры = ПараметрыПользователяEDI.НедоступныеПартнеры;
	КонецЕсли;
	
	ИнформацияОПользователеEDI.Вставить("НедоступныеОрганизации",       НедоступныеОрганизации);
	ИнформацияОПользователеEDI.Вставить("НедоступныеПартнеры",          НедоступныеПартнеры);
	ИнформацияОПользователеEDI.Вставить("НедоступныеДокументы",         НедоступныеДокументы);
	ИнформацияОПользователеEDI.Вставить("НедоступныеСообщения",         НедоступныеСообщения);
	
	Возврат ИнформацияОПользователеEDI;
	
