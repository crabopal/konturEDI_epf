	СчетаКЗаполнению.Добавить("СчетУчетаНДСПоРеализации");
	СчетаКЗаполнению.Добавить("ПереданныеСчетУчета");
	СчетаКЗаполнению.Добавить("Субконто");
	СчетаКЗаполнению.Добавить("СчетДоходов");
	СчетаКЗаполнению.Добавить("СчетРасходов");
	
	КЗаполнению = Новый Соответствие;
	
	Для каждого Имя Из СчетаКЗаполнению Цикл
		Если СтрокаТабЧастиСтруктура.Свойство(Имя) Тогда
			КЗаполнению.Вставить(ИмяТабличнойЧасти + "." + Имя, Истина);
		КонецЕсли;
	КонецЦикла;
	
	// стандартный метод при изменении строки
	Выполнить("РеализацияТоваровУслугФормы.ТоварыНоменклатураПриИзмененииНаСервере(
		|СтрокаТабЧастиСтруктура,
		|ДанныеОбъекта,
		|КЗаполнению)");
	
	ЗаполнитьЗначенияСвойств(СтрокаТабЧасти, СтрокаТабЧастиСтруктура);
	
