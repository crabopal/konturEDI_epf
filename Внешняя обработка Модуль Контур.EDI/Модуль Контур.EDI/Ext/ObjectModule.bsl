Функция МетрикаКонтурСлужебный_ДоступенВариантИдентификации_РегистрСведений(ИмяРегистра, ИмяПВХ)
	
	ЕстьРегистрДополнительныеСведения = Метаданные.РегистрыСведений.Найти(ИмяРегистра) <> Неопределено;
	ЕстьПланВидовХарактеристик = Метаданные.ПланыВидовХарактеристик.Найти(ИмяПВХ) <> Неопределено;
	ЕстьСправочникВалюты = Метаданные.Справочники.Найти("Валюты") <> Неопределено;
	
	Если ЕстьРегистрДополнительныеСведения И ЕстьПланВидовХарактеристик И ЕстьСправочникВалюты Тогда
		
		ЭлементСправочникаВалютыРубль = МетрикаКонтурСлужебный_СправочникСсылкаВалютыРубль();
		
		ТипыОбъектовРегистра = Метаданные.РегистрыСведений[ИмяРегистра].Измерения.Объект.Тип.Типы();
		ВалютаВладелецСвойства = (ТипыОбъектовРегистра.Найти(ТипЗнч(ЭлементСправочникаВалютыРубль)) <> Неопределено);
		
		Результат = ЗначениеЗаполнено(ЭлементСправочникаВалютыРубль) И ВалютаВладелецСвойства;
		
	Иначе       
		
		Результат = Ложь;
		
	КонецЕсли;

	Возврат Результат;	
	
КонецФункции

