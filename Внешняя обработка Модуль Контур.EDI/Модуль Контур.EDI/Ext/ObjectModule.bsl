Функция КонтурEDIAPI_АдресСервера()
	
	МенеджерНастроек = КонтурEDIAPI_МенеджерНастроек();
	
	Если МенеджерНастроек.АдресСервера = Неопределено 
		ИЛИ ПустаяСтрока(МенеджерНастроек.АдресСервера) Тогда  
		
		АдресаСерверовEDI = КонтурEDIAPI_АдресаСерверов();
		
		МенеджерНастроек.АдресСервера = АдресаСерверовEDI[0]; 
		
	КонецЕсли;	
		
	Возврат МенеджерНастроек.АдресСервера;
	
КонецФункции

Функция КонтурEDIAPI_АдресаСерверов()
	
	МенеджерНастроек = КонтурEDIAPI_МенеджерНастроек(); 
	АдресаСерверов = МенеджерНастроек.АдресаСерверов;
	
	Если МенеджерНастроек.АдресаСерверов = Неопределено Тогда
		
		ТестовыеСервера = КонтурСтандарт_МассивЗначений("test-edi-api.kontur.ru");
		ПродуктовыеСервера = КонтурСтандарт_МассивЗначений("edi-api.kontur.ru");
		
		АдресаСерверов = ?(МенеджерНастроек.ТестовоеОкружение = Истина,
								ТестовыеСервера,
								ПродуктовыеСервера);
								
		КонтурEDIAPIПереопределяемый_АдресаСерверов(АдресаСерверов);	
		
		МенеджерНастроек.АдресаСерверов = АдресаСерверов; 
		
	КонецЕсли;
	
	Возврат АдресаСерверов;
	
КонецФункции

Функция КонтурEDIAPI_СменитьАдресСервераНаРезервный()
	
	АдресаСерверовEDI = КонтурEDIAPI_АдресаСерверов();
	
	АдресСервераEDI = КонтурEDIAPI_АдресСервера();
	
	ПорядокТекущегоАдреса = АдресаСерверовEDI.Найти(АдресСервераEDI);
	
	Если ПорядокТекущегоАдреса = АдресаСерверовEDI.ВГраница() Тогда
		
		Возврат Ложь;	
		
	КонецЕсли;
	
	МенеджерНастроек = КонтурEDIAPI_МенеджерНастроек();
	
	МенеджерНастроек.АдресСервера = АдресаСерверовEDI[ПорядокТекущегоАдреса + 1];
	
	Возврат Истина;

КонецФункции

