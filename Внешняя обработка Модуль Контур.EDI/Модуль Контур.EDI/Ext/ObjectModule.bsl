Функция Диагностика_ОписаниеТиповСправочниковБезРеквизитов()

	ТипыОбъектаСправочникСсылка = Новый Массив;
	
	ИмяТипаЮрФизЛицоСвое 		= ПолучитьТипЗначенияОбъекта("ЮрФизЛицоСвое");
	ИмяТипаЮрФизЛицоСтороннее 	= ПолучитьТипЗначенияОбъекта("ЮрФизЛицоСтороннее");
	ИмяТипаДоговор 				= ПолучитьТипЗначенияОбъекта("Договор");
	
	Если ЗначениеЗаполнено(ИмяТипаЮрФизЛицоСвое) Тогда
		ТипыОбъектаСправочникСсылка.Добавить(Тип(ИмяТипаЮрФизЛицоСвое));
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ИмяТипаЮрФизЛицоСтороннее) Тогда
		ТипыОбъектаСправочникСсылка.Добавить(Тип(ИмяТипаЮрФизЛицоСтороннее));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяТипаДоговор) Тогда
		ТипыОбъектаСправочникСсылка.Добавить(Тип(ИмяТипаДоговор));
	КонецЕсли;
	
	ИмяСвойСправочникТДвМетаданных = ПолучитьКонстантуEDI("СвойСправочникТочекДоставки");
	
	Если ЗначениеЗаполнено(ИмяСвойСправочникТДвМетаданных) Тогда		
		
		ИмяТипаСвойСправочникТД = КонтурСтандарт_СтрШаблон_("СправочникСсылка.%1", СокрЛП(ИмяСвойСправочникТДвМетаданных));
		
		ТипыОбъектаСправочникСсылка.Добавить(Тип(ИмяТипаСвойСправочникТД));
		
	КонецЕсли;
	
	ДопПроверяемыеСправочники = "Партнеры,БанковскиеСчета,ФизическиеЛица,Сотрудники,КонтактныеЛица,Пользователи,Подписи,Должности";
	
	ДопПроверяемыеСправочники = КонтурСтандарт_СтрРазделить_(ДопПроверяемыеСправочники, ",");
	
	Для Каждого ИмяПроверяемогоСправочника Из ДопПроверяемыеСправочники Цикл
		
		Если ЕстьНеобходимыеМетаданные("Справочники." + ИмяПроверяемогоСправочника) Тогда
			
			ИмяТипаПроверяемогоСправочника = КонтурСтандарт_СтрШаблон_("СправочникСсылка.%1", ИмяПроверяемогоСправочника);
			
			ТипыОбъектаСправочникСсылка.Добавить(Тип(ИмяТипаПроверяемогоСправочника));
			
		КонецЕсли;
		
	КонецЦикла;
	
	ОписаниеТиповСправочников = Новый ОписаниеТипов(ТипыОбъектаСправочникСсылка);
	
	Возврат ОписаниеТиповСправочников;
	
КонецФункции

Функция Диагностика_ОписаниеТиповДокументыСправочники()
	
	ОписаниеТиповДокументыСправочники = Новый Структура;
	ОписаниеТиповДокументыСправочники.Вставить("ТипыДокументов", Новый ОписаниеТипов(Документы.ТипВсеСсылки()));
	ОписаниеТиповДокументыСправочники.Вставить("ТипыСправочников", Новый ОписаниеТипов(Справочники.ТипВсеСсылки()));
	
	Возврат ОписаниеТиповДокументыСправочники;
	
КонецФункции

Функция Диагностика_ОписаниеИменРеквизитовДокумента()
	
	Перем ОписаниеИменРеквизитовДокумента;
	
	ОписаниеИменРеквизитовДокумента = Новый Соответствие;
	
	ДопИменаРеквизитаПоУмолчанию = КонтурСтандарт_МассивЗначений("ПоУмолчанию");
	
	ИменаОбщихРеквизитов = Новый Структура;
	ИменаОбщихРеквизитов.Вставить("Организация"			, ДопИменаРеквизитаПоУмолчанию);
	ИменаОбщихРеквизитов.Вставить("Контрагент"			, ДопИменаРеквизитаПоУмолчанию);
	ИменаОбщихРеквизитов.Вставить("Партнер"				, ДопИменаРеквизитаПоУмолчанию);	
	ИменаОбщихРеквизитов.Вставить("Договор"				, ДопИменаРеквизитаПоУмолчанию);
	ИменаОбщихРеквизитов.Вставить("Грузоотправитель"	, ДопИменаРеквизитаПоУмолчанию);
	ИменаОбщихРеквизитов.Вставить("Грузополучатель"		, ДопИменаРеквизитаПоУмолчанию);		
	ИменаОбщихРеквизитов.Вставить("ВидОперации"			, ДопИменаРеквизитаПоУмолчанию);
	ИменаОбщихРеквизитов.Вставить("Склад"				, КонтурСтандарт_МассивЗначений("СкладГруппа", "СкладКомпании"));
	ИменаОбщихРеквизитов.Вставить("СуммаВключаетНДС"	, КонтурСтандарт_МассивЗначений("ЦенаВключаетНДС", "СуммаВключаетНДС"));
	
	ОписаниеИменРеквизитовДокумента.Вставить("ИменаОбщихРеквизитов", ИменаОбщихРеквизитов);
	
	ИменаРеквизитовКРТУ = Новый Структура;
	ИменаРеквизитовКРТУ.Вставить("ДокументОснованиеКорректировки"	, ДопИменаРеквизитаПоУмолчанию);
	ИменаРеквизитовКРТУ.Вставить("ВидКорректировки"					, ДопИменаРеквизитаПоУмолчанию);
	
	ОписаниеИменРеквизитовДокумента.Вставить("ИменаРеквизитовКРТУ", ИменаРеквизитовКРТУ);
	
	ИменаРеквизитовСчетФактуры = Новый Структура;
	ИменаРеквизитовСчетФактуры.Вставить("ИсправлениеСчетаФактуры"			, ДопИменаРеквизитаПоУмолчанию);
	ИменаРеквизитовСчетФактуры.Вставить("Корректировочный"					, ДопИменаРеквизитаПоУмолчанию);
	ИменаРеквизитовСчетФактуры.Вставить("НомерИсправления"					, ДопИменаРеквизитаПоУмолчанию);
	ИменаРеквизитовСчетФактуры.Вставить("ДокументОснованиеСчетаФактуры"		, ДопИменаРеквизитаПоУмолчанию);
		
	ОписаниеИменРеквизитовДокумента.Вставить("ИменаРеквизитовСчетФактуры", ИменаРеквизитовСчетФактуры);
	
	Возврат ОписаниеИменРеквизитовДокумента;
	
КонецФункции

