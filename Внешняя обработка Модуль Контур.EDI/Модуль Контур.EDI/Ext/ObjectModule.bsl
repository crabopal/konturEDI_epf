Функция ШаблоныЗапросов_СформироватьТаблицуПодменПоИмениКонфигурации()
	
	Перем ИмяКонфигурацииШаблонаЗапроса;
	
	ИмяКонфигурацииШаблонаЗапроса = ПолучитьИмяКонфигурацииДляЗапроса();
	ОписаниеПодменТекстаВЗапросах = ШаблоныЗапросов_НоваяТаблицаОписанияПодменТекстаВЗапросах();
	
	ПеречисленияEDI_ИменаКонфигурацийШаблоновЗапросов = ПеречисленияEDI_ИменаКонфигурацийШаблоновЗапросов();
	
	Если ИмяКонфигурацииШаблонаЗапроса = ПеречисленияEDI_ИменаКонфигурацийШаблоновЗапросов.УФ_УТ Тогда
		
		ШаблоныЗапросов_ЗаполнитьОписаниеПодменТекстаВЗапросах_УФ_УТ(ОписаниеПодменТекстаВЗапросах);		
		
	ИначеЕсли ИмяКонфигурацииШаблонаЗапроса = ПеречисленияEDI_ИменаКонфигурацийШаблоновЗапросов.УФ_УНФ Тогда
		
		ШаблоныЗапросов_ЗаполнитьОписаниеПодменТекстаВЗапросах_УФ_УНФ(ОписаниеПодменТекстаВЗапросах);
		
	ИначеЕсли ИмяКонфигурацииШаблонаЗапроса = ПеречисленияEDI_ИменаКонфигурацийШаблоновЗапросов.УФ_БП Тогда
		
		ШаблоныЗапросов_ЗаполнитьОписаниеПодменТекстаВЗапросах_УФ_БП(ОписаниеПодменТекстаВЗапросах);
		
	КонецЕсли;
	
	Возврат ОписаниеПодменТекстаВЗапросах;
	
КонецФункции

Процедура ШаблоныЗапросов_ПодготовитьТекстЗапросаКПодмене_КонтурEDI(ТекстЗапроса)
	
	Если Найти(ТекстЗапроса, Символы.ВК) > 0 Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, Символы.ВК, "");	
	КонецЕсли;
		
КонецПроцедуры

