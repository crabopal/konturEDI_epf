// Считывает условия определения типов продукции для режима ПроизвольныеУсловия.
//
// Возвращаемое значение:
//   Массив - список условий определения типа продукции, см. НовыйУсловиеОпределенияТипаПродукции()
Функция УсловияОпределенияТиповПродукции() Экспорт
	
	УсловияОпределения = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.ЗначениеСтрока КАК РежимНастройки,
					|	КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.ЗначениеХранилищеЗначения КАК УсловияОпределения
					|ИЗ
					|	Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты
					|ГДЕ
					|	НЕ КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.Ссылка.ПометкаУдаления
					|	И КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.ИмяРеквизита = ""Сохраненные настройки""
					|	И КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.Ссылка.ИмяСправочника = ""НастройкиОпределенияТиповПродукции""
					|	И КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.Ссылка.Наименование = ""Настройка определения типов продукции""";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		СохраненныеУсловия = Выборка.УсловияОпределения.Получить();
		
		Если ТипЗнч(УсловияОпределения) = Тип("Массив") Тогда
			Для каждого Условие Из СохраненныеУсловия Цикл
				УсловияОпределения.Добавить(НовыйУсловиеОпределенияТипаПродукции(Условие.ТипПродукции, Условие.Отбор));
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат УсловияОпределения;
	
КонецФункции

// Считывает сохранённые в базе настройки определения типов продукции.
//
// Возвращаемое значение:
//   Структура - структура с настройками определения типов продукции, см. НовыйНастройкиОпределенияТиповПродукции
Функция НастройкиОпределенияТиповПродукции() Экспорт
	
	СохраненныеНастройки = НовыйНастройкиОпределенияТиповПродукции();
	СохраненныеНастройки.Режим = РежимОпределенияТиповПродукции();
	СохраненныеНастройки.УсловияОпределения = УсловияОпределенияТиповПродукции();
		
	Возврат СохраненныеНастройки;
	
КонецФункции

// Сохраняет настройки определения типов продукции в базу данных.
//
// Параметры:
//   НастройкиОпределения - Структура - настройки определения типов продукции, см. НовыйНастройкиОпределенияТиповПродукции
Процедура СохранитьНастройкиОпределенияТиповПродукции(НастройкиОпределения) Экспорт
	
	УстановитьКонстантуEDI("РежимОпределенияТиповПродукции", НастройкиОпределения.Режим);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	КонтурEDI_ДополнительныеСправочники.Ссылка КАК Ссылка
					|ИЗ
					|	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
					|ГДЕ
					|	НЕ КонтурEDI_ДополнительныеСправочники.ПометкаУдаления
					|	И КонтурEDI_ДополнительныеСправочники.ИмяСправочника = ""НастройкиОпределенияТиповПродукции""
					|	И КонтурEDI_ДополнительныеСправочники.Наименование = ""Настройка определения типов продукции"""; 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		НастройкаОбъект = Справочники.КонтурEDI_ДополнительныеСправочники.СоздатьЭлемент(); 
		НастройкаОбъект.ИмяСправочника = "НастройкиОпределенияТиповПродукции";
		НастройкаОбъект.Наименование = "Настройка определения типов продукции";
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		НастройкаОбъект = Выборка.Ссылка.ПолучитьОбъект();
	КонецЕсли;
	
	РеквизитНастройки = ПолучитьСтрокуРеквизитаДопСправочника_КонтурEDI(НастройкаОбъект, "Сохраненные настройки");
	РеквизитНастройки.ЗначениеХранилищеЗначения = Новый ХранилищеЗначения(НастройкиОпределения.УсловияОпределения);
	
	НастройкаОбъект.Записать();
	
КонецПроцедуры

Функция ДоступноОпределениеТипаПродукцииПоДанным1С() Экспорт

	СпособЗаполнения = СпособЗаполненияТиповПродукции(); 
	Возврат ЗначениеЗаполнено(СпособЗаполнения);
	
КонецФункции

Функция ОтчетПоУстановленнымУсловиямОпределенияТипаПродукции(НастройкиОпределенияТиповПродукции) Экспорт
	
	ВывестиВКоллекцию = Ложь;
	ВключитьОтборНоменклатуры = Ложь;
	ВернутьПредставленияТипов = Истина;
	
	ПараметрыКомпоновки = ПараметрыКомпоновкиОпределенияТипаПродукции(ВывестиВКоллекцию, 
																	  ВключитьОтборНоменклатуры, 
																	  ВернутьПредставленияТипов, 
																	  НастройкиОпределенияТиповПродукции);
	
	МакетКомпоновки = ПараметрыКомпоновки.МакетКомпоновки;
	
	ОтчетПоУсловиям = Новый ТабличныйДокумент;
	
	ПроцессорКомпоновки = КонтурСКД_НовыйПроцессорКомпоновки(МакетКомпоновки);
	ПроцессорВывода = КонтурСКД_НовыйПроцессорВывода(ПроцессорКомпоновки, ОтчетПоУсловиям);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
    	
	Возврат ОтчетПоУсловиям;
	
КонецФункции

Функция СоответствиеТипаПродукцииНоменклатуре(МассивНоменклатуры, ВернутьПредставленияТипов = Ложь) Экспорт
	
	Соответствие = Новый Соответствие;
	
	Если МассивНоменклатуры.Количество() = 0 Тогда
		Возврат Соответствие;
	КонецЕсли;
	
	ВывестиВКоллекцию = Истина;
	ВключитьОтборНоменклатуры = Истина;
	
	ПараметрыКомпоновки = ПараметрыКомпоновкиОпределенияТипаПродукции(ВывестиВКоллекцию, 
																      ВключитьОтборНоменклатуры, 
																	  ВернутьПредставленияТипов);
	
	МакетКомпоновки = ПараметрыКомпоновки.МакетКомпоновки;
	МакетКомпоновки.ЗначенияПараметров.МассивНоменклатуры.Значение = МассивНоменклатуры;
	
	ТаблицаТиповПродукции = Новый ТаблицаЗначений;
	
	ПроцессорКомпоновки = КонтурСКД_НовыйПроцессорКомпоновки(МакетКомпоновки);
	ПроцессорВывода = КонтурСКД_НовыйПроцессорВывода(ПроцессорКомпоновки, ТаблицаТиповПродукции);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	ИмяПоляТипПродукции = ПараметрыКомпоновки.ИмяПоляТипПродукции;
	Для каждого СтрокаТаблицы Из ТаблицаТиповПродукции Цикл
		Соответствие.Вставить(СтрокаТаблицы.Номенклатура, СтрокаТаблицы[ИмяПоляТипПродукции]);
	КонецЦикла;
	
	Возврат Соответствие;
	
КонецФункции

Функция ПараметрыКомпоновкиОпределенияТипаПродукции(ВывестиВКоллекцию = Ложь, 
													ВключитьОтборНоменклатуры = Ложь, 
													ВернутьПредставленияТипов = Ложь,
													НастройкиОпределенияТиповПродукции = Неопределено)
													
	Если НастройкиОпределенияТиповПродукции = Неопределено Тогда													
		
		ИдентификаторКэша = КонтурСтандарт_СтрШаблон_("ПараметрыКомпоновкиОпределениеТипаПродукции_%1_%2_%3", 
												  	  ВывестиВКоллекцию, 
												  	  ВключитьОтборНоменклатуры, 
												  	  ВернутьПредставленияТипов); 
	
		ПараметрыКомпоновки = ЭДО_Кэш_Прочитать(ИдентификаторКэша);
	
		Если Не ПараметрыКомпоновки = Неопределено Тогда
			Возврат ПараметрыКомпоновки;
		КонецЕсли;
		
		НастройкиОпределенияТиповПродукции = НастройкиОпределенияТиповПродукции();
		
	КонецЕсли;
	
	ПараметрыКомпоновки = Новый Структура("МакетКомпоновки, ИмяПоляТипПродукции");
	
	УсловияОпределения = Новый Массив;
	СхемаКомпоновки = СхемаКомпоновкиОпределениеТиповПродукции(ВключитьОтборНоменклатуры);
	
	Если НастройкиОпределенияТиповПродукции.Режим = ПеречисленияEDI_РежимыОпределенияТиповПродукции().ПроизвольныеУсловия Тогда
		
		УсловияОпределения = НастройкиОпределенияТиповПродукции.УсловияОпределения;
														 
	ИначеЕсли НастройкиОпределенияТиповПродукции.Режим = ПеречисленияEDI_РежимыОпределенияТиповПродукции().ПоДанным1С Тогда
		
		СпособЗаполнения = СпособЗаполненияТиповПродукции();
		СпособыЗаполненияТиповПродукции = ПеречисленияEDI_СпособыЗаполненияТиповПродукции();
		
		Если СпособЗаполнения = СпособыЗаполненияТиповПродукции.ОсобенностьУчета Тогда
			УсловияОпределения = УсловияОпределнияТипаПродукции_ОсобенностьУчета();
		ИначеЕсли СпособЗаполнения = СпособыЗаполненияТиповПродукции.ВидПродукцииИС Тогда
			УсловияОпределения = УсловияОпределенияТипаПродукции_ВидПродукцииИС();
		ИначеЕсли СпособЗаполнения = СпособыЗаполненияТиповПродукции.ВидМаркировки Тогда
			УсловияОпределения = УсловияОпределенияТипаПродукции_ВидМаркировки();
		ИначеЕсли СпособЗаполнения = СпособыЗаполненияТиповПродукции.УФ_БП Тогда
			УсловияОпределения = УсловияОпределенияТипаПродукции_УФ_БП();
		ИначеЕсли СпособЗаполнения = СпособыЗаполненияТиповПродукции.КлючВидовПродукции Тогда
			СхемаКомпоновки = СхемаКомпоновкиОпределениеТиповПродукции_КлючиВидовПродукции(ВключитьОтборНоменклатуры);
			УсловияОпределения = УсловияОпределенияТипаПродукции_КлючВидовПродукции();
		КонецЕсли;
		
	КонецЕсли;														 
	
	КомпоновщикНастроек = КонтурСКД_НовыйКомпоновщикНастроек(СхемаКомпоновки);
	
	Если ВключитьОтборНоменклатуры Тогда
		ПараметрКомпоновки = КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("МассивНоменклатуры");
		ПараметрКомпоновки.Использование = Истина;
	КонецЕсли;
	
	ПолеТипПродукции = КонтурСКД_НайтиПользовательскоеПоле(КомпоновщикНастроек.Настройки, "ТипПродукции");
	
    ЗначенияПеречисленияEDI = ПолучитьСписокЗначенийПеречисленияEDI("ТипыПродукции");
	ПредставленияЗначенийТиповПродукцииEDI = СоответствиеПредставленийЗначениям(ЗначенияПеречисленияEDI);
	
	Для каждого УсловиеОпределения Из УсловияОпределения Цикл
		
		ТипПродукции = УсловиеОпределения.ТипПродукции;
		
		Если ВернутьПредставленияТипов Тогда
			ТипПродукции = ПредставленияЗначенийТиповПродукцииEDI[НРег(ТипПродукции)];
		КонецЕсли;
		
		КонтурСКД_НовыйВариантПользовательскогоПоляВыбор(ПолеТипПродукции, ТипПродукции, УсловиеОпределения.Отбор);
		
	КонецЦикла;
	
	ПараметрыКомпоновки.МакетКомпоновки = КонтурСКД_НовыйМакетКомпоновкиДанных(СхемаКомпоновки, КомпоновщикНастроек.Настройки, ВывестиВКоллекцию);
	ПараметрыКомпоновки.ИмяПоляТипПродукции = СтрЗаменить(ПолеТипПродукции.ПутьКДанным, ".", "");
	
	Если НастройкиОпределенияТиповПродукции = Неопределено Тогда
		ЭДО_Кэш_Поместить(ИдентификаторКэша, ПараметрыКомпоновки);
	КонецЕсли;
	
	Возврат ПараметрыКомпоновки;
	
КонецФункции

Процедура ЗаполнитьТипыПродукцииВСообщении(Сообщение)
	
	Если Не Сообщение.Свойство("Товары")
		ИЛИ Сообщение.Товары.Колонки.Найти("Номенклатура") = Неопределено
		ИЛИ Сообщение.Товары.Колонки.Найти("ТипПродукции") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимОпределенияТиповПродукции() = ПеречисленияEDI_РежимыОпределенияТиповПродукции().Отключено Тогда
		Возврат;
	КонецЕсли;

	Попытка		
		
		НоменклатураСообщения = ПолучитьНоменклатуруСообщения_КонтурEDI(Новый Структура("Товары", Сообщение.Товары));
		ТипыПродукцииНоменклатуры = СоответствиеТипаПродукцииНоменклатуре(НоменклатураСообщения);
		ЗаполнитьПроизвольнуюКолонкуТоваровПоДаннымНоменклатуры(Сообщение.Товары, "ТипПродукции", ТипыПродукцииНоменклатуры);
		
		Сообщение.ТипыПродукции = Новый СписокЗначений;
		
		КопияТоваров = Сообщение.Товары.Скопировать(,"ТипПродукции");
		КопияТоваров.Свернуть("ТипПродукции");
		
		Для каждого Строка Из КопияТоваров Цикл
			
			Если Не ЗначениеЗаполнено(Строка.ТипПродукции) Тогда
				Продолжить;
			КонецЕсли;
			
			Сообщение.ТипыПродукции.Добавить(Строка.ТипПродукции);
			
		КонецЦикла;
		
	Исключение
		
		Если Сообщение.Свойство("ОшибкиПодготовки") Тогда
			
			ОписаниеОшибкиПодготовки = НовыйОписаниеОшибкиПодготовкиСообщенияEDI();
			ОписаниеОшибкиПодготовки.ИмяПоля = "ТипПродукции";
			ОписаниеОшибкиПодготовки.ИмяТабличнойЧасти = "Товары";
			ОписаниеОшибкиПодготовки.СведенияОбОшибках = ОписаниеОшибки();
			ОписаниеОшибкиПодготовки.ВыводитьВТаблицуОшибок = Ложь;
			ОписаниеОшибкиПодготовки.ИсточникОшибки = "ЗаполнитьТипПродукцииВТоварахСообщения";
			
			Сообщение.ОшибкиПодготовки.Добавить(ОписаниеОшибкиПодготовки);
			
		КонецЕсли;
		
	КонецПопытки;
	
КонецПроцедуры

Процедура СохранитьТипыПродукцииВДополнительныеРеквизитыСообщения(СообщениеОбъект, СтруктураСообщения = Неопределено)
	
	Если СтруктураСообщения = Неопределено Тогда
		СтруктураСообщения = СообщениеОбъект.Хранилище.Получить();
	КонецЕсли;
	
	Если ТипЗнч(СтруктураСообщения) = Тип("Структура")
		И СтруктураСообщения.Свойство("ТипыПродукции")
		И ТипЗнч(СтруктураСообщения.ТипыПродукции) = Тип("СписокЗначений") Тогда
		
		ЗначениеТиповПродукции = Строка(СтруктураСообщения.ТипыПродукции);
	    ДополнительныйРеквизит = Новый Структура("ТипыПродукции", ЗначениеТиповПродукции);		
		ЗаполнитьДопРеквизитыОбъектаСправочника_КонтурEDI(СообщениеОбъект, ДополнительныйРеквизит);
		
	КонецЕсли;
	
КонецПроцедуры

Функция УсловияОпределнияТипаПродукции_ОсобенностьУчета()
	
	УсловияОпределения = ЭДО_Кэш_Прочитать("УсловияОпределенияТипаПродукции_ОсобенностьУчета");
	
	Если УсловияОпределения <> Неопределено Тогда
		Возврат УсловияОпределения;
	КонецЕсли;
	
	УсловияОпределения = Новый Массив;
	
	Перечисление1С = Перечисления.ОсобенностиУчетаНоменклатуры; 
	ПолеОтбора = Новый ПолеКомпоновкиДанных("Номенклатура.ОсобенностьУчета");
	
	Для каждого ЭлементСопоставления Из СоответствиеПеречисленийEDI1С_ТипПродукции_ОсобенностьУчета() Цикл

		ЗначениеПеречисленияEDI = ЭлементСопоставления.Значение;
		ЗначениеПеречисления1С = ЭлементСопоставления.Ключ;
					
		Отбор = КонтурСКД_НовыйОтборКомпоновкиДанных();
		КонтурСКД_НовыйЭлементОтбораКомпоновки(Отбор, ПолеОтбора, ЗначениеПеречисления1С);
		УсловияОпределения.Добавить(НовыйУсловиеОпределенияТипаПродукции(ЗначениеПеречисленияEDI, Отбор));		
		
	КонецЦикла;
	
	ЭДО_Кэш_Поместить("УсловияОпределенияТипаПродукции_ОсобенностьУчета", УсловияОпределения);
	
	Возврат УсловияОпределения;
	
КонецФункции

Функция СоответствиеПеречисленийEDI1С_ТипПродукции_ОсобенностьУчета()
	
	ТипыПродукцииEDI = ПеречисленияEDI_ТипыПродукции();
	
	СоответствиеИменЗначений = Новый Структура;
	
