Функция НайтиДокументНаОснованииТекущего(Документ, РежимРаботы, ИмяСоздаваемогоДокумента) Экспорт
	
	ДокументНаОснованииТекущего = Неопределено;
	
	СтандартнаяОбработкаEDI = Истина;
	СтруктураСобытия = Новый Структура("ТекущийДокумент, РежимРаботы, ИмяСоздаваемогоДокумента",
										Документ, РежимРаботы, ИмяСоздаваемогоДокумента);
										
	ДокументНаОснованииТекущего = ОбработкаСобытияПодключаемогоМодуля("НайтиДокументНаОснованииТекущего", СтандартнаяОбработкаEDI, СтруктураСобытия);
	
	Если НЕ СтандартнаяОбработкаEDI Тогда
		Возврат ДокументНаОснованииТекущего;	
	КонецЕсли;	
	
	ИмяКолонкиТекущегоДокумента 	= "Док_" + Документ.Метаданные().Имя;
	ИмяКолонкиСоздаваемогоДокумента = "Док_" + ИмяСоздаваемогоДокумента;
	
	ИменаГруппировок = "";
	
	СтруктураОбращенияКСвязаннымДокументам = Новый Структура;	
	СтруктураОбращенияКСвязаннымДокументам.Вставить("ИмяСоздаваемогоДокумента", ИмяКолонкиСоздаваемогоДокумента);
	СтруктураОбращенияКСвязаннымДокументам.Вставить("ИмяТекущегоДокумента",		ИмяКолонкиТекущегоДокумента); 
	СтруктураОбращенияКСвязаннымДокументам.Вставить("ТипСоздаваемогоДокумента", ИмяСоздаваемогоДокумента); 
		
	ТекстЗапроса = ПолучитьТекстЗапросаПоСвязаннымДокументам(Документ, РежимРаботы, ИменаГруппировок, СтруктураОбращенияКСвязаннымДокументам);
	ЗапросПроверка = Новый Запрос(ТекстЗапроса);
	ЗапросПроверка.УстановитьПараметр("Ссылка", Документ);
	ТабЗапроса = ЗапросПроверка.Выполнить().Выгрузить();	
	
	// на случай, когда для кастома добавляется требуемое действие для документа, 
	// который отсутствует в таблице запросов основной цепочки
	Если ТабЗапроса.Колонки.Найти(ИмяКолонкиСоздаваемогоДокумента) = Неопределено Тогда
		Возврат ДокументНаОснованииТекущего;
	КонецЕсли;
	
	СтрокаТекущегоДокумента = ТабЗапроса.Найти(Документ, ИмяКолонкиТекущегоДокумента);
	Если НЕ СтрокаТекущегоДокумента = Неопределено 
		И ЗначениеЗаполнено(СтрокаТекущегоДокумента[ИмяКолонкиСоздаваемогоДокумента])
		И Не СтрокаТекущегоДокумента[ИмяКолонкиСоздаваемогоДокумента].ПометкаУдаления Тогда 
		ДокументНаОснованииТекущего = СтрокаТекущегоДокумента[ИмяКолонкиСоздаваемогоДокумента];
	КонецЕсли;	

	Возврат ДокументНаОснованииТекущего;
	
КонецФункции // НайтиДокументНаОснованииТекущего()

Функция НайтиОбратныйЗаказ(Документ)
	
	ОбратныйЗаказ1С = Неопределено;
		
	Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_Сообщения.Документ КАК Ссылка
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|ГДЕ
	|	КонтурEDI_Сообщения.Документ = &Документ
	|	И КонтурEDI_Сообщения.ТипСообщения = ""PORDERS""";
	
	Запрос.УстановитьПараметр("Документ", ПреобразоватьЗначениеДляВнешнегоХранилища(Документ));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		ОбратныйЗаказ1С = Неопределено;
		
	Иначе
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		ОбратныйЗаказ1С = Выборка.Ссылка;
		
	КонецЕсли;
	 	
	Возврат ОбратныйЗаказ1С;			
	
КонецФункции

Функция ПолучитьСообщенияДокумента(ДокументСсылка) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
	Запрос.УстановитьПараметр("Документ",			ПреобразоватьЗначениеДляВнешнегоХранилища(ДокументСсылка));
	
	Запрос.Текст =  
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_Сообщения.Ссылка КАК СообщениеСсылка,
	|	КонтурEDI_Сообщения.Направление КАК Направление,
	|	КонтурEDI_Сообщения.ТипСообщения КАК ТипСообщения,
	|	КонтурEDI_Сообщения.Статус КАК Статус,
	|	ВЫБОР
	|		КОГДА КонтурEDI_Сообщения.ТипСообщения = ""PORDERS""
	|			ТОГДА 1
	|		КОГДА КонтурEDI_Сообщения.ТипСообщения = ""ORDERS""
	|			ТОГДА 2
	|		КОГДА КонтурEDI_Сообщения.ТипСообщения = ""ORDRSP""
	|			ТОГДА 3
	|		КОГДА КонтурEDI_Сообщения.ТипСообщения = ""DESADV""
	|			ТОГДА 4
	|		КОГДА КонтурEDI_Сообщения.ТипСообщения = ""RECADV""
	|			ТОГДА 5
	|		КОГДА КонтурEDI_Сообщения.ТипСообщения = ""INVOIC""
	|			ТОГДА 6
	|		КОГДА КонтурEDI_Сообщения.ТипСообщения = ""COINVOIC""
	|			ТОГДА 7
	|		ИНАЧЕ 8
	|	КОНЕЦ КАК Порядок
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|ГДЕ
	|	КонтурEDI_Сообщения.Документ = &Документ
	|	И НЕ КонтурEDI_Сообщения.ПометкаУдаления";
	
	Если ВнешнийМодульМеркурий <> Неопределено
		И Метаданные.Справочники.Найти("КонтурМеркурий_Сообщения") <> Неопределено Тогда
		
		Запрос.Текст = Запрос.Текст + 
		"
		|ОБЪЕДИНИТЬ ВСЕ
		|ВЫБРАТЬ
		|	КонтурМеркурий_Сообщения.Ссылка,
		|	КонтурМеркурий_Сообщения.Направление,
		|	КонтурМеркурий_Сообщения.ТипСообщения,
		|	КонтурМеркурий_Сообщения.Статус,
		|	8 КАК Порядок
		|ИЗ
		|	Справочник.КонтурМеркурий_Сообщения КАК КонтурМеркурий_Сообщения
		|ГДЕ
		|	КонтурМеркурий_Сообщения.Документ = &Документ
		|	И НЕ КонтурМеркурий_Сообщения.ПометкаУдаления";
		
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + 
	"
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	СообщениеСсылка";

	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Если ВнешнееХранилище Тогда
		ТЗ = ПолучитьТаблицуИзВнешнейБазы(ТЗ);
	КонецЕсли;	
	
	Возврат ТЗ;
	
КонецФункции

//создает в ветке СтрокаДерева вложенные строки, соответствующие Сообщениям
Процедура ВывестиСтрокуДокумента(СтрокаДерева)
	
	СтатусДокумента = ПолучитьСтатусДокумента(СтрокаДерева.Ссылка);
	
	СтрокаДерева.Вид				= "Документ";
	СтрокаДерева.Статус				= СтатусДокумента;
	СтрокаДерева.Представление		= СокрЛП(СтрокаДерева.Ссылка);
	СтрокаДерева.Проведен			= СтрокаДерева.Ссылка.Проведен;
	СтрокаДерева.ПометкаУдаления	= СтрокаДерева.Ссылка.ПометкаУдаления;
	
	ТаблицаСообщений = ПолучитьСообщенияДокумента(СтрокаДерева.Ссылка);
	
	Если ТаблицаСообщений.Количество()>0 Тогда
		
		НоваяСтрокаСообщений = СтрокаДерева;
		
		Для каждого Стр Из ТаблицаСообщений Цикл
			НоваяСтрокаСообщения = НоваяСтрокаСообщений.Строки.Добавить();
			НоваяСтрокаСообщения.Вид = "Сообщение";
			НоваяСтрокаСообщения.Представление	= Стр.ТипСообщения + " ("+ НРег(Стр.Статус)+")";
			НоваяСтрокаСообщения.ТипСообщения = Стр.ТипСообщения;
			НоваяСтрокаСообщения.Направление = Стр.Направление;
			НоваяСтрокаСообщения.Ссылка = Стр.СообщениеСсылка;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьТекстЗапросаПоСвязаннымДокументам(ДокументСсылка, РежимРаботыМодуля, ИменаГруппировок, СтруктураОбращенияКСвязаннымДокументам = Неопределено) Экспорт
	//ИменаГруппировок - возвращаемое значение.
	
	ИмяДокумента = ДокументСсылка.Метаданные().Имя;
	ТаблицаСоединенийДокументов = ПолучитьТаблицуДляСборкиЗапросов(РежимРаботыМодуля);
	
	ТекущаяСтрокаСоединений = ТаблицаСоединенийДокументов.Найти(ИмяДокумента,"ТипДокумента");
	Если ТекущаяСтрокаСоединений = Неопределено Тогда
		
		Если СтруктураОбращенияКСвязаннымДокументам <> Неопределено Тогда 
						
			ТекстЗапроса =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СвязанныеДокументы.Ссылка КАК ИмяСоздаваемогоДокумента,
			|	&Ссылка КАК ИмяТекущегоДокумента
			|ИЗ
			|	КритерийОтбора.СвязанныеДокументы(&Ссылка) КАК СвязанныеДокументы
			|ГДЕ
			|	СвязанныеДокументы.Ссылка ССЫЛКА Документ.РеализацияТоваровУслуг";
			
			ИмяКритерияОтбора = ПолучитьИмяКритерияОтбораДляКонфигурации();
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"СвязанныеДокументы", 		ИмяКритерияОтбора);  			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ИмяСоздаваемогоДокумента", СтруктураОбращенияКСвязаннымДокументам.ИмяСоздаваемогоДокумента);
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ИмяТекущегоДокумента", 	СтруктураОбращенияКСвязаннымДокументам.ИмяТекущегоДокумента);
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"РеализацияТоваровУслуг",	СтруктураОбращенияКСвязаннымДокументам.ТипСоздаваемогоДокумента);
			
			Возврат ТекстЗапроса;
			
		Иначе
			
			//для документов вне цепочки, т.е. "одиночных": RETANN,PRICELIST и т.д.
			ТипДокументаСтрокой = ДокументСсылка.Метаданные().Имя;
			ТекстЗапроса =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РеализацияТоваровУслуг.Ссылка КАК РеализацияТоваровУслуг
			|ИЗ
			|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
			|ГДЕ
			|	РеализацияТоваровУслуг.Ссылка В(&Ссылка)"
			;
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"РеализацияТоваровУслуг",ТипДокументаСтрокой);
			ИменаГруппировок = ТипДокументаСтрокой;
			
			Возврат ТекстЗапроса;
		КонецЕсли;
		
	КонецЕсли;	
	
	ТекстЗапроса = ПолучитьТекстЗапросаДляТаблицы(ТекущаяСтрокаСоединений.ПсевдонимТаблицы,ТаблицаСоединенийДокументов,"СвязанныеСообщения");
	//	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&Условия","Истина");//сюда будем подставлять нужные условия
	
	//теперь еще вытянуть группировки
	ИменаГруппировок = "";
	Для Каждого СтрокаСвязанныхДокументов Из ТаблицаСоединенийДокументов Цикл
		ИменаГруппировок = ИменаГруппировок+?(ИменаГруппировок="","",",")+"Док_"+СтрокаСвязанныхДокументов.ТипДокумента;
	КонецЦикла;	
	//ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ТекстУсловия","таб"+ИмяДокумента+".Ссылка в (&Ссылка)");
	
	Возврат ТекстЗапроса;	
	
КонецФункции

Процедура ВывестиСтрокиЗапросаСвязанныхСообщенийРекурсивно(ДеревоЗапроса,ДеревоДокументов,Группировки,ТекущийУровень,ТаблицаРеализаций)
	
	ИменаГруппировок = СтрЗаменить(Группировки,",",Символы.ПС);
	
	Если ТекущийУровень>СтрЧислоСтрок(ИменаГруппировок) Тогда
		//дошли до конца дерева. Проверять надо, т.к. после группировое еще идет уровень детальных записей
		//но еще можно передавать Выборку из РезультатаЗапроса, и проверять по ней
		Возврат;
	КонецЕсли;	
	
	ИмяТекущейГруппировки = СтрПолучитьСтроку(ИменаГруппировок,ТекущийУровень);
	ТипИсходящееУведомлениеОбОтгрузке = ПолучитьТипЗначенияОбъекта("ИсходящееУведомлениеОбОтгрузке");
	
	Для Каждого СтрокаДереваЗапроса ИЗ ДеревоЗапроса.Строки Цикл
		Если ЗначениеЗаполнено(СтрокаДереваЗапроса[ИмяТекущейГруппировки]) Тогда
			
			НоваяСтрока = ДеревоДокументов.Строки.Добавить();
			НоваяСтрока.Ссылка	= СтрокаДереваЗапроса[ИмяТекущейГруппировки];
			ВывестиСтрокуДокумента(НоваяСтрока);
			ВывестиСтрокиЗапросаСвязанныхСообщенийРекурсивно(СтрокаДереваЗапроса,НоваяСтрока,Группировки,ТекущийУровень+1,ТаблицаРеализаций);//а если нет строки?
			
			Если НастройкиМодуля.МыПоставщик И ЕстьКоррИспрСФ Тогда
				
				Если ЗначениеЗаполнено(ТипИсходящееУведомлениеОбОтгрузке) И ТипЗнч(НоваяСтрока.Ссылка) = Тип(ТипИсходящееУведомлениеОбОтгрузке) Тогда
					НоваяСтрокаРеализаций = ТаблицаРеализаций.Добавить();
					НоваяСтрокаРеализаций.Реализация = НоваяСтрока.Ссылка;
					НоваяСтрокаРеализаций.СтрокаДерева = НоваяСтрока;
				КонецЕсли;
				
			КонецЕсли;	
			
		Иначе    
			ВывестиСтрокиЗапросаСвязанныхСообщенийРекурсивно(СтрокаДереваЗапроса,ДеревоДокументов,Группировки,ТекущийУровень+1,ТаблицаРеализаций);//а если нет строки?
		КонецЕсли;	           
	КонецЦикла;	
	
КонецПроцедуры	

//для документа ДокументСсылка возвращает таблицу с колонками
//Документ_PORDERS,
//Документ_ORDERS,
//Документ_ORDRSP,
//Документ_DESADV,
//Документ_RECADV,
//Документ_INVOIC
Функция ПолучитьТаблицуСвязанныхДокументовПоТипамСообщений(ДокументСсылка) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КэшРезультата = ЭДО_Кэш_Прочитать("КэшТаблицыСвязанныхДокументовПоТипамСообщений");
	
	Если ТипЗнч(КэшРезультата) = Тип("Структура") 
		И КэшРезультата.Свойство("ДокументСсылка") 
		И КэшРезультата.Свойство("ТаблицаСвязанных") 
		И ЗначениеЗаполнено(КэшРезультата.ДокументСсылка) 
		И КэшРезультата.ДокументСсылка=ДокументСсылка Тогда //В Кэше наш документ 
		Возврат КэшРезультата.ТаблицаСвязанных;
	КонецЕсли;
	
	ИмяДокумента = ДокументСсылка.Метаданные().Имя;
	
	РезультатПМ = ОбработкаСобытияПодключаемогоМодуля("ПолучитьТаблицуСвязанныхДокументовПоТипамСообщений",, 
														Новый Структура("ДокументСсылка, ИмяДокумента", 
																		ДокументСсылка, ИмяДокумента));
	
	Если НЕ РезультатПМ = Неопределено
		И ТипЗнч(РезультатПМ) = Тип("ТаблицаЗначений") Тогда
		Возврат РезультатПМ;
	КонецЕсли;
	
	МассивДокументов = Новый Массив;
	МассивДокументов.Добавить(ДокументСсылка);
	Запрос = Новый Запрос;
	
	// пока будем искать с пустыми комментариями, нужно на стыке модулей EDI и прикладных
	// TODO добавить колонку "ИмяМодуля" в таблицу типов, чтобы искать типы в рамках используемого модуля
	МассивТаблицыТипов = ТаблицаТипов.НайтиСтроки(Новый Структура("ИмяТипа, Примечание","ДокументСсылка." + ИмяДокумента, Неопределено));
	
	Если МассивТаблицыТипов.Количество() = 0 Тогда 
		Возврат Неопределено;
	Иначе
		СтрокаТаблицыТипов = МассивТаблицыТипов[0];
	КонецЕсли;
				
	//здесь нам достаточно одной строки, т.к. предполагаем, что один и тот же документ никогда не будет работать и в режиме поставщика, и в режиме покупателя
	РежимРаботы = ?(СтрокаТаблицыТипов = Неопределено, Неопределено, СтрокаТаблицыТипов.Сторона);
	
	ТекстВложенногоЗапроса = ПолучитьТекстЗапросаПоСвязаннымДокументам(ДокументСсылка,РежимРаботы,"");
	
	Если РежимРаботы="Поставщик" Тогда

		//привяжем сюда же все множественные документы, созданные из одного общего ORDERS
		
		ТабВиртуальныхСообщений = ПолучитьВиртуальныеСвязанныеORDERS(ДокументСсылка);
		
		Для Каждого Стр Из ТабВиртуальныхСообщений Цикл
			Если ЗначениеЗаполнено(Стр.Документ) Тогда
				МассивДокументов.Добавить(Стр.Документ);
			КонецЕсли;
		КонецЦикла;
			
	КонецЕсли;	
	
	ТекстВложенногоЗапроса = СтрЗаменить(ТекстВложенногоЗапроса," РАЗРЕШЕННЫЕ","");//"РАЗРЕШЕННЫЕ" будет в верхнем запросе, во вложенном не надо
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ";
	
	Для Каждого Стр Из ТаблицаТипов.НайтиСтроки(Новый Структура("Сторона", РежимРаботы)) Цикл
		Если НЕ СтрСодержит_КонтурEDI("RETANN,RETINS,RETDES,RETREC,COINVOIC", Стр.ТипСообщения) Тогда
			//RETANN не входит в цепочку
			Запрос.Текст = Запрос.Текст+Символы.ПС+"	ВложенныйЗапрос."
			
			+"Док_"+СтрЗаменить(Стр.ИмяТипа,"ДокументСсылка.","")
				
			+" как Документ_"+Стр.ТипСообщения+",";
		КонецЕсли;	
	КонецЦикла;	
	
	Запрос.Текст = Лев(Запрос.Текст,СтрДлина(Запрос.Текст)-1);//обрежем последнюю запятую
	Запрос.Текст = Запрос.Текст
				+Символы.ПС+" ИЗ ("+ТекстВложенногоЗапроса+") как ВложенныйЗапрос";
	
	Запрос.УстановитьПараметр("Ссылка",МассивДокументов);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	//закэшировать
	ЭДО_Кэш_Поместить("КэшТаблицыСвязанныхДокументовПоТипамСообщений", 
						Новый Структура("ДокументСсылка,ТаблицаСвязанных", 
										ДокументСсылка, Результат));
	
	Возврат Результат;
	
КонецФункции	

Функция ЗаполнитьАлкогольныеРеквизиты(Сообщение)
	
	Если НЕ Метаданные.РегистрыСведений.Найти("СведенияОбАлкогольнойПродукции") = Неопределено Тогда
		
		ПустаяСтруктураЛицензии = Новый Структура();
		ПустаяСтруктураЛицензии.Вставить("Серия",			"");
		ПустаяСтруктураЛицензии.Вставить("ДатаНачала",		"");
		ПустаяСтруктураЛицензии.Вставить("ДатаОкончания",	"");
		ПустаяСтруктураЛицензии.Вставить("КемВыдана",		"");
		
		Запрос = Новый Запрос();
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеализацияТоваровУслугТовары.Номенклатура,
		|	СведенияОбАлкогольнойПродукции.ВидПродукции.КодВидаПродукции КАК КодВидаПродукции
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОбАлкогольнойПродукции КАК СведенияОбАлкогольнойПродукции
		|		ПО РеализацияТоваровУслугТовары.Номенклатура = СведенияОбАлкогольнойПродукции.Номенклатура
		|ГДЕ
		|	РеализацияТоваровУслугТовары.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка",Сообщение.ДокументСсылка);
		
		ТЗ = Запрос.Выполнить().Выгрузить();
		ТЗ.Индексы.Добавить("Номенклатура");
		
		ТабЧасть = Сообщение.Товары;
		Для каждого Стр Из ТабЧасть Цикл
			
			Если ЗначениеЗаполнено(Стр.Номенклатура) Тогда
				
				НайденнаяСтрока = ТЗ.Найти(Стр.Номенклатура,"Номенклатура");
				
				Если НЕ НайденнаяСтрока = Неопределено Тогда
					Если ЗначениеЗаполнено(НайденнаяСтрока.КодВидаПродукции) Тогда
						Стр.АлкоКодПродукции = СокрЛП(НайденнаяСтрока.КодВидаПродукции);
					КонецЕсли;
				КонецЕсли;
				
				Импортер = Стр.Номенклатура.Импортер;
				
				Если ЗначениеЗаполнено(Импортер) Тогда
					
					Стр.АлкоПроизводитель1С = Импортер;
					
				Иначе
					
					Производитель = Стр.Номенклатура.Производитель;
					
					Если ЗначениеЗаполнено(Производитель) Тогда
						Стр.АлкоПроизводитель1С = Производитель;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			// Объем
			
			Если ЗначениеЗаполнено(Стр.ЕдиницаИзмерения) и ЕстьРеквизитОбъекта_Контур(Стр.ЕдиницаИзмерения, "Объем") Тогда
				
				Стр.АлкоОбъем = Стр.ЕдиницаИзмерения.Объем; // не во всех типовых конфигурациях есть Объем у ед. изм
				
			КонецЕсли;
			
			// Лицензия поставщика
			
			Стр.АлкоЛицензияПоставщика = ПустаяСтруктураЛицензии;
			
		КонецЦикла;
		
		// данные об адресе доставки будут заполнены из входящего заказа (если он был)
		
		// Номер и дата ТТН
		
		Попытка
			Сообщение.ТранспортнаяНакладнаяEDI.Номер = ПолучитьНомерНаПечать_КонтурEDI(Сообщение.ДокументСсылка);
			Выполнить("Сообщение.ТранспортнаяНакладнаяEDI.Дата  = Сообщение.ДокументEDI.Дата;");
			//Выполнить("Сообщение.ТранспортнаяНакладнаяEDI.Номер = ОбщегоНазначения.ПолучитьНомерНаПечать(Сообщение.ДокументСсылка);");
		Исключение
			ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось заполнить номер или дату транспортной накладной - " + ОписаниеОшибки());	
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Сообщение;
	
КонецФункции

// +++ 1 бит Балицкий В.В. 07.10.2026
// Возвращает номер и дату проведённой транспортной накладной, связанной с документом-основанием (реализацией).
Функция ПолучитьНомерИДатуТТНПоДокументуОснованию_КонтурEDI(ДокументОснование) Экспорт
	
	Результат = Новый Структура("Номер, Дата, Найдено", "", Неопределено, Ложь);
	
	Если НЕ ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если НЕ ЕстьНеобходимыеМетаданные("Документы.ТранспортнаяНакладная", Истина) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если НЕ ЕстьНеобходимыеМетаданные("Документы.ТранспортнаяНакладная.ТабличныеЧасти.ДокументыОснования", Истина) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ТранспортнаяНакладнаяДокументыОснования.Ссылка КАК Ссылка,
		|	ТранспортнаяНакладнаяДокументыОснования.Ссылка.Дата КАК Дата
		|ИЗ
		|	Документ.ТранспортнаяНакладная.ДокументыОснования КАК ТранспортнаяНакладнаяДокументыОснования
		|ГДЕ
		|	ТранспортнаяНакладнаяДокументыОснования.ДокументОснование = &ДокументОснование
		|	И ТранспортнаяНакладнаяДокументыОснования.Ссылка.Проведен
		|	И НЕ ТранспортнаяНакладнаяДокументыОснования.Ссылка.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ";
		
		Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			
			Результат.Номер = ПолучитьНомерНаПечать_КонтурEDI(Выборка.Ссылка);
			Если НЕ ЗначениеЗаполнено(Результат.Номер) Тогда
				Результат.Номер = СокрЛП(Выборка.Ссылка.Номер);
			КонецЕсли;
			
			Результат.Дата = Выборка.Дата;
			Результат.Найдено = Истина;
			
		КонецЕсли;
		
	Исключение
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка,
			"Не удалось получить номер/дату ТТН по документу-основанию - " + ОписаниеОшибки());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Заполняет в сообщении DESADV номер и дату ТТН из связанной транспортной накладной.
Процедура ЗаполнитьНомерИДатуТТНВСообщенииИзТранспортнойНакладной_КонтурEDI(Сообщение) Экспорт
	
	Если НЕ ТипЗнч(Сообщение) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ТипСообщения = "";
	Если НЕ Сообщение.Свойство("ТипСообщения", ТипСообщения) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ТипСообщения = "DESADV" Тогда
		Возврат;
	КонецЕсли;
	
	ДокументОснование = Неопределено;
	Если Сообщение.Свойство("ДокументСсылка") Тогда
		ДокументОснование = Сообщение.ДокументСсылка;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДокументОснование) И Сообщение.Свойство("Документ1С") Тогда
		ДокументОснование = Сообщение.Документ1С;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДокументОснование) И Сообщение.Свойство("Накладная1С") Тогда
		ДокументОснование = Сообщение.Накладная1С;
	КонецЕсли;
	
	ДанныеТТН = ПолучитьНомерИДатуТТНПоДокументуОснованию_КонтурEDI(ДокументОснование);
	
	Если НЕ ДанныеТТН.Найдено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Сообщение.Свойство("ТранспортнаяНакладнаяEDI")
		ИЛИ НЕ ТипЗнч(Сообщение.ТранспортнаяНакладнаяEDI) = Тип("Структура") Тогда
		Сообщение.Вставить("ТранспортнаяНакладнаяEDI", ПолучитьСтруктуруПоляСообщения("ТранспортнаяНакладная"));
	КонецЕсли;
	
	Сообщение.ТранспортнаяНакладнаяEDI.Номер = ДанныеТТН.Номер;
	Сообщение.ТранспортнаяНакладнаяEDI.Дата = ДанныеТТН.Дата;
	
	// Плоские поля особенностей / формы (если объявлены в ПМ)
	Если Сообщение.Свойство("НомерТТН") Тогда
		Сообщение.НомерТТН = ДанныеТТН.Номер;
	КонецЕсли;
	Если Сообщение.Свойство("ДатаТТН") Тогда
		Сообщение.ДатаТТН = ДанныеТТН.Дата;
	КонецЕсли;
	
	// Особенности сообщения: поля с waybill / «ТТН» (кроме ДокументEDI — это номер DESADV)
	Если ТипЗнч(ОсобенностиСообщений) = Тип("ТаблицаЗначений") Тогда
		
		Для Каждого ОсобенностьСообщения Из ОсобенностиСообщений Цикл
			
			Если НЕ ОсобенностьЕстьВСообщении(ОсобенностьСообщения, Сообщение) Тогда
				Продолжить;
			КонецЕсли;
			
			ПутьxmlВрег = ВРег(Строка(ОсобенностьСообщения.Путьxml));
			НаименованиеВрег = ВРег(Строка(ОсобенностьСообщения.Наименование));
			ИдентификаторВрег = ВРег(Строка(ОсобенностьСообщения.Идентификатор));
			ПодробноеОписаниеВрег = ВРег(Строка(ОсобенностьСообщения.ПодробноеОписание));
			
			ЭтоНомерТТН = (Найти(ПутьxmlВрег, "WAYBILL.NUMBER") > 0)
				ИЛИ (Найти(НаименованиеВрег, "НОМЕР ТТН") > 0)
				ИЛИ (Найти(ИдентификаторВрег, "НОМЕРТТН") > 0)
				ИЛИ (Найти(ПодробноеОписаниеВрег, "НОМЕР ТРАНСПОРТНОЙ НАКЛАДНОЙ") > 0);
			
			ЭтоДатаТТН = (Найти(ПутьxmlВрег, "WAYBILL.DATE") > 0)
				ИЛИ (Найти(НаименованиеВрег, "ДАТА ТТН") > 0)
				ИЛИ (Найти(ИдентификаторВрег, "ДАТАТТН") > 0)
				ИЛИ (Найти(ПодробноеОписаниеВрег, "ДАТА ТРАНСПОРТНОЙ НАКЛАДНОЙ") > 0);
			
			Если НЕ ЭтоНомерТТН И НЕ ЭтоДатаТТН Тогда
				Продолжить;
			КонецЕсли;
			
			ПолныйПутьОсобенности = ПолучитьПолныйПутьОсобенностиСообщения(ОсобенностьСообщения);
			Если НЕ ЗначениеЗаполнено(ПолныйПутьОсобенности) Тогда
				Продолжить;
			КонецЕсли;
			
			// Не подменяем номер/дату самого EDI-документа (DESADV)
			Если Найти(ВРег(ПолныйПутьОсобенности), "ДОКУМЕНТEDI") > 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ЗначениеОсобенности = ?(ЭтоНомерТТН, ДанныеТТН.Номер, ДанныеТТН.Дата);
			ПеренестиЗначениеВПолеСтруктуры(Сообщение, ПолныйПутьОсобенности, ЗначениеОсобенности);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры
