// СЛУЖЕБНЫЙ ИНТЕРФЕЙС

Функция КонтурEDIAPI_НовыйМенеджерНастроек()
	
	МенеджерНастроек = Новый Структура;
	
	МенеджерНастроек.Вставить("КлиентИД", "");
	МенеджерНастроек.Вставить("ТестовоеОкружение", Ложь);
	МенеджерНастроек.Вставить("Сессия", Неопределено);
	МенеджерНастроек.Вставить("КэшТокенов", Неопределено);
	МенеджерНастроек.Вставить("АдресСервера", "");
	МенеджерНастроек.Вставить("АдресаСерверов", Неопределено);
	МенеджерНастроек.Вставить("ИнтернетРесурсДоступен", Неопределено);
	МенеджерНастроек.Вставить("ДатаПроверкиРесурса", Неопределено);
	МенеджерНастроек.Вставить("ХранилищеСхем", Неопределено);

	Возврат МенеджерНастроек;
	
КонецФункции

Функция КонтурEDIAPI_НовыйПараметрыСервиса()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Сервер"							, КонтурEDIAPI_АдресСервера()			);
	Результат.Вставить("Метод"							, ""						);
	Результат.Вставить("АдресРесурса"					, ""						);
	Результат.Вставить("URL"							, ""						);
	Результат.Вставить("ТелоЗапроса"					, Неопределено				);
	Результат.Вставить("Параметры"						, Новый Структура			);
	Результат.Вставить("Заголовки"						, Новый Соответствие		);
	Результат.Вставить("ДопустимыеКодыОтвета"			, Новый Массив				);
	Результат.Вставить("ТипОтвета"						, КонтурEDIAPI_ТипыОтветаСервиса().JSON	);
		
	Результат.Заголовки.Вставить("Accept"		, "application/json");
	Результат.Заголовки.Вставить("Content-Type"	, "application/json;charset=utf-8");
	
	Возврат Результат;
	
КонецФункции 

Функция КонтурEDIAPI_СформироватьТокен(ClientID, konturediauth_token = Неопределено, konturediauth_login = Неопределено, konturediauth_password = Неопределено)      
	
	Если ПустаяСтрока(konturediauth_token) Тогда
		Токен  = КонтурСтандарт_СтрШаблон_("KonturEdiAuth konturediauth_api_client_id=%1, konturediauth_login=%2, konturediauth_password=%3", ClientID, konturediauth_login, konturediauth_password);  
	Иначе    
		Токен  = КонтурСтандарт_СтрШаблон_("KonturEdiAuth konturediauth_api_client_id=%1, konturediauth_token=%2", ClientID, konturediauth_token);	
	КонецЕсли;    
		
	Возврат Токен;
	
КонецФункции

Функция КонтурEDIAPI_ТипыОтветаСервиса()   
	
	Структура = Новый Структура;
	
	Структура.Вставить("BASE64"	,	"BASE64");
	Структура.Вставить("BIN"	,	"BIN"	);
	Структура.Вставить("JSON"	,	"JSON"	);
	Структура.Вставить("STRING"	,	"STRING");
	
	Возврат Структура; 
	
КонецФункции  

Функция КонтурEDIAPI_Get(ДанныеАвторизацииEDI, URL, ПараметрыЗапроса = Неопределено, ДополнительныеПараметры = Неопределено, Сессия = Неопределено)
	
	Ответ = КлиентHTTP_Get(URL, ПараметрыЗапроса, ДополнительныеПараметры, Сессия);
	
	Если КонтурEDIAPI_КодСостояния_401(Ответ) Тогда
		
		КонтурEDIAPI_ОбновитьТокенАвторизации(ДанныеАвторизацииEDI);
		
		Ответ = КлиентHTTP_Get(URL, ПараметрыЗапроса, ДополнительныеПараметры, Сессия);
		
	ИначеЕсли КонтурEDIAPI_ЭтоКодСостоянияДляСменыСервера(Ответ) Тогда
		
		ДоступенРезервныйАдрес = КонтурEDIAPI_СменитьАдресСервераНаРезервный();
		
		Если ДоступенРезервныйАдрес Тогда
		
			URL = КонтурEDIAPI_ЗаменитьАдресСервераВURL(URL); 
		
			Ответ = КонтурEDIAPI_Get(ДанныеАвторизацииEDI, URL, ПараметрыЗапроса, Сессия);	
		
		КонецЕсли;

	КонецЕсли; 
		
	Возврат Ответ; 
	
КонецФункции

Функция КонтурEDIAPI_Post(ДанныеАвторизацииEDI, URL, Данные = Неопределено, ДополнительныеПараметры = Неопределено, Сессия = Неопределено)
	
	Ответ = КлиентHTTP_Post(URL, Данные, ДополнительныеПараметры, Сессия);
	
	Если НЕ ДанныеАвторизацииEDI = Неопределено 
		И КонтурEDIAPI_КодСостояния_401(Ответ) Тогда
		
		КонтурEDIAPI_ОбновитьТокенАвторизации(ДанныеАвторизацииEDI);
		
		Ответ = КлиентHTTP_Post(URL, Данные, ДополнительныеПараметры, Сессия);
		
	ИначеЕсли КонтурEDIAPI_ЭтоКодСостоянияДляСменыСервера(Ответ) Тогда
		
		ДоступенРезервныйАдрес = КонтурEDIAPI_СменитьАдресСервераНаРезервный();
		
		Если ДоступенРезервныйАдрес Тогда
		
			URL = КонтурEDIAPI_ЗаменитьАдресСервераВURL(URL); 
		
			Ответ = КонтурEDIAPI_Post(ДанныеАвторизацииEDI, URL, Данные, ДополнительныеПараметры, Сессия);	
		
		КонецЕсли;

	КонецЕсли;
	
	Возврат Ответ; 
	
КонецФункции 

Функция КонтурEDIAPI_ЗаменитьАдресСервераВURL(URL)

	СтруктураURL = КлиентHTTP_РазобратьURL(URL);
		
	URL = СтрЗаменить(URL, СтруктураURL.Сервер, КонтурEDIAPI_АдресСервера());
	
	Возврат URL;
	
КонецФункции

Функция КонтурEDIAPI_ЭтоКодСостоянияДляСменыСервера(Ответ)
	
	Коды = КлиентHTTP_КодыСостоянияHTTP();
	
	Возврат Ответ.КодСостояния >= 500; 
	
КонецФункции

Функция КонтурEDIAPI_КодСостояния_401(Ответ)
	
	Коды = КлиентHTTP_КодыСостоянияHTTP();
	
	Возврат Ответ.КодСостояния = Коды.НеАвторизован_401;	
	
КонецФункции                

Функция КонтурEDIAPI_ОбработатьРезультатHTTPЗапроса(ПараметрыСервиса, РезультатHTTP) 
	
	ТипыОтветаСервиса = КонтурEDIAPI_ТипыОтветаСервиса();
	
	ОтветСервиса = Новый Структура("Успешно, Результат, ОписаниеОшибки");
	
	ДопустимыеКодыОтвета	= ПараметрыСервиса.ДопустимыеКодыОтвета;
	
	ОтветСервиса.Успешно = ДопустимыеКодыОтвета.Найти(Число(РезультатHTTP.КодСостояния)) <> Неопределено;
	
	Если ОтветСервиса.Успешно Тогда
		
		Если ПараметрыСервиса.ТипОтвета = ТипыОтветаСервиса.JSON Тогда 
			
			Результат = КлиентHTTP_КакJson(РезультатHTTP, Ложь);
			
		ИначеЕсли ПараметрыСервиса.ТипОтвета = ТипыОтветаСервиса.BASE64 Тогда
			
			Результат = Base64Значение(КлиентHTTP_КакТекст(РезультатHTTP));		  
			
		ИначеЕсли ПараметрыСервиса.ТипОтвета = ТипыОтветаСервиса.STRING Тогда
			
			Результат = КлиентHTTP_КакТекст(РезультатHTTP);
			
		Иначе    
			
			Результат = РезультатHTTP.Тело;	 
			
		КонецЕсли;
		
		ОтветСервиса.Результат = Результат;
		
	Иначе                     
		
		ВызватьИсключение КлиентHTTP_КакИсключение(РезультатHTTP);		  
	
	КонецЕсли;
	
	Возврат ОтветСервиса;
	
КонецФункции

Процедура КонтурEDIAPI_УстановитьТокенДляЗапроса(ДанныеАвторизацииEDI)

	ДанныеАвторизацииEDI.Токен = КонтурEDIAPI_ПрочитатьТокенИзКэша(ДанныеАвторизацииEDI);	
	
	ТипыАвторизации = КонтурEDIAPI_ТипыАвторизации();
	
	Если ПустаяСтрока(ДанныеАвторизацииEDI.Токен) Тогда
		
		Если ДанныеАвторизацииEDI.ТипАвторизации = ТипыАвторизации.ЛогинПароль Тогда
			
			ДанныеАвторизацииEDI.Токен = КонтурEDIAPI_Авторизоваться(ДанныеАвторизацииEDI);	
			
			КонтурEDIAPI_ЗаписатьТокенВКэш(ДанныеАвторизацииEDI);
			
		ИначеЕсли ДанныеАвторизацииEDI.ТипАвторизации = ТипыАвторизации.ТокенДоступа Тогда
			
			АутентификаторEDI_Инициализировать(ДанныеАвторизацииEDI.Организация);
			
			Сессия = Аутентификатор_ПолучитьСессию();
			
			Если Сессия <> Неопределено Тогда
				
				ДанныеАвторизацииEDI.ПортальныйИд = Сессия.ПортальныйИд;
				ДанныеАвторизацииEDI.Токен = Сессия.ТокенДоступа;
			
				КонтурEDIAPI_ЗаписатьТокенВКэш(ДанныеАвторизацииEDI);
				
			Иначе
				
				ВызватьИсключение "Не удалось получить сессию авторизации через портал Контура для организации " + Строка(ДанныеАвторизацииEDI.Организация);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли; 
	
	КонтурEDIAPI_УстановитьЗаголовокАвторизации(ДанныеАвторизацииEDI);
	
КонецПроцедуры

Процедура КонтурEDIAPI_ОбновитьТокенАвторизации(ДанныеАвторизацииEDI)
		
	ДанныеАвторизацииEDI.Токен = "";
		
	КонтурEDIAPI_ЗаписатьТокенВКэш(ДанныеАвторизацииEDI);	
	
	КонтурEDIAPI_УстановитьТокенДляЗапроса(ДанныеАвторизацииEDI);
	
КонецПроцедуры

Процедура КонтурEDIAPI_УстановитьЗаголовокАвторизации(ДанныеАвторизацииEDI)

	МенеджерНастроек = КонтурEDIAPI_МенеджерНастроек();
	
	ТипыАвторизации = КонтурEDIAPI_ТипыАвторизации();
		
	Если ДанныеАвторизацииEDI.ТипАвторизации = ТипыАвторизации.ЛогинПароль Тогда
		
		Логин  = ДанныеАвторизацииEDI.Логин; 
		Пароль = ДанныеАвторизацииEDI.Пароль;
		Токен  = ДанныеАвторизацииEDI.Токен;
		
		Если ПустаяСтрока(Токен) И ПустаяСтрока(Логин) И ПустаяСтрока(Пароль) Тогда
			
			МенеджерНастроек.Сессия.Заголовки.Удалить("Authorization");    
			
		Иначе
			
			ЗаголовокАвторизации = КонтурEDIAPI_СформироватьТокен(МенеджерНастроек.КлиентИД, Токен, Логин, Пароль); 	
			МенеджерНастроек.Сессия.Заголовки.Вставить("Authorization", ЗаголовокАвторизации); 
			
		КонецЕсли;	

	ИначеЕсли ДанныеАвторизацииEDI.ТипАвторизации = ТипыАвторизации.ТокенДоступа Тогда
		
		Токен  = ДанныеАвторизацииEDI.Токен;
		
		Если ПустаяСтрока(Токен) Тогда
			
			МенеджерНастроек.Сессия.Заголовки.Удалить("Authorization");    
			
		Иначе
			
			ЗаголовокАвторизации = КонтурСтандарт_СтрШаблон_("Bearer %1", Токен); 	
			МенеджерНастроек.Сессия.Заголовки.Вставить("Authorization", ЗаголовокАвторизации); 
			
		КонецЕсли;	
		
	Иначе
		
		ВызватьИсключение "Задан некорректный способ авторизации";
		
	КонецЕсли;

КонецПроцедуры

Процедура КонтурEDIAPI_ЗаписатьТокенВКэш(ДанныеАвторизацииEDI)
	
	КлючНастроек = "";
	
	ТипыАвторизации = КонтурEDIAPI_ТипыАвторизации();
	
	Если ДанныеАвторизацииEDI.ТипАвторизации = ТипыАвторизации.ЛогинПароль Тогда
		
		КлючНастроек = ДанныеАвторизацииEDI.Логин;
				
	ИначеЕсли ДанныеАвторизацииEDI.ТипАвторизации = ТипыАвторизации.ТокенДоступа Тогда
		
		КлючНастроек = Строка(ДанныеАвторизацииEDI.Организация.УникальныйИдентификатор()) + "_" + ДанныеАвторизацииEDI.ПортальныйИд;
		
	КонецЕсли;
	
	МенеджерНастроек = КонтурEDIAPI_МенеджерНастроек();
	
	МенеджерНастроек.КэшТокенов.Вставить(КлючНастроек, ДанныеАвторизацииEDI.Токен);

КонецПроцедуры

Функция КонтурEDIAPI_ПрочитатьТокенИзКэша(ДанныеАвторизацииEDI)
	
	КлючНастроек = "";

	ТипыАвторизации = КонтурEDIAPI_ТипыАвторизации();
	
	Если ДанныеАвторизацииEDI.ТипАвторизации = ТипыАвторизации.ЛогинПароль Тогда
		
		КлючНастроек = ДанныеАвторизацииEDI.Логин;
				
	ИначеЕсли ДанныеАвторизацииEDI.ТипАвторизации = ТипыАвторизации.ТокенДоступа Тогда
		
		КлючНастроек = Строка(ДанныеАвторизацииEDI.Организация.УникальныйИдентификатор()) + "_" + ДанныеАвторизацииEDI.ПортальныйИд;
		
	КонецЕсли;
	
	МенеджерНастроек = КонтурEDIAPI_МенеджерНастроек();

	Токен = МенеджерНастроек.КэшТокенов.Получить(КлючНастроек);
	
	Возврат ?(Токен = Неопределено, "", Токен); 

КонецФункции

