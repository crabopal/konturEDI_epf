//{{ Центр поддержки

Функция ИнициализироватьСтруктуруРезультатаПолученияДвоичныхДанныхФайла();
	
	Структура = Новый Структура;
	Структура.Вставить("Успешно"		, Истина);
	Структура.Вставить("ТекстОшибки"	, "");
	Структура.Вставить("ДвоичныеДанные"	, Неопределено);
	
	Возврат Структура;
	
КонецФункции

Процедура ЗаполнитьСвойстваОбъектаФайл_КонтурEDI(МассивФайлов, ДвоичныеДанныеФайла, ИмяФайла, ДляЦентраПоддержки = Ложь)
	
	Перем Файл;
	
	Если ДляЦентраПоддержки Тогда
		Файл = ЦентрПоддержки().МодельФайла();
	Иначе
		Файл = Новый Структура("ИмяФайла, Данные");
	КонецЕсли;
	
	Файл.ИмяФайла	= ИмяФайла;
	Файл.Данные		= ДвоичныеДанныеФайла;
	
	МассивФайлов.Добавить(Файл);	

КонецПроцедуры

Функция ПолучитьДвоичныеДанныеФайлаНастроекМодуля_КонтурEDI()
	
	Результат = ИнициализироватьСтруктуруРезультатаПолученияДвоичныхДанныхФайла();
	
	Попытка
											
		ПутьКФайлуНастроекМодуляКонтурEDI = ПодготовитьФайлНастроекМодуля();
		
		Если ПутьКФайлуНастроекМодуляКонтурEDI <> Неопределено Тогда
		
			Результат.ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлуНастроекМодуляКонтурEDI);
			
			УдалитьФайлы_КонтурEDI(ПутьКФайлуНастроекМодуляКонтурEDI);
			
		Иначе
			
			Результат.Успешно = Ложь;
			Результат.ТекстОшибки = НСтр("ru = 'Не удалось получить путь к файлу настроек модуля.'");
			
		КонецЕсли;
		
	Исключение
		
		Результат.Успешно = Ложь;
		Результат.ТекстОшибки = НСтр("ru = 'Не удалось получить двоичные данные настроек модуля по причине: '") + ОписаниеОшибки();

		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, Результат.ТекстОшибки);
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДвоичныеДанныеФайлаНастроекПартнеров_КонтурEDI()
	
	Перем ФильтрПартнеров;
	
	Результат = ИнициализироватьСтруктуруРезультатаПолученияДвоичныхДанныхФайла();	
		
	Попытка
											
		НастройкиПартнеровКонтурEDI = ПолучитьЗначенияНастроекПартнеров(ФильтрПартнеров, Истина);
	    		
		Результат.ДвоичныеДанные = ПолучитьИзСтроки(ЗаписатьJSON_(НастройкиПартнеровКонтурEDI));
		
	Исключение
		
		Результат.Успешно = Ложь;
		Результат.ТекстОшибки = НСтр("ru = 'Не удалось получить двоичные данные настроек партнеров по причине: '") + ОписаниеОшибки();

		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, Результат.ТекстОшибки);
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДвоичныеДанныеФайлаРасширенияКонфигурации_КонтурEDI(РасположениеМодуля)
	
	Результат = ИнициализироватьСтруктуруРезультатаПолученияДвоичныхДанныхФайла();
	
	ВариантыРасположенияМодуля = ПеречисленияEDI_ВариантыРасположенияМодуля();
	
	Если РасположениеМодуля = ВариантыРасположенияМодуля.Расширение Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		РасширениеКонфигурацииКонтурEDI = РасширениеEDI_КонтурEDI();
		
		Если РасширениеКонфигурацииКонтурEDI <> Неопределено Тогда
			Результат.ДвоичныеДанные = РасширениеКонфигурацииКонтурEDI.ПолучитьДанные();
		Иначе
			Результат.Успешно = Ложь;
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Ложь);
		
	Иначе
		Результат.Успешно = Ложь;	
	КонецЕсли;
	
	Если Не Результат.Успешно Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не удалось получить двоичные данные Расширения конфигурации КонтурEDI.'");	
	КонецЕсли;
			
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДвоичныеДанныеФайлаМодуля_КонтурEDI(РасположениеМодуля, АдресФайлаОбработкиКлиент)
		
	Результат = ИнициализироватьСтруктуруРезультатаПолученияДвоичныхДанныхФайла();
	
	ПутьКМодулю = ОпределитьПутьКМодулю_КонтурEDI(РасположениеМодуля);
	
	ВариантыРасположенияМодуля = ПеречисленияEDI_ВариантыРасположенияМодуля();
	
	Если РасположениеМодуля = ВариантыРасположенияМодуля.Файл Тогда
		
		Файл = Новый Файл(ПутьКМодулю);
		
		Если Файл.Существует() Тогда
			
			Результат.ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКМодулю);
			
		ИначеЕсли ЭтоАдресВременногоХранилища(АдресФайлаОбработкиКлиент) Тогда
			
			Результат.ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайлаОбработкиКлиент);
			
			УдалитьИзВременногоХранилища(АдресФайлаОбработкиКлиент);
			
		Иначе
			Результат.Успешно = Ложь;
		КонецЕсли;		
		
	ИначеЕсли РасположениеМодуля = ВариантыРасположенияМодуля.Справочник
				И ПутьКМодулю <> Неопределено Тогда
		
		Результат.ДвоичныеДанные = ФайлОбработкиИзСправочникаВнешнихОбработок(ПутьКМодулю);
		
	Иначе		
		Результат.Успешно = Ложь;
	КонецЕсли;
	
	Если НЕ Результат.Успешно Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не удалось получить двоичные данные модуля.'");
	КонецЕсли;
	
	Возврат Результат;	
	
КонецФункции

Функция ПолучитьДвоичныеДанныеФайлаПодключаемыйМодуль_КонтурEDI()
	
	Результат = ИнициализироватьСтруктуруРезультатаПолученияДвоичныхДанныхФайла();                 
	
	Попытка
		
		ПутьКФайлуПодключаемогоМодуля = ПолучитьПутьКФайлуПодключаемогоМодуля();
		
		Если ПутьКФайлуПодключаемогоМодуля <> Неопределено Тогда			
			Результат.ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлуПодключаемогоМодуля);
		Иначе
			
			Результат.Успешно = Ложь;
			Результат.ТекстОшибки = НСтр("ru = 'Не удалось получить путь к файлу подключаемого модуля.'");
			
		КонецЕсли;                                
		
	Исключение
		
		Результат.Успешно = Ложь;
		Результат.ТекстОшибки = НСтр("ru = 'Не удалось получить двоичные данные подключаемого модуля по причине: '") + ОписаниеОшибки();
		
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, Результат.ТекстОшибки);
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции 

Функция ПолучитьДвоичныеДанныеФайлаМетаданныхРасширенийМодуля_КонтурEDI(ТаблицаУстановленныхРасширений)
	
	Результат = ИнициализироватьСтруктуруРезультатаПолученияДвоичныхДанныхФайла();
	
	Попытка
		
		МассивИнформацииОРасширениях = Метрика_СформироватьИнформациюОРасширениях(ТаблицаУстановленныхРасширений);
		
		Результат.ДвоичныеДанные = ПолучитьИзСтроки(ЗаписатьJSON_(МассивИнформацииОРасширениях));
		
	Исключение
		
		Результат.Успешно = Ложь;
		Результат.ТекстОшибки = НСтр("ru = 'Не удалось получить двоичные данные метаданных расширений модуля по причине: '") + ОписаниеОшибки();
		
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка,  Результат.ТекстОшибки);
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДвоичныеДанныеФайлаАрхиваРасширенийМодуля_КонтурEDI(ТаблицаУстановленныхРасширений)
	
	Результат = ИнициализироватьСтруктуруРезультатаПолученияДвоичныхДанныхФайла();
	
	Попытка
		
		ФайлДляВыгрузки = ПолучитьИмяВременногоФайла("zip");
		
		КаталогВыгрузкиРасширений = КаталогВременныхФайлов() + "ВыгрузкаРасширений";	
		Файл = Новый Файл(КаталогВыгрузкиРасширений);
		Если Файл.Существует() Тогда
			УдалитьФайлы(КаталогВыгрузкиРасширений);	
		КонецЕсли;	
		СоздатьКаталог(КаталогВыгрузкиРасширений);
		
		ЗаписьZipФайла = Новый ЗаписьZipФайла(ФайлДляВыгрузки);
		
		ПорядокРасширения = 1;
		СтрокаИнформации = "";
		
		Для Каждого СтрокаРасширений Из ТаблицаУстановленныхРасширений Цикл
			
			ИдентификаторРасширения = СтрокаРасширений.Идентификатор;
			РасширениеСсылка = СтрокаРасширений.Ссылка;
			
			ИдентификаторРасширения = Строка(ПорядокРасширения) + "__" + ИдентификаторРасширения;
			
			КаталогВыгрузки = КаталогВыгрузкиРасширений + "\" + ИдентификаторРасширения;
			
			КаталогНаДиске = Новый Файл(КаталогВыгрузки);
			Если НЕ КаталогНаДиске.Существует() Тогда       
				СоздатьКаталог(КаталогВыгрузки);
			КонецЕсли;
			
			Если НЕ СтрокаРасширений.ВерсияРасширения = "0.0" Тогда 
				Типовое = Истина;
			Иначе
				Типовое = Ложь;			
			КонецЕсли;
			
			Если СтрокаРасширений.Измененное = Неопределено Тогда
				Измененное = ПроверитьМодифицированностьРасширения(РасширениеСсылка);
			Иначе
				Измененное = СтрокаРасширений.Измененное;
			КонецЕсли;				
			
			ЦП_ВыгрузитьРасширениеВКаталог(РасширениеСсылка, КаталогВыгрузки, Типовое, Измененное);
			
			ЗаписьZipФайла.Добавить(КаталогВыгрузки + "\", РежимСохраненияПутейZIP.СохранятьОтносительныеПути, РежимОбработкиПодкаталоговZIP.ОбрабатыватьРекурсивно);			
			
			Если Типовое Тогда
				Если Измененное Тогда
					Происхождение = "Типовое(измененное)";	
				Иначе
					Происхождение = "Типовое";		
				КонецЕсли;
			Иначе
				Происхождение = "Нетиповое";	
			КонецЕсли;
			
			СтрокаИнформации = СтрокаИнформации + Строка(ПорядокРасширения) + " " +  Строка(РасширениеСсылка) + " - " + Происхождение + Символы.ПС;
			
			ПорядокРасширения = ПорядокРасширения + 1;
		КонецЦикла;
		
		ИмяФайлаИнформации = КаталогВыгрузкиРасширений + "\" + "Информация о выгруженных расширениях.txt";
		ЗаписьТекста = Новый ЗаписьТекста(ИмяФайлаИнформации);
		ЗаписьТекста.Записать(СтрокаИнформации);
		ЗаписьТекста.Закрыть();
		ЗаписьZipФайла.Добавить(ИмяФайлаИнформации);
		
		ЗаписьZipФайла.Записать();
		
		Результат.ДвоичныеДанные = Новый ДвоичныеДанные(ФайлДляВыгрузки);
		
		УдалитьФайлы_КонтурEDI(ФайлДляВыгрузки);
		
	Исключение
		
		Результат.Успешно = Ложь;
		Результат.ТекстОшибки = НСтр("ru = 'Не удалось получить двоичные данные расширений модуля по причине: '") + ОписаниеОшибки();
		
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, Результат.ТекстОшибки);
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Процедура ЦП_ВыгрузитьРасширениеВКаталог(РасширениеСсылка, КаталогВыгрузки, Типовое = Ложь, Измененное = Ложь) Экспорт

	ДанныеДляВыгрузкиРасширения = ПолучитьДанныеДляВыгрузкиРасширения(РасширениеСсылка, Типовое, Измененное);
		
    ПолноеИмяФайла = КаталогВыгрузки + "\content.xml";
	ТД = Новый ТекстовыйДокумент;
	ТД.УстановитьТекст(ДанныеДляВыгрузкиРасширения.XMLРасширения);
	ТД.Записать(ПолноеИмяФайла,"UTF-8");
	
	Если ЗначениеЗаполнено(ДанныеДляВыгрузкиРасширения.ИнтерфейсФайл) Тогда
		ДанныеДляВыгрузкиРасширения.ИнтерфейсФайл.Записать(КаталогВыгрузки + "\interface.epf");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеДляВыгрузкиРасширения.Файлы) Тогда
		Для Каждого Файл Из ДанныеДляВыгрузкиРасширения.Файлы Цикл
			Файл.ДвоичныеДанные.Записать(КаталогВыгрузки + "\" + Файл.ИмяФайла);	
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция ЦП_GLNАктивныхУчетныхЗаписей() 
	
	Результат = "";
	
	УчетныеЗаписи = ПолучитьСписокЭлементовСправочника("УчетныеЗаписи");
	
	Для Каждого УчетнаяЗапись Из УчетныеЗаписи Цикл 
		
		Если УчетнаяЗапись.НеАктивна Тогда
			Продолжить;
		КонецЕсли;
		
		Результат = Результат + УчетнаяЗапись.GLN + Символы.ПС;
		
	КонецЦикла;                                                
	
	Если НЕ ПустаяСтрока(Результат) Тогда
		Результат = Лев(Результат, СтрДлина(Результат) - 1);		
	КонецЕсли;
	
	Возврат Результат;	
	
КонецФункции

Функция ЦП_ОтправитьЗапрос(Запрос) Экспорт
	
	АдресРесурса = "https://" + Запрос.Хост + Запрос.Ресурс;
	Метод = Запрос.Метод;
	
	ТелоЗапроса = Запрос.Тело;
	
	ПараметрыЗапроса = НовыеПараметрыHTTPЗапроса();
    
	Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
		Если ТипЗнч(ТелоЗапроса) = Тип("ДвоичныеДанные") Тогда
			ПараметрыЗапроса.ТелоЗапроса = Новый Структура("ДвоичныеДанные", ТелоЗапроса);
		ИначеЕсли ТипЗнч(ТелоЗапроса) = Тип("Строка") Тогда 
			ПараметрыЗапроса.ТелоЗапроса = Новый Структура("Строка", ТелоЗапроса);
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыЗапроса.ТелоОтвета  = Новый Структура("ДвоичныеДанные");
	ПараметрыЗапроса.Заголовки = Запрос.Заголовки;
	
	НастройкиПрокси = ПолучитьПараметрыИнтернетСоединения_KE();
	
	Если НастройкиПрокси.ИспользуетсяПрокси Тогда
		
		Прокси = Новый Структура;
		Прокси.Вставить("host"		, НастройкиПрокси.СерверПрокси + ":" + Формат(НастройкиПрокси.ПортПрокси,"ЧГ=0"));
		Прокси.Вставить("username"  , НастройкиПрокси.ЛогинПрокси);
		Прокси.Вставить("password"  , НастройкиПрокси.ПарольПрокси);
		Прокси.Вставить("ИспользоватьСистемныеНастройкиПрокси", НастройкиПрокси.ИспользоватьСистемныеНастройкиПрокси);
		Прокси.Вставить("СпособАутентификацииПрокси", НастройкиПрокси.СпособАутентификацииПрокси);

		ПараметрыЗапроса.Вставить("Прокси", Прокси);
		
	КонецЕсли;	
	
	РезультатВыполненияЗапроса = ВыполнитьHTTPЗапрос(Метод, АдресРесурса, ПараметрыЗапроса);
	
	Результат = Новый Структура("КодСостояния, Тело");
	Результат.КодСостояния = Число(РезультатВыполненияЗапроса.КодСостояния);
	Результат.Тело = РезультатВыполненияЗапроса.ТелоОтвета;
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьПараметрыЦентраПоддержки(ДопКонтекстДляЦентраПоддержки = Неопределено) Экспорт
	
	Результат = ЦентрПоддержки().МодельПараметрыСессии();
	
	Результат.ДополнительныеПараметры = ДополнительныеПараметрыЦентраПоддержки(ДопКонтекстДляЦентраПоддержки);
	Результат.Файлы = ПолучитьДанныеФайловДляОтправкиВЦентрПоддержки_КонтурEDI(ДопКонтекстДляЦентраПоддержки);
			
	Возврат Результат;
	
КонецФункции

Функция ДополнительныеПараметрыЦентраПоддержки(ДопКонтекстДляЦентраПоддержки)
		
	СписокСвойств = ПолучитьСписокСвойствEDI("МодульEDIИзменен, GLN_Основной, ДатаПоследнегоВыполненияОбмена");
	
	ДополнительныеПараметры = Новый Соответствие;
	ДополнительныеПараметры.Вставить("Версия модуля", Строка(ПолучитьНомерРелиза_КонтурEDI()));
	ДополнительныеПараметры.Вставить("Представление особенностей модуля", Строка(ПредставлениеОсобенностейМодуля()));
	ДополнительныеПараметры.Вставить("Модуль изменен", Строка(СписокСвойств.МодульEDIИзменен));
	ДополнительныеПараметры.Вставить("Есть подключаемый модуль",  Строка(ИспользуетсяПодключаемыйМодуль));
	ДополнительныеПараметры.Вставить("GLN-ы учетных записей", ЦП_GLNАктивныхУчетныхЗаписей());
	ДополнительныеПараметры.Вставить("Время последнего обмена с сервером", Строка(СписокСвойств.ДатаПоследнегоВыполненияОбмена));
	
	Если ТипЗнч(ДопКонтекстДляЦентраПоддержки) = Тип("Структура") Тогда
		
		ДополнитьПараметрыСессииЦентраПоддержки_Ошибки(ДопКонтекстДляЦентраПоддержки, ДополнительныеПараметры);
		
		ДополнитьПараметрыСессииЦентраПоддержки_Контекст(ДопКонтекстДляЦентраПоддержки, ДополнительныеПараметры);  
		
	КонецЕсли;
	
	Возврат ДополнительныеПараметры;

КонецФункции

Процедура ДополнитьПараметрыСессииЦентраПоддержки_Контекст(Знач ДопКонтекстДляЦентраПоддержки, Знач ДополнительныеПараметры)
	
	ДопКонтекст = Новый Массив;
	
	Если ДопКонтекстДляЦентраПоддержки.Свойство("Сообщение")
		И ЗначениеЗаполнено(ДопКонтекстДляЦентраПоддержки.Сообщение) Тогда
		
		Сообщение = ДопКонтекстДляЦентраПоддержки.Сообщение;
		
		ДопКонтекст.Добавить("Отправитель: " + Сообщение.ОтправительEDI.GLN);
		ДопКонтекст.Добавить("Получатель: " + Сообщение.ПолучательEDI.GLN);
		ДопКонтекст.Добавить("Тип сообщения: " + Сообщение.ТипСообщения);
		
		Если ПеременнаяСодержитСвойство(Сообщение, "ЗаказEDI") Тогда
			ДопКонтекст.Добавить("Номер заказа: " + Сообщение.ЗаказEDI.Номер);
		КонецЕсли;
		
		Если ПеременнаяСодержитСвойство(Сообщение, "ДокументEDI") Тогда
			ДопКонтекст.Добавить("Номер документа: " + Сообщение.ДокументEDI.Номер);
		КонецЕсли;
		
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДопКонтекст) Тогда
		
		ДополнительныеПараметры.Вставить("context", 
		EDI_СоединитьСтрокуИзМассиваСлов(ДопКонтекст, Символы.ПС));
		
	КонецЕсли;

КонецПроцедуры

Процедура ДополнитьПараметрыСессииЦентраПоддержки_Ошибки(ДопКонтекстДляЦентраПоддержки, ДополнительныеПараметры)
	
	Если ДопКонтекстДляЦентраПоддержки.Свойство("МассивОшибок") 
		И ЗначениеЗаполнено(ДопКонтекстДляЦентраПоддержки.МассивОшибок) Тогда
		
		ДополнительныеПараметры.Вставить("errordetails",
		EDI_СоединитьСтрокуИзМассиваСлов(ДопКонтекстДляЦентраПоддержки.МассивОшибок, Символы.ПС));
		
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьДанныеФайловДляОтправкиВЦентрПоддержки_КонтурEDI(АдресФайлаОбработкиКлиент)
		
	Файлы = Новый Массив;
	
	РасположениеМодуля = ОпределитьРасположениеМодуля_КонтурEDI();
	ВариантыРасположенияМодуля = ПеречисленияEDI_ВариантыРасположенияМодуля();
	
	Если РасположениеМодуля = ВариантыРасположенияМодуля.Файл
			ИЛИ РасположениеМодуля = ВариантыРасположенияМодуля.Справочник Тогда
			
		Результат = ПолучитьДвоичныеДанныеФайлаМодуля_КонтурEDI(РасположениеМодуля, АдресФайлаОбработкиКлиент);
	
		Если Результат.Успешно Тогда
		
			ЗаполнитьСвойстваОбъектаФайл_КонтурEDI(Файлы,
												   Результат.ДвоичныеДанные,														
												   "КонтурEDI_Модуль.epf",
												    Истина);
													
		КонецЕсли;	
		
	ИначеЕсли РасположениеМодуля = ВариантыРасположенияМодуля.Расширение Тогда
		
		Результат = ПолучитьДвоичныеДанныеФайлаРасширенияКонфигурации_КонтурEDI(РасположениеМодуля);
		
		Если Результат.Успешно Тогда
			
			ЗаполнитьСвойстваОбъектаФайл_КонтурEDI(Файлы,
												   Результат.ДвоичныеДанные,
												   "КонтурEDI_РасширениеКонфигурации.cfe",
												    Истина);													
			
		КонецЕсли;
												
	КонецЕсли;
		
	Если ИспользуетсяПодключаемыйМодуль Тогда
		
		Результат = ПолучитьДвоичныеДанныеФайлаПодключаемыйМодуль_КонтурEDI();
	
		Если Результат.Успешно Тогда
			
			ЗаполнитьСвойстваОбъектаФайл_КонтурEDI(Файлы,
												   Результат.ДвоичныеДанные,
												   "КонтурEDI_ПодключаемыйМодуль.epf",
												    Истина);
			
		КонецЕсли;
	
	КонецЕсли;
	
	ТаблицаУстановленныхРасширений = ПолучитьИнформациюОбУстановленныхРасширениях();
	
	Если ТаблицаУстановленныхРасширений.Количество() Тогда
		
		Результат = ПолучитьДвоичныеДанныеФайлаАрхиваРасширенийМодуля_КонтурEDI(ТаблицаУстановленныхРасширений);
		
		Если Результат.Успешно Тогда
			
			ЗаполнитьСвойстваОбъектаФайл_КонтурEDI(Файлы,
												   Результат.ДвоичныеДанные,
												   "КонтурEDI_Расширения.zip",
												    Истина);	
			
		КонецЕсли;
		
		Результат = ПолучитьДвоичныеДанныеФайлаМетаданныхРасширенийМодуля_КонтурEDI(ТаблицаУстановленныхРасширений);
		
		Если Результат.Успешно Тогда
			
			ЗаполнитьСвойстваОбъектаФайл_КонтурEDI(Файлы,
												   Результат.ДвоичныеДанные,
												   "КонтурEDI_СписокРасширений.txt",
													Истина);
			
		КонецЕсли;
												
