		|	табСоответствий_СПометкойОсновных КАК табСоответствий_СПометкойОсновных
		|
		|СГРУППИРОВАТЬ ПО
		|	табСоответствий_СПометкойОсновных.Номенклатура,
		|	табСоответствий_СПометкойОсновных.ХарактеристикаНоменклатуры,
		|	табСоответствий_СПометкойОсновных.ЕдиницаИзмерения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	табСоответствий_СПометкойОсновных.Номенклатура КАК Номенклатура,
		|	табСоответствий_СПометкойОсновных.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	табСоответствий_СПометкойОсновных.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	табСоответствий_СПометкойОсновных.КодТовараСвой КАК КодТовараСвой,
		|	табСоответствий_СПометкойОсновных.НаименованиеПартнера КАК НаименованиеПартнера,
		|	табСоответствий_СПометкойОсновных.GTIN КАК GTIN,
		|	табСоответствий_СПометкойОсновных.КодТовараСторонний КАК КодТовараСторонний,
		|	табСоответствий_СПометкойОсновных.КодЕдиницыИзмеренияEDI КАК КодЕдиницыИзмеренияEDI,
		|	табСоответствий_СПометкойОсновных.КоэффициентEDIВ1С КАК КоэффициентEDIВ1С,
		|	табСоответствий_СПометкойОсновных.ТипЕдиницы КАК ТипЕдиницы,
		|	табСоответствий_СПометкойОсновных.ОсновноеСоответствие
		|ИЗ
		|	табСоответствий_СПометкойОсновных КАК табСоответствий_СПометкойОсновных
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОпределениеКоличестваСоответствий КАК ВТ_ОпределениеКоличестваСоответствий
		|		ПО табСоответствий_СПометкойОсновных.Номенклатура = ВТ_ОпределениеКоличестваСоответствий.Номенклатура
		|			И табСоответствий_СПометкойОсновных.ХарактеристикаНоменклатуры = ВТ_ОпределениеКоличестваСоответствий.ХарактеристикаНоменклатуры
		|			И табСоответствий_СПометкойОсновных.ЕдиницаИзмерения = ВТ_ОпределениеКоличестваСоответствий.ЕдиницаИзмерения
		|ГДЕ
		|	(табСоответствий_СПометкойОсновных.ХарактеристикаНоменклатурыИзСоответствия ЕСТЬ NULL
		|			ИЛИ ВЫБОР
		|				КОГДА ЕСТЬNULL(ВТ_ОпределениеКоличестваСоответствий.КоличествоХарактеристикСоответствия, 1) = 1
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ табСоответствий_СПометкойОсновных.ХарактеристикаНоменклатуры = табСоответствий_СПометкойОсновных.ХарактеристикаНоменклатурыИзСоответствия
		|			КОНЕЦ)";
		 				
	КонецЕсли;
	
	Если НЕ ЕстьМетаданныеТипЕдиницы Тогда
		ТекстЗапросаПоРегиструСоответствий = СтрЗаменить(ТекстЗапросаПоРегиструСоответствий, 
		"ЕСТЬNULL(КонтурEDI_СоответствияТоваров.ТипЕдиницы, """") КАК ТипЕдиницы", 
		"ВЫРАЗИТЬ("""" КАК СТРОКА(20)) КАК ТипЕдиницы");
	КонецЕсли;
	
	ТипХарактеристики = ПолучитьТипЗначенияОбъекта("ХарактеристикаНоменклатуры", Истина);  	
	
	Если ЗначениеЗаполнено(ТипХарактеристики) = Ложь Тогда 
		ТекстЗапросаПоРегиструСоответствий = 	СтрЗаменить(ТекстЗапросаПоРегиструСоответствий,
		"ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)",
		"Неопределено");
	Иначе 
		ТекстЗапросаПоРегиструСоответствий = СтрЗаменить(ТекстЗапросаПоРегиструСоответствий,
		"Справочник.ХарактеристикиНоменклатуры",
		ТипХарактеристики);
	КонецЕсли;
	
	Возврат ТекстЗапросаПоРегиструСоответствий;

КонецФункции

Процедура КонвертироватьТабличнуюЧастьСообщения1СвEDI(Сообщение,ИмяТабличнойЧасти)
	
	ТабличнаяЧастьСообщения = Сообщение[ИмяТабличнойЧасти];
	
	МетаданныеСообщения = ПолучитьМетаданныеСообщения(Сообщение.ТипСообщения,Сообщение.Направление);
	
	ОтборКонвертируемыхПолей = Новый Структура();
	ОтборКонвертируемыхПолей.Вставить("ИмяТаблицы", ИмяТабличнойЧасти);
	ОтборКонвертируемыхПолей.Вставить("Принадлежность", Неопределено);
	
	// отбираем поля, которые нужно конвертить
	КонвертируемыеПоля = МетаданныеСообщения.Скопировать(ОтборКонвертируемыхПолей);
	
	Если КонвертируемыеПоля.Количество()>0 Тогда
		
		НомерСтроки = 0;
		
		Для Каждого СтрокаТоваров ИЗ ТабличнаяЧастьСообщения Цикл
			
			НомерСтроки = НомерСтроки + 1;
			
			Если ИмяТабличнойЧасти = "Товары" 
				И Не ЗначениеЗаполнено(СтрокаТоваров.УИД_СтрокиТовара) Тогда
				
				СтрокаТоваров.УИД_СтрокиТовара = УИД_СтрокиТовара_КонтурEDI(НомерСтроки, Сообщение.ТипСообщения);
				
			КонецЕсли; 
			
			Если ИмяТабличнойЧасти = "Товары" 
				И Не ЗначениеЗаполнено(СтрокаТоваров.УИД_СтрокиПервоначальногоСообщения) Тогда
				
				СтрокаТоваров.УИД_СтрокиПервоначальногоСообщения = СтрокаТоваров.УИД_СтрокиТовара;
				
			КонецЕсли;
			
			Для Каждого ПолеТоваров ИЗ КонвертируемыеПоля Цикл
				
				Если ПолеТоваров.ВидСтруктурыEDI = Неопределено Тогда
					ТипEDI = ПолеТоваров.ТипEDI;
				Иначе
					ТипEDI = ПолеТоваров.ВидСтруктурыEDI;
				КонецЕсли;
				
				РезультатКонвертации = КонвертироватьЗначение1СвEDI(СтрокаТоваров[ПолеТоваров.ИмяПоля+"1С"],ПолеТоваров.Тип1С,ТипEDI,Сообщение);
				
				Если НЕ РезультатКонвертации = Неопределено Тогда
					
					Если Не ЗначениеЗаполнено(СтрокаТоваров[ПолеТоваров.ИмяПоля + "EDI"]) Тогда//можно отдельный костыль на КодЕдиницыИзмерения. Проверить тип поля (edi/1c) в метаданных.
						СтрокаТоваров[ПолеТоваров.ИмяПоля + "EDI"] = РезультатКонвертации;
					КонецЕсли;               
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьТаблицуТоваровИсходногоСообщения_КонтурEDI(ИсходноеСообщение) Экспорт
	
	МассивИсключительныхСообщений = Новый Массив;
	МассивИсключительныхСообщений.Добавить("DELFOR");
	
	// ... получить таблицу
	ЕстьТоварыВИсходномСообщении = 
	ТипЗнч(ИсходноеСообщение) = Тип("Структура")
	И ПеременнаяСодержитСвойство(ИсходноеСообщение, "ТипСообщения") 
	И МассивИсключительныхСообщений.Найти(ИсходноеСообщение.ТипСообщения) = Неопределено 
	И ПеременнаяСодержитСвойство(ИсходноеСообщение, "Товары");
	 	
	Если ЕстьТоварыВИсходномСообщении Тогда
		
		ТаблицаТоваровВходящегоСообщения = ИсходноеСообщение.Товары;
		
	Иначе
		
		ТаблицаТоваровВходящегоСообщения = Новый ТаблицаЗначений;	
		
		ТипСтрока500 = ОписаниеТипаСтрока_КонтурEDI(500);
		
		ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваровВходящегоСообщения, 
		"Номенклатура,ХарактеристикаНоменклатуры,ЕдиницаИзмерения", ТипСтрока500);
				
	КонецЕсли; 
	
	ДобавитьИТипизироватьКолонкиТаблицыТоваровИсходногоСообщения(ТаблицаТоваровВходящегоСообщения);  
		
	ДополнитьДаннымиТаблицуТоваровИсходногоСообщения(ИсходноеСообщение, ТаблицаТоваровВходящегоСообщения);
	
	Возврат ТаблицаТоваровВходящегоСообщения;	
	
КонецФункции

Процедура ДополнитьДаннымиТаблицуТоваровИсходногоСообщения(ИсходноеСообщение, ТаблицаТоваровВходящегоСообщения)
	
	СохранитьТаблицуТоваровВходящегоСообщениям = Ложь;
	
	НомерСтроки = 0;
	
	Для Каждого СтрВходящего Из ТаблицаТоваровВходящегоСообщения Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		// ... сколько не сопоставлено
		Если СтрВходящего.Количество = 0 
			И ЕстьКолонкаСтрокиТаблицы_КонтурEDI(СтрВходящего, "КоличествоПосле") 
			И СтрВходящего.КоличествоПосле <> 0 Тогда
			
			СтрВходящего.КоличествоНеСопоставлено = СтрВходящего.КоличествоПосле;
			СтрВходящего.Количество = СтрВходящего.КоличествоПосле;
			
		Иначе
			
			СтрВходящего.КоличествоНеСопоставлено = СтрВходящего.Количество;
			
		КонецЕсли;
		
		// ... уид строки
		Если Не ЗначениеЗаполнено(СтрВходящего.УИД_СтрокиТовара) Тогда
			
			СтрВходящего.УИД_СтрокиТовара = УИД_СтрокиТовара_КонтурEDI(НомерСтроки, ИсходноеСообщение.ТипСообщения);
					
			СохранитьТаблицуТоваровВходящегоСообщениям = Истина;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрВходящего.УИД_СтрокиПервоначальногоСообщения) Тогда 			
			СтрВходящего.УИД_СтрокиПервоначальногоСообщения = СтрВходящего.УИД_СтрокиТовара;			
		КонецЕсли;
		
		// ... другие реквизиты
		ДругиеРеквизиты = "";
		
		Если ЕстьКолонкаСтрокиТаблицы_КонтурEDI(СтрВходящего, "КодТовараВнутренний") Тогда
			ДругиеРеквизиты = ДругиеРеквизиты + "код вн.: " + СтрВходящего.КодТовараВнутренний + ";";
		КонецЕсли;
		
		Если ЕстьКолонкаСтрокиТаблицы_КонтурEDI(СтрВходящего, "КонечныйГрузополучательGLN") Тогда
			ДругиеРеквизиты = ДругиеРеквизиты + "кон. груз-ль.: " + СтрВходящего.КонечныйГрузополучательGLN + ";";
		КонецЕсли;
		
		СтрВходящего.ДругиеРеквизиты = ДругиеРеквизиты;
		
		// ... конвертация
		Если Не ЗначениеЗаполнено(СтрВходящего.УИД_СтрокиПредыдущегоСообщения)
			И ЕстьКолонкаСтрокиТаблицы_КонтурEDI(СтрВходящего, "УИД_СтрокиТовара_ВходящегоСообщения")
			И ЗначениеЗаполнено(СтрВходящего.УИД_СтрокиТовара_ВходящегоСообщения) Тогда
			
			СтрВходящего.УИД_СтрокиПредыдущегоСообщения = СтрВходящего.УИД_СтрокиТовара_ВходящегоСообщения;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// ... сохранить для сохранения УИД_СтрокиТовара
	Если ТипЗнч(ИсходноеСообщение) = Тип("Структура") И СохранитьТаблицуТоваровВходящегоСообщениям Тогда
		
		ИсходноеСообщение.Товары = ТаблицаТоваровВходящегоСообщения.Скопировать();
		СохранитьСообщение(ИсходноеСообщение, ИсходноеСообщение.СтатусСсылки);
		
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьИТипизироватьКолонкиТаблицыТоваровИсходногоСообщения(ТаблицаТоваровВходящегоСообщения)
		
	ТипСтрока500	= ОписаниеТипаСтрока_КонтурEDI(500);
	ТипСтрока1000	= ОписаниеТипаСтрока_КонтурEDI(1000);
	ТипСтрока50		= ОписаниеТипаСтрока_КонтурEDI(50);
	ТипСтрока256	= ОписаниеТипаСтрока_КонтурEDI(256);
	
	ТипЧисло		= ОписаниеТипаЧисло_КонтурEDI();
	ТипЧисло_15_3	= ОписаниеТипаЧисло_КонтурEDI(15, 3);
	
	// ... добавить ключевые колонки	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваровВходящегоСообщения, 
	"GTIN,КодТовараПокупателя,КодТовараПоставщика,КодТовараВнутренний", ТипСтрока50);
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваровВходящегоСообщения, 
	"УИД_СтрокиПредыдущегоСообщения", ТипСтрока256);
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваровВходящегоСообщения, 
	"УИД_СтрокиПервоначальногоСообщения", ТипСтрока256);
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваровВходящегоСообщения, 
	"Количество", ТипЧисло_15_3);
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваровВходящегоСообщения, 
	"ЦенаСНДС,ЦенаБезНДС", ТипЧисло_15_3); 
	
	// ... типизировать колонки 
	ТипизироватьКолонку_Номенклатура(ТаблицаТоваровВходящегоСообщения);
	ТипизироватьКолонку_ЕдиницаИзмерения(ТаблицаТоваровВходящегоСообщения);
	ТипизироватьКолонку_Характеристика(ТаблицаТоваровВходящегоСообщения);
	ТипизироватьКолонку_СерияНоменклатуры(ТаблицаТоваровВходящегоСообщения);
	
	// ... дополнить колонками и данными для сопоставления
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваровВходящегоСообщения, 
	"Наименование", ТипСтрока1000);
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваровВходящегоСообщения, 
	"КодЕдиницыИзмеренияEDI", ТипСтрока50);
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваровВходящегоСообщения, 
	"ДругиеРеквизиты", ТипСтрока1000);
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваровВходящегоСообщения, 
	"КоличествоНеСопоставлено", ТипЧисло);
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваровВходящегоСообщения, 
	"УИД_СтрокиТовара", ТипСтрока50);

КонецПроцедуры 

Функция ПолучитьТаблицуТоваровИсходногоСообщенияCOINVOIC_КонтурEDI(МассивПредыдущихINVOIC_COINVOIC) Экспорт
	
	ТаблицаТоваровВходящегоСообщения = ТаблицаТоваровИсходногоСообщенияCOINVOIC();
	
	ЗаполнитьТаблицуТоваровИсходногоСообщенияCOINVOIC(МассивПредыдущихINVOIC_COINVOIC, ТаблицаТоваровВходящегоСообщения);
	
	Возврат ТаблицаТоваровВходящегоСообщения;	
	
КонецФункции

Процедура ЗаполнитьТаблицуТоваровИсходногоСообщенияCOINVOIC( МассивПредыдущихINVOIC_COINVOIC, ТаблицаТоваровВходящегоСообщения)
		
	Для Каждого ИсходноеСообщение Из МассивПредыдущихINVOIC_COINVOIC Цикл
		
		Если ИсходноеСообщение.ТипСообщения = "INVOIC" Тогда
			ТаблицаТоваровВходящегоСообщения.Очистить();
		КонецЕсли;
		
		СохранитьТаблицуТоваровВходящегоСообщениям = Ложь;
		
		НомерСтроки = 0;
		
		Для Каждого СтрокаТовары Из ИсходноеСообщение.Товары Цикл 
			
			НомерСтроки = НомерСтроки + 1;
			
			Если ПеременнаяСодержитСвойство(СтрокаТовары, "Количество") Тогда 				
				Количество_СтрокаТовары = СтрокаТовары.Количество;			
			ИначеЕсли ПеременнаяСодержитСвойство(СтрокаТовары, "КоличествоПосле") 
				И СтрокаТовары.КоличествоПосле <> 0 Тогда  
				Количество_СтрокаТовары = СтрокаТовары.КоличествоПосле; 				
			Иначе 			
				Количество_СтрокаТовары = 0;
			КонецЕсли;
			
			КоличествоДо_СтрокаТовары = 0;
			Если ПеременнаяСодержитСвойство(СтрокаТовары, "КоличествоДо") Тогда
				КоличествоДо_СтрокаТовары = СтрокаТовары.КоличествоДо;
			КонецЕсли;
			
			Если ИсходноеСообщение.ТипСообщения = "COINVOIC" Тогда
				
				Если ЗначениеЗаполнено(СтрокаТовары.УИД_СтрокиПредыдущегоСообщения) Тогда
					Поиск = Новый Структура;
					Поиск.Вставить("УИД_СтрокиТовара", СтрокаТовары.УИД_СтрокиПредыдущегоСообщения);  
				Иначе
					Поиск = Новый Структура;
					Поиск.Вставить("GTIN", СтрокаТовары.GTIN); 
					Поиск.Вставить("КодТовараПокупателя", СтрокаТовары.КодТовараПокупателя);
				КонецЕсли;
								
			Иначе
				
				Поиск = Новый Структура;
				Поиск.Вставить("УИД_СтрокиТовара", СтрокаТовары.УИД_СтрокиТовара);
				
			КонецЕсли;
			
			НайденныеСтроки = ТаблицаТоваровВходящегоСообщения.НайтиСтроки(Поиск); 
			
			Если НайденныеСтроки.Количество() = 0 Тогда
				СтрВходящего = Неопределено;
			Иначе
				СтрВходящего = НайденныеСтроки[0];
			КонецЕсли;
			
			Если СтрВходящего = Неопределено Тогда
				
				СтрВходящего = ТаблицаТоваровВходящегоСообщения.Добавить();
				ЗаполнитьЗначенияСвойств(СтрВходящего, СтрокаТовары);
				
				СтрВходящего.Количество = 0;
				СтрВходящего.КоличествоДо = КоличествоДо_СтрокаТовары;
				СтрВходящего.КоличествоНачало = Количество_СтрокаТовары; 
				
			Иначе
				
				СтрВходящего.КоличествоДо = СтрВходящего.Количество;
				
			КонецЕсли;
			
			СтрВходящего.Количество = СтрВходящего.Количество - (КоличествоДо_СтрокаТовары - Количество_СтрокаТовары);
			
			// ... сколько не сопоставлено
			СтрВходящего.КоличествоНеСопоставлено = СтрВходящего.КоличествоНачало;
			
			// ... уид строки
			Если Не ЗначениеЗаполнено(СтрВходящего.УИД_СтрокиТовара) Тогда
				
				СтрВходящего.УИД_СтрокиТовара = УИД_СтрокиТовара_КонтурEDI(НомерСтроки, ИсходноеСообщение.ТипСообщения);
							
				СтрокаТовары.УИД_СтрокиТовара = СтрВходящего.УИД_СтрокиТовара;
				СохранитьТаблицуТоваровВходящегоСообщениям = Истина;
				
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(СтрВходящего.УИД_СтрокиПервоначальногоСообщения) Тогда 			
				СтрВходящего.УИД_СтрокиПервоначальногоСообщения = СтрВходящего.УИД_СтрокиТовара;			
			КонецЕсли;
			
			// ... другие реквизиты
			ДругиеРеквизиты = "";
			
			Если ПеременнаяСодержитСвойство(СтрокаТовары, "КодТовараВнутренний") Тогда
				СтрВходящего.КодТовараВнутренний = СтрокаТовары.КодТовараВнутренний;
				ДругиеРеквизиты = ДругиеРеквизиты + "код вн.: " + СтрВходящего.КодТовараВнутренний + ";";
			КонецЕсли;
			
			Если ПеременнаяСодержитСвойство(СтрВходящего, "КонечныйГрузополучательGLN") Тогда
				ДругиеРеквизиты = ДругиеРеквизиты + "кон. груз-ль.: " + СтрВходящего.КонечныйГрузополучательGLN + ";";
			КонецЕсли;
			
			СтрВходящего.ДругиеРеквизиты = ДругиеРеквизиты;
			
			// ... конвертация
			Если Не ЗначениеЗаполнено(СтрВходящего.УИД_СтрокиПредыдущегоСообщения)
				И ПеременнаяСодержитСвойство(СтрВходящего, "УИД_СтрокиТовара_ВходящегоСообщения")
				И ЗначениеЗаполнено(СтрВходящего.УИД_СтрокиТовара_ВходящегоСообщения) Тогда
				
				СтрВходящего.УИД_СтрокиПредыдущегоСообщения = СтрВходящего.УИД_СтрокиТовара_ВходящегоСообщения;
				
			КонецЕсли;
			
			// ... коды маркировки
			ИсходныеКодыМаркировки = Неопределено;
			
			Если ПеременнаяСодержитСвойство(СтрокаТовары, "КодыМаркировки", ИсходныеКодыМаркировки)
				Или ПеременнаяСодержитСвойство(СтрокаТовары, "КодыМаркировкиПосле", ИсходныеКодыМаркировки) Тогда
				СтрВходящего.КодыМаркировки = ИсходныеКодыМаркировки;
			КонецЕсли;
				
		КонецЦикла;
		
		// ... сохранить для сохранения УИД_СтрокиТовара
		Если ТипЗнч(ИсходноеСообщение) = Тип("Структура") И СохранитьТаблицуТоваровВходящегоСообщениям Тогда
			
			СохранитьСообщение(ИсходноеСообщение, ИсходноеСообщение.СтатусСсылки);
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Функция ТаблицаТоваровИсходногоСообщенияCOINVOIC()
	
	ТипСтрока500	= ОписаниеТипаСтрока_КонтурEDI(500);
	ТипСтрока1000	= ОписаниеТипаСтрока_КонтурEDI(1000);
	ТипСтрока50		= ОписаниеТипаСтрока_КонтурEDI(50);
	ТипСтрока256	= ОписаниеТипаСтрока_КонтурEDI(256);
	
	ТипЧисло		= ОписаниеТипаЧисло_КонтурEDI();
	ТипЧисло_15_3	= ОписаниеТипаЧисло_КонтурEDI(15, 3);
	
	// ... добавить ключевые колонки	
	ТаблицаТоваровВходящегоСообщения = Новый ТаблицаЗначений;		
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваровВходящегоСообщения, 
	"Номенклатура,ХарактеристикаНоменклатуры,СерияНоменклатуры,ЕдиницаИзмерения", ТипСтрока500); 
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваровВходящегоСообщения, 
	"GTIN,КодТовараПокупателя,КодТовараПоставщика,КодТовараВнутренний", ТипСтрока500);
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваровВходящегоСообщения, 
	"УИД_СтрокиПредыдущегоСообщения", ТипСтрока256);
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваровВходящегоСообщения, 
	"УИД_СтрокиПервоначальногоСообщения", ТипСтрока256);
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваровВходящегоСообщения, 
	"Количество,КоличествоДо,КоличествоНачало", ТипЧисло_15_3);
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваровВходящегоСообщения, 
	"ЦенаСНДС,ЦенаБезНДС", ТипЧисло_15_3); 
	
	// ... типизировать колонки 
	ТипизироватьКолонку_Номенклатура(ТаблицаТоваровВходящегоСообщения);
	ТипизироватьКолонку_ЕдиницаИзмерения(ТаблицаТоваровВходящегоСообщения);
	ТипизироватьКолонку_Характеристика(ТаблицаТоваровВходящегоСообщения);
	ТипизироватьКолонку_СерияНоменклатуры(ТаблицаТоваровВходящегоСообщения);
	
	// ... дополнить колонками и данными для сопоставления
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваровВходящегоСообщения, "КодЕдиницыИзмеренияEDI", ТипСтрока50);
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваровВходящегоСообщения, 
	"ДругиеРеквизиты,Наименование", ТипСтрока1000);
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваровВходящегоСообщения, 
	"КоличествоНеСопоставлено",ТипЧисло);
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваровВходящегоСообщения, 
	"УИД_СтрокиТовара", ТипСтрока50);
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваровВходящегоСообщения,
	"КодыМаркировки", Новый ОписаниеТипов("СписокЗначений"));
	
	Возврат ТаблицаТоваровВходящегоСообщения;

КонецФункции 
//}}}

// Установка соответствий

Процедура УстановитьСоответствиеПоляШапки(Значение1С, ЗначениеEDI, Тип1С, ТипEDI, Партнер = Неопределено) Экспорт
	
	Если ТипEDI = "ЮрФизЛицо" Тогда
		
		Если ЗначениеЗаполнено(ЗначениеEDI.GLN) И ЗначениеЗаполнено(Значение1С) Тогда
			
			Если Тип1С = "ТочкаДоставкиСторонняя" Тогда
				
				УстановитьGLN(Значение1С,"GLN_ТочкиДоставки",ЗначениеEDI.GLN);
				
			ИначеЕсли Тип1С = "ЮрФизЛицоСвое" Тогда
				
				УстановитьGLN(Значение1С,"GLN_Организации",ЗначениеEDI.GLN);
				
			ИначеЕсли Тип1С = "ЮрФизЛицоСтороннее" Тогда
				
				УстановитьGLN(Значение1С,"GLN_Контрагента",ЗначениеEDI.GLN);
				УстановитьЗначениеСвойстваОбъекта(Значение1С, "ПартнерКонтрагента", ПреобразоватьЗначениеДляВнешнегоХранилища(Партнер));
				УстановитьКонстантуEDI("ДатаВремяОбновленияПартнеровКонтрагентов", Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss"));
				
			ИначеЕсли Тип1С = "ТочкаДоставкиСвоя" Тогда
				
				УстановитьGLN(Значение1С,"GLN_НашейТочкиДоставки",ЗначениеEDI.GLN);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	//	Сообщить("Устанавливается соответствие между "+Тип1С+" и "+ТипEDI+": "+СокрЛП(Значение1С)+" и "+СокрЛП(ЗначениеEDI));
	
КонецПроцедуры

//После чтения XDTO, но перед конвертацией в 1С
Процедура ПередОбработкойВходящегоСообщения(СтруктураПараметров)
	
	Сообщение = СтруктураПараметров.Сообщение;
	Если Сообщение.ТипСообщения = "DELFOR" И 
		(Сообщение.ТипDELFOR <> "Schedule" И Сообщение.ТипDELFOR <> "Response") Тогда
		
		СтруктураПараметров.ПрекратитьЗагрузкуСообщения = Истина;
		
	КонецЕсли;
	
	СтандартнаяОбработкаEDI = Истина;
	
	ОбработкаСобытияПодключаемогоМодуля("ПередОбработкойВходящегоСообщения", СтандартнаяОбработкаEDI, СтруктураПараметров);
	
	Если СтандартнаяОбработкаEDI = Ложь Или СтруктураПараметров.ПрекратитьЗагрузкуСообщения = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если Сообщение.ТипСообщения = "ORDERS" Тогда
		ТочкаДоставки = КонвертироватьЗначениеEDIв1С(Сообщение.ГрузополучательEDI, "ЮрФизЛицо", "ТочкаДоставкиСторонняя", Сообщение);
		
		Если ТочкаДоставки = Неопределено И МожноАвтоматическиДобавитьТочкуДоставки(Сообщение) Тогда
			ЗаписатьТочкуДоставкиВСправочник(Сообщение);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

//Обрабатывает уже распарсенное в Структуру входящее сообщение.
//Возвращает признак: можно ли удалять сообщение с FTP/каталога.
//Здесь же хорошо бы возвращать и признак, надо ли отправлять еще какие-то статусные в ответ: read_ok, checking_fail
Функция ОбработатьВходящееСообщение(Сообщение) Экспорт
	
	СтруктураВозврата = ИнициализироватьСтруктуруРезультатаФункции();
	СтруктураВозврата.Вставить("МожноУдалятьСообщение",				Ложь);
	СтруктураВозврата.Вставить("СохранятьСообщениеВБазу",			Ложь);
	СтруктураВозврата.Вставить("ОтправитьУведомлениеОПрочтении",	Ложь);//это на будущее
	СтруктураВозврата.Вставить("ОтправитьУведомлениеОВалидации",	Ложь);//это на будущее
	
	ТипСообщения = Сообщение.ТипСообщения;//вытащим поближе, много где надо
	
	Если ТипСообщения = "reports" Тогда
		//быстро обработаем и выйдем
		Результат = ОбработатьСтатусноеСообщение(Сообщение);
		СтруктураВозврата.МожноУдалятьСообщение = Результат.МожноУдалятьСообщение;
		Возврат СтруктураВозврата;
	КонецЕсли;	
	
	КонвертироватьСообщениеEDIв1С(Сообщение,Истина); // добавим пометку что дополнять структуру не нужно, она свежая
	
	//пропустим через фильтры: партнеры, точки доставки, существование в базе сообщения с таким ID
	//возможно, СообщениеСсылка заполнять по ID в блоке конвертации. Хотя как с виртуальными ORDERS будет, непонятно
	ПроверитьНеобходимостьЗагрузкиСохраненияСообщения(Сообщение,СтруктураВозврата);
	
	//Возможность переопределить результаты проверки через подключаемый модуль. Например, в центральной базе не надо загружать ORDRSP на определенные заказы.
	ОбработкаСобытияПодключаемогоМодуля("ПроверитьНеобходимостьЗагрузкиСохраненияСообщения",,Новый Структура("Сообщение,СтруктураВозврата",Сообщение,СтруктураВозврата));
	
	Если НЕ СтруктураВозврата.СохранятьСообщениеВБазу Тогда
		Возврат СтруктураВозврата;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		//запишем в базу.
		СохранитьСообщение(Сообщение);
		
		// редко, но возможно сохранение одного и того же сообщения в разных сессиях, проверим 
		Если НЕ ПроверитьОтсутствиеДублейВходящегоСообщения(Сообщение.ID) Тогда
			ВызватьИсключение "При выполнении обмена несколькими пользователями возникла одновременная загрузка сообщения: " + Сообщение.ID;
		КонецЕсли;
		
		СтруктураВозврата.Вставить("Сообщение",Сообщение);
		////провалидируем, создадим документы и т.д.
		//ДействияПослеСохраненияСообщения(Сообщение,СтруктураВозврата);
		
		СтруктураВозврата.МожноУдалятьСообщение = Истина;//скажем вышестоящей функции, чтоб удаляла сообщение, мы тут все закончили
		
		Если ТранзакцияАктивна() Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
		
	Исключение
		
	    Если ТранзакцияАктивна() Тогда
	        ОтменитьТранзакцию();
		КонецЕсли;
		
		ТекстОшибки = "Не удалось обработать входящее сообщение - " + ТипСообщения + " - " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки); 
		ВызватьИсключение ТекстОшибки;
		
	КонецПопытки;	
	
	Возврат СтруктураВозврата;
	
КонецФункции	

//Берет Сообщение, проверяет его Партнера, ТочкуДоставки и ID
//В СтруктураВозврата меняет 2 параметра: МожноУдалятьСообщение и СохранятьСообщениеВБазу
//Первый влияет на то, будет ли исходный файл удален с FTP
//Второй показывает, будем ли мы сохранять данное сообщение в базу
Процедура ПроверитьНеобходимостьЗагрузкиСохраненияСообщения(Сообщение,СтруктураВозврата)
	
	СтруктураВозврата.СохранятьСообщениеВБазу = Истина;
	
	//Проверим, есть ли у нас сообщение с этим ID в базе. Если есть, то повторно загружать не будем, но с FTP удалим.
	Если СтруктураВозврата.СохранятьСообщениеВБазу Тогда
		//Проверим, вдруг такое сообщение у нас уже было - найдем по ID
		Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	1 КАК Поле1
		|ИЗ
		|	Справочник.КонтурEDI_Сообщения КАК Таб
		|ГДЕ
		|	Таб.ID = &ID
		|
		|ДЛЯ ИЗМЕНЕНИЯ
		|	Справочник.КонтурEDI_Сообщения";
		Запрос.УстановитьПараметр("ID",Сообщение.ID);
		СообщениеСуществует = Не Запрос.Выполнить().Пустой();
		Если СообщениеСуществует Тогда
			СтруктураВозврата.МожноУдалятьСообщение = Истина;
			СтруктураВозврата.СохранятьСообщениеВБазу = Ложь;
			Возврат;
		КонецЕсли;	
		
	КонецЕсли;	
	
	//Проверим, разрешено ли нам принимать сообщения по данному партнеру.
	Если ПараметрыПользователяEDI.ФильтрОбменаПоСетям = Истина Тогда
		
		Если НЕ ЗначениеЗаполнено(Сообщение.Партнер) Тогда
			Сообщение.Партнер = КонвертироватьЗначениеEDIв1С(Сообщение["ОтправительEDI"],"УчастникОбмена","ПодразделениеСтороннее",Сообщение);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Сообщение.Партнер) Тогда
			//мы не знаем эту торговую сеть, перейдем к следующему сообщению.
			СтруктураВозврата.МожноУдалятьСообщение = Ложь;
			СтруктураВозврата.СохранятьСообщениеВБазу = Ложь;
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	//Проверим фильтр по точкам доставки
	Если СтруктураВозврата.СохранятьСообщениеВБазу 
		И ПараметрыПользователяEDI.ФильтрОбменаПоТочкамДоставки = Истина 
		И ОпределитьКемМыЯвляемся(Сообщение) = "Поставщик" Тогда
		
		СтруктураВозврата.МожноУдалятьСообщение = Ложь;
		СтруктураВозврата.СохранятьСообщениеВБазу = Ложь;
		
		ТекТочкаДоставки = ПолучитьЭлементСправочника("ТочкиДоставкиСторонние", Сообщение.ТочкаДоставки);
		//на рефакторинг: тут достаточно получить одну единственную настройку.
		//или просто собрать GLN всех точек доставки, по которым мы загружаем сообщения.
		
		Если ЗначениеЗаполнено(ТекТочкаДоставки) 
			И ТипЗнч(ТекТочкаДоставки) = Тип("Структура") 
			И ТекТочкаДоставки.Свойство("ЗагружатьСообщенияПоТочкеДоставки") 
			И ТекТочкаДоставки.ЗагружатьСообщенияПоТочкеДоставки = Истина 
		Тогда
			СтруктураВозврата.МожноУдалятьСообщение = Истина;
			СтруктураВозврата.СохранятьСообщениеВБазу = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	// ... проверить на дубли
	ПоверитьНаДубльСообщения_ПередЗагрузкой(Сообщение, СтруктураВозврата);   
	
КонецПроцедуры

Процедура ПоверитьНаДубльСообщения_ПередЗагрузкой(Сообщение, СтруктураВозврата)
	
	// Найти такое же сообщение по дате/номеру заказа в пределах партнера
	// необходимо для проверки существования полных дублей сообщения (совпадает номер, партнер, дата поставки, товары)
	Если НЕ (СтруктураВозврата.СохранятьСообщениеВБазу
		И Сообщение.Направление = "Входящее") Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если Сообщение.ТипСообщения = "ORDERS" Тогда
		
		Статусы = Новый Массив;
		Статусы.Добавить("canceled");
		Статусы.Добавить("отменен");
		Статусы.Добавить("отмена");
		Статусы.Добавить("replace");
		
		ПроверкаНаСтатус = 
		Статусы.Найти(НРег(Сообщение.Статус)) = Неопределено;
		
		НайтиДубль = 
		ПроверкаНаСтатус 
		И НЕ (ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, "ПереотправлятьORDRSP_НаКаждуюВерсию") = Истина);
		
	ИначеЕсли Сообщение.ТипСообщения = "RECADV" Тогда
		
		НайтиДубль = Истина;
		
	Иначе
		
		НайтиДубль = Ложь;
		
	КонецЕсли;
	
	Если НайтиДубль Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ТаблицаСообщений.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурEDI_Сообщения КАК ТаблицаСообщений
		|ГДЕ
		|	ТаблицаСообщений.ТипСообщения = &ТипСообщения
		|	И ТаблицаСообщений.Направление = ""Входящее""
		|	И ТаблицаСообщений.НомерДокумента = &НомерСообщения
		|	И ТаблицаСообщений.Партнер = &Партнер
		|	И ТаблицаСообщений.ДатаДокумента МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаСообщения, МЕСЯЦ, -6) И &ДатаСообщения
		|
		|УПОРЯДОЧИТЬ ПО
		|	ТаблицаСообщений.ДатаДокумента УБЫВ,
		|	ТаблицаСообщений.ДатаЗагрузки УБЫВ,
		|	Ссылка УБЫВ";
		
		Если ДлительнаяОперация = Истина Тогда
			Запрос = КэшДлительнойОперации.Получить("КэшЗапросаДублейСообщений");
		Иначе
			Запрос = Неопределено;
		КонецЕсли;	
		
		Если Запрос = Неопределено Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = ТекстЗапроса;
			
			Если ДлительнаяОперация = Истина Тогда
				КэшДлительнойОперации.Вставить("КэшЗапросаДублейСообщений",Запрос);
			КонецЕсли;
			
		КонецЕсли; 
		
		Запрос.УстановитьПараметр("НомерСообщения",	Сообщение.ДокументEDI.Номер);
		Запрос.УстановитьПараметр("Партнер",		Сообщение.Партнер);
		Запрос.УстановитьПараметр("ДатаСообщения",	Сообщение.ДокументEDI.Дата);
		Запрос.УстановитьПараметр("ТипСообщения",	Сообщение.ТипСообщения);
		
		Выб = Запрос.Выполнить().Выбрать();
		
		Если Выб.Следующий() Тогда
			
			СообщениеСсылка = Выб.Ссылка;	
			ПоследнееСообщение = ПрочитатьСообщение(СообщениеСсылка,,, "Входящее");
			
			Если ПоследнееСообщение <> Неопределено 
				И Сообщение.ТипСообщения = ПоследнееСообщение.ТипСообщения Тогда
				
				КонвертироватьСообщениеEDIв1С(ПоследнееСообщение);
				
				_ПоляСравнения = EDI_РазложитьСтрокуВМассивСлов("ДатаПоставки,ДатаОтгрузки,ТочкаДоставки,ЭтоПредварительныйЗаказ",",");
				
				СообщенияСовпадают = СравнитьСообщения(ПоследнееСообщение, Сообщение, _ПоляСравнения, Ложь);
				
				Если СообщенияСовпадают Тогда
					
					СтруктураВозврата.МожноУдалятьСообщение = Истина;
					СтруктураВозврата.СохранятьСообщениеВБазу = Ложь;
					
				КонецЕсли;
				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

Функция МожноПринятьВходящееСообщение(Сообщение,ПервоначальнаяЗагрузкаСообщения)
	
	// проверяем, не успел ли кто-то другой создать документ
	ПроверятьНаличиеДокумента = Ложь;
	
	Если ПервоначальнаяЗагрузкаСообщения Тогда
		
		Если Сообщение.ТипСообщения = "ORDERS" Тогда
			
			Если НЕ (Сообщение.Свойство("ОбратныйЗаказEDI") И 
				ЗначениеЗаполнено(Сообщение.ОбратныйЗаказEDI.Номер) И 
				ЗначениеЗаполнено(Сообщение.ОбратныйЗаказ1С)) Тогда
				
				ПроверятьНаличиеДокумента = Истина;	
			КонецЕсли;
			
		ИначеЕсли Сообщение.ТипСообщения = "DESADV" Тогда
			
			Если ПолучитьТипЗначенияОбъекта("ИсходящийЗаказПоставщику",,Истина) = ПолучитьТипЗначенияОбъекта("ВходящееУведомлениеОбОтгрузке",,Истина) Тогда 
				ПроверятьНаличиеДокумента = Ложь; //документ уже будет в справочнике и мы ему будем перезаполнять ТЧ.
			Иначе
				ПроверятьНаличиеДокумента = Истина;	
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;	
	
	Если ПроверятьНаличиеДокумента Тогда
		
		ИД = СокрЛП(Сообщение.ID);
		
		Если ЗначениеЗаполнено(ИД) Тогда
			
			Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
			
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КонтурEDI_Сообщения.Документ
			|ИЗ
			|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
			|ГДЕ
			|	КонтурEDI_Сообщения.ID = &ID
			|	И КонтурEDI_Сообщения.Направление = ""Входящее""";
			
			Запрос.УстановитьПараметр("ID",ИД);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Если РезультатЗапроса.Пустой() Тогда
				
				НайденныйДокумент = Неопределено;
				
			Иначе
				
				Выборка = РезультатЗапроса.Выбрать();
				Выборка.Следующий();
				
				НайденныйДокумент = Выборка.Документ;
				
			КонецЕсли;
						
			Если НЕ (Сообщение.Свойство("ОбратныйЗаказ1С") И ЗначениеЗаполнено(Сообщение.ОбратныйЗаказ1С) И Сообщение.ОбратныйЗаказ1С = НайденныйДокумент) Тогда
				Если ЗначениеЗаполнено(НайденныйДокумент) Тогда
					Возврат Ложь;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;	
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПринятьБезДокумента(Сообщение)

	МожноПринятьБезДокумента = 
	Сообщение.ТипСообщения = "PRICELIST"
	ИЛИ Сообщение.ТипСообщения = "PRICAT";
	
	Возврат МожноПринятьБезДокумента;

КонецФункции // МожноПринятьБезДокумента()


//Обработка входящего сообщения: создание документа в 1С, смена статусов и т.д.
Функция ПринятьВходящееСообщение(Сообщение,ПервоначальнаяЗагрузкаСообщения = Истина, ИнтерактивнаяОбработка = Ложь) Экспорт
	
	//чистка кэша таблицы связанных документов-сообщений
	//могли случится манипуляции по связям текущего документа. -  ПолучитьТаблицуСвязанныхДокументовПоТипамСообщений, в таком случае может достать из кэша неактуальные данные
	ЭДО_Кэш_Поместить("КэшТаблицыСвязанныхДокументовПоТипамСообщений",неопределено);
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Успешно",	Ложь);
	СтруктураВозврата.Вставить("Документ",	Неопределено);
	
	Если НЕ МожноПринятьВходящееСообщение(Сообщение,ПервоначальнаяЗагрузкаСообщения) Тогда
		Возврат СтруктураВозврата;
	КонецЕсли;
	
	СообщениеОбъект = Неопределено;
	
	Если ЗначениеЗаполнено(Сообщение.СообщениеСсылка) Тогда
		СообщениеОбъект = Сообщение.СообщениеСсылка.ПолучитьОбъект();
	КонецЕсли;
	
	Если Не СообщениеОбъект = Неопределено Тогда
		Попытка
			СообщениеОбъект.Заблокировать();
		Исключение
			
			ТекстОшибки = "Не удалось заблокировать сообщение - " + СообщениеОбъект.ТипСообщения + " Номер: " + СообщениеОбъект.НомерДокумента + " от " + СообщениеОбъект.ДатаДокумента + "
						  |" + ОписаниеОшибки();
			Сообщить_КонтурEDI(ТекстОшибки);
			
			Возврат СтруктураВозврата;
			
		КонецПопытки;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		//Создадим коллекцию для сообщений, которые разбиваются на несколько виртуальных, и обработаем ее в цикле
		ТабСообщенийДляЗагрузки = ПолучитьТаблицуСообщенийДляЗагрузки(Сообщение);
		
		Если ТабСообщенийДляЗагрузки = Неопределено Тогда 
			
			ВызватьИсключение "Не удалось разбить входящий ORDERS";
			
		КонецЕсли;
		
		Для Каждого Стр Из ТабСообщенийДляЗагрузки Цикл
			
			//уберем из таблицы Товары в Сообщении все строки, которые нам сейчас не нужны:
			//те, которые пользователь решил не загружать, и те, которые не подпадают под текущую товарную группу (если есть автоматическое деление)
			ЗагружаемоеСообщение 	= Стр.Сообщение;
			КопияСообщения 			= ЗначениеИзСтрокиВнутр(ЗначениеВСтрокуВнутр(ЗагружаемоеСообщение));
			КопияСообщения.Товары 	= Стр.ТоварыДляЗагрузки;
			
			СтандартнаяОбработкаEDI = Истина;
			СсылкаНаДокумент = ОбработкаСобытияПодключаемогоМодуля("ПринятьВходящееСообщение",
																	СтандартнаяОбработкаEDI,
																	Новый Структура("Сообщение,ПервоначальнаяЗагрузкаСообщения, ИнтерактивнаяОбработка",
																					КопияСообщения,
																					ПервоначальнаяЗагрузкаСообщения,
																					ИнтерактивнаяОбработка));
			
			Если СтандартнаяОбработкаEDI Тогда
				
				//Для RECADV не пересчитываем, т.к. будем сверять с DESADV
				Если Сообщение.ТипСообщения <> "RECADV" Тогда
					ПересчитатьТоварыСообщения(КопияСообщения.Товары, КопияСообщения.Отправитель1С, "В1С", КопияСообщения);
				КонецЕсли;

				СсылкаНаДокумент = ПринятьВходящееСообщение_БМИ(КопияСообщения, ПервоначальнаяЗагрузкаСообщения, ИнтерактивнаяОбработка);
			
			КонецЕсли;
			
			Если НЕ ПринятьБезДокумента(КопияСообщения) И СсылкаНаДокумент = Неопределено  Тогда
				
				ВызватьИсключение "Не получена ссылка на документ";
				
			КонецЕсли;

			ЗагружаемоеСообщение.ДокументСсылка = СсылкаНаДокумент;
			
			Если ПервоначальнаяЗагрузкаСообщения 
				ИЛИ (ЗагружаемоеСообщение.Свойство("Статус") 
				И (ЗагружаемоеСообщение.Статус = "Replace" ИЛИ ЗагружаемоеСообщение.Статус = "Замена")) Тогда

				СохранитьСообщение(ЗагружаемоеСообщение,"Загружен");
				
				ОбработкаСобытияПодключаемогоМодуля("ПослеЗагрузкиВходящегоСообщения",,
						Новый Структура("Сообщение,ДокументСсылка",
						ЗагружаемоеСообщение,СсылкаНаДокумент));
				
			КонецЕсли;
			
			СтруктураВозврата.Успешно	= Истина;
			СтруктураВозврата.Документ	= СсылкаНаДокумент;

		КонецЦикла;
		
	    Если ТранзакцияАктивна() Тогда
	        ЗафиксироватьТранзакцию();
	    КонецЕсли;
		
	Исключение
		
	    Если ТранзакцияАктивна() Тогда
	        ОтменитьТранзакцию();
		КонецЕсли;
		
		_ОписаниеОшибки = ОписаниеОшибки();
		Метрика_Переменные = Новый Структура;
		Метрика_Переменные.Вставить("ТипСообщения", 					Сообщение.ТипСообщения);
		Метрика_Переменные.Вставить("ПервоначальнаяЗагрузкаСообщения", 	ПервоначальнаяЗагрузкаСообщения);
		Если ПеременнаяСодержитСвойство(Сообщение,"Партнер",,Истина) Тогда 
			Метрика_Переменные.Вставить("НастройкиПартнера", ПолучитьЗначенияНастроекПартнеров(Сообщение.Партнер,Истина));
		КонецЕсли;
		Метрика_Ошибка("ПринятьВходящееСообщение", _ОписаниеОшибки, ИнформацияОбОшибке(), Метрика_Переменные);
		
		ТекстОшибки = "Не удалось принять входящее сообщение - " + Сообщение.ТипСообщения + " " + Сообщение.ID + " - " + _ОписаниеОшибки;
		Сообщить_КонтурEDI(ТекстОшибки);
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки, Сообщение.СообщениеСсылка);
		
		Возврат СтруктураВозврата;
		
	КонецПопытки;	
	
	//если стоит флаг "Проводить заказы после создания", то постараемся провести все созданные документы
	//с 4.3.14 эта настройка перенесена в партнера
	Если  
		СтруктураВозврата.Успешно 
		И Сообщение.ТипСообщения = "ORDERS"
		И ЗначениеЗаполнено(СсылкаНаДокумент)  
		И ЗначениеЗаполнено(Сообщение.Партнер) И ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер,"ПроводитьСозданныеЗаказы")=Истина  //тяжелое условие - пусть будет последним
		Тогда
		
		ТаблицаСвязанныхДокументов = ПолучитьВиртуальныеСвязанныеORDERS(СсылкаНаДокумент);
		Для Каждого СтрокаПринятогоДокумента Из ТаблицаСвязанныхДокументов Цикл
			ДокументДляПроведения = СтрокаПринятогоДокумента.Документ;
			Если ЗначениеЗаполнено(СтрокаПринятогоДокумента.Документ) Тогда
				Попытка
					ДокументДляПроведения.ПолучитьОбъект().Записать(РежимЗаписиДокумента.Проведение);
				Исключение
					Сообщить_КонтурEDI("Контур-EDI: Не удалось провести документ "+СокрЛП(ДокументДляПроведения));
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;		
	КонецЕсли;
	
	Если Не СообщениеОбъект = Неопределено И СообщениеОбъект.Заблокирован() Тогда
		СообщениеОбъект.Разблокировать();
	КонецЕсли;
	
	Если Не ВнешнееХранилище И СтруктураВозврата.Успешно 
		И Сообщение.ТипСообщения = "ORDERS" 
		И Сообщение.Свойство("ГрузополучательEDI") 
		И Сообщение.ГрузополучательEDI.Свойство("ТипЛокализации")
		И ЗначениеЗаполнено(Сообщение.ТочкаДоставки)
		И ЗначениеЗаполнено(Сообщение.ГрузополучательEDI.ТипЛокализации) Тогда
		
		ОбработатьПолучениеТипаЛокализацииВЗаказе(Сообщение.ТочкаДоставки, Сообщение.ГрузополучательEDI.ТипЛокализации);
		
	КонецЕсли;
		
	Возврат СтруктураВозврата;
	 
КонецФункции

Процедура ОбработатьПолучениеТипаЛокализацииВЗаказе(ТочкаДоставкиСсылка, ТипЛокализации)
	
	ТочкаДоставки = ТочкаДоставкиСсылка.ПолучитьОбъект();
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("ТипЛокализации", ТипЛокализации);
	
	ЗаписатьЗначенияДопРеквизитовТочкиДоставки_КонтурEDI(ТочкаДоставки, СтруктураРеквизитов);
	
	ТочкаДоставки.Записать(); 	
	
КонецПроцедуры


//на входе берет входящее Сообщение, если это ORDERS, то делит его по товарным группам, товарам и услугам 
//на выходе выдает таблицу с колонками - Сообщение, ТоварыДляЗагрузки
Функция ПолучитьТаблицуСообщенийДляЗагрузки(Сообщение)
	
	ТабВозврата = Новый ТаблицаЗначений;
	ДобавитьКолонкиВТаблицуЗначений(ТабВозврата, "Сообщение,ТоварыДляЗагрузки");
	
	Если Сообщение.ТипСообщения = "ORDERS" Тогда
		
		//Нам придется проверить, а не создано ли уже несколько документов по данному сообщению.
		//Отвязать их либо здесь, либо дождаться интерактивной отвязки
		//Дальше создать по каждой строке, кроме первой, виртуальную копию сообщения
		//и уже по этой копии создавать документ заказа
		
		Если ЗначениеЗаполнено(Сообщение.ДокументСсылка) Тогда
			ТабВиртуальныхСообщений = ПолучитьВиртуальныеСвязанныеORDERS(Сообщение.ДокументСсылка);
			Если ТабВиртуальныхСообщений.Количество() > 1 Тогда
				//к этому сообщению привязано несколько документов
				//значит,мы не можем создавать заказы до тех пор, пока не отвяжем все и пометим на удаление
				Возврат Неопределено;   //продумать, как мы реагируем на несколько уже созданных Заказов по множественному ORDERS
			КонецЕсли;	
		КонецЕсли;
		
		// сбросим товарную группу, чтобы не задублировать при перезаполнении документов
		Сообщение.Товары.ЗаполнитьЗначения(Неопределено, "ТоварнаяГруппа");
		
		//разделение заказов
		//создадим 1 документ для текущего сообщения, а также связанные для других товарных групп
		ОбработкаСобытияПодключаемогоМодуля("ЗаполнитьТоварнуюГруппуТаблицыТоваров",,Новый Структура("Сообщение,Товары",Сообщение,Сообщение.Товары));//попробуем так.
		
		ЗагружатьТоварыИУслугиВРазныеДокументы1С = ЗагружатьТоварыИУслугиВРазныеДокументы1С(Сообщение);

		// 1. Отбор по "НеЗагружать"
		ТоварыДляЗагрузки = Сообщение.Товары.Скопировать(Новый Структура("НеЗагружать", Ложь));
		
		// 2. Отбор по "ТоварнаяГруппа"
		ТоварныеГруппы = Новый Массив;
		Для Каждого СтрокаТоваров Из ТоварыДляЗагрузки Цикл
			Если ТоварныеГруппы.Найти(СтрокаТоваров.ТоварнаяГруппа) = Неопределено Тогда
				ТоварныеГруппы.Добавить(СтрокаТоваров.ТоварнаяГруппа);
			КонецЕсли;	
		КонецЦикла;
		
		ИсходноеСообщениеОбъект = ПолучитьОбъектСообщения(Сообщение.СообщениеСсылка);
	
		// 3. Отбор по "ТипЕдиницы" = услуги
		СоздатьНовыйОбъект = Ложь;
		
		Для Каждого ТоварнаяГруппа Из ТоварныеГруппы Цикл
			
			КопияТоварыГруппы = ТоварыДляЗагрузки.Скопировать(Новый Структура("ТоварнаяГруппа", ТоварнаяГруппа));
			
			Если ЗагружатьТоварыИУслугиВРазныеДокументы1С Тогда
				
				СтрокиУслуги = Новый Массив;
				СтрокиТовары = Новый Массив;
				
				Для Каждого Стр Из КопияТоварыГруппы Цикл
					Если Стр.ТипЕдиницы = "Services" Тогда
						СтрокиУслуги.Добавить(Стр);
					Иначе
						СтрокиТовары.Добавить(Стр);
					КонецЕсли;
				КонецЦикла;
				
				Если НЕ СтрокиУслуги.Количество() = 0 Тогда 
					НоваяСтрока = ТабВозврата.Добавить();
					СоздатьНовыйОбъект 				= НЕ (ТабВозврата.Индекс(НоваяСтрока) = 0); 
					Если СоздатьНовыйОбъект Тогда
						// не первая строка в таблице						
						НоваяСтрока.Сообщение 		= СоздатьКопиюСообщенияДляЗагрузки(ИсходноеСообщениеОбъект, Сообщение);
					Иначе
						НоваяСтрока.Сообщение 		= Сообщение;
					КонецЕсли;
					НоваяСтрока.ТоварыДляЗагрузки 	= КопияТоварыГруппы.Скопировать(СтрокиУслуги);
				КонецЕсли;
				Если НЕ СтрокиТовары.Количество() = 0 Тогда 
					НоваяСтрока = ТабВозврата.Добавить();
					СоздатьНовыйОбъект 				= НЕ (ТабВозврата.Индекс(НоваяСтрока) = 0); 
					Если СоздатьНовыйОбъект Тогда
						// не первая строка в таблице						
						НоваяСтрока.Сообщение 		= СоздатьКопиюСообщенияДляЗагрузки(ИсходноеСообщениеОбъект, Сообщение);
					Иначе
						НоваяСтрока.Сообщение 		= Сообщение;
					КонецЕсли;
					НоваяСтрока.ТоварыДляЗагрузки 	= КопияТоварыГруппы.Скопировать(СтрокиТовары);
				КонецЕсли;
			Иначе
				НоваяСтрока = ТабВозврата.Добавить();
				СоздатьНовыйОбъект 				= НЕ (ТабВозврата.Индекс(НоваяСтрока) = 0); 
				Если СоздатьНовыйОбъект Тогда
					// не первая строка в таблице						
					НоваяСтрока.Сообщение 		= СоздатьКопиюСообщенияДляЗагрузки(ИсходноеСообщениеОбъект, Сообщение);
				Иначе
					НоваяСтрока.Сообщение 		= Сообщение;
				КонецЕсли;
				НоваяСтрока.ТоварыДляЗагрузки 	= КопияТоварыГруппы;
			КонецЕсли;
			
			Если ПеременнаяСодержитСвойство(НоваяСтрока.Сообщение, "ТоварнаяГруппа") Тогда 
				НоваяСтрока.Сообщение.ТоварнаяГруппа = ТоварнаяГруппа;
			КонецЕсли;
			
		КонецЦикла;
	
	ИначеЕсли Сообщение.ТипСообщения = "RECADV" 
		ИЛИ Сообщение.ТипСообщения = "RETANN" Тогда
		ТоварыДляЗагрузки 	= Сообщение.Товары.Скопировать(Новый Структура("НеЗагружать", Ложь));
		Если НЕ ТоварыДляЗагрузки.Количество() = 0 Тогда
			НоваяСтрока = ТабВозврата.Добавить();
			НоваяСтрока.Сообщение 			= Сообщение;
			НоваяСтрока.ТоварыДляЗагрузки 	= ТоварыДляЗагрузки;
		КонецЕсли;
	Иначе	
		//все другие типы сообщений - там будет только по одному сообщению
		НоваяСтрока = ТабВозврата.Добавить();
		НоваяСтрока.Сообщение 			= Сообщение;
		НоваяСтрока.ТоварыДляЗагрузки 	= Сообщение.Товары.Скопировать();
	КонецЕсли;

	Возврат ТабВозврата;
	
КонецФункции

Функция СоздатьКопиюСообщенияДляЗагрузки(СообщениеОбъект, Сообщение)
	
	НовоеСообщение = Неопределено;	
	
	НовоеСообщениеОбъект = СообщениеОбъект.Скопировать();
	НовоеСообщениеОбъект.УстановитьНовыйКод();
	НовоеСообщениеОбъект.Документ = Неопределено;
	СохранитьОбъектСообщения(НовоеСообщениеОбъект);
	
	//дубль объекта создан, создадим дубль структуры Сообщения
	НовоеСообщениеСсылка = ?(ВнешнееХранилище, СоединениеСХранилищем.ЗначениеВСтрокуВнутр(НовоеСообщениеОбъект.Ссылка), НовоеСообщениеОбъект.Ссылка);
	
	НовоеСообщение = ПрочитатьСообщение(НовоеСообщениеСсылка,, "ORDERS", "Входящее");
	НовоеСообщение.ТоварнаяГруппа 	= Сообщение.ТоварнаяГруппа;
	НовоеСообщение.Товары 			= Сообщение.Товары; // скопируем Товары.
	НовоеСообщение.ДокументСсылка 	= Неопределено;
	
	Возврат НовоеСообщение;
	
КонецФункции

Функция ЗагружатьТоварыИУслугиВРазныеДокументы1С(Сообщение)
	
	Результат = Ложь;
	
	//разделение заказов на товары и услуги
	РаботаСУслугами 	= (ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, "РаботаСУслугами") = Истина);
	ТипДокументаORDERS 	= ПолучитьТипЗначенияОбъекта("ВходящийЗаказПокупателя");
	ТипДокументаDESADV 	= ПолучитьТипЗначенияОбъекта("ИсходящееУведомлениеОбОтгрузке");
	ЗагружатьТоварыУслугиВОдинДокумент = (ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, "ЗагружатьТоварыУслугиВОдинДокументРеализации") = Истина);
	
	Если РаботаСУслугами
		И СообщениеСодержитУслуги(Сообщение)
		И ТипДокументаORDERS = ТипДокументаDESADV
		И ЗагружатьТоварыУслугиВОдинДокумент = Ложь
	Тогда
	
		Результат = Истина;
		
	КонецЕсли;
	
    Возврат Результат;
	
КонецФункции // ЗагружатьТоварыИУслугиВРазныеДокументы1С()

Функция ПометитьДокументСообщенияНаУдаление(Сообщение)
	
	РезультатОбработки = Новый Структура("Успешно,Документ", Истина, Неопределено);
	
	Если Сообщение.Свойство("ДокументСсылка") Тогда
		ДокументСсылка = Сообщение.ДокументСсылка;
		
		РезультатОбработки.Документ = ДокументСсылка;
		
		Если ЗначениеЗаполнено(ДокументСсылка) Тогда 
			Попытка
				ДокументСсылка.ПолучитьОбъект().УстановитьПометкуУдаления(Истина);
			Исключение
				Сообщить_КонтурEDI("Документ "+ДокументСсылка+" не удалось пометить на удаление");
				РезультатОбработки.Успешно = Ложь;
			КонецПопытки;
		Иначе
			Сообщить_КонтурEDI("В сообщении нет привязанного документа");
			РезультатОбработки.Успешно = Ложь;
		КонецЕсли;
	Иначе
		Сообщить_КонтурEDI("В сообщении неопределено свойство ""ДокументСсылка""");
		РезультатОбработки.Успешно = Ложь;
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

// Отправка сообщений

Процедура ПеренестиИзмененныеРеквизитыВСообщение(Параметры, Сообщение)

	Если ЗначениеЗаполнено(Параметры) И ТипЗнч(Параметры) = Тип("Структура") 
		И Параметры.Свойство("ИзмененныеРеквизиты") = Истина И ТипЗнч(Параметры.ИзмененныеРеквизиты) = Тип("Структура") Тогда
		
		Для Каждого ИзмРеквизит Из Параметры.ИзмененныеРеквизиты Цикл
			Сообщение.Вставить(ИзмРеквизит.Ключ, ИзмРеквизит.Значение);
		КонецЦикла;
				
	КонецЕсли;
	
КонецПроцедуры  

Функция ПодготовитьИсходящееСообщение(ТипСообщения, ДокументСсылка, Параметры = Неопределено) Экспорт   //Параметр ВходящийЗаказ может быть как ссылкой на сообщение, так и самим сообщением
	
	Метрика_ИдЗамера = Метрика_НовыйУИД();
	Метрика_НачатьЗамер(Метрика_ИдЗамера, "ПодготовитьИсходящееСообщение");
	
	//чистка кэша таблицы связанных документов-сообщений
	//могли случится манипуляции по связям текущего документа. -  ПолучитьТаблицуСвязанныхДокументовПоТипамСообщений в таком случае может достать из кэша неактуальные данные
	ЭДО_Кэш_Поместить("КэшТаблицыСвязанныхДокументовПоТипамСообщений",неопределено);
	
	ЭтоОтклонениеНезагруженногоЗаказа = (
		ТипСообщения = "ORDRSP" 
		И ((ТипЗнч(Параметры) = Тип("Структура") 
		И Параметры.Свойство("ВходящийЗаказ") 
		И Параметры.Свойство("Статус") 
		И Параметры.Статус = "Отклонить")
		ИЛИ НЕ ЗначениеЗаполнено(ДокументСсылка))
		);
		
	ЭтоОтклонениеНезагруженногоВозврата = (
		(ТипСообщения = "RETINS" ИЛИ ТипСообщения = "RETREC")
		И ТипЗнч(Параметры) = Тип("Структура")
		И Параметры.Свойство("ВходящийВозврат")			 
		И Параметры.Свойство("Статус") 
		И Параметры.Статус = "Отклонить" 
		);
		
	Если ЭтоОтклонениеНезагруженногоЗаказа Тогда // отклонение незагруженного в 1С заказа
		Параметры.Вставить("ЭтоОтклонениеНезагруженногоЗаказа",Истина);
	КонецЕсли;
	Если ЭтоОтклонениеНезагруженногоВозврата Тогда // отклонение незагруженного в 1С возврата
		Параметры.Вставить("ЭтоОтклонениеНезагруженногоВозврата",Истина);
	КонецЕсли;
	
	Сообщение = ПолучитьСтруктуруСообщения(ТипСообщения,"Исходящее");
	
	Сообщение.ТипСообщения		= ТипСообщения;
	Сообщение.Направление		= "Исходящее";
	Сообщение.ДокументСсылка	= ДокументСсылка;
	
	Если ПроверитьСвойствоПоляВСтруктуре(Параметры, "ПереотправляемоеСообщениеСсылка") Тогда 
		
		// это явно указанная переотправка		
		// для переотправки будем указывать прямую ссылку на сообщение, которое переотправляем
        Сообщение.Вставить("ПереотправляемоеСообщениеСсылка", Параметры.ПереотправляемоеСообщениеСсылка);
		
    КонецЕсли;
	
	// заполняем поля 1С
	СтандартнаяОбработкаEDI = Истина;
	
	Если Не ЭтоОтклонениеНезагруженногоЗаказа И НЕ ЭтоОтклонениеНезагруженногоВозврата Тогда
		РезультатПМ = ОбработкаСобытияПодключаемогоМодуля("ПодготовитьИсходящееСообщение",СтандартнаяОбработкаEDI,Новый Структура("Сообщение,ДокументСсылка,Параметры",Сообщение,ДокументСсылка,Параметры));
	КонецЕсли;
	
	Если СтандартнаяОбработкаEDI = Ложь Тогда
		
		Сообщение = РезультатПМ;
		
	Иначе	
		//штатная подготовка сообщения
		Если Сообщение.ТипСообщения = "ORDRSP" Тогда
			
			ПодготовитьОтветНаЗаказ(ДокументСсылка, Сообщение, Параметры);
			
		ИначеЕсли Сообщение.ТипСообщения = "DESADV" Тогда	
			
			ПодготовитьУведомлениеОбОтгрузке(ДокументСсылка, Сообщение, Параметры);
			
		ИначеЕсли Сообщение.ТипСообщения = "INVOIC" Тогда
			
			ПодготовитьСчетФактуру(ДокументСсылка, Сообщение, Параметры);
			
		ИначеЕсли Сообщение.ТипСообщения = "ORDERS" Тогда
			
			ПодготовитьЗаказ(ДокументСсылка, Сообщение, Параметры);
			
		ИначеЕсли Сообщение.ТипСообщения = "RECADV" Тогда
			
			ПодготовитьУведомлениеОПриемке(ДокументСсылка, Сообщение);
			
		ИначеЕсли Сообщение.ТипСообщения = "ALCRPT" Тогда
			
			ПодготовитьОтчетОПродажеАлкоголя(ДокументСсылка, Сообщение);
			
		ИначеЕсли Сообщение.ТипСообщения = "PORDERS" Тогда
			
			ПодготовитьОбратныйЗаказ(ДокументСсылка, Сообщение);
			
		ИначеЕсли Сообщение.ТипСообщения = "RETINS" Тогда
			
			ПодготовитьОтветНаУведомлениеОВозврате(ДокументСсылка, Сообщение, Параметры);
			
		ИначеЕсли Сообщение.ТипСообщения = "RETREC" Тогда
			
			ПодготовитьУведомлениеОПриемкеВозврата(ДокументСсылка, Сообщение, Параметры);
			
		ИначеЕсли Сообщение.ТипСообщения = "COINVOIC" Тогда
			
			ПодготовитьИсправительныйКорректировочныйСчетФактуру(ДокументСсылка, Сообщение, Параметры);
			
		ИначеЕсли Сообщение.ТипСообщения = "IFTMBC" Тогда
			
			ПодготовитьОтветНаЗаказПеревозки(ДокументСсылка, Сообщение, Параметры);
			
		ИначеЕсли Сообщение.ТипСообщения = "RETANN" Тогда
			
			ПодготовитьУведомлениеОВозврате(ДокументСсылка, Сообщение);

		ИначеЕсли Сообщение.ТипСообщения = "RETDES" Тогда
			
			ПодготовитьУведомлениеОбОтгрузкеВозврата(ДокументСсылка, Сообщение);
			
		КонецЕсли;
		
		Если НЕ Сообщение.ТипСообщения = "COINVOIC" И НЕ Сообщение.ТипСообщения = "DELFOR" Тогда
		
			Сообщение.СуммаВсего		= Сообщение.Товары.Итог("СуммаСНДС");
			Сообщение.СуммаВсегоНДС		= Сообщение.Товары.Итог("СуммаНДС");
			Сообщение.СуммаВсегоБезНДС	= Сообщение.Товары.Итог("СуммаБезНДС");
		
		КонецЕсли;
		
	КонецЕсли;
	//-вынесено из базового модуля интеграции
	
	Если НЕ ЭтоОтклонениеНезагруженногоЗаказа И     //а отклоненный уже сконвертирован.
		 НЕ ЭтоОтклонениеНезагруженногоВозврата И
		 НЕ Сообщение.ТипСообщения = "PRICELIST" Тогда
		
		// конвертим поля 1С в поля EDI
		КонвертироватьСообщение1СвEDI(Сообщение);
		Сообщение.Партнер = Сообщение.Получатель1С;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Сообщение.ID) Тогда                                                                               
		
		УИД = Новый УникальныйИдентификатор();
		Сообщение.ID = СтрЗаменить(УИД,"-","");
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Сообщение.ДатаСоздания) Тогда
		
		Сообщение.ДатаСоздания = ТекущаяДата();
		
	КонецЕсли;
	
	ДобавитьКомментарийОПропускеСообщения(Сообщение);
	
	ПеренестиИзмененныеРеквизитыВСообщение(Параметры, Сообщение);
	
 	ДополнитьСообщениеКодамиМаркировки(Сообщение, Параметры);
	ЗаполнитьТипыПродукцииВСообщении(Сообщение);
	
	//кастомные заполнения
	РезультатПМ = ОбработкаСобытияПодключаемогоМодуля("ПослеПодготовкиИсходящегоСообщения",,
			Новый Структура("Сообщение,ДокументСсылка,Параметры",
			Сообщение,ДокументСсылка,Параметры));
			
	// проверяем поля на наличие ошибок
	ПропуститьПроверкуСообщения = КонтурСтандарт_ЗначениеПоКлючу(Параметры, "ПропуститьПроверкуСообщения", Ложь);
	
	Если ПропуститьПроверкуСообщения <> Истина Тогда
		РезультатПроверки = ПроверитьПоляСообщения(Сообщение);
		Сообщение.СодержитОшибки = НЕ РезультатПроверки.Успешно;
	Иначе
		Сообщение.СодержитОшибки = Ложь;
	КонецЕсли;
	
	Если Сообщение.СодержитОшибки Тогда
		МассивОшибок = РезультатПроверки.СписокОшибок.ВыгрузитьКолонку("ТекстОшибки");		
		Сообщение.ОписаниеОшибки = КонтурСтандарт_СтрСоединить_(МассивОшибок, Символы.ПС);
	Иначе
		Сообщение.ОписаниеОшибки = "";
	КонецЕсли;
	
	Если РезультатПМ <> Неопределено Тогда
		Сообщение = РезультатПМ.Сообщение;
	КонецЕсли;
	
	// +++ 1 бит Балицкий В.В. 07.10.2026
	// Номер/дату ТТН в DESADV берём из связанной транспортной накладной,
	// а не из номера реализации (после обработки ПМ, чтобы переопределить типовое заполнение).
	ЗаполнитьНомерИДатуТТНВСообщенииИзТранспортнойНакладной_КонтурEDI(Сообщение);
	// --- 1 бит Балицкий В.В. 07.10.2026
			
	Метрика_Переменные = Новый Структура("ТипСообщения", Сообщение.ТипСообщения);
	Метрика_ЗакончитьЗамер(Метрика_ИдЗамера, "ПодготовитьИсходящееСообщение", , , , Метрика_Переменные);
	
	Возврат Сообщение;
	
КонецФункции

Процедура ДобавитьКомментарийОПропускеСообщения(Сообщение)
	
	ДобавитьКомментарий = Ложь;
	
	Если НужноПропуститьСообщениеСУслугами_DESADV(Сообщение) Тогда
		ТекстКомментария = "Сообщение необходимо пропустить согласно отключенной настройке партнера ""Отправлять DESADV на услуги""";
		ДобавитьКомментарий = Истина;
	КонецЕсли;
	
	Если ДобавитьКомментарий Тогда
		Сообщение.Комментарий = Строка(Сообщение.Комментарий) + ?(ЗначениеЗаполнено(Сообщение.Комментарий), ", ", "") + ТекстКомментария;
	КонецЕсли;
	
КонецПроцедуры

// Интерфейсные процедуры и функции

Процедура ПроверитьПредварительныеЗаказы() Экспорт 
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	 |	КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка.Документ КАК Документ,
	 |  КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка.Ссылка КАК СообщениеСсылка  
	 |ИЗ
	 |	Справочник.КонтурEDI_Сообщения.ДополнительныеРеквизиты КАК КонтурEDI_СообщенияДополнительныеРеквизиты
	 |ГДЕ
	 |	НЕ КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка.ПометкаУдаления
	 |	И  КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка.ТипСообщения    = ""ORDERS""
	 |	И  КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка.Направление     = ""Входящее""
	 |	И  КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка.Статус       	 ПОДОБНО ""%ПредварительныйЗаказ""
	 |	И  НЕ КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка.Статус       ПОДОБНО ""Закрыт_ПредварительныйЗаказ""
	 |	И  КонтурEDI_СообщенияДополнительныеРеквизиты.ИмяРеквизита 			 = ""КрайняяДатаБронирования""
	 |  И  КонтурEDI_СообщенияДополнительныеРеквизиты.Значение < &ТекущаяДата
	 |	И  НЕ
	 |	   (КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка.Документ ЕСТЬ NULL
	 |			ИЛИ КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка.Документ = НЕОПРЕДЕЛЕНО)";
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	МассивПросроченныхДокументов = Новый Массив;
	
	НачатьТранзакцию();
	
	Попытка
		
		Для Каждого ПросроченныеПредварительныеЗаказы Из РезультатЗапроса Цикл 
			
			СообщениеСсылка = ПросроченныеПредварительныеЗаказы.СообщениеСсылка;
			
			СообщениеОбъект			= СообщениеСсылка.ПолучитьОбъект();
			СообщениеОбъект.Статус	= "Закрыт_ПредварительныйЗаказ";
			  			
			СохранитьОбъектСообщения(СообщениеОбъект);
			
			МассивПросроченныхДокументов.Добавить(ПросроченныеПредварительныеЗаказы.Документ);
			
		КонецЦикла;
		
		Если МассивПросроченныхДокументов.Количество() > 0 Тогда 
			
			ЗакрытьПредварительныеЗаказы(МассивПросроченныхДокументов);
			
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение 
		
		Если ТранзакцияАктивна() Тогда 
			
			ОтменитьТранзакцию();
			
		КонецЕсли;
		
		ОписаниеОшибки = ОписаниеОшибки();
		
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось закрыть предварительные заказы по причине - " + ОписаниеОшибки);
		ВызватьИсключение ОписаниеОшибки;
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ОтправитьУведомленияОПрочтенииСообщений() Экспорт
	
	ТаблицаСообщений = ПолучитьСообщенияПоКоторымНеОтправленыУведомления();
	
	Если Не ТаблицаСообщений = Неопределено Тогда
		
		Сч = 0;
		
		Для Каждого Стр ИЗ ТаблицаСообщений Цикл
			
			Сч = Сч + 1;
			
			СообщениеОбъект = ПолучитьОбъектСообщения(Стр.СообщениеСсылка);
			
			Если СообщениеОбъект.Заблокирован() Тогда
				Продолжить;
			КонецЕсли;
			
			Попытка
				СообщениеОбъект.Заблокировать();
			Исключение
				Продолжить;
			КонецПопытки;
			
			Сообщение = ПрочитатьСообщение(Стр.СообщениеСсылка, , Стр.ТипСообщения, "Входящее");
			
			Если Стр.СостояниеОбработки = "Read" Тогда
				
				РезультатКонвертации = СформироватьУведомлениеОПрочтенииСообщения(Сообщение);
				
			ИначеЕсли Стр.СостояниеОбработки = "Checking" Тогда
				
				РезультатКонвертации = СформироватьУведомлениеОВалидацииСообщения(Сообщение);
				
			КонецЕсли;
						
			Если НЕ РезультатКонвертации.Успешно Тогда
				СообщениеОбъект.Разблокировать();
				Продолжить;
			КонецЕсли;
			
			РезультатОтправки = ПередатьСообщениеНаСервер(РезультатКонвертации);
			
			Если РезультатОтправки.Успешно Тогда
				
				ПослеОтправкиУведомленияОПрочтении(Стр.СообщениеСсылка);
				
			Иначе
				
				Для Каждого СтрОшибки Из РезультатОтправки.ТаблицаОшибок Цикл
					ПолныйТекстОшибок = "" + СтрОшибки.ТекстОшибки + Символы.ПС;
				КонецЦикла;	
				
				КомментарийЗаписи = "Не удалось отправить уведомление о прочтении сообщения " + Стр.ТипСообщения + " - " + ПолныйТекстОшибок;
				ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, КомментарийЗаписи, Стр.СообщениеСсылка); 
				ОповеститьОбОшибках(РезультатОтправки);
				
			КонецЕсли;
			
			СообщениеОбъект.Разблокировать();
					
			Состояние_КонтурEDI("Отправляется уведомление о прочтении: " + Формат(Сч, "ЧГ=0") + " из " + Формат(ТаблицаСообщений.Количество(), "ЧГ=0"));
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

//отправляет все ALCRPT, которые можно отправить
Процедура ОтправитьALCRPT() Экспорт
	
	ТаблицаСообщений = ПолучитьДокументыПоКоторымНужноОтправитьALCRPT();
	
	Если Не ТаблицаСообщений = Неопределено Тогда
		
		Метрика_ИдЗамера = Метрика_НовыйУИД();
		Метрика_НачатьЗамер(Метрика_ИдЗамера, "ОтправитьALCRPT");
		Метрика_МассивСообщений = Новый Массив;
		
		Для Каждого Стр ИЗ ТаблицаСообщений Цикл
			
			Метрика_ВремяНачала = Метрика_ОтметкаВремени();
			
			Если ЗначениеЗаполнено(Стр.Документ) Тогда
				
				Сообщение = ПодготовитьИсходящееСообщение("ALCRPT", Стр.Документ);
				
				Если Не Сообщение.Товары.Количество() = 0 Тогда
					
					РезультатКонвертации = КонвертироватьИсходящееСообщениеПоНовому(Сообщение);
					
					Если РезультатКонвертации.Успешно <> Истина Тогда
						
						ТекстОшибок = ТекстОшибкиИзРезультатаКонвертации(РезультатКонвертации);  
						
						Сообщить_КонтурEDI("Не удалось отправить ALCRPT по документу " + Стр.Документ + " " + ТекстОшибок);
						
						Продолжить;
						
					КонецЕсли;
					
					РезультатОтправки = ПередатьСообщениеНаСервер(РезультатКонвертации);
					
					Если ПротоколОбмена_КонтурEDI = "API" Тогда
						MessageId = СтрЗаменить(РезультатОтправки.MessageId, "-", "");
					Иначе
						MessageId = Сообщение.ID;
					КонецЕсли;    
					
					УстановитьЗначениеСвойстваОбъекта(Стр.Документ, "ALCRPT_ID", MessageId);
					
				КонецЕсли;
				
			КонецЕсли;
						
			// скинем отметку о необходимости отправки ALCRPT, т.к. сообщение или было отправлено, или в нем не было алкогольной продукции
			УдалитьЗначениеСвойстваОбъекта(Стр.Документ, "НужноОтправитьALCRPT");
			
			Метрика_ВремяОкончания = Метрика_ОтметкаВремени();
			СтруктураЗамера = Новый Структура("ALCRPT", Метрика_Длительность(Метрика_ВремяНачала, Метрика_ВремяОкончания));
			Метрика_МассивСообщений.Добавить(СтруктураЗамера);
			
		КонецЦикла;
		
		Метрика_Переменные = Новый Структура;
		Метрика_Переменные.Вставить("КоличествоСообщений", 	ТаблицаСообщений.Количество());	
		Метрика_Переменные.Вставить("МассивСообщений", 		Метрика_МассивСообщений);	
		Метрика_ЗакончитьЗамер(Метрика_ИдЗамера, "ОтправитьALCRPT", , , , Метрика_Переменные);
	
	КонецЕсли; 
	
КонецПроцедуры

Функция ТекстОшибкиИзРезультатаКонвертации(РезультатКонвертации)
	
	ТекстОшибок = "" + РезультатКонвертации.ОписаниеОшибки;
	
	Для каждого СтрОшибок Из РезультатКонвертации.ТаблицаОшибок Цикл
		ТекстОшибок = ТекстОшибок + Символы.ПС + "" + СтрОшибок.ТекстОшибки;
	КонецЦикла;
	
	Возврат ТекстОшибок;

КонецФункции

Процедура ЗарегистрироватьСообщениеALCRPT_К_Отправке(Сообщение) Экспорт

	Накладная = Неопределено;
	
	Если Сообщение.ТипСообщения = "DESADV" Тогда
		Накладная = Сообщение.Документ1С;
	ИначеЕсли Сообщение.ТипСообщения = "INVOIC" Тогда
		Накладная = ПолучитьНакладнуюСчетаФактуры(Сообщение.Документ1С);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Накладная) Тогда
		УстановитьЗначениеСвойстваОбъекта(Накладная, "НужноОтправитьALCRPT",	Истина);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтправитьСообщенияОжидающиеОтправки() Экспорт
	
	УчетныеЗаписи = ПолучитьСписокЭлементовСправочника("УчетныеЗаписи");//обновим кэш УЗ
	
	НеотправленныеСообщения = ПолучитьСообщенияОжидающиеОтправки();	
	
	Метрика_ИдЗамера = Метрика_НовыйУИД();
	Метрика_НачатьЗамер(Метрика_ИдЗамера, "ОтправитьСообщенияОжидающиеОтправки");
	Метрика_МассивСообщений = Новый Массив;
	Метрика_МассивGLN = Новый Массив;    
	
	ОрганизацииОтправленных = Новый Соответствие;
	
	Сч = 0;
	
	Для каждого Стр Из НеотправленныеСообщения Цикл
		
		Метрика_ВремяНачала = Метрика_ОтметкаВремени();
		
		Сч = Сч + 1;
		Состояние_КонтурEDI("Отправляется исходящее сообщение: "+Формат(Сч,"ЧГ=0")+" из "+Формат(НеотправленныеСообщения.Количество(),"ЧГ=0"));
		ОтправитьПодготовленноеСообщение(Стр.СообщениеСсылка);
		
		Метрика_ВремяОкончания = Метрика_ОтметкаВремени();
		СтруктураЗамера = Новый Структура(Стр.ТипСообщения, Метрика_Длительность(Метрика_ВремяНачала, Метрика_ВремяОкончания));
		Метрика_МассивСообщений.Добавить(СтруктураЗамера);
		
		Если ОрганизацииОтправленных.Получить(Стр.Организация) = Неопределено Тогда
			ОрганизацииОтправленных.Вставить(Стр.Организация, Истина);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ТекущаяОрганизация Из ОрганизацииОтправленных Цикл
		
		GLN_Организации = ПолучитьЗначениеСвойстваОбъектаEDI(ОрганизацияEDI(ТекущаяОрганизация.Ключ), "GLN");
		Если ЗначениеЗаполнено(GLN_Организации) Тогда
			Метрика_МассивGLN.Добавить(GLN_Организации);
		КонецЕсли;
		
	КонецЦикла;
	
	Метрика_Переменные = Новый Структура;
	Метрика_Переменные.Вставить("КоличествоСообщений", 	НеотправленныеСообщения.Количество());	
	Метрика_Переменные.Вставить("МассивСообщений", 		Метрика_МассивСообщений);	
	Метрика_Переменные.Вставить("МассивGLN", 			Метрика_МассивGLN);	
	Метрика_ЗакончитьЗамер(Метрика_ИдЗамера, "ОтправитьСообщенияОжидающиеОтправки", , , , Метрика_Переменные);
	
	Если МетрикаКонтур_ИспользоватьМетрики() Тогда
		
		УчетныеЗаписиОтправленныхСообщений = ЭДО_Кэш_Прочитать("УчетныеЗаписиОтправленныхСообщений");
		
		Если ТипЗнч(УчетныеЗаписиОтправленныхСообщений) = Тип("Соответствие") 
			И УчетныеЗаписиОтправленныхСообщений.Количество() Тогда
			
			Для Каждого ТекСтрока Из УчетныеЗаписиОтправленныхСообщений Цикл 
				
				МетрикаКонтур_ЗаписатьСобытие_ОтправкаИсходящегоСообщения(ТекСтрока.Ключ);	
				
			КонецЦикла;
			
			ЭДО_Кэш_Очистить("УчетныеЗаписиОтправленныхСообщений");
			
		КонецЕсли;  
		
	КонецЕсли;  
	
КонецПроцедуры

Функция ИмяАрхиваСообщений()
	
	ИдентификаторАрхиваСообщений = СтрЗаменить(Новый УникальныйИдентификатор(), "-", "");
	ДатаАрхиваСообщений = Формат(ТекущаяДатаСеанса(), "ДФ=ddMMyyhhmmss");
	Возврат КонтурСтандарт_СтрШаблон_("%1_messages_%2.zip", ИдентификаторАрхиваСообщений, ДатаАрхиваСообщений);
	
КонецФункции	

Процедура ОтправитьСообщенияОжидающиеОтправкиПакетом()
	
	НеотправленныеСообщения = ПолучитьСообщенияОжидающиеОтправки();	
	Если НеотправленныеСообщения.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	УчетныеЗаписи 		= ПолучитьСписокЭлементовСправочника("УчетныеЗаписи");  
	НашиОрганизации 	= ПолучитьСписокЭлементовСправочника("ЮрФизЛицаСвои");
	
	Метрика_ИдЗамера = Метрика_НовыйУИД();
	Метрика_НачатьЗамер(Метрика_ИдЗамера, "ОтправитьСообщенияОжидающиеОтправкиПакетом");
	Метрика_МассивGLN = Новый Массив;
	Метрика_МассивСообщений = Новый Массив;  
	СообщенияВАрхиве = Новый Массив;
	ИндексОтправленныхGLN = Новый Соответствие;
	
	КоличествоСообщенийВАрхиве = КоличествоСообщенийВОдномАрхиве(); 
	
	Для каждого Запись Из УчетныеЗаписи Цикл 
		
		Если Запись.НеАктивна Тогда 
			Продолжить;
		КонецЕсли;
		
		УчетнаяЗаписьОбъект = Запись.Ссылка.ПолучитьОбъект();
		Если ЗаблокироватьУчетнуюЗапись(УчетнаяЗаписьОбъект) = Ложь Тогда 
			Продолжить;
		КонецЕсли;	
		
		ОрганизацияУчетнойЗаписи = НашиОрганизации.Найти(Запись.GLN); 
		
		Метрика_ВремяНачала = Метрика_ОтметкаВремени();
		ПакетыСообщений = Новый Массив;
		
		ИмяФайлаZIP 	= ИмяАрхиваСообщений();
		ЗаписьZIP 		= НоваяЗаписьZipФайла_КонтурEDI(ИмяФайлаZIP);
		
		
		Для каждого СтрокаТаблицы Из НеотправленныеСообщения Цикл
			
			Если СтрокаТаблицы.Организация <> ОрганизацияУчетнойЗаписи.ЮрФизЛицо Тогда
				Продолжить;
			КонецЕсли;
			
			МассивСтатусов = Новый Массив;
			МассивСтатусов.Добавить(Врег("Отправлен"));
			МассивСтатусов.Добавить(Врег("Доставлен"));
			
			Если МассивСтатусов.Найти(Врег(СтрокаТаблицы.СообщениеСсылка.Статус)) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Сообщение = ПрочитатьСообщение(СтрокаТаблицы.СообщениеСсылка,,, "Исходящее");
			РезультатКонвертации = КонвертироватьИсходящееСообщениеПоНовому(Сообщение);
			
			Если НЕ РезультатКонвертации.Успешно Тогда
				ОповеститьОбОшибках(РезультатКонвертации);
				Продолжить;
			КонецЕсли;
			
			РезультатКонвертации.Вставить("Сообщение", Сообщение); 
			СообщенияВАрхиве.Добавить(РезультатКонвертации);
			ЗаписьZIP.Добавить(РезультатКонвертации.ПутьКФайлу);
			
			СообщениеGLN = РезультатКонвертации.GLN;
			Если ИндексОтправленныхGLN.Получить(СообщениеGLN) = Неопределено Тогда
				ИндексОтправленныхGLN.Вставить(СообщениеGLN, Истина);	
				Метрика_МассивGLN.Добавить(СообщениеGLN);
			КонецЕсли;
			
			Если СообщенияВАрхиве.Количество() = КоличествоСообщенийВАрхиве Тогда
				
				ПакетыСообщений.Добавить(Новый Структура("ИмяФайлаZIP, ДвоичныеДанные,СообщенияВАрхиве",
												ИмяФайлаZIP, ДвоичныеДанныеАрхива_КонтурEDI(ЗаписьZIP,ИмяФайлаZIP), СообщенияВАрхиве)); 
												
				ИмяФайлаZIP 	 = ИмяАрхиваСообщений();
				ЗаписьZIP 		 = НоваяЗаписьZipФайла_КонтурEDI(ИмяФайлаZIP);
				СообщенияВАрхиве = Новый Массив;
			КонецЕсли;	
		КонецЦикла;
		
		
		Если СообщенияВАрхиве.Количество() > 0 Тогда
			
			ПакетыСообщений.Добавить(Новый Структура("ИмяФайлаZIP, ДвоичныеДанные,СообщенияВАрхиве",
											ИмяФайлаZIP,ДвоичныеДанныеАрхива_КонтурEDI(ЗаписьZIP,ИмяФайлаZIP),СообщенияВАрхиве));
		КонецЕсли;
 
		
		Метрика_ВремяОкончания = Метрика_ОтметкаВремени();
		СтруктураЗамера = Новый Структура("ZIPАрхивСформирован", Метрика_Длительность(Метрика_ВремяНачала, Метрика_ВремяОкончания));
		Метрика_МассивСообщений.Добавить(СтруктураЗамера);   
		
		Для Каждого ПакетСообщений Из ПакетыСообщений Цикл 
			
			Результат = ИнициализироватьСтруктуруРезультатаФункции();
			Результат.Вставить("GLN", Запись.GLN);
			Результат.Вставить("ПакетнаяОтправка", Истина); 
			Результат.Вставить("ДвоичныеДанные", ПакетСообщений.ДвоичныеДанные);
			Результат.Вставить("ИмяФайлаZIP", ПакетСообщений.ИмяФайлаZIP);
			
			РезультатОтправки = ПередатьСообщениеНаСервер(Результат);
			
			Если РезультатОтправки.Успешно = Истина Тогда 
				НовыйАрхив = НайтиИлиСоздатьОбъектХранилищеОтправленныхАрхивов_КонтурEDI(РезультатОтправки.DocumentCirculationId);
				
				Для Каждого Стр Из ПакетСообщений.СообщенияВАрхиве Цикл 
					ПослеОтправкиИсходящегоСообщения(Стр.Сообщение, РезультатОтправки);
					
					СообщениеАрхива = НовыйАрхив.ДополнительныеРеквизиты.Добавить();
					СообщениеАрхива.Значение  		= Стр.Сообщение.СообщениеСсылка;
					СообщениеАрхива.ЗначениеСтрока 	= Стр.ИмяФайла; 
					СообщениеАрхива.ИмяРеквизита 	= Стр.Сообщение.ID;
					
				КонецЦикла;  
				
				НовыйАрхив.Записать();
				
			Иначе
				ОповеститьОбОшибках(РезультатОтправки);
			КонецЕсли;
		КонецЦикла;
		
		ПакетыСообщений.Очистить();
		
		УчетнаяЗаписьОбъект.Разблокировать();
		
		Метрика_ВремяОкончания = Метрика_ОтметкаВремени();
		СтруктураЗамера = Новый Структура("ZIPАрхивОтправлен", Метрика_Длительность(Метрика_ВремяНачала, Метрика_ВремяОкончания));
		Метрика_МассивСообщений.Добавить(СтруктураЗамера);
		
	КонецЦикла;
	
	Метрика_Переменные = Новый Структура;
	Метрика_Переменные.Вставить("КоличествоСообщений", 	НеотправленныеСообщения.Количество());	
	Метрика_Переменные.Вставить("МассивСообщений", 		Метрика_МассивСообщений);	
	Метрика_Переменные.Вставить("МассивGLN", 			Метрика_МассивGLN);	
	Метрика_ЗакончитьЗамер(Метрика_ИдЗамера, "ОтправитьСообщенияОжидающиеОтправкиПакетом", , , , Метрика_Переменные);
	
	Если МетрикаКонтур_ИспользоватьМетрики() Тогда
		
		УчетныеЗаписиОтправленныхСообщений = ЭДО_Кэш_Прочитать("УчетныеЗаписиОтправленныхСообщений");
		
		Если ТипЗнч(УчетныеЗаписиОтправленныхСообщений) = Тип("Соответствие") 
			И УчетныеЗаписиОтправленныхСообщений.Количество() Тогда
			
			Для Каждого ТекСтрока Из УчетныеЗаписиОтправленныхСообщений Цикл 
				
				МетрикаКонтур_ЗаписатьСобытие_ОтправкаИсходящегоСообщения(ТекСтрока.Ключ);	
				
			КонецЦикла;
			
			ЭДО_Кэш_Очистить("УчетныеЗаписиОтправленныхСообщений");
			
		КонецЕсли;  
		
	КонецЕсли;  
	
КонецПроцедуры

Функция ЗаблокироватьУчетнуюЗапись(УчетнаяЗаписьОбъект)
	
	ЗаблокированУспешно = Истина;
	Попытка
		
		УчетнаяЗаписьОбъект.Заблокировать(); 		
		
	Исключение 
		
		ЗаблокированУспешно = Ложь;
		ТекстКомментарияДляПользователя = "В другом сеансе уже выполняется отправка сообщений в архиве. Попробуйте позже";
		Сообщить_КонтурEDI(ТекстКомментарияДляПользователя);
		ТекстКомментарияДляЖурнала = ТекстКомментарияДляПользователя + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации_КонтурEDI(
			УровеньЖурналаРегистрации.Информация, ТекстКомментарияДляЖурнала, УчетнаяЗаписьОбъект.Ссылка);	
		
	КонецПопытки;
	
	Возврат ЗаблокированУспешно;
	
КонецФункции	

Функция ДвоичныеДанныеАрхива_КонтурEDI(ЗаписьZIP, ИмяZipФайла, УдалитьФайл = Истина)
	Если КонтурСтандарт_ДоступнаРаботаСПотоками() Тогда
		ДвоичныеДанные = ЗаписьZIP.ПолучитьДвоичныеДанные("", "", МетодСжатияZIP.Сжатие, УровеньСжатияZIP.Минимальный, МетодШифрованияZIP.Zip20);
	Иначе
		ЗаписьZIP.Записать();
		ДвоичныеДанные = Новый ДвоичныеДанные(ИмяZipФайла);
	КонецЕсли;
	
	Если УдалитьФайл Тогда 
		УдалитьФайлы_КонтурEDI(ИмяZipФайла);
	КонецЕсли;
	
	Возврат ДвоичныеДанные;
КонецФункции 

Функция НоваяЗаписьZipФайла_КонтурEDI(ИмяZipФайла)
	
	ЗаписьZIP = Неопределено;
	Если КонтурСтандарт_ДоступнаРаботаСПотоками() Тогда // Начиная с версии 8.3.10 доступна запись в поток в памяти
		ЗаписьZIP   = Новый ЗаписьZipФайла();	
	Иначе
		ИмяZipФайла =  мРабочийКаталог + ИмяZipФайла;
		
		ЗаписьZIP   = Новый ЗаписьZipФайла(ИмяZipФайла,
		"", 						// пароль на архив (оставим пустой)
		"", 						// комментарий к архиву
		МетодСжатияZIP.Сжатие, 		// сжатие или копирование
		УровеньСжатияZIP.Минимальный,
		МетодШифрованияZIP.Zip20);
	КонецЕсли;
	Возврат ЗаписьZIP;
	
КонецФункции

Функция НайтиИлиСоздатьОбъектХранилищеОтправленныхАрхивов_КонтурEDI(Знач ИдентификаторАрхива)
	
	ИдентификаторАрхива = СтрЗаменить(ИдентификаторАрхива,"-","");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтурEDI_ДополнительныеСправочники.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
	|ГДЕ
	|	КонтурEDI_ДополнительныеСправочники.Наименование = &ИдентификаторАрхива
	|	И КонтурEDI_ДополнительныеСправочники.ИмяСправочника = ""АрхивСообщений""";
	
	Запрос.УстановитьПараметр("ИдентификаторАрхива", ИдентификаторАрхива);
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Если Выборка.Следующий() Тогда   
		Возврат Выборка.Ссылка.ПолучитьОбъект();
	Иначе
		АрхивСообщенийСправочникОбъект 					= Справочники.КонтурEDI_ДополнительныеСправочники.СоздатьЭлемент(); 
		АрхивСообщенийСправочникОбъект.ИмяСправочника	= "АрхивСообщений";
		АрхивСообщенийСправочникОбъект.Наименование		= ИдентификаторАрхива;        
		
		Возврат АрхивСообщенийСправочникОбъект;
	КонецЕсли;
	
КонецФункции	

Функция ЭтоОбратнаяОтгрузка(ТипСообщения) Экспорт
	
	Если СтрСодержит_КонтурEDI("RETDES,RETREC", ТипСообщения) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ОпределитьКемМыЯвляемся(Сообщение) Экспорт
	
	РежимРаботыEDI = ПолучитьРежимРаботыПоНаправлениюСообщения(Сообщение.ТипСообщения, Сообщение.Направление);
	
	Если Не РежимРаботыEDI = Неопределено Тогда
		Возврат РежимРаботыEDI;
	КонецЕсли;
	
	ТипСообщения = Сообщение.ТипСообщения;
	МыПолучатель = (Сообщение.Направление = "Входящее");
		
	Если ТипСообщения = "DELFOR" ИЛИ ТипСообщения = "INVRPT" Тогда
		
		Если МыПолучатель Тогда
			РезультатКонвертацииПокупателя = КонвертироватьЗначениеEDIв1С(Сообщение.ПокупательEDI, "ЮрФизЛицо", "ЮрФизЛицоСвое");
			Если ЗначениеЗаполнено(РезультатКонвертацииПокупателя) Тогда
				Возврат "Покупатель";	
			Иначе
				Возврат "Поставщик";	
			КонецЕсли;
		Иначе	
			Если ПолучитьТип_КонтурEDI("ЮрФизЛицоСвое").СодержитТип(ТипЗнч(Сообщение.Покупатель1С)) Тогда
				Возврат "Покупатель"; 
			Иначе
				Возврат "Поставщик";	
			КонецЕсли;
		КонецЕсли;
		
	Иначе  
		
		Возврат ?(МыПолучатель, "Покупатель", "Поставщик");

	КонецЕсли;
	
КонецФункции

Функция ПолучитьРежимРаботыПоНаправлениюСообщения(ТипСообщения, Направление) Экспорт
	
	ОтборНаправлений = Новый Структура;
	ОтборНаправлений.Вставить("ТипСообщения", ТипСообщения);
	ОтборНаправлений.Вставить("Направление", Направление);
	
	ТаблицаНаправленийСообщений = ПолучитьТаблицуНаправленийСообщений();
	СтрокиТаблицыНаправлений = ТаблицаНаправленийСообщений.НайтиСтроки(ОтборНаправлений);
	
	Если СтрокиТаблицыНаправлений.Количество() = 1 Тогда
		Возврат СтрокиТаблицыНаправлений[0].РежимРаботы;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция МыЯвляемсяПродавцом(Сообщение) Экспорт
	
	МыПоставщик = ОпределитьКемМыЯвляемся(Сообщение) = "Поставщик";
	МыСеть		 = ОпределитьКемМыЯвляемся(Сообщение) = "Покупатель"; 
	ОбратнаяОтгрузка = ЭтоОбратнаяОтгрузка(Сообщение.ТипСообщения);
	
	Если (МыПоставщик И НЕ ОбратнаяОтгрузка)
		ИЛИ (МыСеть И ОбратнаяОтгрузка) Тогда 
		
		Возврат Истина;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции

Функция СообщениеСодержитУслуги(Сообщение) Экспорт
	
	Возврат (Сообщение.Товары.Колонки.Найти("ТипЕдиницы") <> Неопределено) 
				И (Сообщение.Товары.Найти("Services", "ТипЕдиницы") <> Неопределено);	
КонецФункции

Функция СообщениеСодержитТолькоУслуги(Сообщение) Экспорт
	
	Если СообщениеСодержитУслуги(Сообщение) Тогда
		СтрокиСУслугами = Сообщение.Товары.НайтиСтроки(Новый Структура("ТипЕдиницы", "Services"));
		КоличествоУслуг = СтрокиСУслугами.Количество();
	Иначе
		КоличествоУслуг = 0;	
	КонецЕсли;
	
	КоличествоТоваровВсего = Сообщение.Товары.Количество();
	
	Если НЕ КоличествоУслуг = 0 
		И КоличествоТоваровВсего = КоличествоУслуг Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция НужноПропуститьИсходящееСообщение(Сообщение) Экспорт
	
	Если Не Сообщение.Направление = "Исходящее" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НужноПропуститьСообщение = Ложь;
	
	Если НужноПропуститьСообщениеСУслугами_DESADV(Сообщение) Тогда
		НужноПропуститьСообщение = Истина;
	КонецЕсли;
	
	Возврат НужноПропуститьСообщение;
	
КонецФункции

Функция НужноПропуститьСообщениеСУслугами_DESADV(Сообщение) Экспорт
	
	Возврат Сообщение.ТипСообщения = "DESADV"
			И Сообщение.Направление = "Исходящее"
			И СообщениеСодержитТолькоУслуги(Сообщение)
			И ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, "РаботаСУслугами") = Истина
			И НЕ ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, "Отправлять_DESADV_НаУслуги") = Истина;
	
КонецФункции	

Функция МожноОтправитьВАрхиве()
	Возврат ПолучитьФункциональнуюОпциюEDI("PackageSendMessages", Ложь) И ПолучитьКонстантуEDI("ОтправлятьСообщенияПакетом") <> Ложь;
КонецФункции

Функция КоличествоСообщенийВОдномАрхиве()
	
	КоличествоСообщений = 100;
	КоличествоСообщений = ПолучитьФункциональнуюОпциюEDI("QuantityMessagesInPackage", КоличествоСообщений);
	Возврат КоличествоСообщений; 
	
КонецФункции	
//{{{СТАТУСЫ
//******************************************************************

Процедура ДобавитьЗначениеСтатуса(ТаблицаСтатусов,ИмяСтатуса,Значение)
	
	НоваяСтрока = ТаблицаСтатусов.Добавить();
	НоваяСтрока.ИмяСтатуса	= ИмяСтатуса;
	НоваяСтрока.Значение	= Значение;
	
КонецПроцедуры

Функция ПолучитьТаблицуСтатусовСообщений() Экспорт

	ТаблицаСтатусов = ЭДО_Кэш_Прочитать("ТаблицаСтатусовСообщений");
	
	Если ТаблицаСтатусов = Неопределено Тогда 
	
		ТаблицаСтатусов = Новый  ТаблицаЗначений;
		ТаблицаСтатусов.Колонки.Добавить("ИмяСтатуса");
		ТаблицаСтатусов.Колонки.Добавить("Значение");
		
		ТаблицаСтатусов.Индексы.Добавить("ИмяСтатуса");
		
		ДобавитьЗначениеСтатуса(ТаблицаСтатусов, "ИсходящийALCRPTОжидаетИсправленияОшибок",	 	"ALCRPT ожидает исправления ошибок");
		ДобавитьЗначениеСтатуса(ТаблицаСтатусов, "ВходящийОжидаетУстановкиСоответствий", 	 	"Ожидает установки соответствий");
		ДобавитьЗначениеСтатуса(ТаблицаСтатусов, "ВходящийОжидаетПриемки", 					 	"Ожидает приемки");
