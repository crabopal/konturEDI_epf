Процедура ПроверкаНовойВерсии_НастройкиПредварительныхЗаказов()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтурEDI_ДополнительныеСправочники.Ссылка,
	|	КонтурEDI_ДополнительныеСправочники.Наименование
	|ПОМЕСТИТЬ табПартнеры
	|ИЗ
	|	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
	|ГДЕ
	|	КонтурEDI_ДополнительныеСправочники.ИмяСправочника = ""Партнеры""
	|	И НЕ КонтурEDI_ДополнительныеСправочники.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	табПартнеры.Ссылка,
	|	ЕСТЬNULL(КонтурEDI_ДополнительныеРеквизиты.Значение, """") КАК КодСети,
	|	табПартнеры.Наименование
	|ИЗ
	|	табПартнеры КАК табПартнеры
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеРеквизиты
	|		ПО табПартнеры.Ссылка = КонтурEDI_ДополнительныеРеквизиты.Объект
	|			И (КонтурEDI_ДополнительныеРеквизиты.Свойство = ""КодСети"")";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		КодСети = ВыборкаДетальныеЗаписи.КодСети;
		Наименование = ВРег(ВыборкаДетальныеЗаписи.Наименование);
		
		Если КодСети = "220_Volt" Тогда
			
			СпособПоискаПредварительныхЗаказов = "Заказ не закрыт, дата заказа меньше даты основного заказа";
			СпособОбработкиПредварительныхЗаказов = "Закрыть";
			
		ИначеЕсли КодСети = "dns" Тогда
			
			СпособПоискаПредварительныхЗаказов = "Заказ не закрыт, дата заказа меньше даты основного заказа";
			СпособОбработкиПредварительныхЗаказов = "Корректировать";
			
		ИначеЕсли Найти(Наименование, "НЛМК") > 0 Тогда
			
			СпособПоискаПредварительныхЗаказов = "Номер предварительного заказа равен номеру основного заказа";
			СпособОбработкиПредварительныхЗаказов = "Привязать документ к основному заказу";
			
		Иначе
			
			СпособПоискаПредварительныхЗаказов = "Не искать";
			СпособОбработкиПредварительныхЗаказов = "Закрыть";
			
		КонецЕсли;
		
		УстановитьЗначениеСвойстваОбъекта(ВыборкаДетальныеЗаписи.Ссылка, "СпособПоискаПредварительныхЗаказов", СпособПоискаПредварительныхЗаказов);
		УстановитьЗначениеСвойстваОбъекта(ВыборкаДетальныеЗаписи.Ссылка, "СпособОбработкиПредварительныхЗаказов", СпособОбработкиПредварительныхЗаказов);
		
	КонецЦикла;

КонецПроцедуры

Процедура ПроверкаНовойВерсии_СпособПередачиМашиночитаемойДоверенности()
	
