//{{{ проверка конфигурации

Процедура ПроверитьДоступностьОбъекта(СписокОшибок, ПолноеИмя, ПравоЧтение =  Ложь, ПравоИзменение = Ложь, ПравоДобавление =  Ложь, ПравоУдаление =  Ложь) Экспорт
	
	ПозицияТочки 	= Найти(ПолноеИмя, 	".");
	ВидМетаданных 	= Лев(ПолноеИмя,	ПозицияТочки - 1);
	ИмяОбъекта 		= Сред(ПолноеИмя,	ПозицияТочки + 1);
	
	ОбъектМетаданных = Метаданные[ВидМетаданных].Найти(ИмяОбъекта);
	
	Если ОбъектМетаданных = Неопределено Тогда
		СписокОшибок.Добавить("В конфигурации отсутствует: " + ПолноеИмя);
	Иначе
		Если ПравоЧтение Тогда
			Если НЕ ПравоДоступа("Чтение", ОбъектМетаданных) Тогда
				СписокОшибок.Добавить("У вас недостаточно прав на чтение: " + ПолноеИмя);
			КонецЕсли;
		КонецЕсли;
		Если ПравоИзменение Тогда
			Если НЕ ПравоДоступа("Изменение", ОбъектМетаданных) Тогда
				СписокОшибок.Добавить("У вас недостаточно прав на изменение: " + ПолноеИмя);
			КонецЕсли;
		КонецЕсли;		
		Если ПравоДобавление Тогда
			Если НЕ ПравоДоступа("Добавление", ОбъектМетаданных) Тогда
				СписокОшибок.Добавить("У вас недостаточно прав на добавление: " + ПолноеИмя);
			КонецЕсли;
		КонецЕсли;
		Если ПравоУдаление Тогда
			Если НЕ ПравоДоступа("Удаление", ОбъектМетаданных) Тогда
				СписокОшибок.Добавить("У вас недостаточно прав на удаление: " + ПолноеИмя);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПроверитьСтруктуруДанных()
	
	ВариантХраненияДанных = "";
	
	СписокОшибок = Новый СписокЗначений;
	
	// проверим наличие "своих" объектов
	Если  ДобавленыСвоиОбъектыВКонфигурацию() Тогда
		
		ВариантХраненияДанных = "СвоиОбъекты";
		
	КонецЕсли;
	
	Если НЕ ВнешнееХранилище Тогда
	
		ПроверитьДоступностьОбъекта(СписокОшибок, "Справочники.КонтурEDI_Сообщения", 					Истина, Истина, Истина, Истина);
		ПроверитьДоступностьОбъекта(СписокОшибок, "Справочники.КонтурEDI_ТочкиДоставки", 				Истина, Истина, Истина, Истина);
		ПроверитьДоступностьОбъекта(СписокОшибок, "Справочники.КонтурEDI_ДополнительныеСправочники",	Истина, Истина, Истина, Истина);
		ПроверитьДоступностьОбъекта(СписокОшибок, "РегистрыСведений.КонтурEDI_СтатусыДокументов", 		Истина, Истина, Ложь, Ложь);
		ПроверитьДоступностьОбъекта(СписокОшибок, "РегистрыСведений.КонтурEDI_СоответствияТоваров", 	Истина, Истина, Ложь, Ложь);
		ПроверитьДоступностьОбъекта(СписокОшибок, "РегистрыСведений.КонтурEDI_ДополнительныеРеквизиты",	Истина, Истина, Ложь, Ложь);
		
	КонецЕсли;
		
	Возврат СписокОшибок;
	
КонецФункции

Функция ОпределитьРелизКонфигурации() Экспорт
			
	РелизКонфигурации1С = ЭДО_Кэш_Прочитать("РелизКонфигурации1С");
	
	Если РелизКонфигурации1С = Неопределено Тогда
		
		РелизКонфигурации1С = "";
		
		СинонимКонфигурации = Метаданные.Синоним;
		ВерсияКонфигурации 	= ВерсияКонфигурации1С_КонтурEDI();
		
		Если Найти(СинонимКонфигурации, "Бухгалтерия предприятия, редакция 3.0") > 0
			ИЛИ Найти(СинонимКонфигурации, "Бухгалтерия хлебобулочного и кондитерского предприятия, редакция 3") > 0 Тогда
			
			РелизКонфигурации1С = "3.0";
			
		ИначеЕсли Найти(СинонимКонфигурации, "Бухгалтерия предприятия КОРП, редакция 3.0") > 0 Тогда
			
			РелизКонфигурации1С = "3.0_КОРП";
			
		ИначеЕсли Найти(СинонимКонфигурации, "Бухгалтерия сельскохозяйственного предприятия") > 0 Тогда
			
			РелизКонфигурации1С = "3.0_СЕЛ";
			
		ИначеЕсли Найти(СинонимКонфигурации, "Бухгалтерия предприятия, редакция 1.6") > 0 Тогда
			
			РелизКонфигурации1С = "1.6";
			
		ИначеЕсли Найти(СинонимКонфигурации, "Управление торговлей алкогольной продукцией") > 0 
				И Найти(СинонимКонфигурации, "редакция 11") > 0 Тогда
			
			Если ВерсияКонфигурации.Основная = 11 Тогда
				Если ВерсияКонфигурации.Младшая = 1 Тогда
					РелизКонфигурации1С = "11.1";
				ИначеЕсли ВерсияКонфигурации.Младшая >= 2 Тогда
					РелизКонфигурации1С = "11.2";
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли Найти(СинонимКонфигурации, "Управление торговлей, редакция 11") > 0 
			ИЛИ Найти(СинонимКонфигурации, "Управление торговлей (базовая), редакция 11") > 0 Тогда
			
			Если ВерсияКонфигурации.Основная = 11 Тогда
				Если ВерсияКонфигурации.Младшая = 0 Тогда
					РелизКонфигурации1С = "11.0";
				ИначеЕсли ВерсияКонфигурации.Младшая = 1 Тогда
					РелизКонфигурации1С = "11.1";
				ИначеЕсли ВерсияКонфигурации.Младшая >= 2 Тогда
					РелизКонфигурации1С = "11.2";
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли Найти(СинонимКонфигурации, "Управление торговлей и взаимоотношениями с клиентами") > 0 Тогда
			
			ПодробнаяИнформация = Метаданные.ПодробнаяИнформация;
			
			Если Найти(ПодробнаяИнформация, "1С:Управление торговлей (11") > 0 Тогда
				Если Найти(ПодробнаяИнформация, "1С:Управление торговлей (11.0") > 0 Тогда
					РелизКонфигурации1С = "11.0";
				ИначеЕсли Найти(ПодробнаяИнформация, "1С:Управление торговлей (11.1") > 0 Тогда
					РелизКонфигурации1С = "11.1";
				Иначе
					РелизКонфигурации1С = "11.2";
				КонецЕсли;
			ИначеЕсли Найти(ПодробнаяИнформация, "редакция 2.0") > 0  Тогда
				РелизКонфигурации1С = "11.2";
			КонецЕсли;  
			
		ИначеЕсли Найти(СинонимКонфигурации, "Управление предприятием 2.0") > 0 Тогда // на базе той же БСП что и УТ11  (Это ERP2.0)
			
			РелизКонфигурации1С = "11.1";
			
		ИначеЕсли Найти(СинонимКонфигурации, "Агропромышленный комплекс 2.0") > 0 Тогда // на базе той же БСП что и УТ11
			
			РелизКонфигурации1С = "11.1";    
			
		ИначеЕсли Найти(СинонимКонфигурации, "Комплексная автоматизация 2") > 0
			ИЛИ Найти(СинонимКонфигурации, "Управление предприятием 2") > 0
			ИЛИ Найти(СинонимКонфигурации, "Управление птицеводческим предприятием 2") > 0
			ИЛИ (Найти(СинонимКонфигурации, "Агропромышленный комплекс") > 0 И ВерсияКонфигурации.Основная = 2 И ВерсияКонфигурации.Младшая >= 1) Тогда
			 //конфигурации на базе той же БСП что и УТ11.2 (Это ERP 2.1 и основанные на ней)
			 
			РелизКонфигурации1С = "11.2";

		ИначеЕсли (Найти(СинонимКонфигурации, "Управление холдингом") И ВерсияКонфигурации.Основная = 3) Тогда 

			Если ИмяКонфигурации1С = "УФ_БП" Тогда
				РелизКонфигурации1С = "3.0";
			Иначе 
				РелизКонфигурации1С = "11.2";		
			КонецЕсли;	
			
		ИначеЕсли Найти(СинонимКонфигурации, "Управление небольшой фирмой") > 0
			ИЛИ Найти(СинонимКонфигурации, "Управление нашей фирмой") > 0
			ИЛИ Найти(СинонимКонфигурации, "Управление нашим пищевым производством") > 0
			ИЛИ Найти(СинонимКонфигурации, "Управление нашим хлебобулочным и кондитерским предприятием") > 0
			ИЛИ Найти(СинонимКонфигурации, "Управление предприятием общепита") > 0 Тогда
			
			Если ВерсияКонфигурации.Основная = 1 Тогда
				Если ВерсияКонфигурации.Младшая = 4 Тогда
					РелизКонфигурации1С = "1.4";
				ИначеЕсли ВерсияКонфигурации.Младшая = 5 Тогда
					РелизКонфигурации1С = "1.5";
				ИначеЕсли ВерсияКонфигурации.Младшая >= 6 Тогда
					РелизКонфигурации1С = "1.6";
				КонецЕсли;
			ИначеЕсли ВерсияКонфигурации.Основная = 3 Тогда
				РелизКонфигурации1С = "1.6";
			КонецЕсли;
		ИначеЕсли Найти(СинонимКонфигурации, "Розница, редакция 3.0") > 0 Тогда	
				РелизКонфигурации1С = "1.6";			
		ИначеЕсли ИмяКонфигурации1С = "УФ_УТ" 
			И (ВерсияКонфигурации.Основная = 2 И ВерсияКонфигурации.Младшая >= 1
			ИЛИ ВерсияКонфигурации.Основная = 11 И ВерсияКонфигурации.Младшая >= 2) Тогда
			
			РелизКонфигурации1С = "11.2";
			
		КонецЕсли;
		
		ЭДО_Кэш_Поместить("РелизКонфигурации1С", РелизКонфигурации1С);
		
	КонецЕсли;
	
	Возврат РелизКонфигурации1С;
	
КонецФункции  

Функция ОпределитьРелиз_УправлениеТорговлей11() Экспорт
	
	Релиз_УправлениеТорговлей11 = ЭДО_Кэш_Прочитать("Релиз_УправлениеТорговлей11");
	
	Если Релиз_УправлениеТорговлей11 = Неопределено Тогда
		
		Попытка
			Релиз_УправлениеТорговлей11 = ОпределитьВерсиюПодсистемыБСП_КонтурEDI("УправлениеТорговлей");
		Исключение
			Релиз_УправлениеТорговлей11 = Неопределено;
		КонецПопытки;
		
		Если Релиз_УправлениеТорговлей11 = Неопределено Тогда
			Релиз_УправлениеТорговлей11 = ОпределитьРелизКонфигурации();
		КонецЕсли; 		
		
		ЭДО_Кэш_Поместить("Релиз_УправлениеТорговлей11", Релиз_УправлениеТорговлей11);
		
	КонецЕсли; 	
	
	Возврат Релиз_УправлениеТорговлей11;
	
КонецФункции

Функция ОпределитьВерсиюПодсистемыБСП_КонтурEDI(ИмяПодсистемы) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВерсииПодсистем.Версия КАК Версия
	|ИЗ
	|	РегистрСведений.ВерсииПодсистем КАК ВерсииПодсистем
	|ГДЕ
	|	ВерсииПодсистем.ИмяПодсистемы = &ИмяПодсистемы";
	
	Запрос.УстановитьПараметр("ИмяПодсистемы", ИмяПодсистемы);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВерсияПодсистемы = Неопределено;
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			
			ВерсияПодсистемы = ВыборкаДетальныеЗаписи.Версия;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ВерсияПодсистемы;
	
КонецФункции

Функция ОпределитьКонфигурацию() Экспорт
	
	СинонимКонфигурации = Метаданные.Синоним;
	ПодробнаяИнформация = Метаданные.ПодробнаяИнформация;
	ВерсияКонфигурации	= Метаданные.Версия;
	
	ИмяКонфигурации1С = Неопределено;
	
	Если Найти(СинонимКонфигурации,"ТКПТ") > 0 Тогда
		
		ИмяКонфигурации1С = "ТКПТ";
		
	ИначеЕсли Найти(СинонимКонфигурации, "Торговый дом 7") > 0
		  ИЛИ Найти(СинонимКонфигурации, "Торговый дом 6") > 0 Тогда
		
		ИмяКонфигурации1С = "АСТОР";
		
	ИначеЕсли Найти(СинонимКонфигурации, "Хлебобулочное и кондитерское производство (Управление сбытом продукции)") > 0 Тогда
		
		ИмяКонфигурации1С = "ХБКП_УСП";
		
	ИначеЕсли Найти(СинонимКонфигурации, "Управление производственным предприятием") > 0
		ИЛИ Найти(СинонимКонфигурации, "1С:Хлебобулочное и кондитерское производство, редакция 1.3") > 0
		ИЛИ Найти(СинонимКонфигурации, "Управление проектной организацией") > 0
		ИЛИ Найти(СинонимКонфигурации, "Ликероводочный и винный завод") > 0
		ИЛИ Найти(СинонимКонфигурации, "1С: Спиртовое производство") > 0      
		ИЛИ Найти(СинонимКонфигурации, "1С:Молокозавод") > 0
		ИЛИ Найти(СинонимКонфигурации, "Мясокомбинат, редакция 1.3") > 0
		ИЛИ Найти(СинонимКонфигурации, "Управление птицефабрикой, редакция 1.3") > 0 
		ИЛИ Найти(НРег(СинонимКонфигурации), "управление сельскохозяйственным предприятием") > 0 //схожа с УПП
		ИЛИ Найти(СинонимКонфигурации, "Комплексный учет сельскохозяйственного предприятия") > 0 
		Тогда 
		
		ИмяКонфигурации1С = "УПП";
		
	ИначеЕсли Найти(СинонимКонфигурации, "Хлебобулочное и кондитерское производство") > 0 
		И Найти(СинонимКонфигурации, "(2") > 0 Тогда
		
		ИмяКонфигурации1С = "ХБКП_УСП_2";
		
	ИначеЕсли (Найти(СинонимКонфигурации, "Комплексная автоматизация") > 0 И Лев(ВерсияКонфигурации, 1) >= "2") //Управляемая На базе той же бсп что и УТ11.2
		ИЛИ Найти(СинонимКонфигурации, "1С:ERP") > 0
		ИЛИ Найти(СинонимКонфигурации, "Управление предприятием 2") > 0
		ИЛИ Найти(СинонимКонфигурации, "Агропромышленный комплекс 2") > 0
		ИЛИ (Найти(СинонимКонфигурации, "Агропромышленный комплекс") > 0 И Лев(ВерсияКонфигурации, 1) >= "2")
		ИЛИ Найти(СинонимКонфигурации, "Управление птицеводческим предприятием 2") > 0
		ИЛИ Найти(СинонимКонфигурации, "Управление торговлей и взаимоотношениями с клиентами (CRM)") > 0 И Найти(СинонимКонфигурации, "редакция 2") > 0 Тогда 
		
		ИмяКонфигурации1С = "УФ_УТ";
		
	ИначеЕсли Найти(СинонимКонфигурации, "Комплексная автоматизация") > 0 Тогда
		
		ИмяКонфигурации1С = "КА";
		
	ИначеЕсли Найти(СинонимКонфигурации, "Бухгалтерия Универсал, редакция 3") > 0
		ИЛИ (Найти(СинонимКонфигурации, "Управление холдингом") > 0  И  Лев(ВерсияКонфигурации, 1) >= "3")
		ИЛИ Найти(СинонимКонфигурации, "Бухгалтерия сельскохозяйственного предприятия, редакция 3") > 0 
		ИЛИ Найти(СинонимКонфигурации, "Бухгалтерия сельскохозяйственного предприятия КОРП, редакция 3.0") > 0 
		ИЛИ (Найти(СинонимКонфигурации, "Трактир") > 0 И Найти(СинонимКонфигурации, "Head") = 0 И Найти(СинонимКонфигурации, "3") > 0) //Управляемый  Трактиръ: Back-Office  3.0 на базе БП
		ИЛИ Найти(СинонимКонфигурации, "Бухгалтерия предприятия, редакция 3") > 0  
		ИЛИ Найти(СинонимКонфигурации, "Бухгалтерия предприятия КОРП, редакция 3") > 0  
		ИЛИ Найти(СинонимКонфигурации, "Управление корпоративными финансами, редакция 3") > 0  
		ИЛИ (Найти(СинонимКонфигурации, "Общепит") > 0 И Лев(ВерсияКонфигурации, 1) >= "3")  
		ИЛИ Найти(СинонимКонфигурации, "Бухгалтерия молокозавода, редакция 3") > 0 
		ИЛИ Найти(СинонимКонфигурации, "Бухгалтерия птицефабрики, редакция 3") > 0 
		ИЛИ Найти(СинонимКонфигурации, "Бухгалтерия хлебобулочного и кондитерского предприятия, редакция 3") > 0 Тогда		
		
		ИмяКонфигурации1С = "УФ_БП"; 
		
	ИначеЕсли Найти(СинонимКонфигурации, "Бухгалтерия предприятия, редакция 2") > 0
		ИЛИ (Найти(СинонимКонфигурации, "Трактир") > 0 И Найти(СинонимКонфигурации, "Head") = 0) 
		ИЛИ Найти(СинонимКонфигурации, "Бухгалтерия сельскохозяйственного предприятия") > 0 
		ИЛИ Найти(СинонимКонфигурации, "Бухгалтерия предприятия, редакция 1.6") > 0 
		ИЛИ (Найти(СинонимКонфигурации, "Общепит") > 0 И Лев(ВерсияКонфигурации, 1) = "2") Тогда

		ИмяКонфигурации1С = "БП";

	ИначеЕсли Найти(СинонимКонфигурации, "Управление небольшой фирмой") > 0
		ИЛИ Найти(СинонимКонфигурации, "Управление нашей фирмой") > 0
		ИЛИ Найти(СинонимКонфигурации, "Управление нашим пищевым производством") > 0
		ИЛИ Найти(СинонимКонфигурации, "Розница, редакция 3.0") > 0
		ИЛИ Найти(СинонимКонфигурации, "Управление нашим хлебобулочным и кондитерским предприятием") > 0
		ИЛИ Найти(СинонимКонфигурации, "Управление предприятием общепита") > 0 Тогда

		ИмяКонфигурации1С = "УФ_УНФ";
		
	ИначеЕсли Найти(НРег(СинонимКонфигурации), "управление торговлей") > 0 Тогда
		
		Если Найти(СинонимКонфигурации, "10.2") > 0 Тогда

			ИмяКонфигурации1С = "УТ_10_2";
			
		ИначеЕсли Найти(СинонимКонфигурации, "10.3") > 0 Тогда
			
			ИмяКонфигурации1С = "УТ_10_3";
			
		ИначеЕсли Найти(СинонимКонфигурации, "11") > 0 ИЛИ Найти(ПодробнаяИнформация, "1С:Управление торговлей (11") > 0 Тогда
			
			ИмяКонфигурации1С = "УФ_УТ";
					
		КонецЕсли;
		
	ИначеЕсли Найти(НРег(СинонимКонфигурации), "хлебобулочное и кондитерское производство") > 0 Тогда
		
		ИмяКонфигурации1С = "ХлебУСП";
		
	ИначеЕсли Найти(НРег(СинонимКонфигурации), "розница, редакция 1.0") > 0 Тогда
		
		ИмяКонфигурации1С = "Розница";
		
	ИначеЕсли Найти(СинонимКонфигурации, "Розница, редакция 2.2") > 0
		ИЛИ Найти(СинонимКонфигурации, "Розница, редакция 2.3") > 0
		ИЛИ Найти(СинонимКонфигурации, "Розница 8. Ювелирный магазин, редакция 2.3") > 0 Тогда
		 
		ИмяКонфигурации1С = "УФ_Розница";
		
	ИначеЕсли Найти(СинонимКонфигурации, "RIT:Дистрибуция") > 0 Тогда

		ИмяКонфигурации1С = "RIT";
		
	ИначеЕсли Найти(СинонимКонфигурации, "ДАЛИОН: Управление магазином") > 0 
			ИЛИ (Найти(СинонимКонфигурации, "Трактиръ") > 0 И Найти(СинонимКонфигурации, "Head") > 0) Тогда
		
		ИмяКонфигурации1С = "ДалионУМ";
		
	ИначеЕсли Найти(СинонимКонфигурации, "ДАЛИОН: ТРЕНД, редакция") > 0 Тогда
		
		Если Лев(ВерсияКонфигурации, 1) >= "3" Тогда
			ИмяКонфигурации1С = "УФ_ДалионТРЕНД";		
		Иначе	
			ИмяКонфигурации1С = "ДалионТРЕНД";
		КонецЕсли;  
		
	ИначеЕсли Найти(СинонимКонфигурации, "Штрих-М: Розничная сеть, редакция 5") > 0 Тогда
		
		ИмяКонфигурации1С = "ШтрихМ_РС";
		
	Иначе
		
		Если Найти(ВРег(Метаданные.Поставщик), "ОМЕГА ИНК") > 0 Тогда
			
			ИмяКонфигурации1С = "УТ_10_2";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если (НЕ ЗначениеЗаполнено(ИмяКонфигурации1С)) Тогда
		Попытка
			//не проверены объекты (если это первый запуск)  - дешевле завернуть в попытку, чем ходить за метаданными
			ИмяКонфигурации1С = ПолучитьКонстантуEDI("ИмяКонфигурации1С");
		Исключение
			ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось получить Имя Конфигурации 1С - " + ОписаниеОшибки());	
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат ИмяКонфигурации1С;
	
КонецФункции

Функция ВерсияПлатформы1С()
	
	Результат = "";

	Попытка
		СистемнаяИнформация = Новый СистемнаяИнформация;
		Результат = СистемнаяИнформация.ВерсияПриложения;
	Исключение
		_ОписаниеОшибки = ОписаниеОшибки();	
	КонецПопытки;	
		
	Возврат Результат;	
	
КонецФункции

Функция ДоменПользователяКонтур()
	
	Результат = Ложь;     
		
	ДоменПользователя = ВРег(ПолучитьЗначениеПеременнойСреды("USERDOMAIN"));
	
	Если ЗначениеЗаполнено(ДоменПользователя) Тогда
		Результат = Найти(ДоменПользователя, "KONTUR") > 0;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьЗначениеПеременнойСреды(Имя)
	
	Результат = Неопределено;
	
	Попытка
		
		Информация = Новый СистемнаяИнформация;	
		Если Найти(НРег(Информация.ТипПлатформы), "windows") Тогда
			WshShell	= Новый COMobject("wscript.shell");
	    	Результат	= WshShell.ExpandEnvironmentStrings("%"+Имя+"%");
		Иначе	
			Результат = Неопределено;	
		КонецЕсли;		
		
	Исключение
		
		_ОписаниеОшибки = ОписаниеОшибки();
		ТекстСообщения = 	"Не удалось получить значение переменной окружения <%1> по причине:
							|	" + _ОписаниеОшибки;
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%1", Имя);
		
	КонецПопытки;
		
	Если Результат = Неопределено Тогда
		
		ТекстСообщения = "Переменная окружения <%1> не найдена";
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%1", Имя);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоУФ() Экспорт
	
	ЭтоУФ = Ложь;
	Если Лев(ИмяКонфигурации1С, 3) = "УФ_" Тогда
		ЭтоУФ = Истина;		
	КонецЕсли;
	
	Возврат ЭтоУФ;
	
КонецФункции

Функция ЭтоВозвратТоваровОтКлиентаУФ_УТ(Документ) 
	Если ЕстьНеобходимыеМетаданные("Документы.ВозвратТоваровОтКлиента",Истина) И ИмяКонфигурации1С = "УФ_УТ" Тогда
		Возврат ТипЗнч(Документ) = Тип("ДокументСсылка.ВозвратТоваровОтКлиента");
	Иначе 
		Возврат Ложь;
	КонецЕсли;  
КонецФункции	

