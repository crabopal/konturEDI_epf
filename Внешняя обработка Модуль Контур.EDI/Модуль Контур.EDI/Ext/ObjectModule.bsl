// #Область Автотесты
	
Процедура Автотесты_ОчиститьДанныеМодуля() Экспорт
	
	// во избежание случайного вызова
	Если НЕ ЗначениеЗаполнено(ПараметрыАвтотестирования) Тогда
		Возврат;
	КонецЕсли;
	
	Если ВнешнееХранилище Тогда
		
		СправочникиДляУдаления = СоединениеСХранилищем.Справочники;
		РегистрыСведенияДляУдаления = СоединениеСХранилищем.РегистрыСведений;
		
	Иначе
		
		СправочникиДляУдаления = Справочники;
		РегистрыСведенияДляУдаления = РегистрыСведений;
		
	КонецЕсли;
	
	Выб=СправочникиДляУдаления.КонтурEDI_ДополнительныеСправочники.Выбрать();
	Пока Выб.Следующий() Цикл
		Об=Выб.ПолучитьОбъект();
		Об.Удалить();//да, так сурово
	КонецЦикла;	
	
	Выб=СправочникиДляУдаления.КонтурEDI_Сообщения.Выбрать();
	Пока Выб.Следующий() Цикл
		Об=Выб.ПолучитьОбъект();
		Об.Удалить();//да, так сурово
	КонецЦикла;	
	
	Выб=СправочникиДляУдаления.КонтурEDI_ТочкиДоставки.Выбрать();
	Пока Выб.Следующий() Цикл
		Об=Выб.ПолучитьОбъект();
		Об.Удалить();//да, так сурово
	КонецЦикла;	
	
	НЗ=РегистрыСведенияДляУдаления.КонтурEDI_ДополнительныеРеквизиты.СоздатьНаборЗаписей();
	НЗ.Записать();
	
	НЗ=РегистрыСведенияДляУдаления.КонтурEDI_СоответствияТоваров.СоздатьНаборЗаписей();
	НЗ.Записать();
	
	НЗ=РегистрыСведенияДляУдаления.КонтурEDI_СтатусыДокументов.СоздатьНаборЗаписей();
	НЗ.Записать();
	
КонецПроцедуры

Процедура Автотесты_УстановитьНачальныеНастройки(ВладелецФормы = Неопределено) Экспорт
	
	// 1. Удаляем все настройки и сообщения
	Автотесты_ОчиститьДанныеМодуля();
	
	ВариантОбмена = ПараметрыАвтотестирования.Настройки.ВариантОбменаДанными;
	
	УстановитьКонстантуEDI("ПротоколОбмена_КонтурEDI",	ВариантОбмена.Вид);
	УстановитьКонстантуEDI("Сервер",					ВариантОбмена.Сервер);
	УстановитьКонстантуEDI("Порт",						21);
	УстановитьКонстантуEDI("АдресКаталогаОбменаEDI",	ВариантОбмена.ПутьККаталогу);
	
	// 2. Устанавливаем настройки структуры компании
	ПолучитьФорму("ФормаСтруктураКомпании_Элемент", ВладелецФормы).ОткрытьМодально();
	
	// 3. Устанавливаем настройки модуля
	ПолучитьФорму("ФормаСервис_Настройка", ВладелецФормы).ОткрытьМодально();
	
	// 4. Устанавливаем настройки партнеров
	ПолучитьФорму("ФормаПартнеры_Элемент", ВладелецФормы).ОткрытьМодально();
	
	// 5. Устанавливаем учетные записи (может в структуру компании их добавить?)
	ПолучитьФорму("ФормаУчетныеЗаписи_Элемент", ВладелецФормы).ОткрытьМодально();
	
	// 6. Получаем выполняемый код
	
	Действия = Новый ТаблицаЗначений;
	Действия.Колонки.Добавить("ФормаОбработки");
	Действия.Колонки.Добавить("ВыполняемыйКод");
	Действия.Колонки.Добавить("Выполнено");
	
	Текст = Новый ТекстовыйДокумент;
	Текст.Прочитать(ПараметрыАвтотестирования.КаталогСценария+"\in\source.txt");
	
	ТекстКода	= "";
	НоваяСтрока = Неопределено;

	Для н = 1 По Текст.КоличествоСтрок() Цикл
		
		ТекСтрока = Текст.ПолучитьСтроку(н);
		
		Если СокрЛП(ТекСтрока) = "************НОВЫЙ_ШАГ" Тогда
			
			Если НЕ ТекстКода = "" Тогда
				НоваяСтрока.ВыполняемыйКод = ТекстКода;
			КонецЕсли;
			
			ТекстКода = "";
			
			НоваяСтрока = Действия.Добавить();
			НоваяСтрока.Выполнено = Ложь;
			
			Продолжить;
			
		КонецЕсли;
		
		Если НоваяСтрока = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.ФормаОбработки) Тогда
			
			НоваяСтрока.ФормаОбработки = СокрЛП(ТекСтрока);
			ТекстКода = "";
			
			Продолжить;
			
		КонецЕсли;
			
		ТекстКода = ТекстКода + Символы.ПС+ " " + ТекСтрока;	

	КонецЦикла;
	
	Если НЕ ТекстКода = "" Тогда
		НоваяСтрока.ВыполняемыйКод = ТекстКода;
	КонецЕсли;
	
	ПараметрыАвтотестирования.Вставить("ВыполняемыеДействия",	Действия);
	
	// инициализируем результаты выполнения
	РезультатВыполненияСценария = Новый ТаблицаЗначений();
	РезультатВыполненияСценария.Колонки.Добавить("Имя");
	РезультатВыполненияСценария.Колонки.Добавить("Тип");
	РезультатВыполненияСценария.Колонки.Добавить("Значение");
	
	ПараметрыАвтотестирования.Вставить("РезультатВыполненияСценария",РезультатВыполненияСценария);
	
	ТекстЛога = Новый ТекстовыйДокумент;
	ТекстЛога.Записать(ПараметрыАвтотестирования.КаталогСценария+"\out\log.txt");
	
КонецПроцедуры

Процедура Автотесты_ЗаменитьПеременныеПоШаблону(ТекСообщение)
	
	Для Каждого ПолеСообщения Из ТекСообщение Цикл
		Если НЕ ПолеСообщения.Ключ = "Товары" Тогда
			Если Найти(СокрЛП(ПолеСообщения.Значение),"{**")>0 Тогда
				ШаблонПоляСообщения = СокрЛП(ПолеСообщения.Значение);
				Для Каждого ПолеПеременной Из ПараметрыАвтотестирования.Настройки.Переменные Цикл
					ШаблонПеременной = ПолеПеременной.Значение.Шаблон;
					Если ШаблонПоляСообщения = ШаблонПеременной Тогда
						ТекСообщение[ПолеСообщения.Ключ] = ПолеПеременной.Значение.Значение;
						Прервать;
					КонецЕсли;	
				КонецЦикла;
			КонецЕсли;			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция Автотесты_ПолучитьНовыйИдентификаторСообщения() 
	
	УИД = Новый УникальныйИдентификатор();
	УИД = СтрЗаменить(УИД,"-","");
	
	Возврат УИД;
	
КонецФункции

Функция Автотесты_ОтправитьТестовоеСообщение(ИмяСообщения) Экспорт
	
	ВходящиеДанные = ПараметрыАвтотестирования.Настройки.ВходящиеДанные;
	
	НайденноеСообщение = Неопределено;
	Для Каждого Стр Из ВходящиеДанные Цикл
		Если Стр.Имя = ИмяСообщения Тогда
			НайденноеСообщение = Стр;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НайденноеСообщение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекСообщение = НайденноеСообщение.Значение;
	Автотесты_ЗаменитьПеременныеПоШаблону(ТекСообщение);
	
	Сообщение = ПолучитьСтруктуруСообщения(ТекСообщение.ТипСообщения,"Исходящее");
	Сообщение.ТипСообщения		= ТекСообщение.ТипСообщения;
	Сообщение.Направление		= "Исходящее";
	Сообщение.ID = Автотесты_ПолучитьНовыйИдентификаторСообщения();
	
	Сообщение.ПокупательEDI.GLN = ТекСообщение.Покупатель;
	Сообщение.ПродавецEDI.GLN = ТекСообщение.Поставщик;
	Сообщение.ГрузополучательEDI.GLN = ТекСообщение.Грузополучатель;
	
	Сообщение.ДокументEDI.Номер = ТекСообщение.НомерДокумента;
	Сообщение.ДокументEDI.Дата = ТекСообщение.ДатаДокумента;
	
	Если Сообщение.ТипСообщения = "ORDERS" Тогда
		Сообщение.ОбратныйЗаказEDI.Номер	= ТекСообщение.НомерОбратногоЗаказа;
		Сообщение.ОбратныйЗаказEDI.Дата		= ТекСообщение.ДатаОбратногоЗаказа;
	КонецЕсли;
	
	Сообщение.ЗаказEDI.Номер = ТекСообщение.НомерЗаказа;
	Сообщение.ЗаказEDI.Дата = ТекСообщение.ДатаЗаказа;
	
	Сообщение.НакладнаяEDI.Номер = ТекСообщение.НомерНакладной;
	Сообщение.НакладнаяEDI.Дата = ТекСообщение.ДатаНакладной;
	
	Сообщение.ВалютаEDI = "RUB";
	
	Сообщение.Статус = ТекСообщение.Статус;
	
	Сообщение.ОтправительEDI.GLN = СокрЛП(ПараметрыАвтотестирования.Настройки.Партнер.GLN);
	Сообщение.ПолучательEDI.GLN = СокрЛП(ПараметрыАвтотестирования.Настройки.СтруктураКомпании.GLN);
	
	Для Каждого СтрокаТоваров Из ТекСообщение.Товары Цикл
		
		НоваяСтрока = Сообщение.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаТоваров);
		НоваяСтрока.КодЕдиницыИзмеренияEDI = СтрокаТоваров.КодЕдиницыИзмерения;
		НоваяСтрока.СтавкаНДСEDI = СтрокаТоваров.СтавкаНДС;
		
	КонецЦикла;
	
	РезультатКонвертации = КонвертироватьИсходящееСообщениеПоНовому(Сообщение);
	
	ТекПутьККаталогу = ПараметрыАвтотестирования.Настройки.ВариантОбменаДанными.ПутьККаталогу;
	Если ЗначениеЗаполнено(ТекПутьККаталогу) Тогда
		ПереместитьФайл(РезультатКонвертации.ПутьКФайлу,ТекПутьККаталогу+"\inbox\"+ИмяСообщения+"_"+СокрЛП(Сообщение.ДокументEDI.Номер)+".xml")
	КонецЕсли;
	
КонецФункции

Процедура Автотесты_ДобавитьЗаписьВЛог(Текст) Экспорт
	
	ТекстЛога = Новый ТекстовыйДокумент;
	ТекстЛога.Прочитать(ПараметрыАвтотестирования.КаталогСценария+"\out\log.txt");
	ТекстЛога.ДобавитьСтроку(Текст);
	ТекстЛога.Записать(ПараметрыАвтотестирования.КаталогСценария+"\out\log.txt");
		
КонецПроцедуры

Процедура Автотесты_УстановитьЗначениеПеременной(Имя,Значение,Шаблон) Экспорт
	
	СтруктураПеременной = Новый Структура();
	
	СтруктураПеременной.Вставить("Имя", 	Имя);
	СтруктураПеременной.Вставить("Значение",Значение);
	СтруктураПеременной.Вставить("Шаблон",	Шаблон);

	ПараметрыАвтотестирования.Настройки.Переменные.Вставить(Имя,СтруктураПеременной);
	
КонецПроцедуры

Процедура Автотесты_ЗавершитьВыполнениеТестирования(Флаг) Экспорт
	
	Если Флаг = "fail" Тогда
		ПараметрыАвтотестирования.ВыполняемыеДействия.Очистить();
	КонецЕсли;	
		
	СтруктураВыполнения = Новый Структура;
	СтруктураВыполнения.Вставить("РезультатВыполнения",ПараметрыАвтотестирования.РезультатВыполненияСценария);
	СтруктураВыполнения.Вставить("Переменные",ПараметрыАвтотестирования.Настройки.Переменные);
	
	ФайлРезультата = Новый ТекстовыйДокумент;
	ФайлРезультата.УстановитьТекст(ЗначениеВСтрокуВнутр(СтруктураВыполнения));
	ФайлРезультата.Записать(ПараметрыАвтотестирования.КаталогСценария+"\out\result.txt");
	
	ПутьКФайлу = ПараметрыАвтотестирования.КаталогСценария+"\out\"+Флаг+".txt";

	Текст = Новый ТекстовыйДокумент;
	Текст.Записать(ПутьКФайлу);
	
КонецПроцедуры

Процедура Автотесты_УдалитьПоследниеДокументы(ВидДокумента) Экспорт
	
	// во избежание случайного вызова
	Если НЕ ЗначениеЗаполнено(ПараметрыАвтотестирования) Тогда
		Возврат;
	КонецЕсли;
	
	Если Метаданные.Документы.Найти(ВидДокумента) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Документ.Ссылка
		|ИЗ
		|	Документ."+ВидДокумента+" КАК Документ
		|ГДЕ
		|	Документ.Дата >= &ТекущаяДата";

	Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ТекущаяДата()));

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл

		Попытка
			ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект().Удалить();
		Исключение
			ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект().УстановитьПометкуУдаления(Истина);
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Функция Автотесты_ПолучитьПустуюСтруктуруДокументаАвтотестирования()
	
	Структура = Новый Структура("Контрагент,Грузополучатель,Организация,Грузоотправитель,СуммаВклНДС");
	
	ТаблицаТоваров = Новый ТаблицаЗначений;
	ТаблицаТоваров.Колонки.Добавить("Номенклатура");
	ТаблицаТоваров.Колонки.Добавить("Единица");
	ТаблицаТоваров.Колонки.Добавить("Количество");
	ТаблицаТоваров.Колонки.Добавить("Цена");
	ТаблицаТоваров.Колонки.Добавить("СуммаНДС");
	ТаблицаТоваров.Колонки.Добавить("СтавкаНДС");
	ТаблицаТоваров.Колонки.Добавить("Сумма");
	
	Структура.Вставить("Товары",ТаблицаТоваров);
	
	Возврат Структура;
	
КонецФункции

Функция Автотесты_ПолучитьПустуюСтруктуруСообщенияАвтотестирования()
	
	Структура = Новый Структура("ТипСообщения,Покупатель,Поставщик,Грузополучатель,НомерДокумента,ДатаДокумента,НомерЗаказа,ДатаЗаказа,НомерОтветаНаЗаказ,ДатаОтветаНаЗаказ,НомерОтгрузки,ДатаОтгрузки,НомерПриемки,ДатаПриемки,НомерСчетаФактуры,ДатаСчетаФактуры,СуммаБезНДС,СуммаНДС,СуммаСНДС,Статус");
	
	ТаблицаТоваров = Новый ТаблицаЗначений;
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваров,
		"GTIN
		|КодТовараПартнера
		|Наименование
		|Количество
		|КодЕдиницыИзмерения
		|ЦенаБезНДС
		|ЦенаСНДС
		|СтавкаНДС
		|СуммаБезНДС
		|СуммаНДС
		|СуммаСНДС
		|Статус"
	);
	
	Структура.Вставить("Товары",ТаблицаТоваров);
	
	Возврат Структура;
	
КонецФункции

Функция Автотесты_ПолучитьКодЭлементаСправочника(ЭлементСсылка)
	
	Если ЗначениеЗаполнено(ЭлементСсылка) Тогда
		Возврат СокрЛП(ЭлементСсылка.Код);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция Автотесты_ПолучитьПредставлениеСтавкиНДС(СтавкаНДС)
	
	Возврат "10";
	
КонецФункции

Процедура Автотесты_ПоместитьДокументНаПроверку(Имя,Документ) Экспорт
	
	СтруктураДокумента = Автотесты_ПолучитьПустуюСтруктуруДокументаАвтотестирования();
	СтруктураДокумента.Контрагент = Автотесты_ПолучитьКодЭлементаСправочника(Документ.Контрагент);
	Попытка
		СтруктураДокумента.Грузополучатель = Автотесты_ПолучитьКодЭлементаСправочника(Документ.Грузополучатель);
	Исключение
		СтруктураДокумента.Грузополучатель = Неопределено;		
	КонецПопытки;
	СтруктураДокумента.Организация = Автотесты_ПолучитьКодЭлементасправочника(Документ.Организация);
	СтруктураДокумента.СуммаВклНДС = Документ.СуммаВключаетНДС;
	
	Для Каждого Стр Из Документ.Товары Цикл
		НоваяСтрокаДокумента = СтруктураДокумента.Товары.Добавить();
		НоваяСтрокаДокумента.Номенклатура = Автотесты_ПолучитьКодЭлементаСправочника(Стр.Номенклатура);
		Попытка
			НоваяСтрокаДокумента.Единица = Автотесты_ПолучитьКодЭлементаСправочника(Стр.ЕдиницаИзмерения);
		Исключение
			НоваяСтрокаДокумента.Единица = Неопределено;
		КонецПопытки;
		НоваяСтрокаДокумента.Количество = Стр.Количество;
		НоваяСтрокаДокумента.Цена = Стр.Цена;
		НоваяСтрокаДокумента.СуммаНДС = Стр.СуммаНДС;
		НоваяСтрокаДокумента.СтавкаНДС = Автотесты_ПолучитьПредставлениеСтавкиНДС(Стр.СтавкаНДС);
		НоваяСтрокаДокумента.Сумма = Стр.Сумма;
	КонецЦикла;	
		
	НоваяСтрока = ПараметрыАвтотестирования.РезультатВыполненияСценария.Добавить();
	НоваяСтрока.Имя = Имя;
	НоваяСтрока.Тип = "Документ";
	НоваяСтрока.Значение = СтруктураДокумента;
	
КонецПроцедуры

Функция Автотесты_ПривестиСтатусСообщенияКОдномуВиду(Статус)
	
	Если Статус = "Подтвержден" Тогда
		Возврат "Accepted";
	ИначеЕсли Статус = "Уточнен" Тогда
		Возврат "Changed";
	ИначеЕсли Статус = "Отклонен" Тогда
		Возврат "Declined";
	КонецЕсли;
	
	Возврат Статус;
	
КонецФункции

Процедура Автотесты_ПоместитьСообщениеНаПроверку(Имя,Сообщение) Экспорт
	
	СтруктураСообщения = Автотесты_ПолучитьПустуюСтруктуруСообщенияАвтотестирования();
	
	СтруктураСообщения.НомерДокумента = Сообщение.ДокументEDI.Номер;
	СтруктураСообщения.ДатаДокумента = Сообщение.ДокументEDI.Дата;
	СтруктураСообщения.НомерЗаказа = Сообщение.ЗаказEDI.Номер;
	СтруктураСообщения.ДатаЗаказа = Сообщение.ЗаказEDI.Дата;
	СтруктураСообщения.Покупатель = Сообщение.ПокупательEDI.GLN;
	СтруктураСообщения.Поставщик = Сообщение.ПродавецEDI.GLN;
	СтруктураСообщения.Грузополучатель = Сообщение.ГрузополучательEDI.GLN;
	
	СтруктураСообщения.Статус = Автотесты_ПривестиСтатусСообщенияКОдномуВиду(Сообщение.Статус);
	
	Для Каждого Стр Из Сообщение.Товары Цикл
		НоваяСтрокаСообщения = СтруктураСообщения.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаСообщения,Стр);
		НоваяСтрокаСообщения.КодЕдиницыИзмерения = Стр.КодЕдиницыИзмеренияEDI;
		НоваяСтрокаСообщения.СтавкаНДС = Стр.СтавкаНДСEDI;
		НоваяСтрокаСообщения.Статус = Автотесты_ПривестиСтатусСообщенияКОдномуВиду(Стр.Статус);
	КонецЦикла;
	
	НоваяСтрока = ПараметрыАвтотестирования.РезультатВыполненияСценария.Добавить();
	НоваяСтрока.Имя = Имя;
	НоваяСтрока.Тип = "Сообщение";
	НоваяСтрока.Значение = СтруктураСообщения;
	
КонецПроцедуры

Процедура Автотесты_ЭмулироватьПолучениеСтатусногоСообщения(Сообщение,Этап,Статус) Экспорт
	
	Результат = СформироватьУведомлениеОПрочтенииСообщения(Сообщение,Этап,Статус);
 	ТекПутьККаталогу = ПараметрыАвтотестирования.Настройки.ВариантОбменаДанными.ПутьККаталогу;

	Если Результат.Успешно = Истина Тогда
		ФайлСтатусного = Новый Файл(Результат.ПутьКФайлу);
		Если ФайлСтатусного.Существует() Тогда
			ПереместитьФайл(Результат.ПутьКФайлу,ТекПутьККаталогу+"\Reports\"+ФайлСтатусного.Имя);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// #КонецОбласти //Автотесты


// #Область Конфигурация
	
//Использовать данную функцию в подключаемом модуле пока не рекомендуется.
Функция ПолучитьРеквизитДокументаДляСообщения(Документ, ИмяРеквизита, Сообщение = Неопределено) Экспорт
	
	СтандартнаяОбработкаEDI = Истина;
	
	ПараметрыСобытияПодключаемогоМодуля = Новый Структура("Документ, ИмяРеквизита, Сообщение", Документ, ИмяРеквизита, Сообщение);
	РезультатПодключаемогоМодуля = ОбработкаСобытияПодключаемогоМодуля(
		"ПолучитьРеквизитДокументаДляСообщения", СтандартнаяОбработкаEDI, ПараметрыСобытияПодключаемогоМодуля);
	
	Если НЕ СтандартнаяОбработкаEDI Тогда       
		Возврат РезультатПодключаемогоМодуля;
	КонецЕсли;
	
	Если Документ = Неопределено Тогда
		Возврат Неопределено;		
	КонецЕсли;
	
	Если ИмяРеквизита = "Комментарий" Тогда        
		
		ЗначениеРеквизита = РеквизитДокумента_Комментарий(Документ, Сообщение);
		
	ИначеЕсли ИмяРеквизита = "Грузополучатель" Тогда
		
		ЗначениеРеквизита = РеквизитДокумента_Грузополучатель(Документ, Сообщение);
		
	ИначеЕсли ИмяРеквизита = "Грузоотправитель" Тогда
		
		ЗначениеРеквизита = РеквизитДокумента_Грузоотправитель(Документ, Сообщение);
		
	ИначеЕсли ИмяРеквизита = "Склад" Тогда
		
		ЗначениеРеквизита = РеквизитДокумента_Склад(Документ, Сообщение);
		
	ИначеЕсли ИмяРеквизита = "Организация" Тогда
		
		ЗначениеРеквизита = РеквизитДокумента_Организация(Документ, Сообщение);
	
	ИначеЕсли ИмяРеквизита = "Договор" Тогда
		
		ЗначениеРеквизита = РеквизитДокумента_Договор(Документ, Сообщение);
		
	ИначеЕсли ИмяРеквизита = "Контрагент" Тогда
		
		ЗначениеРеквизита = РеквизитДокумента_Контрагент(Документ, Сообщение);
		
	ИначеЕсли ИмяРеквизита = "Партнер" Тогда
		
		ЗначениеРеквизита = РеквизитДокумента_Партнер(Документ, Сообщение);
		
	ИначеЕсли ИмяРеквизита = "СуммаВключаетНДС" Тогда	
		
		ЗначениеРеквизита = РеквизитДокумента_СуммаВключаетНДС(Документ, Сообщение);
	
	ИначеЕсли ИмяРеквизита = "Валюта" Тогда	
		
		ЗначениеРеквизита = РеквизитДокумента_Валюта(Документ, Сообщение);
		
	ИначеЕсли ИмяРеквизита = "ДатаОтгрузки" Тогда
		
		ЗначениеРеквизита = РеквизитДокумента_ДатаОтгрузки(Документ, Сообщение);
		
	ИначеЕсли ИмяРеквизита = "ДокументОснованиеКорректировки" Тогда
		
		ЗначениеРеквизита = РеквизитДокумента_ДокументОснованиеКорректировки(Документ, Сообщение);
		
	ИначеЕсли ИмяРеквизита = "ДокументОснованиеВозврата" Тогда
		
		ЗначениеРеквизита = РеквизитДокумента_ДокументОснованиеВозврата(Документ, Сообщение);
		
	ИначеЕсли ИмяРеквизита = "СчетФактураДокументаОснования" Тогда
		
		ЗначениеРеквизита = РеквизитДокумента_СчетФактураПоДокументуОснованию(Документ, Сообщение);
		
	ИначеЕсли ИмяРеквизита = "ДокументОснованиеСчетаФактуры" Тогда
		
		ЗначениеРеквизита = РеквизитДокумента_ДокументОснованиеПоСчетуФактуре(Документ, Сообщение);
		
	ИначеЕсли ИмяРеквизита = "ИсправляемыйСчетФактура" Тогда
		
		ЗначениеРеквизита = РеквизитДокумента_ИсправляемыйСчетФактура(Документ, Сообщение);
		
	ИначеЕсли ИмяРеквизита = "ИсправлениеСчетаФактуры" Тогда
		
		ЗначениеРеквизита = РеквизитДокумента_ИсправлениеСчетаФактуры(Документ, Сообщение);
		
	ИначеЕсли ИмяРеквизита = "ДокументЗаказ" Тогда
		
		ЗначениеРеквизита = РеквизитДокумента_Заказ(Документ, Сообщение);
		
	ИначеЕсли ИмяРеквизита = "ДокументНакладная" Тогда
		
		ЗначениеРеквизита = РеквизитДокумента_Накладная(Документ, Сообщение);
		
	ИначеЕсли ИмяРеквизита = "Корректировочный" Тогда
		
		ЗначениеРеквизита = РеквизитДокумента_Корректировочный(Документ, Сообщение);
		
	ИначеЕсли ИмяРеквизита = "ФактическаяДатаПоставки" Тогда
		
		ЗначениеРеквизита = РеквизитДокумента_ФактическаяДатаПоставки(Документ, Сообщение);
		
	Иначе 
		
		ЗначениеРеквизита = Неопределено;
		
	КонецЕсли;
		
	Если ЗначениеРеквизита = Неопределено 
		И ПеременнаяСодержитСвойство(Документ, ИмяРеквизита) Тогда
		
		Возврат Документ[ИмяРеквизита];
		
	Иначе
		
		Возврат ЗначениеРеквизита;
		
	КонецЕсли;
	
КонецФункции

Функция РеквизитДокумента_ФактическаяДатаПоставки(Документ, Сообщение)
	
	ФактическаяДатаПоставки = Дата(1, 1, 1);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	НАЧАЛОПЕРИОДА(ИмяДокументаВМетаданных.Дата, ДЕНЬ) КАК Дата
	               |ИЗ
	               |	Документ.ИмяДокументаВМетаданных КАК ИмяДокументаВМетаданных
	               |ГДЕ
	               |	ИмяДокументаВМетаданных.Ссылка = &Ссылка";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяДокументаВМетаданных", Документ.Метаданные().Имя); 
	Запрос.УстановитьПараметр("Ссылка", Документ);
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		
		ФактическаяДатаПоставки = Выборка.Дата;
		
	КонецЕсли;
	
	Возврат ФактическаяДатаПоставки; 
	
КонецФункции

Функция РеквизитДокумента_Корректировочный(Документ, Сообщение)
	
	Если ПеременнаяСодержитСвойство(Документ, "Корректировочный") Тогда
		Возврат Документ.Корректировочный;
	КонецЕсли;
	
	Если ПеременнаяСодержитСвойство(Документ, "Корректировка") Тогда
		Возврат Документ.Корректировка;
	КонецЕсли;
	
	ВидСчетаФактуры = ПолучитьРеквизитДокументаДляСообщения(Документ,"ВидСчетаФактуры");
	Если Не ВидСчетаФактуры = Неопределено 
			И ЕстьНеобходимыеМетаданные("Перечисления.ВидСчетаФактурыВыставленного.ЗначенияПеречисления.Корректировочный") Тогда
		Возврат ВидСчетаФактуры = Перечисления.ВидСчетаФактурыВыставленного.Корректировочный;
	КонецЕсли;
	
	ВидОперации = ПолучитьРеквизитДокументаДляСообщения(Документ, "ВидОперации");
	Если Не ВидОперации = Неопределено 
			И ЕстьНеобходимыеМетаданные("Перечисления.ВидыОперацийСчетФактура.ЗначенияПеречисления.Корректировка") Тогда
		Возврат ВидОперации = Перечисления.ВидыОперацийСчетФактура.Корректировка;
	КонецЕсли;	
	
	Возврат Неопределено;
	
КонецФункции

Функция РеквизитДокумента_Комментарий(Документ, Сообщение)
	
	Комментарий = Неопределено;
	СвойствоЗаполнено = Истина;
	
	ПеременнаяСодержитСвойство(Документ, "Комментарий", Комментарий, СвойствоЗаполнено);
	
	Возврат Комментарий;
	
КонецФункции

Функция РеквизитДокумента_Грузополучатель(Документ, Сообщение)
	
	ДокументГрузополучатель = Неопределено;
	СвойствоЗаполнено = Истина;
	
	Если ИмяКонфигурации1С = "УФ_УТ" 
		И ЗначениеЗаполнено(ПолучитьКонстантуEDI("СвойСправочникТочекДоставки")) Тогда
		
		Возврат РеквизитДокумента_Партнер(Документ, Сообщение);	
		
	ИначеЕсли ПеременнаяСодержитСвойство(Документ, "Грузополучатель", ДокументГрузополучатель, СвойствоЗаполнено) = Истина
		И ТипЗнч(ДокументГрузополучатель) <> Тип("Строка")  Тогда
		
		Возврат ДокументГрузополучатель;
		
	Иначе
		
		Возврат РеквизитДокумента_Контрагент(Документ, Сообщение);
		
	КонецЕсли;
	
КонецФункции

Функция РеквизитДокумента_Грузоотправитель(Документ, Сообщение)
	
	СвойствоЗаполнено = Истина;
	ДокументГрузоотправитель = Неопределено;
	
	Если ПеременнаяСодержитСвойство(Документ, "Грузоотправитель", ДокументГрузоотправитель, СвойствоЗаполнено) = Истина Тогда
		
		Возврат ДокументГрузоотправитель;	
		
	Иначе
		
		Возврат РеквизитДокумента_Организация(Документ, Сообщение);
		
	КонецЕсли;
	
КонецФункции

Функция РеквизитДокумента_Склад(Документ, Сообщение)
	
	ИмяДокумента = Документ.Метаданные().Имя;
	ИмяКонфигурацииВШаблонах = ПолучитьИмяКонфигурацииДляЗапроса();
	
	Если (ИмяКонфигурацииВШаблонах = "УТ_УПП_КА" ИЛИ ИмяКонфигурации1С = "УТ_10_2")
		И (ИмяДокумента = "ВозвратТоваровОтПокупателя" ИЛИ ИмяДокумента = "ПоступлениеТоваровУслуг")
		И ПеременнаяСодержитСвойство(Документ, "СкладОрдер") Тогда
		
		Возврат Документ.СкладОрдер;
		
	ИначеЕсли ИмяКонфигурации1С = "ТКПТ"
		И ПеременнаяСодержитСвойство(Документ, "ПодразделениеКомпании") Тогда
		
		Возврат Документ.ПодразделениеКомпании;
		
	ИначеЕсли ИмяКонфигурации1С = "АСТОР"
		И ПеременнаяСодержитСвойство(Документ, "СтруктурнаяЕдиница") Тогда
		
		Возврат Документ.СтруктурнаяЕдиница;
		
	ИначеЕсли ИмяКонфигурации1С = "УФ_УНФ"
		И ПеременнаяСодержитСвойство(Документ, "СтруктурнаяЕдиницаРезерв",, Истина) Тогда
		
		Возврат Документ.СтруктурнаяЕдиницаРезерв;
		
	ИначеЕсли ИмяКонфигурации1С = "УФ_УНФ"
		И ПеременнаяСодержитСвойство(Документ, "СтруктурнаяЕдиница",, Истина) Тогда
		
		Возврат Документ.СтруктурнаяЕдиница;
		
	ИначеЕсли ПеременнаяСодержитСвойство(Документ, "Склад") Тогда 
		
		Возврат Документ.Склад;
		
	Иначе 
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции

Функция РеквизитДокумента_Организация(Документ, Сообщение)
	
	Если ИмяКонфигурации1С = "ДалионУМ" ИЛИ ИмяКонфигурации1С = "АСТОР" ИЛИ ИмяКонфигурации1С = "ШтрихМ_РС"
		И ПеременнаяСодержитСвойство(Документ, "Фирма") Тогда
		
		Возврат Документ.Фирма;
		
	ИначеЕсли ИмяКонфигурации1С = "Розница"
		И ПеременнаяСодержитСвойство(Документ, "Склад")
		И ПеременнаяСодержитСвойство(Документ.Склад, "Организация") Тогда
		
		Возврат Документ.Склад.Организация;
		
	ИначеЕсли ПеременнаяСодержитСвойство(Документ, "Организация") Тогда 
		
		Возврат Документ.Организация;
		
	Иначе 
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции

Функция РеквизитДокумента_Договор(Документ, Сообщение)
	
	Если (ИмяКонфигурации1С = "УФ_УТ" ИЛИ ИмяКонфигурации1С = "УФ_УНФ")
		И Документ.Метаданные().Имя = "СчетФактураВыданный"
		И ПеременнаяСодержитСвойство(Документ, "ДокументОснование")
		И ПеременнаяСодержитСвойство(Документ.ДокументОснование, "Договор") Тогда
		
		Возврат Документ.ДокументОснование.Договор;
		
	ИначеЕсли ИмяКонфигурации1С = "УФ_Розница" Тогда
		
		Возврат Неопределено;	
		
	ИначеЕсли ИмяКонфигурации1С = "ТКПТ"
		И ПеременнаяСодержитСвойство(Документ, "ДоговорВзаиморасчетов") Тогда
		
		Возврат Документ.ДоговорВзаиморасчетов;
		
	ИначеЕсли ПеременнаяСодержитСвойство(Документ, "Договор") Тогда
		
		Возврат Документ.Договор;
		
	ИначеЕсли ПеременнаяСодержитСвойство(Документ, "ДоговорКонтрагента") Тогда
		
		Возврат Документ.ДоговорКонтрагента;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции

Функция РеквизитДокумента_Контрагент(Документ, Сообщение)
	
	Если (ИмяКонфигурации1С = "УФ_УТ" ИЛИ ИмяКонфигурации1С = "УФ_УНФ" ИЛИ ИмяКонфигурации1С = "УФ_Розница")
		И Документ.Метаданные().Имя = "СчетФактураВыданный"
		И ПеременнаяСодержитСвойство(Документ, "ДокументОснование")
		И ПеременнаяСодержитСвойство(Документ.ДокументОснование, "Контрагент") Тогда
		
		Возврат Документ.ДокументОснование.Контрагент;
	ИначеЕсли ИмяКонфигурации1С = "УФ_ДалионТРЕНД"
			И Документ.Метаданные().Имя = "СчетФактура"
			И ПеременнаяСодержитСвойство(Документ, "ДокументОснование", ,Истина)
			И ПеременнаяСодержитСвойство(Документ.ДокументОснование, "Контрагент") Тогда 
			
			Возврат ПолучитьЗначениеРеквизитаОбъекта_КонтурEDI(Документ.ДокументОснование, "Контрагент"); 
		
	ИначеЕсли ИмяКонфигурации1С = "АСТОР"
		И Документ.Метаданные().Имя = "Резерв"
		И ПеременнаяСодержитСвойство(Документ, "Покупатель") Тогда
		
		Возврат Документ.Покупатель;
		
	ИначеЕсли ПеременнаяСодержитСвойство(Документ, "Контрагент") Тогда
		
		Возврат Документ.Контрагент;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции

Функция РеквизитДокумента_Партнер(Документ, Сообщение)
	
	Если ПеременнаяСодержитСвойство(Документ, "Партнер") Тогда
		
		Возврат Документ.Партнер;
		
	ИначеЕсли ПеременнаяСодержитСвойство(Документ, "Контрагент")
		И ПеременнаяСодержитСвойство(Документ.Контрагент, "Партнер") Тогда
		
		Возврат Документ.Контрагент.Партнер;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции

Функция РеквизитДокумента_СуммаВключаетНДС(Документ, Сообщение)
	
	Если (ИмяКонфигурации1С = "ТКПТ" ИЛИ ИмяКонфигурации1С = "ШтрихМ_РС")
		И ПеременнаяСодержитСвойство(Документ, "ТипЦен") 
		И ПеременнаяСодержитСвойство(Документ.ТипЦен, "ЦенаВключаетНДС") Тогда
		
		Возврат Документ.ТипЦен.ЦенаВключаетНДС;
		
	ИначеЕсли ИмяКонфигурации1С = "АСТОР" Тогда
		
		МетаданныеДокументаИмя = Документ.Метаданные().Имя;
		
		Если МетаданныеДокументаИмя = "Заказ" Тогда
			
			Возврат Ложь;
			
		ИначеЕсли МетаданныеДокументаИмя = "ПриходнаяНакладная"
			И ПеременнаяСодержитСвойство(Документ, "ВариантРасчетаНДС") 
			И ЕстьНеобходимыеМетаданные("Перечисления.ВариантыРасчетаНДС.ЗначенияПеречисления.НДСвТомЧисле") Тогда
			
			Возврат Документ.ВариантРасчетаНДС = Перечисления.ВариантыРасчетаНДС.НДСвТомЧисле;
			
		КонецЕсли;
		
	ИначеЕсли ИмяКонфигурации1С = "УФ_УТ"
		И ПеременнаяСодержитСвойство(Документ, "ЦенаВключаетНДС") Тогда
		
		Возврат Документ.ЦенаВключаетНДС;
		
	ИначеЕсли ИмяКонфигурации1С = "УФ_УНФ" Тогда
		
		МетаданныеДокумента = Документ.Метаданные();
		
		Если МетаданныеДокумента.Имя = "СчетФактура" Тогда
			
			Если ЕстьНеобходимыеМетаданные("Документы.СчетФактура.ТабличныеЧасти.Запасы") Тогда 
				
				Возврат Ложь;
				
			КонецЕсли;
			
			Если ПеременнаяСодержитСвойство(Документ, "ДокументОснование",, Истина)
				И ПеременнаяСодержитСвойство(Документ.ДокументОснование, "СуммаВключаетНДС") Тогда
				
				Возврат Документ.ДокументОснование.СуммаВключаетНДС;
				
			Иначе
				
				Накладная = ПолучитьНакладнуюСчетаФактуры(Документ);
				
				Если НЕ Накладная = Неопределено
					И ПеременнаяСодержитСвойство(Накладная, "СуммаВключаетНДС") Тогда
					
					Возврат Накладная.СуммаВключаетНДС;
					
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли ПеременнаяСодержитСвойство(Документ, "СуммаВключаетНДС") Тогда	
			
			Возврат Документ.СуммаВключаетНДС;
			
		КонецЕсли;
		
	ИначеЕсли ИмяКонфигурации1С = "УФ_Розница" ИЛИ ИмяКонфигурации1С = "ДалионТРЕНД" ИЛИ ИмяКонфигурации1С = "УФ_ДалионТРЕНД"
		И ПеременнаяСодержитСвойство(Документ, "ЦенаВключаетНДС") Тогда
		
		Возврат Документ.ЦенаВключаетНДС;
			
	Иначе
		
		Возврат Документ.СуммаВключаетНДС;		
		
	КонецЕсли;
	
КонецФункции

Функция РеквизитДокумента_Валюта(Документ, Сообщение)
	
	Если (ИмяКонфигурации1С = "АСТОР" ИЛИ ИмяКонфигурации1С = "ШтрихМ_РС")
		И ПеременнаяСодержитСвойство(Документ, "Валюта") Тогда
		
		Возврат Документ.Валюта;	
		
	ИначеЕсли ИмяКонфигурации1С = "УФ_Розница" Тогда
		
		Возврат Неопределено;

	ИначеЕсли ИмяКонфигурации1С <> "УФ_УТ" 
		И ПеременнаяСодержитСвойство(Документ, "ВалютаДокумента") Тогда
		
		Возврат Документ.ВалютаДокумента;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции

Функция РеквизитДокумента_ДатаОтгрузки(Документ, Сообщение)
	
	МетаданныеДокументаИмя = Документ.Метаданные().Имя;
	
	Если ИмяКонфигурации1С = "ТКПТ" Тогда
		
		Если (МетаданныеДокументаИмя = "ЗаказПокупателя"
			ИЛИ МетаданныеДокументаИмя = "ЗаказПоставщику")
			И ПеременнаяСодержитСвойство(Документ, "СрокПоставки") Тогда
			
			Возврат Документ.СрокПоставки;
			
		Иначе
			
			Возврат Документ.Дата;
			
		КонецЕсли;
		
	ИначеЕсли (ИмяКонфигурации1С = "ДалионУМ"
		ИЛИ ИмяКонфигурации1С = "ШтрихМ_РС") Тогда
		
		Если МетаданныеДокументаИмя = "ЗаказПоставщику"
			И ПеременнаяСодержитСвойство(Документ, "ДатаПоставки") Тогда
			
			Возврат Документ.ДатаПоставки;
			
		Иначе
			
			Возврат Документ.Дата;
			
		КонецЕсли;
		
	ИначеЕсли ИмяКонфигурации1С = "ДалионТРЕНД" ИЛИ ИмяКонфигурации1С = "УФ_ДалионТРЕНД"  Тогда
		
		Если МетаданныеДокументаИмя = "ЗаказТоваров"
			И ПеременнаяСодержитСвойство(Документ, "ДатаПоставки") Тогда
			
			Возврат Документ.ДатаПоставки;
			
		Иначе
			
			Возврат Документ.Дата;
			
		КонецЕсли;
		
	ИначеЕсли ИмяКонфигурации1С = "АСТОР" Тогда
		
		Если МетаданныеДокументаИмя = "Заказ"
			И ПеременнаяСодержитСвойство(Документ, "ДатаПоставки") Тогда

			Возврат Документ.ДатаПоставки;
			
		Иначе
			
			Возврат Документ.Дата;
			
		КонецЕсли;
		
	ИначеЕсли ПеременнаяСодержитСвойство(Документ, "ДатаОтгрузки",, Истина) Тогда 
		
		Возврат Документ.ДатаОтгрузки;
	
	ИначеЕсли ПеременнаяСодержитСвойство(Документ, "ДатаПоступления",, Истина) Тогда
		
		Возврат Документ.ДатаПоступления;
		
	ИначеЕсли ПеременнаяСодержитСвойство(Документ, "ЖелаемаяДатаПоступления",, Истина) Тогда
		
		Возврат Документ.ЖелаемаяДатаПоступления;
		
	Иначе
		
		Возврат Документ.Дата;                     
		
	КонецЕсли;
	
КонецФункции

Функция РеквизитДокумента_ДокументОснованиеКорректировки(Документ, Сообщение)
	
	Если ЕстьРеквизитОбъекта_Контур(Документ, "ДокументОснование") Тогда
		Возврат Документ.ДокументОснование;
	Иначе 
		Возврат Документ.ДокументРеализации;
	КонецЕсли;
	
КонецФункции

Функция РеквизитДокумента_ДокументОснованиеВозврата(Документ, Сообщение)
	
	Если ЕстьРеквизитОбъекта_Контур(Документ, "ДокументРеализации") Тогда
		Возврат Документ.ДокументРеализации;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция РеквизитДокумента_ИсправляемыйСчетФактура(Документ, Сообщение)
	
	ИмяКонфигурацииДляЗапроса = ПолучитьИмяКонфигурацииДляЗапроса();
	
	Если ИмяКонфигурацииДляЗапроса = "УФ_УТ" Тогда
		
		ИсправляемыйСчетФактура = Неопределено;
		
		Если Не ЕстьНеобходимыеМетаданные("Документы.СчетФактураВыданный.Реквизиты.СчетФактураОснование") Тогда
			Возврат ИсправляемыйСчетФактура;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", Документ);
		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	СчетФактураВыданный.СчетФактураОснование КАК ИсправляемыйСчетФактура
		               |ИЗ
		               |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
		               |ГДЕ
		               |	СчетФактураВыданный.Ссылка = &Ссылка";
		
		Если ЕстьНеобходимыеМетаданные("Документы.СчетФактураВыданный.ТабличныеЧасти.Товары.Реквизиты.ПредыдущийСчетФактура") Тогда
			
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			               |	ВЫБОР
			               |		КОГДА СчетФактураВыданный.СчетФактураОснование = НЕОПРЕДЕЛЕНО
			               |				ИЛИ СчетФактураВыданный.СчетФактураОснование = ЗНАЧЕНИЕ(Документ.СчетФактураВыданный.ПустаяСсылка)
			               |			ТОГДА СчетФактураВыданныйТовары.ПредыдущийСчетФактура
			               |		ИНАЧЕ СчетФактураВыданный.СчетФактураОснование
			               |	КОНЕЦ КАК ИсправляемыйСчетФактура
			               |ИЗ
			               |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
			               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный.Товары КАК СчетФактураВыданныйТовары
			               |		ПО СчетФактураВыданный.Ссылка = &Ссылка
			               |			И СчетФактураВыданныйТовары.Ссылка = СчетФактураВыданный.Ссылка
			               |ГДЕ
			               |	СчетФактураВыданный.Ссылка = &Ссылка";
		
		ИначеЕсли ЕстьНеобходимыеМетаданные("Документы.СчетФактураВыданный.ТабличныеЧасти.ДокументыОснования.Реквизиты.ИсходныйДокумент") Тогда
			
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			               |	ВЫБОР
			               |		КОГДА СчетФактураВыданный.СчетФактураОснование = НЕОПРЕДЕЛЕНО
			               |				ИЛИ СчетФактураВыданный.СчетФактураОснование = ЗНАЧЕНИЕ(Документ.СчетФактураВыданный.ПустаяСсылка)
			               |			ТОГДА СчетФактураВыданныйДокументыОснования.ИсходныйДокумент
			               |		ИНАЧЕ СчетФактураВыданный.СчетФактураОснование
			               |	КОНЕЦ КАК ИсправляемыйСчетФактура
			               |ИЗ
			               |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
			               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
			               |		ПО СчетФактураВыданный.Ссылка = &Ссылка
			               |			И СчетФактураВыданныйДокументыОснования.Ссылка = СчетФактураВыданный.Ссылка
			               |ГДЕ
			               |	СчетФактураВыданный.Ссылка = &Ссылка";
			
				
		ИначеЕсли ЕстьНеобходимыеМетаданные("Документы.СчетФактураВыданный.Реквизиты.ИсходныйДокумент") Тогда
			
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			               |	ВЫБОР
			               |		КОГДА СчетФактураВыданный.СчетФактураОснование = НЕОПРЕДЕЛЕНО
			               |				ИЛИ СчетФактураВыданный.СчетФактураОснование = ЗНАЧЕНИЕ(Документ.СчетФактураВыданный.ПустаяСсылка)
			               |			ТОГДА СчетФактураВыданный.ИсходныйДокумент
			               |		ИНАЧЕ СчетФактураВыданный.СчетФактураОснование
			               |	КОНЕЦ КАК ИсправляемыйСчетФактура
			               |ИЗ
			               |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
			               |ГДЕ
			               |	СчетФактураВыданный.Ссылка = &Ссылка";
			
		КонецЕсли;
		
		Результат = Запрос.Выполнить();
		Если Результат.Пустой() Тогда
			Возврат ИсправляемыйСчетФактура;
		КонецЕсли;
		
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.ИсправляемыйСчетФактура) Тогда
				ИсправляемыйСчетФактура = Выборка.ИсправляемыйСчетФактура;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не ИсправляемыйСчетФактура = Неопределено
			И ПолучитьРеквизитДокументаДляСообщения(Документ, "ИсправлениеСчетаФактуры") = Истина
			И ПолучитьРеквизитДокументаДляСообщения(ИсправляемыйСчетФактура, "ИсправлениеСчетаФактуры") = Ложь
			И ПолучитьРеквизитДокументаДляСообщения(ИсправляемыйСчетФактура, "Корректировочный") = Истина Тогда
			
			ИсправляемыйСчетФактура = ПолучитьРеквизитДокументаДляСообщения(ИсправляемыйСчетФактура, "ИсправляемыйСчетФактура", Сообщение);
			
		КонецЕсли;
		
		Возврат ИсправляемыйСчетФактура;
		
	Иначе
			
		ОснованиеСчетаФактуры = ПолучитьРеквизитДокументаДляСообщения(Документ, "ДокументОснованиеСчетаФактуры");
		ИсправляемыйДокумент = ПолучитьИсправляемыйДокументРеализации_КонтурEDI(ОснованиеСчетаФактуры);	
		ИсправляемыйСчетФактура = ПолучитьРеквизитДокументаДляСообщения(ИсправляемыйДокумент, "СчетФактураДокументаОснования");
	
		Если ПолучитьРеквизитДокументаДляСообщения(ИсправляемыйСчетФактура, "Корректировочный") = Истина Тогда
			ИсправляемыйСчетФактура = ПолучитьПредыдущийСчетФактуру_КонтурEDI(ИсправляемыйСчетФактура, Сообщение);
		КонецЕсли;
		
		Возврат ИсправляемыйСчетФактура;
			
	КонецЕсли;
	
КонецФункции

Функция РеквизитДокумента_ИсправлениеСчетаФактуры(Документ, Сообщение)
	
	ДокументСчетФактура = Неопределено;
	ДокументКорректировкаРеализации = Неопределено;
	
	ИсправительныйСчетФактура = Ложь;
	КорректировкаРеализацииСФункциейИсправления = Ложь;
	
	ТипИсходящийКСФ = ПолучитьТипЗначенияОбъекта("ИсходящийКСФ");
	ТипДокументаСчетФактура = ПолучитьТипЗначенияОбъекта("ТипДокументаСчетФактура");
	
	Если ЗначениеЗаполнено(ТипДокументаСчетФактура) И ТипЗнч(Документ) = Тип(ТипДокументаСчетФактура) Тогда
		ДокументСчетФактура = Документ;
		ДокументКорректировкаРеализации = ПолучитьКорректировкуРеализацииСчетаФактуры(ДокументСчетФактура);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТипИсходящийКСФ) И ТипЗнч(Документ) = Тип(ТипИсходящийКСФ) Тогда
		ДокументКорректировкаРеализации = Документ;
		ДокументСчетФактура = РеквизитДокумента_СчетФактураПоДокументуОснованию(ДокументКорректировкаРеализации);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументСчетФактура) Тогда
		ИсправительныйСчетФактура = (ПеременнаяСодержитСвойство(Документ, "Исправление") И Документ.Исправление = Истина);	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументКорректировкаРеализации) Тогда
		КорректировкаРеализацииСФункциейИсправления = КорректировкаРеализацииСФункциейИсправления(ДокументКорректировкаРеализации);	
	КонецЕсли;
	
	Если ИсправительныйСчетФактура
		ИЛИ КорректировкаРеализацииСФункциейИсправления Тогда
		
		Возврат Истина;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции

Функция РеквизитДокумента_Заказ(Документ, Сообщение)
	
	Если ИмяКонфигурации1С = "УТ_10_3"
		 Или ИмяКонфигурации1С = "УПП" 
		 Или ИмяКонфигурации1С = "КА" Тогда 
	
		Возврат Документ.Сделка;
		
	ИначеЕсли ИмяКонфигурации1С = "УФ_УТ" Тогда
		
		Если НЕ ЗначениеЗаполнено(Документ.Сделка) Тогда 
			
			Возврат Документ.ДокументПоступления.ЗаказПоставщику;
			
		Иначе
			
			Возврат Документ.Сделка;
			
		КонецЕсли;
		
	ИначеЕсли ИмяКонфигурации1С = "УФ_Розница" Тогда 
		
		Возврат НайтиСвязанныйДокументПоТипуСообщения(Документ, "ORDERS");
		
	ИначеЕсли ИмяКонфигурации1С = "ДалионУМ" Тогда
		
		ДокументОснование = Неопределено;
		ПеременнаяСодержитСвойство(Документ, "ДокументОснование", ДокументОснование, Истина);
		
		ЗаказПоставщику = Неопределено;
		ПеременнаяСодержитСвойство(ДокументОснование, "ЗаказПоставщику", ЗаказПоставщику, Истина);
		
		Возврат ЗаказПоставщику;		
	ИначеЕсли ИмяКонфигурации1С = "УФ_УНФ" Тогда 	
		Возврат Документ.Заказ;		
	Иначе 
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции

Функция РеквизитДокумента_Накладная(Документ, Сообщение)
	
	Возврат НайтиСвязанныйДокументПоТипуСообщения(Сообщение.Заказ1С, "DESADV");
	
КонецФункции

Функция ПолучитьИсправляемыйДокументРеализации_КонтурEDI(Корректировка, Исходный = Ложь) Экспорт
	
	ИмяКонфигурацииДляЗапроса = ПолучитьИмяКонфигурацииДляЗапроса();
	
	ИсправляемыйДокумент = Неопределено;
	
	Попытка
		
		Если ИмяКонфигурацииДляЗапроса = "УТ_УПП_КА" 
				ИЛИ ИмяКонфигурацииДляЗапроса = "БП_20" Тогда
				
			ИсправляемыйДокумент = Вычислить("УчетНДС.ПолучитьИсправляемыйДокументРеализации(Корректировка)");
			
		ИначеЕсли ИмяКонфигурацииДляЗапроса = "УФ_УНФ" Тогда
			
			ИсправляемыйДокумент = Вычислить("Документы.КорректировкаРеализации.ПолучитьИсправляемыйДокументРеализации(Корректировка)");
			
		ИначеЕсли ИмяКонфигурацииДляЗапроса = "УФ_БП" Тогда
			
			ИсправляемыйДокумент = Вычислить("УчетНДСПереопределяемый.ПолучитьИсправляемыйДокументРеализации(Корректировка)");
			
		КонецЕсли;
		
	Исключение
		
		МетрикаПеременные = Новый Структура;
		МетрикаПеременные.Вставить("ИмяКонфигурацииДляЗапроса", ИмяКонфигурацииДляЗапроса);
		
		Метрика_Ошибка("ПолучитьИсправляемыйДокументРеализации_КонтурEDI", ОписаниеОшибки(), ИнформацияОбОшибке(), МетрикаПеременные);
		
	КонецПопытки;
	
	Если ИсправляемыйДокумент = Неопределено Тогда
		
		ИсправляемыйДокумент = ПолучитьИсправляемыйДокументРеализацииРекурсивно_КонтурEDI(Корректировка);
		
	КонецЕсли;
		
	Возврат ИсправляемыйДокумент;
	
КонецФункции

Функция ПолучитьИсправляемыйДокументРеализацииРекурсивно_КонтурEDI(ДокРеализации, Исходный = Ложь) Экспорт
	
	ТипИсходящийКСФ = ПолучитьТипЗначенияОбъекта("ИсходящийКСФ");
	
	Если ЗначениеЗаполнено(ДокРеализации) 
		И ЗначениеЗаполнено(ТипИсходящийКСФ) 
		И ТипЗнч(ДокРеализации) = Тип(ТипИсходящийКСФ)
		И (КорректировкаРеализацииСФункциейИсправления(ДокРеализации) ИЛИ Исходный) Тогда
			
		ДокументОснование = ПолучитьРеквизитДокументаДляСообщения(ДокРеализации, "ДокументОснованиеКорректировки");
		Если ДокументОснование <> ДокРеализации Тогда
			Возврат ПолучитьИсправляемыйДокументРеализацииРекурсивно_КонтурEDI(ДокументОснование, Исходный);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ДокРеализации;
	
КонецФункции

Функция КорректировкаРеализацииСФункциейИсправления(КорректировкаРеализации)
	
	Если (ПеременнаяСодержитСвойство(КорректировкаРеализации, "ВидОперации")
		И ЕстьНеобходимыеМетаданные("Перечисления.ВидыОперацийИсправленияПоступленияРеализации.ЗначенияПеречисления.ИсправлениеОшибки")
		И КорректировкаРеализации.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки)
		// Конфигурации: УФ_УНФ, УФ_БП, БП, УТ_10_3, УПП, КА 
		ИЛИ (ПеременнаяСодержитСвойство(КорректировкаРеализации, "ХозяйственнаяОперация") 
		И ЕстьНеобходимыеМетаданные("Перечисления.ХозяйственныеОперации.ЗначенияПеречисления.ИсправлениеОшибок")
		И КорректировкаРеализации.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ИсправлениеОшибок) Тогда
		// Конфигурации: УФ_УТ 
		
		Возврат Истина;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции

Процедура ЗаполнитьВходящийДокументПоСообщению_ORDERS_ОФ(НовыйДокумент,Сообщение)
	
	ИмяТабЧастиТовары = "Товары";
	ИмяТабЧастиУслуги = "Услуги";
	
	НовыйДокумент[ИмяТабЧастиТовары].Очистить();
	
	РаботаСУслугами = (ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, "РаботаСУслугами") = Истина);
	ЗагружатьУслугиВТабЧастьУслуги = (ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, "ЗагружатьУслугиВТабЧастьУслуги") = Истина);
	ЕстьТабЧастьУслуги = (НЕ (НовыйДокумент.Метаданные().ТабличныеЧасти.Найти("Услуги") = Неопределено));
	
	Если РаботаСУслугами
		И ЗагружатьУслугиВТабЧастьУслуги
		И ЕстьТабЧастьУслуги Тогда
		НовыйДокумент[ИмяТабЧастиУслуги].Очистить();
	КонецЕсли;	
	
	Если ИспользоватьМаппингМетаданных Тогда
		Маппинг_ЗаполнитьВходящийДокументПоСообщению_ORDERS_ОФ(НовыйДокумент,Сообщение);
		Возврат;
	КонецЕсли;
	
	ТипЦен				= Неопределено;
	флУчитыватьНДС		= Истина;
	флСуммаВключаетНДС	= Истина;
	
	ИмяРеквизитаОрганизация = ?(ИмяКонфигурации1С = "ДалионУМ", "Фирма", 		"Организация");
	ИмяРеквизитаТипЦен 		= ?(ИмяКонфигурации1С = "ДалионУМ", "КатегорияЦен", "ТипЦен");
	
	ДоговорКонтрагента = Сообщение.Договор;
	Если ЗначениеЗаполнено(ДоговорКонтрагента)
		И ЕстьРеквизитОбъекта_Контур(ДоговорКонтрагента,ИмяРеквизитаТипЦен) Тогда
		ТипЦен = ДоговорКонтрагента[ИмяРеквизитаТипЦен];
	КонецЕсли;
	
	Если ИмяКонфигурации1С = "ДалионУМ" Тогда
		
		Склад  				= ПолучитьКонстантуEDI("СоздаваемыйДокументСклад");
		УчетнаяПолитика		= Неопределено;
		Выполнить("УчетнаяПолитика = ПолучитьУчетнуюПолитику(ТекущаяДата(), Сообщение.Продавец1С, Склад);");
		Если Не УчетнаяПолитика = Неопределено Тогда
			флУчитыватьНДС 		= НЕ УчетнаяПолитика.НеЯвляетсяПлательщикомНДС;			
			флСуммаВключаетНДС 	= УчетнаяПолитика.СуммаВключаетНДС;
		КонецЕсли;
		
	Иначе 
	
		Если ЗначениеЗаполнено(ТипЦен) Тогда
			Если ПеременнаяСодержитСвойство(ТипЦен,"Рассчитывается") Тогда
				ЗначениеРассчитывается = ТипЦен.Рассчитывается;
			Иначе
				ЗначениеРассчитывается = Ложь;
			КонецЕсли;			
			
			Если ТипЗнч(ТипЦен) = Тип("СправочникСсылка.ТипыЦенНоменклатуры") И ЗначениеРассчитывается Тогда
				флСуммаВключаетНДС = ТипЦен.БазовыйТипЦен.ЦенаВключаетНДС;
			Иначе
				флСуммаВключаетНДС = ТипЦен.ЦенаВключаетНДС;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	НовыйДокумент[ИмяРеквизитаТипЦен] = ТипЦен;
	
	Если ИмяКонфигурации1С<>"ТКПТ" Тогда
		НовыйДокумент.УчитыватьНДС		= флУчитыватьНДС;
		НовыйДокумент.СуммаВключаетНДС	= флСуммаВключаетНДС;
	КонецЕсли;
	
	НовыйДокумент.Дата = ТекущаяДата();
	
	НовыйДокумент[ИмяРеквизитаОрганизация] = Сообщение.Продавец1С;
	НовыйДокумент.Контрагент = Сообщение.Покупатель1С;
	
	Если ЕстьРеквизитОбъекта_Контур(НовыйДокумент,"ДоговорВзаиморасчетов") Тогда
		НовыйДокумент.ДоговорВзаиморасчетов = ДоговорКонтрагента;
	ИначеЕсли ЕстьРеквизитОбъекта_Контур(НовыйДокумент,"ДоговорКонтрагента") Тогда
		НовыйДокумент.ДоговорКонтрагента = ДоговорКонтрагента;
	КонецЕсли;
	
	Склад = ПолучитьКонстантуEDI("СоздаваемыйДокументСклад");
	
	Если ЕстьРеквизитОбъекта_Контур(НовыйДокумент,"СкладГруппа") Тогда
		НовыйДокумент.СкладГруппа = Склад;
	ИначеЕсли ЕстьРеквизитОбъекта_Контур(НовыйДокумент,"Склад") Тогда
		НовыйДокумент.Склад = Склад;
	ИначеЕсли ЕстьРеквизитОбъекта_Контур(НовыйДокумент,"СкладКомпании") Тогда
		НовыйДокумент.СкладКомпании = Склад;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ПараметрыПользователяEDI.СозданиеЗаказаРСчет) Тогда
		
		ИмяДокумента = НовыйДокумент.Метаданные().Имя;
		Если ИмяДокумента = "РеализацияТоваровУслуг" ИЛИ ИмяДокумента = "схРеализацияТоваровУслуг" Тогда
			НовыйДокумент.БанковскийСчетОрганизации = ПараметрыПользователяEDI.СозданиеЗаказаРСчет;
		ИначеЕсли ЕстьРеквизитОбъекта_Контур(НовыйДокумент, "СтруктурнаяЕдиница") Тогда
			НовыйДокумент.СтруктурнаяЕдиница = ПараметрыПользователяEDI.СозданиеЗаказаРСчет;	
		КонецЕсли;
				
	КонецЕсли;
	
	Если ЕстьРеквизитОбъекта_Контур(НовыйДокумент,"СрокПоставки") Тогда
		НовыйДокумент.СрокПоставки = Сообщение.ДатаПоставки;
	ИначеЕсли ЕстьРеквизитОбъекта_Контур(НовыйДокумент,"ДатаОтгрузки") Тогда
		НовыйДокумент.ДатаОтгрузки = Сообщение.ДатаПоставки;
	КонецЕсли;
	
	НовыйДокумент.ВалютаДокумента = Сообщение.Валюта1С;
	Если ИмяКонфигурации1С = "ТКПТ" Тогда
			
		Если ЕстьРеквизитОбъекта_Контур(НовыйДокумент, "КурсВалютыУпр") Тогда
			НовыйДокумент.КурсВалютыУпр = 1;	
		КонецЕсли;
		
		Если ПеременнаяСодержитСвойство(НовыйДокумент, "ПодразделениеКомпании") 
			И ПеременнаяСодержитСвойство(ПараметрыСеанса, "Пользователь") Тогда
			НовыйДокумент.ПодразделениеКомпании = ПараметрыСеанса.Пользователь.Подразделение;	
		КонецЕсли;		
		
		НовыйДокумент.КурсДокумента				= 1; 
		
	КонецЕсли;
	
	Если НЕ ИмяКонфигурации1С = "ТКПТ"
		И НЕ ИмяКонфигурации1С = "ХБКП_УСП_2" Тогда
		
		НовыйДокумент.КурсВзаиморасчетов		= 1; 
		НовыйДокумент.КратностьВзаиморасчетов	= 1;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Сообщение.Грузополучатель1С) Тогда
		
		ТочкаДоставкиСторонняя		= ПолучитьЭлементСправочника("ТочкиДоставкиСторонние",Сообщение.Грузополучатель1С);
		ГрузополучательИзЮрФизЛицаТД = ОпределитьЗначениеНастройкиГрузополучательИзЮрФизЛицаТД(Сообщение.Партнер);
		
		Если ГрузополучательИзЮрФизЛицаТД = Истина Тогда

			Если ЕстьРеквизитОбъекта_Контур(НовыйДокумент,"Грузополучатель") Тогда
				НовыйДокумент.Грузополучатель = ТочкаДоставкиСторонняя.ЮрФизЛицо;
				
				//TODO проверить, насколько нам вообще нужен адрес из учетн системы поставщика. Можем ли мы всегда ставить свой адрес, без лишних вопросов?
				Если ЗначениеЗаполнено(НовыйДокумент.Грузополучатель) Тогда
					
					Попытка
						
						Если ИмяКонфигурации1С = "БП" Тогда
							Выполнить("НовыйДокумент.АдресДоставки = УправлениеКонтактнойИнформацией.ПолучитьАдресИзКонтактнойИнформации(НовыйДокумент.Грузополучатель,""Фактический"");");
						ИначеЕсли ИмяКонфигурации1С = "УТ_10_2" Тогда
							Выполнить("НовыйДокумент.АдресДоставки = ПолучитьАдресИзКонтактнойИнформации(НовыйДокумент.Грузополучатель,""Фактический"");");
						Иначе
							Выполнить("НовыйДокумент.АдресДоставки = ЗаполнениеДокументов.ПолучитьАдресДоставкиСтрокой(НовыйДокумент.Грузополучатель, """");");
						КонецЕсли;
						
					Исключение
						ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось заполнить адрес доставки - " + ОписаниеОшибки());	
					КонецПопытки;
						
				КонецЕсли;				
				
			КонецЕсли;
				
		КонецЕсли;
		
		Если ЕстьРеквизитОбъекта_Контур(НовыйДокумент,"АдресДоставки") Тогда
			Если НЕ ЗначениеЗаполнено(НовыйДокумент.АдресДоставки) Тогда	
				Если ЗначениеЗаполнено(ТочкаДоставкиСторонняя.АдресДоставки) Тогда
					НовыйДокумент.АдресДоставки = ТочкаДоставкиСторонняя.АдресДоставки;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// по метаданным находим реквизит точки доставки, и если есть чем заполнять, заполняем его
		Если ЗначениеЗаполнено(ТочкаДоставкиСторонняя.ТочкаДоставкиСвойСправочник) Тогда
			
			РеквизитыШапки = НовыйДокумент.Метаданные().Реквизиты;
			
			Для Каждого Реквизит Из РеквизитыШапки Цикл
				
				ТипыРеквизита = Реквизит.Тип.Типы();
				Если ТипыРеквизита.Количество()=1 Тогда
					Если Реквизит.Тип.СодержитТип(ТипЗнч(ТочкаДоставкиСторонняя.ТочкаДоставкиСвойСправочник)) Тогда
						НовыйДокумент[Реквизит.Имя] = ТочкаДоставкиСторонняя.ТочкаДоставкиСвойСправочник;
						Прервать;
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрыПМ = Новый Структура("ДокументОбъект, Сообщение", НовыйДокумент, Сообщение);
	ОбработкаСобытияПодключаемогоМодуля("ПослеЗаполненияШапкиВходящегоДокумента", , ПараметрыПМ);
	
	ЕстьРеквизитЕдиницаИзмерения_Товары = ЕстьРеквизитОбъекта_Контур(НовыйДокумент,"ЕдиницаИзмерения",ИмяТабЧастиТовары);
	ЕстьХарактеристики_Товары = ЗначениеЗаполнено(ПолучитьТипЗначенияОбъекта("ХарактеристикаНоменклатуры")) 
								И ЕстьРеквизитОбъекта_Контур(НовыйДокумент,"ХарактеристикаНоменклатуры",ИмяТабЧастиТовары); 
								
	ТипЕдиницыИзмерения 			= ПолучитьТипЗначенияОбъекта("ЕдиницаИзмерения",,Истина);   
	ЕстьКоэффициент 				= ЕстьРеквизитОбъекта_Контур(НовыйДокумент,"Коэффициент",ИмяТабЧастиТовары) И 
									  ЕстьНеобходимыеМетаданные("Справочники." +ТипЕдиницыИзмерения+ ".Реквизиты.Коэффициент");

								
	Если ЕстьТабЧастьУслуги = Истина Тогда
									
		ЕстьРеквизитЕдиницаИзмерения_Услуги = ЕстьРеквизитОбъекта_Контур(НовыйДокумент,"ЕдиницаИзмерения",ИмяТабЧастиУслуги);
		ЕстьХарактеристики_Услуги 			= ЗначениеЗаполнено(ПолучитьТипЗначенияОбъекта("ХарактеристикаНоменклатуры")) 
											  И ЕстьРеквизитОбъекта_Контур(НовыйДокумент,"ХарактеристикаНоменклатуры",ИмяТабЧастиУслуги);
		
	Иначе 
		
		ЕстьРеквизитЕдиницаИзмерения_Услуги = Ложь;
		ЕстьХарактеристики_Услуги 			= Ложь;
		
	КонецЕсли;

	ЗаполнятьРазмещение = (Сообщение.Свойство("СписокПредварительныхЗаказов") И ЗначениеЗаполнено(Сообщение.СписокПредварительныхЗаказов))
						ИЛИ Сообщение.ЭтоПредварительныйЗаказ = Истина;
	
	Для Каждого СтрокаСообщения Из Сообщение.Товары Цикл
		
		Если СтрокаСообщения.ТипЕдиницы = "Services" Тогда
			Если РаботаСУслугами Тогда
				Если ЗагружатьУслугиВТабЧастьУслуги 
					И ЕстьТабЧастьУслуги Тогда
					ИмяТабЧасти = ИмяТабЧастиУслуги;
				Иначе
					ИмяТабЧасти = ИмяТабЧастиТовары;
				КонецЕсли;
			Иначе 
				Продолжить;
			КонецЕсли;
		Иначе
			ИмяТабЧасти = ИмяТабЧастиТовары;
		КонецЕсли;
		
		НоваяСтрока = НовыйДокумент[ИмяТабЧасти].Добавить();
		
		НоваяСтрока.Номенклатура		= СтрокаСообщения.Номенклатура;
		Если (ИмяТабЧасти = "Товары" И ЕстьРеквизитЕдиницаИзмерения_Товары)
			ИЛИ (ИмяТабЧасти = "Услуги" И ЕстьРеквизитЕдиницаИзмерения_Услуги) Тогда
			НоваяСтрока.ЕдиницаИзмерения	= СтрокаСообщения.ЕдиницаИзмерения;
		КонецЕсли;
		
		Если НЕ ИмяКонфигурации1С = "БП"
			И НЕ ИмяТабЧасти = "Услуги" Тогда 
			Если ЕстьКоэффициент Тогда 
				НоваяСтрока.Коэффициент			= СтрокаСообщения.ЕдиницаИзмерения.Коэффициент;
			КонецЕсли;	
		КонецЕсли;
		
		Если ИмяКонфигурации1С = "ТКПТ" Тогда
			НовыйДокумент.ОбработкаРеквизита("Товары.ЕдиницаИзмерения", НоваяСтрока);
		КонецЕсли;
		
		Если (ИмяТабЧасти = "Товары" И ЕстьХарактеристики_Товары)
			ИЛИ (ИмяТабЧасти = "Услуги" И ЕстьХарактеристики_Услуги) Тогда
			НоваяСтрока.ХарактеристикаНоменклатуры	= СтрокаСообщения.ХарактеристикаНоменклатуры;
		КонецЕсли; 		
		
		ЗаполнитьСтавкуНДСВСтрокеТовараДокумента(СтрокаСообщения, НоваяСтрока, НовыйДокумент.Дата); 
		
		//Посчитаем цену без НДС / с НДС по суммам без / с НДС, если сеть не прислала эти данные в сообщении
		ЗаполнитьНедостающиеПоляСтрокиТоваров(СтрокаСообщения);
		
		НоваяСтрока.Количество = СтрокаСообщения.Количество;
		
		Если ПеременнаяСодержитСвойство(НоваяСтрока, "ЕдиницаИзмеренияМест") Тогда
			
			ОбработкаТабличныхЧастейМодуль = ОбщийМодуль1С_КонтурEDI("ОбработкаТабличныхЧастей");
			
			Если ОбработкаТабличныхЧастейМодуль <> Неопределено Тогда
				
				Попытка
					ОбработкаТабличныхЧастейМодуль.ЗаполнитьЕдиницуМестТабЧасти(НоваяСтрока, НовыйДокумент, Ложь);
				Исключение 					
				КонецПопытки;
				
			КонецЕсли;
									
			// заполнить единицу измерения мест и рассчитать количество мест
			Если Не ЗначениеЗаполнено(НоваяСтрока.КоличествоМест) Тогда
				
				НоваяСтрока.КоличествоМест = НоваяСтрока.Количество;
				НоваяСтрока.ЕдиницаИзмеренияМест = НоваяСтрока.ЕдиницаИзмерения;
				
			КонецЕсли;
			
		КонецЕсли; 		
		
		Если флСуммаВключаетНДС Тогда
			НоваяСтрока.Цена = СтрокаСообщения.ЦенаСНДС;
		Иначе        
			НоваяСтрока.Цена = СтрокаСообщения.ЦенаБезНДС;
		КонецЕсли;	

		//Теперь необходимо рассчитать сумму по строке и НДС, так как данные, отправленные покупателем, могут быть неправильными.
		Если ИмяКонфигурации1С = "УТ_10_2" 
			Или ИмяКонфигурации1С = "УТ_10_3" 
			Или ИмяКонфигурации1С = "УПП" 
			Или ИмяКонфигурации1С = "КА" 
			Или ИмяКонфигурации1С = "БП" 
			Или ИмяКонфигурации1С = "Розница" 
			Или ИмяКонфигурации1С = "УФ_Розница" 
			Тогда
			
			_ОбщийМодуль = Метаданные.ОбщиеМодули.Найти("ОбработкаТабличныхЧастей");
			Если НовыйДокумент.Метаданные().Имя = "схРеализацияСельхозПродукции" Тогда
				//БСХП
				Выполнить("
					|ПроцентыСтавокНДС = схОбщийСервер.ПолучитьПроцентыСтавокНДС();
					|СтруктураПараметров = Новый Структура(""УчитыватьНДС,СуммаВключаетНДС"", НовыйДокумент.УчитыватьНДС, НовыйДокумент.СуммаВключаетНДС);
					|схОбщийКлиент.РассчитатьСуммуТабЧастиСельхоз(НоваяСтрока, Истина, Истина);
					|схОбщийКлиент.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, ПроцентыСтавокНДС, СтруктураПараметров);
					|");
			ИначеЕсли НЕ _ОбщийМодуль=Неопределено И Не _ОбщийМодуль.Глобальный Тогда
				Выполнить("
					|ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НоваяСтрока, НовыйДокумент);
					|ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, НовыйДокумент);");
			ИначеЕсли Не _ОбщийМодуль = Неопределено Тогда
				Выполнить("
					|РассчитатьСуммуТабЧасти(НоваяСтрока, НовыйДокумент);
					|РассчитатьСуммуНДСТабЧасти(НоваяСтрока, НовыйДокумент);
					|");
			Иначе
				//что-то совсем старое или сильно измененное. В любом случае придется писать код - здесь или в ПМ.
			КонецЕсли;
			
			Если ИмяТабЧасти = "Услуги" Тогда
				Если НЕ _ОбщийМодуль = Неопределено И Не _ОбщийМодуль.Глобальный Тогда
					Выполнить("ОбработкаТабличныхЧастей.ЗаполнитьСодержаниеТабЧасти(НоваяСтрока, НовыйДокумент);");
				ИначеЕсли Не _ОбщийМодуль = Неопределено Тогда
					Выполнить("ЗаполнитьСодержаниеТабЧасти(НоваяСтрока, НовыйДокумент);");
				Иначе
					//что-то совсем старое или сильно измененное. В любом случае придется писать код - здесь или в ПМ.
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ИмяКонфигурации1С = "ТКПТ" Тогда
			
			НовыйДокумент.ОбработкаРеквизита("Товары.Цена",НоваяСтрока);
			
		ИначеЕсли ИмяКонфигурации1С = "ДалионУМ" Тогда
			СвойстваТЧТовары = Новый Структура;
			СвойстваТЧТовары.Вставить("ИмяТЧ", ИмяТабЧасти);
			СвойстваТЧТовары.Вставить("ХарактеристикаНоменклатуры");
			СвойстваТЧТовары.Вставить("ЕдиницаИзмерения");
			СвойстваТЧТовары.Вставить("Цена");
			
			// Здесь нужно использовать один из двух методов. Смотря какой есть в конфигурации. 
			Попытка
				Выполнить("тчПриИзмененииЦеныТабЧастиДокументовОтгрузки(НоваяСтрока, НовыйДокумент, СвойстваТЧТовары);");				
			Исключение
				Выполнить("тчПриИзмененииЦеныТабЧастиРасходнойНакладной(НоваяСтрока, НовыйДокумент, СвойстваТЧТовары);");
			КонецПопытки;
		
		ИначеЕсли ИмяКонфигурации1С = "АСТОР" Тогда
			Выполнить("
				|ОмРаботаСФормами.РассчитатьСуммуТабЧасти(НоваяСтрока);
				|ОмРаботаСФормами.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, НовыйДокумент.ВариантРасчетаНДС);
				|ОмРаботаСФормами.РассчитатьВсегоТабЧасти(НоваяСтрока, НовыйДокумент.ВариантРасчетаНДС);
				|");
		Иначе
		//ИначеЕсли ИмяКонфигурации1С = "ХлебУСП" Тогда
		//ИначеЕсли ИмяКонфигурации1С = "RIT" Тогда
		
		    //в остальных конфигурациях алгоритмы расчета не выяснены. Оставим пока просто заполнение из сообщения, старый вариант.
			Если флСуммаВключаетНДС Тогда
				НоваяСтрока.Сумма = СтрокаСообщения.СуммаСНДС;
			Иначе        
				НоваяСтрока.Сумма = СтрокаСообщения.СуммаБезНДС;
			КонецЕсли;	
			НоваяСтрока.СуммаНДС = СтрокаСообщения.СуммаНДС;
			
		КонецЕсли;
		
		Если ЗаполнятьРазмещение
			И ПеременнаяСодержитСвойство(НоваяСтрока, "Размещение") Тогда 
			
			НоваяСтрока.Размещение = Склад;			
			
		КонецЕсли;
		
		ПараметрыПМ = Новый Структура("СтрокаТабЧасти, СтрокаСообщения, ДокументОбъект, Сообщение", НоваяСтрока, СтрокаСообщения, НовыйДокумент, Сообщение);
		ОбработкаСобытияПодключаемогоМодуля("ПослеЗаполненияСтрокиТабличнойЧастиВходящегоДокумента", , ПараметрыПМ);
		
	КонецЦикла;	
	
	Комментарий="";//В некоторых сообщениях может не быть комментария
	Сообщение.Свойство("Комментарий",Комментарий);
	ТипПоставки = ТипПоставкиСообщения(Сообщение);
	НовыйДокумент.Комментарий = "Загружен из Контур-EDI"+?(ТипПоставки="","",", тип поставки: "+ТипПоставки);
	
	Если ИмяКонфигурации1С = "ТКПТ" 
		или ИмяКонфигурации1С = "ДалионУМ" Тогда
		НовыйДокумент.Автор			= ПолучитьТекущегоПользователя1С();
	Иначе
		НовыйДокумент.Ответственный = ПолучитьТекущегоПользователя1С();
	КонецЕсли;
	
	ДозаполнитьПоляДокументаИзВходящегоORDERS(НовыйДокумент,Сообщение);//свалка алгоритмов из известных типовых конфигураций: счета учета, количество мест, флажки УУ\БУ\НУ и т.д.
	
	//и проставим свои цены вместо тех, что прислал покупатель
	УстанавливатьСобственныеЦеныВЗаказах = (ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Отправитель1С,"УстанавливатьСобственныеЦеныВЗаказах")=Истина);
	
	Если УстанавливатьСобственныеЦеныВЗаказах Тогда
		
		ЦеныУстановлены = ПерезаполнитьЦеныСкидкиВДокументе(НовыйДокумент);
		
		Если Не ЦеныУстановлены Тогда
			ВызватьИсключение "В документе не указан тип цен: невозможно установить собственные цены"; //свалимся намертво, чтоб не пропустить некорректные цены
		КонецЕсли;	
		
	КонецЕсли;
	
	//Обработка настройки ОткрыватьФормуЗаказаПередЗаписью перенесена в шаблон ПМ, событие "ПриЗагрузкеВходящегоСообщения"
	
	Если ИмяКонфигурации1С = "RIT" Тогда
		НовыйДокумент.ОбменДанными.Загрузка = Истина;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьВходящийДокументПоСообщению_ORDERS_УФ(Док, Сообщение)
	
	УстановитьПривилегированныйРежим(Истина);
		
	ОпределитьРелизКонфигурации();
	
	СвойстваПартнера = ПолучитьСписокСвойствEDI("УстанавливатьСобственныеЦеныВЗаказах,РаботаСУслугами,ЗагружатьУслугиВТабЧастьУслуги", Сообщение.Партнер);
	
	ПараметрыЗаполнения = Новый Структура;
	
	ПараметрыЗаполнения.Вставить("СоздаваемыйДокументСклад", 				ПолучитьКонстантуEDI("СоздаваемыйДокументСклад"));
	ПараметрыЗаполнения.Вставить("ТекущийПользователь1С", 					ПолучитьТекущегоПользователя1С());
	ПараметрыЗаполнения.Вставить("ИмяДокументаЗаказ", 						ПолучитьТипЗначенияОбъекта("ВходящийЗаказПокупателя", , Истина));
	ПараметрыЗаполнения.Вставить("УстанавливатьСобственныеЦеныВЗаказах", 	СвойстваПартнера.УстанавливатьСобственныеЦеныВЗаказах = Истина);
	ПараметрыЗаполнения.Вставить("РаботаСУслугами", 						СвойстваПартнера.РаботаСУслугами = Истина);
	ПараметрыЗаполнения.Вставить("ЕстьТабЧастьУслуги", 						ЕстьТабличнаяЧастьОбъекта_Контур(Док, "Услуги"));
	ПараметрыЗаполнения.Вставить("ЗагружатьУслугиВТабЧастьУслуги", 			СвойстваПартнера.ЗагружатьУслугиВТабЧастьУслуги = Истина);
	
	Если ИмяКонфигурации1С = "УФ_УНФ" Тогда
		ЗаполнитьВходящийДокументПоСообщению_ORDERS_УФ_УНФ(Док, Сообщение, ПараметрыЗаполнения);	
	ИначеЕсли ИмяКонфигурации1С = "УФ_УТ" Тогда
		ЗаполнитьВходящийДокументПоСообщению_ORDERS_УФ_УТ(Док, Сообщение, ПараметрыЗаполнения);
	ИначеЕсли ИмяКонфигурации1С = "УФ_Розница" Тогда
		ЗаполнитьВходящийДокументПоСообщению_ORDERS_УФ_Розница(Док, Сообщение, ПараметрыЗаполнения);	
	ИначеЕсли ИмяКонфигурации1С = "УФ_ДалионТРЕНД" Тогда
		ЗаполнитьВходящийДокументПоСообщению_ORDERS_УФ_ДалионТРЕНД(Док, Сообщение, ПараметрыЗаполнения);
	Иначе
		ЗаполнитьВходящийДокументПоСообщению_ORDERS_УФ_БП(Док, Сообщение, ПараметрыЗаполнения);	
	КонецЕсли;   
	
	УстановитьПризнакОбменДаннымиВДокументе_КонтурEDI(Док);
	
КонецПроцедуры 

Процедура ЗаполнитьВходящийДокументПоСообщению_ORDERS_УФ_УНФ(Документ, Сообщение, ПараметрыЗаполнения)
	
	ИмяДокументаЗаказ = ПараметрыЗаполнения.ИмяДокументаЗаказ;
	
	Если ИмяДокументаЗаказ = "РасходнаяНакладная" Тогда
		
		Документ.Дата						= ТекущаяДата();
		Документ.ПоложениеЗаказаПокупателя 	= Перечисления.ПоложениеРеквизитаНаФорме.ВШапке;
		Документ.ВидОперации     			= Перечисления.ВидыОперацийРасходнаяНакладная.ПродажаПокупателю;
		_Подразделение 						= Неопределено;
		
		ОбщийМодуль_УправлениеНебольшойФирмойПовтИсп = ОбщийМодуль1С_КонтурEDI("УправлениеНебольшойФирмойПовтИсп");
		Если Не ОбщийМодуль_УправлениеНебольшойФирмойПовтИсп = Неопределено Тогда
			_Подразделение = ОбщийМодуль_УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеПоУмолчаниюПользователя(ПараметрыСеанса.ТекущийПользователь, "ОсновноеПодразделение");	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(_Подразделение) Тогда
			Если Документ.Подразделение <> _Подразделение Тогда
				Документ.Подразделение = _Подразделение;
			КонецЕсли;
		Иначе
			Документ.Подразделение = Справочники.СтруктурныеЕдиницы.ОсновноеПодразделение;
		КонецЕсли;
		
	Иначе  
		
		//ЗаказПокупателя
		Документ.ДатаИзменения = ТекущаяДата();
		Документ.ДатаОтгрузки  = Сообщение.ДатаПоставки;
		
		// между релизами 1.6.6 и 1.6.7 добавился реквизит документа
		Если ЕстьНеобходимыеМетаданные("Справочники.ВидыЗаказовПокупателей", Истина)
			И ЕстьРеквизитОбъекта_Контур(Документ, "ВидЗаказа") Тогда
			Документ.ВидЗаказа = Справочники.ВидыЗаказовПокупателей.Основной;					
		КонецЕсли;
		
		Если ЕстьНеобходимыеМетаданные("Перечисления.СтатусыЗаказов", Истина) Тогда
			Документ.СостояниеЗаказа = Справочники.СостоянияЗаказовПокупателей.НайтиПоРеквизиту("СтатусЗаказа", Перечисления.СтатусыЗаказов.ВРаботе);
		Иначе 
			
			ОбщийМодуль_ЗаполнениеОбъектовУНФ = ОбщийМодуль1С_КонтурEDI("ЗаполнениеОбъектовУНФ");  
			
			Если ОбщийМодуль_ЗаполнениеОбъектовУНФ <> Неопределено Тогда 
				Попытка
					Документ.СостояниеЗаказа = ОбщийМодуль_ЗаполнениеОбъектовУНФ.ПолучитьСостояниеЗаказаПокупателя(Документ.ВидЗаказа);
				Исключение
					// нет метода в общем модуле.
				КонецПопытки;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Документ.СостояниеЗаказа)  Тогда
				Документ.СостояниеЗаказа = Справочники.СостоянияЗаказовПокупателей.НайтиПоНаименованию("В работе");
			КонецЕсли;
			
		КонецЕсли;
		
		Документ.ПоложениеДатыОтгрузки 	= Перечисления.ПоложениеРеквизитаНаФорме.ВШапке;
		Документ.ВидОперации     		= Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу;
		
	КонецЕсли;
	
	Документ.Автор 		= ПараметрыЗаполнения.ТекущийПользователь1С;
	Документ.Контрагент = Сообщение.Покупатель1С;
	
	Документ.Кратность 		 = 1;
	Документ.Курс 			 = 1;
	Документ.ВалютаДокумента = ВалютаУчета_КонтурEDI();
	
	Документ.Организация = Сообщение.Продавец1С;
	
	Документ.НомерВходящегоДокумента = Сообщение.ДокументEDI.Номер;
	
	ОбщийМодуль_ПодписьДокументовУНФ = ОбщийМодуль1С_КонтурEDI("ПодписьДокументовУНФ");  
	
	Если ОбщийМодуль_ПодписьДокументовУНФ <> Неопределено Тогда 	
		Попытка
			ОбщийМодуль_ПодписьДокументовУНФ.ОбработкаЗаполненияПодписей(Документ);
		Исключение 
			ТекстОшибки = ОписаниеОшибки();
		КонецПопытки;
	КонецЕсли;
	
	//заполнить грузополучателя контрагентом, основной договор, вид цен договора, цена включает НДС!!!
	//для УНФ начиная с какого-то релиза выпилили Грузополучателя пока через попытку
	
	Если ЕстьРеквизитОбъекта_Контур(Документ, "Грузополучатель") Тогда
		Если ЗначениеЗаполнено(Сообщение.Грузополучатель1С) И ЗначениеЗаполнено(Сообщение.Грузополучатель1С.СвязанныйСправочник1) Тогда 
			Документ.Грузополучатель = Сообщение.Грузополучатель1С.СвязанныйСправочник1;
		Иначе
			Документ.Грузополучатель = Документ.Контрагент;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыПользователяEDI.СозданиеЗаказаРСчет) Тогда
		Документ.БанковскийСчет	= ПараметрыПользователяEDI.СозданиеЗаказаРСчет;
	КонецЕсли;
	
	Если ПараметрыЗаполнения.СоздаваемыйДокументСклад <> Неопределено Тогда
		СтруктурнаяЕдиницаЗаполнения = ПараметрыЗаполнения.СоздаваемыйДокументСклад;
	Иначе
		СтруктурнаяЕдиницаЗаполнения = Справочники.СтруктурныеЕдиницы.ОсновнойСклад;
	КонецЕсли;
	
	Если ЕстьРеквизитОбъекта_Контур(Документ, "СтруктурнаяЕдиница") Тогда 
		Документ.СтруктурнаяЕдиница = СтруктурнаяЕдиницаЗаполнения;
	КонецЕсли;
	Если ЕстьРеквизитОбъекта_Контур(Документ, "СтруктурнаяЕдиницаПродажи") Тогда 
		Документ.СтруктурнаяЕдиницаПродажи = СтруктурнаяЕдиницаЗаполнения;
	КонецЕсли;
	Если ЕстьРеквизитОбъекта_Контур(Документ, "СтруктурнаяЕдиницаРезерв") Тогда 
		Документ.СтруктурнаяЕдиницаРезерв = СтруктурнаяЕдиницаЗаполнения;
	КонецЕсли;
	
	МенеджерСправочника = Справочники.ДоговорыКонтрагентов;
	
	СписокВидовДоговоров = МенеджерСправочника.ПолучитьСписокВидовДоговораДляДокумента(Документ.Ссылка, Документ.ВидОперации);
	ДоговорПоУмолчанию   = МенеджерСправочника.ПолучитьДоговорПоУмолчаниюПоОрганизацииВидуДоговора(Документ.Контрагент, Документ.Организация, СписокВидовДоговоров);
	
	Документ.Договор = ДоговорПоУмолчанию;
	
	Если ЗначениеЗаполнено(Документ.Договор) Тогда            
		//РаботаСКурсамиВалют 
		Реквизиты_ДоговораДокумента 	 = ПолучитьЗначенияРеквизитовОбъекта(Документ.Договор, НовыйМассив("ВалютаРасчетов", "ВидСкидкиНаценки", "ВидЦен"));
		Документ.ВалютаДокумента         = Реквизиты_ДоговораДокумента.ВалютаРасчетов;
		ВалютаРасчетовКурсКратность 	 = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(ТекущаяДата(), Новый Структура("Валюта", Реквизиты_ДоговораДокумента.ВалютаРасчетов));
		Документ.Курс                    = ?(ВалютаРасчетовКурсКратность.Курс = 0, 1, ВалютаРасчетовКурсКратность.Курс);
		Документ.Кратность               = ?(ВалютаРасчетовКурсКратность.Кратность = 0, 1, ВалютаРасчетовКурсКратность.Кратность);
		Документ.ВидСкидкиНаценки        = Реквизиты_ДоговораДокумента.ВидСкидкиНаценки;
		Документ.ВидЦен                  = Реквизиты_ДоговораДокумента.ВидЦен;
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА Организации.БанковскийСчетПоУмолчанию.ВалютаДенежныхСредств = &ВалютаДенежныхСредств
		|			ТОГДА Организации.БанковскийСчетПоУмолчанию
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК БанковскийСчет,
		|	Организации.КассаПоУмолчанию КАК Касса
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.Ссылка = &Организация");
		
		ТипОрганизации = ПолучитьТипЗначенияОбъекта("ЮрФизЛицоСвое",,Истина);
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Справочник.Организации", "Справочник." + ТипОрганизации);
		Запрос.УстановитьПараметр("Организация", Документ.Организация);
		Запрос.УстановитьПараметр("ВалютаДенежныхСредств", Документ.ВалютаДокумента);
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			Документ.БанковскийСчет = Выборка.БанковскийСчет;
			
			Если ИмяДокументаЗаказ = "ЗаказПокупателя" Тогда 
				Документ.Касса = Выборка.Касса;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	ОбщийМодуль_НалогиУНФ = ОбщийМодуль1С_КонтурEDI("НалогиУНФ");
	
	Если ОбщийМодуль_НалогиУНФ <> Неопределено Тогда
		Попытка
			НастройкиНДСОрганизации = ОбщийМодуль_НалогиУНФ.НастройкиНДСОрганизации(Документ.Организация, , Документ.ДатаИзменения);
			Документ.НалогообложениеНДС = НастройкиНДСОрганизации.ТипНалогообложения; 		
		Исключение 
			Попытка
				Документ.НалогообложениеНДС = ОбщийМодуль_НалогиУНФ.НалогообложениеНДС(Документ.Организация, , Документ.ДатаИзменения);	
			Исключение
				ТекстОшибки = ОписаниеОшибки();
			КонецПопытки;
		КонецПопытки;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Документ.НалогообложениеНДС) Тогда
		Документ.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Документ.ВидЦен) Тогда
		ВидЦен_ЦенаВключаетНДС = ПолучитьЗначениеРеквизитаОбъекта_КонтурEDI(Документ.ВидЦен, "ЦенаВключаетНДС");
		Документ.СуммаВключаетНДС = ВидЦен_ЦенаВключаетНДС;
	КонецЕсли;
	
	флСуммаВключаетНДС 				= Документ.СуммаВключаетНДС;
	Документ.НДСВключатьВСтоимость  = флСуммаВключаетНДС;
	
	ТипПоставки = ТипПоставкиСообщения(Сообщение);
	
	Документ.Комментарий = "Загружен из Контур-EDI";
	Если ЗначениеЗаполнено(ТипПоставки) Тогда
		Документ.Комментарий = Документ.Комментарий + КонтурСтандарт_СтрШаблон_(", тип поставки: %1", ТипПоставки);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Документ.Дата) Тогда 
		Документ.Дата = ТекущаяДата();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Сообщение.Грузополучатель1С) Тогда
		Если ЕстьРеквизитОбъекта_Контур(Документ, "АдресДоставки") Тогда 
			Документ.АдресДоставки = Сообщение.Грузополучатель1С.АдресДоставки;
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыПМ = Новый Структура("ДокументОбъект, Сообщение", Документ, Сообщение);
	ОбработкаСобытияПодключаемогоМодуля("ПослеЗаполненияШапкиВходящегоДокумента", , ПараметрыПМ);
	
	ИмяТабЧастиТовары = "Запасы";
	ИмяТабЧастиУслуги = "Услуги";
	
	Документ[ИмяТабЧастиТовары].Очистить();
	
	Если ПараметрыЗаполнения.РаботаСУслугами Тогда
		Если ПараметрыЗаполнения.ЗагружатьУслугиВТабЧастьУслуги
			И ПараметрыЗаполнения.ЕстьТабЧастьУслуги Тогда
			Документ[ИмяТабЧастиУслуги].Очистить();
		Иначе
			ИмяТабЧастиУслуги = ИмяТабЧастиТовары;	
		КонецЕсли;
	КонецЕсли;	
	
	КэшированныеЗначения = ОбработкаТабличнойЧасти_КэшированныеЗначения();
	
	ТоварыЗаказа = Сообщение.Товары;
	
	Для Каждого Стр Из ТоварыЗаказа Цикл
		
		Если Стр.НеЗагружать = Истина Тогда 
			Продолжить; 
		КонецЕсли;
		
		Если Стр.ТипЕдиницы = "Services" Тогда
			Если ПараметрыЗаполнения.РаботаСУслугами Тогда
				ИмяТабЧасти = ИмяТабЧастиУслуги;
			Иначе 
				Продолжить;
			КонецЕсли;
		Иначе
			ИмяТабЧасти = ИмяТабЧастиТовары;
		КонецЕсли;
		
		НоваяСтрока = Документ[ИмяТабЧасти].Добавить();
		
		НоваяСтрока.Номенклатура		= Стр.Номенклатура;
		НоваяСтрока.ЕдиницаИзмерения	= Стр.ЕдиницаИзмерения;
		
		Если ЕстьРеквизитОбъекта_Контур(Документ, "СтруктурнаяЕдиница", ИмяТабЧасти) 
			И ЕстьРеквизитОбъекта_Контур(Документ, "СтруктурнаяЕдиница") Тогда
			
			НоваяСтрока.СтруктурнаяЕдиница = Документ.СтруктурнаяЕдиница;
			
		КонецЕсли;
		
		НоваяСтрока.Количество = Стр.Количество;
		
		Если ЗначениеЗаполнено(Стр.ХарактеристикаНоменклатуры) Тогда 
			НоваяСтрока.Характеристика = Стр.ХарактеристикаНоменклатуры;
		КонецЕсли;
		
		Если ЕстьРеквизитОбъекта_Контур(Документ, "ТипНоменклатурыЗапас", ИмяТабЧасти) Тогда
			ТипНоменклатуры = Неопределено;
			Если ПеременнаяСодержитСвойство(Стр.Номенклатура, "ТипНоменклатуры", ТипНоменклатуры, Истина)  Тогда
				ТипНоменклатурыЗапас = Вычислить("Перечисления.ТипыНоменклатуры.Запас");
				НоваяСтрока.ТипНоменклатурыЗапас = ТипНоменклатуры = ТипНоменклатурыЗапас;
			КонецЕсли;
		КонецЕсли;
		
		ЗаполнитьСтавкуНДСВСтрокеТовараДокумента(Стр, НоваяСтрока, Документ.Дата);
		
		ЗаполнитьНедостающиеПоляСтрокиТоваров(Стр);
		
		Если флСуммаВключаетНДС Тогда
			НоваяСтрока.Цена = Стр.ЦенаСНДС;
		Иначе        
			НоваяСтрока.Цена = Стр.ЦенаБезНДС;
		КонецЕсли;
		
		НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Цена;
		СтавкаНДС = 22;
		
		Модуль_УправлениеНебольшойФирмойПовтИсп = ОбщийМодуль1С_КонтурEDI("УправлениеНебольшойФирмойПовтИсп");
		Если Модуль_УправлениеНебольшойФирмойПовтИсп <> Неопределено Тогда   
			СтавкаНДС = Модуль_УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеСтавкиНДС(НоваяСтрока.СтавкаНДС);	
		КонецЕсли;
		
		Если флСуммаВключаетНДС Тогда
			НоваяСтрока.СуммаНДС = НоваяСтрока.Сумма - (НоваяСтрока.Сумма) / ((СтавкаНДС + 100) / 100);	
		Иначе
			НоваяСтрока.СуммаНДС = НоваяСтрока.Сумма * СтавкаНДС / 100;	
		КонецЕсли;
		
		НоваяСтрока.Всего = НоваяСтрока.Сумма + ?(Документ.СуммаВключаетНДС, 0, НоваяСтрока.СуммаНДС);						  
		
		Если РелизКонфигурации1С = "1.6" Тогда 
			Попытка  
				Модуль_РаботаСНоменклатуройКлиентСервер = ОбщийМодуль1С_КонтурEDI("РаботаСНоменклатуройКлиентСервер");
				
				Если Модуль_РаботаСНоменклатуройКлиентСервер <> Неопределено Тогда 
					Модуль_РаботаСНоменклатуройКлиентСервер.РассчитатьСуммуВСтрокеТабличнойЧасти(Документ, НоваяСтрока, ИмяТабЧасти);
				КонецЕсли; 
				
			Исключение  
				Модуль_НоменклатураВДокументахКлиентСервер = ОбщийМодуль1С_КонтурEDI("НоменклатураВДокументахКлиентСервер"); 
				
				Если Модуль_НоменклатураВДокументахКлиентСервер <> Неопределено Тогда  	
					Модуль_НоменклатураВДокументахКлиентСервер.РассчитатьСуммуВСтрокеТабличнойЧасти(Документ, НоваяСтрока, ИмяТабЧасти);
				КонецЕсли;  
				
			КонецПопытки;
		КонецЕсли;		
			
		ПараметрыПМ = Новый Структура("СтрокаТабЧасти, СтрокаСообщения, ДокументОбъект, Сообщение", НоваяСтрока, Стр, Документ, Сообщение);
		ОбработкаСобытияПодключаемогоМодуля("ПослеЗаполненияСтрокиТабличнойЧастиВходящегоДокумента", , ПараметрыПМ);
		
	КонецЦикла;                                        
	
	Документ.СуммаДокумента = Документ[ИмяТабЧасти].Итог("Всего");
	
	Если ЗначениеЗаполнено(Сообщение.Партнер) И ПараметрыЗаполнения.УстанавливатьСобственныеЦеныВЗаказах Тогда 
		
		ЦеныУстановлены = Ложь;
		
		Если  РелизКонфигурации1С = "1.5" Тогда
			
			ЦеныУстановлены = УстановитьСобственныеценыВЗаказ_УНФ15(Документ);
			
		ИначеЕсли РелизКонфигурации1С = "1.6" Тогда
			
			ЦеныУстановлены = УстановитьСобственныеценыВЗаказ_УНФ16(Документ);
			
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

Процедура ЗаполнитьВходящийДокументПоСообщению_ORDERS_УФ_Розница(Документ, Сообщение, ПараметрыЗаполнения)
	
	Грузополучатель = Сообщение.Грузополучатель1С;
	
	Документ.Заполнить(Неопределено);
	
	Документ.Дата				= ТекущаяДата();
	Документ.Ответственный		= ПараметрыЗаполнения.ТекущийПользователь1С; 		
	Документ.Организация		= Сообщение.Продавец1С;    		
	Документ.Контрагент			= Сообщение.Покупатель1С;	
	Документ.Склад				= ПараметрыЗаполнения.СоздаваемыйДокументСклад;
	
	флСуммаВключаетНДС = Документ.ЦенаВключаетНДС;
	
	ТипПоставки = ТипПоставкиСообщения(Сообщение);
	
	Документ.Комментарий = "Загружен из Контур-EDI";
	Если ЗначениеЗаполнено(ТипПоставки) Тогда
		Документ.Комментарий = Документ.Комментарий + КонтурСтандарт_СтрШаблон_(", тип поставки: %1", ТипПоставки);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Документ.Дата) Тогда 
		Документ.Дата = ТекущаяДата();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Сообщение.Грузополучатель1С) Тогда
		Если ЕстьРеквизитОбъекта_Контур(Документ, "АдресДоставки") Тогда 
			Документ.АдресДоставки = Сообщение.Грузополучатель1С.АдресДоставки;
		КонецЕсли;
	КонецЕсли;

	ПараметрыПМ = Новый Структура("ДокументОбъект, Сообщение", Документ, Сообщение);
	ОбработкаСобытияПодключаемогоМодуля("ПослеЗаполненияШапкиВходящегоДокумента", , ПараметрыПМ);
	
	ИмяТабЧастиТовары = "Товары";
	ИмяТабЧастиУслуги = "Услуги";
	
	Документ[ИмяТабЧастиТовары].Очистить();

	Если ПараметрыЗаполнения.РаботаСУслугами Тогда
		Если ПараметрыЗаполнения.ЗагружатьУслугиВТабЧастьУслуги
			И ПараметрыЗаполнения.ЕстьТабЧастьУслуги Тогда
		    Документ[ИмяТабЧастиУслуги].Очистить();
		Иначе
			ИмяТабЧастиУслуги = ИмяТабЧастиТовары;	
		КонецЕсли;
	КонецЕсли;	
	
	КэшированныеЗначения = ОбработкаТабличнойЧасти_КэшированныеЗначения();

	ТоварыЗаказа = Сообщение.Товары;
	
	Для Каждого Стр Из ТоварыЗаказа Цикл
		
		Если Стр.НеЗагружать = Истина Тогда 
			Продолжить; 
		КонецЕсли;
		
		Если Стр.ТипЕдиницы = "Services" Тогда
			Если ПараметрыЗаполнения.РаботаСУслугами Тогда
				ИмяТабЧасти = ИмяТабЧастиУслуги;
			Иначе 
				Продолжить;
			КонецЕсли;
		Иначе
			ИмяТабЧасти = ИмяТабЧастиТовары;
		КонецЕсли;                                
		
		НоваяСтрока = Документ[ИмяТабЧасти].Добавить();
		
		НоваяСтрока.Номенклатура		= Стр.Номенклатура;
		НоваяСтрока.Упаковка			= Стр.ЕдиницаИзмерения;
		НоваяСтрока.КоличествоУпаковок	= Стр.Количество;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.Упаковка) Тогда 
			НоваяСтрока.Количество = Стр.Количество;//базовая единица
		Иначе                           
			НоваяСтрока.Количество = Стр.Количество * ПолучитьКоэффициентУпаковкиУФ_УТ(НоваяСтрока.Упаковка);  
		КонецЕсли;       
		
		НоваяСтрока.Характеристика = Стр.ХарактеристикаНоменклатуры; 
		
		ЗаполнитьСтавкуНДСВСтрокеТовараДокумента(Стр, НоваяСтрока, Документ.Дата);
		
		ЗаполнитьНедостающиеПоляСтрокиТоваров(Стр);  
		
		Если флСуммаВключаетНДС Тогда
			НоваяСтрока.Цена = Стр.ЦенаСНДС;
		Иначе        
			НоваяСтрока.Цена = Стр.ЦенаБезНДС;
		КонецЕсли;
		
		Модуль_ОбработкаТабличнойЧастиТоварыСервер = ОбщийМодуль1С_КонтурEDI("ОбработкаТабличнойЧастиТоварыСервер");
		
		Попытка
			НоваяСтрока.СуммаНДС = Модуль_ОбработкаТабличнойЧастиТоварыСервер.РассчитатьСуммуНДС(НоваяСтрока.Сумма, НоваяСтрока.СтавкаНДС, флСуммаВключаетНДС);
		Исключение        
			Модуль_ОбработкаТабличнойЧастиТоварыКлиентСервер = ОбщийМодуль1С_КонтурEDI("ОбработкаТабличнойЧастиТоварыКлиентСервер");
			
			НоваяСтрока.СуммаНДС = Модуль_ОбработкаТабличнойЧастиТоварыКлиентСервер.СуммаНДС(НоваяСтрока.Сумма, НоваяСтрока.СтавкаНДС, флСуммаВключаетНДС);
		КонецПопытки;
		
		Модуль_ОбработкаТабличнойЧастиТоварыСервер.ОбработатьСтрокуТЧСервер(НоваяСтрока, Новый Структура("ПересчитатьСумму"), КэшированныеЗначения);
		
		ПараметрыПМ = Новый Структура("СтрокаТабЧасти, СтрокаСообщения, ДокументОбъект, Сообщение", НоваяСтрока, Стр, Документ, Сообщение);
		ОбработкаСобытияПодключаемогоМодуля("ПослеЗаполненияСтрокиТабличнойЧастиВходящегоДокумента", , ПараметрыПМ);

	КонецЦикла;        
	
	Если флСуммаВключаетНДС Тогда 
		Документ.СуммаДокумента = Документ[ИмяТабЧасти].Итог("Сумма");
	Иначе
		Документ.СуммаДокумента = Документ[ИмяТабЧасти].Итог("СуммаСНДС");
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьВходящийДокументПоСообщению_ORDERS_УФ_ДалионТРЕНД(Документ, Сообщение, ПараметрыЗаполнения)
	
