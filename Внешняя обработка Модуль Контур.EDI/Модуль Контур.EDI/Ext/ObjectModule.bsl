	КонтурEDIAPI_УстановитьЗаголовокАвторизации(ДанныеАвторизацииEDI);	 
	
	МенеджерНастроек = КонтурEDIAPI_МенеджерНастроек();
	
	ПараметрыСервиса = КонтурEDIAPI_Authenticate();    						

	Ответ = КонтурEDIAPI_Post(Неопределено, ПараметрыСервиса.URL, , , МенеджерНастроек.Сессия); 	
	
	ПодготовленныйОтветКлиента = КонтурEDIAPI_ОбработатьРезультатHTTPЗапроса(ПараметрыСервиса, Ответ);	

