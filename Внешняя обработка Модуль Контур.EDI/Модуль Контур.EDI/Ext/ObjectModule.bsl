		УдалитьРасширенияПоИдентификаторам(ИдентификаторыРасширения);
		
	КонецЕсли;
	
	Если СравнитьСемантикВерсии(ВерсияМодуляВ1С, "4.41.1") = ВидСравнения.Меньше Тогда
		ПроверкаНовойВерсии_ОбновитьРасширенияИспользующиеКартинкаШтрихкода();
	КонецЕсли;
	
	Если СравнитьСемантикВерсии(ВерсияМодуляВ1С, "4.42.0") = ВидСравнения.Меньше Тогда
				
		ИдентификаторыРасширения = Новый Массив;
		ИдентификаторыРасширения.Добавить("total_code_2");
		
		УдалитьРасширенияПоИдентификаторам(ИдентификаторыРасширения);
		
		ПроверкаНовойВерсии_ОбновитьРасширенияИсправительныйINVOICБезДокумента();
		
	КонецЕсли; 
	
	Если СравнитьСемантикВерсии(ВерсияМодуляВ1С, "4.46.0") = ВидСравнения.Меньше Тогда
		
		ПроверкаНовойВерсии_ОбновитьТиповоеРасширениеКодыМаркировки();
		
	КонецЕсли;

	Если СравнитьСемантикВерсии(ВерсияМодуляВ1С, "4.51.0") = ВидСравнения.Меньше Тогда
		
		ПроверкаНовойВерсии_ОтправлятьПоказателиПроизводительности();
		ПроверкаНовойВерсии_ВключитьАвтообновлениеМодуля();
		
	КонецЕсли;
	
	Если СравнитьСемантикВерсии(ВерсияМодуляВ1С, "4.52.0") = ВидСравнения.Меньше Тогда
		
		ПроверкаНовойВерсии_РазделитьНастройкиПартнеров();
		
	КонецЕсли;
	
	Если СравнитьСемантикВерсии(ВерсияМодуляВ1С, "4.54.0") = ВидСравнения.Меньше Тогда
		
		ПроверкаНовойВерсии_СпособПередачиМашиночитаемойДоверенности();
		
	КонецЕсли;
	
	Если СравнитьСемантикВерсии(ВерсияМодуляВ1С, "4.56.0") = ВидСравнения.Меньше Тогда
		ПроверкаНовойВерсии_ПеренестиПарольИзРегистраСведенийВХранилище();
	КонецЕсли;
	
	Если СравнитьСемантикВерсии(ВерсияМодуляВ1С, "4.58.0") = ВидСравнения.Меньше Тогда
		
