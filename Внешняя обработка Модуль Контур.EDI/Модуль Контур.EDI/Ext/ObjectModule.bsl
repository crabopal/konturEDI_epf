//{{{*********  УниверсальнаяФормаРедактирования *********

Функция СтруктураСвойствТаблицыМаппинга() Экспорт
	
	Структура = Новый Структура;
	Структура.Вставить("ИмяПоля");
	Структура.Вставить("ТипПоля");
	Структура.Вставить("ИмяСтруктуры");
	Структура.Вставить("Представление");
	Структура.Вставить("ИмяСпискаВыбора");
	
	Возврат Структура;
	
КонецФункции

Процедура ПолучитьДеревоДопРеквизитов_ДляРедактирования(СтруктураРеквизита, Сообщение)  Экспорт
	
	ДеревоДляОткрытияУниверсальнойФормыРедактирования = ПодготовитьДеревоДляОткрытияУниверсальнойФормыРедактированияРеквизитов();
	
	НастройкаРеквизитов	= ПолучитьНастройкуРеквизитов_КонтурEDI(Новый Структура("ИмяРеквизита", СтруктураРеквизита.ИмяРеквизита));
	
	ДобавитьНастройкиВДеревоУниверсальнойФормыРедактированияРекурсивно(НастройкаРеквизитов, ДеревоДляОткрытияУниверсальнойФормыРедактирования, Сообщение);
	
	СтруктураРеквизита.Вставить("ДеревоЗначения",		ДеревоДляОткрытияУниверсальнойФормыРедактирования);
	СтруктураРеквизита.Вставить("НастройкаРеквизитов",	НастройкаРеквизитов); 
	
КонецПроцедуры

Функция ПолучитьЗначениеИзПутиВСообщении(Сообщение,ПутьКЗначению)
			
	СписокСтрок = РазложитьСтроку(ПутьКЗначению, ".");
	
	Значение = Сообщение;
	Для каждого Стр Из СписокСтрок Цикл
		Если Значение.Свойство(Стр.Значение) Тогда
			Значение = Значение[Стр.Значение];
		Иначе
			Возврат Неопределено;
		КонецЕсли; 				
	КонецЦикла;
	
	Возврат Значение;
		
КонецФункции

Процедура ДобавитьНастройкиВДеревоУниверсальнойФормыРедактированияРекурсивно(НастройкаРеквизитов, Дерево, Сообщение)

	 Для каждого Настройка Из НастройкаРеквизитов Цикл
		
		СтрокаДерева = Дерево.Строки.Добавить();
		
		ЗначениеИзПути = Неопределено;
		
		ПутьКЗначению	= СтрЗаменить(Настройка.ПутьКЗначению,"Сообщение.", "");
		ЗначениеИзПути 	= ПолучитьЗначениеИзПутиВСообщении(Сообщение,ПутьКЗначению);
		
		Если ЗначениеЗаполнено(Настройка.ТипРеквизита) И ЗначениеЗаполнено(ЗначениеИзПути)  Тогда
			
			ЗначениеИзПути = ПривестиЗначениеПоТипуРеквизита(ЗначениеИзПути,Строка(Настройка.ТипРеквизита));
			
		Иначе
			
			ЗначениеИзПути = Настройка.ЗначениеПоУмолчанию;
			
		КонецЕсли;
				
		СтрокаДерева.ИмяРеквизита			= Настройка.ИмяРеквизита;
		СтрокаДерева.Значение				= ЗначениеИзПути;
		СтрокаДерева.ПредставлениеРеквизита	= Настройка.ПредставлениеРеквизита;
		
		НастройкаВложенныхРеквизитов = ПолучитьНастройкуРеквизитов_КонтурEDI(Новый Структура("ИмяГруппыРеквизитов", Настройка.ИмяРеквизита));

		ДобавитьНастройкиВДеревоУниверсальнойФормыРедактированияРекурсивно(НастройкаВложенныхРеквизитов, СтрокаДерева, Сообщение);
		
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьНастройкуРеквизитов_КонтурEDI(Знач СтруктураОтбора) Экспорт
	
	НастройкиРеквизитов	 	= ПолучитьЗаписиДопСправочника_КонтурEDI("НастройкиРеквизитов", СтруктураОтбора);
	
	Если НастройкиРеквизитов.Количество() = 0 Тогда
		ДобавитьНастройкуРеквизитов(СтруктураОтбора);
		НастройкиРеквизитов =  ПолучитьЗаписиДопСправочника_КонтурEDI("НастройкиРеквизитов", СтруктураОтбора);
	КонецЕсли;
	
	Возврат НастройкиРеквизитов;
	
КонецФункции

Функция ПолучитьНастройкиОсновныхРеквизитов() Экспорт
        			
	МетаданныеРеквизитов = ПолучитьМетаданныеДопРеквизитов_КонтурEDI();				 
	
	СтруктураДопСправочника = НовыйСтруктураДопСправочника_КонтурEDI("НастройкиРеквизитов");
	ПустаяСтруктура			= СтруктураДопСправочника;     
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(КонтурEDI_ДопРеквизиты_ИмяРеквизита.Значение, НЕОПРЕДЕЛЕНО) КАК ИмяРеквизита
	|ИЗ
	|	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК КонтурEDI_ДопРеквизиты_ИмяРеквизита
	|		ПО (КонтурEDI_ДополнительныеСправочники.ИмяСправочника = ""НастройкиРеквизитов"")
	|			И (НЕ КонтурEDI_ДополнительныеСправочники.ПометкаУдаления)
	|			И (КонтурEDI_ДопРеквизиты_ИмяРеквизита.Ссылка = КонтурEDI_ДополнительныеСправочники.Ссылка)
	|			И (КонтурEDI_ДопРеквизиты_ИмяРеквизита.ИмяРеквизита = ""ИмяРеквизита"")";
	
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Для каждого ЭлементМетаданыеРеквизитов Из МетаданныеРеквизитов Цикл
		
		ТекущиеНастройки = Таблица.Найти(ЭлементМетаданыеРеквизитов.ИмяРеквизита, "ИмяРеквизита");
		
		Если НЕ ЗначениеЗаполнено(ТекущиеНастройки) Тогда
			
			СтруктураДопСправочника.Ссылка = Неопределено;
			ЗаполнитьЗначенияСвойств(СтруктураДопСправочника, ПустаяСтруктура);  			
			ЗаполнитьЗначенияСвойств(СтруктураДопСправочника, ЭлементМетаданыеРеквизитов); 
			
			СтруктураДопСправочника.Наименование = "" + ?(ЗначениеЗаполнено(СтруктураДопСправочника.ИмяГруппыРеквизитов),СтруктураДопСправочника.ИмяГруппыРеквизитов,"") + СтруктураДопСправочника.ИмяРеквизита; 
			
			ЗаписатьЭлементДопСправочника_КонтурEDI(СтруктураДопСправочника);

		КонецЕсли;
		
	КонецЦикла;	
	
	НастройкиРеквизитов	= ПолучитьЗаписиДопСправочника_КонтурEDI("НастройкиРеквизитов", Новый Структура);
	
	Возврат НастройкиРеквизитов;
	
КонецФункции

Функция ПодготовитьДеревоДляОткрытияУниверсальнойФормыРедактированияРеквизитов() Экспорт

	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Строка"));
	МассивТипов.Добавить(Тип("Число"));
	
	МассивДляВключенияВсехМетаданных = Новый Массив;
	МассивДляВключенияВсехМетаданных.Добавить(Новый Структура("ИмяМетаданных, ИмяТипа", "Справочники", "СправочникСсылка"));
	МассивДляВключенияВсехМетаданных.Добавить(Новый Структура("ИмяМетаданных, ИмяТипа", "Перечисления", "ПеречислениеСсылка"));
	
	ВозможныеТипы = ПолучитьТипЗначения_КонтурEDI(МассивТипов, МассивДляВключенияВсехМетаданных);
			
	МассивКолонок = Новый Массив;
	МассивКолонок.Добавить(Новый Структура("Имя, Тип, Заголовок, Ширина", "ПредставлениеРеквизита",	Неопределено, 	"Реквизит",			0));
	МассивКолонок.Добавить(Новый Структура("Имя, Тип, Заголовок, Ширина", "Значение", 				ВозможныеТипы, 	"Значение",			0)); 
	МассивКолонок.Добавить(Новый Структура("Имя, Тип, Заголовок, Ширина", "ИмяРеквизита",			Неопределено, 	"Имя реквизита",	0));

	
	ДеревоДляОткрытияУниверсальнойФормыРедактирования	= ПодготовитьДеревоЗначений_КонтурEDI(МассивКолонок);
	
	Возврат ДеревоДляОткрытияУниверсальнойФормыРедактирования;
	
КонецФункции

Процедура ДобавитьНастройкуРеквизитов(Структура)
 
	СтруктураДопСправочника = НовыйСтруктураДопСправочника_КонтурEDI("НастройкиРеквизитов");
	
	МетаданныеРеквизитов = ПолучитьМетаданныеДопРеквизитов_КонтурEDI();				 
	СтрокиРеквизитовСправочника = МетаданныеРеквизитов.НайтиСтроки(Структура);
	
	МетаданныеРеквизитов_ГруппыРеквизитов = МетаданныеРеквизитов.Скопировать(СтрокиРеквизитовСправочника);
	
	Для каждого ЭлементМетаданыеРеквизитов Из МетаданныеРеквизитов_ГруппыРеквизитов Цикл
		СтруктураДопСправочника.Ссылка = Неопределено;
		
		ЗаполнитьЗначенияСвойств(СтруктураДопСправочника,ЭлементМетаданыеРеквизитов); 
		
		СтруктураДопСправочника.Наименование = "" + ?(ЗначениеЗаполнено(СтруктураДопСправочника.ИмяГруппыРеквизитов),СтруктураДопСправочника.ИмяГруппыРеквизитов,"") + СтруктураДопСправочника.ИмяРеквизита;
		
		ЗаписатьЭлементДопСправочника_КонтурEDI(СтруктураДопСправочника)                  
	КонецЦикла;
	  
 КонецПроцедуры
 
Функция ПолучитьМетаданныеДопРеквизитов_КонтурEDI() Экспорт
	
	ТаблицаМетаданных = ЭДО_Кэш_Прочитать("ДопРеквизиты_Метаданные");
	
	Если ТаблицаМетаданных = Неопределено Тогда
		
		Макет = ПолучитьМакет("Маппинг_НастройкиРеквизитов");
		ТаблицаМетаданных = ПолучитьТаблицуМетаданныхДопРеквизитов_КонтурEDI(Макет);
		
		ОбработкаСобытияПодключаемогоМодуля("ИзменитьМетаданныеДопРеквизитов",,Новый Структура("ТаблицаМетаданных", ТаблицаМетаданных));
		ЭДО_Кэш_Поместить("ДопРеквизиты_Метаданные", ТаблицаМетаданных);
		
	КонецЕсли;
	
	Возврат ТаблицаМетаданных;
	
КонецФункции

Функция ПолучитьТаблицуМетаданныхДопРеквизитов_КонтурEDI(Макет)
	
	ТабМетаданных = Новый ТаблицаЗначений;
	ДобавитьКолонкиВТаблицуЗначений(ТабМетаданных, 
	"ИмяГруппыРеквизитов, ИмяРеквизита, ПредставлениеРеквизита, ТипРеквизита, ЗначениеПоУмолчанию ,ПутьКЗначению, ПутьЗаписиВДопСправочник, ОтборПоДопСправочнику, ТипыСообщений, ЭтоГруппаРеквизитов, ЧтоНужноДозаписать_в_ДопСправочник, КлючевыеРеквизиты");
	
	Если Макет = Неопределено Тогда
		Возврат ТабМетаданных;
	КонецЕсли;
	
	ОбластьДопСправочники = Макет.ПолучитьОбласть("Метаданные");
	
	Для Сч = 1 По ОбластьДопСправочники.ВысотаТаблицы Цикл
		НоваяСтрока = ТабМетаданных.Добавить();
		
		НоваяСтрока.ИмяРеквизита						= ПолучитьТекстЯчейкиОбласти(ОбластьДопСправочники, Сч, 1);
		НоваяСтрока.ИмяГруппыРеквизитов					= ПолучитьТекстЯчейкиОбласти(ОбластьДопСправочники, Сч, 2);
		НоваяСтрока.ПредставлениеРеквизита				= ПолучитьТекстЯчейкиОбласти(ОбластьДопСправочники, Сч, 3);
		НоваяСтрока.ТипРеквизита						= ПолучитьТекстЯчейкиОбласти(ОбластьДопСправочники, Сч, 4); 
		НоваяСтрока.ЗначениеПоУмолчанию					= ПолучитьТекстЯчейкиОбласти(ОбластьДопСправочники, Сч, 5);
		НоваяСтрока.ПутьКЗначению						= ПолучитьТекстЯчейкиОбласти(ОбластьДопСправочники, Сч, 6);
		НоваяСтрока.ПутьЗаписиВДопСправочник			= ПолучитьТекстЯчейкиОбласти(ОбластьДопСправочники, Сч, 7); 
		НоваяСтрока.ОтборПоДопСправочнику				= ПолучитьТекстЯчейкиОбласти(ОбластьДопСправочники, Сч, 8); 
		НоваяСтрока.ТипыСообщений						= ПолучитьТекстЯчейкиОбласти(ОбластьДопСправочники, Сч, 9);
		НоваяСтрока.ЭтоГруппаРеквизитов					= ПолучитьТекстЯчейкиОбласти(ОбластьДопСправочники, Сч, 10); 
		НоваяСтрока.ЧтоНужноДозаписать_в_ДопСправочник	= ПолучитьТекстЯчейкиОбласти(ОбластьДопСправочники, Сч, 11); 
		НоваяСтрока.КлючевыеРеквизиты					= ПолучитьТекстЯчейкиОбласти(ОбластьДопСправочники, Сч, 12); 
	КонецЦикла;
	
	Возврат ТабМетаданных;
	
КонецФункции

Функция ПолучитьСтруктуру_ИзТекстаНастройкиРеквизитов(СтрокаНастройки, СвойствоСтруктуры)  Экспорт
	
	Структура = Неопределено;
	Попытка  		
		Если ЗначениеЗаполнено(СтрокаНастройки[СвойствоСтруктуры]) Тогда
			Выполнить("Структура = " + СтрокаНастройки[СвойствоСтруктуры]); 
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось получить структуру из текста настройки реквизитов - " + ОписаниеОшибки());	
	КонецПопытки;

	Если ТипЗнч(Структура) <> Тип("Структура") Тогда
		Структура = Новый Структура;
	КонецЕсли; 
		
	Возврат Структура;
			
КонецФункции

Функция ПолучитьСоздатьНовыйЭлементДопСправочника(СтрокаНастройки ,СтруктураСохраненияВДопСправочник, ПолученЭлементДопСправочника, СтрокаДерева)
			
	Если (ЗначениеЗаполнено(СтрокаНастройки.ПутьЗаписиВДопСправочник) И НЕ ЗначениеЗаполнено(СтруктураСохраненияВДопСправочник)) Тогда
		
		Если ЗначениеЗаполнено(СтрокаДерева.Значение) И ТипЗнч(СтрокаДерева.Значение) = Тип("СправочникСсылка.КонтурEDI_ДополнительныеСправочники") Тогда
			СтруктураСохраненияВДопСправочник = ПрочитатьЭлементДопСправочника_КонтурEDI(СтрокаДерева.Значение); 
		Иначе
			СтруктураСохраненияВДопСправочник = НовыйСтруктураДопСправочника_КонтурEDI(СтрокаНастройки.ПутьЗаписиВДопСправочник);
		КонецЕсли;
		
		ПолученЭлементДопСправочника = Истина;
		
	КонецЕсли;

	Возврат СтруктураСохраненияВДопСправочник;
	
КонецФункции 

Процедура ОтредактироватьЭлементДопСправочника(СтруктураСохраненияВДопСправочник, СтрокаНастройки, СтрокаДерева)
	
	Если ЗначениеЗаполнено(СтруктураСохраненияВДопСправочник) Тогда
		
		МассивПутей = EDI_РазложитьСтрокуВМассивСлов(СтрокаНастройки.ПутьЗаписиВДопСправочник, ";");
		Для Каждого Путь Из МассивПутей Цикл
			МассивИменРеквизитов = EDI_РазложитьСтрокуВМассивСлов(Путь, ".");
			
			Для каждого ИмяРеквизита Из МассивИменРеквизитов Цикл
				Если СтруктураСохраненияВДопСправочник.Свойство(ИмяРеквизита) Тогда
					СтруктураСохраненияВДопСправочник[ИмяРеквизита] = ?(ИмяРеквизита = "Наименование", Строка(СтрокаДерева.Значение), СтрокаДерева.Значение);
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьОтредактированныйЭлементДопСправочника(СтруктураСохраненияВДопСправочник, СтрокаНастройки, СтрокаДерева)

	Если ЗначениеЗаполнено(СтруктураСохраненияВДопСправочник) Тогда
		
		ЧтоНужноДозаписатьВСправочник = ПолучитьСтруктуру_ИзТекстаНастройкиРеквизитов(СтрокаНастройки, "ЧтоНужноДозаписать_в_ДопСправочник");
		
		Если ЧтоНужноДозаписатьВСправочник <> неопределено Тогда
			Для каждого ЭлСтруктуры Из ЧтоНужноДозаписатьВСправочник Цикл
				Если СтруктураСохраненияВДопСправочник.Свойство(ЭлСтруктуры.Ключ) Тогда
					СтруктураСохраненияВДопСправочник[ЭлСтруктуры.Ключ] = ЭлСтруктуры.Значение;
				КонецЕсли;
			КонецЦикла;						
		КонецЕсли;
		
		ЗаписатьЭлементДопСправочника_КонтурEDI(СтруктураСохраненияВДопСправочник);
		СтрокаДерева.Значение = СтруктураСохраненияВДопСправочник.Ссылка;
		
	КонецЕсли;

КонецПроцедуры

Процедура СохранитьНастройкиРеквизитов_ДопСправочник(СтруктураНастроек, СтрокаНастройки, СтрокаДерева)

	ЗаполнитьЗначенияСвойств(СтруктураНастроек, СтрокаНастройки);
	
	СтруктураНастроек.ЗначениеПоУмолчанию	= СтрокаДерева.Значение;
	
	СтруктураНастроек.ТипРеквизита			= ПолучитьПолноеИмяТипаЗначения(СтрокаДерева.Значение);
	
	ЗаписатьЭлементДопСправочника_КонтурEDI(СтруктураНастроек);

КонецПроцедуры 

Процедура ОбработатьСохраненныйИзУниверсальнойФормыРедактированияРезультат(Сообщение, РезультатСохраненияРеквизитов, НастройкаРеквизитов)  Экспорт
	
	СтруктураНастроек = НовыйСтруктураДопСправочника_КонтурEDI("НастройкиРеквизитов");							
	
	ОбработатьДеревоРеквизитовПослеСохранения(Сообщение, РезультатСохраненияРеквизитов,	НастройкаРеквизитов, СтруктураНастроек, Неопределено);  
	
КонецПроцедуры

Процедура ОбработатьДеревоРеквизитовПослеСохранения(Сообщение, Дерево, Настройка, СтруктураНастроек, СтруктураСохраненияВДопСправочник = Неопределено) 
    
	Для каждого СтрокаДерева Из Дерево.Строки Цикл
		
		СтрокаНастройки = Настройка.Найти(СтрокаДерева.ИмяРеквизита,"ИмяРеквизита");
		
		Если ЗначениеЗаполнено(СтрокаНастройки) Тогда
			
			////Если необходимо создать или отредактировать элемент доп справочника, то сделаем это
			ПолученЭлементДопСправочника = Ложь; 
			
			СтруктураСохраненияВДопСправочник = ПолучитьСоздатьНовыйЭлементДопСправочника(СтрокаНастройки ,СтруктураСохраненияВДопСправочник, ПолученЭлементДопСправочника, СтрокаДерева);
			ОтредактироватьЭлементДопСправочника(СтруктураСохраненияВДопСправочник, СтрокаНастройки, СтрокаДерева);
			
			/////Обработаем вложенные реквизиты (в том числе и запишем нужные данные в элемент доп справочника
			НастройкаВложенныхРеквизитов = ПолучитьНастройкуРеквизитов_КонтурEDI(Новый Структура("ИмяГруппыРеквизитов", СтрокаНастройки.ИмяРеквизита)); 			
			ОбработатьДеревоРеквизитовПослеСохранения(Сообщение, СтрокаДерева, НастройкаВложенныхРеквизитов, СтруктураНастроек,	СтруктураСохраненияВДопСправочник);  
			
			/////Запишем отредактированный элемент доп справочника
			Если ПолученЭлементДопСправочника Тогда   				
				ЗаписатьОтредактированныйЭлементДопСправочника(СтруктураСохраненияВДопСправочник, СтрокаНастройки, СтрокаДерева); 				
			КонецЕсли; 		
			
			//Сохраним данные в настройки, теперь по умолчанию будет открываться как сохранили
		 	СохранитьНастройкиРеквизитов_ДопСправочник(СтруктураНастроек, СтрокаНастройки, СтрокаДерева);
			
			//Поместим значения в сообщение
			Если ЗначениеЗаполнено(СтруктураНастроек.ПутьКЗначению) Тогда
				Выполнить("" + СтруктураНастроек.ПутьКЗначению + " = ?(Найти(СтруктураНастроек.ПутьКЗначению, ""EDI"") <> 0, Строка(СтрокаДерева.Значение), СтрокаДерева.Значение)");
			КонецЕсли;   		
		КонецЕсли;  		
	КонецЦикла;
	
КонецПроцедуры 

//}}} 

//{{********* Настройка списков *********

Функция ПолучитьВидКомпании() Экспорт
	
	Если НастройкиМодуля.МыТорговаяСеть Тогда
		Возврат "ТорговаяСеть";
	Иначе
		Возврат "Поставщик";
	КонецЕсли;	
		
КонецФункции

Процедура ДобавитьНастройкуСписка(ТаблицаСписков, Вид, Код =  Неопределено, Имя =  Неопределено, Представление = Неопределено )
	
	НоваяСтрока = ТаблицаСписков.Добавить();
	НоваяСтрока.Вид = Вид;
	НоваяСтрока.Код = Код;
	НоваяСтрока.Имя = Имя;
	НоваяСтрока.Представление = Представление;
	
КонецПроцедуры

Функция ПолучитьНастройкиСписков() Экспорт
	
	//на рефакторинг после удаления старого интерфейса
	ТаблицаНастройки = Новый ТаблицаЗначений;
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаНастройки,"Вид,Код,Имя,Представление");
	
	Если НастройкиМодуля.МыПоставщик ИЛИ НастройкиМодуля.МыТорговаяСеть Тогда
		
		ПоказыватьСпискиПоставщика		= НастройкиМодуля.МыПоставщик;
		ПоказыватьСпискиТорговойСети	= НастройкиМодуля.МыТорговаяСеть;

	Иначе
		
		ПоказыватьСпискиПоставщика		= Истина;
		ПоказыватьСпискиТорговойСети	= Истина;
		
	КонецЕсли;
	
	Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	СвойствоВозврат.Объект
	|ИЗ
	|	РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК СвойствоВозврат
	|ГДЕ
	|	СвойствоВозврат.Свойство = ""RETANN_Входящее""
	|	И СвойствоВозврат.Значение = ИСТИНА";
				   
	ЕстьВозвраты = НЕ Запрос.Выполнить().Пустой();
	
	Если ПоказыватьСпискиПоставщика Тогда
		
		ДобавитьНастройкуСписка(ТаблицаНастройки, "Кнопка", "01", "ЗаказПокупателя"		, "Заказы покупателей"	);
		ДобавитьНастройкуСписка(ТаблицаНастройки, "Кнопка", "02", "РеализацияТоваров"	, "Реализации товаров"	);
		Если ЕстьВозвраты Тогда
			ДобавитьНастройкуСписка(ТаблицаНастройки, "Кнопка", "07", "ВозвратТоваров"		, "Возвраты товаров");
		КонецЕсли;
		ДобавитьНастройкуСписка(ТаблицаНастройки, "Кнопка", "03", "СчетФактураВыданный"	, "Счета-фактуры выданные");
		
	КонецЕсли;
	
	Если ПоказыватьСпискиПоставщика И ПоказыватьСпискиТорговойСети Тогда
		
		ДобавитьНастройкуСписка(ТаблицаНастройки, "Отступ");
		
	КонецЕсли;
	
	Если ПоказыватьСпискиТорговойСети Тогда
		
		ДобавитьНастройкуСписка(ТаблицаНастройки, "Кнопка", "04", "ЗаказПоставщику"			, "Заказы поставщикам"	);
		ДобавитьНастройкуСписка(ТаблицаНастройки, "Кнопка", "05", "ПоступлениеТоваров"		, "Поступления товаров"	);
		ДобавитьНастройкуСписка(ТаблицаНастройки, "Кнопка", "06", "СчетФактураПолученный"	, "Счета-фактуры полученные");
		
	КонецЕсли;
	
	Если ПолучитьКонстантуEDI("ВыгружатьОтчетОПродажеАлко") = Истина Тогда
		
		ДобавитьНастройкуСписка(ТаблицаНастройки, "Отступ");
		ДобавитьНастройкуСписка(ТаблицаНастройки, "Кнопка", "07", "РеализацияАлкоголя", "Реализация алкоголя");
		
	КонецЕсли;
	
	Возврат ТаблицаНастройки;
	
КонецФункции

