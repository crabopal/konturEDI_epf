		КонецЕсли;
		СписокДокументов.Добавить("СчетНаОплатуПокупателю",	"Счет на оплату покупателю");
		
	ИначеЕсли ИмяКонфигурации1С = "УФ_УТ" Тогда
		
		СписокДокументов.Добавить("ЗаказКлиента",	"Реализация товаров и услуг");
		СписокДокументов.Добавить("РеализацияТоваровУслуг",	"Счет на оплату покупателю");
		
	ИначеЕсли ИмяКонфигурации1С = "УФ_УНФ" Тогда
		
		СписокДокументов.Добавить("ЗаказПокупателя",	"Реализация товаров и услуг");
		СписокДокументов.Добавить("РасходнаяНакладная",	"Счет на оплату покупателю");
		
	ИначеЕсли ИмяКонфигурации1С = "УФ_БП" Тогда
		
		СписокДокументов.Добавить("СчетНаОплатуПокупателю",	"Реализация товаров и услуг");
		СписокДокументов.Добавить("РасходнаяНакладная",	"Счет на оплату покупателю");
		
	ИначеЕсли ИмяКонфигурации1С = "ДалионУМ" Тогда
		
		СписокДокументов.Добавить("РасходнаяНакладная",	"Расходная накладная");
		
	ИначеЕсли ИмяКонфигурации1С = "ДалионТРЕНД"	Тогда
		
		СписокДокументов.Добавить("ЗаказТоваров",	"Заказ товаров");
		СписокДокументов.Добавить("РасходнаяНакладная",	"Расходная накладная");
		
	Иначе
		СписокДокументов.Добавить("ЗаказПокупателя",		"Заказ покупателя");
		СписокДокументов.Добавить("РеализацияТоваровУслуг",	"Реализация товаров и услуг");
	КонецЕсли;		
	
	Возврат СписокДокументов;
	
КонецФункции

Процедура ОтразитьОшибкиИзСтатусногоСообщения(Сообщение, ТаблицаОшибок) Экспорт
	
	ОписаниеОшибки = Неопределено;
	Если Сообщение.Направление = "Исходящее"
		И ПеременнаяСодержитСвойство(Сообщение, "СообщениеСсылка", , Истина)
		И ПеременнаяСодержитСвойство(Сообщение.СообщениеСсылка, "ОписаниеОшибки", ОписаниеОшибки, Истина) Тогда
		
		Статусное = Истина;
		
		ОбработатьТекстОшибки(ОписаниеОшибки, ТаблицаОшибок, Статусное);		
		
	КонецЕсли;

КонецПроцедуры

Процедура ОбработатьТекстОшибки(ТекстОшибки, ТаблицаОшибок, Статусное = Ложь) Экспорт
	  		
	Если СтрДлина(ТекстОшибки) > 0 Тогда
		 				
		КоличествоСтрокВТекстеОшибки = СтрЧислоСтрок(ТекстОшибки);
		
		Для К = 1 По КоличествоСтрокВТекстеОшибки Цикл
			
			СтрокаТекстаОшибки = СокрЛП(СтрПолучитьСтроку(ТекстОшибки, К));
			
			НоваяСтрока = ТаблицаОшибок.Добавить();
			НоваяСтрока.ТекстОшибки = СтрокаТекстаОшибки;

			Если Статусное = Истина Тогда 
				
				НоваяСтрока.Действие = "Информация";
				
			КонецЕсли;
									
			НрегСтрокаТекстаОшибки = Нрег(СтрокаТекстаОшибки);
			Если Найти(НрегСтрокаТекстаОшибки, "получатель отказал в подписи") > 0
				Или Найти(НрегСтрокаТекстаОшибки, "принято с разногласиями") > 0
				Или Найти(НрегСтрокаТекстаОшибки, "не принято") > 0
				Или Найти(НрегСтрокаТекстаОшибки, "комментарий к отказу") > 0 
				Или Найти(НрегСтрокаТекстаОшибки, "не удалось отправить пакет электронных документов") Тогда 
				
				НоваяСтрока.ИмяПоля = "СтатусДиадок";
				НоваяСтрока.Действие = "Информация";
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПроверитьПоляСообщения(Сообщение,Параметры =  Неопределено) Экспорт
	
	РезультатПроверки = Новый Структура();
	
	Если Сообщение.ТипСообщения = "ALCRPT" Тогда
		
		ОшибкиСообщения=ИнициализироватьТаблицуОшибок();
		ОшибкиСообщения.Колонки.Добавить("ТекстОшибки");
		ПроверитьСообщениеALCRPT(Сообщение,ОшибкиСообщения);
		Если ОшибкиСообщения.Количество() = 0 Тогда
			РезультатПроверки.Вставить("Успешно",Истина);
		Иначе
			РезультатПроверки.Вставить("Успешно",Ложь);
			РезультатПроверки.Вставить("СписокОшибок",ОшибкиСообщения);
		КонецЕсли;
		
		Возврат РезультатПроверки;
		
	КонецЕсли;
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ТекстОшибки");
	Результат.Колонки.Добавить("ИмяПоля");
	Результат.Колонки.Добавить("ИмяТабличнойЧасти");
	Результат.Колонки.Добавить("НомерСтроки");
	
	Если Сообщение.Направление = "Входящее" Тогда
		
		Возврат ПроверитьПоля1С(Сообщение);
		
	ИначеЕсли Сообщение.Направление = "Исходящее" Тогда
		
		ОшибкиСообщения = ПроверитьСообщениеEDI(Сообщение,Параметры);
		
		Для Каждого Стр Из ОшибкиСообщения Цикл
			
			 НоваяСтрока = Результат.Добавить();
			 НоваяСтрока.ИмяПоля = Стр.ИмяПоля;
			 НоваяСтрока.ИмяТабличнойЧасти = Стр.ИмяТабличнойЧасти;
			 НоваяСтрока.НомерСтроки = Стр.НомерСтроки;
			 
			 ПредставлениеПоля = ПолучитьПредставлениеПоля(Стр);
			 НоваяСтрока.ТекстОшибки = ПолучитьТекстОшибкиПоляСообщения(Стр,ПредставлениеПоля);
			
		 КонецЦикла;
		
	КонецЕсли;
	
	Если Результат.Количество() = 0 Тогда
		РезультатПроверки.Вставить("Успешно",Истина);
	Иначе
		РезультатПроверки.Вставить("Успешно",Ложь);
		РезультатПроверки.Вставить("СписокОшибок",Результат);
	КонецЕсли;	
		
	Возврат РезультатПроверки;
	
КонецФункции

Процедура ПроверитьСообщениеALCRPT(СообщениеАлко,ТаблицаОшибок)
	// проверка алко полей
	
	ЕстьАлкоОшибки = Ложь;
	
	Если НЕ ЗначениеЗаполнено(СообщениеАлко) 
		ИЛИ СообщениеАлко.Товары.Количество() = 0 Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Для Каждого Стр Из СообщениеАлко.Товары Цикл
		
		Если НЕ ЗначениеЗаполнено(Стр.АлкоКодПродукции) Тогда
			
			НоваяСтрока = ТаблицаОшибок.Добавить();
			НоваяСтрока.ТекстОшибки = "Не указан код алкогольной продукции в строке "+Стр.НомерСтроки;
			ЕстьАлкоОшибки = Истина;	
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Стр.АлкоОбъем) Тогда
			
			НоваяСтрока = ТаблицаОшибок.Добавить();
			НоваяСтрока.ТекстОшибки = "Не указан объем алкогольной продукции в строке "+Стр.НомерСтроки;
			ЕстьАлкоОшибки = Истина;
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Стр.АлкоПроизводитель1С) Тогда
			
			НоваяСтрока = ТаблицаОшибок.Добавить();
			НоваяСтрока.ТекстОшибки = "Не указан производитель алкогольной продукции в строке "+Стр.НомерСтроки;
			ЕстьАлкоОшибки = Истина;
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Стр.АлкоЛицензияПоставщика) Тогда
			
			НоваяСтрока = ТаблицаОшибок.Добавить();
			НоваяСтрока.ТекстОшибки = "Не указана алк. лицензий поставщика в строке "+Стр.НомерСтроки;
			ЕстьАлкоОшибки = Истина;
			
		КонецЕсли;
		
		//данные по ЕГАИС заполняются в подключаемом модуле или расширении, если данные есть - провалидируем их
		Если НЕ Стр.ЕГАИС = Неопределено 
			И ТипЗнч(Стр.ЕГАИС) = Тип("Структура") Тогда
			
			Если Стр.ЕГАИС.Свойство("КодТовараВЕГАИС") 
				И НЕ ЗначениеЗаполнено(Стр.ЕГАИС.КодТовараВЕГАИС) Тогда
				
				НоваяСтрока = ТаблицаОшибок.Добавить();
				НоваяСтрока.ТекстОшибки = "Не указан код товара в системе ЕГАИС";
				ЕстьАлкоОшибки = Истина;
				
			КонецЕсли;
			
			Если Стр.ЕГАИС.Свойство("ИдентификаторТовараВТТНЕГАИС") 
				И НЕ ЗначениеЗаполнено(Стр.ЕГАИС.ИдентификаторТовараВТТНЕГАИС) Тогда
				
				НоваяСтрока = ТаблицаОшибок.Добавить();
				НоваяСтрока.ТекстОшибки = "Не указан идентификатор позиции товара внутри ТТН в системе ЕГАИС";
				ЕстьАлкоОшибки = Истина;
				
			КонецЕсли;
			
		КонецЕсли;	
		
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(СообщениеАлко.ТранспортнаяНакладнаяEDI.Номер) Тогда
		
		НоваяСтрока = ТаблицаОшибок.Добавить();
		НоваяСтрока.ТекстОшибки = "Не указан номер ТТН";
		ЕстьАлкоОшибки = Истина;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СообщениеАлко.ТранспортнаяНакладнаяEDI.Дата) Тогда
		
		НоваяСтрока = ТаблицаОшибок.Добавить();
		НоваяСтрока.ТекстОшибки = "Не указана дата ТТН";
		ЕстьАлкоОшибки = Истина;
		
	КонецЕсли;
		
КонецПроцедуры

Функция ПолучитьСвойстваПоля(ИмяПоля,МетаданныеСообщения) Экспорт
	
	СтруктураСвойств = Новый Структура();
	СтруктураСвойств.Вставить("ТипEDI");
	СтруктураСвойств.Вставить("Тип1С");
	СтруктураСвойств.Вставить("ИмяНаФорме1С");
	СтруктураСвойств.Вставить("ИмяНаФормеEDI");
	СтруктураСвойств.Вставить("ВидСтруктурыEDI");
	
	СтрокаМетаданных = МетаданныеСообщения.Найти(ИмяПоля,"ИмяПоля");
	
	Если НЕ СтрокаМетаданных = Неопределено Тогда
		
		СтруктураСвойств.Тип1С	= СтрокаМетаданных.Тип1С;
		СтруктураСвойств.ТипEDI = СтрокаМетаданных.ТипEDI;
		
		Если СтрокаМетаданных.Принадлежность = "1С" ИЛИ СтрокаМетаданных.Принадлежность = "=" Тогда
			ИмяНаФорме1С = ИмяПоля;
		Иначе
			ИмяНаФорме1С = ИмяПоля+"1С";
		КонецЕсли;
		
		СтруктураСвойств.ИмяНаФорме1С = ИмяНаФорме1С;
		
		Если СтрокаМетаданных.Принадлежность = "EDI" ИЛИ СтрокаМетаданных.Принадлежность = "=" Тогда
			ИмяНаФормеEDI = ИмяПоля;
		Иначе
			ИмяНаФормеEDI = ИмяПоля+"EDI";
		КонецЕсли;

		СтруктураСвойств.ВидСтруктурыEDI = СтрокаМетаданных.ВидСтруктурыEDI;
		
	КонецЕсли;
	
	Возврат СтруктураСвойств;
	
КонецФункции

// Обработка входящих сообщений ORDERS со статусом Canceled на стороне ПОСТАВЩИКА
Процедура ОбработатьОтменуЗаказа(Сообщение, ТаблицаСообщений = Неопределено) Экспорт
	// на рефакторинг: ТаблицаСообщений уже не нужна, но пока оставим для совместимости со старыми ПМ
	
	СтандартнаяОбработкаEDI = Истина; 
	
	ОбработкаСобытияПодключаемогоМодуля("ОбработатьОтменуЗаказа", СтандартнаяОбработкаEDI,
	Новый Структура("Сообщение,ТаблицаСообщений",
	Сообщение,ТаблицаСообщений));
	
	Если СтандартнаяОбработкаEDI = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ЭДО_Кэш_Очистить("КэшТаблицыСвязанныхДокументовПоТипамСообщений");
	
	ПериодПоискаДублейВходящегоСообщения = 
	ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, "ПериодПоискаДублейВходящегоСообщения");
	
	Если Не ЗначениеЗаполнено(ПериодПоискаДублейВходящегоСообщения) Тогда
		ПериодПоискаДублейВходящегоСообщения = 7;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_Сообщения.Ссылка,
	|	КонтурEDI_Сообщения.ТочкаДоставки,
	|	КонтурEDI_Сообщения.Документ
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|ГДЕ
	|	КонтурEDI_Сообщения.Партнер = &Партнер
	|	И КонтурEDI_Сообщения.Ссылка <> &Ссылка
	|	И КонтурEDI_Сообщения.НомерДокумента = &НомерЗаказа
	|	И КонтурEDI_Сообщения.НомерСерииЗаказов = &НомерСерииЗаказов
	|	И КонтурEDI_Сообщения.ТипСообщения = ""ORDERS""
	|	И КонтурEDI_Сообщения.ТочкаДоставки = &ТочкаДоставки
	|	И КонтурEDI_Сообщения.ДатаДокумента МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаЗаказа, ДЕНЬ, -&ПериодПоискаДублейВходящегоСообщения) И ДОБАВИТЬКДАТЕ(&ДатаЗаказа, ДЕНЬ, &ПериодПоискаДублейВходящегоСообщения)";
	// Ищем заказы по данному номеру за этот же день
	
	Если Сообщение.Свойство("НомерСерииЗаказов") Тогда
		Запрос.УстановитьПараметр("НомерСерииЗаказов",	Сообщение.НомерСерииЗаказов);
	Иначе
		Запрос.УстановитьПараметр("НомерСерииЗаказов",	"");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НомерЗаказа",		Сообщение.ДокументEDI.Номер);
	Запрос.УстановитьПараметр("ДатаЗаказа",			Сообщение.ДокументEDI.Дата);
	Запрос.УстановитьПараметр("Партнер",			Сообщение.Отправитель1С);
	Запрос.УстановитьПараметр("Ссылка",				Сообщение.СообщениеСсылка);
	Запрос.УстановитьПараметр("ТочкаДоставки",		Сообщение.ТочкаДоставки);
	Запрос.УстановитьПараметр("ПериодПоискаДублейВходящегоСообщения", ПериодПоискаДублейВходящегоСообщения);
	
	ТаблицаПредыдущихСообщенийORDERS = Запрос.Выполнить().Выгрузить();
		
	// 1. Соберем все документы, привязанные к загруженным ранее сообщениям ORDERS с этим же номером.
	ДокументыORDERS = ВыгрузитьТолькоЗаполненныеЗначенияКолонки_КонтурEDI(ТаблицаПредыдущихСообщенийORDERS, "Документ");   
	
	ТаблицаСвязанныхДокументов = Неопределено;

	Для каждого ДокументORDERS Из ДокументыORDERS Цикл
		ВременнаяТаблицаСвязанных = ПолучитьТаблицуСвязанныхДокументовПоТипамСообщений(ДокументORDERS);
		Если ТаблицаСвязанныхДокументов = Неопределено Тогда
			ТаблицаСвязанныхДокументов = ВременнаяТаблицаСвязанных;
		Иначе
			ТаблицаСвязанныхДокументов = ОбъединитьТаблицыЗначений_КонтурEDI(ТаблицаСвязанныхДокументов, ВременнаяТаблицаСвязанных);
		КонецЕсли;
	КонецЦикла;
	
	// 2. пробежимся по этим документам и посмотрим, не пошла ли по ним цепочка дальше. 
	// Если дошли хотя бы до DESADV, то уже не будем ничего отменять в базе у поставщика.
	
	ДокументыDESADV = Новый Массив;
	ДокументыINVOIC = Новый Массив;
	ДокументыDESADV_INVOIC = Новый Массив;
	СообщенияDESADV_INVOIC = Новый Массив;
	
	ТипыСообщенийDESADV_INVOIC = Новый Массив;
	ТипыСообщенийDESADV_INVOIC.Добавить("DESADV");
	ТипыСообщенийDESADV_INVOIC.Добавить("INVOIC");
	
	СтатусыНеОтправленныхDESADV_INVOIC = Новый Массив;
	СтатусыНеОтправленныхDESADV_INVOIC.Добавить("Сохранен");
	СтатусыНеОтправленныхDESADV_INVOIC.Добавить("Ожидает отправки");
	
	Если Не ТаблицаСвязанныхДокументов = Неопределено Тогда	
		
		ДокументыDESADV = ВыгрузитьТолькоЗаполненныеЗначенияКолонки_КонтурEDI(ТаблицаСвязанныхДокументов, "Документ_DESADV");
		ДокументыINVOIC = ВыгрузитьТолькоЗаполненныеЗначенияКолонки_КонтурEDI(ТаблицаСвязанныхДокументов, "Документ_INVOIC");
		
		ДокументыDESADV_INVOIC = ОбъединитьМассивы_КонтурEDI(ДокументыDESADV, ДокументыINVOIC); 
		
		СтруктураОтбораСообщений = СтруктураОтбораСообщений();
		СтруктураОтбораСообщений.Статус.Значение = СтатусыНеОтправленныхDESADV_INVOIC;
		СтруктураОтбораСообщений.Статус.ВидСравнения = ВидСравнения.НеВСписке;
		СтруктураОтбораСообщений.ТипСообщения.Значение = ТипыСообщенийDESADV_INVOIC; 
		СтруктураОтбораСообщений.ТипСообщения.ВидСравнения = ВидСравнения.ВСписке;
		СтруктураОтбораСообщений.Документ.Значение = ДокументыDESADV_INVOIC;
		СтруктураОтбораСообщений.Документ.ВидСравнения = ВидСравнения.ВСписке;
		
		СообщенияDESADV_INVOIC = НайтиСообщенияПоОтбору(СтруктураОтбораСообщений);
		
	КонецЕсли;
		 	
	// 3. Собственно действия
	Если Не СообщенияDESADV_INVOIC = Неопределено 
		И СообщенияDESADV_INVOIC.Количество() > 0 Тогда
		
		// Игнорируем ORDERS от сети с отменой, потому что уже поздно отменять.
		ОбъектСообщения = ПолучитьОбъектСообщения(Сообщение.СообщениеСсылка);
		ОбъектСообщения.ТипСообщения = "-ORDERS";
		ОбъектСообщения.ОтклоненоОтправителем = Истина;
		ОбъектСообщения.Статус = "Загружен";
		СохранитьОбъектСообщения(ОбъектСообщения);
		
	Иначе 
		
		// Удалим все сообщения и документы по отмененному ORDERS.
		
		// 3.1. Удалим документы
		
		ТекстКомментария = "Торговая сеть отменила заказ " + Сообщение.ДокументEDI.Номер + ".";
		
		Если ПолучитьКонстантуEDI("УдалятьВсеДокументыПриОбработкеОтменыЗаказа") = Истина Тогда
		
			ПометитьНаУдалениеДокументы_КонтурEDI(ДокументыINVOIC, ТекстКомментария);
			ПометитьНаУдалениеДокументы_КонтурEDI(ДокументыDESADV, ТекстКомментария);
			
		КонецЕсли;
		
		ПометитьНаУдалениеДокументы_КонтурEDI(ДокументыORDERS, ТекстКомментария);
		
		// 3.2. Удалим сообщения
		Для Каждого Стр Из ТаблицаПредыдущихСообщенийORDERS Цикл
			
			СообщениеЗаказОбъект = Стр.Ссылка.ПолучитьОбъект();
			
			СообщениеЗаказОбъект.ТипСообщения = "#ORDERS";
			СообщениеЗаказОбъект.ОтклоненоОтправителем = Истина;
			СообщениеЗаказОбъект.Статус = "Загружен";
			
			СохранитьОбъектСообщения(СообщениеЗаказОбъект);
			
		КонецЦикла;
		
		ДокументыORDRSP = Новый Массив;
		Если Не ТаблицаСвязанныхДокументов = Неопределено Тогда
			ДокументыORDRSP = ВыгрузитьТолькоЗаполненныеЗначенияКолонки_КонтурEDI(ТаблицаСвязанныхДокументов, "Документ_ORDRSP");
		КонецЕсли;
		
		СтруктураОтбораСообщений = СтруктураОтбораСообщений();
		СтруктураОтбораСообщений.ТипСообщения.Значение = "ORDRSP"; 
		СтруктураОтбораСообщений.Документ.Значение = ДокументыORDRSP;
		СтруктураОтбораСообщений.Документ.ВидСравнения = ВидСравнения.ВСписке;
		
		СообщенияORDRSP = НайтиСообщенияПоОтбору(СтруктураОтбораСообщений);

		Для каждого СообщениеORDRSP Из СообщенияORDRSP Цикл
			
			ОбъектСообщенияORDRSP = СообщениеORDRSP.ПолучитьОбъект();
			ОбъектСообщенияORDRSP.ОтклоненоОтправителем = Истина;
			ОбъектСообщенияORDRSP.Статус = "Отменен";
			СохранитьОбъектСообщения(ОбъектСообщенияORDRSP);
			
		КонецЦикла;
		
		СтруктураОтбораСообщений = СтруктураОтбораСообщений();
		СтруктураОтбораСообщений.Архив.Значение = Ложь;
		СтруктураОтбораСообщений.Статус.Значение = СтатусыНеОтправленныхDESADV_INVOIC;
		СтруктураОтбораСообщений.Статус.ВидСравнения = ВидСравнения.ВСписке;
		СтруктураОтбораСообщений.ТипСообщения.Значение = ТипыСообщенийDESADV_INVOIC; 
		СтруктураОтбораСообщений.ТипСообщения.ВидСравнения = ВидСравнения.ВСписке;
		СтруктураОтбораСообщений.Документ.Значение = ДокументыDESADV_INVOIC;
		СтруктураОтбораСообщений.Документ.ВидСравнения = ВидСравнения.ВСписке;
		
		СохраненныеНеотправленныеDESADV_INVOIC = НайтиСообщенияПоОтбору(СтруктураОтбораСообщений);
		
		Для каждого СообщениеDESADV_INVOIC Из СохраненныеНеотправленныеDESADV_INVOIC Цикл
			
			СообщениеОбъект = СообщениеDESADV_INVOIC.ПолучитьОбъект();
			СообщениеОбъект.Документ		= Неопределено;
			СообщениеОбъект.ТипСообщения	= "#"+СообщениеОбъект.ТипСообщения;
			СообщениеОбъект.Статус			= "#"+СообщениеОбъект.Статус;
			СохранитьОбъектСообщения(СообщениеОбъект);
			
		КонецЦикла;
		
		// 3.3 Текущее сообщение оставим с нужным статусом
		ОбъектСообщения = ПолучитьОбъектСообщения(Сообщение.СообщениеСсылка);
		ОбъектСообщения.ОтклоненоОтправителем = Истина;
		
		Если ДокументыORDERS.Количество() > 0 Тогда
			ОбъектСообщения.Документ = ДокументыORDERS[0];
		КонецЕсли;
		
		ОбъектСообщения.Статус = "Загружен";
			
		СохранитьОбъектСообщения(ОбъектСообщения);
				
	КонецЕсли; 
		
КонецПроцедуры

Функция ЕстьСообщенияПоДокументу_КонтурEDI(Документ, ТипСообщения)

	Если ТипЗнч(Документ) <> Тип("Массив") Тогда
		МассивДокументов = Новый Массив;
		МассивДокументов.Добавить(Документ);
	Иначе
		МассивДокументов = Документ;
	КонецЕсли;
	
	ЕстьСообщенияПоДокументу = Ложь;	
	Для Каждого ДокументСсылка Из МассивДокументов Цикл
		
		ДокументПоТипуСообщения = НайтиСвязанныйДокументПоТипуСообщения(ДокументСсылка, ТипСообщения);
		
		Если ЗначениеЗаполнено(ДокументПоТипуСообщения)
			И НайтиСообщениеДокумента(ДокументПоТипуСообщения, ТипСообщения) <> Неопределено Тогда
			
			ЕстьСообщенияПоДокументу = Истина;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ЕстьСообщенияПоДокументу;

КонецФункции

Процедура ПометитьНаУдалениеДокументы_КонтурEDI(МассивДокументов, ТекстОшибки)
		
	Для Каждого ДокументСсылка Из МассивДокументов Цикл
		
		Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			ДокументСсылка.ПолучитьОбъект().УстановитьПометкуУдаления(Истина);
		Исключение
			
			ТекстИсключения = ТекстОшибки + " Документ " + ДокументСсылка + " не удалось пометить на удаление по причине: 
							 |" + ОписаниеОшибки();
			
			ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстИсключения);
			Сообщить_КонтурEDI(ТекстИсключения);
			
		КонецПопытки; 			
	КонецЦикла;

КонецПроцедуры

Функция ВыгрузитьТолькоЗаполненныеЗначенияКолонки_КонтурEDI(Таблица, ИмяКолонки)
	
	МассивЗаполненныхЗначений = Новый Массив;
	
	Для Каждого Стр Из Таблица Цикл
		
		Если ЗначениеЗаполнено(Стр[ИмяКолонки]) Тогда
			МассивЗаполненныхЗначений.Добавить(Стр[ИмяКолонки]);
		КонецЕсли;    
		
	КонецЦикла;
	
	Возврат МассивЗаполненныхЗначений;

КонецФункции

Процедура ОбработатьЗаменуЗаказа(Сообщение) Экспорт
		
	СтандартнаяОбработкаEDI = Истина; 
	
	ОбработкаСобытияПодключаемогоМодуля("ОбработатьЗаменуЗаказа", СтандартнаяОбработкаEDI,
	Новый Структура("Сообщение", Сообщение));
	
	Если СтандартнаяОбработкаEDI = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_Сообщения.Ссылка,
	|	КонтурEDI_Сообщения.ТочкаДоставки,
	|	КонтурEDI_Сообщения.Документ
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|ГДЕ
	|	КонтурEDI_Сообщения.Партнер = &Партнер
	|	И КонтурEDI_Сообщения.Ссылка <> &Ссылка
	|	И КонтурEDI_Сообщения.НомерДокумента = &НомерЗаказа
	|	И КонтурEDI_Сообщения.НомерСерииЗаказов = &НомерСерииЗаказов
	|	И КонтурEDI_Сообщения.ТипСообщения = ""ORDERS""
	|	И КонтурEDI_Сообщения.ТочкаДоставки = &ТочкаДоставки
	|	И КонтурEDI_Сообщения.ДатаДокумента МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаЗаказа, МЕСЯЦ, &ПериодПоискаОбработкиЗаменыЗаказа) И &ДатаЗаказа
	|
	|УПОРЯДОЧИТЬ ПО
	|	КонтурEDI_Сообщения.ДатаДокумента УБЫВ";
	
	Если Сообщение.Свойство("НомерСерииЗаказов") Тогда
		Запрос.УстановитьПараметр("НомерСерииЗаказов",	Сообщение.НомерСерииЗаказов);
	Иначе
		Запрос.УстановитьПараметр("НомерСерииЗаказов",	"");
	КонецЕсли;
	
	ПериодПоискаОбработкиЗаменыЗаказа = ПолучитьКонстантуEDI("ПериодПоискаОбработкиЗаменыЗаказа");
	
	Если Не ЗначениеЗаполнено(ПериодПоискаОбработкиЗаменыЗаказа)
		ИЛИ ТипЗнч(ПериодПоискаОбработкиЗаменыЗаказа) <> Тип("Число") Тогда
			
		ПериодПоискаОбработкиЗаменыЗаказа = 6;
			
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ПериодПоискаОбработкиЗаменыЗаказа", -ПериодПоискаОбработкиЗаменыЗаказа);
	
	Запрос.УстановитьПараметр("НомерЗаказа",		Сообщение.ДокументEDI.Номер);
	Запрос.УстановитьПараметр("ДатаЗаказа",			Сообщение.ДокументEDI.Дата);
	Запрос.УстановитьПараметр("Партнер",			Сообщение.Отправитель1С);
	Запрос.УстановитьПараметр("Ссылка",				Сообщение.СообщениеСсылка);
	Запрос.УстановитьПараметр("ТочкаДоставки",		Сообщение.ТочкаДоставки);
	
	ТаблицаПредыдущихСообщенийORDERS = Запрос.Выполнить().Выгрузить();
		
	// 1. Соберем все документы, привязанные к загруженным ранее сообщениям ORDERS с этим же номером.
	МассивДокументовПоВходящимORDERS = 
	ВыгрузитьТолькоЗаполненныеЗначенияКолонки_КонтурEDI(ТаблицаПредыдущихСообщенийORDERS, "Документ");
	
	// 2. пробежимся по этим документам и посмотрим, не пошла ли по ним цепочка дальше. 
	// Если дошли хотя бы до DESADV, то уже не будем ничего отменять в базе у поставщика.
	ЕстьDESADVПоДокументу = ЕстьСообщенияПоДокументу_КонтурEDI(МассивДокументовПоВходящимORDERS, "DESADV");
	
	// 3. Собственно действия
	Если ЕстьDESADVПоДокументу Тогда
		
		// Игнорируем ORDERS от сети с заменой, потому что уже поздно заменять.
		ОбъектСообщения = ПолучитьОбъектСообщения(Сообщение.СообщениеСсылка);
		ОбъектСообщения.ТипСообщения = "#ORDERS";
		ОбъектСообщения.ОтклоненоОтправителем = Истина;
		ОбъектСообщения.Статус = "Загружен";
		СохранитьОбъектСообщения(ОбъектСообщения);
		
	Иначе 
		
		// 3.1. Удалим сообщения
		Для Каждого Стр Из ТаблицаПредыдущихСообщенийORDERS Цикл
			
			СообщениеЗаказОбъект = Стр.Ссылка.ПолучитьОбъект();
			
			СообщениеЗаказОбъект.ТипСообщения = "#ORDERS";
			СообщениеЗаказОбъект.ОтклоненоОтправителем = Истина;
			СообщениеЗаказОбъект.Статус = "Загружен";
			
			СохранитьОбъектСообщения(СообщениеЗаказОбъект);
			
		КонецЦикла;
		
		// 3.2 Текущее сообщение оставим с нужным статусом
		ОбъектСообщения = ПолучитьОбъектСообщения(Сообщение.СообщениеСсылка);
		ОбъектСообщения.ОтклоненоОтправителем = Ложь;
		ОбъектСообщения.Статус = "НоваяВерсия";
		Если МассивДокументовПоВходящимORDERS.Количество() > 0 Тогда
			ОбъектСообщения.Документ = МассивДокументовПоВходящимORDERS[0];
		КонецЕсли;
		
		СохранитьОбъектСообщения(ОбъектСообщения);
		
		// 3.3 Удалим отправленные ORDRSP по документу
		Для Каждого ДокументORDERS Из МассивДокументовПоВходящимORDERS Цикл 
			
			СообщениеORDRSP = НайтиСообщениеДокумента(ДокументORDERS, "ORDRSP");
			
			Если СообщениеORDRSP <> Неопределено Тогда 
				
				ОбъектСообщениеORDRSP = СообщениеORDRSP.ПолучитьОбъект();
				
				ОбъектСообщениеORDRSP.ТипСообщения = "#ORDRSP";
				ОбъектСообщениеORDRSP.ОтклоненоОтправителем = Истина;
				ОбъектСообщениеORDRSP.Статус = "Отменен";
				
				СохранитьОбъектСообщения(ОбъектСообщениеORDRSP);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
				
КонецПроцедуры
 
//Обработка входящих сообщений RETANN со статусом Canceled на стороне ПОСТАВЩИКА
Функция ОбработатьОтменуВозврата(Сообщение) Экспорт
		
	СтандартнаяОбработкаEDI = Истина; 
	
	ОбработкаСобытияПодключаемогоМодуля("ОбработатьОтменуВозврата",СтандартнаяОбработкаEDI,	Новый Структура("Сообщение",Сообщение));

	Если СтандартнаяОбработкаEDI Тогда
		
		Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтурEDI_Сообщения.Ссылка,
		|	КонтурEDI_Сообщения.Документ
		|ИЗ
		|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
		|ГДЕ
		|	КонтурEDI_Сообщения.Партнер = &Партнер
		|	И КонтурEDI_Сообщения.Ссылка <> &Ссылка
		|	И КонтурEDI_Сообщения.НомерДокумента = &НомерВозврата
		|	И КонтурEDI_Сообщения.ТипСообщения = ""RETANN""
		|	И КонтурEDI_Сообщения.ДатаДокумента МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаВозврата, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаВозврата, ДЕНЬ)";
		//Ищем возвраты по данному номеру за этот же день
		
		Запрос.УстановитьПараметр("НомерВозврата",		Сообщение.ДокументEDI.Номер);
		Запрос.УстановитьПараметр("ДатаВозврата",		Сообщение.ДокументEDI.Дата);
		Запрос.УстановитьПараметр("Партнер",			ПреобразоватьЗначениеДляВнешнегоХранилища(Сообщение.Отправитель1С));
		Запрос.УстановитьПараметр("Ссылка",				ПреобразоватьЗначениеДляВнешнегоХранилища(Сообщение.СообщениеСсылка));
		
		ТаблицаПредыдущихСообщенийRETANN = Запрос.Выполнить().Выгрузить();
		МассивДокументовПоВходящимRETANN = Новый Массив; 		
		
		//1. Соберем все документы, привязанные к загруженным ранее сообщениям RETANN с этим же номером.
		Для Каждого Стр Из ТаблицаПредыдущихСообщенийRETANN Цикл   			
			Если ЗначениеЗаполнено(Стр.Документ) Тогда
				ДокументСсылка = ?(ВнешнееХранилище,ЗначениеИзСтрокиВнутр(Стр.Документ),Стр.Документ);
				Если ЗначениеЗаполнено(ДокументСсылка)Тогда
					МассивДокументовПоВходящимRETANN.Добавить(ДокументСсылка);
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;  		
		
		//2. Пробежимся по этим документам и посмотрим, не пошла ли по ним цепочка дальше. Если есть цепочка "RETDES" и документ привзяан к "RETDES", то ничего не делаем.
		МожемУдалятьСообщенияИДокументы = Истина;	//сейчас поймем, что нам с этой отменой делать
		Если ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер,"RETDES_Входящее") = Истина Тогда
			Для Каждого ДокументСсылка Из МассивДокументовПоВходящимRETANN Цикл
				ДокументДляRETDES = НайтиСвязанныйДокументПоТипуСообщения(ДокументСсылка,"RETDES");
				Если ЗначениеЗаполнено(ДокументДляRETDES) Тогда
					Если НайтиСообщениеДокумента(ДокументДляRETDES,"RETDES") <> Неопределено Тогда
						МожемУдалятьСообщенияИДокументы = Ложь;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;  		
		
		//3. Собственно действия
		Если Не МожемУдалятьСообщенияИДокументы Тогда
			
			//Игнорируем RETANN от сети с отменой, потому что уже поздно отменять.
			ОбъектСообщения = ПолучитьОбъектСообщения(Сообщение.СообщениеСсылка);
			ОбъектСообщения.ТипСообщения = "-RETANN";//сохраним в базу для истории, но показывать уже не будем
			ОбъектСообщения.ОтклоненоОтправителем = Истина;
			ОбъектСообщения.Статус = "Загружен";
			СохранитьОбъектСообщения(ОбъектСообщения);
			
		Иначе //МожемУдалятьСообщенияИДокументы
			
			//Удалим все сообщения и документы по отмененному RETANN.
						
			//3.1. Удалим документы, если есть настройка партнера, позволяюща сделать это. Иначе даем это сделать только интерактивно
			ЕстьНастройкаСВозможностьюУдаления = (ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, "УдалятьДокументПриСтатусеCanceledRETANN") = Истина);
			Если ЕстьНастройкаСВозможностьюУдаления Тогда
				Для Каждого ДокументСсылка Из МассивДокументовПоВходящимRETANN Цикл
					Попытка
						ДокументСсылка.ПолучитьОбъект().УстановитьПометкуУдаления(Истина);
					Исключение
						Сообщить_КонтурEDI("Сеть отменила возврат "+Сообщение.ДокументEDI.Номер+", но документ "+ДокументСсылка+" не удалось пометить на удаление");
					КонецПопытки;					
				КонецЦикла;
			КонецЕсли;
			
			//3.2. Удалим сообщения
			Документ = Неопределено;
			Для Каждого Стр Из ТаблицаПредыдущихСообщенийRETANN Цикл
				
				СообщениеВозвратОбъект = Стр.Ссылка.ПолучитьОбъект();
				
				СообщениеВозвратОбъект.ТипСообщения = "#RETANN";//скроем старое
				СообщениеВозвратОбъект.ОтклоненоОтправителем = Истина;
				СообщениеВозвратОбъект.Статус = "Загружен";

				СохранитьОбъектСообщения(СообщениеВозвратОбъект);
				
				Если НЕ ЕстьНастройкаСВозможностьюУдаления И ЗначениеЗаполнено(СообщениеВозвратОбъект.Документ) Тогда
					Документ = СообщениеВозвратОбъект.Документ;
				КонецЕсли;
				
			КонецЦикла;
			
			//3.3 Текущее сообщение оставим с нужным статусом
			ОбъектСообщения = ПолучитьОбъектСообщения(Сообщение.СообщениеСсылка);
			ОбъектСообщения.ОтклоненоОтправителем = Истина;
			Если НЕ ЕстьНастройкаСВозможностьюУдаления И ЗначениеЗаполнено(Документ) Тогда
				ОбъектСообщения.Документ = Документ;
				ОбъектСообщения.Статус = "НоваяВерсия";
			Иначе
				ОбъектСообщения.Статус = "Загружен";
			КонецЕсли;     			
			СохранитьОбъектСообщения(ОбъектСообщения);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;//ответ нигде не анализируется.
			
КонецФункции

Процедура УдалитьRETINS_По_Сообщению(Сообщение) Экспорт
	
	Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_Сообщения.Ссылка,
	|	КонтурEDI_Сообщения.Документ
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|ГДЕ
	|	КонтурEDI_Сообщения.ТипСообщения = ""RETINS""
	|	И КонтурEDI_Сообщения.Документ = &Документ";
	//Ищем возвраты по данному номеру за этот же день
	
	Запрос.УстановитьПараметр("Документ",			Сообщение.ДокументСсылка);
	Запрос.УстановитьПараметр("Партнер",			ПреобразоватьЗначениеДляВнешнегоХранилища(Сообщение.Отправитель1С));
		
	ТаблицаRETINS = Запрос.Выполнить().Выгрузить();
	
	Для каждого Стр Из ТаблицаRETINS Цикл
		
		ОбъектСообщения = ПолучитьОбъектСообщения(Стр.Ссылка);
		ОбъектСообщения.ТипСообщения = "#RETINS";
		ОбъектСообщения.ОтклоненоОтправителем = Истина;
		ОбъектСообщения.Статус = "Загружен";
		СохранитьОбъектСообщения(ОбъектСообщения);
		
	КонецЦикла;  	
	
КонецПроцедуры

//Форма УниверсальныйДиалог

// Добавляет в форму уведомлений уведомления из переданного массива
//
// Параметры:
//  ТаблицаСообщений  - ТаблицаЗначений - реквизит формы, связанный с элементом управления уведомлениями
//                 
//МассивУведомлений - массив структур, каждая из которых содержит:
// 	ТекстУведомления
// 	ПодробныйТекстУведомления
// 	ЗаголовокДействия
// 	КлиентскийОбработчик
Процедура УниверсальныйДиалог_ЗаполнитьТаблицуУведомлений(ТаблицаСообщений, МассивУведомлений) Экспорт
	//МассивУведомлений - массив структур
		// ТекстУведомления
		// ПодробныйТекстУведомления
		// ЗаголовокДействия
		// КлиентскийОбработчик
	
	Если ТипЗнч(МассивУведомлений) = Тип("Массив") Тогда 
		Для Каждого Уведомление Из МассивУведомлений Цикл
			Попытка
				
				НовоеСообщение = ТаблицаСообщений.Добавить();
				
				НовоеСообщение.ТекстСообщения		= ?(ЗначениеЗаполнено(Уведомление.ПодробныйТекстУведомления),Уведомление.ПодробныйТекстУведомления,Уведомление.ТекстУведомления);
				НовоеСообщение.Выполнено			= Ложь;
				НовоеСообщение.ЗаголовокДействия	= ?(ЗначениеЗаполнено(Уведомление.ЗаголовокДействия),Уведомление.ЗаголовокДействия,"Перейти");
				
				Если ЗначениеЗаполнено(Уведомление.ПараметрыОбработчика) Тогда
					СтруктураПараметровДействия = Уведомление.ПараметрыОбработчика;
				Иначе
					СтруктураПараметровДействия = Новый Структура;
				КонецЕсли;
				
				СтруктураПараметровДействия.Вставить("ВыполняемыйКод",Уведомление.КлиентскийОбработчик);
				
				НовоеСообщение.ПараметрыДействия	= ЗначениеВСтрокуВнутр(СтруктураПараметровДействия);
				
			Исключение
				//TODO отправить метрику ошибку
				ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось добавить уведомление в таблицу уведомлений - " + ОписаниеОшибки());
			КонецПопытки;
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

//конструктор сущности Уведомление
Функция УниверсальныйДиалог_Уведомление(ТекстУведомления, 
										ПодробныйТекстУведомления = Неопределено, 
										КлиентскийОбработчик = Неопределено, 
										ЗаголовокДействия = Неопределено, 
										ПараметрыОбработчика = Неопределено) Экспорт
	
	ПараметрыУниверсальныйДиалог = Новый Структура;
	ПараметрыУниверсальныйДиалог.Вставить("ТекстУведомления"			, ТекстУведомления);
	ПараметрыУниверсальныйДиалог.Вставить("ПодробныйТекстУведомления"	, ПодробныйТекстУведомления);
	ПараметрыУниверсальныйДиалог.Вставить("КлиентскийОбработчик"		, КлиентскийОбработчик);
	ПараметрыУниверсальныйДиалог.Вставить("ЗаголовокДействия"			, ЗаголовокДействия);
	ПараметрыУниверсальныйДиалог.Вставить("ПараметрыОбработчика"		, ПараметрыОбработчика);
	
	Возврат ПараметрыУниверсальныйДиалог;
	
КонецФункции


//Обработка входящих сообщений RETANN со статусом REPLACE на стороне ПОСТАВЩИКА
Функция ОбработатьЗаменуВозврата(Сообщение) Экспорт
		
	СтандартнаяОбработкаEDI = Истина; 
	
	ОбработкаСобытияПодключаемогоМодуля("ОбработатьЗаменуВозврата",СтандартнаяОбработкаEDI,	Новый Структура("Сообщение",Сообщение));

	Если СтандартнаяОбработкаEDI Тогда
		
		Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтурEDI_Сообщения.Ссылка,
		|	КонтурEDI_Сообщения.Документ
		|ИЗ
		|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
		|ГДЕ
		|	КонтурEDI_Сообщения.Партнер = &Партнер
		|	И КонтурEDI_Сообщения.Ссылка <> &Ссылка
		|	И КонтурEDI_Сообщения.НомерДокумента = &НомерВозврата
		|	И КонтурEDI_Сообщения.ТипСообщения = ""RETANN""
		|	И КонтурEDI_Сообщения.ДатаДокумента МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаВозврата, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаВозврата, ДЕНЬ)";
		//Ищем возвраты по данному номеру за этот же день
		
		Запрос.УстановитьПараметр("НомерВозврата",		Сообщение.ДокументEDI.Номер);
		Запрос.УстановитьПараметр("ДатаВозврата",		Сообщение.ДокументEDI.Дата);
		Запрос.УстановитьПараметр("Партнер",			ПреобразоватьЗначениеДляВнешнегоХранилища(Сообщение.Отправитель1С));
		Запрос.УстановитьПараметр("Ссылка",				ПреобразоватьЗначениеДляВнешнегоХранилища(Сообщение.СообщениеСсылка));
		
		ТаблицаПредыдущихСообщенийRETANN = Запрос.Выполнить().Выгрузить();
		МассивДокументовПоВходящимRETANN = Новый Массив; 		
		
		//1. Соберем все документы, привязанные к загруженным ранее сообщениям RETANN с этим же номером.
		Для Каждого Стр Из ТаблицаПредыдущихСообщенийRETANN Цикл   			
			Если ЗначениеЗаполнено(Стр.Документ) Тогда
				ДокументСсылка = ?(ВнешнееХранилище,ЗначениеИзСтрокиВнутр(Стр.Документ),Стр.Документ);
				Если ЗначениеЗаполнено(ДокументСсылка)Тогда
					МассивДокументовПоВходящимRETANN.Добавить(ДокументСсылка);
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;  		
		
		//2. Пробежимся по этим документам и посмотрим, не пошла ли по ним цепочка дальше. Если есть цепочка "RETDES" и документ привзяан к "RETDES", то ничего не делаем.
		МожемУдалятьСообщенияИДокументы = Истина;	//сейчас поймем, что нам с этой отменой делать
		Если ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер,"RETDES_Входящее") = Истина Тогда
			Для Каждого ДокументСсылка Из МассивДокументовПоВходящимRETANN Цикл
				ДокументДляRETDES = НайтиСвязанныйДокументПоТипуСообщения(ДокументСсылка,"RETDES");
				Если ЗначениеЗаполнено(ДокументДляRETDES) Тогда
					Если НайтиСообщениеДокумента(ДокументДляRETDES,"RETDES") <> Неопределено Тогда
						МожемУдалятьСообщенияИДокументы = Ложь;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;  		
		
		//3. Собственно действия
		Если Не МожемУдалятьСообщенияИДокументы Тогда
			
			//Игнорируем RETANN от сети с отменой, потому что уже поздно отменять.
			ОбъектСообщения = ПолучитьОбъектСообщения(Сообщение.СообщениеСсылка);
			ОбъектСообщения.ТипСообщения = "-RETANN";//сохраним в базу для истории, но показывать уже не будем
			ОбъектСообщения.ОтклоненоОтправителем = Истина;
			ОбъектСообщения.Статус = "Загружен";
			СохранитьОбъектСообщения(ОбъектСообщения);
			
		Иначе //МожемУдалятьСообщенияИДокументы
			
					
			//3.1. Удалим предыдущие сообщения
			Документ = Неопределено;
					
			Для Каждого Стр Из ТаблицаПредыдущихСообщенийRETANN Цикл
				
				СообщениеВозвратОбъект = Стр.Ссылка.ПолучитьОбъект(); 				
				 				
				СообщениеВозвратОбъект.ТипСообщения = "#RETANN";//скроем старое
				СообщениеВозвратОбъект.ОтклоненоОтправителем = Истина;
				СообщениеВозвратОбъект.Статус = "Загружен";

				СохранитьОбъектСообщения(СообщениеВозвратОбъект);
				
				Если ЗначениеЗаполнено(СообщениеВозвратОбъект.Документ) Тогда
					Документ = СообщениеВозвратОбъект.Документ;
				КонецЕсли;
				
			КонецЦикла;
			
			//3.3 Текущее сообщение оставим с нужным статусом
			ОбъектСообщения = ПолучитьОбъектСообщения(Сообщение.СообщениеСсылка);
			
			Если ЗначениеЗаполнено(Документ) Тогда
				ОбъектСообщения.Документ = Документ;
				ОбъектСообщения.Статус = "НоваяВерсия";
			Иначе
				
			КонецЕсли;
			СохранитьОбъектСообщения(ОбъектСообщения);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;//ответ нигде не анализируется. 
			
КонецФункции

