Функция КлиентHTTP_Переопределяемый_ВызватьHTTPМетод(Сессия, Метод, URL, ДополнительныеПараметры)
	
	// Поддержка старого события ВыполнитьHTTPЗапрос, если включен ПМ или есть активные расширения использующие это событие
	
	Если Не ИспользуетсяПодключаемыйМодуль = Истина
		И Не КонтурEDI_ЕстьСобытиеВИспользуемыхРасширениях("ВыполнитьHTTPЗапрос") Тогда
		
		Возврат Неопределено;                 
		
	КонецЕсли;
	
	// Преобразуем входные параметры метода ВызватьHTTPМетод в параметры для события ВызватьHTTPЗапрос
	
	ПараметрыПМ = КонтурEDI_ПараметрыВызватьHTTPМетод_В_ВыполнитьHTTPЗапрос(Сессия, Метод, URL, ДополнительныеПараметры);
	
	РезультатПМ = ОбработкаСобытияПодключаемогоМодуля("ВыполнитьHTTPЗапрос",, ПараметрыПМ);
	
	Если РезультатПМ = Неопределено Тогда	
		
		// В событии могли изменить параметры запроса или адрес, поэтому вернём значения в параметры
		// для дальнейшего выполнения запроса типовым модулем КлиентHTTP  
		
		Метод = ПараметрыПМ.Метод;
		URL = ПараметрыПМ.Адрес; 
		ПараметрыЗапроса = ПараметрыПМ.ПараметрыЗапроса;
		ДополнительныеПараметры.Заголовки = Новый Соответствие;
		
		Для Каждого ТекЗаголовок Из ПараметрыЗапроса.Заголовки Цикл
			
			Если НЕ Сессия.Заголовки[ТекЗаголовок.Ключ] = Неопределено Тогда               
				
				Сессия.Заголовки[ТекЗаголовок.Ключ] = ПараметрыЗапроса.Заголовки[ТекЗаголовок.Ключ];
				
			Иначе
				
				ДополнительныеПараметры.Заголовки[ТекЗаголовок.Ключ] = ПараметрыЗапроса.Заголовки[ТекЗаголовок.Ключ];
				
			КонецЕсли;
			
		КонецЦикла;
		
		ДополнительныеПараметры.ПараметрыЗапроса = Новый Структура;
		
		Для Каждого ПараметрЗапроса Из ПараметрыЗапроса.Параметры Цикл
			ДополнительныеПараметры.ПараметрыЗапроса.Вставить(ПараметрЗапроса.Ключ, ПараметрЗапроса.Значение);		
		КонецЦикла;
		
		Если ПараметрыЗапроса.Свойство("Прокси") Тогда
			
			СерверПортПрокси = КонтурСтандарт_СтрРазделить_(ПараметрыЗапроса.Прокси.host, ":");
			
			ИспользоватьСистемныеНастройкиПрокси = КонтурСтандарт_ЗначениеПоКлючу(ПараметрыЗапроса.Прокси, "ИспользоватьСистемныеНастройкиПрокси", Ложь);
			СпособАутентификацииПрокси = КонтурСтандарт_ЗначениеПоКлючу(ПараметрыЗапроса.Прокси, "СпособАутентификацииПрокси", Неопределено);
			
			Сессия.Прокси = СоздатьИнтернетПрокси(СерверПортПрокси[0], 
									   	   		  Число(СерверПортПрокси[1]), 
									   	   		  ПараметрыЗапроса.Прокси.username, 
									  	   		  ПараметрыЗапроса.Прокси.password,
									   	   		  ИспользоватьСистемныеНастройкиПрокси,
									   	   		  СпособАутентификацииПрокси);
			
		КонецЕсли;
		
		Если ПараметрыЗапроса.Свойство("Таймаут") Тогда
			
			ДополнительныеПараметры.Вставить("Таймаут", ПараметрыЗапроса.Таймаут);		
			
		КонецЕсли;
		
		Если ПараметрыЗапроса.ТелоЗапроса.Свойство("Строка") Тогда 	
			
			Попытка
				ДополнительныеПараметры.Json = КонтурСтандарт_ЗначениеИзСтрокиJSON(ПараметрыЗапроса.ТелоЗапроса.Строка);
			Исключение   
				ДополнительныеПараметры.Данные = ПараметрыЗапроса.ТелоЗапроса.Строка; 	
			КонецПопытки;
			
		ИначеЕсли ПараметрыЗапроса.ТелоЗапроса.Свойство("ДвоичныеДанные") Тогда 
			
			ДополнительныеПараметры.Данные = ПараметрыЗапроса.ТелоЗапроса.ДвоичныеДанные;	
			
		КонецЕсли;

		Возврат Неопределено;	
		
	Иначе
		
		// ПМ вернул ответ преобразуем его в КлиентHTTP_НовыйОтвет
		
		ПодготовленныйОтвет = КлиентHTTP_НовыйОтвет();
		ПодготовленныйОтвет.Метод = Метод;
		ПодготовленныйОтвет.URL = URL;
		ПодготовленныйОтвет.КодСостояния = Число(РезультатПМ.КодСостояния);
		ПодготовленныйОтвет.Заголовки = РезультатПМ.Заголовки;
		
		Если ТипЗнч(РезультатПМ) = Тип("HTTPОтвет") Тогда
			ПодготовленныйОтвет.Тело = РезультатПМ.ПолучитьТелоКакДвоичныеДанные();	
		Иначе     
			ПодготовленныйОтвет.Тело = РезультатПМ.ТелоОтвета;		
		КонецЕсли; 
		
		Возврат ПодготовленныйОтвет;
		
	КонецЕсли;
	
КонецФункции

Функция КлиентHTTP_НовыйМенеджерНастроек()
	
	МенеджерНастроек = Новый Структура;
	
	МенеджерНастроек.Вставить("МодульФункцииHTTPЗапроса", Неопределено);
	МенеджерНастроек.Вставить("ИмяФункцииHTTPЗапроса", "");
    МенеджерНастроек.Вставить("ИспользоватьВнешнийАлгоритм", Ложь); 
	МенеджерНастроек.Вставить("КодыСостояния", Неопределено); 
	
	Возврат МенеджерНастроек;
	
КонецФункции

Функция КлиентHTTP_МенеджерНастроек()
	
	МенеджерНастроек = ЭДО_Кэш_Прочитать("КлиентHTTP_НовыйМенеджерНастроек");
	
	Если МенеджерНастроек = Неопределено Тогда

		МенеджерНастроек = КлиентHTTP_НовыйМенеджерНастроек();
		
		МенеджерНастроек.МодульФункцииHTTPЗапроса = Неопределено;  
		МенеджерНастроек.ИмяФункцииHTTPЗапроса = "ВыполнитьHTTPЗапросКонтурПлагин";  
		
		МенеджерНастроек.ИспользоватьВнешнийАлгоритм = ИспользоватьКонтурPlugin();
		
		ЭДО_Кэш_Поместить("КлиентHTTP_НовыйМенеджерНастроек", МенеджерНастроек); 
		
	КонецЕсли;
	
	Возврат МенеджерНастроек;
	
КонецФункции

