//возвращает "+вх, +пм", если установлено временное хранилище и подключаемый модуль
//используется для индикации в заголовках форм
Функция ПредставлениеОсобенностейМодуля() Экспорт
	
	КлючКэша = "РезультатФункции_ПредставлениеОсобенностейМодуля";
	
	ПредставлениеОсобенностейМодуля = ЭДО_Кэш_Прочитать(КлючКэша);
	
	Если НЕ ПредставлениеОсобенностейМодуля = Неопределено Тогда
		Возврат ПредставлениеОсобенностейМодуля;	
	КонецЕсли;
	
	КонтекстОбновленияПоставки 			= КонтекстОбновленияПоставки_КонтурEDI();
	КонтекстОбновленияМодуль   			= КонтекстОбновленияПоставки.Модуль;
	КонтекстОбновленияСистемаХранения   = КонтекстОбновленияПоставки.СистемаХранения;
	
	ОсобенностиМодуля = Новый Массив;
	
	Если ВнешнееХранилище = Истина Тогда
		ОсобенностиМодуля.Добавить("+вх"); // внешнее хранилище
	ИначеЕсли КонтекстОбновленияСистемаХранения.Расположение = ПеречисленияEDI_ВариантыРасположенияСистемыХранения().Расширение  Тогда
		ОсобенностиМодуля.Добавить("+рш1С"); // добавлены объекты через расширение 1С     
	Иначе	
		ОсобенностиМодуля.Добавить("+об"); // добавлены объекты конфигурации
	КонецЕсли;
	
	Если ИспользуетсяПодключаемыйМодуль = Истина Тогда
		ОсобенностиМодуля.Добавить("пм");
	КонецЕсли;
	
	Если ТипЗнч(ТаблицаКэшИсполняемогоКодаРасширений) = Тип("ТаблицаЗначений") 
		И НЕ ТаблицаКэшИсполняемогоКодаРасширений.Количество() = 0 Тогда
		ОсобенностиМодуля.Добавить("рш");		
	КонецЕсли;
	
	Модифицированность = КонтекстОбновленияМодуль.Модифицированность;
	УстановленыТолькоИсправленияКонтур = КонтекстОбновленияМодуль.УстановленыТолькоИсправленияКонтур;
	Если Модифицированность = ПеречисленияEDI_ПризнакиМодифицированностиКонтента().Изменен Тогда
		
		ПредставлениеМодифицированности = "К";
		Если УстановленыТолькоИсправленияКонтур Тогда
			ПредставлениеМодифицированности = "КР";	
		КонецЕсли;
		
		ОсобенностиМодуля.Добавить(ПредставлениеМодифицированности);
		
	ИначеЕсли Модифицированность = ПеречисленияEDI_ПризнакиМодифицированностиКонтента().Неизвестно Тогда
		ОсобенностиМодуля.Добавить("К?");
	КонецЕсли;
	
	ПредставлениеОсобенностейМодуля = КонтурСтандарт_СтрСоединить_(ОсобенностиМодуля, ",");
	
	ЭДО_Кэш_Поместить(КлючКэша, ПредставлениеОсобенностейМодуля);
	
	Возврат ПредставлениеОсобенностейМодуля;
	
КонецФункции

Функция ОписаниеВерсии_КонтурEDI()
	
	ОписаниеВерсииГит = DoParse(ПолучитьМакет("ОписаниеВерсии").ПолучитьТекст());
	СоответствиеОписанияВерсии = СоответствиеОписанияВерсии_КонтурEDI();
	
	ОписаниеВерсии = Новый Структура;
	
	Для каждого КлючЗначение Из СоответствиеОписанияВерсии Цикл
		
		ЗначенияПоля = ОписаниеВерсииГит[КлючЗначение.Ключ];
		Если КлючЗначение.Значение = "ДатаФиксации" Тогда
			ЗначенияПоля = ДатаXML_в_Дата1С(ЗначенияПоля);
		КонецЕсли;
		
		ОписаниеВерсии.Вставить(КлючЗначение.Значение, ЗначенияПоля);	
	
	КонецЦикла;

	Возврат ОписаниеВерсии;
	
КонецФункции

Функция ОписаниеВерсииСтрокойСОсобенностями_КонтурEDI() Экспорт
	
	Перем ОписаниеВерсии;
	
	Если ЗначениеЗаполнено(ПараметрыКлиентСервер.ОписаниеВерсии.ПредРелизныйТег) Тогда
		ОписаниеВерсии = ПараметрыКлиентСервер.ОписаниеВерсии.СемантикВерсияФайлаСборки;
	Иначе
		ОписаниеВерсии = ПараметрыКлиентСервер.ОписаниеВерсии.ПолнаяСемантикВерсия;
	КонецЕсли;
	
	ОписаниеВерсии = ОписаниеВерсии + " " + ПредставлениеОсобенностейМодуля();
	
	Возврат ОписаниеВерсии;
	
КонецФункции

