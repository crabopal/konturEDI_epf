Функция КонтурEDIAPIПереопределяемый_МенеджерНастроек()
	
	МенеджерНастроек = ЭДО_Кэш_Прочитать("КонтурEDIAPI_МенеджерНастроек");
	
	Если МенеджерНастроек = Неопределено Тогда

		МенеджерНастроек = КонтурEDIAPI_НовыйМенеджерНастроек();
		
		МенеджерНастроек.КлиентИД = API_КлючРазработчика(); 
		МенеджерНастроек.ТестовоеОкружение = ЭтоТестовыйAPI(); 
        МенеджерНастроек.КэшТокенов = Новый Соответствие;
		
		МенеджерНастроек.Сессия = КлиентHTTP_СоздатьСессию(); 
		МенеджерНастроек.Сессия.Прокси = ПолучитьИнтернетПрокси();  
        МенеджерНастроек.ХранилищеСхем = КонтурEDIAPI_ИнициализироватьСхемы();
		
		ЭДО_Кэш_Поместить("КонтурEDIAPI_МенеджерНастроек", МенеджерНастроек); 
		
	КонецЕсли;
	
	Возврат МенеджерНастроек;
	
КонецФункции

Процедура КонтурEDIAPIПереопределяемый_АдресаСерверов(АдресаСерверов)
	
	ОсновнойАдрес = АдресаСерверов[0];
	
	РезервныеАдреса = КонтурEDI_РезервныеАдресаСерверовКонтур();
	
	Если НЕ РезервныеАдреса = Неопределено 
		И НЕ РезервныеАдреса.Получить(ОсновнойАдрес) = Неопределено Тогда
		
		Для Каждого РезервныйАдрес Из РезервныеАдреса[ОсновнойАдрес] Цикл
			
			Если НЕ РезервныйАдрес = ОсновнойАдрес Тогда
				АдресаСерверов.Добавить(РезервныйАдрес);	
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

