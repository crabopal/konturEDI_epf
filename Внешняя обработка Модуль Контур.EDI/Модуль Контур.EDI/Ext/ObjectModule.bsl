Функция КлиентСервисОбновлений_ОтправитьПлагин(ДвоичныеДанные, ИмяФайла, ТипПлагина, Описание = "", ХешРасширения = "", ХешМД5Родителя = "", МенеджерНастроек = Неопределено) Экспорт 
	
	Если МенеджерНастроек = Неопределено Тогда
		МенеджерНастроек = КлиентСервисОбновлений_МенеджерНастроек();
	КонецЕсли;
	
	КлиентСервисОбновлений_УстановитьЗаголовокАвторизации(МенеджерНастроек);
	
	ПараметрыСервиса = КлиентСервисОбновлений_CreatePlugin(МенеджерНастроек.ИмяПродукта, МенеджерНастроек.ИдентификаторИБ, МенеджерНастроек.ТестовоеОкружение);
	
	ТелоЗапроса = КлиентСервисОбновлений_Привести("PluginPostRequest");
	ТелоЗапроса.content_data 	= Base64Строка(ДвоичныеДанные);
	ТелоЗапроса.description 	= Описание;
	ТелоЗапроса.filename 		= ИмяФайла;
	ТелоЗапроса.hash_ext 		= ХешРасширения;
	ТелоЗапроса.parent_md5hash  = ХешМД5Родителя;
	ТелоЗапроса.plugin_type 	= ТипПлагина;
	
	Если ПустаяСтрока(ХешМД5Родителя) Тогда    
		
		ТелоЗапроса.Удалить("parent_md5hash");	
		
	КонецЕсли;   
	
	Ответ = КлиентСервисОбновлений_PostJson(ПараметрыСервиса.URL, ТелоЗапроса, МенеджерНастроек.Сессия, "CreatePlugin");
	
	ПодготовленныйОтветКлиента = КлиентСервисОбновлений_ОбработатьРезультатHTTPЗапроса(ПараметрыСервиса, Ответ);	
	
	Если НЕ ПодготовленныйОтветКлиента.Успешно Тогда
		КлиентСервисОбновлений_ТелоОписаниеОшибки(Ответ, ПодготовленныйОтветКлиента.ОписаниеОшибки); 		
	КонецЕсли;
		
	Возврат КлиентСервисОбновлений_Привести("PluginGetResponseV4", ПодготовленныйОтветКлиента.Результат); 

		
КонецФункции

