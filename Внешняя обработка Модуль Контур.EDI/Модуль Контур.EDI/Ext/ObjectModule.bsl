Функция СравнитьСообщения(Сообщение1, Сообщение2, ПроверяемыеПоля, ПропускатьНулевыеЗначения = Ложь) Экспорт
	                                                
	СообщенияРавны = СравнитьПроверямыеПоляСообщений_КонтурEDI(Сообщение1, Сообщение2, ПроверяемыеПоля);  	
	
	СообщенияРавны = СообщенияРавны И СравнитьВратаВремениСообщений_КонтурEDI(Сообщение1, Сообщение2);  
	
	Если СтрСодержит_КонтурEDI("ORDERS,ORDRSP,DESADV", Сообщение1.ТипСообщения) Тогда
		
		СообщенияРавны = СообщенияРавны И СравнитьФасовкуВСообщениях_КонтурEDI(Сообщение1, Сообщение2);  
				
	КонецЕсли;
	
	СообщенияРавны = СообщенияРавны И СравнитьТоварыСообщений_КонутEDI(Сообщение1, Сообщение2, ПропускатьНулевыеЗначения);
	
	Возврат СообщенияРавны;
	
КонецФункции

Функция СравнитьТоварыСообщений_КонутEDI(Сообщение1, Сообщение2, ПропускатьНулевыеЗначения )
	
	СообщенияРавны = Истина;
		
	СравниваемыеПоля = Новый СписокЗначений;
	СравниваемыеПоля.Добавить("Количество");
	СравниваемыеПоля.Добавить("ЦенаБезНДС");
	СравниваемыеПоля.Добавить("ЦенаСНДС");
	СравниваемыеПоля.Добавить("СтавкаНДСEDI");
	СравниваемыеПоля.Добавить("СуммаБезНДС");
	СравниваемыеПоля.Добавить("СуммаСНДС");
	
	СравниваемыеПоля.Добавить("GTIN");
	СравниваемыеПоля.Добавить("КодТовараПокупателя");
	СравниваемыеПоля.Добавить("КодТовараПоставщика");
	
	СравниваемыеПоля.Добавить("ТипПоставки");
	
	Если СтрСодержит_КонтурEDI("ORDERS,ORDRSP,DESADV", Сообщение1.ТипСообщения) Тогда
		СравниваемыеПоля.Добавить("Калибр");
	КонецЕсли; 		
	
	СтруктураТаблицы1 = ПолучитьСтруктуруТаблицыТоваров();
	СтруктураТаблицы1.Вид			= "Сообщение";
	СтруктураТаблицы1.ТипСообщения	= "ORDERS";
	СтруктураТаблицы1.Товары		= Сообщение1.Товары;
	
	СтруктураТаблицы2 = ПолучитьСтруктуруТаблицыТоваров();
	СтруктураТаблицы2.Вид			= "Сообщение";
	СтруктураТаблицы2.ТипСообщения	= "ORDERS";
	СтруктураТаблицы2.Товары		= Сообщение2.Товары;   	
	
	РезультатСравнения = СравнитьТаблицыТоваров(
	СтруктураТаблицы1,
	СтруктураТаблицы2,
	СравниваемыеПоля,,
	ПропускатьНулевыеЗначения,
	Сообщение1,
	Сообщение2);
	
	Если РезультатСравнения.Успешно 
		И РезультатСравнения.ЕстьРасхождения Тогда
		
		СообщенияРавны = Ложь;
		
	КонецЕсли;
	
	Возврат СообщенияРавны;

КонецФункции

Функция СравнитьФасовкуВСообщениях_КонтурEDI(Сообщение1, Сообщение2)
	
	СообщенияРавны = Истина;
	
	ТабФасовка1 = Сообщение1.Фасовка.Скопировать();
	ТабФасовка1.Колонки.Удалить("ФасовкаТовара");
	
	ТабФасовка2 = Сообщение2.Фасовка.Скопировать();
	ТабФасовка2.Колонки.Удалить("ФасовкаТовара");
	
	РезультатСравненияФасовки = СравнитьТаблицыЗначений(ТабФасовка1, ТабФасовка2);
	
	Если РезультатСравненияФасовки = Ложь Тогда 
		
		СообщенияРавны = Ложь;
		
	КонецЕсли;
	
	Возврат СообщенияРавны;

КонецФункции

Функция СравнитьВратаВремениСообщений_КонтурEDI(Сообщение1, Сообщение2)
	
	СообщенияРавны = Истина;
	
	// cравним врата времени
	Если Сообщение2.ТипСообщения = "ORDERS" Тогда
		
		РезультатСравнения = СравнитьСпискиЗначений(
		Сообщение1.Транспортировка.ДатаВремяПрибытия, 
		Сообщение2.Транспортировка.ДатаВремяПрибытия);
		
		Если РезультатСравнения.Успешно 
			И РезультатСравнения.ЕстьРасхождения Тогда
			
			СообщенияРавны = Ложь;
			
		КонецЕсли;
		
		РезультатСравнения = Неопределено;
		
	КонецЕсли;
	
	Возврат СообщенияРавны;

КонецФункции

Функция СравнитьПроверямыеПоляСообщений_КонтурEDI(Сообщение1, Сообщение2, ПроверяемыеПоля)
	
	СообщенияРавны = Истина;
	
	Для Каждого Эл Из ПроверяемыеПоля Цикл
		
		Элемент1 = Неопределено;
		ПеременнаяСодержитСвойство(Сообщение1, Эл, Элемент1);
		
		Элемент2 = Неопределено;
		ПеременнаяСодержитСвойство(Сообщение2, Эл, Элемент2);
		
		ТекущиеЭлементыРавны = (Элемент1 = Элемент2);
		
		СообщенияРавны = СообщенияРавны И ТекущиеЭлементыРавны;
		
	КонецЦикла;
	
	Возврат СообщенияРавны;

КонецФункции	

Функция МодульТиповой_РассчитатьСуммуНДС(Сумма, УчитыватьНДС, СуммаВключаетНДС, СтавкаНДС)
	
	Если (УчитыватьНДС=Истина) И (СуммаВключаетНДС=Истина) Тогда
		СуммаБезНДС = 100 * Сумма / (100 + СтавкаНДС);
		СуммаНДС = Сумма - СуммаБезНДС;
	Иначе
		СуммаБезНДС = Сумма;
	КонецЕсли;
	
	Если УчитыватьНДС=Истина Тогда 
		Если НЕ СуммаВключаетНДС=Истина Тогда
			СуммаНДС = СуммаБезНДС * СтавкаНДС / 100;
		КонецЕсли;
	Иначе
		СуммаНДС = 0;
	КонецЕсли;
	
	Возврат СуммаНДС;
	
КонецФункции // РассчитатьСуммуНДС()

Функция ПолучитьСтавкуНДС_КонтурEDI(СтавкаНДС) Экспорт
	
	СтандартнаяОбработкаEDI = Истина;
	
	Ставка = ОбработкаСобытияПодключаемогоМодуля("ПолучитьСтавкуНДС", СтандартнаяОбработкаEDI, Новый Структура("СтавкаНДС", СтавкаНДС));
	
	Если Не СтандартнаяОбработкаEDI Тогда
		
		Возврат Ставка;
		
	КонецЕсли;

	Числом = Истина;
	Возврат КонвертироватьСтавкуНДС_1СвEDI(СтавкаНДС, Числом);
	
КонецФункции

Процедура ДобавитьВиртуальныйORDERS(ТекущийДокумент,ДокументДляПривязки) Экспорт
	
	//а еще надо создать ORDRSP и статус документа, если уже отправлен хотя бы один ORDRSP
	ТабВиртуальныхСообщений = ПолучитьВиртуальныеСвязанныеORDERS(ТекущийДокумент);
	СтрокаДляКопирования = ТабВиртуальныхСообщений.Найти(ТекущийДокумент,"Документ");
	Если СтрокаДляКопирования<>Неопределено 
		И ЗначениеЗаполнено(СтрокаДляКопирования.ORDERS) Тогда
		
		НачатьТранзакцию();
		Попытка
			                       
			НовСообщение = ПреобразоватьЗначениеДляВнешнегоХранилища(СтрокаДляКопирования.ORDERS).Скопировать();
			НовСообщение.Документ = ПреобразоватьЗначениеДляВнешнегоХранилища(ДокументДляПривязки);
			НовСообщение.УстановитьНовыйКод();
			СохранитьОбъектСообщения(НовСообщение);
			
			Если ЗначениеЗаполнено(СтрокаДляКопирования.ORDRSP)
				И НЕ (ПолучитьЗначениеСвойстваОбъектаEDI(СтрокаДляКопирования.ORDRSP.Партнер, "ОтдельныйORDRSPНаКаждыйДокументЗаказа") = Истина) Тогда
				
				УдалитьORDRSP = Ложь;
				Для Каждого Стр Из ТабВиртуальныхСообщений Цикл
					Если ЗначениеЗаполнено(Стр.ORDRSP) 
						И Стр.ORDRSP_Статус = "Ожидает отправки" Тогда
						УдалитьORDRSP = Истина;
					КонецЕсли;	
				КонецЦикла;	
						
				Если УдалитьORDRSP Тогда
					//удалим все ORDRSP и статусы документов, чтобы сообщение вернулось в статус "Подтвердите заказ"
					Для Каждого Стр Из ТабВиртуальныхСообщений Цикл
						
						Если ЗначениеЗаполнено(Стр.ORDRSP) Тогда
							
							ПреобразоватьЗначениеДляВнешнегоХранилища(Стр.ORDRSP).ПолучитьОбъект().Удалить();
							
							Если ВнешнееХранилище Тогда
								МЗ = СоединениеСХранилищем.РегистрыСведений.КонтурEDI_СтатусыДокументов.СоздатьМенеджерЗаписи();
							Иначе
								МЗ = РегистрыСведений.КонтурEDI_СтатусыДокументов.СоздатьМенеджерЗаписи();
							КонецЕсли;	
							
							МЗ.Документ = ПреобразоватьЗначениеДляВнешнегоХранилища(Стр.Документ);
							МЗ.ИмяСтатуса = "Заказ";
							МЗ.Удалить();
							
						КонецЕсли;
						
					КонецЦикла;	
					
				Иначе	//не УдалитьORDRSP
					
					//заодно создать ORDRSP и скопировать статус документа
					НовСообщение = ПреобразоватьЗначениеДляВнешнегоХранилища(СтрокаДляКопирования.ORDRSP).Скопировать();
					НовСообщение.УстановитьНовыйКод();
					НовСообщение.Документ = ПреобразоватьЗначениеДляВнешнегоХранилища(ДокументДляПривязки);
					СохранитьОбъектСообщения(НовСообщение);
					
					Если ВнешнееХранилище Тогда
						МЗ = СоединениеСХранилищем.РегистрыСведений.КонтурEDI_СтатусыДокументов.СоздатьМенеджерЗаписи();
					Иначе
						МЗ = РегистрыСведений.КонтурEDI_СтатусыДокументов.СоздатьМенеджерЗаписи();
					КонецЕсли;
				
					МЗ.Документ = ПреобразоватьЗначениеДляВнешнегоХранилища(ТекущийДокумент);
					МЗ.ИмяСтатуса = "Заказ";
					МЗ.Прочитать();
					_Статус = МЗ.Статус;//получим текущий статус документа
					
					МЗ.Документ = ПреобразоватьЗначениеДляВнешнегоХранилища(ДокументДляПривязки);
					МЗ.ИмяСтатуса = "Заказ";
					МЗ.Статус = _Статус;//и скопируем его в остальные документы
					МЗ.Записать();
						
				КонецЕсли;
			КонецЕсли;	
			
		    Если ТранзакцияАктивна() Тогда
		        ЗафиксироватьТранзакцию();
			КонецЕсли;
			
		Исключение
			
		    Если ТранзакцияАктивна() Тогда
		        ОтменитьТранзакцию();
			КонецЕсли;
			
			ТекстОшибки = "Не удалось привязать дополнительный документ к ORDERS - " + ОписаниеОшибки();
			ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);
			ВызватьИсключение ТекстОшибки;
			
		КонецПопытки;
	КонецЕсли;	
		
КонецПроцедуры

Функция ТекстПересчета_КонтурEDI(ЕдиницаИзмерения, ЕдиницаEDI, КоэффициентEDIВ1С) Экспорт

	Если Не ЗначениеЗаполнено(ЕдиницаEDI) Тогда
		
		Текст = "нет пересчетов";
		 		
	Иначе
		
		Если КоэффициентEDIВ1С = 0 Тогда
			
			КоличествоЕдиниц1С = 1;
			КоличествоЕдиницEDI = 1; 
			
		ИначеЕсли КоэффициентEDIВ1С < 0  Тогда
			
			КоличествоЕдиниц1С = 1;
			КоличествоЕдиницEDI = -1*КоэффициентEDIВ1С;
			
		Иначе
			
			КоличествоЕдиниц1С = КоэффициентEDIВ1С;
			КоличествоЕдиницEDI = 1; 
			
		КонецЕсли;
		
		Если КоличествоЕдиницEDI > 1 Тогда
			
			ТекстРавно = " равны ";
			
		Иначе
			
			ТекстРавно = " равен ";
			
		КонецЕсли;
		
		Текст = "" + КоличествоЕдиницEDI + " " + ЕдиницаEDI + ТекстРавно + КоличествоЕдиниц1С + " " + ЕдиницаИзмерения;
		
	КонецЕсли;  	
	
	Возврат Текст;

КонецФункции 

Функция КоэффициентИЕдиницаПересчета_КонтурEDI(КоличествоЕдиниц1С, КоличествоЕдиницEDI, ЕдиницаEDI) Экспорт
	
	Структура = Новый Структура("КоэффициентEDIВ1С,ЕдиницаEDI", , ЕдиницаEDI);
	
	Если КоличествоЕдиниц1С = КоличествоЕдиницEDI 
		ИЛИ КоличествоЕдиниц1С = 0
		ИЛИ КоличествоЕдиницEDI = 0 Тогда
		
		Структура.КоэффициентEDIВ1С = 1;
		
		Возврат Структура;
		
	КонецЕсли;
	
	ТипКоэффициентаEDIВ1С	= ПолучитьТип_КонтурEDI("КоэффициентEDIВ1С");
	РазрядностьОкругления	= ТипКоэффициентаEDIВ1С.КвалификаторыЧисла.РазрядностьДробнойЧасти;
	
	Если КоличествоЕдиниц1С < КоличествоЕдиницEDI Тогда
		
		РасчетБезОкругления = КоличествоЕдиницEDI / КоличествоЕдиниц1С;
		РасчетСОкруглением = Окр(РасчетБезОкругления, РазрядностьОкругления);
		
		Если РасчетБезОкругления <> РасчетСОкруглением Тогда
			КоэффициентEDIВ1С = КоличествоЕдиниц1С / КоличествоЕдиницEDI;
		Иначе
			КоэффициентEDIВ1С = -1 * КоличествоЕдиницEDI / КоличествоЕдиниц1С;
		КонецЕсли;
		
	Иначе
		
		РасчетБезОкругления = КоличествоЕдиниц1С / КоличествоЕдиницEDI;
		РасчетСОкруглением = Окр(РасчетБезОкругления, РазрядностьОкругления);
		
		Если РасчетБезОкругления <> РасчетСОкруглением Тогда
			КоэффициентEDIВ1С = -1 * КоличествоЕдиницEDI / КоличествоЕдиниц1С;
		Иначе
			КоэффициентEDIВ1С = КоличествоЕдиниц1С / КоличествоЕдиницEDI;
		КонецЕсли;
		
	КонецЕсли;
	
	Структура.КоэффициентEDIВ1С = КоэффициентEDIВ1С;
	
	Возврат Структура;

КонецФункции

Процедура ЗаполнитьРеквизитыПересчетаКорректно(СтрокаНаФорме, СтрокаСоответствия, ТипЕдиницы) Экспорт
	
	Если Не ЗначениеЗаполнено(СтрокаСоответствия.КоэффициентEDIВ1С) Тогда
		СтрокаНаФорме.КоэффициентEDIВ1С = 1;
	КонецЕсли;	
		
	Если Не ЗначениеЗаполнено(СтрокаНаФорме.ЕдиницаEDI) Тогда
		СтрокаНаФорме.ЕдиницаEDI = "";		 
	КонецЕсли;
		
	Если НЕ ЗначениеЗаполнено(ТипЕдиницы) И ЗначениеЗаполнено(СтрокаСоответствия.ТипЕдиницы) Тогда
		ТипЕдиницы = СтрокаСоответствия.ТипЕдиницы;
	КонецЕсли;
		
КонецПроцедуры   

Функция ПолучитьМассивКолонокДляПересчета_КонтурEDI(Колонки, Таблица) Экспорт

	МассивКолонок = Новый Массив;
	
	Колонки = СтрЗаменить(Колонки,",",Символы.ПС);
	
	ЧислоКолонок = СтрЧислоСтрок(Колонки);
	
	Для Сч = 1 По ЧислоКолонок Цикл
		
		ИмяКолонки = СокрЛП(СтрПолучитьСтроку(Колонки,Сч));
		
		Если Таблица.Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
			 МассивКолонок.Добавить(ИмяКолонки);
		КонецЕсли;
			
	КонецЦикла;

	Возврат МассивКолонок
	
КонецФункции

Процедура ПересчитатьТоварыСообщения(ТаблицаТоваров,Партнер,Направление,Сообщение = Неопределено) Экспорт
			
	СтандартнаяОбработкаEDI = Истина;
	ОбработкаСобытияПодключаемогоМодуля("ПересчитатьТоварыСообщения",СтандартнаяОбработкаEDI,Новый Структура("ТаблицаТоваров,Партнер,Направление,Сообщение",ТаблицаТоваров,Партнер,Направление,Сообщение));
	Если Не СтандартнаяОбработкаEDI Тогда
		Возврат;
	КонецЕсли;
	
	МассивКолонокДляПересчета_Разделить = ПолучитьМассивКолонокДляПересчета_КонтурEDI("Количество,КоличествоДоКорректировки", ТаблицаТоваров);
	МассивКолонокДляПересчета_Умножить = ПолучитьМассивКолонокДляПересчета_КонтурEDI("Цена,ЦенаБезНДС,ЦенаСНДС,ЦенаДоКорректировки,ЦенаБезНДСДоКорректировки,ЦенаСНДСДоКорректировки", ТаблицаТоваров);
	
	Для Каждого СтрокаСообщения Из ТаблицаТоваров Цикл
		
		Коэффициент = КоэффициентEDIВ1С_Расчетный_КонтурEDI(Направление, СтрокаСообщения.КоэффициентEDIВ1С); 
		
		// теперь собственно расчеты
		ПересчетСтроки_КонтурEDI(СтрокаСообщения, Коэффициент, МассивКолонокДляПересчета_Разделить, МассивКолонокДляПересчета_Умножить);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПересчетСтроки_КонтурEDI(
	СтрокаСообщения, 
	Коэффициент, 
	МассивКолонокДляПересчета_Разделить, 
	МассивКолонокДляПересчета_Умножить) Экспорт
		
	Для Каждого ИмяКолонки Из МассивКолонокДляПересчета_Разделить Цикл
		СтрокаСообщения[ИмяКолонки]	= СтрокаСообщения[ИмяКолонки] / Коэффициент;
	КонецЦикла;
	
	Для Каждого ИмяКолонки Из МассивКолонокДляПересчета_Умножить Цикл
		СтрокаСообщения[ИмяКолонки]	= СтрокаСообщения[ИмяКолонки] * Коэффициент;
	КонецЦикла;

КонецПроцедуры

Функция КоэффициентEDIВ1С_Расчетный_КонтурEDI(Направление, КоэффициентEDIВ1С) Экспорт
	
	Если Направление = "ВEDI" Тогда
		
		Если КоэффициентEDIВ1С > 0 Тогда
			Коэффициент = КоэффициентEDIВ1С;
		ИначеЕсли КоэффициентEDIВ1С < 0 Тогда
			Коэффициент = -1/КоэффициентEDIВ1С;
		Иначе
			Коэффициент = 1;
		КонецЕсли;
		
	Иначе
		
		Если КоэффициентEDIВ1С > 0 Тогда
			Коэффициент = 1/КоэффициентEDIВ1С;
		ИначеЕсли КоэффициентEDIВ1С < 0 Тогда
			Коэффициент = -1*КоэффициентEDIВ1С;
		Иначе
			Коэффициент = 1;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Коэффициент;

КонецФункции

Процедура ПересчитатьСтрокуТоваровНезависимогоСообщения(Строка, Направление, ПересчитыватьКоличество = Истина) Экспорт
		
	ДействиеПересчета = "";
	КоэффициентEDIВ1С = 1;
	
	Если ЗначениеЗаполнено(Строка.КоэффициентEDIВ1С) Тогда
		ДействиеПересчета = ?(Строка.КоэффициентEDIВ1С>0, "умножить", "разделить");
		КоэффициентEDIВ1С = Макс(-Строка.КоэффициентEDIВ1С, Строка.КоэффициентEDIВ1С);
	КонецЕсли;
	
	Если ДействиеПересчета = "умножить" Тогда
		Коэффициент = 1/КоэффициентEDIВ1С;
	ИначеЕсли ДействиеПересчета = "разделить" Тогда
		Коэффициент = КоэффициентEDIВ1С;
	Иначе
		Коэффициент = 1;
	КонецЕсли;
	
	Если Направление = "ВEDI" Тогда
		Коэффициент = 1/Коэффициент;//для исходящих будет обратный пересчет
	КонецЕсли;
	
	МассивРеквизитов = Новый Массив;
	
	Если ПересчитыватьКоличество Тогда
		МассивРеквизитов.Добавить("КоличествоТекущегоОстатка");
		МассивРеквизитов.Добавить("КоличествоЗаказано");
		МассивРеквизитов.Добавить("КоличествоДоставлено");
		МассивРеквизитов.Добавить("КоличествоПринято");
		МассивРеквизитов.Добавить("КоличествоОстаткаНаНачало");
		МассивРеквизитов.Добавить("КоличествоОстаткаНаКонец");
		МассивРеквизитов.Добавить("КоличествоПродано");
		МассивРеквизитов.Добавить("Количество");
	КонецЕсли;
	
	Если ПеременнаяСодержитСвойство(Строка, "ЦенаБезНДСРасчетная") Тогда 
		Строка.ЦенаБезНДСРасчетная = Строка.ЦенаБезНДС * Коэффициент;
	Иначе
		МассивРеквизитов.Добавить("ЦенаБезНДС"); 
	КонецЕсли;
	
	Если ПеременнаяСодержитСвойство(Строка, "ЦенаСНДСРасчетная") Тогда 
		Строка.ЦенаСНДСРасчетная = Строка.ЦенаСНДС   * Коэффициент;
	Иначе
		МассивРеквизитов.Добавить("ЦенаСНДС");   
	КонецЕсли; 
	
	Для каждого ИмяРеквизита Из МассивРеквизитов Цикл
		ПересчитатьРеквизитТоваровНезависимогоСообщения(ИмяРеквизита, Строка, Направление, Коэффициент);
	КонецЦикла;
		
КонецПроцедуры

Процедура ПересчитатьРеквизитТоваровНезависимогоСообщения(НазваниеРеквизита, Строка, Направление, Знач Коэффициент) Экспорт
	
	Если Найти(НазваниеРеквизита, "Количество") = 1 Тогда
		Коэффициент = 1/Коэффициент;
	КонецЕсли;
	
	Если ПеременнаяСодержитСвойство(Строка, НазваниеРеквизита) Тогда
		
		Если ПеременнаяСодержитСвойство(Строка, НазваниеРеквизита + "Расчетный") Тогда
			
			Если Направление = "ВEDI" Тогда 
				
				Строка[НазваниеРеквизита + "Расчетный"] = Строка[НазваниеРеквизита] * Коэффициент;
				
			Иначе
				
				Строка[НазваниеРеквизита] = Строка[НазваниеРеквизита + "Расчетный"] * Коэффициент;
				
			КонецЕсли;
			
		Иначе 
			
			Строка[НазваниеРеквизита] = Строка[НазваниеРеквизита] * Коэффициент;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Функция ЕдиницаEDI_ПоУмолчанию(ЕдиницаИзмерения) Экспорт
	
	Если НРег(Строка(ЕдиницаИзмерения)) = "кг" Тогда
		ЕдиницаEDI = "KGM";
	Иначе
		ЕдиницаEDI = "PCE"; 			
	КонецЕсли; 
	
	Возврат ЕдиницаEDI;
	
КонецФункции 

Функция СоотношениеКоличеств_1С_EDI(КоэффициентEDIВ1С) Экспорт
	
	СоотношениеКоличеств = Новый Структура("КоличествоЕдиниц1С,КоличествоЕдиницEDI", 1, 1);
	
	Если КоэффициентEDIВ1С = 0 Тогда
		
		СоотношениеКоличеств.КоличествоЕдиниц1С = 1;
		СоотношениеКоличеств.КоличествоЕдиницEDI = 1;
		
	ИначеЕсли КоэффициентEDIВ1С < 0  Тогда
		
		СоотношениеКоличеств.КоличествоЕдиниц1С = 1;
		СоотношениеКоличеств.КоличествоЕдиницEDI = -1*КоэффициентEDIВ1С;
		
	Иначе
		
		СоотношениеКоличеств.КоличествоЕдиниц1С = КоэффициентEDIВ1С;
		СоотношениеКоличеств.КоличествоЕдиницEDI = 1;
		
	КонецЕсли;
	
	Возврат СоотношениеКоличеств;
	
КонецФункции

Функция ПолучитьСоответствияТоваровДляПересчета(ТаблицаТоваров,ЗНАЧ Партнер)
	
	//TODO постараться завернуть на ПолучитьТаблицуСоответствийДляТоваров1С 
	//сюда же завернуть и СоответствиеТоваров_НайтиНоменклатуру по возможности
	//а саму эту функцию постараться завернуть на конвертацию товаров - "ПолучитьТаблицуСоответствийДляТоваров1С"
	
	ТаблицаДляЗапроса = Новый ТаблицаЗначений;
	ТаблицаДляЗапроса.Колонки.Добавить("GTIN", ОписаниеТипаСтрока_КонтурEDI(14));
	ТаблицаДляЗапроса.Колонки.Добавить("КодТовараПокупателя", ОписаниеТипаСтрока_КонтурEDI(36));
	
	Для Каждого СтрокаТоваров Из ТаблицаТоваров Цикл//типизируем колонки таблицы
		НоваяСтрокаДляЗапроса = ТаблицаДляЗапроса.Добавить();
		НоваяСтрокаДляЗапроса.GTIN					= СтрокаТоваров.GTIN;
		НоваяСтрокаДляЗапроса.КодТовараПокупателя	= СтрокаТоваров.КодТовараПокупателя;
	КонецЦикла;
	
	Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
	
	Если ВнешнееХранилище Тогда
		Запрос.УстановитьПараметр("Парам",ПоместитьТаблицуВоВнешнююБазу(ТаблицаДляЗапроса));
	Иначе	
		Запрос.УстановитьПараметр("Парам",ТаблицаДляЗапроса);
	КонецЕсли;
	Запрос.УстановитьПараметр("СинхронизироватьТоварыТолькоПоКодуПартнера",	ПолучитьЗначениеСвойстваОбъектаEDI(Партнер, "СинхронизироватьТоварыТолькоПоКодуПартнера") = Истина);
	Запрос.УстановитьПараметр("СинхронизироватьТоварыТолькоПоGTIN",			ПолучитьЗначениеСвойстваОбъектаEDI(Партнер, "СинхронизироватьТоварыТолькоПоGTIN") = Истина);
	Запрос.УстановитьПараметр("Партнер",									ПреобразоватьЗначениеДляВнешнегоХранилища(Партнер));
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Парам.GTIN КАК GTIN,
	|	Парам.КодТовараПокупателя КАК КодТовараПокупателя
	|ПОМЕСТИТЬ ВТКоды
	|ИЗ
	|	&парам КАК Парам
	|ГДЕ
	|	(Парам.GTIN <> """"
	|			ИЛИ Парам.КодТовараПокупателя <> """")
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	GTIN,
	|	КодТовараПокупателя
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТКоды.GTIN КАК GTIN,
	|	ВложенныйЗапрос.КодТовараПартнера КАК КодТовараПартнера,
	|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	|	ВложенныйЗапрос.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ВложенныйЗапрос.Единица КАК ЕдиницаИзмерения,
	|	ВложенныйЗапрос.ОсновноеСоответствие КАК Основной,
	|	ВложенныйЗапрос.ЕдиницаEDI КАК ЕдиницаEDI,
	|	ВложенныйЗапрос.КоэффициентEDIВ1С КАК КоэффициентEDIВ1С,
	|	ВложенныйЗапрос.Контрагент,
	|	ВложенныйЗапрос.Договор,
	|	ВложенныйЗапрос.ТипЕдиницы КАК ТипЕдиницы
	|ИЗ
	|	ВТКоды КАК ВТКоды
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			КонтурEDI_СоответствияТоваров.Номенклатура КАК Номенклатура,
	|			КонтурEDI_СоответствияТоваров.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|			КонтурEDI_СоответствияТоваров.Единица КАК Единица,
	|			КонтурEDI_СоответствияТоваров.ЕдиницаEDI КАК ЕдиницаEDI,
	|			КонтурEDI_СоответствияТоваров.GTIN КАК GTIN,
	|			КонтурEDI_СоответствияТоваров.КодТовараПартнера КАК КодТовараПартнера,
	|			КонтурEDI_СоответствияТоваров.КоэффициентEDIВ1С КАК КоэффициентEDIВ1С,
	|			КонтурEDI_СоответствияТоваров.ОсновноеСоответствие КАК ОсновноеСоответствие,
	|			КонтурEDI_СоответствияТоваров.Контрагент КАК Контрагент,
	|			КонтурEDI_СоответствияТоваров.Договор КАК Договор,
	|			КонтурEDI_СоответствияТоваров.ТипЕдиницы КАК ТипЕдиницы
	|		ИЗ
	|			РегистрСведений.КонтурEDI_СоответствияТоваров КАК КонтурEDI_СоответствияТоваров
	|		ГДЕ
	|			КонтурEDI_СоответствияТоваров.Партнер = &Партнер
	|			И (КонтурEDI_СоответствияТоваров.GTIN = """"
	|					ИЛИ КонтурEDI_СоответствияТоваров.GTIN В
	|						(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|							ВТКоды.GTIN
	|						ИЗ
	|							ВТКоды КАК ВТКоды)
	|					ИЛИ (КонтурEDI_СоответствияТоваров.КодТовараПартнера = """"
	|						ИЛИ КонтурEDI_СоответствияТоваров.КодТовараПартнера В
	|							(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|								ВТКоды.КодТовараПокупателя
	|							ИЗ
	|								ВТКоды КАК ВТКоды)))) КАК ВложенныйЗапрос
	|		ПО (ВЫБОР
	|				КОГДА &СинхронизироватьТоварыТолькоПоGTIN
	|						И ВТКоды.GTIN <> """"
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ВложенныйЗапрос.КодТовараПартнера = ВТКоды.КодТовараПокупателя
	|			КОНЕЦ)
	|			И (ВЫБОР
	|				КОГДА &СинхронизироватьТоварыТолькоПоКодуПартнера
	|						И ВТКоды.КодТовараПокупателя <> """"
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ВложенныйЗапрос.GTIN = ВТКоды.GTIN
	|			КОНЕЦ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	GTIN,
	|	КодТовараПартнера,
	|	Основной УБЫВ,
	|	Номенклатура
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Если НЕ ЕстьМетаданныеТипЕдиницы Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КонтурEDI_СоответствияТоваров.ТипЕдиницы КАК ТипЕдиницы", "ВЫРАЗИТЬ("""" КАК СТРОКА(20)) КАК ТипЕдиницы");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВложенныйЗапрос.ТипЕдиницы КАК ТипЕдиницы", "ВЫРАЗИТЬ("""" КАК СТРОКА(20)) КАК ТипЕдиницы");
	КонецЕсли;
	
	ТабСоответствий = Запрос.Выполнить().Выгрузить();
	
	Если ВнешнееХранилище Тогда
		//объясним, какие колонки внешней базы мы будем преобразовывать в Ссылки локальной базы
		СтруктураКолонокПреобразуемыхВСсылки = Новый Структура;
		СтруктураКолонокПреобразуемыхВСсылки.Вставить("Номенклатура",				Новый ОписаниеТипов(ПолучитьТипЗначенияОбъекта("Номенклатура")));
		СтруктураКолонокПреобразуемыхВСсылки.Вставить("ЕдиницаИзмерения", 			Новый ОписаниеТипов(ПолучитьТипЗначенияОбъекта("ЕдиницаИзмерения")));
		
		Если Не НастройкиМодуля.ИспользоватьХарактеристикиНоменклатуры Тогда
			СтруктураКолонокПреобразуемыхВСсылки.Вставить("ХарактеристикаНоменклатуры",	ОписаниеТипаСтрока_КонтурEDI());
		Иначе
			СтруктураКолонокПреобразуемыхВСсылки.Вставить("ХарактеристикаНоменклатуры",	Новый ОписаниеТипов(ПолучитьТипЗначенияОбъекта("ХарактеристикаНоменклатуры")));
		КонецЕсли;
		
		СтруктураКолонокПреобразуемыхВСсылки.Вставить("Контрагент",	Новый ОписаниеТипов(ПолучитьТипЗначенияОбъекта("ЮрФизЛицоСтороннее")));
		СтруктураКолонокПреобразуемыхВСсылки.Вставить("Договор", 	Новый ОписаниеТипов(ПолучитьТипЗначенияОбъекта("Договор")));
		
		ТабСоответствий = ПолучитьТаблицуИзВнешнейБазы(ТабСоответствий,СтруктураКолонокПреобразуемыхВСсылки);
		
	КонецЕсли;
	
	Возврат ТабСоответствий;
	
КонецФункции

Процедура УбратьВиртуальныйORDERS(ОтвязываемыйДокумент) Экспорт
	
	ТабВиртуальныхСообщений = ПолучитьВиртуальныеСвязанныеORDERS(ОтвязываемыйДокумент);
			
	СтрокаДляУдаления = ТабВиртуальныхСообщений.Найти(ОтвязываемыйДокумент, "Документ");
	
	Если СтрокаДляУдаления = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	
	Попытка
		УдалитьСообщение(СтрокаДляУдаления.ORDERS, , "#v");
		
		Если ЗначениеЗаполнено(СтрокаДляУдаления.ORDRSP) Тогда
			
			УдалитьORDRSP = Ложь;
			Для Каждого Стр Из ТабВиртуальныхСообщений Цикл
				Если ЗначениеЗаполнено(Стр.ORDRSP) 
					И Стр.ORDRSP_Статус = "Ожидает отправки" Тогда
					УдалитьORDRSP = Истина;
					Прервать;
				КонецЕсли;	
			КонецЦикла;	
			
			Для Каждого СтрокаТаблицы Из ТабВиртуальныхСообщений Цикл
			
				// Если существует ORDRSP в статусе "ОжидаетОтправки", удалим все ORDRSP и статусы документов, 
				// чтобы сообщения вернулись в статус "Подтвердите заказ", иначе удалим только одно сообщение
				Если ЗначениеЗаполнено(СтрокаТаблицы.ORDRSP) И (УдалитьORDRSP ИЛИ СтрокаТаблицы = СтрокаДляУдаления) Тогда

					УдалитьСообщение(СтрокаТаблицы.ORDRSP, , "#v");
					
					МЗ = РегистрыСведений.КонтурEDI_СтатусыДокументов.СоздатьМенеджерЗаписи();
					МЗ.Документ = СтрокаТаблицы.Документ;
					МЗ.ИмяСтатуса = "Заказ";
					МЗ.Удалить();

				КонецЕсли;

			КонецЦикла;
		
		КонецЕсли;
		
	    Если ТранзакцияАктивна() Тогда
	        ЗафиксироватьТранзакцию();
		КонецЕсли;
		
	Исключение
		
	    Если ТранзакцияАктивна() Тогда
	        ОтменитьТранзакцию();
		КонецЕсли;
		
		ТекстОшибки = "Не удалось отвязать документ от ORDERS - " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);
		ВызватьИсключение ТекстОшибки;
		
	КонецПопытки;
	
КонецПроцедуры

Функция ПолучитьЗапросПоЦенамНоменклатуры_КонтурEDI() Экспорт

	ТекстЗапроса = ЭДО_Кэш_Прочитать("КэшТекстЗапросаПоЦенам");
	
	Если ТекстЗапроса = Неопределено Тогда
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЦеныНоменклатурыСрезПоследних.Номенклатура,
			|	ЦеныНоменклатурыСрезПоследних.Цена
			|ИЗ
			|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
			|			&ДатаЦен,
			|			Номенклатура В (&МассивНоменклатуры)
			|				И ВидЦен = &ТипЦен) КАК ЦеныНоменклатурыСрезПоследних";
		
		Если ЕстьНеобходимыеМетаданные("РегистрыСведений.ЦеныНоменклатуры.Измерения.ВидЦены") Тогда
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВидЦен", "ВидЦены");
						
		ИначеЕсли ЕстьНеобходимыеМетаданные("РегистрыСведений.ЦеныНоменклатуры.Измерения.ТипЦен") Тогда 
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВидЦен", "ТипЦен");
		    			
		ИначеЕсли ЕстьНеобходимыеМетаданные("РегистрыСведений.ЦеныНоменклатуры.Измерения.КатегорияЦен") Тогда
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВидЦен", "КатегорияЦен");
			
		КонецЕсли;
		
		ОбработатьПодменыДляКонфигурации_КонтурEDI(ТекстЗапроса);		
		
		ЭДО_Кэш_Поместить("КэшТекстЗапросаПоЦенам", ТекстЗапроса);
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;

КонецФункции 

Функция ПолучитьРезультатЗапросаПоСвоимЦенам_КонтруEDI(МассивНоменклатуры, ТипЦен, ДатаЦен) 

	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьЗапросПоЦенамНоменклатуры_КонтурEDI();
	
	Запрос.УстановитьПараметр("МассивНоменклатуры",	МассивНоменклатуры);
	Запрос.УстановитьПараметр("ТипЦен",				ТипЦен);
	Запрос.УстановитьПараметр("ДатаЦен",			ДатаЦен);
	
	Возврат Запрос.Выполнить();

КонецФункции 

Процедура ЗаполнитьСтрокиТаблицыСвоимиЦенами(Строки, 
											ТипЦен, 
											Дата, 
											ТолькоСНезаполненнойЦеной = Ложь, 
											ПересчитатьСтроку = Ложь, 
											Документ = Неопределено, 
											ИмяКолонкиНоменклатура = "Номенклатура", 
											ИмяКолонкиЦена = "Цена") Экспорт

	Если ТипЗнч(Строки) <> Тип("Массив") Тогда
		МассивСтрок = Новый Массив;
		МассивСтрок.Добавить(Строки);
	Иначе
		МассивСтрок = Строки;
	КонецЕсли;
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МассивНоменклатуры = Новый Массив;
	
	Для каждого Строка Из МассивСтрок Цикл
		
		Если НЕ ТолькоСНезаполненнойЦеной ИЛИ Строка[ИмяКолонкиЦена] = 0 Тогда
			МассивНоменклатуры.Добавить(Строка[ИмяКолонкиНоменклатура]);
		КонецЕсли;
		
	КонецЦикла;
	
	РезультатЗапроса = ПолучитьРезультатЗапросаПоСвоимЦенам_КонтруEDI(МассивНоменклатуры, ТипЦен, Дата);	
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли; 	
	
	ВыборкаЦен = РезультатЗапроса.Выбрать();
	
	СоответствиеЦен = Новый Соответствие;
	Пока ВыборкаЦен.Следующий() Цикл
		СоответствиеЦен.Вставить(ВыборкаЦен.Номенклатура, ВыборкаЦен.Цена);
	КонецЦикла;
	
    Для каждого Строка Из МассивСтрок Цикл
		
		Если НЕ ТолькоСНезаполненнойЦеной ИЛИ Строка[ИмяКолонкиЦена] = 0 Тогда
			
			Цена = СоответствиеЦен[Строка[ИмяКолонкиНоменклатура]];
			Если Цена <> Неопределено И Строка[ИмяКолонкиЦена] <> Цена Тогда
				
				Строка[ИмяКолонкиЦена] = Цена;	
				
				Если ПересчитатьСтроку И Документ <> Неопределено Тогда
					ПересчитатьСтрокуДокумента(Строка,Документ);
				КонецЕсли;
				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЦикла; 
	
КонецПроцедуры


// #КонецОбласти //МодульИнтеграции_Новый


// #Область Модуль_Интеграция_УТ_УПП_КА

// печать заявок.	
Функция ПодготовитьПечатнуюФормуЗаказа(Сообщение, Макет, ТабДокОбщий = Неопределено) Экспорт
	
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("Сообщение", Сообщение);
	ПараметрыПМ.Вставить("Макет", Макет);
	ПараметрыПМ.Вставить("ТабДокОбщий", ТабДокОбщий);
	
	РезультатПМ = ОбработкаСобытияПодключаемогоМодуля("ПодготовитьПечатнуюФормуЗаказа",, ПараметрыПМ);
	
	Если НЕ РезультатПМ = Неопределено
		И ТипЗнч(РезультатПМ) = Тип("ТабличныйДокумент") Тогда
		Возврат РезультатПМ;
	КонецЕсли;

	Товары = Сообщение.Товары;
	ТабДок = Новый ТабличныйДокумент;
	
	ЗаголовокЛиста = "Заказ № " + Сообщение.ДокументEDI.Номер; 
	Если ЗначениеЗаполнено(Сообщение.НомерСерииЗаказов) Тогда
		ЗаголовокЛиста = ЗаголовокЛиста + " (" + Сообщение.НомерСерииЗаказов + ") ";
	КонецЕсли;
	ЗаголовокЛиста = ЗаголовокЛиста + " от " + Формат(Сообщение.ДокументEDI.Дата, "ДЛФ=Д");
	Если ЗначениеЗаполнено(Сообщение.Статус) Тогда
		ЗаголовокЛиста = ЗаголовокЛиста + " - " + Сообщение.Статус;
	КонецЕсли;
	Партнер = ПреобразоватьЗначениеДляВнешнегоХранилища(Сообщение.Партнер);
	Если Партнер <> Неопределено Тогда
		ЗаголовокЛиста = ЗаголовокЛиста + ", " + Партнер.Наименование;
	КонецЕсли;
	
	ДатаВывозаОтПоставщика = "";
	Если Сообщение.Свойство("ДатаВывозаОтПоставщика")
		И ЗначениеЗаполнено(Сообщение.ДатаВывозаОтПоставщика) Тогда
		ДатаВывозаОтПоставщика = Формат(Сообщение.ДатаВывозаОтПоставщика, "ДФ=""дд.ММ.гггг ЧЧ:мм""");
	КонецЕсли;
	
	Договор = "";
	Если Сообщение.Свойство("Контракт") Тогда
		Договор = ?(ЗначениеЗаполнено(Сообщение.Контракт.Номер), "№ " + Строка(Сообщение.Контракт.Номер) + " ", "")  
				+ ?(ЗначениеЗаполнено(Сообщение.Контракт.Дата), "от " + Формат(Сообщение.Контракт.Дата, "ДФ=""дд.ММ.гггг"""), "");
	КонецЕсли;
	
	Контакты = "";
	Если Сообщение.Свойство("КонтактноеЛицоФИО") Тогда
		Контакты = ?(ЗначениеЗаполнено(Сообщение.КонтактноеЛицоФИО), Сообщение.КонтактноеЛицоФИО + " ", "") 
					+ ?(ЗначениеЗаполнено(Сообщение.КонтактноеЛицоТелефон), "Телефон: " + Сообщение.КонтактноеЛицоТелефон + " ", "") 
					+ ?(ЗначениеЗаполнено(Сообщение.КонтактноеЛицоЭлпочта), "Эл. почта: " + Сообщение.КонтактноеЛицоЭлпочта, "");
	КонецЕсли;
		
	ОбластьРазделитель 				= Макет.ПолучитьОбласть("Разделитель"); 
	ОбластьШапкаЗаголовок			= Макет.ПолучитьОбласть("ШапкаЗаголовок");
	ОбластьШапкаРеквизит			= Макет.ПолучитьОбласть("ШапкаРеквизит");
	ОбластьЗаголовокРеквизиты 		= Макет.ПолучитьОбласть("ЗаголовокРеквизиты");
	ОбластьРеквизиты				= Макет.ПолучитьОбласть("Реквизиты");
	ОбластьЗаголовокТаблицы 		= Макет.ПолучитьОбласть("ЗаголовокТаблицы");
	ОбластьСтрокаТаблицы 			= Макет.ПолучитьОбласть("СтрокаТаблицы");
	ОбластьЗаголовокВрата			= Макет.ПолучитьОбласть("ЗаголовокВрата");
	ОбластьСтрокаВрата				= Макет.ПолучитьОбласть("СтрокаВрата");
	ОбластьЗаголовокВремяПогрузки	= Макет.ПолучитьОбласть("ЗаголовокВремяПогрузки");
	ОбластьСтрокаВремяПогрузки		= Макет.ПолучитьОбласть("СтрокаВремяПогрузки");
	ЯчейкаОбычноеПоле				= Макет.ПолучитьОбласть("ОбычноеПоле");
	ЯчейкаРасчетноеПоле 			= Макет.ПолучитьОбласть("РасчетноеПоле");
	ЯчейкаОбычноеПолеИтого 			= Макет.ПолучитьОбласть("ОбычноеПолеИтого");
	ЯчейкаРасчетноеПолеИтого 		= Макет.ПолучитьОбласть("РасчетноеПолеИтого");
   	ОбластьИтого					= Макет.ПолучитьОбласть("Итого");
	ОбластьПредупреждениеРасчет 	= Макет.ПолучитьОбласть("ПредупреждениеРасчет");

	ОбластьШапкаЗаголовок.Параметры.Заголовок = ЗаголовокЛиста;
	ТабДок.Вывести(ОбластьШапкаЗаголовок);
	
	ТабДок.Вывести(ОбластьРазделитель);
	
	РеквизитыШапки = Новый Соответствие;
	РеквизитыШапки.Вставить("Ожидаемое время доставки", 			Формат(Сообщение.ДатаПоставки, "ДФ=""дд.ММ.гггг ЧЧ:мм"""));
	РеквизитыШапки.Вставить("Время выезда товара от поставщика", 	ДатаВывозаОтПоставщика);
	РеквизитыШапки.Вставить("Договор", 								Договор);
	РеквизитыШапки.Вставить("Промоакция №", 						Сообщение.ПромоНомер);
	РеквизитыШапки.Вставить("Тип поставки", 						Товары[0].ТипПоставки);
	РеквизитыШапки.Вставить("Способ доставки", 						ПолучитьПредставлениеПеречисленияEDI(Сообщение.ОтветственныйЗаДоставку, "СпособДоставки"));
	РеквизитыШапки.Вставить("Комментарий", 							СтрЗаменить(Сообщение.Комментарий, "Загружен из EDI", ""));
	РеквизитыШапки.Вставить("Контакты", 							Контакты);
	
	Для каждого Реквизит Из РеквизитыШапки Цикл
		Если ЗначениеЗаполнено(Реквизит.Значение) Тогда
         	ОбластьШапкаРеквизит.Параметры.Представление 	= Реквизит.Ключ + ":";
         	ОбластьШапкаРеквизит.Параметры.Значение 		= Реквизит.Значение;
			ТабДок.Вывести(ОбластьШапкаРеквизит);
		КонецЕсли;
	КонецЦикла;
	
	//выведем врата времени X5 если они были
	ДатаВремяПрибытия = Сообщение.Транспортировка.ДатаВремяПрибытия;
	ВремяНачалаПогрузки = Сообщение.Транспортировка.ВремяНачалаПогрузки;
	ВремяОкончанияПогрузки = Сообщение.Транспортировка.ВремяОкончанияПогрузки;
	
	ЕстьДатаВремяПрибытия = ЗначениеЗаполнено(ДатаВремяПрибытия);
	ЕстьВремяПогрузки = ЗначениеЗаполнено(ВремяНачалаПогрузки) ИЛИ ЗначениеЗаполнено(ВремяОкончанияПогрузки);
	
	КоличествоСтрок = Макс(ДатаВремяПрибытия.Количество(), ВремяНачалаПогрузки.Количество(), ВремяОкончанияПогрузки.Количество());
	Если НЕ КоличествоСтрок = 0 Тогда
		ТабДок.Вывести(ОбластьРазделитель);
		
		Если ЕстьДатаВремяПрибытия Тогда
			ТабДок.Вывести(ОбластьЗаголовокВрата);
			Если ЕстьВремяПогрузки Тогда
				ТабДок.Присоединить(ОбластьЗаголовокВремяПогрузки);	
			КонецЕсли;
		Иначе
			ТабДок.Вывести(ОбластьЗаголовокВремяПогрузки);	
		КонецЕсли;
		
		ТабВремя = Новый ТаблицаЗначений;
		ДобавитьКолонкиВТаблицуЗначений(ТабВремя, "ДатаВремяПрибытия,ВремяНачалаПогрузки,ВремяОкончанияПогрузки");
		Для Сч = 1 По КоличествоСтрок Цикл
			ТабВремя.Добавить();	
		КонецЦикла;
		ТабВремя.ЗагрузитьКолонку(ДатаВремяПрибытия.ВыгрузитьЗначения(), "ДатаВремяПрибытия");
		ТабВремя.ЗагрузитьКолонку(ВремяНачалаПогрузки.ВыгрузитьЗначения(), "ВремяНачалаПогрузки");
		ТабВремя.ЗагрузитьКолонку(ВремяОкончанияПогрузки.ВыгрузитьЗначения(), "ВремяОкончанияПогрузки");
		
		Для каждого Строка Из ТабВремя Цикл
			Если ЗначениеЗаполнено(Строка.ДатаВремяПрибытия) Тогда
				ОбластьСтрокаВрата.Параметры.ДатаВремяПрибытия = ДатаXML_в_ДатаВремя1С(Строка.ДатаВремяПрибытия);
			Иначе
				ОбластьСтрокаВрата.Параметры.ДатаВремяПрибытия = Неопределено;
			КонецЕсли;
			ОбластьСтрокаВремяПогрузки.Параметры.ВремяНачалаПогрузки = Строка.ВремяНачалаПогрузки;
			ОбластьСтрокаВремяПогрузки.Параметры.ВремяОкончанияПогрузки = Строка.ВремяОкончанияПогрузки;
			
			Если ЕстьДатаВремяПрибытия Тогда
				ТабДок.Вывести(ОбластьСтрокаВрата);
				Если ЕстьВремяПогрузки Тогда
					ТабДок.Присоединить(ОбластьСтрокаВремяПогрузки);	
				КонецЕсли;
			Иначе
				ТабДок.Вывести(ОбластьСтрокаВремяПогрузки);	
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	ТабДок.Вывести(ОбластьРазделитель);
	ТабДок.Вывести(ОбластьЗаголовокРеквизиты);

	СписокПолейРеквизитов = "ПокупательEDI,ГрузополучательEDI,ПлательщикEDI,ПродавецEDI,ГрузоотправительEDI,КонечныйГрузополучательEDI";
	МассивПолейРеквизитов = EDI_РазложитьСтрокуВМассивСлов(СписокПолейРеквизитов, ",");

	Для каждого ИмяРеквизита Из МассивПолейРеквизитов Цикл
		
		// не будем выводить пустые реквизиты шапки
		Если НЕ (ЗначениеЗаполнено(Сообщение[ИмяРеквизита].ИНН)
			ИЛИ ЗначениеЗаполнено(Сообщение[ИмяРеквизита].GLN)
			ИЛИ ЗначениеЗаполнено(Сообщение[ИмяРеквизита].Наименование)) Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПоля = СтрЗаменить(ИмяРеквизита, "EDI", "");
		Если ИмяПоля = "КонечныйГрузополучатель" Тогда
			ОбластьРеквизиты.Параметры.ИмяПоля 			= "Конечный грузополучатель";
		Иначе			
			ОбластьРеквизиты.Параметры.ИмяПоля 			= ИмяПоля;
		КонецЕсли;
		
		Если Сообщение[ИмяРеквизита].Вид = "ФизЛицо" Тогда
			
			Наименование = КонтурСтандарт_СтрШаблон_("%1 %2 %3", 
													 Сообщение[ИмяРеквизита].Фамилия, 
													 Сообщение[ИмяРеквизита].Имя, 
													 Сообщение[ИмяРеквизита].Отчество);
			
		Иначе
			Наименование = Сообщение[ИмяРеквизита].Наименование;	
		КонецЕсли;
		
		ОбластьРеквизиты.Параметры.Наименование		= Наименование;
		ОбластьРеквизиты.Параметры.Адрес        	= ПолучитьПредставлениеАдресаEDI(Сообщение[ИмяРеквизита].Адрес);
		ИННКПП = "";
		
		Если ЗначениеЗаполнено(Сообщение[ИмяРеквизита].ИНН) Тогда
			ИННКПП = Сообщение[ИмяРеквизита].ИНН;
			Если ЗначениеЗаполнено(Сообщение[ИмяРеквизита].КПП) Тогда
				ИННКПП = ИННКПП + "-" + Сообщение[ИмяРеквизита].КПП;
			КонецЕсли;
		КонецЕсли;
		
		ОбластьРеквизиты.Параметры.ИННКПП	= ИННКПП;
		ОбластьРеквизиты.Параметры.GLN		= Сообщение[ИмяРеквизита].GLN;
		ТабДок.Вывести(ОбластьРеквизиты);
		
	КонецЦикла;
	
	ТабДок.Вывести(ОбластьРазделитель);
	ТабДок.Вывести(ОбластьЗаголовокТаблицы);
	
	СписокЕИ = Новый СписокЗначений;
	СписокЕИ.Добавить("PCE", "шт");
	СписокЕИ.Добавить("KGM", "кг");
	СписокЕИ.Добавить("CT",  "упак");
	СписокЕИ.Добавить("PA",  "упак");
	НомСтр = 0;
	ИтогоКоличество	 	= 0;
    ЕстьРасчетныеПоля 	= Ложь;
	
	Для Каждого Товар Из Товары Цикл
		НомСтр = НомСтр + 1;
		ОбластьСтрокаТаблицы.Параметры.НомерСтроки 	= НомСтр;
		ОбластьСтрокаТаблицы.Параметры.Штрихкод	 	= Товар.GTIN;
		//Наименование товара может не передаваться в сообщении
		ОбластьСтрокаТаблицы.Параметры.Наименование = ?(ЗначениеЗаполнено(Товар.Наименование), 
														Строка(Товар.Наименование), 
														Строка(Товар.Номенклатура));
		ОбластьСтрокаТаблицы.Параметры.КодСети 					= Товар.КодТовараПокупателя;	
		ОбластьСтрокаТаблицы.Параметры.Артикул 					= Товар.КодТовараПоставщика;	
		ОбластьСтрокаТаблицы.Параметры.Количество 				= Товар.Количество;	
		ОбластьСтрокаТаблицы.Параметры.КоличествоВОдномМесте 	= ?(ЗначениеЗаполнено(Товар.КоличествоВОдномМесте), 
																	Товар.КоличествоВОдномМесте, 
																	"");	
		Если СписокЕИ.НайтиПоЗначению(Товар.КодЕдиницыИзмеренияEDI) <> Неопределено Тогда
			ОбластьСтрокаТаблицы.Параметры.ЕдиницаИзмерения = СписокЕИ.НайтиПоЗначению(Товар.КодЕдиницыИзмеренияEDI).Представление;
		Иначе 
			ОбластьСтрокаТаблицы.Параметры.ЕдиницаИзмерения = Товар.КодЕдиницыИзмеренияEDI;
		КонецЕсли;
		ОбластьСтрокаТаблицы.Параметры.СтавкаНДС = ?(ЗначениеЗаполнено(Товар.СтавкаНДСEDI), Товар.СтавкаНДСEDI+"%", "");
		ТабДок.Вывести(ОбластьСтрокаТаблицы);
	
		СписокПолей 	= "ЦенаБезНДС,ЦенаСНДС,СуммаБезНДС,СуммаНДС,СуммаСНДС";
		МассивПолей 	= EDI_РазложитьСтрокуВМассивСлов(СписокПолей, ",");
		РасчетныеПоля 	= ОпределитьРасчетныеПоляСтрокиТоваров(Товар, МассивПолей);
		Если РасчетныеПоля.Количество() > 0 Тогда
			ЗаполнитьНедостающиеПоляСтрокиТоваров(Товар);
			ЕстьРасчетныеПоля = Истина;
		КонецЕсли;
		Для каждого Поле Из МассивПолей Цикл
			Если РасчетныеПоля.Найти(Поле) = Неопределено Тогда
				ЯчейкаОбычноеПоле.Параметры.ОбычноеПоле = Товар[Поле];
				ТабДок.Присоединить(ЯчейкаОбычноеПоле);
			Иначе
				ЯчейкаРасчетноеПоле.Параметры.РасчетноеПоле = Товар[Поле];
				ТабДок.Присоединить(ЯчейкаРасчетноеПоле);
			КонецЕсли;
		КонецЦикла;
		
		ИтогоКоличество	= ИтогоКоличество + Товар.Количество;
	КонецЦикла;
	
	ОбластьИтого.Параметры.ИтогоКоличество = ИтогоКоличество;
	ТабДок.Вывести(ОбластьИтого);
	
	СписокПолейИтого = "СуммаВсегоБезНДС,СуммаВсегоНДС,СуммаВсего";
	МассивПолейИтого = EDI_РазложитьСтрокуВМассивСлов(СписокПолейИтого, ",");
	Для каждого Поле Из МассивПолейИтого Цикл
		Если ЗначениеЗаполнено(Сообщение[Поле]) Тогда
			ЯчейкаОбычноеПолеИтого.Параметры.ОбычноеПолеИтого = Число(Сообщение[Поле]);
			ТабДок.Присоединить(ЯчейкаОбычноеПолеИтого);
		Иначе
			ЕстьРасчетныеПоля = Истина;
			Если Поле = "СуммаВсегоБезНДС" Тогда
				ИтоговоеПоле = "СуммаБезНДС";
			ИначеЕсли Поле = "СуммаВсегоНДС" Тогда
				ИтоговоеПоле = "СуммаНДС";
			ИначеЕсли Поле = "СуммаВсего" Тогда
				ИтоговоеПоле = "СуммаСНДС";
			КонецЕсли;	
			ЯчейкаРасчетноеПолеИтого.Параметры.РасчетноеПолеИтого = Товары.Итог(ИтоговоеПоле);
			ТабДок.Присоединить(ЯчейкаРасчетноеПолеИтого);
		КонецЕсли;
	КонецЦикла;
	Если ЕстьРасчетныеПоля Тогда
		ТабДок.Вывести(ОбластьРазделитель);
		ТабДок.Вывести(ОбластьПредупреждениеРасчет);
	КонецЕсли;
	
	Возврат ТабДок;

КонецФункции

Функция ОпределитьРасчетныеПоляСтрокиТоваров(СтрокаТовара, МассивПолей)
	
	РасчетныеПоля = Новый Массив;
	
	Для Каждого РасчетноеПоле Из МассивПолей Цикл
		Если СтрокаТовара[РасчетноеПоле] = 0 Тогда 
			РасчетныеПоля.Добавить(РасчетноеПоле);
		КонецЕсли;
	КонецЦикла;
	
	Возврат РасчетныеПоля;	
	
КонецФункции

Функция ОбработатьМассовуюПечатьЗаказов(МассивСообщений) Экспорт
	
	Макет = ПолучитьМакет("ПечатнаяФормаORDERS");	
	ТабДокОбщий = Новый ТабличныйДокумент;
	
	//и установим параметры печати
	ТабДокОбщий.ИмяПараметровПечати 		= "КонтурEDI_ПечатьЗаказов";
	ТабДокОбщий.ИмяСохраненияПоложенияОкна 	= "КонтурEDI_ПечатьЗаказов";
	ТабДокОбщий.ОриентацияСтраницы 			= ОриентацияСтраницы.Ландшафт;
	ТабДокОбщий.ОтображатьСетку 			= Ложь;
	ТабДокОбщий.АвтоМасштаб 				= Истина;
	ТабДокОбщий.РазмерСтраницы 				= "A4";
	ТабДокОбщий.ПолеСверху 					= 20;
	ТабДокОбщий.ПолеСнизу 					= 20;
	ТабДокОбщий.ПолеСлева 					= 5;
	ТабДокОбщий.ПолеСправа 					= 5;
	ТабДокОбщий.РазмерКолонтитулаСверху 	= 0;
	ТабДокОбщий.РазмерКолонтитулаСнизу 		= 0;
	
	Для Каждого ТекСообщение Из МассивСообщений Цикл
		СообщениеORDERS = ПрочитатьСообщение(ТекСообщение);
		ТабДок = ПодготовитьПечатнуюФормуЗаказа(СообщениеORDERS, Макет, ТабДокОбщий);
		ТабДокОбщий.Вывести(ТабДок);
		ТабДокОбщий.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЦикла;
	
	ТабДокОбщий.ВывестиВертикальныйРазделительСтраниц();

	Возврат ТабДокОбщий;
	
КонецФункции

//Печать палетного листа

Функция ОбработатьМассовуюПечатьПалетныхЛистов(МассивСообщенийДляОтбора) Экспорт
	
	Результат = Новый Структура("Успешно, ТабДокОбщий, КоличествоЛистов");
	Успешно = Истина;
	КоличествоЛистов = 0;
	Результат.Вставить("Успешно", Успешно);
	Результат.Вставить("КоличествоЛистов", КоличествоЛистов);
	
	МассивСообщений = Новый Массив;
	
	Для Каждого ТекСообщение Из МассивСообщенийДляОтбора Цикл
		СообщениеСтруктура = ПрочитатьСообщение(ТекСообщение);
		Если СообщениеСтруктура.ТипСообщения = "DESADV" ИЛИ СообщениеСтруктура.ТипСообщения = "INVOIC" Тогда
			Если СообщениеСтруктура.Свойство("ТранспортныеУпаковки")
				И СообщениеСтруктура.ТранспортныеУпаковки.Строки.Количество() > 0 Тогда
				МассивСообщений.Добавить(СообщениеСтруктура);
				КоличествоЛистов = КоличествоЛистов + 1;
			Иначе
				Продолжить;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если КоличествоЛистов = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Компонент = ПолучитьВнешнююКомпонентуКартинкаШтрихкода();
	Если Компонент = Неопределено Тогда
		Результат.Успешно = Ложь;
		Возврат Результат;
	КонецЕсли;
	
	Макет = ПолучитьМакет("ПалетныйЛист");
	
	ТабДокОбщий = Новый ТабличныйДокумент;
	
	// установить параметры печати
	ТабДокОбщий.ИмяПараметровПечати 		= "КонтурEDI_ПечатьПалетныхЛистов";
	ТабДокОбщий.ИмяСохраненияПоложенияОкна 	= "КонтурEDI_ПечатьПалетныхЛистов";
	ТабДокОбщий.ОриентацияСтраницы 			= ОриентацияСтраницы.Портрет;
	ТабДокОбщий.ОтображатьСетку 			= Ложь;
	ТабДокОбщий.АвтоМасштаб 				= Ложь;
	ТабДокОбщий.РазмерСтраницы 				= "A4";
	ТабДокОбщий.ПолеСверху 					= 20;
	ТабДокОбщий.ПолеСнизу 					= 20;
	ТабДокОбщий.ПолеСлева 					= 5;
	ТабДокОбщий.ПолеСправа 					= 5;
	ТабДокОбщий.РазмерКолонтитулаСверху 	= 0;
	ТабДокОбщий.РазмерКолонтитулаСнизу 		= 0;
	
	// вывести в общий таб. док
	Для Каждого СообщениеDESADV Из МассивСообщений Цикл
		
		ТабДок = ПодготовитьПечатнуюФормуПалетногоЛиста(СообщениеDESADV, Макет, Компонент, ТабДокОбщий);
		
		ТабДокОбщий.Вывести(ТабДок);
		
		ТабДокОбщий.ВывестиГоризонтальныйРазделительСтраниц();
		
	КонецЦикла;
	
	ТабДокОбщий.ВывестиВертикальныйРазделительСтраниц();  	
	
	// вставить в результат функции
	Результат.Вставить("ТабДокОбщий", ТабДокОбщий);
    Результат.Вставить("КоличествоЛистов", КоличествоЛистов);

	Возврат Результат;	

КонецФункции // ОбработатьМассовуюПечатьПалетныхЛистов()

Функция ПодготовитьПечатнуюФормуПалетногоЛиста(Знач Сообщение, Знач Макет, Знач Компонент, ТабДокОбщий = Неопределено) Экспорт

	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("Сообщение", Сообщение);
	ПараметрыПМ.Вставить("КомпонентаПечатиШК", Компонент);
	ПараметрыПМ.Вставить("ТабДокОбщий", ТабДокОбщий);
	
	РезультатПМ = ОбработкаСобытияПодключаемогоМодуля("ПодготовитьПечатнуюФормуПалетногоЛиста",, ПараметрыПМ);
	
	Если НЕ РезультатПМ = Неопределено
		И ТипЗнч(РезультатПМ) = Тип("ТабличныйДокумент") Тогда
		Возврат РезультатПМ;
	КонецЕсли;

	СообщениеORDERS = ПрочитатьСообщение(, Сообщение.Заказ1С,"ORDERS", "Входящее");
	
	ДляСетиX5 = (ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, "КодСети") = "x5");
	
	ТабДокумент 				   	= Новый ТабличныйДокумент;
	ТабДокумент.ОриентацияСтраницы 	= ОриентацияСтраницы.Портрет;
	
	//грузополучатель
	Грузополучатель  					= НайтиОбъектПоЗначениюСвойства("GLN_ТочкиДоставки", Сообщение.ГрузополучательEDI.GLN);
	ГрузополучательНаименование			= "";
	ГрузополучательАдрес				= "";
	Если ЗначениеЗаполнено(Грузополучатель) Тогда
		Попытка
			ГрузополучательНаименование 	= Грузополучатель.Наименование;
			ГрузополучательАдрес  			= Грузополучатель.АдресДоставки;
		Исключение
			СообщениеОшибки = "Не удалось получить адрес и наименование грузополучателя по свойству GLN_ТочкиДоставки - " + ОписаниеОшибки();
			ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, СообщениеОшибки);		
		КонецПопытки;
	КонецЕсли;
	
	КонечныйГрузополучатель			= Неопределено;

	Если ТипЗнч(СообщениеORDERS) = Тип("Структура") 
		И СообщениеORDERS.Свойство("КонечныйГрузополучательEDI") 
		И СообщениеORDERS.КонечныйГрузополучательEDI.Свойство("Наименование") 
		И ЗначениеЗаполнено(СообщениеORDERS.КонечныйГрузополучательEDI.Наименование)  Тогда
		
		КонечныйГрузополучатель = СообщениеORDERS.КонечныйГрузополучательEDI;
		
		ЗаказчикНаименование	= СообщениеORDERS.КонечныйГрузополучательEDI.Наименование;
		ЗаказчикАдрес			= "";		
		
		Если СообщениеORDERS.КонечныйГрузополучательEDI.Свойство("Адрес") Тогда
			
			Если ТипЗнч(СообщениеORDERS.КонечныйГрузополучательEDI.Адрес) = Тип("Строка") Тогда
				
				ЗаказчикАдрес	= СообщениеORDERS.КонечныйГрузополучательEDI.Адрес;
				
			ИначеЕсли ТипЗнч(СообщениеORDERS.КонечныйГрузополучательEDI.Адрес) = Тип("Структура") Тогда
				
				Для Каждого ЭлементАдреса Из СообщениеORDERS.КонечныйГрузополучательEDI.Адрес Цикл
					Если ЗначениеЗаполнено(ЭлементАдреса.Значение) И НЕ ЭлементАдреса.Ключ = "ВидАдреса" Тогда
						ЗаказчикАдрес = ЗаказчикАдрес + ", " + ЭлементАдреса.Значение;
					КонецЕсли;
				КонецЦикла;
				
				Если Лев(ЗаказчикАдрес,2) = ", " Тогда
					ЗаказчикАдрес = Сред(ЗаказчикАдрес,3);
				КонецЕсли;
								
			КонецЕсли;
			
		КонецЕсли;
				
	ИначеЕсли Сообщение.Свойство("КонечныйГрузополучательEDI") И ЗначениеЗаполнено(Сообщение.КонечныйГрузополучательEDI.GLN) Тогда
		
		КонечныйГрузополучатель	= НайтиОбъектПоЗначениюСвойства("GLN_ТочкиДоставки",Сообщение.КонечныйГрузополучательEDI.GLN);
		
		Если ТипЗнч(КонечныйГрузополучатель) <> Тип("СправочникСсылка.КонтурEDI_ТочкиДоставки") Тогда
			КонечныйГрузополучатель = Неопределено;
		Иначе
			ЗаказчикНаименование	= КонечныйГрузополучатель.Наименование;
			ЗаказчикАдрес			= КонечныйГрузополучатель.АдресДоставки;
		КонецЕсли;
		
	КонецЕсли;  
	
	Если Не ЗначениеЗаполнено(КонечныйГрузополучатель) Тогда
		
		//покупатель
		Если ЗначениеЗаполнено(СообщениеORDERS) Тогда
			ЗаказчикНаименование	= СообщениеORDERS.ПокупательEDI.Наименование;
			ЗаказчикАдрес			= ПолучитьПредставлениеАдресаEDI(СообщениеORDERS.ПокупательEDI.Адрес);
		Иначе
			СведенияОПокупателе 	= ПолучитьСведенияОЮрФизЛице_Контур(Сообщение.Покупатель1С);
			ЗаказчикНаименование 	= ПолучитьОписаниеОрганизации_Контур(СведенияОПокупателе, "ПолноеНаименование");
			ЗаказчикАдрес			= ПолучитьОписаниеОрганизации_Контур(СведенияОПокупателе, "ЮридическийАдрес");
		КонецЕсли;
		
	КонецЕсли;

	//поставщик
	НомерПоставщика						= "";
	СведенияОПоставщике					= ПолучитьСведенияОЮрФизЛице_Контур(Сообщение.Продавец1С);
	ПоставщикНаименование               = ПолучитьОписаниеОрганизации_Контур(СведенияОПоставщике, "ПолноеНаименование");
	Если ЗначениеЗаполнено(СообщениеORDERS) Тогда
		НомерПоставщика					= СообщениеORDERS.ПродавецEDI.КодВСистемеПокупателя;
	КонецЕсли;
	НомерЗаказа							= Сообщение.ЗаказEDI.Номер;
	ПлановаяДатаПоступления				= Сообщение.ДатаПоставки;
	
	//для X5
	ЕстьКолонкаДатаПроизводства = (НЕ Сообщение.Товары.Колонки.Найти("ДатаПроизводства") = Неопределено);			
	
	//sscc
	ВсегоУпаковок = Сообщение.ТранспортныеУпаковки.Строки.Количество();
	
	ПорядковыйНомерУпаковки = 1;
	СписокЕИ = Новый СписокЗначений;
	СписокЕИ.Добавить("PCE", "Штука");
	СписокЕИ.Добавить("KGM", "Килограмм");
	СписокЕИ.Добавить("CT",  "Коробка");
	СписокЕИ.Добавить("PA",  "Упаковка");	
	
	Для Каждого Упаковка Из Сообщение.Транспортныеупаковки.Строки Цикл
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
		ОбластьМакета.Параметры.ГрузополучательНаименование	= ГрузополучательНаименование;
		ОбластьМакета.Параметры.ГрузополучательАдрес 		= ГрузополучательАдрес;
		
		ОбластьМакета.Параметры.ЗаказчикНаименование 		= ЗаказчикНаименование;
		ОбластьМакета.Параметры.ЗаказчикАдрес 				= ЗаказчикАдрес;
		
		ОбластьМакета.Параметры.НомерПоставщика 			= НомерПоставщика;
		ОбластьМакета.Параметры.НомерЗаказа 				= НомерЗаказа;
		ОбластьМакета.Параметры.ПлановаяДатаПоступления 	= ПлановаяДатаПоступления;
		ОбластьМакета.Параметры.ПоставщикНаименование 		= ПоставщикНаименование;
		ТабДокумент.Вывести(ОбластьМакета);
		
		ОбластьМакета = Макет.ПолучитьОбласть("SSCC");
		ОбластьМакета.Параметры.SSCC 					= Упаковка.SSCC;
		КартинкаSSCCКода 								= ПолучитьКартинкуШтрихкода_КонтурEDI(Компонент, Упаковка.SSCC);
		Если Не КартинкаSSCCКода = Неопределено Тогда
			Рисунок = ОбластьМакета.Область("Картинка");
			Рисунок.Картинка = КартинкаSSCCКода;
		КонецЕсли;
		ТабДокумент.Вывести(ОбластьМакета);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
		ОбластьМакета.Параметры.НомерТекущейУпаковки	= ПорядковыйНомерУпаковки;
		ОбластьМакета.Параметры.ВсегоУпаковок			= ВсегоУпаковок;
		ТабДокумент.Вывести(ОбластьМакета);
		
		Если ДляСетиX5 Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("СоставШапкаДляX5");
		Иначе
			ОбластьМакета = Макет.ПолучитьОбласть("СоставШапка");
		КонецЕсли;
		
		ТабДокумент.Вывести(ОбластьМакета);
		ПорядковыйНомерТовара = 1;
		
		ВременнаяТЗ = Новый ТаблицаЗначений;
		
		ДобавитьКолонкиВТаблицуЗначений(ВременнаяТЗ, "ДатаПроизводства,НомерСтроки,КодТовараПокупателя,НаименованиеТовара,ЕдиницаИзмеренияПредставление,Количество");
		
		Для Каждого Товар Из Упаковка.Строки Цикл
			
			СтрокаВСообщении 			= Сообщение.Товары[Товар.НомерСтроки-1];
			НаименованиеНоменклатуры 	= ?(ЗначениеЗаполнено(СтрокаВСообщении.Номенклатура),Строка(СтрокаВСообщении.Номенклатура),СтрокаВСообщении.Наименование);
			НаименованиеХарактеристики	= Строка(СтрокаВСообщении.ХарактеристикаНоменклатуры);
			НаименованиеТовара			= НаименованиеНоменклатуры + ?(ЗначениеЗаполнено(НаименованиеХарактеристики), "("+НаименованиеХарактеристики+")", "");
			КодТовараПокупателя 		= СтрокаВСообщении.КодТовараПокупателя;
			ЕдиницаИзмерения 			= СтрокаВСообщении.КодЕдиницыИзмеренияEDI;
			ЕдиницаИзмеренияПредставление = "";
			НайденнаяЕИ 				= СписокЕИ.НайтиПоЗначению(ЕдиницаИзмерения);
			Если НайденнаяЕИ <> Неопределено Тогда
				ЕдиницаИзмеренияПредставление = НайденнаяЕИ.Представление;
			КонецЕсли;
			
			НоваяСтрока = ВременнаяТЗ.Добавить();
			
			Если ЕстьКолонкаДатаПроизводства 
				И ЗначениеЗаполнено(СтрокаВСообщении.ДатаПроизводства) Тогда			
				НоваяСтрока.ДатаПроизводства = СтрокаВСообщении.ДатаПроизводства;
			КонецЕсли;
			
			НоваяСтрока.НомерСтроки = ПорядковыйНомерТовара;
			НоваяСтрока.КодТовараПокупателя = КодТовараПокупателя;
			НоваяСтрока.НаименованиеТовара = НаименованиеТовара;
			НоваяСтрока.ЕдиницаИзмеренияПредставление = ЕдиницаИзмеренияПредставление;
			НоваяСтрока.Количество = Товар.Количество;
			
			ПорядковыйНомерТовара = ПорядковыйНомерТовара + 1;
			
		КонецЦикла;
		
		ВременнаяТЗ.Свернуть("ДатаПроизводства,КодТовараПокупателя,НаименованиеТовара,ЕдиницаИзмеренияПредставление","Количество"); 
		
		НомерСтроки = 1;
		
		Для каждого Строка из ВременнаяТЗ Цикл
			
			Если ДляСетиX5 Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("СоставДанныеДляX5");
			Иначе
				ОбластьМакета = Макет.ПолучитьОбласть("СоставДанные");					
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, Строка);
			ОбластьМакета.Параметры.НомерСтроки = НомерСтроки ;
			
			ТабДокумент.Вывести(ОбластьМакета);	
			НомерСтроки = НомерСтроки + 1;
		КонецЦИкла;
		
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ПорядковыйНомерУпаковки = ПорядковыйНомерУпаковки + 1;
		
	КонецЦикла;
	
	Возврат ТабДокумент;	

КонецФункции // ПодготовитьПечатнуюФормуПалетногоЛиста()

Функция ПолучитьВнешнююКомпонентуКартинкаШтрихкода() Экспорт
	
	Попытка
		ВнешняяКомпонента = Новый("AddIn.КартинкаШтрихкода.Barcode");
		Возврат ВнешняяКомпонента;
	Исключение
		СообщениеОшибки = "Не удалось инициализировать компоненту для формирования картинки штрихкода, попытка подключения... " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Информация, СообщениеОшибки);	
	КонецПопытки;
	
	МестоположенияКомпоненты = Новый Массив; 
	
	Если ЕстьНеобходимыеМетаданные("ОбщиеМакеты.КомпонентаПечатиШтрихкодов") Тогда
		
		МестоположенияКомпоненты.Добавить("ОбщийМакет.КомпонентаПечатиШтрихкодов");
		
	КонецЕсли;
	
	Макет = ПолучитьМакет_КонтурEDI("barcode", "zip", Ложь, Истина, Ложь, Истина);  	
	МестоположенияКомпоненты.Добавить(ПоместитьВоВременноеХранилище(Макет));
	
	ВнешняяКомпонента = Неопределено;
	
	Для Каждого МестоположениеКомпоненты Из МестоположенияКомпоненты Цикл
		
		ПодключениеВыполнено = ПодключитьВнешнююКомпоненту_КонтурEDI("КартинкаШтрихкода", МестоположениеКомпоненты,  "Native");
		
		Если ПодключениеВыполнено Тогда
			ВнешняяКомпонента = Новый("AddIn.КартинкаШтрихкода.Barcode");
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ВнешняяКомпонента = Неопределено Тогда
		Сообщить_КонтурEDI("Не удалось подключить компоненту для формирования картинки штрихкода");
	КонецЕсли;
	
	Возврат ВнешняяКомпонента;
	
КонецФункции 

Функция ПолучитьКартинкуШтрихкода_КонтурEDI(Компонент, ШтрихКод) Экспорт
		
	Если НЕ Компонент.ГрафикаУстановлена Тогда
		Возврат Неопределено;
    КонецЕсли;

	Если Компонент.НайтиШрифт("Tahoma") = Истина Тогда
		Компонент.Шрифт = "Tahoma";
   	Иначе
		Для Сч = 0 По Компонент.КоличествоШрифтов -1 Цикл
        	ТекущийШрифт = Компонент.ШрифтПоИндексу(Сч);
            Если ТекущийШрифт <> Неопределено Тогда
                Компонент.Шрифт = ТекущийШрифт;
				Прервать;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
 
	Компонент.РазмерШрифта = 12;
	Компонент.ОтображатьТекст = Ложь;

	Компонент.Ширина = 100;
	Компонент.Высота = 90;

	Компонент.АвтоТип = Ложь;
	Компонент.ТипКода = 4;
	
	Компонент.СодержитКС = СтрДлина(ШтрихКод) = 18;

	Компонент.ЗначениеКода = ШтрихКод;

	Если Компонент.Ширина < Компонент.МинимальнаяШиринаКода Тогда
    	Компонент.Ширина = Компонент.МинимальнаяШиринаКода + 10;
    КонецЕсли;
 
	ДвоичныеДанныеКартинки = Компонент.ПолучитьШтрихкод();
 
	Если НЕ ДвоичныеДанныеКартинки = Неопределено Тогда
        Возврат Новый Картинка(ДвоичныеДанныеКартинки);
    КонецЕсли;

	Возврат Неопределено;	
	
КонецФункции // ПолучитьКартинкуШтрихкода_КонтурEDI()

