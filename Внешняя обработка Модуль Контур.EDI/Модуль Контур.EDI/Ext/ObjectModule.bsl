Функция ИнициализироватьПодключаемыеМодули() Экспорт
	
	РезультатИнициализации = Новый Структура();
	РезультатИнициализации.Вставить("Успешно");
	РезультатИнициализации.Вставить("ТекстОшибки");
	РезультатИнициализации.Вставить("НужноОбновитьКонфигурацию");
	
	ОчиститьОбщийКаталогВременныхФайлов_КонтурEDI();
	мРабочийКаталог = КаталогВременныхФайлов_КонтурEDI();
	
	Адрес_edi_kontur_ru 		= "edi.kontur.ru";
	КаталогОбновленийНаСервере 	= "/1c/KonturEDI_82/releases/";
	
	// 1. определяем вариант хранения данных
	//
	Если ДобавленыСвоиОбъектыВКонфигурацию() Тогда
		ВариантХраненияДанных = "СвоиОбъекты";
		ВнешнееХранилище = Ложь;
	Иначе
		ПопытатьсяПодключитьсяКВнешнемуХранилищу();//добавленные объекты считаем более приоритетными. Если их нет, то тогда подключаемся к ВХ
		ВариантХраненияДанных = "";
	КонецЕсли;
		
	Если НЕ ВнешнееХранилище = Истина И НЕ ВариантХраненияДанных = "СвоиОбъекты" Тогда

		РезультатИнициализации.Успешно		= Ложь;
		РезультатИнициализации.ТекстОшибки = "Не выбран режим хранения данных модуля";
		
		Возврат РезультатИнициализации;
		
	КонецЕсли;
	
	// 2. Проверим наличие всех необходимых реквизитов в наших справочниках: пока частично
	
	РезультатПроверкиМетаданных = ПроверитьКорректностьИДоступностьМетаданных();//проверка конфигурации, необходимых реквизитов наших справочников, прав доступа
	
	Если НЕ РезультатПроверкиМетаданных.Успешно Тогда
		
		РезультатИнициализации.Успешно = Ложь;
		РезультатИнициализации.ТекстОшибки = РезультатПроверкиМетаданных.ТекстОшибки;
		
		Возврат РезультатИнициализации;
		
	КонецЕсли;
		
	// 3. Проверяем имя конфигурации. Если не заполнено, основной интерфейс выдаст пользователю окно с выбором наиболее подходящей
	
	ОпределитьКонфигурацию();
	
	Если НЕ ЗначениеЗаполнено(ИмяКонфигурации1С) Тогда
		
		РезультатИнициализации.Успешно = Ложь;
		РезультатИнициализации.ТекстОшибки = "Не определена конфигурация";//список поддерживаемых конфигураций расположен в отдельном окне: ФормаСервис_ВыборКонфигурации

		Возврат РезультатИнициализации;
		
	КонецЕсли;
	
	// 4. Все проверки пройдены, начинаем собственно инициализацию.
	
	ОбновитьКэшИсполняемогоКодаРасширений();
	
    // перенес, чтобы при инициализации подключаемого модуля можно было изменить параметр ЕстьКоррИспрСФ, необходимо если COINVOIC 
	// будет формироваться по данным из другой БД
	ЕстьКоррИспрСФ = ЕстьКорректировочныйИсправительныйСчетФактура();
	
	НастройкиПодключаемогоМодуля = ПолучитьСписокСвойствEDI(
		"ПодключаемыйМодульТип
		|ПодключаемыйМодульПуть
		|ПодключаемыйМодульИмяОбработки
		|ПодключаемыйМодульВидСправочника
		|ПодключаемыйМодульGUID
		|ПодключаемыйМодульСсылка");

	ИнициализироватьВнешнийПодключаемыйМодуль();
		
	ИспользоватьКонтурPlugin = ИспользоватьКонтурPlugin(); 
	
	ОбновитьТаблицуТиповЗначенияОбъектов();	
	
	НастройкиМодуля = ПолучитьНастройкиМодуля();
		
	ИнициализироватьТаблицуОсобенностейСообщений();
			
	ИспользоватьМаппингМетаданных = (ПолучитьКонстантуEDI("ИспользоватьМаппингМетаданных")=Истина);
	Если ИспользоватьМаппингМетаданных Тогда 
		МаппингМетаданных = ПолучитьМаппингМетаданных();
		Сообщить_КонтурEDI("Используется маппинг объектов.");
	КонецЕсли;
	
	ПараметрыПользователяEDI = ПолучитьПараметрыТекущегоПользователяEDI();

	ОбновитьКэшПартнеров();
	
	// РаботаССерверомДиадок - остается пока только для Отчета по сверке СФ
		//инициализируем глобальные переменные для работы с API Диадока
	РаботаССерверомДиадок = Новый Структура();
	РаботаССерверомДиадок.Вставить("Используется",Ложь);
	РаботаССерверомДиадок.Вставить("АПИ");
	РаботаССерверомДиадок.Вставить("Соединение");
	
	РезультатИнициализации.Успешно = Истина;
	
	Возврат РезультатИнициализации;
	
КонецФункции

Функция ОбщийКаталогВременныхФайлов_КонтурEDI()
	
	ОбщийКаталогВременныхФайловКонтурEDI = КаталогВременныхФайлов() + "КонтурEDI\";
	ОбщийКаталогВременныхФайловКонтурEDI_Файл = Новый Файл(ОбщийКаталогВременныхФайловКонтурEDI);
	
	Если НЕ ОбщийКаталогВременныхФайловКонтурEDI_Файл.Существует() Тогда
		СоздатьКаталог(ОбщийКаталогВременныхФайловКонтурEDI);
	КонецЕсли;
	
	Возврат ОбщийКаталогВременныхФайловКонтурEDI;
	
КонецФункции

Функция КаталогВременныхФайлов_КонтурEDI()
		
	ОбщийКаталогВременныхФайловКонтурEDI = ОбщийКаталогВременныхФайлов_КонтурEDI();
	ОбщийКаталогВременныхФайловКонтурEDI_Файл = Новый Файл(ОбщийКаталогВременныхФайловКонтурEDI);
	
	Если НЕ ОбщийКаталогВременныхФайловКонтурEDI_Файл.Существует() Тогда
		СоздатьКаталог(ОбщийКаталогВременныхФайловКонтурEDI_Файл);
	КонецЕсли;
	
	КаталогВременныхФайловСеансаКонтурEDI = ОбщийКаталогВременныхФайловКонтурEDI + Строка(Новый УникальныйИдентификатор) + "\";
	КаталогВременныхФайловСеансаКонтурEDI_Файл = Новый Файл(КаталогВременныхФайловСеансаКонтурEDI);
	
	Если НЕ КаталогВременныхФайловСеансаКонтурEDI_Файл.Существует() Тогда
		СоздатьКаталог(КаталогВременныхФайловСеансаКонтурEDI);
	КонецЕсли;
	
	Возврат КаталогВременныхФайловСеансаКонтурEDI;
	
КонецФункции                        

Процедура ОчиститьКаталогВременныхФайлов_КонтурEDI()
	                                                              
	РабочийКаталог_Файл = Новый Файл(мРабочийКаталог);
	
	Если РабочийКаталог_Файл.Существует() Тогда
		Попытка
			УдалитьФайлы(мРабочийКаталог);
		Исключение
			ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Предупреждение, "Не удалось очистить каталог временных файлов - " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОчиститьОбщийКаталогВременныхФайлов_КонтурEDI()
				
	КаталогиВременныхФайловСеансов = НайтиФайлы(ОбщийКаталогВременныхФайлов_КонтурEDI(), "*");
	ТриДняНазад = ТекущаяДатаСеанса() - (3 * 24 * 3600);
	
	Для Каждого КаталогСеанса Из КаталогиВременныхФайловСеансов Цикл
		
		Попытка
			Если КаталогСеанса.ПолучитьВремяИзменения() > ТриДняНазад Тогда
				Продолжить;
			КонецЕсли;
			УдалитьФайлы(КаталогСеанса.ПолноеИмя);
		Исключение
			СообщениеЖР = "Не удалось очистить каталог временных файлов " + КаталогСеанса.ПолноеИмя + " - " + ОписаниеОшибки();
			ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Предупреждение, СообщениеЖР);
		КонецПопытки;

	КонецЦикла;
	
КонецПроцедуры

Функция ИнициализироватьПараметрыКлиентСервер(ОсновнаяФорма = Неопределено) Экспорт

	ПараметрыКлиентСервер = Новый Структура;
	
	// Константы
	ПараметрыКлиентСервер.Вставить("АдресаВХ");
	ПараметрыКлиентСервер.Вставить("URLАдреса");
	ПараметрыКлиентСервер.Вставить("ОписаниеВерсии");
	ПараметрыКлиентСервер.Вставить("НомерРелизаМодуля");
	ПараметрыКлиентСервер.Вставить("ИмяКонфигурации1С");
	ПараметрыКлиентСервер.Вставить("МодальностьЗапрещена");
	ПараметрыКлиентСервер.Вставить("ПутьКФормам");
	ПараметрыКлиентСервер.Вставить("IDОсновнойФормы");
	ПараметрыКлиентСервер.Вставить("КоличествоДнейВОсновномСпискеПриОткрытии");
	ПараметрыКлиентСервер.Вставить("КлючиAPI");
	ПараметрыКлиентСервер.Вставить("ЗаписыватьОшибкиВЖурналРегистрации");
	ПараметрыКлиентСервер.Вставить("ИспользуемоеИмяФайла");
	ПараметрыКлиентСервер.Вставить("РежимИспользованияОбработки");
	ПараметрыКлиентСервер.Вставить("ДоменПользователяКонтур");
	ПараметрыКлиентСервер.Вставить("ТипИспользуемыхФорм");
	ПараметрыКлиентСервер.Вставить("ВерсияПлатформы1С");
	ПараметрыКлиентСервер.Вставить("СинонимМодуля");
	ПараметрыКлиентСервер.Вставить("ИмяПродукта");
	ПараметрыКлиентСервер.Вставить("ИдентификаторБазы");
	ПараметрыКлиентСервер.Вставить("ТекущийВариантИнтерфейса");
	ПараметрыКлиентСервер.Вставить("ДоступенПоискФормПоID");
	
	// Могут переинициализироваться в процессе работы
	ПараметрыКлиентСервер.Вставить("КэшироватьОбработкуОбъект"); //TODO прямо сейчас не переинициализируется
		
	УникальныйИдентификатор	= ПолучитьУникальныйИдентификаторДляВХ(ОсновнаяФорма);
	
	АдресаВХ = Новый Структура;
	АдресаВХ.Вставить("Диадок_Токены",							ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор));   //Соответствие: "отпечаток-токен" или "логин-токен"
	АдресаВХ.Вставить("Диадок_Соединение",						ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор));	//COM-объект
	АдресаВХ.Вставить("Диадок_НастройкиДоступа",				ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор));	//Соответствие: организация - данные авторизации
	АдресаВХ.Вставить("Диадок_МассивСообщенийДляПодписания",	ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор));	//ДеревоЗначений: результат валидации подписываемого документа
	АдресаВХ.Вставить("Диадок_ТабСФДляОтправкиИзвещений",		ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор));	//Таблица значений
		
	АдресаВХ.Вставить("ОбработкаОбъект",						ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор));	//Структура с одним элементом: ключ = "ОбработкаОбъект", значение = объект [Внешняя]ОбработкаОбъект.КонтурEDI
	АдресаВХ.Вставить("ОбработкаОбъектДвоичныеДанные",			ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор));	// Двоичные данные обработки файла модуля с клиента (УФ)
	АдресаВХ.Вставить("ХранилищеСертификатов",					ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор));	//COM-объект
	АдресаВХ.Вставить("ТаблицыЗначений",						ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор));	//Структура: имя таблицы значений - таблица значений
	
	// Соответствие: УведомленияEDI которые не нужно показывать повторно
	АдресаВХ.Вставить("СкрытыеУведомленияСеанса",				ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор));
	
	ПараметрыКлиентСервер.АдресаВХ					= АдресаВХ;
	ПараметрыКлиентСервер.URLАдреса					= URLАдреса_КонтурEDI();
	ПараметрыКлиентСервер.ОписаниеВерсии			= ОписаниеВерсии_КонтурEDI();
	ПараметрыКлиентСервер.ИмяКонфигурации1С			= ОпределитьКонфигурацию();
	ПараметрыКлиентСервер.МодальностьЗапрещена		= МодальностьЗапрещена();
	ПараметрыКлиентСервер.ПутьКФормам				= Метаданные().ПолноеИмя() + ".Форма.";
	ПараметрыКлиентСервер.IDОсновнойФормы           = УникальныйИдентификатор;
	ПараметрыКлиентСервер.КлючиAPI					= КлючиAPI_КонтурEDI();
	ПараметрыКлиентСервер.КэшироватьОбработкуОбъект	= ДоступноКэшированиеОбработкиОбъекта();
