//{{{ ********* Настройка модуля *********

Функция ПолучитьНастройкуТипаСообщения(ТипСообщения,НеПриниматьАвтоматически = Ложь)
	
	СтруктураНастроекСообщения = Новый Структура();
	СтруктураНастроекСообщения.Вставить("ПриниматьАвтоматически",Истина);
	
	Если НеПриниматьАвтоматически = Истина
		ИЛИ ТипСообщения = "ORDERS"
		ИЛИ ТипСообщения = "RETANN"
		ИЛИ ТипСообщения = "RETDES"
		ИЛИ ТипСообщения = "PORDERS"
		ИЛИ ТипСообщения = "DELFOR" Тогда
		
		СтруктураНастроекСообщения.Вставить("ПриниматьАвтоматически",Ложь);//переопределим
		
	КонецЕсли;	
	
	Возврат СтруктураНастроекСообщения;
	
КонецФункции

Функция ПолучитьНастройкиМодуля() Экспорт
	
	СтруктураНастроек = Новый Структура();
	
	НастройкиАвтоматическойПриемки = Новый Массив;
	Для Каждого ТипСообщения Из EDI_РазложитьСтрокуВМассивСлов("PORDERS,ORDERS,ORDRSP,DESADV,RECADV,INVOIC,RETANN,ALCRPT,RETDES,PRICAT,PRICELIST,DELFOR",",") Цикл
		НастройкиАвтоматическойПриемки.Добавить("НеПриниматьАвтоматически_"+ТипСообщения);
	КонецЦикла;
	
	НастройкиАвтоматическойПриемки = ПолучитьСписокСвойствEDI(НастройкиАвтоматическойПриемки);
	
	Для Каждого ЭлементСтруктуры Из НастройкиАвтоматическойПриемки Цикл
		НеПриниматьАвтоматически = (ЭлементСтруктуры.Значение = Истина);
		ТипСообщения = Сред(ЭлементСтруктуры.Ключ,26);
		СтруктураНастроек.Вставить(ТипСообщения,ПолучитьНастройкуТипаСообщения(ТипСообщения,НеПриниматьАвтоматически));
	КонецЦикла;
	
	ИмяСправочникаХарактеристики = ПолучитьТипЗначенияОбъекта("ХарактеристикаНоменклатуры",,Истина);
	СтруктураНастроек.Вставить("ИспользоватьХарактеристикиНоменклатуры",ЗначениеЗаполнено(ИмяСправочникаХарактеристики));
	
	МассивСвойств = Новый Массив;
	МассивСвойств.Добавить("МыПоставщик");
	МассивСвойств.Добавить("МыТорговаяСеть");
	МассивСвойств.Добавить("ШаблонЦепочкиДокументов_Поставщик");
	МассивСвойств.Добавить("ШаблонЦепочкиДокументов_Покупатель");
	МассивСвойств.Добавить("СоздаваемыйДокументРСчетВид");
	МассивСвойств.Добавить("СоздаваемыйДокументРСчетGUID");
	МассивСвойств.Добавить("ПротоколОбмена_КонтурEDI");
		
	СохраненныеНастройки = ПолучитьСписокСвойствEDI(МассивСвойств);
	
	СтруктураНастроек.Вставить("МыПоставщик",							(СохраненныеНастройки.МыПоставщик = Истина));
	СтруктураНастроек.Вставить("МыТорговаяСеть",						(СохраненныеНастройки.МыТорговаяСеть = Истина));
	СтруктураНастроек.Вставить("ШаблонЦепочкиДокументов_Поставщик",		СохраненныеНастройки.ШаблонЦепочкиДокументов_Поставщик);
	СтруктураНастроек.Вставить("ШаблонЦепочкиДокументов_Покупатель",	СохраненныеНастройки.ШаблонЦепочкиДокументов_Покупатель);
	СтруктураНастроек.Вставить("СоздаваемыйДокументРСчетВид",			СохраненныеНастройки.СоздаваемыйДокументРСчетВид);
	СтруктураНастроек.Вставить("СоздаваемыйДокументРСчетGUID",			СохраненныеНастройки.СоздаваемыйДокументРСчетGUID);
	СтруктураНастроек.Вставить("ПротоколОбмена_КонтурEDI",				СохраненныеНастройки.ПротоколОбмена_КонтурEDI);

	ПротоколОбмена_КонтурEDI = СохраненныеНастройки.ПротоколОбмена_КонтурEDI; // на будущее - оставить все в НастройкиМодуля
		
	// Общие настройки модуля

	НастройкиМодуля = СтруктураНастроек; // сохраним настройки кем мы являемся для построения дерева общих настроек
	
	СтруктураОбщихНастроек = ПолучитьСтруктуруДополнительныхНастроек("Общие"); 
	ДобавитьСкрытыеНастройки(СтруктураОбщихНастроек, "Общие");
	
	МассивСвойств = Новый Массив;
	Для Каждого Настройка Из СтруктураОбщихНастроек Цикл
		МассивСвойств.Добавить(Настройка.Ключ);
	КонецЦикла;
	
	СохраненныеНастройки = ПолучитьСписокСвойствEDI(МассивСвойств);
	
	Для Каждого Настройка Из СохраненныеНастройки Цикл

		ИмяНастройки = Настройка.Ключ;
		ЗначениеНастройки = Настройка.Значение;
		
		Если Не ЗначениеЗаполнено(ЗначениеНастройки) Тогда
			ЗначениеПоУмолчанию = Неопределено;
			СтруктураОбщихНастроек.Свойство(ИмяНастройки, ЗначениеПоУмолчанию);
			
			ЗначениеНастройки = ?(ЗначениеЗаполнено(ЗначениеПоУмолчанию), ЗначениеПоУмолчанию, Неопределено);
		Конецесли;	
		
		СтруктураНастроек.Вставить(ИмяНастройки, ЗначениеНастройки);	
		
	КонецЦикла;
		
	Возврат СтруктураНастроек;
	
КонецФункции

Процедура ДобавитьСкрытыеНастройки(СтруктураНастроек, ВидНастроек)
	
	Если ВидНастроек = "Общие" Тогда
		СтруктураНастроек.Вставить("АвтообновлениеМодуля", Истина);
		СтруктураНастроек.Вставить("АвтообновлениеРасширений", Истина);
		СтруктураНастроек.Вставить("СинхронизироватьПодключаемыйМодуль", Истина);
		СтруктураНастроек.Вставить("СинхронизироватьРасширения", Истина);
		СтруктураНастроек.Вставить("СинхронизироватьКастомныйМодуль", Истина);

	ИначеЕсли ВидНастроек = "Партнеры" Тогда
		СтруктураНастроек.Вставить("КодСети", "");
	КонецЕсли;
	
Конецпроцедуры

Функция ИспользоватьКонтурPlugin() Экспорт

	СистемнаяИнформация = Новый СистемнаяИнформация;
	ВерсияПлатформы1С = СистемнаяИнформация.ВерсияПриложения;
	
	Если ВерсияПлатформы1С < "8.2.19.130" Тогда
		
		Возврат Истина;
		
	КонецЕсли;         
	
	Возврат ПолучитьКонстантуEDI("ИспользоватьКонтурPlugin") = Истина;
	
КонецФункции

Процедура ИнициализироватьТаблицуОсобенностейСообщений() Экспорт

	ТаблицаОсобенностей = Новый ТаблицаЗначений;
	ТаблицаОсобенностей.Колонки.Добавить("Наименование");  											// это только как показывать пользователю
	ТаблицаОсобенностей.Колонки.Добавить("Идентификатор"); 											// "через точку" везде использовать это (кроме xdto)
	ТаблицаОсобенностей.Колонки.Добавить("ИмяТаблицы"); 											// если данное поле заполнено, будем строить как вложенное поле указанной таблицы
	ТаблицаОсобенностей.Колонки.Добавить("ПодробноеОписание", ОписаниеТипаСтрока_КонтурEDI());   	// как справочная информация к особенности	
	
	// фильтры
	ТаблицаОсобенностей.Колонки.Добавить("Партнер");       											// можно оставить пустым - тогда по всем, можно просто через запятую псевдонимы вида: tander, billa  - это общее органичение механизма, но можно поставить доп ограничения по партнеру в его настройке (см. ниже здесь же)
	ТаблицаОсобенностей.Колонки.Добавить("ТипыСообщения"); 											// можно оставить пустым - тогда по всем, можно просто через запятую выбрать какие сообщения
	ТаблицаОсобенностей.Колонки.Добавить("Направление");   											// Фильтр по направлению
	
	// ВНИМАНИЕ! Если добавляется структура то она должна быть добавлена до её дочерних элементов  
	// У товаров не может быть структур!!!
	ТаблицаОсобенностей.Колонки.Добавить("ЭтоСтруктура", Новый ОписаниеТипов("Булево")); 			// если установлено то используется только для формирования структуры сообщения (например создать кастомные поля типа Сообщение.МояСтруктура.МоёПоле )
	ТаблицаОсобенностей.Колонки.Добавить("ИмяСтруктуры"); 											// заполняется если указано ЭтоСтруктура=Истина. По этому имени будет производиться попытка построить вложенные поля известной структуры, объявленной в "ПолучитьМетаданныеПоляСообщения"
																									// Если вы создаете СТРУКТУРУ то в поле Ревенство1СEDI можно указать "Неопределено", тогда создастся пара полей у сообщения - ИмяСтркутурыEDI + ИмяСтркутуры1С Если надо только 1 (без конвертации) то лучше явно указать = или EDI
	//Структуры не могут быть вложенными!
	ТаблицаОсобенностей.Колонки.Добавить("Путьxml");       											// путь для маппинга и понимания реквизита XDTO
	
	ТаблицаОсобенностей.Колонки.Добавить("Ревенство1СEDI"); 										// = / 1С / EDI	/ Неопределено // - В понимании функции ПолучитьМетаданныеСообщения 
	ТаблицаОсобенностей.Колонки.Добавить("ТипЗначенияEDI");	 										// тип поля EDI, для простых типов используйте эту колонку, как заполнять можно посмотреть в функции ПолучитьТипОсобенности()
	ТаблицаОсобенностей.Колонки.Добавить("ТипЗначения1С");	                                    	// тип поля 1С, можно определить для удобства, если хочется типизировать особенность 
	ТаблицаОсобенностей.Колонки.Добавить("ТипЗначенийСписка");                                      // если ТипЗначения1С список значений, тогда нужно указать какого типа эти значения
	
	ТаблицаОсобенностей.Колонки.Добавить("ВыводитьВКарточке", Новый ОписаниеТипов("Булево"));    	// В карточке сообщения в том числе для ручного изменения
	ТаблицаОсобенностей.Колонки.Добавить("ВалидироватьЗаполнение", Новый ОписаниеТипов("Булево"));  // можно добавить проверку на заполненность поля. простейшую через ЗначениеЗаполнено()
                                                                                                    // сложные проверки - это в событие ПМ "ПослеПроверкиСообщенияEDI"
	ТаблицаОсобенностей.Колонки.Добавить("ДобавитьНастройкуПартнера", Новый ОписаниеТипов("Булево"));// добавить включение/выключение по партнеру
	
	ТаблицаОсобенностей.Колонки.Добавить("НеОтправлятьДанные", Новый ОписаниеТипов("Булево"));    	// для возможности только вывести информацию через особенности, в исходящем сообщении данные отправлены не будут
	ТаблицаОсобенностей.Колонки.Добавить("НеСохранятьВСообщение", Новый ОписаниеТипов("Булево"));   // при выводе особенностей на форму и их изменении данные не будут переноситься в сообщение, потребуется для вывода информации для входящих сообщений 
	
	ТаблицаОсобенностей.Колонки.Добавить("СписокВыбора", Новый ОписаниеТипов("СписокЗначений"));    // передать в элемент управления особенности список для интерактивного выбора на форме
	
	РезультатПМ = ОбработкаСобытияПодключаемогоМодуля("ДобавитьОсобенностиСообщений", , Новый Структура("ТаблицаОсобенностей",ТаблицаОсобенностей));
	
	Если НЕ РезультатПМ = Неопределено Тогда
		ТаблицаОсобенностей = РезультатПМ;
	КонецЕсли;
	
	ТаблицаОсобенностей.Колонки.Добавить("ПолныйИдентификаторОсобенности", ОписаниеТипаСтрока_КонтурEDI(150));
	
	Для каждого Особенность Из ТаблицаОсобенностей Цикл
		
		Если ЭтоОсобенностьТоваров(Особенность) Тогда
			Особенность.ПолныйИдентификаторОсобенности = ПолныйИдентификаторОсобенностиТоваров(Особенность);
		Иначе 
			Особенность.ПолныйИдентификаторОсобенности = Особенность.Идентификатор;	
		КонецЕсли;
		
	КонецЦикла;
	
	ОсобенностиСообщений = ТаблицаОсобенностей;
	
КонецПроцедуры

Функция ОсобенностьЕстьВСообщении(ОсобенностьСообщения,Сообщение) Экспорт
	
	// тип
	Если ОсобенностьСообщения.ТипыСообщения <> "" Тогда 
		
		МассивТиповСообщений = КонтурСтандарт_РазложитьСтрокуВМассивСлов(ВРег(ОсобенностьСообщения.ТипыСообщения), ","); 
		
		Если МассивТиповСообщений.Найти(ВРег(Сообщение.ТипСообщения)) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;				
		
	КонецЕсли;
	
	// направление
	Если ОсобенностьСообщения.Направление <> "" И Найти(ОсобенностьСообщения.Направление, Сообщение.Направление) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// проверка что подходит партнер
	Если ОсобенностьСообщения.Партнер <> "" Тогда
		
		Партнер = Сообщение.Партнер;
		
		Если Сообщение.Свойство("ПереотправляемоеСообщениеСсылка") 
			 И НЕ Сообщение.ПереотправляемоеСообщениеСсылка.Пустая() Тогда
			 
			Партнер = Сообщение.ПереотправляемоеСообщениеСсылка.Партнер;
			
		КонецЕсли;
	
		КодСети = ПолучитьЗначениеСвойстваОбъектаEDI(Партнер, "КодСети");
		
		Если НЕ ЗначениеЗаполнено(КодСети)
			ИЛИ Найти(ОсобенностьСообщения.Партнер, КодСети) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	// проверка настройки партнера по добавлению этого поля т.е. у партнера не стоит галочка использования 
	Если ОсобенностьСообщения.ДобавитьНастройкуПартнера 
		И ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, ОсобенностьСообщения.Идентификатор) <> Истина Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
		
КонецФункции

Функция ОсобенностьВыводитсяВКарточкуСообщения(ОсобенностьСообщения,Сообщение) Экспорт
	
	//в принципе есть для сообщения
	Если НЕ ОсобенностьЕстьВСообщении(ОсобенностьСообщения,Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	//включено ли редактирование пользователем
	Если НЕ ОсобенностьСообщения.ВыводитьВКарточке Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
		
КонецФункции
	
Функция НужноКонвертироватьОсобенностиВСообщении(Сообщение) Экспорт
	
	Для каждого Особенность Из ОсобенностиСообщений Цикл
		Если ОсобенностьЕстьВСообщении(Особенность, Сообщение) 
			И ОсобенностьНужноКонвертировать(Особенность) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Процедура ЗаполнитьОсобенностиСтруктурТоваровСообщения(Товары, Сообщение) Экспорт
	
	Для каждого ОсобенностьСообщения Из ОсобенностиСообщений Цикл
		
		НеЗаполнятьОсобенность =		
		НЕ ОсобенностьВыводитсяВКарточкуСообщения(ОсобенностьСообщения, Сообщение)
		ИЛИ НЕ ЭтоОсобенностьТоваров(ОсобенностьСообщения)
		ИЛИ НЕ ЗначениеЗаполнено(ОсобенностьСообщения.ИмяСтруктуры)
		ИЛИ ОсобенностьСообщения.ЭтоСтруктура;
		
		Если НеЗаполнятьОсобенность Тогда
			Продолжить;
		КонецЕсли;
				
		Для Сч = 0 По Сообщение.Товары.Количество() - 1 Цикл
			
			ЗначениеОсобенности = Неопределено;
			
			ЕстьЗначение = ЗначениеЗаполнено(ОсобенностьСообщения.ИмяТаблицы)
			И ПроверитьСвойствоПоляВСтруктуре(
			Сообщение.Товары[Сч][ОсобенностьСообщения.ИмяТаблицы], 
			ОсобенностьСообщения.Идентификатор, ЗначениеОсобенности);
			
			Если ЕстьЗначение Тогда 
				Товары[Сч][ОсобенностьСообщения.ПолныйИдентификаторОсобенности] = ЗначениеОсобенности;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПеренестиОсобенностиВСообщение(Сообщение, Особенности, Товары, ЭтаФорма) Экспорт

	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("Сообщение", Сообщение);
	ПараметрыПМ.Вставить("Особенности", Особенности);
	ПараметрыПМ.Вставить("ТаблицаТоваров", Товары);
	ПараметрыПМ.Вставить("Форма", ЭтаФорма);
	
	ОбработкаСобытияПодключаемогоМодуля("ПеренестиОсобенностиВСообщение",, ПараметрыПМ);
	
	Для каждого ОсобенностьСообщения Из ОсобенностиСообщений Цикл
		
		НеПереноситьОсобенность =
		НЕ ОсобенностьВыводитсяВКарточкуСообщения(ОсобенностьСообщения, Сообщение)
		ИЛИ ОсобенностьСообщения.НеСохранятьВСообщение
		ИЛИ ЭтоОсобенностьСложногоТипа(ОсобенностьСообщения.ТипЗначенияEDI);
		
		Если НеПереноситьОсобенность Тогда
			Продолжить;
		КонецЕсли;
				
		ПолныйПутьОсобенности = ПолучитьПолныйПутьОсобенностиСообщения(ОсобенностьСообщения);
		
		Если ЭтоОсобенностьТоваров(ОсобенностьСообщения) Тогда
			
			ПеренестиОсобенностьТоваровВСообщение(ОсобенностьСообщения, Сообщение, Товары);
			
		Иначе
			
			ПеренестиОсобенностьШапкиВСообщение(Особенности, ОсобенностьСообщения, ПолныйПутьОсобенности, Сообщение);

		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура ПеренестиОсобенностьШапкиВСообщение(Особенности, ОсобенностьСообщения, ПолныйПутьОсобенности, Сообщение)
	
	Если ОсобенностьСообщения.ИмяСтруктуры = Неопределено Тогда
		ИмяСтруктурыОсобенности = "";	
	Иначе
		ИмяСтруктурыОсобенности = ОсобенностьСообщения.ИмяСтруктуры;	
	КонецЕсли;
	
	ПоискОсобенности = Новый Структура(
	"Идентификатор,ИмяСтруктуры", ОсобенностьСообщения.Идентификатор, ИмяСтруктурыОсобенности);
	
	МассивОсобенностейНаФорме = Особенности.НайтиСтроки(ПоискОсобенности);
	
	Если МассивОсобенностейНаФорме.Количество() = 1 Тогда
		
		НайденнаяОсобенность = МассивОсобенностейНаФорме[0];
		ПеренестиЗначениеВПолеСтруктуры(Сообщение, ПолныйПутьОсобенности, НайденнаяОсобенность.Значение);
		
	КонецЕсли;

КонецПроцедуры

Процедура ПеренестиОсобенностьТоваровВСообщение(ОсобенностьСообщения, Сообщение, Товары)
	
	ПолныйИдентификаторОсобенности = ОсобенностьСообщения.ПолныйИдентификаторОсобенности;
	
	ИмяПоляСообщения = ПолныйИдентификаторОсобенности;
	Если ОсобенностьСообщения.Ревенство1СEDI = Неопределено Тогда
		ИмяПоляСообщения = ИмяПоляСообщения + "1С";		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОсобенностьСообщения.ИмяСтруктуры) Тогда
		Для Сч = 0 По Товары.Количество() - 1 Цикл
			ЗначениеОсобенности = Товары[Сч][ПолныйИдентификаторОсобенности];
			ПеренестиЗначениеВПолеСтруктуры(Сообщение.Товары[Сч][ОсобенностьСообщения.ИмяТаблицы], ОсобенностьСообщения.Идентификатор, ЗначениеОсобенности);
		КонецЦикла;
	КонецЕсли;			
	
	Если Товары.Колонки.Найти(ИмяПоляСообщения) <> Неопределено 
		И Сообщение.Товары.Колонки.Найти(ИмяПоляСообщения) <> Неопределено Тогда
		
		Сообщение.Товары.ЗагрузитьКолонку(Товары.ВыгрузитьКолонку(ИмяПоляСообщения), ИмяПоляСообщения);
		
	КонецЕсли;

КонецПроцедуры

Процедура КонвертироватьОсобенностиСообщения(Сообщение) Экспорт

	Для каждого ОсобенностьСообщения Из ОсобенностиСообщений Цикл
		
		ПропуститьОсобенность = НЕ ОсобенностьЕстьВСообщении(ОсобенностьСообщения, Сообщение)
		ИЛИ НЕ ОсобенностьНужноКонвертировать(ОсобенностьСообщения)
		ИЛИ ОсобенностьСообщения.НеСохранятьВСообщение;
		
		Если ПропуститьОсобенность Тогда   			
			Продолжить;     			
		КонецЕсли;
		
		Если ОсобенностьСообщения.Направление = "Исходящее" Тогда
			Источник = "1С"; 
			Приемник = "EDI";			
		Иначе
			Источник = "EDI"; 
			Приемник = "1С";			
		КонецЕсли;
		
		ИмяИсточника = ОсобенностьСообщения.Идентификатор + Источник;
		ИмяПриемника = ОсобенностьСообщения.Идентификатор + Приемник;
		
		Если ЭтоОсобенностьТоваров(ОсобенностьСообщения) Тогда
			
			КонвертироватьОсобенностьТоваровСообщения(ИмяИсточника, ИмяПриемника, ОсобенностьСообщения, Сообщение);   
			
		Иначе
			
			КонвертироватьОсобенностьШапкиСообщения(ИмяИсточника, ИмяПриемника, ОсобенностьСообщения, Сообщение); 
			
		КонецЕсли;
		
	КонецЦикла; 

КонецПроцедуры

Процедура КонвертироватьОсобенностьШапкиСообщения(ИмяИсточника, ИмяПриемника, ОсобенностьСообщения, Сообщение)
	
	ЗначениеОсобенности = Сообщение[ИмяИсточника];
	
	Если ОсобенностьСообщения.Направление = "Исходящее" Тогда
		Сообщение[ИмяПриемника] = КонвертироватьЗначение1СвEDI(ЗначениеОсобенности, 
		ОсобенностьСообщения.ТипЗначения1С, 
		ОсобенностьСообщения.ТипЗначенияEDI, 
		Сообщение);
	Иначе
		Сообщение[ИмяПриемника] = КонвертироватьЗначениеEDIв1С(ЗначениеОсобенности, 
		ОсобенностьСообщения.ТипЗначенияEDI, 
		ОсобенностьСообщения.ТипЗначения1С, 
		Сообщение);
	КонецЕсли;

КонецПроцедуры

Процедура КонвертироватьОсобенностьТоваровСообщения(ИмяИсточника, ИмяПриемника, ОсобенностьСообщения, Сообщение)
	
	Для каждого Стр Из Сообщение.Товары Цикл 
		ЗначениеОсобенности = Стр[ИмяИсточника];
		
		Если ОсобенностьСообщения.Направление = "Исходящее" Тогда
			Стр[ИмяПриемника] 	= КонвертироватьЗначение1СвEDI(ЗначениеОсобенности, 
			ОсобенностьСообщения.ТипЗначения1С, 
			ОсобенностьСообщения.ТипЗначенияEDI, 
			Сообщение);
		Иначе
			Стр[ИмяПриемника] 	= КонвертироватьЗначениеEDIв1С(ЗначениеОсобенности, 
			ОсобенностьСообщения.ТипЗначенияEDI, 
			ОсобенностьСообщения.ТипЗначения1С, 
			Сообщение);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Функция ОсобенностьНужноКонвертировать(ОсобенностьСообщения) Экспорт
		
	Если ОсобенностьСообщения.Ревенство1СEDI = Неопределено Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли
	
КонецФункции

Функция ПолучитьТипОсобенности(Особенность) Экспорт 

	// дефолт
	ТипЗначенияОсобенностиПоУмолчанию = ОписаниеТипаСтрока_КонтурEDI(); 
		
	Если Особенность.Ревенство1СEDI = "EDI" Или Особенность.Ревенство1СEDI = "=" Тогда
		БазовыйТип = "ТипЗначенияEDI";
	Иначе
		БазовыйТип = "ТипЗначения1С";
	КонецЕсли;
	
	ТипЗначенияОсобенности = ПолучитьТип_КонтурEDI(Особенность[БазовыйТип]); 	
	
	Если ТипЗначенияОсобенности = Неопределено Тогда
		Возврат ТипЗначенияОсобенностиПоУмолчанию;
	Иначе
		Возврат ТипЗначенияОсобенности;
	КонецЕсли;
	
КонецФункции // ПолучитьТипОсобенности()

Функция ТипЗначенийСпискаИзОсобенности_КонтурEDI(Особенность) Экспорт
	
	Если ПеременнаяСодержитСвойство(Особенность, "ТипЗначенийСписка") 
		И ЗначениеЗаполнено(Особенность.ТипЗначенийСписка) Тогда
		
		ТипЗначенийСпискаЗначений = ПолучитьТип_КонтурEDI(Особенность.ТипЗначенийСписка);
		
	Иначе
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("Дата"));
		МассивТипов.Добавить(Тип("Строка"));
		МассивТипов.Добавить(Тип("Число")); 
		
		ТипЗначенийСпискаЗначений = Новый ОписаниеТипов(Справочники.ТипВсеСсылки(), МассивТипов);
		ТипЗначенийСпискаЗначений = Новый ОписаниеТипов(ТипЗначенийСпискаЗначений, Документы.ТипВсеСсылки().Типы());
		ТипЗначенийСпискаЗначений = Новый ОписаниеТипов(ТипЗначенийСпискаЗначений, Перечисления.ТипВсеСсылки().Типы());
		
	КонецЕсли;
	
	Возврат ТипЗначенийСпискаЗначений;

КонецФункции

Функция ПолучитьПолныйПутьОсобенностиСообщения(Особенность) Экспорт
	
	ПолныйПутьОсобенности = "";
	
	Если ЗначениеЗаполнено(Особенность.ИмяТаблицы)
		И НЕ Особенность.Идентификатор = Особенность.ИмяТаблицы Тогда
		ПолныйПутьОсобенности 	= Особенность.ИмяТаблицы + "." + Особенность.Идентификатор;
	Иначе
		ПолныйПутьОсобенности 	= Особенность.Идентификатор;
	КонецЕсли;
	
	Возврат ПолныйПутьОсобенности;
	
КонецФункции

Функция ПолныйИдентификаторОсобенностиТоваров(Особенность) Экспорт

	ПолныйИдентификаторОсобенности = "";
	
	Если ЗначениеЗаполнено(Особенность.ИмяТаблицы)
		И НЕ Особенность.ИмяТаблицы = "Товары" Тогда
		// Имя таблиы в данном случае - имя родительской структуры
		// таблиц и деревьев не должно быть в товарах
		ПолныйИдентификаторОсобенности 	= Особенность.ИмяТаблицы + Особенность.Идентификатор;
	Иначе
		ПолныйИдентификаторОсобенности	= Особенность.Идентификатор;
	КонецЕсли;
		
	Возврат ПолныйИдентификаторОсобенности;
	
КонецФункции
	
Функция ЭтоЗначениеСложногоТипа_КонтурEDI(Значение) Экспорт
	
	Тип = ТипЗнч(Значение);
	МассивТипов = ПолучитьМассивТиповСложныхОбъектов();	
	ЭтоСложныйТип = НЕ МассивТипов.Найти(Тип) = Неопределено;
	
	Возврат ЭтоСложныйТип;
	
КонецФункции

Функция ЭтоОсобенностьСложногоТипа(ИмяТипа) Экспорт
	
	МассивИменТипов = ПолучитьМассивИменТиповСложныхОбъектов();
	ЭтоСложныйТип = НЕ МассивИменТипов.Найти(ИмяТипа) = Неопределено;
	
	Возврат ЭтоСложныйТип;	
	
КонецФункции

Функция ПолучитьСоответствиеИменТиповСложныхОбъектов() Экспорт
	
	СоответствиеИмен = Новый Соответствие;
	МассивИменТипов = ПолучитьМассивИменТиповСложныхОбъектов();
	
	Для каждого ИмяТипа Из МассивИменТипов Цикл
		СоответствиеИмен.Вставить(Тип(ИмяТипа), ИмяТипа);
	КонецЦикла;
	
	Возврат СоответствиеИмен;
	
КонецФункции

Функция ОпределитьИмяТипаЗначенияСложногоТипа(Значение) Экспорт
	
	ТипЗначения = Неопределено;
	Тип = ТипЗнч(Значение);
	СоответствиеИменТипов = ПолучитьСоответствиеИменТиповСложныхОбъектов();
	ТипЗначения = СоответствиеИменТипов[Тип];
	
	Возврат ТипЗначения;
	
КонецФункции

Функция ОписаниеТипаСодержитСложныйТип(ОписаниеТипа) Экспорт
	
	МассивСложныхТипов = ПолучитьМассивТиповСложныхОбъектов();
	
	Для каждого СложныйТип Из МассивСложныхТипов Цикл
		Если ОписаниеТипа.СодержитТип(СложныйТип) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции // ОписаниеТипаСодержитСложныйТип()
	
Функция ПолучитьМассивТиповСложныхОбъектов()
	
	МассивТипов = ЭДО_Кэш_Прочитать("МассивТиповСложныхОбъектов");
	
	Если МассивТипов = Неопределено Тогда
	
		МассивТипов = Новый Массив;
		МассивИменТипов = ПолучитьМассивИменТиповСложныхОбъектов();
		
		Для каждого ИмяТипа Из МассивИменТипов Цикл
			МассивТипов.Добавить(Тип(ИмяТипа));	
		КонецЦикла;	
		
		ЭДО_Кэш_Поместить("МассивТиповСложныхОбъектов", МассивТипов);
		
	КонецЕсли;
	
	Возврат МассивТипов;
	
КонецФункции // ПолучитьМассивТиповСложныхОбъектов()

Функция ПолучитьМассивИменТиповСложныхОбъектов()

	МассивТипов = Новый Массив;
	МассивТипов.Добавить("Структура");	
	МассивТипов.Добавить("Соответствие");	
	МассивТипов.Добавить("Массив");	
	МассивТипов.Добавить("ТаблицаЗначений");	
	МассивТипов.Добавить("ДеревоЗначений");	
	
	Возврат МассивТипов;
	
КонецФункции // ПолучитьМассивИменТиповСложныхОбъектов()

Функция ПолучитьПустоеЗначениеОсобенности(Особенность) Экспорт
	
	ТипЗнчОсобенности = ПолучитьТипОсобенности(Особенность);
	
	Возврат ТипЗнчОсобенности.ПривестиЗначение();
	
	//это подсказка когда дойдет дело до объектов 1С: ПолучитьПустуюСсылкуОбъекта()

КонецФункции // ПолучитьПустоеЗначениеОсобенности()

Процедура ОбновитьТаблицуТиповЗначенияОбъектов() Экспорт 
	
	ТаблицаТипов = Новый ТаблицаЗначений;
	ТаблицаТипов.Колонки.Добавить("ИмяОбъекта");
	ТаблицаТипов.Колонки.Добавить("ИмяТипа");
	ТаблицаТипов.Колонки.Добавить("Примечание");
	ТаблицаТипов.Колонки.Добавить("ТипСообщения");             // только для документов/сообщений
	ТаблицаТипов.Колонки.Добавить("Сторона");                           // только для документов/сообщений
	ТаблицаТипов.Колонки.Добавить("Направление"); // только для документов/сообщений
	ТаблицаТипов.Колонки.Добавить("ПорядокСообщения",ОписаниеТипаЧисло_КонтурEDI());// только для документов/сообщений
	
	ТаблицаТипов.Индексы.Добавить("ИмяОбъекта");
	
	Если НЕ ВнешнийМодуль = Неопределено
		И НЕ ВнешнийМодуль.Метаданные().Макеты.Найти("ТипыОбъектов") = Неопределено Тогда
		МакетНастроек = ВнешнийМодуль.ПолучитьМакет("ТипыОбъектов");
		ИмяВертикальнойОбласти = "ПодключаемыйМодуль";
	Иначе  
		МакетНастроек = ПолучитьМакет("ТипыОбъектов");
		ИмяВертикальнойОбласти = "ПоУмолчанию"; //УТ, УПП, КА
	КонецЕсли;
	
	//1. Заполним типы для справочников
	
	//для начала поймем, из какой колонки брать названия типов для данной конфигурации
	ОбластьНазванияСправочников=МакетНастроек.ПолучитьОбласть("ТипыСправочников");
	
	Если ИмяВертикальнойОбласти = "ПодключаемыйМодуль" Тогда
		//оставим ее, это макет в подключаемом модуле.
	ИначеЕсли ИмяКонфигурации1С = "БП"
		Или ИмяКонфигурации1С = "ТКПТ"
		Или ИмяКонфигурации1С = "ДалионУМ"
		Или ИмяКонфигурации1С = "АСТОР" 
		Или ИмяКонфигурации1С = "УФ_УТ" 
		Или ИмяКонфигурации1С = "УФ_БП" 
		Или ИмяКонфигурации1С = "УФ_УНФ"
		Или ИмяКонфигурации1С = "УФ_Розница"
		Или ИмяКонфигурации1С = "ХБКП_УСП"
		Или ИмяКонфигурации1С = "ШтрихМ_РС"
		Или ИмяКонфигурации1С = "УФ_ДалионТРЕНД"
		Тогда 
		ИмяВертикальнойОбласти = ИмяКонфигурации1С;
	КонецЕсли;       
	
	ОбластьТипыСправочников = МакетНастроек.ПолучитьОбласть("ТипыСправочников|"+ИмяВертикальнойОбласти);
	
	Если НЕ МодульМеркурий() = Неопределено Тогда
		
		Если НЕ ВнешнийМодуль = Неопределено
			И НЕ ВнешнийМодуль.Метаданные().Макеты.Найти("ТипыОбъектовМеркурий") = Неопределено Тогда
			МакетМеркурий = ВнешнийМодуль.ПолучитьМакет("ТипыОбъектовМеркурий");
			ИмяВертикальнойОбластиМеркурий = "ПодключаемыйМодуль";
		Иначе  
			МакетМеркурий = МодульМеркурий().ПолучитьМакет("ТипыОбъектов");
			ИмяВертикальнойОбластиМеркурий = "ПоУмолчанию"; //УТ, УПП, КА
		КонецЕсли;
		
		Если ИмяВертикальнойОбластиМеркурий = "ПодключаемыйМодуль" Тогда
			//оставим ее, это макет в подключаемом модуле.
		ИначеЕсли ИмяКонфигурации1С = "БП"
			Или ИмяКонфигурации1С = "ТКПТ"
			Или ИмяКонфигурации1С = "ДалионУМ"
			Или ИмяКонфигурации1С = "АСТОР" 
			Или ИмяКонфигурации1С = "УФ_УТ" 
			Или ИмяКонфигурации1С = "УФ_БП" 
			Или ИмяКонфигурации1С = "УФ_УНФ"
			Или ИмяКонфигурации1С = "УФ_Розница"
			Или ИмяКонфигурации1С = "ХБКП_УСП"
			Тогда 
			ИмяВертикальнойОбластиМеркурий = ИмяКонфигурации1С;
		КонецЕсли;       
		
		ОбластьНазванияСправочников.Вывести(МакетМеркурий.ПолучитьОбласть("ТипыСправочников"));
		ОбластьТипыСправочников.Вывести(МакетМеркурий.ПолучитьОбласть("ТипыСправочников|"+ИмяВертикальнойОбластиМеркурий));
	КонецЕсли;
	
	//собственно загрузка типов
	Для Сч=1 По ОбластьНазванияСправочников.ВысотаТаблицы Цикл
		
		ИмяОбъекта = ПолучитьТекстЯчейкиОбласти(ОбластьНазванияСправочников,Сч,1);
		Примечание = ПолучитьТекстЯчейкиОбласти(ОбластьНазванияСправочников,Сч,2);
		ИмяТипа    = ПолучитьТекстЯчейкиОбласти(ОбластьНазванияСправочников,Сч,3);
		
		ИмяРасширенияТипа = ПолучитьТекстЯчейкиОбласти(ОбластьТипыСправочников,Сч,1);
		Если ЗначениеЗаполнено(ИмяРасширенияТипа) Тогда
			ИмяТипа = ИмяРасширенияТипа;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИмяОбъекта) Тогда
			
			Если ИмяОбъекта = "ИсходящийКСФ" Тогда
				Если ИмяТипа = "Неопределено" Тогда
					Продолжить;
				Иначе
					ДокументТип = СтрЗаменить(ИмяТипа,"ДокументСсылка.","");
					Если Метаданные.Документы.Найти(ДокументТип) = Неопределено Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			НоваяСтрока = ТаблицаТипов.Добавить();
			НоваяСтрока.ИмяОбъекта = ИмяОбъекта;
			НоваяСтрока.Примечание = Примечание;
			НоваяСтрока.ИмяТипа = Неопределено;
			
			
			Если ЗначениеЗаполнено(ИмяТипа) Тогда
				Если НЕ СокрЛП(ИмяТипа) = "Неопределено" Тогда
					
					Если Найти(ИмяТипа, "СправочникСсылка") <> 0 ИЛИ
						Найти(ИмяТипа, "ДокументСсылка") <> 0 ИЛИ
						Найти(ИмяТипа, "ПеречислениеСсылка") <> 0 Тогда						
						
						ИмяТипа = СтрЗаменить(ИмяТипа, "ДокументСсылка.", "Документы."); 
						ИмяТипа = СтрЗаменить(ИмяТипа, "СправочникСсылка.", "Справочники.");
						ИмяТипа = СтрЗаменить(ИмяТипа, "ПеречислениеСсылка.", "Перечисления.");
						
						МассивТипов = EDI_РазложитьСтрокуВМассивСлов(ИмяТипа,",");
						
						СуществующиеТипы = "";
						
						Для каждого Тип из МассивТипов Цикл
							ИскатьВВХ = Ложь;
							Если Найти(Тип, "КонтурEDI_") <> 0 Тогда
								ИскатьВВХ = Истина;
							КонецЕсли;
							Если ЕстьНеобходимыеМетаданные(Тип, Не ИскатьВВХ) Тогда
								СуществующиеТипы = СуществующиеТипы + Тип + ",";							
							КонецЕсли;
						КонецЦикла;
						
						СуществующиеТипы = Лев(СуществующиеТипы, СтрДлина(СуществующиеТипы)-1);
						
						СуществующиеТипы = СтрЗаменить(СуществующиеТипы, "Документы.", "ДокументСсылка."); 
						СуществующиеТипы = СтрЗаменить(СуществующиеТипы, "Справочники.", "СправочникСсылка.");
						СуществующиеТипы = СтрЗаменить(СуществующиеТипы, "Перечисления.", "ПеречислениеСсылка.");
						
						Если ЗначениеЗаполнено(СуществующиеТипы) Тогда 
							
							НоваяСтрока.ИмяТипа = СуществующиеТипы;
							
						КонецЕсли;
						
					Иначе 
						
						НоваяСтрока.ИмяТипа = ИмяТипа;
						
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			
			Если ИмяОбъекта = "ВходящийВозврат" Тогда
				НоваяСтрока.Сторона = "Поставщик";
				НоваяСтрока.ТипСообщения = "RETANN";
				НоваяСтрока.Направление = "Входящее";
			ИначеЕсли ИмяОбъекта = "ИсходящийОтветНаУведомлениеОВозврате" Тогда
				НоваяСтрока.Сторона = "Поставщик";
				НоваяСтрока.ТипСообщения = "RETINS";
				НоваяСтрока.Направление = "Исходящее";
			ИначеЕсли ИмяОбъекта = "ИсходящийВозврат" Тогда
				НоваяСтрока.Сторона = "Покупатель";
				НоваяСтрока.ТипСообщения = "RETANN";
				НоваяСтрока.Направление = "Исходящее";
			ИначеЕсли ИмяОбъекта = "ИсходящееУведомлениеОбОтгрузкеВозврата" Тогда
				НоваяСтрока.Сторона = "Покупатель";
				НоваяСтрока.ТипСообщения = "RETDES";
				НоваяСтрока.Направление = "Исходящее";
			ИначеЕсли ИмяОбъекта = "ВходящееУведомлениеОбОтгрузкеВозврата" Тогда
				НоваяСтрока.Сторона = "Поставщик";
				НоваяСтрока.ТипСообщения = "RETDES";
				НоваяСтрока.Направление = "Входящее";
			ИначеЕсли ИмяОбъекта = "ИсходящееУведомлениеОПриемкеВозврата" Тогда
				НоваяСтрока.Сторона = "Поставщик";
				НоваяСтрока.ТипСообщения = "RETREC";
				НоваяСтрока.Направление = "Исходящее";
			ИначеЕсли ИмяОбъекта = "ИсходящийКСФ" Тогда
				НоваяСтрока.Сторона = "Поставщик";
				НоваяСтрока.ТипСообщения = "COINVOIC";
				НоваяСтрока.Направление = "Исходящее";
			ИначеЕсли ИмяОбъекта = "ВходящийОтветНаУведомлениеОВозврате" Тогда
				НоваяСтрока.Сторона = "Покупатель";
				НоваяСтрока.ТипСообщения = "RETINS";
				НоваяСтрока.Направление = "Входящее"; 
			ИначеЕсли ИмяОбъекта = "ВходящееУведомлениеОПриемкеВозврата" Тогда
				НоваяСтрока.Сторона = "Покупатель";
				НоваяСтрока.ТипСообщения = "RETREC";
				НоваяСтрока.Направление = "Входящее";
			КонецЕсли;
						
		КонецЕсли;
		
	КонецЦикла;                   
	
	//2. Заполним типы для документов
	Попытка
		ОбновитьТаблицуТиповЗначенияОбъектов_Из_СКД();//для кастомов
	Исключение
		Сообщить_КонтурEDI("Не удалось обновить таблицу типов значения объектов из шаблонов запросов.");
	КонецПопытки;              
	
	//4. Прокинем ПМ и индексируем таблицу
	РезультатПМ = ОбработкаСобытияПодключаемогоМодуля("ИзменитьНастройкуТиповОбъектов",,Новый Структура("ТаблицаТипов",ТаблицаТипов));
	Если НЕ РезультатПМ = Неопределено Тогда
		ТаблицаТипов = РезультатПМ;
	КонецЕсли;
	
	ТаблицаТипов.Сортировать("ИмяТипа");
	
КонецПроцедуры

Функция ОбновитьТаблицуТиповЗначенияОбъектов_Из_СКД()
	
	ИмяШаблона = "";
	
	//вариант работы для поставщика и покупателя отдельно

	СКД_ВеткаКонфигурации = ПолучитьВеткуСКДИзШаблонаЗапросов();
	
	Если ТипЗнч(СКД_ВеткаКонфигурации) <> Тип("НаборДанныхОбъединениеСхемыКомпоновкиДанных") Тогда
		Сообщить_КонтурEDI("Не удалось определить шаблоны цепочек для текущей конфигурации.");
		Возврат Ложь;
	КонецЕсли;
	
	НастройкиЦепочек = ПолучитьСписокСвойствEDI("МыПоставщик,МыТорговаяСеть,ШаблонЦепочкиДокументов_Покупатель,ШаблонЦепочкиДокументов_Поставщик");
	
	Для Каждого Флаг Из НастройкиЦепочек Цикл
		
		Если Флаг.Значение = Истина Тогда//мы являемся покупателем или поставщиком
			
			Если Флаг.Ключ = "МыПоставщик" Тогда
				РежимРаботы = "Поставщик";
			ИначеЕсли Флаг.Ключ = "МыТорговаяСеть" Тогда
				РежимРаботы = "Покупатель";
			Иначе
				Продолжить;//2 других свойства просто повисят в этом же запросе
			КонецЕсли;
			
			ТипЦепочки = "ШаблонЦепочкиДокументов_" + РежимРаботы;
			ИмяВарианта = НастройкиЦепочек[ТипЦепочки];
			
			Если Не ЗначениеЗаполнено(ИмяВарианта) Тогда
				СписокШаблонов = ПолучитьСписокДоступныхШаблоновЦепочки(РежимРаботы);
				Если СписокШаблонов.Количество() > 0 Тогда
					ИмяВарианта = СписокШаблонов[0].Представление;
					УстановитьКонстантуEDI(ТипЦепочки, ИмяВарианта);
				КонецЕсли;	
			КонецЕсли;

			ИмяВарианта = ОпределитьИндексШаблонаДляЦепочки(ИмяВарианта, РежимРаботы);
			
			ИсточникДанных = Неопределено;
			
			Если ТипЗнч(ИмяВарианта) = Тип("Строка") Тогда
				ИсточникДанных = СКД_ВеткаКонфигурации.Элементы[РежимРаботы].Элементы.ЗапросОсновнойЦепочки.Элементы.Найти(ИмяВарианта);
			КонецЕсли;
			
			Если ИсточникДанных = Неопределено Тогда
				Сообщить_КонтурEDI("Не удалось найти запрос основной цепочки (шаблоны запросов) для режима" + РежимРаботы);
				Возврат Ложь;
			КонецЕсли;
			
			ШаблонЗапросаЦепочкиДокументов = ИсточникДанных.Запрос;
			Выполнить("ШаблонЗапросаЦепочкиДокументов_" + РежимРаботы + " = ШаблонЗапросаЦепочкиДокументов"); //определяем глобальные переменные
			ОбработатьПодменыДляКонфигурации_КонтурEDI(ШаблонЗапросаЦепочкиДокументов);
			
			ЗаполнитьСоответствиеДокументовСообщений(РежимРаботы);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ОпределитьИндексШаблонаДляЦепочки(ИмяВарианта, РежимРаботы) Экспорт  
	
	Если ИмяВарианта="ПодключаемыйМодуль" ИЛИ НЕ ЗначениеЗаполнено(ИмяВарианта) Тогда//берем запросы из подключаемого модуля  
		ИндексШаблона = 0;
	Иначе
		ИндексШаблона = ИмяВарианта;
	КонецЕсли;
	
	Возврат ИндексШаблона;

КонецФункции 

//установим типы документов для сообщений
Процедура ЗаполнитьСоответствиеДокументовСообщений(РежимРаботы) Экспорт
	
	ТаблицаСоединенийДокументов = ПолучитьТаблицуДляСборкиЗапросов(РежимРаботы);
	
	//и все это нам надо кинуть еще и в таблицу типов
	Если РежимРаботы = "Поставщик" Тогда
		ИсходныйТекстЗапроса = ШаблонЗапросаЦепочкиДокументов_Поставщик;
	ИначеЕсли РежимРаботы = "Покупатель" Тогда
		ИсходныйТекстЗапроса = ШаблонЗапросаЦепочкиДокументов_Покупатель;
	КонецЕсли;	
	
	//вычленим из текста запроса список полей
	//он будет выглядеть примерно так:
	
	//ВЫБРАТЬ
	//	докЗаказПокупателя.Ссылка КАК PORDERS,
	//	докЗаказПокупателя.Ссылка КАК ORDERS,
	//	докЗаказПокупателя.Ссылка КАК ORDRSP,
	//	РеализацияТоваровУслуг.Ссылка КАК DESADV,
	//	РеализацияТоваровУслуг.Ссылка КАК RECADV,
	//	СчетФактураВыданный.Ссылка КАК INVOIC
	
	
	ПозицияНачалаСоединений = Найти(ИсходныйТекстЗапроса,"{ПОЛНОЕ СОЕДИНЕНИЕ");
	
	ТекстНачалаЗапроса = Лев(ИсходныйТекстЗапроса,ПозицияНачалаСоединений-1);
	
	ТекстПолейЗапроса = Лев(ИсходныйТекстЗапроса,ПозицияНачалаСоединений);
	ТекстПолейЗапроса = СтрЗаменить(ТекстПолейЗапроса,Символы.ПС," "+Символы.ПС+" ");
	ТекстПолейЗапроса = Сред(СокрЛП(ТекстПолейЗапроса),8);
	ПозицияНачалаТаблиц = Найти(ТекстПолейЗапроса," ИЗ");
	ТекстПолейЗапроса = Лев(ТекстПолейЗапроса,ПозицияНачалаТаблиц);
	
	ТекстПолейЗапроса = СтрЗаменить(ТекстПолейЗапроса,",",Символы.ПС);
	
	//теперь пройдемся по каждой строке из ТекстПолейЗапроса и установим нужный тип документа для каждого сообщения
	Для Сч=1 По СтрЧислоСтрок(ТекстПолейЗапроса) Цикл
		ТекСтрока = СокрЛП(СтрПолучитьСтроку(ТекстПолейЗапроса,Сч));
		
		//из строк вида
		//	докЗаказПокупателя.Ссылка КАК ORDRSP,
		//определим, какой документ в 1С какому типу сообщения соответствует
		
		Если ТекСтрока="" Тогда
			Продолжить;
		Иначе
			ПозицияТочки = Найти(ТекСтрока,".");
			ПсевдонимТаблицы = Лев(ТекСтрока,Позицияточки-1);
			ПозицияКАК = Найти(ТекСтрока," КАК ");
			ТипСообщения = СокрЛП(Сред(ТекСтрока,ПозицияКАК+5));
			
			СтрокаТаблицыСоединений = ТаблицаСоединенийДокументов.Найти(ПсевдонимТаблицы,"ПсевдонимТаблицы");
			
			ТипДокумента = СтрокаТаблицыСоединений.ТипДокумента;
			
			ПорядокСообщения = ПолучитьПорядокСообщенияВЦепочке(ТипСообщения);
			
			Если РежимРаботы="Поставщик" Тогда
				Если ТипСообщения="PORDERS" Тогда
					ПредставлениеТипа = "ИсходящийОбратныйЗаказ";
				ИначеЕсли ТипСообщения="ORDERS" Тогда
					ПредставлениеТипа = "ВходящийЗаказПокупателя";
				ИначеЕсли ТипСообщения="ORDRSP" Тогда
					ПредставлениеТипа = "ИсходящийОтветНаЗаказ";
				ИначеЕсли ТипСообщения="DESADV" Тогда
					ПредставлениеТипа = "ИсходящееУведомлениеОбОтгрузке";
				ИначеЕсли ТипСообщения="RECADV" Тогда
					ПредставлениеТипа = "ВходящееУведомлениеОПриемке";
				ИначеЕсли ТипСообщения="INVOIC" Тогда
					ПредставлениеТипа = "ИсходящийСчетФактура";
				ИначеЕсли ТипСообщения="COINVOIC" Тогда
					ПредставлениеТипа = "ИсходящийКСФ";
				ИначеЕсли ТипСообщения="RETANN" Тогда
					ПредставлениеТипа = "ВходящийВозврат";
				КонецЕсли;
			ИначеЕсли РежимРаботы="Покупатель" Тогда
				Если ТипСообщения="PORDERS" Тогда
					ПредставлениеТипа = "ВходящийОбратныйЗаказ";
				ИначеЕсли ТипСообщения="ORDERS" Тогда
					ПредставлениеТипа = "ИсходящийЗаказПоставщику";
				ИначеЕсли ТипСообщения="ORDRSP" Тогда
					ПредставлениеТипа = "ВходящийОтветНаЗаказ";
				ИначеЕсли ТипСообщения="DESADV" Тогда
					ПредставлениеТипа = "ВходящееУведомлениеОбОтгрузке";
				ИначеЕсли ТипСообщения="RECADV" Тогда
					ПредставлениеТипа = "ИсходящееУведомлениеОПриемке";
				ИначеЕсли ТипСообщения="INVOIC" Тогда
					ПредставлениеТипа = "ВходящийСчетФактура";
				ИначеЕсли ТипСообщения="RETANN" Тогда
					ПредставлениеТипа = "ИсходящийВозврат";
				КонецЕсли;
				
			КонецЕсли;
			//заголовок
			
			Направление = ПолучитьНаправлениеСообщения(ТипСообщения,РежимРаботы);
			УстановитьТипЗначенияОбъекта(ПредставлениеТипа,			"ДокументСсылка."+ТипДокумента,		ТипСообщения,	РежимРаботы,	, ПорядокСообщения, Направление);
			
		КонецЕсли;	
	КонецЦикла;	
		
КонецПроцедуры

Функция ПолучитьИмяКритерияОтбораДляКонфигурации()
	
	ИмяКритерияОтбора = "СвязанныеДокументы";
	
	Если ИмяКонфигурации1С = "БП" Тогда
	
		ИмяКритерияОтбора = "СтруктураПодчиненности";
	
	КонецЕсли;
	
	Возврат ИмяКритерияОтбора;	
	
КонецФункции

Функция ПолучитьИмяКонфигурацииДляЗапроса() Экспорт
	
	ИмяДляЗапроса = ЭДО_Кэш_Прочитать("ИмяКонфигурацииДляЗапроса");
	
	Если ИмяДляЗапроса = Неопределено Тогда
		
		СинонимКонфигурации = Метаданные.Синоним;
		
		ИмяДляЗапроса = "";
		Если ИмяКонфигурации1С="БП" Тогда
			Если Найти(СинонимКонфигурации,"Бухгалтерия предприятия, редакция 1.6")>0 Тогда
				ИмяДляЗапроса = "БП_16";
			ИначеЕсли Найти(СинонимКонфигурации, "Бухгалтерия сельскохозяйственного предприятия, редакция 2.0")>0 Тогда
				ИмяДляЗапроса = "БСХП_20";
			Иначе
				ИмяДляЗапроса = "БП_20";
			КонецЕсли;	
		ИначеЕсли ИмяКонфигурации1С = "УТ_10_3" 
			Или ИмяКонфигурации1С = "УПП"
			Или ИмяКонфигурации1С = "RIT"
			Или ИмяКонфигурации1С = "КА"
			Тогда
			ИмяДляЗапроса = "УТ_УПП_КА";
		ИначеЕсли ИмяКонфигурации1С = "УФ_УТ" Тогда
			ИмяДляЗапроса = "УФ_УТ";
		ИначеЕсли ИмяКонфигурации1С = "УФ_БП" Тогда
			ИмяДляЗапроса = "УФ_БП";
		ИначеЕсли ИмяКонфигурации1С = "УФ_УНФ" Тогда 
			ИмяДляЗапроса = "УФ_УНФ";
			
		Иначе	
			ИмяДляЗапроса = ИмяКонфигурации1С;
		КонецЕсли;
		
		ЭДО_Кэш_Поместить("ИмяКонфигурацииДляЗапроса", ИмяДляЗапроса);
		
	КонецЕсли;
	
	Возврат ИмяДляЗапроса;
	
КонецФункции  

Функция ПолучитьСписокДоступныхШаблоновЦепочки(РежимРаботы) Экспорт
	
	//вариант работы для поставщика и покупателя отдельно
	
	СКД_ВеткаКонфигурации = ПолучитьВеткуСКДИзШаблонаЗапросов();
	СКД_ВеткаЦепочек = СКД_ВеткаКонфигурации.Элементы[РежимРаботы].Элементы.ЗапросОсновнойЦепочки.Элементы;
	Список = Новый СписокЗначений;
	
	Для Каждого Эл Из СКД_ВеткаЦепочек Цикл
		
		//С определенной версии УТ_УФ необходимо использовать цепочку с документом ПриобретениеТоваровУслуг   
		Если РежимРаботы = "Покупатель" И ИмяКонфигурации1С = "УФ_УТ"
			И Эл.Имя = "Заказ_Поступление_СФ"
			И ЕстьНеобходимыеМетаданные("Документы.ПриобретениеТоваровУслуг") Тогда
			Продолжить;	
		КонецЕсли;
		
		Список.Добавить(Эл.Запрос, Эл.Имя);
	КонецЦикла;	
	
	Возврат Список;

КонецФункции

Процедура УстановитьТипЗначенияОбъекта(ИмяОбъекта, ИмяТипа, ТипСообщения = "", Сторона = "", ДоступныеТипы = Неопределено, ПорядокСообщения=0, Направление)
	
	НайденнаяСтрока = ТаблицаТипов.Найти(ИмяОбъекта,"ИмяОбъекта");
	Если НайденнаяСтрока = Неопределено Тогда
		
		НайденнаяСтрока = ТаблицаТипов.Добавить();
		НайденнаяСтрока.ИмяОбъекта		= ИмяОбъекта;
		
	КонецЕсли;
		
	НайденнаяСтрока.ИмяТипа				= ИмяТипа;
	НайденнаяСтрока.ТипСообщения		= ТипСообщения;
	НайденнаяСтрока.Сторона				= Сторона;
	НайденнаяСтрока.ПорядокСообщения	= ПорядокСообщения;
	НайденнаяСтрока.Направление			= Направление;
	
КонецПроцедуры

Функция ПолучитьПорядокСообщенияВЦепочке(ТипСообщения)
	
	Если ТипСообщения = "PORDERS" Тогда
		ПорядокСообщения = 1;
	ИначеЕсли ТипСообщения = "ORDERS" Тогда
		ПорядокСообщения = 2;
	ИначеЕсли ТипСообщения = "ORDRSP" Тогда
		ПорядокСообщения = 3;
	ИначеЕсли ТипСообщения = "DESADV" Тогда
		ПорядокСообщения = 4;
	ИначеЕсли ТипСообщения = "RECADV" Тогда
		ПорядокСообщения = 5;
	ИначеЕсли ТипСообщения = "INVOIC" Тогда
		ПорядокСообщения = 6;
	ИначеЕсли ТипСообщения="RETANN" Тогда
		ПорядокСообщения = -1;
		// RETANN не входит в цепочку и является независимым сообщением
	КонецЕсли;
	
	Возврат ПорядокСообщения
	
КонецФункции	

// Вызывается после интерактивного выбора шаблона в форме настроек
// Параметры:
// 		РежимРаботы - Строка - Поставщик или Покупатель.
// 		ТекстШаблона - Строка - Шаблон запроса основной цепочки документов.
//
Процедура УстановитьШаблонЦепочкиДляРежимаРаботы(РежимРаботы, ТекстШаблона) Экспорт
	
	Если РежимРаботы = "Поставщик" Тогда
		ШаблонЗапросаЦепочкиДокументов_Поставщик = ТекстШаблона;
	Иначе
		ШаблонЗапросаЦепочкиДокументов_Покупатель = ТекстШаблона;
	КонецЕсли;	
	
	ЗаполнитьСоответствиеДокументовСообщений(РежимРаботы);
	
КонецПроцедуры

