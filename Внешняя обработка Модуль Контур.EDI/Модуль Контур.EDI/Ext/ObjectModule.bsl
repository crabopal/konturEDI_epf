	|	Организация - " + СтрокаСчетФактура.Организация + "
	|	boxId 		- " + СтрокаСчетФактура.boxId + "
	|	messageId 	- " + СтрокаСчетФактура.MessageId + "
	|Подробная информация - " + ОписаниеОшибки;
	ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстСообщения);
	Сообщить(ТекстСообщения);
	
КонецПроцедуры

Функция ДоверенностьПоУмолчанию(ДанныеАвторизации) Экспорт
	
	ИдентификаторОрганизацииДиадок = ИдентификаторОрганизацииДиадок(ДанныеАвторизации.Организация);
	Если ИдентификаторОрганизацииДиадок = Неопределено Тогда
		ВызватьИсключение "Для организации " + Строка(ДанныеАвторизации.Организация) + " не настроена связка с diadoc.ru
		|обратитесь в техническую поддержку";		
	КонецЕсли;
	ИдентификаторЯщикаДиадок = ИдентификаторЯщикаДиадок(ДанныеАвторизации, ИдентификаторОрганизацииДиадок);               
	ИдентификаторПользователя = ОписаниеПользователяДиадок(ДанныеАвторизации).Значение.UserId;
	
	СписокДоверенностей = ПолучитьСписокМЧДСотрудника(ДанныеАвторизации, ИдентификаторЯщикаДиадок, ИдентификаторПользователя);

	Для Каждого СтруктураДоверенности Из СписокДоверенностей Цикл 
		Если СтруктураДоверенности.ПоУмолчанию = Истина Тогда
			Возврат СтруктураДоверенности.МашиночитаемаяДоверенность;
		КонецЕсли;		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция СпособПередачиМашиночитаемойДоверенности(Партнер) Экспорт
	
	СпособПередачиМашиночитаемойДоверенности = ПолучитьЗначениеСвойстваОбъектаEDI(Партнер, "СпособПередачиМашиночитаемойДоверенности");
	
	Если Не ЗначениеЗаполнено(СпособПередачиМашиночитаемойДоверенности) Тогда
		СпособПередачиМашиночитаемойДоверенности = СписокСпособПередачиМашиночитаемойДоверенности()[0].Значение;
	КонецЕсли;
	
	Возврат СпособПередачиМашиночитаемойДоверенности;
	
КонецФункции

Функция ПолучитьСписокМЧДСотрудника(ДанныеАвторизации, ИдентификаторЯщикаДиадок, ИдентификаторПользователя, ТолькоАктуальные = Ложь) Экспорт
	
	ДанныеАвторизацииДиадок = ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизации);
	СписокМЧДСотрудника = КонтурДиадокAPI_ДоверенностиПользователя(ДанныеАвторизацииДиадок, ИдентификаторЯщикаДиадок, ИдентификаторПользователя, ТолькоАктуальные, Истина);
	
	МашиночитаемыеДоверенностиСотрудника = СписокМЧДСотрудника.МашиночитаемыеДоверенности;
	
	Для Каждого ТекущаяМЧД Из МашиночитаемыеДоверенностиСотрудника Цикл
		МашиночитаемаяДоверенностьСотрудника = ТекущаяМЧД.МашиночитаемаяДоверенность;
		МашиночитаемаяДоверенностьСотрудника.ДатаНачала = КонтурСтандарт_Ticks_to_Date(МашиночитаемаяДоверенностьСотрудника.ДатаНачала.КоличествоТиков); 	
		МашиночитаемаяДоверенностьСотрудника.СрокДействия = КонтурСтандарт_Ticks_to_Date(МашиночитаемаяДоверенностьСотрудника.СрокДействия.КоличествоТиков); 				
	КонецЦикла;
	
	Возврат МашиночитаемыеДоверенностиСотрудника;	
	
КонецФункции

Функция ОписаниеПользователяДиадок(ДанныеАвторизации) Экспорт    
	
	ДанныеАвторизацииДиадок = ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизации);
	Попытка
		Ответ = КонтурДиадокAPI_ИнформацияТекущегоПользователя(ДанныеАвторизацииДиадок);	
	    Результат = Новый Структура("Успешно, Значение" , Истина , Ответ);
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		Результат = Новый Структура("Успешно, Значение" , Ложь , ОписаниеОшибки);
	КонецПопытки;
	
	Возврат Результат;
		
КонецФункции

Функция ИдентификаторЯщикаДиадок(ДанныеАвторизации, ИдентификаторОрганизацииДиадок) Экспорт
	
	Организация = ДанныеАвторизации.Организация;	
	DiadocBoxId = ПолучитьЗначениеСвойстваОбъектаEDI(Организация, "DiadocBoxId");
	
	Если НЕ ЗначениеЗаполнено(DiadocBoxId) Тогда
		
		ОписаниеОрганизации = ОписаниеОрганизацииДиадок(ДанныеАвторизации, ИдентификаторОрганизацииДиадок);
		DiadocBoxId = ОписаниеОрганизации.Значение.Boxes[0].BoxId;
		УстановитьЗначениеСвойстваОбъекта(Организация, "DiadocBoxId", DiadocBoxId);		
		
	КонецЕсли;
	
	Возврат DiadocBoxId;	
	
КонецФункции

Функция ОписаниеОрганизацииДиадок(ДанныеАвторизации, ИдентификаторОрганизацииДиадок) Экспорт  
	
	ДанныеАвторизацииДиадок = ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизации);
	
	Попытка
		Ответ = КонтурДиадокAPI_Организации(ДанныеАвторизацииДиадок, ИдентификаторОрганизацииДиадок);	
	    Результат = Новый Структура("Успешно, Значение" , Истина , Ответ);
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		Результат = Новый Структура("Успешно, Значение" , Ложь , ОписаниеОшибки);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Процедура ВыполнитьОбработкуПодписанногоДокумента_КонтурEDI(СчетФактураКПодписи) 
	
	СменитьСтатусСообщенияНаПодписанВДиадок = (СчетФактураКПодписи.isDraft = Ложь);
	
	Если ЗначениеЗаполнено(СчетФактураКПодписи.messageId_new) Тогда 
		УстановитьЗначениеСвойстваОбъекта(СчетФактураКПодписи.Документ, "messageId", СчетФактураКПодписи.messageId_new);	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СчетФактураКПодписи.torg12Id_new) Тогда 
		УстановитьЗначениеСвойстваОбъекта(СчетФактураКПодписи.Документ, "torg12Id", СчетФактураКПодписи.torg12Id_new);	
		СменитьСтатусСообщенияНаПодписанВДиадок = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СчетФактураКПодписи.invoiceId_new) Тогда 
		УстановитьЗначениеСвойстваОбъекта(СчетФактураКПодписи.Документ, "invoiceId", СчетФактураКПодписи.invoiceId_new);	
		СменитьСтатусСообщенияНаПодписанВДиадок = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СчетФактураКПодписи.UniversalTransferDocumentId_new) Тогда 
		УстановитьЗначениеСвойстваОбъекта(СчетФактураКПодписи.Документ, "UniversalTransferDocumentId", СчетФактураКПодписи.UniversalTransferDocumentId_new);	
		СменитьСтатусСообщенияНаПодписанВДиадок = Истина;
	КонецЕсли;
	
	Если СменитьСтатусСообщенияНаПодписанВДиадок Тогда 
		
		СвойстваДляЗаписи = Новый Структура("isDraft, DraftOfDocumentPackageSignedByMe", СчетФактураКПодписи.isDraft, Истина);					
		ЗаписатьДопРеквизитСправочника_КонтурEDI(СчетФактураКПодписи.Ссылка, СвойстваДляЗаписи);        					
		УстановитьСтатусСообщения(СчетФактураКПодписи.Ссылка,  , "INVOIC", "ИсходящийПодписанВДиадок"); 
		
		Партнер = ?(ВнешнееХранилище, СоединениеСХранилищем.ЗначениеИзСтрокиВнутр(СчетФактураКПодписи.Ссылка).Партнер, СчетФактураКПодписи.Ссылка.Партнер); 
		
		ПроставитьПризнакОтправкиALCRPT_ПослеПодписанияВДиадок(СчетФактураКПодписи.Документ, Партнер);
		
	Иначе
		
		СообщениеОбъект        = СчетФактураКПодписи.Ссылка.ПолучитьОбъект();
		СообщениеОбъект.Статус = "Ожидает отправки";
		СохранитьОбъектСообщения(СообщениеОбъект);
		
	КонецЕсли;
	
КонецПроцедуры  

Функция Токен(ДанныеАвторизации, ИспользоватьКэш = Истина)
	
    Токен = Неопределено;
	
	Если ДанныеАвторизации.ТипАвторизации = "ЛогинПароль" Тогда
		Ключ = ДанныеАвторизации.ЛогинДД;		
	ИначеЕсли ДанныеАвторизации.ТипАвторизации = "Сертификат" Тогда
		Ключ = ДанныеАвторизации.Отпечаток;	
	КонецЕсли;
	
	Если Токены = Неопределено Тогда
		Токены = Новый Соответствие;
	КонецЕсли;
	
	Если ИспользоватьКэш Тогда	
		Если Не Токены = Неопределено Тогда
			Токен = Токены.Получить(Ключ);
		КонецЕсли;
	КонецЕсли;
		
	Если Токен = Неопределено Тогда
		
		Если ДанныеАвторизации.ТипАвторизации = "ЛогинПароль" Тогда
			
			Ответ = DD_API_Authenticate(, ДанныеАвторизации.ЛогинДД, ДанныеАвторизации.ПарольДД);
			
			Если Ответ.КодСостояния <> "200" Тогда
				
				ОписаниеОшибки = "Ошибка HTTP запроса"
				+ ?(ЗначениеЗаполнено(Ответ.КодСостояния), Символы.ПС + Ответ.КодСостояния, "")
				+ ?(ЗначениеЗаполнено(Ответ.ТелоОтвета)  , Символы.ПС + Ответ.ТелоОтвета  , "");
				
				ВызватьИсключение ОписаниеОшибки;
				
			КонецЕсли;
			
			Токен = Ответ.ТелоОтвета;
			
		ИначеЕсли ДанныеАвторизации.ТипАвторизации = "Сертификат" Тогда
			
			ТелоЗапроса = ПолучитьСертификат1СПоОтпечатку_КонтурEDI(ДанныеАвторизации, Истина);
			
			Ответ = DD_API_Authenticate(ТелоЗапроса);
			
			Если Ответ.КодСостояния <> "200" Тогда
				
				ОписаниеОшибки = "Ошибка HTTP запроса"
				+ ?(ЗначениеЗаполнено(Ответ.КодСостояния), Символы.ПС + Ответ.КодСостояния, "")
				+ ?(ЗначениеЗаполнено(Ответ.ТелоОтвета)  , Символы.ПС + Ответ.ТелоОтвета  , "");
				
				ВызватьИсключение ОписаниеОшибки;
				
			КонецЕсли;
			
			Токен = РасшифроватьЗашифрованныйТокен_КонтурEDI(Ответ.ТелоОтвета, ДанныеАвторизации);

		КонецЕсли;

		Токены.Вставить(Ключ, Токен);
	
	КонецЕсли;
	
	Возврат Токен;
	
КонецФункции

Функция ПолучитьMessage(BoxId, MessageId, ДанныеАвторизации, ВозвращатьСодержимоеСущностей = Истина)
	
	ДанныеАвторизацииДиадок = ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизации);
	Результат = КонтурДиадокAPI_СодержимоеСообщения(ДанныеАвторизацииДиадок, BoxId, MessageId, "", "", ВозвращатьСодержимоеСущностей);
	
	Возврат Результат;
	
КонецФункции 

Функция SignerContent(ДанныеАвторизации, BoxId)
	
	МашиночитаемаяДоверенностьДляОтправки = МашиночитаемаяДоверенностьДляОтправки(ДанныеАвторизации);
	
	CertificateBytes = ПолучитьСертификат1СПоОтпечатку_КонтурEDI(ДанныеАвторизации, Истина);
	CertificateThumbprint = ДанныеАвторизации.Отпечаток;

	ДвоичныеДанныеBase64 = XML_УниверсальныйПодписант(BoxId, CertificateBytes, CertificateThumbprint, МашиночитаемаяДоверенностьДляОтправки);
	
	Возврат ДвоичныеДанныеBase64;
	
КонецФункции 

Функция SignerContent970(ДанныеАвторизации, BoxId)
	
	CertificateBytes = ПолучитьСертификат1СПоОтпечатку_КонтурEDI(ДанныеАвторизации, Истина);
	CertificateThumbprint = ДанныеАвторизации.Отпечаток;
	
	Если Не ЗначениеЗаполнено(ДанныеАвторизации.СвойстваСертификата) Тогда
		ДанныеАвторизации.СвойстваСертификата = ПолучитьСвойстваСертификата_КонтурEDI(ДанныеАвторизации);
	КонецЕсли;
	
	ИННОрганизацииДиадок = ПолучитьИННЯщикаДиадок(BoxId, ДанныеАвторизации);
	
	КонтентПодписантаBase64 = XML_УниверсальныйПодписант970(BoxId, CertificateBytes, CertificateThumbprint, ДанныеАвторизации, ИННОрганизацииДиадок);
	
	Возврат КонтентПодписантаBase64	
	
КонецФункции

Функция SignerContentИоП(ДанныеАвторизации)
	
	МашиночитаемаяДоверенностьДляОтправки = МашиночитаемаяДоверенностьДляОтправки(ДанныеАвторизации);
	
	CertificateBytes = ПолучитьСертификат1СПоОтпечатку_КонтурEDI(ДанныеАвторизации, Истина);
