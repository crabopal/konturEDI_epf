Функция ШаблонКлиентскогоОбработчикаОткрытьИнструкцию_КонтурEDI()
	
	Перем ТипИспользуемыхФорм;
	
	ПараметрыКлиентСервер.Свойство("ТипИспользуемыхФорм", ТипИспользуемыхФорм);
	
	Если ТипИспользуемыхФорм = "Управляемые" Тогда
		
		ШаблонОбработчика = "СвойстваКнопки = Новый Структура(""Имя,Действие"",""%1"",""%1"");
							|АдресСтраницы = Объект.ПараметрыКлиентСервер.URLАдреса[""%2""];
							|МодульОбъектаКлиент().ОткрытьИнструкциюКлиент(СвойстваКнопки, ЭтаФорма, АдресСтраницы);";
		
	Иначе
		
		ШаблонОбработчика = "СвойстваКнопки = Новый Структура(""Имя"",""%1"");
							|КонтекстКлиентМетрика = НоваяМетрика().НажатаКнопка(СвойстваКнопки).НаФорме(ЭтаФорма);
							|АдресСтраницы = ПараметрыКлиентСервер.URLАдреса[""%2""];
							|ОткрытьИнструкцию(АдресСтраницы, КонтекстКлиентМетрика);";	
	КонецЕсли;
	
	Возврат ШаблонОбработчика;
		
КонецФункции

Функция ПолучитьДанныеУведомленияПользователяПоОтправкеМодуляНаFTP_КонтурEDI()
	
	Перем КлиентскийОбработчик, ШаблонКлиентскогоОбработчика, ПараметрыОбработчиков;
	Перем ПараметрыУниверсальныйДиалог, ПараметрыУведомления;
	
	ДанныеУведомления = Новый Структура;	
	
	ЗаголовокУведомления = "Не удалось отправить модуль для анализа.
						   |Для отправки модуля в техническую поддержку по почте воспользуйтесь инструкциями.";
	
	ДанныеУведомления.Вставить("Заголовок", ЗаголовокУведомления);
			
	ПараметрыУведомления = Новый Соответствие;
	
	ПараметрыУведомления.Вставить("Инструкция по выгрузке модуля Контур.EDI", 
								  Новый Структура("ОткрытьИнструкциюВыгрузкаМодуляКонтурEDI", "ВыгрузкаМодуляКонтурEDI"));
								
	
	ПараметрыУведомления.Вставить("Инструкция по выгрузке Расширений и Подключаемого модуля", 
								  Новый Структура("ОткрытьИнструкциюВыгрузкаРасширенийИПМ", "ВыгрузкаРасширенийИПМ"));
	
	ШаблонКлиентскогоОбработчика = ШаблонКлиентскогоОбработчикаОткрытьИнструкцию_КонтурEDI();
	
	МассивУведомлений = Новый Массив;
	
	Для Каждого Элемент Из ПараметрыУведомления Цикл
				
		ТекстУведомления		= Элемент.Ключ;
		ПараметрыОбработчиков	= Элемент.Значение;
		
		Для каждого КлючЗначение Из ПараметрыОбработчиков Цикл
						
			ИмяКнопки     = КлючЗначение.Ключ;
			КлючURLАдреса = КлючЗначение.Значение;
			
			КлиентскийОбработчик = КонтурСтандарт_СтрШаблон_(ШаблонКлиентскогоОбработчика, ИмяКнопки, КлючURLАдреса);
			
		КонецЦикла;
		
		ПараметрыУниверсальныйДиалог = УниверсальныйДиалог_Уведомление(ТекстУведомления,, КлиентскийОбработчик, "Открыть инструкцию");
		
		МассивУведомлений.Добавить(ПараметрыУниверсальныйДиалог);
		
	КонецЦикла;
	
	ДанныеУведомления.Вставить("МассивУведомлений", МассивУведомлений);
	
	Возврат ДанныеУведомления;
	
КонецФункции

// Возвращаемое значение:
//  Структура:
//   * Ключ 	- Строка - Текущее действие   
//   * Значение - Строка - Следующее действие
//
Функция ПорядокДействийПриПодготовкеФайловДляОтправкиНаFTP_КонтурEDI()

	Структура = Новый Структура;
	Структура.Вставить("ПолучитьДанныеМодуля"					, "ПолучитьДанныеПодключаемогоМодуля");
	Структура.Вставить("ПолучитьДанныеРасширенияКонфигурации"	, "ПолучитьДанныеПодключаемогоМодуля");
	Структура.Вставить("ПолучитьДанныеПодключаемогоМодуля"		, "ПолучитьДанныеНастроекРасширений");
	Структура.Вставить("ПолучитьДанныеНастроекРасширений"		, "ПолучитьДанныеНастроекМодуляИПартнеров");
	Структура.Вставить("ПолучитьДанныеНастроекМодуляИПартнеров"	, "ПодготовитьФайлАрхива");
	Структура.Вставить("ПодготовитьФайлАрхива"					, "ОтправитьНаFTP");
		
	Возврат Структура;
	
КонецФункции

Процедура ОпределитьНачальноеДействиеПодготовкиФайловДляОтправкиНаFTP_КонтурEDI(ПараметрыПодготовки)
	
	ВариантыРасположенияМодуля = ПеречисленияEDI_ВариантыРасположенияМодуля();
		
	РасположенияМодуля = ОпределитьРасположениеМодуля_КонтурEDI();
			
	Если РасположенияМодуля = ВариантыРасположенияМодуля.Файл 
		ИЛИ РасположенияМодуля = ВариантыРасположенияМодуля.Справочник Тогда
		
		ПараметрыПодготовки.Действие = "ПолучитьДанныеМодуля";		
		ПараметрыПодготовки.Вставить("РасположенияМодуля", РасположенияМодуля);		
		
	ИначеЕсли РасположенияМодуля = ВариантыРасположенияМодуля.Расширение Тогда
		
		ПараметрыПодготовки.Действие = "ПолучитьДанныеРасширенияКонфигурации";
		ПараметрыПодготовки.Вставить("РасположенияМодуля", РасположенияМодуля);
		
	Иначе
		
		ТекстОшибки = НСтр("ru = 'Не удалось определить месторасположение модуля.'");
		
		ОпределитьСледующееДействиеПодготовкиФайловДляОтправкиНаFTP_КонтурEDI(ПараметрыПодготовки, ТекстОшибки, Ложь);
		
	КонецЕсли;	
	
КонецПроцедуры

Процедура ОпределитьСледующееДействиеПодготовкиФайловДляОтправкиНаFTP_КонтурEDI(ПараметрыПодготовки, ТекстОшибки = "", ДанныеФайлаПолучены = Истина)
		
	Если ДанныеФайлаПолучены Тогда	
			
		ТекущееДействие = ПараметрыПодготовки.Действие;
		
		ПорядокДействий = ПорядокДействийПриПодготовкеФайловДляОтправкиНаFTP_КонтурEDI();
		
		ПараметрыПодготовки.Действие = ПорядокДействий[ТекущееДействие];
		
	Иначе
		
		ПараметрыПодготовки.ФайлыАрхива = Неопределено;
		ПараметрыПодготовки.Действие	= "ПоказатьУведомлениеПользователю";		
		ПараметрыПодготовки.Успешно		= Ложь;		
	    ПараметрыПодготовки.ТекстОшибки	= ТекстОшибки;
		
		ПараметрыПодготовки.ДанныеУведомления = ПолучитьДанныеУведомленияПользователяПоОтправкеМодуляНаFTP_КонтурEDI();
				
	КонецЕсли;
	
КонецПроцедуры

Процедура ПодготовитьФайлыМодуляИНастроекДляПомещенияВФайлАрхива_КонтурEDI(АдресФайлаОбработкиКлиент, ПараметрыПодготовки)
						
	ОпределитьНачальноеДействиеПодготовкиФайловДляОтправкиНаFTP_КонтурEDI(ПараметрыПодготовки);
	
	Если ПараметрыПодготовки.Действие = "ПолучитьДанныеМодуля" Тогда
		
		Результат = ПолучитьДвоичныеДанныеФайлаМодуля_КонтурEDI(ПараметрыПодготовки.РасположенияМодуля, АдресФайлаОбработкиКлиент);
		
		Если Результат.Успешно Тогда
			
			ЗаполнитьСвойстваОбъектаФайл_КонтурEDI(ПараметрыПодготовки.ФайлыАрхива, 
												   Результат.ДвоичныеДанные, 
												   "КонтурEDI_Модуль.epf");						
		
		КонецЕсли;
		
		ОпределитьСледующееДействиеПодготовкиФайловДляОтправкиНаFTP_КонтурEDI(ПараметрыПодготовки, Результат.ТекстОшибки, Результат.Успешно);
																			  		
	КонецЕсли;
	
	Если ПараметрыПодготовки.Действие = "ПолучитьДанныеРасширенияКонфигурации" Тогда
		
		Результат = ПолучитьДвоичныеДанныеФайлаРасширенияКонфигурации_КонтурEDI(ПараметрыПодготовки.РасположенияМодуля);
		
		Если Результат.Успешно Тогда
			
			ЗаполнитьСвойстваОбъектаФайл_КонтурEDI(ПараметрыПодготовки.ФайлыАрхива, 
												   Результат.ДвоичныеДанные, 
												   "КонтурEDI_РасширениеКонфигурации.cfe");								   
				
		КонецЕсли;
		
		ОпределитьСледующееДействиеПодготовкиФайловДляОтправкиНаFTP_КонтурEDI(ПараметрыПодготовки, Результат.ТекстОшибки, Результат.Успешно);
		
	КонецЕсли;
		
	Если ПараметрыПодготовки.Действие = "ПолучитьДанныеПодключаемогоМодуля" Тогда
		
		Если ИспользуетсяПодключаемыйМодуль Тогда
			
			Результат = ПолучитьДвоичныеДанныеФайлаПодключаемыйМодуль_КонтурEDI();
		
			Если Результат.Успешно Тогда
			
				ЗаполнитьСвойстваОбъектаФайл_КонтурEDI(ПараметрыПодготовки.ФайлыАрхива, 
													   Результат.ДвоичныеДанные, 
													   "КонтурEDI_ПодключаемыйМодуль.epf");
			
			КонецЕсли;
															
		КонецЕсли;
	
		ОпределитьСледующееДействиеПодготовкиФайловДляОтправкиНаFTP_КонтурEDI(ПараметрыПодготовки, Результат.ТекстОшибки, Результат.Успешно);
		
	КонецЕсли;
		
	Если ПараметрыПодготовки.Действие = "ПолучитьДанныеНастроекРасширений" Тогда
		
		ТаблицаУстановленныхРасширений = ПолучитьИнформациюОбУстановленныхРасширениях();
		
		Если ТаблицаУстановленныхРасширений.Количество() Тогда
													   
			Результат = ПолучитьДвоичныеДанныеФайлаАрхиваРасширенийМодуля_КонтурEDI(ТаблицаУстановленныхРасширений);
			
			Если Результат.Успешно Тогда
				
				ЗаполнитьСвойстваОбъектаФайл_КонтурEDI(ПараметрыПодготовки.ФайлыАрхива, 
													   Результат.ДвоичныеДанные,
													   "КонтурEDI_Расширения.zip");
													   
				Результат = ПолучитьДвоичныеДанныеФайлаМетаданныхРасширенийМодуля_КонтурEDI(ТаблицаУстановленныхРасширений);
			
				Если Результат.Успешно Тогда
				
					ЗаполнитьСвойстваОбъектаФайл_КонтурEDI(ПараметрыПодготовки.ФайлыАрхива, 
														   Результат.ДвоичныеДанные,
														   "КонтурEDI_СписокРасширений.txt");
				
				КонецЕсли;													   
				
			КонецЕсли;
																   
		КонецЕсли;
		
		ОпределитьСледующееДействиеПодготовкиФайловДляОтправкиНаFTP_КонтурEDI(ПараметрыПодготовки, Результат.ТекстОшибки, Результат.Успешно);
		
	КонецЕсли;
	
	Если ПараметрыПодготовки.Действие = "ПолучитьДанныеНастроекМодуляИПартнеров" Тогда
		
		Результат = ПолучитьДвоичныеДанныеФайлаНастроекМодуля_КонтурEDI();
		
		Если Результат.Успешно Тогда
			
			ЗаполнитьСвойстваОбъектаФайл_КонтурEDI(ПараметрыПодготовки.ФайлыАрхива, 
												   Результат.ДвоичныеДанные,
												   "КонтурEDI_НастройкиМодуля.txt");														   
			
		КонецЕсли;
		
		Результат = ПолучитьДвоичныеДанныеФайлаНастроекПартнеров_КонтурEDI();
		
		Если Результат.Успешно Тогда
			
			ЗаполнитьСвойстваОбъектаФайл_КонтурEDI(ПараметрыПодготовки.ФайлыАрхива, 
												   Результат.ДвоичныеДанные,
												   "КонтурEDI_НастройкиПартнеров.txt");
			
		КонецЕсли;
		
		ОпределитьСледующееДействиеПодготовкиФайловДляОтправкиНаFTP_КонтурEDI(ПараметрыПодготовки);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьФайлАрхиваМодуляСНастройкамиДляОтправкиНаFTP_КонтурEDI(АдресФайлаОбработкиКлиент)
	
	Результат = Новый Структура;
	Результат.Вставить("Успешно"			, Истина);
	Результат.Вставить("ТекстОшибки"		, "");
	Результат.Вставить("ДанныеУведомления"	, Новый Структура);
	Результат.Вставить("Действие"			, "");
	Результат.Вставить("ФайлыАрхива"		, Новый Массив);
	Результат.Вставить("ФайлАрхива"			, Новый Структура("Имя,ПутьНаДиске,АдресВременногоХранилища"));
		
	ПодготовитьФайлыМодуляИНастроекДляПомещенияВФайлАрхива_КонтурEDI(АдресФайлаОбработкиКлиент, Результат);
	
	Если Результат.Действие = "ПодготовитьФайлАрхива" Тогда
		ПодготовитьФайлАрхиваМодуляСНастройкамиДляОтправкиНаFTP_КонтурEDI(Результат);		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОтправитьМодульСНастройкамиНаFTP_КонтурEDI(АдресФайлаОбработкиКлиент = Неопределено) Экспорт
	
	Результат = ПолучитьФайлАрхиваМодуляСНастройкамиДляОтправкиНаFTP_КонтурEDI(АдресФайлаОбработкиКлиент);
			
	Если Результат.Действие = "ОтправитьНаFTP" Тогда
		
		ПередатьФайлАрхиваСМодулемИНастройкамиНаFTP_КонтурEDI(Результат); 
		
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

Функция ПараметрыИнтернетСоединенияСлужебныйFTP_KонтурEDI()
	
	Результат = ПолучитьСписокСвойствEDI("Сервер
										 |Порт
										 |ПассивныйРежим");
	
	Если НЕ ЗначениеЗаполнено(Результат.Сервер) Тогда
		Результат.Сервер = "ftp-edi.kontur.ru";
	КонецЕсли;
		
	Если НЕ ЗначениеЗаполнено(Результат.Порт) Тогда
		Результат.Порт = 21;
	КонецЕсли;
	
	Если Результат.ПассивныйРежим = Неопределено Тогда
		Результат.ПассивныйРежим = Истина;
	КонецЕсли;
	
	Результат.Вставить("Таймаут", 20);
	
	ДвоичныеДанные = ПолучитьФайл_EDI("/1c/KonturEDI_82/templates/edi_settings_service_ftp.txt");
	
	СтрокаBase64 = КонтурСтандарт_ПолучитьСтрокуИзДвоичныхДанных_(ДвоичныеДанные);
	
	ПараметрыАвторизации = КонтурСтандарт_ПолучитьСтрокуИзДвоичныхДанных_(Base64Значение(СтрокаBase64));
	
	ПараметрыАвторизации = СтрЗаменить(ПараметрыАвторизации, "@@", Символы.ПС);
	
	РаскодированныйЛогин = СимметричноеШифрованиеТабличнымСмещением_Контур(СтрПолучитьСтроку(ПараметрыАвторизации,1),"Обратное");
	
	РаскодированныйПароль = СимметричноеШифрованиеТабличнымСмещением_Контур(СтрПолучитьСтроку(ПараметрыАвторизации,2),"Обратное");
	
	Результат.Вставить("Логин"	, РаскодированныйЛогин);
	Результат.Вставить("Пароль"	, РаскодированныйПароль);
		
	Возврат Результат;
	
КонецФункции

Процедура ПередатьФайлАрхиваСМодулемИНастройкамиНаFTP_КонтурEDI(ПараметрыОтправки)
	
	Перем Сервер, ФайлАрхива, ДвоичныеДанныеФайлаАрхива;		
	
	ФайлАрхива = ПараметрыОтправки.ФайлАрхива;
	
	Попытка
		
		ПараметрыСоединения = ПараметрыИнтернетСоединенияСлужебныйFTP_KонтурEDI();
		
		Сервер			= ПараметрыСоединения.Сервер;
		Порт			= ПараметрыСоединения.Порт;
		Пользователь	= ПараметрыСоединения.Логин;
		Пароль			= ПараметрыСоединения.Пароль;
		ПассивныйРежим 	= ПараметрыСоединения.ПассивныйРежим;
		Таймаут			= ПараметрыСоединения.Таймаут;		
		
		Соединение = Новый FTPСоединение(СокрЛП(Сервер), Порт, Пользователь, Пароль, , ПассивныйРежим, Таймаут);
		
		Соединение.Записать(ФайлАрхива.ПутьНаДиске, "outbox/" + ФайлАрхива.Имя);
		
	Исключение
		
		ОписаниеОшибки = ОписаниеОшибки();
		
		ПараметрыОтправки.Успешно 	= Ложь;
		ПараметрыОтправки.Действие	= "ПоказатьТекстОшибкиОтправки";
		
		ПараметрыОтправки.ТекстОшибки = КонтурСтандарт_СтрШаблон_("Не удалось отправить модуль по причине: %1 %2", Символы.ПС, ОписаниеОшибки);
		
		ДвоичныеДанныеФайлаАрхива = Новый ДвоичныеДанные(ФайлАрхива.ПутьНаДиске);
		
		ФайлАрхива.АдресВременногоХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайлаАрхива, Новый УникальныйИдентификатор);
		
	КонецПопытки;

КонецПроцедуры

Процедура ПодготовитьФайлАрхиваМодуляСНастройкамиДляОтправкиНаFTP_КонтурEDI(ПараметрыПодготовки)
	
	Префикс = СокрЛП(ПолучитьКонстантуEDI("GLN_Основной"));
	
	СписокЮрЛиц = ПолучитьСписокЭлементовСправочника("ЮрФизЛицаСвои");
	
	Если СписокЮрЛиц.Количество() > 0 Тогда
		Префикс = Префикс + "_" + УбратьНедопустимыеСимволы(СокрЛП(СписокЮрЛиц[0].ЮрФизЛицо));
	КонецЕсли;
	
	ИмяАрхива = Префикс + "_" + Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd-hh-mm-ss") + ".zip";
	
	Попытка
		
		ПутьКАрхиву = КаталогВременныхФайлов() + ИмяАрхива;
		
		ЗаписьАрхива = Новый ЗаписьZipФайла(ПутьКАрхиву);
		
		МассивВременныхФайловУдалить = Новый Массив;
		
		Для каждого Файл Из ПараметрыПодготовки.ФайлыАрхива Цикл
			
			ПутьКВременномуФайлу = КаталогВременныхФайлов() + Файл.ИмяФайла;
			Файл.Данные.Записать(ПутьКВременномуФайлу);
			
			ЗаписьАрхива.Добавить(ПутьКВременномуФайлу);
			
			МассивВременныхФайловУдалить.Добавить(ПутьКВременномуФайлу);
			
		КонецЦикла;
		
		ЗаписьАрхива.Записать();
		
		ЗаполнитьЗначенияСвойств(ПараметрыПодготовки.ФайлАрхива, Новый Структура("Имя,ПутьНаДиске", ИмяАрхива, ПутьКАрхиву));
		
		ОпределитьСледующееДействиеПодготовкиФайловДляОтправкиНаFTP_КонтурEDI(ПараметрыПодготовки);
		
		ПараметрыПодготовки.ФайлыАрхива = Неопределено;
		
		Для Каждого ПолноеИмяФайла Из МассивВременныхФайловУдалить Цикл
			УдалитьФайлы_КонтурEDI(ПолноеИмяФайла);
		КонецЦикла;
		
	Исключение
				
		ТекстОшибки = НСтр("ru = 'Не удалось получить файл архива с модулем и настройками по причине: '") + ОписаниеОшибки();
		
		ОпределитьСледующееДействиеПодготовкиФайловДляОтправкиНаFTP_КонтурEDI(ПараметрыПодготовки, ТекстОшибки, Ложь);
		
	КонецПопытки;
	
КонецПроцедуры

// Обращается к справочнику с внешними обработками и возвращает список имен обработок 
// 
// Возвращаемое значение: 
//   СписокЗначений, Неопределено   - Неопределено, если нет подходящего справочника с внешними обработками 
//
Функция ПолучитьСписокДопОбработок_КонтурEDI()
	
	Перем ВыборкаОбработок, Запрос, РезультатЗапроса, СписокИменОбработок;
	
	СписокИменОбработок = Новый СписокЗначений;
	
	Запрос = Новый Запрос();
	
	Если ЕстьНеобходимыеМетаданные("Справочники.ВнешниеОбработки") Тогда
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВнешниеОбработки.Ссылка
			|ИЗ
			|	Справочник.ВнешниеОбработки КАК ВнешниеОбработки
			|ГДЕ
			|	НЕ ВнешниеОбработки.ПометкаУдаления
			|	И &УсловиеВидОбработки
			|УПОРЯДОЧИТЬ ПО
			|	ВнешниеОбработки.Наименование";
		
		Если ЕстьНеобходимыеМетаданные("Справочники.ВнешниеОбработки.Реквизиты.ВидОбработки")
			И ЕстьНеобходимыеМетаданные("Перечисления.ВидыДополнительныхВнешнихОбработок", Истина) Тогда
			
			УсловиеВидОбработки = "ВнешниеОбработки.ВидОбработки = ЗНАЧЕНИЕ(Перечисление.ВидыДополнительныхВнешнихОбработок.Обработка)";
			
		Иначе
			
			УсловиеВидОбработки = "Истина";
			
		КонецЕсли;
	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеВидОбработки", УсловиеВидОбработки);

	ИначеЕсли ЕстьНеобходимыеМетаданные("Справочники.ДополнительныеОтчетыИОбработки")  Тогда
		
		Запрос.Текст = "ВЫБРАТЬ
		|	ДополнительныеОтчетыИОбработки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки КАК ДополнительныеОтчетыИОбработки
		|ГДЕ
		|	ДополнительныеОтчетыИОбработки.Вид = &ВидОбработки";
		
		Запрос.УстановитьПараметр("ВидОбработки", Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Запрос.Текст) Тогда
		
		СписокИменОбработок = Новый СписокЗначений;
		
		ВыборкаОбработок = Запрос.Выполнить().Выбрать();
			
		Пока ВыборкаОбработок.Следующий() Цикл
				
			СписокИменОбработок.Добавить(ВыборкаОбработок.Ссылка);
				
		КонецЦикла;
		
	Иначе
		
		СписокИменОбработок = Неопределено;
		
	КонецЕсли;
	
	Возврат СписокИменОбработок;

КонецФункции

Функция ПолучитьИмяРеквизитаХраненияОбработки_КонтурEDI(МодульСсылка)
	
	Перем ИмяРеквизитаХранения, МетаданныеСправочника, Реквизит;
	
	ИмяРеквизитаХранения = "";
	
	Если ЕстьНеобходимыеМетаданные("Справочники.ВнешниеОбработки.Реквизиты.ХранилищеВнешнейОбработки") Тогда
		
		ИмяРеквизитаХранения = "ХранилищеВнешнейОбработки";
		
	ИначеЕсли  ЕстьНеобходимыеМетаданные("Справочники.ДополнительныеОтчетыИОбработки.Реквизиты.ХранилищеОбработки")  Тогда
		
		ИмяРеквизитаХранения = "ХранилищеОбработки";
		
	Иначе
		
		МетаданныеСправочника = МодульСсылка.Метаданные();
		Для Каждого Реквизит Из МетаданныеСправочника.Реквизиты Цикл
			
			Если Реквизит.Тип.СодержитТип(Тип("ХранилищеЗначения")) Тогда
				ИмяРеквизитаХранения = Реквизит.Имя;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;    
		
	КонецЕсли;
	
	Возврат ИмяРеквизитаХранения;

КонецФункции

Функция УбратьНедопустимыеСимволы(Значение)
	
	Результат = СтрЗаменить(Значение, "\", "");
	Результат = СтрЗаменить(Результат, "/", "");
	Результат = СтрЗаменить(Результат, "~", "");
	Результат = СтрЗаменить(Результат, "`", "");
	Результат = СтрЗаменить(Результат, "!", "");
	Результат = СтрЗаменить(Результат, "|", "");
	Результат = СтрЗаменить(Результат, ".", "");
	Результат = СтрЗаменить(Результат, """", "");
	Результат = СтрЗаменить(Результат, "?", "");
	Результат = СтрЗаменить(Результат, "*", "");
	Результат = СтрЗаменить(Результат, ":", "");
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаписьЖурналаРегистрации_КонтурEDI(УровеньСобытия, Комментарий, Данные = Неопределено) Экспорт
	
	Если ПараметрыКлиентСервер.ЗаписыватьОшибкиВЖурналРегистрации = Истина Тогда
		
		ЗаписьЖурналаРегистрации("Контур.EDI", УровеньСобытия,, Данные, Комментарий);
		
	КонецЕсли;
	
КонецПроцедуры

// #КонецОбласти //ОтправкаМодуляНаАнализВКонтур

// #Область Заполнение_элементов_справочников
Процедура ЗаполнитьНовуюНоменклатуру_КонтурEDI(НоменклатураОбъект, Сообщение, СтрокаСообщения, УникальныйИдентификторНовойСсылки, ИмяСправочникаНоменклатуры) Экспорт
	
	Если ЗначениеЗаполнено(УникальныйИдентификторНовойСсылки) Тогда	
		НоваяСсылка = Справочники[ИмяСправочникаНоменклатуры].ПолучитьСсылку(УникальныйИдентификторНовойСсылки);	
		НоменклатураОбъект.УстановитьСсылкуНового(НоваяСсылка);
	КонецЕсли;
		
	НоменклатураОбъект.Наименование	= СтрокаСообщения.Наименование;
	
	ОбработкаСобытияПодключаемогоМодуля("ЗаполнитьЭлементСправочника",
										,
										Новый Структура("ОбъектСправочник,Сообщение,СтрокаТоваров,ИмяСправочника"
														, НоменклатураОбъект, Сообщение, СтрокаСообщения, ИмяСправочникаНоменклатуры)
										);
	
КонецПроцедуры
// #КонецОбласти //Заполнение элементов справочников

// #Область Входящее_независимое_сообщение
Процедура ОбработатьВходящееНезависимоеСообщение(Сообщение) Экспорт
	
	СтандартнаяОбработкаEDI = Истина;
	
	ОбработкаСобытияПодключаемогоМодуля("ОбработатьВходящееНезависимоеСообщение", СтандартнаяОбработкаEDI,	Новый Структура("Сообщение", Сообщение));
										
	Если СтандартнаяОбработкаEDI = Истина Тогда
		
		СохранитьСообщение(Сообщение, "Загружен");
		
	КонецЕсли;
	
КонецПроцедуры
// #КонецОбласти //Входящее независимое сообщение

// #Область Особенности_на_форме
Процедура ЗаполнитьОсобенностиСообщенияНаФорме_УФ(Форма) Экспорт

	Форма.Особенности.Очистить();

	// штатный обход таблицы особенностей
	Для каждого ОсобенностьСообщения Из ОсобенностиСообщений Цикл
		
		Если НЕ ОсобенностьВыводитсяВКарточкуСообщения(ОсобенностьСообщения, Форма.Сообщение) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭтоОсобенностьТоваров(ОсобенностьСообщения) Тогда
			
			// Пока не умеем выводить сложные особенности в товарах
			Если ЭтоОсобенностьСложногоТипа(ОсобенностьСообщения.ТипЗначенияEDI) Тогда
				Продолжить;
			КонецЕсли;
			
			ДобавитьОсобенностьТоваров(ОсобенностьСообщения, Форма);
			
		Иначе
			
			ДобавитьОсобенностьШапки(ОсобенностьСообщения, Форма);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Форма.Особенности.Количество() = 0 Тогда
		Форма.Элементы.СтраницаОсобенности.Видимость = Ложь;
	Иначе
		Форма.Элементы.СтраницаОсобенности.Видимость = Истина;
		Форма.Элементы.СтраницаОсобенности.Заголовок = "Особенности (" + Форма.Особенности.Количество() + ")";
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьОсобенностьШапки(Особенность, Форма) // Особенность - строка таблицы Особенностей
	
	// в таблицу Особенности
	НоваяОсобенность = Форма.Особенности.Добавить();
	НоваяОсобенность.Наименование 	= Особенность.Наименование;
	НоваяОсобенность.Идентификатор 	= Особенность.Идентификатор;
	НоваяОсобенность.ИмяТаблицы 	= Особенность.ИмяТаблицы;
	НоваяОсобенность.Подсказка 		= Особенность.ПодробноеОписание;
	
	НоваяОсобенность.ЭтоСтруктура 	= Особенность.ЭтоСтруктура;
	НоваяОсобенность.ИмяСтруктуры 	= Особенность.ИмяСтруктуры;
	
	НоваяОсобенность.НеСохранятьВСообщение 	= Особенность.НеСохранятьВСообщение;
	
	ПолныйПутьОсобенности = ПолучитьПолныйПутьОсобенностиСообщения(Особенность);
	
	ЗначениеСвойстваСообщения = Неопределено;
	ПроверитьСвойствоПоляВСтруктуре(Форма.Сообщение, ПолныйПутьОсобенности, ЗначениеСвойстваСообщения); 
	
	Если Не ЗначениеЗаполнено(ЗначениеСвойстваСообщения) Тогда
		
		Дефолт = ПолучитьПустоеЗначениеОсобенности(Особенность);
		Если НЕ Дефолт = Неопределено Тогда
			ЗначениеСвойстваСообщения = Дефолт;
			
			Если ТипЗнч(ЗначениеСвойстваСообщения) = Тип("СписокЗначений") Тогда
				
				ЗначениеСвойстваСообщения.ТипЗначения = ТипЗначенийСпискаИзОсобенности_КонтурEDI(Особенность);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Особенность.СписокВыбора) Тогда
		НоваяОсобенность.СписокВыбора = Особенность.СписокВыбора;
	КонецЕсли;
	
	ТипОсобенности = ОпределитьИмяТипаЗначенияСложногоТипа(ЗначениеСвойстваСообщения);
	Если НЕ ТипОсобенности = Неопределено Тогда
		НоваяОсобенность.ТипЗначения = ТипОсобенности;
	Иначе
		НоваяОсобенность.Значение = ЗначениеСвойстваСообщения;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьОсобенностьТоваров(Особенность, Форма)
	
	// создать колонку и привязать данные
	
	ТипЗначенияКолонкиОсобенность = ПолучитьТипОсобенности(Особенность);
	
	ПолныйИдентификаторОсобенности = Особенность.ПолныйИдентификаторОсобенности;
	
	Если Особенность.Ревенство1СEDI = Неопределено Тогда
		ПолныйИдентификаторОсобенности = ПолныйИдентификаторОсобенности + "1С";
	КонецЕсли;
	
	ДобавитьОсобенностьТоваровНаФорму(Особенность, ПолныйИдентификаторОсобенности, ТипЗначенияКолонкиОсобенность, Форма); 
	
	КолонкаНаФорме = Форма.Элементы.Найти("Товары" + ПолныйИдентификаторОсобенности);
	
	Если КолонкаНаФорме = Неопределено Тогда
		
		НоваяКолонкаНаФорме = Форма.Элементы.Добавить("Товары" + ПолныйИдентификаторОсобенности, Тип("ПолеФормы"), Форма.Элементы.Товары);
		
		УстановитьЭлементУправленияОсобенностью(НоваяКолонкаНаФорме, Особенность, ПолныйИдентификаторОсобенности, ТипЗначенияКолонкиОсобенность, Форма); 
		
		Если ЗначениеЗаполнено(Особенность.СписокВыбора) Тогда
			ПеренестиСписокВыбораОсобенностиНаФорму(НоваяКолонкаНаФорме, Особенность);   
		КонецЕсли;
		
	КонецЕсли;
	
	// значение туда положит механизм  ЗаполнитьПоляНаФорме()
	
КонецПроцедуры

Процедура ПеренестиСписокВыбораОсобенностиНаФорму(НоваяКолонкаНаФорме, Особенность) Экспорт
		
	ШиринаКолонки = 15;
	
	Если ПеременнаяСодержитСвойство(НоваяКолонкаНаФорме, "СписокВыбора") Тогда
		
		НоваяКолонкаНаФорме.РедактированиеТекста = Ложь;
		СписокВыбора = НоваяКолонкаНаФорме.СписокВыбора;
		
	ИначеЕсли ПеременнаяСодержитСвойство(НоваяКолонкаНаФорме, "ЭлементУправления") 
		И ПеременнаяСодержитСвойство(НоваяКолонкаНаФорме.ЭлементУправления, "СписокВыбора") Тогда	
		
		НоваяКолонкаНаФорме.ЭлементУправления.КнопкаСпискаВыбора = Истина;
		НоваяКолонкаНаФорме.ЭлементУправления.РежимВыбораИзСписка = Истина;
		НоваяКолонкаНаФорме.ЭлементУправления.РедактированиеТекста = Ложь;
		
		СписокВыбора = НоваяКолонкаНаФорме.ЭлементУправления.СписокВыбора;
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	Для каждого Эл Из Особенность.СписокВыбора Цикл 		
		
		СписокВыбора.Добавить(Эл.Значение, Эл.Представление);
		
		Если ЗначениеЗаполнено(Эл.Представление) Тогда
			ШиринаКолонки = Макс(СтрДлина(Эл.Представление), ШиринаКолонки);
		ИначеЕсли ТипЗнч(Эл.Значение) = Тип("Строка") Тогда
			ШиринаКолонки = Макс(СтрДлина(Эл.Значение), ШиринаКолонки);
		Иначе
			ЗначениеСтрокой = Строка(Эл.Значение);
			ШиринаКолонки = Макс(СтрДлина(ЗначениеСтрокой), ШиринаКолонки); 
		КонецЕсли;
		
	КонецЦикла;
	
	НоваяКолонкаНаФорме.Ширина = Мин(ШиринаКолонки, 40);

КонецПроцедуры

Процедура УстановитьЭлементУправленияОсобенностью(
	НоваяКолонкаНаФорме, 
	Особенность, 
	ПолныйИдентификаторОсобенности, 
	ТипЗначенияКолонкиОсобенность, 
	Форма)
	
	Если ТипЗначенияКолонкиОсобенность = Новый ОписаниеТипов("Булево") Тогда
		НоваяКолонкаНаФорме.Вид = ВидПоляФормы.ПолеФлажка; 
	Иначе
		НоваяКолонкаНаФорме.Вид = ВидПоляФормы.ПолеВвода; 
		НоваяКолонкаНаФорме.Ширина = 15;
	КонецЕсли;
	
	НоваяКолонкаНаФорме.ПутьКДанным = "Товары." + ПолныйИдентификаторОсобенности;
	НоваяКолонкаНаФорме.Заголовок	= Особенность.Наименование;
	НоваяКолонкаНаФорме.Подсказка 	= 
	"Эта колонка добавлена из-за особенности партнера: """ + Особенность.Наименование + """";
	НоваяКолонкаНаФорме.КартинкаШапки = Форма.Элементы.СтраницаОсобенности.Картинка;	
	НоваяКолонкаНаФорме.УстановитьДействие("ПриИзменении", "ПеренестиОсобенностиИПерепроверитьСообщение");
	
	Если ПеременнаяСодержитСвойство(НоваяКолонкаНаФорме, "ДоступныеТипы") Тогда
		НоваяКолонкаНаФорме.ДоступныеТипы = ТипЗначенияКолонкиОсобенность;
	Иначе
		НоваяКолонкаНаФорме.ОграничениеТипа = ТипЗначенияКолонкиОсобенность;
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьОсобенностьТоваровНаФорму(Особенность, ПолныйИдентификаторОсобенности, ТипЗначенияКолонкиОсобенность, Форма)
	
	РеквизитДобавлен = Ложь;
	
	Для каждого РеквизитТоваров Из Форма.ПолучитьРеквизиты("Товары") Цикл
		Если РеквизитТоваров.Имя = ПолныйИдентификаторОсобенности Тогда
			РеквизитДобавлен = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ РеквизитДобавлен Тогда	
		
		НовыеРеквизиты = Новый Массив;
		НовыеРеквизиты.Добавить(Новый РеквизитФормы(ПолныйИдентификаторОсобенности, ТипЗначенияКолонкиОсобенность, "Товары", Особенность.Наименование));
		
		Форма.ИзменитьРеквизиты(НовыеРеквизиты);
		
	КонецЕсли;

КонецПроцедуры

Функция ПолныйИдентификаторОсобенности(Особенность)
	
	Если ЗначениеЗаполнено(Особенность.ИмяСтруктуры) Тогда
		ПолныйИдентификаторОсобенности = ПолныйИдентификаторОсобенностиТоваров(Особенность);
	Иначе
		ПолныйИдентификаторОсобенности = Особенность.Идентификатор;
	КонецЕсли;
	
	Если Особенность.Ревенство1СEDI = Неопределено Тогда
		ПолныйИдентификаторОсобенности = ПолныйИдентификаторОсобенности + "1С";			
	КонецЕсли;
	
	Возврат ПолныйИдентификаторОсобенности;

КонецФункции

Процедура ДобавитьУсловноеОформлениеОсобенностейСообщения(Форма) Экспорт 
	
	Для каждого ОсобенностьСообщения Из ОсобенностиСообщений Цикл
		
		Если НЕ ОсобенностьВыводитсяВКарточкуСообщения(ОсобенностьСообщения, Форма.Сообщение) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭтоОсобенностьТоваров(ОсобенностьСообщения) Тогда
			ПолныйИдентификаторОсобенности = ОсобенностьСообщения.ПолныйИдентификаторОсобенности;
			ИмяПоляОформления 	= "Товары" + ПолныйИдентификаторОсобенности;
			ИмяПоляОтбора 		= "Товары." + ПолныйИдентификаторОсобенности;
		Иначе
			ИмяПоляОформления 	= "ОсобенностиЗначение";
			ИмяПоляОтбора 		= "Особенности.Значение";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОсобенностьСообщения.СписокВыбора) Тогда
			
			Для каждого Эл Из ОсобенностьСообщения.СписокВыбора Цикл
			
				Элемент = Форма.УсловноеОформление.Элементы.Добавить();
				ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
				ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяПоляОформления);
				
				ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоляОтбора);
				ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
				ОтборЭлемента.ПравоеЗначение = Эл.Значение;
				
				ЗначениеТекста = Эл.Представление;
				
				Если ПустаяСтрока(ЗначениеТекста) Тогда
					ЗначениеТекста = Эл.Значение;	
				КонецЕсли;
				
				Элемент.Оформление.УстановитьЗначениеПараметра("Текст", ЗначениеТекста);
		
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

