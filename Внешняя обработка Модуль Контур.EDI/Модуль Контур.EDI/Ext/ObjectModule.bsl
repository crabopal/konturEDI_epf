		//Предварительные заказы
		ДобавитьОписаниеПоля(ТабОписания,"КрайняяДатаПриемки",		ИмяДокумента+".deliveryInfo.lastReceivingDate");
		ДобавитьОписаниеПоля(ТабОписания,"КрайняяДатаБронирования",	ИмяДокумента+".lastReservationDate");
		ДобавитьОписаниеПоля(ТабОписания,"КрайняяДатаОтвета",		ИмяДокумента+".lastResponseDate"); 		
		
		ДобавитьОписаниеПоля(ТабОписания,"НомерЭкспедиционногоЗаказа",	ИмяДокумента+".forwardingOrder.number");
		ДобавитьОписаниеПоля(ТабОписания,"ДатаЭкспедиционногоЗаказа",	ИмяДокумента+".forwardingOrder.date");
		ДобавитьОписаниеПоля(ТабОписания,"НомерЗаказаПеревозки",		ИмяДокумента+".firmBooking.number");
		ДобавитьОписаниеПоля(ТабОписания,"ДатаЗаказаПеревозки",			ИмяДокумента+".firmBooking.date");
		
		Если ТипСообщения = "IFTMBF" 
			ИЛИ ТипСообщения = "IFTMBC" Тогда
			ДобавитьОписаниеПоля(ТабОписания,"ДатаВремяПоставки",		ИмяДокумента+"."+ДатаПоставки);
			ДобавитьОписаниеПоля(ТабОписания,"ВесУпаковокБрутто",		ИмяДокумента+".totalPackagesGrossWeight", "Количество");
			ДобавитьОписаниеПоля(ТабОписания,"КоличествоУпаковок",		ИмяДокумента+".totalPackagesQuantity");
			ДобавитьОписаниеПоля(ТабОписания,"ТарифНаПеревозку",		ИмяДокумента+".deliveryInfo.despatchParty.tariffInfo", "ТарифНаПеревозку");
			ДобавитьОписаниеПоля(ТабОписания,"ИнформацияОТранспорте",	ИмяДокумента+".deliveryInfo.transportation", "ИнформацияОТранспорте");
		Иначе
