Функция ПоcчитатьКоличествоДокументовЗаПоследнийМесяц()
	
	КоличествоДокументов = Новый Соответствие;
	
	ИмяДокументаРеализации 	= ПолучитьТипЗначенияОбъекта("ИсходящееУведомлениеОбОтгрузке", , Истина); 
	ИмяДокументаПоступления = ПолучитьТипЗначенияОбъекта("ВходящееУведомлениеОбОтгрузке", , Истина);
	
	НачалоПериода 	= ТекущаяДата() - 30 * 24 * 3600;
	КонецПериода 	= ТекущаяДата();
	
	КоличествоРеализаций = Неопределено;
	Если НЕ ИмяДокументаРеализации = Неопределено Тогда
		КоличествоРеализаций = ПосчитатьКоличествоДокументовЗаПериод(ИмяДокументаРеализации, НачалоПериода, КонецПериода);	
	КонецЕсли;
	КоличествоПоступлений = Неопределено;
	Если НЕ ИмяДокументаПоступления = Неопределено Тогда
		КоличествоПоступлений = ПосчитатьКоличествоДокументовЗаПериод(ИмяДокументаПоступления, НачалоПериода, КонецПериода);	
	КонецЕсли;

	КоличествоДокументов.Вставить("КоличествоРеализаций",	КоличествоРеализаций);
	КоличествоДокументов.Вставить("КоличествоПоступлений",	КоличествоПоступлений);
	
    Возврат КоличествоДокументов;
	
КонецФункции // ПоcчитатьКоличествоДокументовЗаПоследнийМесяц()

Функция ПосчитатьКоличествоДокументовЗаПериод(ИмяДокумента, НачалоПериода = Неопределено, КонецПериода = Неопределено)
	
  	Количество = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(ИмяДокумента) Тогда
		Возврат Количество;
	КонецЕсли;
 	Если НЕ ЕстьНеобходимыеМетаданные("Документы." + ИмяДокумента) Тогда
		Возврат Количество;
	КонецЕсли;
	Если НачалоПериода = Неопределено
		ИЛИ КонецПериода = Неопределено Тогда
		Возврат Количество;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДокументИмяДокумента.Ссылка
	|ИЗ
	|	Документ.ИмяДокумента КАК ДокументИмяДокумента
	|ГДЕ
	|	ДокументИмяДокумента.Дата МЕЖДУ &НачалоПериода И &КонецПериода";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяДокумента", ИмяДокумента);
	Запрос.УстановитьПараметр("НачалоПериода", 	НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", 	КонецПериода);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
    Возврат Выборка.Количество();

КонецФункции // ПосчитатьКоличествоДокументовЗаПериод()

Функция ПоcчитатьКоличествоСообщенийВБазе(Пересчитать = Ложь)

	Количество = Неопределено;
	
	Если НЕ ЕстьНеобходимыеМетаданные("Справочники.КонтурEDI_Сообщения") Тогда
		Возврат Количество;
	КонецЕсли;
	
	ДатаКоличестваСообщений = НачалоДня(ТекущаяДата());
	
	Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	табДатаКоличестваСообщений.Значение КАК ДатаКоличестваСообщений,
	|	табКоличествоСообщений.Значение КАК КоличествоСообщений
	|ИЗ
	|	РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК табДатаКоличестваСообщений
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК табКоличествоСообщений
	|		ПО табДатаКоличестваСообщений.Объект = табКоличествоСообщений.Объект
	|			И (табКоличествоСообщений.Свойство = ""КоличествоСообщений"")
	|			И (табДатаКоличестваСообщений.Свойство = ""ДатаКоличестваСообщений"")
	|			И (табДатаКоличестваСообщений.Значение >= &ТекущаяДата)";
	
	Запрос.УстановитьПараметр("ТекущаяДата", ДатаКоличестваСообщений);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не Пересчитать И Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		КоличествоСообщений = Выборка.КоличествоСообщений;
		
	Иначе   	
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(КонтурEDI_Сообщения.Ссылка) КАК КоличествоСообщений
		|ИЗ
		|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если Не РезультатЗапроса.Пустой() Тогда
			
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			
			КоличествоСообщений = Выборка.КоличествоСообщений;
			
		Иначе
			
			КоличествоСообщений = 0;
			
		КонецЕсли;   		
		
		УстановитьКонстантуEDI("ДатаКоличестваСообщений", ДатаКоличестваСообщений);
		УстановитьКонстантуEDI("КоличествоСообщений", КоличествоСообщений); 
		
	КонецЕсли;
	
	Возврат КоличествоСообщений;   
	
КонецФункции // ПоcчитатьКоличествоEDIСообщенийВБазе()

