Функция Текст_ВТ_ТаблицаСоответствий()
		
	Текст_ВТ_ТаблицаСоответствий =
	"ВЫБРАТЬ
	|	ТаблицаСоответствий.Номенклатура КАК Номенклатура,
	|	ТаблицаСоответствий.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТаблицаСоответствий.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ТаблицаСоответствий.GTIN КАК GTIN,
	|	ТаблицаСоответствий.КодТовараСвой КАК КодТовараСвой,
	|	ТаблицаСоответствий.КодТовараСторонний КАК КодТовараСторонний,
	|	ТаблицаСоответствий.КодЕдиницыИзмеренияEDI КАК КодЕдиницыИзмеренияEDI,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ТаблицаСоответствий.КоэффициентEDIВ1С) <> ТИП(ЧИСЛО)
	|			ТОГДА 1
	|		КОГДА ТаблицаСоответствий.КоэффициентEDIВ1С > 0
	|			ТОГДА ТаблицаСоответствий.КоэффициентEDIВ1С
	|		КОГДА ТаблицаСоответствий.КоэффициентEDIВ1С < 0
	|			ТОГДА -1 * (1 / ТаблицаСоответствий.КоэффициентEDIВ1С)
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК КоэффициентEDIВ1С_Расчетный,
	|	ТаблицаСоответствий.ТипЕдиницы КАК ТипЕдиницы,
	|	ТаблицаСоответствий.НаименованиеПартнера КАК Наименование,
	|	ТаблицаСоответствий.ОсновноеСоответствие,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ТаблицаСоответствий.КоэффициентEDIВ1С) <> ТИП(ЧИСЛО)
	|			ТОГДА 1
	|		ИНАЧЕ ТаблицаСоответствий.КоэффициентEDIВ1С
	|	КОНЕЦ КАК КоэффициентEDIВ1С
	|ПОМЕСТИТЬ ВТ_ТаблицаСоответствий
	|ИЗ
	|	&ТаблицаСоответствий КАК ТаблицаСоответствий
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	ХарактеристикаНоменклатуры";
	
	Возврат Текст_ВТ_ТаблицаСоответствий;

КонецФункции

Функция Текст_ВТ_ТаблицаТоваров_КонтурEDI(ТаблицаТоваров)
		
	Текст_ВТ_ТаблицаТоваров = 
	"ВЫБРАТЬ
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТаблицаТоваров.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	&ПолеСерияНоменклатуры КАК СерияНоменклатуры,
	|	ВЫРАЗИТЬ(&ПолеКоличествоТовары * ВЫБОР
	|		КОГДА ТаблицаТоваров.КоэффициентEDIВ1С > 0
	|			ТОГДА ТаблицаТоваров.КоэффициентEDIВ1С
	|		КОГДА ТаблицаТоваров.КоэффициентEDIВ1С < 0
	|			ТОГДА -1 * (1 / ТаблицаТоваров.КоэффициентEDIВ1С)
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК ЧИСЛО(25,10)) КАК КоличествоВДокументе1С,
	|	ТаблицаТоваров.УИД_СтрокиДокумента КАК УИД_СтрокиДокумента,
	|	ТаблицаТоваров.УИД_СтрокиПредыдущегоСообщения КАК УИД_СтрокиПредыдущегоСообщения,
	|	ТаблицаТоваров.ЦенаВДокументе1С КАК ЦенаВДокументе1С,
	|	&ПолеКоличествоДоКорректировки КАК КоличествоДоКорректировкиВДокументе1С,
	|	&ПолеЦенаДоКорректировки КАК ЦенаДоКорректировкиВДокументе1С,
	|	ТаблицаТоваров.GTIN КАК ТоварыGTIN,
	|	ТаблицаТоваров.КодТовараПокупателя КАК ТоварыКодТовараПокупателя,
	|	ТаблицаТоваров.КодТовараПоставщика КАК ТоварыКодТовараПоставщика,
	|	ТаблицаТоваров.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	ТаблицаТоваров.КодЕдиницыИзмеренияEDI КАК КодЕдиницыИзмеренияEDI
	|ПОМЕСТИТЬ ВТ_ТаблицаТоваров
	|ИЗ
	|	&ТаблицаТоваров КАК ТаблицаТоваров
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	ХарактеристикаНоменклатуры";
	
	// ... определить поле "серии номенклатуры"
	ЗаменитьПолеСерияНоменклатуры_КонтурEDI(ТаблицаТоваров, Текст_ВТ_ТаблицаТоваров);   
	
	// ... определить поле "количества"
	ЗаменитьПолеКоличествоВТаблицеТоваров_КонтурEDI(ТаблицаТоваров, Текст_ВТ_ТаблицаТоваров); 

	// ... определить поле "количества до корректировки"
	ЗаменитьПолеКоличествоДоКорректировкиВТаблицеТоваров_КонтурEDI(ТаблицаТоваров, Текст_ВТ_ТаблицаТоваров);
	
	// ... определить поле "цена до корректировки"
	ЗаменитьПолеЦенаДоКорректировкиВТаблицеТоваров_КонтурEDI(ТаблицаТоваров, Текст_ВТ_ТаблицаТоваров);
	
	Возврат Текст_ВТ_ТаблицаТоваров;

КонецФункции

Функция Текст_ВТ_СоединениеСоответствий_и_ВходящегоСообщения(МыГлавныеВРазрезеСделки)
	
	Если МыГлавныеВРазрезеСделки Тогда
		
		Текст_ВТ_СоединениеСоответствий_и_ВходящегоСообщения = 
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ВТ_ТаблицаТоваровВходящегоСообщения.Номенклатура ЕСТЬ НЕ NULL 
		|				И ВТ_ТаблицаТоваровВходящегоСообщения.Номенклатура <> НЕОПРЕДЕЛЕНО
		|				И ВТ_ТаблицаТоваровВходящегоСообщения.Номенклатура <> &ПустаяНоменклатура
		|			ТОГДА ВТ_ТаблицаТоваровВходящегоСообщения.Номенклатура
		|		ИНАЧЕ ВТ_ТаблицаСоответствий.Номенклатура
		|	КОНЕЦ КАК Номенклатура,
		|	ВЫБОР
		|		КОГДА ВТ_ТаблицаТоваровВходящегоСообщения.Номенклатура ЕСТЬ НЕ NULL 
		|				И ВТ_ТаблицаТоваровВходящегоСообщения.Номенклатура <> НЕОПРЕДЕЛЕНО
		|				И ВТ_ТаблицаТоваровВходящегоСообщения.Номенклатура <> &ПустаяНоменклатура
		|			ТОГДА ВТ_ТаблицаТоваровВходящегоСообщения.ЕдиницаИзмерения
		|		ИНАЧЕ ВТ_ТаблицаСоответствий.ЕдиницаИзмерения
		|	КОНЕЦ КАК ЕдиницаИзмерения,
		|	ВЫБОР
		|		КОГДА ВТ_ТаблицаТоваровВходящегоСообщения.Номенклатура ЕСТЬ НЕ NULL 
		|				И ВТ_ТаблицаТоваровВходящегоСообщения.Номенклатура <> НЕОПРЕДЕЛЕНО
		|				И ВТ_ТаблицаТоваровВходящегоСообщения.Номенклатура <> &ПустаяНоменклатура
		|			ТОГДА ВТ_ТаблицаТоваровВходящегоСообщения.ХарактеристикаНоменклатуры
		|		ИНАЧЕ ВТ_ТаблицаСоответствий.ХарактеристикаНоменклатуры
		|	КОНЕЦ КАК ХарактеристикаНоменклатуры,
		|	ЕСТЬNULL(ВТ_ТаблицаТоваровВходящегоСообщения.GTIN, ВТ_ТаблицаСоответствий.GTIN) КАК GTIN,
		|	&ПолеКодТовараСвой КАК КодТовараСвой,
		|	&ПолеКодТовараСторонний КАК КодТовараСторонний,
		|	ВЫБОР
		|		КОГДА ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI = """"
		|				ИЛИ ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI ЕСТЬ NULL
		|				ИЛИ ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI = ВТ_ТаблицаТоваровВходящегоСообщения.КодЕдиницыИзмеренияEDI
		|			ТОГДА ЕСТЬNULL(ВТ_ТаблицаТоваровВходящегоСообщения.КодЕдиницыИзмеренияEDI, """")
		|		ИНАЧЕ ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI
		|	КОНЕЦ КАК КодЕдиницыИзмеренияEDI,
		|	ЕСТЬNULL(ВТ_ТаблицаСоответствий.КоэффициентEDIВ1С_Расчетный, 1) КАК КоэффициентEDIВ1С_Расчетный,
		|	ЕСТЬNULL(ВТ_ТаблицаСоответствий.КоэффициентEDIВ1С, 1) КАК КоэффициентEDIВ1С,
		|	ЕСТЬNULL(ВТ_ТаблицаСоответствий.ТипЕдиницы, """") КАК ТипЕдиницы,
		|	ВЫРАЗИТЬ(ЕСТЬNULL(ВТ_ТаблицаТоваровВходящегоСообщения.Количество, 0) КАК ЧИСЛО(25,10)) КАК КоличествоВоВходящем,
		|	ЕСТЬNULL(ВТ_ТаблицаТоваровВходящегоСообщения.УИД_СтрокиТовара, """") КАК УИД_СтрокиПредыдущегоСообщения,
		|	ЕСТЬNULL(ВТ_ТаблицаТоваровВходящегоСообщения.ДругиеРеквизиты, """") КАК ДругиеРеквизиты,
		|	ЕСТЬNULL(ВТ_ТаблицаТоваровВходящегоСообщения.Наименование, ВТ_ТаблицаСоответствий.Наименование) КАК Наименование,
		|	ЕСТЬNULL(ВТ_ТаблицаТоваровВходящегоСообщения.ЦенаСНДС, 0) КАК ЦенаСНДС,
		|	ЕСТЬNULL(ВТ_ТаблицаТоваровВходящегоСообщения.ЦенаБезНДС, 0) КАК ЦенаБезНДС,
		|	ВЫБОР
		|		КОГДА ВТ_ТаблицаТоваровВходящегоСообщения.УИД_СтрокиТовара ЕСТЬ НЕ NULL 
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЕстьСтрокаВИсходномСообщении,
		|	ВЫБОР
		|		КОГДА ВТ_ТаблицаТоваровВходящегоСообщения.ХарактеристикаНоменклатуры = ВТ_ТаблицаСоответствий.ХарактеристикаНоменклатуры
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ХаркаВСоответствияхРавнаХаркеИсходногоСообщения,
		|	ЕСТЬNULL(ВТ_ТаблицаТоваровВходящегоСообщения.УИД_СтрокиПервоначальногоСообщения, """") КАК УИД_СтрокиПервоначальногоСообщения,
		|	ВЫРАЗИТЬ(ВЫБОР
		|		КОГДА ВТ_ТаблицаТоваровВходящегоСообщения.УИД_СтрокиТовара ЕСТЬ НЕ NULL 
		|				И (ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI = ВТ_ТаблицаТоваровВходящегоСообщения.КодЕдиницыИзмеренияEDI
		|					ИЛИ ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI = """")
		|			ТОГДА 100
		|		ИНАЧЕ 0
		|	КОНЕЦ + ВЫБОР
		|		КОГДА ВТ_ТаблицаСоответствий.КоэффициентEDIВ1С_Расчетный = 0
		|			ТОГДА 0
		|		КОГДА 1 / ВТ_ТаблицаСоответствий.КоэффициентEDIВ1С_Расчетный <= 1
		|			ТОГДА 10 + 1 / ВТ_ТаблицаСоответствий.КоэффициентEDIВ1С_Расчетный
		|		ИНАЧЕ 10 + ВТ_ТаблицаСоответствий.КоэффициентEDIВ1С_Расчетный/ 1000
		|	КОНЕЦ + ЕСТЬNULL(ВТ_ТаблицаСоответствий.ОсновноеСоответствие, 0) КАК ЧИСЛО(25,10)) КАК ОценкаПодбораСоответствия
		|ПОМЕСТИТЬ ВТ_СоединениеСоответствий_и_ВходящегоСообщения
		|ИЗ
		|	ВТ_ТаблицаСоответствий КАК ВТ_ТаблицаСоответствий
		|		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_ТаблицаТоваровВходящегоСообщения КАК ВТ_ТаблицаТоваровВходящегоСообщения
		|		ПО (&ПоляДляСоединенияТаблицыСоответствийИВходящегоСообщения)
		|			И (ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI = """"
		|				ИЛИ ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI = ВТ_ТаблицаТоваровВходящегоСообщения.КодЕдиницыИзмеренияEDI)";
		
	Иначе
		
		Текст_ВТ_СоединениеСоответствий_и_ВходящегоСообщения =
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ВТ_ТаблицаТоваровВходящегоСообщения.Номенклатура ЕСТЬ НЕ NULL 
		|				И ВТ_ТаблицаТоваровВходящегоСообщения.Номенклатура <> НЕОПРЕДЕЛЕНО
		|				И ВТ_ТаблицаТоваровВходящегоСообщения.Номенклатура <> &ПустаяНоменклатура
		|			ТОГДА ВТ_ТаблицаТоваровВходящегоСообщения.Номенклатура
		|		ИНАЧЕ ВТ_ТаблицаСоответствий.Номенклатура
		|	КОНЕЦ КАК Номенклатура,
		|	ВЫБОР
		|		КОГДА ВТ_ТаблицаТоваровВходящегоСообщения.Номенклатура ЕСТЬ НЕ NULL 
		|				И ВТ_ТаблицаТоваровВходящегоСообщения.Номенклатура <> НЕОПРЕДЕЛЕНО
		|				И ВТ_ТаблицаТоваровВходящегоСообщения.Номенклатура <> &ПустаяНоменклатура
		|			ТОГДА ВТ_ТаблицаТоваровВходящегоСообщения.ЕдиницаИзмерения
		|		ИНАЧЕ ВТ_ТаблицаСоответствий.ЕдиницаИзмерения
		|	КОНЕЦ КАК ЕдиницаИзмерения,
		|	ВЫБОР
		|		КОГДА ВТ_ТаблицаТоваровВходящегоСообщения.Номенклатура ЕСТЬ НЕ NULL 
		|				И ВТ_ТаблицаТоваровВходящегоСообщения.Номенклатура <> НЕОПРЕДЕЛЕНО
		|				И ВТ_ТаблицаТоваровВходящегоСообщения.Номенклатура <> &ПустаяНоменклатура
		|			ТОГДА ВТ_ТаблицаТоваровВходящегоСообщения.ХарактеристикаНоменклатуры
		|		ИНАЧЕ ВТ_ТаблицаСоответствий.ХарактеристикаНоменклатуры
		|	КОНЕЦ КАК ХарактеристикаНоменклатуры,
		|	ЕСТЬNULL(ВТ_ТаблицаТоваровВходящегоСообщения.GTIN, ВТ_ТаблицаСоответствий.GTIN) КАК GTIN,
		|	&ПолеКодТовараСвой КАК КодТовараСвой,
		|	&ПолеКодТовараСторонний КАК КодТовараСторонний,
		|	ВЫБОР
		|		КОГДА ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI = """"
		|				ИЛИ ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI = ВТ_ТаблицаТоваровВходящегоСообщения.КодЕдиницыИзмеренияEDI
		|			ТОГДА ЕСТЬNULL(ВТ_ТаблицаТоваровВходящегоСообщения.КодЕдиницыИзмеренияEDI, """")
		|		ИНАЧЕ ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI
		|	КОНЕЦ КАК КодЕдиницыИзмеренияEDI,
		|	ВТ_ТаблицаСоответствий.КоэффициентEDIВ1С_Расчетный КАК КоэффициентEDIВ1С_Расчетный,
		|	ВТ_ТаблицаСоответствий.КоэффициентEDIВ1С КАК КоэффициентEDIВ1С,
		|	ВТ_ТаблицаСоответствий.ТипЕдиницы КАК ТипЕдиницы,
		|	ВЫРАЗИТЬ(ЕСТЬNULL(ВТ_ТаблицаТоваровВходящегоСообщения.Количество, 0) КАК ЧИСЛО(25,10)) КАК КоличествоВоВходящем,
		|	ВЫБОР
		|		КОГДА ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI = """"
		|				ИЛИ ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI = ВТ_ТаблицаТоваровВходящегоСообщения.КодЕдиницыИзмеренияEDI
		|			ТОГДА ЕСТЬNULL(ВТ_ТаблицаТоваровВходящегоСообщения.УИД_СтрокиТовара, """")
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК УИД_СтрокиПредыдущегоСообщения,
		|	ЕСТЬNULL(ВТ_ТаблицаТоваровВходящегоСообщения.ДругиеРеквизиты, """") КАК ДругиеРеквизиты,
		|	ЕСТЬNULL(ВТ_ТаблицаТоваровВходящегоСообщения.Наименование, ВТ_ТаблицаСоответствий.Наименование) КАК Наименование,
		|	ЕСТЬNULL(ВТ_ТаблицаТоваровВходящегоСообщения.ЦенаСНДС, 0) КАК ЦенаСНДС,
		|	ЕСТЬNULL(ВТ_ТаблицаТоваровВходящегоСообщения.ЦенаБезНДС, 0) КАК ЦенаБезНДС,
		|	ВЫБОР
		|		КОГДА ВТ_ТаблицаТоваровВходящегоСообщения.УИД_СтрокиТовара ЕСТЬ НЕ NULL 
		|				И (ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI = """"
		|					ИЛИ ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI = ВТ_ТаблицаТоваровВходящегоСообщения.КодЕдиницыИзмеренияEDI)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ПриоритетноеСопоставление,
		|	ВЫБОР
		|		КОГДА ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI = """"
		|				ИЛИ ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI = ВТ_ТаблицаТоваровВходящегоСообщения.КодЕдиницыИзмеренияEDI
		|			ТОГДА ЕСТЬNULL(ВТ_ТаблицаТоваровВходящегоСообщения.УИД_СтрокиПервоначальногоСообщения, """")
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК УИД_СтрокиПервоначальногоСообщения,
		|	ВЫРАЗИТЬ(ВЫБОР
		|		КОГДА ВТ_ТаблицаТоваровВходящегоСообщения.УИД_СтрокиТовара ЕСТЬ НЕ NULL 
		|				И (ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI = ВТ_ТаблицаТоваровВходящегоСообщения.КодЕдиницыИзмеренияEDI
		|					ИЛИ ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI = """")
		|			ТОГДА 100
		|		ИНАЧЕ 0
		|	КОНЕЦ + ВЫБОР
		|		КОГДА ВТ_ТаблицаСоответствий.КоэффициентEDIВ1С_Расчетный = 0
		|			ТОГДА 0
		|		КОГДА 1 / ВТ_ТаблицаСоответствий.КоэффициентEDIВ1С_Расчетный <= 1
		|			ТОГДА 10 + 1 / ВТ_ТаблицаСоответствий.КоэффициентEDIВ1С_Расчетный
		|		ИНАЧЕ 10 + ВТ_ТаблицаСоответствий.КоэффициентEDIВ1С_Расчетный / 1000
		|	КОНЕЦ + ЕСТЬNULL(ВТ_ТаблицаСоответствий.ОсновноеСоответствие, 0) КАК ЧИСЛО(25,10)) КАК ОценкаПодбораСоответствия
		|ПОМЕСТИТЬ ВТ_СоединениеСоответствий_и_ВходящегоСообщения
		|ИЗ
		|	ВТ_ТаблицаСоответствий КАК ВТ_ТаблицаСоответствий
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТаблицаТоваровВходящегоСообщения КАК ВТ_ТаблицаТоваровВходящегоСообщения
		|		ПО (&ПоляДляСоединенияТаблицыСоответствийИВходящегоСообщения)
		|			И (ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI = """"
		|				ИЛИ ВТ_ТаблицаСоответствий.КодЕдиницыИзмеренияEDI = ВТ_ТаблицаТоваровВходящегоСообщения.КодЕдиницыИзмеренияEDI)";
		
	КонецЕсли;
	
	Возврат Текст_ВТ_СоединениеСоответствий_и_ВходящегоСообщения;

КонецФункции

