КонецФункции

Функция ПолучитьИнформациюОЯщикеДиадок(ИдентификаторЯщика, ДанныеАвторизации)
	
	ДанныеАвторизацииДиадок = ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизации);
	Результат = КонтурДиадокAPI_ИнформацияОЯщике(ДанныеАвторизацииДиадок, ИдентификаторЯщика);
	
	Возврат Результат;	
	
КонецФункции

Функция ПолучитьИННЯщикаДиадок(ИдентификаторЯщика, ДанныеАвторизации) Экспорт
	
	ИНН = ЭДО_Кэш_Прочитать("ИНН_" + ИдентификаторЯщика);
	
	Если ЗначениеЗаполнено(ИНН) Тогда
		Возврат ИНН;
	КонецЕсли;
	
	Попытка
		ЯщикДиадок = ПолучитьИнформациюОЯщикеДиадок(ИдентификаторЯщика, ДанныеАвторизации);
		ИНН = ЯщикДиадок.Organization.Inn;
	Исключение
		
		ТекстОшибки = "Ошибка при получении ИНН ящика Диадок
					|BoxID = %1
					|%2";
		ТекстОшибки = КонтурСтандарт_СтрШаблон_(ТекстОшибки, ИдентификаторЯщика, ОписаниеОшибки());
			
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);
		
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(ИНН) Тогда
		ИНН = ПолучитьЗначениеСвойстваОбъектаEDI(ДанныеАвторизации.Организация, "DiadocOrgInn");	
	КонецЕсли;
	
	ЭДО_Кэш_Поместить("ИНН_" + ИдентификаторЯщика, ИНН);
	
	Возврат ИНН;
	
КонецФункции

