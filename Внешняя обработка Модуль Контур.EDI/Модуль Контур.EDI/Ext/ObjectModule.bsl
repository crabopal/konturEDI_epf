Функция ДобавитьЭлементСпискаXDTO(СписокXDTO,мФабрика,СоздаватьВложенные = Ложь)
	
	НовЭлемент = СоздатьПустойОбъектXDTO(мФабрика,СписокXDTO.ВладеющееСвойство.Тип,СоздаватьВложенные);
	СписокXDTO.Добавить(НовЭлемент);
	Возврат НовЭлемент;
	
КонецФункции

Функция СоздатьПустойОбъектXDTO(мФабрика,Тип_Основной,СоздатьВложенныеОбъекты = Ложь)
	//по умолчанию создаем все вложенные свойства
	
	НовОбъект=Неопределено;
	
	НовОбъект = мФабрика.Создать(Тип_Основной);
	
	Если СоздатьВложенныеОбъекты Тогда
		Для Каждого Эл из Тип_Основной.Свойства Цикл
	        флСвойствоНеСписковое =	(Эл.ВерхняяГраница=1);
			Если Эл.Тип.URIПространстваИмен=Тип_Основной.URIПространстваИмен 
				И флСвойствоНеСписковое	Тогда
				
				Если ТипЗнч(Эл.Тип) = Тип("ТипОбъектаXDTO") Тогда//вложенные свойства создаем только для объектов
					НовоеСвойство = СоздатьПустойОбъектXDTO(мФабрика,Эл.Тип,СоздатьВложенныеОбъекты);
					НовОбъект[Эл.Имя]=НовоеСвойство;
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	
	Возврат НовОбъект;
	
КонецФункции

Функция УдалитьПустыеСвойстваXDTO(ОбъектXDTO)
	//продумать другой вариант: по умолчанию не создаем все свойства объекта, а только в момент их установки инициализируем. Тогда и этот метод не нужен будет.
	
	Если ТипЗнч(ОбъектXDTO) = Тип("ОбъектXDTO") Тогда
		ЕстьНеПустые = Ложь;
		Для Каждого Свойство Из ОбъектXDTO.Свойства() Цикл
			//Сообщить(Свойство.Имя);
			ТекущееСвойствоПустое = УдалитьПустыеСвойстваXDTO(ОбъектXDTO[Свойство.Имя]);
			Если ТекущееСвойствоПустое Тогда
				ОбъектXDTO.Сбросить(Свойство.Имя);
			КонецЕсли;
			ЕстьНеПустые = ЕстьНеПустые или Не ТекущееСвойствоПустое;
		КонецЦикла;	
		Возврат Не ЕстьНеПустые;
	ИначеЕсли ТипЗнч(ОбъектXDTO) = Тип("СписокXDTO") Тогда
		Для Каждого ЭлементКоллекции Из ОбъектXDTO Цикл
			УдалитьПустыеСвойстваXDTO(ЭлементКоллекции);
		КонецЦикла;	
		
		Возврат (ОбъектXDTO.Количество()=0);//если нет строк, то удалим этот тег
	Иначе//уткнулись в конец ветки, в примитивный / ссылочный тип
		Если Не ЗначениеЗаполнено(ОбъектXDTO)
			И ОбъектXDTO<>0 Тогда//значение "0" не будем считать пустым
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
КонецФункции

Функция ВычислитьXDTO(ОбъектXDTO,Путь) Экспорт
	
	ТекущийЭлемент = ОбъектXDTO;
	
	ТипСписок = Тип("СписокXDTO");
	
	МассивСлов = EDI_РазложитьСтрокуВМассивСлов(Путь,".");
	
	Для Каждого ТекущийПуть Из МассивСлов Цикл
		
		Если ТекущийЭлемент = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Если ТипЗнч(ТекущийЭлемент)=ТипСписок Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ТекущийЭлемент = ПолучитьЗначениеСвойстваXDTO(ТекущийЭлемент,ТекущийПуть);
		
	КонецЦикла;
	
	Возврат ТекущийЭлемент;
	
КонецФункции 

Функция XML_ФабрикаXDTO(ИмяПакетаXDTO) Экспорт
	
	КлючКэш = "ФабрикаXDTO_" + ИмяПакетаXDTO;
	
	Результат = ЭДО_Кэш_Прочитать(КлючКэш);
	
	Если Результат = Неопределено Тогда
		
		ИмяМакета	 = ИмяПакетаXDTO + "_xsd";
		ТекстМакета	 = ПолучитьМакет(ИмяМакета).ПолучитьТекст();
		
		Результат = КонтурСтандарт_ФабрикаXDTO(ТекстМакета);
		
		ЭДО_Кэш_Поместить(КлючКэш, Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция XML_УниверсальныйПодписант(BoxId, CertificateBytes, CertificateThumbprint, МашиночитаемаяДоверенностьДляОтправки) Экспорт
	
	РегистрационныйНомер = СвойствоСтруктуры(МашиночитаемаяДоверенностьДляОтправки, "СоставнойИдентификатор.РегистрационныеНомер", "");
	ИННДоверителя = СвойствоСтруктуры(МашиночитаемаяДоверенностьДляОтправки, "СоставнойИдентификатор.ИННДоверителя", "");
	ИННПредставителя = СвойствоСтруктуры(МашиночитаемаяДоверенностьДляОтправки, "СоставнойИдентификатор.ИННПредставителя", "");
	
	СоставнойИдентификаторМЧДЗаполнен =  ЗначениеЗаполнено(РегистрационныйНомер) И ЗначениеЗаполнено(ИННДоверителя) И ЗначениеЗаполнено(ИННПредставителя);
									
	ИспользоватьДоверенностьПоУмолчанию = МашиночитаемаяДоверенностьДляОтправки.ИспользоватьДоверенностьПоУмолчанию;
	
	КлючПодписантаВКэше = "Signer" 
						+ BoxId 
						+ CertificateThumbprint 
						+ РегистрационныйНомер;
						
	КонтентПодписантаBase64 = ЭДО_Кэш_Прочитать(КлючПодписантаВКэше);
	
	Если Не КонтентПодписантаBase64 = Неопределено Тогда
		Возврат КонтентПодписантаBase64;
	КонецЕсли;
	
	Фабрика = XML_ФабрикаXDTO("SignerUserDataXsdUrl");
	
	UniversalSignersXDTO = КонтурСтандарт_ПолучитьПустойОбъектXDTO(Фабрика, "Signers", "Signers");
	
	Signer = КонтурСтандарт_НовыйДочернийОбъектXDTO(Фабрика, UniversalSignersXDTO, "Signer");
	SignerReference = КонтурСтандарт_НовыйДочернийОбъектXDTO(Фабрика, Signer, "SignerReference");
	
	КонтурСтандарт_УстановитьЗначениеXDTO(SignerReference, "BoxId", BoxId);
	КонтурСтандарт_УстановитьЗначениеXDTO(SignerReference, "CertificateBytes", CertificateBytes);
	КонтурСтандарт_УстановитьЗначениеXDTO(SignerReference, "CertificateThumbprint", CertificateThumbprint);

	Если СоставнойИдентификаторМЧДЗаполнен	Или ИспользоватьДоверенностьПоУмолчанию Тогда
		
		PowerOfAttorney = КонтурСтандарт_НовыйДочернийОбъектXDTO(Фабрика, SignerReference, "PowerOfAttorney");
		
		КонтурСтандарт_УстановитьЗначениеXDTO(PowerOfAttorney, "UseDefault", Формат(ИспользоватьДоверенностьПоУмолчанию, "БЛ=false; БИ=true"));

		Если СоставнойИдентификаторМЧДЗаполнен Тогда
			
			FullId = КонтурСтандарт_НовыйДочернийОбъектXDTO(Фабрика, PowerOfAttorney, "FullId");
			
			КонтурСтандарт_УстановитьЗначениеXDTO(FullId, "RegistrationNumber", РегистрационныйНомер);
			КонтурСтандарт_УстановитьЗначениеXDTO(FullId, "IssuerInn", 			ИННДоверителя);
			КонтурСтандарт_УстановитьЗначениеXDTO(FullId, "RepresentativeInn", 	ИННПредставителя);
			
		КонецЕсли;		
		
	КонецЕсли;
	
	СтрокаXML = КонтурСтандарт_ОбъектXDTO_В_СтрокаXML(Фабрика, UniversalSignersXDTO);
	
	XML_УдалитьОбъявлениеПрефиксовПространстваИмен("Signers", СтрокаXML);
	
	ДвоичныеДанные = КонтурСтандарт_ПолучитьДвоичныеДанныеИзСтроки_(СтрокаXML, "windows-1251"); 
	
	КонтентПодписантаBase64 = Base64Строка(ДвоичныеДанные);	
	КонтентПодписантаBase64 = СтрЗаменить(КонтентПодписантаBase64, Символы.ВК, "");
	КонтентПодписантаBase64 = СтрЗаменить(КонтентПодписантаBase64, Символы.ПС, "");
	
	ЭДО_Кэш_Поместить(КлючПодписантаВКэше, КонтентПодписантаBase64);
	
	Возврат КонтентПодписантаBase64;	
	
КонецФункции

Функция XML_УниверсальныйПодписант970(BoxId, CertificateBytes, CertificateThumbprint, ДанныеАвторизации, ИННОрганизации) Экспорт
	
	КлючПодписантаВКэше = "Signer970" 
						+ BoxId 
						+ CertificateThumbprint 
						+ ЗначениеЗаполнено(ДанныеАвторизации.Доверенность) 
						+ СвойствоСтруктуры(ДанныеАвторизации, "СпособПередачиДоверенности", "");
						
	КонтентПодписантаBase64 = ЭДО_Кэш_Прочитать(КлючПодписантаВКэше);

	Если Не КонтентПодписантаBase64 = Неопределено Тогда
		Возврат КонтентПодписантаBase64;
	КонецЕсли;
	
	Фабрика = XML_ФабрикаXDTO("SignerUserDataXsdUrl970");
	
	UniversalSignersXDTO = КонтурСтандарт_ПолучитьПустойОбъектXDTO(Фабрика, "Signers", "Signers");
	КонтурСтандарт_УстановитьЗначениеXDTO(UniversalSignersXDTO, "BoxId", BoxId);
	
	Signer = КонтурСтандарт_НовыйДочернийОбъектXDTO(Фабрика, UniversalSignersXDTO, "Signer");
	
	СпособПодтвежденияПолномочий = СпособПодтвежденияПолномочийПодписанта(ИННОрганизации, ДанныеАвторизации);
	КонтурСтандарт_УстановитьЗначениеXDTO(Signer, "SignerPowersConfirmationMethod", СпособПодтвежденияПолномочий);
	
	Certificate = КонтурСтандарт_НовыйДочернийОбъектXDTO(Фабрика, Signer, "Certificate");
	КонтурСтандарт_УстановитьЗначениеXDTO(Certificate, "CertificateBytes", CertificateBytes);
	КонтурСтандарт_УстановитьЗначениеXDTO(Certificate, "CertificateThumbprint", CertificateThumbprint);
	
	СубъектСертификата = ДанныеАвторизации.СвойстваСертификата.Субъект;
	
	Если ЗначениеЗаполнено(СубъектСертификата) 
		И ЗначениеЗаполнено(СубъектСертификата.Фамилия)
		И ЗначениеЗаполнено(СубъектСертификата.Имя) Тогда
	
		Fio = КонтурСтандарт_НовыйДочернийОбъектXDTO(Фабрика, Signer, "Fio");
		
		КонтурСтандарт_УстановитьЗначениеXDTO(Fio, "LastName", СубъектСертификата.Фамилия); 
		КонтурСтандарт_УстановитьЗначениеXDTO(Fio, "FirstName", СубъектСертификата.Имя); 
		
		Если ЗначениеЗаполнено(СубъектСертификата.Отчество) Тогда
			КонтурСтандарт_УстановитьЗначениеXDTO(Fio, "MiddleName", СубъектСертификата.Отчество);
		КонецЕсли;
		
	КонецЕсли;
	
	Position = КонтурСтандарт_НовыйДочернийОбъектXDTO(Фабрика, Signer, "Position");
	КонтурСтандарт_УстановитьЗначениеXDTO(Position, "PositionSource", "Employee");
	
	СтрокаXML = КонтурСтандарт_ОбъектXDTO_В_СтрокаXML(Фабрика, UniversalSignersXDTO);
	
	XML_УдалитьОбъявлениеПрефиксовПространстваИмен("Signers", СтрокаXML);
	
	ДвоичныеДанные = КонтурСтандарт_ПолучитьДвоичныеДанныеИзСтроки_(СтрокаXML, "windows-1251"); 
	
	КонтентПодписантаBase64 = Base64Строка(ДвоичныеДанные);	
	КонтентПодписантаBase64 = СтрЗаменить(КонтентПодписантаBase64, Символы.ВК, "");
	КонтентПодписантаBase64 = СтрЗаменить(КонтентПодписантаBase64, Символы.ПС, "");
	
	ЭДО_Кэш_Поместить(КлючПодписантаВКэше, КонтентПодписантаBase64);
	
	Возврат КонтентПодписантаBase64;	
	
КонецФункции

Функция XML_УниверсальныйПодписант_ИоП(CertificateBytes, CertificateThumbprint, МашиночитаемаяДоверенностьДляОтправки) Экспорт
	
	РегистрационныйНомер = СвойствоСтруктуры(МашиночитаемаяДоверенностьДляОтправки, "СоставнойИдентификатор.РегистрационныеНомер", "");
	ИННДоверителя = СвойствоСтруктуры(МашиночитаемаяДоверенностьДляОтправки, "СоставнойИдентификатор.ИННДоверителя", "");
	ИННПредставителя = СвойствоСтруктуры(МашиночитаемаяДоверенностьДляОтправки, "СоставнойИдентификатор.ИННПредставителя", "");
	
	СоставнойИдентификаторМЧДЗаполнен =  ЗначениеЗаполнено(РегистрационныйНомер) И ЗначениеЗаполнено(ИННДоверителя) И ЗначениеЗаполнено(ИННПредставителя);
									
	ИспользоватьДоверенностьПоУмолчанию = МашиночитаемаяДоверенностьДляОтправки.ИспользоватьДоверенностьПоУмолчанию;
	
	Фабрика = XML_ФабрикаXDTO("TechnologicalSigner133UserContract1505");
	
	Signer = КонтурСтандарт_ПолучитьПустойОбъектXDTO(Фабрика, "Signer", "Signer");
	
	Certificate = КонтурСтандарт_НовыйДочернийОбъектXDTO(Фабрика, Signer, "Certificate");
	
	КонтурСтандарт_УстановитьЗначениеXDTO(Certificate, "CertificateThumbprint", CertificateThumbprint);
	КонтурСтандарт_УстановитьЗначениеXDTO(Certificate, "CertificateBytes", CertificateBytes);

	Если СоставнойИдентификаторМЧДЗаполнен	Или ИспользоватьДоверенностьПоУмолчанию Тогда
		
		PowerOfAttorney = КонтурСтандарт_НовыйДочернийОбъектXDTO(Фабрика, Signer, "PowerOfAttorney");
		
		Electronic = КонтурСтандарт_НовыйДочернийОбъектXDTO(Фабрика, PowerOfAttorney, "Electronic");
		КонтурСтандарт_УстановитьЗначениеXDTO(Electronic, "MethodOfProviding", "1");
		
		Storage = КонтурСтандарт_НовыйДочернийОбъектXDTO(Фабрика, Electronic, "Storage");
		КонтурСтандарт_УстановитьЗначениеXDTO(Storage, "UseDefault", Формат(ИспользоватьДоверенностьПоУмолчанию, "БЛ=false; БИ=true"));
		
		Если СоставнойИдентификаторМЧДЗаполнен Тогда

			FullId = КонтурСтандарт_НовыйДочернийОбъектXDTO(Фабрика, Storage, "FullId");
			
			КонтурСтандарт_УстановитьЗначениеXDTO(FullId, "RegistrationNumber", РегистрационныйНомер);
			КонтурСтандарт_УстановитьЗначениеXDTO(FullId, "IssuerInn", 			ИННДоверителя);
			КонтурСтандарт_УстановитьЗначениеXDTO(FullId, "RepresentativeInn", 	ИННПредставителя);
			
		КонецЕсли;
		
	КонецЕсли;
	
	СтрокаXML = КонтурСтандарт_ОбъектXDTO_В_СтрокаXML(Фабрика, Signer);
	
	XML_УдалитьОбъявлениеПрефиксовПространстваИмен("Signer", СтрокаXML);
	
	ДвоичныеДанные = КонтурСтандарт_ПолучитьДвоичныеДанныеИзСтроки_(СтрокаXML, "windows-1251"); 
	
	ДвоичныеДанныеBase64 = Base64Строка(ДвоичныеДанные);	
	ДвоичныеДанныеBase64 = СтрЗаменить(ДвоичныеДанныеBase64, Символы.ВК, "");
	ДвоичныеДанныеBase64 = СтрЗаменить(ДвоичныеДанныеBase64, Символы.ПС, "");
	
	Возврат ДвоичныеДанныеBase64;	
	
КонецФункции

Процедура XML_УдалитьОбъявлениеПрефиксовПространстваИмен(ИмяПакетаXDTO, СтрокаXML)
	
	СтрокаXML = СтрЗаменить(СтрокаXML, "xmlns=""" + ИмяПакетаXDTO + """ xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance""", "");
	СтрокаXML = СтрЗаменить(СтрокаXML, "xmlns=""" + ИмяПакетаXDTO + """ xmlns:xsd=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance""", "");
	
КонецПроцедуры

// Функция - Возвращает способ подтвеждения полномочий подписанта на основании данных авторизации и информации из ящика Диадок
//
// Параметры:
//  DiadocBoxID			 - Строка - ID ящика в Диадоке
//  ДанныеАвторизации	 - Структура - Данные авторизации в Диадоке (см. ПолучитьСтруктуруДанныхАвторизации())
// 
// Возвращаемое значение:
//  Строка - способ подтверждения полномочий подписанта, см. тег СпосПодтПолном в формате УПД приказа ЕД-7-26/970@
//			1 - "В соответствии с данными, содержащимися в электронной подписи"
//			2 - "В соответствии с доверенностью в электронной форме в машиночитаемом виде, если представление доверенности осуществляется посредством включения в каждый пакет электронных документов, подписываемых представителем"
//  		3 - "В соответствии с доверенностью в электронной форме в машиночитаемом виде, если представление доверенности осуществляется из информационной системы. При этом необходимая информация для запроса доверенности из информационной системы, указана в электронном документе"
//  		4 - "В соответствии с доверенностью в электронной форме в машиночитаемом виде, если представление доверенности осуществляется из информационной системы. При этом необходимая информация для запроса доверенности из информационной системы, представляется способом, отличным от указания в электронном документе"
//  		5 - "В соответствии с доверенностью в форме документа на бумажном носителе"
//  		6 - "Иное"
Функция СпособПодтвежденияПолномочийПодписанта(ИННОрганизации, ДанныеАвторизации)
	
	ИННСертификата = ПолучитьИННСертификата(ДанныеАвторизации.СвойстваСертификата);
	
	Если Не ЗначениеЗаполнено(ИННСертификата) Тогда
		Возврат "6";
	КонецЕсли;
	
	ИННСовпадают				= ИННСертификата = ИННОрганизации;
	ЭтоСертификатЮрЛица 		= ЭтоСертификатЮрЛица(ДанныеАвторизации.СвойстваСертификата);
	ЕстьДоверенность			= ЗначениеЗаполнено(ДанныеАвторизации.Доверенность);
	
	СоответствиеСпособаПодтвержденияИМЧД = Новый Структура;
	СоответствиеСпособаПодтвержденияИМЧД.Вставить("Метаинформацией", "4");
	СоответствиеСпособаПодтвержденияИМЧД.Вставить("Файлом", "2");
	
	Если Не ЭтоСертификатЮрЛица И ИННСовпадают Тогда
		
		//Это кейс, при котором ИП подписывает документ сертификатом ФЛ
		СпособПодтвержденияПолномочий = "6";
		
	ИначеЕсли ЕстьДоверенность Тогда
		
		СпособПередачиДоверенности = СвойствоСтруктуры(ДанныеАвторизации, "СпособПередачиДоверенности");
		СпособПодтвержденияПолномочий = СвойствоСтруктуры(СоответствиеСпособаПодтвержденияИМЧД, СпособПередачиДоверенности, "6");
		
	ИначеЕсли ЭтоСертификатЮрЛица И ИННСовпадают Тогда
		
		СпособПодтвержденияПолномочий = "1";
		
	Иначе
		
		СпособПодтвержденияПолномочий = "6";
		
	КонецЕсли;
		
	Возврат СпособПодтвержденияПолномочий;
	
КонецФункции

Функция ПолучитьИННСертификата(СвойстваСертификата)
	
	СубъектСертификата = СвойстваСертификата.Субъект;  
    
	Если ЗначениеЗаполнено(СубъектСертификата.ИННЮЛ) Тогда
		ИНН = СубъектСертификата.ИННЮЛ;
	ИначеЕсли ЗначениеЗаполнено(СубъектСертификата.ИНН) Тогда
		ИНН = СубъектСертификата.ИНН;
	Иначе
		ИНН = Неопределено;
	КонецЕсли;

	Возврат ИНН;
	
КонецФункции

Функция ЭтоСертификатЮрЛица(СвойстваСертификата)
	
	СубъектСертификата = СвойстваСертификата.Субъект;  
	
	Если ЗначениеЗаполнено(СубъектСертификата.ИННЮЛ)
		ИЛИ ЗначениеЗаполнено(СубъектСертификата.ОГРНИП) 
		ИЛИ ЗначениеЗаполнено(СубъектСертификата.ИНН) 
			И Не ЭтоИННФизЛица(СубъектСертификата.ИНН) Тогда
			
		ЭтоСертификатЮрЛица = Истина;
		
	Иначе
		
		ЭтоСертификатЮрЛица = Ложь;
		
	КонецЕсли;

	Возврат ЭтоСертификатЮрЛица;
	
КонецФункции

