//Зеркальная функция для "ПолучитьКодРегиона": по ISO коду региона возвращает его текстовое представление
Функция ПредставлениеРегионаПоКоду(КодРегионаСтрокой)
	
	Результат = "";
	
	НайденнаяСтрока = ТаблицаКодовРегионов().Найти(КодРегионаСтрокой,"КодСтрока");
	Если НЕ НайденнаяСтрока = Неопределено Тогда
		Результат = СокрЛП(НайденнаяСтрока.КраткоеНаименование+" "+НайденнаяСтрока.Сокращение);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


//Возвращает ISO код региона по текстовому представлению ("Свердловская обл"=>"RU-SVE")
Функция ПолучитьКодРегиона(ЗНАЧ ИмяРегиона)
	
	Если ИмяРегиона = "" Тогда
		Возврат "";
	КонецЕсли;
	
	//приведем синонимы к единому виду:
	
	ИмяРегиона = СтрЗаменить(ИмяРегиона,"Санкт",		"Ленинград");
	ИмяРегиона = СтрЗаменить(ИмяРегиона,"Камчатская",	"Камчатский");
	ИмяРегиона = СтрЗаменить(ИмяРегиона,"Читинская",	"Забайкальского");
	ИмяРегиона = СтрЗаменить(ИмяРегиона,"Пермская",		"Пермский");
	ИмяРегиона = СтрЗаменить(ИмяРегиона,"Горьковская",	"Нижегородская");
	
	ИмяРегионаПоиск = Врег(ИмяРегиона);
	
	Для каждого  Стр Из ТаблицаКодовРегионов() Цикл
		
		Если Найти(ИмяРегионаПоиск, Стр.ПредставлениеДляПоиска)>0 Тогда
			
			Возврат Стр.КодСтрока;      
			
		КонецЕсли;
		
	КонецЦикла;   
	
	Возврат "";
	
КонецФункции

Функция ПолучитьСтруктуруКонтактнойИнформации_КонтурEDI(ЗначенияПолей, ВидАдреса) Экспорт   
	
	СтруктураАдресаУФ = ПолучитьСтруктуруАдреса();   
	
	_ОписаниеОшибки = Неопределено;
	
	Модуль_КонтактнаяИнформацияСлужебный = ОбщийМодуль1С_КонтурEDI("КонтактнаяИнформацияСлужебный");
	Если Модуль_КонтактнаяИнформацияСлужебный <> Неопределено Тогда
		Попытка
			СтруктураАдресаУФ = Модуль_КонтактнаяИнформацияСлужебный.ПредыдущаяСтруктураКонтактнойИнформацииXML(ЗначенияПолей, ВидАдреса);
			Возврат СтруктураАдресаУФ;
		Исключение 
			_ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
	КонецЕсли; 
	
	Модуль_УправлениеКонтактнойИнформацией = ОбщийМодуль1С_КонтурEDI("УправлениеКонтактнойИнформацией");
	
	Если Модуль_УправлениеКонтактнойИнформацией <> Неопределено Тогда
		Попытка
			СтруктураАдресаУФ = Модуль_УправлениеКонтактнойИнформацией.ПредыдущаяСтруктураКонтактнойИнформацииXML(ЗначенияПолей, ВидАдреса);
			Возврат СтруктураАдресаУФ;
		Исключение 
			_ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
	КонецЕсли;
	
	Модуль_РаботаСАдресами = ОбщийМодуль1С_КонтурEDI("РаботаСАдресами");       
	
	Если Модуль_РаботаСАдресами <> Неопределено Тогда
		Попытка
			СтруктураАдресаУФ = Модуль_РаботаСАдресами.СведенияОбАдресе(ЗначенияПолей);
			Возврат СтруктураАдресаУФ;
		Исключение
			Попытка
				СтруктураАдресаУФ = Модуль_РаботаСАдресами.ПредыдущаяСтруктураКонтактнойИнформацииXML(ЗначенияПолей, ВидАдреса);
				Возврат СтруктураАдресаУФ;	
				
			Исключение
				_ОписаниеОшибки = ОписаниеОшибки();	
			КонецПопытки;
		КонецПопытки;
	КонецЕсли; 
	
	Если _ОписаниеОшибки = Неопределено Тогда
		_ОписаниеОшибки = "Не удалось получить структуру контактной информации";				
	КонецЕсли;   
	
	Метрика_Переменные = Новый Структура("ЗначенияПолей, ВидАдреса", Строка(ЗначенияПолей), Строка(ВидАдреса));
	Метрика_ОтправитьСразу = Истина;
	Метрика_Ошибка("РазобратьАдресУФ", _ОписаниеОшибки, , Метрика_Переменные, Метрика_ОтправитьСразу); 
	
	Возврат СтруктураАдресаУФ;
	
КонецФункции

Функция РазобратьАдресУФ(Объект, ВидАдреса = "")
	Если ВидАдреса="" Тогда
		ВидАдреса = Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента;
	КонецЕсли;
	
	СтруктураАдреса = ПолучитьСтруктуруАдреса();
	
	Если Объект.КонтактнаяИнформация.Количество()=0 Тогда
		Возврат СтруктураАдреса; //не заведен адрес в 1С
	КонецЕсли;
	
	ЗначенияПолей=Объект.КонтактнаяИнформация[0].ЗначенияПолей;
	
	Если ОпределитьРелизКонфигурации()= "11.0" 
		ИЛИ ОпределитьРелизКонфигурации()="1.4" Тогда 
		
		//неповезло, старая БСП, затолкаем все в улицу
		КИ_УТ11_0_Строка="";
		Выполнить("КИ_УТ11_0_Строка = УправлениеКонтактнойИнформацией.ПолучитьКонтактнуюИнформацияОбъекта(Объект,ВидАдреса)");
		НайденныеСтрокиРоссии = Объект.КонтактнаяИнформация.НайтиСтроки(Новый Структура("Страна", "РОССИЯ"));
		
		Если НайденныеСтрокиРоссии.Количество()>0 Тогда 
			СтруктураАдреса.Вставить("ВидАдреса", 	"Российский");
			СтруктураАдреса.Вставить("Улица", 		КИ_УТ11_0_Строка);
			СтруктураАдреса.Вставить("КодСтраны");
		ИНаче
			СтруктураАдреса.Вставить("ВидАдреса", 	"Иностранный");
			СтруктураАдреса.Вставить("Адрес", 		КИ_УТ11_0_Строка);
		КонецЕсли;
		СтруктураАдреса.Вставить("Представление", 	КИ_УТ11_0_Строка);
		
	Иначе 
				
		СтруктураАдресаУФ = ПолучитьСтруктуруКонтактнойИнформации_КонтурEDI(ЗначенияПолей, ВидАдреса);
		
		ЗаполнитьЗначенияСвойств(СтруктураАдреса, СтруктураАдресаУФ);
		Если НЕ СтруктураАдреса.КодСтраны = "643" 
			И СтруктураАдреса.Улица = Неопределено Тогда 
			СтруктураАдреса.Вставить("ВидАдреса", 	"Иностранный");
			СтруктураАдреса.Вставить("Адрес", 		?(СтруктураАдресаУФ.Свойство("Представление"),СтруктураАдресаУФ.Представление,""));
		Иначе
			СтруктураАдреса.Вставить("ВидАдреса", 	"Российский");
		КонецЕсли;
		СтруктураАдреса.Вставить("Представление", 	?(СтруктураАдресаУФ.Свойство("Представление"),СтруктураАдресаУФ.Представление,""));
		
		Если СтруктураАдресаУФ.Свойство("Регион") Тогда		
			СтруктураАдреса.Вставить("Регион", 			ПолучитьКодРегиона(СтруктураАдресаУФ.Регион));
		КонецЕсли;   
		
		Если СтруктураАдресаУФ.Свойство("Здание") Тогда		
			СтруктураАдреса.Вставить("Дом", 			СтруктураАдресаУФ.Здание.Номер);
		КонецЕсли;
		
		Если СтруктураАдресаУФ.Свойство("Корпуса") И ЗначениеЗаполнено(СтруктураАдресаУФ.Корпуса) Тогда
			СтруктураАдресаУФ.Корпуса[0].Свойство("Номер", СтруктураАдреса.Корпус);
		КонецЕсли;
		
		Если СтруктураАдресаУФ.Свойство("Помещения") И ЗначениеЗаполнено(СтруктураАдресаУФ.Помещения) Тогда
			СтруктураАдресаУФ.Помещения[0].Свойство("Номер", СтруктураАдреса.Квартира);
		КонецЕсли;

		
		Если СтруктураАдреса.ВидАдреса = "Российский" Тогда 
			СтруктураАдреса.КодСтраны = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураАдреса;
	
КонецФункции

Функция РазобратьАдрес(Объект, ТипАдреса = "") Экспорт
	
	СтруктураАдреса = ПолучитьСтруктуруАдреса();
	
	Если НЕ ЗначениеЗаполнено(Объект) Тогда
		Возврат СтруктураАдреса;
	КонецЕсли;
	
	// значение по умолчанию
	СтруктураАдреса.Вставить("ВидАдреса", "Российский");
	
	Если НЕ ЗначениеЗаполнено(ТипАдреса) Тогда
		Возврат СтруктураАдреса;
	КонецЕсли;
	
	Если ТипАдреса="Фактический" Тогда
		Начало = "Факт";
	ИначеЕсли ТипАдреса="Регистрации"
		ИЛИ ТипАдреса="Юридический" Тогда
		Начало = "Юр";
	Иначе
		Возврат СтруктураАдреса;
	КонецЕсли;
	
	Если ИмяКонфигурации1С = "ТКПТ" Тогда
		
		Если ТипАдреса="Фактический" Тогда
			ВидАдреса = Справочники.ВидыКонтактнойИнформации.АдресФактический;
		ИначеЕсли ТипАдреса="Регистрации"
			Или ТипАдреса="Юридический" Тогда
			ВидАдреса = Справочники.ВидыКонтактнойИнформации.АдресЮридический;
		КонецЕсли;
	Иначе
			
		ОбъектКИ = Объект;
		ТипЮрФизЛицоСвое = ПолучитьТипЗначенияОбъекта("ЮрФизЛицоСвое");
		Если ЗначениеЗаполнено(ТипЮрФизЛицоСвое) И ТипЗнч(Объект) = Тип(ТипЮрФизЛицоСвое) Тогда
			
			Если ИмяКонфигурации1С = "КА" ИЛИ ИмяКонфигурации1С = "УПП" ИЛИ ИмяКонфигурации1С = "БП" Тогда
				Если Объект.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
					Окончание = "ФизЛица";
					ОбъектКИ = Объект.ИндивидуальныйПредприниматель;
				Иначе
					Окончание = "Организации";
				КонецЕсли;
			Иначе
				Окончание = "Организации";
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(Объект) = Тип("СправочникСсылка.Контрагенты") Тогда
			Окончание = "Контрагента";
		ИначеЕсли ИмяКонфигурации1С = "УФ_УТ"
			И ТипЗнч(Объект) = Тип("СправочникСсылка.Партнеры") Тогда
			Начало = "";
			Окончание = "Партнера";
		КонецЕсли;
	
		ВидАдреса = Справочники.ВидыКонтактнойИнформации[Начало+"Адрес"+Окончание].ПолучитьОбъект().Ссылка;

	КонецЕсли;
	
	//УФ - без всяких запросов
	Если Лев(ИмяКонфигурации1С,3)= "УФ_" Тогда 
		Возврат РазобратьАдресУФ(Объект, ВидАдреса);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Объект", ОбъектКИ);
	Запрос.УстановитьПараметр("Тип"   , Перечисления.ТипыКонтактнойИнформации.Адрес);
	Запрос.УстановитьПараметр("Вид"   , ВидАдреса);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	КонтактнаяИнформация.Представление,
	|	КонтактнаяИнформация.Поле1 КАК Индекс,
	|	КонтактнаяИнформация.Поле2 КАК Область,
	|	КонтактнаяИнформация.Поле3 КАК Район,
	|	КонтактнаяИнформация.Поле4 КАК Город,
	|	КонтактнаяИнформация.Поле5 КАК НаселенныйПункт,
	|	КонтактнаяИнформация.Поле6 КАК Улица,
	|	КонтактнаяИнформация.Поле7 КАК Дом,
	|	КонтактнаяИнформация.Поле8 КАК Корпус,
	|	КонтактнаяИнформация.Поле9 КАК Квартира,
	|	КонтактнаяИнформация.Поле10
	// |,Регионы.КодРегионаВКоде
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	//|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	//|			АдресныйКлассификатор.КодРегионаВКоде КАК КодРегионаВКоде,
	//|			АдресныйКлассификатор.Наименование КАК Наименование
	//|		ИЗ
	//|			РегистрСведений.АдресныйКлассификатор КАК АдресныйКлассификатор
	//|		ГДЕ
	//|			АдресныйКлассификатор.ТипАдресногоЭлемента = 1) КАК Регионы
	//|		ПО (КонтактнаяИнформация.Поле2 ПОДОБНО Регионы.Наименование + ""%"")
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Объект
	|	И КонтактнаяИнформация.Тип = &Тип
	|	И КонтактнаяИнформация.Вид = &Вид";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() тогда 
		
		Если 	Выборка.Область = "" и 
			Выборка.Район = "" и 
			Выборка.Город = "" и 
			Выборка.НаселенныйПункт = "" и 
			Выборка.Улица = "" и  
			Выборка.Дом = "" и 
			Выборка.Корпус = "" и 
			Выборка.Квартира = "" Тогда 
			
			СтруктураАдреса.Вставить("КодСтраны",  ?(ЗначениеЗаполнено(Выборка.индекс), Справочники.КлассификаторСтранМира.НайтиПоНаименованию(Выборка.Индекс).Код, "") );
			СтруктураАдреса.Вставить("Адрес", 		СтрЗаменить(Выборка.Представление, Выборка.Индекс, ""));
			
			СтруктураАдреса.Вставить("ВидАдреса", "Иностранный"); 
			
		Иначе 
			
			СтруктураАдреса.Вставить("Индекс", 			Выборка.Индекс);
			СтруктураАдреса.Вставить("Регион", 			"");
			СтруктураАдреса.Вставить("Район", 			Выборка.Район);
			СтруктураАдреса.Вставить("Город", 			Выборка.Город);
			СтруктураАдреса.Вставить("НаселенныйПункт", Выборка.НаселенныйПункт);
			СтруктураАдреса.Вставить("Улица", 			Выборка.Улица);
			СтруктураАдреса.Вставить("Дом", 			Выборка.Дом);
			СтруктураАдреса.Вставить("Корпус", 			Выборка.Корпус);
			СтруктураАдреса.Вставить("Квартира", 		Выборка.Квартира);
			
			СтруктураАдреса.Вставить("КодСтраны");
			СтруктураАдреса.Вставить("Адрес");
			
			Если ЗначениеЗаполнено(Выборка.Область) Тогда 
				СтруктураАдреса.Вставить("Регион", ПолучитьКодРегиона(Выборка.Область));
			КонецЕсли;	
			
			СтруктураАдреса.Вставить("ВидАдреса", "Российский");
			
		КонецЕсли;	
		СтруктураАдреса.Вставить("Представление", Выборка.Представление);
		
	КонецЕсли;	
	
	Возврат СтруктураАдреса;
	
КонецФункции 

Функция ПолучитьСтруктуруАдреса()
	
	СтруктураАдреса = Новый Структура;
	СтруктураАдреса.Вставить("Индекс");
	СтруктураАдреса.Вставить("Регион");
	СтруктураАдреса.Вставить("Район");
	СтруктураАдреса.Вставить("Город");
	СтруктураАдреса.Вставить("НаселенныйПункт");
	СтруктураАдреса.Вставить("Улица");
	СтруктураАдреса.Вставить("Дом");
	СтруктураАдреса.Вставить("Корпус");
	СтруктураАдреса.Вставить("Квартира");
	
	СтруктураАдреса.Вставить("КодСтраны");
	СтруктураАдреса.Вставить("Адрес");
	
	СтруктураАдреса.Вставить("ВидАдреса");
	СтруктураАдреса.Вставить("Представление");
	
	Возврат СтруктураАдреса;
	
КонецФункции

Функция ПолучитьФИО(Объект,ДатаДок)
	
	Фамилия		= "";
	Имя			= "";
	Отчество	= "";
	
	
	
	Если ТипЗнч(Объект) = Тип("СправочникСсылка.Организации") Тогда
		
		ФИО = Неопределено;
		
		ЮрФизЛицо = Объект;
		Если ИмяКонфигурации1С = "КА" ИЛИ ИмяКонфигурации1С = "УПП" Тогда
			ЮрФизЛицо = Объект.ИндивидуальныйПредприниматель;
		КонецЕсли;
		
		Если ИмяКонфигурации1С = "БП" Тогда
			Попытка
				ОтветственыеЛицаОрганизации = ОбщийМодуль1С_КонтурEDI("ОбщегоНазначения").ОтветственныеЛица(ЮрФизЛицо, ТекущаяДата());
				ФИО = ОтветственыеЛицаОрганизации.РуководительФИО;	
			Исключение
			    ТекстОшибки = ОписаниеОшибки();
			КонецПопытки;
		ИначеЕсли ИмяКонфигурации1С = "УФ_БП" Тогда
			Попытка
				ОтветственыеЛицаОрганизации = ОбщийМодуль1С_КонтурEDI("ОтветственныеЛицаБП").ОтветственныеЛица(ЮрФизЛицо, ТекущаяДата());
				ФИО = ОтветственыеЛицаОрганизации.РуководительФИО;	
			Исключение
				ТекстОшибки = ОписаниеОшибки();
			КонецПопытки;
		Иначе
			
			СписокМодулей = Новый Массив;
			
			_ОбщийМодуль1С = Неопределено;
			
			Если ЕстьОбщийМодуль1С_КонтурEDI("ФизическиеЛицаУТ", _ОбщийМодуль1С) Тогда
				СписокМодулей.Добавить(_ОбщийМодуль1С);	
			КонецЕсли;
			
			Если ЕстьОбщийМодуль1С_КонтурEDI("ФормированиеПечатныхФорм", _ОбщийМодуль1С) Тогда 
				СписокМодулей.Добавить(_ОбщийМодуль1С);	
			КонецЕсли;
			
			СписокМодулей.Добавить(Неопределено);
			
			Для Каждого ТекМодуль Из СписокМодулей Цикл
				Попытка
					Если ТекМодуль = Неопределено Тогда
						ФИО	= Вычислить("ФамилияИмяОтчество(ЮрФизЛицо, ДатаДок);");	
					Иначе   
						ФИО = ТекМодуль.ФамилияИмяОтчество(ЮрФизЛицо, ДатаДок);
					КонецЕсли;
					Прервать;
				Исключение
				    ТекстОшибки = ОписаниеОшибки();
				КонецПопытки;		
			КонецЦикла;
			
		КонецЕсли;
		
		Если ТипЗнч(ФИО) = Тип("Структура") Тогда
			Фамилия		= ФИО.Фамилия;
			Имя			= ФИО.Имя;
			Отчество	= ФИО.Отчество;
		КонецЕсли;
		
	КонецЕсли;
	
	Если СокрЛП(Фамилия)+СокрЛП(Имя)+СокрЛП(Отчество) = "" Тогда
		
		// разложим строку
		
		ФИО = Новый СписокЗначений;
		Стр = СокрЛП(Объект.НаименованиеПолное);
		Пока Истина Цикл
			Поз = Найти(Стр," ");
			Если Поз=0 Тогда
				ФИО.Добавить(СокрЛП(Стр));
				Прервать;
			КонецЕсли;
			ФИО.Добавить(СокрЛП(Лев(Стр,Поз-1)));
			Стр = СокрЛ(Сред(Стр,Поз));
		КонецЦикла;
		
		ФИО.Количество();
		
		Фамилия  = СокрЛП(?(0 < ФИО.Количество(), ФИО.Получить(0).Значение, ""));
		Имя		 = СокрЛП(?(1 < ФИО.Количество(), ФИО.Получить(1).Значение, ""));
		Отчество = "";                                                  
		
		Если ФИО.Количество() > 2 Тогда 
			// а вот отчество бывает и не из одного слова				
			Для Сч = 3 По ФИО.Количество() Цикл
				Отчество = Отчество + ФИО.Получить(Сч-1).Значение + " ";
			КонецЦикла;
			
			Если НЕ ПустаяСтрока(Отчество) Тогда
				Отчество = Лев(Отчество,СтрДлина(Отчество)-1);
			КонецЕсли;
		КонецЕсли; 
		
		Отчество = СокрЛП(Отчество);		
		
	КонецЕсли;
	
	ФИО = Новый  Структура;
	ФИО.Вставить("Фамилия",		Фамилия);
	ФИО.Вставить("Имя",			Имя);
	ФИО.Вставить("Отчество",	Отчество);
	
	Возврат ФИО;
	
КонецФункции

Функция ПреобразоватьЮрФизЛицо_1С_в_EDI(Объект,ТипАдреса,ТолькоGLN = Ложь, Тип1С = "", Сообщение = Неопределено) Экспорт
	
	ЮрФизЛицо = Новый Структура;
	ЮрФизЛицо.Вставить("Вид"); // ЮрЛицо ФизЛицо ТолькоGLN
	ЮрФизЛицо.Вставить("GLN");
	ЮрФизЛицо.Вставить("ИНН");
	ЮрФизЛицо.Вставить("КПП");
	
	ЮрФизЛицо.Вставить("Наименование");
	
	ЮрФизЛицо.Вставить("Фамилия");
	ЮрФизЛицо.Вставить("Имя");
	ЮрФизЛицо.Вставить("Отчество");
	
	ЮрФизЛицо.Вставить("ТипАдреса");   // Юридический Фактический
	ЮрФизЛицо.Вставить("Адрес",ПолучитьСтруктуруАдреса());
	
	ЮрФизЛицо.Вставить("Телефон");
	
	ЮрФизЛицо.Вставить("Банк");
	ЮрФизЛицо.Вставить("БИК");
	ЮрФизЛицо.Вставить("НомерСчета");
	ЮрФизЛицо.Вставить("КоррСчет");
	
	ЮрФизЛицо.Вставить("Руководитель");
	ЮрФизЛицо.Вставить("ГлавныйБухгалтер");
	ЮрФизЛицо.Вставить("КодВСистемеПокупателя");
	
	ЮрФизЛицо.Вставить("ТипЛокализации");
	
	Если Не ЗначениеЗаполнено(Объект) Тогда
		Возврат ЮрФизЛицо; 	
	КонецЕсли;
	
	GLN = "";
	
	ТипОбъекта_НашейТочкиДоставки = ПолучитьТипЗначенияОбъекта("ТочкаДоставкиСвоя");
	ТипОбъекта_НашейСтороннейТочкиДоставки = ПолучитьКонстантуEDI("СвойСправочникТочекДоставки");
	ТипОбъекта_ЮрФизЛицоСвое = ПолучитьТипЗначенияОбъекта("ЮрФизЛицоСвое");
	ТипОбъекта_ЮрФизЛицоСтороннее = ПолучитьТипЗначенияОбъекта("ЮрФизЛицоСтороннее");
	
	// КлассификаторОрганизацийЕГАИС 
	
	Если ЕстьНеобходимыеМетаданные("Справочники.КлассификаторОрганизацийЕГАИС")
		И ТипЗнч(Объект) = Тип("СправочникСсылка.КлассификаторОрганизацийЕГАИС") Тогда 
		
		ОрганизацияЕГАИССсылка = Объект;
		
		Если ОрганизацияЕГАИССсылка.ТипОрганизации = Перечисления.ТипыОрганизацийЕГАИС.ЮридическоеЛицоРФ Тогда
			ВидОрганизации = "ЮрЛицо";
		ИначеЕсли ОрганизацияЕГАИССсылка.ТипОрганизации = Перечисления.ТипыОрганизацийЕГАИС.ИндивидуальныйПредпринимательРФ Тогда
			ВидОрганизации = "ФизЛицо";
		ИначеЕсли ОрганизацияЕГАИССсылка.ТипОрганизации = Перечисления.ТипыОрганизацийЕГАИС.ИностранныйКонтрагент
			ИЛИ ОрганизацияЕГАИССсылка.ТипОрганизации = Перечисления.ТипыОрганизацийЕГАИС.КонтрагентТаможенногоСоюза Тогда
			ВидОрганизации = "Нерезидент";
		КонецЕсли;
		
		Если ВидОрганизации = "Нерезидент" Тогда
			ИНН = ОрганизацияЕГАИССсылка.ИдентификаторОрганизацииТС;
		Иначе
			ИНН = ОрганизацияЕГАИССсылка.ИНН;
			КПП = ОрганизацияЕГАИССсылка.КПП;
		КонецЕсли;
		
		ЮрФизЛицо.Вставить("Наименование",    ОрганизацияЕГАИССсылка.НаименованиеПолное);
		ЮрФизЛицо.Вставить("Вид", ВидОрганизации);
		ЮрФизЛицо.Вставить("ИНН", ИНН);
		ЮрФизЛицо.Вставить("КПП", КПП);
		ЮрФизЛицо.Вставить("ТипАдреса", "Юридический");
		
		Если ВидОрганизации = "ФизЛицо" Тогда
			
			ФИО = ПолучитьФИО(ОрганизацияЕГАИССсылка, ТекущаяДатаСеанса());
			
			ЮрФизЛицо.Вставить("Фамилия",    ФИО.Фамилия);
			ЮрФизЛицо.Вставить("Имя",        ФИО.Имя);
			ЮрФизЛицо.Вставить("Отчество",   ФИО.Отчество);
			
		КонецЕсли;
		
		Возврат ЮрФизЛицо;
		
	КонецЕсли;
	
	//
	
	Если ЗначениеЗаполнено(ТипОбъекта_ЮрФизЛицоСвое) И ТипЗнч(Объект) = Тип(ТипОбъекта_ЮрФизЛицоСвое) Тогда
		
		GLN = ПолучитьЗначениеСвойстваОбъектаEDI(Объект, "GLN_Организации");		
		
	ИначеЕсли ЗначениеЗаполнено(ТипОбъекта_ЮрФизЛицоСтороннее) И ТипЗнч(Объект) = Тип(ТипОбъекта_ЮрФизЛицоСтороннее) Тогда
		
		Если Тип1С = "ТочкаДоставкиСторонняя" Тогда
			
			ТочкаДоставки = НайтиОбъектПоЗначениюСвойства("ЮрФизЛицо_ТочкиДоставки",Объект);
			Если ЗначениеЗаполнено(ТочкаДоставки) Тогда
				
				ТочкаДоставкиПолностью = ПолучитьЭлементСправочника("ТочкиДоставкиСторонние",ТочкаДоставки);
				GLN = ТочкаДоставкиПолностью.GLN;
				//на рефакторинг: избыточность   //конвертация
				
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(GLN) Тогда
				
				GLN = ПолучитьЗначениеСвойстваОбъектаEDI(Объект, "GLN_Контрагента");
				
			КонецЕсли;
			
		Иначе
			
			GLN = ПолучитьЗначениеСвойстваОбъектаEDI(Объект, "GLN_Контрагента");
			
			Если GLN = Неопределено Тогда
				
				ТочкаДоставки = НайтиОбъектПоЗначениюСвойства("ЮрФизЛицо_ТочкиДоставки",Объект);
				Если ЗначениеЗаполнено(ТочкаДоставки) Тогда
					
					ТочкаДоставкиПолностью = ПолучитьЭлементСправочника("ТочкиДоставкиСторонние",ТочкаДоставки);
					GLN = ТочкаДоставкиПолностью.GLN;
					//на рефакторинг: избыточность   //конвертация
					
				КонецЕсли;
				
			КонецЕсли;   
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(GLN) Тогда 
			//конвертация неосновного контрагента
			
			GLN = ПолучитьЗначениеСвойстваОбъектаEDI(Объект, "GLN_ДопКонтрагента");
			
		КонецЕсли;  										
		
	ИначеЕсли ТипЗнч(Объект) = Тип(ТипОбъекта_НашейТочкиДоставки) Тогда
		
		GLN					= ПолучитьЗначениеСвойстваОбъектаEDI(Объект, "GLN_НашейТочкиДоставки");
		ТипЛокализацииТочки	= ПолучитьЗначениеСвойстваОбъектаEDI(Объект, "ТипЛокализацииТочки");	
		
		ЮрФизЛицо.Вставить("GLN",				GLN);
		ЮрФизЛицо.Вставить("ТипЛокализации",	ТипЛокализацииТочки); 
		
		Возврат ЮрФизЛицо;
		
	ИначеЕсли ЗначениеЗаполнено(ТипОбъекта_НашейСтороннейТочкиДоставки) И ТипЗнч(Объект) = Тип("СправочникСсылка."+ТипОбъекта_НашейСтороннейТочкиДоставки) Тогда
		
		ТочкаДоставки = НайтиОбъектПоЗначениюСвойства("СвойСправочник_ТочкиДоставки",Объект,ОпределитьПартнераСообщения(Сообщение));
		Если ЗначениеЗаполнено(ТочкаДоставки) Тогда 
			ЮрФизЛицо.Вставить("GLN", ТочкаДоставки.GLN);                  
			Возврат ЮрФизЛицо;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Объект) = Тип("Строка") Тогда
		
		Возврат ЮрФизЛицо;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(GLN)
		И ПеременнаяСодержитСвойство(Объект, "GLN") Тогда
		
		GLN = Объект.GLN;
		
	КонецЕсли;
	
	ЮрФизЛицо.Вставить("GLN",				GLN);
		
	Если ТолькоGLN ИЛИ ТипЗнч(Объект) = Тип("СправочникСсылка.КонтурEDI_ТочкиДоставки") Тогда
		Возврат ЮрФизЛицо;
	КонецЕсли;
			
	СведенияОЮрФизЛице = ПолучитьСведенияОЮрФизЛице_Контур(Объект);
	
	ЮрФизЛицо.Вставить("Наименование",	СведенияОЮрФизЛице.ПолноеНаименование);
	
	ЮрФизЛицо.Вставить("ИНН",			СведенияОЮрФизЛице.ИНН);
	ЮрФизЛицо.Вставить("КПП",			СведенияОЮрФизЛице.КПП);
	
	ЮрФизЛицо.Вставить("Телефон",		СведенияОЮрФизЛице.Телефоны);
	
	Если НЕ ИмяКонфигурации1С = "Розница" И НЕ ИмяКонфигурации1С = "УФ_Розница" Тогда
		
		ЮрФизЛицо.Вставить("Банк",			СокрЛП(СведенияОЮрФизЛице.Банк));
		ЮрФизЛицо.Вставить("БИК",			СведенияОЮрФизЛице.БИК);
		ЮрФизЛицо.Вставить("НомерСчета",	СведенияОЮрФизЛице.НомерСчета);
		ЮрФизЛицо.Вставить("КоррСчет",		СведенияОЮрФизЛице.КоррСчет);		
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект) Тогда
		Если ИмяКонфигурации1С = "ТКПТ" Тогда
			Если (ТипЗнч(Объект)=Тип("СправочникСсылка.Организации")) ИЛИ
				((ТипЗнч(Объект)=Тип("СправочникСсылка.Контрагенты")) И (Объект.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо)) Тогда
				Вид = "ЮрЛицо";
			Иначе
				Вид = "ФизЛицо";
			КонецЕсли;
		ИначеЕсли ИмяКонфигурации1С="УФ_БП" Тогда
			Если Объект.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо Тогда
				Вид = "ЮрЛицо";
			Иначе
				Вид = "ФизЛицо";
			КонецЕсли;
		ИначеЕсли ИмяКонфигурации1С="УФ_УНФ" И ОпределитьРелизКонфигурации()="1.6" Тогда
			Если (ТипЗнч(Объект)=Тип("СправочникСсылка.Организации") И Объект.ЮридическоеФизическоеЛицо=Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо) 
				ИЛИ (ТипЗнч(Объект)=Тип("СправочникСсылка.Контрагенты")	И Объект.ВидКонтрагента=Перечисления.ВидыКонтрагентов.ЮридическоеЛицо) Тогда
				Вид = "ЮрЛицо";
			Иначе
				Вид = "ФизЛицо";
			КонецЕсли;
		ИначеЕсли ИмяКонфигурации1С = "АСТОР" И ПеременнаяСодержитСвойство(Объект, "ТипКонтрагента") Тогда
			Если Объект.ТипКонтрагента = Перечисления.ТипыКонтрагентов.ФизЛицо Тогда
				Вид = "ФизЛицо";
			Иначе
				Вид = "ЮрЛицо";
			КонецЕсли;
		Иначе
			Если Объект.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо
			 Или (ЕстьНеобходимыеМетаданные("Перечисления.ЮрФизЛицо.ЗначенияПеречисления.ИндивидуальныйПредприниматель")
				И Объект.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель) Тогда
				Вид = "ФизЛицо";
			Иначе
				Вид = "ЮрЛицо";
			КонецЕсли;
		КонецЕсли;
		
		ЭтоНерезидент = Ложь;
		ИмяСправочникаКонтрагенты = ПолучитьТипЗначенияОбъекта("ЮрФизЛицоСтороннее",,Истина);
		
		Если ТипЗнч(Объект) = Тип("СправочникСсылка."+ИмяСправочникаКонтрагенты) Тогда
			
			Если Метаданные.Справочники[ИмяСправочникаКонтрагенты].Реквизиты.Найти("алкЧленТаможенногоСоюза") <> Неопределено Тогда
				ЭтоНерезидент = Объект.алкЧленТаможенногоСоюза;			
			ИначеЕсли Метаданные.Справочники[ИмяСправочникаКонтрагенты].Реквизиты.Найти("НеЯвляетсяРезидентом") <> Неопределено Тогда
				ЭтоНерезидент = Объект.НеЯвляетсяРезидентом;
			КонецЕсли;
						
			Если ЭтоНерезидент Тогда
				Вид =  "Нерезидент";
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЮрФизЛицо.Вставить("Вид",Вид);
	
	Если Вид = "ФизЛицо" Тогда
		
		ФИО = ПолучитьФИО(Объект,ТекущаяДата());
		
		ЮрФизЛицо.Вставить("Фамилия",	ФИО.Фамилия);
		ЮрФизЛицо.Вставить("Имя",		ФИО.Имя);
		ЮрФизЛицо.Вставить("Отчество",	ФИО.Отчество);
		
	КонецЕсли;
	
	// адрес структурой
	ЮрФизЛицо.Вставить("ТипАдреса", ТипАдреса);
	ЮрФизЛицо.Вставить("Адрес",		РазобратьАдрес(Объект,ТипАдреса));
	
	Если ЗначениеЗаполнено(ТипОбъекта_ЮрФизЛицоСвое) И ТипЗнч(Объект) = Тип(ТипОбъекта_ЮрФизЛицоСвое) Тогда
		
		Руководители = ОтветственныеЛицаОрганизации_КонтурEDI(Объект, ТекущаяДата());
		
		ЮрФизЛицо.Вставить("Руководитель",		Строка(Руководители.Руководитель));
		ЮрФизЛицо.Вставить("ГлавныйБухгалтер",	Строка(Руководители.ГлавныйБухгалтер));
		
	КонецЕсли;
	
	Возврат ЮрФизЛицо;
	
КонецФункции

Функция ОтветственныеЛицаОрганизации_КонтурEDI(Организация, Дата = Неопределено) 
	
	Результат = Неопределено;
	ВызываемыйОбщийМодуль1С = Неопределено;
	
	Если ЕстьОбщийМодуль1С_КонтурEDI("ОтветственныеЛицаСервер", ВызываемыйОбщийМодуль1С) Тогда 
		
		Попытка
			Результат = ВызываемыйОбщийМодуль1С.ПолучитьОтветственныеЛицаОрганизации(Организация, Дата);
		Исключение
			ТекстОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;

	Если Результат = Неопределено 
		И ЕстьОбщийМодуль1С_КонтурEDI("РегламентированнаяОтчетность", ВызываемыйОбщийМодуль1С) Тогда
		                 
		Попытка
			Результат = ВызываемыйОбщийМодуль1С.ПолучитьОтветственныеЛицаОрганизации(Организация, Дата);	
		Исключение
		    ТекстОшибки = ОписаниеОшибки();
		КонецПопытки;
		
		Если Результат = Неопределено Тогда
			
			Попытка
				Результат = ВызываемыйОбщийМодуль1С.ОтветственныеЛицаОрганизации(Организация, Дата);	
			Исключение
			    ТекстОшибки = ОписаниеОшибки();
			КонецПопытки;
			
		КонецЕсли;
		
		Если Результат = Неопределено Тогда
			
			Попытка
				Результат = ВызываемыйОбщийМодуль1С.ОтветственныеЛицаОрганизаций(Организация, Дата);	
			Исключение
			    ТекстОшибки = ОписаниеОшибки();
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Результат = Неопределено Тогда
		Результат = Новый Структура;
	КонецЕсли;
	
	Если НЕ Результат.Свойство("Руководитель") Тогда
		Результат.Вставить("Руководитель", "");
	КонецЕсли;
	
	Если НЕ Результат.Свойство("ГлавныйБухгалтер") Тогда
		Результат.Вставить("ГлавныйБухгалтер", "");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСведенияОЮрФизЛице_Контур(ЮрФизЛицо, ДатаПериода = Неопределено) Экспорт

	СведенияОЮрФизЛице = Неопределено;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ЮрФизЛицо",	 	   ЮрФизЛицо);
	ДополнительныеПараметры.Вставить("ДатаПериода",	 	   ДатаПериода);
	ДополнительныеПараметры.Вставить("СведенияОЮрФизЛице", СведенияОЮрФизЛице);
	
	СтандартнаяОбработкаEDI = Истина;
	ОбработкаСобытияПодключаемогоМодуля("ПолучитьСведенияОЮрФизЛице", СтандартнаяОбработкаEDI, ДополнительныеПараметры);
	
	Если СтандартнаяОбработкаEDI = Ложь Тогда 
		
		Возврат ДополнительныеПараметры.СведенияОЮрФизЛице;
		
	КонецЕсли;
	
	Если ДатаПериода = Неопределено Тогда
		ДатаПериода = ТекущаяДата();
	КонецЕсли;
	
	Попытка
		Если ИмяКонфигурации1С = "УФ_УТ" Тогда
			Выполнить("СведенияОЮрФизЛице = ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ЮрФизЛицо, ДатаПериода);");
		ИначеЕсли ИмяКонфигурации1С = "УФ_БП" Тогда
			Выполнить("СведенияОЮрФизЛице = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(ЮрФизЛицо, ДатаПериода);");
		ИначеЕсли ИмяКонфигурации1С = "УФ_УНФ" Тогда  
			Попытка
				Выполнить("СведенияОЮрФизЛице = УправлениеНебольшойФирмойСервер.СведенияОЮрФизЛице(ЮрФизЛицо, ДатаПериода);");
			Исключение
				Выполнить("СведенияОЮрФизЛице = ПечатьДокументовУНФ.СведенияОЮрФизЛице(ЮрФизЛицо, ДатаПериода);");
			КонецПопытки;
		ИначеЕсли  ИмяКонфигурации1С = "УФ_Розница"  Тогда
			Выполнить("СведенияОЮрФизЛице = ФормированиеПечатныхФормСервер.СведенияОЮрФизЛице(ЮрФизЛицо, ДатаПериода);");
		ИначеЕсли ИмяКонфигурации1С = "ТКПТ" Тогда
			Выполнить("СведенияОЮрФизЛице = ЭлектронныеДокументыПереопределяемый.СведенияОЮрФизЛице(ЮрФизЛицо, ДатаПериода);");
		ИначеЕсли ИмяКонфигурации1С = "УФ_ДалионТРЕНД" Тогда
			
			ОбщийМодуль_УправлениеПечатнымиФормами = ОбщийМодуль1С_КонтурEDI("УправлениеПечатнымиФормами"); 
			
			Если ОбщийМодуль_УправлениеПечатнымиФормами <> Неопределено Тогда
				СведенияОЮрФизЛице =  ОбщийМодуль_УправлениеПечатнымиФормами.СведенияОЮрФизЛице(ЮрФизЛицо);	
			КонецЕсли;
			
		ИначеЕсли ИмяКонфигурации1С = "АСТОР" Тогда
			
			ОбщийМодуль_КонтактнаяИнформация = ОбщийМодуль1С_КонтурEDI("ОмКонтактнаяИнформация");
			Если ОбщийМодуль_КонтактнаяИнформация = Неопределено Тогда
				ОбщийМодуль_КонтактнаяИнформация = ОбщийМодуль1С_КонтурEDI("УправлениеКонтактнойИнформацией");
			КонецЕсли;
			
			СведенияОЮрФизЛице = ОбщийМодуль_КонтактнаяИнформация.СведенияОЮрФизЛице(ЮрФизЛицо, ДатаПериода);
			
		Иначе //все конфигурации на обычных формах
			Выполнить("СведенияОЮрФизЛице = УправлениеКонтактнойИнформацией.СведенияОЮрФизЛице(ЮрФизЛицо, ДатаПериода);");
		КонецЕсли;
	Исключение
		Выполнить("СведенияОЮрФизЛице = СведенияОЮрФизЛице(ЮрФизЛицо, ДатаПериода);");
	КонецПопытки;	
	
	Возврат СведенияОЮрФизЛице;

КонецФункции // ПолучитьСведенияОЮрФизЛице_Контур()

Функция ПолучитьОписаниеОрганизации_Контур(Сведения, СписокРеквизитов = "") Экспорт

	Результат = "";
	
	Попытка
		
		ИмяМодуляДляПолученияОписания = "";
		
		Если ИмяКонфигурации1С = "УФ_УНФ" Тогда
			
			Попытка
				
				МодульДляПолученияОписания = Вычислить("УправлениеНебольшойФирмойСервер");
				Результат = МодульДляПолученияОписания.ОписаниеОрганизации(Сведения, СписокРеквизитов);
				
			Исключение
				
				МодульДляПолученияОписания = Вычислить("ПечатьДокументовУНФ");
				Результат = МодульДляПолученияОписания.ОписаниеОрганизации(Сведения, СписокРеквизитов);
				
			КонецПопытки;
								
		ИначеЕсли ИмяКонфигурации1С = "УФ_БП" Тогда
									
			МодульДляПолученияОписания = Вычислить("ОбщегоНазначенияБПВызовСервера");
			Результат = МодульДляПолученияОписания.ОписаниеОрганизации(Сведения, СписокРеквизитов);
									
		Иначе
					
			Попытка
				
				МодульДляПолученияОписания = Вычислить("ФормированиеПечатныхФорм");
				Результат = МодульДляПолученияОписания.ОписаниеОрганизации(Сведения, СписокРеквизитов);
				
			Исключение
				
				МодульДляПолученияОписания = Вычислить("ФормированиеПечатныхФормСервер");
				Результат = МодульДляПолученияОписания.ОписаниеОрганизации(Сведения, СписокРеквизитов);
				
			КонецПопытки;
			
		КонецЕсли;
				
	Исключение
		
		ТекстОшибки = ОписаниеОшибки(); 		
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось получить описание организации из типовых модулей - " + ТекстОшибки);
		
	КонецПопытки;	
	
	Возврат Результат;

КонецФункции // ПолучитьОписаниеОрганизации_Контур()

Функция КонвертироватьТоварыEDIв1С(Знач ТаблицаТоваров, Сообщение, ИскатьПоШтрихкоду = Ложь) Экспорт
	
	// при длительных операциях попробуем найти значения из кэша
	Если ДлительнаяОперация = Истина Тогда
		
		КэшСоответствийТоваров = КэшДлительнойОперации.Получить("КэшСоответствийТоваров");
		Если КэшСоответствийТоваров = Неопределено Тогда
			КэшСоответствийТоваров = Новый Соответствие;
			КэшДлительнойОперации.Вставить("КэшСоответствийТоваров",КэшСоответствийТоваров);
		КонецЕсли;
			
		// партнер
		ТаблицаСоответствийПартнера = КэшСоответствийТоваров.Получить(Сообщение.Партнер);
		Если НЕ ТаблицаСоответствийПартнера = Неопределено Тогда
			
			ВсеИзКэша = Ложь;
			ТабСоответствий = ТаблицаСоответствийПартнера.СкопироватьКолонки();
			
			Для Каждого Стр Из ТаблицаТоваров Цикл
				СтруктураОтбора = Новый Структура("GTIN,КодТовараСвой,КодТовараСторонний,КодЕдиницыИзмеренияEDI",Стр.GTIN,Стр.КодТовараСвой,Стр.КодТовараСторонний,Стр.КодЕдиницыИзмеренияEDI);
				НайденныеСтроки = ТаблицаСоответствийПартнера.НайтиСтроки(СтруктураОтбора);
				Если НайденныеСтроки.Количество()>0 Тогда
					Для Каждого СтрокаНайденныхСоответствий Из НайденныеСтроки Цикл
						НоваяСтрока = ТабСоответствий.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаНайденныхСоответствий);
					КонецЦикла;
					ВсеИзКэша = Истина;
				Иначе
					ВсеИзКэша = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ВсеИзКэша Тогда
				Возврат ТабСоответствий;
			КонецЕсли;
			
		КонецЕсли;	
		
	КонецЕсли;
	
	Если ТаблицаТоваров.Колонки.Найти("КодТовараСвойЧисло") = Неопределено Тогда
	
		ТаблицаТоваров.Колонки.Добавить("КодТовараСвойЧисло", ОписаниеТипаЧисло_КонтурEDI());
		
		ТипКодаСправочникаНоменклатура = ТипКодаСправочникаНоменклатура_КонтурEDI();
		
		Если ТипКодаСправочникаНоменклатура.СодержитТип(Тип("Число")) Тогда 
			
			Для Каждого Стр Из ТаблицаТоваров Цикл
				
				Стр.КодТовараСвойЧисло = СтрокаВЧисло_КонтурEDI(Стр.КодТовараСвой, -1);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли; 
	
	РежимРаботы = ОпределитьКемМыЯвляемся(Сообщение);
	ПартнерСообщения = Сообщение.Партнер;
	  
	// Запрос выполнить по частям
	// 1. Запрос по регистру соответствий
	ЗапросПоСоответствиям = Новый Запрос;
	ЗапросПоСоответствиям.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
	ЗапросПоСоответствиям.УстановитьПараметр("Партнер", ПартнерСообщения);
	ЗапросПоСоответствиям.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваров);			   
	ЗапросПоСоответствиям.УстановитьПараметр("Поставщик", Сообщение.Продавец1С); 
	
	ЗапросПоСоответствиям.Текст = ТекстЗапросПоРегиструСоответствий_EDI_1C(ПартнерСообщения);
	
	//событие, позволяющее переопределить конвертацию EDI в 1С
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("РежимРаботы", РежимРаботы);
	ДополнительныеПараметры.Вставить("Сообщение", Сообщение);
	
	ПараметрыПМ = Новый Структура("Запрос,ДополнительныеПараметры", ЗапросПоСоответствиям, ДополнительныеПараметры);
	РезультатПМ = ОбработкаСобытияПодключаемогоМодуля("ИзменитьЗапросКонвертацииТоваровEDIв1С",, ПараметрыПМ);
	
	ЕстьВызовПМ = Ложь;		
			
	Если РезультатПМ <> Неопределено Тогда
		ЗапросПоСоответствиям = РезультатПМ;
		ЕстьВызовПМ = Истина;		
	КонецЕсли;
	
	ЗапросПоСоответствиям.Выполнить(); // создали  врем.таблицу "ТабСоответствий_КонтурEDI"
		
	// 2. Запрос по штрихкодам для покупателя, вывод результата запроса по соответствиям для поставщика
	ЗапросПоСоответствиям.Текст = ТекстЗапросаПоШтрихкодам_EDI_1С(ИскатьПоШтрихкоду, РежимРаботы);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("РежимРаботы",	 РежимРаботы);
	ДополнительныеПараметры.Вставить("Сообщение",	 Сообщение);
	ДополнительныеПараметры.Вставить("Запрос", 		 ЗапросПоСоответствиям);
	
	СтандартнаяОбработкаEDI = Истина;
	ОбработкаСобытияПодключаемогоМодуля("ИзменитьЗапросПоШтрихКодам", СтандартнаяОбработкаEDI, ДополнительныеПараметры);
	
	Если СтандартнаяОбработкаEDI = Ложь Тогда 
	
		ЗапросПоСоответствиям = ДополнительныеПараметры.Запрос;
		
	КонецЕсли;
	
	ТЗ = ЗапросПоСоответствиям.Выполнить().Выгрузить();
	
	Если НЕ ПеременнаяСодержитСвойство(ТЗ.Колонки, "НаименованиеПартнера") Тогда
		
		ДобавитьКолонкиВТаблицуЗначений(ТЗ, "НаименованиеПартнера", ОписаниеТипаСтрока_КонтурEDI(50));
		ТЗ.ЗагрузитьКолонку(ТЗ.ВыгрузитьКолонку("Номенклатура"), "НаименованиеПартнера");
		
	КонецЕсли;
	
	//Для отладки: ВремТабДляПросмотра = ПросмотретьВременнуюТаблицуЗапроса(ЗапросПоСоответствиям,"ТабТоваров")//"ТабСоответствий_КонтурEDI", "ВТ_НайденныеСоответствия"
	
	ЗапросПоСоответствиям = Неопределено;
	
	Если ДлительнаяОперация = Истина И НЕ ЕстьВызовПМ Тогда
		
		Если ТаблицаСоответствийПартнера = Неопределено Тогда
			ТаблицаСоответствийПартнера = ТЗ.Скопировать();            
			ТаблицаСоответствийПартнера.Индексы.Добавить("GTIN");
			ТаблицаСоответствийПартнера.Индексы.Добавить("КодТовараСвой");
			ТаблицаСоответствийПартнера.Индексы.Добавить("КодТовараСторонний");
			ТаблицаСоответствийПартнера.Индексы.Добавить("КодЕдиницыИзмеренияEDI");
		Иначе
			Для Каждого Стр ИЗ Тз Цикл
				СтруктураОтбора = Новый Структура("GTIN,КодТовараСвой,КодТовараСторонний,КодЕдиницыИзмеренияEDI",Стр.GTIN,Стр.КодТовараСвой,Стр.КодТовараСторонний,Стр.КодЕдиницыИзмеренияEDI);
				НайденныеСтроки = ТаблицаСоответствийПартнера.НайтиСтроки(СтруктураОтбора);
				Если НайденныеСтроки.Количество()=0 Тогда
					ДобавляемыеСтроки = Тз.НайтиСтроки(СтруктураОтбора);
					Для Каждого ДобавляемаяСтрока Из ДобавляемыеСтроки Цикл
						НоваяСтрока = ТаблицаСоответствийПартнера.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока,ДобавляемаяСтрока);
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	
	    КэшСоответствийТоваров.Вставить(Сообщение.Партнер,ТаблицаСоответствийПартнера);
		
	КонецЕсли;
	
	Возврат ТЗ;
	
КонецФункции

Функция ТекстЗапросаПоШтрихкодам_EDI_1С(Знач ИскатьПоШтрихкоду, Знач РежимРаботы)
		
	ТекстЗапросаПоШтрихкодам = "";
	
	Если РежимРаботы = "Поставщик" И Не ИскатьПоШтрихкоду Тогда
		
		//здесь не ищем штрихкоды, что нашли в регистре "КонтурEDI_СоответствияТоваров", то и выкатим
		ТекстЗапросаПоШтрихкодам = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаСоответствий.GTIN,
		|	ТаблицаСоответствий.КодТовараСвой,
		|	ТаблицаСоответствий.КодТовараСторонний,
		|	ТаблицаСоответствий.КодЕдиницыИзмеренияEDI,
		|	ТаблицаСоответствий.Номенклатура,
		|	ТаблицаСоответствий.ХарактеристикаНоменклатуры,
		|	ТаблицаСоответствий.ЕдиницаИзмерения,
		|	ТаблицаСоответствий.КоэффициентEDIВ1С,
		|	ТаблицаСоответствий.ТипЕдиницы КАК ТипЕдиницы,
		|	ТаблицаСоответствий.ОсновноеСоответствие,
		|   ТаблицаСоответствий.НаименованиеПартнера
		|ИЗ
		|	ТабСоответствий_КонтурEDI КАК ТаблицаСоответствий"
		;
		
		Если НЕ ЕстьМетаданныеТипЕдиницы Тогда
			ТекстЗапросаПоШтрихкодам = СтрЗаменить(ТекстЗапросаПоШтрихкодам, "ТаблицаСоответствий.ТипЕдиницы КАК ТипЕдиницы", "ВЫРАЗИТЬ("""" КАК СТРОКА(20)) КАК ТипЕдиницы");
		КонецЕсли;	
		
	ИначеЕсли РежимРаботы = "Покупатель" ИЛИ ИскатьПоШтрихкоду Тогда//Ищем по РС "Штрихкоды". В Рарусе вроде еще использовались "Прайсы поставщиков".
		
		// Кастомизируемый запрос
		//По умолчанию берем сначала данные из нашего регистра соответствий, потом пытаемся найти по справочнику "Номенклатура", потом - по РС "Штрихкоды"
		ТекстЗапросаПоШтрихкодам = ПолучитьТекстЗапросаКонвертацииТоваровEDIв1С();
		
		Если НЕ ЕстьМетаданныеТипЕдиницы Тогда
			ТекстЗапросаПоШтрихкодам = СтрЗаменить(ТекстЗапросаПоШтрихкодам, "ТабСоответствий_КонтурEDI.ТипЕдиницы КАК ТипЕдиницы", "ВЫРАЗИТЬ("""" КАК СТРОКА(20)) КАК ТипЕдиницы");
		КонецЕсли;	
		
		ПолеКодЕдиницыИзмеренияEDI = "NULL";
		
		Если Найти(ТекстЗапросаПоШтрихкодам, "КодЕдиницыИзмеренияEDI") <> 0 Тогда
			ПолеКодЕдиницыИзмеренияEDI = "ВТ_НайденныеСоответствия.КодЕдиницыИзмеренияEDI";
		КонецЕсли;
		
		//Теперь выберем наилучшее соответствие из всех вариантов, полученных выше
		ТекстЗапросаПоШтрихкодам = ТекстЗапросаПоШтрихкодам+
		"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|" +
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаТоваровИсходная.GTIN КАК GTIN,
		|	ТаблицаТоваровИсходная.КодТовараСторонний КАК КодТовараСторонний,
		|	ТаблицаТоваровИсходная.КодТовараСвой КАК КодТовараСвой,
		|	ВЫБОР
		|		КОГДА ВложенныйЗапрос.КодЕдиницыИзмеренияEDI ЕСТЬ НЕ NULL 
		|			ТОГДА ВложенныйЗапрос.КодЕдиницыИзмеренияEDI
		|		КОГДА ТаблицаТоваровИсходная.КодЕдиницыИзмеренияEDI <> """"
		|			ТОГДА ТаблицаТоваровИсходная.КодЕдиницыИзмеренияEDI
		|		ИНАЧЕ ""PCE""
		|	КОНЕЦ КАК КодЕдиницыИзмеренияEDI,
		|	ЕСТЬNULL(ВложенныйЗапрос.КоэффициентEDIВ1С, 1) КАК КоэффициентEDIВ1С,
		|	ВложенныйЗапрос.Номенклатура,
		|	ВложенныйЗапрос.ХарактеристикаНоменклатуры,
		|	ВложенныйЗапрос.ЕдиницаИзмерения,
		|	ВложенныйЗапрос.ТипЕдиницы КАК ТипЕдиницы,
		|	ЕСТЬNULL(ВложенныйЗапрос.ОсновноеСоответствие, 0) КАК ОсновноеСоответствие
		|ИЗ
		|	ТабТоваров КАК ТаблицаТоваровИсходная
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ВТ_НайденныеСоответствия.GTIN КАК GTIN,
		|			ВТ_НайденныеСоответствия.КодТовараСторонний КАК КодТовараСторонний,
		|			ВТ_НайденныеСоответствия.КодТовараСвой КАК КодТовараСвой,
		|			ВТ_НайденныеСоответствия.Номенклатура КАК Номенклатура,
		|			ВТ_НайденныеСоответствия.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|			ВТ_НайденныеСоответствия.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|			ВТ_НайденныеСоответствия.ТипЕдиницы КАК ТипЕдиницы,
		|			ТабСоответствий_КонтурEDI.КоэффициентEDIВ1С КАК КоэффициентEDIВ1С,
		|			&ПолеКодЕдиницыИзмеренияEDI КАК КодЕдиницыИзмеренияEDI,
		|			ЕСТЬNULL(ТабСоответствий_КонтурEDI.ОсновноеСоответствие, 0) КАК ОсновноеСоответствие
		|		ИЗ
		|			ВТ_НайденныеСоответствия КАК ВТ_НайденныеСоответствия
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|					ВТ_НайденныеСоответствия.GTIN КАК GTIN,
		|					ВТ_НайденныеСоответствия.КодТовараСторонний КАК КодТовараСторонний,
		|					ВТ_НайденныеСоответствия.КодТовараСвой КАК КодТовараСвой,
		|					МАКСИМУМ(ВТ_НайденныеСоответствия.Приоритет) КАК Приоритет
		|				ИЗ
		|					ВТ_НайденныеСоответствия КАК ВТ_НайденныеСоответствия
		|				
		|				СГРУППИРОВАТЬ ПО
		|					ВТ_НайденныеСоответствия.GTIN,
		|					ВТ_НайденныеСоответствия.КодТовараСторонний,
		|					ВТ_НайденныеСоответствия.КодТовараСвой) КАК МаксимальныйПриоритет
		|				ПО ВТ_НайденныеСоответствия.GTIN = МаксимальныйПриоритет.GTIN
		|					И ВТ_НайденныеСоответствия.КодТовараСторонний = МаксимальныйПриоритет.КодТовараСторонний
		|					И ВТ_НайденныеСоответствия.КодТовараСвой = МаксимальныйПриоритет.КодТовараСвой
		|					И ВТ_НайденныеСоответствия.Приоритет = МаксимальныйПриоритет.Приоритет
		|				ЛЕВОЕ СОЕДИНЕНИЕ ТабСоответствий_КонтурEDI КАК ТабСоответствий_КонтурEDI
		|				ПО ВТ_НайденныеСоответствия.GTIN = ТабСоответствий_КонтурEDI.GTIN
		|					И ВТ_НайденныеСоответствия.КодТовараСторонний = ТабСоответствий_КонтурEDI.КодТовараСторонний
		|					И ВТ_НайденныеСоответствия.Номенклатура = ТабСоответствий_КонтурEDI.Номенклатура
		|					И ВТ_НайденныеСоответствия.ХарактеристикаНоменклатуры = ТабСоответствий_КонтурEDI.ХарактеристикаНоменклатуры
		|					И ВТ_НайденныеСоответствия.ЕдиницаИзмерения = ТабСоответствий_КонтурEDI.ЕдиницаИзмерения) КАК ВложенныйЗапрос
		|		ПО ТаблицаТоваровИсходная.GTIN = ВложенныйЗапрос.GTIN
		|			И ТаблицаТоваровИсходная.КодТовараСторонний = ВложенныйЗапрос.КодТовараСторонний
		|			И ТаблицаТоваровИсходная.КодТовараСвой = ВложенныйЗапрос.КодТовараСвой";
		
		Если НЕ ЕстьМетаданныеТипЕдиницы Тогда
			ТекстЗапросаПоШтрихкодам = СтрЗаменить(ТекстЗапросаПоШтрихкодам, "ВложенныйЗапрос.ТипЕдиницы КАК ТипЕдиницы", "ВЫРАЗИТЬ("""" КАК СТРОКА(20)) КАК ТипЕдиницы");
			ТекстЗапросаПоШтрихкодам = СтрЗаменить(ТекстЗапросаПоШтрихкодам, "ВТ_НайденныеСоответствия.ТипЕдиницы КАК ТипЕдиницы", "ВЫРАЗИТЬ("""" КАК СТРОКА(20)) КАК ТипЕдиницы");
		КонецЕсли;
		
		Если ИмяКонфигурации1С = "УФ_УТ" Тогда 
			ТекстЗамены = 
			"	ВЫБОР 
			|		КОГДА ВложенныйЗапрос.ЕдиницаИзмерения = Значение(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
			|			ТОГДА ВложенныйЗапрос.Номенклатура.ЕдиницаИзмерения
			|		ИНАЧЕ ВложенныйЗапрос.ЕдиницаИзмерения
			|	КОНЕЦ КАК ЕдиницаИзмерения";
			Если НЕ ЕстьНеобходимыеМетаданные("Справочники.УпаковкиЕдиницыИзмерения") Тогда
				ТекстЗамены = СтрЗаменить(ТекстЗамены, "УпаковкиЕдиницыИзмерения", "УпаковкиНоменклатуры");	
			КонецЕсли;
			ТекстЗапросаПоШтрихкодам = СтрЗаменить(ТекстЗапросаПоШтрихкодам, "ВложенныйЗапрос.ЕдиницаИзмерения", ТекстЗамены);	
		КонецЕсли;
		
		ТекстЗапросаПоШтрихкодам = СтрЗаменить(ТекстЗапросаПоШтрихкодам, "&ПолеКодЕдиницыИзмеренияEDI", ПолеКодЕдиницыИзмеренияEDI);
		
	КонецЕсли;
	
	Возврат ТекстЗапросаПоШтрихкодам;

КонецФункции

Функция ТекстЗапросПоРегиструСоответствий_EDI_1C(ПартнерСообщения)
		
	ТекстЗапросаПоРегиструСоответствий = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Таб.GTIN,
	|	Таб.КодТовараСторонний КАК КодТовараСторонний,
	|	Таб.КодЕдиницыИзмеренияEDI КАК КодЕдиницыИзмеренияEDI,
	|	Таб.КодТовараСвой КАК КодТовараСвой,
	|	Таб.КодТовараСвойЧисло КАК КодТовараСвойЧисло
	|ПОМЕСТИТЬ ТабТоваров
	|ИЗ
	|	&ТаблицаТоваров КАК Таб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТабТоваров.GTIN КАК GTIN,
	|	ТабТоваров.КодТовараСторонний КАК КодТовараСторонний,
	|	ТабТоваров.КодТовараСвой КАК КодТовараСвой,
	|	ТабТоваров.КодЕдиницыИзмеренияEDI КАК КодЕдиницыИзмеренияEDI,
	|	КонтурEDI_СоответствияТоваров.Номенклатура,
	|	КонтурEDI_СоответствияТоваров.ХарактеристикаНоменклатуры,
	|	КонтурEDI_СоответствияТоваров.Единица КАК ЕдиницаИзмерения,
	|	КонтурEDI_СоответствияТоваров.КоэффициентEDIВ1С КАК КоэффициентEDIВ1С,
	|	КонтурEDI_СоответствияТоваров.ТипЕдиницы КАК ТипЕдиницы,
	|	ЕСТЬNULL(КонтурEDI_СоответствияТоваров.ОсновноеСоответствие, ЛОЖЬ) КАК ОсновноеСоответствие,
	|	КонтурEDI_СоответствияТоваров.ЕдиницаEDI КАК ЕдиницаEDI_Сопоставление,
	|	КонтурEDI_СоответствияТоваров.НаименованиеПартнера
	|ПОМЕСТИТЬ ТабСоответствий_
	|ИЗ
	|	ТабТоваров КАК ТабТоваров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурEDI_СоответствияТоваров КАК КонтурEDI_СоответствияТоваров
	|		ПО (КонтурEDI_СоответствияТоваров.Партнер = &Партнер)
	|			И (&УсловиеПопыткиСопоставления)
	|			И (&УсловиеСопоставления)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	GTIN,
	|	КодТовараСторонний,
	|	КодТовараСвой
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабСоответствий_.GTIN,
	|	ТабСоответствий_.КодТовараСторонний,
	|	ТабСоответствий_.Номенклатура,
	|	ТабСоответствий_.ХарактеристикаНоменклатуры,
	|	ТабСоответствий_.ЕдиницаИзмерения,
	|	ТабСоответствий_.ОсновноеСоответствие,
	|	ТабСоответствий_.НаименованиеПартнера
	|ПОМЕСТИТЬ табОсновноеСоответствие
	|ИЗ
	|	ТабСоответствий_ КАК ТабСоответствий_
	|ГДЕ
	|	ТабСоответствий_.ОсновноеСоответствие = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	ТабСоответствий_.GTIN,
	|	ТабСоответствий_.КодТовараСторонний,
	|	ТабСоответствий_.Номенклатура,
	|	ТабСоответствий_.ХарактеристикаНоменклатуры,
	|	ТабСоответствий_.ЕдиницаИзмерения,
	|	ТабСоответствий_.ОсновноеСоответствие,
	|	ТабСоответствий_.НаименованиеПартнера
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабСоответствий_.GTIN,
	|	ТабСоответствий_.КодТовараСторонний,
	|	ТабСоответствий_.КодТовараСвой,
	|	ТабСоответствий_.КодЕдиницыИзмеренияEDI,
	|	ТабСоответствий_.Номенклатура,
	|	ТабСоответствий_.ХарактеристикаНоменклатуры,
	|	ТабСоответствий_.ЕдиницаИзмерения,
	|	ТабСоответствий_.КоэффициентEDIВ1С,
	|	ТабСоответствий_.ТипЕдиницы,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА табОсновноеСоответствие.Номенклатура ЕСТЬ NULL
	|				ТОГДА 0
	|			КОГДА ТабСоответствий_.ХарактеристикаНоменклатуры = табОсновноеСоответствие.ХарактеристикаНоменклатуры
	|					И ТабСоответствий_.ЕдиницаИзмерения = табОсновноеСоответствие.ЕдиницаИзмерения
	|				ТОГДА 4
	|			КОГДА ТабСоответствий_.ХарактеристикаНоменклатуры = табОсновноеСоответствие.ХарактеристикаНоменклатуры
	|				ТОГДА 3
	|			КОГДА ТабСоответствий_.ЕдиницаИзмерения = табОсновноеСоответствие.ЕдиницаИзмерения
	|				ТОГДА 2
	|			ИНАЧЕ 1
	|		КОНЕЦ) КАК ОсновноеСоответствие,
	|	табОсновноеСоответствие.НаименованиеПартнера
	|ПОМЕСТИТЬ ТабСоответствий_КонтурEDI
	|ИЗ
	|	ТабСоответствий_ КАК ТабСоответствий_
	|		ЛЕВОЕ СОЕДИНЕНИЕ табОсновноеСоответствие КАК табОсновноеСоответствие
	|		ПО ТабСоответствий_.GTIN = табОсновноеСоответствие.GTIN
	|			И ТабСоответствий_.КодТовараСторонний = табОсновноеСоответствие.КодТовараСторонний
	|			И ТабСоответствий_.Номенклатура = табОсновноеСоответствие.Номенклатура
	|ГДЕ
	|	(ТабСоответствий_.КодЕдиницыИзмеренияEDI = ТабСоответствий_.ЕдиницаEDI_Сопоставление
	|			ИЛИ ТабСоответствий_.ЕдиницаEDI_Сопоставление = """")
	|
	|СГРУППИРОВАТЬ ПО
	|	ТабСоответствий_.GTIN,
	|	ТабСоответствий_.КодЕдиницыИзмеренияEDI,
	|	ТабСоответствий_.КодТовараСторонний,
	|	ТабСоответствий_.КодТовараСвой,
	|	ТабСоответствий_.Номенклатура,
	|	ТабСоответствий_.ЕдиницаИзмерения,
	|	ТабСоответствий_.ХарактеристикаНоменклатуры,
	|	ТабСоответствий_.ТипЕдиницы,
	|	ТабСоответствий_.КоэффициентEDIВ1С,
	|	табОсновноеСоответствие.НаименованиеПартнера";
	
	НастройкиСинхронизацииТоваров = НастройкиСинхронизацииТоваров(ПартнерСообщения); 
	
	СинхронизироватьТоварыТолькоПоGTIN = НастройкиСинхронизацииТоваров.СинхронизироватьТоварыТолькоПоGTIN;
	СинхронизироватьТоварыТолькоПоКодуПартнера = НастройкиСинхронизацииТоваров.СинхронизироватьТоварыТолькоПоКодуПартнера;
	
	Если НЕ СинхронизироватьТоварыТолькоПоGTIN И НЕ СинхронизироватьТоварыТолькоПоКодуПартнера Тогда
		
		УсловиеПопыткиСопоставления = "(НЕ ТабТоваров.GTIN = """" ИЛИ НЕ ТабТоваров.КодТовараСторонний = """")";
		
		УсловиеСопоставления = 
		"(ТабТоваров.GTIN = КонтурEDI_СоответствияТоваров.GTIN ИЛИ ТабТоваров.GTIN = """") 
		| И (ТабТоваров.КодТовараСторонний = КонтурEDI_СоответствияТоваров.КодТовараПартнера ИЛИ ТабТоваров.КодТовараСторонний = """")";
		
	ИначеЕсли НЕ СинхронизироватьТоварыТолькоПоGTIN И СинхронизироватьТоварыТолькоПоКодуПартнера Тогда
		
		УсловиеПопыткиСопоставления = "НЕ ТабТоваров.КодТовараСторонний = """"";
		
		УсловиеСопоставления = "ТабТоваров.КодТовараСторонний = КонтурEDI_СоответствияТоваров.КодТовараПартнера"; 
		
	ИначеЕсли СинхронизироватьТоварыТолькоПоGTIN И НЕ СинхронизироватьТоварыТолькоПоКодуПартнера  Тогда
		
		УсловиеПопыткиСопоставления = "НЕ ТабТоваров.GTIN = """"";
		
		УсловиеСопоставления = "ТабТоваров.GTIN = КонтурEDI_СоответствияТоваров.GTIN";
		
	Иначе
		
		УсловиеПопыткиСопоставления = "ЛОЖЬ";
		УсловиеСопоставления = "ЛОЖЬ"; 
		
	Конецесли;
	
	ТекстЗапросаПоРегиструСоответствий = СтрЗаменить(ТекстЗапросаПоРегиструСоответствий, "&УсловиеПопыткиСопоставления", УсловиеПопыткиСопоставления);
	ТекстЗапросаПоРегиструСоответствий = СтрЗаменить(ТекстЗапросаПоРегиструСоответствий, "&УсловиеСопоставления", УсловиеСопоставления);

	Если НЕ ЕстьМетаданныеТипЕдиницы Тогда
		ТекстЗапросаПоРегиструСоответствий = СтрЗаменить(ТекстЗапросаПоРегиструСоответствий, "КонтурEDI_СоответствияТоваров.ТипЕдиницы КАК ТипЕдиницы", "ВЫРАЗИТЬ("""" КАК СТРОКА(20)) КАК ТипЕдиницы");
	КонецЕсли;
	
	Возврат ТекстЗапросаПоРегиструСоответствий;

КонецФункции

Функция НастройкиСинхронизацииТоваров(ПартнерСообщения)
	
	НастройкиСинхронизацииТоваров = ПолучитьСписокСвойствEDI(
	"СинхронизироватьТоварыТолькоПоGTIN,СинхронизироватьТоварыТолькоПоКодуПартнера", ПартнерСообщения); 
	
	НастройкиСинхронизацииТоваров.СинхронизироватьТоварыТолькоПоGTIN = 
	НастройкиСинхронизацииТоваров.СинхронизироватьТоварыТолькоПоGTIN = Истина;
	
	НастройкиСинхронизацииТоваров.СинхронизироватьТоварыТолькоПоКодуПартнера = 
	НастройкиСинхронизацииТоваров.СинхронизироватьТоварыТолькоПоКодуПартнера = Истина;
	
	Возврат НастройкиСинхронизацииТоваров;

КонецФункции

Функция ТипКодаСправочникаНоменклатура_КонтурEDI()
	
	ТипКодаСправочникаНоменклатура = ЭДО_Кэш_Прочитать("ТипКодаСправочникаНоменклатура");
	
	Если ТипКодаСправочникаНоменклатура = Неопределено Тогда
		
		ИмяСправочникаНоменклатура = ПолучитьТипЗначенияОбъекта("Номенклатура",,Истина);
		ТипКодаСправочникаНоменклатура = Метаданные.Справочники[ИмяСправочникаНоменклатура].СтандартныеРеквизиты.Код.Тип; 
		
		ЭДО_Кэш_Поместить("ТипКодаСправочникаНоменклатура", ТипКодаСправочникаНоменклатура);
		
	КонецЕсли; 		
		
	Возврат ТипКодаСправочникаНоменклатура;

КонецФункции

// конвертация полей и табличной части

//Приемник, Источник - тип "Структура"
//Поля - тип "Строка", перечень полей через запятую
//Копирует каждое Поле из Источника в Приемник, попутно проверяя наличие этих полей в источнике и приемнике
Процедура ЗаполнитьПоляСтруктурыИзИсточника(Приемник,Источник,Поля,НеПроверятьЗаполненность = Истина)
	
	Для Каждого Поле Из EDI_РазложитьСтрокуВМассивСлов(Поля,",") Цикл
		
		Если Приемник.Свойство(Поле) и Источник.Свойство(Поле) Тогда
			Если НеПроверятьЗаполненность или ЗначениеЗаполнено(Источник[Поле]) Тогда
				Приемник[Поле] = Источник[Поле];
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

//дополняет в исходящем сообщении поля из предыдущих входящих:
//дата/номер заказа, GLN отправителя/получателя/плательщика/...
Процедура ПослеКонвертацииСообщения1СвEDI(Сообщение)
	
	Если Сообщение.Направление <> "Исходящее" Тогда
		//дозаполняем только исходящие
		Возврат;
	КонецЕсли;	
	
	ПараметрыПолучателя = ПолучитьСписокСвойствEDI("ДополнятьGTINдо13,ОбрезатьЛидирующиеНулиGTIN,СинхронизироватьТоварыТолькоПоGTIN,СинхронизироватьТоварыТолькоПоКодуПартнера",Сообщение.Получатель1С);
	
	//Обработаем GTIN в табличной части
	Для каждого Стр Из Сообщение.Товары Цикл
		
		//Дополняем до 13 символов по необходимости
		Если ПараметрыПолучателя.ДополнятьGTINдо13 = Истина  Тогда
			Если ЗначениеЗаполнено(Стр.GTIN) Тогда
				Стр.GTIN = Прав("0000000000000"+СокрЛП(Стр.GTIN),13);
			КонецЕсли;
		КонецЕсли;
		
		//И обрезаем лидирующие нули если нужно
		Если ПараметрыПолучателя.ОбрезатьЛидирующиеНулиGTIN = Истина Тогда
			
			Стр.GTIN = УбратьЛидирующиеНулиВСтроке_КонтурEDI(Стр.GTIN);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Сообщение.ДокументСсылка) Тогда

		Возврат;
	КонецЕсли;	
	
	БазовыйДокумент = Сообщение.ДокументСсылка;
	
	Если Сообщение.ТипСообщения = "COINVOIC" 
		ИЛИ	(Сообщение.ТипСообщения = "INVOIC" И Сообщение.Исправление = Истина) Тогда
		
		БазовыйДокумент = Сообщение.Накладная1С;
		
	КонецЕсли;
	
	Если Сообщение.ТипСообщения = "RETINS" Тогда
		
		ВходящийRETANN = ПрочитатьСообщение(, Сообщение.ДокументСсылка, "RETANN", "Входящее");

		Если ЗначениеЗаполнено(ВходящийRETANN) Тогда
			
			Сообщение.ГрузополучательEDI.GLN 	= ВходящийRETANN.ГрузополучательEDI.GLN;	
			Сообщение.ГрузоотправительEDI.GLN	= ВходящийRETANN.ГрузоотправительEDI.GLN;
			
			Сообщение.ЗаказEDI.Номер			= ВходящийRETANN.ЗаказEDI.Номер;
			Сообщение.ЗаказEDI.Дата				= ВходящийRETANN.ЗаказEDI.Дата;
			
			Сообщение.УведомлениеОВозвратеEDI.Номер = ВходящийRETANN.ДокументEDI.Номер;
			Сообщение.УведомлениеОВозвратеEDI.Дата 	= ВходящийRETANN.ДокументEDI.Дата;
			
			Сообщение.Партнер			= ВходящийRETANN.Партнер;
			Сообщение.Получатель1С		= ВходящийRETANN.Партнер;
			Сообщение.ТочкаДоставки		= ВходящийRETANN.ТочкаДоставки;
			
		КонецЕсли;

		Возврат;
	КонецЕсли;
	
	Если Сообщение.ТипСообщения = "RETREC" Тогда
		
		ВходящийRETDES = ПрочитатьСообщение(, Сообщение.ДокументСсылка, "RETDES", "Входящее");
		ВходящийRETANN = ПрочитатьСообщение(, Сообщение.ДокументСсылка, "RETANN", "Входящее");

		Если ЗначениеЗаполнено(ВходящийRETDES) Тогда
			
			Сообщение.ОтправительEDI.GLN		= ВходящийRETDES.ПолучательEDI.GLN;
			Сообщение.ПолучательEDI.GLN			= ВходящийRETDES.ОтправительEDI.GLN;
			Сообщение.ПокупательEDI.GLN 		= ВходящийRETDES.ПокупательEDI.GLN;
			Сообщение.ПродавецEDI.GLN			= ВходящийRETDES.ПродавецEDI.GLN;
			Сообщение.ГрузоотправительEDI.GLN	= ВходящийRETDES.ГрузоотправительEDI.GLN;
			Сообщение.ГрузополучательEDI.GLN	= ВходящийRETDES.ГрузополучательEDI.GLN;
			
			Сообщение.ЗаказEDI.Номер			= ВходящийRETDES.ЗаказEDI.Номер;
			Сообщение.ЗаказEDI.Дата				= ВходящийRETDES.ЗаказEDI.Дата;
			
			Сообщение.НакладнаяEDI.Номер		= ВходящийRETDES.ДокументEDI.Номер;
			Сообщение.НакладнаяEDI.Дата			= ВходящийRETDES.ДокументEDI.Дата;

			Сообщение.Партнер			= ВходящийRETDES.Партнер;
			Сообщение.Получатель1С		= ВходящийRETDES.Партнер;
			Сообщение.ТочкаДоставки		= ВходящийRETDES.ТочкаДоставки;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВходящийRETANN) Тогда
			
			Сообщение.УведомлениеОВозвратеEDI.Номер = ВходящийRETANN.ДокументEDI.Номер;
			Сообщение.УведомлениеОВозвратеEDI.Дата 	= ВходящийRETANN.ДокументEDI.Дата;
		
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	////надо найти ORDERS,ORDRSP,RECADV
	ДокументДляORDERS	= НайтиСвязанныйДокументПоТипуСообщения(БазовыйДокумент,"ORDERS");
	ДокументДляORDRSP	= НайтиСвязанныйДокументПоТипуСообщения(БазовыйДокумент,"ORDRSP");
	ДокументДляRECADV	= НайтиСвязанныйДокументПоТипуСообщения(БазовыйДокумент,"RECADV");
	
	ТипыСообщений = КонтурСтандарт_МассивЗначений("RECADV","INVOIC","COINVOIC");
	
	
	//нашли документ для входящего ORDERS, начнем дозаполнять реквизиты
	//сначала короткие заполнялки
	Если Сообщение.ТипСообщения = "ORDRSP" 
		И ЗначениеЗаполнено(Сообщение.ДокументEDI.Дата) 
		И Сообщение.ДокументEDI.Дата > ТекущаяДата() Тогда	
		
		Сообщение.ДокументEDI.Дата = ТекущаяДата();		
		
	ИначеЕсли ТипыСообщений.Найти(Сообщение.ТипСообщения) <> Неопределено 
		И ПустаяСтрока(Сообщение.ЗаказEDI.Номер) Тогда
		
		//если в RECADV, INVOIC или COINVOIC нет номера заказа, то будем считать, что он совпадает с номером накладной
		ЗаполнитьЗначенияСвойств(Сообщение.ЗаказEDI, Сообщение.НакладнаяEDI, "Номер,Дата");
		
	КонецЕсли;
	
	//теперь крупные заполнялки
	ВходящийORDERS	= Неопределено;
	ИсходящийORDRSP = Неопределено;
	ВходящийRECADV	= Неопределено;

	//попробуем прочитать данные из ORDERS
	ЗаполнилиПоЗаказу = Ложь;

	Если ЗначениеЗаполнено(ДокументДляORDERS) Тогда
		
		ВходящийORDERS = ПрочитатьСообщение(,ДокументДляORDERS,"ORDERS","Входящее");
		
		Если ЗначениеЗаполнено(ВходящийORDERS) Тогда
			СообщениеДляЗаполненияОсновныхРеквизитов = ВходящийORDERS;
			
			ЗаполнилиПоЗаказу = Истина;
			
			Если ПроверитьСвойствоПоляВСтруктуре(Сообщение, "ПродавецEDI.КодВСистемеПокупателя")
				И ПроверитьСвойствоПоляВСтруктуре(ВходящийORDERS, "ПродавецEDI.КодВСистемеПокупателя") Тогда
				Сообщение.ПродавецEDI.КодВСистемеПокупателя = ВходящийORDERS.ПродавецEDI.КодВСистемеПокупателя;	
			КонецЕсли;
			
			Если ПроверитьСвойствоПоляВСтруктуре(Сообщение, "ГрузополучательEDI.КодВСистемеПокупателя")
				И ПроверитьСвойствоПоляВСтруктуре(ВходящийORDERS, "ГрузополучательEDI.КодВСистемеПокупателя") Тогда
				Сообщение.ГрузополучательEDI.КодВСистемеПокупателя = ВходящийORDERS.ГрузополучательEDI.КодВСистемеПокупателя;
			КонецЕсли;
			
			НомерКонтракта = Неопределено;
			Если ПроверитьСвойствоПоляВСтруктуре(ВходящийORDERS, "Контракт.Номер") И
				ПроверитьСвойствоПоляВСтруктуре(Сообщение, "Контракт.Номер", НомерКонтракта) 
				И НомерКонтракта = Неопределено Тогда
				
				Сообщение.Контракт	= ВходящийORDERS.Контракт;
				
			КонецЕсли;
				
		КонецЕсли;
		
		//Удалить 
		//блок, все давно вынесено в ОпределитьДатуПоставки - там полный алгоритм, который вызывается в том числе на подготовить уведомление об отгрузке
		//Если Сообщение.ТипСообщения = "DESADV" Тогда
		//	//дату поставки в DESADV протянем из входящего ORDERS
		//	//надо бы вытянуть наружу, чтоб везде заполнялось
		//	ИсходящийORDRSP = ПрочитатьСообщение(,ДокументДляORDRSP,"ORDRSP","Исходящее");
		//	
		//	Если ЗначениеЗаполнено(ИсходящийORDRSP) И ЗначениеЗаполнено(ИсходящийORDRSP.ДатаПоставки) Тогда
		//		Сообщение.ДатаПоставки = ИсходящийORDRSP.ДатаПоставки;
		//	КонецЕсли;
		//	
		//КонецЕсли;
		
	КонецЕсли;
	
	//попробуем прочитать данные из RECADV
	Если НЕ ЗаполнилиПоЗаказу И ЗначениеЗаполнено(ДокументДляRECADV) Тогда
		
		ВходящийRECADV = ПрочитатьСообщение(,ДокументДляRECADV,"RECADV","Входящее");

		СообщениеДляЗаполненияОсновныхРеквизитов = ВходящийRECADV;
		
		Если НЕ СообщениеДляЗаполненияОсновныхРеквизитов=Неопределено
			И ЗначениеЗаполнено(ВходящийRECADV.ЗаказEDI.Номер) Тогда
			
			ЗаполнитьЗначенияСвойств(Сообщение.ЗаказEDI, ВходящийRECADV.ЗаказEDI, "Номер,Дата");
			
		КонецЕсли;
		
	КонецЕсли;
	
	//возьмем отправителя, получателя, плательщика и т.д. из полученного ORDERS/RECADV, смотря что нашли
	Если ЗначениеЗаполнено(СообщениеДляЗаполненияОсновныхРеквизитов) Тогда
		
		//ОтправительEDI,ПолучательEDI поменяем местами
		ЗаполнитьПоляСтруктурыИзИсточника(Сообщение.ОтправительEDI,	СообщениеДляЗаполненияОсновныхРеквизитов.ПолучательEDI,		"GLN",	Ложь);
		ЗаполнитьПоляСтруктурыИзИсточника(Сообщение.ПолучательEDI,	СообщениеДляЗаполненияОсновныхРеквизитов.ОтправительEDI,	"GLN",	Ложь);
		
		//следующие реквизиты сообщения скопируем "как есть"
		КопируемыеРеквизиты = "ПокупательEDI,ПродавецEDI,ПлательщикEDI,ГрузополучательEDI,КонечныйГрузополучательEDI,ПромежуточныйГрузополучательEDI";
		
		Для Каждого Поле Из EDI_РазложитьСтрокуВМассивСлов(КопируемыеРеквизиты,",") Цикл
			Если Сообщение.Свойство(Поле) И СообщениеДляЗаполненияОсновныхРеквизитов.Свойство(Поле) И Не ПустаяСтрока(СообщениеДляЗаполненияОсновныхРеквизитов[Поле].GLN) Тогда
				Сообщение[Поле].GLN = СообщениеДляЗаполненияОсновныхРеквизитов[Поле].GLN;
			КонецЕсли;
		КонецЦикла;
		
		ЗаполнитьПоляСтруктурыИзИсточника(Сообщение, СообщениеДляЗаполненияОсновныхРеквизитов, "НомерСерииЗаказов");
		
		Если ПараметрыПользователяEDI.НеБратьАдресаПартнераИз1С <> Истина Тогда
			АдресГрузополучателя = СообщениеДляЗаполненияОсновныхРеквизитов.ГрузополучательEDI.Адрес;
			Если ЗначениеЗаполнено(АдресГрузополучателя.Улица) И ЗначениеЗаполнено(АдресГрузополучателя.Регион) Тогда
				Сообщение.ГрузополучательEDI.Адрес = АдресГрузополучателя;
			КонецЕсли;
		КонецЕсли;
		
		Если ПараметрыПользователяEDI.НеБратьАдресаПартнераИз1С <> Истина Тогда
			
			Если Сообщение.ТипСообщения = "ALCRPT" 
				И ЗначениеЗаполнено(ВходящийORDERS) Тогда
				
				Сообщение.ПокупательEDI			= ЗначениеИзСтрокиВнутр(ЗначениеВСтрокуВнутр(ВходящийORDERS.ПокупательEDI));
				Сообщение.ГрузополучательEDI	= ЗначениеИзСтрокиВнутр(ЗначениеВСтрокуВнутр(ВходящийORDERS.ГрузополучательEDI));
				
				Если НЕ ЗначениеЗаполнено(Сообщение.ГрузополучательEDI.ИНН) Тогда
					ЗаполнитьЗначенияСвойств(Сообщение.ГрузополучательEDI,Сообщение.ПокупательEDI,"ИНН,КПП");
				КонецЕсли;
				
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЕсли;	
	
	Сообщение.ТочкаДоставки = НайтиОбъектПоЗначениюСвойства("GLN_ТочкиДоставки",Сообщение.ГрузополучательEDI.GLN);
	
	Если ЗначениеЗаполнено(Сообщение.ТочкаДоставки) И Сообщение.Свойство("ГрузополучательEDI") Тогда
		
		МассивРеквизитов = Новый Массив;
		МассивРеквизитов.Добавить("ТипЛокализации");
		
		СтруктураРеквизитов = ПолучитьЗначенияДопРеквизитовТочкиДоставки_КонтурEDI(Сообщение.ТочкаДоставки, МассивРеквизитов);
		Сообщение.ГрузополучательEDI.Вставить("ТипЛокализации", СтруктураРеквизитов.ТипЛокализации);
		
	КонецЕсли;
		
	Если Сообщение.ТипСообщения = "INVOIC" ИЛИ Сообщение.ТипСообщения = "COINVOIC" Тогда
		
		Если НЕ ЗначениеЗаполнено(Сообщение.ГрузоотправительEDI.GLN) Тогда
			
			Сообщение.ГрузоотправительEDI.GLN = Сообщение.ПродавецEDI.GLN;
			
		КонецЕсли;
		
		//заполним номер и дату приемки
		//здесь мы  снова ищем входящий RECADV
		Если Не ЗначениеЗаполнено(ВходящийRECADV) Тогда
			ВходящийRECADV = ПрочитатьСообщение(,ДокументДляRECADV,"RECADV","Входящее");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВходящийRECADV) Тогда
			Если Сообщение.Свойство("ПриемкаEDI") и ВходящийRECADV.Свойство("ДокументEDI") Тогда
				ЗаполнитьПоляСтруктурыИзИсточника(Сообщение.ПриемкаEDI,		ВходящийRECADV.ДокументEDI,	"Дата,Номер");
				ЗаполнитьПоляСтруктурыИзИсточника(Сообщение,				ВходящийRECADV,				"НомерПриемкиПокупателя");
			КонецЕсли;
		КонецЕсли;
		
		//заполним номер и дату ответа на заказ
		//здесь мы  снова ищем исходящий ORDRSP
		Если Не ЗначениеЗаполнено(ИсходящийORDRSP) Тогда
			ИсходящийORDRSP = ПрочитатьСообщение(,ДокументДляORDRSP,"ORDRSP","Исходящее");
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(ИсходящийORDRSP) Тогда 
			Если Сообщение.Свойство("ОтветНаЗаказEDI") и ИсходящийORDRSP.Свойство("ДокументEDI") Тогда 
				ЗаполнитьПоляСтруктурыИзИсточника(Сообщение.ОтветНаЗаказEDI,	ИсходящийORDRSP.ДокументEDI,	"Дата,Номер");
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	//для ИСФ/КСФ требуется особенное заполнение полей "Номер/дата документа"
	Если ЕстьКоррИспрСФ 
		И (Сообщение.ТипСообщения = "INVOIC" ИЛИ Сообщение.ТипСообщения = "COINVOIC") Тогда
		
		ТипКСФ = ПолучитьТипЗначенияОбъекта("ИсходящийКСФ");
		ТипДокументаСчетФактура	= ПолучитьТипЗначенияОбъекта("ТипДокументаСчетФактура");
		ТипИсходныйСФ = ПолучитьТипЗначенияОбъекта("ИсходящийСчетФактура");
		
		Если ЗначениеЗаполнено(Сообщение.Документ1С) Тогда
			
			ТипДок1С = ТипЗнч(Сообщение.Документ1С);
			
			Если ТипДок1С = Тип(ТипИсходныйСФ) 
				ИЛИ (ЗначениеЗаполнено(ТипКСФ) И ТипДок1С = Тип(ТипКСФ)) 
				ИЛИ ТипДок1С = Тип(ТипДокументаСчетФактура) Тогда
				
				Если Сообщение.ТипСообщения = "COINVOIC" Тогда
					
					Если ТипЗнч(Сообщение.ДокументСсылка) = Тип(ТипДокументаСчетФактура)  Тогда 
						КорректировкаРеализации = ПолучитьКорректировкуРеализацииСчетаФактуры(Сообщение.ДокументСсылка);
					Иначе
						КорректировкаРеализации = Сообщение.ДокументСсылка;
					КонецЕсли;  
					
					ВходящийRETANN = ПрочитатьСообщение(, КорректировкаРеализации, "RETANN", "Входящее");
					ВходящийRETDES = ПрочитатьСообщение(, КорректировкаРеализации, "RETDES", "Входящее");
					
					Если ЗначениеЗаполнено(ВходящийRETANN) Тогда
						Сообщение.УведомлениеОВозвратеEDI.Номер = ВходящийRETANN.ДокументEDI.Номер;
						Сообщение.УведомлениеОВозвратеEDI.Дата 	= ВходящийRETANN.ДокументEDI.Дата;
					КонецЕсли;
					
					Если ЗначениеЗаполнено(ВходящийRETDES) Тогда
						Сообщение.ВозвратнаяНакладнаяEDI.Номер 	= ВходящийRETDES.ДокументEDI.Номер;
						Сообщение.ВозвратнаяНакладнаяEDI.Дата 	= ВходящийRETDES.ДокументEDI.Дата;
					КонецЕсли;
				
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

Функция УбратьЛидирующиеНулиВСтроке_КонтурEDI(Знач Значение)
	
	ЗначениеБезНулей = СокрЛП(Значение);
	
	ДлинаКода = СтрДлина(ЗначениеБезНулей);
	
	Для н = 1 По ДлинаКода Цикл
		
		Если Лев(ЗначениеБезНулей, 1) = "0" Тогда
			ЗначениеБезНулей = Сред(ЗначениеБезНулей, 2);
		Иначе
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ЗначениеБезНулей;

КонецФункции

//После получения и парсинга входящего сообщения дозаполняет в нем поля:
//Грузополучатель1С, Покупатель1С, ТочкаДоставки, ДатаПоставки, Договор.
Процедура ПослеКонвертацииСообщенияEDIв1С(Сообщение)
	
	КтоМы = ОпределитьКемМыЯвляемся(Сообщение); 
	
	Если КтоМы = "Поставщик" Тогда 
		
		Если ЭтоОбратнаяОтгрузка(Сообщение.ТипСообщения) 
			ИЛИ Сообщение.ТипСообщения = "RETANN" Тогда
			Сообщение.ТочкаДоставки = Сообщение.Грузоотправитель1С;
		Иначе
			Сообщение.ТочкаДоставки = Сообщение.Грузополучатель1С;
		КонецЕсли;	
			
		Если ЗначениеЗаполнено(Сообщение.ПлательщикEDI.GLN) 
			И ЗначениеЗаполнено(Сообщение.Плательщик1С) Тогда
			//Сообщение.ПокупательEDI = Сообщение.ПлательщикEDI;
			Сообщение.Покупатель1С = Сообщение.Плательщик1С;//костыль для Елисея в свое время.
		КонецЕсли;
		
		ГрузополучательИзЮрФизЛицаТД = ОпределитьЗначениеНастройкиГрузополучательИзЮрФизЛицаТД(Сообщение.Партнер);
		
		//на рефакторинг: убрать в ПринятьВходящееСообщение со временем.
		Если ГрузополучательИзЮрФизЛицаТД = Ложь Тогда
			
			ПолучитьЮрФизЛицоПартнераПоТочкеДоставки(Сообщение);
			
		КонецЕсли;
		
		Если Сообщение.ТипСообщения = "RECADV"
			И Не ЗначениеЗаполнено(Сообщение.ДатаПоставки) 
			И ЗначениеЗаполнено(Сообщение.Накладная1С) Тогда
			
			Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
			Запрос.УстановитьПараметр("Документ", ПреобразоватьЗначениеДляВнешнегоХранилища(Сообщение.Накладная1С));
			
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	КонтурEDI_Сообщения.ДатаПоставки
			|ИЗ
			|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
			|ГДЕ
			|	КонтурEDI_Сообщения.Документ = &Документ
			|	И КонтурEDI_Сообщения.ТипСообщения = ""DESADV""
			|	И НЕ КонтурEDI_Сообщения.ПометкаУдаления";
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Если РезультатЗапроса.Пустой() Тогда
				
				ДатаПоставки = Неопределено;
				
			Иначе
				
				Выборка = РезультатЗапроса.Выбрать();
				Выборка.Следующий();
				
				ДатаПоставки = Выборка.ДатаПоставки;
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДатаПоставки) Тогда
				Сообщение.ДатаПоставки = ДатаПоставки;		
			КонецЕсли;
			
		КонецЕсли;
		
		//в КонвертироватьЗначениеEDIв1с для RECADV мы не конвертируем Сообщение.Документ1с поэтому записываем здесь, т.к. накладную мы уже нашли
		Если Сообщение.ТипСообщения = "RECADV"              
			И Не ЗначениеЗаполнено(Сообщение.Документ1С) 
			И ЗначениеЗаполнено(Сообщение.Накладная1С) Тогда
			Сообщение.Документ1С = Сообщение.Накладная1С;
		КонецЕсли;	
	КонецЕсли;
	
	//БЛОК Сторона СЕТИ
	
	Если Сообщение.ТипСообщения = "INVOIC" 
		И Сообщение.Направление = "Входящее" Тогда
		Если ЗначениеЗаполнено(Сообщение.Документ1С) Тогда//если мы загружаем пришедшую СЧФ и оказалось что документ уже есть - проставим его
			Сообщение.ДокументСсылка = Сообщение.Документ1С;
		КонецЕсли;
		Сообщение.ТочкаДоставки = Сообщение.Грузополучатель1С;
	КонецЕсли;
	
	Если Сообщение.ТипСообщения = "ORDRSP" 
		И Сообщение.Направление = "Входящее" Тогда
		Если ЗначениеЗаполнено(Сообщение.Заказ1С) Тогда//если мы загружаем пришедший ответ на заказ и документ-заказ сконвертировался то проставим его
			Сообщение.ДокументСсылка = Сообщение.Заказ1С;
			Сообщение.Документ1С = Сообщение.Заказ1С;
		КонецЕсли;
		Сообщение.ТочкаДоставки = Сообщение.Грузополучатель1С;
	КонецЕсли;
	
	Если Сообщение.ТипСообщения = "DESADV" 
		И Сообщение.Направление = "Входящее"
		И ПолучитьТипЗначенияОбъекта("ИсходящийЗаказПоставщику",,Истина) = ПолучитьТипЗначенияОбъекта("ВходящееУведомлениеОбОтгрузке",,Истина) Тогда
		Если ЗначениеЗаполнено(Сообщение.Заказ1С) Тогда//в качестве заказа и документа для desadv выступает один и тот же документ - соотв. мы знаем документ1С для сообщеиня
			Сообщение.ДокументСсылка = Сообщение.Заказ1С;
			Сообщение.Документ1С = Сообщение.Заказ1С;
		КонецЕсли;
		Сообщение.ТочкаДоставки = Сообщение.Грузополучатель1С;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПолучитьЮрФизЛицоПартнераПоТочкеДоставки(Сообщение, ЮрФизЛицоПартнера = "") Экспорт

	Если Сообщение.ТипСообщения = "RETDES" Тогда
		ТочкаДоставкиПартнера 	= "Грузоотправитель1С";
		ЮрФизЛицоПартнера		= "Продавец1С";
	ИначеЕсли Сообщение.ТипСообщения = "RETANN" Тогда
		ТочкаДоставкиПартнера 	= "Грузоотправитель1С";
		ЮрФизЛицоПартнера		= "Покупатель1С";
	Иначе
		ТочкаДоставкиПартнера 	= "Грузополучатель1С";
		ЮрФизЛицоПартнера		= "Покупатель1С";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Сообщение[ТочкаДоставкиПартнера]) Тогда 
		
		ТочкаДоставки = ПолучитьЭлементСправочника("ТочкиДоставкиСторонние",Сообщение[ТочкаДоставкиПартнера]); 
		
		Если ЗначениеЗаполнено(ТочкаДоставки.ЮрФизЛицо) Тогда 
			Сообщение[ЮрФизЛицоПартнера] = ТочкаДоставки.ЮрФизЛицо; 
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция ТипПоставкиСообщения(Сообщение) Экспорт
	
	//возвращает тип поставки (сток\транзит) из первой строки
	ТипПоставки = "";
	ТабЧасть = Сообщение.Товары;
	Если ТабЧасть.Количество()>0 Тогда
		Если НЕ ТабЧасть.Колонки.Найти("ТипПоставки")=Неопределено Тогда
			ТипПоставки = СокрЛП(ТабЧасть[0].ТипПоставки);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТипПоставки;
	
КонецФункции

// установка соответствий

//Устарела, грозится исчезнуть (более нигде не вызывается)
Функция Товары_НайтиПоИдентификаторам(ВладелецСпискаТоваров = Неопределено, GTIN = Неопределено, КодТовараПартнера = Неопределено, НашКодТовара = Неопределено, ПоПриоритету = Ложь)
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("GTIN", GTIN);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ "+?(ПоПриоритету,"","РАЗЛИЧНЫЕ")+"
	|	ВложенныйЗапрос.Номенклатура,
	|	ВложенныйЗапрос.ХарактеристикаНоменклатуры,
	|	ВложенныйЗапрос.ЕдиницаИзмерения
	|	"+?(ПоПриоритету,", ВложенныйЗапрос.Порядок КАК Порядок ","") + "
	|ИЗ
	|	(
	|";
	
	ВложенныйЗапрос = "";
	
	Если НЕ ПустаяСтрока(GTIN) Тогда
		
		// уберем поиск соответствий товара по штрихкоду
		
		//Если НЕ ИмяКонфигурации1С = "БП" Тогда
		//	
		//	ВложенныйЗапрос = "ВЫБРАТЬ
		//					|	Штрихкоды.Владелец КАК Номенклатура,
		//					|	Штрихкоды.ХарактеристикаНоменклатуры,
		//					|	Штрихкоды.ЕдиницаИзмерения,
		//					|	3 КАК Порядок
		//					|ИЗ
		//					|	РегистрСведений.Штрихкоды КАК Штрихкоды
		//					|ГДЕ
		//					|	Штрихкоды.ТипШтрихкода = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ТипыШтрихкодов.EAN13)
		//					|	И Штрихкоды.Штрихкод = ПОДСТРОКА(&GTIN, 2, 13)";
		//	
		//КонецЕсли;				 
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВладелецСпискаТоваров) Тогда
		
		Если ЗначениеЗаполнено(GTIN) Тогда
			
			Если НЕ ПустаяСтрока(ВложенныйЗапрос) Тогда
				
				ВложенныйЗапрос = ВложенныйЗапрос + " Объединить все ";
				
			КонецЕсли;
			
			ВложенныйЗапрос = ВложенныйЗапрос+ "
			|	
			|ВЫБРАТЬ
			|	КонтурEDI_СоответствияТоваров.Номенклатура,
			|	КонтурEDI_СоответствияТоваров.ХарактеристикаНоменклатуры,
			|	КонтурEDI_СоответствияТоваров.Единица КАК ЕдиницаИзмерения,
			|	2 КАК Порядок
			|ИЗ
			|	РегистрСведений.КонтурEDI_СоответствияТоваров КАК КонтурEDI_СоответствияТоваров
			|ГДЕ
			|	КонтурEDI_СоответствияТоваров.GTIN = &GTIN
			|	И КонтурEDI_СоответствияТоваров.Контрагент = &Контрагент
			|
			|";
				
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КодТовараПартнера) Тогда
			
			Если НЕ ПустаяСтрока(ВложенныйЗапрос) Тогда
				
				ВложенныйЗапрос = ВложенныйЗапрос + " Объединить все ";
				
			КонецЕсли;
			
			ВложенныйЗапрос = ВложенныйЗапрос+ "
			|	
			|ВЫБРАТЬ
			|	КонтурEDI_СоответствияТоваров.Номенклатура,
			|	КонтурEDI_СоответствияТоваров.ХарактеристикаНоменклатуры,
			|	КонтурEDI_СоответствияТоваров.Единица КАК ЕдиницаИзмерения,
			|	1 КАК Порядок
			|ИЗ
			|	РегистрСведений.КонтурEDI_СоответствияТоваров КАК КонтурEDI_СоответствияТоваров
			|ГДЕ
			|	КонтурEDI_СоответствияТоваров.КодТовараПартнера = &КодТовараПартнера
			|	И КонтурEDI_СоответствияТоваров.Контрагент = &Контрагент
			|";
			
			Запрос.УстановитьПараметр("КодТовараПартнера",	КодТовараПартнера);
			
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Контрагент",	ВладелецСпискаТоваров);
		
	КонецЕсли;
	
	Если ВложенныйЗапрос = "" Тогда
		
		ТЗ = Новый ТаблицаЗначений;
		ТЗ.Колонки.Добавить("Номенклатура");
		ТЗ.Колонки.Добавить("ХарактеристикаНоменклатуры");
		ТЗ.Колонки.Добавить("ЕдиницаИзмерения");
		
		Возврат ТЗ;
		
	Иначе
		
		Запрос.Текст = Запрос.Текст+ ВложенныйЗапрос +"
		|) КАК ВложенныйЗапрос "+?(ПоПриоритету,"Упорядочить ПО ВложенныйЗапрос.Порядок", "");
		
		ТЗ = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
	
	Возврат ТЗ;	
	
КонецФункции

//Устарела, грозится исчезнуть (более нигде не вызывается)
Процедура Товары_ЗаписатьСоответствие(ВладелецСпискаТоваров, Номенклатура, ХарактеристикаНоменклатуры = Неопределено, ЕдиницаИзмерения, GTIN =  Неопределено, КодТовараПартнера =  Неопределено, НашКодТовара =  Неопределено, Отказ =  Ложь)
	
	Запись = РегистрыСведений.КонтурEDI_СоответствияТоваров.СоздатьМенеджерЗаписи();
	
	Запись.Контрагент					= ВладелецСпискаТоваров;
	Запись.Номенклатура					= Номенклатура;
	Запись.ХарактеристикаНоменклатуры	= ХарактеристикаНоменклатуры;
	Запись.Единица						= ЕдиницаИзмерения;
	
	Запись.GTIN						= GTIN;
	Запись.КодТовараПартнера		= КодТовараПартнера;
	
	Попытка
		Запись.Записать();
	Исключение
		Отказ = Истина;	
	КонецПопытки;
	
КонецПроцедуры

Процедура УстановитьGLN(Ссылка,ИмяСвойства,GLN,Отказ = Ложь)
	
	//на рефакторинг: опасный цикл
	Если ЗначениеЗаполнено(Ссылка) Тогда
		
		Если НЕ ИмяСвойства = "GLN_ТочкиДоставки" Тогда
			
			Пока Истина Цикл
				
				ТекЗначение = НайтиОбъектПоЗначениюСвойства(ИмяСвойства, GLN);
				
				Если ЗначениеЗаполнено(ТекЗначение) Тогда
					УдалитьЗначениеСвойстваОбъекта(ТекЗначение, ИмяСвойства);
				Иначе
					Прервать;
				КонецЕсли;
				
			КонецЦикла;	
			
		КонецЕсли;
		
		УстановитьЗначениеСвойстваОбъекта(Ссылка, ИмяСвойства, GLN);
		
	КонецЕсли;	
	
КонецПроцедуры

// Создадим запрос, в котором уже будут временные таблицы партнеров и их цепочек сообщений
Функция ИнициализироватьЗапросСКэшемПартнеров(ДляВнешнегоХранилища = Ложь, НачалоПериода, КонецПериода, МассивПартнеров)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ТаблицаКэшПартнеров", ТаблицаКэшПартнеров);
	Запрос.УстановитьПараметр("ТаблицаКэшПартнеровКонтрагентов", ТаблицаКэшПартнеровКонтрагентов);
	Запрос.УстановитьПараметр("Партнеры", МассивПартнеров);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	
	Запрос.Текст = 
	"ВЫБРАТЬ * 
	|ПОМЕСТИТЬ ТаблицаКэшПартнеров 
	|ИЗ 
	|	&ТаблицаКэшПартнеров КАК _ТаблицаКэшПартнеров 
	|ГДЕ 
	|	_ТаблицаКэшПартнеров.Партнер в (&Партнеры) 
	|ИНДЕКСИРОВАТЬ ПО 
	|	Партнер,
	|	СообщениеБлокирующееORDERS,
	|	СообщениеБлокирующееORDRSP,
	|	СообщениеБлокирующееDESADV,
	|	СообщениеБлокирующееRECADV,
	|	СообщениеБлокирующееINVOIC
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ * 
	|ПОМЕСТИТЬ ТаблицаКэшПартнеровКонтрагентов 
	|ИЗ 
	|	&ТаблицаКэшПартнеровКонтрагентов как _ТаблицаКэшПартнеровКонтрагентов
	|ГДЕ
	|	_ТаблицаКэшПартнеровКонтрагентов.Партнер в (&Партнеры) 
	|ИНДЕКСИРОВАТЬ ПО 
	|	Контрагент, 
	|	Партнер,
	|	СообщениеБлокирующееORDERS,
	|	СообщениеБлокирующееORDRSP,
	|	СообщениеБлокирующееDESADV,
	|	СообщениеБлокирующееRECADV,
	|	СообщениеБлокирующееINVOIC";
	// может, и остальные поля индексировать? Надо глянуть, что в соединениях еще участвует
	
	Запрос.Выполнить();
	
	Возврат Запрос;
	
КонецФункции	

// получение и отправка сообщений

//суффикс БМИ - функция располагалась в базовом модуле интеграции
//с основной функцией большая разница в параметрах, поэтому объединять сложно
Функция ПринятьВходящееСообщение_БМИ(ЗНАЧ Сообщение,ПервоначальнаяЗагрузкаСообщения = Истина, ИнтерактивнаяОбработка = Ложь) Экспорт//само Сообщение больше не меняем. Данная функция занимается только заполнением документа в 1С по сообщению.
	
	Если НЕ Сообщение = Неопределено Тогда
		Если Сообщение.ТипСообщения = "PORDERS" Тогда
			Возврат ПринятьОбратныйЗаказПоставщика(Сообщение,ПервоначальнаяЗагрузкаСообщения);
		ИначеЕсли Сообщение.ТипСообщения = "ORDERS" Тогда
			Возврат ПринятьЗаказПокупателя(Сообщение,ПервоначальнаяЗагрузкаСообщения);
		ИначеЕсли Сообщение.ТипСообщения = "RECADV" Тогда
			Возврат ПринятьУведомлениеОПриемке(Сообщение);
		ИначеЕсли Сообщение.ТипСообщения = "ORDRSP" Тогда
			Возврат ПринятьОтветНаЗаказ(Сообщение);
		ИначеЕсли Сообщение.ТипСообщения = "DESADV" Тогда		
			Возврат ПринятьУведомлениеОбОтгрузке(Сообщение, ИнтерактивнаяОбработка);
		ИначеЕсли Сообщение.ТипСообщения = "INVOIC" Тогда
			Возврат ПринятьСчетФактуру(Сообщение);
		ИначеЕсли Сообщение.ТипСообщения = "RETANN" ИЛИ Сообщение.ТипСообщения = "RETDES" Тогда
			Возврат ПринятьВозвратТоваров(Сообщение,ПервоначальнаяЗагрузкаСообщения);
		ИначеЕсли Сообщение.ТипСообщения = "PRICELIST" ИЛИ Сообщение.ТипСообщения = "PRICAT" Тогда
			ОбработатьВходящееНезависимоеСообщение(Сообщение);
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

//ORDRSP входящий
Функция ПринятьОтветНаЗаказ(Сообщение)
	
	ТипДокументаЗаказПоставщику = ПолучитьТипЗначенияОбъекта("ИсходящийЗаказПоставщику");
	ИмяТипаДокумента = СтрЗаменить(ТипДокументаЗаказПоставщику,"ДокументСсылка.","");
	
	НайденныйДокумент = Сообщение.Заказ1С; // уже искали этот документ при конвертации по полю "Заказ"
	Если Не ЗначениеЗаполнено(НайденныйДокумент) Тогда 
		НайденныйДокумент = Документы[ИмяТипаДокумента].НайтиПоНомеру(Сообщение.ЗаказEDI.Номер,ТекущаяДата());
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденныйДокумент) Тогда
		
		Если Сообщение.Статус = "Rejected" Тогда
			УстановитьСтатусДокумента(НайденныйДокумент, "ЗаказОтклонен", "Заказ", Сообщение.СообщениеСсылка);
		ИначеЕсли Сообщение.Статус = "Changed" Тогда
			УстановитьСтатусДокумента(НайденныйДокумент, "ЗаказУточнен", "Заказ", Сообщение.СообщениеСсылка);
		Иначе
			УстановитьСтатусДокумента(НайденныйДокумент, "ЗаказПодтвержден", "Заказ", Сообщение.СообщениеСсылка);
		КонецЕсли;
		
		Возврат НайденныйДокумент;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	
КонецФункции

//DESADV входящий
Функция ПринятьУведомлениеОбОтгрузке(Сообщение, ИнтерактивнаяОбработка = Ложь)
	
	Если ИспользоватьМаппингМетаданных Тогда
		ДокументСсылка = Маппинг_ПринятьУведомлениеОбОтгрузке(Сообщение);
		Возврат ДокументСсылка;
	КонецЕсли;
	
	СтандартнаяОбработкаEDI = Истина;
	Документ = ОбработкаСобытияПодключаемогоМодуля("ПринятьУведомлениеОбОтгрузке", СтандартнаяОбработкаEDI, Новый Структура("Сообщение", Сообщение));
	
	Если Не СтандартнаяОбработкаEDI Тогда
		
		Если НЕ Документ = Неопределено Тогда
			ДокументСсылка = Документ.Ссылка;
		Иначе
			ДокументСсылка = Неопределено;
		КонецЕсли;  
		
		Возврат ДокументСсылка; 
			
	КонецЕсли;
	
	Если НЕ НастройкиМодуля["DESADV"].ПриниматьАвтоматически И Не ИнтерактивнаяОбработка Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТипДокументаORDERS = ПолучитьТипЗначенияОбъекта("ИсходящийЗаказПоставщику",, Истина);
	ТипДокументаDESADV = ПолучитьТипЗначенияОбъекта("ВходящееУведомлениеОбОтгрузке",, Истина);

	ДатаДокумента = Сообщение.ЗаказEDI.Дата;
	Если НЕ ЗначениеЗаполнено(ДатаДокумента) Тогда
		ДатаДокумента = ТекущаяДата();
	КонецЕсли;
	
	НайденныйЗаказ = Документы[ТипДокументаORDERS].НайтиПоНомеру(Сообщение.ЗаказEDI.Номер,ДатаДокумента);

	Если НЕ ЗначениеЗаполнено(НайденныйЗаказ) Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Сообщение.Документ1С) Тогда
		
		Документ = Сообщение.Документ1С.ПолучитьОбъект();
		
	Иначе
		
		//Ищем DESADV с таким же номером накладной и номером заказа,
		//если такое сообщение есть - грузим в его документ, иначе создаем новый
		СообщениеDESADV = Неопределено;
		
		СтруктураОтбора = СтруктураОтбораСообщений();
		СтруктураОтбора.ТипСообщения.Значение = "DESADV";
		СтруктураОтбора.Направление.Значение = "Входящее";
		СтруктураОтбора.Партнер.Значение = Сообщение.Партнер;
		СтруктураОтбора.НомерДокумента.Значение = Сообщение.ДокументEDI.Номер;
		СтруктураОтбора.НомерЗаказа.Значение = Сообщение.ЗаказEDI.Номер;
		СтруктураОтбора.ID.Значение = Сообщение.ID;
		СтруктураОтбора.ID.ВидСравнения = ВидСравнения.НеРавно;
		
		СообщениеDESADV = НайтиСообщенияПоОтбору(СтруктураОтбора, Истина);
		
		Если ЗначениеЗаполнено(СообщениеDESADV) Тогда
			СообщениеОбъект = СообщениеDESADV.ПолучитьОбъект();
			СообщениеОбъект.ТипСообщения = "#DESADV";					
			СохранитьОбъектСообщения(СообщениеОбъект);	
		КонецЕсли;
		
		Если ТипДокументаDESADV = ТипДокументаORDERS Тогда
			//Для конфигураций, где нет документа-заказа и для этой цели используется поступление(БП2)
			Документ = НайденныйЗаказ.ПолучитьОбъект();		
		Иначе		
			Если ЗначениеЗаполнено(СообщениеDESADV) И ЗначениеЗаполнено(СообщениеDESADV.Документ) Тогда
				Документ = СообщениеDESADV.Документ.ПолучитьОбъект();	
			Иначе	
				Документ = Документы[ТипДокументаDESADV].СоздатьДокумент();
				Документ.Заполнить(НайденныйЗаказ);
				Документ.Дата = ТекущаяДата();	
			КонецЕсли;
		КонецЕсли;   		
		
	КонецЕсли;       	
		
	ЗаполнитьДокументПоступленияНаОснованииСообщения(Сообщение, Документ, НайденныйЗаказ);
	
	Возврат Документ.Ссылка;
	
КонецФункции

Функция СтруктураЗначенияОтбораСообщений() Экспорт
	
	СтруктураЗначенияОтбораСообщений = Новый Структура;
	СтруктураЗначенияОтбораСообщений.Вставить("Значение");
	СтруктураЗначенияОтбораСообщений.Вставить("ВидСравнения", ВидСравнения.Равно);
	
	Возврат СтруктураЗначенияОтбораСообщений;
	
КонецФункции

Функция СтруктураОтбораСообщений() Экспорт
	
	//Как вариант на будущее - можно не описывать, а брать из метаданных
	СтруктураОтбора = Новый Структура;
	
	СтруктураОтбора.Вставить("ТипСообщения", СтруктураЗначенияОтбораСообщений());
	СтруктураОтбора.Вставить("Направление", СтруктураЗначенияОтбораСообщений());
	СтруктураОтбора.Вставить("НомерДокумента", СтруктураЗначенияОтбораСообщений());
	СтруктураОтбора.Вставить("ДатаДокумента", СтруктураЗначенияОтбораСообщений());
	СтруктураОтбора.Вставить("НомерЗаказа", СтруктураЗначенияОтбораСообщений());
	СтруктураОтбора.Вставить("НомерСерииЗаказов", СтруктураЗначенияОтбораСообщений());
	СтруктураОтбора.Вставить("ТочкаДоставки", СтруктураЗначенияОтбораСообщений());
	СтруктураОтбора.Вставить("Партнер", СтруктураЗначенияОтбораСообщений());
	СтруктураОтбора.Вставить("Статус", СтруктураЗначенияОтбораСообщений());
	СтруктураОтбора.Вставить("Документ", СтруктураЗначенияОтбораСообщений());
	СтруктураОтбора.Вставить("Организация", СтруктураЗначенияОтбораСообщений());	
	СтруктураОтбора.Вставить("ДатаЗаказа", СтруктураЗначенияОтбораСообщений());
	СтруктураОтбора.Вставить("ДатаПоставки", СтруктураЗначенияОтбораСообщений());
	СтруктураОтбора.Вставить("Архив", СтруктураЗначенияОтбораСообщений());
	СтруктураОтбора.Вставить("ID", СтруктураЗначенияОтбораСообщений());
	
	Возврат СтруктураОтбора;
	
КонецФункции

Функция НайтиСообщенияПоОтбору(СтруктураОтбора, ТолькоПервое = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтурEDI_Сообщения.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
		|ГДЕ
		|	КонтурEDI_Сообщения.ПометкаУдаления = ЛОЖЬ";
	
	Если ТолькоПервое Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВЫБРАТЬ РАЗРЕШЕННЫЕ", "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1");
	КонецЕсли;
	
	Для Каждого КлючЗначение Из СтруктураОтбора Цикл
		ИмяРеквизита = КлючЗначение.Ключ;
		ЗначениеОтбора = КлючЗначение.Значение.Значение;
		ВидСравнения_ = КлючЗначение.Значение.ВидСравнения;
		
		Если Не ЗначениеОтбора = Неопределено Тогда
			
			ВидСравненияСимвол = " = ";
			ОкончаниеУсловия = "";
			
			Если ВидСравнения_ = ВидСравнения.НеРавно Тогда
				ВидСравненияСимвол = " <> ";
			ИначеЕсли ВидСравнения_ = ВидСравнения.Больше Тогда
				ВидСравненияСимвол = " > ";
			ИначеЕсли ВидСравнения_ = ВидСравнения.БольшеИлиРавно Тогда
				ВидСравненияСимвол = " >= ";
			ИначеЕсли ВидСравнения_ = ВидСравнения.Меньше Тогда
				ВидСравненияСимвол = " < ";
			ИначеЕсли ВидСравнения_ = ВидСравнения.МеньшеИлиРавно Тогда
				ВидСравненияСимвол = " <= "; 
			ИначеЕсли ВидСравнения_ = ВидСравнения.ВСписке Тогда
				ВидСравненияСимвол = " В (";
				ОкончаниеУсловия = ")";
			ИначеЕсли ВидСравнения_ = ВидСравнения.НеВСписке Тогда
				ВидСравненияСимвол = " НЕ В (";
				ОкончаниеУсловия = ")";
			КонецЕсли;
			
			Запрос.Текст = Запрос.Текст + Символы.ПС + "	И КонтурEDI_Сообщения." + ИмяРеквизита + ВидСравненияСимвол + "&" + ИмяРеквизита + ОкончаниеУсловия;
			Запрос.УстановитьПараметр(ИмяРеквизита, ЗначениеОтбора);
		КонецЕсли;
	КонецЦикла;
	
	МассивСообщений = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Если ТолькоПервое Тогда
		Если МассивСообщений.Количество() Тогда
			Результат = МассивСообщений[0];
		Иначе
			Результат = Неопределено;
		КонецЕсли;
	Иначе
		Результат = МассивСообщений;		
	КонецЕсли;
	
	Возврат Результат;
		
КонецФункции

//RECADV входящий
Функция ПринятьУведомлениеОПриемке(Сообщение)

	НайденныйДокумент = Сообщение.Накладная1С;
	
	Если Не ЗначениеЗаполнено(НайденныйДокумент) Тогда
		НайденныйДокумент = НайтиИПолучитьНакладную(Сообщение);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденныйДокумент) Тогда
		
		Сообщение.ДокументСсылка = НайденныйДокумент;
		СохранитьСообщение(Сообщение, "ВходящийОжидаетУстановкиСоответствий");
		
		НастройкиСравненияRECADV = ПолучитьСписокСвойствEDI("СверятьВRECADVЦеныИСтавки
															|СверятьВRECADVКодыМаркировки
															|КодыМаркировкиВDESADV
															|КодыМаркировкиВINVOIC",
															Сообщение.Партнер); 
															
		Если НастройкиСравненияRECADV.СверятьВRECADVКодыМаркировки = Истина Тогда
			
			ПараметрыПодготовкиИсходящегоСообщения = ПараметрыПодготовкиСообщенияДляОбработкиПриемки(Сообщение);															
			ПараметрыПодготовкиИсходящегоСообщения.Вставить("ИгнорироватьНастройкиОтправкиКодовМаркировки", Истина);
			ПараметрыПодготовкиИсходящегоСообщения.Вставить("ПропуститьПроверкуСообщения", Истина);

			СообщениеСКодамиМаркировки = ПолучитьСообщениеСКодамиМаркировкиДляОбработкиПриемки(НайденныйДокумент, НастройкиСравненияRECADV);
									
			Если ЗначениеЗаполнено(СообщениеСКодамиМаркировки) Тогда
				
				ПараметрыПодготовкиИсходящегоСообщения.Вставить("СообщениеСсылка", СообщениеСКодамиМаркировки);
				ТипИсходящегоСообщения = СообщениеСКодамиМаркировки.ТипСообщения;
				ДокументИсходящегоСообщения = СообщениеСКодамиМаркировки.Документ;
				
			Иначе
				
				ТипИсходящегоСообщения = "DESADV";
				ДокументИсходящегоСообщения = НайденныйДокумент;
				
			КонецЕсли;
			
			СообщениеДляСравнения = ПодготовитьИсходящееСообщение(ТипИсходящегоСообщения, 
															  	  ДокументИсходящегоСообщения, 
															      ПараметрыПодготовкиИсходящегоСообщения);
																  
			ТоварыДляСравнения = СообщениеДляСравнения.Товары;
			
		Иначе
			
			ПараметрыПодготовкиИсходящегоСообщения = Новый Структура();
			ПараметрыПодготовкиИсходящегоСообщения.Вставить("Действие","ПринятьУведомлениеОПриемке");
			ПараметрыПодготовкиИсходящегоСообщения.Вставить("ПропуститьПроверкуСообщения", Истина);
			
			СообщениеДляСравнения = ПодготовитьИсходящееСообщение("DESADV", НайденныйДокумент, ПараметрыПодготовкиИсходящегоСообщения);
			ТоварыДляСравнения = ПолучитьТоварыДокументаДляСообщения(НайденныйДокумент, Истина, "ОбработкаРасхожденийПриемки", , Сообщение);
			
		КонецЕсли;	
		
		СтруктураТаблицы1 = ПолучитьСтруктуруТаблицыТоваров();
		СтруктураТаблицы1.Вид			= "Сообщение";
		СтруктураТаблицы1.ТипСообщения	= "RECADV";
		СтруктураТаблицы1.Товары		= Сообщение.Товары;
		
		СтруктураТаблицы2 = ПолучитьСтруктуруТаблицыТоваров();
		СтруктураТаблицы2.Вид			= "Документ";
		СтруктураТаблицы2.ТипСообщения	= "DESADV";  	
		СтруктураТаблицы2.Товары		= ТоварыДляСравнения;
		
		СравниваемыеПоля = Новый СписокЗначений;
		СравниваемыеПоля.Добавить("Количество");
		
		РассчитыватьНДСПриСравнении = Ложь;
		Если НастройкиСравненияRECADV.СверятьВRECADVЦеныИСтавки = Истина Тогда
			СравниваемыеПоля.Добавить("ЦенаБезНДС"); 
			СравниваемыеПоля.Добавить("ЦенаСНДС"); 
			РассчитыватьНДСПриСравнении = Истина;
		КонецЕсли;
		
		Если НастройкиСравненияRECADV.СверятьВRECADVКодыМаркировки = Истина Тогда
			СравниваемыеПоля.Добавить("КодыМаркировки");
		КонецЕсли;
		
		РезультатСравнения = СравнитьТаблицыТоваров(
								СтруктураТаблицы1,
								СтруктураТаблицы2,
								СравниваемыеПоля,
								РассчитыватьНДСПриСравнении,
								Истина,
								Сообщение,
								СообщениеДляСравнения);
		
		Если РезультатСравнения.Успешно = Истина И НЕ РезультатСравнения.ЕстьРасхождения Тогда
			ЕстьОтклонения = Ложь;
		Иначе
			ЕстьОтклонения = Истина;
		КонецЕсли;	
		
		Если ЕстьОтклонения Тогда
			УстановитьСтатусДокумента(НайденныйДокумент, "НакладнаяПринятЧастично",	"Приемка",Сообщение.СообщениеСсылка);
		Иначе
			УстановитьСтатусДокумента(НайденныйДокумент, "НакладнаяПринятПолностью", "Приемка",Сообщение.СообщениеСсылка);
		КонецЕсли;	
		
	КонецЕсли;
	
	Возврат НайденныйДокумент;
	
КонецФункции

Функция ПараметрыПодготовкиСообщенияДляОбработкиПриемки(СообщениеRECADV)
	
	ПараметрыПодготовкиИсходящегоСообщения = Новый Структура;
	ПараметрыПодготовкиИсходящегоСообщения.Вставить("Действие","ПринятьУведомлениеОПриемке");
	ПараметрыПодготовкиИсходящегоСообщения.Вставить("ИсточникПодготовкиТоваров", "ОбработкаРасхожденийПриемки");
	ПараметрыПодготовкиИсходящегоСообщения.Вставить("КонтекстСообщенияДляПодготовкиТоваров", СообщениеRECADV);
	Возврат ПараметрыПодготовкиИсходящегоСообщения;
	
КонецФункции

Функция ИспользоватьВозвратнуюТару_УТ_10_3_КА()
	
	Если (ИмяКонфигурации1С = "УТ_10_3" ИЛИ ИмяКонфигурации1С = "КА")
		И Метаданные.Константы.Найти("ИспользоватьВозвратнуюТару") <> Неопределено
		И Константы.ИспользоватьВозвратнуюТару.Получить() Тогда
		
		ИспользоватьВозвратнуюТару = Истина;
		
	Иначе
		ИспользоватьВозвратнуюТару = Ложь;
	КонецЕсли;
	
	Возврат ИспользоватьВозвратнуюТару;
	
КонецФункции

//RETANN входящий
//RETDES входящий
Функция ПринятьВозвратТоваров(Сообщение, ПервоначальнаяЗагрузкаСообщения = Истина, ЗагружатьВДокПоступление = Ложь) Экспорт
	
	Если Сообщение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИД = СокрЛП(Сообщение.ID);
	
	// TODO вроде как искать загруженный документ уже поздно, нужно было делать это где-то раньше
	// или это доп. проверка на случай, когда форма долго открыта в многопользовательском режиме?
	// еще похоже на дублирование кода
	Если ПервоначальнаяЗагрузкаСообщения Тогда
		
		Если ЗначениеЗаполнено(ИД) Тогда
			
			Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КонтурEDI_Сообщения.Документ
			|ИЗ
			|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
			|ГДЕ
			|	КонтурEDI_Сообщения.ID = &ID";
			
			Запрос.УстановитьПараметр("ID",ИД);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Если РезультатЗапроса.Пустой() Тогда
				
				НайденныйДокумент = Неопределено;
				
			Иначе
				
				Выборка = РезультатЗапроса.Выбрать();
				Выборка.Следующий();
				
				НайденныйДокумент = Выборка.Документ;
				
			КонецЕсли;
						
			Если ЗначениеЗаполнено(НайденныйДокумент) Тогда
				Возврат Неопределено;
			КонецЕсли;
			
		КонецЕсли;	
	КонецЕсли;
	
	Если ИспользоватьМаппингМетаданных Тогда
		ДокументСсылка = Маппинг_ПринятьВозвратТоваров(Сообщение,ПервоначальнаяЗагрузкаСообщения);
		Возврат ДокументСсылка;
	КонецЕсли;
	
	
	ДокПоУмолчанию = ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, "ДокументПоУмолчанию" + Сообщение.ТипСообщения); 
	ДокПоУмолчаниюКорр = НЕ (ДокПоУмолчанию = "Создавать документ Возврат товаров от клиента");
	
	Если ЕстьКоррИспрСФ 
		И ЗначениеЗаполнено(Сообщение.Накладная1С)
		И ДокПоУмолчаниюКорр Тогда
		
	    ДокументКорректировкиСсылка = ПринятьВозвратТоваровВКорректировкуРеализации(Сообщение, ПервоначальнаяЗагрузкаСообщения);
		Возврат ДокументКорректировкиСсылка;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Сообщение.Договор) Тогда
		Сообщение.Договор = ПолучитьДоговорКонтрагентаДляСообщения(Сообщение,ОпределитьКемМыЯвляемся(Сообщение));
	КонецЕсли;
	
	ДоговорКонтрагента = Сообщение.Договор;
	
	Если ЗначениеЗаполнено(ДоговорКонтрагента) Тогда

		// запомним договор по-умолчанию
		УстановитьЗначениеСвойстваОбъекта(Сообщение.Покупатель1С, "GUIDДоговораПоУмолчанию", СокрЛП(ДоговорКонтрагента.УникальныйИдентификатор()));
		
	КонецЕсли;
	
	Если ЗагружатьВДокПоступление И ЕстьНеобходимыеМетаданные("Документы.ПоступлениеТоваровУслуг") Тогда
		ТипВозвратногоДокумента = "ПоступлениеТоваровУслуг";
	КонецЕсли;
	
	Если ЗагружатьВДокПоступление И ЕстьНеобходимыеМетаданные("Документы.ПриобретениеТоваровУслуг") Тогда
		ТипВозвратногоДокумента = "ПриобретениеТоваровУслуг";
	КонецЕсли;
	
	Если НЕ ЗагружатьВДокПоступление Тогда
		ТипВозвратногоДокумента = ПолучитьТипЗначенияОбъекта("ВходящийВозврат",,Истина);
	КонецЕсли;
	
	Если ПервоначальнаяЗагрузкаСообщения Тогда
		
		Если ЗначениеЗаполнено(ТипВозвратногоДокумента) Тогда 
			НовыйДокумент = Документы[ТипВозвратногоДокумента].СоздатьДокумент();
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		НовыйДокумент = Сообщение.ДокументСсылка.ПолучитьОбъект();
	КонецЕсли;
	
	Если ЗагружатьВДокПоступление
		ИЛИ ТипВозвратногоДокумента = "ПоступлениеТоваровУслуг"
		ИЛИ ТипВозвратногоДокумента = "ПриобретениеТоваровУслуг" Тогда
		ЗагружатьВозвратВДокументПоступление = Истина;
	Иначе
		ЗагружатьВозвратВДокументПоступление = Ложь;
	КонецЕсли;
			
	//УФ в отдельное место, иначе станет нечитаемо
	Если ИмяКонфигурации1С = "УФ_УТ" 
		ИЛИ ИмяКонфигурации1С = "УФ_БП" 
		ИЛИ ИмяКонфигурации1С = "УФ_УНФ" 
		ИЛИ ИмяКонфигурации1С = "УФ_Розница" Тогда
		
		СоздатьВозвратУФ(Сообщение, НовыйДокумент, ЗагружатьВозвратВДокументПоступление);
		
	Иначе
		
		ТипЦен				= Неопределено;
		флУчитыватьНДС		= Истина;
		флСуммаВключаетНДС	= Истина;
		
		Если ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
			
			ТипЦен = ДоговорКонтрагента.ТипЦен;
			Если ЗначениеЗаполнено(ТипЦен) Тогда
				
				Если ПеременнаяСодержитСвойство(ТипЦен,"Рассчитывается") Тогда
					ЗначениеРассчитывается = ТипЦен.Рассчитывается;
				Иначе
					ЗначениеРассчитывается = Ложь;
				КонецЕсли;			
				
				Если ТипЗнч(ТипЦен) = Тип("СправочникСсылка.ТипыЦенНоменклатуры") И ЗначениеРассчитывается Тогда
					флСуммаВключаетНДС = ТипЦен.БазовыйТипЦен.ЦенаВключаетНДС;
				Иначе
					флСуммаВключаетНДС = ТипЦен.ЦенаВключаетНДС;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	
		НовыйДокумент.ТипЦен			= ТипЦен;
		НовыйДокумент.УчитыватьНДС		= флУчитыватьНДС;
		НовыйДокумент.СуммаВключаетНДС	= флСуммаВключаетНДС;
		
		
		Если ЕстьНеобходимыеМетаданные("Перечисления.ВидыПоступленияТоваров.ЗначенияПеречисления.НаСклад")
			И ЕстьНеобходимыеМетаданные("Документы." + ТипВозвратногоДокумента + ".Реквизиты.ВидПоступления") Тогда
			
			НовыйДокумент.ВидПоступления = Перечисления.ВидыПоступленияТоваров.НаСклад;
			
		КонецЕсли;
					
		НовыйДокумент.Дата = ТекущаяДата();
		
		Если ЗагружатьВозвратВДокументПоступление Тогда
			
			НовыйДокумент.НомерВходящегоДокумента	= Сообщение.ДокументEDI.Номер;
			НовыйДокумент.ДатаВходящегоДокумента	= Сообщение.ДокументEDI.Дата;
			
			Если ИмяКонфигурации1С = "УПП" Тогда
				Выполнить("НовыйДокумент.ВидОперации = Перечисления.ВидыОперацийПоступлениеТоваровУслуг.ПокупкаКомиссия;");	
			КонецЕсли;
		Иначе
			Если ЕстьНеобходимыеМетаданные("Перечисления.ВидыОперацийВозвратТоваровОтПокупателя.ЗначенияПеречисления.ПродажаКомиссия")
				И ЕстьНеобходимыеМетаданные("Документы." + ТипВозвратногоДокумента + ".Реквизиты.ВидОперации") Тогда
				
				НовыйДокумент.ВидОперации = Перечисления.ВидыОперацийВозвратТоваровОтПокупателя.ПродажаКомиссия;
				
			КонецЕсли;			
		КонецЕсли;
		
		Если Сообщение.ТипСообщения = "RETDES" Тогда
			НовыйДокумент.Организация	= Сообщение.Покупатель1С;
			НовыйДокумент.Контрагент	= Сообщение.Продавец1С;
		Иначе		
			НовыйДокумент.Организация	= Сообщение.Продавец1С;
			НовыйДокумент.Контрагент	= Сообщение.Покупатель1С;
		КонецЕсли;	
		
		НовыйДокумент.ДоговорКонтрагента = ДоговорКонтрагента;
		
		Если 	//ИмяКонфигурации1С = "УТ_10_2" ИЛИ  //в УТ 10.2 уже "СкладОрдер"
			ИмяКонфигурации1С = "БП" Тогда
			
			НовыйДокумент.Склад = ПолучитьКонстантуEDI("СоздаваемыйДокументСклад");
			Попытка
				Выполнить("НовыйДокумент.ЗаполнитьСчетаУчетаРасчетов();");
			Исключение
				ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось заполнить счета учета расчетов при возврате - " + ОписаниеОшибки());	
			КонецПопытки;
		Иначе
			
			НовыйДокумент.СкладОрдер = ПолучитьКонстантуEDI("СоздаваемыйДокументСклад");
			
			Если ЗначениеЗаполнено(Сообщение.Заказ1С) И				
				ЕстьНеобходимыеМетаданные("Документы." + ТипВозвратногоДокумента + ".Реквизиты.Сделка") Тогда
			
				НовыйДокумент.Сделка = Сообщение.Заказ1С;
					
			КонецЕсли;
			
		КонецЕсли;
		
		НовыйДокумент.ВалютаДокумента			= Сообщение.Валюта1С;
		НовыйДокумент.КурсВзаиморасчетов		= 1; 
		НовыйДокумент.КратностьВзаиморасчетов	= 1;
		
		Если Сообщение.ТипСообщения = "RETDES" 
			ИЛИ Сообщение.ТипСообщения = "RETANN" Тогда
			СторонаТранспорта = "Грузоотправитель";
		Иначе
			СторонаТранспорта = "Грузополучатель";
		КонецЕсли;		
		
		Если ЕстьНеобходимыеМетаданные("Документы." + ТипВозвратногоДокумента + ".Реквизиты." + СторонаТранспорта) Тогда

			СторонаТранспорта1С = Сообщение[СторонаТранспорта + "1С"];
			
			Если ЗначениеЗаполнено(СторонаТранспорта1С) Тогда
				
				ТочкаДоставкиСторонняя		= ПолучитьЭлементСправочника("ТочкиДоставкиСторонние", СторонаТранспорта1С);
				
				ГрузополучательИзЮрФизЛицаТД = ОпределитьЗначениеНастройкиГрузополучательИзЮрФизЛицаТД(Сообщение.Партнер);
				
				Если ГрузополучательИзЮрФизЛицаТД = Истина Тогда
					НовыйДокумент[СторонаТранспорта] = ТочкаДоставкиСторонняя.ЮрФизЛицо;
				Иначе
					Если ТочкаДоставкиСторонняя.ТочкаДоставкиСвойСправочник <> Неопределено Тогда
						НовыйДокумент[СторонаТранспорта] = ТочкаДоставкиСторонняя.ТочкаДоставкиСвойСправочник;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Кол = 0;
		
		НовыйДокумент.Товары.Очистить();
		
		//выясним, по всем ли позициям пришла цена
		//критерием будет являться отсутствие и ЦенаБезНДС и ценысндс
		ЦеныПроставлены=истина;
		СписокНоменклатурыБезЦен= новый СписокЗначений;
		
		Для Каждого Стр Из Сообщение.Товары Цикл
			Если Стр.ЦенаСНДС=0 и стр.ЦенаБезНДС=0 тогда
				ЦеныПроставлены=Ложь;
				СписокНоменклатурыБезЦен.Добавить(Стр.Номенклатура);
			КонецЕсли;
		КонецЦикла;
		ТабличкаЦен=Неопределено;
		Если Не ЦеныПроставлены и СписокНоменклатурыБезЦен.Количество()>0  Тогда
			Попытка
				ТипЦеныВДоговоре= Сообщение.Договор.ТипЦен;
				Если ЗначениеЗаполнено(ТипЦеныВДоговоре) Тогда 
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ЦеныНоменклатурыСрезПоследних.Номенклатура,
					|	ЦеныНоменклатурыСрезПоследних.Цена
					|ИЗ
					|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
					|			&Дата,
					|			ТипЦен = &ТипЦен
					|				И Номенклатура В (&СписокНоменклатуры)) КАК ЦеныНоменклатурыСрезПоследних";
					
					Запрос.УстановитьПараметр("СписокНоменклатуры", СписокНоменклатурыБезЦен);
					Запрос.УстановитьПараметр("ТипЦен", ТипЦеныВДоговоре);
					Если Сообщение.ТипСообщения = "RETDES" Тогда
						Запрос.УстановитьПараметр("Дата",?(ЗначениеЗаполнено(Сообщение.ДокументEDI.Дата),Сообщение.ДокументEDI.Дата,ТекущаяДата()));
					Иначе
						Запрос.УстановитьПараметр("Дата",?(ЗначениеЗаполнено(Сообщение.ДатаПоставки),Сообщение.ДатаПоставки,ТекущаяДата()));
					КонецЕсли;	
					
					Результат = Запрос.Выполнить();
					ТабличкаЦен	= Результат.Выгрузить();			
					
				КонецЕсли;
			Исключение
				ТабличкаЦен=Неопределено;
			КонецПопытки;
		КонецЕсли; //составили табличку цен
		
		ЕстьРеквизитЕдиницаИзмерения	= ЕстьРеквизитОбъекта_Контур(НовыйДокумент,"ЕдиницаИзмерения",	"Товары");
		ЕстьРеквизитКачество			= ЕстьРеквизитОбъекта_Контур(НовыйДокумент,"Качество",			"Товары");  
		
		ТипЕдиницыИзмерения 			= ПолучитьТипЗначенияОбъекта("ЕдиницаИзмерения",,Истина);   
		ЕстьКоэффициент 				= ЕстьРеквизитОбъекта_Контур(НовыйДокумент,"Коэффициент","Товары") И 
									  	  ЕстьНеобходимыеМетаданные("Справочники." +ТипЕдиницыИзмерения+ ".Реквизиты.Коэффициент");

		
		ИспользоватьВозвратнуюТару_УТ_10_3_КА = ИспользоватьВозвратнуюТару_УТ_10_3_КА(); 
		
		Для Каждого Стр Из Сообщение.Товары Цикл
			
			Если Стр.НеЗагружать = Истина Тогда
				Продолжить;
			КонецЕсли;
				
			Если ИспользоватьВозвратнуюТару_УТ_10_3_КА И Стр.ТипЕдиницы = "RC" Тогда
				НоваяСтрока = НовыйДокумент.ВозвратнаяТара.Добавить();
				НоваяСтрока.Номенклатура		= Стр.Номенклатура;
				НоваяСтрока.Количество			= Стр.Количество;
				НоваяСтрока.Цена				= Стр.ЦенаСНДС;
				НоваяСтрока.Сумма				= Стр.СуммаСНДС;
				Продолжить;
			КонецЕсли;
	
			НоваяСтрока = НовыйДокумент.Товары.Добавить();
			
			НоваяСтрока.Номенклатура		= Стр.Номенклатура;
			Если ЕстьРеквизитЕдиницаИзмерения Тогда
				НоваяСтрока.ЕдиницаИзмерения	= Стр.ЕдиницаИзмерения;
			КонецЕсли;
			
			Если НЕ ИмяКонфигурации1С = "БП" Тогда  
				Если ЕстьКоэффициент Тогда
					НоваяСтрока.Коэффициент			= Стр.ЕдиницаИзмерения.Коэффициент;
				КонецЕсли;	
				НоваяСтрока.ХарактеристикаНоменклатуры	= Стр.ХарактеристикаНоменклатуры;
			КонецЕсли;
			
			НоваяСтрока.Количество			= Стр.Количество;
			
			Если ЕстьРеквизитКачество Тогда
				НоваяСтрока.Качество			= Справочники.Качество.Новый;
			КонецЕсли;
			
			ЗаполнитьСтавкуНДСВСтрокеТовараДокумента(Стр, НоваяСтрока, НовыйДокумент.Дата);
			
			ЗаполнитьНедостающиеПоляСтрокиТоваров(Стр);

			Если НЕ ЗначениеЗаполнено(Стр.ЦенаСНДС) и не ЗначениеЗаполнено(Стр.ЦенаБезНДС) и ТабличкаЦен<>Неопределено Тогда  
				Попытка
					НайденнаяЦенаПоУмолч=ТабличкаЦен.Найти(Стр.Номенклатура,"Номенклатура");
					Если НайденнаяЦенаПоУмолч  <> Неопределено		 Тогда
						Если флСуммаВключаетНДС Тогда
							
							НоваяСтрока.Цена=НайденнаяЦенаПоУмолч.Цена;
							Стр.ЦенаСНДС=НайденнаяЦенаПоУмолч.Цена;
							Стр.СуммаСНДС=НайденнаяЦенаПоУмолч.Цена*Стр.Количество;
						иначе
							НоваяСтрока.Цена=НайденнаяЦенаПоУмолч.Цена;
							Стр.ЦенаБезНДС=НайденнаяЦенаПоУмолч.Цена;
							Стр.СуммаБезНДС=НайденнаяЦенаПоУмолч.Цена*Стр.Количество;
						КонецЕсли;
					КонецЕсли;
				Исключение
					//TODO - код выше вынести переделать на условия 
					ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось заполнить цены при возврате - " + ОписаниеОшибки());	
				КонецПопытки;
			КонецЕсли;
			
			Если флСуммаВключаетНДС Тогда
				
				Если Стр.ЦенаСНДС = 0 Тогда   
					Если Стр.Количество > 0 Тогда
						Если Стр.СуммаСНДС = 0 Тогда
							НоваяСтрока.Цена = (Стр.СуммаБезНДС+Стр.СуммаНДС)/Стр.Количество;
						Иначе
							НоваяСтрока.Цена = Стр.СуммаСНДС/Стр.Количество;
						КонецЕсли;
					КонецЕсли;
				Иначе
					НоваяСтрока.Цена = Стр.ЦенаСНДС;
				КонецЕсли;             
				
				Если Стр.СуммаСНДС = 0 Тогда
					Если Стр.СуммаБезНДС = 0 Тогда
						НоваяСтрока.Сумма = НоваяСтрока.Цена*НоваяСтрока.Количество;
					Иначе
						НоваяСтрока.Сумма = Стр.СуммаБезНДС+Стр.СуммаНДС;
					КонецЕсли;
				Иначе
					НоваяСтрока.Сумма = Стр.СуммаСНДС;
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(НоваяСтрока.Сумма) Тогда
					
					СтавкаНДС1С = Стр.СтавкаНДС1С;
					
					Если НЕ ЗначениеЗаполнено(СтавкаНДС1С) Тогда
						Если ЗначениеЗаполнено(Стр.Номенклатура) Тогда
							СтавкаНДС1С = Стр.Номенклатура.СтавкаНДС;
						КонецЕсли;
					КонецЕсли;
					
					Числом = Истина;
					СтавкаНДС = КонвертироватьСтавкуНДС_1СвEDI(СтавкаНДС1С, Числом); 
					
					НоваяСтрока.Цена = Стр.ЦенаБезНДС*(100+СтавкаНДС)/100;
					НоваяСтрока.Сумма = НоваяСтрока.Количество*НоваяСтрока.Цена;
					
				КонецЕсли;
				
			Иначе        
				
				Если Стр.ЦенаБезНДС = 0 Тогда   
					Если Стр.Количество > 0 Тогда
						Если Стр.СуммаБезНДС = 0 Тогда
							НоваяСтрока.Цена = (Стр.СуммаСНДС-Стр.СуммаНДС)/Стр.Количество;
						Иначе
							НоваяСтрока.Цена = Стр.СуммаБезНДС/Стр.Количество;
						КонецЕсли;
					КонецЕсли;
				Иначе
					НоваяСтрока.Цена = Стр.ЦенаБезНДС;
				КонецЕсли;             
				
				Если Стр.СуммаБезНДС = 0 Тогда
					Если Стр.СуммаСНДС = 0 Тогда
						НоваяСтрока.Сумма = НоваяСтрока.Цена*НоваяСтрока.Количество;
					Иначе
						НоваяСтрока.Сумма = Стр.СуммаСНДС-Стр.СуммаНДС;
					КонецЕсли;	
				Иначе
					НоваяСтрока.Сумма = Стр.СуммаБезНДС;
				КонецЕсли;      
				
			КонецЕсли;	
			
			ЗаполнитьСтавкуНДСВСтрокеТовараДокумента(Стр, НоваяСтрока, НовыйДокумент.Дата);

			Если Стр.СуммаНДС = 0 Тогда
				
				Попытка
					Выполнить("НоваяСтрока.СуммаНДС = УчетНДС.РассчитатьСуммуНДС(НоваяСтрока.Сумма,флУчитыватьНДС, флСуммаВключаетНДС, УчетНДС.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС));");
				Исключение
					Выполнить("НоваяСтрока.СуммаНДС = МодульТиповой_РассчитатьСуммуНДС(НоваяСтрока.Сумма,флУчитыватьНДС, флСуммаВключаетНДС, ПолучитьСтавкуНДС_КонтурEDI(НоваяСтрока.СтавкаНДС));");
				КонецПопытки;
				
			Иначе
				
				НоваяСтрока.СуммаНДС = Стр.СуммаНДС;
				
			КонецЕсли;
			
			// -) конец расчета с учетом НДС
			
		КонецЦикла;	
		
		Комментарий="";//В некоторых сообщениях может не быть комментария
		Сообщение.Свойство("Комментарий",Комментарий);
		НовыйДокумент.Комментарий = "Загружен из EDI"+?(СокрЛП(Комментарий)<>"",": "+Комментарий,"")+" Номер возврата сети: "+СокрЛП(Сообщение.ДокументEDI.Номер);
		
		НовыйДокумент.Ответственный = ПолучитьТекущегоПользователя1С();
		
		Если ИмяКонфигурации1С = "УТ_10_2" Тогда
			
			Попытка
				Выполнить("НовыйДокумент.ОтражатьВУправленческомУчете	= НЕ ПолучитьЗначениеПоУмолчанию(глТекущийПользователь, ""НеОтражатьДокументыВУправленческомУчете"");");
				Выполнить("НовыйДокумент.ОтражатьВБухгалтерскомУчете	= НЕ ПолучитьЗначениеПоУмолчанию(глТекущийПользователь, ""НеОтражатьДокументыВБухгалтерскомУчете"");");
				Выполнить("НовыйДокумент.ОтражатьВНалоговомУчете		= НЕ ПолучитьЗначениеПоУмолчанию(глТекущийПользователь, ""НеОтражатьДокументыВНалоговомУчете"");");
			Исключение
				ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось установить признаки отражения в учете при загрузке документа возврата - " + ОписаниеОшибки());	
			КонецПопытки;
			
		ИначеЕсли ИмяКонфигурации1С = "БП" Тогда
			
			ОтражатьВНалоговомУчете = Истина;
			Если ЕстьРеквизитОбъекта_Контур(НовыйДокумент, "ОтражатьВНалоговомУчете") Тогда
				// для БП 1.6
				Попытка // для БП 1.6
					Выполнить("НовыйДокумент.ОтражатьВНалоговомУчете		= НЕ УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(глЗначениеПеременной(""глТекущийПользователь""), ""НеОтражатьДокументыВНалоговомУчете"");");
					ОтражатьВНалоговомУчете = НовыйДокумент.ОтражатьВНалоговомУчете;
				Исключение
					ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось определить признак отражения в НУ при возврате - " + ОписаниеОшибки());	
				КонецПопытки;
			КонецЕсли;
			
			ЗаполнилиСчета = Истина;
			Попытка
				//заполнение счетов учета таб части
				Для каждого СтрокаТоваров из НовыйДокумент.ТОвары Цикл
					НовыйДокумент.ЗаполнитьСчетаУчетаВСтрокеТабЧастиРегл(СтрокаТоваров, "Товары", истина, ОтражатьВНалоговомУчете);
				КонецЦикла;
			Исключение
				ЗаполнилиСчета = Ложь;
			КонецПопытки;
			
			Если НЕ ЗаполнилиСчета Тогда
				Для каждого СтрокаТоваров из НовыйДокумент.ТОвары Цикл
					НовыйДокумент.ЗаполнитьСчетаУчетаВСтрокеТабЧастиРегл(СтрокаТоваров, "Товары", истина);
				КонецЦикла;
			КонецЕсли;
			
		Иначе
			
			Попытка
				
				Выполнить("НовыйДокумент.ОтражатьВУправленческомУчете	= УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(глЗначениеПеременной(""глТекущийПользователь""), ""ОтражатьДокументыВУправленческомУчете"");");
				Выполнить("НовыйДокумент.ОтражатьВБухгалтерскомУчете	= УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(глЗначениеПеременной(""глТекущийПользователь""), ""ОтражатьДокументыВБухгалтерскомУчете"");");
				Выполнить("НовыйДокумент.ОтражатьВНалоговомУчете		= УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(глЗначениеПеременной(""глТекущийПользователь""), ""ОтражатьДокументыВНалоговомУчете"");");
				
			Исключение
				ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось установить признаки отражения в учете при загрузке документа возврата - " + ОписаниеОшибки());	
			КонецПопытки;
			
		КонецЕсли;
	КонецЕсли;
	
	УстановитьПризнакОбменДаннымиВДокументе_КонтурEDI(НовыйДокумент);
	
	ОбработкаСобытияПодключаемогоМодуля("ПриЗагрузкеВходящегоСообщения",,Новый Структура("Сообщение,ДокументСсылка",Сообщение,НовыйДокумент));
	
	НовыйДокумент.Записать();
	
	СсылкаНаДокумент = НовыйДокумент.Ссылка;
	
	Возврат СсылкаНаДокумент;
	
КонецФункции

Процедура ОчиститьТабличныеЧастиОбъекта_КонтурEDI(Объект, МассивИменТабЧастей) 
	
	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КоллекцияОбъектовМетаданных = Объект.Метаданные().ТабличныеЧасти;
	
	Для каждого ИмяТабЧасти Из МассивИменТабЧастей Цикл
	
		Если НЕ КоллекцияОбъектовМетаданных.Найти(ИмяТабЧасти) = Неопределено Тогда
			Объект[ИмяТабЧасти].Очистить();		
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры 

// функция используется для определения необходимости создания документа корректировки
// вместо документа возврата при загрузке сообщений RETANN, RETDES
//
// Возвращаемое значение:
//		Булево - признак необходимости создания документа корректировки вместо документа возврата
//
Функция НужноСоздатьКорректировкуИзВозврата(Сообщение) Экспорт
	
	Результат = Ложь;
	
	Если (Сообщение.ТипСообщения = "RETANN" ИЛИ Сообщение.ТипСообщения = "RETDES")
		И ЕстьКоррИспрСФ // глобальная переменная
		И ЗначениеЗаполнено(Сообщение.НакладнаяEDI.Номер) Тогда
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// функция необходима для определения типа документа для связывания его через форму сообщения
//
// Возвращаемое значение:
//		Строка - имя типа документа 1С, например, КорректировкаРеализации
//
Функция ОпределитьИмяТипаДокумента(ДокументСсылка, Сообщение) Экспорт
	
	Если НужноСоздатьКорректировкуИзВозврата(Сообщение) Тогда
		
		ВернутьИмяВМетаданных = Истина;
		ТипДокумента = ПолучитьТипЗначенияОбъекта("ИсходящийКСФ", , ВернутьИмяВМетаданных);
	
	Иначе
		
		ТипДокумента = ДокументСсылка.Метаданные().Имя;
	
	КонецЕсли;

	Возврат ТипДокумента;	

КонецФункции

Процедура ПоменятьКодТовараПокупателяСКодомТовараПоставщика(СтрокаТовара)
	
	КодТовараПоставщика = СтрокаТовара.КодТовараПоставщика;
	
	СтрокаТовара.КодТовараПоставщика = СтрокаТовара.КодТовараПокупателя;
	СтрокаТовара.КодТовараПокупателя = КодТовараПоставщика;
	
КонецПроцедуры

Функция ПринятьВозвратТоваровВКорректировкуРеализации(Сообщение, ПервоначальнаяЗагрузкаСообщения)
	
	ВернутьИмяВМетаданных = Истина;
	ТипКСФ = ПолучитьТипЗначенияОбъекта("ИсходящийКСФ", , ВернутьИмяВМетаданных);
	
	Если НЕ ПервоначальнаяЗагрузкаСообщения
		И ЗначениеЗаполнено(Сообщение.ДокументСсылка) Тогда
		
		ДокументКорректировки = Сообщение.ДокументСсылка.ПолучитьОбъект();
		
	Иначе
		
		ДокументКорректировки = Документы[ТипКСФ].СоздатьДокумент();
		
	КонецЕсли;
	
	СтандартнаяОбработкаEDI = Истина;
	ПараметрыПМ = Новый Структура("Сообщение, ДокументОбъект", Сообщение, ДокументКорректировки);
	
	ОбработкаСобытияПодключаемогоМодуля("ЗаполнитьКорректировкуПоВходящемуRETANN", СтандартнаяОбработкаEDI, ПараметрыПМ);
		
	Если СтандартнаяОбработкаEDI = Ложь Тогда
		
		ДокументКорректировки.Записать();
		Возврат ДокументКорректировки.Ссылка;
		
	КонецЕсли;
	
	Если ДокументКорректировки.Проведен Тогда
		
		Если ИмяКонфигурации1С = "УФ_УТ" 
			И НЕ ПервоначальнаяЗагрузкаСообщения Тогда
	        ДокументКорректировки.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЕсли;

		РежимЗаписиДокумент = РежимЗаписиДокумента.Проведение;
	Иначе
		РежимЗаписиДокумент = РежимЗаписиДокумента.Запись;
	КонецЕсли;
		
	Если НЕ ПервоначальнаяЗагрузкаСообщения Тогда
		
		МассивИменТабЧастей = Новый Массив;
		МассивИменТабЧастей.Добавить("Товары");
		МассивИменТабЧастей.Добавить("Услуги");
		МассивИменТабЧастей.Добавить("Запасы");
		МассивИменТабЧастей.Добавить("Расхождения");
		
		ОчиститьТабличныеЧастиОбъекта_КонтурEDI(ДокументКорректировки, МассивИменТабЧастей);
		
	КонецЕсли;
	
	Если ИмяКонфигурации1С = "УФ_УТ" Тогда
		
		ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.КорректировкаПоСогласованиюСторон;
		
		Если ПеременнаяСодержитСвойство(ДокументКорректировки, "ВидКорректировки") Тогда
			ДокументКорректировки.ВидКорректировки = ХозяйственнаяОперация;	
		ИначеЕсли ПеременнаяСодержитСвойство(ДокументКорректировки, "ХозяйственнаяОперация") Тогда
			ДокументКорректировки.ХозяйственнаяОперация = ХозяйственнаяОперация;	
		КонецЕсли;
		
	Иначе
		
		ДокументКорректировки.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение;
		
	КонецЕсли;
	
	ЗаполнитьДокументКорректировкиСУчетомПредыдущихКорректировок(ДокументКорректировки, Сообщение.Накладная1С);
		
	ДокументКорректировки.Дата = ТекущаяДата();
	ДокументКорректировки.Записать(РежимЗаписиДокумент);
	
	ШаблонCOINVOIC = ПолучитьСтруктуруСообщения("COINVOIC", "Исходящее");
	ШаблонCOINVOIC.Вставить("Партнер", Сообщение.Партнер);
	
	ПреобразоватьТовары = Истина;
	ИсточникПодготовки = "ПодготовкаКорректировочногоСчетаФактурыКОтправке";
	ТоварыCOINVOIC = ПолучитьТоварыДокументаДляСообщения(ДокументКорректировки.Ссылка, ПреобразоватьТовары, ИсточникПодготовки, , ШаблонCOINVOIC);
	ПересчитатьТоварыСообщения(ТоварыCOINVOIC, Сообщение.Партнер, "В1С", ШаблонCOINVOIC);
	
	ТаблицаТоваровВозврата = Сообщение.Товары.Скопировать();
	
	Если ЭтоОбратнаяОтгрузка(Сообщение.ТипСообщения) Тогда
		Для каждого Стр Из ТаблицаТоваровВозврата Цикл
		
			ПоменятьКодТовараПокупателяСКодомТовараПоставщика(Стр);	
		
		КонецЦикла;	
	КонецЕсли;
		
	СтруктураТаблицы1 = ПолучитьСтруктуруТаблицТоваровДляСравнения("Сообщение", "COINVOIC", ТоварыCOINVOIC);
	СтруктураТаблицы2 = ПолучитьСтруктуруТаблицТоваровДляСравнения("Сообщение", Сообщение.ТипСообщения, ТаблицаТоваровВозврата);
	
	СравниваемыеПоля = Новый СписокЗначений;
	СравниваемыеПоля.Добавить("Количество");
	РассчитыватьНДС = Ложь;
	ПропускатьНулевыеЗначения = Ложь;
	
	РезультатСравнения = СравнитьТаблицыТоваров(СтруктураТаблицы1, СтруктураТаблицы2, СравниваемыеПоля, РассчитыватьНДС, ПропускатьНулевыеЗначения, ШаблонCOINVOIC, Сообщение);

	ЗаполнитьТоварыДокумента_КорректировкаРеализации_ПоВозврату(ДокументКорректировки, РезультатСравнения.ТаблицаСравнения);
	
	Если ИмяКонфигурации1С = "УФ_УТ" Тогда
		
		Попытка
			Документы.КорректировкаРеализации.ЗаполнитьРасхождения(ДокументКорректировки);
		Исключение
			ДокументКорректировки.ЗаполнитьРасхождения();
		КонецПопытки;
		
		Попытка
			ДокументКорректировки.СтатьяРасходов = ПланыВидовХарактеристик.СтатьиРасходов.РазницыСтоимостиВозвратаИФактическойСтоимостиТоваров;
		Исключение
			ДокументКорректировки.СтатьяРасходов = ПланыВидовХарактеристик.СтатьиРасходов.СебестоимостьПродаж;
		КонецПопытки;
		
		Для каждого СтрокаРасхождений из ДокументКорректировки.Расхождения Цикл
			Если СтрокаРасхождений.Количество < 0 Тогда
				СтрокаРасхождений.ВариантОтражения = Перечисления.ВариантыОтраженияКорректировокРеализаций.УменьшитьРеализациюУвеличитьСкладскиеОстатки;
			ИначеЕсли СтрокаРасхождений.Количество > 0 Тогда
				СтрокаРасхождений.ВариантОтражения = Перечисления.ВариантыОтраженияКорректировокРеализаций.УвеличитьРеализациюУменьшитьСкладскиеОстатки;
			ИначеЕсли Не ЗначениеЗаполнено(СтрокаРасхождений.ВариантОтражения) Тогда
				СтрокаРасхождений.ВариантОтражения = Перечисления.ВариантыОтраженияКорректировокРеализаций.СписатьНаРасходы;
			КонецЕсли;	
		КонецЦикла;
		
		ДокументКорректировки.АналитикаРасходов = ДокументКорректировки.Партнер;
		
	КонецЕсли;
	
	УстановитьПризнакОбменДаннымиВДокументе_КонтурEDI(ДокументКорректировки);
	
	ДокументКорректировки.Записать(РежимЗаписиДокумент);
	
	Возврат ДокументКорректировки.Ссылка
	
КонецФункции

Процедура ЗаполнитьДокументКорректировкиСУчетомПредыдущихКорректировок(ДокументКорректировки, ДокументРеализации)
	
	Если ИмяКонфигурации1С = "УФ_УТ" Тогда
		
		ДокументКорректировки.Заполнить(ДокументРеализации);
		Возврат;
		
	КонецЕсли;
		
	ПредыдущаяКорректировка = ПолучитьПоследнююКорректировкуРеализации(ДокументРеализации);
	
	Если НЕ ЗначениеЗаполнено(ПредыдущаяКорректировка) Тогда
		
		ДокументКорректировки.Заполнить(ДокументРеализации);
		Возврат;
		
	КонецЕсли;
	
	Если ДокументКорректировки.Ссылка = ПредыдущаяКорректировка.Ссылка Тогда
		// перезаполняем документ по сообщению
		ПредыдущаяКорректировка = ПолучитьРеквизитДокументаДляСообщения(ДокументКорректировки, "ДокументОснованиеКорректировки");
	КонецЕсли;
		
	Попытка
		ДокументКорректировки.Заполнить(ПредыдущаяКорректировка);
	Исключение
		
		ОписаниеОшибки = ОписаниеОшибки();
		Если Найти(ОписаниеОшибки, "Нельзя вводить документ на согласованную корректировку на основании другой согласованной корректировки") <> 0 Тогда
			
			// на старых релизах УТ 10.3 нельзя было вводить Корректировку по согласованию на основании согласованной корректировки
			// и можно вводить Корректировку по согласованию на основании исправления
			
			КорректировкаСИсправлением = НайтиПредыдущуюКорректировкуСИсправлением(ПредыдущаяКорректировка);
			Если ЗначениеЗаполнено(КорректировкаСИсправлением) Тогда
				ДокументОснованиеКорректировки = КорректировкаСИсправлением;
			Иначе
				ДокументОснованиеКорректировки = ДокументРеализации;
			КонецЕсли;	
			
			ДокументКорректировки.Заполнить(ДокументОснованиеКорректировки);
			ЗаполнитьКоличествоПослеКорректировкиСУчетомПоследнейКорректировки(ДокументКорректировки, ПредыдущаяКорректировка);
			
		Иначе
			ВызватьИсключение ОписаниеОшибки; 	
		КонецЕсли;
		
	КонецПопытки;
	
КонецПроцедуры

Функция НайтиПредыдущуюКорректировкуСИсправлением(ДокументКорректировки)
	
	ДокументОснование = ПолучитьРеквизитДокументаДляСообщения(ДокументКорректировки, "ДокументОснованиеКорректировки");
	ТипИсходящийКСФ = ПолучитьТипЗначенияОбъекта("ИсходящийКСФ");	
	ТипИсходящееУведомлениеОбОтгрузке = ПолучитьТипЗначенияОбъекта("ИсходящееУведомлениеОбОтгрузке");
	
	Если ЗначениеЗаполнено(ТипИсходящийКСФ) И ТипЗнч(ДокументОснование) = Тип(ТипИсходящийКСФ)
		И КорректировкаРеализацииСФункциейИсправления(ДокументОснование) = Истина Тогда
		
		Возврат ДокументОснование;
		
	ИначеЕсли ЗначениеЗаполнено(ТипИсходящееУведомлениеОбОтгрузке) 
		И ТипЗнч(ДокументОснование) = Тип(ТипИсходящееУведомлениеОбОтгрузке) Тогда
		
		Возврат Неопределено;
		
	Иначе
		
		ДокументОснование = НайтиПредыдущуюКорректировкуСИсправлением(ДокументКорректировки);
		
	КонецЕсли;
	
	Возврат ДокументОснование;
	
КонецФункции

Процедура ЗаполнитьКоличествоПослеКорректировкиСУчетомПоследнейКорректировки(КорректировкаРеализацииОбъект, ПредыдущаяКорректировка)
		
	ТаблицыДокумента = ТаблицыДокумента_КонтурEDI(КорректировкаРеализацииОбъект); 
	
	флСуммаВключаетНДС = ПолучитьРеквизитДокументаДляСообщения(ПредыдущаяКорректировка, "СуммаВключаетНДС");

	ИмяТабЧасти = "Товары";
	
	Для каждого Строка Из КорректировкаРеализацииОбъект[ИмяТабЧасти] Цикл
		
		РезультатПоискаСтроки =	
		ПоискСтрокиВДокументе_КонтурEDI(Строка, ТаблицыДокумента, флСуммаВключаетНДС);
		
		СтрокаДоКорректировки = РезультатПоискаСтроки.НайденнаяСтрока;
				
		Если СтрокаДоКорректировки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Строка.Количество = СтрокаДоКорректировки.Количество;
	    ПересчитатьСтрокуДокумента_КорректировкаРеализации(Строка, КорректировкаРеализацииОбъект, флСуммаВключаетНДС);
		
	КонецЦикла;
		
КонецПроцедуры

Функция ПолучитьТекстЗапросаКорректировокДокументаРеализации()
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	КорректировкаРеализации.Ссылка КАК Корректировка,
	|	КорректировкаРеализации.Дата КАК ДатаКорректировки
	|ИЗ
	|	Документ.КорректировкаРеализации КАК КорректировкаРеализации
	|ГДЕ
	|	КорректировкаРеализации.ДокументРеализации = &Ссылка
	|	И НЕ КорректировкаРеализации.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаКорректировки УБЫВ";
	
	ВернутьИмяВМетаданных = Истина;
	ТипКСФ = ПолучитьТипЗначенияОбъекта("ИсходящийКСФ", , ВернутьИмяВМетаданных); 
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.КорректировкаРеализации", "Документ." + ТипКСФ);
	
	Если НЕ ЕстьНеобходимыеМетаданные("Документы." + ТипКСФ + ".Реквизиты.ДокументРеализации") Тогда
		
		Если ЕстьНеобходимыеМетаданные("Документы." + ТипКСФ + ".Реквизиты.ДокументОснование") Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "КорректировкаРеализации.ДокументРеализации", "КорректировкаРеализации.ДокументОснование");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПолучитьВыборкуКорректировокДокументаРеализации(ДокументРеализации)
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаКорректировокДокументаРеализации();
	
	Запрос.УстановитьПараметр("Ссылка", ДокументРеализации);
	
	ВыборкаПредыдущихКорректировок = Запрос.Выполнить().Выбрать();
	
	Возврат ВыборкаПредыдущихКорректировок;
	
КонецФункции

Функция ПолучитьПоследнююКорректировкуРеализации(ДокументРеализации)
	
	Выборка = ПолучитьВыборкуКорректировокДокументаРеализации(ДокументРеализации);
	
	Если Выборка.Следующий() Тогда
		
		ТекущаяКорректировка = Выборка.Корректировка;
		СледующаяКорректировка = ПолучитьПоследнююКорректировкуРеализации(ТекущаяКорректировка);
		
		Если СледующаяКорректировка = Неопределено Тогда
			Возврат ТекущаяКорректировка;
		КонецЕсли;
		
		Возврат СледующаяКорректировка;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ЗаполнитьТоварыДокумента_КорректировкаРеализации_ПоВозврату(ДокументКорректировки, ТаблицаСравнения) Экспорт
	
	флСуммаВключаетНДС = ПолучитьРеквизитДокументаДляСообщения(ДокументКорректировки, "СуммаВключаетНДС");
	
	ТаблицыДокумента = ТаблицыДокумента_КонтурEDI(ДокументКорректировки);
	
	МассивДляУдаленияСтрок = Новый Массив;
	
	Для каждого Строка Из ТаблицаСравнения Цикл
		
		РезультатПоискаСтроки =	
		ПоискСтрокиВДокументе_КонтурEDI(Строка, ТаблицыДокумента, флСуммаВключаетНДС);
		
		НайденнаяСтрока = РезультатПоискаСтроки.НайденнаяСтрока;
	 		
		Если НайденнаяСтрока = Неопределено Тогда
			// возврат товара, которого не было в прямой поставке
			// по накладной уже оформлена корректировка на возврат и товар был скорректирован ранее?
			Продолжить;
			
		КонецЕсли;
		
		ИмяПоляКоличество = ?(ИмяКонфигурации1С = "УФ_УТ", "КоличествоУпаковок", "Количество");
		
		КоличествоДоКорректировки = НайденнаяСтрока[ИмяПоляКоличество];
		КоличествоПослеКорректировки = Макс(Строка.Количество1 - Строка.Количество2, 0);
		
		Если КоличествоДоКорректировки = КоличествоПослеКорректировки Тогда
			Продолжить;
		КонецЕсли;
		
		Если КоличествоПослеКорректировки = 0 
			И ИмяКонфигурации1С = "УФ_УТ" Тогда
			
			МассивДляУдаленияСтрок.Добавить(НайденнаяСтрока);
						
		ИначеЕсли НЕ КоличествоДоКорректировки = КоличествоПослеКорректировки Тогда
			
			НайденнаяСтрока[ИмяПоляКоличество] = КоличествоПослеКорректировки; 
	    	ПересчитатьСтрокуДокумента_КорректировкаРеализации(НайденнаяСтрока, ДокументКорректировки, флСуммаВключаетНДС);
			
		Иначе
			
			ВызватьИсключение("Данный сценарий заполнения товаров документа КорректировкаРеализации по сообщению возврата не реализован. Обратитесь в техническую поддержку.");
			
		КонецЕсли;
	
	КонецЦикла;
	
	Если ИмяКонфигурации1С = "УФ_УТ" Тогда
		
		Для Каждого СтрокаДляУдаления Из МассивДляУдаленияСтрок Цикл
			
			ДокументКорректировки.Товары.Удалить(СтрокаДляУдаления);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПересчитатьСтрокуДокумента_КорректировкаРеализации(НайденнаяСтрока, ДокументКорректировки, флСуммаВключаетНДС) Экспорт
	
	// TODO нужен рефакторинг с учетом ПересчитатьСтрокуДокумента	
	Если ИмяКонфигурации1С = "УФ_УТ" Тогда
		
		Если НЕ ЗначениеЗаполнено(НайденнаяСтрока.Упаковка) Тогда
			
			НайденнаяСтрока.Количество	= НайденнаяСтрока.КоличествоУпаковок;
			
		Иначе
			Если ОпределитьРелизКонфигурации() = "11.2" Тогда
				СтруктураДействий = Новый Структура;
				СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
				ОбработкаТабличнойЧастиСервер_ОбработатьСтрокуТЧ(НайденнаяСтрока, СтруктураДействий, Неопределено);
			Иначе
				НайденнаяСтрока.Количество = НайденнаяСтрока.КоличествоУпаковок * ПолучитьКоэффициентУпаковкиУФ_УТ(НайденнаяСтрока.Упаковка); //в упаковках
			КонецЕсли;
		КонецЕсли;

		СтруктураПересчетов = Новый Структура;
		СтруктураПересчетов.Вставить("ПересчитатьСумму","КоличествоУпаковок");
		СтруктураПересчетов.Вставить("ПересчитатьСуммуНДС", Новый Структура ("ЦенаВключаетНДС", флСуммаВключаетНДС));
		СтруктураПересчетов.Вставить("ПересчитатьСуммуСНДС", Новый Структура ("ЦенаВключаетНДС", флСуммаВключаетНДС));
	
		ОбработкаТабличнойЧастиСервер_ОбработатьСтрокуТЧ(НайденнаяСтрока, СтруктураПересчетов, Неопределено);
		
	ИначеЕсли ИмяКонфигурации1С = "УФ_БП" Тогда
		
		НайденнаяСтрока.Сумма = НайденнаяСтрока.Цена * НайденнаяСтрока.Количество;
		Выполнить("НайденнаяСтрока.СуммаНДС = УчетНДСКлиентСервер.РассчитатьСуммуНДС(НайденнаяСтрока.Сумма, флСуммаВключаетНДС, УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(НайденнаяСтрока.СтавкаНДС))");
		
	ИначеЕсли ИмяКонфигурации1С = "УФ_УНФ" Тогда
		
		СтавкаНДС = Неопределено;
		Выполнить("СтавкаНДС = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеСтавкиНДС(НайденнаяСтрока.СтавкаНДС)");
		
		НайденнаяСтрока.Сумма 		= НайденнаяСтрока.Цена * НайденнаяСтрока.Количество;
		НайденнаяСтрока.СуммаНДС 	= ?(флСуммаВключаетНДС, 
										НайденнаяСтрока.Сумма - (НайденнаяСтрока.Сумма) / ((СтавкаНДС + 100) / 100),
										НайденнаяСтрока.Сумма * СтавкаНДС / 100);
		
		НайденнаяСтрока.Всего 		= НайденнаяСтрока.Сумма + ?(флСуммаВключаетНДС, 0, НайденнаяСтрока.СуммаНДС);

	КонецЕсли;
	
	ПересчитатьСтрокуДокумента(НайденнаяСтрока, ДокументКорректировки);
	
КонецПроцедуры

Процедура СоздатьВозвратУФ(Сообщение, Док, ЗагружатьВозвратВДокументПоступление)
	
	ИспользуютсяХарактеристики = НастройкиМодуля.ИспользоватьХарактеристикиНоменклатуры;
	
	Партнер = Сообщение.Партнер;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ИмяКонфигурации1С = "УФ_БП" Тогда
		
		Если ЗагружатьВозвратВДокументПоступление Тогда
			Док.ВидОперации					= Перечисления.ВидыОперацийПоступлениеТоваровУслуг.ПокупкаКомиссия;
		Иначе
			
			Если ЕстьНеобходимыеМетаданные("Перечисления.ВидыОперацийВозвратТоваровОтПокупателя.ЗначенияПеречисления.ПродажаКомиссия") Тогда
				
				Док.ВидОперации = Перечисления.ВидыОперацийВозвратТоваровОтПокупателя.ПродажаКомиссия;
								
			КонецЕсли;
			
			Док.ДеятельностьНаПатенте = Ложь;
		
		КонецЕсли;
	
		Док.Склад						= ПолучитьКонстантуEDI("СоздаваемыйДокументСклад");
		Док.ВалютаДокумента				= ВалютаУчета_КонтурEDI();
		Док.СуммаВключаетНДС			= Истина;
		
		Попытка
			// заполним данные по умолчанию
			ДанныеЗаполненияДок = Новый Структура("ВидОперации", Док.ВидОперации);
			Выполнить("ЗаполнениеДокументов.Заполнить(Док, ДанныеЗаполненияДок, Истина);");
			
			Если НЕ ЗагружатьВозвратВДокументПоступление Тогда
				Док.ПокупателемВыставляетсяСчетФактураНаВозврат = Истина;
				Док.ОтразитьВКнигеПокупок = Истина;
				Док.УстановитьРеквизитыУчетаНДС();
			КонецЕсли;
			
		Исключение
			ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось заполнить данные по умолчанию при загрузке возврата - " + ОписаниеОшибки());	
		КонецПопытки;
	КонецЕсли;
	
	Если ИмяКонфигурации1С = "УФ_УНФ" Тогда 
		Док.ВидОперации = Перечисления.ВидыОперацийПриходнаяНакладная.ВозвратОтПокупателя;
	КонецЕсли;
	
	Если НЕ ((ИмяКонфигурации1С = "УФ_БП" ИЛИ ИмяКонфигурации1С = "УФ_Розница")
		И НЕ ЗагружатьВозвратВДокументПоступление) Тогда
		Док.НомерВходящегоДокумента		= Сообщение.ДокументEDI.Номер;
		Док.ДатаВходящегоДокумента		= Сообщение.ДокументEDI.Дата;
	КонецЕсли;
	
	Док.Дата = Сообщение.ДокументEDI.Дата;
	
	Если ИмяКонфигурации1С = "УФ_БП" 
		ИЛИ ИмяКонфигурации1С = "УФ_УНФ" 
		ИЛИ ИмяКонфигурации1С = "УФ_Розница" Тогда
		Док.Ответственный	= ПолучитьТекущегоПользователя1С();
	Иначе
		Док.Менеджер		= ПолучитьТекущегоПользователя1С();
	КонецЕсли;	
	
	Если ИмяКонфигурации1С = "УФ_УТ" И ЗначениеЗаполнено(Док.Менеджер) Тогда
		Если ЕстьРеквизитОбъекта_Контур(Док, "Подразделение") И ЕстьРеквизитОбъекта_Контур(Док.Менеджер, "ТекущееПодразделение") Тогда 
			Док.Подразделение	= Док.Менеджер.ТекущееПодразделение;		
		КонецЕсли;
	КонецЕсли;
	
	Если Сообщение.ТипСообщения = "RETDES" Тогда
		Док.Организация		= Сообщение.Покупатель1С;
		ЮрФизЛицоСтороннее	= Сообщение.Продавец1С;
		Док.Контрагент		= ЮрФизЛицоСтороннее; 
	Иначе
		Док.Организация		= Сообщение.Продавец1С;
		ЮрФизЛицоСтороннее  = Сообщение.Покупатель1С;
		Док.Контрагент		= ЮрФизЛицоСтороннее; 
	КонецЕсли;
	
	Если Сообщение.ТипСообщения = "RETDES"
		ИЛИ Сообщение.ТипСообщения = "RETANN" Тогда
		Грузополучатель 	= Сообщение.Грузоотправитель1С;
	Иначе
		Грузополучатель		= Сообщение.Грузополучатель1С;
	КонецЕсли;
	
	Если ИмяКонфигурации1С = "УФ_УТ" Тогда
		
		Валюта	= ВалютаУчета_КонтурEDI();
		Док.Валюта = Валюта;
		
		Если ПеременнаяСодержитСвойство(Док, "ВалютаВзаиморасчетов") Тогда 
			Док.ВалютаВзаиморасчетов = Валюта;			
		КонецЕсли;
		
		Док.Склад 	= ПолучитьКонстантуEDI("СоздаваемыйДокументСклад");
		
		// Посмотрим на значение функц. опции раздельного учета Партнеров и контрагентов
		Если УТ11_1_Константа_ИспользоватьПартнеровИКонтрагентов() 
			И СокрЛП(ПолучитьКонстантуEDI("СвойСправочникТочекДоставки")) <> "" Тогда
 
			// использованы магазины-партнеры(клиенты). Правильный учет по рекомендациям 1С.
			Док.Партнер	= Грузополучатель.СвязанныйСправочник2;
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Док.Партнер) Тогда
			Док.Партнер	= Док.Контрагент.Партнер;
		КонецЕсли;
		
		Если ЗагружатьВозвратВДокументПоступление Тогда
			Док.ЗаполнитьУсловияЗакупокПоУмолчанию();
		Иначе
			Док.ЗаполнитьУсловияПродажПоУмолчанию();
		КонецЕсли;
	
		Если ЗначениеЗаполнено(Док.Соглашение) Тогда
			Если ЗагружатьВозвратВДокументПоступление Тогда
				Попытка
					Док.ЗаполнитьУсловияЗакупокПоСоглашению();
				Исключение
					Док.ЗаполнитьУсловияЗакупокПоCоглашению(); // англ.буква C встречается в старых релизах
				КонецПопытки;
			Иначе
				Попытка
					Док.ЗаполнитьУсловияПродажПоСоглашению();
				Исключение
					Док.ЗаполнитьУсловияПродажПоCоглашению();//ВызватьИсключение "В этом релизе УТ11.1 присутствует ошибка именования процедуры ЗаполнитьУсловияПродажПоCоглашению (Буква С - латиницей)";
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
		КурсВалютыВзаиморасчетов = 1;
		
		Если ЕстьРеквизитОбъекта_Контур(Док, "ВариантПриемкиТоваров") Тогда
			Попытка
				Если НЕ ЗагружатьВозвратВДокументПоступление Тогда
					Выполнить("Док.ВариантПриемкиТоваров = Константы.ВариантПриемкиТоваров.Получить()");
				Иначе
					Выполнить("Док.ВариантПриемкиТоваров = ЗакупкиСервер.ПолучитьВариантПриемкиТоваров(Неопределено, Док.Договор)");
				КонецЕсли;				
			Исключение
				ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось определить вариант приемки при возврате - " + ОписаниеОшибки());	
			КонецПопытки;
		КонецЕсли;
			
	ИначеЕсли ИмяКонфигурации1С = "УФ_БП" Тогда
		
		СписокВидовДоговоров = Новый Массив;
		Если ЗагружатьВозвратВДокументПоступление Тогда
			Выполнить("СписокВидовДоговоров.Добавить(ПредопределенноеЗначение(""Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком""))");//в 8.1 нет такого метода
		Иначе
			Выполнить("СписокВидовДоговоров.Добавить(ПредопределенноеЗначение(""Перечисление.ВидыДоговоровКонтрагентов.СПокупателем""))");//в 8.1 нет такого метода
		КонецЕсли;
			
		Попытка //реорганизация в типовой БП30
			Выполнить("РаботаСДоговорамиКонтрагентовБП.УстановитьДоговорКонтрагента(Док.ДоговорКонтрагента, Док.Контрагент, Док.Организация,СписокВидовДоговоров);");
		исключение
			Выполнить("БухгалтерскийУчетПереопределяемый.УстановитьДоговорКонтрагента(Док.ДоговорКонтрагента, Док.Контрагент, Док.Организация,СписокВидовДоговоров);");
		КонецПопытки;
		
		РеквизитыДоговора = неопределено;
		
		Выполнить("РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Док.ДоговорКонтрагента, ""Владелец,ТипЦен,ВидДоговора"")");
		
		СтруктураКурсаДокумента=неопределено;
		Выполнить("СтруктураКурсаДокумента     = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Док.ВалютаДокумента, ТекущаяДата())");
		Док.КурсВзаиморасчетов      = СтруктураКурсаДокумента.Курс;
		Док.КратностьВзаиморасчетов = СтруктураКурсаДокумента.Кратность;
		
		Если ЗначениеЗаполнено(РеквизитыДоговора.ТипЦен) Тогда
			Док.ТипЦен           = РеквизитыДоговора.ТипЦен;
			Док.СуммаВключаетНДС = РеквизитыДоговора.ТипЦен.ЦенаВключаетНДС;
		КонецЕсли;
		
	ИначеЕсли  ИмяКонфигурации1С = "УФ_УНФ" Тогда
		
		Если Не Док.Контрагент.ВестиРасчетыПоДоговорам Тогда
			Док.Договор = Док.Контрагент.ДоговорПоУмолчанию;
		Иначе
			МенеджерСправочника = Неопределено;
			СписокВидовДоговоров = Неопределено;
			ДоговорПоУмолчанию = Неопределено;
			
			Выполнить("МенеджерСправочника = Справочники.ДоговорыКонтрагентов;");
			Выполнить("СписокВидовДоговоров = МенеджерСправочника.ПолучитьСписокВидовДоговораДляДокумента(Док.Ссылка, Док.ВидОперации);");
			Выполнить("ДоговорПоУмолчанию = МенеджерСправочника.ПолучитьДоговорПоУмолчаниюПоОрганизацииВидуДоговора(Док.Контрагент, Док.Организация, СписокВидовДоговоров);");
			
			Док.Договор = ДоговорПоУмолчанию;
		КонецЕсли;
		
		Док.НДСВключатьВСтоимость = Истина;	
		
		Если НЕ Метаданные.Константы.Найти("ФункциональнаяОпцияУчетЦенКонтрагентов") = Неопределено
			И Константы.ФункциональнаяОпцияУчетЦенКонтрагентов.Получить() = Ложь Тогда
			ВидЦен = Док.Договор.ВидЦен;
		Иначе
			ВидЦен = Док.Договор.ВидЦенКонтрагента;
			Док.ВидЦенКонтрагента = ВидЦен;
		КонецЕсли;	
			
	    Док.СуммаВключаетНДС = ВидЦен.ЦенаВключаетНДС;
		Док.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС;
		
		ЗначениеНастройкиОсновнойСклад = Неопределено;
		Выполнить("ЗначениеНастройкиОсновнойСклад = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеПоУмолчаниюПользователя(ПолучитьТекущегоПользователя1С(), ""ОсновнойСклад"");");
		Док.СтруктурнаяЕдиница = ?(ЗначениеЗаполнено(ЗначениеНастройкиОсновнойСклад), ЗначениеНастройкиОсновнойСклад, Справочники.СтруктурныеЕдиницы.ОсновнойСклад);
		Если Не ЗначениеЗаполнено(Док.СтруктурнаяЕдиница) Тогда
			Док.СтруктурнаяЕдиница 	= ПолучитьКонстантуEDI("СоздаваемыйДокументСклад");
		КонецЕсли;	
		
		Док.ВалютаДокумента	= ?(ЗначениеЗаполнено(Док.Договор), Док.Договор.ВалютаРасчетов, ВалютаУчета_КонтурEDI());
		ВалютаКурсКратность = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(Док.Дата, Новый Структура("Валюта", Док.ВалютаДокумента));
		Док.Курс		= ВалютаКурсКратность.Курс;
		Док.Кратность	= ВалютаКурсКратность.Кратность;
		
	КонецЕсли;
	
	Если НЕ Сообщение.НакладнаяEDI.Номер = "" Тогда
		Если ИмяКонфигурации1С = "УФ_БП"
			И НЕ ЗагружатьВозвратВДокументПоступление Тогда
			Док.Сделка 				= НайтиИПолучитьНакладную(Сообщение);
		ИначеЕсли ИмяКонфигурации1С = "УФ_УТ" 
			И НЕ ЗагружатьВозвратВДокументПоступление Тогда
			Док.ДокументРеализации 	= НайтиИПолучитьНакладную(Сообщение);
		ИначеЕсли ИмяКонфигурации1С = "УФ_УНФ" Тогда
			Док.ДокументОснование 	= НайтиИПолучитьНакладную(Сообщение);
		ИначеЕсли ИмяКонфигурации1С = "УФ_Розница" Тогда
			Док.ДокументОснование 	= НайтиИПолучитьНакладную(Сообщение);
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяКонфигурации1С = "УФ_БП" Тогда
		флСуммаВключаетНДС = Док.СуммаВключаетНДС;
	ИначеЕсли ИмяКонфигурации1С = "УФ_УНФ" Тогда
		флСуммаВключаетНДС = Док.СуммаВключаетНДС;
	ИначеЕсли ИмяКонфигурации1С = "УФ_УТ" 
		ИЛИ ИмяКонфигурации1С = "УФ_Розница" Тогда
		флСуммаВключаетНДС = Док.ЦенаВключаетНДС;
	КонецЕсли;	
	
	Если ИмяКонфигурации1С = "УФ_УНФ" Тогда		
		ИмяТабличнойЧасти = "Запасы";
	Иначе
		ИмяТабличнойЧасти = "Товары";	
	КонецЕсли;
	
	ТаблицаДокументаВМетаданных = КонтурСтандарт_СтрШаблон_("Документы.%1.ТабличныеЧасти.%2",
															 Док.Метаданные().Имя,
															 ИмяТабличнойЧасти);															 
	ЕстьРеквизитЕдиницаИзмерения = ЕстьНеобходимыеМетаданные(ТаблицаДокументаВМетаданных + ".Реквизиты.ЕдиницаИзмерения");
	
	ЕстьРеквизитХарактеристика = ЕстьНеобходимыеМетаданные(ТаблицаДокументаВМетаданных + ".Реквизиты.Характеристика");
	
	Док[ИмяТабличнойЧасти].Очистить();
	
	Для каждого Стр Из Сообщение.Товары Цикл
		
		НоваяСтрока = Док[ИмяТабличнойЧасти].Добавить();
		
		НоваяСтрока.Номенклатура		= Стр.Номенклатура;
		
		Если ИмяКонфигурации1С = "УФ_УТ" ИЛИ ИмяКонфигурации1С = "УФ_Розница" Тогда
			НоваяСтрока.Упаковка			= Стр.ЕдиницаИзмерения;
			НоваяСтрока.КоличествоУпаковок	= Стр.Количество;
			
			// пересчитаем количество на основании коэффициента упаковки
			Если ОпределитьРелизКонфигурации() = "11.2" Тогда
				Если НоваяСтрока.Упаковка.Числитель > 1 Тогда
					НоваяСтрока.Количество	= НоваяСтрока.КоличествоУпаковок * НоваяСтрока.Упаковка.Числитель;
				ИначеЕсли НоваяСтрока.Упаковка.Знаменатель > 1 Тогда
					НоваяСтрока.Количество	= НоваяСтрока.КоличествоУпаковок / НоваяСтрока.Упаковка.Знаменатель;
				Иначе
					НоваяСтрока.Количество	= НоваяСтрока.КоличествоУпаковок;
				КонецЕсли;
			Иначе
				Если ЗначениеЗаполнено(НоваяСтрока.Упаковка) Тогда
					НоваяСтрока.Количество	= НоваяСтрока.КоличествоУпаковок * ПолучитьКоэффициентУпаковкиУФ_УТ(НоваяСтрока.Упаковка);
				Иначе
					НоваяСтрока.Количество	= НоваяСтрока.КоличествоУпаковок;
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ИмяКонфигурации1С = "УФ_БП" 
			ИЛИ ИмяКонфигурации1С = "УФ_УНФ" Тогда
			НоваяСтрока.Количество	= Стр.Количество;
		КонецЕсли;
		
		Если ЕстьРеквизитЕдиницаИзмерения Тогда 
			НоваяСтрока.ЕдиницаИзмерения = Стр.ЕдиницаИзмерения;
		КонецЕсли;
		
		Если ИспользуютсяХарактеристики И ЕстьРеквизитХарактеристика Тогда
			НоваяСтрока.Характеристика	= Стр.ХарактеристикаНоменклатуры;
		КонецЕсли;
		
		ЗаполнитьСтавкуНДСВСтрокеТовараДокумента(Стр, НоваяСтрока, Док.Дата);
		
		ЗаполнитьНедостающиеПоляСтрокиТоваров(Стр);
			
		Если флСуммаВключаетНДС Тогда
			НоваяСтрока.Цена = Стр.ЦенаСНДС;
			НоваяСтрока.Сумма = Стр.СуммаСНДС;
		Иначе        
			НоваяСтрока.Цена = Стр.ЦенаБезНДС;
			НоваяСтрока.Сумма = Стр.СуммаБезНДС;
		КонецЕсли;	
		
		НоваяСтрока.СуммаНДС = Стр.СуммаНДС;
		
		Если ИмяКонфигурации1С = "УФ_УНФ" Тогда 
			НоваяСтрока.Всего = НоваяСтрока.Сумма + ?(флСуммаВключаетНДС, 0, НоваяСтрока.СуммаНДС);
		КонецЕсли;
		
		Если ИмяКонфигурации1С = "УФ_УТ" Тогда
			НоваяСтрока.СуммаСНДС = Стр.СуммаСНДС;
			Если ЗагружатьВозвратВДокументПоступление Тогда
				НоваяСтрока.СуммаВзаиморасчетов = Стр.СуммаСНДС * КурсВалютыВзаиморасчетов;	
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ЗагружатьВозвратВДокументПоступление
			И Сообщение.ТипСообщения = "RETANN"
			И ИмяКонфигурации1С = "УФ_УТ" Тогда
			Док.ПричинаВозврата = Док.ПричинаВозврата + "Поз." + Стр.НомерСтроки + ": " + Стр.ПричинаВозврата + " "; 
		КонецЕсли;
		
		Если ИмяКонфигурации1С = "УФ_БП" Тогда
			Выполнить("ОбработкаТабличныхЧастейКлиентСервер.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, Док.СуммаВключаетНДС)");
		КонецЕсли;
		
		//попытаемся поставить документ в тч
		Если ИмяКонфигурации1С = "УФ_УТ" Тогда  
			
			Если ЗагружатьВозвратВДокументПоступление Тогда
				
				Если ЗначениеЗаполнено(Док.Склад) Тогда
					НоваяСтрока.Склад = Док.Склад;
				КонецЕсли;
				
			Иначе
				
				Если ЕстьРеквизитОбъекта_Контур(Док, "ДокументРеализации") И ЗначениеЗаполнено(Док.ДокументРеализации) Тогда
					
					Если ЕстьРеквизитОбъекта_Контур(Док, "СпособОпределенияСебестоимости", "Товары") Тогда
						
						Если ЕстьНеобходимыеМетаданные("Перечисления.СпособыОпределенияСебестоимостиВозврата.ЗначенияПеречисления.ИзДокументаПродажи") Тогда
							НоваяСтрока.СпособОпределенияСебестоимости = Перечисления.СпособыОпределенияСебестоимостиВозврата.ИзДокументаПродажи;
						ИначеЕсли ЕстьНеобходимыеМетаданные("Перечисления.СпособыОпределенияСебестоимости.ЗначенияПеречисления.ИзДокументаПродажи") Тогда
							НоваяСтрока.СпособОпределенияСебестоимости = Перечисления.СпособыОпределенияСебестоимости.ИзДокументаПродажи;
						КонецЕсли;
						
					КонецЕсли;
					
					НоваяСтрока.ДокументРеализации = Док.ДокументРеализации;
					
				КонецЕсли;
				
			КонецЕсли;			
			
		ИначеЕсли ИмяКонфигурации1С = "УФ_БП" Тогда
			//нет документа в ТЧ
		КонецЕсли;
			
	КонецЦикла;
	
	Если ЗагружатьВозвратВДокументПоступление И ЕстьНеобходимыеМетаданные("Документы.ПоступлениеТоваровУслуг") Тогда
		ТипВозвратногоДокумента = "ПоступлениеТоваровУслуг";
	КонецЕсли;
	
	Если ЗагружатьВозвратВДокументПоступление И ЕстьНеобходимыеМетаданные("Документы.ПриобретениеТоваровУслуг") Тогда
		ТипВозвратногоДокумента = "ПриобретениеТоваровУслуг";
	КонецЕсли;
	
	Если НЕ ЗагружатьВозвратВДокументПоступление Тогда
		ТипВозвратногоДокумента = ПолучитьТипЗначенияОбъекта("ВходящийВозврат",,Истина);
	КонецЕсли;
	
	//Счета учета
	Если ИмяКонфигурации1С = "УФ_БП" Тогда
		ЗаполнилиСчетаУчета = Ложь;
		Попытка
			Выполнить("Документы[ТипВозвратногоДокумента].ЗаполнитьСчетаУчетаВТабличнойЧасти(Док, ""Товары"");");
			ЗаполнилиСчетаУчета = Истина;
		Исключение
			ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось заполнить счета учета в ТЧ - " + ОписаниеОшибки());
		КонецПопытки;		
		Если НЕ ЗаполнилиСчетаУчета Тогда
			Попытка
				Выполнить("СчетаУчетаВДокументах.ЗаполнитьСчетаУчетаВТабличнойЧасти(Док, ""Товары"");");
				ЗаполнилиСчетаУчета = Истина;
			Исключение
				ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось заполнить счета учета в ТЧ - " + ОписаниеОшибки());
			КонецПопытки;		
		КонецЕсли;
		Если НЕ ЗаполнилиСчетаУчета Тогда
			Попытка
				Выполнить("СчетаУчетаВДокументах.ЗаполнитьПередЗаписью(Док, РежимЗаписиДокумента.Запись);");
				ЗаполнилиСчетаУчета = Истина;
			Исключение
				ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось заполнить счета учета в ТЧ - " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	//реквизиты печати
	Если ИмяКонфигурации1С = "УФ_УТ"
		И НЕ ЗагружатьВозвратВДокументПоступление Тогда
		Док.Покупатель = Строка(Док.Партнер);
	КонецЕсли;	
	
	Док.Записать();
	
КонецПроцедуры // СоздатьВозвратУФ()

//PORDERS входящий
Функция ПринятьОбратныйЗаказПоставщика(Сообщение,ПервоначальнаяЗагрузкаСообщения = Истина)
	
	Если Лев(ИмяКонфигурации1С,3)="УФ_" Тогда 
		Возврат ПринятьОбратныйЗаказПоставщика_УФ(Сообщение,ПервоначальнаяЗагрузкаСообщения);
	КонецЕсли;
	
	Если Сообщение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИД = СокрЛП(Сообщение.ID);
	
	Если ИспользоватьМаппингМетаданных Тогда
		СсылкаНаДокумент = Маппинг_ПринятьОбратныйЗаказПоставщика(Сообщение,ПервоначальнаяЗагрузкаСообщения);
		Возврат СсылкаНаДокумент;
	КонецЕсли;
	
	ИмяРеквизитаОрганизация = ?(ИмяКонфигурации1С = "ДалионУМ" ИЛИ ИмяКонфигурации1С = "АСТОР", "Фирма", "Организация");
	ИмяРеквизитаТипЦен 		= ?(ИмяКонфигурации1С = "ДалионУМ", "КатегорияЦен", "ТипЦен"); 
	ИмяРеквизитаДоговор		= ?(ИмяКонфигурации1С = "АСТОР"  ИЛИ ИмяКонфигурации1С = "ДалионТРЕНД" ИЛИ ИмяКонфигурации1С = "УФ_ДалионТРЕНД" , "Договор", "ДоговорКонтрагента");
	ИмяРеквизитаВалюта 		= ?(ИмяКонфигурации1С = "АСТОР", "Валюта", "ВалютаДокумента");
	ИмяТабличнойЧастиТовары = ?(ИмяКонфигурации1С = "АСТОР", "Состав", "Товары");
	ИмяРеквизитаХарактеристикаНоменклатуры = ?(ИмяКонфигурации1С = "АСТОР", "Характеристика", "ХарактеристикаНоменклатуры");
	
	ТипЦен				= Неопределено;
	флУчитыватьНДС		= Истина;
	флСуммаВключаетНДС	= Истина;
	
	Если ЗначениеЗаполнено(Сообщение.Договор) Тогда
		ДоговорКонтрагента = Сообщение.Договор;
	Иначе
		Если ИмяКонфигурации1С = "АСТОР" Тогда
			Выполнить("ДоговорКонтрагента = ОмРаботаСФормами.ПолучитьОсновнойДоговор(Сообщение.Покупатель1С,Сообщение.Продавец1С,Перечисления.ВидыДоговоров.Покупка);");
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДоговорКонтрагента)
		И ЕстьРеквизитОбъекта_Контур(ДоговорКонтрагента,ИмяРеквизитаТипЦен) Тогда
		ТипЦен = ДоговорКонтрагента[ИмяРеквизитаТипЦен];
		УстановитьЗначениеСвойстваОбъекта(Сообщение.Покупатель1С, "GUIDДоговораПоУмолчанию", СокрЛП(ДоговорКонтрагента.УникальныйИдентификатор()));
	КонецЕсли;
	
	Если ИмяКонфигурации1С = "ДалионУМ" Тогда
		
		Склад  				= ПолучитьКонстантуEDI("СоздаваемыйДокументСклад");
		УчетнаяПолитика		= Неопределено;
		Выполнить("УчетнаяПолитика = ПолучитьУчетнуюПолитику(ТекущаяДата(), Сообщение.Продавец1С, Склад);");
		Если Не УчетнаяПолитика = Неопределено Тогда
			флУчитыватьНДС 		= НЕ УчетнаяПолитика.НеЯвляетсяПлательщикомНДС;			
			флСуммаВключаетНДС 	= УчетнаяПолитика.СуммаВключаетНДС;
		КонецЕсли;
		
	ИначеЕсли ИмяКонфигурации1С = "ДалионТРЕНД"  ИЛИ ИмяКонфигурации1С = "УФ_ДалионТРЕНД"  Тогда
		
		Склад  				= ПолучитьКонстантуEDI("СоздаваемыйДокументСклад");
		УчетнаяПолитика		= Неопределено;
		Выполнить("УчетнаяПолитика = ПолучитьУчетнуюПолитику(ТекущаяДата(), Сообщение.Продавец1С, Склад);");
		Если Не УчетнаяПолитика = Неопределено Тогда
			флУчитыватьНДС 		= НЕ УчетнаяПолитика.НеЯвляетсяПлательщикомНДС;			
			флСуммаВключаетНДС 	= УчетнаяПолитика.СуммаВключаетНДС;
		КонецЕсли;
		
	ИначеЕсли ИмяКонфигурации1С = "АСТОР" Тогда
		
		Если ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
			флУчитыватьНДС 		= ?(ДоговорКонтрагента.ТипДоговора = Перечисления.ТипыДоговоров.Комиссия, Ложь, Истина);
			флСуммаВключаетНДС	= флУчитыватьНДС;
		КонецЕсли;
		
	Иначе 
		
		Если ЗначениеЗаполнено(ТипЦен) Тогда
			флСуммаВключаетНДС = ТипЦен.ЦенаВключаетНДС;
		КонецЕсли;
		
	КонецЕсли;
		
	Если ПервоначальнаяЗагрузкаСообщения Тогда
		Если Не ИмяКонфигурации1С = "БП" Тогда
			ТипДокументаЗаказ = ПолучитьТипЗначенияОбъекта("ВходящийОбратныйЗаказ",,Истина); 
			НовыйДокумент = Документы[ТипДокументаЗаказ].СоздатьДокумент();
		Иначе
			Возврат Неопределено;
		КонецЕсли;	
	КонецЕсли;
		
	Если ЕстьРеквизитОбъекта_Контур(НовыйДокумент,ИмяРеквизитаТипЦен) Тогда
		НовыйДокумент[ИмяРеквизитаТипЦен]	= ТипЦен;
	КонецЕсли;
	
	Если ЕстьРеквизитОбъекта_Контур(НовыйДокумент,"УчитыватьНДС") Тогда
		НовыйДокумент.УчитыватьНДС			= флУчитыватьНДС;
	КонецЕсли;
	
	Если ЕстьРеквизитОбъекта_Контур(НовыйДокумент,"СуммаВключаетНДС") Тогда
		НовыйДокумент.СуммаВключаетНДС		= флСуммаВключаетНДС;
	КонецЕсли;
	
	НовыйДокумент.Дата = ТекущаяДата();
	
	НовыйДокумент[ИмяРеквизитаОрганизация]	= Сообщение.Покупатель1С;
	НовыйДокумент.Контрагент				= Сообщение.Продавец1С;
	НовыйДокумент[ИмяРеквизитаДоговор] 		= ДоговорКонтрагента;
	
	Если ЕстьРеквизитОбъекта_Контур(НовыйДокумент,"Склад") Тогда
		НовыйДокумент.Склад 				= Сообщение.Грузополучатель1С;
	КонецЕсли;
	
	Если ЕстьРеквизитОбъекта_Контур(НовыйДокумент,"СтруктурнаяЕдиница") Тогда
		Если ЗначениеЗаполнено(Сообщение.Покупатель1С)
			И ЕстьРеквизитОбъекта_Контур(Сообщение.Покупатель1С,"ОсновнойБанковскийСчет") Тогда
			НовыйДокумент.СтруктурнаяЕдиница = Сообщение.Покупатель1С.ОсновнойБанковскийСчет;
		КонецЕсли;
	КонецЕсли;
	
	Если ЕстьРеквизитОбъекта_Контур(НовыйДокумент,"ДатаПоступления") Тогда
		НовыйДокумент.ДатаПоступления = Сообщение.ДатаПоставки;
	ИначеЕсли ЕстьРеквизитОбъекта_Контур(НовыйДокумент,"ДатаПоставки") Тогда
		НовыйДокумент.ДатаПоставки = Сообщение.ДатаПоставки;
	КонецЕсли;
		
	НовыйДокумент[ИмяРеквизитаВалюта] = Сообщение.Валюта1С;
	
	Если ИмяКонфигурации1С = "АСТОР" Тогда
		НовыйДокумент.КурсВалютыДоговора	= 1;
	Иначе
		НовыйДокумент.КурсВзаиморасчетов		= 1; 
		НовыйДокумент.КратностьВзаиморасчетов	= 1;
	КонецЕсли;
	
	Если ИмяКонфигурации1С = "УПП" Тогда                                                                       
		Если ПеременнаяСодержитСвойство(НовыйДокумент,"ВидОперации") И ЕстьНеобходимыеМетаданные("Перечисления.ВидыОперацийЗаказПоставщику.ЗначенияПеречисления.ПокупкаКомиссия") Тогда
			НовыйДокумент.ВидОперации = Вычислить("Перечисления.ВидыОперацийЗаказПоставщику.ПокупкаКомиссия"); 
		КонецЕсли;
	КонецЕсли; 
	
	ТипЕдиницыИзмерения 			= ПолучитьТипЗначенияОбъекта("ЕдиницаИзмерения",,Истина);   
	ЕстьКоэффициент 				= ЕстьРеквизитОбъекта_Контур(НовыйДокумент,"Коэффициент",ИмяТабличнойЧастиТовары) И 
									  ЕстьНеобходимыеМетаданные("Справочники." +ТипЕдиницыИзмерения+ ".Реквизиты.Коэффициент");

	
	Кол = 0;
	НовыйДокумент[ИмяТабличнойЧастиТовары].Очистить();
	
	//выясним, по всем ли позициям пришла цена
	//критерием будет являться отсутствие и ЦенаБезНДС и ЦенаСНДС
	ЦеныПроставлены = Истина;
	СписокНоменклатурыБезЦен = Новый СписокЗначений;
	
	Для Каждого Стр Из Сообщение.Товары Цикл
		Если Стр.ЦенаСНДС=0 и стр.ЦенаБезНДС=0 тогда
			ЦеныПроставлены=Ложь;
			СписокНоменклатурыБезЦен.Добавить(Стр.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	ТабличкаЦен=Неопределено;
	Если Не ЦеныПроставлены и СписокНоменклатурыБезЦен.Количество()>0  Тогда
		Попытка
			Если ЗначениеЗаполнено(ТипЦен) Тогда 
				Запрос = Новый Запрос;
				Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ЦеныНоменклатурыСрезПоследних.Номенклатура,
				|	ЦеныНоменклатурыСрезПоследних.Цена
				|ИЗ
				|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
				|			&Дата,
				|			ТипЦен = &ТипЦен
				|				И Номенклатура В (&СписокНоменклатуры)) КАК ЦеныНоменклатурыСрезПоследних";
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТипЦен = &ТипЦен", ИмяРеквизитаТипЦен+" = &ТипЦен");	
				Запрос.УстановитьПараметр("СписокНоменклатуры", СписокНоменклатурыБезЦен);
				Запрос.УстановитьПараметр("ТипЦен", ТипЦен);
				Запрос.УстановитьПараметр("Дата",?(ЗначениеЗаполнено(Сообщение.ДатаПоставки),Сообщение.ДатаПоставки,ТекущаяДата()));
				
				Результат = Запрос.Выполнить();
				ТабличкаЦен	= Результат.Выгрузить();			
				
			КонецЕсли;
		Исключение
			ТабличкаЦен=Неопределено;
		КонецПопытки;
	КонецЕсли; //составили табличку цен
	
	Для Каждого Стр Из Сообщение.Товары Цикл
		
		Если Стр.НеЗагружать = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = НовыйДокумент[ИмяТабличнойЧастиТовары].Добавить();
		
		НоваяСтрока.Номенклатура		= Стр.Номенклатура;
		НоваяСтрока.ЕдиницаИзмерения	= Стр.ЕдиницаИзмерения;
		Если ЕстьКоэффициент Тогда 
			НоваяСтрока.Коэффициент			= Стр.ЕдиницаИзмерения.Коэффициент;
		КонецЕсли;
		НоваяСтрока[ИмяРеквизитаХарактеристикаНоменклатуры]	= Стр.ХарактеристикаНоменклатуры;
	
		НоваяСтрока.Количество			= Стр.Количество;
		
		ЗаполнитьСтавкуНДСВСтрокеТовараДокумента(Стр, НоваяСтрока, НовыйДокумент.Дата);
		
		Если Найти("/УТ_10_2/RIT/ДалионУМ/АСТОР/","/"+ИмяКонфигурации1С+"/")>0 Тогда
			Если ЗначениеЗаполнено(НоваяСтрока.Номенклатура.ЕдиницаИзмеренияМест) Тогда
				Выполнить("ОбработкаТабличныхЧастей.ЗаполнитьЕдиницуМестТабЧасти(НоваяСтрока,НовыйДокумент,Ложь);");
			КонецЕсли;	
		КонецЕсли;

		ЗаполнитьНедостающиеПоляСтрокиТоваров(Стр);
		
		Если флСуммаВключаетНДС Тогда
			НоваяСтрока.Цена = Стр.ЦенаСНДС;
			НоваяСтрока.Сумма = Стр.СуммаСНДС;
		Иначе        
			НоваяСтрока.Цена = Стр.ЦенаБезНДС;
			НоваяСтрока.Сумма = Стр.СуммаБезНДС;
		КонецЕсли;	
		
		Если ЕстьРеквизитОбъекта_Контур(НовыйДокумент,"СуммаНДС",ИмяТабличнойЧастиТовары) Тогда
			НоваяСтрока.СуммаНДС = Стр.СуммаНДС;
		КонецЕсли;

	КонецЦикла;	
	
	Комментарий="";//В некоторых сообщениях может не быть комментария
	Сообщение.Свойство("Комментарий",Комментарий);
	НовыйДокумент.Комментарий = "Загружен из EDI"+?(СокрЛП(Комментарий)<>"",": "+Комментарий,"");
	
	Если ИмяКонфигурации1С = "ДалионУМ" 
		или ИмяКонфигурации1С = "АСТОР" Тогда
		НовыйДокумент.Автор = ПолучитьТекущегоПользователя1С();
	Иначе
		НовыйДокумент.Ответственный = ПолучитьТекущегоПользователя1С();
	КонецЕсли;
	
	УстановитьПризнакОбменДаннымиВДокументе_КонтурEDI(НовыйДокумент);

	ОбработкаСобытияПодключаемогоМодуля("ПриЗагрузкеВходящегоСообщения",,Новый Структура("Сообщение,ДокументСсылка",Сообщение,НовыйДокумент));
	
	#Если Клиент Тогда
	Если ПолучитьКонстантуEDI("ОткрыватьФормуОбратногоЗаказаПередЗаписью") = Истина Тогда
		
		ФормаДокумента = НовыйДокумент.ПолучитьФорму();
		ФормаДокумента.ЭлементыФормы.Склад.ОграничениеТипа = Новый ОписаниеТипов(ПолучитьТипЗначенияОбъекта("ТочкаДоставкиСвоя"));
		ФормаДокумента.ОткрытьМодально();
		
		СсылкаНаДокумент = НовыйДокумент.Ссылка;		
		
		Если НЕ ЗначениеЗаполнено(СсылкаНаДокумент) Тогда
			Возврат Неопределено;
		Иначе
			Возврат СсылкаНаДокумент;
		КонецЕсли;
	КонецЕсли;
	#КонецЕсли
		
	//в регламентном задании всегда будем попадать сюда
	НовыйДокумент.Записать();
	Если ПолучитьКонстантуEDI("ПроводитьЗагруженныеОбратныеЗаказы") = Истина Тогда
		ПроводитьЗаказ = Истина;
	Иначе
		ПроводитьЗаказ = НовыйДокумент.Проведен;
	КонецЕсли;
	Если ПроводитьЗаказ Тогда
		Попытка
			НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Сообщить("Контур-EDI: Не удалось провести документ "+СокрЛП(Строка(НовыйДокумент)));
		КонецПопытки;
	КонецЕсли;
	СсылкаНаДокумент = НовыйДокумент.Ссылка;
		
	Возврат СсылкаНаДокумент;
	
КонецФункции

//INVOIC входящий
Функция ПринятьСчетФактуру(Сообщение)
	
	Если ИспользоватьМаппингМетаданных Тогда
		ДокументСсылка = Маппинг_ПринятьСчетФактуру(Сообщение);
		Возврат ДокументСсылка;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	
	Если ИмяКонфигурации1С = "ТКПТ" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |	ПоступлениеТоваров.Ссылка
        |ИЗ
        |	Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
        |ГДЕ
        |	ПоступлениеТоваров.ВхДокНомер = &НомерВходящегоДокумента
        |	И ПоступлениеТоваров.ВхДокДата МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаВходящегоДокумента, МЕСЯЦ, -2) И ДОБАВИТЬКДАТЕ(&ДатаВходящегоДокумента, МЕСЯЦ, 1)";	
		
		Запрос.УстановитьПараметр("НомерВходящегоДокумента", Сообщение.НакладнаяEDI.Номер);
		Запрос.УстановитьПараметр("ДатаВходящегоДокумента",  Сообщение.НакладнаяEDI.Дата);
		
		Если Не Сообщение.Покупатель1С = Справочники.Организации.ПустаяСсылка() Тогда
			Запрос.Текст = Запрос.Текст +  "	И ПоступлениеТоваров.Организация = &Организация ";
			Запрос.УстановитьПараметр("Организация", Сообщение.Покупатель1С);
		КонецЕсли;
		
		Если Не Сообщение.Продавец1С   = Справочники.Организации.ПустаяСсылка() Тогда
			Запрос.Текст = Запрос.Текст +  "	И ПоступлениеТоваров.Контрагент = &Контрагент ";
			Запрос.УстановитьПараметр("Контрагент", Сообщение.Продавец1С );
		КонецЕсли;
		
	ИначеЕсли ИмяКонфигурации1С = "АСТОР" Тогда
		
	    Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |	ПриходнаяНакладная.Ссылка
        |ИЗ
        |	Документ.ПриходнаяНакладная КАК ПриходнаяНакладная
        |ГДЕ
        |	ПриходнаяНакладная.НомерДокумента = &НомерВходящегоДокумента
        |	И ПриходнаяНакладная.ДатаДокумента МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаВходящегоДокумента, МЕСЯЦ, -2) И ДОБАВИТЬКДАТЕ(&ДатаВходящегоДокумента, МЕСЯЦ, 1)";	
		
		Запрос.УстановитьПараметр("НомерВходящегоДокумента", Сообщение.НакладнаяEDI.Номер);
		Запрос.УстановитьПараметр("ДатаВходящегоДокумента",  Сообщение.НакладнаяEDI.Дата);
		
		Если Не Сообщение.Покупатель1С = Справочники.Организации.ПустаяСсылка() Тогда
			Запрос.Текст = Запрос.Текст +  "	И ПриходнаяНакладная.Фирма = &Организация ";
			Запрос.УстановитьПараметр("Организация", Сообщение.Покупатель1С);
		КонецЕсли;
		
		Если Не Сообщение.Продавец1С   = Справочники.Организации.ПустаяСсылка() Тогда
			Запрос.Текст = Запрос.Текст +  "	И ПриходнаяНакладная.Контрагент = &Контрагент ";
			Запрос.УстановитьПараметр("Контрагент", Сообщение.Продавец1С );
		КонецЕсли;
		
	ИначеЕсли ИмяКонфигурации1С = "ДалионУМ" Тогда
		
	    Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |	ПриходнаяНакладная.Ссылка
        |ИЗ
        |	Документ.ПриходнаяНакладная КАК ПриходнаяНакладная
        |ГДЕ
        |	ПриходнаяНакладная.ВходящийНомер = &НомерНакладной
        |	И ПриходнаяНакладная.ДатаСчетаФактуры МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаНакладной, МЕСЯЦ, -2) И ДОБАВИТЬКДАТЕ(&ДатаНакладной, МЕСЯЦ, 1)";	
		
		Запрос.УстановитьПараметр("НомерНакладной", Сообщение.НакладнаяEDI.Номер);
		Запрос.УстановитьПараметр("ДатаНакладной",  Сообщение.НакладнаяEDI.Дата);
		
		Если Не Сообщение.Покупатель1С = Справочники.Фирмы.ПустаяСсылка() Тогда
			Запрос.Текст = Запрос.Текст +  "	И ПриходнаяНакладная.Фирма = &Фирма ";
			Запрос.УстановитьПараметр("Фирма", Сообщение.Покупатель1С);
		КонецЕсли;
		
		Если Не Сообщение.Продавец1С = Справочники.Контрагенты.ПустаяСсылка() Тогда
			Запрос.Текст = Запрос.Текст +  "	И ПриходнаяНакладная.Контрагент = &Контрагент ";
			Запрос.УстановитьПараметр("Контрагент", Сообщение.Продавец1С );
		КонецЕсли;
		
	ИначеЕсли ИмяКонфигурации1С = "ШтрихМ_РС" Тогда
		
	    Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |	ПриходнаяНакладная.Ссылка
        |ИЗ
        |	Документ.ПриходнаяНакладная КАК ПриходнаяНакладная
        |ГДЕ
        |	ПриходнаяНакладная.ВходящийНомерДокумента = &НомерВходящегоДокумента
        |	И ПриходнаяНакладная.ВходящаяДатаДокумента МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаВходящегоДокумента, МЕСЯЦ, -2) И ДОБАВИТЬКДАТЕ(&ДатаВходящегоДокумента, МЕСЯЦ, 1)";	
		
		Запрос.УстановитьПараметр("НомерВходящегоДокумента", Сообщение.НакладнаяEDI.Номер);
		Запрос.УстановитьПараметр("ДатаВходящегоДокумента",  Сообщение.НакладнаяEDI.Дата);
		
		Если Не Сообщение.Покупатель1С = Справочники.Фирмы.ПустаяСсылка() Тогда
			Запрос.Текст = Запрос.Текст +  "	И ПриходнаяНакладная.Фирма = &Организация ";
			Запрос.УстановитьПараметр("Организация", Сообщение.Покупатель1С);
		КонецЕсли;
		
		Если Не Сообщение.Продавец1С   = Справочники.Контрагенты.ПустаяСсылка() Тогда
			Запрос.Текст = Запрос.Текст +  "	И ПриходнаяНакладная.Контрагент = &Контрагент ";
			Запрос.УстановитьПараметр("Контрагент", Сообщение.Продавец1С );
		КонецЕсли;
		
	ИначеЕсли ИмяКонфигурации1С = "УФ_ДалионТРЕНД" Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПриходнаяНакладная.Ссылка
		|ИЗ
		|	Документ.ПриходнаяНакладная КАК ПриходнаяНакладная
		|ГДЕ
		|	ПриходнаяНакладная.НомерВходящегоДокумента = &НомерВходящегоДокумента
		|	И ПриходнаяНакладная.ДатаВходящегоДокумента МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаВходящегоДокумента, МЕСЯЦ, -2) И ДОБАВИТЬКДАТЕ(&ДатаВходящегоДокумента, МЕСЯЦ, 1)";	
		
		Запрос.УстановитьПараметр("НомерВходящегоДокумента", Сообщение.НакладнаяEDI.Номер);
		Запрос.УстановитьПараметр("ДатаВходящегоДокумента",  Сообщение.НакладнаяEDI.Дата);
		
		Если Не Сообщение.Покупатель1С = ПолучитьПустуюСсылкуОбъекта("ЮрФизЛицоСвое") Тогда
			Запрос.Текст = Запрос.Текст +  "	И ПриходнаяНакладная.Организация = &Организация ";
			Запрос.УстановитьПараметр("Организация", Сообщение.Покупатель1С);
		КонецЕсли;
		
		Если Не Сообщение.Продавец1С   = ПолучитьПустуюСсылкуОбъекта("ЮрФизЛицоСтороннее") Тогда
			Запрос.Текст = Запрос.Текст +  "	И ПриходнаяНакладная.Контрагент = &Контрагент ";
			Запрос.УстановитьПараметр("Контрагент", Сообщение.Продавец1С );
		КонецЕсли;
		
	Иначе
		
	    ТипДокумента = ПолучитьТипЗначенияОбъекта("ВходящееУведомлениеОбОтгрузке", , Истина);
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПоступлениеТоваровУслуг.Ссылка
		|ИЗ
		|	Документ." + ТипДокумента + " КАК ПоступлениеТоваровУслуг
		|ГДЕ
		|	ПоступлениеТоваровУслуг.НомерВходящегоДокумента = &НомерВходящегоДокумента
		|	И ПоступлениеТоваровУслуг.ДатаВходящегоДокумента = &ДатаВходящегоДокумента
		|	И ПоступлениеТоваровУслуг.Контрагент = &Контрагент
		|	И НЕ ПоступлениеТоваровУслуг.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("НомерВходящегоДокумента",	Сообщение.НакладнаяEDI.Номер);
		Запрос.УстановитьПараметр("ДатаВходящегоДокумента",		Сообщение.НакладнаяEDI.Дата);
		Запрос.УстановитьПараметр("Контрагент",					Сообщение.Продавец1С);
	
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Сообщить_КонтурEDI("Не удалось найти поступление с вх. номером " + Сообщение.НакладнаяEDI.Номер);
		
	ИначеЕсли РезультатЗапроса.Выгрузить().Количество() > 1 Тогда
		
		Если ИмяКонфигурации1С = "АСТОР" Тогда
			ТекстСообщения = "Не удается однозначно сопоставить регистрацию счета-фактуры и приходную накладную с вх. номером " + 
				Сообщение.НакладнаяEDI.Номер + " и вх. датой " + Сообщение.НакладнаяEDI.Дата;	
		Иначе
			ТекстСообщения = "Не удается однозначно сопоставить счет-фактуру и поступление с вх. номером " + 
				Сообщение.НакладнаяEDI.Номер + " и вх. датой " + Сообщение.НакладнаяEDI.Дата;
		КонецЕсли;
		
		Сообщить_КонтурEDI(ТекстСообщения);
		
	Иначе
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Поступление = Выборка.Ссылка;
		
		// пробуем найти счет-фактуру (в случае повторного INVOIC или уже введенного вручную)
		СчетФактура = НайтиСвязанныйДокументПоТипуСообщения(Поступление, "INVOIC");
		
		Если ЗначениеЗаполнено(СчетФактура) Тогда
			
			Док = СчетФактура.ПолучитьОбъект();
			
		Иначе	
			
			ИмяДокументаСФ = ПолучитьТипЗначенияОбъекта("ВходящийСчетФактура", , Истина);
			Док = Документы[ИмяДокументаСФ].СоздатьДокумент();	
			
		КонецЕсли;
		
		ЭтоПовторноеЗаполенения_УФ_БП = ИмяКонфигурации1С = "УФ_БП" И ЗначениеЗаполнено(СчетФактура);
		
		Если НЕ (ЭтоПовторноеЗаполенения_УФ_БП) Тогда
			
			Если Док.Метаданные().ТабличныеЧасти.Найти("ДокументыОснования") <> Неопределено Тогда
				Док.ДокументыОснования.Очистить();		
			КонецЕсли; 			
			
			Если Лев(ИмяКонфигурации1С, 3) = "УФ_" И НЕ ИмяКонфигурации1С = "УФ_БП" И НЕ ИмяКонфигурации1С = "УФ_УНФ" Тогда 
				
				ИменаРеквизитов = Новый Соответствие;
				ИменаРеквизитов.Вставить("Организация", "Организация");
				ИменаРеквизитов.Вставить("Контрагент", "Контрагент");
				ИменаРеквизитов.Вставить("Номер", "НомерСчетаФактуры");
				ИменаРеквизитов.Вставить("Валюта", "ВалютаСчетаФактуры");
				
				ДанныеЗаполнения = Новый Структура;
				ДанныеЗаполнения.Вставить("ДокументОснование", Поступление);
				ДанныеЗаполнения.Вставить("ДатаСоставления",   ТекущаяДатаСеанса());
				
				Для каждого КлючЗначение Из ИменаРеквизитов Цикл
					
					ЗначениеРеквизита = Неопределено;
					
					Если ПеременнаяСодержитСвойство(Поступление, КлючЗначение.Значение, ЗначениеРеквизита) Тогда
						ДанныеЗаполнения.Вставить(КлючЗначение.Ключ, ЗначениеРеквизита);
					КонецЕсли;
					
				КонецЦикла;
				
			Иначе 
				
				ДанныеЗаполнения = Поступление;
				
			КонецЕсли;
			
			Док.Заполнить(ДанныеЗаполнения);
			
		КонецЕсли;

		Если ИмяКонфигурации1С = "ТКПТ" Тогда
			
			Док.ВхДокДата  = Сообщение.ДокументEDI.Дата;
			Док.ВхДокНомер = Сообщение.ДокументEDI.Номер;
			
		ИначеЕсли ИмяКонфигурации1С = "АСТОР" Тогда
			
			Док.ДатаСчетаФактуры  = Сообщение.ДокументEDI.Дата;
			Док.НомерСчетаФактуры = Сообщение.ДокументEDI.Номер;
			
		ИначеЕсли ИмяКонфигурации1С = "ДалионУМ" Тогда
			
			Док.НомерСчетаФактуры = Сообщение.ДокументEDI.Номер;
			Док.Комментарий = "Входящий счет-фактура №" + СокрЛП(Сообщение.ДокументEDI.Номер) + 
				" от " + Формат(Сообщение.ДокументEDI.Дата,"ДФ=dd.MM.yyyy");
			
		ИначеЕсли ИмяКонфигурации1С = "УФ_ДалионТРЕНД" Тогда
			
			Док.ПредъявленСчетФактура = Истина;
			Док.ДатаСчетаФактуры  = Сообщение.ДокументEDI.Дата;
			Док.НомерСчетаФактуры = Сообщение.ДокументEDI.Номер;
			
		ИначеЕсли ИмяКонфигурации1С = "УФ_УТ" ИЛИ ИмяКонфигурации1С = "УФ_Розница" Тогда
			
			Док.Дата  = Сообщение.ДокументEDI.Дата;
			Док.Номер = Сообщение.ДокументEDI.Номер;
			Док.ПолученВЭлектронномВиде  = Истина;
			
		ИначеЕсли ИмяКонфигурации1С = "ШтрихМ_РС" Тогда
			
			Док.ВходящаяДатаДокумента  = Сообщение.ДокументEDI.Дата;
			Док.ВходящийНомерДокумента = Сообщение.ДокументEDI.Номер;
			
		ИначеЕсли ИмяКонфигурации1С = "УФ_УНФ" Тогда
			
			Док.Дата  = Сообщение.ДокументEDI.Дата;
			Док.ДатаВходящегоДокумента  = Сообщение.ДокументEDI.Дата;
			Док.НомерВходящегоДокумента = Сообщение.ДокументEDI.Номер;
			Док.КодСпособаВыставления = 2;
			
		Иначе
			
			Док.ДатаВходящегоДокумента	= Сообщение.ДокументEDI.Дата;
			Док.НомерВходящегоДокумента = Сообщение.ДокументEDI.Номер;
			
		КонецЕсли;
		
		Если ПеременнаяСодержитСвойство(Док, "КодСпособаПолучения") Тогда
			
			// Электронно
			Док.КодСпособаПолучения = 2; 
			
		КонецЕсли;
		
		УстановитьПризнакОбменДаннымиВДокументе_КонтурEDI(Док);
		
		Док.Записать();
		
		Возврат Док.Ссылка;
		
	КонецЕсли;
	
КонецФункции

Функция ОпределитьДатуПоставки(Сообщение,ВходящийЗаказ=Неопределено)
	
	// Используется при подготовке ORDRSP, DESADV, INVOIC, COINVOIC на стороне поставщика
	// "ВходящийЗаказ" - передается только для ORDRSP
	
	ТипСообщения = Сообщение.ТипСообщения;
	
	// Все что найдем, будем заполнять в эту структуру.	
	ДатыПоставки = Новый Структура; 
	
	// Узнаем цепочку с партнером, получим структуру
	ФлагиСообщений = ПолучитьСписокСвойствEDI("ORDERS_Входящее,ORDRSP_Исходящее,DESADV_Исходящее,RECADV_Входящее", Сообщение.Партнер);
	
	// постараемся определить все возможные даты поставки, из которых дальше выберем какую-то одну
	// для начала пройдемся по сообщениям в базе
	ТекстЗапросаЗаказы = "ВЫБРАТЬ
	|	КонтурEDI_Сообщения.ДатаПоставки КАК ДатаПоставки,
	|	КонтурEDI_Сообщения.ТипСообщения
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|ГДЕ
	|	КонтурEDI_Сообщения.Документ = &ДокументЗаказ
	|	И (КонтурEDI_Сообщения.ТипСообщения = ""ORDRSP""
	|				И КонтурEDI_Сообщения.Направление = ""Исходящее""
	|			ИЛИ КонтурEDI_Сообщения.ТипСообщения = ""ORDERS""
	|				И КонтурEDI_Сообщения.Направление = ""Входящее"")";
	
	ТекстЗапросаОбъединение = "
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|";
	
	ТекстЗапросаНакладные = "ВЫБРАТЬ 
	|	КонтурEDI_Сообщения.ДатаПоставки КАК ДатаПоставки,
	|	КонтурEDI_Сообщения.ТипСообщения
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|ГДЕ
	|	КонтурEDI_Сообщения.Документ = &ДокументНакладная
	|	И (КонтурEDI_Сообщения.ТипСообщения = ""DESADV""
	|				И КонтурEDI_Сообщения.Направление = ""Исходящее""
	|			ИЛИ КонтурEDI_Сообщения.ТипСообщения = ""RECADV""
	|				И КонтурEDI_Сообщения.Направление = ""Входящее"")";		
		
	Если ТипСообщения = "ORDRSP" Тогда
		
		Если ЗначениеЗаполнено(ВходящийЗаказ.ДатаПоставки) Тогда
			ДатыПоставки.Вставить("ORDERS", ВходящийЗаказ.ДатаПоставки);
		КонецЕсли;
		
	ИначеЕсли ТипСообщения = "RETREC" Тогда
		
		СообщениеRETDES = ПрочитатьСообщение(, Сообщение.ДокументСсылка, "RETDES", "Входящее");
		
		Если СообщениеRETDES <> Неопределено
			И ЗначениеЗаполнено(СообщениеRETDES.ДатаПоставки) Тогда 
			ДатыПоставки.Вставить("RETDES", СообщениеRETDES.ДатаПоставки);
		КонецЕсли;

	ИначеЕсли ТипСообщения = "RETINS" Тогда
		
		СообщениеRETANN = ПрочитатьСообщение(, Сообщение.ДокументСсылка, "RETANN", "Входящее");
		
		Если СообщениеRETANN <> Неопределено
			И ЗначениеЗаполнено(СообщениеRETANN.ДатаПоставки) Тогда 
			ДатыПоставки.Вставить("RETANN", СообщениеRETANN.ДатаПоставки);
		КонецЕсли;
		
	ИначеЕсли СтрСодержит_КонтурEDI("DESADV,INVOIC,COINVOIC", ТипСообщения) Тогда
		
		ЗапросДатыПоставки = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
	
		// поищем дату поставки в сообщениях документу прямо в базе.
		Если (ФлагиСообщений.ORDERS_Входящее = Истина ИЛИ ФлагиСообщений.ORDRSP_Исходящее = Истина)
			И ЗначениеЗаполнено(Сообщение.Заказ1С) Тогда
			
			ЗапросДатыПоставки.Текст = ТекстЗапросаЗаказы;
			ЗапросДатыПоставки.УстановитьПараметр("ДокументЗаказ", ПреобразоватьЗначениеДляВнешнегоХранилища(Сообщение.Заказ1С));
			
		КонецЕсли;	
		Если ТипСообщения = "INVOIC" ИЛИ ТипСообщения = "COINVOIC"
			И (ФлагиСообщений.DESADV_Исходящее = Истина ИЛИ ФлагиСообщений.RECADV_Входящее = Истина) 
			И ЗначениеЗаполнено(Сообщение.Накладная1С) Тогда
			
			Если ЗначениеЗаполнено(ЗапросДатыПоставки.Текст) Тогда
				ЗапросДатыПоставки.Текст = ЗапросДатыПоставки.Текст + ТекстЗапросаОбъединение + ТекстЗапросаНакладные;
			Иначе
				ЗапросДатыПоставки.Текст = ТекстЗапросаНакладные;
			КонецЕсли;
			ЗапросДатыПоставки.УстановитьПараметр("ДокументНакладная", ПреобразоватьЗначениеДляВнешнегоХранилища(Сообщение.Накладная1С));
			
		КонецЕсли;
		Если ЗначениеЗаполнено(ЗапросДатыПоставки.Текст) Тогда			
			
			Выборка = ЗапросДатыПоставки.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Если ЗначениеЗаполнено(Выборка.ДатаПоставки) Тогда
					ДатыПоставки.Вставить(Выборка.ТипСообщения, Выборка.ДатаПоставки);

				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Еще постараемся поискать дату поставки в реквизитах документа.
	// Обычно она там присутствует, только называется по-разному.
	ДокументДляПоискаДатыПоставки = ?(ТипСообщения = "ORDRSP", Сообщение.ДокументСсылка, Сообщение.Заказ1С);
	
	Если ЗначениеЗаполнено(ДокументДляПоискаДатыПоставки) Тогда
		
		Для Каждого ВариантНазвания Из EDI_РазложитьСтрокуВМассивСлов("ДатаОтгрузки,СрокПоставки", ",") Цикл
			
			Если ЕстьРеквизитОбъекта_Контур(ДокументДляПоискаДатыПоставки, ВариантНазвания) Тогда
				ДатаПоставкиВДокументе = ДокументДляПоискаДатыПоставки[ВариантНазвания];
				Если ЗначениеЗаполнено(ДатаПоставкиВДокументе) Тогда
					ДатыПоставки.Вставить("Документ", ДатаПоставкиВДокументе);
				КонецЕсли;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		//Вызов подключаемого модуля, если имя реквизита даты отгрузки в базе называется иначе. Возвращать дату
		ПараметрыСобытияПодключаемогоМодуля = Новый Структура;
		ПараметрыСобытияПодключаемогоМодуля.Вставить("Документ", ДокументДляПоискаДатыПоставки);
		ПараметрыСобытияПодключаемогоМодуля.Вставить("ИмяРеквизита", "ДатаОтгрузки");
		ПараметрыСобытияПодключаемогоМодуля.Вставить("Сообщение", Сообщение);  
		
		ДатаОтгрузкиВДокументе = ОбработкаСобытияПодключаемогоМодуля(
		"ПолучитьРеквизитДокументаДляСообщения",, ПараметрыСобытияПодключаемогоМодуля);
		
		Если ЗначениеЗаполнено(ДатаОтгрузкиВДокументе) Тогда       
			ДатыПоставки.Вставить("Документ", ДатаОтгрузкиВДокументе);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипСообщения = "RETREC"
		И ДатыПоставки.Свойство("RETDES") Тогда
		Возврат ДатыПоставки.RETDES;
	ИначеЕсли ТипСообщения = "RETINS"
		И ДатыПоставки.Свойство("RETANN") Тогда
		Возврат ДатыПоставки.RETANN;
	КонецЕсли;
	
	// Теперь выберем нужную дату из всех возможных.
	// Для DESADV, INVOIC, COINVOIC сначала попробуем взять из предыдущего сообщения в цепочке.
	Если ДатыПоставки.Свойство("RECADV") Тогда
		Возврат ДатыПоставки.RECADV;
	ИначеЕсли ДатыПоставки.Свойство("DESADV") Тогда
		Возврат ДатыПоставки.DESADV;
	ИначеЕсли ДатыПоставки.Свойство("ORDRSP") Тогда
		Возврат ДатыПоставки.ORDRSP;
	Иначе
		// Если не нашли предыдущие сообщения в цепочке, сравниваем дату в ORDERS и Документе
		Если ДатыПоставки.Свойство("ORDERS") И ДатыПоставки.Свойство("Документ") Тогда
			Если НачалоДня(ДатыПоставки.ORDERS) = НачалоДня(ДатыПоставки.Документ) Тогда
				// если они равны (в пределах дня), то выдаем дату в сообщении, т.к. она может содержать еще время.
				Возврат ДатыПоставки.ORDERS;
			Иначе
				// иначе - в документе.
				Возврат ДатыПоставки.Документ;
			КонецЕсли;
		ИначеЕсли ДатыПоставки.Свойство("Документ") Тогда
			// есть дата поставки в специальном реквизите документа документа 1С
			Возврат ДатыПоставки.Документ;
			
		ИначеЕсли ДатыПоставки.Свойство("ORDERS") Тогда
			// есть дата поставки есть в сообщении ORDERS, а в документе 1С отсутствует, тогда берем из сообщения ORDERS
			Возврат ДатыПоставки.ORDERS;
			
		Иначе
			Если ТипСообщения = "ORDRSP" Тогда
				// для ORDRSP дата заказа в общем случае не равна дате отгрузки. Вернем пустую дату
				Возврат Дата(1, 1, 1);			
			Иначе
				// Не нашли никаких подходящих дат, вернем просто дату документа
				Возврат НачалоДня(Сообщение.ДокументСсылка.Дата);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Функция УдалитьПрефиксыИзНомераОбъекта_КонтурEDI(Номер) Экспорт
	
	НомерБезПрефиксов = Номер;	
	
	Если ЕстьНеобходимыеМетаданные("ОбщиеМодули.ПрефиксацияОбъектовКлиентСервер") Тогда
		
		ИспользуемыйМодуль = Вычислить("ПрефиксацияОбъектовКлиентСервер");
		
		Попытка
			УдалитьПрефиксОрганизации = Истина;
			УдалитьПрефиксИнформационнойБазы = Истина;
			НомерБезПрефиксов = ИспользуемыйМодуль.УдалитьПользовательскиеПрефиксыИзНомераОбъекта(НомерБезПрефиксов);
			НомерБезПрефиксов = ИспользуемыйМодуль.УдалитьПрефиксыИзНомераОбъекта(НомерБезПрефиксов, УдалитьПрефиксОрганизации, УдалитьПрефиксИнформационнойБазы);
		Исключение
			ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось удалить префиксы из номера - " + ОписаниеОшибки());		
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат НомерБезПрефиксов;
	
КонецФункции

Функция НайтиИПолучитьНакладную(Сообщение) Экспорт
	
	//Определимся с типами документов
	Тип_ORDERS = ПолучитьТипЗначенияОбъекта("ВходящийЗаказПокупателя",,Истина);
	Тип_ORDRSP = ПолучитьТипЗначенияОбъекта("ИсходящийОтветНаЗаказ",,Истина);
	Тип_DESADV = ПолучитьТипЗначенияОбъекта("ИсходящееУведомлениеОбОтгрузке",,Истина);
	
	ЗаказЗагружаетсяВРеализацию = (Тип_ORDERS = Тип_DESADV);
	
	//заполним список контрагентов, по которым будем искать накладную
	Если ТаблицаКэшПартнеровКонтрагентов=Неопределено Тогда
	    ОбновитьКэшПартнеров(ОпределитьКемМыЯвляемся(Сообщение));
	КонецЕсли;
	
	СтрокиКонтрагентов = ТаблицаКэшПартнеровКонтрагентов.НайтиСтроки(Новый Структура("Партнер",Сообщение.Партнер));
	МассивКонтрагентов = Новый Массив;
	Для Каждого Стр Из СтрокиКонтрагентов Цикл
		МассивКонтрагентов.Добавить(Стр.Контрагент);
	КонецЦикла;	
	
	НайденныйДокумент = Неопределено;
	НайденныйЗаказПоORDERS = Неопределено;
	
	НайденнаяНакладнаяПоORDERS = Неопределено;
	НайденнаяНакладнаяПоDESADV = Неопределено;
	
	НомерЗаказа 	= Сообщение.ЗаказEDI.Номер; 
	ДатаЗаказа 		= Сообщение.ЗаказEDI.Дата;
	
	НомерНакладной 				= Сообщение.НакладнаяEDI.Номер;
	НомерНакладнойБезПрефиксов 	= УдалитьПрефиксыИзНомераОбъекта_КонтурEDI(НомерНакладной);	
	ДатаНакладной 				= Сообщение.НакладнаяEDI.Дата;
	
	ИмяРеквизитаКонтрагентВНакладной = "Контрагент";
	Если Не ЕстьНеобходимыеМетаданные("Документы." + Тип_DESADV + ".Реквизиты.Контрагент") Тогда
		ИмяРеквизитаКонтрагентВНакладной = ПолучитьИмяРеквизитаВладельцаПоИмениТипа("ИсходящееУведомлениеОбОтгрузке", "ЮрФизЛицоСтороннее");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомерЗаказа) Тогда
		
		//ищем накладную по номеру и дате ORDERS *********************************************************************

		//находим документ-заказ по номеру и дате ORDERS и устанавливаем приоритет поиска:
		//5 - заказ найден по дате и номеру 
		//4 - заказ найден по дате и частичному совпадению номера
		//3 - заказ найден по номеру среди документов за последние 2 месяца
		//2 - заказ найден по частичному совпадению номера среди документов за последние 2 месяца
		
		//К сожалению, старые версии платформы содержат ошибку при попытке упорядочить таблицу по полю, являющемуся константой
		//10091717  (SW633006)  Константное выражение в УПОРЯДОЧИТЬ ПО
		//А поскольку некоторые пользователи не хотят обновлять платформу, то для них пришлось делать костыль и закидывать весь результат запроса в ВТДокументы и упорядочивать уже ее.
		
		ЗапросЗаказы = ИнициализироватьЗапрос_КонтурEDI();
		
		ЗапросЗаказы.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА НЕ &ДатаЗаказа = ДАТАВРЕМЯ(1, 1, 1)
		|				И КонтурEDI_Сообщения.НомерДокумента = &НомерЗаказа
		|				И НАЧАЛОПЕРИОДА(КонтурEDI_Сообщения.ДатаДокумента, ДЕНЬ) = НАЧАЛОПЕРИОДА(&ДатаЗаказа, ДЕНЬ)
		|			ТОГДА 5
		|		КОГДА НЕ &ДатаЗаказа = ДАТАВРЕМЯ(1, 1, 1)
		|				И КонтурEDI_Сообщения.НомерДокумента ПОДОБНО ""%"" + &НомерЗаказа
		|				И НАЧАЛОПЕРИОДА(КонтурEDI_Сообщения.ДатаДокумента, ДЕНЬ) = НАЧАЛОПЕРИОДА(&ДатаЗаказа, ДЕНЬ)
		|			ТОГДА 4
		|		КОГДА &ДатаЗаказа = ДАТАВРЕМЯ(1, 1, 1)
		|				И КонтурEDI_Сообщения.НомерДокумента = &НомерЗаказа
		|			ТОГДА 3
		|		КОГДА &ДатаЗаказа = ДАТАВРЕМЯ(1, 1, 1)
		|				И КонтурEDI_Сообщения.НомерДокумента ПОДОБНО ""%"" + &НомерЗаказа
		|			ТОГДА 2
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Приоритет,
		|	ВЫБОР
		|		КОГДА КонтурEDI_Сообщения.Документ ССЫЛКА Документ.ЗаказПокупателя
		|			ТОГДА ВЫРАЗИТЬ(КонтурEDI_Сообщения.Документ КАК Документ.ЗаказПокупателя)
		|		КОГДА КонтурEDI_Сообщения.Документ ССЫЛКА Документ.РеализацияТоваровУслуг
		|			ТОГДА ВЫРАЗИТЬ(КонтурEDI_Сообщения.Документ КАК Документ.РеализацияТоваровУслуг)
		|		ИНАЧЕ КонтурEDI_Сообщения.Документ
		|	КОНЕЦ КАК ДокументЗаказ,
		|	ВЫБОР
		|		КОГДА КонтурEDI_Сообщения.Документ ССЫЛКА Документ.ЗаказПокупателя
		|			ТОГДА ВЫРАЗИТЬ(КонтурEDI_Сообщения.Документ КАК Документ.ЗаказПокупателя)
		|		КОГДА КонтурEDI_Сообщения.Документ ССЫЛКА Документ.РеализацияТоваровУслуг
		|			ТОГДА ВЫРАЗИТЬ(КонтурEDI_Сообщения.Документ КАК Документ.РеализацияТоваровУслуг)
		|		ИНАЧЕ КонтурEDI_Сообщения.Документ
		|	КОНЕЦ КАК КоличествоДокументов,
		|	КонтурEDI_Сообщения.НомерДокумента
		|ПОМЕСТИТЬ ВТСообщения
		|ИЗ
		|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
		|ГДЕ
		|	КонтурEDI_Сообщения.ТипСообщения = ""ORDERS""
		|	И НЕ КонтурEDI_Сообщения.ПометкаУдаления
		|	И КонтурEDI_Сообщения.ДатаДокумента > НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ТекущаяДата, МЕСЯЦ, &ПериодПоискаНакладной), ДЕНЬ)
		|;
		|	
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ *
		|ПОМЕСТИТЬ ВТДокументы
		|ИЗ
		|	ВТСообщения КАК Сообщения
		|ГДЕ
		|	Сообщения.НомерДокумента = &НомерЗаказа
		|			ИЛИ Сообщения.НомерДокумента ПОДОБНО ""%"" + &НомерЗаказа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТДокументы.Приоритет КАК Приоритет,
		|	ВТДокументы.ДокументЗаказ КАК ДокументЗаказ,
		|	ВТДокументы.КоличествоДокументов КАК КоличествоДокументов
		|ИЗ
		|	ВТДокументы КАК ВТДокументы
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет УБЫВ
		|ИТОГИ
		|	МАКСИМУМ(ДокументЗаказ),
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КоличествоДокументов)
		|ПО
		|	Приоритет";
		ЗапросЗаказы.УстановитьПараметр("ТекущаяДата", 	ТекущаяДата());
		ЗапросЗаказы.УстановитьПараметр("НомерЗаказа", 	НомерЗаказа);
		ЗапросЗаказы.УстановитьПараметр("ДатаЗаказа", 	ДатаЗаказа);
		
		ПериодПоискаНакладной = ПолучитьКонстантуEDI("ПериодПоискаНакладнойПоДатеДокумента");
		
		Если Не ЗначениеЗаполнено(ПериодПоискаНакладной)
			ИЛИ ТипЗнч(ПериодПоискаНакладной) <> Тип("Число") Тогда
			
			ПериодПоискаНакладной = 2;
			
		КонецЕсли;
		
		ЗапросЗаказы.УстановитьПараметр("ПериодПоискаНакладной", -ПериодПоискаНакладной);
		
		ЗапросЗаказы.Текст = СтрЗаменить(ЗапросЗаказы.Текст,	"Документ.РеализацияТоваровУслуг",			"Документ." + Тип_DESADV);
		ЗапросЗаказы.Текст = СтрЗаменить(ЗапросЗаказы.Текст,	"Документ.ЗаказПокупателя",					"Документ." + Тип_ORDERS);
		
		ВидОбходаЗапроса = ОбходРезультатаЗапроса.ПоГруппировкам;
		
		РезультатЗаказы = ЗапросЗаказы.Выполнить().Выбрать(ВидОбходаЗапроса);
		
		Если РезультатЗаказы.Следующий() Тогда
			Если РезультатЗаказы.Приоритет>0 И РезультатЗаказы.КоличествоДокументов = 1 Тогда
				
				НайденныйЗаказПоORDERS = РезультатЗаказы.ДокументЗаказ;
				
				Если ЗначениеЗаполнено(НайденныйЗаказПоORDERS) Тогда
					Если ЗаказЗагружаетсяВРеализацию Тогда
						НайденнаяНакладнаяПоORDERS = НайденныйЗаказПоORDERS;
					Иначе
						//находим документ-накладную по реквизиту связи с документом-заказ (в типовом варианте "Сделка") и устанавливаем приоритет поиска:
						//5 - накладная найдена по реквизиту связи с документом-заказ, дате и номеру 
						//4 - накладная найдена по реквизиту связи с документом-заказ, дате и частичному совпадению номера
						//3 - накладная найдена по реквизиту связи с документом-заказ, номеру среди документов за последние 2 месяца
						//2 - накладная найдена по реквизиту связи с документом-заказ, частичному совпадению номера среди документов за последние 2 месяца
						//1 - накладная найдена по реквизиту связи с документом-заказ 
						ЗапросНакладные = Новый Запрос;
						ЗапросНакладные.Текст = 
						"ВЫБРАТЬ РАЗРЕШЕННЫЕ
						|	ВЫБОР
						|		КОГДА НЕ &ДатаНакладной = ДАТАВРЕМЯ(1, 1, 1)
						|				И НЕ &НомерНакладной = """"
						|				И НАЧАЛОПЕРИОДА(_РеализацияТоваровУслуг_псевдоним.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&ДатаНакладной, ДЕНЬ)
						|				И _РеализацияТоваровУслуг_псевдоним.Номер = &НомерНакладной
						|			ТОГДА 6
						|		КОГДА НЕ &ДатаНакладной = ДАТАВРЕМЯ(1, 1, 1)
						|				И НЕ &НомерНакладной = """"
						|				И &НомерНакладной ПОДОБНО ""%"" + &НомерНакладной + ""%""
						|				И НАЧАЛОПЕРИОДА(_РеализацияТоваровУслуг_псевдоним.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&ДатаНакладной, ДЕНЬ)
						|			ТОГДА 5
						|		КОГДА НЕ &ДатаНакладной = ДАТАВРЕМЯ(1, 1, 1)
						|				И НЕ &НомерНакладнойБезПрефиксов = """"
						|				И НАЧАЛОПЕРИОДА(_РеализацияТоваровУслуг_псевдоним.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&ДатаНакладной, ДЕНЬ)
						|				И _РеализацияТоваровУслуг_псевдоним.Номер ПОДОБНО ""%"" + &НомерНакладнойБезПрефиксов
						|			ТОГДА 4
						|		КОГДА &ДатаНакладной = ДАТАВРЕМЯ(1, 1, 1)
						|				И НЕ &НомерНакладной = """"
						|				И _РеализацияТоваровУслуг_псевдоним.Номер = &НомерНакладной
						|			ТОГДА 3
						|		КОГДА &ДатаНакладной = ДАТАВРЕМЯ(1, 1, 1)
						|				И НЕ &НомерНакладной = """"
						|				И _РеализацияТоваровУслуг_псевдоним.Номер ПОДОБНО ""%"" + &НомерНакладной + ""%""
						|			ТОГДА 2
						|		КОГДА &ДатаНакладной = ДАТАВРЕМЯ(1, 1, 1)
						|				И &НомерНакладной = """"
						|			ТОГДА 1
						|		ИНАЧЕ 0
						|	КОНЕЦ КАК Приоритет,
						|	_РеализацияТоваровУслуг_псевдоним.Ссылка КАК ДокументНакладная,
						|	_РеализацияТоваровУслуг_псевдоним.Ссылка КАК КоличествоДокументов
						|ПОМЕСТИТЬ ВТДокументы
						|ИЗ
						|	Документ.РеализацияТоваровУслуг КАК _РеализацияТоваровУслуг_псевдоним
						|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК _ЗаказПокупателя_псевдоним
						|		ПО (&УсловиеСвязи_DESADV_ORDERS)
						|			И (НЕ _РеализацияТоваровУслуг_псевдоним.ПометкаУдаления)
						|			И (_РеализацияТоваровУслуг_псевдоним.ИмяРеквизитаКонтрагент В (&МассивКонтрагентов))
						|			И (_РеализацияТоваровУслуг_псевдоним.Дата > НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ТекущаяДата, МЕСЯЦ, -2), ДЕНЬ))
						|			И (_ЗаказПокупателя_псевдоним.Ссылка = &ДокументЗаказ)
						|;
						|
						|////////////////////////////////////////////////////////////////////////////////
						|ВЫБРАТЬ
						|	ВТДокументы.Приоритет КАК Приоритет,
						|	ВТДокументы.ДокументНакладная КАК ДокументНакладная,
						|	ВТДокументы.КоличествоДокументов КАК КоличествоДокументов
						|ИЗ
						|	ВТДокументы КАК ВТДокументы
						|
						|УПОРЯДОЧИТЬ ПО
						|	Приоритет УБЫВ
						|ИТОГИ
						|	МАКСИМУМ(ДокументНакладная),
						|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КоличествоДокументов)
						|ПО
						|	Приоритет";
						ЗапросНакладные.УстановитьПараметр("ТекущаяДата", 					ТекущаяДата());
						ЗапросНакладные.УстановитьПараметр("НомерНакладной", 				НомерНакладной);
						ЗапросНакладные.УстановитьПараметр("НомерНакладнойБезПрефиксов", 	НомерНакладнойБезПрефиксов);
						ЗапросНакладные.УстановитьПараметр("ДатаНакладной", 				ДатаНакладной);
						ЗапросНакладные.УстановитьПараметр("ДокументЗаказ",					НайденныйЗаказПоORDERS);
						ЗапросНакладные.УстановитьПараметр("МассивКонтрагентов",			МассивКонтрагентов);
						
						ТаблицаСоединенийДокументов = ПолучитьТаблицуДляСборкиЗапросов("Поставщик");
						СтрокаДокументаORDERS = ТаблицаСоединенийДокументов.Найти(Тип_ORDERS,"ТипДокумента");
						СтрокаДокументаDESADV = ТаблицаСоединенийДокументов.Найти(Тип_DESADV,"ТипДокумента");
						
						// определим условие связи DESADV - ORDERS
						Если Тип_ORDERS = Тип_ORDRSP
							ИЛИ Тип_DESADV = Тип_ORDRSP Тогда
							
							ЗапросНакладные.Текст = СтрЗаменить(ЗапросНакладные.Текст,	"Документ.ЗаказПокупателя",	СтрокаДокументаORDERS.ИмяТаблицы);
							УсловиеСвязи_DESADV_ORDERS = СтрокаДокументаORDERS.СоединениеСоСледующейТаблицей;
							
						Иначе
							СтрокаДокументаORDRSP = ТаблицаСоединенийДокументов.Найти(Тип_ORDRSP, "ТипДокумента");
							ЗапросНакладные.Текст = СтрЗаменить(ЗапросНакладные.Текст,
																"ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК _ЗаказПокупателя_псевдоним",
																"ВНУТРЕННЕЕ СОЕДИНЕНИЕ " + СтрокаДокументаORDRSP.ИмяТаблицы + " КАК " + СтрокаДокументаORDRSP.ПсевдонимТаблицы + Символы.ПС
																+ "			ВНУТРЕННЕЕ СОЕДИНЕНИЕ " + СтрокаДокументаORDERS.ИмяТаблицы + " КАК " + СтрокаДокументаORDERS.ПсевдонимТаблицы + Символы.ПС
																+ "			ПО (" + СтрокаДокументаORDERS.СоединениеСоСледующейТаблицей + ")");
							УсловиеСвязи_DESADV_ORDERS = СтрокаДокументаORDRSP.СоединениеСоСледующейТаблицей; 	
						КонецЕсли;
						
						ЗапросНакладные.Текст = СтрЗаменить(ЗапросНакладные.Текст,	"_ЗаказПокупателя_псевдоним",			СтрокаДокументаORDERS.ПсевдонимТаблицы);
						ЗапросНакладные.Текст = СтрЗаменить(ЗапросНакладные.Текст,	"&УсловиеСвязи_DESADV_ORDERS",			УсловиеСвязи_DESADV_ORDERS);
						ЗапросНакладные.Текст = СтрЗаменить(ЗапросНакладные.Текст,	"Документ.РеализацияТоваровУслуг",		СтрокаДокументаDESADV.ИмяТаблицы);
						ЗапросНакладные.Текст = СтрЗаменить(ЗапросНакладные.Текст,	"_РеализацияТоваровУслуг_псевдоним",	СтрокаДокументаDESADV.ПсевдонимТаблицы);
						ЗапросНакладные.Текст = СтрЗаменить(ЗапросНакладные.Текст,  "ИмяРеквизитаКонтрагент",				ИмяРеквизитаКонтрагентВНакладной);
						
						РезультатНакладные = ЗапросНакладные.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
						Если РезультатНакладные.Следующий() Тогда
							Если РезультатНакладные.Приоритет > 0 
								И РезультатНакладные.КоличествоДокументов = 1 Тогда
								НайденнаяНакладнаяПоORDERS = РезультатНакладные.ДокументНакладная;	
							КонецЕсли;									
						КонецЕсли;
					КонецЕсли;				
				КонецЕсли;			
			КонецЕсли;
		КонецЕсли;
	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомерНакладной) Тогда
		
		//ищем накладную по номеру и дате DESADV *********************************************************************
		
		//находим документ-накладную по номеру и дате DESADV и устанавливаем приоритет поиска:
		//5 - накладная найдена дате и номеру 
		//4 - накладная найдена дате и частичному совпадению номера
		//3 - накладная найдена номеру среди документов за последние 2 месяца
		//2 - накладная найдена частичному совпадению номера среди документов за последние 2 месяца
		ЗапросНакладные = Новый Запрос;
		ЗапросНакладные.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА НЕ &ДатаНакладной = ДАТАВРЕМЯ(1, 1, 1)
		|				И РеализацияТоваровУслуг.Номер = &НомерНакладной
		|				И НАЧАЛОПЕРИОДА(РеализацияТоваровУслуг.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&ДатаНакладной, ДЕНЬ)
		|			ТОГДА 6
		|		КОГДА НЕ &ДатаНакладной = ДАТАВРЕМЯ(1, 1, 1)
		|				И РеализацияТоваровУслуг.Номер ПОДОБНО ""%"" + &НомерНакладной
		|				И НАЧАЛОПЕРИОДА(РеализацияТоваровУслуг.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&ДатаНакладной, ДЕНЬ)
		|			ТОГДА 5
		|		КОГДА НЕ &ДатаНакладной = ДАТАВРЕМЯ(1, 1, 1)
		|				И РеализацияТоваровУслуг.Номер ПОДОБНО ""%"" + &НомерНакладнойБезПрефиксов
		|				И НАЧАЛОПЕРИОДА(РеализацияТоваровУслуг.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&ДатаНакладной, ДЕНЬ)
		|			ТОГДА 4
		|		КОГДА &ДатаНакладной = ДАТАВРЕМЯ(1, 1, 1)
		|				И РеализацияТоваровУслуг.Номер = &НомерНакладной
		|			ТОГДА 3
		|		КОГДА &ДатаНакладной = ДАТАВРЕМЯ(1, 1, 1)
		|				И РеализацияТоваровУслуг.Номер ПОДОБНО ""%"" + &НомерНакладной
		|			ТОГДА 2
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Приоритет,
		|	РеализацияТоваровУслуг.Ссылка КАК ДокументНакладная,
		|	РеализацияТоваровУслуг.Ссылка КАК КоличествоДокументов,
		|	РеализацияТоваровУслуг.Номер КАК Номер
		|ПОМЕСТИТЬ ВТНакладные
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|ГДЕ
		|	НЕ РеализацияТоваровУслуг.ПометкаУдаления
		|	И РеализацияТоваровУслуг.ИмяРеквизитаКонтрагент В(&МассивКонтрагентов)
		|	И РеализацияТоваровУслуг.Дата > НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ТекущаяДата, МЕСЯЦ, -2), ДЕНЬ)
		|;
		|	
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ *
		|ПОМЕСТИТЬ ВТДокументы
		|ИЗ
		|	ВТНакладные КАК Накладные
		|ГДЕ
		|	Накладные.Номер = &НомерНакладной
		|			ИЛИ Накладные.Номер ПОДОБНО ""%"" + &НомерНакладной
		|			ИЛИ Накладные.Номер ПОДОБНО ""%"" + &НомерНакладнойБезПрефиксов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТДокументы.Приоритет КАК Приоритет,
		|	ВТДокументы.ДокументНакладная КАК ДокументНакладная,
		|	ВТДокументы.КоличествоДокументов КАК КоличествоДокументов
		|ИЗ
		|	ВТДокументы КАК ВТДокументы
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет УБЫВ
		|ИТОГИ
		|	МАКСИМУМ(ДокументНакладная),
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КоличествоДокументов)
		|ПО
		|	Приоритет";
		
		ЗапросНакладные.УстановитьПараметр("ТекущаяДата", 					ТекущаяДата());
		ЗапросНакладные.УстановитьПараметр("НомерНакладной", 				НомерНакладной);
		ЗапросНакладные.УстановитьПараметр("НомерНакладнойБезПрефиксов", 	НомерНакладнойБезПрефиксов);
		ЗапросНакладные.УстановитьПараметр("ДатаНакладной", 				ДатаНакладной);
		ЗапросНакладные.УстановитьПараметр("МассивКонтрагентов",			МассивКонтрагентов);
		
		ЗапросНакладные.Текст = СтрЗаменить(ЗапросНакладные.Текст, "Документ.РеализацияТоваровУслуг", "Документ." + Тип_DESADV);
		ЗапросНакладные.Текст = СтрЗаменить(ЗапросНакладные.Текст, "ИмяРеквизитаКонтрагент", ИмяРеквизитаКонтрагентВНакладной);
						
		РезультатНакладные = ЗапросНакладные.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Если РезультатНакладные.Следующий() Тогда
			Если РезультатНакладные.Приоритет > 0 
				И РезультатНакладные.КоличествоДокументов = 1 Тогда
				НайденнаяНакладнаяПоDESADV = РезультатНакладные.ДокументНакладная;	
			КонецЕсли;									
		КонецЕсли;

	КонецЕсли;

	//нашли какую-то накладную по ORDERS и/или какую-то по DESADV
	//если нашлись обе, и они совпадают, то это именно нужная накладная
	//если нашлась только одна, то ее и вернем
	Если ЗначениеЗаполнено(НайденнаяНакладнаяПоORDERS) и ЗначениеЗаполнено(НайденнаяНакладнаяПоDESADV) Тогда
		
		Если НайденнаяНакладнаяПоORDERS = НайденнаяНакладнаяПоDESADV Тогда
			НайденныйДокумент = НайденнаяНакладнаяПоORDERS;
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(НайденнаяНакладнаяПоORDERS) Тогда
		
		НайденныйДокумент = НайденнаяНакладнаяПоORDERS;	
		
	ИначеЕсли ЗначениеЗаполнено(НайденнаяНакладнаяПоDESADV) Тогда
		
		НайденныйДокумент = НайденнаяНакладнаяПоDESADV;
		
	КонецЕсли;
	
	Возврат НайденныйДокумент;
	
КонецФункции

// служебные процедуры и функции
Функция ПринятьОбратныйЗаказПоставщика_УФ(Сообщение,ПервоначальнаяЗагрузкаСообщения = Истина)
	
	НеПриниматьОбратныйЗаказ = 
	Сообщение = Неопределено ИЛИ
	(ПервоначальнаяЗагрузкаСообщения И ИмяКонфигурации1С = "УФ_БП");
	
	Если НеПриниматьОбратныйЗаказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИД = СокрЛП(Сообщение.ID);
			
	флУчитыватьНДС		= Истина;
	флСуммаВключаетНДС	= Истина;
	
	ДоговорКонтрагента = Сообщение.Договор;
	Если ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
		УстановитьЗначениеСвойстваОбъекта(Сообщение.Покупатель1С, "GUIDДоговораПоУмолчанию", СокрЛП(ДоговорКонтрагента.УникальныйИдентификатор()));
	КонецЕсли;
	
	ТипДокументаЗаказ = ПолучитьТипЗначенияОбъекта("ВходящийОбратныйЗаказ",,Истина);
	
	НовыйДокумент = Документы[ТипДокументаЗаказ].СоздатьДокумент();
	
	ИмяТабличнойЧастиТовары 		= "Товары";
	ИмяРеквизитаКоличество			= "КоличествоУпаковок";
	ИмяРеквизитаСуммаВключаетНДС    = "ЦенаВключаетНДС";
	ИмяРеквизитаСклад				= "Склад"; 
	
	Если ИмяКонфигурации1С = "УФ_УНФ" Тогда 
		ИмяТабличнойЧастиТовары 		= "Запасы";
		ИмяРеквизитаКоличество 			= "Количество";
		ИмяРеквизитаСуммаВключаетНДС 	= "НДСВключатьВСтоимость";
		ИмяРеквизитаСклад				= "СтруктурнаяЕдиница";
	КонецЕсли;	
	
	НовыйДокумент[ИмяРеквизитаСуммаВключаетНДС] = флСуммаВключаетНДС;
	
	НовыйДокумент.Дата = ТекущаяДата();
	
	НовыйДокумент.Организация			= Сообщение.Покупатель1С;
	НовыйДокумент.Контрагент			= Сообщение.Продавец1С;  
	НовыйДокумент[ИмяРеквизитаСклад] 	= Сообщение.Грузополучатель1С;
	НовыйДокумент.Договор 				= ДоговорКонтрагента; 
	
	Если ИмяКонфигурации1С = "УФ_УНФ" Тогда
		Если НЕ ЗначениеЗаполнено(НовыйДокумент.СтруктурнаяЕдиница) Тогда 
				НовыйДокумент.СтруктурнаяЕдиница 	= ПолучитьКонстантуEDI("СоздаваемыйДокументСклад");
		КонецЕсли;
		//Получает первое значение по бизнес логике	
		ОбщийМодуль_ЗаполнениеОбъектовУНФ = Неопределено;
		Если ЕстьРеквизитОбъекта_Контур(НовыйДокумент,"СостояниеЗаказа")
			И ЕстьОбщийМодуль1С_КонтурEDI("ЗаполнениеОбъектовУНФ",ОбщийМодуль_ЗаполнениеОбъектовУНФ) Тогда 
			НовыйДокумент.СостояниеЗаказа = ОбщийМодуль_ЗаполнениеОбъектовУНФ.ПолучитьСостояниеЗаказаПоставщику();
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяКонфигурации1С = "УФ_Розница" 
		ИЛИ ИмяКонфигурации1С = "УФ_УНФ" Тогда
		
		НовыйДокумент.ДатаПоступления = Сообщение.ДатаПоставки;
		Если ЕстьРеквизитОбъекта_Контур(НовыйДокумент,"НалогообложениеНДС") Тогда 
			НовыйДокумент.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС;
		КонецЕсли;
		
	Иначе
		НовыйДокумент.Партнер				= НовыйДокумент.Контрагент.Партнер;
		        		
		НовыйДокумент.ЖелаемаяДатаПоступления 	= Сообщение.ДатаПоставки;
		НовыйДокумент.ДатаПервогоПоступления 	= Сообщение.ДатаПоставки;
		НовыйДокумент.ДатаПоступления 			= Сообщение.ДатаПоставки;
		НовыйДокумент.ПоступлениеОднойДатой 	= Истина;
		
		НовыйДокумент.НомерПоДаннымПоставщика 	= Сообщение.ДокументEDI.Номер;
		НовыйДокумент.ДатаПоДаннымПоставщика 	= Сообщение.ДокументEDI.Дата;
		
		НовыйДокумент.Валюта = Сообщение.Валюта1С;
		
		НовыйДокумент.ЗаполнитьУсловияЗакупокПоУмолчанию();
		
		флСуммаВключаетНДС = НовыйДокумент.ЦенаВключаетНДС;
	
	КонецЕсли;

	Кол = 0;
	НовыйДокумент[ИмяТабличнойЧастиТовары].Очистить();
			
	ТабличкаЦен = Неопределено;
	
	Для Каждого Стр Из Сообщение.Товары Цикл
		
		Если Стр.НеЗагружать = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = НовыйДокумент[ИмяТабличнойЧастиТовары].Добавить();
		
		НоваяСтрока.Номенклатура = Стр.Номенклатура;
		
		НоваяСтрока.Характеристика = Стр.ХарактеристикаНоменклатуры;
	
		НоваяСтрока[ИмяРеквизитаКоличество] = Стр.Количество;
		
		Если НЕ ИмяКонфигурации1С = "УФ_УНФ" Тогда
			НоваяСтрока.Упаковка = Стр.ЕдиницаИзмерения; 
			
			Коэффициент = Неопределено;
			ПеременнаяСодержитСвойство(НоваяСтрока.Упаковка, "Коэффициент", Коэффициент); 
			
			ПересчитатьКоличествоВСтрокеУФ_КонтурEDI(Коэффициент, НоваяСтрока, Стр);     
		КонецЕсли; 
				
		ЗаполнитьСтавкуНДСВСтрокеТовараДокумента(Стр, НоваяСтрока, НовыйДокумент.Дата);

		ЗаполнитьНедостающиеПоляСтрокиТоваров(Стр);
		
		Если флСуммаВключаетНДС Тогда
			НоваяСтрока.Цена = Стр.ЦенаСНДС;
			НоваяСтрока.Сумма = Стр.СуммаСНДС;
		Иначе        
			НоваяСтрока.Цена = Стр.ЦенаБезНДС;
			НоваяСтрока.Сумма = Стр.СуммаБезНДС;
		КонецЕсли;	
		
		НоваяСтрока.СуммаНДС = Стр.СуммаНДС;

	КонецЦикла;
	
	Если ИмяКонфигурации1С = "УФ_УТ" Тогда
		
		СтруктураДействий = ПодготовитьСтруктуруДействий_УФ_ЗаказПокупателя(НовыйДокумент);
		
		Попытка
			ОбработкаТабличнойЧастиСервер_ОбработатьТЧ(НовыйДокумент.Товары, СтруктураДействий, Неопределено);
		Исключение
			СтруктураДействий = Неопределено;
		КонецПопытки;
		
	КонецЕсли;	
	
	Комментарий = "";
	Сообщение.Свойство("Комментарий", Комментарий);
	НовыйДокумент.Комментарий = "Загружен из EDI" + ?(СокрЛП(Комментарий) <> "", ": " + Комментарий,"");
	
	УстановитьПризнакОбменДаннымиВДокументе_КонтурEDI(НовыйДокумент);
	
	ОбработкаСобытияПодключаемогоМодуля("ПриЗагрузкеВходящегоСообщения",, Новый Структура("Сообщение,ДокументСсылка",Сообщение,НовыйДокумент));
		
	НовыйДокумент.Записать();
	
	ПроводитьЗаказ = (ПолучитьКонстантуEDI("ПроводитьЗагруженныеОбратныеЗаказы") = Истина) ИЛИ НовыйДокумент.Проведен;
		
	Если ПроводитьЗаказ Тогда
		Попытка
			НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Сообщить("Контур-EDI: Не удалось провести документ "+СокрЛП(Строка(НовыйДокумент)));
		КонецПопытки;
	КонецЕсли;
	
	СсылкаНаДокумент = НовыйДокумент.Ссылка; 		
				
	Возврат СсылкаНаДокумент;
	
КонецФункции

Процедура ПересчитатьКоличествоВСтрокеУФ_КонтурEDI(Коэффициент, НоваяСтрока, Стр)
	
	Если ЗначениеЗаполнено(Коэффициент) Тогда			
		
		НоваяСтрока.Количество = Стр.Количество*Коэффициент;			
		
	ИначеЕсли ОпределитьРелизКонфигурации() = "11.2" Тогда
		
		Попытка
			СтруктураДействий = Новый Структура;
			СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
			ОбработкаТабличнойЧастиСервер_ОбработатьСтрокуТЧ(НоваяСтрока, СтруктураДействий, Неопределено);
		Исключение
			НоваяСтрока.Количество = Стр.Количество;
		КонецПопытки;
		
	Иначе
		
		НоваяСтрока.Количество = Стр.Количество;
		
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьДокументыПоКоторымНужноОтправитьALCRPT()

	Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);

	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_ДополнительныеРеквизиты.Объект КАК Документ
	|ИЗ
	|	РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеРеквизиты
	|ГДЕ
	|	КонтурEDI_ДополнительныеРеквизиты.Свойство = &Свойство
	|	И КонтурEDI_ДополнительныеРеквизиты.Значение = ИСТИНА";
	
	Запрос.УстановитьПараметр("Свойство","НужноОтправитьALCRPT");
	
	// + Внешнее хранилище. kns 2014.09.10
	Если ВнешнееХранилище Тогда
		
		СтруктураКолонокПреобразуемыхВСсылки = Новый Структура("Документ", Новый ОписаниеТипов(ПолучитьТипЗначенияОбъекта("ИсходящееУведомлениеОбОтгрузке")));
		
		Возврат ПолучитьТаблицуИзВнешнейБазы(Запрос.Выполнить().Выгрузить(),СтруктураКолонокПреобразуемыхВСсылки);
	Иначе
		// - Внешнее хранилище. kns 2014.09.10
		
		Возврат Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
	
КонецФункции

Функция ОбработатьСтатусноеСообщение(Сообщение)
	
	Этап			= ВРег(Сообщение.Этап);
	Статус			= ВРег(Сообщение.Статус);
	ТипСообщения	= ВРег(Сообщение.ТипДокумента);
	
	ТипДокумента	= Неопределено;
	
	СообщениеСсылка = Неопределено;
	
	СтатусноеНаОтменуЗаказа = Ложь;
	СтатусноеНаОтменуВозврата = Ложь;
	
	МожноУдалятьСообщение = Ложь;
	
	Если ЗначениеЗаполнено(Сообщение.ID) Тогда
	
		//поищем исходное сообщение и документ, связанный с сообщением
		Если ТипСообщения="ALCRPT" Тогда
			НайденныйДокумент = НайтиОбъектПоЗначениюСвойства(ТипСообщения+"_ID",Сообщение.ID);
		Иначе	
			Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
			
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	КонтурEDI_Сообщения.Ссылка КАК Ссылка,
			|	КонтурEDI_Сообщения.Документ КАК Документ,
			|	КонтурEDI_Сообщения.ТипСообщения КАК ТипСообщения
			|ИЗ
			|   Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения	
			|ГДЕ
			|	КонтурEDI_Сообщения.ID = &ID
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка,
			|	КонтурEDI_Сообщения.Документ,
			|	КонтурEDI_Сообщения.ТипСообщения
			|ИЗ
			|	Справочник.КонтурEDI_Сообщения.ДополнительныеРеквизиты КАК КонтурEDI_СообщенияДополнительныеРеквизиты
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
			|		ПО КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка = КонтурEDI_Сообщения.Ссылка
			|ГДЕ 
			|	КонтурEDI_СообщенияДополнительныеРеквизиты.ИмяРеквизита = ""OriginalId""
			|	И КонтурEDI_СообщенияДополнительныеРеквизиты.Значение = &ID";
			
			Запрос.УстановитьПараметр("ID", Сообщение.ID);
			
			РезультатЗапроса = Запрос.Выполнить();
			Если НЕ РезультатЗапроса.Пустой() Тогда
				
				Выборка = РезультатЗапроса.Выбрать();             
				
				Пока Выборка.Следующий() Цикл
					
					Если Выборка.ТипСообщения = ТипСообщения Тогда 		
						Если ВнешнееХранилище Тогда
							НайденныйДокумент = ЗначениеИзСтрокиВнутр(Выборка.Документ);
							СообщениеСсылка = СоединениеСХранилищем.ЗначениеВСтрокуВнутр(Выборка.Ссылка);
						Иначе
							НайденныйДокумент = Выборка.Документ;
							СообщениеСсылка = Выборка.Ссылка;
						КонецЕсли;		
					ИначеЕсли (Выборка.ТипСообщения = "ORDERS" И ТипСообщения = "ORDRSP") Тогда  // статусное на отмену заказа, когда мы не создали док в 1С
						СтатусноеНаОтменуЗаказа = Истина;
					ИначеЕсли (Выборка.ТипСообщения = "RETDES" И ТипСообщения = "RETREC") Тогда  // статусное на отмену заказа, когда мы не создали док в 1С
						СтатусноеНаОтменуВозврата = Истина;
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
		КонецЕсли;	
	
	КонецЕсли;

	//если не нашли исходное сообщение, то попробуем найти исходный документ по его номеру и дате
	Если НайденныйДокумент = Неопределено Тогда
		
		Если ТипСообщения = "PORDERS" Тогда
			
			ТипДокумента = ПолучитьТипЗначенияОбъекта("ВходящийЗаказПокупателя");
			
		ИначеЕсли ТипСообщения = "ORDERS" Тогда
			
			ТипДокумента = ПолучитьТипЗначенияОбъекта("ИсходящийЗаказПоставщику");
			
		ИначеЕсли ТипСообщения = "ORDRSP" Тогда
			
			ТипДокумента = ПолучитьТипЗначенияОбъекта("ВходящийЗаказПокупателя");
			
		ИначеЕсли ТипСообщения = "DESADV" Тогда	
			
			ТипДокумента = ПолучитьТипЗначенияОбъекта("ИсходящееУведомлениеОбОтгрузке");
			
		ИначеЕсли ТипСообщения = "RECADV" Тогда	
			
			ТипДокумента = ПолучитьТипЗначенияОбъекта("ВходящееУведомлениеОПриемке");
			
		ИначеЕсли ТипСообщения = "INVOIC" Тогда	
			
			ТипДокумента = ПолучитьТипЗначенияОбъекта("ИсходящийСчетФактура");
			
		КонецЕсли;	
		
		Если НЕ ТипДокумента = Неопределено Тогда
			
			ИмяТипа = СтрЗаменить(ТипДокумента,"ДокументСсылка.","");
			
			Если СокрЛП(Сообщение.НомерДокумента) = "" Тогда
				НайденныйДокумент = Неопределено;
			ИначеЕсли Сообщение.ДатаДокумента = Дата(1,1,1) Тогда
				НайденныйДокумент = Документы[ИмяТипа].НайтиПоНомеру(Сообщение.НомерДокумента, ТекущаяДата());
			Иначе
				НайденныйДокумент = Документы[ИмяТипа].НайтиПоНомеру(Сообщение.НомерДокумента, Сообщение.ДатаДокумента);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	
	//Если ничего не смогли найти, то выйдем отсюда сразу
	Если Не ЗначениеЗаполнено(НайденныйДокумент) Тогда
		//вернем еще признак того, можно ли удалять сообщение с FTP/каталога
		
		Если Не ЗначениеЗаполнено(Сообщение.ID) ИЛИ СтатусноеНаОтменуЗаказа ИЛИ СтатусноеНаОтменуВозврата Тогда
			//сообщения без привязки к документу (нет ID) были отправлены в ответ на действия из веба и можно их удалить, т.к в системе не найти связанных
			//а сообщение ORDERS_canceled не сохраняется в базе, поэтому тоже не имеет ID
			
			МожноУдалятьСообщение = Истина;
			
		ИначеЕсли ЗначениеЗаполнено(Сообщение.ПутьКФайлу) Тогда
			// удалить сообщения с датой создания 3 недели назад, если они так и не были обработаны - т.к. их актуальность потеряна
			
			ВремФайл=Новый Файл(Сообщение.ПутьКФайлу);
			Если ВремФайл.Существует() Тогда 
				ВремяСозданияФайла=ВремФайл.ПолучитьВремяИзменения(); //время изменения файла было установлено на время создания на фтп
				Если ВремяСозданияФайла<ТекущаяДата()-60*60*24*21 Тогда
					МожноУдалятьСообщение = Истина;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		//сообщение PriceList пока не привязывается к документу, обработаем здесь его статусное
		Если ТипСообщения = "PRICELIST" ИЛИ (ТипСообщения = "ORDRSP" И СтатусноеНаОтменуЗаказа) ИЛИ (ТипСообщения = "RETREC" И СтатусноеНаОтменуВозврата) Тогда
			Если ЗначениеЗаполнено(СообщениеСсылка) Тогда
				Если Статус = "FAIL" Тогда
					УстановитьСтатусСообщения(СообщениеСсылка,	, ТипСообщения, "ИсходящийОжидаетИсправленияОшибок");
				    СообщениеОбъект = ПолучитьОбъектСообщения(СообщениеСсылка);
					СообщениеОбъект.ОписаниеОшибки = Сообщение.ОписаниеОшибки;
					СохранитьОбъектСообщения(СообщениеОбъект);
				ИначеЕсли Статус = "OK" Тогда
					УстановитьСтатусСообщения(СообщениеСсылка, , ТипСообщения, "ИсходящийДоставлен");
				КонецЕсли;
				МожноУдалятьСообщение = Истина;
			КонецЕсли;			
		КонецЕсли;
		
		СтруктураВозврата = Новый Структура("МожноУдалятьСообщение",МожноУдалятьСообщение);
		Возврат СтруктураВозврата;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденныйДокумент) Тогда
		//документ найден, значит, мы можем обработать статусное и удалить его с FTP
		
		ЭтоСтатусДоставкиINVOICпослеДД = 
		((Этап = "DELIVERY" ИЛИ Этап = "RECEIPTEDBYRECIPIENT") И ТипСообщения = "INVOIC" И ЗначениеЗаполнено(Сообщение.messageId));// поле messageId всегда есть
			
		Если ТипСообщения="ALCRPT" Тогда
			//ALCRPT живут своей жизнью
			Если Статус = "FAIL" Тогда
				
				УстановитьСтатусСообщения(,  НайденныйДокумент, "DESADV", "ИсходящийALCRPTОжидаетИсправленияОшибок");
				
				DESADV = ПрочитатьСообщение(,НайденныйДокумент,"DESADV","Исходящее");
				Если DESADV<>Неопределено Тогда
					СообщениеОбъект = ПолучитьОбъектСообщения(DESADV.СообщениеСсылка);
					СообщениеОбъект.ОписаниеОшибки = Сообщение.ОписаниеОшибки;
					СохранитьОбъектСообщения(СообщениеОбъект);
				КонецЕсли;
				
			Иначе
				Если ПолучитьСтатусСообщения(, НайденныйДокумент, "DESADV") = ПолучитьЗначениеСтатусаСообщения("ИсходящийALCRPTОжидаетИсправленияОшибок") Тогда						
					УстановитьСтатусСообщения(,  НайденныйДокумент, "DESADV", "ИсходящийДоставлен");
				КонецЕсли;	
				УстановитьЗначениеСвойстваОбъекта(НайденныйДокумент, "БылОтправленALCRPT",	Истина);
			КонецЕсли;		
			
		ИначеЕсли Этап = "CONVERTINGTODIADOC" Тогда
			
			
			////проверим, получали ли мы статусное сообщение SIGNINGBYSENDER (torg12Id приходит только в нем) 			
			////torg12Id = СокрЛП(ПолучитьЗначениеСвойстваОбъектаEDI(НайденныйДокумент, "torg12Id"));
			////Если Не ЗначениеЗаполнено(torg12Id) Тогда
				
			// не учитывалась переотправка INVOIC, будем проверять что INVOIC находится в статусе "Отправлен"
			//еще учтем схему MetroOkNotOk, когда сначала приходит статус Checking, а только потом ConvertingToDiadoc 

			ТекущийСтатусСообщения = ПолучитьСтатусСообщения(, НайденныйДокумент, ТипСообщения);
			
			Если ТекущийСтатусСообщения = ПолучитьЗначениеСтатусаСообщения("ИсходящийОтправлен")
				Или ТекущийСтатусСообщения = ПолучитьЗначениеСтатусаСообщения("ИсходящийДоставлен") Тогда
				
				Если Статус = "OK" Тогда
					
					УстановитьСтатусСообщения(,  НайденныйДокумент, ТипСообщения, "ИсходящийСозданВДиадок");
				
					УстановитьЗначениеСвойстваОбъекта(НайденныйДокумент, "boxId",		СокрЛП(Сообщение.boxId));
					УстановитьЗначениеСвойстваОбъекта(НайденныйДокумент, "messageId",	СокрЛП(Сообщение.messageId));
					//свойства torg12Id, invoiceId, universalTransferDocumentEntityId могут отсутствовать, в зависимости от настроек Диадока
					Если Сообщение.Свойство("torg12Id") И ЗначениеЗаполнено(СокрЛП(Сообщение.torg12Id)) Тогда
						УстановитьЗначениеСвойстваОбъекта(НайденныйДокумент, "torg12Id",	СокрЛП(Сообщение.torg12Id));
					КонецЕсли;
					Если Сообщение.Свойство("invoiceId") И ЗначениеЗаполнено(СокрЛП(Сообщение.invoiceId)) Тогда
						УстановитьЗначениеСвойстваОбъекта(НайденныйДокумент, "invoiceId",	СокрЛП(Сообщение.invoiceId));
					КонецЕсли;
					Если Сообщение.Свойство("universalTransferDocumentEntityId") И ЗначениеЗаполнено(СокрЛП(Сообщение.universalTransferDocumentEntityId)) Тогда
						УстановитьЗначениеСвойстваОбъекта(НайденныйДокумент, "UniversalTransferDocumentId",	СокрЛП(Сообщение.universalTransferDocumentEntityId));
					ИначеЕсли Сообщение.Свойство("universalTranferDocumentEntityId") И ЗначениеЗаполнено(СокрЛП(Сообщение.universalTranferDocumentEntityId)) Тогда //опечатка в сервисе
						УстановитьЗначениеСвойстваОбъекта(НайденныйДокумент, "UniversalTransferDocumentId",	СокрЛП(Сообщение.universalTranferDocumentEntityId));
					КонецЕсли;
					Если Сообщение.Свойство("universalCorrectionDocumentEntityId") И ЗначениеЗаполнено(СокрЛП(Сообщение.universalCorrectionDocumentEntityId)) Тогда
						УстановитьЗначениеСвойстваОбъекта(НайденныйДокумент, "UniversalTransferDocumentId",	СокрЛП(Сообщение.universalCorrectionDocumentEntityId));  //складываем в 1 тег
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
				
		ИначеЕсли Этап = "SIGNINGBYSENDER" Тогда
			
			Если Статус = "OK" Тогда
				
				УстановитьСтатусСообщения(,  НайденныйДокумент, ТипСообщения, "ИсходящийПодписанВДиадок");
							
				УстановитьЗначениеСвойстваОбъекта(НайденныйДокумент, "boxId",		СокрЛП(Сообщение.boxId));
				УстановитьЗначениеСвойстваОбъекта(НайденныйДокумент, "messageId",	СокрЛП(Сообщение.messageId));
				//свойства torg12Id, invoiceId, universalTransferDocumentEntityId могут отсутствовать, в зависимости от настроек Диадока
				Если Сообщение.Свойство("torg12Id") И ЗначениеЗаполнено(СокрЛП(Сообщение.torg12Id)) Тогда
					УстановитьЗначениеСвойстваОбъекта(НайденныйДокумент, "torg12Id",	СокрЛП(Сообщение.torg12Id));
				КонецЕсли;
				Если Сообщение.Свойство("invoiceId") И ЗначениеЗаполнено(СокрЛП(Сообщение.invoiceId)) Тогда
					УстановитьЗначениеСвойстваОбъекта(НайденныйДокумент, "invoiceId",	СокрЛП(Сообщение.invoiceId));
				КонецЕсли;
				Если Сообщение.Свойство("universalTransferDocumentEntityId") И ЗначениеЗаполнено(СокрЛП(Сообщение.universalTransferDocumentEntityId)) Тогда
					УстановитьЗначениеСвойстваОбъекта(НайденныйДокумент, "UniversalTransferDocumentId",	СокрЛП(Сообщение.universalTransferDocumentEntityId));
				ИначеЕсли Сообщение.Свойство("universalTranferDocumentEntityId") И ЗначениеЗаполнено(СокрЛП(Сообщение.universalTranferDocumentEntityId)) Тогда //опечатка в сервисе
					УстановитьЗначениеСвойстваОбъекта(НайденныйДокумент, "UniversalTransferDocumentId",	СокрЛП(Сообщение.universalTranferDocumentEntityId));
				КонецЕсли;
				Если Сообщение.Свойство("universalCorrectionDocumentEntityId") И ЗначениеЗаполнено(СокрЛП(Сообщение.universalCorrectionDocumentEntityId)) Тогда
					УстановитьЗначениеСвойстваОбъекта(НайденныйДокумент, "UniversalTransferDocumentId",	СокрЛП(Сообщение.universalCorrectionDocumentEntityId));  //складываем в 1 тег
				КонецЕсли;
				
				GLNСети = Сообщение.Получатель;
				НайденныйПартнер = НайтиОбъектПоЗначениюСвойства("GLN_Партнера",GLNСети); 
				
				Если ЗначениеЗаполнено(НайденныйПартнер) Тогда
					
					ОтправлятьALCRPT = ПолучитьЗначениеСвойстваОбъектаEDI(НайденныйПартнер, "ОтправлятьALCRPTсINVOIC");
					
					Если ОтправлятьALCRPT = Истина Тогда
						Накладная = ПолучитьНакладнуюСчетаФактуры(НайденныйДокумент);
						УстановитьЗначениеСвойстваОбъекта(Накладная, "НужноОтправитьALCRPT",	Истина);
					КонецЕсли;
					
				КонецЕсли;
				
			ИначеЕсли Статус = "FAIL" Тогда
				
				УстановитьСтатусСообщения(,  НайденныйДокумент, ТипСообщения, "ИсходящийОжидаетИсправленияОшибок");
				Если НЕ СообщениеСсылка = Неопределено Тогда
					СообщениеОбъект = ПолучитьОбъектСообщения(СообщениеСсылка);
					СообщениеОбъект.ОписаниеОшибки = "Был удален черновик документов в Диадоке";
					СохранитьОбъектСообщения(СообщениеОбъект);
				КонецЕсли;
				
			КонецЕсли;
				
		ИначеЕсли НЕ ЭтоСтатусДоставкиINVOICпослеДД Тогда
			
			Если Статус = "OK" Тогда
				
				//статусные обрабатываются сервером асинхронно и возможно получение DraftOfDocumentPackagePostedIntoDiadoc 
				//до MessageCheckingOk  EDISUP-398
									
				НайденноеСообщение = НайтиСообщениеДокумента(НайденныйДокумент, ТипСообщения);					
				
				Если ЗначениеЗаполнено(НайденноеСообщение) Тогда

					Если Этап = "SIGNEDBYRECIPIENT" Тогда
						
						ЗаписатьПризнакОтправкиИзвещенияОПолучении(НайденноеСообщение);
						
					КонецЕсли;
					
					// был статус "ИсходящийДоставленСУточнением", заменен, потому что новый интерфейс устанавливает треб. действие "Переотправить"
					ТекущийСтатусСообщения = ПолучитьСтатусСообщения(НайденноеСообщение, , ТипСообщения);
					
					Если ТекущийСтатусСообщения = ПолучитьЗначениеСтатусаСообщения("ИсходящийСозданВДиадок")
						ИЛИ ЭтоБлокирующийСтатусОбработкиСтатусныхСообщенийДляСообщенийДД(ТекущийСтатусСообщения) Тогда
						
						МожноУдалятьСообщение = Истина;
						
						СтруктураВозврата = Новый Структура("МожноУдалятьСообщение", МожноУдалятьСообщение);
						
						Возврат СтруктураВозврата;
						
					КонецЕсли; 			
					
					Если Этап = "CHECKING" Тогда
						
						Если НЕ ТекущийСтатусСообщения = ПолучитьЗначениеСтатусаСообщения("ИсходящийСозданВДиадок")
							И НЕ ЭтоБлокирующийСтатусОбработкиСтатусныхСообщенийДляСообщенийДД(ТекущийСтатусСообщения) Тогда   
	
							УстановитьСтатусСообщения(НайденноеСообщение, НайденныйДокумент, ТипСообщения, "ИсходящееПрошлоПроверку");
							
						КонецЕсли;

						Если ЗначениеЗаполнено(Сообщение.ОписаниеОшибки) Тогда
							Если ТипСообщения = "ORDRSP" ИЛИ ТипСообщения = "DESADV" Тогда
								
								//был статус "ИсходящийДоставленСУточнением", заменен, потому что новый интерфейс устанавливает треб. действие "Переотправить"
								УстановитьСтатусСообщения(НайденноеСообщение,  НайденныйДокумент, ТипСообщения, "ИсходящийДоставлен");   
								
								Если СообщениеСсылка <> Неопределено Тогда
									СообщениеОбъект = ПолучитьОбъектСообщения(СообщениеСсылка);
									СообщениеОбъект.ОписаниеОшибки = Сообщение.ОписаниеОшибки;
									СохранитьОбъектСообщения(СообщениеОбъект);
								КонецЕсли;
								
							КонецЕсли;
						КонецЕсли;
						
					ИначеЕсли Не ТекущийСтатусСообщения = ПолучитьЗначениеСтатусаСообщения("ИсходящийСозданВДиадок") Тогда
						
						УстановитьСтатусСообщения(НайденноеСообщение,  НайденныйДокумент, ТипСообщения, "ИсходящийДоставлен");
						
					КонецЕсли;
					
				КонецЕсли;
				
				GLNСети = Сообщение.Получатель;
				Если ТипСообщения = "DESADV" Тогда
					
					НайденныйПартнер = Неопределено;
					НайденныйПартнер = НайтиОбъектПоЗначениюСвойства("GLN_Партнера",GLNСети); 
					
					Если ЗначениеЗаполнено(НайденныйПартнер) Тогда
						
						ОтправлятьALCRPT 		= ПолучитьЗначениеСвойстваОбъектаEDI(НайденныйПартнер, "ОтправлятьALCRPT");
						ОтправлятьINVOICсDESADV = ПолучитьЗначениеСвойстваОбъектаEDI(НайденныйПартнер, "ОтправлятьINVOICсDESADV");
						
						Если ОтправлятьALCRPT = Истина И Не Этап = "CHECKING" Тогда     //Checking- для нас не является побуждением к отправке ALCRPT
							УстановитьЗначениеСвойстваОбъекта(НайденныйДокумент, "НужноОтправитьALCRPT",	Истина);
						КонецЕсли;
						Если ОтправлятьINVOICсDESADV = Истина Тогда
							
							СчетФактура = ПолучитьСчетФактуруНакладной(НайденныйДокумент);
							Если ЗначениеЗаполнено(СчетФактура) Тогда
								ОтправитьСообщение("INVOIC",СчетФактура);
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;    
				
			ИначеЕсли Статус = "FAIL" Тогда
				
				Если ТипСообщения = "INVOIC" ИЛИ ТипСообщения = "COINVOIC" Тогда
					Если Этап = "PROCESSING" Тогда
						УстановитьСтатусСообщения(,  НайденныйДокумент, ТипСообщения, "ИсходящийОжидаетИсправленияОшибок");
					Иначе
						УстановитьСтатусСообщения(,  НайденныйДокумент, ТипСообщения, "ИсходящийОтказаноВподписиПолучателем");
					КонецЕсли;
				Иначе
					УстановитьСтатусСообщения(,  НайденныйДокумент, ТипСообщения, "ИсходящийОжидаетИсправленияОшибок");
				КонецЕсли;				
								
				Если НЕ СообщениеСсылка = Неопределено Тогда
					СообщениеОбъект = ПолучитьОбъектСообщения(СообщениеСсылка);
					СообщениеОбъект.ОписаниеОшибки = Сообщение.ОписаниеОшибки;
					СохранитьОбъектСообщения(СообщениеОбъект);
				КонецЕсли;
				
			ИначеЕсли Статус = "PARTIALLYOK" Тогда
				
				УстановитьСтатусСообщения(,  НайденныйДокумент, ТипСообщения, "ИсходящийПодписанПолучателемСРазногласиями");
				
				Если НЕ СообщениеСсылка = Неопределено Тогда
					СообщениеОбъект = ПолучитьОбъектСообщения(СообщениеСсылка);
					СообщениеОбъект.ОписаниеОшибки = Сообщение.ОписаниеОшибки;
					СохранитьОбъектСообщения(СообщениеОбъект);
				КонецЕсли;	
			КонецЕсли;	
			
		КонецЕсли;
		
		МожноУдалятьСообщение = Истина;

	КонецЕсли;
	
	СтруктураВозврата = Новый Структура("МожноУдалятьСообщение",МожноУдалятьСообщение);
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ПолучитьИдентификаторыСообщения(СодержимоеСобытия)
	
	Результат = Новый Структура;
	Результат.Вставить("boxId"		, СодержимоеСобытия.ИдентификаторЯщикаВДиадоке);
	Результат.Вставить("messageId"	, СодержимоеСобытия.ИдентификаторСообщенияВДиадоке);
	
	Если СодержимоеСобытия.Свойство("ИдентификаторТорг12") 
		И ЗначениеЗаполнено(СодержимоеСобытия.ИдентификаторТорг12) Тогда
		
		Результат.Вставить("torg12Id", СодержимоеСобытия.ИдентификаторТорг12);
		
	КонецЕсли;
	
	Если СодержимоеСобытия.Свойство("ИдентификаторСчетаФактуры") 
		И ЗначениеЗаполнено(СодержимоеСобытия.ИдентификаторСчетаФактуры) Тогда
		
		Результат.Вставить("invoiceId", СодержимоеСобытия.ИдентификаторСчетаФактуры);
		
	КонецЕсли;
	
	Если СодержимоеСобытия.Свойство("ИдентификаторКорректировочногоСчетаФактуры") 
			И ЗначениеЗаполнено(СодержимоеСобытия.ИдентификаторКорректировочногоСчетаФактуры) Тогда
			
		Результат.Вставить("invoiceId", СодержимоеСобытия.ИдентификаторКорректировочногоСчетаФактуры);
		
	КонецЕсли;
	
	Если СодержимоеСобытия.Свойство("ИдентификаторУПД") 
		И ЗначениеЗаполнено(СодержимоеСобытия.ИдентификаторУПД) Тогда
		
		Результат.Вставить("UniversalTransferDocumentId", СодержимоеСобытия.ИдентификаторУПД);
		
	КонецЕсли;
	
	Если СодержимоеСобытия.Свойство("ИдентификаторУКД") 
		И ЗначениеЗаполнено(СодержимоеСобытия.ИдентификаторУКД) Тогда
		
		Результат.Вставить("UniversalTransferDocumentId", СодержимоеСобытия.ИдентификаторУКД);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//{Работа со статусными сообщениями

//Событие ------------------------------------------------- СтрокаТаблицыЗначений
//  |- ДатаИВремяСобытия ---------------------------------- Дата
//  |- ИдентификаторОрганизации --------------------------- Строка
//  |- ИдентификаторСобытия ------------------------------- Строка
//  |- ИдентификаторЯщика --------------------------------- Строка
//  |- СодержимоеСобытия ---------------------------------- Структура
//       |- МетаинформацияВходящегоСообщения -------------- Структура
//             |- ВнутреннийИдентификаторСообщения -------- Строка
//             |- ДатаИВремяОтправки ---------------------- Дата
//             |- ИдентификаторСообщения ------------------ Строка
//             |- ИдентификаторЯщикаКлиента --------------- Строка
//             |- ИнформацияОДокументе -------------------- Структура
//                  |- ДатаДокумента ---------------------- Дата
//                  |- НомерДокумента --------------------- Строка
//                  |- Тестовый --------------------------- Булево
//                  |- ТипДокумента ----------------------- Строка
//             |- ОтправительСообщения -------------------- Структура
//                  |- GLN -------------------------------- Строка
//                  |- Наименование ----------------------- Строка
//                  |- УникальныйИдентификаторОрганизации - Строка
//             |- ФорматСообщения ------------------------- Строка
//        |- ТипСодержимогоСобытия ------------------------ Строка
//  |- ТипСобытия ----------------------------------------- Строка
//  |- УказательНаСобытие --------------------------------- Строка
Процедура ОбработатьСобытие_NewInboxMessage(Событие, УчетнаяЗапись)
	
	ТипСообщения			  = Врег(Событие.СодержимоеСобытия.МетаинформацияВходящегоСообщения.ИнформацияОДокументе.ТипДокумента);
	ФорматСообщения 		  = Событие.СодержимоеСобытия.МетаинформацияВходящегоСообщения.ФорматСообщения;
	ИдентификаторОрганизации  = Событие.ИдентификаторОрганизации;
	ВнутреннийИдентификаторСообщения = Событие.СодержимоеСобытия.МетаинформацияВходящегоСообщения.ВнутреннийИдентификаторСообщения;
	ИдентификаторЯщикаКлиента = Событие.СодержимоеСобытия.МетаинформацияВходящегоСообщения.ИдентификаторЯщикаКлиента;
	
	Если НЕ ФорматСообщения = "KonturXml" Тогда 
		Сообщить_КонтурEDI("Получено сообщение в неправильном формате. Обратитесь в техподдержку.");
		Возврат;
	КонецЕсли;
	
	Если НЕ МожемОбработатьТипВходящегоСообщения(ТипСообщения) Тогда
		Возврат;
	КонецЕсли;
	
	Сообщение = ПрочитатьСообщениеИзЛенты_КонтурEDI(Событие, УчетнаяЗапись);	
	
	СтруктураПараметров = Новый Структура;
	 
	СтруктураПараметров.Вставить("Сообщение",					Сообщение);
	СтруктураПараметров.Вставить("EventType", 					"NewInboxMessage");
	СтруктураПараметров.Вставить("boxId", 						ИдентификаторЯщикаКлиента);
	СтруктураПараметров.Вставить("УчетнаяЗапись",				УчетнаяЗапись);
	СтруктураПараметров.Вставить("ПрекратитьЗагрузкуСообщения",	Ложь);
	
	ПередОбработкойВходящегоСообщения(СтруктураПараметров);
	
	Если СтруктураПараметров.ПрекратитьЗагрузкуСообщения = Истина Тогда
		Возврат;
	Иначе
		Сообщение = СтруктураПараметров.Сообщение;
	КонецЕсли;

	РезультатСохранения = ОбработатьВходящееСообщение(Сообщение);
	
	Если РезультатСохранения.Свойство("Сообщение") Тогда
		
		// веб-ссылка на сообщение в мониторинге EDI
		СсылкаНаСообщениеВМониторинге = СформироватьСсылкуНаСообщениеВМониторинге(ВнутреннийИдентификаторСообщения, ИдентификаторОрганизации);
		ЗаписатьДопРеквизитСправочника_КонтурEDI(РезультатСохранения.Сообщение.СообщениеСсылка, "СсылкаНаСообщениеВМониторинге", СсылкаНаСообщениеВМониторинге); 
		
		ДействияПослеСохраненияВходящегоСообщения(РезультатСохранения.Сообщение);
	КонецЕсли;	
		
КонецПроцедуры

//Событие ----------------------------------------- СтрокаТаблицыЗначений
//  |- ДатаИВремяСобытия --------------------------- Дата
//  |- ИдентификаторОрганизации -------------------- Строка
//  |- ИдентификаторСобытия ------------------------ Строка
//  |- ИдентификаторЯщика -------------------------- Строка
//  |- СодержимоеСобытия --------------------------- Структура
//     |- МетаинформацияИсходящегоСообщения -- ----- Структура
//      	|- ВнутреннийИдентификаторСообщения ---- Строка
//          |- ИдентификаторСообщения -------------- Строка
//          |- ИдентификаторЯщикаКлиента ----------- Строка
//     |- ОтправительСообщения --------------------- Строка
//     |- ПолучательСообщения ---------------------- Строка
//     |- ТипДокумента ----------------------------- Строка
//     |- ТипСодержимогоСобытия -------------------- Строка
//  |- ТипСобытия ---------------------------------- Строка
//  |- УказательНаСобытие -------------------------- Строка
Процедура ОбработатьСобытие_RecognizeMessage(Событие, УчетнаяЗапись)
	
	ТипСообщения			  = Врег(Событие.СодержимоеСобытия.ТипДокумента);
	
	Если НЕ ТипСообщения = "RECADV" Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторОрганизации  = Событие.ИдентификаторОрганизации;
	ВнутреннийИдентификаторСообщения = Событие.СодержимоеСобытия.МетаинформацияИсходящегоСообщения.ВнутреннийИдентификаторСообщения;
	ИдентификаторЯщикаКлиента = Событие.СодержимоеСобытия.МетаинформацияИсходящегоСообщения.ИдентификаторЯщикаКлиента;
	ИдентификаторСообщения = Событие.СодержимоеСобытия.МетаинформацияИсходящегоСообщения.ИдентификаторСообщения;
	
	РезультатПоискаСообщенийПоID = ПолучитьРезультатПоискаСообщенийПоID(СтрЗаменить(ИдентификаторСообщения,"-","")); 
	
	Если РезультатПоискаСообщенийПоID.ИсходящееСообщениеНайдено Тогда
		Возврат;
	КонецЕсли;
	
	Сообщение = ПрочитатьСообщениеИзЛенты_КонтурEDI(Событие, УчетнаяЗапись); 
	
	СтруктураПараметров = Новый Структура;
	 
	СтруктураПараметров.Вставить("Сообщение",					Сообщение);
	СтруктураПараметров.Вставить("EventType", 					"RecognizeMessage");
	СтруктураПараметров.Вставить("boxId", 						ИдентификаторЯщикаКлиента);
	СтруктураПараметров.Вставить("УчетнаяЗапись",				УчетнаяЗапись);
	СтруктураПараметров.Вставить("ПрекратитьЗагрузкуСообщения",	Истина);
	
	ОбработкаСобытияПодключаемогоМодуля("ПередОбработкойВходящегоСообщения", , СтруктураПараметров);
	
	Если СтруктураПараметров.ПрекратитьЗагрузкуСообщения = Истина Тогда
		Возврат;
	Иначе
		Сообщение = СтруктураПараметров.Сообщение;
	КонецЕсли;

	РезультатСохранения = ОбработатьВходящееСообщение(Сообщение);
	
	Если РезультатСохранения.Свойство("Сообщение") Тогда
		
		// веб-ссылка на сообщение в мониторинге EDI
		СсылкаНаСообщениеВМониторинге = СформироватьСсылкуНаСообщениеВМониторинге(ВнутреннийИдентификаторСообщения, ИдентификаторОрганизации);
		ЗаписатьДопРеквизитСправочника_КонтурEDI(РезультатСохранения.Сообщение.СообщениеСсылка, "СсылкаНаСообщениеВМониторинге", СсылкаНаСообщениеВМониторинге); 
		
		ДействияПослеСохраненияВходящегоСообщения(РезультатСохранения.Сообщение);
	КонецЕсли;	

КонецПроцедуры

//Событие ----------------------------------------- СтрокаТаблицыЗначений
//  |- ДатаИВремяСобытия -------------------------- Дата
//  |- ИдентификаторОрганизации ------------------- Строка
//  |- ИдентификаторСобытия ----------------------- Строка
//  |- ИдентификаторЯщика ------------------------- Строка
//  |- СодержимоеСобытия -------------------------- Структура
//      |- МетаинформацияИсходящегоСообщения ------ Структура
//           |- ВнутреннийИдентификаторСообщения -- Строка
//           |- ИдентификаторСообщения ------------ Строка
//           |- ИдентификаторЯщикаКлиента --------- Строка
//      |- ТипСодержимогоСобытия ------------------ Строка
//  |- ТипСобытия---------------------------------- Строка
//  |- УказательНаСобытие ------------------------- Строка
Процедура ОбработатьСобытие_MessageDelivered(Событие)
	
	IDСообщения = СтрЗаменить(Событие.СодержимоеСобытия.МетаинформацияИсходящегоСообщения.ИдентификаторСообщения,"-", ""); 
	
	РезультатПоискаСообщенийПоID = ПолучитьРезультатПоискаСообщенийПоID(IDСообщения);
	
	ИсходящееСообщениеНайдено = РезультатПоискаСообщенийПоID.ИсходящееСообщениеНайдено;
	ТабНайденныхСообщений     = РезультатПоискаСообщенийПоID.ТабНайденныхСообщений;
	Партнер    				  = РезультатПоискаСообщенийПоID.Партнер;

	Если НЕ ИсходящееСообщениеНайдено Тогда 
		
		НайденныйДокументALCRPT = НайтиОбъектПоЗначениюСвойства("ALCRPT_ID",IDСообщения);
		
		Если НайденныйДокументALCRPT = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Если ПолучитьЗначениеСвойстваОбъектаEDI(Партнер, "ОтправлятьALCRPTсINVOIC") = Истина Тогда
			ТипОтправленногоСообщения = "INVOIC";
			ДокументДляПоискаСообщения = ПолучитьСчетФактуруНакладной(НайденныйДокументALCRPT);
		Иначе
			ТипОтправленногоСообщения = "DESADV";
			ДокументДляПоискаСообщения = НайденныйДокументALCRPT;
		КонецЕсли;
		
		Если ПолучитьСтатусСообщения(, ДокументДляПоискаСообщения, ТипОтправленногоСообщения) = ПолучитьЗначениеСтатусаСообщения("ИсходящийALCRPTОжидаетИсправленияОшибок") Тогда						
			УстановитьСтатусСообщения(,  ДокументДляПоискаСообщения, ТипОтправленногоСообщения, "ИсходящийДоставлен");
		КонецЕсли;	
		
		УстановитьЗначениеСвойстваОбъекта(ДокументДляПоискаСообщения, "БылОтправленALCRPT",	Истина);
		
		Возврат;
		
	КонецЕсли;
	
	Для Каждого СтрокаСообщенияВБазе Из ТабНайденныхСообщений Цикл
		
		СообщениеСсылка		= СтрокаСообщенияВБазе.Ссылка;
		ТипСообщения		= СтрокаСообщенияВБазе.ТипСообщения;
		Документ			= СтрокаСообщенияВБазе.Документ;
		Статус 				= СтрокаСообщенияВБазе.Статус;
		Партнер 			= СтрокаСообщенияВБазе.Партнер;
		
		Если ЭтоТипПодписываемогоДДСообщения(ТипСообщения)
			И ЭтоБлокирующийСтатусОбработкиСтатусныхСообщенийДляСообщенийДД(Статус) Тогда
			
			Возврат;
			
		КонецЕсли;
		
		Если ТипСообщения = "INVOIC" И
			ПолучитьЗначениеСвойстваОбъектаEDI(Партнер, "INVOICОжидатьСтатусноеСообщениеОтСети") = Истина Тогда 
			
			Возврат;
			
		КонецЕсли;
		
		УстановитьСтатусСообщения(СообщениеСсылка, , ТипСообщения, "ИсходящийДоставлен");
		
		//если мы получили статусное на DESADV, то нам стоит еще поставить пометку о необходимости отправки ALCRPT
		Если ТипСообщения = "DESADV" Тогда
			
			Если ПолучитьЗначениеСвойстваОбъектаEDI(Партнер, "ОтправлятьALCRPT") = Истина Тогда
				УстановитьЗначениеСвойстваОбъекта(Документ, "НужноОтправитьALCRPT",	Истина);
			КонецЕсли;
			
			Если ПолучитьЗначениеСвойстваОбъектаEDI(Партнер, "ОтправлятьINVOICсDESADV") = Истина Тогда
				
				СчетФактура = ПолучитьСчетФактуруНакладной(Документ);
				Если ЗначениеЗаполнено(СчетФактура) Тогда
					ОтправитьСообщение("INVOIC", СчетФактура);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

//Событие --------------------------------------------- СтрокаТаблицыЗначений
//  |- ДатаИВремяСобытия ------------------------------ Дата
//  |- ИдентификаторОрганизации ----------------------- Строка
//  |- ИдентификаторСобытия --------------------------- Строка
//  |- ИдентификаторЯщика ----------------------------- Строка
//  |- СодержимоеСобытия ------------------------------ Структура
//       |- МетаинформацияИсходящегоСообщения --------- Структура
//            |- ВнутреннийИдентификаторСообщения ----- Строка
//            |- ИдентификаторСообщения --------------- Строка
//            |-ИдентификаторЯщикаКлиента ------------- Строка
//       |- ПричиныПоКоторымСообщениеНеДоставлено ----- Строка
//       |- ТипСодержимогоСобытия --------------------- Строка
//  |- ТипСобытия -------------------------------------	Строка
//  |- УказательНаСобытие ----------------------------- Строка
Процедура ОбработатьСобытие_MessageUndelivered(Событие)
	
	IDСообщения = СтрЗаменить(Событие.СодержимоеСобытия.МетаинформацияИсходящегоСообщения.ИдентификаторСообщения,"-", ""); 
	
	РезультатПоискаСообщенийПоID = ПолучитьРезультатПоискаСообщенийПоID(IDСообщения);
	
	ИсходящееСообщениеНайдено = РезультатПоискаСообщенийПоID.ИсходящееСообщениеНайдено;
	Партнер    				  = РезультатПоискаСообщенийПоID.Партнер;

	Если НЕ ИсходящееСообщениеНайдено Тогда
		
		НайденныйДокументALCRPT = НайтиОбъектПоЗначениюСвойства("ALCRPT_ID",IDСообщения);
		
		Если НайденныйДокументALCRPT = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Если ПолучитьЗначениеСвойстваОбъектаEDI(Партнер, "ОтправлятьALCRPTсINVOIC") = Истина Тогда
			ТипОтправленногоСообщения = "INVOIC";
			ДокументДляПоискаСообщения = ПолучитьСчетФактуруНакладной(НайденныйДокументALCRPT);
		Иначе
			ТипОтправленногоСообщения = "DESADV";
			ДокументДляПоискаСообщения = НайденныйДокументALCRPT;
		КонецЕсли;
		
		УстановитьСтатусСообщения(,  ДокументДляПоискаСообщения, ТипОтправленногоСообщения, "ИсходящийALCRPTОжидаетИсправленияОшибок");
		
		//и запишем сам текст ошибки в сообщение DESADV или INVOIC
		ОтправленноеСообщение = ПрочитатьСообщение(,ДокументДляПоискаСообщения,ТипОтправленногоСообщения,"Исходящее");
		
		Если НЕ ОтправленноеСообщение = Неопределено Тогда
			
			СообщениеОбъект = ПолучитьОбъектСообщения(ОтправленноеСообщение.СообщениеСсылка);
			
			ОписаниеОшибки = КонтурСтандарт_СтрСоединить_(Событие.СодержимоеСобытия.ПричиныПоКоторымСообщениеНеДоставлено, Символы.ПС);
			
			РеквизитОписаниеОшибкиALCRPT = СообщениеОбъект.ДополнительныеРеквизиты.Найти("ОшибкаALCRPT","ИмяРеквизита");
			
			Если РеквизитОписаниеОшибкиALCRPT = Неопределено Тогда
				РеквизитОписаниеОшибкиALCRPT = СообщениеОбъект.ДополнительныеРеквизиты.Добавить();
				РеквизитОписаниеОшибкиALCRPT.ИмяРеквизита = "ОшибкаALCRPT";
			КонецЕсли;
			
			РеквизитОписаниеОшибкиALCRPT.Значение		= ОписаниеОшибки;
			РеквизитОписаниеОшибкиALCRPT.ЗначениеСтрока	= ОписаниеОшибки;
			
			СообщениеОбъект.Записать();
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	
	ТабНайденныхСообщений     = РезультатПоискаСообщенийПоID.ТабНайденныхСообщений;
	
	Для Каждого СтрокаСообщенияВБазе Из ТабНайденныхСообщений Цикл
		
		СообщениеСсылка		= СтрокаСообщенияВБазе.Ссылка;
		ТипСообщения		= СтрокаСообщенияВБазе.ТипСообщения;
		
		УстановитьСтатусСообщения(СообщениеСсылка,  , ТипСообщения, "ИсходящийОжидаетИсправленияОшибок");
		
		Если НЕ СообщениеСсылка = Неопределено Тогда
			СообщениеОбъект = ПолучитьОбъектСообщения(СообщениеСсылка);
			СообщениеОбъект.ОписаниеОшибки = КонтурСтандарт_СтрСоединить_(Событие.СодержимоеСобытия.ПричиныПоКоторымСообщениеНеДоставлено, Символы.ПС);
			СохранитьОбъектСообщения(СообщениеОбъект);
		КонецЕсли;
		
	КонецЦикла;
	
	
КонецПроцедуры

Процедура ОбработатьСобытие_MessageCheckingOk(Событие)
	
	IDСообщения = СтрЗаменить(Событие.СодержимоеСобытия.МетаинформацияИсходящегоСообщения.ИдентификаторСообщения,"-", ""); 
	
	РезультатПоискаСообщенийПоID = ПолучитьРезультатПоискаСообщенийПоID(IDСообщения);
	
	ИсходящееСообщениеНайдено = РезультатПоискаСообщенийПоID.ИсходящееСообщениеНайдено;
	Партнер    				  = РезультатПоискаСообщенийПоID.Партнер;
	
	Если НЕ ИсходящееСообщениеНайдено Тогда
		Возврат;
	КонецЕсли;
	
	ТабНайденныхСообщений     = РезультатПоискаСообщенийПоID.ТабНайденныхСообщений;
	
	Для Каждого СтрокаСообщенияВБазе Из ТабНайденныхСообщений Цикл
		
		СообщениеСсылка		= СтрокаСообщенияВБазе.Ссылка;
		ТипСообщения		= СтрокаСообщенияВБазе.ТипСообщения;
		Статус 				= СтрокаСообщенияВБазе.Статус;
		
		// был статус "ИсходящийДоставленСУточнением", заменен, потому что новый интерфейс устанавливает треб. действие "Переотправить"
		ТекущийСтатусСообщения = ПолучитьСтатусСообщения(СообщениеСсылка, , ТипСообщения);
		
		Если НЕ ТекущийСтатусСообщения = ПолучитьЗначениеСтатусаСообщения("ИсходящийСозданВДиадок")
			И НЕ ЭтоБлокирующийСтатусОбработкиСтатусныхСообщенийДляСообщенийДД(Статус) Тогда   
			// статусные обрабатываются сервером асинхронно и возможно получение DraftOfDocumentPackagePostedIntoDiadoc до MessageCheckingOk  EDISUP-398
			УстановитьСтатусСообщения(СообщениеСсылка,  , ТипСообщения, "ИсходящееПрошлоПроверку");
		КонецЕсли;
		
		Если НЕ СообщениеСсылка = Неопределено 
			И Событие.СодержимоеСобытия.Свойство("Замечания") Тогда
			СообщениеОбъект = ПолучитьОбъектСообщения(СтрокаСообщенияВБазе.Ссылка);
			СообщениеОбъект.ОписаниеОшибки = КонтурСтандарт_СтрСоединить_(Событие.СодержимоеСобытия.Замечания, Символы.ПС);
			СохранитьОбъектСообщения(СообщениеОбъект);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработатьСобытие_MessageCheckingFail(Событие)
	
	IDСообщения = СтрЗаменить(Событие.СодержимоеСобытия.МетаинформацияИсходящегоСообщения.ИдентификаторСообщения,"-", ""); 
	
	РезультатПоискаСообщенийПоID = ПолучитьРезультатПоискаСообщенийПоID(IDСообщения);
	
	ИсходящееСообщениеНайдено = РезультатПоискаСообщенийПоID.ИсходящееСообщениеНайдено;
	Партнер    				  = РезультатПоискаСообщенийПоID.Партнер;

	Если НЕ ИсходящееСообщениеНайдено Тогда
		
		НайденныйДокументALCRPT = НайтиОбъектПоЗначениюСвойства("ALCRPT_ID",IDСообщения);
		
		Если НайденныйДокументALCRPT = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Если ПолучитьЗначениеСвойстваОбъектаEDI(Партнер, "ОтправлятьALCRPTсINVOIC") = Истина Тогда
			ТипОтправленногоСообщения = "INVOIC";
			ДокументДляПоискаСообщения = ПолучитьСчетФактуруНакладной(НайденныйДокументALCRPT);
		Иначе
			ТипОтправленногоСообщения = "DESADV";
			ДокументДляПоискаСообщения = НайденныйДокументALCRPT;
		КонецЕсли;
		
		УстановитьСтатусСообщения(,  ДокументДляПоискаСообщения, ТипОтправленногоСообщения, "ИсходящийALCRPTОжидаетИсправленияОшибок");
		
		//и запишем сам текст ошибки в сообщение DESADV или INVOIC
		ОтправленноеСообщение = ПрочитатьСообщение(,ДокументДляПоискаСообщения,ТипОтправленногоСообщения,"Исходящее");
		
		Если НЕ ОтправленноеСообщение = Неопределено Тогда
			
			СообщениеОбъект = ПолучитьОбъектСообщения(ОтправленноеСообщение.СообщениеСсылка);
			
			ОписаниеОшибки = КонтурСтандарт_СтрСоединить_(Событие.СодержимоеСобытия.Ошибки, Символы.ПС);
			
			РеквизитОписаниеОшибкиALCRPT = СообщениеОбъект.ДополнительныеРеквизиты.Найти("ОшибкаALCRPT","ИмяРеквизита");
			
			Если РеквизитОписаниеОшибкиALCRPT = Неопределено Тогда
				РеквизитОписаниеОшибкиALCRPT = СообщениеОбъект.ДополнительныеРеквизиты.Добавить();
				РеквизитОписаниеОшибкиALCRPT.ИмяРеквизита = "ОшибкаALCRPT";
			КонецЕсли;
			
			РеквизитОписаниеОшибкиALCRPT.Значение		= ОписаниеОшибки;
			РеквизитОписаниеОшибкиALCRPT.ЗначениеСтрока	= ОписаниеОшибки;
			
			СообщениеОбъект.Записать();
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	ТабНайденныхСообщений     = РезультатПоискаСообщенийПоID.ТабНайденныхСообщений;
	
	Для Каждого СтрокаСообщенияВБазе Из ТабНайденныхСообщений Цикл
		
		СообщениеСсылка		= СтрокаСообщенияВБазе.Ссылка;
		ТипСообщения		= СтрокаСообщенияВБазе.ТипСообщения;
		
		УстановитьСтатусСообщения(СтрокаСообщенияВБазе.Ссылка,  , СтрокаСообщенияВБазе.ТипСообщения, "ИсходящийДоставленСУточнением");
		
		Если НЕ СтрокаСообщенияВБазе.Ссылка = Неопределено Тогда
			СообщениеОбъект = ПолучитьОбъектСообщения(СтрокаСообщенияВБазе.Ссылка);
			СообщениеОбъект.ОписаниеОшибки = КонтурСтандарт_СтрСоединить_(Событие.СодержимоеСобытия.Ошибки, Символы.ПС);
			СохранитьОбъектСообщения(СообщениеОбъект);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

