        МенеджерНастроек.ХранилищеСхем = КонтурДиадокAPI_ИнициализироватьСхемы();
		
		ЭДО_Кэш_Поместить("КонтурДиадокAPI_МенеджерНастроек", МенеджерНастроек); 
		
	КонецЕсли;
	
	Возврат МенеджерНастроек;
	
