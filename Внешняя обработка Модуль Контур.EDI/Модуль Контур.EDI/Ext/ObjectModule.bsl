// Возвращает структуру данных авторизации, необходимую
// для работы модуля и выполнения запросов.
//
// Параметры:
//   ТипАвторизации - Строка - См. метод КонтурEDIAPI_ТипыАвторизации.
//
// Возвращаемое значение:
//   Структура - Зависит от параметры ТипАвторизации.
//
Функция КонтурEDIAPI_НовыйДанныеАвторизации(ТипАвторизации) Экспорт
	
	ДанныеАвторизацииEDI = Новый Структура("ТипАвторизации");
	ТипыАвторизации = КонтурEDIAPI_ТипыАвторизации();               
	
	Если ТипАвторизации = ТипыАвторизации.ЛогинПароль Тогда
		
		ДанныеАвторизацииEDI.ТипАвторизации = ТипыАвторизации.ЛогинПароль;	
		ДанныеАвторизацииEDI.Вставить("Логин", "");
		ДанныеАвторизацииEDI.Вставить("Пароль", "");
		ДанныеАвторизацииEDI.Вставить("Токен", "");
		
	ИначеЕсли ТипАвторизации = ТипыАвторизации.ТокенДоступа Тогда
	
		ДанныеАвторизацииEDI.ТипАвторизации = ТипыАвторизации.ТокенДоступа;	
		ДанныеАвторизацииEDI.Вставить("Организация", Неопределено);
		ДанныеАвторизацииEDI.Вставить("ПортальныйИд", "");
		ДанныеАвторизацииEDI.Вставить("Токен", "");
		
	Иначе
		
		ВызватьИсключение "Задан некорректный способ авторизации";
		
	КонецЕсли;
	
    Возврат ДанныеАвторизацииEDI;
	
КонецФункции

// Определяет список возможных типов авторизации API.
//
// Возвращаемое значение:
//   Структура - Список возможных типов авторизации API.
//
Функция КонтурEDIAPI_ТипыАвторизации() Экспорт
	
	ТипыАвторизации = Новый Структура;
	
	ТипыАвторизации.Вставить("ЛогинПароль", "ЛогинПароль");
	ТипыАвторизации.Вставить("ТокенДоступа", "ТокенДоступа");
	
	Возврат ТипыАвторизации;
	
КонецФункции

// Метод для получения авторизационного токена. 
// В случае HTTP ответа отличного от "200", выбрасывает исключение.
//
// Параметры:
