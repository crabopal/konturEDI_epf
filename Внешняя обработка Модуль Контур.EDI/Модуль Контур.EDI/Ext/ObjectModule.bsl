КонецФункции

Функция МашиночитаемаяДоверенностьДляОтправки(ДанныеАвторизации)
	
	РегистрационныйНомер = СвойствоСтруктуры(ДанныеАвторизации, "Доверенность.Идентификатор", "");
	РегистрационныйНомер = СвойствоСтруктуры(ДанныеАвторизации, "Доверенность.РегистрационныйНомер", РегистрационныйНомер);
	РегистрационныйНомер = СвойствоСтруктуры(ДанныеАвторизации, "Доверенность.СоставнойИдентификатор.РегистрационныеНомер", РегистрационныйНомер);
	
	ИННДоверителя = СвойствоСтруктуры(ДанныеАвторизации, "Доверенность.ИННОрганизации", "");
	ИННДоверителя = СвойствоСтруктуры(ДанныеАвторизации, "Доверенность.Доверитель", ИННДоверителя); 
	ИННДоверителя = СвойствоСтруктуры(ДанныеАвторизации, "Доверенность.СоставнойИдентификатор.ИННДоверителя", ИННДоверителя); 

	ИННПредставителя = СвойствоСтруктуры(ДанныеАвторизации, "Доверенность.СоставнойИдентификатор.ИННПредставителя", "");
	
	ИспользоватьДоверенностьПоУмолчанию = СвойствоСтруктуры(ДанныеАвторизации, "Доверенность.ИспользоватьПоУмолчанию", Ложь);
	ИспользоватьДоверенностьПоУмолчанию = ИспользоватьДоверенностьПоУмолчанию Или
										 (ДанныеАвторизации.ЕстьДоверенностьПоУмолчаниюВДиадок = Истина И ДанныеАвторизации.ТребуетсяДоверенность = Истина);
	
	ИспользоватьДоверенностьПоУмолчанию = ИспользоватьДоверенностьПоУмолчанию И (Не ЗначениеЗаполнено(РегистрационныйНомер) И Не ЗначениеЗаполнено(ИННДоверителя));
	
	ФайлДоверенности = СвойствоСтруктуры(ДанныеАвторизации, "Доверенность.ДвоичныеДанныеДоверенности", Неопределено);
	ФайлПодписи 	= СвойствоСтруктуры(ДанныеАвторизации, "Доверенность.ДвоичныеДанныеПодписи", Неопределено);  
	
	ПередатьФайлом = СвойствоСтруктуры(ДанныеАвторизации, "СпособПередачиДоверенности", "Метаинформацией") = "Файлом";

	МашиночитаемаяДоверенностьДляОтправки = КонтурДиадокAPI_СоздатьПоСхеме("PowerOfAttorneyToPost", Истина);
	
	МашиночитаемаяДоверенностьДляОтправки.СоставнойИдентификатор.РегистрационныеНомер = РегистрационныйНомер;
	МашиночитаемаяДоверенностьДляОтправки.СоставнойИдентификатор.ИННДоверителя = ИННДоверителя;
	МашиночитаемаяДоверенностьДляОтправки.СоставнойИдентификатор.ИННПредставителя = ИННПредставителя;
	МашиночитаемаяДоверенностьДляОтправки.ИспользоватьДоверенностьПоУмолчанию = ИспользоватьДоверенностьПоУмолчанию;
	МашиночитаемаяДоверенностьДляОтправки.СодержимоеФайлаДоверенностиИПодписи.ФайлДоверенности.Контент = Base64Строка(ФайлДоверенности);
	МашиночитаемаяДоверенностьДляОтправки.СодержимоеФайлаДоверенностиИПодписи.ФайлПодписи.Контент = Base64Строка(ФайлПодписи); 
	МашиночитаемаяДоверенностьДляОтправки.ПередатьФайлом = ПередатьФайлом;
	
	Возврат МашиночитаемаяДоверенностьДляОтправки;
	
КонецФункции

Функция ПолучитьСтруктуруMessagePatchToPost(Message,BoxId,MessageId,ДанныеАвторизации,PatchedEntities)
	
	РезультатПолученияMessagePatchToPost = Новый Структура("Успешно, MessagePatchToPost", Истина,  Новый Структура);
	
	Если Message = Неопределено Тогда
		
		РезультатПолученияMessagePatchToPost.Успешно = Ложь;
		
		Возврат РезультатПолученияMessagePatchToPost;
		
	КонецЕсли;
	
	РезультатSignatures = ПолучитьМассивСтруктурSignatures(BoxId, Message, ДанныеАвторизации, PatchedEntities);
	
	Если РезультатSignatures.Успешно Тогда
		
		Signatures = РезультатSignatures.МассивСтруктур;
		
		РезультатПолученияMessagePatchToPost.MessagePatchToPost.Вставить("BoxId", 		BoxId);
		РезультатПолученияMessagePatchToPost.MessagePatchToPost.Вставить("MessageId", 	MessageId);
		РезультатПолученияMessagePatchToPost.MessagePatchToPost.Вставить("Signatures", 	Signatures);
		
	Иначе
		
		РезультатПолученияMessagePatchToPost.Успешно = Ложь;
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, РезультатSignatures.ТекстСообщения);
		
	КонецЕсли;
	
	Возврат РезультатПолученияMessagePatchToPost;
	
КонецФункции

Функция ПолучитьМассивСтруктурSignatures(BoxId, Message, ДанныеАвторизации, PatchedEntities)
	
	Результат = Новый Структура("Успешно,МассивСтруктур,ТекстОшибки", Истина, Неопределено, "");
	
	Entities = Message.Entities;
	Для Каждого PatchedEntity Из PatchedEntities Цикл
				                                
		MessageId = Message.MessageId;
		EntityId = PatchedEntity.DocumentId.EntityId;
		ПутьКФайлу = мРабочийКаталог+Message.MessageId + "_" + PatchedEntity.DocumentId.EntityId;
		
		Если PatchedEntity.Свойство("Content") и ТипЗнч(PatchedEntity.Content) = Тип("Строка") Тогда
			РезультатСохранения = ЗакодированныеДвоичныеДанныеВФайл(PatchedEntity.Content, "base64", ПутьКФайлу);
		Иначе
			РезультатСохранения = СохранитьКонтентВложения(BoxId, MessageId, PatchedEntity.DocumentId.EntityId, ДанныеАвторизации, ПутьКФайлу);
		КонецЕсли;
		
		Если Не РезультатСохранения.Успешно Тогда
			Возврат Неопределено;
		КонецЕсли;  		
						
		DocumentSignature = Новый Структура;
		DocumentSignature.Вставить("ParentEntityId", 			PatchedEntity.DocumentId.EntityId);
		DocumentSignature.Вставить("ПутьКФайлу",				ПутьКФайлу);
		DocumentSignature.Вставить("АдресАрхиваВоВХ",			Неопределено);
		
		ПутьКФайлуПодписи = DocumentSignature.ПутьКФайлу;
		ФайлДляПодписи = Новый ДвоичныеДанные(ПутьКФайлу);
		АдресФайлаДляПодписи = ПоместитьВоВременноеХранилище(ФайлДляПодписи, Новый УникальныйИдентификатор);
		
		Для Сч = 1 По 2 Цикл
			
			РезультатПодписания = ПолучитьПодписьФайлаДокумента_КонтурEDI(АдресФайлаДляПодписи, ДанныеАвторизации);
		
			Если ОбработкаИсключенияТипМодуляКриптографии(РезультатПодписания.ОписаниеОшибки, ДанныеАвторизации) Тогда
				Продолжить; // еще раз, уже с нужным типом модуля криптографии
			Иначе
				Прервать;
			КонецЕсли;	
			
		КонецЦикла;		
		
		Если НЕ РезультатПодписания.Успешно Тогда
			
			Результат.Успешно = Ложь;
			Результат.ТекстОшибки = "Не удалось получить подпись для Entity " + PatchedEntity.DocumentId.EntityId; 
			
			Прервать;
			
		КонецЕсли;
		
		DocumentSignature.Вставить("Signature",					РезультатПодписания.ШифрованнаяПодпись);
		
		DocumentSignature.Вставить("SignWithTestSignature"	, 	Ложь);
		DocumentSignature.Вставить("IsApprovementSignature"	, 	Ложь);
		DocumentSignature.Вставить("SignatureNameOnShelf"	, 	Неопределено);
		DocumentSignature.Вставить("PatchedContentId"		, 	PatchedEntity.PatchedContentId);   //Entity.PatchedContentId

		Если Результат.МассивСтруктур = Неопределено Тогда
			Результат.МассивСтруктур = Новый Массив;
		КонецЕсли;
		
		ДобавитьИнформациюОбМЧД(DocumentSignature, ДанныеАвторизации);
		
		Результат.МассивСтруктур.Добавить(DocumentSignature);
		
	КонецЦикла;
	
	Если Результат.МассивСтруктур = Неопределено Тогда
		
		Результат.Успешно = Ложь;
		
		Если Результат.ТекстОшибки = "" Тогда
			Результат.ТекстОшибки = "Не удалось получить Signatures. Возможно не передан массив PatchedEntities.";
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
		
КонецФункции

Функция ЗакодированныеДвоичныеДанныеВФайл(ЗакодированныеДвоичныеДанные, ИмяАлгоритма, ПутьКФайлу)

	Результат = Новый Структура("Успешно", Ложь);
	
	Попытка
	
		Если ИмяАлгоритма = "base64" Тогда
			ДвоичныеДанные = Base64Значение(ЗакодированныеДвоичныеДанные);			
		КонецЕсли;
		
		ДвоичныеДанные.Записать(ПутьКФайлу);
		Результат.Успешно = Истина;
		
	Исключение
		
		ТекстОшибки = "Подписание ДД. Не удалось записать данные в файл - " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации_КонтурEDI("Ошибка", ТекстОшибки);
		ВызватьИсключение ТекстОшибки;				
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция СохранитьКонтентВложения(BoxId, MessageId, EntityId, ДанныеАвторизации, ПутьКФайлу)
	
	Результат = ИнициализироватьСтруктуруРезультатаФункции();
	
	ИспользоватьСохраненныйТокен = Истина;
	
	ДвоичныеДанные = ДвоичныеДанныеКонтентаEntity(BoxId, EntityId, MessageId, ДанныеАвторизации, ИспользоватьСохраненныйТокен);     
	
	Если ДвоичныеДанные <> Неопределено Тогда
		
		ДвоичныеДанные.Записать(ПутьКФайлу);
		
		ФайлКонтентаВложения = Новый Файл(ПутьКФайлу);
		Если Не ФайлКонтентаВложения.Существует() Тогда
			ВызватьИсключение "не удалось сохранить файл на диск";
		КонецЕсли;
		
		Результат.Успешно = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДвоичныеДанныеКонтентаEntity(BoxId, EntityId, MessageId, Знач ДанныеАвторизации, ИспользоватьСохраненныйТокен)
	
	ДанныеАвторизацииДиадок = ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизации);
	Результат = КонтурДиадокAPI_СодержимоеСущности(ДанныеАвторизацииДиадок, BoxId, MessageId, EntityId);
	
	Возврат Результат;

КонецФункции

Функция PostMessagePatch(MessagePatchToPostV2, operationId = "", ДанныеАвторизации) 
	
	ДанныеАвторизацииДиадок = ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизации);
