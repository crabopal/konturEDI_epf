//получает список заказов для отправки сообщения PORDERS
Процедура ВывестиСписокЗаказов_ДляОтправкиPORDERS(ЗапросСКэшемПартнеров,МассивВременныхТаблиц)
	
	ТипДокументаPORDERS = ПолучитьТипЗначенияОбъекта("ИсходящийОбратныйЗаказ",,Истина);
	ТипДокументаORDERS = ПолучитьТипЗначенияОбъекта("ВходящийЗаказПокупателя",,Истина);
	ТребоватьПроведение = Не (ПолучитьКонстантуEDI("ОПНД_"+"PORDERS")=Истина);
	
	ТипСообщения = "PORDERS";
	РежимРаботы = "Поставщик";
	ПредставлениеСообщения = ПеревестиТипСообщенияДляДействия(ТипСообщения);
	
	ДействиеЕслиПроведен = "Отправить "+ПредставлениеСообщения;//временно убрать фильтр.
	ТребоватьПроведение = Не (ПолучитьКонстантуEDI("ОПНД_"+ТипСообщения)=Истина);
	
	НеПроводитьДокументВМодуле = (ПолучитьКонстантуEDI("НПД_"+ТипДокументаPORDERS)=Истина);
	
	Если ТребоватьПроведение Тогда
		СинонимДокумента = Метаданные.Документы[ТипДокументаPORDERS].Синоним;
		Если НеПроводитьДокументВМодуле Тогда
			ДействиеЕслиНеПроведен = "Ожидается проведение: "+СинонимДокумента;
		Иначе	
			ДействиеЕслиНеПроведен = "Провести "+СинонимДокумента;
		КонецЕсли;	
	КонецЕсли;	
	
	//теперь найдем из документов, полученных предыдущим запросом, те, по которым не отправлен PORDERS и не пришел ORDERS
	//их и будем показывать в списке как "Отправить обратный заказ"
	ЗапросСКэшемПартнеров.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ДокументыДляPORDERS.Партнер КАК Партнер,
	|	ВТ_ДокументыДляPORDERS.Документ_PORDERS КАК Документ,
	|	ЗНАЧЕНИЕ(Справочник.КонтурEDI_Сообщения.) КАК Сообщение,
	|	ВТ_ДокументыДляPORDERS.Док_Проведен,
	|	ВТ_ДокументыДляPORDERS.СуммаДокумента
	|ПОМЕСТИТЬ ВТ_Заказы_Без_ORDERS
	|ИЗ
	|	ВТ_ДокументыДляPORDERS КАК ВТ_ДокументыДляPORDERS
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_Сообщения КАК КонтурEDI_ORDERS
	|		ПО ВТ_ДокументыДляPORDERS.Документ_ORDERS = КонтурEDI_ORDERS.Документ
	|			И (КонтурEDI_ORDERS.ТипСообщения = ""ORDERS"")
	|			И (КонтурEDI_ORDERS.Направление = ""Входящее"")
	|ГДЕ
	|	КонтурEDI_ORDERS.Ссылка ЕСТЬ NULL
	|	И ВТ_ДокументыДляPORDERS.PORDERS
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_Заказы_Без_ORDERS.Партнер КАК Партнер,
	|	ВТ_Заказы_Без_ORDERS.Документ КАК Документ,
	|	ЗНАЧЕНИЕ(Справочник.КонтурEDI_Сообщения.) КАК Сообщение,
	|	""PORDERS"" КАК ТипСообщения,
	|	ВЫБОР
	|		КОГДА НЕ ВТ_Заказы_Без_ORDERS.Док_Проведен
	|				И &ТребоватьПроведение
	|			ТОГДА &ДействиеЕслиНеПроведен
	|		ИНАЧЕ &ДействиеЕслиПроведен
	|	КОНЕЦ КАК ТребуемоеДействие,
	|	ВТ_Заказы_Без_ORDERS.СуммаДокумента,
	|	""Исходящее"" КАК Направление
	|ПОМЕСТИТЬ ВТ_ОтправитьСообщения_PORDERS
	|ИЗ
	|	ВТ_Заказы_Без_ORDERS КАК ВТ_Заказы_Без_ORDERS
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_Сообщения КАК КонтурEDI_PORDERS
	|		ПО ВТ_Заказы_Без_ORDERS.Документ = КонтурEDI_PORDERS.Документ
	|			И (КонтурEDI_PORDERS.ТипСообщения = ""PORDERS"")
	|			И (КонтурEDI_PORDERS.Направление = ""Исходящее"")
	|ГДЕ
	|	КонтурEDI_PORDERS.Ссылка ЕСТЬ NULL
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_Заказы_Без_ORDERS"
	;
	
	ЗапросСКэшемПартнеров.УстановитьПараметр("ДействиеЕслиНеПроведен",ДействиеЕслиНеПроведен);
	ЗапросСКэшемПартнеров.УстановитьПараметр("ДействиеЕслиПроведен",ДействиеЕслиПроведен);
	ЗапросСКэшемПартнеров.УстановитьПараметр("ТребоватьПроведение",ТребоватьПроведение);
	
	ЗапросСКэшемПартнеров.Текст = СтрЗаменить(ЗапросСКэшемПартнеров.Текст,"ВТ_ДокументыДляPORDERS","ВТ_"+ТипДокументаPORDERS);
	ЗапросСКэшемПартнеров.Текст = СтрЗаменить(ЗапросСКэшемПартнеров.Текст,"Документ_ORDERS","Док_"+ТипДокументаORDERS);
	ЗапросСКэшемПартнеров.Текст = СтрЗаменить(ЗапросСКэшемПартнеров.Текст,"Документ_PORDERS","Док_"+ТипДокументаPORDERS);
	
	МассивВременныхТаблиц.Добавить("ВТ_ОтправитьСообщения_PORDERS");
			
	ЗапросСКэшемПартнеров.Выполнить();
	
КонецПроцедуры

// получает список ответов на заказы перевозки (IFTMBC) для отправки
Процедура СформироватьСписокЗаказовПеревозки_ДляОтправкиIFTMBC(ЗапросСКэшемПартнеров, МассивВременныхТаблиц)
	
	ПредставлениеСообщения = ПеревестиТипСообщенияДляДействия("IFTMBC");
	ДействиеДляIFTMBC = "Отправить " + ПредставлениеСообщения;
	
	ЗапросСКэшемПартнеров.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_Сообщения.Ссылка,
	|	КонтурEDI_Сообщения.НомерЗаказа,
	|	КонтурEDI_Сообщения.ДатаЗаказа
	|ПОМЕСТИТЬ ВТ_ОтветыНаЗаказыПеревозки
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаКэшПартнеров КАК ТаблицаКэшПартнеров
	|		ПО КонтурEDI_Сообщения.Партнер = ТаблицаКэшПартнеров.Партнер
	|ГДЕ
	|	НЕ КонтурEDI_Сообщения.ПометкаУдаления
	|	И КонтурEDI_Сообщения.ДатаДокумента МЕЖДУ &НачалоПериода И &КонецПериода
	|	И КонтурEDI_Сообщения.ТипСообщения = ""IFTMBC""
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_Сообщения.Документ,
	|	КонтурEDI_Сообщения.Партнер КАК Партнер,
	|	&ДействиеДляIFTMBC КАК ТребуемоеДействие,
	|	""IFTMBC"" КАК ТипСообщения,
	|	КонтурEDI_Сообщения.Ссылка КАК Сообщение,
	|	КонтурEDI_Сообщения.Сумма КАК СуммаСообщения
	|ПОМЕСТИТЬ ВТ_ЗаказыПеревозки
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаКэшПартнеров КАК ТаблицаКэшПартнеров
	|		ПО КонтурEDI_Сообщения.Партнер = ТаблицаКэшПартнеров.Партнер
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОтветыНаЗаказыПеревозки КАК ВТ_ОтветыНаЗаказыПеревозки
	|		ПО КонтурEDI_Сообщения.НомерЗаказа = ВТ_ОтветыНаЗаказыПеревозки.НомерЗаказа
	|			И КонтурEDI_Сообщения.ДатаЗаказа = ВТ_ОтветыНаЗаказыПеревозки.ДатаЗаказа
	|ГДЕ
	|	НЕ КонтурEDI_Сообщения.ПометкаУдаления
	|	И КонтурEDI_Сообщения.ДатаДокумента МЕЖДУ &НачалоПериода И &КонецПериода
	|	И КонтурEDI_Сообщения.ТипСообщения = ""IFTMBF""
	|	И КонтурEDI_Сообщения.ТребуемоеДействие = ""РаботаЗавершена""
	|	И ВТ_ОтветыНаЗаказыПеревозки.Ссылка ЕСТЬ NULL
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Партнер,
	|	ТипСообщения,
	|	Сообщение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ОтветыНаЗаказыПеревозки";
	
	ЗапросСКэшемПартнеров.УстановитьПараметр("ДействиеДляIFTMBC", 	ДействиеДляIFTMBC);

	ЗапросСКэшемПартнеров.Выполнить();
	
	МассивВременныхТаблиц.Добавить("ВТ_ЗаказыПеревозки");
	
КонецПроцедуры

//{ Работа с COINVOIC

Функция ПолучитьМассивИменЗапросовВЗависимостиОтРелизаКонфигурации(ОсновноеИмя)

	МассивИменВеткиЗапросовCOINVOIC = Новый Массив;
	
	МассивИменВеткиЗапросовCOINVOIC.Добавить(ОсновноеИмя);
	   
	Возврат МассивИменВеткиЗапросовCOINVOIC;

КонецФункции

Функция ПолучитьСписокЗапросовCOINVOICДляПоиска()

	//Где будет поиск
	ШаблоныЗапросов = ПолучитьВозможныеШаблоныЗапросов();
	
	//Сюда запишем найденный список запросов
	СписокЗапросовПоCOINVOIC = Неопределено;
	
	//Будем искать ветки в шаблоне. имена веток с приоритетом поиска укажем в массиве ниже
	МассивИменВеткиЗапросовCOINVOIC = ПолучитьМассивИменЗапросовВЗависимостиОтРелизаКонфигурации("ЗапросПоCOINVOIC");
			
	Для Каждого ВеткаШаблонов Из ШаблоныЗапросов Цикл
		
		Если ВеткаШаблонов = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если СписокЗапросовПоCOINVOIC = Неопределено  Тогда
			
			Для Каждого ИмяВетки Из МассивИменВеткиЗапросовCOINVOIC Цикл
				
				СписокЗапросовПоCOINVOIC = ПолучитьСписокЗапросовИзВеткиШаблоновЗапросов(ВеткаШаблонов, "Поставщик", ИмяВетки);
				Если СписокЗапросовПоCOINVOIC <> Неопределено Тогда
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат СписокЗапросовПоCOINVOIC;

КонецФункции

Функция ПолучитьСписокЗапросовПоКоличествуТоваровORDERS()

	//Где будет поиск
	ШаблоныЗапросов = ПолучитьВозможныеШаблоныЗапросов();
	
	//Сюда запишем найденный список запросов
	СписокЗапросовПоКоличествуТоваровORDERS = Неопределено;
	
	//Будем искать ветки в шаблоне. имена веток с приоритетом поиска укажем в массиве ниже
	МассивИменВеткиЗапросовПоКоличествуТоваровORDERS = ПолучитьМассивИменЗапросовВЗависимостиОтРелизаКонфигурации("ЗапросПоКоличествуТовараORDERS");
			
	Для Каждого ВеткаШаблонов Из ШаблоныЗапросов Цикл
		
		Если ВеткаШаблонов = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если СписокЗапросовПоКоличествуТоваровORDERS <> Неопределено  Тогда
			Прервать;
		КонецЕсли;

		Для Каждого ИмяВетки Из МассивИменВеткиЗапросовПоКоличествуТоваровORDERS Цикл
            
            		СписокЗапросовПоКоличествуТоваровORDERS = ПолучитьСписокЗапросовИзВеткиШаблоновЗапросов(ВеткаШаблонов, "Поставщик", ИмяВетки);
            		Если СписокЗапросовПоКоличествуТоваровORDERS <> Неопределено Тогда
                		Прервать;
           		КонецЕсли;
            
        	КонецЦикла;
			
	КонецЦикла;


	Возврат СписокЗапросовПоКоличествуТоваровORDERS;

КонецФункции

Функция ПолучитьТекстЗапросаЦепочки_COINVOIC()
	
	СписокЗапросовПоCOINVOIC = ПолучитьСписокЗапросовCOINVOICДляПоиска();
			
	ТекстЗапроса = Неопределено;  	
	
	// Попытка найти запрос соответсвующий основной цепочке, если такого нет, то первый попавшийся
	Если  СписокЗапросовПоCOINVOIC <> Неопределено Тогда
		
		ШаблонЦепочкиДокументов_Поставщик = СокрЛП(ПолучитьКонстантуEDI("ШаблонЦепочкиДокументов_Поставщик"));
		
		НаборЗапросДляЦепочкиCOINVOIC = СписокЗапросовПоCOINVOIC.Элементы.Найти(ШаблонЦепочкиДокументов_Поставщик);
		
		Если НаборЗапросДляЦепочкиCOINVOIC <> Неопределено Тогда
			ТекстЗапроса = НаборЗапросДляЦепочкиCOINVOIC.Запрос;
		Иначе
			ТекстЗапроса = СписокЗапросовПоCOINVOIC.Элементы[0].Запрос;
		КонецЕсли;  
		
	КонецЕсли;	
		
	Возврат ?(Не ЗначениеЗаполнено(ТекстЗапроса), "ЗапросНеОпределен", ТекстЗапроса);
	
КонецФункции

Функция ПолучитьТекстЗапросаЦепочки_КоличествоТоваровORDERS()
	
	СписокЗапросовПоКоличествоТоваровORDERS = ПолучитьСписокЗапросовПоКоличествуТоваровORDERS();
			
	ТекстЗапроса = Неопределено;  	
	
	// Попытка найти запрос соответсвующий основной цепочке, если такого нет, то первый попавшийся
	Если  СписокЗапросовПоКоличествоТоваровORDERS <> Неопределено Тогда
		
		ШаблонЦепочкиДокументов_Поставщик = СокрЛП(ПолучитьКонстантуEDI("ШаблонЦепочкиДокументов_Поставщик"));
		
		НаборЗапросДляЦепочкиПоКоличествуТоваровORDERS = СписокЗапросовПоКоличествоТоваровORDERS.Элементы.Найти(ШаблонЦепочкиДокументов_Поставщик);
		
		Если НаборЗапросДляЦепочкиПоКоличествуТоваровORDERS <> Неопределено Тогда
			ТекстЗапроса = НаборЗапросДляЦепочкиПоКоличествуТоваровORDERS.Запрос;
		Иначе
			ТекстЗапроса = СписокЗапросовПоКоличествоТоваровORDERS.Элементы[0].Запрос;
		КонецЕсли;  
		
	КонецЕсли;	
		
	Возврат ?(Не ЗначениеЗаполнено(ТекстЗапроса), "ЗапросНеОпределен", ТекстЗапроса);
	
КонецФункции

Функция КэшТекстЗапросаЦепочки_COINVOIC() Экспорт
	
	Результат = ЭДО_Кэш_Прочитать("ТекстЗапросаЦепочки_COINVOIC");
	
	Если Результат = Неопределено Тогда
		
		//переинициализируем кэш
		Результат = ПолучитьТекстЗапросаЦепочки_COINVOIC();
		
		ЭДО_Кэш_Поместить("ТекстЗапросаЦепочки_COINVOIC", Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КэшТекстЗапросаЦепочки_КоличествоТоваровORDERS() Экспорт 
	
	Результат = ЭДО_Кэш_Прочитать("ТекстЗапросаЦепочки_КоличествоТоваровORDERS");
	
	Если Результат = Неопределено Тогда
		
		//переинициализируем кэш
		Результат = ПолучитьТекстЗапросаЦепочки_КоличествоТоваровORDERS();
		
		ЭДО_Кэш_Поместить("ТекстЗапросаЦепочки_КоличествоТоваровORDERS", Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

 
Процедура СформироватьСписокДокументов_ДляОтправкиКоррИспрINVOIC(ЗапросСКэшемПартнеров, МассивВременныхТаблиц);
    		
	Если Не ЕстьКоррИспрСФ ИЛИ ВнешнееХранилище Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапросаДляCOINVOIC = КэшТекстЗапросаЦепочки_COINVOIC();
	
	Если ТекстЗапросаДляCOINVOIC <> "ЗапросНеОпределен" Тогда
		
		ЗапросСКэшемПартнеров.Текст  = ТекстЗапросаДляCOINVOIC;
		
		ОбработатьПодменыДляКонфигурации_КонтурEDI(ЗапросСКэшемПартнеров.Текст);
		
		ЗапросСКэшемПартнеров.УстановитьПараметр("БлокирующиеСтатусыПервичногоINVOIC", ПолучитьБлокирующиеСтатусыПервичногоINVOIC());
		ЗапросСКэшемПартнеров.УстановитьПараметр("ТолькоТребуемые", Истина); 
		
		ЗапросСКэшемПартнеров.УстановитьПараметр("ВозвратИспользуется", (ПолучитьКонстантуEDI("ИспользоватьДокументВозвратТоваровОтКлиента") = Истина)); 
		
		ЗапросСКэшемПартнеров.УстановитьПараметр("ТребуетсяПроведениеCOINVOIC", Не (ПолучитьКонстантуEDI("ОПНД_COINVOIC") = Истина));
		
		ЗапросСКэшемПартнеров.Выполнить();
		
		МассивВременныхТаблиц.Добавить("ВТ_КоррИспрСФ");		
						
	Иначе
		
		СформироватьСписокДокументов_ДляОтправкиКоррИспрINVOIC_Стар(ЗапросСКэшемПартнеров,МассивВременныхТаблиц);
		
	КонецЕсли;  
		
КонецПроцедуры

//получает список корректировочных и исправительных СФ для отправки
Процедура СформироватьСписокДокументов_ДляОтправкиКоррИспрINVOIC_Стар(ЗапросСКэшемПартнеров,МассивВременныхТаблиц);
    		
	Если Не ЕстьКоррИспрСФ Тогда
		Возврат;
	КонецЕсли;
	
	// выбрать все корректировки реализации по нашим контрагентам
	// найти у них реализации и заказы 	// присоединить блокирующее сообщение
	
	ТекстЗапросаПоДокументам = 
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СчетФактураВыданныйДокументыОснования.Ссылка КАК Документ,
	|	ТаблицаКэшПартнеровКонтрагентов.Партнер КАК Партнер,
	|	ВЫБОР
	|		КОГДА КорректировкаРеализации.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки)
	|				И КорректировкаРеализации.ДокументРеализации ССЫЛКА Документ.РеализацияТоваровУслуг
	|			ТОГДА ""Отправить счет-фактуру""
	|		ИНАЧЕ ""Отправить корректировочный счет-фактуру""
	|	КОНЕЦ КАК ТребуемоеДействие,
	|	ВЫБОР
	|		КОГДА КорректировкаРеализации.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки)
	|				И КорректировкаРеализации.ДокументРеализации ССЫЛКА Документ.РеализацияТоваровУслуг
	|			ТОГДА ""INVOIC""
	|		ИНАЧЕ ""COINVOIC""
	|	КОНЕЦ КАК ТипСообщения,
	|	СчетФактура_ИсходнойСФ.Ссылка КАК СчетФактураИсходнойСФ_Ссылка
	|ПОМЕСТИТЬ ВТ_Документы_КоррИспрСФ
	|ИЗ
	|	Документ.КорректировкаРеализации КАК КорректировкаРеализации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаКэшПартнеровКонтрагентов КАК ТаблицаКэшПартнеровКонтрагентов
	|		ПО (ТаблицаКэшПартнеровКонтрагентов.Контрагент = КорректировкаРеализации.Контрагент)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|			ПО СчетФактураВыданныйДокументыОснования.Ссылка = СчетФактураВыданный.Ссылка
	|		ПО (СчетФактураВыданныйДокументыОснования.ДокументОснование = КорректировкаРеализации.Ссылка)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактура_ИсходнойСФ
	|		ПО (СчетФактура_ИсходнойСФ.ДокументОснование = КорректировкаРеализации.ДокументРеализации)
	|ГДЕ
	|	КорректировкаРеализации.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И КорректировкаРеализации.Проведен
	|	И НЕ СчетФактураВыданный.ПометкаУдаления
	|	И (КорректировкаРеализации.ДокументРеализации ССЫЛКА Документ.РеализацияТоваровУслуг
	|			ИЛИ КорректировкаРеализации.ДокументРеализации ССЫЛКА Документ.КорректировкаРеализации)
	|	И ВЫБОР
	|			КОГДА КорректировкаРеализации.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки)
	|				ТОГДА ТаблицаКэшПартнеровКонтрагентов.INVOIC
	|						И НЕ ТаблицаКэшПартнеровКонтрагентов.НеОтправлять_I_INVOIC
	|			ИНАЧЕ ТаблицаКэшПартнеровКонтрагентов.COINVOIC
	|		КОНЕЦ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Партнер,
	|	Документ,
	|	ТипСообщения";
	
	Если НЕ ОснованиеINVOICСчетФактура() Тогда
		ТекстЗапросаПоДокументам = СтрЗаменить(ТекстЗапросаПоДокументам, "СчетФактура_ИсходнойСФ.Ссылка КАК СчетФактураИсходнойСФ_Ссылка", "СчетФактура_ИсходнойСФ.ДокументОснование КАК СчетФактураИсходнойСФ_Ссылка");
	КонецЕсли;
	
	ТекстЗапросаПоСообщениям = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_Документы_КоррИспрСФ.Документ КАК Документ,
	|	ВТ_Документы_КоррИспрСФ.Партнер КАК Партнер,
	|	ВТ_Документы_КоррИспрСФ.ТребуемоеДействие КАК ТребуемоеДействие,
	|	ВТ_Документы_КоррИспрСФ.ТипСообщения КАК ТипСообщения,
	|	ВТ_Документы_КоррИспрСФ.СчетФактураИсходнойСФ_Ссылка КАК СчетФактураИсходнойСФ_Ссылка,
	|	СообщенияINVOIC.Ссылка КАК Сообщение
	|ПОМЕСТИТЬ табINVOIC
	|ИЗ
	|	ВТ_Документы_КоррИспрСФ КАК ВТ_Документы_КоррИспрСФ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_Сообщения КАК СообщенияINVOIC
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_Сообщения.ДополнительныеРеквизиты КАК КонтурEDI_СообщенияДополнительныеРеквизиты
	|			ПО (КонтурEDI_СообщенияДополнительныеРеквизиты.ИмяРеквизита = ""DraftOfDocumentPackageSignedByMe"")
	|				И СообщенияINVOIC.Ссылка = КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка
	|		ПО ВТ_Документы_КоррИспрСФ.СчетФактураИсходнойСФ_Ссылка = СообщенияINVOIC.Документ
	|			И (СообщенияINVOIC.ТипСообщения = ""COINVOIC""
	|				ИЛИ СообщенияINVOIC.ТипСообщения = ""INVOIC"")
	|ГДЕ
	|	ВЫБОР
	|			КОГДА КонтурEDI_СообщенияДополнительныеРеквизиты.Значение ЕСТЬ NULL 
	|				ТОГДА НЕ СообщенияINVOIC.Статус В (&БлокирующиеСтатусыПервичногоINVOIC)
	|			ИНАЧЕ КонтурEDI_СообщенияДополнительныеРеквизиты.Значение = ИСТИНА
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	табINVOIC.Документ КАК Документ,
	|	табINVOIC.Партнер КАК Партнер,
	|	табINVOIC.ТребуемоеДействие КАК ТребуемоеДействие,
	|	табINVOIC.ТипСообщения КАК ТипСообщения,
	|	табINVOIC.Сообщение
	|ПОМЕСТИТЬ ВТ_КоррИспрСФ
	|ИЗ
	|	табINVOIC КАК табINVOIC
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_Сообщения КАК КонтурEDI_COINVOIC
	|		ПО табINVOIC.Документ = КонтурEDI_COINVOIC.Документ
	|			И (КонтурEDI_COINVOIC.ТипСообщения = ""COINVOIC""
	|				ИЛИ КонтурEDI_COINVOIC.ТипСообщения = ""INVOIC"")
	|ГДЕ
	|	КонтурEDI_COINVOIC.Ссылка ЕСТЬ NULL ";
		
	Если ИмяКонфигурации1С="УФ_УТ" Тогда
		ТекстЗапросаПоДокументам = УФ_СформироватьТекстЗапросаДляОтправкиКоррИспрINVOIC();
	ИначеЕсли ИмяКонфигурации1С = "УФ_УНФ" Тогда
		ТекстЗапросаПоДокументам = УФ_УНФ_СформироватьТекстЗапросаДляОтправкиКоррИспрINVOIC();
	ИначеЕсли ИмяКонфигурации1С = "УФ_Розница" Тогда
		ТекстЗапросаПоДокументам = УФ_Розница_СформироватьТекстЗапросаДляОтправкиКоррИспрINVOIC();
	КонецЕсли;
	 
	ЗапросСКэшемПартнеров.Текст  = ТекстЗапросаПоДокументам;	
	
	ЗапросСКэшемПартнеров.Выполнить();
	
	ЗапросСКэшемПартнеров.Текст = ТекстЗапросаПоСообщениям;
	ЗапросСКэшемПартнеров.УстановитьПараметр("БлокирующиеСтатусыПервичногоINVOIC", ПолучитьБлокирующиеСтатусыПервичногоINVOIC());
	
	ЗапросСКэшемПартнеров.Выполнить();
 	МассивВременныхТаблиц.Добавить("ВТ_КоррИспрСФ");

КонецПроцедуры

Функция ПолучитьБлокирующиеСтатусыПервичногоINVOIC()
	
	МассивСтатусов = Новый СписокЗначений;
	МассивСтатусов.Добавить("Ожидает отправки");
	МассивСтатусов.Добавить("Отправлен");
	МассивСтатусов.Добавить("Ожидает подписания");
	МассивСтатусов.Добавить("Сохранено");
	
	Возврат МассивСтатусов; 
	
КонецФункции

//} Работа с COINVOIC

//универсальная процедура для формирования запроса на отправку/ожидания сообщения - и со стороны ТС, и со стороны поставщика. Проведение кинуть сюда же
Процедура СформироватьСписокДокументов_ДляОтправкиОжиданияСообщений(РежимРаботы, ЗапросСКэшемПартнеров, МассивВременныхТаблиц, ТипСообщения)
	
	ТипДокумента = ПолучитьНазваниеТипаДокументаПоТипуСообщения(ТипСообщения, РежимРаботы);
	
	Если НЕ ЗначениеЗаполнено(ТипДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	ПредставлениеСообщения = ПеревестиТипСообщенияДляДействия(ТипСообщения);
	
	//еще надо определить, входящее у нас сообщение или исходящее
	Если ПолучитьНаправлениеСообщения(ТипСообщения,РежимРаботы) = "Входящее" Тогда
		ДействиеЕслиПроведен = "Ожидайте "+ПредставлениеСообщения;//временно убрать фильтр.
		ТребоватьПроведение = Ложь;//Для получения входящих сообщений нам не надо проводить документ.
	Иначе	
		ДействиеЕслиПроведен = "Отправить "+ПредставлениеСообщения;//временно убрать фильтр.
		ТребоватьПроведение = Не (ПолучитьКонстантуEDI("ОПНД_"+ТипСообщения)=Истина);
	КонецЕсли;	
	
	НеПроводитьДокументВМодуле = (ПолучитьКонстантуEDI("НПД_"+ТипДокумента)=Истина);
	
	Если ТребоватьПроведение Тогда
		СинонимДокумента = Метаданные.Документы[ТипДокумента].Синоним;
		Если НеПроводитьДокументВМодуле Тогда
			ДействиеЕслиНеПроведен = "Ожидается проведение: "+СинонимДокумента;
		Иначе	
			ДействиеЕслиНеПроведен = "Провести "+СинонимДокумента;
		КонецЕсли;	
	КонецЕсли;

	//теперь сам запрос
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_Сообщения.Документ КАК Документ,
	|	КонтурEDI_Сообщения.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Сообщения_УжеСуществующие
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДокументыДляОтправки КАК ВТ_ДокументыДляОтправки
	|		ПО КонтурEDI_Сообщения.Документ = ВТ_ДокументыДляОтправки.ОтправляемыйДокумент
	|			И (КонтурEDI_Сообщения.ТипСообщения = &ТипСообщенияДляОтправки)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ДокументыДляОтправки.Партнер КАК Партнер,
	|	ВТ_ДокументыДляОтправки.ОтправляемыйДокумент КАК ДокументДляОтправки,
	|	ВТ_ДокументыДляОтправки.СуммаДокумента КАК СуммаДокумента,
	|	NULL КАК СуммаСообщения,
	|	ВТ_ДокументыДляОтправки.PORDERS,
	|	ВТ_ДокументыДляОтправки.ORDERS,
	|	ВТ_ДокументыДляОтправки.ORDRSP,
	|	ВТ_ДокументыДляОтправки.DESADV,
	|	ВТ_ДокументыДляОтправки.RECADV,
	|	ВТ_ДокументыДляОтправки.INVOIC,
	|	ВТ_ДокументыДляОтправки.Док_Проведен КАК Док_Проведен,
	|	&ПолеБлокирующегоСообщения КАК ТипПредыдущегоСообщения,
	|	ВЫБОР
	|		КОГДА &ПолеБлокирующегоСообщения = ""PORDERS""
	|			ТОГДА &ДокументЦепочки_PORDERS
	|		КОГДА &ПолеБлокирующегоСообщения = ""ORDERS""
	|			ТОГДА &ДокументЦепочки_ORDERS
	|		КОГДА &ПолеБлокирующегоСообщения = ""ORDRSP""
	|			ТОГДА &ДокументЦепочки_ORDRSP
	|		КОГДА &ПолеБлокирующегоСообщения = ""DESADV""
	|			ТОГДА &ДокументЦепочки_DESADV
	|		КОГДА &ПолеБлокирующегоСообщения = ""RECADV""
	|			ТОГДА &ДокументЦепочки_RECADV
	|		КОГДА &ПолеБлокирующегоСообщения = ""INVOIC""
	|			ТОГДА &ДокументЦепочки_INVOIC
	|		КОГДА &ПолеБлокирующегоСообщения = ""RETANN""
	|			ТОГДА &ДокументЦепочки_RETANN
	|		КОГДА &ПолеБлокирующегоСообщения = ""RETINS""
	|			ТОГДА &ДокументЦепочки_RETINS
	|		КОГДА &ПолеБлокирующегоСообщения = ""RETDES""
	|			ТОГДА &ДокументЦепочки_RETDES
	|		КОГДА &ПолеБлокирующегоСообщения = ""RETREC""
	|			ТОГДА &ДокументЦепочки_RETREC
	|		КОГДА &ПолеБлокирующегоСообщения = """"
	|				И &ДокументЦепочки_RETREC ЕСТЬ НЕ NULL 
	|			ТОГДА &ДокументЦепочки_RETREC
	|		КОГДА &ПолеБлокирующегоСообщения = """"
	|				И &ДокументЦепочки_RETDES ЕСТЬ НЕ NULL 
	|			ТОГДА &ДокументЦепочки_RETDES
	|		КОГДА &ПолеБлокирующегоСообщения = """"
	|				И &ДокументЦепочки_RETINS ЕСТЬ НЕ NULL 
	|			ТОГДА &ДокументЦепочки_RETINS
	|		КОГДА &ПолеБлокирующегоСообщения = """"
	|				И &ДокументЦепочки_RETANN ЕСТЬ НЕ NULL 
	|			ТОГДА &ДокументЦепочки_RETANN
	|		КОГДА &ПолеБлокирующегоСообщения = """"
	|				И &ДокументЦепочки_RECADV ЕСТЬ НЕ NULL 
	|			ТОГДА &ДокументЦепочки_RECADV
	|		КОГДА &ПолеБлокирующегоСообщения = """"
	|				И &ДокументЦепочки_DESADV ЕСТЬ НЕ NULL 
	|			ТОГДА &ДокументЦепочки_DESADV
	|		КОГДА &ПолеБлокирующегоСообщения = """"
	|				И &ДокументЦепочки_ORDRSP ЕСТЬ НЕ NULL 
	|			ТОГДА &ДокументЦепочки_ORDRSP
	|		КОГДА &ПолеБлокирующегоСообщения = """"
	|				И &ДокументЦепочки_ORDERS ЕСТЬ НЕ NULL 
	|			ТОГДА &ДокументЦепочки_ORDERS
	|		КОГДА &ПолеБлокирующегоСообщения = """"
	|				И &ДокументЦепочки_PORDERS ЕСТЬ НЕ NULL 
	|			ТОГДА &ДокументЦепочки_PORDERS
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК ПредыдущийДокументЦепочки,
	|	ВТ_ДокументыДляОтправки.INVOICНеБлокируетсяПредыдущимиСообщениями КАК INVOICНеБлокируетсяПредыдущимиСообщениями,
	|	&ДокументЦепочки_ORDERS КАК ДокументЦепочкиORDERS
	|ПОМЕСТИТЬ ВТ_НеотправленныеСообщения
	|ИЗ
	|	ВТ_ДокументыДляОтправки КАК ВТ_ДокументыДляОтправки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Сообщения_УжеСуществующие КАК ВТ_Сообщения_УжеСуществующие
	|		ПО ВТ_ДокументыДляОтправки.ОтправляемыйДокумент = ВТ_Сообщения_УжеСуществующие.Документ
	|ГДЕ
	|	&ПолеТипаСообщенияДляОтправки
	|	И ВТ_Сообщения_УжеСуществующие.Ссылка ЕСТЬ NULL
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Партнер,
	|	ДокументДляОтправки,
	|	ТипПредыдущегоСообщения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_НеотправленныеСообщения.Партнер,
	|	ВТ_НеотправленныеСообщения.ДокументДляОтправки КАК Документ,
	|	&ТипСообщенияДляОтправки КАК ТипСообщения,
	|	&ТекстТребуемоеДействие КАК ТребуемоеДействие,
	|	"""" КАК СтатусДокумента,
	|	&НаправлениеСообщения КАК Направление,
	|	ВТ_НеотправленныеСообщения.СуммаДокумента,
	|	ВТ_НеотправленныеСообщения.СуммаСообщения,
	|	КонтурEDI_Сообщения_Блокирующие.Ссылка КАК Сообщение,
	|	ВТ_ХронологияСуществующихСообщений.ХронологияСообщения,
