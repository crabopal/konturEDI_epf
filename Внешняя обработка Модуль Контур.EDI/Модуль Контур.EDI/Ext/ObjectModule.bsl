// ЗАПРОСЫ

Функция Аутентификатор_ЗапросКодУстройства(ПараметрыЗапроса)
	
	Результат = Аутентификатор_МодельЗапрос();
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	
	Результат.Хост = КонфигурацияПровайдера.Хост;
	Результат.Ресурс = "/connect/deviceauthorization";
	Результат.Адрес = КонтурСтандарт_СтрШаблон_("%1%2", Результат.Хост, Результат.Ресурс);
	Результат.Метод = "POST";
	Результат.Заголовки = Заголовки;
	Результат.Параметры = ПараметрыЗапроса;
	
	Возврат Результат;
	
КонецФункции

