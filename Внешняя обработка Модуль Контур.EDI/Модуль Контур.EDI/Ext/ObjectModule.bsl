Функция ПолучитьСпискиВыбораКолонокНезависимогоСообщения(ТипСообщения)

	СтруктураСписков = Новый Структура;
	
	СписокЕдиницИзмерения = ПолучитьСписокЕдиницEDI();
	СтруктураСписков.Вставить("КодЕдиницыИзмеренияEDI", СписокЕдиницИзмерения);

	Если ТипСообщения = "PRICELIST" Тогда
		
		СписокСтатусов = Новый СписокЗначений;
		СписокСтатусов.Добавить("Added", 		"Товар добавлен (Added)");
		СписокСтатусов.Добавить("Changed", 		"Данные изменены (Changed)");
		СписокСтатусов.Добавить("No Action", 	"Нет изменений (No Action)");
		СписокСтатусов.Добавить("Deleted", 		"Товар удален (Deleted)");
		СтруктураСписков.Вставить("Статус", СписокСтатусов);
		
		СписокЕдИзмСрокаГодности = Новый СписокЗначений;
		СписокЕдИзмСрокаГодности.Добавить("Month", 	"Месяц");
		СписокЕдИзмСрокаГодности.Добавить("Week", 	"Неделя");
		СписокЕдИзмСрокаГодности.Добавить("Day", 	"День");
		СписокЕдИзмСрокаГодности.Добавить("Hour", 	"Час");
		СтруктураСписков.Вставить("ЕдИзмСрокаГодности", СписокЕдИзмСрокаГодности);
		
	ИначеЕсли ТипСообщения = "SLSRPT" Тогда
		
		СписокКаналовСбыта = Новый СписокЗначений;
		СписокКаналовСбыта.Добавить("Оптовик", 				"Оптовик");
		СписокКаналовСбыта.Добавить("Розничный магазин", 	"Розничный магазин");
		СписокКаналовСбыта.Добавить("Торговая сеть", 		"Торговая сеть");
		СтруктураСписков.Вставить("КаналСбыта1С", СписокКаналовСбыта);
		
	ИначеЕсли ТипСообщения = "DELFOR" Тогда
		
		СписокСогласований = Новый СписокЗначений;
		СписокСогласований.Добавить("Принят", 		"Принят");
		СписокСогласований.Добавить("Отклонен", 	"Отклонен");		 
		СтруктураСписков.Вставить("СписокСогласований", СписокСогласований);
		
		СписокСтатусовГрафиков = Новый СписокЗначений;
		СписокСтатусовГрафиков.Добавить("Добавлен", 	"Добавлен");
		СписокСтатусовГрафиков.Добавить("Изменен", 		"Изменен");		 
		СписокСтатусовГрафиков.Добавить("Удален", 		"Удален");		 
		СтруктураСписков.Вставить("СписокСтатусовГрафиков", СписокСтатусовГрафиков);
		
		СписокПериодичностейНедели = Новый СписокЗначений;
		СписокПериодичностейНедели.Добавить("Каждую неделю", 		"Каждую неделю");
		СписокПериодичностейНедели.Добавить("По четным неделям", 	"По четным неделям");		 
		СписокПериодичностейНедели.Добавить("По нечетным неделям", 	"По нечетным неделям");		 
		СтруктураСписков.Вставить("СписокПериодичностейНедели", СписокПериодичностейНедели);
		
		СписокПериодичностейДни = Новый СписокЗначений;
		СписокПериодичностейДни.Добавить("Пн", 		"Пн");
		СписокПериодичностейДни.Добавить("Вт", 		"Вт");
		СписокПериодичностейДни.Добавить("Ср", 		"Ср");
		СписокПериодичностейДни.Добавить("Чт", 		"Чт");
		СписокПериодичностейДни.Добавить("Пт", 		"Пт");
		СписокПериодичностейДни.Добавить("Сб", 		"Сб");
		СписокПериодичностейДни.Добавить("Вс", 		"Вс");	 
		СтруктураСписков.Вставить("СписокПериодичностейДни", СписокПериодичностейДни);
		
	КонецЕсли;
	
	Возврат СтруктураСписков;

КонецФункции // ПолучитьСпискиВыбораКолонокНезависимогоСообщения()

Функция ПолучитьСпискиВыбораПолейНезависимогоСообщения(ТипСообщения, Направление)

	СтруктураСписков = Новый Структура;
	
	Если ТипСообщения = "PRICELIST" Тогда
		
		СписокСтатусов = Новый СписокЗначений;
		СписокСтатусов.Добавить("Added", 		"Товар добавлен (Added)");
		СписокСтатусов.Добавить("Changed", 		"Данные изменены (Changed)");
		СписокСтатусов.Добавить("No Action", 	"Нет изменений (No Action)");
		СписокСтатусов.Добавить("Deleted", 		"Товар удален (Deleted)");
		СтруктураСписков.Вставить("СтатусТовараПоУмолчанию", СписокСтатусов);

		СписокТиповПрайсЛиста = Новый СписокЗначений;
		СписокТиповПрайсЛиста.Добавить("Catalogue", 	 "Основной");
		СписокТиповПрайсЛиста.Добавить("MarketingPrice", "Акционный");
		СтруктураСписков.Вставить("ТипПрайсЛиста", СписокТиповПрайсЛиста);

	ИначеЕсли ТипСообщения = "DELFOR" Тогда
		
		СписокДлительностейГрафиков = Новый СписокЗначений;                    
		СписокДлительностейГрафиков.Добавить("Регулярный", 	"Регулярный");
		СписокДлительностейГрафиков.Добавить("Временный", 	"Временный");
		СтруктураСписков.Вставить("СписокДлительностейГрафиков", СписокДлительностейГрафиков);
		
	ИначеЕсли ТипСообщения = "INVRPT" И Направление = "Исходящее" Тогда 
		
		СписокПартнеров = Новый СписокЗначений; 
		МассивПартнеров = ПолучитьМассивПартнеровПоТипуСообщения(ТипСообщения);
		СписокПартнеров.ЗагрузитьЗначения(МассивПартнеров);
		
		СтруктураСписков.Вставить("Партнер", СписокПартнеров);	
		
		СписокОрганизаций = Новый СписокЗначений;
		МассивОрганизаций = ПолучитьМассивОрганизаций();
		СписокОрганизаций.ЗагрузитьЗначения(МассивОрганизаций);
		
		СтруктураСписков.Вставить("Организация", СписокОрганизаций);
		
	КонецЕсли;
	
	Возврат СтруктураСписков;

КонецФункции

Функция ПолучитьМассивОрганизаций()
	
	ТипОрганизации = ПолучитьТипЗначенияОбъекта("ЮрФизЛицоСвое", Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	   "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	   |	ВЫРАЗИТЬ(КонтурEDI_ДополнительныеРеквизиты.Объект КАК " + ТипОрганизации + ") КАК Организация
	   |ИЗ
	   |	РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеРеквизиты
	   |ГДЕ
	   |	КонтурEDI_ДополнительныеРеквизиты.Свойство = ""GLN_Организации""
	   |	И НЕ ВЫРАЗИТЬ(КонтурEDI_ДополнительныеРеквизиты.Объект КАК " + ТипОрганизации + ") В (&МассивНедоступныхОрганизаций)";
	   
	МассивНедоступныхОрганизаций = ?(ЗначениеЗаполнено(ПараметрыПользователяEDI.НедоступныеОрганизации), ПараметрыПользователяEDI.НедоступныеОрганизации, Новый Массив);
	Запрос.УстановитьПараметр("МассивНедоступныхОрганизаций", МассивНедоступныхОрганизаций);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Организация"); 
	
КонецФункции

Функция ПолучитьМассивПартнеровПоТипуСообщения(ТипСообщения, Направление = "")
	
	ИдентификаторНастройки = ТипСообщения;
	Если ЗначениеЗаполнено(Направление) Тогда
		ИдентификаторНастройки = ИдентификаторНастройки + "_" + Направление;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурEDI_ДополнительныеСправочники.Ссылка КАК Партнер
	|ПОМЕСТИТЬ табПартнеры
	|ИЗ
	|	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
	|ГДЕ
	|	НЕ КонтурEDI_ДополнительныеСправочники.Ссылка В (&МассивНедоступныхПартнеров)
	|	И КонтурEDI_ДополнительныеСправочники.ИмяСправочника = ""Партнеры""
	|	И НЕ КонтурEDI_ДополнительныеСправочники.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(КонтурEDI_ДополнительныеРеквизиты.Объект КАК Справочник.КонтурEDI_ДополнительныеСправочники) КАК Партнер
	|ИЗ
	|	табПартнеры КАК табПартнеры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеРеквизиты
	|		ПО табПартнеры.Партнер = КонтурEDI_ДополнительныеРеквизиты.Объект
	|			И (КонтурEDI_ДополнительныеРеквизиты.Свойство = &ИдентификаторНастройки)
	|			И ((ВЫРАЗИТЬ(КонтурEDI_ДополнительныеРеквизиты.Значение КАК БУЛЕВО)) = ИСТИНА)";
	
	Запрос.УстановитьПараметр("ИдентификаторНастройки", ИдентификаторНастройки);
	МассивНедоступныхПартнеров = ?(ЗначениеЗаполнено(ПараметрыПользователяEDI.НедоступныеПартнеры), ПараметрыПользователяEDI.НедоступныеПартнеры, Новый Массив);
	Запрос.УстановитьПараметр("МассивНедоступныхПартнеров", МассивНедоступныхПартнеров);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Партнер");
	
КонецФункции

Функция ПолучитьМассивКонтрагентовПартнера(Партнер) Экспорт
	
	ТипКонтрагенты = ПолучитьТипЗначенияОбъекта("ЮрФизЛицоСтороннее", Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		  "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		 |	ВЫРАЗИТЬ(КонтурEDI_ДополнительныеРеквизиты.Объект КАК " + ТипКонтрагенты + ") КАК Контрагент
		 |ИЗ
		 |	РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеРеквизиты
		 |ГДЕ
		 |	(ВЫРАЗИТЬ(КонтурEDI_ДополнительныеРеквизиты.Значение КАК Справочник.КонтурEDI_ДополнительныеСправочники)) = &Партнер
		 |	И КонтурEDI_ДополнительныеРеквизиты.Свойство = ""ПартнерКонтрагента""";
		 
	Запрос.УстановитьПараметр("Партнер", Партнер);
		 
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Контрагент");
	
КонецФункции

Функция ПредставлениеОрганизации(МассивОрганизаций) Экспорт
	
	Результат = Новый Соответствие;
	
	ЮрФизЛицаСвои = ПолучитьСписокЭлементовСправочника("ЮрФизЛицаСвои");
	
	Для Каждого Организация Из МассивОрганизаций Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("ЮрФизЛицо", Организация);
		НайденныеСтроки = ЮрФизЛицаСвои.НайтиСтроки(Отбор);	
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			Результат.Вставить(Организация, Строка(Организация) + " (" + НайденныеСтроки[0].GLN + ")");			
		Иначе
			Результат.Вставить(Организация, Строка(Организация));	
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеСертификата(СвойстваСертификата, Краткое = Ложь) Экспорт
	
	ФИО = СокрЛП(Строка(СвойстваСертификата.Субъект.Фамилия) + " " + Строка(СвойстваСертификата.Субъект.Имя) + " " + Строка(СвойстваСертификата.Субъект.Отчество));
	ИНН = СокрЛП(?(ЗначениеЗаполнено(СвойстваСертификата.Субъект.ИННЮЛ), СвойстваСертификата.Субъект.ИННЮЛ, СвойстваСертификата.Субъект.ИНН));
	НаименованиеОрганизацииСубъекта = ?(ЗначениеЗаполнено(СвойстваСертификата.Субъект.Организация), СвойстваСертификата.Субъект.Организация, ФИО); 	
	
	Представление = ?(ЗначениеЗаполнено(НаименованиеОрганизацииСубъекта), НаименованиеОрганизацииСубъекта, "<Неизвестно>");
	ИНН = ?(ЗначениеЗаполнено(ИНН), ИНН, "<Неизвестно>");

	Если Краткое Тогда
		
		Представление = Представление + ", " + ИНН; 
		
	Иначе
		
		Представление = Представление + Символы.ПС;
		
		ДанныеДляЗаполнения = Новый Массив;
		ДанныеДляЗаполнения.Добавить("ИНН: " + ИНН);
		Если ЗначениеЗаполнено(ФИО) Тогда
			ДанныеДляЗаполнения.Добавить(ФИО);
		КонецЕсли;
		
		Для Каждого Строка Из ДанныеДляЗаполнения Цикл
			Представление = Представление + Строка + Символы.ПС;			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции

Функция СохранитьДоверенность(Новый_Доверенность) Экспорт
	
	ЭлементОбъект = Справочники.КонтурEDI_ДополнительныеСправочники.СоздатьЭлемент();
	
	ЭлементОбъект.Наименование = Новый_Доверенность.Идентификатор;
	ЭлементОбъект.ИмяСправочника = "Доверенность";
	
	ДопРеквизиты = Новый Структура;
	ДопРеквизиты.Вставить("Идентификатор");
	ДопРеквизиты.Вставить("НаименованиеОрганизации");
	ДопРеквизиты.Вставить("ИННОрганизации");
	ДопРеквизиты.Вставить("КППОрганизации");
	ДопРеквизиты.Вставить("ДатаВыдачи");
	ДопРеквизиты.Вставить("СрокДействия");
	ДопРеквизиты.Вставить("ДоверенноеЛицоФамилия");
	ДопРеквизиты.Вставить("ДоверенноеЛицоИмя");
	ДопРеквизиты.Вставить("ДоверенноеЛицоОтчество");
	ДопРеквизиты.Вставить("ДоверенноеЛицоФИО");
	ДопРеквизиты.Вставить("КраткоеПредставление");
	ДопРеквизиты.Вставить("ПолноеПредставление");
	
	ЗаполнитьЗначенияСвойств(ДопРеквизиты, Новый_Доверенность);
	
	ЗаполнитьДопРеквизитыОбъектаСправочника_КонтурEDI(ЭлементОбъект, ДопРеквизиты);
	
	ДополнительныеРеквизитыХранилищеЗначений = Новый Массив;
	ДополнительныеРеквизитыХранилищеЗначений.Добавить("ДвоичныеДанныеДоверенности");
	ДополнительныеРеквизитыХранилищеЗначений.Добавить("ДвоичныеДанныеПодписи");
	
	Для Каждого ДополнительныйРеквизит Из ДополнительныеРеквизитыХранилищеЗначений Цикл
		
		НоваяЗапись = ЭлементОбъект.ДополнительныеРеквизиты.Добавить();
		НоваяЗапись.ИмяРеквизита = ДополнительныйРеквизит;
		НоваяЗапись.Значение = "ХранилищеЗначений";
		НоваяЗапись.ЗначениеХранилищеЗначения = Новый ХранилищеЗначения(Новый_Доверенность[ДополнительныйРеквизит]);
		
	КонецЦикла; 
	
	ЭлементОбъект.Записать();
	
	Возврат ЭлементОбъект.Ссылка;
	
КонецФункции

Функция НайтиДоверенность(Идентификатор) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	КонтурEDI_ДополнительныеСправочники.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
		|ГДЕ
		|	КонтурEDI_ДополнительныеСправочники.Наименование = &Идентификатор
		|	И КонтурEDI_ДополнительныеСправочники.ИмяСправочника = ""Доверенность""";
	
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция СписокСохраненныхДоверенностей() Экспорт
	              
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурEDI_ДополнительныеСправочники.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
		|ГДЕ
		|	НЕ КонтурEDI_ДополнительныеСправочники.ПометкаУдаления
		|	И КонтурEDI_ДополнительныеСправочники.ИмяСправочника = ""Доверенность""";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	МассивДоверенностей = Новый Массив;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ДоверенностьСсылка = ВыборкаДетальныеЗаписи.Ссылка;
		
		Новый_Доверенность = ДовереностьСсылка_В_Новый_Доверенность(ДоверенностьСсылка);
		МассивДоверенностей.Добавить(Новый_Доверенность);
	КонецЦикла;                                
	
	Возврат МассивДоверенностей;
	
КонецФункции

