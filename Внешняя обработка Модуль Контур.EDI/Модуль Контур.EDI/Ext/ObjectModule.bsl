			УстановитьЗначениеСвойстваОбъекта(Стр.ТочкаДоставки, "ТипЛокализацииТочки",		Стр.ТипЛокализации, Отказ);
			
		КонецЕсли;		
		
		Если Отказ Тогда 
			Прервать;
