	konturediauth_token 		= "konturediauth_token="""    	 + Токен + """";
	
	Authorization = "KonturEdiAuth " + konturediauth_api_client_id + "," + konturediauth_token; 
	
	ПараметрыЗапроса.Заголовки.Вставить("Authorization", Authorization);
	Если ПараметрыЗапроса.Заголовки.Получить("Accept") = Неопределено Тогда
		ПараметрыЗапроса.Заголовки.Вставить("Accept", "application/xml");
	КонецЕсли;

	НастройкиПрокси = ПолучитьПараметрыИнтернетСоединения_KE();
	
