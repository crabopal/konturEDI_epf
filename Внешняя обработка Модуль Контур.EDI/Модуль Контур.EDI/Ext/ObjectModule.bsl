КонецФункции

Функция ДовереностьСсылка_В_Новый_Доверенность(ДоверенностьСсылка) Экспорт

	Новый_МашиночитаемаяДоверенность = КонтурДиадокAPI_СоздатьПоСхеме("PowerOfAttorney", Истина); 
	
	ТабличнаяЧасть = ДоверенностьСсылка.ДополнительныеРеквизиты.Выгрузить();
	
	СтруктураЗначений = Новый Структура;
	СтруктураЗначенийХранилищеЗначений = Новый Структура;
	
	Для Каждого СтрокаТабличнойЧасти Из ТабличнаяЧасть Цикл
		
		СтруктураЗначений.Вставить(СтрокаТабличнойЧасти.ИмяРеквизита, СтрокаТабличнойЧасти.Значение);
		
	КонецЦикла;
	
	Новый_МашиночитаемаяДоверенность = Контракт_СтараяМашиночитаемаяДоверенность_В_МашиночитаемаяДоверенность(СтруктураЗначений);
	
	Возврат Новый_МашиночитаемаяДоверенность;
	
КонецФункции

Функция Контракт_СтараяМашиночитаемаяДоверенность_В_МашиночитаемаяДоверенность(Контракт_СтараяМашиночитаемаяДоверенность) Экспорт
	
	Новый_МашиночитаемаяДоверенность = КонтурДиадокAPI_СоздатьПоСхеме("PowerOfAttorney", Истина);	 
	
	Новый_МашиночитаемаяДоверенность.СоставнойИдентификатор.РегистрационныеНомер = Контракт_СтараяМашиночитаемаяДоверенность.Идентификатор;
	Новый_МашиночитаемаяДоверенность.СоставнойИдентификатор.ИННДоверителя 		 = Контракт_СтараяМашиночитаемаяДоверенность.ИННОрганизации;
	
	Новый_МашиночитаемаяДоверенность.Представитель.ФИО.Фамилия 	= Контракт_СтараяМашиночитаемаяДоверенность.ДоверенноеЛицоФамилия;
	Новый_МашиночитаемаяДоверенность.Представитель.ФИО.Имя 		= Контракт_СтараяМашиночитаемаяДоверенность.ДоверенноеЛицоИмя;
	Новый_МашиночитаемаяДоверенность.Представитель.ФИО.Отчество = Контракт_СтараяМашиночитаемаяДоверенность.ДоверенноеЛицоОтчество; 
	                                                  
	Новый_МашиночитаемаяДоверенность.Доверитель.Тип = "LegalEntity";
	
	Новый_МашиночитаемаяДоверенность.Доверитель.ЮридическоеЛицо.ИНН = Контракт_СтараяМашиночитаемаяДоверенность.ИННОрганизации;
	Новый_МашиночитаемаяДоверенность.Доверитель.ЮридическоеЛицо.КПП = Контракт_СтараяМашиночитаемаяДоверенность.КППОрганизации;
	Новый_МашиночитаемаяДоверенность.Доверитель.ЮридическоеЛицо.Наименование = Контракт_СтараяМашиночитаемаяДоверенность.НаименованиеОрганизации;
	
	Новый_МашиночитаемаяДоверенность.СрокДействия = Контракт_СтараяМашиночитаемаяДоверенность.СрокДействия;
	Новый_МашиночитаемаяДоверенность.ДатаНачала   = Контракт_СтараяМашиночитаемаяДоверенность.ДатаВыдачи; 
	
	Возврат	Новый_МашиночитаемаяДоверенность;
	
КонецФункции

Функция TimeStampToDate(TimeStamp)
	Возврат Дата('00010101')+ TimeStamp / 10000000;
КонецФункции

Функция Представление_ФИО(Фамилия, Имя, Отчество) Экспорт
	
	Возврат "" + Фамилия + " " + Имя + ?(ЗначениеЗаполнено(Отчество), " " + Отчество, "");
	
КонецФункции

Функция Представление_ИННКПП(ИНН, КПП = "", Разделитель = "/") Экспорт
	
	Результат = "";
	
	Если ЗначениеЗаполнено(ИНН) Тогда
		Если ЗначениеЗаполнено(КПП) Тогда
			Результат = Результат + "ИНН" + Разделитель + "КПП: " + ИНН + Разделитель + КПП;
		Иначе
			Результат = Результат + "ИНН: " + ИНН;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Представление_МашиночитаемаяДоверенность_Представитель(МашиночитаемаяДоверенность) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ФИО");
	Результат.Вставить("ИНН");
	Результат.Вставить("ИННБезЗаголовка");
	Результат.Вставить("Организация", Новый Структура("Наименование,ИННКПП"));
	
	Представитель = МашиночитаемаяДоверенность.Представитель;
	Организация = Представитель.Организация;
	
	ФИО = Представитель.ФИО;
	
	Фамилия = ФИО.Фамилия;
	Имя = ФИО.Имя;
	Отчество = ФИО.Отчество;
	
	Результат.ФИО = Представление_ФИО(Фамилия, Имя, Отчество);
	Результат.ИНН = Представление_ИННКПП(Представитель.ИНН);
	Результат.ИННБезЗаголовка = Представитель.ИНН;
	Результат.Организация.Наименование = Организация.Наименование;
	Результат.Организация.ИННКПП = Представление_ИННКПП(Организация.ИНН, Организация.КПП, "-");
	
	Возврат Результат;
	
КонецФункции

Функция Представление_МашиночитаемаяДоверенность_Доверитель(МашиночитаемаяДоверенность) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Наименование");
	Результат.Вставить("Тип");
	Результат.Вставить("ИННКПП");
	Результат.Вставить("ИННБезЗаголовка","");
	Результат.Вставить("КППБезЗаголовка","");
	
	Доверитель = МашиночитаемаяДоверенность.Доверитель;
	ТипДоверителя = МашиночитаемаяДоверенность.Доверитель.Тип;
	
	Если Врег(ТипДоверителя) = Врег("UnknownIssuerType") ИЛИ Врег(ТипДоверителя) = Врег("Неизвестно") Тогда
		
		Результат.Наименование = "<< Неизвестно >>";
		Результат.Тип = "Неизвестно";
		Результат.ИННКПП = "";
		
		Возврат Результат;
		
	ИначеЕсли Врег(ТипДоверителя) = Врег("IndividualEntity") ИЛИ Врег(ТипДоверителя) = Врег("ИндивидуальныйПредприниматель") Тогда 
		
		ИндивидуальныйПредприниматель = Доверитель.ИндивидуальныйПредприниматель;
		
		Результат.Наименование = ИндивидуальныйПредприниматель.Наименование;
		Результат.Тип = "Индивидуальный предприниматель";
		Результат.ИННКПП = Представление_ИННКПП(ИндивидуальныйПредприниматель.ИНН, "", "-");
		Результат.ИННБезЗаголовка = ИндивидуальныйПредприниматель.ИНН;
		
		Возврат Результат;
		
	ИначеЕсли Врег(ТипДоверителя) = Врег("ForeignEntity") ИЛИ Врег(ТипДоверителя) = Врег("ИностраннаяОрганизация") Тогда
		
		ИностраннаяОрганизация = Доверитель.ИностраннаяОрганизация;
		
		Результат.Наименование = ИностраннаяОрганизация.Наименование;
		Результат.Тип = "Иностранная организация";
		Результат.ИННКПП = Представление_ИННКПП(ИностраннаяОрганизация.ИНН, ИностраннаяОрганизация.КПП, "-");
		Результат.ИННБезЗаголовка = ИностраннаяОрганизация.ИНН;
		Результат.КППБезЗаголовка = ИностраннаяОрганизация.КПП;
		
		Возврат Результат;
		
	ИначеЕсли Врег(ТипДоверителя) = Врег("PhysicalEntity") ИЛИ Врег(ТипДоверителя) = Врег("ФизическоеЛицо") Тогда
		
		ФизическоеЛицо = Доверитель.ФизическоеЛицо;
		
		ФИО = ФизическоеЛицо.ФИО;
		
		Фамилия = ФИО.Фамилия;
		Имя = ФИО.Имя;
		Отчество = ФИО.Отчество;
		
		Результат.Наименование = Представление_ФИО(Фамилия, Имя, Отчество);
		Результат.Тип = "Физическое лицо";
		Результат.ИННКПП = Представление_ИННКПП(ФизическоеЛицо.ИНН, "", "-");
		Результат.ИННБезЗаголовка = ФизическоеЛицо.ИНН;
		
		Возврат Результат;
		
	ИначеЕсли Врег(ТипДоверителя) = Врег("LegalEntity") ИЛИ Врег(ТипДоверителя) = Врег("ЮридическоеЛицо") Тогда 
		
		ЮридическоеЛицо = Доверитель.ЮридическоеЛицо; 
		
		Результат.Наименование = ЮридическоеЛицо.Наименование;
		Результат.Тип = "Юридическое лицо";
		Результат.ИННКПП = Представление_ИННКПП(ЮридическоеЛицо.ИНН, ЮридическоеЛицо.КПП, "-");
		Результат.ИННБезЗаголовка = ЮридическоеЛицо.ИНН;
		Результат.КППБезЗаголовка = ЮридическоеЛицо.КПП;
		
		Возврат Результат;
		
	Иначе
		
		Результат.Наименование = "<< Неизвестно >>";
		Результат.Тип = "Неизвестно";
		Результат.ИННКПП = "";
		
		Возврат Результат;
		
	КонецЕсли;
	
КонецФункции

Функция Представление_МашиночитаемаяДоверенность_ФормаСписка(МашиночитаемаяДоверенность) Экспорт
	
	Доверитель = Представление_МашиночитаемаяДоверенность_Доверитель(МашиночитаемаяДоверенность);
	Представитель = Представление_МашиночитаемаяДоверенность_Представитель(МашиночитаемаяДоверенность);
	
	Представление = "" + Доверитель.Наименование + "
	|" + Доверитель.ИННКПП + "
	|" + Представитель.ФИО;
	
	Возврат Представление;
	
КонецФункции

Функция Представление_МашиночитаемаяДоверенность_Краткое(МашиночитаемаяДоверенность) Экспорт
	
	Доверитель = Представление_МашиночитаемаяДоверенность_Доверитель(МашиночитаемаяДоверенность);
	Представитель = Представление_МашиночитаемаяДоверенность_Представитель(МашиночитаемаяДоверенность);
	
	Представление = "" + Доверитель.Наименование + ", " + Представитель.ФИО;
	
	Возврат Представление;
	
КонецФункции

Функция Представление_МашиночитаемаяДоверенность_ТабличныйДокумент(МашиночитаемаяДоверенность, ОтображатьЦепочкуПередоверия = Истина) Экспорт
	
	ПредставлениеДоверенности = Новый ТабличныйДокумент;
	
	МакетДоверенности = ПолучитьМакет_КонтурEDI("ПредставлениеМашиночитаемойДоверенности","mxl",Истина,Ложь,Истина,Истина);

	ОбластьРегистрационныйНомер 			= МакетДоверенности.ПолучитьОбласть("РегистрационныйНомер");
	ОбластьПредставитель 					= МакетДоверенности.ПолучитьОбласть("Представитель");
	ОбластьОрганизацияПредставителя 		= МакетДоверенности.ПолучитьОбласть("ОрганизацияПредставителя");
	ОбластьДоверитель 						= МакетДоверенности.ПолучитьОбласть("Доверитель");
	ОбластьСрокДействия 					= МакетДоверенности.ПолучитьОбласть("СрокДействия");
	ОбластьГиперссылкаФНС 					= МакетДоверенности.ПолучитьОбласть("ГиперссылкаНаСайтФНС");
	ОбластьГиперссылкаСведенияОПолномочиях 	= МакетДоверенности.ПолучитьОбласть("ЗаголовокСведенияОПолномочиях");
	ОбластьГиперссылкаЦепочкаПередоверия	= МакетДоверенности.ПолучитьОбласть("ЗаголовокЦепочкаПередоверия");
	ОбластьОтступМеждуГруппами				= МакетДоверенности.ПолучитьОбласть("ОтступМеждуГруппами");
	
	ПредставлениеДоверенности.НачатьАвтогруппировкуСтрок();
	
	РегистрационныйНомер	 = МашиночитаемаяДоверенность.СоставнойИдентификатор.РегистрационныеНомер;
	Доверитель				 = Представление_МашиночитаемаяДоверенность_Доверитель(МашиночитаемаяДоверенность);
	Представитель			 = Представление_МашиночитаемаяДоверенность_Представитель(МашиночитаемаяДоверенность);
	ЦепочкаПередоверия		 = МашиночитаемаяДоверенность.ЦепочкаПередоверия;
	ГиперссылкаНаСайтФНС	 = МашиночитаемаяДоверенность_ГиперссылкаНаСайтФНС(РегистрационныйНомер, Доверитель.ИННБезЗаголовка, Представитель.ИННБезЗаголовка);
	ОрганизацияПредставителя = Неопределено;
	
	Если ЗначениеЗаполнено(Представитель.Организация.ИННКПП) ИЛИ ЗначениеЗаполнено(Представитель.Организация.Наименование) Тогда
		ОрганизацияПредставителя = Представитель.Организация;
	КонецЕсли;
	
	ОбластьРегистрационныйНомер.Параметры.Заполнить(МашиночитаемаяДоверенность.СоставнойИдентификатор);
	ОбластьПредставитель.Параметры.Заполнить(Представитель);
	
	Если Не ОрганизацияПредставителя = Неопределено Тогда
		ОбластьОрганизацияПредставителя.Параметры.Заполнить(ОрганизацияПредставителя);
	КонецЕсли;
	
	ОбластьДоверитель.Параметры.Заполнить(Доверитель);
	ОбластьСрокДействия.Параметры.Заполнить(МашиночитаемаяДоверенность);
	ОбластьГиперссылкаФНС.Параметры.ГиперссылкаНаСайтФНС = ГиперссылкаНаСайтФНС;

	ОбластьПолномочияДоверенности = Представление_ПолномочияМашиночитаемойДоверенности_ТабличныйДокумент(МашиночитаемаяДоверенность);
	
	Если ОтображатьЦепочкуПередоверия = Истина И ЦепочкаПередоверия.Количество() > 0 Тогда
				
		ОбластьЦепочкиПередоверия = Новый ТабличныйДокумент;
		
		Для Каждого ДоверенностьЦепочки Из ЦепочкаПередоверия Цикл
			ТабличныйДокументДоверенности = Представление_МашиночитаемаяДоверенность_ТабличныйДокумент(ДоверенностьЦепочки, Ложь);
			ОбластьЦепочкиПередоверия.Вывести(ТабличныйДокументДоверенности);
		КонецЦикла;
		
	КонецЕсли;	
	
	ПредставлениеДоверенности.Вывести(ОбластьРегистрационныйНомер, 0);
	ПредставлениеДоверенности.Вывести(ОбластьПредставитель, 0);
	
	Если Не ОрганизацияПредставителя = Неопределено Тогда
		ПредставлениеДоверенности.Вывести(ОбластьОрганизацияПредставителя, 0);
	КонецЕсли;
	
	ПредставлениеДоверенности.Вывести(ОбластьДоверитель, 0);
	ПредставлениеДоверенности.Вывести(ОбластьСрокДействия, 0);
	ПредставлениеДоверенности.Вывести(ОбластьГиперссылкаФНС, 0);
	
	ПредставлениеДоверенности.Вывести(ОбластьГиперссылкаСведенияОПолномочиях, 0);
	ПредставлениеДоверенности.Вывести(ОбластьПолномочияДоверенности, 1);
	
	Если ОтображатьЦепочкуПередоверия = Истина И ЦепочкаПередоверия.Количество() > 0 Тогда
		
		ПредставлениеДоверенности.Вывести(ОбластьГиперссылкаЦепочкаПередоверия, 0);
		ПредставлениеДоверенности.Вывести(ОбластьЦепочкиПередоверия, 1);
		
	КонецЕсли;
	
	ПредставлениеДоверенности.ЗакончитьАвтогруппировкуСтрок();
	
	Возврат ПредставлениеДоверенности;
	
КонецФункции

Функция Представление_МашиночитаемыеДоверенностиСообщения_ТабличныйДокумент(ДоверенностиСообщения) Экспорт
	
	ОбщийТабличныйДокумент = Новый ТабличныйДокумент;
	
	Макет = ПолучитьМакет("ПредставлениеМашиночитаемойДоверенности");
	
	ОбластьГруппаВходящиеДоверенности = Макет.ПолучитьОбласть("ГруппаВходящиеДоверенности");
	ОбластьГруппаИсходящиеДоверенности = Макет.ПолучитьОбласть("ГруппаИсходящиеДоверенности");
	ОбластьТекстНетДоверенностей = Макет.ПолучитьОбласть("ТекстНетДоверенностей");
	ОбластьОтступМеждуГруппами = Макет.ПолучитьОбласть("ОтступМеждуГруппами");
	
	ОбщийТабличныйДокумент.НачатьАвтогруппировкуСтрок();
	
	Если ДоверенностиСообщения.Исходящие.Количество() > 0 Тогда
		
		ОбщийТабличныйДокумент.Вывести(ОбластьГруппаИсходящиеДоверенности,0);
		
		Для каждого Доверенность Из ДоверенностиСообщения.Исходящие Цикл
			ТабличныйДокументДоверенности = Представление_МашиночитаемаяДоверенность_ТабличныйДокумент(Доверенность);
			ОбщийТабличныйДокумент.Вывести(ТабличныйДокументДоверенности, 1);
		КонецЦикла;
		
		ОбщийТабличныйДокумент.Вывести(ОбластьОтступМеждуГруппами, 0);
		
	КонецЕсли;
	
	Если ДоверенностиСообщения.Входящие.Количество() > 0 Тогда
		
		ОбщийТабличныйДокумент.Вывести(ОбластьГруппаВходящиеДоверенности, 0);
		
		Для каждого Доверенность Из ДоверенностиСообщения.Входящие Цикл
			ТабличныйДокументДоверенности = Представление_МашиночитаемаяДоверенность_ТабличныйДокумент(Доверенность);
			ОбщийТабличныйДокумент.Вывести(ТабличныйДокументДоверенности, 1);
		КонецЦикла;
		
	КонецЕсли;
	
	Если ДоверенностиСообщения.Исходящие.Количество() = 0 
		И ДоверенностиСообщения.Входящие.Количество() = 0 Тогда
		
		ОбщийТабличныйДокумент.Вывести(ОбластьТекстНетДоверенностей);
		
	КонецЕсли;
	
	ОбщийТабличныйДокумент.ЗакончитьАвтогруппировкуСтрок();
	
	Возврат ОбщийТабличныйДокумент;
	
КонецФункции

Функция Представление_ПолномочияМашиночитаемойДоверенности_ТабличныйДокумент(ДоверенностьСообщения) 
	
	ИнформацияОПолномочиях = ДоверенностьСообщения.ИнформацияОПолномочиях;
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Макет = ПолучитьМакет("ПредставлениеМашиночитаемойДоверенности");
	
	ОбластьЗаголовокСведенийОПолномочиях		= Макет.ПолучитьОбласть("ЗаголовокСведенийОПолномочиях");
	ОбластьИнформацияОПолномочиях 				= Макет.ПолучитьОбласть("ИнформацияОПолномочиях");
	ОбластьЗаголовокМашиночитаемыхПолномочий	= Макет.ПолучитьОбласть("ЗаголовокМашиночитаемыхПолномочий");
	ОбластьЗаголовокТекстовыхПолномочий			= Макет.ПолучитьОбласть("ЗаголовокТекстовыхПолномочий");
	ОбластьЗаголовокОграничений					= Макет.ПолучитьОбласть("ЗаголовокОграничений");
	ОбластьПредставлениеПолномочия 				= Макет.ПолучитьОбласть("ПредставлениеПолномочия");
	ОбластьОграничение							= Макет.ПолучитьОбласть("Ограничение");
	ОбластьОтступМеждуГруппами					= Макет.ПолучитьОбласть("ОтступМеждуГруппами");
	
	ТабличныйДокумент.Вывести(ОбластьЗаголовокСведенийОПолномочиях);
	
	ОбщиеСведения = Представление_ПолномочияМашиночитаемойДоверенности_ОбщиеСведенияОПолномочиях(ИнформацияОПолномочиях);
	
	Если ЗначениеЗаполнено(ОбщиеСведения.СовместноеОсуществление) Тогда
		
		ОбластьИнформацияОПолномочиях.Параметры.ИнформацияОПолномочиях = ОбщиеСведения.СовместноеОсуществление;
		ТабличныйДокумент.Вывести(ОбластьИнформацияОПолномочиях);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбщиеСведения.УтратаПолномочий) Тогда
		
		ОбластьИнформацияОПолномочиях.Параметры.ИнформацияОПолномочиях = ОбщиеСведения.УтратаПолномочий;
		ТабличныйДокумент.Вывести(ОбластьИнформацияОПолномочиях);
		
	КонецЕсли;
	
	ТипыПолномочий = Новый Структура;
	ТипыПолномочий.Вставить("Машиночитаемые", Новый Массив);
	ТипыПолномочий.Вставить("Текстовые", Новый Массив);
	
	Для каждого Полномочие Из ИнформацияОПолномочиях.Полномочия Цикл
		
		Если НРег(Полномочие.Тип) = "text" Тогда
			
			ТипыПолномочий.Текстовые.Добавить(Полномочие);
			
		ИначеЕсли НРег(Полномочие.Тип) = "machinereadable" Тогда
			
			Для каждого МашиночитаемоеПолномочие Из Полномочие.МашиночитаемыеПолномочия Цикл
				ТипыПолномочий.Машиночитаемые.Добавить(МашиночитаемоеПолномочие);
			КонецЦикла;
			
		КонецЕсли;		
		
	КонецЦикла;
	
	Если ТипыПолномочий.Машиночитаемые.Количество() > 0 Тогда
		ТабличныйДокумент.Вывести(ОбластьЗаголовокМашиночитаемыхПолномочий);
	КонецЕсли;
	
	Для каждого Полномочие Из ТипыПолномочий.Машиночитаемые Цикл
		
		ОбластьПредставлениеПолномочия.Параметры.ПредставлениеПолномочия = Полномочие.Наименование;	
		ТабличныйДокумент.Вывести(ОбластьПредставлениеПолномочия);
		
		Если Полномочие.Ограничения.Количество() > 0 Тогда
			ТабличныйДокумент.Вывести(ОбластьЗаголовокОграничений);
		КонецЕсли;
		
		Для каждого Ограничение Из Полномочие.Ограничения Цикл
			
			ОбластьОграничение.Параметры.Наименование = Ограничение.Наименование;
			
			Если ЗначениеЗаполнено(Ограничение.НаименованиеЗначения) Тогда
				ОбластьОграничение.Параметры.Значение = Ограничение.НаименованиеЗначения;
			Иначе
				ОбластьОграничение.Параметры.Значение = Ограничение.ТекстЗначения;
			КонецЕсли;
			
			ТабличныйДокумент.Вывести(ОбластьОграничение);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если ТипыПолномочий.Текстовые.Количество() > 0 Тогда
		
		ТабличныйДокумент.Вывести(ОбластьЗаголовокТекстовыхПолномочий);
		
		Для каждого Полномочие Из ТипыПолномочий.Текстовые Цикл
			
			ОбластьПредставлениеПолномочия.Параметры.ПредставлениеПолномочия = Полномочие.ТекстовоеСодержание;	
			ТабличныйДокумент.Вывести(ОбластьПредставлениеПолномочия);
			
		КонецЦикла;
		
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(ОбластьОтступМеждуГруппами);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция Представление_ПолномочияМашиночитаемойДоверенности_ОбщиеСведенияОПолномочиях(ИнформацияОПолномочиях)
	
	ОбщаяИнформацияОПолномочиях = Новый Структура;
	ОбщаяИнформацияОПолномочиях.Вставить("СовместноеОсуществление", "");
	ОбщаяИнформацияОПолномочиях.Вставить("УтратаПолномочий", "");
	
	Если НРег(ИнформацияОПолномочиях.СовместноеОсуществление) = "personal" Тогда
		ОбщаяИнформацияОПолномочиях.СовместноеОсуществление = "Полномочия индивидуальные";
	ИначеЕсли НРег(ИнформацияОПолномочиях.СовместноеОсуществление) = "group" Тогда
		ОбщаяИнформацияОПолномочиях.СовместноеОсуществление = "Полномочия совместные";
	ИначеЕсли ЗначениеЗаполнено(ИнформацияОПолномочиях.СовместноеОсуществление) Тогда
		ОбщаяИнформацияОПолномочиях.СовместноеОсуществление = "Тип совместного осуществления: " + ИнформацияОПолномочиях.СовместноеОсуществление;
	КонецЕсли;
	
	Если НРег(ИнформацияОПолномочиях.УтратаПолномочий) = "notlossontransfer" Тогда
		ОбщаяИнформацияОПолномочиях.УтратаПолномочий = "Не утрачиваются при передоверии";
	ИначеЕсли НРег(ИнформацияОПолномочиях.УтратаПолномочий) = "lossontransfer" Тогда
		ОбщаяИнформацияОПолномочиях.УтратаПолномочий = "Утрачиваются при передоверии";
	ИначеЕсли ЗначениеЗаполнено(ИнформацияОПолномочиях.УтратаПолномочий) Тогда
		ОбщаяИнформацияОПолномочиях.УтратаПолномочий = "Тип утраты полномочий: " + ИнформацияОПолномочиях.УтратаПолномочий;
	КонецЕсли;
	
	Возврат ОбщаяИнформацияОПолномочиях;
	
КонецФункции

Функция МашиночитаемаяДоверенность_ГиперссылкаНаСайтФНС(РегистрационныйНомер, ИННДоверителя, ИННПредставителя) Экспорт
	
	Если ЗначениеЗаполнено(РегистрационныйНомер)
		И ЗначениеЗаполнено(ИННДоверителя)
		И ЗначениеЗаполнено(ИННПредставителя) Тогда
	
		Возврат ШаблонСтр("https://m4d.nalog.gov.ru/EMCHD/get-info?guid=%1&innP=%2&innR=%3",
			  			  РегистрационныйНомер,
			  			  ИННДоверителя,
			  			  ИННПредставителя);
						  
	Иначе
		
		Возврат  "https://m4d.nalog.gov.ru/EMCHD/get-info";
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьИдентификаторыДоверенностейСообщения(СсылкаНаСообщение) Экспорт

	ИдентификаторыДоверенностей = Новый Структура;
	ИдентификаторыДоверенностей.Вставить("Входящие", Новый Массив);
	ИдентификаторыДоверенностей.Вставить("Исходящие", Новый Массив);
	
	ИмяРеквизитаВходящейДоверенности = "Вх_ИдентификаторМЧДВПакетеДокументов";
	ИмяРеквизитаИсходящейДоверенности = "Исх_ИдентификаторМЧДВПакетеДокументов";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КонтурEDI_СообщенияДополнительныеРеквизиты.ИмяРеквизита КАК РеквизитНаправления,
	               |	КонтурEDI_СообщенияДополнительныеРеквизиты.Значение КАК Идентификатор
	               |ИЗ
	               |	Справочник.КонтурEDI_Сообщения.ДополнительныеРеквизиты КАК КонтурEDI_СообщенияДополнительныеРеквизиты
	               |ГДЕ
	               |	КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка = &Ссылка
	               |	И (КонтурEDI_СообщенияДополнительныеРеквизиты.ИмяРеквизита = &ИмяРеквизитаВходящейДоверенности
	               |			ИЛИ КонтурEDI_СообщенияДополнительныеРеквизиты.ИмяРеквизита = &ИмяРеквизитаИсходящейДоверенности)";
	
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаСообщение);
	Запрос.УстановитьПараметр("ИмяРеквизитаВходящейДоверенности", ИмяРеквизитаВходящейДоверенности);
	Запрос.УстановитьПараметр("ИмяРеквизитаИсходящейДоверенности", ИмяРеквизитаИсходящейДоверенности);
	
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Если Выборка.РеквизитНаправления = ИмяРеквизитаВходящейДоверенности Тогда
				ИдентификаторыДоверенностей.Входящие.Добавить(Выборка.Идентификатор);		
			Иначе
				ИдентификаторыДоверенностей.Исходящие.Добавить(Выборка.Идентификатор);		
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ИдентификаторыДоверенностей;
	
КонецФункции

Функция ПолучитьОбязательныеПоляШапкиНезависимогоСообщения(ТипСообщения)

	ОбязательныеПоляШапки = Новый Структура;
	
	Если ТипСообщения = "DELFOR" Тогда
		
		ОбязательныеПоляШапки.Вставить("Отправитель", "Отправитель");
		ОбязательныеПоляШапки.Вставить("Продавец", "Продавец");
		ОбязательныеПоляШапки.Вставить("Покупатель", "Покупатель");
		ОбязательныеПоляШапки.Вставить("Получатель", "Партнер");
			
	КонецЕсли;
	
	Если ТипСообщения = "INVRPT" Тогда 
		
		ОбязательныеПоляШапки.Вставить("Партнер");
		ОбязательныеПоляШапки.Вставить("Организация");
		ОбязательныеПоляШапки.Вставить("Контрагент");
		ОбязательныеПоляШапки.Вставить("Продавец");
		ОбязательныеПоляШапки.Вставить("ДатаНачалаПериода");
		ОбязательныеПоляШапки.Вставить("ДатаОкончанияПериода");

	КонецЕсли;
	
	Возврат ОбязательныеПоляШапки;

КонецФункции

Функция ПолучитьОбязательныеПоляТЧНезависимогоСообщения(ТипСообщения)

	ОбязательныеПоляСтроки = Новый Структура;
	
	Если ТипСообщения = "DELFOR" Тогда
		
		ОбязательныеПоляСтроки.Вставить("ТорговаяТочкаGLN", "GLN торговой точки");
		ОбязательныеПоляСтроки.Вставить("ИмяГрафикаПоставок", "Имя графика поставок");
		ОбязательныеПоляСтроки.Вставить("НомерГрафикаПоставок", "Номер графика поставок");
		ОбязательныеПоляСтроки.Вставить("СтатусГрафика", "Статус графика");
		ОбязательныеПоляСтроки.Вставить("ДлительностьГрафика", "Длительность графика");
		
	КонецЕсли;
	
	Возврат ОбязательныеПоляСтроки;

КонецФункции

Функция ПодготовитьИсходящееНезависимоеСообщение(ТипСообщения, Товары, Параметры = Неопределено) Экспорт
	
	Если Параметры = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Сообщение = ПолучитьСтруктуруСообщения(ТипСообщения, "Исходящее");
	
	Если Сообщение.ТипСообщения = "PRICELIST" Тогда
		
		ПодготовитьПрайсЛист(Сообщение, Товары, Параметры);
		
	ИначеЕсли Сообщение.ТипСообщения = "SLSRPT" Тогда	
		
		ПодготовитьОтчетОПродажах(Сообщение, Товары, Параметры);
		
	ИначеЕсли Сообщение.ТипСообщения = "INVRPT" Тогда
		
		ПодготовитьОтчетОбОстатках(Сообщение, Товары, Параметры);
		
	ИначеЕсли Сообщение.ТипСообщения = "DELFOR" Тогда
		
		ПодготовитьГрафикПоставок(Сообщение, Товары, Параметры);
		
	КонецЕсли;
	
	Если Параметры.Свойство("ПереотправляемоеСообщениеСсылка") Тогда 
		Сообщение.Вставить("ПереотправляемоеСообщениеСсылка", Параметры.ПереотправляемоеСообщениеСсылка);
	КонецЕсли;
	
	Если Параметры.Свойство("СообщениеСсылка") Тогда
		Сообщение.Вставить("СообщениеСсылка", Параметры.СообщениеСсылка);
	КонецЕсли;
	
	Если Параметры.Свойство("ВыгружатьОстаткиВПрайсЛист") И Параметры.ВыгружатьОстаткиВПрайсЛист = Истина Тогда 
		Сообщение.Вставить("ВыгружатьОстаткиВПрайсЛист", Параметры.ВыгружатьОстаткиВПрайсЛист);
	Иначе
		Сообщение.Вставить("ВыгружатьОстаткиВПрайсЛист", Ложь);
	КонецЕсли;
	
	Если Параметры.Свойство("Склад") И ЗначениеЗаполнено(Параметры.Склад) Тогда 
		Сообщение.Вставить("Склад", Параметры.Склад);
	КонецЕсли;   
	
	Сообщение.Документ1С = "";
	
	КонвертироватьСообщение1СвEDI(Сообщение);
	ПересчитатьТоварыСообщения(Сообщение.Товары, Параметры.Партнер, "ВEDI", Сообщение);
	
	Если Параметры.Свойство("Особенности") Тогда
		
		ЭтаФорма = Неопределено;
		Параметры.Свойство("ЭтаФорма", ЭтаФорма);
		
		ПеренестиОсобенностиВСообщение(Сообщение, Параметры.Особенности, Товары, ЭтаФорма);
		
	КонецЕсли;
	
	Если Параметры.Свойство("ПроверитьСообщение") 
		И Параметры.ПроверитьСообщение = Истина Тогда
		
		РезультатПроверки = ПроверитьПоляСообщения(Сообщение);
		Сообщение.СодержитОшибки =  НЕ РезультатПроверки.Успешно;
		
		Параметры.Вставить("РезультатПроверкиСообщения", РезультатПроверки);
	
	КонецЕсли;
	
	// кастомные заполнения
	РезультатПМ = ОбработкаСобытияПодключаемогоМодуля("ПослеПодготовкиИсходящегоСообщения",,
	Новый Структура("Сообщение,ДокументСсылка,Параметры",
	Сообщение, Неопределено, Параметры));
		
	Если РезультатПМ <> Неопределено Тогда
		Сообщение = РезультатПМ.Сообщение;
	КонецЕсли;
	
	Возврат Сообщение;
	
КонецФункции

Функция ПолучитьТоварыДляНезависимогоСообщения(ТипСообщения, Параметры) Экспорт
	
	СтандартнаяОбработкаEDI = Истина;
	
	ПараметрыПодключаемогоМодуля = Новый Структура("ТипСообщения, Параметры", ТипСообщения, Параметры);
	
	ТоварыРезультат = ОбработкаСобытияПодключаемогоМодуля("ПолучитьТоварыДляНезависимогоСообщения", СтандартнаяОбработкаEDI, ПараметрыПодключаемогоМодуля);
																			
	Результат = ИнициализироватьСтруктуруРезультатаФункции();

	Если СтандартнаяОбработкаEDI Тогда
		
		Если ТипСообщения = "INVRPT" Тогда
			ТоварыРезультат = ПолучитьТоварыДляОтчетаПоОстаткам(Параметры);
		КонецЕсли;
		
		Если ТипСообщения = "PRICELIST" Тогда
			ТоварыРезультат = ПолучитьТоварыДляПрайсЛиста(Параметры);
		КонецЕсли;
		
		Если ТипСообщения = "SLSRPT" Тогда
			ТоварыРезультат = ПолучитьТоварыДляОтчетаПоПродажам(Параметры);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТоварыРезультат = Неопределено Тогда
		
		Результат.ОписаниеОшибки = "Заполнение товаров для сообщения " + ТипСообщения + " не настроено." + Символы.ПС 
									+ "Необходимо воспользоваться событием расширения или подключаемого модуля ""ПолучитьТоварыДляНезависимогоСообщения"".";
		Возврат Результат;
		
	ИначеЕсли ТипСообщения = "PRICELIST"
		И ТоварыРезультат.Количество() = 0 Тогда
		
		Результат.ОписаниеОшибки = "Товары не добавлены, проверьте, что они не попадают в следующие категории:
									|
									| - товар помечен на удаление;
									| - с нулевой ценой для выбранного типа цен;
									| - товар по виду номенклатуры относится к услугам.";
		Возврат Результат;
		
	ИначеЕсли ТипСообщения = "INVRPT" 
		И ТоварыРезультат.Количество() = 0 Тогда 
		
		Результат.ОписаниеОшибки = "Товары не добавлены, проверьте, что они попадают в следующие категории:
									|
									| - Товар есть в доступном остатке;";
		
		Возврат Результат;
		
	КонецЕсли;
	
	Результат.Успешно = Истина;
	
	Если ТипСообщения = "PRICELIST" Тогда
		СтатусТовараПоУмолчанию = ?(ЗначениеЗаполнено(Параметры.СтатусТовараПоУмолчанию), Параметры.СтатусТовараПоУмолчанию, "Changed");
	ИначеЕсли ТипСообщения = "SLSRPT" Тогда
		// добавим колонки для расчетов цен/сумм
		// и подстрахуемся, проверим наличие новых колонок СтавкаНДСПродажи,СуммаВключаетНДС, чтобы старые ПМы не сломались
		ДобавитьКолонкиВТаблицуЗначений(ТоварыРезультат, "ЦенаСНДС,ЦенаБезНДС,СуммаСНДС,СуммаБезНДС,СуммаНДС,СтавкаНДСПродажи,СуммаВключаетНДС");
	КонецЕсли;
	
	СтруктураСообщения = ПолучитьСтруктуруСообщения(ТипСообщения, "Исходящее");
	Товары = СтруктураСообщения.Товары.Скопировать();
	
	РазрядностьОкругленияСуммИЦен = ПолучитьРазрядностьОкругленияДляСуммИЦен(Параметры.Партнер);															
	
	СтруктураПоискаДублей = Новый Структура;
	СтруктураПоискаДублей.Вставить("Номенклатура");
	
	ПоляПоискаДублейТоваров = ПоляПоискаДублейТоваровПрайсЛиста();
	Для каждого Поле Из ПоляПоискаДублейТоваров Цикл
		Если Не ТоварыРезультат.Колонки.Найти(Поле) = Неопределено Тогда
			СтруктураПоискаДублей.Вставить(Поле);
		КонецЕсли;
	КонецЦикла;
	
	СтандартнаяОбработкаEDI = Истина;
	
	ПараметрыПодключаемогоМодуля = Новый Структура("ТипСообщения, ТаблицаТоваровСообщения, РезультатЗапросаПоТоварам, СтруктураПоискаДублейТоваров, ПараметрыПодготовкиСообщения", 
													ТипСообщения, Товары, ТоварыРезультат, СтруктураПоискаДублей, Параметры);
	
	ОбработкаСобытияПодключаемогоМодуля("ПеренестиТоварыВНезависимоеСообщение", СтандартнаяОбработкаEDI, ПараметрыПодключаемогоМодуля);
	
	Если СтандартнаяОбработкаEDI = Истина Тогда	
	
		Для каждого Стр Из ТоварыРезультат Цикл
			
			Если ТипСообщения = "PRICELIST" Тогда
				
				ЗаполнитьЗначенияСвойств(СтруктураПоискаДублей, Стр);
				
				Если НЕ Товары.НайтиСтроки(СтруктураПоискаДублей).Количество() = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока = Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
				
				НоваяСтрока.СтавкаНДС1С = Стр.СтавкаНДС;
				НоваяСтрока.Статус 		= СтатусТовараПоУмолчанию;
				
				СтавкаНДС = ПолучитьСтавкуНДС_КонтурEDI(Стр.СтавкаНДС);
				Если Параметры.ЦенаВключаетНДС Тогда
					НоваяСтрока.ЦенаБезНДС	= Окр((Стр.Цена * 100) / (100 + СтавкаНДС), 2, 1);
					НоваяСтрока.ЦенаСНДС 	= Стр.Цена;
				Иначе	
					НоваяСтрока.ЦенаБезНДС 	= Стр.Цена;
					НоваяСтрока.ЦенаСНДС	= Окр((Стр.Цена * (100 + СтавкаНДС)) / 100, 2, 1);
				КонецЕсли;	
				
				КатегорияТовара 					= ПолучитьПредставлениеКаталога(Стр.Номенклатура);
				НоваяСтрока.Каталог 				= ?(ЗначениеЗаполнено(КатегорияТовара), КатегорияТовара, "Без категории");
				
				// Дополнительные реквизиты
				Если ЗначениеЗаполнено(Стр.КоличествоВОдномМесте) Тогда
					НоваяСтрока.КоличествоВОдномМесте = Стр.КоличествоВОдномМесте;
				Иначе
					НоваяСтрока.КоличествоВОдномМесте = 1;		
				КонецЕсли;

				НоваяСтрока.КвантПоставки 			= Стр.КвантПоставки;
				НоваяСтрока.Страна1С		    	= Стр.Страна;
				НоваяСтрока.СрокГодности 			= Стр.СрокГодности;
				НоваяСтрока.ЕдИзмСрокаГодности      = Стр.ЕдИзмСрокаГодности;
				
			ИначеЕсли ТипСообщения = "SLSRPT" Тогда
				
				НоваяСтрока = Товары.Добавить();
				
				Если Стр.СуммаВключаетНДС = Неопределено Тогда
					флСуммаВключаетНДС = Истина;
				Иначе
					флСуммаВключаетНДС = Стр.СуммаВключаетНДС;
				КонецЕсли;
				
				ДозаполнитьСуммыВСтрокеТоваровОтСуммыНДС(Стр, флСуммаВключаетНДС, , РазрядностьОкругленияСуммИЦен);
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
				
				НоваяСтрока.МестоПродаж1С 	= Стр.МестоПродаж;
				НоваяСтрока.Менеджер1С 		= Стр.Менеджер;
				НоваяСтрока.КаналСбыта1С 	= Стр.КаналСбыта;
				
				Если ЗначениеЗаполнено(Стр.СтавкаНДСПродажи) Тогда
					НоваяСтрока.СтавкаНДС1С = Стр.СтавкаНДСПродажи;
				Иначе
					НоваяСтрока.СтавкаНДС1С = Стр.СтавкаНДС;
				КонецЕсли;	
				
				СтавкаНДС = ПолучитьСтавкуНДС_КонтурEDI(Стр.СтавкаНДС);
				Если Параметры.ЦенаВключаетНДС Тогда
					НоваяСтрока.ЦенаПроизводителяБезНДС	= Окр((Стр.ЦенаПроизводителя * 100) / (100 + СтавкаНДС), 2, 1);
					НоваяСтрока.ЦенаПроизводителяСНДС	= Стр.ЦенаПроизводителя;
				Иначе                                   	
					НоваяСтрока.ЦенаПроизводителяБезНДС	= Стр.ЦенаПроизводителя;
					НоваяСтрока.ЦенаПроизводителяСНДС	= Окр((Стр.ЦенаПроизводителя * (100 + СтавкаНДС)) / 100, 2, 1);
				КонецЕсли;
				
				НоваяСтрока.СуммаПоЦенеПроизводителяСНДС 	= НоваяСтрока.ЦенаПроизводителяСНДС * Стр.Количество;
				НоваяСтрока.СуммаПоЦенеПроизводителяБезНДС	= Окр((НоваяСтрока.СуммаПоЦенеПроизводителяСНДС * 100) / (100 + СтавкаНДС), 2, 1);
				
			ИначеЕсли ТипСообщения = "INVRPT" Тогда
				
				НоваяСтрока = Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ТипСообщения = "PRICELIST" Тогда
		
		ИскатьСоответствияТоваровПоШтрихкоду = Ложь;
		МыПоставщик = Истина;
		
	ИначеЕсли ТипСообщения = "SLSRPT" Тогда 
			
		ИскатьСоответствияТоваровПоШтрихкоду = Истина;
		МыПоставщик = Ложь;
		
	ИначеЕсли ТипСообщения = "INVRPT" Тогда
		
		ИскатьСоответствияТоваровПоШтрихкоду = НЕ Параметры.МыПоставщик;
		МыПоставщик = Параметры.МыПоставщик;
		
	КонецЕсли;
	
	// ... подготовить таблицу товаров к конвертации
	ДопПараметры = ПараметрыПодготовкиТаблицыТоваров();
	
	ДопПараметры.СуммаВключаетНДС = флСуммаВключаетНДС;
	ДопПараметры.ЭтоТиповойЗапросПоПроведенномуЗаказу_УТ_УПП_КА = Ложь;
	ДопПараметры.Направление = "Исходящее";
	ДопПараметры.ТипСообщения = ТипСообщения;
	ДопПараметры.МыПоставщик = МыПоставщик;
	ДопПараметры.ЭтоОбратнаяОтгрузка = Ложь;
	
	ПодготовитьТаблицуТоваровККонвертации1СВEDI(Товары, Параметры.Партнер, ТипСообщения, ДопПараметры);
	
	КонвертироватьТовары1СвEDI(Товары, Параметры.Партнер, , ТипСообщения, , , , МыПоставщик);
	
	Если ТипСообщения = "INVRPT" Тогда 
		
		ЗаполнитьПредставлениеЕдиницыИзмеренияВТаблицеТоваров(Товары);
		
	КонецЕсли;
	
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("ДокументСсылка", Неопределено);
	ПараметрыПМ.Вставить("ТаблицаТоваров", Товары);
	ПараметрыПМ.Вставить("Источник", ТипСообщения);
	
	Если Параметры.Свойство("Сообщение") Тогда
		ПараметрыПМ.Вставить("Сообщение", Параметры.Сообщение);
	Иначе
		ПараметрыПМ.Вставить("Сообщение", Неопределено);
	КонецЕсли;
	
	РезультатПМ = 
	ОбработкаСобытияПодключаемогоМодуля("ПослеПолученияТоваровДокумента1С",, ПараметрыПМ);
	
	Результат.Вставить("Товары", Товары);
	
	Возврат Результат;
	
КонецФункции

Функция ПоляПоискаДублейТоваровПрайсЛиста()
	
	ПоляПоискаДублей = Новый Массив;
	ПоляПоискаДублей.Добавить("GTIN");
	ПоляПоискаДублей.Добавить("КодТовараПоставщика");
	ПоляПоискаДублей.Добавить("ЕдиницаИзмерения");
	ПоляПоискаДублей.Добавить("ЕдиницаEDI");
	ПоляПоискаДублей.Добавить("КодТовараПокупателя");
	ПоляПоискаДублей.Добавить("ХарактеристикаНоменклатуры");
	
	Возврат ПоляПоискаДублей;
	
КонецФункции

Функция ПараметрыПодготовкиТаблицыТоваров()
	
	ДопПараметры = Новый Структура;
	
	ДопПараметры.Вставить("СуммаВключаетНДС");
	ДопПараметры.Вставить("ЭтоТиповойЗапросПоПроведенномуЗаказу_УТ_УПП_КА");
	ДопПараметры.Вставить("Направление");
	ДопПараметры.Вставить("МыПоставщик");
	ДопПараметры.Вставить("ЭтоОбратнаяОтгрузка");
	ДопПараметры.Вставить("ТипСообщения");
	
	Возврат ДопПараметры;

КонецФункции

Функция ПолучитьТоварыДляОтчетаПоОстаткам(Параметры)

	ТоварыРезультат = Неопределено;
	
	ТекстЗапросаДляТоваровОтчетаПоОстаткам = ПолучитьТекстЗапросаПоТоварамДокумента("INVRPT", Ложь);
	
	Если ТекстЗапросаДляТоваровОтчетаПоОстаткам <> Неопределено Тогда
		
		УникальныеСкладыОстатков = ПолучитьМассивУникальныхСкладовОстатков(Параметры.СоответствиеТочкаДоставкиСкладыОстатков);
		
		Если УникальныеСкладыОстатков.ЕстьНеЗаполненноеЗначение = Истина Тогда 
			
			МассивДляПоиска = Новый Массив;
			
		Иначе 
			
			МассивДляПоиска = УникальныеСкладыОстатков.МассивУникальныхСкладов;
			
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапросаДляТоваровОтчетаПоОстаткам;
		Запрос.УстановитьПараметр("ДатаОкончанияПериода", ТекущаяДатаСеанса());
		
		ЕстьОтборПоНоменклатуре = Параметры.Свойство("Номенклатура") И ЗначениеЗаполнено(Параметры.Номенклатура);
		
		ЕстьОтборСкладов = МассивДляПоиска.Количество() > 0;
		
		Если ЕстьОтборСкладов Тогда 
			Запрос.УстановитьПараметр("СкладыОстатков", МассивДляПоиска);
		Иначе 
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "Таблица.Склад В(&СкладыОстатков)"		   , "ИСТИНА");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЗаказПоставщику.Склад В (&СкладыОстатков)", "ИСТИНА");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "Склад В (&СкладыОстатков)"	   		   , "ИСТИНА");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "СтруктурнаяЕдиница В (&СкладыОстатков)" , "ИСТИНА");
		КонецЕсли;
		
		Если ЕстьОтборПоНоменклатуре Тогда
			
			Запрос.УстановитьПараметр("Номенклатура", Параметры.Номенклатура);
			
		Иначе
			
			Запрос.УстановитьПараметр("Номенклатура", Неопределено);
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "Таблица.Номенклатура В ИЕРАРХИИ(&Номенклатура)", "ИСТИНА");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "Номенклатура В ИЕРАРХИИ (&Номенклатура)"		 , "ИСТИНА");
			
		КонецЕсли;
		
				
		ТоварыРезультат = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
		
	Возврат ТоварыРезультат;

КонецФункции

Функция ПолучитьМассивУникальныхСкладовОстатков(СоответствиеТочкаДоставкиСкладыОстатков) 
	
	Результат = Новый Структура("МассивУникальныхСкладов, ЕстьНеЗаполненноеЗначение", Новый Массив, Ложь); 
	
	Для Каждого УникальноеСоответствие Из СоответствиеТочкаДоставкиСкладыОстатков Цикл
		
		МассивСкладов = УникальноеСоответствие.СкладыОстатков;
		
		Если НЕ ЗначениеЗаполнено(МассивСкладов) ИЛИ МассивСкладов.Количество() = 0 Тогда 
			
				Результат.ЕстьНеЗаполненноеЗначение = Истина;
				
		КонецЕсли;
		
		Для Каждого Склад Из МассивСкладов Цикл
			
			Если Результат.МассивУникальныхСкладов.Найти(Склад) = Неопределено Тогда 
				
				Результат.МассивУникальныхСкладов.Добавить(Склад);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

Функция ПолучитьСкладыОстатковТочкиДоставки(ТочкаДоставки) Экспорт
	
	МассивСкладыОстатков = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(ТочкаДоставки) Тогда 
		
		Возврат МассивСкладыОстатков;
		
	КонецЕсли;
	
	Если ТипЗнч(ТочкаДоставки) <> Тип("СправочникСсылка.КонтурEDI_ТочкиДоставки") Тогда 
		
		МассивСкладыОстатков.Добавить(ТочкаДоставки);
		Возврат МассивСкладыОстатков;
		
	КонецЕсли;
	
	Партнер = ТочкаДоставки.Партнер;

	СкладыОстатковПартнера = ПолучитьСкладыОстатковПартнера(Партнер);
	
	ОбщиеСкладыОстатков = ПолучитьСкладыОстатковПартнера(Неопределено); 

	МассивСкладовОстатковТочкиДоставки = ПолучитьИндивидуальныеСкладыОстатковТочкиДоставки(ТочкаДоставки);
	
	Если МассивСкладовОстатковТочкиДоставки.Количество() > 0 Тогда 
		
		МассивСкладыОстатков = МассивСкладовОстатковТочкиДоставки;
		
	ИначеЕсли СкладыОстатковПартнера.Количество() > 0 Тогда  
		
		МассивСкладыОстатков = СкладыОстатковПартнера;
		
	Иначе 
		
		МассивСкладыОстатков = ОбщиеСкладыОстатков;
		
	КонецЕсли;
		
	Возврат МассивСкладыОстатков;	
	
КонецФункции

Функция ПолучитьСкладыОстатковПартнера(Партнер) Экспорт
	
	МассивСкладовОстатков = Новый Массив;
	
	СправочникСсылкаСкладыОстатков = ПолучитьЗначениеСвойстваОбъектаEDI(Партнер, "СкладыОстатков");
	
	Если ТипЗнч(СправочникСсылкаСкладыОстатков) = Тип("СправочникСсылка.КонтурEDI_ДополнительныеСправочники") Тогда 
		
		Возврат ПолучитьСкладыОстатковПоСсылке(СправочникСсылкаСкладыОстатков);
		
	Иначе
	
		Возврат МассивСкладовОстатков;	
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьСкладыОстатковПоСсылке(Ссылка) Экспорт 
	
	СкладыОстатков = Новый Массив;
	
	Если ТипЗнч(Ссылка) <> Тип("СправочникСсылка.КонтурEDI_ДополнительныеСправочники") Тогда 
		
		Возврат СкладыОстатков;
		
	КонецЕсли;
	
	Для каждого СкладОстатков из Ссылка.ДополнительныеРеквизиты Цикл 
		
		Если СкладыОстатков.Найти(СкладОстатков.Значение) = Неопределено
			И СкладОстатков.ИмяРеквизита = "Склад" Тогда
				
				СкладыОстатков.Добавить(СкладОстатков.Значение);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СкладыОстатков;
	
КонецФункции

Процедура РедактированиеСкладыОстатков(Значение, НаименованиеПартнера = "", Владелец) Экспорт
	
	ТЗСкладыОстатков = Новый ТаблицаЗначений;
	ДобавитьКолонкиВТаблицуЗначений(ТЗСкладыОстатков, "СкладыОстатков"); 
	
	Если ЗначениеЗаполнено(Значение)
		И ТипЗнч(Значение) = Тип("СправочникСсылка.КонтурEDI_ДополнительныеСправочники") Тогда
		
		МассивСкладовОстатков = ПолучитьСкладыОстатковПоСсылке(Значение);
		
		Для каждого СкладОстатков ИЗ МассивСкладовОстатков Цикл 
			
			НоваяСтрока = ТЗСкладыОстатков.Добавить();
			НоваяСтрока.СкладыОстатков = СкладОстатков;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ФормаРедактированияРеквизитов = ПолучитьФорму("УниверсальнаяФормаРедактирования", Владелец);
	ФормаРедактированияРеквизитов.НастройкиФормы = Новый Структура("НадписьИнформация", "Укажите склады остатков");
	ФормаРедактированияРеквизитов.Значение = ТЗСкладыОстатков;
	
	ПолученнаяТаблицаЗначенийСкладовОстатков =  ФормаРедактированияРеквизитов.ОткрытьМодально();  
	
	Если ПолученнаяТаблицаЗначенийСкладовОстатков = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Значение)
		И ТипЗнч(Значение) = Тип("СправочникСсылка.КонтурEDI_ДополнительныеСправочники") Тогда 
		
		ТекущийОбъект = Значение.ПолучитьОбъект();
		
	Иначе 
		
		ТекущийОбъект = Справочники.КонтурEDI_ДополнительныеСправочники.СоздатьЭлемент();
		ТекущийОбъект.ИмяСправочника = "СкладыОстатков";
		ТекущийОбъект.Наименование = НаименованиеПартнера + " (Склады остатков)";			
		
	КонецЕсли;
	
	ТекущийОбъект.ДополнительныеРеквизиты.Очистить();
	
	Для Каждого СтрокаСкладОстатков ИЗ ПолученнаяТаблицаЗначенийСкладовОстатков Цикл 
		
		НовыйСклад = ТекущийОбъект.ДополнительныеРеквизиты.Добавить();
		НовыйСклад.ИмяРеквизита = "Склад";
		НовыйСклад.Значение = СтрокаСкладОстатков.СкладыОстатков;
		
	КонецЦикла;
	
	ТекущийОбъект.Записать();
	
	Значение = ТекущийОбъект.Ссылка;
	
КонецПроцедуры

Функция ПолучитьИндивидуальныеСкладыОстатковТочкиДоставки(ТочкаДоставки) Экспорт
	
	МассивСкладовОстатков = Новый Массив;
	
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить("СкладыОстатков");
	
	СтруктураРеквизитов = ПолучитьЗначенияДопРеквизитовТочкиДоставки_КонтурEDI(ТочкаДоставки, МассивРеквизитов);
	СправочникСсылкаСкладыОстатков = СтруктураРеквизитов.СкладыОстатков;
	
	Если ТипЗнч(СправочникСсылкаСкладыОстатков) = Тип("СправочникСсылка.КонтурEDI_ДополнительныеСправочники") Тогда 
		
		Возврат ПолучитьСкладыОстатковПоСсылке(СправочникСсылкаСкладыОстатков);
		
	Иначе		
	
		Возврат МассивСкладовОстатков;
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьТоварыДляОтчетаПоПродажам(Параметры)

	ТоварыРезультат = Неопределено;
	
	ТекстЗапросаДляТоваровОтчетаПоПродажам = ПолучитьТекстЗапросаПоТоварамДокумента("SLSRPT", Ложь);
	
	Если ТекстЗапросаДляТоваровОтчетаПоПродажам <> Неопределено Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапросаДляТоваровОтчетаПоПродажам;
		
		ТоварыРезультат = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
		
	Возврат ТоварыРезультат;

КонецФункции

Функция ПолучитьТоварыДляПрайсЛиста(Параметры)
	
	// Начало блока для совместимости со старыми ПМ

	СтандартнаяОбработка = Истина; 
	//в результате обработки должны получить заполненную таблицу значений "Товары"
	
	СтруктураСообщения = ПолучитьСтруктуруСообщения("PRICELIST", "Исходящее");
	ТоварыКопия = СтруктураСообщения.Товары.Скопировать();
    Параметры.Вставить("Товары", ТоварыКопия);
	
	РезультатОбработки = ОбработкаСобытияПодключаемогоМодуля("ЗаполнитьДанныеПрайсЛиста",
															СтандартнаяОбработка,
															Параметры);
															
	Если Не СтандартнаяОбработка И ТипЗнч(РезультатОбработки) = Тип("ТаблицаЗначений") Тогда
		Возврат РезультатОбработки;
	КонецЕсли;

	ВыборкаСЦенами = Ложь;
    ТекстЗапроса = ""; 	
    ПолучитьТекстЗапросаПоТоварамДляПрайсЛиста(Параметры, ВыборкаСЦенами, ТекстЗапроса); 
			
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Параметры.Вставить("ВыборкаБезЦен", НЕ ВыборкаСЦенами);
	РезультатПМ = ОбработкаСобытияПодключаемогоМодуля("ИзменитьЗапросПоНоменклатуреДляПрайсЛиста",,	Новый Структура("Запрос, ДополнительныеПараметры", Запрос, Параметры));
	
	Если РезультатПМ <> Неопределено И ТипЗнч(РезультатПМ) = Тип("Запрос") Тогда
		Запрос = РезультатПМ;
	КонецЕсли;
	
	УстановитьПараметрыЗапросаПоТоварамДляПрайсЛиста(ВыборкаСЦенами, Запрос, Параметры);  
	
	ТоварыРезультат = Запрос.Выполнить().Выгрузить();
	
	СвернутьТоварыПрайсЛистаПослеЗапроса(ТоварыРезультат);
	
	Возврат ТоварыРезультат;

КонецФункции

Процедура СвернутьТоварыПрайсЛистаПослеЗапроса(Знач ТоварыРезультат)
	
	ВсеКолонкиТаблицы = Новый Массив;
	КолонкиДляСуммирования = Новый Массив;
	Для Каждого Колонка Из ТоварыРезультат.Колонки Цикл
		
		ИмяКолонки = Колонка.Имя;
		
		ВсеКолонкиТаблицы.Добавить(ИмяКолонки);
		
		Если ИмяКолонки = "КоличествоОстаткаНаКонец" Тогда
			КолонкиДляСуммирования.Добавить(ИмяКолонки);
		КонецЕсли;
		
	КонецЦикла;
	
	КолонкиДляГруппировки = КонтурСтандарт_РазностьМассивов(ВсеКолонкиТаблицы, КолонкиДляСуммирования);
	
	СтрокаКолонкиДляГруппировки = КонтурСтандарт_СтрСоединить_(КолонкиДляГруппировки, ",");
	СтрокаКолонкиДляСуммирования = КонтурСтандарт_СтрСоединить_(КолонкиДляСуммирования, ","); 
	
	ТоварыРезультат.Свернуть(СтрокаКолонкиДляГруппировки, СтрокаКолонкиДляСуммирования);
	
КонецПроцедуры

Процедура УстановитьПараметрыЗапросаПоТоварамДляПрайсЛиста(ВыборкаСЦенами, Запрос, Параметры)
	
	Если ВыборкаСЦенами Тогда
		Запрос.УстановитьПараметр("ТипЦен", Параметры.ТипЦен);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.Склад) Тогда
		Запрос.УстановитьПараметр("Склад", Параметры.Склад);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Склад = НЕОПРЕДЕЛЕНО", "ЛОЖЬ");
	Иначе
		Запрос.УстановитьПараметр("Склад", Неопределено);
	КонецЕсли;
	
	Если ИмяКонфигурации1С = "УФ_УНФ" И КонтурСтандарт_СтрНайти_(Запрос.Текст, "&АктуальныеСтавкиНДС") Тогда
		
		Попытка
			
			АктуальныеСтавкиНДС = Новый Массив;
			
			СоответствияСтавокНДС = Справочники.СтавкиНДС.СоответствиеСтавокНДС(ТекущаяДатаСеанса());
				
			Для каждого КлючЗначение Из СоответствияСтавокНДС Цикл
				АктуальныеСтавкиНДС.Добавить(КлючЗначение.Значение);
			КонецЦикла;
			
			Запрос.УстановитьПараметр("АктуальныеСтавкиНДС", АктуальныеСтавкиНДС);
			
		Исключение
			
			ТекстОшибки = "Ошибка при формировании запроса по товарам. Не удалось определить актуальные ставки НДС.
						  |
						  |Подробное описание ошибки:
						  |" + ОписаниеОшибки();
			
			ВызватьИсключение(ТекстОшибки);
			
		КонецПопытки;
		
	КонецЕсли;

	УсловиеОтбораВидыНоменклатуры = "ИСТИНА";
	ВидНоменклатуры = Неопределено;
	Если ПеременнаяСодержитСвойство(Параметры, "ВидНоменклатуры", ВидНоменклатуры, Истина) Тогда
		
		Если ВыборкаСЦенами Тогда
			УсловиеОтбораВидыНоменклатуры = "Номенклатура.ВидНоменклатуры В ИЕРАРХИИ(&ВидНоменклатуры)"; 		
		Иначе
			УсловиеОтбораВидыНоменклатуры = "СправочникНоменклатура.Ссылка.ВидНоменклатуры В ИЕРАРХИИ(&ВидНоменклатуры)"; 		
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ВидНоменклатуры", ВидНоменклатуры);
		
	КонецЕсли;
	
	УсловиеОтбораНоменклатуры = "ИСТИНА";
	Если ЗначениеЗаполнено(Параметры.Номенклатура) Тогда
		
		ТипПараметраНоменклатура = ТипЗнч(Параметры.Номенклатура);
		ТипОбъектаНоменклатура = ПолучитьТипЗначенияОбъекта("Номенклатура");
		
		Если (ЗначениеЗаполнено(ТипОбъектаНоменклатура) И ТипПараметраНоменклатура = Тип(ТипОбъектаНоменклатура))
			ИЛИ ТипПараметраНоменклатура = Тип("Массив")
			ИЛИ ТипПараметраНоменклатура = Тип("СписокЗначений") Тогда
			
			Если ВыборкаСЦенами Тогда
				УсловиеОтбораНоменклатуры = "Номенклатура В ИЕРАРХИИ(&Номенклатура)";
			Иначе
				УсловиеОтбораНоменклатуры = "СправочникНоменклатура.Ссылка В ИЕРАРХИИ(&Номенклатура)";
			КонецЕсли;
			
			Запрос.УстановитьПараметр("Номенклатура", Параметры.Номенклатура);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИмяКонфигурации1С = "УФ_БП" Тогда
		
		СчетаУчетаТоваров = ПолучитьСчетаУчетаТоваров_УФ_БП();
		ВидыСубконтоУчетаТоваров = ПолучитьВидыСубконтоУчетаТоваров_УФ_БП();
		
		Запрос.УстановитьПараметр("СчетаУчетаТоваров", СчетаУчетаТоваров);
		Запрос.УстановитьПараметр("СубконтоНоменклатураИСклад", ВидыСубконтоУчетаТоваров);
		
		Если Не ЗначениеЗаполнено(Параметры.Склад) ИЛИ ВидыСубконтоУчетаТоваров.Количество() < 2 Тогда 
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "Субконто2 В (&Склад)", "");
		КонецЕсли;
		
	КонецЕсли;

	УсловиеОтбора = УсловиеОтбораВидыНоменклатуры + " И " + УсловиеОтбораНоменклатуры;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтбораНоменклатуры", УсловиеОтбора);

КонецПроцедуры

Процедура ПолучитьТекстЗапросаПоТоварамДляПрайсЛиста(Параметры, ВыборкаСЦенами, ТекстЗапроса)
	
	ВыборкаСЦенами = ЗначениеЗаполнено(Параметры.ТипЦен);
	ВыборкаСОстатками = Параметры.Свойство("ВыгружатьОстаткиВПрайсЛист") И Параметры.ВыгружатьОстаткиВПрайсЛист = Истина;
	
	ИмяТекстаЗапроса = "";
	
	Если ВыборкаСЦенами Тогда
		ИмяТекстаЗапроса = ИмяТекстаЗапроса + "_СЦенами";
	Иначе
		ИмяТекстаЗапроса = ИмяТекстаЗапроса + "_БезЦен";
	КонецЕсли;
	
	Если ВыборкаСОстатками Тогда
		ИмяТекстаЗапроса = ИмяТекстаЗапроса + "_Остатки";
	КонецЕсли;
	
	Если ИмяКонфигурации1С = "УФ_УНФ"
		И НЕ ЕстьНеобходимыеМетаданные("Справочники.Номенклатура.Реквизиты.СтавкаНДС") Тогда
		
		ИмяТекстаЗапроса = ИмяТекстаЗапроса + "_ВидыСтавок";
		
	КонецЕсли;
	
	ТекстЗапроса = ПолучитьТекстЗапросаПоТоварамДокумента("PRICELIST", Ложь,,, ИмяТекстаЗапроса);
	
	Если ИмяКонфигурации1С = "УФ_УТ" И ИспользуетсяЦенообразование25() Тогда

		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РегистрСведений.ЦеныНоменклатуры.", "РегистрСведений.ЦеныНоменклатуры25.");
			
	КонецЕсли;

КонецПроцедуры 

//Определяет, используется ли ценообразование версии ERP 2.5 (УТ 11.5)
Функция ИспользуетсяЦенообразование25()
	
	Если ЕстьНеобходимыеМетаданные("РегистрыСведений.ЦеныНоменклатуры25") Тогда
		
		МодульЦенообразование = Вычислить("ЦенообразованиеВызовСервера");
		
		Возврат МодульЦенообразование.ИспользуетсяЦенообразование25();
		
	КонецЕсли;

	Возврат Ложь;
	
КонецФункции	

Функция ЭтоТипНезависимогоСообщения(ТипСообщения) Экспорт

	Если СтрСодержит_КонтурEDI("PRICELIST,PRICAT,SLSRPT,INVRPT,DELFOR", ТипСообщения) Тогда	
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции // ЭтоТипНезависимогоСообщения()

Функция ЭтоТипЛогистическогоСообщения(ТипСообщения) Экспорт

	Если СтрСодержит_КонтурEDI("IFTMBF,IFTMBC", ТипСообщения) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции // ЭтоТипЛогистическогоСообщения()

Функция ЭтоТипСообщенияСКомментарием(ТипСообщения) Экспорт

	Если СтрСодержит_КонтурEDI("ORDERS, PORDERS, DESADV, INVOIC, COINVOIC, DELFOR, PRICELIST, PRICAT", ТипСообщения) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции // ЭтоТипСообщенияСКомментарием()

// Функция определяет наличие подстроки в исходной строке
//
// В отличие от функций Найти и СтрНайти, выполняется строгий поиск подстроки с учетом разделителей,
// с предварительным разложением строки на массив подстрок. 
// Подстрока поиска должна точно совпасть минимум с одним из элементов массива подстрок исходной строки
//
// Параметры:
//  Строка          - Строка - исходная строка с разделителями
//  ПодстрокаПоиска - Строка - искомая строка
//  Разделители	    - Строка - символ-разделитель
//
//  Возвращаемое значение:
//      Булево - признак наличия
//
Функция СтрСодержит_КонтурEDI(Знач Строка, Знач ПодстрокаПоиска, Знач Разделитель = ",") Экспорт
	
	МассивПодстрок = EDI_РазложитьСтрокуВМассивСлов(Строка, Разделитель); 
	//эмуляция функции СтрРазделить() для обратной совместимости

	Если МассивПодстрок.Найти(ПодстрокаПоиска) = Неопределено Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;

КонецФункции // СтрСодержит_КонтурEDI()

Функция ОпределитьСторонуЮрФизЛица(ТипСообщения, Направление, ДляПартнера = Истина) Экспорт
	
	МетаданныеСообщения = ПолучитьМетаданныеСообщения(ТипСообщения, Направление);
	СтрокаМетаданных = МетаданныеСообщения.Найти("Продавец", "ИмяПоля");
	
	Если СтрокаМетаданных.Тип1С = "ЮрФизЛицоСвое" Тогда
		Возврат ?(ДляПартнера, "Покупатель", "Продавец");
	ИначеЕсли СтрокаМетаданных.Тип1С = "ЮрФизЛицоСтороннее" Тогда
 		Возврат ?(ДляПартнера, "Продавец", "Покупатель");
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура СвернутьТаблицуТоваров_INVRPT(ТаблицаТоваров) Экспорт
	
	КолонкиГруппировок =    "Номенклатура
							|GTIN
                            |ЕдиницаEDI
                            |КодЕдиницыИзмеренияEDI
                            |КодТовараПокупателя
                            |КодТовараПоставщика
                            |Комментарий
                            |Наименование
							|ДополнительнаяИнформация
                            |НомерГТДEDI
                            |СтавкаНДСEDI
                            |СтранаEDI
							|ЦенаБезНДС
							|ЦенаСНДС
							|КоэффициентEDIВ1С";
	
	КолонкиСуммирования =   "Количество
							|КоличествоВОдномМесте
							|КоличествоДоставлено
							|КоличествоЗаказано
							|КоличествоОстаткаНаКонец
							|КоличествоОстаткаНаНачало
							|КоличествоПринято
							|КоличествоПродано
							|КоличествоТекущегоОстатка
							|СуммаБезНДС
							|СуммаНДС
							|СуммаСНДС";
	
	КолонкиГруппировок  = СтрЗаменить(КолонкиГруппировок,  Символы.ПС, ",");
	КолонкиСуммирования = СтрЗаменить(КолонкиСуммирования, Символы.ПС, ",");
	
	КолонкиСуммирования = УдалитьИзСпискаКолонокНесуществующиеВТаблице(КолонкиСуммирования, ТаблицаТоваров);
	КолонкиГруппировок = УдалитьИзСпискаКолонокНесуществующиеВТаблице(КолонкиГруппировок, ТаблицаТоваров);
	
	ТаблицаТоваров.Свернуть(КолонкиГруппировок, КолонкиСуммирования);

КонецПроцедуры

Функция УдалитьИзСпискаКолонокНесуществующиеВТаблице(Знач СписокКолонок, Знач Таблица)
	
	Если НЕ ТипЗнч(СписокКолонок) = Тип("Строка")
		ИЛИ НЕ ТипЗнч(Таблица) = Тип("ТаблицаЗначений") Тогда
		Возврат СписокКолонок;
	КонецЕсли;
	
	МассивКолонок = EDI_РазложитьСтрокуВМассивСлов(СписокКолонок, ",");
	НовыйСписокКолонок = "";
	
	Для каждого ИмяКолонки Из МассивКолонок Цикл
		Если НЕ Таблица.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
			 НовыйСписокКолонок = НовыйСписокКолонок + "," + ИмяКолонки;
		КонецЕсли;
	КонецЦикла;
	
	НовыйСписокКолонок = Сред(НовыйСписокКолонок, 2); //обрежем первую запятую
	
	Возврат НовыйСписокКолонок;
	
КонецФункции

// INVRPT
Процедура ПодготовитьОтчетОбОстатках(Сообщение, Товары, Параметры)
	
	Параметры.Свойство("Организация", Сообщение.Отправитель1С);
	Параметры.Свойство("Партнер", 	  Сообщение.Получатель1С);
	Параметры.Свойство("Продавец", 	  Сообщение.Продавец1С);

	ПродавецЭтоПартнер = ЗначениеЗаполнено(ОпределитьПартнера(Новый Структура("ТипЗначения, ЮрФизЛицо, Сообщение","ЮрФизЛицо", Параметры.Продавец, Сообщение)));
	
	Если ПродавецЭтоПартнер Тогда
		
		Параметры.Свойство("Организация", Сообщение.Покупатель1С);
		
	Иначе
		
		Параметры.Свойство("Контрагент", Сообщение.Покупатель1С);
		
	КонецЕсли;
	
	Параметры.Свойство("Партнер"			 , Сообщение.Партнер);
	Параметры.Свойство("ДатаИнвентаризации"  , Сообщение.ДатаИнвентаризации);
	Параметры.Свойство("ДатаНачалаПериода"	 , Сообщение.ДатаНачалаПериодаОтчета);
	Параметры.Свойство("ДатаОкончанияПериода", Сообщение.ДатаОкончанияПериодаОтчета);
	
	Сообщение.Статус 	  = "Ожидает отправки";
	Сообщение.Направление = "Исходящее";
	
	Параметры.Свойство("ТипЦен", 	  Сообщение.ТипЦен);
	Параметры.Свойство("Валюта", 	  Сообщение.Валюта1С);
	
	Если Параметры.Свойство("ID") 
		И ЗначениеЗаполнено(Параметры.ID) Тогда 
		
		Сообщение.ID = Параметры.ID;
		
	Иначе
		
		Сообщение.ID = Строка(Новый УникальныйИдентификатор());
		
	КонецЕсли;

	Если Параметры.Свойство("ДокументНомер") 
		И ЗначениеЗаполнено(Параметры.ДокументНомер) Тогда 
		
		Сообщение.ДокументEDI.Номер = Параметры.ДокументНомер;
		
	Иначе 
		
		Сообщение.ДокументEDI.Номер = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
		
	КонецЕсли;
	
	Сообщение.СтатусСсылки = "Ожидает отправки";
	
	Если Параметры.Свойство("ДокументДата") 
		И ЗначениеЗаполнено(Параметры.ДокументДата) Тогда 
		
		Сообщение.ДокументEDI.Дата = Параметры.ДокументДата;
		
	Иначе
		
		Сообщение.ДокументEDI.Дата = ТекущаяДата();
		
	КонецЕсли;

	Параметры.Свойство("ТочкаДоставки" , Сообщение.ТочкаДоставки1С);
	
	ТабМестонахождениеТовара = Товары.Скопировать(, "МестонахождениеТовара1С");
	ТабМестонахождениеТовара.Свернуть("МестонахождениеТовара1С");
	ТабМестонахождениеТовара.Колонки.Добавить("МестонахождениеТовараEDI");
	Для каждого Строка Из ТабМестонахождениеТовара Цикл
		Строка.МестонахождениеТовараEDI = КонвертироватьЗначение1СвEDI(Строка.МестонахождениеТовара1С, "ТочкаДоставкиСвоя", "ЮрФизЛицо", Сообщение);
	КонецЦикла;
	
	Для каждого Стр Из Товары Цикл     
		
		НоваяСтрока = Сообщение.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);		
		
		НоваяСтрока.КоличествоОстаткаНаНачало = Стр.КоличествоОстаткаНаНачалоРасчетный;
		НоваяСтрока.КоличествоОстаткаНаКонец = Стр.КоличествоОстаткаНаКонецРасчетный;
		НоваяСтрока.КоличествоТекущегоОстатка = Стр.КоличествоТекущегоОстаткаРасчетный;
		
		НоваяСтрока.КоличествоДоставлено = Стр.КоличествоДоставленоРасчетный;
		НоваяСтрока.КоличествоПринято = Стр.КоличествоПринятоРасчетный;
		НоваяСтрока.КоличествоПродано = Стр.КоличествоПроданоРасчетный; 
		
		НоваяСтрока.ЦенаБезНДС = Стр.ЦенаБезНДСРасчетный;
		НоваяСтрока.ЦенаСНДС = Стр.ЦенаСНДСРасчетный;
				
		СтрокаМестонахождениеТовара = ТабМестонахождениеТовара.Найти(Стр.МестонахождениеТовара1С, "МестонахождениеТовара1С");
		Если СтрокаМестонахождениеТовара <> Неопределено Тогда
			НоваяСтрока.МестонахождениеТовараEDI = СтрокаМестонахождениеТовара.МестонахождениеТовараEDI;
		КонецЕсли;
		
		НоваяСтрока.ТекстПересчета = ТекстПересчета_КонтурEDI(
		НоваяСтрока.ЕдиницаИзмерения, 
		НоваяСтрока.КодЕдиницыИзмеренияEDI, 
		НоваяСтрока.КоэффициентEDIВ1С);
	
	КонецЦикла;
	
КонецПроцедуры

// DELFOR
Процедура ПодготовитьГрафикПоставок(Сообщение, Графики, Параметры)
	
	// Укажем дополнительно, т.к. из метаданных сообщения нельзя понять направление
	Сообщение.Направление = "Исходящее";
	
	Сообщение.Отправитель1С = Параметры.Отправитель;
	Сообщение.Получатель1С = Параметры.Получатель;
	
	Сообщение.Покупатель1С = Параметры.Покупатель;
	Сообщение.Продавец1С = Параметры.Продавец;
	
	Сообщение.ТипDELFOR = Параметры.ТипDELFOR;
	
	Сообщение.Партнер = Параметры.Получатель;
	
	Сообщение.НачалоДействияГрафика = Параметры.НачалоДействияГрафика;
	Сообщение.ОкончаниеДействияГрафика = Параметры.ОкончаниеДействияГрафика;
	
	Сообщение.ДлительностьГрафика = Параметры.ДлительностьГрафика;
	
	Сообщение.НомерДоговора = Параметры.НомерДоговора;
	Сообщение.ДатаДоговора = Параметры.ДатаДоговора;
	
	Сообщение.РегионПродаж = Параметры.РегионПродаж;
	Сообщение.СегментАссортимента = Параметры.СегментАссортимента;
	
	ПеременнаяСодержитСвойство(Параметры, "Комментарий", Сообщение.Комментарий);
	
	Сообщение.ID = Строка(Новый УникальныйИдентификатор());
	Сообщение.СтатусСсылки = "Ожидает отправки";
	
	Сообщение.ДокументEDI.Номер = Параметры.НомерDELFOR; 
	Сообщение.ДокументEDI.Дата = Параметры.ДатаDELFOR;
	
	ЕстьСогласованные = Ложь;
	ЕстьОтклоненные = Ложь;	
	Для каждого Стр Из Графики Цикл
		НоваяСтрока = Сообщение.Графики.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		
		НоваяСтрока.НачалоДействияГрафика = Стр.НачалоДействияГрафика;
		НоваяСтрока.ОкончаниеДействияГрафика = Стр.ОкончаниеДействияГрафика;
		
		Если НоваяСтрока.СтатусСогласования = "Принят" Тогда 
			ЕстьСогласованные = Истина;
		ИначеЕсли НоваяСтрока.СтатусСогласования = "Отклонен" Тогда
			ЕстьОтклоненные = Истина;
		КонецЕсли; 	
	КонецЦикла;
	
	Если Параметры.ТипDELFOR = "Schedule" Тогда
		СтатусDELFOR = "Original";
	ИначеЕсли Параметры.ТипDELFOR = "Response" Тогда
		Если ЕстьСогласованные И ЕстьОтклоненные Тогда
			СтатусDELFOR = "AcceptedWithAmendment";
		ИначеЕсли ЕстьСогласованные Тогда
			СтатусDELFOR = "Accepted";
		ИначеЕсли ЕстьОтклоненные Тогда
			СтатусDELFOR = "NotAccepted";
		КонецЕсли;	
	КонецЕсли;
	Сообщение.СтатусDELFOR = СтатусDELFOR;
		
КонецПроцедуры

// SLSRPT
Процедура ПодготовитьОтчетОПродажах(Сообщение, Товары, Параметры)
	
	Сообщение.Отправитель1С = Параметры.Отправитель;
	Сообщение.Получатель1С = Параметры.Получатель;
	
	Сообщение.Покупатель1С = Параметры.Покупатель;
	Сообщение.Продавец1С = Параметры.Продавец;
	
	Сообщение.Партнер = Параметры.Получатель;
	
	Сообщение.ДатаНачалаПериодаОтчета 	= Параметры.ДатаНачалаПериода;
	Сообщение.ДатаОкончанияПериодаОтчета = Параметры.ДатаОкончанияПериода;
	
	Сообщение.ID = Строка(Новый УникальныйИдентификатор());
	Сообщение.СтатусСсылки = "Ожидает отправки";
	
	Сообщение.ТипЦен = Параметры.ТипЦен;
	Сообщение.Валюта1С = Параметры.Валюта;

	Сообщение.ДокументEDI.Номер = Формат(ТекущаяДата(), "ДФ=ггггММддЧЧммсс"); 
	Сообщение.ДокументEDI.Дата = ТекущаяДата();
	
	Если ЗначениеЗаполнено(Параметры.НомерДоговора) Тогда 
		Сообщение.Контракт.Номер = СокрЛП(Параметры.НомерДоговора);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.ДатаДоговора) Тогда 
		Сообщение.Контракт.Дата = Параметры.ДатаДоговора;
	КонецЕсли;
		
	ДобавитьКолонкиВТаблицуЗначений(Товары, "УИД_СтрокиТовара");
	ДобавитьКолонкиВТаблицуЗначений(Товары, "УИД_МестаПродаж");
	
	НомерСтроки = 0;
	
	Для Каждого СтрокаТоваров Из Товары Цикл

		НомерСтроки = НомерСтроки + 1;
		
		Если Не ЗначениеЗаполнено(СтрокаТоваров.УИД_СтрокиТовара) Тогда
			
			СтрокаТоваров.УИД_СтрокиТовара = УИД_СтрокиТовара_КонтурEDI(НомерСтроки, Сообщение.ТипСообщения); 
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТоварыДерево = ПреобразоватьТаблицуВДеревоПоГруппировкам(
	Товары, "МестоПродаж1С,Менеджер1С,КаналСбыта1С", "МестоПродаж1С,Менеджер1С,КаналСбыта1С");	
	
	Сообщение.МестаПродаж.Очистить();
	
	НомерСтроки = 0;
	
	Для Каждого СтрокаДерева Из ТоварыДерево.Строки Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		СтрокаМестаПродаж = Сообщение.МестаПродаж.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаМестаПродаж, СтрокаДерева);
		
		СтрокаМестаПродаж.УИД_МестаПродаж	= УИД_СтрокиТовара_КонтурEDI(НомерСтроки, "" + Сообщение.ТипСообщения + "_МестаПродаж"); 
		СтрокаДерева.УИД_МестаПродаж		= СтрокаМестаПродаж.УИД_МестаПродаж;
		
		СтрокаМестаПродаж.МестоПродажEDI	= КонвертироватьЗначение1СвEDI(СтрокаМестаПродаж.МестоПродаж1С, "ТочкаДоставкиСторонняя", "ЮрФизЛицо", Сообщение);
		СтрокаМестаПродаж.МенеджерEDI		= КонвертироватьЗначение1СвEDI(СтрокаМестаПродаж.Менеджер1С, "КонтактнаяИнформацияФизЛица", "КонтактнаяИнформацияФизЛица", Сообщение);
		СтрокаМестаПродаж.КаналСбытаEDI		= КонвертироватьЗначение1СвEDI(СтрокаМестаПродаж.КаналСбыта1С, "КаналСбыта", "КаналСбыта", Сообщение); 
		
		Для Каждого СтрокаТовар Из СтрокаДерева.Строки Цикл
			
			СтрокаТовар.УИД_МестаПродаж = СтрокаМестаПродаж.УИД_МестаПродаж;
			
		КонецЦикла;
		
	КонецЦикла;
		
	Для Каждого Стр Из Товары Цикл
		
		НоваяСтрока = Сообщение.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
						
		НоваяСтрока.ТекстПересчета = ТекстПересчета_КонтурEDI(
		НоваяСтрока.ЕдиницаИзмерения, 
		НоваяСтрока.КодЕдиницыИзмеренияEDI, 
		НоваяСтрока.КоэффициентEDIВ1С);
		
		СтрокаДерева = ТоварыДерево.Строки.Найти(Стр.УИД_СтрокиТовара, "УИД_СтрокиТовара", Истина);
		
		Если СтрокаДерева <> Неопределено Тогда
			
			НоваяСтрока.УИД_МестаПродаж = СтрокаДерева.УИД_МестаПродаж;
			
		КонецЕсли;
		
 	КонецЦикла;
	
КонецПроцедуры

// PRICELIST
Процедура ПодготовитьПрайсЛист(Сообщение, Товары, Параметры)

	Сообщение.Отправитель1С = Параметры.Отправитель;
	Сообщение.Получатель1С = Параметры.Получатель;
	
	Сообщение.Покупатель1С = Параметры.Покупатель;
	Сообщение.Продавец1С = Параметры.Продавец;
	
	Сообщение.Партнер = Параметры.Получатель;
	
	Сообщение.ДатаНачалаДействияЦен 	= Параметры.ДатаНачалаПериода;
	Сообщение.ДатаОкончанияДействияЦен 	= Параметры.ДатаОкончанияПериода;
	
	Сообщение.СтатусСсылки = "Ожидает отправки";
	
	Сообщение.ID = Строка(Новый УникальныйИдентификатор());
	
	Сообщение.ТипЦен = Параметры.ТипЦен;
 	Сообщение.Валюта1С = Параметры.Валюта;
	
	Если Параметры.Свойство("ТипПрайсЛиста") Тогда
		Сообщение.ТипПрайсЛиста = Параметры.ТипПрайсЛиста;
	КонецЕсли;

	Если ЗначениеЗаполнено(Параметры.НомерПрайслиста) Тогда
		НомерPriceList = Параметры.НомерПрайслиста;	
	Иначе
		НомерPriceList = Формат(ТекущаяДата(),"ДФ=ггггММддЧЧммсс");	
	КонецЕсли;
		
	Сообщение.ДокументEDI.Номер = НомерPriceList; 
	Сообщение.ДокументEDI.Дата = ТекущаяДата();
	
	Если ЗначениеЗаполнено(Параметры.НомерДоговора) Тогда 
		Сообщение.Контракт.Номер = СокрЛП(Параметры.НомерДоговора);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.ДатаДоговора) Тогда 
		Сообщение.Контракт.Дата = Параметры.ДатаДоговора;
	КонецЕсли;
	
	ПеременнаяСодержитСвойство(Параметры, "Комментарий", Сообщение.Комментарий);
	
	Для Каждого Стр Из Товары Цикл
		
		НовСтрока = Сообщение.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока,Стр);
				
		Если Не ЗначениеЗаполнено(НовСтрока.Каталог) Тогда
			НовСтрока.Каталог = "Без категории";
		КонецЕсли;
		
		НовСтрока.ТекстПересчета = ТекстПересчета_КонтурEDI(НовСтрока.ЕдиницаИзмерения, НовСтрока.КодЕдиницыИзмеренияEDI, НовСтрока.КоэффициентEDIВ1С);
		
	КонецЦикла;

КонецПроцедуры

// #КонецОбласти //SLSRPT и INVRPT


// #Область API_DD

//В контексте Модуля объекта эта функция работает только в режиме обычного приложения
//и отдает Форму ФормаСервис_ПодписаниеДД, в которой идет работа с ДД
//сделано для того чтобы код дублирующихся клиентских процедур и функций ОФ-УФ был полностью идентичен

//-------------------------------------------------------------------------------------------------
// Работа с клиентским модулем Диадок -------------------------------------------------------------
//-------------------------------------------------------------------------------------------------

Функция МодульОбменКлиент() Экспорт
	
	ФормаРаботыСДД = ЭДО_Кэш_Прочитать("МодульРаботыСДД");
	
	Если ФормаРаботыСДД = Неопределено Тогда
		ИнициализироватьМодульОбменКлиент();
	Иначе
		Возврат ФормаРаботыСДД;
	КонецЕсли;
	
	Возврат ЭДО_Кэш_Прочитать("МодульРаботыСДД");
	
КонецФункции

Процедура ИнициализироватьМодульОбменКлиент() Экспорт
	
	ОсновнаяФорма = ЭДО_Кэш_Прочитать("ОсновнаяФорма");
	Если ОсновнаяФорма = Неопределено Тогда
		ОсновнаяФорма = ПолучитьФорму("ОсновнойИнтерфейс");
	КонецЕсли;
	ЭДО_Кэш_Поместить("ОсновнаяФорма",ОсновнаяФорма);
	
	ФормаРаботыСДД = ПолучитьФорму("ФормаСервис_ПодписаниеДД",ОсновнаяФорма,Новый УникальныйИдентификатор);	
	ЭДО_Кэш_Поместить("МодульРаботыСДД",ФормаРаботыСДД);
	
КонецПроцедуры 

//Подготавливает пачку для последующего уточнения в Диадоке
Функция ПолучитьДокументыСУточнениями() Экспорт
	
	МассивДокументовДляУточнения = Новый Массив;
	
	Для Каждого Стр ИЗ ЭтотОбъект.ТабСообщения Цикл
		
		Если (СокрЛП(Стр.ТребуемоеДействие) = "Ожидайте подпись партнера" 
			ИЛИ СокрЛП(Стр.ТребуемоеДействие) = "Работа завершена"
			ИЛИ СокрЛП(Стр.ТребуемоеДействие) = "Работа завершена с уточнением")
			И (Стр.ТипСообщения = "INVOIC" ИЛИ Стр.ТипСообщения = "COINVOIC")
			Тогда
			
			ИдентификаторыДиадок = ПолучитьИдентификаторыДокументаДиадок(Стр.Документ);
			
			Если НЕ ЗначениеЗаполнено(ИдентификаторыДиадок.boxId) 
				ИЛИ НЕ ЗначениеЗаполнено(ИдентификаторыДиадок.messageId) Тогда
				Продолжить;
			КонецЕсли;
			
			Отправитель1С = ?(ЗначениеЗаполнено(Стр.Организация), Стр.Организация, Стр.Документ.Организация);
			СтруктураИдентификаторов = Новый Структура;
			СтруктураИдентификаторов.Вставить("boxId", ИдентификаторыДиадок.boxId);
			СтруктураИдентификаторов.Вставить("messageId", ИдентификаторыДиадок.messageId);
			СтруктураИдентификаторов.Вставить("invoiceId", ИдентификаторыДиадок.invoiceId);
			СтруктураИдентификаторов.Вставить("torg12Id", ИдентификаторыДиадок.torg12Id);
			СтруктураИдентификаторов.Вставить("UniversalTransferDocumentId", ИдентификаторыДиадок.UniversalTransferDocumentId);
			СтруктураИдентификаторов.Вставить("Документ", Стр.Документ);
			СтруктураИдентификаторов.Вставить("Отправитель1С", Отправитель1С);
			СтруктураИдентификаторов.Вставить("СообщениеСсылка", Стр.СообщениеСсылка);
			СтруктураИдентификаторов.Вставить("Статус", Стр.СообщениеСсылка.Статус);
			СтруктураИдентификаторов.Вставить("ТребуемоеДействие", Стр.СообщениеСсылка.ТребуемоеДействие);
			
			МассивДокументовДляУточнения.Добавить(СтруктураИдентификаторов);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивДокументовДляУточнения;
	
КонецФункции // ПолучитьДокументыСУточнениями()

Функция ПолучитьИдентификаторыДокументаДиадок(ДокументСсылка) Экспорт
	
	МассивИменСвойств = Новый Массив;
	МассивИменСвойств.Добавить("boxId");
	МассивИменСвойств.Добавить("messageId");
	МассивИменСвойств.Добавить("invoiceId");
	МассивИменСвойств.Добавить("torg12Id");
	МассивИменСвойств.Добавить("UniversalTransferDocumentId");
	
	СтруктураСвойствEDI = ПолучитьСписокСвойствEDI(МассивИменСвойств, ДокументСсылка);
	
	Возврат СтруктураСвойствEDI;
	
КонецФункции // ПолучитьИдентификаторыДокументаДиадок()

// Получаем ссылки на документы, записанные в дополнительные реквизиты сообщения из статусных ленты API
// если их не окажется, то попробуем собрать ссылки самостоятельно из регистра дополнительные реквизиты.
// Из-за асинхронной работы может оказаться, что после подписания документов статусные от EDI API мы еще не получили.
// Однако, после подписания сразу же имеем идентификаторы от Diadoc API
// поэтому основной источник идентификаторов - это регистр дополнительные реквизиты.
//
// Параметры
//  СообщениеСсылка - Справочник.КонтурEDI_Сообщения.Ссылка - сообщение INVOIC или COINVOIC
//  ДокументСсылка  - ДокументСсылка - документ, по которому отправлено сообщение INVOIC или COINVOIC
// 	ДокументыНеПодписаны - Булево - признак отсутствия подписания документов в Диадок
//
Функция ПолучитьСписокСсылокНаДокументыВВебДиадок(СообщениеСсылка, ДокументСсылка, ДокументыНеПодписаны = Ложь) Экспорт
	
	СписокСсылок = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурEDI_Сообщения.ТребуемоеДействие КАК ТребуемоеДействие
		|ИЗ
		|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
		|ГДЕ
		|	КонтурEDI_Сообщения.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", СообщениеСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	ВыборкаДетальныеЗаписи.Следующий();
	
	ДокументыПодписаны = ВыборкаДетальныеЗаписи.ТребуемоеДействие <> "ПодписатьВДиадок";
		
	Если ДокументыПодписаны И СтрСодержит_КонтурEDI("INVOIC,COINVOIC",СообщениеСсылка.ТипСообщения) Тогда
		
		СтруктураИдентификаторов = ПолучитьИдентификаторыДокументаДиадок(ДокументСсылка);
		
		ЗаполненыОсновныеИдентификаторыДиадок = ЗначениеЗаполнено(СтруктураИдентификаторов.boxId) 
		И ЗначениеЗаполнено(СтруктураИдентификаторов.messageId);
		
		Если ЗаполненыОсновныеИдентификаторыДиадок = Истина Тогда
			
			ЗаполненыИдентификаторыДокументаДиадок = ЗначениеЗаполнено(СтруктураИдентификаторов.invoiceId) 
			ИЛИ ЗначениеЗаполнено(СтруктураИдентификаторов.torg12Id) 
			ИЛИ ЗначениеЗаполнено(СтруктураИдентификаторов.UniversalTransferDocumentId);	
			
			АдресВебСервисаДиадок = ДиадокСервер();
			
			Если ЗаполненыИдентификаторыДокументаДиадок Тогда
				
				СсылкаНаПакетДокументов = АдресВебСервисаДиадок + "/" + СтруктураИдентификаторов.boxId + 
				"/Document/Show?letterId=" + СтруктураИдентификаторов.messageId;
				
				Если ЗначениеЗаполнено(СтруктураИдентификаторов.torg12Id) Тогда
					
					СсылкаНаТорг12 = СсылкаНаПакетДокументов + "&documentId=" + СтруктураИдентификаторов.torg12Id;
										
					СписокЗначенийДобавитьУникальноеЗначение_КонтурEDI(СписокСсылок, СсылкаНаТорг12, "Торг-12");   
					
				КонецЕсли;
				
				Если ЗначениеЗаполнено(СтруктураИдентификаторов.invoiceId) Тогда
					
					СсылкаНаСчетФактуру = СсылкаНаПакетДокументов + "&documentId=" + СтруктураИдентификаторов.invoiceId;
					
					СписокЗначенийДобавитьУникальноеЗначение_КонтурEDI(СписокСсылок, СсылкаНаСчетФактуру, "Счет-фактура");
									
				КонецЕсли;
				
				Если ЗначениеЗаполнено(СтруктураИдентификаторов.UniversalTransferDocumentId) Тогда
					
					СсылкаНаСчетФактуру = СсылкаНаПакетДокументов + "&documentId=" + СтруктураИдентификаторов.UniversalTransferDocumentId;
					
					СписокЗначенийДобавитьУникальноеЗначение_КонтурEDI(СписокСсылок, СсылкаНаСчетФактуру, "УПД или УКД");
										
				КонецЕсли;
				
			КонецЕсли;   			 
			
		КонецЕсли;		      		
		
	КонецЕсли;  
	
	Если СписокСсылок.Количество() = 0 Тогда
		
		СоответствиеИменСсылок = СоответствиеИменСсылокНаДокументыВДиадок();
		ДополнительныеРеквизиты = СообщениеСсылка.ДополнительныеРеквизиты.Выгрузить();
		
		Для каждого стрДопРеквизит Из ДополнительныеРеквизиты Цикл
			
			ИмяРеквизита = стрДопРеквизит.ИмяРеквизита;
			ПредставлениеИмениДокумента = СоответствиеИменСсылок[ИмяРеквизита];
			
			Если ЗначениеЗаполнено(ПредставлениеИмениДокумента) И ЗначениеЗаполнено(стрДопРеквизит.Значение) Тогда
				СписокЗначенийДобавитьУникальноеЗначение_КонтурEDI(СписокСсылок, стрДопРеквизит.Значение, ПредставлениеИмениДокумента);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
		
	Возврат СписокСсылок;

КонецФункции

Функция СоответствиеИменСсылокНаДокументыВДиадок()
	
	СоответствиеИменСсылок = Новый Соответствие;
	СоответствиеИменСсылок.Вставить("СсылкаНаКорректировочныйСчетФактуруВДиадоке", "Корректировочный счет-фактура");
	СоответствиеИменСсылок.Вставить("СсылкаНаНеформализованныйДокументВДиадоке", "Неформализованный документ");
	СоответствиеИменСсылок.Вставить("СсылкаНаСообщениеВДиадоке", "Сообщение в Диадок");
	СоответствиеИменСсылок.Вставить("СсылкаНаСчетФактуруВДиадоке", "Счет-фактура");
	СоответствиеИменСсылок.Вставить("СсылкаНаТорг12ВДиадоке", "Торг-12");
	СоответствиеИменСсылок.Вставить("СсылкаНаУКДВДиадоке", "УКД");
	СоответствиеИменСсылок.Вставить("СсылкаНаУПДВДиадоке", "УПД");
	СоответствиеИменСсылок.Вставить("СсылкаНаЦеновойЛистВДиадоке", "Ценовой лист");	
	
	Возврат СоответствиеИменСсылок;
	
КонецФункции

Процедура ОбновитьСтатусСообщенияINVOICИзДД(СообщениеСсылка,АктуальноеСостояниеСообщенияINVOIC)Экспорт
	
	СообщениеОбъект=ПолучитьОбъектСообщения(СообщениеСсылка);
	
	Если ЗначениеЗаполнено(АктуальноеСостояниеСообщенияINVOIC.Статус) Тогда 
		СообщениеОбъект.Статус=АктуальноеСостояниеСообщенияINVOIC.Статус;
		СообщениеОбъект.Архив=АктуальноеСостояниеСообщенияINVOIC.Архив;
	КонецЕсли;
	Если ЗначениеЗаполнено(АктуальноеСостояниеСообщенияINVOIC.ТребуемоеДействие) Тогда 
		СообщениеОбъект.ТребуемоеДействие=АктуальноеСостояниеСообщенияINVOIC.ТребуемоеДействие;
		СообщениеОбъект.Архив=АктуальноеСостояниеСообщенияINVOIC.Архив;
	КонецЕсли;
	
	СохранитьОбъектСообщения(СообщениеОбъект);
	
КонецПроцедуры // ОбновитьСтатусСообщенияINVOICИзДД()

Функция НужноПодписатьДокументыВДиадок(НачалоПериода = Неопределено, КонецПериода = Неопределено) Экспорт
	
	МассивСообщений = ПолучитьМассивСообщенийДляАвтоматическогоПодписания(НачалоПериода, КонецПериода);
	
	Если НЕ МассивСообщений.Количество() = 0 Тогда
		ПоместитьВоВХ("Диадок_МассивСообщенийДляПодписания", МассивСообщений);
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Процедура ЗаписатьПризнакОтправкиИзвещенияОПолучении(СообщениеСсылка)
	
	Если ПолучитьЗначениеДопРеквизитаСправочника_КонтурEDI(СообщениеСсылка, "InvoiceReceiptEntityId_HaveToCreateReceipt") = Неопределено Тогда 
		ЗаписатьДопРеквизитСправочника_КонтурEDI(СообщениеСсылка, "InvoiceReceiptEntityId_HaveToCreateReceipt");
	КонецЕсли;

КонецПроцедуры	

Функция ПолучитьТаблицуДляОтправкиСлужебныхУниверсальныхСообщений(DD_СписокДокументов) Экспорт 
	
	Запрос = ИнициализироватьЗапрос_КонтурEDI(); 
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_ДопСпрДопРеквизиты_Организация.Значение КАК Организация
	|ПОМЕСТИТЬ ВТ_ОрганизацииССертификатами
	|ИЗ
	|	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК КонтурEDI_ДопСпрДопРеквизиты_СертификатДействуетПо
	|		ПО (КонтурEDI_ДопСпрДопРеквизиты_СертификатДействуетПо.Ссылка = КонтурEDI_ДополнительныеСправочники.Ссылка)
	|			И (КонтурEDI_ДопСпрДопРеквизиты_СертификатДействуетПо.ИмяРеквизита = ""СертификатДействуетПо"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК КонтурEDI_ДопСпрДопРеквизиты_Пользователь1С
	|		ПО (КонтурEDI_ДопСпрДопРеквизиты_Пользователь1С.Ссылка = КонтурEDI_ДополнительныеСправочники.Ссылка)
	|			И (КонтурEDI_ДопСпрДопРеквизиты_Пользователь1С.ИмяРеквизита = ""Пользователь1С"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК КонтурEDI_ДопСпрДопРеквизиты_Организация
	|		ПО (КонтурEDI_ДопСпрДопРеквизиты_Организация.Ссылка = КонтурEDI_ДополнительныеСправочники.Ссылка)
	|			И (КонтурEDI_ДопСпрДопРеквизиты_Организация.ИмяРеквизита = ""Организация"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК КонтурEDI_ДопСпрДопРеквизиты_ПоУмолчанию
	|		ПО (КонтурEDI_ДопСпрДопРеквизиты_ПоУмолчанию.Ссылка = КонтурEDI_ДополнительныеСправочники.Ссылка)
	|			И (КонтурEDI_ДопСпрДопРеквизиты_ПоУмолчанию.ИмяРеквизита = ""ПоУмолчанию"")
	|ГДЕ
	|	КонтурEDI_ДополнительныеСправочники.ИмяСправочника = ""Сертификаты""
	|	И НЕ КонтурEDI_ДополнительныеСправочники.ПометкаУдаления
	|	И КонтурEDI_ДопСпрДопРеквизиты_СертификатДействуетПо.Значение >= &СертификатДействуетПо
	|	И КонтурEDI_ДопСпрДопРеквизиты_Пользователь1С.Значение = &Пользователь1С
	|	И КонтурEDI_ДопСпрДопРеквизиты_ПоУмолчанию.Значение = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ИД_Документов_messageId.Объект КАК ДокументСсылка,
	|	ВЫРАЗИТЬ(ИД_Документов_messageId.Значение КАК СТРОКА(36)) КАК messageId,
	|	ВЫРАЗИТЬ(ИД_Документов_boxId.Значение КАК СТРОКА(36)) КАК boxId,
	|	КонтурEDI_Сообщения.Ссылка КАК Ссылка,
	|	КонтурEDI_Сообщения.Организация КАК Организация
	|ИЗ
	|	РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК ИД_Документов_messageId
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК ИД_Документов_boxId
	|		ПО ИД_Документов_messageId.Объект = ИД_Документов_boxId.Объект
	|			И (ИД_Документов_boxId.Свойство = ""boxId"")
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОрганизацииССертификатами КАК ВТ_ОрганизацииССертификатами
	|			ПО КонтурEDI_Сообщения.Организация = ВТ_ОрганизацииССертификатами.Организация
	|		ПО ИД_Документов_messageId.Объект = КонтурEDI_Сообщения.Документ
	|			И (КонтурEDI_Сообщения.ТипСообщения В (""INVOIC"", ""COINVOIC""))
	|ГДЕ
	|	ИД_Документов_messageId.Значение В(&МассивИндетификаторов)
	|	И КонтурEDI_Сообщения.ДатаЗагрузки > &ДатаСоздания";

	
	Запрос.УстановитьПараметр("Пользователь1С", 		ПолучитьТекущегоПользователя1С());
	Запрос.УстановитьПараметр("СертификатДействуетПо", 	НачалоДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("ДатаСоздания", 			НачалоДня(ТекущаяДата() - 60*60*24*30)); // будем искать за последний месяц   
	
	МассивID = Новый Массив;
	Для каждого ПакетДокументов из DD_СписокДокументов Цикл 
		Для Каждого Документ Из ПакетДокументов Цикл 
			МассивID.Добавить(Документ.MessageId); 
		КонецЦикла;
	КонецЦикла; 
	
	Запрос.УстановитьПараметр("МассивИндетификаторов", МассивID);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ТипыСообщенийПодписываемыхДД()
	
	ТипыСообщений = ЭДО_Кэш_Прочитать("ТипыСообщенийПодписываемыхДД");
	
	Если ТипыСообщений = Неопределено Тогда
		
		ТипыСообщений = Новый Массив;
		ТипыСообщений.Добавить("INVOIC");
		ТипыСообщений.Добавить("COINVOIC");
		ТипыСообщений.Добавить("PRICAT");
		ТипыСообщений.Добавить("PRICELIST");
		
		ЭДО_Кэш_Поместить("ТипыСообщенийПодписываемыхДД", ТипыСообщений);
		
	КонецЕсли;
	
	Возврат ТипыСообщений;

КонецФункции

Функция ЭтоТипПодписываемогоДДСообщения(ТипСообщения) Экспорт
	
	ТипыСообщенийДД = ТипыСообщенийПодписываемыхДД();
	
	ТипСообщенияНайденВТипыСообщенийДД = (ТипыСообщенийДД.Найти(ТипСообщения) <> Неопределено);
	
	Возврат ТипСообщенияНайденВТипыСообщенийДД;	
	
КонецФункции

Функция ПолучитьМассивСообщенийДляАвтоматическогоПодписания(Знач НачалоПериода = Неопределено, Знач КонецПериода = Неопределено) Экспорт
	
	МассивСообщенийДляПодписания = Новый Массив;
	
	Если НЕ НастройкиМодуля.МыПоставщик Тогда
		Возврат МассивСообщенийДляПодписания;
	КонецЕсли;
	
	МассивНедоступныхСообщений = ?(ЗначениеЗаполнено(ПараметрыПользователяEDI.НедоступныеСообщения), ПараметрыПользователяEDI.НедоступныеСообщения.ВыгрузитьЗначения(), Новый Массив);
									
	Если НЕ МассивНедоступныхСообщений.Найти("INVOIC") = Неопределено
		И НЕ МассивНедоступныхСообщений.Найти("COINVOIC") = Неопределено Тогда
		Возврат МассивСообщенийДляПодписания;
	КонецЕсли;
	
	МассивНедоступныхПартнеров = ?(ЗначениеЗаполнено(ПараметрыПользователяEDI.НедоступныеПартнеры), ПараметрыПользователяEDI.НедоступныеПартнеры, Новый Массив);
	
	Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_ДополнительныеСправочники.Ссылка КАК Партнер,
	|	ВЫБОР
	|		КОГДА КонтурEDI_ДополнительныеРеквизиты.Свойство = ""АвтоПодписание_INVOIC""
	|			ТОГДА ""INVOIC""
	|		КОГДА КонтурEDI_ДополнительныеРеквизиты.Свойство = ""АвтоПодписание_COINVOIC""
	|			ТОГДА ""COINVOIC""
	|	КОНЕЦ КАК ТипСообщения
	|ИЗ
	|	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеРеквизиты
	|		ПО КонтурEDI_ДополнительныеСправочники.Ссылка = КонтурEDI_ДополнительныеРеквизиты.Объект
	|			И (КонтурEDI_ДополнительныеРеквизиты.Свойство = ""АвтоПодписание_INVOIC""
	|				ИЛИ КонтурEDI_ДополнительныеРеквизиты.Свойство = ""АвтоПодписание_COINVOIC"")
	|			И (КонтурEDI_ДополнительныеРеквизиты.Значение = ИСТИНА)";
	
	ВремТабПартнеровСообщений = Запрос.Выполнить().Выгрузить();
	Если ВнешнееХранилище Тогда
		ВремТабПартнеровСообщений = ПолучитьТаблицуИзВнешнейБазы(ВремТабПартнеровСообщений);
	КонецЕсли;
	МассивСтрок = Новый Массив;	
	Для каждого Строка Из ВремТабПартнеровСообщений Цикл
		Если НЕ МассивНедоступныхПартнеров.Найти(Строка.Партнер) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ МассивНедоступныхСообщений.Найти(Строка.ТипСообщения) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
	    МассивСтрок.Добавить(Строка);
	КонецЦикла;
	ТабПартнеровСообщений = ВремТабПартнеровСообщений.Скопировать(МассивСтрок);
	
	Если ТабПартнеровСообщений.Количество() = 0 Тогда
		Возврат МассивСообщенийДляПодписания;
	КонецЕсли;
	
	МассивНедоступныхОрганизаций = ?(ЗначениеЗаполнено(ПараметрыПользователяEDI.НедоступныеОрганизации), ПараметрыПользователяEDI.НедоступныеОрганизации, Новый Массив);
	ТабОрганизаций = Новый ТаблицаЗначений;
	ТабОрганизаций.Колонки.Добавить("ОрганизацияСсылка", Новый ОписаниеТипов(ПолучитьТипЗначенияОбъекта("ЮрФизЛицоСвое")));
	СписокЮрЛиц = ПолучитьСписокЭлементовСправочника("ЮрФизЛицаСвои");
	Для каждого Стр ИЗ СписокЮрЛиц Цикл
		Если НЕ МассивНедоступныхОрганизаций.Найти(Стр.ЮрФизЛицо) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ТабОрганизаций.Добавить();
		НоваяСтрока.ОрганизацияСсылка = Стр.ЮрФизЛицо;
	КонецЦикла;
	
	ПериодПодбораСообщенийДляАвтоподписания = ПолучитьКонстантуEDI("ПериодПодбораСообщенийДляАвтоподписания");
	Если Не ЗначениеЗаполнено(ПериодПодбораСообщенийДляАвтоподписания)
		ИЛИ ТипЗнч(ПериодПодбораСообщенийДляАвтоподписания) <> Тип("Число") Тогда
		
		ПериодПодбораСообщенийДляАвтоподписания = 3;
		
	КонецЕсли;
	
	НачалоПериода	= ?(НачалоПериода = Неопределено, НачалоДня(ТекущаяДата() - 60*60*24*ПериодПодбораСообщенийДляАвтоподписания), НачалоПериода);
	КонецПериода	= ?(ЗначениеЗаполнено(КонецПериода), КонецПериода, КонецДня(ТекущаяДата() + 60*60*24*ПериодПодбораСообщенийДляАвтоподписания));

	
	Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище); 
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ТабОрганизаций.ОрганизацияСсылка
	|ПОМЕСТИТЬ ВТ_ТабОрганизаций
	|ИЗ
	|	&ТабОрганизаций КАК _ТабОрганизаций
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ТабПартнеровСообщений.Партнер,
	|	_ТабПартнеровСообщений.ТипСообщения
	|ПОМЕСТИТЬ ВТ_ТабПартнеровСообщений
	|ИЗ
	|	&ТабПартнеровСообщений КАК _ТабПартнеровСообщений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	КонтурEDI_Сообщения.Ссылка,
	|	КонтурEDI_Сообщения.Партнер,
	|	КонтурEDI_Сообщения.ТипСообщения,
	|	КонтурEDI_Сообщения.ТочкаДоставки,
	|	КонтурEDI_Сообщения.Документ,
	|	КонтурEDI_Сообщения.Организация
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТабОрганизаций КАК ВТ_ТабОрганизаций
	|		ПО КонтурEDI_Сообщения.Организация = ВТ_ТабОрганизаций.ОрганизацияСсылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТабПартнеровСообщений КАК ВТ_ТабПартнеровСообщений
	|		ПО (КонтурEDI_Сообщения.Партнер = ВТ_ТабПартнеровСообщений.Партнер
	|			И КонтурEDI_Сообщения.ТипСообщения = ВТ_ТабПартнеровСообщений.ТипСообщения)
	|ГДЕ
	|	(КонтурEDI_Сообщения.ТипСообщения = ""INVOIC""
	|			ИЛИ КонтурEDI_Сообщения.ТипСообщения = ""COINVOIC"")
	|	И КонтурEDI_Сообщения.ДатаЗагрузки МЕЖДУ &НачалоПериода И &КонецПериода
	|	И КонтурEDI_Сообщения.ТребуемоеДействие = ""ПодписатьВДиадок""
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организация";
	
	Запрос.УстановитьПараметр("ТабОрганизаций", 				?(ВнешнееХранилище, ПоместитьТаблицуВоВнешнююБазу(ТабОрганизаций), ТабОрганизаций));
	Запрос.УстановитьПараметр("ТабПартнеровСообщений", 			?(ВнешнееХранилище, ПоместитьТаблицуВоВнешнююБазу(ТабПартнеровСообщений, Новый Структура("Партнер", "КонтурEDI_ДополнительныеСправочники")), ТабПартнеровСообщений)); 
	
	Пользователь1С = ПолучитьТекущегоПользователя1С();
	Если Строка(Пользователь1С) = "<Не указан>" Тогда 
		// это регламентное задание на сервере
		// используем сертификат служебного пользователя автообмена
		ПользовательНастроек = НайтиОбъектПоЗначениюСвойства("СлужебныйПользовательАвтообмен", Истина);
		Если ЗначениеЗаполнено(ПользовательНастроек) Тогда
			Пользователь1С = ПользовательНастроек;
		КонецЕсли;
	КонецЕсли;	
		
	Запрос.УстановитьПараметр("Пользователь1С", 				?(ВнешнееХранилище, ПреобразоватьЗначениеДляВнешнегоХранилища(Пользователь1С), Пользователь1С));
	Запрос.УстановитьПараметр("СертификатДействуетПо", 			НачалоДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("НачалоПериода", 					НачалоПериода); 
	Запрос.УстановитьПараметр("КонецПериода", 					КонецПериода); 
	
	ТабСФ = Запрос.Выполнить().Выгрузить();
	Если ВнешнееХранилище Тогда
		ТабСФ = ПолучитьТаблицуИзВнешнейБазы(ТабСФ, Новый Структура("Документ,Организация", Документы.ТипВсеСсылки(), Новый ОписаниеТипов(ПолучитьТипЗначенияОбъекта("ЮрФизЛицоСвое"))));  
	КонецЕсли;
	
	Для каждого СтрокаСообщения Из ТабСФ Цикл
		
		// ПМ на необходимость автоподписания
		// требуется для кастомных запретов автоподписания
		СтандартнаяОбработкаEDI = Истина;
		ОбработкаСобытияПодключаемогоМодуля("ПередАвтоПодписаниемСообщения",СтандартнаяОбработкаEDI,Новый Структура("СтрокаСообщения,ТипСообщения", СтрокаСообщения, СтрокаСообщения.ТипСообщения));
		
		Если СтандартнаяОбработкаEDI = Истина Тогда 
			МассивСообщенийДляПодписания.Добавить(СтрокаСообщения.Ссылка);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивСообщенийДляПодписания;		
	
КонецФункции

