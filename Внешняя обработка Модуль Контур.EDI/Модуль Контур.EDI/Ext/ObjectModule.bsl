	КонецЕсли;
	
	Если СравнитьСемантикВерсии(ВерсияМодуляВ1С, "4.62.0") = ВидСравнения.Меньше Тогда
		
		ПроверкаНовойВерсии_УдалитьРасширениеРезервныеАдреса();
		ПроверкаНовойВерсии_ОбновитьХешСуммуПредложенийПродления();
		
	КонецЕсли;
	
	Если СравнитьСемантикВерсии(ВерсияМодуляВ1С, "4.67.1") = ВидСравнения.Меньше Тогда
		
		ПроверкаНовойВерсии_ИзменитьТипИзмеренияХарактеристикаНоменклатурыВСоответствииТоваров();
		
	КонецЕсли;
	
	Если СравнитьСемантикВерсии(ВерсияМодуляВ1С, "4.80.1") = ВидСравнения.Меньше Тогда
		
    	ПроверкаНовойВерсии_ИзменитьСистемуХраненияАрхивовСообщений();
		
	КонецЕсли;  

	Если СравнитьСемантикВерсии(ВерсияМодуляВ1С, "4.83.0") = ВидСравнения.Меньше Тогда
		
    	ПроверкаНовойВерсии_НеИспользоватьПортальнуюАвторизацию();
		
	КонецЕсли;  
	
	УстановитьВерсиюМодуля(ТекущаяВерсияМодуля);

	Возврат Результат;
	
КонецФункции


Процедура ПроверкаНовойВерсии_ИзменитьСистемуХраненияАрхивовСообщений() 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтурEDI_ДополнительныеСправочники.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
	|ГДЕ
	|	КонтурEDI_ДополнительныеСправочники.ИмяСправочника = ""АрхивСообщений""
	|	И КонтурEDI_ДополнительныеСправочники.Наименование = ""ОтправленныеСообщенияВАрхиве""";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		ОтправленныеАрхивы = Выборка.Ссылка.ДополнительныеРеквизиты;
		
		Для Каждого АрхивСообщений Из ОтправленныеАрхивы Цикл 
			
			НовыйАрхив  = НайтиИлиСоздатьОбъектХранилищеОтправленныхАрхивов_КонтурEDI(АрхивСообщений.ИмяРеквизита);
			СтарыйАрхив = АрхивСообщений.ЗначениеХранилищеЗначения.Получить();
			
			Для Каждого Сообщение Из СтарыйАрхив Цикл 
				СообщениеАрхива = НовыйАрхив.ДополнительныеРеквизиты.Добавить(); 
				
				СообщениеАрхива.Значение  		= Сообщение.Значение.СообщениеСсылка;
				СообщениеАрхива.ЗначениеСтрока 	= Сообщение.Ключ;  
				СообщениеАрхива.ИмяРеквизита	= Сообщение.Значение.ID;
				
			КонецЦикла;	
			НовыйАрхив.Записать();	
		КонецЦикла;  
		
		Попытка
			ОбъектСтарогоАрхива = Выборка.Ссылка.ПолучитьОбъект();
			ОбъектСтарогоАрхива.Удалить();
		Исключение
			_Ошибка = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;  
	
КонецПроцедуры	

Процедура ПроверкаНовойВерсии_ИзменитьТипИзмеренияХарактеристикаНоменклатурыВСоответствииТоваров()
	
	ПустаяСсылкаХарактеристики = ПолучитьПустуюСсылкуОбъекта("ХарактеристикаНоменклатуры");
	
	Если ПустаяСсылкаХарактеристики = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВариантыРасположенияСистемыХранения = ПеречисленияEDI_ВариантыРасположенияСистемыХранения();
	
	СистемаХраненияЧерезРасширение = 
				(ОпределитьРасположениеСистемыХранения_КонтурEDI() = ВариантыРасположенияСистемыХранения.Расширение);
	
	Если НЕ СистемаХраненияЧерезРасширение Тогда
		Возврат;
	КонецЕсли;
	
	СоответствияТоваров_КонтурEDI = РегистрыСведений.КонтурEDI_СоответствияТоваров.Выбрать();
		
	Пока СоответствияТоваров_КонтурEDI.Следующий() Цикл
		
		Если СоответствияТоваров_КонтурEDI.ХарактеристикаНоменклатуры = ПустаяСсылкаХарактеристики Тогда
			
			МенеджерЗаписиСоответствийТоваров = СоответствияТоваров_КонтурEDI.ПолучитьМенеджерЗаписи();
			
			МенеджерЗаписиСоответствийТоваров.Прочитать();
			
			Если МенеджерЗаписиСоответствийТоваров.Выбран() 
				И МенеджерЗаписиСоответствийТоваров.ХарактеристикаНоменклатуры = ПустаяСсылкаХарактеристики Тогда
				
				МенеджерЗаписиСоответствийТоваров.ХарактеристикаНоменклатуры = Неопределено;
				МенеджерЗаписиСоответствийТоваров.Записать(Истина);
				
			КонецЕсли;
						
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверкаНовойВерсии_УдалитьРасширениеРезервныеАдреса()
	
	ТабРасширения = ПолучитьДанныеОбУстановленныхРасширениях(Истина);
	
	НайденнаяСтрока = ТабРасширения.Найти("Mirror_host", "Идентификатор");
	Если НЕ НайденнаяСтрока = Неопределено Тогда
		
		РасширениеСсылка = НайденнаяСтрока.Ссылка;
		УдалитьРасширение(РасширениеСсылка);  
		ОбновитьКэшИсполняемогоКодаРасширений();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверкаНовойВерсии_ОбновитьХешСуммуПредложенийПродления()
	
	Если ПротоколОбмена_КонтурEDI = "API" И ЕстьОбъектыХраненияДанных_КонтурEDI() Тогда

		НаборЗаписей = РегистрыСведений.КонтурEDI_ДополнительныеРеквизиты.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Свойство.Установить("MD5ПредложенияПродления");
		НаборЗаписей.Прочитать();  
		
		Если НаборЗаписей.Количество() Тогда
			
			СтруктураПредложенияПродления = ПолучитьСтруктуруПредложенияПродления();
			ХешMD5 = СтруктураПредложенияПродления.MD5;
			
			Для Каждого Запись Из НаборЗаписей Цикл
				
				Запись.Значение = ХешMD5;	
				
			КонецЦикла;
			
			НаборЗаписей.Записать();
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры 

Процедура ПроверкаНовойВерсии_УстановитьФлагНеБратьАдресаПартнераИз1СРежимСети()
	
