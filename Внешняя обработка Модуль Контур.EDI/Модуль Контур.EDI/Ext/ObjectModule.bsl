	Возврат КонтурСтандарт_ИнформационнаяБазаФайловая();
	
КонецФункции

Функция МетрикаКонтурСлужебный_ИдентификаторИнформационнойБазы_Файл()
	
	Результат = "";
	
	ПараметрыСоединения = КонтурСтандарт_ПараметрыИзСтроки(СтрокаСоединенияИнформационнойБазы());
	Каталог = ПараметрыСоединения.File;
	ПутьКФайлу = ОбъединитьПути(Каталог, "KonturBaseId.txt");
		
	Если НЕ ПроверитьСуществованиеФайлаКаталога(ПутьКФайлу) Тогда
		
		Результат = Строка(Новый УникальныйИдентификатор);	
		
		ТД = Новый ТекстовыйДокумент;
		ТД.УстановитьТекст(Результат);
		ТД.Записать(ПутьКФайлу);
		
	Иначе           
		
		ТД = Новый ТекстовыйДокумент;
		ТД.Прочитать(ПутьКФайлу);
		Результат = СокрЛП(ТД.ПолучитьСтроку(1));
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция МетрикаКонтурСлужебный_ИдентификаторИнформационнойБазы()
	
	Если МетрикаКонтурСлужебный_ДоступенВариантИдентификации_БСП() Тогда
		Результат = МетрикаКонтурСлужебный_ИдентификаторИнформационнойБазы_БСП();	
	ИначеЕсли МетрикаКонтурСлужебный_ДоступенВариантИдентификации_ДополнительныеСведения() Тогда
		Результат = МетрикаКонтурСлужебный_ИдентификаторИнформационнойБазы_ДополнительныеСведения();		
	ИначеЕсли МетрикаКонтурСлужебный_ДоступенВариантИдентификации_ЗначенияСвойствОбъектов() Тогда		
		Результат = МетрикаКонтурСлужебный_ИдентификаторИнформационнойБазы_ЗначенияСвойствОбъектов(); 	
	ИначеЕсли МетрикаКонтурСлужебный_ДоступенВариантИдентификации_КонстантаКонтур() Тогда		
		Результат = МетрикаКонтурСлужебный_ИдентификаторИнформационнойБазы_КонстантаКонтур();
	ИначеЕсли МетрикаКонтурСлужебный_ДоступенВариантИдентификации_Файл() Тогда	 	
		Результат = МетрикаКонтурСлужебный_ИдентификаторИнформационнойБазы_Файл();	
	Иначе
		Результат = МетрикаКонтурСлужебный_ИдентификаторИнформационнойБазыНеОпределен();	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

