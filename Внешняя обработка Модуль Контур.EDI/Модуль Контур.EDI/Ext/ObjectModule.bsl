	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Функция ПолучитьСвойстваМеток(Метки) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Метки_Ссылки.Ссылка КАК Ссылка,
	|	Метки_Ссылки.Наименование КАК Наименование,
	|	ЕСТЬNULL(Метки_ДопРеквизитЦветТекста.ЗначениеСтрока, """") КАК ЦветТекста,
	|	ЕСТЬNULL(Метки_ДопРеквизитШрифт.ЗначениеСтрока, """") КАК Шрифт,
	|	ЕСТЬNULL(Метки_ДопРеквизитЦветФона.ЗначениеСтрока, """") КАК ЦветФона
	|ИЗ
	|	Справочник.КонтурEDI_ДополнительныеСправочники КАК Метки_Ссылки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК Метки_ДопРеквизитЦветТекста
	|		ПО Метки_Ссылки.Ссылка = Метки_ДопРеквизитЦветТекста.Ссылка
	|			И (Метки_ДопРеквизитЦветТекста.ИмяРеквизита = ""ЦветТекста"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК Метки_ДопРеквизитШрифт
	|		ПО Метки_Ссылки.Ссылка = Метки_ДопРеквизитШрифт.Ссылка
	|			И (Метки_ДопРеквизитШрифт.ИмяРеквизита = ""Шрифт"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК Метки_ДопРеквизитЦветФона
	|		ПО Метки_Ссылки.Ссылка = Метки_ДопРеквизитЦветФона.Ссылка
	|			И (Метки_ДопРеквизитЦветФона.ИмяРеквизита = ""ЦветФона"")
	|ГДЕ
	|	Метки_Ссылки.ИмяСправочника = ""Метки""
	|	И Метки_Ссылки.Ссылка В (&Метки)";
	
	Запрос.УстановитьПараметр("Метки", Метки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	СоответствиеСвойствМеток = Новый Соответствие;
	
	ШрифтПоУмолчанию = Новый Шрифт();
	ЦветПоУмолчанию = Новый Цвет();
	
	Пока Выборка.Следующий() Цикл
		
		СтруктураСвойств = Новый Структура;
		СтруктураСвойств.Вставить("Наименование", Выборка.Наименование);
		
		Если ЗначениеЗаполнено(Выборка.ЦветТекста) Тогда
			СтруктураСвойств.Вставить("ЦветТекста", ЗначениеИзСтрокиВнутр(Выборка.ЦветТекста));
		Иначе
			СтруктураСвойств.Вставить("ЦветТекста", ЦветПоУмолчанию);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.Шрифт) Тогда
			СтруктураСвойств.Вставить("Шрифт", ЗначениеИзСтрокиВнутр(Выборка.Шрифт));
		Иначе
			СтруктураСвойств.Вставить("Шрифт", ШрифтПоУмолчанию);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.ЦветФона) Тогда
			СтруктураСвойств.Вставить("ЦветФона", ЗначениеИзСтрокиВнутр(Выборка.ЦветФона));
		Иначе
			СтруктураСвойств.Вставить("ЦветФона", ЦветПоУмолчанию);
		КонецЕсли;
		
		СоответствиеСвойствМеток.Вставить(Выборка.Ссылка, СтруктураСвойств);
		
	КонецЦикла;
	
	Возврат СоответствиеСвойствМеток; 
	
КонецФункции

Процедура УдалитьЭлементыМетокНаФорме(КоличествоЭлементов, МассивЭлементовДляУдаления, ЭтоУправляемаяФорма, КоллекцияЭлементовФормы)
	
	МинимальноеКоличество = ?(ЭтоУправляемаяФорма, 1, 0);
	
	Пока КоличествоЭлементов > МинимальноеКоличество Цикл
		
		КоличествоЭлементов = КоличествоЭлементов - 1;
		ЭлементМетка = МассивЭлементовДляУдаления[КоличествоЭлементов];
		КоллекцияЭлементовФормы.Удалить(ЭлементМетка);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьДекорациюНадпись(Форма, ГруппаВладелец, Имя, СвойстваМеток, ЭтоУправляемаяФорма, Лево = 0, Верх = 0, Высота = 0, Ширина = 0) Экспорт 
	
	Если ЭтоУправляемаяФорма Тогда
		
		ДекорацияНадпись = Форма.Элементы.Добавить(Имя, Тип("ДекорацияФормы"), ГруппаВладелец);
		ДекорацияНадпись.Вид = ВидДекорацииФормы.Надпись;
		
	Иначе
		
		ДекорацияНадпись = Форма.ЭлементыФормы.Добавить(Тип("Надпись"), Имя, Истина, ГруппаВладелец);
		ДекорацияНадпись.Лево = Лево;
		ДекорацияНадпись.Верх = Верх;
		ДекорацияНадпись.Высота = Высота;
		ДекорацияНадпись.Ширина = Ширина;
		
	КонецЕсли;
	
	СвойстваМеток.Свойство("Наименование"	, ДекорацияНадпись.Заголовок);
	СвойстваМеток.Свойство("ЦветТекста"		, ДекорацияНадпись.ЦветТекста);
	СвойстваМеток.Свойство("Шрифт"			, ДекорацияНадпись.Шрифт);
	СвойстваМеток.Свойство("ЦветФона"		, ДекорацияНадпись.ЦветФона);
	
КонецПроцедуры

Функция НайтиМетку(Наименование) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	КонтурEDI_ДополнительныеСправочники.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
		|ГДЕ
		|	КонтурEDI_ДополнительныеСправочники.ИмяСправочника = &ИмяСправочника
		|	И КонтурEDI_ДополнительныеСправочники.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("ИмяСправочника", "Метки");
	Запрос.УстановитьПараметр("Наименование", Наименование);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;                               
	
	Возврат Неопределено;	
	
КонецФункции

Функция СоздатьМетку(Наименование, ЦветТекста = Неопределено, Шрифт = Неопределено, ЦветФона = Неопределено) Экспорт
	
	МеткаОбъект = Справочники.КонтурEDI_ДополнительныеСправочники.СоздатьЭлемент();
	МеткаОбъект.Наименование = Наименование;
	МеткаОбъект.ИмяСправочника = "Метки";
	
	Если ЦветТекста <> Неопределено Тогда
		СтрокаЦветТекста = МеткаОбъект.ДополнительныеРеквизиты.Добавить();
		СтрокаЦветТекста.ИмяРеквизита = "ЦветТекста";
		СтрокаЦветТекста.ЗначениеСтрока = ЗначениеВСтрокуВнутр(ЦветТекста);
	КонецЕсли;
	
	Если Шрифт <> Неопределено Тогда
		СтрокаЦветТекста = МеткаОбъект.ДополнительныеРеквизиты.Добавить();
		СтрокаЦветТекста.ИмяРеквизита = "Шрифт";
		СтрокаЦветТекста.ЗначениеСтрока = ЗначениеВСтрокуВнутр(Шрифт);
	КонецЕсли;
	
	Если ЦветФона <> Неопределено Тогда
		СтрокаЦветТекста = МеткаОбъект.ДополнительныеРеквизиты.Добавить();
		СтрокаЦветТекста.ИмяРеквизита = "ЦветФона";
		СтрокаЦветТекста.ЗначениеСтрока = ЗначениеВСтрокуВнутр(ЦветФона); 
	КонецЕсли;
	
	МеткаОбъект.Записать();
	
	Возврат МеткаОбъект.Ссылка;	
	
КонецФункции

Процедура ЗаписатьДанныеМетокНаФорме(Форма, ОбъектПрикрепления) Экспорт
	
	ДополнительныеРеквизиты = ОбъектПрикрепления.ДополнительныеРеквизиты;
	
	ОчиститьДанныеМеток(ОбъектПрикрепления);
	
	Метки = Форма.ДанныеМеток.Выгрузить(, "Метка").ВыгрузитьКолонку("Метка");
	
	ЗаписатьМетки(ОбъектПрикрепления, Метки);	
	
КонецПроцедуры

Процедура ЗаписатьМетки(ОбъектПрикрепления, Метки) Экспорт
	
	ДополнительныеРеквизиты = ОбъектПрикрепления.ДополнительныеРеквизиты;
	
	Для Каждого Метка Из Метки Цикл
		
		Отбор = Новый Структура("ИмяРеквизита, Значение", "Метка", Метка);
		СтрокиМеток = ДополнительныеРеквизиты.НайтиСтроки(Отбор);
		
		Если СтрокиМеток.Количество() = 0 Тогда
			
			НоваяСтрокаМеток = ДополнительныеРеквизиты.Добавить();
			НоваяСтрокаМеток.ИмяРеквизита = "Метка";
			НоваяСтрокаМеток.Значение = Метка;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьМетки(ОбъектПрикрепления, Метки) Экспорт
	
	ДополнительныеРеквизиты = ОбъектПрикрепления.ДополнительныеРеквизиты;
	
	Для Каждого Метка Из Метки Цикл
	
		Отбор = Новый Структура("ИмяРеквизита, Значение", "Метка", Метка);
		СтрокиМеток = ДополнительныеРеквизиты.НайтиСтроки(Отбор);
		
		Для Каждого СтрокаМеток Из СтрокиМеток Цикл
			ОбъектПрикрепления.ДополнительныеРеквизиты.Удалить(СтрокаМеток);
		КонецЦикла;
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура ОчиститьДанныеМеток(ОбъектПрикрепления) Экспорт
	
	Отбор = Новый Структура("ИмяРеквизита", "Метка");
	СтрокиМеток = ОбъектПрикрепления.ДополнительныеРеквизиты.НайтиСтроки(Отбор);
	Для Каждого СтрокаМеток Из СтрокиМеток Цикл
		ОбъектПрикрепления.ДополнительныеРеквизиты.Удалить(СтрокаМеток);
	КонецЦикла;
	
КонецПроцедуры

Процедура Метки_ПриСозданииеФормы(Форма, СообщениеСсылка) Экспорт
	
	ПрочитатьДанныеМеток(Форма, СообщениеСсылка);
	ОбновитьЭлементыМетокНаФорме(Форма);
	
КонецПроцедуры

Процедура ПрочитатьДанныеМеток(Форма, СообщениеСсылка)
	
	Форма.ДанныеМеток.Очистить();
	
	Если Не ЗначениеЗаполнено(СообщениеСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВЫРАЗИТЬ(КонтурEDI_СообщенияДополнительныеРеквизиты.Значение КАК Справочник.КонтурEDI_ДополнительныеСправочники).Наименование КАК Наименование,
		|	ВЫРАЗИТЬ(КонтурEDI_СообщенияДополнительныеРеквизиты.Значение КАК Справочник.КонтурEDI_ДополнительныеСправочники).ПометкаУдаления КАК ПометкаУдаления,
		|	ВЫРАЗИТЬ(КонтурEDI_СообщенияДополнительныеРеквизиты.Значение КАК Справочник.КонтурEDI_ДополнительныеСправочники).Ссылка КАК Метка
		|ИЗ
		|	Справочник.КонтурEDI_Сообщения.ДополнительныеРеквизиты КАК КонтурEDI_СообщенияДополнительныеРеквизиты
		|ГДЕ
		|	КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка = &СообщениеСсылка
		|	И КонтурEDI_СообщенияДополнительныеРеквизиты.ИмяРеквизита = ""Метка""
		|	И НЕ КонтурEDI_СообщенияДополнительныеРеквизиты.Значение ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("СообщениеСсылка", СообщениеСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Выборка.Метка) Тогда
			Продолжить;
		КонецЕсли;
		
		НовыеДанныеМетки = Форма.ДанныеМеток.Добавить();
		НовыеДанныеМетки.Метка = Выборка.Метка;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиОшибкиПроверкиДоверенностейНаФорме(Форма, СообщениеСсылка) Экспорт
	
	ТаблицаОшибок = Форма.ТаблицаОшибок;
	
	СообщениеОбъект = ПолучитьОбъектСообщения(СообщениеСсылка);
	
	МассивОшибок = Новый Массив;
	
	ДополнительныеРеквизиты = СообщениеОбъект.ДополнительныеРеквизиты;
	
	Отбор = Новый Структура("ИмяРеквизита", "Исх_ОшибкиПроверкиМЧД");
	Строки_Исх_ОшибкиПроверкиМЧД = ДополнительныеРеквизиты.НайтиСтроки(Отбор);
	
	Для Каждого Строка_Исх_ОшибкиПроверкиМЧД Из Строки_Исх_ОшибкиПроверкиМЧД Цикл
		
		МассивОшибок = ЗначениеИзСтрокиВнутр(Строка_Исх_ОшибкиПроверкиМЧД.ЗначениеСтрока);
		
		Если МассивОшибок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаОшибок.Добавить();
								  
		ПолныйТекстОшибки = "";
		Для Каждого Ошибка из МассивОшибок Цикл
			
			КодОшибки = Ошибка.Код;
			ТекстОшибки = Ошибка.Текст;
			
			ПолныйТекстОшибки = ПолныйТекстОшибки + " - " + "(" + КодОшибки + ")" + " " + ТекстОшибки + Символы.ПС;
			
		КонецЦикла; 
		
		НоваяСтрока.ТекстОшибки = "Исходящая доверенность не прошла проверку по причине:
								  |" + ПолныйТекстОшибки;
								  
		НоваяСтрока.ИмяПоля		= "ИсходящаяДоверенность";
		НоваяСтрока.Действие	= "Информация";
		
	КонецЦикла;
	
	Отбор = Новый Структура("ИмяРеквизита", "Вх_ОшибкиПроверкиМЧД");
	Строки_Вх_ОшибкиПроверкиМЧД = ДополнительныеРеквизиты.НайтиСтроки(Отбор);
	
	Для Каждого Строка_Вх_ОшибкиПроверкиМЧД Из Строки_Вх_ОшибкиПроверкиМЧД Цикл
		
		МассивОшибок = ЗначениеИзСтрокиВнутр(Строка_Вх_ОшибкиПроверкиМЧД.ЗначениеСтрока);
		
		Если МассивОшибок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаОшибок.Добавить();
								  
		ПолныйТекстОшибки = "";
		Для Каждого Ошибка из МассивОшибок Цикл
			
			КодОшибки = Ошибка.Код;
			ТекстОшибки = Ошибка.Текст;
			
			ПолныйТекстОшибки = ПолныйТекстОшибки + " - " + "(" + КодОшибки + ")" + " " + ТекстОшибки + Символы.ПС;
			
		КонецЦикла; 
		
		НоваяСтрока.ТекстОшибки = "Входящая доверенность не прошла проверку по причине:
								  |" + ПолныйТекстОшибки;
								  
		НоваяСтрока.ИмяПоля		= "ВходящаяДоверенность";
		НоваяСтрока.Действие	= "Информация";
		
	КонецЦикла;

КонецПроцедуры

Функция Метки() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтурEDI_ДополнительныеСправочники.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
		|ГДЕ
		|	КонтурEDI_ДополнительныеСправочники.ИмяСправочника = &ИмяСправочника";	
	Запрос.УстановитьПараметр("ИмяСправочника", "Метки");
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

// #КонецОбласти

// #Область Автоотправка_Прайслистов

Функция ИнициализироватьТаблицуНастроекАвтоотправкиПрайслистов() Экспорт
	
	ТаблицаНастроекАвтоотправки = Новый ТаблицаЗначений;
	
	КолонкиТаблицыНастроек = Новый Массив;
	КолонкиТаблицыНастроек.Добавить("НастройкаСсылка");
	КолонкиТаблицыНастроек.Добавить("НаименованиеНастройки");
	КолонкиТаблицыНастроек.Добавить("РасписаниеВключено");
	КолонкиТаблицыНастроек.Добавить("ПараметрыПодготовкиСообщения");
	КолонкиТаблицыНастроек.Добавить("Расписание");
	КолонкиТаблицыНастроек.Добавить("Партнер");
	КолонкиТаблицыНастроек.Добавить("ДатаПоследнейОтправки");
	КолонкиТаблицыНастроек.Добавить("ОтправленУспешно");
	КолонкиТаблицыНастроек.Добавить("СписокОшибок");
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаНастроекАвтоотправки, КолонкиТаблицыНастроек);
	
	Возврат ТаблицаНастроекАвтоотправки;
	
КонецФункции

Процедура СохранитьНастройкиАвтоотправкиПрайслистов(ТаблицаНастроекАвтоотправки) Экспорт
	
	ТекущиеНастройкиАвтоотправки = ПолучитьНастройкиАвтоотправкиПрайслистов();
	
	Для каждого НастройкаАвтоотправки Из ТекущиеНастройкиАвтоотправки Цикл
		
		Если ТаблицаНастроекАвтоотправки.Найти(НастройкаАвтоотправки.НастройкаСсылка, "НастройкаСсылка") = Неопределено Тогда
			УдаленнаяНастройка = НастройкаАвтоотправки.НастройкаСсылка.ПолучитьОбъект();
			УдаленнаяНастройка.УстановитьПометкуУдаления(Истина);
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого НастройкаАвтоотправки Из ТаблицаНастроекАвтоотправки Цикл
		
		СоздатьОбновитьНастройкуАвтоотправкиПрайслистов(НастройкаАвтоотправки.ПараметрыПодготовкиСообщения,
													   НастройкаАвтоотправки.Расписание,
													   НастройкаАвтоотправки.НаименованиеНастройки,
													   НастройкаАвтоотправки.РасписаниеВключено,
													   НастройкаАвтоотправки.Партнер,
													   НастройкаАвтоотправки.НастройкаСсылка);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьНастройкиАвтоотправкиПрайслистов() Экспорт
	
	ТаблицаНастроекАвтоотправки = ИнициализироватьТаблицуНастроекАвтоотправкиПрайслистов();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтурEDI_ДополнительныеСправочники.Ссылка КАК Ссылка,
	               |	КонтурEDI_ДополнительныеСправочники.Наименование КАК Наименование
	               |ПОМЕСТИТЬ НастройкиАвтоотправки
	               |ИЗ
	               |	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
	               |ГДЕ
	               |	КонтурEDI_ДополнительныеСправочники.ИмяСправочника = ""НастройкиАвтоотправкиПрайслистов""
	               |	И КонтурEDI_ДополнительныеСправочники.ПометкаУдаления = ЛОЖЬ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НастройкиАвтоотправки.Ссылка КАК НастройкаСсылка,
	               |	НастройкиАвтоотправки.Наименование КАК НаименованиеНастройки,
	               |	РеквизитРасписаниеВключено.Значение КАК РасписаниеВключено,
	               |	РеквизитРасписание.ЗначениеХранилищеЗначения КАК Расписание,
	               |	РеквизитПараметрыПодготовкиСообщения.ЗначениеХранилищеЗначения КАК ПараметрыПодготовкиСообщения,
	               |	РеквизитПартнер.Значение КАК Партнер,
	               |	ЕстьNULL(РеквизитДатаПоследнейОтправки.Значение, Неопределено) КАК ДатаПоследнейОтправки,
				   |	ЕстьNULL(РеквизитОтправленУспешно.Значение, Истина) КАК ОтправленУспешно,
				   |	РеквизитСписокОшибок.ЗначениеХранилищеЗначения КАК СписокОшибок
	               |ИЗ
	               |	НастройкиАвтоотправки КАК НастройкиАвтоотправки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК РеквизитРасписаниеВключено
	               |		ПО (РеквизитРасписаниеВключено.Ссылка = НастройкиАвтоотправки.Ссылка)
	               |			И (РеквизитРасписаниеВключено.ИмяРеквизита = ""РасписаниеВключено"")
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК РеквизитРасписание
	               |		ПО (РеквизитРасписание.Ссылка = НастройкиАвтоотправки.Ссылка)
	               |			И (РеквизитРасписание.ИмяРеквизита = ""Расписание"")
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК РеквизитПараметрыПодготовкиСообщения
	               |		ПО (РеквизитПараметрыПодготовкиСообщения.Ссылка = НастройкиАвтоотправки.Ссылка)
	               |			И (РеквизитПараметрыПодготовкиСообщения.ИмяРеквизита = ""ПараметрыПодготовкиСообщения"")
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК РеквизитПартнер
	               |		ПО (РеквизитПартнер.Ссылка = НастройкиАвтоотправки.Ссылка)
	               |			И (РеквизитПартнер.ИмяРеквизита = ""Партнер"")
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК РеквизитДатаПоследнейОтправки
	               |		ПО (РеквизитДатаПоследнейОтправки.Ссылка = НастройкиАвтоотправки.Ссылка)
	               |			И (РеквизитДатаПоследнейОтправки.ИмяРеквизита = ""ДатаПоследнейОтправки"")
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК РеквизитОтправленУспешно
	               |		ПО (РеквизитОтправленУспешно.Ссылка = НастройкиАвтоотправки.Ссылка)
	               |			И (РеквизитОтправленУспешно.ИмяРеквизита = ""ОтправленУспешно"")
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК РеквизитСписокОшибок
	               |		ПО (РеквизитСписокОшибок.Ссылка = НастройкиАвтоотправки.Ссылка)
	               |			И (РеквизитСписокОшибок.ИмяРеквизита = ""СписокОшибок"")";
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат ТаблицаНастроекАвтоотправки;
	КонецЕсли;	
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СтрокаНастроек = ТаблицаНастроекАвтоотправки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаНастроек, Выборка);
		
		Если ТипЗнч(Выборка.Расписание) = Тип("ХранилищеЗначения") Тогда
			СтрокаНастроек.Расписание = Выборка.Расписание.Получить();
		КонецЕсли;
		
		Если ТипЗнч(Выборка.ПараметрыПодготовкиСообщения) = Тип("ХранилищеЗначения") Тогда
			СтрокаНастроек.ПараметрыПодготовкиСообщения = Выборка.ПараметрыПодготовкиСообщения.Получить();
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаНастроекАвтоотправки;
	
КонецФункции

Функция СоздатьОбновитьНастройкуАвтоотправкиПрайслистов(ПараметрыОтправкиСообщения, 
													   Расписание, 
													   НаименованиеНастройки,
													   РасписаниеВключено,
													   Партнер,
													   НастройкаСсылка = Неопределено) Экспорт
	
	Если НастройкаСсылка = Неопределено Тогда
		НастройкаОбъект = Справочники.КонтурEDI_ДополнительныеСправочники.СоздатьЭлемент(); 
		НастройкаОбъект.ИмяСправочника = "НастройкиАвтоотправкиПрайслистов";
	Иначе
		НастройкаОбъект = НастройкаСсылка.ПолучитьОбъект();
	КонецЕсли;
	
	НастройкаОбъект.Наименование = НаименованиеНастройки;
	
	РеквизитПараметрыПодготовки = ПолучитьСтрокуРеквизитаДопСправочника_КонтурEDI(НастройкаОбъект, "ПараметрыПодготовкиСообщения");
	РеквизитПараметрыПодготовки.ЗначениеХранилищеЗначения = Новый ХранилищеЗначения(ПараметрыОтправкиСообщения);
	
	РеквизитРасписание = ПолучитьСтрокуРеквизитаДопСправочника_КонтурEDI(НастройкаОбъект, "Расписание");
	РеквизитРасписание.ЗначениеХранилищеЗначения = Новый ХранилищеЗначения(Расписание);
	
	РеквизитРасписаниеВключено = ПолучитьСтрокуРеквизитаДопСправочника_КонтурEDI(НастройкаОбъект, "РасписаниеВключено");
	РеквизитРасписаниеВключено.Значение = РасписаниеВключено = Истина; 
	
	РеквизитПартнер = ПолучитьСтрокуРеквизитаДопСправочника_КонтурEDI(НастройкаОбъект, "Партнер");
	РеквизитПартнер.Значение = Партнер;
	
	НастройкаОбъект.Записать();	
	
	Возврат НастройкаОбъект.Ссылка;
	
КонецФункции

Процедура ОтправитьPRICELISTПоРасписанию() Экспорт
	
	НастройкиАвтоотправкиПрайслистов = ПолучитьНастройкиАвтоотправкиПрайслистов();
	
	Для каждого НастройкаОтправкиПрайслистов Из НастройкиАвтоотправкиПрайслистов Цикл
		
		Если Не НастройкаОтправкиПрайслистов.РасписаниеВключено = Истина Тогда
			Продолжить;
		КонецЕсли;
		                                                      
		РасписаниеОтправки = НастройкаОтправкиПрайслистов.Расписание;
		ДатаПоследнейОтправки = НастройкаОтправкиПрайслистов.ДатаПоследнейОтправки;
		
		Если Не ТипЗнч(РасписаниеОтправки) = Тип("РасписаниеРегламентногоЗадания") Тогда
			Продолжить;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(ДатаПоследнейОтправки) Тогда
			ДатаПоследнейОтправки = Неопределено;
		КонецЕсли;

		Если РасписаниеОтправки.ТребуетсяВыполнение(ТекущаяДатаСеанса(), ДатаПоследнейОтправки, ДатаПоследнейОтправки) Тогда
			
			ПараметрыПодготовкиСообщения = НастройкаОтправкиПрайслистов.ПараметрыПодготовкиСообщения;
			ПараметрыПодготовкиСообщения.Вставить("ПроверитьСообщение", Истина);
			
			ОшибкиОтправки = Новый Массив;
			ОтправленУспешно = Истина;
			
			РезультатПолучения = ПолучитьТоварыДляНезависимогоСообщения("PRICELIST", ПараметрыПодготовкиСообщения);
			
			Если РезультатПолучения.Успешно Тогда
				
				ОтправитьНезависимоеСообщение("PRICELIST", РезультатПолучения.Товары, ПараметрыПодготовкиСообщения);
				
				Если ПараметрыПодготовкиСообщения.Свойство("РезультатПроверкиСообщения") 
					И ПараметрыПодготовкиСообщения.РезультатПроверкиСообщения.Успешно = Ложь Тогда
					
					ОтправленУспешно = Ложь;
					
					Для каждого СтрокаОшибки ИЗ ПараметрыПодготовкиСообщения.РезультатПроверкиСообщения.СписокОшибок Цикл
						ОшибкиОтправки.Добавить(СтрокаОшибки.ТекстОшибки);
					КонецЦикла;
					
				КонецЕсли;
				
			Иначе
				
				ОтправленУспешно = Ложь;
				ОшибкиОтправки.Добавить(РезультатПолучения.ОписаниеОшибки);
				
			КонецЕсли;
			
			НастройкаОтправкиОбъект = НастройкаОтправкиПрайслистов.НастройкаСсылка.ПолучитьОбъект();
			
			РеквизитДатаПоследнейОтправки = ПолучитьСтрокуРеквизитаДопСправочника_КонтурEDI(НастройкаОтправкиОбъект, "ДатаПоследнейОтправки");
			РеквизитДатаПоследнейОтправки.Значение = ТекущаяДатаСеанса();
			
			РеквизитОтправленУспешно = ПолучитьСтрокуРеквизитаДопСправочника_КонтурEDI(НастройкаОтправкиОбъект, "ОтправленУспешно");
			РеквизитОтправленУспешно.Значение = ОтправленУспешно;
			
			РеквизитСписокОшибок = ПолучитьСтрокуРеквизитаДопСправочника_КонтурEDI(НастройкаОтправкиОбъект, "СписокОшибок");
			РеквизитСписокОшибок.ЗначениеХранилищеЗначения = Новый ХранилищеЗначения(ОшибкиОтправки);
			
			НастройкаОтправкиОбъект.Записать();
			
		КонецЕсли;
		
	КонецЦикла;
	
	ПараметрыОбмена = ПараметрыОбменаССервером();
	ПараметрыОбмена.Вставить("ЭтоФоновоеЗадание", Истина);
	ПараметрыВыполнения = Новый Структура("ВОтдельномФоновомЗадании, ПараметрыОбмена", ФоновыеЗаданияКонтурEDI_Доступны(), ПараметрыОбмена);
	ОперацииОбмена_ЗапуститьОперацию("ОперацииОбмена_ОтправитьСообщенияОжидающиеОтправки", ПараметрыВыполнения);
	
КонецПроцедуры

// #КонецОбласти

// #Область Сборка_Разборка_Запросов
	
Функция ПолучитьТаблицуДляСборкиЗапросов(РежимРаботы) Экспорт
	
	//1. Для начала вытащим из шаблона запроса часть, содержащую соединения	
	
	//и все это нам надо кинуть еще и в таблицу типов
	Если РежимРаботы = "Поставщик" Тогда
		ИсходныйТекстЗапроса = ШаблонЗапросаЦепочкиДокументов_Поставщик;
	ИначеЕсли РежимРаботы = "Покупатель" Тогда
		ИсходныйТекстЗапроса = ШаблонЗапросаЦепочкиДокументов_Покупатель;
	КонецЕсли;	
	
	//удастся ли из верхней части вытащить соответствие типов документов сообщениям?
	//без нижней части не получится.
	//конструкции вида <ПсевдонимТаблицы>.Ссылка как <ТипСообщения> и будут ключом
	//надо обновить ТаблицаТипов. Сделаем это здесь или отдельно?
	
	
	ПозицияНачалаСоединений = Найти(ИсходныйТекстЗапроса,"{ПОЛНОЕ СОЕДИНЕНИЕ");
	//найдем позицию: до нее все будет неизменным,
	//после - соединения и условия
	//соединения надо перетасовать
	//условия - кинуть так же, как начало
	ТекстНачалаЗапроса = Лев(ИсходныйТекстЗапроса,ПозицияНачалаСоединений-1);
	
	ТекстОстаткаЗапроса = Сред(ИсходныйТекстЗапроса,ПозицияНачалаСоединений);
	
	ПозицияНачалаУсловий = СтрДлина(ТекстОстаткаЗапроса);//все до этой позиции будет перетасовано
	
	ТекстСоединений = Лев(ТекстОстаткаЗапроса,ПозицияНачалаУсловий);//тасовать будем именно это
	
	//2. Теперь приступим к формированию таблицы
	
	ТаблицаСоединенийДокументов = Новый ТаблицаЗначений;
	ТаблицаСоединенийДокументов.Колонки.Добавить("ИмяТаблицы",ОписаниеТипаСтрока_КонтурEDI());
	ТаблицаСоединенийДокументов.Колонки.Добавить("ПсевдонимТаблицы",ОписаниеТипаСтрока_КонтурEDI());
	ТаблицаСоединенийДокументов.Колонки.Добавить("СоединениеСоСледующейТаблицей",ОписаниеТипаСтрока_КонтурEDI());
	ТаблицаСоединенийДокументов.Колонки.Добавить("ТипДокумента",ОписаниеТипаСтрока_КонтурEDI());//тип в виде строки вроде "ЗаказПоставщику"
	
	
	ЧислоТаблиц = СтрЧислоВхождений(ТекстСоединений,"{");
	
	Для Сч=1 По ЧислоТаблиц Цикл
		
		РазбираемыйКусок = ТекстСоединений;
		
		//1. найти последнюю открывающую скобку
		Для сч2 = 0 по ЧислоТаблиц-Сч Цикл
			ПозицияОткрывающейСкобки = Найти(РазбираемыйКусок,"{");
			РазбираемыйКусок = Сред(РазбираемыйКусок,ПозицияОткрывающейСкобки+1);
		КонецЦикла;	
		
		ПозицияЗакрывающейСкобки = Найти(РазбираемыйКусок,"}");
		РазбираемыйКусок = Лев(РазбираемыйКусок,ПозицияЗакрывающейСкобки-1);
		//Сообщить(РазбираемыйКусок);
			  
		ТекстСоединений = СтрЗаменить(ТекстСоединений,"{"+РазбираемыйКусок+"}","");//вырежем то, что разобрали, из запроса
		
		РазбираемыйКусок = СтрЗаменить(РазбираемыйКусок,Символы.ПС," ");//для корректного поиска ниже
		РазбираемыйКусок = СтрЗаменить(РазбираемыйКусок,Символы.Таб," ");//для корректного поиска ниже
		ПозицияСловаСоединение = Найти(РазбираемыйКусок," СОЕДИНЕНИЕ ");
		ПозицияСловаКак = Найти(РазбираемыйКусок," КАК ");
		ПозицияСловаПо = Найти(РазбираемыйКусок," ПО ");
		
		НовСтрокаТаблицы = ТаблицаСоединенийДокументов.Добавить();
		
		НовСтрокаТаблицы.ИмяТаблицы = СокрЛП(Сред(РазбираемыйКусок,ПозицияСловаСоединение+11,ПозицияСловаКак - ПозицияСловаСоединение - 11));
		
		//в псевдоним взять название объекта в метаданных     
		НовСтрокаТаблицы.ПсевдонимТаблицы = СокрЛП(Сред(РазбираемыйКусок,ПозицияСловаКак+4,ПозицияСловаПо - ПозицияСловаКак - 4));
		НовСтрокаТаблицы.ТипДокумента = СтрЗаменить(НовСтрокаТаблицы.ИмяТаблицы,"Документ.","");
		ПозицияТочки = Найти(НовСтрокаТаблицы.ТипДокумента,".");
		Если ПозицияТочки<>0 Тогда
			НовСтрокаТаблицы.ТипДокумента = Лев(НовСтрокаТаблицы.ТипДокумента,ПозицияТочки-1);
		КонецЕсли;	
		
		НовСтрокаТаблицы.СоединениеСоСледующейТаблицей = СокрЛП(Сред(РазбираемыйКусок,ПозицияСловаПо+3));
		
	КонецЦикла;	
	
	Возврат ТаблицаСоединенийДокументов;
КонецФункции	


//используется в построении списков документов и в поиске связанных сообщений по документам
Функция ПолучитьТекстЗапросаДляТаблицы(ИмяТаблицы, ТаблицаСоединенийДокументов, НазначениеЗапроса)
	
	//у нас тут самопальный построитель с преферансом и барышнями
	
	//работает в 2 режимах: 
	//	1. НазначениеЗапроса = "ПостроениеСписка" - для вывода списка требуемых действий
	//	2. НазначениеЗапроса = "СвязанныеСообщения" - для просмотра связанных сообщений и навигации по цепочке документов/сообщений
	
	ПараметрыПМ = Новый Структура(	"ИмяТаблицы,	ТаблицаСоединенийДокументов,	НазначениеЗапроса",
									ИмяТаблицы,		ТаблицаСоединенийДокументов,	НазначениеЗапроса);
									
	//предусмотрим возможность полностью переопределить данные запросы, актуально для Астора
	//и других конфигураций, где для связи документов друг с другом используются вспомогательные таблицы (РС, РН и т.д.)
	СтандартнаяОбработка = Истина;
	ПолныйТекстЗапроса = ОбработкаСобытияПодключаемогоМодуля("ПолучитьТекстЗапросаДляТаблицы",СтандартнаяОбработка,ПараметрыПМ);
	Если Не СтандартнаяОбработка Тогда
		Возврат ПолныйТекстЗапроса;
	КонецЕсли;
	
	ТекущаяСтрокаТаблицы = ТаблицаСоединенийДокументов.Найти(ИмяТаблицы,"ПсевдонимТаблицы");
	
	ПоляВПредыдущемДокументе = (ИмяКонфигурации1С = "УТ_10_2" и Лев(ТекущаяСтрокаТаблицы.ПсевдонимТаблицы,11)="СчетФактура") 
							или (ИмяКонфигурации1С = "УФ_УТ" и ТекущаяСтрокаТаблицы.ПсевдонимТаблицы = "СчетФактураВыданный")
							или (ИмяКонфигурации1С = "УФ_УТ" и ТекущаяСтрокаТаблицы.ПсевдонимТаблицы = "СчетФактураПолученныйДокументыОснования")
							ИЛИ (ИмяКонфигурации1С = "УФ_ДалионТРЕНД" и ТекущаяСтрокаТаблицы.ПсевдонимТаблицы = "СчетФактура");
							//костыль для УТ 10.2 и УФ_УТ: в документе СчетФактураВыданный и СчетФактура иногда нет контрагентов, сумм и т.д.
	
	ТекстПолей = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|";

	ТекстПолей = ТекстПолей+"	"+ТекущаяСтрокаТаблицы.ПсевдонимТаблицы+".Ссылка КАК Док_"+ТекущаяСтрокаТаблицы.ТипДокумента;
	
	ТекстТаблицСоединений = Символы.ПС+"ИЗ"+Символы.ПС+"	"+ТекущаяСтрокаТаблицы.ИмяТаблицы+" КАК "+ТекущаяСтрокаТаблицы.ПсевдонимТаблицы;
	ТекстУсловий = Символы.ПС+"ГДЕ"+Символы.ПС+"	Истина";//на будущее, пока не надо
	ТекстИндексов = "";
	
	СоединениеЧерезСсылку = (СтрЧислоВхождений(ТекущаяСтрокаТаблицы.ИмяТаблицы,".")>1);//в этом случае основные поля - Контрагент,СуммаДокумента,Проведен - находятся в шапке документа.
	
	//добавим связь с таблицей партнеров
	Если НазначениеЗапроса = "СвязанныеСообщения" Тогда//запрос для связанных сообщений
		
		ТекстУсловий = ТекстУсловий+"
		|	И "+ТекущаяСтрокаТаблицы.ПсевдонимТаблицы+".Ссылка В (&Ссылка)";
		
	ИначеЕсли НазначениеЗапроса = "ПостроениеСписка" Тогда
		
		ТекстПолей = ТекстПолей + ",
		|	ТаблицаКэшПартнеровКонтрагентов.Партнер,
		|	ТаблицаКэшПартнеровКонтрагентов.PORDERS,
		|	ТаблицаКэшПартнеровКонтрагентов.ORDERS,
		|	ТаблицаКэшПартнеровКонтрагентов.ORDRSP,
		|	ТаблицаКэшПартнеровКонтрагентов.DESADV,
		|	ТаблицаКэшПартнеровКонтрагентов.RECADV,
		|	ТаблицаКэшПартнеровКонтрагентов.INVOIC,
		|	"""" КАК СообщениеБлокирующееPORDERS,
		|	ТаблицаКэшПартнеровКонтрагентов.СообщениеБлокирующееORDERS,
		|	ТаблицаКэшПартнеровКонтрагентов.СообщениеБлокирующееORDRSP,
		|	ТаблицаКэшПартнеровКонтрагентов.СообщениеБлокирующееDESADV,
		|	ТаблицаКэшПартнеровКонтрагентов.СообщениеБлокирующееRECADV,
		|	ТаблицаКэшПартнеровКонтрагентов.СообщениеПредыдущееINVOIC,
		|	ТаблицаКэшПартнеровКонтрагентов.СообщениеБлокирующееINVOIC,
		|	ТаблицаКэшПартнеровКонтрагентов.INVOICНеБлокируетсяПредыдущимиСообщениями";
			
		ИмяРеквизитаСуммаДокумента = "";
		Для Каждого _ВариантИмени Из EDI_РазложитьСтрокуВМассивСлов("СуммаДокумента,ИтогоВсего,ИтогоСумма",",") Цикл
			Если НЕ Метаданные.Документы[ТекущаяСтрокаТаблицы.ТипДокумента].Реквизиты.Найти(_ВариантИмени) = Неопределено Тогда
				ИмяРеквизитаСуммаДокумента = _ВариантИмени;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ИспользоватьМаппингМетаданных Тогда
			ИмяРеквизитаВМаппинге = ПолучитьИмяРеквизитаПоИдентификаторуОбъектаМетаданных(ТекущаяСтрокаТаблицы.ТипДокумента, "СуммаДокумента");
			Если ИмяРеквизитаВМаппинге <> Неопределено Тогда
				ИмяРеквизитаСуммаДокумента = ИмяРеквизитаВМаппинге;	
			КонецЕсли;
		КонецЕсли;
		
		Если ИмяКонфигурации1С = "ШтрихМ_РС" И ТекущаяСтрокаТаблицы.ПсевдонимТаблицы = "ПриходнаяНакладная" Тогда
			ИмяРеквизитаСуммаДокумента = "СуммаДокументаПрих";
		ИначеЕсли ИмяКонфигурации1С = "ШтрихМ_РС" И ТекущаяСтрокаТаблицы.ПсевдонимТаблицы = "СчетФактураПолученный" Тогда
			ИмяРеквизитаСуммаДокумента = "Сумма";
		КонецЕсли;
		
		Если СоединениеЧерезСсылку Тогда
			
			ПсевдонимШапки = ТекущаяСтрокаТаблицы.ТипДокумента+"_Шапка";
			
			ТекстПолей = ТекстПолей + ",
			|	"+ТекущаяСтрокаТаблицы.ПсевдонимТаблицы+".Ссылка.Проведен КАК Док_Проведен,
			|	";
			Если ИмяКонфигурации1С = "УФ_УТ" и ТекущаяСтрокаТаблицы.ПсевдонимТаблицы = "СчетФактураПолученныйДокументыОснования" Тогда
				ТекстПолей = ТекстПолей + ТекущаяСтрокаТаблицы.ПсевдонимТаблицы+".ДокументОснование.СуммаДокумента КАК СуммаДокумента";//В УТ11 поле "СуммаДокумента" отсутствует в счет-фактуре.
			Иначе
				ТекстПолей = ТекстПолей + ?(ЗначениеЗаполнено(ИмяРеквизитаСуммаДокумента), ПсевдонимШапки + "." + ИмяРеквизитаСуммаДокумента, "0") + " КАК СуммаДокумента";
			КонецЕсли;
			
			ТекстТаблицСоединений = ТекстТаблицСоединений+"
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ."+ТекущаяСтрокаТаблицы.ТипДокумента+" КАК "+ПсевдонимШапки+"
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаКэшПартнеровКонтрагентов КАК ТаблицаКэшПартнеровКонтрагентов
			|			ПО (ТаблицаКэшПартнеровКонтрагентов.Контрагент = "+ПсевдонимШапки+".Контрагент)
			|		По ("+ТекущаяСтрокаТаблицы.ПсевдонимТаблицы+".Ссылка = "+ПсевдонимШапки+".Ссылка)";
			
			ТекстУсловий = ТекстУсловий+"
			|	И "+ПсевдонимШапки+".Дата МЕЖДУ &НачалоПериода И &КонецПериода
			|	И НЕ "+ПсевдонимШапки+".ПометкаУдаления";//здесь возможна ветка для УФ
			
		Иначе	
			ТекстПолей = ТекстПолей + ",
			|	"+ТекущаяСтрокаТаблицы.ПсевдонимТаблицы+".Проведен КАК Док_Проведен,
			|	"
			
			//костыль для УТ 10.2 и УФ_УТ
			+?(ПоляВПредыдущемДокументе,
				ТекущаяСтрокаТаблицы.ПсевдонимТаблицы+".ДокументОснование.СуммаДокумента КАК СуммаДокумента",
				?(ЗначениеЗаполнено(ИмяРеквизитаСуммаДокумента), ТекущаяСтрокаТаблицы.ПсевдонимТаблицы + "." + ИмяРеквизитаСуммаДокумента, "0") + " КАК СуммаДокумента"
				);
				
			ТекстТаблицСоединений = ТекстТаблицСоединений+"
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаКэшПартнеровКонтрагентов КАК ТаблицаКэшПартнеровКонтрагентов"
			
			+?(ПоляВПредыдущемДокументе,
				"
				|		ПО (ТаблицаКэшПартнеровКонтрагентов.Контрагент = "+ТекущаяСтрокаТаблицы.ПсевдонимТаблицы+".ДокументОснование.Контрагент)"
				,
				"
				|		ПО (ТаблицаКэшПартнеровКонтрагентов.Контрагент = "+ТекущаяСтрокаТаблицы.ПсевдонимТаблицы+".Контрагент)"
			);
			
			
			ТекстУсловий = ТекстУсловий+"
			|	И "+ТекущаяСтрокаТаблицы.ПсевдонимТаблицы+".Дата МЕЖДУ &НачалоПериода И &КонецПериода
			|	И НЕ "+ТекущаяСтрокаТаблицы.ПсевдонимТаблицы+".ПометкаУдаления";
			
				
		КонецЕсли;	
		
		ТекстИндексов = "
		|ИНДЕКСИРОВАТЬ ПО
		|	Док_"+ТекущаяСтрокаТаблицы.ТипДокумента;
		
	КонецЕсли;	
	
	
	//в будущем можно продумать оптимизацию, когда у нас одна таблица ссылается на другую явно
	
	//теперь заполним область соединений документов
	//1. Сначала пройдемся вверх, чтобы получить предыдущие документы
	
	ИндексТекущейСтроки = ТаблицаСоединенийДокументов.Индекс(ТекущаяСтрокаТаблицы);
	Для Сч = 1 По ИндексТекущейСтроки Цикл //текущую строку не берем
		ДобавляемаяСтрока = ТаблицаСоединенийДокументов[ИндексТекущейСтроки-Сч];
		
		ТекстПолей = ТекстПолей + ", 
			|	" + ДобавляемаяСтрока.ПсевдонимТаблицы + ".Ссылка КАК Док_" + ДобавляемаяСтрока.ТипДокумента;
		
		//К сожалению придется оставить здесь костыль который бы требовал от СФ обязательного наличия родительского РТУ 
		//(если он предусмотрен) т.к. нельзя случайно принять за INVOIC СФ, например, на корректировку реализации
		Если Лев(ТекущаяСтрокаТаблицы.ТипДокумента,5) = "СчетФ" И 
			(ДобавляемаяСтрока.ПсевдонимТаблицы = "докРеализацияТоваровУслуг"
			ИЛИ ДобавляемаяСтрока.ПсевдонимТаблицы = "РеализацияТоваровУслуг")Тогда 
			ТекстУсловий = ТекстУсловий+"
				|	И ВЫРАЗИТЬ("+ДобавляемаяСтрока.ПсевдонимТаблицы+".Ссылка КАК Документ."+ДобавляемаяСтрока.ТипДокумента+") ЕСТЬ НЕ NULL";
		Конецесли;
		
		ТекстТаблицСоединений = ТекстТаблицСоединений + "
			|		ЛЕВОЕ СОЕДИНЕНИЕ " + ДобавляемаяСтрока.ИмяТаблицы + " КАК " + ДобавляемаяСтрока.ПсевдонимТаблицы + "
			|		ПО " + ДобавляемаяСтрока.СоединениеСоСледующейТаблицей;
			
		Если НазначениеЗапроса = "ПостроениеСписка" Тогда
			
			ТекстИндексов = ТекстИндексов + ",
				|	Док_"+ДобавляемаяСтрока.ТипДокумента;
			
			ТекстУсловий = ТекстУсловий + "
				|	И НЕ ЕСТЬNULL(" + ДобавляемаяСтрока.ПсевдонимТаблицы + ".ПометкаУдаления, Ложь)";
		Иначе
			
			ТекстТаблицСоединений = ТекстТаблицСоединений + "
				|	И НЕ ЕСТЬNULL(" + ДобавляемаяСтрока.ПсевдонимТаблицы + ".ПометкаУдаления, Ложь)";
			
		КонецЕсли;
		
	КонецЦикла;	
	
	//2. Потом вниз - на одну позицию или до конца, чтобы получить следующие документы
	//на одну позицию - для того, чтобы получить запрос, который покажет по каждой цепочке документов, какие следующие документы еще не созданы
	//Например, есть ЗаказПокупателя, но нет Реализации
	//или есть Реализация, но нет СчетФактуры
	//ДобавлятьВсеТаблицы = Истина - для функции НайтиСвязанныеСообщения
	//Для остальных ДобавлятьВсеТаблицы = Ложь
	
	ПредыдущаяСтрока = ТекущаяСтрокаТаблицы;
	Для Сч = ИндексТекущейСтроки + 1 По ТаблицаСоединенийДокументов.Количество() - 1 Цикл //текущую строку не берем
		
		ДобавляемаяСтрока = ТаблицаСоединенийДокументов[Сч];
		
		ТекущееСоединениеЧерезСсылку = (СтрЧислоВхождений(ДобавляемаяСтрока.ИмяТаблицы,".")>1);
		
		ТекстПолей = ТекстПолей + ", 
			|	" + ДобавляемаяСтрока.ПсевдонимТаблицы + ".Ссылка КАК Док_" + ДобавляемаяСтрока.ТипДокумента;
			
		ТекстТаблицСоединений = ТекстТаблицСоединений + "
			|		ЛЕВОЕ СОЕДИНЕНИЕ " + ДобавляемаяСтрока.ИмяТаблицы + " КАК " + ДобавляемаяСтрока.ПсевдонимТаблицы + "
			|		ПО " + ПредыдущаяСтрока.СоединениеСоСледующейТаблицей;
		
		Если ТекущееСоединениеЧерезСсылку Тогда
			ТекстТаблицСоединений = ТекстТаблицСоединений + "
			|			И НЕ " + ДобавляемаяСтрока.ПсевдонимТаблицы + ".Ссылка.ПометкаУдаления";
		Иначе
			ТекстТаблицСоединений = ТекстТаблицСоединений + "
			|			И НЕ " + ДобавляемаяСтрока.ПсевдонимТаблицы + ".ПометкаУдаления";
		КонецЕсли;
			
		ПредыдущаяСтрока = ДобавляемаяСтрока;
		Если НазначениеЗапроса = "ПостроениеСписка" Тогда
			Прервать;//нам требуется только один документ вперед в цепочке
		КонецЕсли;	
		
	КонецЦикла;	
	
	Если НазначениеЗапроса = "ПостроениеСписка" Тогда
		ТекстПолей = ТекстПолей+"
		|	Поместить ВТ_"+ТекущаяСтрокаТаблицы.ТипДокумента;
	КонецЕсли;	
	
	ПолныйТекстЗапроса = ТекстПолей+ТекстТаблицСоединений+ТекстУсловий+ТекстИндексов;
	
	ОбработатьПодменыДляКонфигурации_КонтурEDI(ПолныйТекстЗапроса);
	
	Возврат ПолныйТекстЗапроса;
	
	//на выходе получаем текст запроса вроде
	
	//"ВЫБРАТЬ РАЗРЕШЕННЫЕ            
	//|	Документы.Ссылка КАК Заказ,
	//|	Документы.Проведен КАК Заказ_Проведен,
	//|	ТаблицаКэшПартнеровКонтрагентов.Партнер КАК Партнер,
	//|	ТаблицаКэшПартнеровКонтрагентов.PORDERS,
	//|	ТаблицаКэшПартнеровКонтрагентов.ORDERS,
	//|	ТаблицаКэшПартнеровКонтрагентов.ORDRSP,
	//|	ТаблицаКэшПартнеровКонтрагентов.DESADV,
	//|	ТаблицаКэшПартнеровКонтрагентов.RECADV,
	//|	ТаблицаКэшПартнеровКонтрагентов.INVOIC,
	//|	ТаблицаКэшПартнеровКонтрагентов.INVOICДоОбработкиRECADV,
	//|	ТаблицаКэшПартнеровКонтрагентов.СообщениеБлокирующееORDERS,
	//|	ТаблицаКэшПартнеровКонтрагентов.СообщениеБлокирующееORDRSP,
	//|	ТаблицаКэшПартнеровКонтрагентов.СообщениеБлокирующееDESADV,
	//|	ТаблицаКэшПартнеровКонтрагентов.СообщениеБлокирующееRECADV,
	//|	ТаблицаКэшПартнеровКонтрагентов.СообщениеБлокирующееINVOIC,
	//|	Документы.СуммаДокумента КАК СуммаДокумента,
	//|	РеализацияТоваровУслуг.Ссылка КАК Реализация
	//|ПОМЕСТИТЬ ВТДокументы_ЗаказПокупателя
	//|ИЗ
	//|	Документ.ЗаказПокупателя КАК Документы
	//|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаКэшПартнеровКонтрагентов КАК ТаблицаКэшПартнеровКонтрагентов
	//|		ПО (ТаблицаКэшПартнеровКонтрагентов.Контрагент = Документы.Контрагент)
	//|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	//|		ПО РеализацияТоваровУслуг.Сделка = Документы.Ссылка
	//|ГДЕ
	//|	Документы.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	//|	И НЕ Документы.ПометкаУдаления
	//|	И &Условия
	//|
	//|ИНДЕКСИРОВАТЬ ПО
	//|	Документы.Ссылка,
	//|	Партнер";
	
КонецФункции	

//по возвратам пока будет отдельно и не на основании шаблонов, а по таблице типов
Функция ПолучитьТекстЗапросаДляТаблицыВозврата(ТипДокумента, ТаблицаСоединенийДокументов = Неопределено, НазначениеЗапроса)
	
	ПараметрыПМ = Новый Структура(	"ИмяТаблицы,	ТаблицаСоединенийДокументов,	НазначениеЗапроса, ТаблицаВозврата",
									ТипДокумента,	ТаблицаСоединенийДокументов,	НазначениеЗапроса, Истина);
									
	//предусмотрим возможность полностью переопределить данные запросы
	//и других конфигураций, где для связи документов друг с другом используются вспомогательные таблицы (РС, РН и т.д.)
	СтандартнаяОбработка = Истина;
	ПолныйТекстЗапроса = ОбработкаСобытияПодключаемогоМодуля("ПолучитьТекстЗапросаДляТаблицы", СтандартнаяОбработка, ПараметрыПМ);
	Если Не СтандартнаяОбработка Тогда
		Возврат ПолныйТекстЗапроса;
	КонецЕсли;
	
	ПолныйТекстЗапроса = "";
	
	Если НазначениеЗапроса = "ПостроениеСписка" Тогда
		
		ПсевдонимТаблицы = "док" + ТипДокумента;
		
	 	ПолныйТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	докВозврат.Ссылка КАК Док_Возврат,
		|	докВозврат.Проведен КАК Док_Проведен,
		|	ТаблицаКэшПартнеровКонтрагентов.Партнер,
		|   ТаблицаКэшПартнеровКонтрагентов.PORDERS,
		|   ТаблицаКэшПартнеровКонтрагентов.ORDERS,
		|	ТаблицаКэшПартнеровКонтрагентов.ORDRSP,
		|	ТаблицаКэшПартнеровКонтрагентов.DESADV,
		|	ТаблицаКэшПартнеровКонтрагентов.RECADV,
		|	ТаблицаКэшПартнеровКонтрагентов.INVOIC,
		|	ТаблицаКэшПартнеровКонтрагентов.RETANN,
		|	ТаблицаКэшПартнеровКонтрагентов.RETINS,
		|	ТаблицаКэшПартнеровКонтрагентов.RETDES,
		|	ТаблицаКэшПартнеровКонтрагентов.RETREC,
		|	ТаблицаКэшПартнеровКонтрагентов.СообщениеБлокирующееRETANN,
		|	ТаблицаКэшПартнеровКонтрагентов.СообщениеБлокирующееRETINS,
		|	ТаблицаКэшПартнеровКонтрагентов.СообщениеБлокирующееRETDES,
		|	ТаблицаКэшПартнеровКонтрагентов.СообщениеБлокирующееRETREC,
		|	докВозврат.СуммаДокумента КАК СуммаДокумента
		|ПОМЕСТИТЬ ВТ_ТипДокументаВозврата
		|ИЗ
		|	Документ.Возврат КАК докВозврат
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаКэшПартнеровКонтрагентов КАК ТаблицаКэшПартнеровКонтрагентов
		|		ПО (ТаблицаКэшПартнеровКонтрагентов.Контрагент = докВозврат.Контрагент)
		|ГДЕ
		|	докВозврат.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И НЕ докВозврат.ПометкаУдаления
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Док_Возврат";	
		
		ИмяРеквизитаСуммаДокумента = "";
		Для Каждого _ВариантИмени Из EDI_РазложитьСтрокуВМассивСлов("СуммаДокумента,ИтогоВсего,ИтогоСумма",",") Цикл
			Если НЕ Метаданные.Документы[ТипДокумента].Реквизиты.Найти(_ВариантИмени) = Неопределено Тогда
				ИмяРеквизитаСуммаДокумента = _ВариантИмени;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ИспользоватьМаппингМетаданных Тогда
			ИмяРеквизитаВМаппинге = ПолучитьИмяРеквизитаПоИдентификаторуОбъектаМетаданных(ТипДокумента, "СуммаДокумента");
			Если ИмяРеквизитаВМаппинге <> Неопределено Тогда
				ИмяРеквизитаСуммаДокумента = ИмяРеквизитаВМаппинге;	
			КонецЕсли;
		КонецЕсли;
		
		ПолныйТекстЗапроса = СтрЗаменить(ПолныйТекстЗапроса, "докВозврат.СуммаДокумента", ?(ЗначениеЗаполнено(ИмяРеквизитаСуммаДокумента), "докВозврат." + ИмяРеквизитаСуммаДокумента, "0"));
		ПолныйТекстЗапроса = СтрЗаменить(ПолныйТекстЗапроса, "Документ.Возврат", "Документ." + ТипДокумента);
		ПолныйТекстЗапроса = СтрЗаменить(ПолныйТекстЗапроса, "ПОМЕСТИТЬ ВТ_ТипДокументаВозврата", "ПОМЕСТИТЬ ВТ_" + ТипДокумента);
		ПолныйТекстЗапроса = СтрЗаменить(ПолныйТекстЗапроса, "Док_Возврат", "Док_" + ТипДокумента);
		
	КонецЕсли;
	
	Возврат ПолныйТекстЗапроса;
	
КонецФункции

