Функция ПолучитьВеткуСКДИзШаблонаЗапросов(ГдеПолучитьВетку = Неопределено) Экспорт
	
	// Метод ищет ветку шаблона запросов. Возвращает ВеткаШаблонаЗапросов: ветка из скд (НаборДанныхОбъединениеСхемыКомпоновкиДанных) или Неопределено.
	// На вход может передаваться "ГдеПолучитьВетку": макет на сервере , макет обработки или макет в подключаемом модуле 
	// 		ГдеПолучитьВетку - структура с одним или несколькими ключами: "МакетССервера", "МакетОбработки", "ВнешнийМодуль";
	// Если не передано "ГдеПолучитьВетку", то нужно искать везде и возвращать более приоритетную ветку.
	// Приоритет: макет в подключаемом модуле, макет обработки. Макет с сервера пока не используем (сложности с поддержкой).
	
	ВеткаШаблонаЗапросов	= Неопределено; // Метод возвращает значение этой переменной
		
	МестаПоискаВетки_УпорядоченныеПоПриотритету = Новый Массив;
	
	Если ТипЗнч(ГдеПолучитьВетку) = Тип("Структура") Тогда
		Если ГдеПолучитьВетку.Свойство("ВнешнийМодуль") Тогда
			МестаПоискаВетки_УпорядоченныеПоПриотритету.Добавить("ВнешнийМодуль");
		КонецЕсли;
		Если ГдеПолучитьВетку.Свойство("МакетОбработки") Тогда
			МестаПоискаВетки_УпорядоченныеПоПриотритету.Добавить("МакетОбработки");
		КонецЕсли;
	Иначе
		МестаПоискаВетки_УпорядоченныеПоПриотритету.Добавить("ВнешнийМодуль");
		МестаПоискаВетки_УпорядоченныеПоПриотритету.Добавить("МакетОбработки");
	КонецЕсли;  	  	
	
	Для Каждого МестоПоиска Из МестаПоискаВетки_УпорядоченныеПоПриотритету Цикл
		
		Кэшировать = Ложь;
		ИскатьНаСервере 		= Ложь; // МестоПоиска = "МакетССервера";
		ИскатьВОсновномМодуле 	= МестоПоиска = "МакетОбработки";
		ИскатьВоВнешнемМодуле 	= МестоПоиска = "ВнешнийМодуль";
		
		ШаблоныЗапросовСКД_КонтурEDI = ПолучитьМакет_КонтурEDI("ШаблоныЗапросов", "xml", Кэшировать, ИскатьНаСервере, ИскатьВОсновномМодуле, ИскатьВоВнешнемМодуле);
		
		Если НЕ ШаблоныЗапросовСКД_КонтурEDI = Неопределено Тогда
			
			Если МестоПоиска = "ВнешнийМодуль" Тогда
				_ИмяКонфигурации = "ПодключаемыйМодуль";
			Иначе
				_ИмяКонфигурации = ПолучитьИмяКонфигурацииДляЗапроса();
			КонецЕсли;
			
			Если ТипЗнч(_ИмяКонфигурации) <> Тип("Строка") Тогда
				Продолжить;
			КонецЕсли;
			
			// Пытаемся найти ветку по имени конфигурации. Имя конфигурации для запроса (например, "БП_16"), либо "ПодключаемыйМодуль".
			ВеткаШаблонаЗапросов = ШаблоныЗапросовСКД_КонтурEDI.НаборыДанных.Найти(_ИмяКонфигурации);
			Если ВеткаШаблонаЗапросов <> Неопределено Тогда
				Прервать;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;

	Возврат ВеткаШаблонаЗапросов;	
	
КонецФункции  

