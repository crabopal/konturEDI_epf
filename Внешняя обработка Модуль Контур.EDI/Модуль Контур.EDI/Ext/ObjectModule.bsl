Функция Диагностика_ПодготовитьДанныеЦепочкиДокументаСообщения(ДокументСсылка, Сообщение = Неопределено) Экспорт
	
	Перем ПартнерEDI;
	
	Диагностика_МенеджерНастроек();
	
	ПартнерEDI = ОпределитьПартнераИзСообщенияИлиДокумента(Сообщение, ДокументСсылка);
	
	Если НЕ ПартнерEDI = Неопределено Тогда	
		Диагностика_ЗаписатьНастройкиСоответствийПартнераВФайлы(ПартнерEDI);
	Иначе
		Диагностика_ЗаписатьДанныеТаблицыКэшПартнеровКонтрагентовВФайл();	
	КонецЕсли;	
	
	Диагностика_ЗаписатьДанныеСообщенияEDIВФайлы(Сообщение);
	
	Диагностика_ЗаписатьДанныеСвязанныхСообщенийВФайлы(ДокументСсылка);
	
	Результат = Диагностика_СоздатьАрхивДанныхДляДиагностики();
	
	ЭДО_Кэш_Очистить("Диагностика_МенеджерНастроек");
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти

// #Область Служебный_интерфейс

Функция Диагностика_НовыйМенеджерНастроек()
	
	МенеджерНастроек = Новый Структура;
	
    МенеджерНастроек.Вставить("ОписаниеТиповДокументыСправочники");
	МенеджерНастроек.Вставить("КаталогДиагностики");	
	МенеджерНастроек.Вставить("МакетТабличныйДокумент");
	МенеджерНастроек.Вставить("ТипыСправочниковБезРеквизитов");
	МенеджерНастроек.Вставить("ТипИсходящийКСФ");
	МенеджерНастроек.Вставить("ТипДокументаСчетФактура");
	МенеджерНастроек.Вставить("НовыйПараметрыВыводаТаблицы");
	МенеджерНастроек.Вставить("ОписаниеИменРеквизитовДокумента");
	МенеджерНастроек.Вставить("ПодстрокиИменСвойствОбъекта");
	МенеджерНастроек.Вставить("ИменаТабЧастейДокументовКВыгрузке");
		
	Возврат МенеджерНастроек;
	
КонецФункции

Функция Диагностика_МенеджерНастроек()
	
	МенеджерНастроек = ЭДО_Кэш_Прочитать("Диагностика_МенеджерНастроек");
	
	Если МенеджерНастроек = Неопределено Тогда

		МенеджерНастроек = Диагностика_НовыйМенеджерНастроек();
		
		МенеджерНастроек.КаталогДиагностики					= Диагностика_СоздатьКаталогДиагностики();
		МенеджерНастроек.ОписаниеТиповДокументыСправочники	= Диагностика_ОписаниеТиповДокументыСправочники();		
		МенеджерНастроек.МакетТабличныйДокумент				= Диагностика_ПодготовитьМакетТабличныйДокумент();
 		МенеджерНастроек.ТипыСправочниковБезРеквизитов		= Диагностика_ОписаниеТиповСправочниковБезРеквизитов();
		МенеджерНастроек.ТипИсходящийКСФ 					= ПолучитьТипЗначенияОбъекта("ИсходящийКСФ");
		МенеджерНастроек.ТипДокументаСчетФактура			= ПолучитьТипЗначенияОбъекта("ТипДокументаСчетФактура");
		МенеджерНастроек.НовыйПараметрыВыводаТаблицы		= Диагностика_НовыйПараметрыВыводаТаблицы();
		МенеджерНастроек.ОписаниеИменРеквизитовДокумента    = Диагностика_ОписаниеИменРеквизитовДокумента();
		МенеджерНастроек.ПодстрокиИменСвойствОбъекта		= Диагностика_ПодстрокиИменСвойствОбъекта();
		МенеджерНастроек.ИменаТабЧастейДокументовКВыгрузке	= Диагностика_ИменаТабличныхЧастейДокументовКВыгрузке();
		
		ЭДО_Кэш_Поместить("Диагностика_МенеджерНастроек", МенеджерНастроек); 
		
	КонецЕсли;
	
	Возврат МенеджерНастроек;
	
КонецФункции

Функция Диагностика_ПроверитьЗаписьФайлаВоВременныйКаталог()
		
	РезультатПроверки = ИнициализироватьСтруктуруРезультатаФункции();
		
	Попытка
		
		ИмяТестовогоФайла	= УникальноеИмяФайла("txt");		
		ПутьКТестовомуФайлу = ОбъединитьПути(КаталогВременныхФайлов(), ИмяТестовогоФайла);
		
		Текст = Новый ЗаписьТекста(ПутьКТестовомуФайлу, КодировкаТекста.ANSI);    
		Текст.ЗаписатьСтроку("Проверка на запись файлов!");
		Текст.Закрыть();
		
		РезультатПроверки.Успешно = Истина;
		
	Исключение
		РезультатПроверки.ОписаниеОшибки = "Не удалось подготовить данные для диагностики. Причина: " + ОписаниеОшибки();						
	КонецПопытки;
	
	Попытка
		
		ФайлПроверкиЗаписи = Новый Файл(ПутьКТестовомуФайлу);
		
		Если ФайлПроверкиЗаписи.Существует() Тогда
			УдалитьФайлы_КонтурEDI(ФайлПроверкиЗаписи.ПолноеИмя);
		КонецЕсли;
		
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Возврат РезультатПроверки;
	
КонецФункции

Функция Диагностика_СоздатьКаталогДиагностики()
			
	РезультатПроверки = Диагностика_ПроверитьЗаписьФайлаВоВременныйКаталог();
	
	Если НЕ РезультатПроверки.Успешно Тогда
		ВызватьИсключение РезультатПроверки.ОписаниеОшибки;		
	КонецЕсли;
	
	ПутьКаталогДиагностики = ОбъединитьПути(ОбщийКаталогВременныхФайлов_КонтурEDI(), "KonturEDI_Diagnostics"); 
	
	ФайлОбъект = Новый Файл(ПутьКаталогДиагностики);
	
	Если НЕ ФайлОбъект.Существует() Тогда
		СоздатьКаталог(ПутьКаталогДиагностики);
	КонецЕсли;
		
	Возврат ПутьКаталогДиагностики;
	
КонецФункции

Функция Диагностика_ИспользуемоеИмяФайлаТабличногоДокумента(ИмяФайлаБезРасширения)
	
	ИмяФайлаТабличногоДокумента = УбратьНедопустимыеСимволы(ИмяФайлаБезРасширения);
	
	Возврат КонтурСтандарт_СтрШаблон_("%1.xlsx", ИмяФайлаТабличногоДокумента);	
	
КонецФункции

Функция Диагностика_ИмяZipФайла()
	
	ЧастиИмениZipФайла = Новый Массив;
	ЧастиИмениZipФайла.Добавить("KonturEDI_Diagnostics");
	ЧастиИмениZipФайла.Добавить(ПолучитьКонстантуEDI("GLN_Основной"));
	ЧастиИмениZipФайла.Добавить(Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd-HH-mm-ss"));
	ЧастиИмениZipФайла.Добавить(".zip");
	
	Возврат КонтурСтандарт_СтрСоединить_(ЧастиИмениZipФайла, "_");
	
КонецФункции

Функция Диагностика_СоздатьАрхивДанныхДляДиагностики()
	
	Результат = Новый Структура;
	Результат.Вставить("Успешно"	, Истина);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("ФайлАрхива"	, Новый Структура("Имя,АдресВременногоХранилища"));
	
	КаталогДиагностики = Диагностика_МенеджерНастроек().КаталогДиагностики;
	
	Попытка
		
		ИмяZipФайла = Диагностика_ИмяZipФайла();
		ЗаписьZipФайла = НоваяЗаписьZipФайла_КонтурEDI(ИмяZipФайла);
		
		НайденныеФайлы = НайтиФайлы(КаталогДиагностики, "*.xlsx");
		
		Для Каждого ТекущийФайл Из НайденныеФайлы Цикл
			
			Если НЕ ТекущийФайл.ЭтоФайл() Или ТекущийФайл.Размер() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаписьZipФайла.Добавить(ТекущийФайл.ПолноеИмя);
			
		КонецЦикла;
		
		Результат.ФайлАрхива.Имя = ИмяZipФайла;
		
		ДвоичныеДанныеZipФайла = ДвоичныеДанныеАрхива_КонтурEDI(ЗаписьZipФайла, ИмяZipФайла);		
		
		Результат.ФайлАрхива.АдресВременногоХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанныеZipФайла, Новый УникальныйИдентификатор);
		
		УдалитьФайлы_КонтурEDI(КаталогДиагностики);
		
	Исключение
		
		Результат.Успешно = Ложь;
		
		ТекстОшибки = НСтр("ru = 'Не удалось создать файл архива: '") + ОписаниеОшибки();		
		
		Результат.ТекстОшибки = ТекстОшибки;
		
	КонецПопытки;

	Возврат Результат;
	
КонецФункции

Процедура Диагностика_ДобавитьВМакетТабличногоДокументаОбластиВыводаДерева(КоллекцияКолонокДерева)
	
	МакетТабличныйДокумент = Диагностика_МенеджерНастроек().МакетТабличныйДокумент;
		
	КоличествоСтрокТаблицы = МакетТабличныйДокумент.ВысотаТаблицы;
	КоличествоДобавляемыхСтрок = 2;
	
	КоличествоСтрокИтого = КоличествоСтрокТаблицы + КоличествоДобавляемыхСтрок; 
	НомерНачальнойСтроки = 3;		
		
	Для НомерСтроки = НомерНачальнойСтроки По КоличествоСтрокИтого Цикл
		
		ЭтоВтораяСтрока = НомерСтроки > НомерНачальнойСтроки;
		
		Для ИндексКолонки = 0 По КоллекцияКолонокДерева.Количество() - 1 Цикл
			
			НомерКолонки = ИндексКолонки + 1;
			
			ОбластьЯчейки = МакетТабличныйДокумент.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
			КолонкаДерева = КоллекцияКолонокДерева[ИндексКолонки];
			
			Если ЭтоВтораяСтрока Тогда
				
				ОбластьЯчейки.Параметр		= КолонкаДерева.Имя;				
				ОбластьЯчейки.Заполнение	= ТипЗаполненияОбластиТабличногоДокумента.Параметр;
				
				Продолжить;
		
			КонецЕсли;
				
			ОбластьЯчейки.Текст			= КолонкаДерева.Имя;
			ОбластьЯчейки.ЦветФона		= Новый Цвет(244, 236, 197);
			ОбластьЯчейки.ШиринаКолонки	= 20;
						
		КонецЦикла;
		
	КонецЦикла;
	
	МакетТабличныйДокумент.Область("R3").Имя = "ОбластьШапкаДерева";
	МакетТабличныйДокумент.Область("R4").Имя = "ОбластьДетальнаяЗаписьДерева";
	
КонецПроцедуры

Функция Диагностика_ПодготовитьМакетТабличныйДокумент()

	МакетТабличныйДокумент = Новый ТабличныйДокумент;
			
	ПараметрыОбластейМакета = Новый Структура;	
	ПараметрыОбластейМакета.Вставить("СоответствиеИмяТекстЯчейки"	, Новый Структура("C1,C2,C3", "ИмяПоля", "Значение", "Тип"));
	ПараметрыОбластейМакета.Вставить("ЦветФонаЗаголовка"			, Новый Цвет(244, 236, 197));
	ПараметрыОбластейМакета.Вставить("ШиринаКолонки"				, 20);
	ПараметрыОбластейМакета.Вставить("ТипЗаполнения"				, ТипЗаполненияОбластиТабличногоДокумента.Параметр);
		
	КоличествоКолонок = 3;
	КоличествоСтрок = 2;
		
	Для НомерСтроки = 1 По КоличествоСтрок Цикл
		
		ЭтоВтораяСтрока = НомерСтроки > 1;
		
		Для НомерКолонки = 1 По КоличествоКолонок Цикл
			
			ИмяОбласти = "R" + НомерСтроки + "C" + НомерКолонки;
			
			ОбластьЯчейки = МакетТабличныйДокумент.Область(ИмяОбласти);
			ТекстЯчейки = ПараметрыОбластейМакета.СоответствиеИмяТекстЯчейки["C" + НомерКолонки];
			
			Если ЭтоВтораяСтрока Тогда
				
				ОбластьЯчейки.Заполнение = ПараметрыОбластейМакета.ТипЗаполнения;
				ОбластьЯчейки.Параметр	= ТекстЯчейки;
				
				Продолжить;
				
			КонецЕсли;
			
			ОбластьЯчейки.Текст = ТекстЯчейки;
			ОбластьЯчейки.ЦветФона = ПараметрыОбластейМакета.ЦветФонаЗаголовка;
			ОбластьЯчейки.ШиринаКолонки = ПараметрыОбластейМакета.ШиринаКолонки;	
			
		КонецЦикла;
		
	КонецЦикла;
		
	МакетТабличныйДокумент.Область("R1").Имя = "ОбластьШапкаОбъекта";
	МакетТабличныйДокумент.Область("R2").Имя = "ОбластьДетальнаяЗаписьОбъекта";
			
	Возврат МакетТабличныйДокумент;
	
КонецФункции

Процедура Диагностика_ЗаписатьТабличныйДокументВФайл(ТабличныйДокумент)
	
	КаталогДиагностики = Диагностика_МенеджерНастроек().КаталогДиагностики;
	
	Если НЕ ПроверитьСуществованиеФайлаКаталога(КаталогДиагностики) Тогда
		КаталогДиагностики = Диагностика_СоздатьКаталогДиагностики();
	КонецЕсли;
	
	ПутьКФайлуДиагностики = ОбъединитьПути(КаталогДиагностики, ТабличныйДокумент.ИспользуемоеИмяФайла);
	
	ТабличныйДокумент.Записать(ПутьКФайлуДиагностики, ТипФайлаТабличногоДокумента.XLSX);
	
КонецПроцедуры

Процедура Диагностика_ЗаписатьНастройкиСоответствийПартнераВФайлы(ПартнерСсылка)
					
	Диагностика_ЗаписатьСоответствияЮрФизЛицПартнераВФайл(ПартнерСсылка);
		
	Диагностика_ЗаписатьСоответствияТочекДоставокПартнераВФайл(ПартнерСсылка);
	
	Диагностика_ЗаписатьСоответствияТоваровПартнераВФайл(ПартнерСсылка);
		
КонецПроцедуры

Процедура Диагностика_ЗаписатьСоответствияЮрФизЛицПартнераВФайл(ПартнерСсылка)
				
	СписокЮрФизЛицПартнера = ПолучитьСписокЭлементовСправочника("ЮрФизЛицаСторонние", ПартнерСсылка);
	
	ПараметрыВыводаТаблицы = Диагностика_ПараметрыВыводаТаблицыВТабличныйДокумент("Соответствие Юридических(Физических) лиц Партнера", "GLN", Истина);
	
	ТабличныйДокумент = Диагностика_ВывестиТаблицуВТабличныйДокумент(СписокЮрФизЛицПартнера, ПараметрыВыводаТаблицы);
	
	Диагностика_ЗаписатьТабличныйДокументВФайл(ТабличныйДокумент);	
	
КонецПроцедуры

Процедура Диагностика_ЗаписатьСоответствияТочекДоставокПартнераВФайл(ПартнерСсылка)
			
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтурEDI_ТочкиДоставки.Ссылка КАК Ссылка,
		|	КонтурEDI_ТочкиДоставки.Наименование КАК Наименование,
		|	КонтурEDI_ТочкиДоставки.АдресДоставки КАК АдресДоставки,
		|	КонтурEDI_ТочкиДоставки.GLN КАК GLN,
		|	КонтурEDI_ТочкиДоставки.СвязанныйСправочник1 КАК ЮрФизЛицо,
		|	КонтурEDI_ТочкиДоставки.СвязанныйСправочник2 КАК ТочкаДоставкиСвойСправочник,
		|	КонтурEDI_ТочкиДоставки.Подразделение КАК Подразделение,
		|	КонтурEDI_ТочкиДоставки.ЗагружатьСообщения КАК ЗагружатьСообщения
		|ПОМЕСТИТЬ ВТ_ТочкиДоставкиПартнера
		|ИЗ
		|	Справочник.КонтурEDI_ТочкиДоставки КАК КонтурEDI_ТочкиДоставки
		|ГДЕ
		|	КонтурEDI_ТочкиДоставки.Партнер = &Партнер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ		
		|	ВТ_ТочкиДоставкиПартнера.Ссылка КАК Ссылка,
		|	ВТ_ТочкиДоставкиПартнера.Наименование КАК Наименование,
		|	ВТ_ТочкиДоставкиПартнера.АдресДоставки КАК АдресДоставки,
		|	ВТ_ТочкиДоставкиПартнера.GLN КАК GLN,
		|	ВТ_ТочкиДоставкиПартнера.ЮрФизЛицо КАК ЮрФизЛицо,
		|	ВТ_ТочкиДоставкиПартнера.ТочкаДоставкиСвойСправочник КАК ТочкаДоставкиСвойСправочник,
		|	ВТ_ТочкиДоставкиПартнера.Подразделение КАК Подразделение,
		|	ВТ_ТочкиДоставкиПартнера.ЗагружатьСообщения КАК ЗагружатьСообщения,
		|	ЕСТЬNULL(ПРЕДСТАВЛЕНИЕ(ДопРевизитТипЛокализации.Значение), """") КАК ТипЛокализации,
		|	ЕСТЬNULL(ПРЕДСТАВЛЕНИЕ(ДопРевизитСкладыОстатков.Значение), """") КАК СкладыОстатков
		|ИЗ
		|	ВТ_ТочкиДоставкиПартнера КАК ВТ_ТочкиДоставкиПартнера
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ТочкиДоставки.ДополнительныеРеквизиты КАК ДопРевизитТипЛокализации
		|		ПО ВТ_ТочкиДоставкиПартнера.Ссылка = ДопРевизитТипЛокализации.Ссылка
		|			И (ДопРевизитТипЛокализации.ИмяРеквизита = ""ТипЛокализации"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ТочкиДоставки.ДополнительныеРеквизиты КАК ДопРевизитСкладыОстатков
		|		ПО ВТ_ТочкиДоставкиПартнера.Ссылка = ДопРевизитСкладыОстатков.Ссылка
		|			И (ДопРевизитСкладыОстатков.ИмяРеквизита = ""СкладыОстатков"")";
	
	Запрос.УстановитьПараметр("Партнер", ПартнерСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ПараметрыВыводаТаблицы = Диагностика_ПараметрыВыводаТаблицыВТабличныйДокумент("Точки доставки Партнера", "GLN", Истина);
	
	ТабличныйДокумент = Диагностика_ВывестиТаблицуВТабличныйДокумент(РезультатЗапроса.Выгрузить(), ПараметрыВыводаТаблицы);
	
	Диагностика_ЗаписатьТабличныйДокументВФайл(ТабличныйДокумент);
	
КонецПроцедуры

Процедура Диагностика_ЗаписатьСоответствияТоваровПартнераВФайл(ПартнерСсылка)
			
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтурEDI_СоответствияТоваров.GTIN КАК GTIN,
		|	КонтурEDI_СоответствияТоваров.КодТовараПартнера КАК КодТовараПартнера,
		|	КонтурEDI_СоответствияТоваров.Номенклатура КАК Номенклатура,
		|	КонтурEDI_СоответствияТоваров.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	КонтурEDI_СоответствияТоваров.Единица КАК Единица,		
		|	КонтурEDI_СоответствияТоваров.Контрагент КАК Контрагент,
		|	КонтурEDI_СоответствияТоваров.Договор КАК Договор,
		|	КонтурEDI_СоответствияТоваров.ЕдиницаEDI КАК ЕдиницаEDI,				
		|	КонтурEDI_СоответствияТоваров.КоэффициентEDIВ1С КАК КоэффициентEDIВ1С,
		|	КонтурEDI_СоответствияТоваров.ОсновноеСоответствие КАК ОсновноеСоответствие,
		|	КонтурEDI_СоответствияТоваров.ТипЕдиницы КАК ТипЕдиницы
		|ИЗ
		|	РегистрСведений.КонтурEDI_СоответствияТоваров КАК КонтурEDI_СоответствияТоваров
		|ГДЕ
		|	КонтурEDI_СоответствияТоваров.Партнер = &Партнер";
	
	Запрос.УстановитьПараметр("Партнер", ПартнерСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ОписаниеСвойствСтроки = Диагностика_НовыйОписаниеСвойствСтрокиТаблицы(РезультатЗапроса.Колонки);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Диагностика_ВывестиОбластьМакетаПоИмениВТабличныйДокумент(ТабличныйДокумент, "ОбластьШапкаОбъекта");
		
	ПараметрыДетальнойЗаписи = Диагностика_НовыйПараметрыДетальнойЗаписиОбъекта();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл		
		
		ЗначениеGTIN = СокрЛП(Выборка.GTIN);
		
		ИмяПоляГруппировки = ?(ЗначениеЗаполнено(ЗначениеGTIN), "GTIN", "КодТовараПартнера");
				 
		Диагностика_ЗаполнитьПараметрыДетальнойЗаписи(ПараметрыДетальнойЗаписи, ИмяПоляГруппировки, Выборка[ИмяПоляГруппировки]);
		
		ЗаполнитьЗначенияСвойств(ОписаниеСвойствСтроки, Выборка);
		
		Диагностика_ВывестиГруппуДетальныхЗаписейВТабличныйДокумент(ТабличныйДокумент, ОписаниеСвойствСтроки, ПараметрыДетальнойЗаписи);
		
	КонецЦикла;
	
	ТабличныйДокумент.ИспользуемоеИмяФайла = "Соответствие товаров Партнера.xlsx";
	
	Диагностика_ЗаписатьТабличныйДокументВФайл(ТабличныйДокумент);
	
КонецПроцедуры

Процедура Диагностика_ЗаписатьДанныеСообщенияEDIВФайлы(Сообщение)
	
	Если НЕ ТипЗнч(Сообщение) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ПредставлениеСообщения = КонтурСтандарт_СтрШаблон_("%1 №%2 от %3", 
														Сообщение.ТипСообщения, 
														Сообщение.ДокументEDI.Номер, 
														Сообщение.ДокументEDI.Дата); 
	
	ТабличныйДокумент = Диагностика_ВывестиОбъектВТабличныйДокумент(Сообщение, ПредставлениеСообщения);
		
	Диагностика_ЗаписатьТабличныйДокументВФайл(ТабличныйДокумент);
	
	Если Сообщение.Свойство("Товары") И ТипЗнч(Сообщение.Товары) = Тип("ТаблицаЗначений") Тогда
		
		ПредставлениеТаблицы = Диагностика_ПредставлениеТаблицыОбъекта(ПредставлениеСообщения, "Товары");
		
		ПараметрыВыводаТаблицы = Диагностика_ПараметрыВыводаТаблицыВТабличныйДокумент(ПредставлениеТаблицы,, Истина);
		
		ТабличныйДокумент = Диагностика_ВывестиТаблицуВТабличныйДокумент(Сообщение.Товары, ПараметрыВыводаТаблицы);
		
		Диагностика_ЗаписатьТабличныйДокументВФайл(ТабличныйДокумент);
		
	КонецЕсли;
	
	ЕстьТранспортныеУпаковки = Сообщение.Свойство("ТранспортныеУпаковки") 
								И ТипЗнч(Сообщение.ТранспортныеУпаковки) = Тип("ДеревоЗначений") 
								И Сообщение.ТранспортныеУпаковки.Строки.Количество();
	
	Если ЕстьТранспортныеУпаковки Тогда 
		
		ПредставлениеТаблицы = Диагностика_ПредставлениеТаблицыОбъекта(ПредставлениеСообщения, "Транспортные упаковки");
		
		ПараметрыВыводаТаблицы = Диагностика_ПараметрыВыводаТаблицыВТабличныйДокумент(ПредставлениеТаблицы, "СоставУпаковки");
				
		ТабличныйДокумент = Диагностика_ВывестиДеревоЗначенийВТабличныйДокумент(Сообщение.ТранспортныеУпаковки, ПараметрыВыводаТаблицы);
		
		Диагностика_ЗаписатьТабличныйДокументВФайл(ТабличныйДокумент);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Диагностика_ЗаписатьДанныеДокументаОснованияСообщенияВФайлы(ДокументСсылка, ПредставлениеДокумента)
	
	Перем ТабличныеЧастиДокумента, ТабличнаяЧастьДокумента, ИмяТабличнойЧасти;
	
	ОбъектСтруктура = Диагностика_КонвертироватьОбъектСсылкаВСтруктуру(ДокументСсылка, ТипЗнч(ДокументСсылка));
	
	ТабличныйДокумент = Диагностика_ВывестиОбъектВТабличныйДокумент(ОбъектСтруктура, ПредставлениеДокумента);
		
	Диагностика_ЗаписатьТабличныйДокументВФайл(ТабличныйДокумент);
	
	ТабличныеЧастиДокумента = ДокументСсылка.Метаданные().ТабличныеЧасти;           
	
	ИменаТабЧастейКВыгрузке = Диагностика_МенеджерНастроек().ИменаТабЧастейДокументовКВыгрузке;
	
	Для Каждого ТабличнаяЧастьДокумента Из ТабличныеЧастиДокумента Цикл 		
		
		ИмяТабличнойЧасти = ТабличнаяЧастьДокумента.Имя;
		
		ПропуститьТабличнуюЧасть = ИменаТабЧастейКВыгрузке.Найти(ИмяТабличнойЧасти) = Неопределено
									ИЛИ ДокументСсылка[ИмяТабличнойЧасти].Количество() = 0;
		
		Если ПропуститьТабличнуюЧасть Тогда
			Продолжить;
		КонецЕсли;
		
		ПредставлениеТаблицы = Диагностика_ПредставлениеТаблицыОбъекта(ПредставлениеДокумента, ИмяТабличнойЧасти);
		
		ПараметрыВыводаТаблицы = Диагностика_ПараметрыВыводаТаблицыВТабличныйДокумент(ПредставлениеТаблицы);
		
		ТабличныйДокумент = Диагностика_ВывестиТаблицуВТабличныйДокумент(ДокументСсылка[ИмяТабличнойЧасти], ПараметрыВыводаТаблицы);
		
		Диагностика_ЗаписатьТабличныйДокументВФайл(ТабличныйДокумент);
				
	КонецЦикла;
		
КонецПроцедуры

Процедура Диагностика_ЗаписатьДанныеТаблицыКэшПартнеровКонтрагентовВФайл()
	
	ОбновитьКэшПартнеров();
	
	ПараметрыВыводаТаблицы = Диагностика_ПараметрыВыводаТаблицыВТабличныйДокумент("Контрагенты Партнеров", "Контрагент", Истина);
	
	ТабличныйДокумент = Диагностика_ВывестиТаблицуВТабличныйДокумент(ТаблицаКэшПартнеровКонтрагентов, ПараметрыВыводаТаблицы);
	
	Диагностика_ЗаписатьТабличныйДокументВФайл(ТабличныйДокумент);
	
КонецПроцедуры

Процедура Диагностика_ЗаписатьДанныеСвязанныхСообщенийВФайлы(ДокументСсылка)
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат;
	КонецЕсли;
		
	ДеревоСвязанныхСообщений = ПолучитьСвязанныеСообщения(, ДокументСсылка);
	
	ДобавитьКолонкиВТаблицуЗначений(ДеревоСвязанныхСообщений, "Архив,ТребуемоеДействие");
	
	Диагностика_ЗаполнитьДополнительныеКолонкиДереваСвязанныхСообщений(ДеревоСвязанныхСообщений.Строки); 
	
	ПараметрыВыводаТаблицы = Диагностика_ПараметрыВыводаТаблицыВТабличныйДокумент("Связанные сообщения", "Представление");
		
	ТабличныйДокумент = Диагностика_ВывестиДеревоЗначенийВТабличныйДокумент(ДеревоСвязанныхСообщений, ПараметрыВыводаТаблицы);		
	
	Диагностика_ЗаписатьТабличныйДокументВФайл(ТабличныйДокумент);
	
	ТаблицаСвязанныхСообщений = ВыгрузитьДеревоЗначенийВТаблицуЗначений(ДеревоСвязанныхСообщений,, Истина);
	
	Для Каждого СтрокаТаблицы Из ТаблицаСвязанныхСообщений Цикл 
		
		Если СтрокаТаблицы.Вид = "Сообщение" Тогда
			
			Сообщение = СтрокаТаблицы.Ссылка.Хранилище.Получить();
			
			Диагностика_ЗаписатьДанныеСообщенияEDIВФайлы(Сообщение);
						
		ИначеЕсли СтрокаТаблицы.Вид = "Документ" Тогда
						
			Диагностика_ЗаписатьДанныеДокументаОснованияСообщенияВФайлы(СтрокаТаблицы.Ссылка, СтрокаТаблицы.Представление);
			
		КонецЕсли;
				
	КонецЦикла;
	
КонецПроцедуры

Функция Диагностика_ВывестиОбъектВТабличныйДокумент(ОбъектЗначение, ПредставлениеОбъекта)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Диагностика_ВывестиОбластьМакетаПоИмениВТабличныйДокумент(ТабличныйДокумент, "ОбластьШапкаОбъекта");
			
	ПараметрыДетальнойЗаписи = Диагностика_НовыйПараметрыДетальнойЗаписиОбъекта();
	
	Диагностика_ВывестиОбъектВТабличныйДокументРекурсивно(ТабличныйДокумент, ОбъектЗначение, ПараметрыДетальнойЗаписи);
	
	ТабличныйДокумент.ИспользуемоеИмяФайла = Диагностика_ИспользуемоеИмяФайлаТабличногоДокумента(ПредставлениеОбъекта);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Процедура Диагностика_ВывестиОбъектВТабличныйДокументРекурсивно(ТабличныйДокумент, ОбъектЗначение, ПараметрыДетальнойЗаписи, Уровень = 0, ДоступныйУровень = 3)
			
	Для Каждого Элемент Из ОбъектЗначение Цикл
		
		ИмяСвойства			= Элемент.Ключ;
		ЗначениеСвойства	= Элемент.Значение;
		
		Диагностика_ЗаполнитьПараметрыДетальнойЗаписи(ПараметрыДетальнойЗаписи, ИмяСвойства, ЗначениеСвойства);
		
		Уровень = Уровень + 1;						
		
		Если ПараметрыДетальнойЗаписи.Тип = Тип("Структура") Тогда
			
			Диагностика_ВывестиГруппуДетальныхЗаписейВТабличныйДокумент(ТабличныйДокумент, ПараметрыДетальнойЗаписи.Значение, ПараметрыДетальнойЗаписи, Уровень);
			
		ИначеЕсли ТипПринадлежитДокументуСправочнику(ПараметрыДетальнойЗаписи.Тип) И Уровень < ДоступныйУровень Тогда
			
			ОбъектСтруктура = Диагностика_КонвертироватьОбъектСсылкаВСтруктуру(ЗначениеСвойства, ПараметрыДетальнойЗаписи.Тип);
			
			Диагностика_ВывестиГруппуДетальныхЗаписейВТабличныйДокумент(ТабличныйДокумент, ОбъектСтруктура, ПараметрыДетальнойЗаписи, Уровень);					
			
		Иначе			
			Диагностика_ВывестиОбластьМакетаПоИмениВТабличныйДокумент(ТабличныйДокумент, "ОбластьДетальнаяЗаписьОбъекта", ПараметрыДетальнойЗаписи, Уровень);	
		КонецЕсли;	
		
		Уровень = Уровень - 1;
		
	КонецЦикла;
	
КонецПроцедуры

Функция Диагностика_ВывестиТаблицуВТабличныйДокумент(ТаблицаДанных, ПараметрыВывода)
			
	Если ПараметрыВывода.ЭтоТаблицаЗначений Тогда
		КоллекцияКолонокТаблицы = ТаблицаДанных.Колонки;	
	Иначе
		КоллекцияКолонокТаблицы = ТаблицаДанных.ВыгрузитьКолонки().Колонки;		
	КонецЕсли;
	
	ОписаниеСвойствСтроки = Диагностика_НовыйОписаниеСвойствСтрокиТаблицы(КоллекцияКолонокТаблицы);
									
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Диагностика_ВывестиОбластьМакетаПоИмениВТабличныйДокумент(ТабличныйДокумент, "ОбластьШапкаОбъекта");		
	
	ПараметрыДетальнойЗаписи	= Диагностика_НовыйПараметрыДетальнойЗаписиОбъекта();
	ИмяПоляГруппировки			= ПараметрыВывода.ИмяПоляГруппировки;
	
	Для Каждого СтрокаТаблицы Из ТаблицаДанных Цикл
		
		Диагностика_ЗаполнитьПараметрыДетальнойЗаписи(ПараметрыДетальнойЗаписи, ИмяПоляГруппировки, СтрокаТаблицы[ИмяПоляГруппировки]);
		
		ЗаполнитьЗначенияСвойств(ОписаниеСвойствСтроки, СтрокаТаблицы);
						
		Диагностика_ВывестиГруппуДетальныхЗаписейВТабличныйДокумент(ТабличныйДокумент, ОписаниеСвойствСтроки, ПараметрыДетальнойЗаписи);	
		
	КонецЦикла;
	
	ТабличныйДокумент.ИспользуемоеИмяФайла = Диагностика_ИспользуемоеИмяФайлаТабличногоДокумента(ПараметрыВывода.ПредставлениеТаблицы);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Процедура Диагностика_ВывестиГруппуДетальныхЗаписейВТабличныйДокумент(ТабличныйДокумент, ОбъектЗначение, ПараметрыДетальнойЗаписи, Уровень = 0)
	
	Диагностика_ВывестиОбластьМакетаПоИмениВТабличныйДокумент(ТабличныйДокумент, "ОбластьДетальнаяЗаписьОбъекта", ПараметрыДетальнойЗаписи, Уровень);
			
	ТабличныйДокумент.НачатьГруппуСтрок(ПараметрыДетальнойЗаписи.ИмяПоля, Ложь);
	
	Диагностика_ВывестиОбъектВТабличныйДокументРекурсивно(ТабличныйДокумент, ОбъектЗначение, ПараметрыДетальнойЗаписи, Уровень);
			
	ТабличныйДокумент.ЗакончитьГруппуСтрок();
	
КонецПроцедуры

Процедура Диагностика_ВывестиОбластьМакетаПоИмениВТабличныйДокумент(ТабличныйДокумент, ИмяОбласти, ПараметрыДетальнойЗаписи = Неопределено, Отступ = 0)
	
	Макет = Диагностика_МенеджерНастроек().МакетТабличныйДокумент;
	
	ВыводимаяОбласть = Макет.ПолучитьОбласть(ИмяОбласти);
	
	ВыводимаяОбласть.Область("R1C1").Отступ = Отступ;	 
	
	Если НЕ ПараметрыДетальнойЗаписи = Неопределено Тогда 
		ЗаполнитьЗначенияСвойств(ВыводимаяОбласть.Параметры, ПараметрыДетальнойЗаписи);
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(ВыводимаяОбласть);
	
КонецПроцедуры

Процедура Диагностика_ВывестиСтрокиДереваВТабличныйДокументРекурсивно(ТабличныйДокумент, КоллекцияСтрокДерева, ИмяПоляГруппировки, Отступ = 0)
	
	Для Каждого СтрокаДерева Из КоллекцияСтрокДерева Цикл
		
		Диагностика_ВывестиОбластьМакетаПоИмениВТабличныйДокумент(ТабличныйДокумент, "ОбластьДетальнаяЗаписьДерева", СтрокаДерева, Отступ);
		
		Отступ = Отступ + 1;
		
		ТабличныйДокумент.НачатьГруппуСтрок(ИмяПоляГруппировки);
		 
		Диагностика_ВывестиСтрокиДереваВТабличныйДокументРекурсивно(ТабличныйДокумент, СтрокаДерева.Строки, ИмяПоляГруппировки, Отступ);
		
		Отступ = Отступ - 1;
		
		ТабличныйДокумент.ЗакончитьГруппуСтрок();
					
	КонецЦикла;
		
КонецПроцедуры

Функция Диагностика_ВывестиДеревоЗначенийВТабличныйДокумент(ДеревоЗначений, ПараметрыВывода)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
			
	Диагностика_ДобавитьВМакетТабличногоДокументаОбластиВыводаДерева(ДеревоЗначений.Колонки);
	
	Диагностика_ВывестиОбластьМакетаПоИмениВТабличныйДокумент(ТабличныйДокумент, "ОбластьШапкаДерева");
			
	Диагностика_ВывестиСтрокиДереваВТабличныйДокументРекурсивно(ТабличныйДокумент, ДеревоЗначений.Строки, ПараметрыВывода.ИмяПоляГруппировки);
		
	ТабличныйДокумент.ИспользуемоеИмяФайла = Диагностика_ИспользуемоеИмяФайлаТабличногоДокумента(ПараметрыВывода.ПредставлениеТаблицы);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Процедура Диагностика_ЗаполнитьПараметрыДетальнойЗаписи(ПараметрыДетальнойЗаписи, ИмяПоля, Значение)
	
	ПодстрокиИменСвойств = Диагностика_МенеджерНастроек().ПодстрокиИменСвойствОбъекта;	
	
	Для Каждого ПодстрокаИмениСвойства Из ПодстрокиИменСвойств Цикл
		
		Если Найти(ИмяПоля, ПодстрокаИмениСвойства) > 0 Тогда			
			Значение = "";		
			Прервать;		
		КонецЕсли;		
			
	КонецЦикла;
	
	ПараметрыДетальнойЗаписи.ИмяПоля 	= ИмяПоля;
	ПараметрыДетальнойЗаписи.Значение 	= Значение;
	ПараметрыДетальнойЗаписи.Тип		= ТипЗнч(Значение);
	
КонецПроцедуры

