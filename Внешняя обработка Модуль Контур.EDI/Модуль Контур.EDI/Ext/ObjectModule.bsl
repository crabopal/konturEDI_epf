Процедура СоздатьИПрикрепитьМеткуНаФорме(Форма, Знач ЗаголовокМетки) Экспорт 
	
	Метка = НайтиСоздатьМетку(ЗаголовокМетки);
	ПрикрепитьМеткуНаФорме(Форма, Метка);
	
КонецПроцедуры

Функция НайтиСоздатьМетку(Наименование, ЦветТекста = Неопределено, Шрифт = Неопределено, ЦветФона = Неопределено) Экспорт
	
	Метка = НайтиМетку(Наименование);
	
	Если Метка = Неопределено Тогда
		
		Метка = СоздатьМетку(Наименование, ЦветТекста, Шрифт, ЦветФона);
		
	КонецЕсли;
	
	Возврат Метка;
	
КонецФункции

Процедура ПрикрепитьМеткуНаФорме(Форма, Метка) Экспорт 
		
	Если Форма.ДанныеМеток.НайтиСтроки(Новый Структура("Метка", Метка)).Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаМетки = Форма.ДанныеМеток.Добавить();
	СтрокаМетки.Метка = Метка;
	СтрокаМетки.ПометкаУдаления = Метка.ПометкаУдаления;
	
	ОбновитьЭлементыМетокНаФорме(Форма);
	
КонецПроцедуры

Процедура ОбновитьЭлементыМетокНаФорме(Форма) Экспорт
	
	Если ТипЗнч(Форма) = Тип("УправляемаяФорма") Тогда
		ОбновитьЭлементыМетокНаФорме_УправляемаяФорма(Форма);
	Иначе
		ОбновитьЭлементыМетокНаФорме_ОбычнаяФорма(Форма);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьЭлементыМетокНаФорме_УправляемаяФорма(Форма) Экспорт
	
	ГруппаСписокМеток = Форма.Элементы.СписокМеток;
	
	КоличествоЭлементов = ГруппаСписокМеток.ПодчиненныеЭлементы.Количество(); 
	
	Если КоличествоЭлементов > 1 Тогда
		УдалитьЭлементыМетокНаФорме(КоличествоЭлементов, ГруппаСписокМеток.ПодчиненныеЭлементы, Истина, Форма.Элементы);
	КонецЕсли;
	
	МассивМеток = Форма.ДанныеМеток.Выгрузить(, "Метка").ВыгрузитьКолонку("Метка");
	СоответствиеСвойствМеток = ПолучитьСвойстваМеток(МассивМеток);
	
	Индекс = 0;
	
	Для Каждого Метка Из МассивМеток Цикл 
		
		СвойстваМеток = СоответствиеСвойствМеток[Метка];
		
		Имя = "Метка_" + Индекс;
		
		СоздатьДекорациюНадпись(Форма, ГруппаСписокМеток, Имя, СвойстваМеток, Истина);
		
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьЭлементыМетокНаФорме_ОбычнаяФорма(Форма) Экспорт
	
	МассивЭлементовДляУдаления = Новый Массив;
	
	Для каждого ЭлементФормы Из Форма.ЭлементыФормы Цикл
		
		Если Лев(ЭлементФормы.Имя, 6) = "Метка_" Тогда
			
			МассивЭлементовДляУдаления.Добавить(ЭлементФормы);
			
		КонецЕсли;
		
	КонецЦикла;
	
	КоличествоЭлементов = МассивЭлементовДляУдаления.Количество();
	
	Если КоличествоЭлементов Тогда
		УдалитьЭлементыМетокНаФорме(КоличествоЭлементов, МассивЭлементовДляУдаления, Ложь, Форма.ЭлементыФормы);
	КонецЕсли;
	
	МассивМеток = Форма.ДанныеМеток.ВыгрузитьКолонку("Метка");
	ГруппаСписокМеток = Форма.ЭлементыФормы.СписокМеток;
	СоответствиеСвойствМеток = ПолучитьСвойстваМеток(МассивМеток);
	
	Индекс = 0;
	Лево = 1;
	Верх = 1;
	Высота = 19;
	
	Для Каждого Метка Из МассивМеток Цикл 
		
		СвойстваМеток = СоответствиеСвойствМеток[Метка];
		
		Имя = "Метка_" + Индекс; 
		
		Ширина = СтрДлина(СвойстваМеток.Наименование) * 8;
		
		СоздатьДекорациюНадпись(Форма, ГруппаСписокМеток, Имя, СвойстваМеток, Ложь, Лево, Верх, Высота, Ширина);
		
		Лево = Лево + 1 + Ширина;
		
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
КонецПроцедуры

Функция СообщенияИмеющиеМетки(Метки, Условие = "И") Экспорт
	
	Если ТипЗнч(Метки) = Тип("Массив") Тогда
