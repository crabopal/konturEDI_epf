Процедура ВыполнитьКоманду(ИдентификаторКоманды) Экспорт
	
	Если ИдентификаторКоманды = "ВыполнитьФоновыйОбмен" Тогда
		
		ФоновоеЗадание_ВыполнитьОбмен();
		
	ИначеЕсли ИдентификаторКоманды = "РассчитатьСтатистикуПоСообщениям" Тогда
		
		ФоновоеЗадание_РассчитатьСтатистикуПоСообщениям();
		
	ИначеЕсли ИдентификаторКоманды = "УдалитьНеактуальныеДанные" Тогда
		
		ФоновоеЗадание_УдалитьНеактуальныеДанные();
		
	ИначеЕсли ИдентификаторКоманды = "УдалитьНеактуальныеСообщения" Тогда
		
		ФоновоеЗадание_УдалитьНеактуальныеСообщения();
		
	Иначе
		
		Если Лев(ИдентификаторКоманды, 54) = "ОперацииОбмена_ЗагрузитьНовыеСообщенияПоТипуСообщения_" Тогда
			
			ТипСообщения = Сред(ИдентификаторКоманды, 55);
			
			ПараметрыВыполненияПоТипуСообщения = Новый Структура("ВОтдельномФоновомЗадании,ИдентификаторЗадания,ТипСообщения");
			ПараметрыВыполненияПоТипуСообщения.ВОтдельномФоновомЗадании = Истина;
			ПараметрыВыполненияПоТипуСообщения.ИдентификаторЗадания = ИдентификаторКоманды;
			ПараметрыВыполненияПоТипуСообщения.ТипСообщения = ТипСообщения;
			
			ОперацииОбмена_ЗагрузитьНовыеСообщенияПоТипуСообщения(ПараметрыВыполненияПоТипуСообщения);
			
		ИначеЕсли ИдентификаторКоманды = "ОперацииОбмена_ПринятьВходящиеСообщенияАвтоматически" Тогда
			
			ПараметрыОбмена = ПараметрыОбменаССервером();
			ПараметрыОбмена.Вставить("ЭтоФоновоеЗадание", Истина);	
