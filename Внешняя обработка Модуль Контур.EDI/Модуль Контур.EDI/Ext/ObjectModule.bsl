// Преобразование JSON в Объект.
//
// Параметры:
//  Json - ДвоичныеДанные, Строка - данные в формате JSON.
//  Кодировка - Строка, КодировкаТекста - кодировка текста JSON. Значение по умолчанию = utf-8.
// 
// Возвращаемое значение:
//  Произвольный - значение, десериализованное из JSON.
//
Функция КлиентHTTP_JsonВОбъект(Json, Кодировка = "UTF-8") Экспорт
	
	Если ТипЗнч(Json) = Тип("ДвоичныеДанные") Тогда
		
		СтрокаJSON = КонтурСтандарт_ПолучитьСтрокуИзДвоичныхДанных_(Json, Кодировка);
		
	Иначе
		
		СтрокаJSON = Json;
		
	КонецЕсли;

	Возврат КонтурСтандарт_ЗначениеИзСтрокиJSON(СтрокаJSON, Истина);
	
КонецФункции

