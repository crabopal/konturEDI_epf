КонецПроцедуры

Функция НовыйОписаниеОшибкиПодготовкиСообщенияEDI() Экспорт
	
	ОписаниеОшибкиПодготовкиСообщенияEDI = Новый Структура;
	
	ОписаниеОшибкиПодготовкиСообщенияEDI.Вставить("ИмяПоля", Неопределено);
	ОписаниеОшибкиПодготовкиСообщенияEDI.Вставить("ИмяТабличнойЧасти", Неопределено);
	ОписаниеОшибкиПодготовкиСообщенияEDI.Вставить("НомерСтроки", Неопределено);
	ОписаниеОшибкиПодготовкиСообщенияEDI.Вставить("СведенияОбОшибках", Неопределено);
	ОписаниеОшибкиПодготовкиСообщенияEDI.Вставить("СодержитОписаниеПоля", Ложь);
	ОписаниеОшибкиПодготовкиСообщенияEDI.Вставить("ВыводитьВТаблицуОшибок", Истина);
	ОписаниеОшибкиПодготовкиСообщенияEDI.Вставить("ИсточникОшибки", Неопределено);
	
	Возврат ОписаниеОшибкиПодготовкиСообщенияEDI;
	
КонецФункции

Функция ИнициализироватьТаблицуОшибок() Экспорт
	
	ТаблицаОшибок = Новый ТаблицаЗначений;
	
	ТаблицаОшибок.Колонки.Добавить("ИмяПоля");
	ТаблицаОшибок.Колонки.Добавить("ИмяТабличнойЧасти");
	ТаблицаОшибок.Колонки.Добавить("НомерСтроки");
	ТаблицаОшибок.Колонки.Добавить("СведенияОбОшибках"); // или текст строкой, или таблица с ошибками подчиненных полей
	ТаблицаОшибок.Колонки.Добавить("СодержитОписаниеПоля");
	
	Возврат ТаблицаОшибок;
	
КонецФункции

Процедура ЗафиксироватьОшибку(ТаблицаОшибок,ИмяПоля,ИмяТабличнойЧасти,НомерСтроки,СведенияОбОшибках,СодержитОписаниеПоля = Ложь) Экспорт
	
	НоваяСтрока = ТаблицаОшибок.Добавить();
	
	НоваяСтрока.ИмяПоля					= ИмяПоля;
	НоваяСтрока.ИмяТабличнойЧасти		= ИмяТабличнойЧасти;
	НоваяСтрока.НомерСтроки				= НомерСтроки;
	НоваяСтрока.СведенияОбОшибках		= СведенияОбОшибках;
	НоваяСтрока.СодержитОписаниеПоля	= СодержитОписаниеПоля;
	
КонецПроцедуры

Функция ДополнитьСообщениеОбОшибке(ТекПутьКПолю,ПутьКПолю)
	
	Если Найти(ТекПутьКПолю, "ГрузоотправительEDI")>0 И СокрЛП(ПутьКПолю) = "Регион" Тогда
		СообщениеОбОшибке = "Не заполнено поле Регион в Фактическом адресе";
	ИначеЕсли Найти(ТекПутьКПолю, "ПродавецEDI")>0 И СокрЛП(ПутьКПолю) = "Регион" Тогда
		СообщениеОбОшибке = "Не заполнено поле Регион в Юридическом адресе";
	ИначеЕсли Найти(ТекПутьКПолю, "ПокупательEDI")>0 И СокрЛП(ПутьКПолю) = "Регион" Тогда
		СообщениеОбОшибке = "Не заполнено поле Регион в Юридическом адресе";	
	Иначе
		СообщениеОбОшибке = "Не заполнено обязательное поле "+ПутьКПолю+"!";
	КонецЕсли;
	
	Возврат СообщениеОбОшибке;	

КонецФункции

Функция НеобходимоВалидироватьПолеСообщения(ИмяПоля)
	
	НеобходимоВалидировать = Истина;
	
	Если Лев(ИмяПоля,4) = "Алко" 
		ИЛИ Лев(ИмяПоля,5) = "Фарма" 
		ИЛИ ИмяПоля = "КоличествоВОдномМесте"
		ИЛИ ИмяПоля = "Производитель" 
		Тогда
		
		НеобходимоВалидировать = Ложь;
		
	КонецЕсли;
		
	Возврат НеобходимоВалидировать;
		
КонецФункции

Процедура ПроверитьТабличнуюЧастьСообщения(Сообщение, МетаданныеСообщения, ТаблицаОшибок, ИмяТаблицы, ПутьКПолю, ПолныйПутьКПолю, ОбязательныеПоля)
	
	// копируем метаданные сообщения по этой таблице
	ОтборПолейТаблицы = Новый Структура("ИмяТаблицы", ИмяТаблицы);
	
	МетаданныеТабличнойЧасти = МетаданныеСообщения.Скопировать(ОтборПолейТаблицы);
	                                         
	НайденнаяСтрока = МетаданныеТабличнойЧасти.Найти(ИмяТаблицы, "ИмяПоля");
	
	Если НЕ НайденнаяСтрока = Неопределено Тогда
		МетаданныеТабличнойЧасти.Удалить(НайденнаяСтрока);
	КонецЕсли;
	
	НайденнаяСтрока = ОбязательныеПоля.Найти(ПолныйПутьКПолю, "ИмяПоля");
	
	Если НЕ НайденнаяСтрока = Неопределено Тогда
		Если Сообщение[ИмяТаблицы].Количество() = 0 Тогда
			ЗафиксироватьОшибку(ТаблицаОшибок, ПутьКПолю, ИмяТаблицы, 0, "Табличная часть """ + ИмяТаблицы + """ должна быть заполнена!");
		КонецЕсли;
	КонецЕсли;
	
	НомерСтрокиТаблицы = 0;
	
	Режим = ОпределитьКемМыЯвляемся(Сообщение);
	
	ТребуетсяСопоставление = (Режим = "Поставщик" ) И (ОбязательныеПоля.Найти("Товары.GTIN", "ИмяПоля") <> Неопределено 
		ИЛИ ОбязательныеПоля.Найти("Товары.КодТовараПокупателя", "ИмяПоля") <> Неопределено);
	
	Для каждого СтрокаТаблицы ИЗ Сообщение[ИмяТаблицы] Цикл
		
		НомерСтрокиТаблицы = НомерСтрокиТаблицы + 1;
		
		Если ИмяТаблицы = "Товары" Тогда
			
			Если ЗначениеЗаполнено(СтрокаТаблицы.НомерГТДEDI) Тогда
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.СтранаEDI) Тогда
					ЗафиксироватьОшибку(ТаблицаОшибок, "СтранаEDI", "Товары", НомерСтрокиТаблицы, "Необходимо указать страну, если заполнен номер ГТД!", Истина);
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.КодТовараПокупателя)
				И НЕ ЗначениеЗаполнено(СтрокаТаблицы.GTIN) Тогда
				
				ЕстьОшибка = Истина;
				
				Если ТребуетсяСопоставление Тогда 					
					ИмяПоля = "Номенклатура";
					ТекстОшибки = "Не найдено соответствие номенклатуры в строке " + НомерСтрокиТаблицы + " !";
				ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаТаблицы.КодТовараПоставщика) Тогда
					ИмяПоля = "GTIN";
					ТекстОшибки = "В строке товара не определен ни один идентификатор (Штрихкод, Код товара покупателя, Код товара поставщика).";
				Иначе
					ЕстьОшибка = Ложь;	 
				КонецЕсли;
				
				Если ЕстьОшибка 
					И ПеременнаяСодержитСвойство(СтрокаТаблицы, "МногиеКоМногим")
					И СтрокаТаблицы.МногиеКоМногим = Истина Тогда
					
					ТекстОшибки = ТекстОшибки + " (строка с признаком ""МногиеКоМногим"")";
					
				КонецЕсли;
				
				Если ЕстьОшибка Тогда 
					ЗафиксироватьОшибку(ТаблицаОшибок, ИмяПоля , "Товары", НомерСтрокиТаблицы, ТекстОшибки, Истина);
					Продолжить; 
				КонецЕсли;
				
			КонецЕсли;
					
		КонецЕсли;
		
		ПроверитьПоляСообщенияEDI(СтрокаТаблицы, МетаданныеТабличнойЧасти, ТаблицаОшибок, ПолныйПутьКПолю, ИмяТаблицы, НомерСтрокиТаблицы, ОбязательныеПоля);
		
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьСтруктуруСообщения(ТаблицаОшибок, ИмяТабличнойЧасти, НомерСтроки, ПутьКПолю, ПолныйПутьКПолю, ВидСтруктурыEDI, ЗначениеПоля, ОбязательныеПоля, Сообщение)
	
	Если ТипЗнч(ЗначениеПоля) <> Тип("Структура") Тогда
		ЗафиксироватьОшибку(ТаблицаОшибок, ПутьКПолю, ИмяТабличнойЧасти, НомерСтроки, "Неверная структура сообщения! Поле " + ПолныйПутьКПолю + " должно иметь тип ""Структура""!", Истина);
		Возврат;
	КонецЕсли;
	
	Если ПараметрыПользователяEDI.НеБратьСвоиАдресаИз1С = Истина Тогда
		Если ПолныйПутьКПолю = "ПродавецEDI.Адрес" ИЛИ ПолныйПутьКПолю = "ГрузоотправительEDI.Адрес" Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ПараметрыПользователяEDI.НеБратьАдресаПартнераИз1С = Истина Тогда
		Если ПолныйПутьКПолю = "ПокупательEDI.Адрес" ИЛИ ПолныйПутьКПолю = "ПлательщикEDI.Адрес" ИЛИ ПолныйПутьКПолю = "ГрузополучательEDI.Адрес" Тогда
			Возврат;
		КонецЕсли;	
	КонецЕсли;
	
	СтруктураСообщения = ПолучитьМетаданныеПоляСообщения(ВидСтруктурыEDI, Сообщение);
	Если СтруктураСообщения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаОшибокПоля	= ИнициализироватьТаблицуОшибок();
	
	// рекурсивно проверим вложенные структуры
	ПроверитьПоляСообщенияEDI(ЗначениеПоля, СтруктураСообщения, ТаблицаОшибокПоля, ПолныйПутьКПолю,ИмяТабличнойЧасти,НомерСтроки, ОбязательныеПоля);
	
	Если ТаблицаОшибокПоля.Количество() > 0 Тогда
		ЗафиксироватьОшибку(ТаблицаОшибок, ПутьКПолю, ИмяТабличнойЧасти, НомерСтроки, ТаблицаОшибокПоля);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьПолеСообщения(Сообщение, ТаблицаОшибок, ИмяТабличнойЧасти, НомерСтроки, ТекПутьКПолю, ПутьКПолю, ПолныйПутьКПолю, ТипEDI, ЗначениеПоля, ОбязательныеПоля)
	
	Если ОбязательныеПоля = Неопределено Тогда
		ОбязательныеПоля = Новый Массив;
	КонецЕсли;
	
	ПроверятьЗаполнениеПоля = ОбязательныеПоля.Количество() > 0;
	
	Для Каждого ОбязательноеПоле Из ОбязательныеПоля Цикл
		
		Если ОбязательноеПоле.ИмяПоляУсловия = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПроверятьЗаполнениеПоля = Ложь;
		
		Если ОбязательноеПоле.ВидСравнения = "равно" И Сообщение[ОбязательноеПоле.ИмяПоляУсловия] = ОбязательноеПоле.ЗначениеПоляУсловия Тогда

			Если Не ОбязательноеПоле.ПравилоПроверки = Неопределено Тогда
				ТипEDI = ОбязательноеПоле.ПравилоПроверки;
			КонецЕсли;
			
			ПроверятьЗаполнениеПоля = Истина;
			Прервать;
			
		КонецЕсли;

	КонецЦикла;
	
	Если ПроверятьЗаполнениеПоля И НЕ ЗначениеЗаполнено(ЗначениеПоля) Тогда

		СообщениеОбОшибке = ДополнитьСообщениеОбОшибке(ТекПутьКПолю, ПутьКПолю);
		ЗафиксироватьОшибку(ТаблицаОшибок, ПутьКПолю, ИмяТабличнойЧасти, НомерСтроки, СообщениеОбОшибке, Истина);
		Возврат;
		
	КонецЕсли;
	
	// проверяем значение
	РезультатПроверки = ПроверитьЗначениеEDI(ЗначениеПоля, ТипEDI);
	Если НЕ РезультатПроверки.Успешно Тогда
		Для Каждого СтрокаОшибки Из РезультатПроверки.ТаблицаОшибок Цикл
			ЗафиксироватьОшибку(ТаблицаОшибок, ПутьКПолю, ИмяТабличнойЧасти, НомерСтроки, СтрокаОшибки);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьПоляСообщенияEDI(ПроверяемоеЗначение, Знач МетаданныеСообщения, ТаблицаОшибок, ТекПутьКПолю, ИмяТабличнойЧасти = Неопределено, НомерСтроки = Неопределено, ОбязательныеПоля, Сообщение = Неопределено) Экспорт
	
	Если МетаданныеСообщения.Колонки.Найти("ПутьКПолю") = Неопределено Тогда
		МетаданныеСообщения = ПодготовитьМетаданныеСообщенияДляПроверки(МетаданныеСообщения, ОбязательныеПоля, ТекПутьКПолю);
	КонецЕсли;	
	
	Для Каждого Стр Из МетаданныеСообщения Цикл
		
		ПутьКПолю 		= Стр.ПутьКПолю;
		ПолныйПутьКПолю = Стр.ПолныйПутьКПолю;
		ЗначениеПоля 	= Неопределено;
		
		Если ТипЗнч(ПроверяемоеЗначение) = Тип("Структура") Тогда
			
			Если НЕ ЗначениеЗаполнено(Стр.ИмяТаблицы) 
				ИЛИ Стр.ТипEDI = "ТабличнаяЧасть" Тогда
				Если НЕ ПроверяемоеЗначение.Свойство(ПутьКПолю,ЗначениеПоля) Тогда
					
					ЗафиксироватьОшибку(ТаблицаОшибок,ПутьКПолю,ИмяТабличнойЧасти,НомерСтроки,"Неверная структура сообщения! Отстутствует поле "+ПолныйПутьКПолю+"!",Истина);
					Продолжить;
				КонецЕсли;
			КонецЕсли;	
		Иначе
			Попытка
				ЗначениеПоля = ПроверяемоеЗначение[ПутьКПолю];
			Исключение
				ЗафиксироватьОшибку(ТаблицаОшибок,ПутьКПолю,ИмяТабличнойЧасти,НомерСтроки,"Неверная структура сообщения! Отстутствует поле "+ПолныйПутьКПолю+"!",Истина);
				Продолжить;
			КонецПопытки;
		КонецЕсли;
		
		Если Стр.ТипEDI = "ТабличнаяЧасть" Тогда
			ПроверитьТабличнуюЧастьСообщения(ПроверяемоеЗначение, МетаданныеСообщения, ТаблицаОшибок, Стр.ИмяТаблицы, ПутьКПолю, ПолныйПутьКПолю, ОбязательныеПоля);			
		ИначеЕсли НЕ ЗначениеЗаполнено(ИмяТабличнойЧасти) И ЗначениеЗаполнено(Стр.ИмяТаблицы) Тогда
			Продолжить;
		ИначеЕсли Стр.ТипEDI = "Структура" Тогда
			ПроверитьСтруктуруСообщения(ТаблицаОшибок, ИмяТабличнойЧасти, НомерСтроки, ПутьКПолю, ПолныйПутьКПолю, Стр.ВидСтруктурыEDI, ЗначениеПоля, ОбязательныеПоля, Сообщение);			
		Иначе
			ПроверитьПолеСообщения(ПроверяемоеЗначение, ТаблицаОшибок, ИмяТабличнойЧасти, НомерСтроки, ТекПутьКПолю, ПутьКПолю, ПолныйПутьКПолю, Стр.ТипEDI, ЗначениеПоля, Стр.ОбязательныеПоля);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПодготовитьМетаданныеСообщенияДляПроверки(МетаданныеСообщения, ОбязательныеПоля, ТекПутьКПолю)
	
	ЕстьПринадлежностьВМетаданных = Не МетаданныеСообщения.Колонки.Найти("Принадлежность") = Неопределено;

	ПроверяемыеЗначенияПринадлежности = Новый Массив;
	ПроверяемыеЗначенияПринадлежности.Добавить("=");
	ПроверяемыеЗначенияПринадлежности.Добавить("EDI");
	ПроверяемыеЗначенияПринадлежности.Добавить(Неопределено);

	ПодготовленныеМетаданные = МетаданныеСообщения.Скопировать();
	ПодготовленныеМетаданные.Колонки.Добавить("ПутьКПолю");
	ПодготовленныеМетаданные.Колонки.Добавить("ПолныйПутьКПолю");
	ПодготовленныеМетаданные.Колонки.Добавить("ОбязательныеПоля");
	
	ИндексСтрокиМетаданных = ПодготовленныеМетаданные.Количество();
	
	Пока ИндексСтрокиМетаданных > 0 Цикл
		
		ИндексСтрокиМетаданных = ИндексСтрокиМетаданных - 1;
		
		ПолеМетаданных 		= ПодготовленныеМетаданные[ИндексСтрокиМетаданных];
		ПринадлежностьПоля 	= ?(ЕстьПринадлежностьВМетаданных, ПолеМетаданных.Принадлежность, Неопределено);
		
		ПолеТребуетПроверки = НеобходимоВалидироватьПолеСообщения(ПолеМетаданных.ИмяПоля) 
							  И Не ПроверяемыеЗначенияПринадлежности.Найти(ПринадлежностьПоля) = Неопределено;
		
		Если НЕ ПолеТребуетПроверки Тогда
			ПодготовленныеМетаданные.Удалить(ИндексСтрокиМетаданных);
            Продолжить;
		КонецЕсли;
		
		ПолеМетаданных.ПутьКПолю = ПолеМетаданных.ИмяПоля;
		
		Если ЕстьПринадлежностьВМетаданных И ПринадлежностьПоля = Неопределено Тогда
			ПолеМетаданных.ПутьКПолю = ПолеМетаданных.ПутьКПолю + "EDI";
		КонецЕсли;
		
		ПолеМетаданных.ПолныйПутьКПолю = ПолеМетаданных.ПутьКПолю;
		
		Если ЗначениеЗаполнено(ПолеМетаданных.ИмяТаблицы) И ПолеМетаданных.ИмяТаблицы <> ПолеМетаданных.ИмяПоля Тогда
			ИмяВладелецПоля = ПолеМетаданных.ИмяТаблицы;
		Иначе			
			ИмяВладелецПоля = ТекПутьКПолю;
		КонецЕсли;
		
		Если Не ИмяВладелецПоля = "" Тогда
			ПолеМетаданных.ПолныйПутьКПолю = ИмяВладелецПоля + "." + ПолеМетаданных.ПутьКПолю;
		КонецЕсли;
		
		Если Не ПолеМетаданных.ТипEDI = "ТабличнаяЧасть" И Не ПолеМетаданных.ТипEDI = "Структура" Тогда
			ОтборОбязательныхПолей = Новый Структура("ИмяПоля", ПолеМетаданных.ПолныйПутьКПолю);
			ПолеМетаданных.ОбязательныеПоля = ОбязательныеПоля.НайтиСтроки(ОтборОбязательныхПолей);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ПодготовленныеМетаданные;
	
КонецФункции

Функция ПроверитьСообщениеEDI(Сообщение,Параметры = Неопределено) Экспорт
	
	ТаблицаОшибок = ИнициализироватьТаблицуОшибок();
	
	ОбязательныеПоля = ПолучитьОбязательныеПоля(Сообщение);
		
	Если Сообщение.Направление = "Исходящее" Тогда
		
		МассивНеПроверяемыхПолей = Новый Массив;
		
		ПроверитьДанныеОбУпаковках_КонтурEDI(Сообщение, ТаблицаОшибок); 
		ПроверитьКодыМаркировки_КонтурEDI(Сообщение, ТаблицаОшибок);
			
		Если (Сообщение.ТипСообщения = "DESADV" 
			ИЛИ Сообщение.ТипСообщения = "INVOIC"
			ИЛИ Сообщение.ТипСообщения = "COINVOIC") Тогда
			
			НетORDERS = Не ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Получатель1С,"ORDERS_Входящее") = Истина;
			Если НетORDERS Тогда
				МассивНеПроверяемыхПолей.Добавить("ЗаказEDI.Номер");
				МассивНеПроверяемыхПолей.Добавить("ЗаказEDI.Дата");
			КонецЕсли;
			
		КонецЕсли;
		
		Если Сообщение.ТипСообщения = "DESADV" И Врег(Сообщение.Статус) = "ОТМЕНЕН" Тогда 
			МассивНеПроверяемыхПолей.Добавить("Товары.Количество");
		КонецЕсли;
		
		Если Сообщение.ТипСообщения = "RETREC" Тогда
			МассивНеПроверяемыхПолей.Добавить("ЗаказEDI.Номер");
			МассивНеПроверяемыхПолей.Добавить("ЗаказEDI.Дата");
		КонецЕсли;
		
		Если Сообщение.ТипСообщения = "RECADV" Тогда
						
			НетDESADV = Не ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Получатель1С,"DESADV_Входящее") = Истина 
							ИЛИ ПолучитьКонстантуEDI("РазрешитьПустойDespatchId_В_RECADV") = Истина;
							
			Если НетDESADV Тогда
				МассивНеПроверяемыхПолей.Добавить("НакладнаяEDI.Номер");
				МассивНеПроверяемыхПолей.Добавить("НакладнаяEDI.Дата");
			КонецЕсли;
			
		КонецЕсли;
		
		Если Сообщение.ТипСообщения = "INVOIC" И Сообщение.СуммаВсего = 0 И ЕстьКоррИспрСФ Тогда
			
			ДокОснование = ПолучитьЗначениеСвойстваОбъектаМетаданныхПоИмени("ДокументОснование", Сообщение.Документ1С);
			ТипИсходящийКСФ = ПолучитьТипЗначенияОбъекта("ИсходящийКСФ");
			
			Если ЗначениеЗаполнено(ТипИсходящийКСФ) И ТипЗнч(ДокОснование) = Тип(ТипИсходящийКСФ) Тогда
				
				Если ИмяКонфигурации1С = "УФ_УТ" Тогда
					ЕстьВидОперации = (ПолучитьЗначениеСвойстваОбъектаМетаданныхПоИмени("ВидКорректировки", ДокОснование) <> Неопределено);
				Иначе
					ЕстьВидОперации = (ПолучитьЗначениеСвойстваОбъектаМетаданныхПоИмени("ВидОперации", ДокОснование) <> Неопределено);
				КонецЕсли;
								
				ЗафиксироватьОшибку(ТаблицаОшибок,,,,"Запрещено выгружать исправление счет-фактуры с пустой табличной частью. 
									|Измените "+?(ЕстьВидОперации, "вид корректировки", "корректировку")+", либо прекратите обработку сообщения (Действия - Прекратить обработку нулевой счет-фактуры)!",Истина);
									
				МассивНеПроверяемыхПолей.Добавить("СуммаВсего");
				МассивНеПроверяемыхПолей.Добавить("СуммаВсегоБезНДС");
				
			КонецЕсли;
			
		КонецЕсли;
				
		Для Каждого ИмяПоля Из МассивНеПроверяемыхПолей Цикл
			УдаляемаяСтрока = ОбязательныеПоля.Найти(ИмяПоля,"ИмяПоля");
			Если НЕ УдаляемаяСтрока=Неопределено Тогда
				ОбязательныеПоля.Удалить(УдаляемаяСтрока);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ОписаниеОшибкиПодготовки Из Сообщение.ОшибкиПодготовки Цикл
			Если ОписаниеОшибкиПодготовки.ВыводитьВТаблицуОшибок = Истина Тогда
				НоваяСтрокаТаблицыОшибок = ТаблицаОшибок.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицыОшибок, ОписаниеОшибкиПодготовки);	
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	МетаданныеСообщения = ПолучитьМетаданныеСообщения(Сообщение.ТипСообщения, Сообщение.Направление);
	
	ДобавитьКонтрольЗаполненияОсобенностейСообщения(Сообщение,ОбязательныеПоля); //Доп полей, созданных с помощью события ПМ ДобавитьОсобенностиСообщений
	
	ПроверитьПоляСообщенияEDI(Сообщение, МетаданныеСообщения, ТаблицаОшибок, "", , , ОбязательныеПоля, Сообщение); 	
	
	ОбработкаСобытияПодключаемогоМодуля("ПослеПроверкиСообщенияEDI",,Новый Структура("Сообщение,ТаблицаОшибок",Сообщение,ТаблицаОшибок));
	
	Возврат ТаблицаОшибок;
	
КонецФункции

Процедура ПроверитьДанныеОбУпаковках_КонтурEDI(Сообщение, ТаблицаОшибок)
	
	Если НЕ Сообщение.ТипСообщения = "DESADV" 
		И НЕ Сообщение.ТипСообщения = "INVOIC"
		И НЕ Сообщение.ТипСообщения = "COINVOIC" Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ОтправлятьДанныеОбУпаковках = ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Получатель1С, "ОтправлятьДанныеОбУпаковках") = Истина;
	
	Если ОтправлятьДанныеОбУпаковках 
		И СообщениеСодержитТранспортныеУпаковки(Сообщение) Тогда
		
		// проверим наличие "пустых" упаковок
		Для Каждого Упаковка Из Сообщение.ТранспортныеУпаковки.Строки Цикл
			
			Если Упаковка.Строки.Количество() = 0 Тогда
				
				ТекстОшибки = "В упаковку " + Упаковка.СоставУпаковки + " не размещен ни один товар.";
				ЗафиксироватьОшибку(ТаблицаОшибок, , "ТранспортныеУпаковки", , ТекстОшибки, Истина);
				
			КонецЕсли;
			
		КонецЦикла;
		
		КоличествоТовараВТранспортныхУпаковках = Сообщение.ТранспортныеУпаковки.Строки.Итог("Количество", Ложь);
		КоличествоТовараВТЧТовары = Сообщение.Товары.Итог("Количество");
		
		Если НЕ КоличествоТовараВТранспортныхУпаковках = КоличествоТовараВТЧТовары Тогда
			
			ТекстОшибки = "Не все товарные позиции размещены по транспортным упаковкам.";
			ЗафиксироватьОшибку(ТаблицаОшибок, , "ТранспортныеУпаковки", , ТекстОшибки, Истина);
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьКодыМаркировки_КонтурEDI(Сообщение, ТаблицаОшибок)
	
	Если Не ОтправлятьКодыМаркировки(Сообщение) Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоКодовМаркировки = 0;
	СписокВсехКодовМаркировки = Новый СписокЗначений;
	СписокКодовИзТаблицыУпаковок = Новый СписокЗначений;
	
	ИменаПолейКодовМаркировки = Новый Массив;
	ИменаПолейКодовМаркировки.Добавить("КодыМаркировки");
	ИменаПолейКодовМаркировки.Добавить("КодыМаркировкиДо");
	ИменаПолейКодовМаркировки.Добавить("КодыМаркировкиПосле");	
		
	Для каждого СтрокаТоваров Из Сообщение.Товары Цикл
		Для каждого ИмяПоля Из ИменаПолейКодовМаркировки Цикл
			
			КодыМаркировки = Неопределено;
			
			Если Не ПеременнаяСодержитСвойство(СтрокаТоваров, ИмяПоля, КодыМаркировки, Истина) Тогда
				Продолжить;
			КонецЕсли;
		
			Для каждого КодМаркировки Из КодыМаркировки Цикл
			
				Если Не ЗначениеЗаполнено(КодМаркировки.Значение) Тогда
					ТекстОшибки = "В списке кодов маркировки в строке " + СтрокаТоваров.НомерСтроки + " содержится пустой код маркировки";
					ЗафиксироватьОшибку(ТаблицаОшибок, , "Товары",СтрокаТоваров.НомерСтроки,ТекстОшибки,Истина);
				КонецЕсли;
			
				СписокВсехКодовМаркировки.Добавить(КодМаркировки.Значение,КодМаркировки.Представление);
			
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	КоличествоКодовМаркировки = СписокВсехКодовМаркировки.Количество();
	
	ДеревоУпаковок = Неопределено;
	Если ПеременнаяСодержитСвойство(Сообщение, "ТранспортныеУпаковки", ДеревоУпаковок, Истина)
		И ДеревоУпаковок.Строки.Количество() > 0 Тогда
		
		КоличествоКодовМаркировкиВУпаковках = 0;
		
		Для каждого СтрокаУпаковки Из ДеревоУпаковок.Строки Цикл
			Для каждого СтрокаТовара Из СтрокаУпаковки.Строки Цикл
				
				Если Не ЗначениеЗаполнено(СтрокаТовара.КодыМаркировки) Тогда
					Продолжить;
				КонецЕсли;
				
				КоличествоКодовМаркировкиВУпаковках = КоличествоКодовМаркировкиВУпаковках + СтрокаТовара.КодыМаркировки.Количество();
				
			КонецЦикла;
		КонецЦикла;
		
		Если КоличествоКодовМаркировки > КоличествоКодовМаркировкиВУпаковках Тогда
			
			ТекстОшибки = "Не все коды маркировки распределены по упаковкам";
			ЗафиксироватьОшибку(ТаблицаОшибок,"КодыМаркировкиВУпаковках","Товары",,ТекстОшибки,Истина);
			
		КонецЕсли;
		
		Если КоличествоКодовМаркировки < КоличествоКодовМаркировкиВУпаковках Тогда
			
			ТекстОшибки = "Обнаружено расхождение между кодами маркировки в таблице товаров и кодами маркировки в таблице упаковок. 
						   |Необходимо повторно распределить коды маркировки по упаковкам.";
			ЗафиксироватьОшибку(ТаблицаОшибок,"КодыМаркировкиВУпаковках","Товары",,ТекстОшибки,Истина);
			
		КонецЕсли
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьКонтрольЗаполненияОсобенностейСообщения(Сообщение,ОбязательныеПоля)

	Для каждого ОсобенностьСообщения Из ОсобенностиСообщений Цикл
		//проверка что подходит партнер
		Если НЕ ОсобенностьЕстьВСообщении(ОсобенностьСообщения,Сообщение)
			Тогда
			Продолжить;
		КонецЕсли;
		Если ЭтоОсобенностьСложногоТипа(ОсобенностьСообщения.ТипЗначенияEDI) Тогда
			Продолжить;
		КонецЕсли;
		Если ОсобенностьСообщения.НеОтправлятьДанные Тогда
			Продолжить;
		КонецЕсли;

		Если ОсобенностьСообщения.ВалидироватьЗаполнение Тогда
			
			Если ЭтоОсобенностьТоваров(ОсобенностьСообщения) Тогда
				
				ПолныйПутьОсобенности = ПолныйИдентификаторОсобенностиТоваров(ОсобенностьСообщения);
				
				Если Найти(ПолныйПутьОсобенности, "Товары.") = 0 Тогда
					ПолныйПутьОсобенности = "Товары." + ПолныйПутьОсобенности;	
				КонецЕсли;
			Иначе
 				ПолныйПутьОсобенности = ПолучитьПолныйПутьОсобенностиСообщения(ОсобенностьСообщения);
			КонецЕсли;
			
			ДобавитьОбязательноеПоле(ОбязательныеПоля, ПолныйПутьОсобенности);
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьСвязанныеСправочникиТочкиДоставкиНаПовтор(Партнер,ЗНАЧ ТекущаяТочкаДоставки,ТаблицаОшибок,ЗНАЧ СвязанныйСправочник1,ЗНАЧ СвязанныйСправочник2) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ПолучитьКонстантуEDI("СвойСправочникТочекДоставки")) Тогда //нам необходимо отделять одну тд от другой по юр лицу (связ спр 1)
		
		Если ЗначениеЗаполнено(СвязанныйСправочник1) Тогда 
		
			//найдем любую другую ТД по этой ссылке	
			НайденнаяТД = НайтиОбъектПоЗначениюСвойства("ЮрФизЛицо_ТочкиДоставки",СвязанныйСправочник1);
			
			Если ЗначениеЗаполнено(НайденнаяТД) И НайденнаяТД<>ТекущаяТочкаДоставки Тогда
				НайденнаяТДСтруктура = ПолучитьЭлементСправочника("ТочкиДоставкиСторонние",НайденнаяТД);
				ТекстОшибки="Указанное юр./физ. лицо уже поставлено в соответствие точке доставки: "+НайденнаяТДСтруктура.Наименование+Символы.ПС+"Партнер: "+ПреобразоватьЗначениеДляВнешнегоХранилища(НайденнаяТДСтруктура.Партнер).Наименование;
				ЗафиксироватьОшибку(ТаблицаОшибок,"ЮрФизЛицо","",0,ТекстОшибки);
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		//здесь надо проверять в пределах партнера т.к. возможна ситуация когда у 2х ТД разных ТС одинаковое значение СвязанныйСправочник2 
		//проверим  СвязанныйСправочник2
		Если ЗначениеЗаполнено(СвязанныйСправочник2) Тогда 
			Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			               |	КонтурEDI_ТочкиДоставки.Ссылка,
			               |	КонтурEDI_ТочкиДоставки.Партнер
			               |ИЗ
			               |	Справочник.КонтурEDI_ТочкиДоставки КАК КонтурEDI_ТочкиДоставки
			               |ГДЕ
			               |	НЕ КонтурEDI_ТочкиДоставки.ПометкаУдаления
			               |	И КонтурEDI_ТочкиДоставки.СвязанныйСправочник2 = &СвязанныйСправочник2
			               |	И КонтурEDI_ТочкиДоставки.Партнер = &Партнер";
			
			Запрос.УстановитьПараметр("СвязанныйСправочник2", ПреобразоватьЗначениеДляВнешнегоХранилища(СвязанныйСправочник2));
			Запрос.УстановитьПараметр("Партнер", Партнер);
			Если ПолучитьКонстантуEDI("СвойСправочникТочекДоставки") = "ВидыКонтактнойИнформации" Тогда
				Запрос.Текст = Запрос.Текст + Символы.ПС + "	И КонтурEDI_ТочкиДоставки.СвязанныйСправочник1 = &СвязанныйСправочник1";
				Запрос.УстановитьПараметр("СвязанныйСправочник1", СвязанныйСправочник1);
			КонецЕсли;
			
			Результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			ЕстьОшибкаСвязанногоСправочника2 = Ложь;
			Пока Выборка.Следующий()Цикл 
				Если Выборка.Ссылка<>ТекущаяТочкаДоставки Тогда
					ТекстОшибки="Указанное значения ""своей"" точки доставки уже поставлено в соответствие точке доставки: "+Выборка.Ссылка+Символы.ПС+"Партнер: "+Партнер;
					ЗафиксироватьОшибку(ТаблицаОшибок,"ЮрФизЛицо","",0,ТекстОшибки);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

