Функция МетрикаКонтур_НовыйСобытие(Категория, Действие, Знач GLN = Неопределено)

	СобытиеПуть = МетрикаКонтур_НовыйПутьСобытия(Категория, Действие);
	Результат = МетрикаКонтур_НовыйМетрика(СобытиеПуть);
	
	AppContext = МетрикаКонтур_НовыйAppContext();
	Session = МетрикаКонтур_НовыйSession();
	ClientInfo = МетрикаКонтур_НовыйClientInfo();
	
	Если ЗначениеЗаполнено(GLN) Тогда
		
		Marker = Неопределено;
		
		РеквизитыОрганизации = РеквизитыОрганизацииПоGLN_КонтурEDI(GLN);
		
		Если ЗначениеЗаполнено(РеквизитыОрганизации.ИНН) Тогда
			Marker = КонтурСтандарт_ПодставитьПараметрыВСтроку("%1-%2", РеквизитыОрганизации.ИНН, РеквизитыОрганизации.КПП); 	
		КонецЕсли;
	
		NormativeSession = МетрикаКонтур_НовыйNormativeSession(Marker, GLN);
		Session.Вставить("NormativeSession", NormativeSession);
		
	КонецЕсли;
		
	Результат["AppContext"] = AppContext;
	Результат["Session"] = Session;
	Результат["ClientInfo"] = ClientInfo;
	
	Возврат Результат;
	
КонецФункции

