		|	И КонтурEDI_СообщенияДополнительныеРеквизиты.Значение В (&Метки)";
		
		Запрос.УстановитьПараметр("Метки", МассивМетки);
		
	//ИначеЕсли Условие = "НЕ" Тогда
	//	
	//	Запрос.Текст = 
	//	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	//	|	КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка КАК Ссылка
	//	|ИЗ
	//	|	Справочник.КонтурEDI_Сообщения.ДополнительныеРеквизиты КАК КонтурEDI_СообщенияДополнительныеРеквизиты
	//	|ГДЕ
	//	|	КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка.ПометкаУдаления = ЛОЖЬ
	//	|	И КонтурEDI_СообщенияДополнительныеРеквизиты.ИмяРеквизита = ""Метка""
	//	|	И КонтурEDI_СообщенияДополнительныеРеквизиты.Значение НЕ В (&Метки)";
	//	
	//	Запрос.УстановитьПараметр("Метки", МассивМетки);  
		
	ИначеЕсли Условие = "И" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка КАК Ссылка,
		|	КонтурEDI_СообщенияДополнительныеРеквизиты.Значение КАК Значение
		|ПОМЕСТИТЬ ВТ_СообщенияСМетками
		|ИЗ
		|	Справочник.КонтурEDI_Сообщения.ДополнительныеРеквизиты КАК КонтурEDI_СообщенияДополнительныеРеквизиты
		|ГДЕ
		|	КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка.ПометкаУдаления = ЛОЖЬ
		|	И КонтурEDI_СообщенияДополнительныеРеквизиты.ИмяРеквизита = ""Метка""
		|	И КонтурEDI_СообщенияДополнительныеРеквизиты.Значение В(&Метки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СообщенияСМетками.Ссылка КАК Ссылка,
		|	СУММА(1) КАК КоличествоСовпадений
		|ПОМЕСТИТЬ ВТ_Совпадения
		|ИЗ
		|	ВТ_СообщенияСМетками КАК ВТ_СообщенияСМетками
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_СообщенияСМетками.Ссылка
