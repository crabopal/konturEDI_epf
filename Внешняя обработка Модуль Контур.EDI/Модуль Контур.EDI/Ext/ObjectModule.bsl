	|		ПО (ВТ_ПредварительнаяОтправитьСообщения_.ТипСообщения = ""INVOIC"")
	|			И (ВТ_ПредварительнаяОтправитьСообщения_.INVOICНеБлокируетсяПредыдущимиСообщениями = ИСТИНА)
	|			И (НЕ ВТ_ПредварительнаяОтправитьСообщения_.ДокументЦепочкиORDERS ЕСТЬ NULL)
	|			И ВТ_ПредварительнаяОтправитьСообщения_.ДокументЦепочкиORDERS = КонтурEDI_Сообщения_Блокирующие.Документ
	|			И (КонтурEDI_Сообщения_Блокирующие.ТипСообщения = ""ORDERS"")
	|			И (КонтурEDI_Сообщения_Блокирующие.ОтклоненоОтправителем = ИСТИНА)
	|ГДЕ
	|	КонтурEDI_Сообщения_Блокирующие.Ссылка ЕСТЬ NULL";
	
	ЗапросСКэшемПартнеров.УстановитьПараметр("ДействиеЕслиНеПроведен",ДействиеЕслиНеПроведен);
	ЗапросСКэшемПартнеров.УстановитьПараметр("ДействиеЕслиПроведен",ДействиеЕслиПроведен);
	ЗапросСКэшемПартнеров.УстановитьПараметр("ТребоватьПроведение",ТребоватьПроведение);
	ЗапросСКэшемПартнеров.УстановитьПараметр("ТипСообщенияДляОтправки",ТипСообщения);
	
	Направление = ПолучитьНаправлениеСообщения(ТипСообщения,РежимРаботы); 
	
	ЗапросСКэшемПартнеров.УстановитьПараметр("НаправлениеСообщения",Направление);
	
	ТекстТребуемоеДействие = ПолучитьТекстТребуемыхДействийСписокДокументов_ДляОтправкиОжиданияСообщений(ТипСообщения, ТипДокумента, Направление, РежимРаботы, ТребоватьПроведение);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ТекстТребуемоеДействие", ТекстТребуемоеДействие);	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ПолеТипаСообщенияДляОтправки","ВТ_ДокументыДляОтправки."+ТипСообщения);
	
	Если ТипСообщения="ORDERS" И РежимРаботы = "Покупатель" Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ПолеБлокирующегоСообщения","""""");
		//в режиме торговой сети нам не нужен входящий PORDERS, чтобы отправить уже существующий ЗаказПоставщику
	ИначеЕсли ТипСообщения="ORDERS" И РежимРаботы = "Поставщик" Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ПолеБлокирующегоСообщения",
		"Выбор Когда ВТ_ДокументыДляОтправки.PORDERS Тогда ""PORDERS"" Иначе ""___"" Конец"
		//для случаев, когда в цепочке нет PORDERS, в качестве "блокирующего" сообщения будем указывать несуществующий тип
		//костыль связан с тем, что PORDERS является "не очень обязательным" сообщением
		);
	ИначеЕсли ТипСообщения="RETANN" И РежимРаботы = "Покупатель" Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ПолеБлокирующегоСообщения","""""");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ПолеБлокирующегоСообщения","ВТ_ДокументыДляОтправки.СообщениеБлокирующее"+ТипСообщения);
	КонецЕсли;	

	Если Найти("RETANN,RETINS,RETDES,RETREC", ТипСообщения) > 0 Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ВТ_ДокументыДляОтправки.INVOICНеБлокируетсяПредыдущимиСообщениями","ЛОЖЬ");
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВТ_ДокументыДляОтправки"				, "ВТ_" + ТипДокумента);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ОтправляемыйДокумент"					, "Док_" + ТипДокумента);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВТ_ПредварительнаяОтправитьСообщения_", "ВТ_ПредварительнаяОтправитьСообщения_" + ТипСообщения);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВТ_ОтправитьСообщения_"				, "ВТ_ОтправитьСообщения_" + ТипСообщения);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВТ_НеотправленныеСообщения"			, "ВТ_НеотправленныеСообщения_" + ТипСообщения);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВТ_Сообщения_УжеСуществующие"			, "ВТ_Сообщения_УжеСуществующие_" + ТипСообщения);
	
	ЗаменитьНазванияТаблицВТекстеЗапроса(ТекстЗапроса,РежимРаботы);
	
	СтрокиДляЗамены = ТаблицаТипов.НайтиСтроки(Новый Структура("Сторона",РежимРаботы));
	Для Каждого Стр Из СтрокиДляЗамены Цикл
		ТипДокумента = СтрЗаменить(Стр.ИмяТипа,"ДокументСсылка.","");
		
		Если ПолучитьМассивПредыдущихСообщений(ТипСообщения).Найти(Стр.ТипСообщения)<>Неопределено Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ДокументЦепочки_"+Стр.ТипСообщения,"Док_"+ТипДокумента);
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ДокументЦепочки_"+Стр.ТипСообщения,"NULL");
		КонецЕсли;	
	КонецЦикла;
	
	ЗаменитьСсылкиДляВнешнегоХранилищаВЗапросе(ЗапросСКэшемПартнеров.Текст);
	
	МассивВременныхТаблиц.Добавить("ВТ_ОтправитьСообщения_"+ТипСообщения);
	
	ЗапросСКэшемПартнеров.Текст = ТекстЗапроса;
	
	ЗапросСКэшемПартнеров.Выполнить();
	
КонецПроцедуры

Функция ПолучитьТекстТребуемыхДействийСписокДокументов_ДляОтправкиОжиданияСообщений(ТипСообщения, ТипДокумента, Направление, РежимРаботы, ТребоватьПроведение)

	ПредставлениеСообщения = ПеревестиТипСообщенияДляДействия(ТипСообщения);
	
	ДействиеЕслиПроведенПредварительный	= """""";// Только для ORDRSP.
	ДействиеЕслиНеПроведенПредварительный = """""";
	ДействиеЕслиПроведен = """""";
	ДействиеЕслиНеПроведен = """""";
	
	//еще надо определить, входящее у нас сообщение или исходящее
	Если Направление = "Входящее" Тогда  		
		ДействиеЕслиПроведен = """Ожидайте " + ПредставлениеСообщения + """";//временно убрать фильтр.   			
	Иначе	                                                                                  		
		ДействиеЕслиПроведен = """Отправить " + ПредставлениеСообщения + """";//временно убрать фильтр.		
		Если ТипСообщения = "ORDRSP" Тогда
			ДействиеЕслиПроведенПредварительный = """Отправить подтверждение предварительного заказа""";//Только для ORDRSP.
		КонецЕсли;  		                                                                  		
	КонецЕсли;	
	
	НеПроводитьДокументВМодуле = (ПолучитьКонстантуEDI("НПД_"+ТипДокумента)=Истина);
	
	Если ТребоватьПроведение Тогда
		СинонимДокумента = Метаданные.Документы[ТипДокумента].Синоним;
		Если НеПроводитьДокументВМодуле Тогда
			ДействиеЕслиНеПроведен = """Ожидается проведение: " + СинонимДокумента + """";
			ДействиеЕслиНеПроведенПредварительный	= """Ожидается проведение предварительного: " + СинонимДокумента + """";
		Иначе	
			ДействиеЕслиНеПроведен = """Провести " + СинонимДокумента + """";
			ДействиеЕслиНеПроведенПредварительный	= """Провести предварительный " + СинонимДокумента + """";
		КонецЕсли;	
	КонецЕсли;
	
	ТекстТребуемыхДействий = "
	|   ВЫБОР
	|   	КОГДА &ТипСообщенияДляОтправки = ""ORDRSP"" И КонтурEDI_Сообщения_Блокирующие.Статус ПОДОБНО ""%ПредварительныйЗаказ""
	|		ТОГДА 
	|			ВЫБОР
	|				КОГДА &ТребоватьПроведение 
	|					И НЕ ВТ_НеотправленныеСообщения.Док_Проведен 
	|				ТОГДА &ДействиеЕслиНеПроведенПредварительный
	|			ИНАЧЕ &ДействиеЕслиПроведенПредварительный
	|			КОНЕЦ
	|		ИНАЧЕ
	|			ВЫБОР
	|				КОГДА &ТребоватьПроведение 
	|					И НЕ ВТ_НеотправленныеСообщения.Док_Проведен
	|				ТОГДА &ДействиеЕслиНеПроведен
	|			ИНАЧЕ &ДействиеЕслиПроведен
	|			КОНЕЦ
	|   КОНЕЦ";
	
	ТекстТребуемыхДействий = СтрЗаменить(ТекстТребуемыхДействий, "&ДействиеЕслиНеПроведенПредварительный", ДействиеЕслиНеПроведенПредварительный);
	ТекстТребуемыхДействий = СтрЗаменить(ТекстТребуемыхДействий, "&ДействиеЕслиПроведенПредварительный", ДействиеЕслиПроведенПредварительный);
	ТекстТребуемыхДействий = СтрЗаменить(ТекстТребуемыхДействий, "&ДействиеЕслиНеПроведен", ДействиеЕслиНеПроведен);
	ТекстТребуемыхДействий = СтрЗаменить(ТекстТребуемыхДействий, "&ДействиеЕслиПроведен", ДействиеЕслиПроведен);
	
	Возврат ТекстТребуемыхДействий;
	
КонецФункции 

//Отдельная процедура для задач ожидания входящих DELFOR 
Процедура СформироватьСписокДляОжиданияВходящихDELFOR(ЗапросСКэшемПартнеров, МассивВременныхТаблиц)
		
	Действие = "Ожидайте согласования графика поставок";
	ТипСообщения = "DELFOR";
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтурEDI_Сообщения.Ссылка КАК Ссылка,
		|	КонтурEDI_Сообщения.НомерДокумента КАК НомерДокумента,
		|	КонтурEDI_Сообщения.ДатаДокумента КАК ДатаДокумента,
		|	КонтурEDI_Сообщения.Партнер КАК Партнер,
		|	КонтурEDI_Сообщения.НомерЗаказа КАК НомерЗаказа,
		|	КонтурEDI_Сообщения.ДатаЗаказа КАК ДатаЗаказа
		|ПОМЕСТИТЬ ОтправленныеСообщения
		|ИЗ
		|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
		|ГДЕ
		|	КонтурEDI_Сообщения.Направление = ""Исходящее""
		|	И КонтурEDI_Сообщения.ТипСообщения = &ТипСообщения
		|	И КонтурEDI_Сообщения.Архив = ИСТИНА
		|	И КонтурEDI_Сообщения.ДатаДокумента МЕЖДУ &НачалоПериода И &КонецПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОтправленныеСообщения.Ссылка КАК Ссылка,
		|	ОтправленныеСообщения.НомерДокумента КАК НомерДокумента,
		|	ОтправленныеСообщения.ДатаДокумента КАК ДатаДокумента,
		|	ОтправленныеСообщения.Партнер КАК Партнер,
		|	ОтправленныеСообщения.НомерЗаказа КАК НомерЗаказа,
		|	ОтправленныеСообщения.ДатаЗаказа КАК ДатаЗаказа
		|ПОМЕСТИТЬ ОтправленныеСообщенияНезавершенныхЦепочек
		|ИЗ
		|	ОтправленныеСообщения КАК ОтправленныеСообщения
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_Сообщения КАК ПринятыеСообщения
		|		ПО (ПринятыеСообщения.Направление = ""Входящее"")
		|			И (ПринятыеСообщения.ТипСообщения = &ТипСообщения)
		|			И ОтправленныеСообщения.НомерДокумента = ПринятыеСообщения.НомерДокумента
		|			И ОтправленныеСообщения.ДатаДокумента = ПринятыеСообщения.ДатаДокумента
		|			И ОтправленныеСообщения.НомерЗаказа = ПринятыеСообщения.НомерЗаказа
		|			И ОтправленныеСообщения.ДатаЗаказа = ПринятыеСообщения.ДатаЗаказа
		|			И ОтправленныеСообщения.Партнер = ПринятыеСообщения.Партнер
		|ГДЕ
		|	ПринятыеСообщения.Ссылка ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОтправленныеСообщенияНезавершенныхЦепочек.Ссылка.Партнер КАК Партнер,
		|	НЕОПРЕДЕЛЕНО КАК Документ,
		|	ОтправленныеСообщенияНезавершенныхЦепочек.Ссылка.ТипСообщения КАК ТипСообщения,
		|	&Действие КАК ТребуемоеДействие,
		|	"""" КАК СтатусДокумента,
		|	ОтправленныеСообщенияНезавершенныхЦепочек.Ссылка.Направление КАК Направление,
		|	0 КАК СуммаДокумента,
		|	0 КАК СуммаСообщения,
		|	ОтправленныеСообщенияНезавершенныхЦепочек.Ссылка КАК Сообщение,
		|	0 КАК ХронологияСообщения
		|ПОМЕСТИТЬ ВТ_ОтправитьСообщения_
		|ИЗ
		|	ОтправленныеСообщенияНезавершенныхЦепочек КАК ОтправленныеСообщенияНезавершенныхЦепочек
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Документ,
		|	Сообщение";

	ЗапросСКэшемПартнеров.УстановитьПараметр("ТипСообщения", ТипСообщения);
	ЗапросСКэшемПартнеров.УстановитьПараметр("Действие", Действие);
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ВТ_ОтправитьСообщения_","ВТ_ОтправитьСообщения_" + ТипСообщения);
	
	МассивВременныхТаблиц.Добавить("ВТ_ОтправитьСообщения_" + ТипСообщения);
	
	ЗапросСКэшемПартнеров.Текст = ТекстЗапроса;
	
	ЗапросСКэшемПартнеров.Выполнить();
	
КонецПроцедуры

//универсальная процедура для вывода треб.действия "Создать документ" - и со стороны ТС, и со стороны поставщика
Процедура СформироватьСписокДокументов_ДляСозданияСледующего(РежимРаботы,ЗапросСКэшемПартнеров,МассивВременныхТаблиц,ТипСообщения,ИмяТекущегоДокумента,ИмяСоздаваемогоДокумента, ТипПредыдущегоСообщения = "")

	СоздаватьПоНепроведенномуОснованию 	= (ПолучитьКонстантуEDI("СПНО_"+ИмяСоздаваемогоДокумента)=Истина);
	НеСоздаватьДокументВМодуле 			= (ПолучитьКонстантуEDI("НСД_"+ИмяСоздаваемогоДокумента)=Истина);
	НеПроводитьДокументОснованиеВМодуле = (ПолучитьКонстантуEDI("НПД_"+ИмяТекущегоДокумента)=Истина);

	//Если стоит флаг "Не создавать в модуле" и одновременно "Создавать по непроведенному", то флаг "Не создавать в модуле" приоритетнее
	СинонимСоздаваемогоДокумента = Метаданные.Документы[ИмяСоздаваемогоДокумента].Синоним;
	
	ДействиеЕслиНеПроведен 	= "";
	ДействиеЕслиПроведен 	= "";
	
	Если СоздаватьПоНепроведенномуОснованию Тогда
		Если НеСоздаватьДокументВМодуле Тогда
			ДействиеЕслиНеПроведен 	= "Ожидается создание: " + СинонимСоздаваемогоДокумента;
		Иначе
			ДействиеЕслиНеПроведен 	= "Создать " + СинонимСоздаваемогоДокумента;
		КонецЕсли;
	Иначе
		СинонимТекущегоДокумента = Метаданные.Документы[ИмяТекущегоДокумента].Синоним;
		Если НеПроводитьДокументОснованиеВМодуле Тогда
			ДействиеЕслиНеПроведен 	= "Ожидается проведение: " + СинонимТекущегоДокумента;
		Иначе
			ДействиеЕслиНеПроведен 	= "Провести " + СинонимТекущегоДокумента;
		КонецЕсли;
		Если НеСоздаватьДокументВМодуле Тогда
			ДействиеЕслиПроведен 	= "Ожидается создание: " + СинонимСоздаваемогоДокумента;
		Иначе	
			ДействиеЕслиПроведен 	= "Создать " + СинонимСоздаваемогоДокумента;
		КонецЕсли;
	КонецЕсли;
			
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ДокументыДляОтправки.Партнер КАК Партнер,
	|	ВТ_ДокументыДляОтправки.ОтправляемыйДокумент КАК ДокументДляОтправки,
	|	ВТ_ДокументыДляОтправки.СуммаДокумента КАК СуммаДокумента,
	|	NULL КАК СуммаСообщения,
	|	ВТ_ДокументыДляОтправки.PORDERS,
	|	ВТ_ДокументыДляОтправки.ORDERS,
	|	ВТ_ДокументыДляОтправки.ORDRSP,
	|	ВТ_ДокументыДляОтправки.DESADV,
	|	ВТ_ДокументыДляОтправки.RECADV,
	|	ВТ_ДокументыДляОтправки.INVOIC,
	|	ВТ_ДокументыДляОтправки.Док_Проведен КАК Док_Проведен,
	|	&ПолеБлокирующегоСообщения КАК ТипПредыдущегоСообщения,
	|	ВЫБОР
	|		КОГДА &ПолеБлокирующегоСообщения = ""PORDERS""
	|			ТОГДА &ДокументЦепочки_PORDERS
	|		КОГДА &ПолеБлокирующегоСообщения = ""ORDERS""
	|			ТОГДА &ДокументЦепочки_ORDERS
	|		КОГДА &ПолеБлокирующегоСообщения = ""ORDRSP""
	|			ТОГДА &ДокументЦепочки_ORDRSP
	|		КОГДА &ПолеБлокирующегоСообщения = ""DESADV""
	|			ТОГДА &ДокументЦепочки_DESADV
	|		КОГДА &ПолеБлокирующегоСообщения = ""RECADV""
	|			ТОГДА &ДокументЦепочки_RECADV
	|		КОГДА &ПолеБлокирующегоСообщения = ""INVOIC""
	|			ТОГДА &ДокументЦепочки_INVOIC
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК ПредыдущийДокументЦепочки,
	|	&СледующийДокументЦепочки КАК СледующийДокументЦепочки,
	|	ВТ_ДокументыДляОтправки.INVOICНеБлокируетсяПредыдущимиСообщениями
	|ПОМЕСТИТЬ ВТ_ОтсутствующиеДокументы
	|ИЗ
	|	ВТ_ДокументыДляОтправки КАК ВТ_ДокументыДляОтправки
	|ГДЕ
	|	&СледующийДокументЦепочки ЕСТЬ NULL
	|	И &УсловиеНаСледующийТип
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Партнер,
	|	ДокументДляОтправки,
	|	ПредыдущийДокументЦепочки,
	|	ТипПредыдущегоСообщения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ОтсутствующиеДокументы.Партнер,
	|	ВТ_ОтсутствующиеДокументы.ДокументДляОтправки КАК Документ,
	|	&ТипСообщенияДляОтправки КАК ТипСообщения,
	|	ВЫБОР
	|		КОГДА &ТребоватьПроведение
	|				И НЕ ВТ_ОтсутствующиеДокументы.Док_Проведен
	|			ТОГДА &ДействиеЕслиНеПроведен
	|		КОГДА &ТребоватьПроведение
	|				И ВТ_ОтсутствующиеДокументы.Док_Проведен
	|			ТОГДА &ДействиеЕслиПроведен
	|		КОГДА НЕ &ТребоватьПроведение
	|			ТОГДА &ДействиеЕслиНеПроведен
	|	КОНЕЦ КАК ТребуемоеДействие,
	|	"""" КАК СтатусДокумента,
	|	ВТ_ОтсутствующиеДокументы.СуммаДокумента,
	|	ВТ_ОтсутствующиеДокументы.СуммаСообщения,
	|	КонтурEDI_Сообщения_Блокирующие.Ссылка КАК Сообщение
	|ПОМЕСТИТЬ ВТ_СоздатьДокументы_
	|ИЗ
	|	ВТ_ОтсутствующиеДокументы КАК ВТ_ОтсутствующиеДокументы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения_Блокирующие
	|		ПО ВТ_ОтсутствующиеДокументы.ТипПредыдущегоСообщения = КонтурEDI_Сообщения_Блокирующие.ТипСообщения
	|			И ВТ_ОтсутствующиеДокументы.ПредыдущийДокументЦепочки = КонтурEDI_Сообщения_Блокирующие.Документ
	|			И (КонтурEDI_Сообщения_Блокирующие.Архив
	|				ИЛИ (&ТипСообщенияДляОтправки = ""INVOIC""
	|					И ВТ_ОтсутствующиеДокументы.INVOICНеБлокируетсяПредыдущимиСообщениями = ИСТИНА))
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ВТ_ОтсутствующиеДокументы.ТипПредыдущегоСообщения = """"
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ КонтурEDI_Сообщения_Блокирующие.Ссылка ЕСТЬ НЕ NULL 
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА КонтурEDI_Сообщения_Блокирующие.Партнер ЕСТЬ NULL
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ВЫБОР
	|					КОГДА КонтурEDI_Сообщения_Блокирующие.Партнер = ЗНАЧЕНИЕ(Справочник.КонтурEDI_ДополнительныеСправочники.ПустаяССылка)
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ КонтурEDI_Сообщения_Блокирующие.Партнер = ВТ_ОтсутствующиеДокументы.Партнер
	|				КОНЕЦ
	|		КОНЕЦ
	|	И ВЫБОР 
	|		КОГДА КонтурEDI_Сообщения_Блокирующие.Статус ЕСТЬ NULL
	|			ТОГДА ИСТИНА
	|			ИНАЧЕ НЕ КонтурEDI_Сообщения_Блокирующие.Статус ПОДОБНО ""%ПредварительныйЗаказ""
	|		КОНЕЦ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Документ,
	|	Сообщение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ОтсутствующиеДокументы"
	;
	
	ЗапросСКэшемПартнеров.УстановитьПараметр("ДействиеЕслиНеПроведен",				ДействиеЕслиНеПроведен);
	ЗапросСКэшемПартнеров.УстановитьПараметр("ДействиеЕслиПроведен",				ДействиеЕслиПроведен);
	ЗапросСКэшемПартнеров.УстановитьПараметр("ТребоватьПроведение",					Не СоздаватьПоНепроведенномуОснованию);
	ЗапросСКэшемПартнеров.УстановитьПараметр("ТипСообщенияДляОтправки",				ТипСообщения); 
			
	Если ТипСообщения = "DESADV" Тогда
		ТекстУсловия = "(ВТ_ДокументыДляОтправки.DESADV ИЛИ ВТ_ДокументыДляОтправки.RECADV ИЛИ ВТ_ДокументыДляОтправки.INVOIC)";		
	Иначе
		ТекстУсловия = "ВТ_ДокументыДляОтправки."+ТипСообщения;
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ДокументЦепочки_ТипПредыдущегоСообщения", ?(ЗначениеЗаполнено(ТипПредыдущегоСообщения),"&ДокументЦепочки_" + ТипПредыдущегоСообщения,"&ДокументЦепочки_" + ТипСообщения));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ПолеТипаСообщенияДляОтправки",ТекстУсловия);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ПолеБлокирующегоСообщения",?(ТипСообщения = "INVOIC","ВТ_ДокументыДляОтправки.СообщениеПредыдущее"+ТипСообщения,"ВТ_ДокументыДляОтправки.СообщениеБлокирующее"+ТипСообщения));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&СледующийДокументЦепочки","ВТ_ДокументыДляОтправки.Док_"+ИмяСоздаваемогоДокумента);
	
	ТипДокумента = ПолучитьНазваниеТипаДокументаПоТипуСообщения(ТипСообщения,РежимРаботы);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ВТ_ДокументыДляОтправки","ВТ_"+ИмяТекущегоДокумента);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ОтправляемыйДокумент","Док_"+ИмяТекущегоДокумента);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ВТ_СоздатьДокументы_","ВТ_СоздатьДокументы_"+ИмяСоздаваемогоДокумента);

	ЗаменитьНазванияТаблицВТекстеЗапроса(ТекстЗапроса,РежимРаботы);
	
	УсловиеНаСледующийТип = "(ВТ_" + ИмяТекущегоДокумента + "." + ТипСообщения;
	
	ТипыСообщенийОсновнойЦепочки = Новый Массив;
	ТипыСообщенийОсновнойЦепочки.Добавить("ORDERS");
	ТипыСообщенийОсновнойЦепочки.Добавить("ORDRSP");
	ТипыСообщенийОсновнойЦепочки.Добавить("DESADV");
	ТипыСообщенийОсновнойЦепочки.Добавить("RECADV");
	ТипыСообщенийОсновнойЦепочки.Добавить("INVOIC");
	
	НачатьФормированиеУсловияНаСледущийТип = Ложь;
	
	НайденныеСтроки = ТаблицаТипов.НайтиСтроки(Новый Структура("Сторона", РежимРаботы));
	ТаблицаТиповДляРежимаРаботы = ТаблицаТипов.Скопировать(НайденныеСтроки);
	ТаблицаТиповДляРежимаРаботы.Сортировать("ПорядокСообщения");
	
	Для Каждого Стр Из ТаблицаТиповДляРежимаРаботы Цикл
		
		Если Стр.ПорядокСообщения = -1 Тогда
			Продолжить;//костыль для RETANN
		КонецЕсли;
		
		Если НачатьФормированиеУсловияНаСледущийТип
			И Стр.Направление = "Исходящее"
			И ТипыСообщенийОсновнойЦепочки.Найти(Стр.ТипСообщения) <> Неопределено Тогда
			
			УсловиеНаСледующийТип = УсловиеНаСледующийТип + Символы.ПС + "ИЛИ ВТ_" + ИмяТекущегоДокумента + "." + Стр.ТипСообщения;
			
		КонецЕсли;
		
		Если ТипСообщения = Стр.ТипСообщения  Тогда
			НачатьФормированиеУсловияНаСледущийТип = Истина;
		КонецЕсли;
				
		ТипДокумента = СтрЗаменить(Стр.ИмяТипа,"ДокументСсылка.","");
		
		Если ПолучитьМассивПредыдущихСообщений(ТипСообщения).Найти(Стр.ТипСообщения)<>Неопределено Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ДокументЦепочки_"+Стр.ТипСообщения,"Док_"+ТипДокумента);
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ДокументЦепочки_"+Стр.ТипСообщения,"NULL");
		КонецЕсли;	
	КонецЦикла;
	
	УсловиеНаСледующийТип = УсловиеНаСледующийТип + ")";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеНаСледующийТип", УсловиеНаСледующийТип);  
		
	МассивВременныхТаблиц.Добавить("ВТ_СоздатьДокументы_"+ИмяСоздаваемогоДокумента);
	
	ЗапросСКэшемПартнеров.Текст = ТекстЗапроса;
	
	ЗапросСКэшемПартнеров.Выполнить();
	
КонецПроцедуры

Функция ПолучитьМассивПредыдущихСообщений(ТипСообщения)
	
	Если ТипСообщения = "INVOIC" Тогда
		МассивПредыдущихСообщений = EDI_РазложитьСтрокуВМассивСлов("RECADV,DESADV,ORDRSP,ORDERS,PORDERS",",");
	ИначеЕсли ТипСообщения = "RECADV" Тогда
		МассивПредыдущихСообщений = EDI_РазложитьСтрокуВМассивСлов("DESADV,ORDRSP,ORDERS,PORDERS",",");
	ИначеЕсли ТипСообщения = "DESADV" Тогда
		МассивПредыдущихСообщений = EDI_РазложитьСтрокуВМассивСлов("ORDRSP,ORDERS,PORDERS",",");
	ИначеЕсли ТипСообщения = "ORDRSP" Тогда
		МассивПредыдущихСообщений = EDI_РазложитьСтрокуВМассивСлов("ORDERS,PORDERS",",");
	ИначеЕсли ТипСообщения = "ORDERS" Тогда
		МассивПредыдущихСообщений = EDI_РазложитьСтрокуВМассивСлов("PORDERS",",");
	ИначеЕсли ТипСообщения = "PORDERS" Тогда
		МассивПредыдущихСообщений = Новый Массив;
		//для PORDERS пустой
	ИначеЕсли ТипСообщения = "RETANN" Тогда
		МассивПредыдущихСообщений = Новый Массив;
	ИначеЕсли ТипСообщения = "RETINS" Тогда
		МассивПредыдущихСообщений = EDI_РазложитьСтрокуВМассивСлов("RETANN",",");
	ИначеЕсли ТипСообщения = "RETDES" Тогда
		МассивПредыдущихСообщений = EDI_РазложитьСтрокуВМассивСлов("RETANN,RETINS",",");
	ИначеЕсли ТипСообщения = "RETREC" Тогда
		МассивПредыдущихСообщений = EDI_РазложитьСтрокуВМассивСлов("RETANN,RETINS,RETDES",",");
	КонецЕсли;

	
	Возврат МассивПредыдущихСообщений;
	
КонецФункции	

Процедура ЗаменитьНазванияТаблицВТекстеЗапроса(ТекстЗапроса,_РежимРаботы="Поставщик/Покупатель")
	
	СтрокиДляЗамены = ТаблицаТипов.НайтиСтроки(Новый Структура("Сторона",_РежимРаботы));
	Для Каждого Стр Из СтрокиДляЗамены Цикл
		ТипДокумента = СтрЗаменить(Стр.ИмяТипа,"ДокументСсылка.","");
		//ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ВТ_ДокументыДляОтправки_"+Стр.ТипСообщения,"ВТ_"+ТипДокумента);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"Документ_"+Стр.ТипСообщения,"Док_"+ТипДокумента);
	КонецЦикла;
	
КонецПроцедуры	

Функция ПолучитьТипыСообщенийВозвратнойЦепочки()

	ВозвратнаяЦепочка = Новый Массив;
	ВозвратнаяЦепочка.Добавить("RETANN");
	ВозвратнаяЦепочка.Добавить("RETINS");
	ВозвратнаяЦепочка.Добавить("RETDES");
	ВозвратнаяЦепочка.Добавить("RETREC");

	Возврат ВозвратнаяЦепочка;

КонецФункции // ПолучитьТипыСообщенийВозвратнойЦепочки()

Функция ПолучитьНазваниеТипаДокументаПоТипуСообщения(ТипСообщения,_РежимРаботы)
	Строки = ТаблицаТипов.НайтиСтроки(Новый Структура("Сторона,ТипСообщения",_РежимРаботы,ТипСообщения));
	Если Строки.Количество()=1 Тогда
		Возврат СтрЗаменить(Строки[0].ИмяТипа,"ДокументСсылка.","");
	Иначе
		ВызватьИсключение "Неправильно настроен шаблон цепочки";
		Возврат "";
	КонецЕсли;
	
КонецФункции	

Функция ПолучитьНаправлениеСообщения(ТипСообщения,_РежимРаботы) Экспорт
	
	ОтборНаправлений = Новый Структура;
	ОтборНаправлений.Вставить("РежимРаботы", _РежимРаботы);
	ОтборНаправлений.Вставить("ТипСообщения", ТипСообщения);
	
	ТаблицаНаправленийСообщений = ПолучитьТаблицуНаправленийСообщений();
	СтрокиТаблицыНаправлений = ТаблицаНаправленийСообщений.НайтиСтроки(ОтборНаправлений);
	
	Если СтрокиТаблицыНаправлений.Количество() = 1 Тогда
		Возврат СтрокиТаблицыНаправлений[0].Направление;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции	

Функция ПолучитьМассивИменИспользуемыхМодулей() Экспорт
	
	МассивИмен = Новый Массив;
	
	МассивИмен.Добавить("EDI");
	Если НЕ МодульМеркурий() = Неопределено Тогда	
		МассивИмен.Добавить("Меркурий");
	КонецЕсли;

	Возврат МассивИмен;
	
КонецФункции

Функция ПолучитьМассивТиповСообщенийМодулей(СтрокаИмен = "") Экспорт
	
	МассивТиповСообщений = Новый Массив;
	
	Если ПустаяСтрока(СтрокаИмен) Тогда
		МассивИменМодулей = ПолучитьМассивИменИспользуемыхМодулей();
	Иначе
		МассивИменМодулей = EDI_РазложитьСтрокуВМассивСлов(СтрокаИмен, ",");
	КонецЕсли;
	
	Если НЕ МассивИменМодулей.Найти("EDI") = Неопределено Тогда
		
		МассивТиповСообщенийEDI = ПолучитьМассивТиповСообщенийEDI();
		Для каждого ТипСообщения Из МассивТиповСообщенийEDI Цикл
			МассивТиповСообщений.Добавить(ТипСообщения);	
		КонецЦикла;
		
	КонецЕсли;
	
	Если НЕ МассивИменМодулей.Найти("Меркурий") = Неопределено Тогда
		
		МассивТиповСообщенийМеркурия = ПолучитьМассивТиповСообщенийМеркурия();
		Для каждого ТипСообщения Из МассивТиповСообщенийМеркурия Цикл
			МассивТиповСообщений.Добавить(ТипСообщения);	
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат МассивТиповСообщений; 
		
КонецФункции

Функция ПолучитьМассивТиповСообщенийEDI()
	
	МассивТиповСообщений = ЭДО_Кэш_Прочитать("МассивТиповСообщенийEDI");
	
	Если МассивТиповСообщений = Неопределено Тогда
		
		МассивТиповСообщений = Новый Массив;
		
		МассивТиповСообщений.Добавить("PORDERS");
		МассивТиповСообщений.Добавить("ORDERS");
		МассивТиповСообщений.Добавить("ORDRSP");
		МассивТиповСообщений.Добавить("DESADV");
		МассивТиповСообщений.Добавить("RECADV");
		МассивТиповСообщений.Добавить("INVOIC");
		МассивТиповСообщений.Добавить("COINVOIC");
		МассивТиповСообщений.Добавить("RETANN");
		МассивТиповСообщений.Добавить("RETINS");
		МассивТиповСообщений.Добавить("RETDES");
		МассивТиповСообщений.Добавить("RETREC");
		МассивТиповСообщений.Добавить("RETINV");
		МассивТиповСообщений.Добавить("PRICELIST");
		МассивТиповСообщений.Добавить("PRICAT");
		МассивТиповСообщений.Добавить("SLSRPT");
		МассивТиповСообщений.Добавить("INVRPT");
		МассивТиповСообщений.Добавить("IFTMBF");
		МассивТиповСообщений.Добавить("IFTMBC");
		МассивТиповСообщений.Добавить("DELFOR");
		
		ЭДО_Кэш_Поместить("МассивТиповСообщенийEDI", МассивТиповСообщений);
		
	КонецЕсли;
	
	Возврат МассивТиповСообщений; 
	
КонецФункции

Функция ПолучитьМассивТиповСообщенийМеркурия()
	
	МассивТиповСообщений = ЭДО_Кэш_Прочитать("МассивТиповСообщенийМеркурия");
	
	Если МассивТиповСообщений = Неопределено Тогда
		
		МассивТиповСообщений = Новый Массив;
		
		МассивТиповСообщений.Добавить("M_INC");
		МассивТиповСообщений.Добавить("M_REC");
		МассивТиповСообщений.Добавить("M_PRD");
		МассивТиповСообщений.Добавить("M_MOV");
		МассивТиповСообщений.Добавить("M_DES");
		МассивТиповСообщений.Добавить("M_CAN");
		
		ЭДО_Кэш_Поместить("МассивТиповСообщенийМеркурия", МассивТиповСообщений);
		
	КонецЕсли;
	
	Возврат МассивТиповСообщений; 
	
КонецФункции

Функция ПеревестиТипСообщения(ТипСообщения) Экспорт
	
	Если ТипСообщения = "PORDERS" Тогда
		Возврат "Обратный заказ";
	ИначеЕсли ТипСообщения = "ORDERS" Тогда
		Возврат "Заказ";
	ИначеЕсли ТипСообщения = "ORDRSP" Тогда
		Возврат "Ответ на заказ";
	ИначеЕсли ТипСообщения = "DESADV" Тогда
		Возврат "Отгрузка";
	ИначеЕсли ТипСообщения = "RECADV" Тогда
		Возврат "Приемка";
	ИначеЕсли ТипСообщения = "ALCRPT" Тогда
		Возврат "Отчет о продаже алкогольной продукции";
	ИначеЕсли ТипСообщения = "INVOIC" Тогда
		Возврат "Счет-фактура";
	ИначеЕсли ТипСообщения = "COINVOIC" Тогда
		Возврат "Корректировочный счет-фактура";
	ИначеЕсли ТипСообщения = "RETANN" Тогда
		Возврат "Возврат";
	ИначеЕсли ТипСообщения = "RETINS" Тогда
		Возврат "Ответ на возврат";
	ИначеЕсли ТипСообщения = "RETDES" Тогда
		Возврат "Отгрузка возврата";
	ИначеЕсли ТипСообщения = "RETREC" Тогда
		Возврат "Приемка возврата";
	ИначеЕсли ТипСообщения = "RETINV" Тогда
		Возврат "Счет-фактура на возврат";
	ИначеЕсли ТипСообщения = "PRICELIST" Тогда
