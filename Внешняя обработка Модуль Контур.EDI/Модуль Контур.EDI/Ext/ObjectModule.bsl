Функция СформироватьУведомлениеОПрочтенииСообщения(Сообщение,Этап = "read",Статус = "ok") Экспорт
	
	Результат = ИнициализироватьРезультатКонвертацииИсходящегоСообщения();
	
	Если Сообщение = Неопределено Тогда
		
		Результат.Успешно = Ложь;
		
		Возврат Результат;
		
	КонецЕсли;

	ID				= Сообщение.ID;
	
	ТипСообщения	= Сообщение.ТипСообщения;
	НомерСообщения	= Сообщение.ДокументEDI.Номер;
	ДатаСообщения	= Сообщение.ДокументEDI.Дата;
	
	GLN_Отправителя = Сообщение.ОтправительEDI.GLN;
	GLN_Получателя	= Сообщение.ПолучательEDI.GLN;
	
	ID_Уведомления = Новый УникальныйИдентификатор();
	ID_Уведомления = СтрЗаменить(ID_Уведомления,"-","");
	
	ДатаУведомления = ТекущаяДата();
	ДатаЗаголовка	= Формат(ДатаУведомления, "ДФ=yyyyMMddhhmmss");
	
	ПутьКФайлу = мРабочийКаталог+"report_ok_"+ДатаЗаголовка+"_"+ТипСообщения+"_"+ПолучитьСтрокуБезСпецсимволов(НомерСообщения)+"_"+ID_Уведомления+".xml";
	
	ЗаписьХМЛ = Новый ЗаписьXML;
	ЗаписьХМЛ.УстановитьСтроку();
	
	ЗаписьХМЛ.ЗаписатьОбъявлениеXML();
	
    ЗаписьХМЛ.ЗаписатьНачалоЭлемента("statusReport");
	
		ЗаписатьЭлементХМЛ(ЗаписьХМЛ,	"reportDateTime",	Дата1С_в_ДатаВремяXML(ДатаУведомления));
		ЗаписатьЭлементХМЛ(ЗаписьХМЛ,	"reportRecipient",	GLN_Отправителя);
	
	    ЗаписьХМЛ.ЗаписатьНачалоЭлемента("reportItem");
		
			СтатусныйТипСообщений = Лев(ТипСообщения,1)+Сред(НРег(ТипСообщения),2);
		
			ЗаписатьЭлементХМЛ(ЗаписьХМЛ,	"messageId",		ID);
			ЗаписатьЭлементХМЛ(ЗаписьХМЛ,	"messageSender",	GLN_Отправителя);
			ЗаписатьЭлементХМЛ(ЗаписьХМЛ,	"messageRecepient",	GLN_Получателя);
			ЗаписатьЭлементХМЛ(ЗаписьХМЛ,	"documentType",		СтатусныйТипСообщений);
			ЗаписатьЭлементХМЛ(ЗаписьХМЛ,	"documentNumber",	НомерСообщения);
			ЗаписатьЭлементХМЛ(ЗаписьХМЛ,	"documentDate",		Дата1С_в_ДатаXML(ДатаСообщения));
			
	    	ЗаписьХМЛ.ЗаписатьНачалоЭлемента("statusItem");
						
				ДатаСозданияДокумента = ПолучитьСтатусДокумента(Сообщение.Документ1С, "ДатаСозданияДок");
				Если ЗначениеЗаполнено(ДатаСозданияДокумента) Тогда
					ДатаСобытия = ДатаСозданияДокумента;
				Иначе
					ДатаСобытия = Дата1С_в_ДатаВремяXML(ДатаУведомления);
				КонецЕсли;
			
				ЗаписатьЭлементХМЛ(ЗаписьХМЛ,	"dateTime",		ДатаСобытия);
				ЗаписатьЭлементХМЛ(ЗаписьХМЛ,	"stage",		Этап);
				ЗаписатьЭлементХМЛ(ЗаписьХМЛ,	"state",		Статус);
				ЗаписатьЭлементХМЛ(ЗаписьХМЛ,	"description",	"Сообщение загружено в учетную систему.");
		
			ЗаписьХМЛ.ЗаписатьКонецЭлемента();
			
		ЗаписьХМЛ.ЗаписатьКонецЭлемента();
		
	ЗаписьХМЛ.ЗаписатьКонецЭлемента();

	СтрокаXML = ЗаписьХМЛ.Закрыть();
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(СтрокаXML);
	ТекстовыйДокумент.Записать(ПутьКФайлу,"UTF-8");
	
	Результат.Успешно		= Истина;
	Результат.ПутьКФайлу	= ПутьКФайлу;
	Результат.Вставить("GLN",GLN_Получателя);
	Результат.Вставить("СтрокаXML", СтрокаXML);
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьУведомлениеОВалидацииСообщения(Сообщение)
	
	Результат = ИнициализироватьРезультатКонвертацииИсходящегоСообщения();
	
	Если Сообщение = Неопределено Тогда
		
		Результат.Успешно = Ложь;
		
		Возврат Результат;
		
	КонецЕсли;

	ID				= Сообщение.ID;
		
	ТипСообщения	= Сообщение.ТипСообщения;
	НомерСообщения	= Сообщение.ДокументEDI.Номер;
	ДатаСообщения	= Сообщение.ДокументEDI.Дата;
	
	GLN_Отправителя = Сообщение.ОтправительEDI.GLN;
	GLN_Получателя	= Сообщение.ПолучательEDI.GLN;
	
	ID_Уведомления = Новый УникальныйИдентификатор();
	ID_Уведомления = СтрЗаменить(ID_Уведомления,"-","");
	
	ДатаУведомления = ТекущаяДата();
	ДатаЗаголовка	= Формат(ДатаУведомления, "ДФ=yyyyMMddhhmmss");
	
	Если (ТипСообщения = "ORDRSP" или ТипСообщения = "DESADV" или ТипСообщения = "ALCRPT") И Сообщение.СтатусСсылки = "ВходящийНеПрошелВалидацию" Тогда
		РезультатВалидации = "fail";
	Иначе
		РезультатВалидации = "ok";
	КонецЕсли;
			
	ПутьКФайлу = мРабочийКаталог+"report_"+РезультатВалидации+"_"+ДатаЗаголовка+"_"+ТипСообщения+"_"+ПолучитьСтрокуБезСпецсимволов(НомерСообщения)+"_"+ID_Уведомления+".xml";
	
	ЗаписьХМЛ = Новый ЗаписьXML;
	ЗаписьХМЛ.УстановитьСтроку();

	ЗаписьХМЛ.ЗаписатьОбъявлениеXML();
	
    ЗаписьХМЛ.ЗаписатьНачалоЭлемента("statusReport");
	
		ЗаписатьЭлементХМЛ(ЗаписьХМЛ,	"reportDateTime",	Дата1С_в_ДатаВремяXML(ДатаУведомления));
		ЗаписатьЭлементХМЛ(ЗаписьХМЛ,	"reportRecipient",	GLN_Отправителя);
	
	    ЗаписьХМЛ.ЗаписатьНачалоЭлемента("reportItem");
		
			СтатусныйТипСообщений = Лев(ТипСообщения,1)+Сред(НРег(ТипСообщения),2);
		
			ЗаписатьЭлементХМЛ(ЗаписьХМЛ,	"messageId",		ID);
			ЗаписатьЭлементХМЛ(ЗаписьХМЛ,	"messageSender",	GLN_Отправителя);
			ЗаписатьЭлементХМЛ(ЗаписьХМЛ,	"messageRecepient",	GLN_Получателя);
			ЗаписатьЭлементХМЛ(ЗаписьХМЛ,	"documentType",		СтатусныйТипСообщений);
			ЗаписатьЭлементХМЛ(ЗаписьХМЛ,	"documentNumber",	НомерСообщения);
			ЗаписатьЭлементХМЛ(ЗаписьХМЛ,	"documentDate",		Дата1С_в_ДатаXML(ДатаСообщения));
			
	    	ЗаписьХМЛ.ЗаписатьНачалоЭлемента("statusItem");
			
				ЗаписатьЭлементХМЛ(ЗаписьХМЛ,	"dateTime",		Дата1С_в_ДатаВремяXML(ДатаУведомления));
				ЗаписатьЭлементХМЛ(ЗаписьХМЛ,	"stage",		"Checking");
				ЗаписатьЭлементХМЛ(ЗаписьХМЛ,	"state",		ВРег(Лев(РезультатВалидации,1))+Сред(РезультатВалидации,2));
				ЗаписатьЭлементХМЛ(ЗаписьХМЛ,	"description",	"Сообщение "+? (РезультатВалидации="ok","","не")+" прошло проверку на корректность.");
				
               	ОписаниеОшибки = Сообщение.СообщениеСсылка.ОписаниеОшибки;

				Если Найти(ОписаниеОшибки,Символы.ПС)>0 Тогда
					Пока Найти(ОписаниеОшибки,Символы.ПС)>0 Цикл
						ЗаписатьЭлементХМЛ(ЗаписьХМЛ,	"error",	Лев(ОписаниеОшибки, Найти(ОписаниеОшибки,Символы.ПС)-1));
						ОписаниеОшибки = Сред(ОписаниеОшибки, Найти(ОписаниеОшибки,Символы.ПС)+1);
					КонецЦикла;
				ИначеЕсли СтрДлина(ОписаниеОшибки)>0 Тогда
					ЗаписатьЭлементХМЛ(ЗаписьХМЛ,	"error",	ОписаниеОшибки);		
				КонецЕсли;
		
			ЗаписьХМЛ.ЗаписатьКонецЭлемента();
			
		ЗаписьХМЛ.ЗаписатьКонецЭлемента();
		
	ЗаписьХМЛ.ЗаписатьКонецЭлемента();

	СтрокаXML = ЗаписьХМЛ.Закрыть();
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(СтрокаXML);
	ТекстовыйДокумент.Записать(ПутьКФайлу,"UTF-8");
	
	Результат.Успешно		= Истина;
	Результат.ПутьКФайлу	= ПутьКФайлу;
	Результат.Вставить("GLN", GLN_Получателя);
	Результат.Вставить("СтрокаXML", СтрокаXML);
	
	Возврат Результат;
	
КонецФункции

//В разных сообщениях есть похожие по смыслу реквизиты с разными именами. Определим их список.
Процедура ОпределитьИменаРеквизитовСообщения(ТипСообщения,ИмяДокумента,ИмяКоличества,ДатаПоставки)
	
	Если ТипСообщения = "ORDERS" Тогда
		ИмяДокумента	= "order";
		ИмяКоличества	= "requestedQuantity";
		ДатаПоставки	= "requestedDeliveryDateTime";
	ИначеЕсли ТипСообщения = "PORDERS" Тогда
		ИмяДокумента	= "proposalOrder";
		ИмяКоличества	= "requestedQuantity";
		ДатаПоставки	= "requestedDeliveryDateTime";
	ИначеЕсли ТипСообщения = "ORDRSP" Тогда
		ИмяДокумента	= "orderResponse";
		ИмяКоличества	= "confirmedQuantity";
		ДатаПоставки	= "estimatedDeliveryDateTime";
	ИначеЕсли ТипСообщения = "DESADV" Тогда
		ИмяДокумента	= "despatchAdvice";
		ИмяКоличества	= "despatchedQuantity";
		ДатаПоставки	= "estimatedDeliveryDateTime";
	ИначеЕсли ТипСообщения = "RECADV" Тогда
		ИмяДокумента	= "receivingAdvice";
		ИмяКоличества	= "acceptedQuantity";
		ДатаПоставки	= "receptionDateTime";
	ИначеЕсли ТипСообщения = "INVOIC" Тогда
		ИмяДокумента	= "invoice";
		ИмяКоличества	= "quantity";
		ДатаПоставки	= "actualDeliveryDateTime";
	ИначеЕсли ТипСообщения = "ALCRPT" Тогда
		ИмяДокумента	= "alcoholReport";
		ИмяКоличества	= "volume";
		ДатаПоставки	= "";
	ИначеЕсли ТипСообщения = "RETANN" Тогда
		ИмяДокумента	= "announcementForReturns";
		ИмяКоличества	= "returnQuantity";
		ДатаПоставки	= "deliveryDate";
	ИначеЕсли ТипСообщения = "RETINS" Тогда
		ИмяДокумента	= "instructionsForReturns";
		ИмяКоличества	= "confirmedReturnQuantity";
		ДатаПоставки	= "deliveryDate";
	ИначеЕсли ТипСообщения = "COINVOIC" Тогда
		ИмяДокумента	= "correctiveInvoice";
		ИмяКоличества	= "";
		ДатаПоставки	= "";
	ИначеЕсли ТипСообщения = "PRICELIST" ИЛИ ТипСообщения = "PRICAT" Тогда
		ИмяДокумента	= "priceCatalogue";
		ИмяКоличества	= "";
		ДатаПоставки	= "deliveryDate";
	ИначеЕсли ТипСообщения = "SLSRPT" Тогда
		ИмяДокумента	= "salesDataReport";
		ИмяКоличества	= "";
		ДатаПоставки	= "";
	ИначеЕсли ТипСообщения = "INVRPT" Тогда
		ИмяДокумента	= "inventoryReport";
		ИмяКоличества	= "";
		ДатаПоставки	= "";
	ИначеЕсли ТипСообщения = "RETDES" Тогда
		ИмяДокумента	= "returnDespatchAdvice";
		ИмяКоличества	= "despatchedQuantity";
		ДатаПоставки	= "estimatedDeliveryDateTime";
	ИначеЕсли ТипСообщения = "RETREC" Тогда
		ИмяДокумента	= "returnReceivingAdvice";
		ИмяКоличества	= "acceptedQuantity";
		ДатаПоставки	= "receptionDateTime";		
	ИначеЕсли ТипСообщения = "IFTMBF" Тогда
		ИмяДокумента	= "firmBooking";
		ИмяКоличества	= "";
		ДатаПоставки	= "exportDateTime";		
	ИначеЕсли ТипСообщения = "IFTMBC" Тогда
		ИмяДокумента	= "bookingConfirmation";
		ИмяКоличества	= "";
		ДатаПоставки	= "estimatedExportDateTime";
	ИначеЕсли ТипСообщения = "DELFOR" Тогда
		ИмяДокумента	= "deliverySchedule";
		ИмяКоличества	= "";
		ДатаПоставки	= "";
	КонецЕсли;	
	
КонецПроцедуры

Функция КонвертироватьИсходящееСообщениеПоНовому(Сообщение) Экспорт
	
	Результат = ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Вставить("ПутьКФайлу", 	"");
	Результат.Вставить("ИмяФайла", 		"");
	Результат.Вставить("GLN", 			"");
	Результат.Вставить("СтрокаXML",		"");
	
	Если Сообщение = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипСообщения = Сообщение.ТипСообщения;
		
	Если Сообщение.Свойство("ДатаСоздания")	И Сообщение.Направление = "Исходящее" Тогда
		Если Сообщение.Свойство("Архив") И Сообщение.Архив Тогда
			//Не перезаписываем дату создания
		Иначе
			Сообщение.ДатаСоздания = ТекущаяДата();
		КонецЕсли;
	КонецЕсли;
	
	ИмяФайла = СокрЛП(Сообщение.ТипСообщения)+"_"+СокрЛП(Сообщение.ID)+"_"+СокрЛП(Сообщение.ОтправительEDI.GLN)+"_"+СокрЛП(Сообщение.ПолучательEDI.GLN)+".xml";
	ПутьКФайлу = мРабочийКаталог+ИмяФайла;
	
	//корень сообщения
	Попытка
		ЗаписьХМЛ = Новый ЗаписьXML;
		ЗаписьХМЛ.УстановитьСтроку();
		ЗаписьХМЛ.ЗаписатьОбъявлениеXML();
		xmlЗаписатьEdiMessage(ЗаписьХМЛ, Сообщение);
		СтрокаXML = ЗаписьХМЛ.Закрыть();
	Исключение
		Метрика_Переменные = Новый Структура;
		Метрика_Переменные.Вставить("ТипСообщения", Сообщение.ТипСообщения);
		Метрика_Переменные.Вставить("ИмяФайла", 	ИмяФайла);
		Если ПеременнаяСодержитСвойство(Сообщение,"Партнер",,Истина) Тогда
			Метрика_Переменные.Вставить("НастройкиПартнера", ПолучитьЗначенияНастроекПартнеров(Сообщение.Партнер,Истина));
		КонецЕсли;
		_ОписаниеОшибки = ОписаниеОшибки();
		Метрика_ОтправитьСразу = Истина;
		Метрика_Ошибка("xmlЗаписатьEdiMessage", _ОписаниеОшибки, ИнформацияОбОшибке(), Метрика_Переменные, Метрика_ОтправитьСразу);	
		ЗарегистрироватьОшибку(Результат, "Не удалось сформировать XML-файл сообщения " + ИмяФайла + ", описание ошибки: " + _ОписаниеОшибки);
		Возврат Результат;
	КонецПопытки;
	
	//вычистить лишнее на переходный период
	СтрокаXML = СтрЗаменить(СтрокаXML," xmlns="""+xmlПространствоИменСообщений()+""" xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance""","");
	
	ТД = Новый ТекстовыйДокумент;
	ТД.УстановитьТекст(СтрокаXML);
	ТД.Записать(ПутьКФайлу,"UTF-8");
	
	Сообщение.ПутьКФайлу = ПутьКФайлу;
	
	Результат.Успешно		= Истина;
	Результат.ПутьКФайлу	= ПутьКФайлу;
	Результат.ИмяФайла		= ИмяФайла;
	// при отправке по этому полю поймем, с какой учетной записи отправлять
	Результат.GLN 			= ?(Сообщение.Направление = "Исходящее", Сообщение.ОтправительEDI.GLN, Сообщение.ПолучательEDI.GLN);
	Результат.СтрокаXML = СтрокаXML;
	
	Возврат Результат;
	
КонецФункции

// Заполнение объекта XDTO PRICELIST
Функция ЗаполнитьОбъектСообщения_PRICELIST(СообщениеОбъект,Сообщение)
	
	Отправитель = Сообщение.ОтправительEDI.GLN;
	Получатель = Сообщение.ПолучательEDI.GLN;
	
	СообщениеОбъект.id = Сообщение.id;
	
	xmlСоздатьДочернийЭлементXDTO(СообщениеОбъект, "interchangeHeader");
	xmlЗаписатьInterchangeHeader_XDTO(СообщениеОбъект.interchangeHeader,Сообщение);
	
	// сам документ
	priceCatalogue = xmlСоздатьДочернийЭлементXDTO(СообщениеОбъект, "priceCatalogue");
	
	ЗаполнитьШапкуОбъектаСообщения_PRICELIST(priceCatalogue, Сообщение, СообщениеОбъект); 

	xmlСоздатьДочернийЭлементXDTO(СообщениеОбъект.priceCatalogue,		"lineItems");
	
	xmlЗаполнитьЗначениеXDTO(СообщениеОбъект.priceCatalogue.lineItems, "currencyISOCode", Сообщение.ВалютаEDI);	
	
	Для Каждого СтрокаТоваров ИЗ Сообщение.Товары Цикл
		
		lineItem = ДобавитьЭлементСпискаXDTO(СообщениеОбъект.priceCatalogue.lineItems.lineItem,ФабрикаXDTO_EdiXml());
		
		ЗаполнитьСтрокуТоваровОбъектаСообщения_PRICELIST(lineItem, Сообщение, СтрокаТоваров);   
			
	КонецЦикла;
	
	Возврат СообщениеОбъект;
	
КонецФункции

Процедура ЗаполнитьСтрокуТоваровОбъектаСообщения_PRICELIST(lineItem, Сообщение, СтрокаТоваров)
	
	Если ЗначениеЗаполнено(СтрокаТоваров.Статус) Тогда
		lineItem.status = СтрокаТоваров.Статус;
	Иначе
		lineItem.status = "Changed";
	КонецЕсли;
	
	xmlЗаполнитьЗначениеXDTO(lineItem,	"gtin",						СтрокаТоваров.GTIN);
	xmlЗаполнитьЗначениеXDTO(lineItem,	"internalBuyerCode",		СтрокаТоваров.КодТовараПокупателя);
	xmlЗаполнитьЗначениеXDTO(lineItem,	"internalSupplierCode",		СтрокаТоваров.КодТовараПоставщика);
	xmlЗаполнитьЗначениеXDTO(lineItem,	"description",				СтрокаТоваров.Наименование);
	
	Если ЗначениеЗаполнено(СтрокаТоваров.КоличествоВОдномМесте) Тогда
		xmlЗаписатьQuantityType_XDTO(lineItem, "onePlaceQuantity", СтрокаТоваров.КоличествоВОдномМесте, СтрокаТоваров.КодЕдиницыИзмеренияEDI, Истина); 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТоваров.КоличествоОстаткаНаКонец) Тогда
		xmlЗаписатьQuantityType_XDTO(lineItem, "supplierWHQuantity", СтрокаТоваров.КоличествоОстаткаНаКонец, СтрокаТоваров.КодЕдиницыИзмеренияEDI, Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТоваров.КвантПоставки) Тогда
		xmlЗаписатьQuantityType_XDTO(lineItem,"incrementalOrderQuantity",СтрокаТоваров.КвантПоставки,         СтрокаТоваров.КодЕдиницыИзмеренияEDI,	Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТоваров.РекомендуемаяРозничнаяЦена) Тогда
		xmlЗаписатьQuantityType_XDTO(lineItem,    "suggestedRetailPrice", СтрокаТоваров.РекомендуемаяРозничнаяЦена, СтрокаТоваров.КодЕдиницыИзмеренияEDI,    Истина, Сообщение.ВалютаEDI);
	КонецЕсли;
	
	ЦенаБезНДС = СтрокаТоваров.ЦенаБезНДС;
	ЦенаСНДС = СтрокаТоваров.ЦенаСНДС;
	
	Если Сообщение.Направление = "Исходящее" Тогда
		
		Если ПеременнаяСодержитСвойство(СтрокаТоваров, "ЦенаБезНДСРасчетная") 
			И ЗначениеЗаполнено(СтрокаТоваров.ЦенаБезНДСРасчетная) Тогда
			
			ЦенаБезНДС = СтрокаТоваров.ЦенаБезНДСРасчетная;
					
		КонецЕсли;
		
		Если ПеременнаяСодержитСвойство(СтрокаТоваров, "ЦенаСНДСРасчетная") 
			И ЗначениеЗаполнено(СтрокаТоваров.ЦенаСНДСРасчетная) Тогда
			
			ЦенаСНДС = СтрокаТоваров.ЦенаСНДСРасчетная;
				
		КонецЕсли;
	КонецЕсли;
	
	xmlЗаписатьQuantityType_XDTO(lineItem, "netPrice",        ЦенаБезНДС, СтрокаТоваров.КодЕдиницыИзмеренияEDI, Истина, Сообщение.ВалютаEDI);
	xmlЗаписатьQuantityType_XDTO(lineItem, "netPriceWithVAT", ЦенаСНДС, СтрокаТоваров.КодЕдиницыИзмеренияEDI, Истина, Сообщение.ВалютаEDI); 
	
	Если ЗначениеЗаполнено(СтрокаТоваров.СрокГодности) Тогда
		xmlЗаписатьShelfLifeType_XDTO(lineItem, "shelfLife",		СтрокаТоваров.СрокГодности, СтрокаТоваров.ЕдИзмСрокаГодности,	Истина);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(СтрокаТоваров.СтранаEDI) Тогда
		xmlЗаполнитьЗначениеXDTO(lineItem, "countryOfOriginISOCode",СтрокаТоваров.СтранаEDI);
	КонецЕсли;
	xmlЗаполнитьЗначениеXDTO(lineItem,	"vATRate",		СтрокаТоваров.СтавкаНДСEDI);
	
	Если ЗначениеЗаполнено(СтрокаТоваров.Каталог) Тогда
		xmlЗаполнитьЗначениеXDTO(lineItem,	"productCategory", СтрокаТоваров.Каталог);
	КонецЕсли;
	
	Если ПеременнаяСодержитСвойство(СтрокаТоваров, "ДополнительнаяИнформация") 
		И ТипЗнч(СтрокаТоваров.ДополнительнаяИнформация) = Тип("Структура") Тогда
		
		xmlЗаполнитьKeyValueTypeXDTO(lineItem, СтрокаТоваров.ДополнительнаяИнформация);
		
	КонецЕсли;
	
	// Особенности сообщений, сформированные с помощью события ПМ ДобавитьОсобенностиСообщений
	ЗаполнитьОсобенностиLineitem_XDTO(lineItem, СтрокаТоваров, Сообщение);

КонецПроцедуры

Процедура ЗаполнитьШапкуОбъектаСообщения_PRICELIST(priceCatalogue, Сообщение, СообщениеОбъект)
	
	// номер/дата документа
	xmlЗаписатьДанныеДокумента_XDTO(priceCatalogue, Сообщение.ДокументEDI.Номер, Сообщение.ДокументEDI.Дата);
	
	Если Сообщение.Свойство("ТипПрайсЛиста") И ЗначениеЗаполнено(Сообщение.ТипПрайсЛиста) Тогда
		priceCatalogue.type = Сообщение.ТипПрайсЛиста;
	Иначе
		priceCatalogue.type = "Catalogue";
	КонецЕсли;	
		
	priceCatalogue.status = "Original";
	
	Если ЗначениеЗаполнено(Сообщение.ТипЦен) Тогда
		priceCatalogue.name = Сообщение.ТипЦен.Наименование;
	КонецЕсли;
	
	xmlЗаполнитьЗначениеXDTO(priceCatalogue,	"startDate",	Сообщение.ДатаНачалаДействияЦен);
	xmlЗаполнитьЗначениеXDTO(priceCatalogue,	"endDate",		Сообщение.ДатаОкончанияДействияЦен);
	xmlЗаполнитьЗначениеXDTO(priceCatalogue,	"comment",		Сообщение.Комментарий);
	
	xmlЗаполнитьDocumentIdentificator(priceCatalogue, "contractIdentificator", Сообщение, "Контракт");
	
	ВыгружатьТолькоОрганизацию = Истина;
	
	Если ЗначениеЗаполнено(Сообщение.Продавец1С) Тогда
		xmlСоздатьДочернийЭлементXDTO(priceCatalogue,		"seller");
		xmlЗаписатьContractor_XDTO(priceCatalogue.seller,	"seller", 	Сообщение.ПродавецEDI, 	ВыгружатьТолькоОрганизацию);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Сообщение.Покупатель1С) Тогда
		xmlСоздатьДочернийЭлементXDTO(priceCatalogue,		"buyer");
		xmlЗаписатьContractor_XDTO(priceCatalogue.buyer,	"buyer", 	Сообщение.ПокупательEDI, 	ВыгружатьТолькоОрганизацию);
	КонецЕсли;	
	
	// запишем Особенности сообщения, созданные в событии ПМ ДобавитьОсобенностиСообщений
	ЗаполнитьОсобенностиДокумента_XDTO(СообщениеОбъект.priceCatalogue, Сообщение, Сообщение.ТипСообщения);

КонецПроцедуры

// Заполнение объекта XDTO DELFOR
Функция ЗаполнитьОбъектСообщения_DELFOR(СообщениеОбъект,Сообщение)
	
	Отправитель = Сообщение.ОтправительEDI.GLN;
	Получатель = Сообщение.ПолучательEDI.GLN;
	
	СообщениеОбъект.id = Сообщение.id;
	
	xmlСоздатьДочернийЭлементXDTO(СообщениеОбъект, "interchangeHeader");
	xmlЗаписатьInterchangeHeader_XDTO(СообщениеОбъект.interchangeHeader,Сообщение);
	
	//шапка документа
	deliverySchedule = xmlСоздатьДочернийЭлементXDTO(СообщениеОбъект, "deliverySchedule");
	xmlЗаписатьДанныеДокумента_XDTO(deliverySchedule, Сообщение.ДокументEDI.Номер, Сообщение.ДокументEDI.Дата);
			
	xmlЗаполнитьЗначениеXDTO(deliverySchedule,	"type",							Сообщение.ТипDELFOR);
	xmlЗаполнитьЗначениеXDTO(deliverySchedule,	"status",						Сообщение.СтатусDELFOR);
	xmlЗаполнитьЗначениеXDTO(deliverySchedule,	"startDate",					Сообщение.НачалоДействияГрафика);
	xmlЗаполнитьЗначениеXDTO(deliverySchedule,	"endDate",						Сообщение.ОкончаниеДействияГрафика);	
	
	ДлительностьГрафика_xml = ПолучитьЗначениеПеречисленияEDI(Сообщение.ДлительностьГрафика, "ДлительностьГрафикаDELFOR"); 
	xmlЗаполнитьЗначениеXDTO(deliverySchedule,	"duration",						ДлительностьГрафика_xml);
	
	xmlЗаполнитьЗначениеXDTO(deliverySchedule,	"segmentOfBuyerAssortment",		Сообщение.СегментАссортимента);
	xmlЗаполнитьЗначениеXDTO(deliverySchedule,	"salesRegion",					Сообщение.РегионПродаж);
	xmlЗаполнитьЗначениеXDTO(deliverySchedule,	"comment",						Сообщение.Комментарий);
	
	xmlСоздатьДочернийЭлементXDTO(deliverySchedule, "contractIdentificator");
	xmlЗаписатьДанныеДокумента_XDTO(deliverySchedule.contractIdentificator, Сообщение.НомерДоговора, Сообщение.ДатаДоговора);

	xmlСоздатьДочернийЭлементXDTO(deliverySchedule,		"seller");
	xmlЗаписатьContractor_XDTO(deliverySchedule.seller,	"seller", 	Сообщение.ПродавецEDI, 	Истина);
	
	xmlСоздатьДочернийЭлементXDTO(deliverySchedule,		"buyer");
	xmlЗаписатьContractor_XDTO(deliverySchedule.buyer,	"buyer", 	Сообщение.ПокупательEDI, Истина);	
	
	//Таблица графиков
	xmlСоздатьДочернийЭлементXDTO(СообщениеОбъект.deliverySchedule,		"scheduleItems");
	
	ТекGLN = Неопределено;	
	Сообщение.Графики.Сортировать("ТорговаяТочкаGLN");
	
	Для Каждого СтрокаГрафика ИЗ Сообщение.Графики Цикл
		
		Если ТекGLN <> СтрокаГрафика.ТорговаяТочкаGLN Тогда//графики по одной точке доставки складываются в один scheduleItem
			ТекGLN = СтрокаГрафика.ТорговаяТочкаGLN;
			
			scheduleItem = ДобавитьЭлементСпискаXDTO(СообщениеОбъект.deliverySchedule.scheduleItems.scheduleItem, ФабрикаXDTO_EdiXml());                 
			xmlСоздатьДочернийЭлементXDTO(scheduleItem,		"shipTo");
			xmlЗаполнитьЗначениеXDTO(scheduleItem.shipTo,	"gln",			СтрокаГрафика.ТорговаяТочкаGLN);
		КонецЕсли;
		
	    deliveryForecast = ДобавитьЭлементСпискаXDTO(scheduleItem.deliveryForecast, ФабрикаXDTO_EdiXml());
		
		xmlЗаполнитьЗначениеXDTO(deliveryForecast, "number", 	СтрокаГрафика.НомерГрафикаПоставок);
		xmlЗаполнитьЗначениеXDTO(deliveryForecast, "name", 		СтрокаГрафика.ИмяГрафикаПоставок);
		
		Если Сообщение.ТипDELFOR = "Schedule" Тогда 
			СтатусГрафика_xml = ПолучитьЗначениеПеречисленияEDI(СтрокаГрафика.СтатусГрафика, "СтатусГрафикаDELFOR");
		ИначеЕсли Сообщение.ТипDELFOR = "Response" Тогда
			СтатусГрафика_xml = ПолучитьЗначениеПеречисленияEDI(СтрокаГрафика.СтатусСогласования, "СтатусГрафикаDELFOR");	
		КонецЕсли;	
		
		Если СтатусГрафика_xml = "" Тогда
			ВызватьИсключение "Не удалось определить статус графика для xml";	
		КонецЕсли;
		xmlЗаполнитьЗначениеXDTO(deliveryForecast, "status", 	СтатусГрафика_xml);
		
		xmlСоздатьДочернийЭлементXDTO(deliveryForecast,		"orderForecastIdentificator");		
		xmlЗаполнитьЗначениеXDTO(deliveryForecast.orderForecastIdentificator, "number", 	СтрокаГрафика.НомерГрафикаЗаказов);
		xmlЗаполнитьЗначениеXDTO(deliveryForecast.orderForecastIdentificator, "name", 		СтрокаГрафика.ИмяГрафикаЗаказов);
		
		ДлительностьГрафика_xml = ПолучитьЗначениеПеречисленияEDI(СтрокаГрафика.ДлительностьГрафика, "ДлительностьГрафикаDELFOR"); 
		Если ДлительностьГрафика_xml = "" Тогда
			ВызватьИсключение "Не удалось определить длительность графика для xml";	
		КонецЕсли;
		
		xmlЗаполнитьЗначениеXDTO(deliveryForecast, 	"duration", 			ДлительностьГрафика_xml);
		xmlЗаполнитьЗначениеXDTO(deliveryForecast,	"startDate",			СтрокаГрафика.НачалоДействияГрафика);
		xmlЗаполнитьЗначениеXDTO(deliveryForecast,	"endDate",				СтрокаГрафика.ОкончаниеДействияГрафика);
		xmlЗаполнитьЗначениеXDTO(deliveryForecast,	"DeletionDate",			СтрокаГрафика.ДатаУдаления);
		xmlЗаполнитьЗначениеXDTO(deliveryForecast,	"DaysForDelivery",		СтрокаГрафика.ВремяОтЗаказаДоПоставки);
		xmlЗаполнитьЗначениеXDTO(deliveryForecast,	"SendOrderToTime",		Формат(СтрокаГрафика.ЗаказыПринимаютсяДо, "ДЛФ=T"));
		xmlЗаполнитьЗначениеXDTO(deliveryForecast,	"plannedDeliveryDate",	СтрокаГрафика.ДатаЗаказа);
		xmlЗаполнитьЗначениеXDTO(deliveryForecast,	"PlannedOrderDate",		СтрокаГрафика.ДатаПоставки);
		xmlЗаполнитьЗначениеXDTO(deliveryForecast,	"MinimumNetAmount",		СтрокаГрафика.МинимальнаяСуммаЗаказа);
		
		xmlСоздатьДочернийЭлементXDTO(deliveryForecast,		"minimumNetWeight");		
		xmlЗаполнитьЗначениеXDTO(deliveryForecast.minimumNetWeight, "unitOfMeasure",	СтрокаГрафика.МинимальныйВесЗаказаЕдИзм);
		xmlЗаполнитьЗначениеXDTO(deliveryForecast.minimumNetWeight,	"__content",		СтрокаГрафика.МинимальныйВесЗаказа);
		
		xmlСоздатьДочернийЭлементXDTO(deliveryForecast,		"minimumNumberOfPalletPlaces");		
		xmlЗаполнитьЗначениеXDTO(deliveryForecast.minimumNumberOfPalletPlaces, "unitOfMeasure", 	СтрокаГрафика.МинимальноеКолличествоПаллетЕдИзм);
		xmlЗаполнитьЗначениеXDTO(deliveryForecast.minimumNumberOfPalletPlaces,	"__content",		СтрокаГрафика.МинимальноеКолличествоПаллет);	
		
		xmlСоздатьДочернийЭлементXDTO(deliveryForecast,		"transportation");		
		xmlЗаполнитьЗначениеXDTO(deliveryForecast.transportation, "vehicleArrivalFromTime", 	Формат(СтрокаГрафика.ВремяПоставкиС, "ДЛФ=T"));
		xmlЗаполнитьЗначениеXDTO(deliveryForecast.transportation, "vehicleArrivalToTime", 		Формат(СтрокаГрафика.ВремяПоставкиДо, "ДЛФ=T"));
		
		xmlСоздатьДочернийЭлементXDTO(deliveryForecast,		"frequencyOfDelivery");
		
		РегулярностьВНеделях_xml = ПолучитьЗначениеПеречисленияEDI(СтрокаГрафика.РегулярностьВНеделях, "РегулярностьВНеделяхDELFOR"); 
		xmlЗаполнитьЗначениеXDTO(deliveryForecast.frequencyOfDelivery, "Weeks", РегулярностьВНеделях_xml);
		
		РегулярностьВДнях_xml = ПолучитьЗначениеПеречисленияEDI(СтрокаГрафика.РегулярностьВДнях, "ДниНедели"); 
		xmlЗаполнитьЗначениеXDTO(deliveryForecast.frequencyOfDelivery, "Days", 	РегулярностьВДнях_xml);
		
	КонецЦикла;
	
	Возврат СообщениеОбъект;
	
КонецФункции

Функция КонвертироватьВходящееСообщение_REPORTS(Параметры,ТипСообщения)
	//на рефакторинг: фактически используется только для чтения REPORTS
	
	Перем ИсточникДанных;

	РезультатКонвертации = ИнициализироватьСтруктуруРезультатаФункции(Ложь);
	
	Если Параметры.Свойство("ИсточникДанных", ИсточникДанных) Тогда
		
		СтруктураСообщения = ПолучитьСтруктуруСообщения_Объект_REPORTS();

		Шапка				= СтруктураСообщения.Шапка;
		СтруктураШапки		= СтруктураСообщения.ШапкаСтруктура;
		
		Попытка
			
			ПрочитатьФайлXML_REPORTS(ИсточникДанных, ТипСообщения, 1, Шапка, СтруктураШапки, Неопределено, Неопределено);
			
			РезультатКонвертации.Вставить("Успешно", Истина);
			
		Исключение
			
			//ошибка чтения статусного сообщения не дожна прерывать обмен
			
			_ОписаниеОшибки = ОписаниеОшибки();
			
			ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, _ОписаниеОшибки);
			
			Метрика_Переменные = Новый Структура("ТипСообщения, ИмяФайла", "reports", Шапка.ПутьКФайлу);
			Метрика_ОтправитьСразу = Истина;
			Метрика_Ошибка("КонвертироватьВходящееСообщение_REPORTS", _ОписаниеОшибки, ИнформацияОбОшибке(), Метрика_Переменные, Метрика_ОтправитьСразу); 
			
			РезультатКонвертации.ОписаниеОшибки = _ОписаниеОшибки;

		КонецПопытки;

		РезультатКонвертации.Вставить("Шапка", Шапка);

	КонецЕсли;
	
	Возврат РезультатКонвертации;
	
КонецФункции

Функция ПолучитьМаппингПолейXML(ИмяСтруктуры,ТипСообщения,СоответствиеПутей = Неопределено)
	
	Если ДлительнаяОперация = Истина Тогда
		
		КэшМаппингаПолей = КэшДлительнойОперации.Получить("КэшМаппингаПолей");
		Если КэшМаппингаПолей = Неопределено Тогда
			КэшМаппингаПолей = Новый Соответствие;
			КэшДлительнойОперации.Вставить("КэшМаппингаПолей",КэшМаппингаПолей);
		КонецЕсли;
		КэшМаппингаСообщения = КэшМаппингаПолей.Получить(ТипСообщения);
		Если КэшМаппингаСообщения = Неопределено Тогда
			КэшМаппингаСообщения = Новый Соответствие;
			КэшМаппингаПолей.Вставить(ТипСообщения,КэшМаппингаСообщения);
		КонецЕсли;
		
		СтруктураОписания = КэшМаппингаСообщения.Получить(ИмяСтруктуры);
		Если НЕ СтруктураОписания = Неопределено Тогда
			Если НЕ СоответствиеПутей = Неопределено Тогда
				СоответствиеПутей = СтруктураОписания.СоответствиеПутей;
			КонецЕсли;	
			Возврат СтруктураОписания.ТабОписания;
		КонецЕсли;
		
	КонецЕсли;	

	
	ТабОписания = Новый ТаблицаЗначений;
	ТабОписания.Колонки.Добавить("ИмяПоля");
	ТабОписания.Колонки.Добавить("Путь");
	ТабОписания.Колонки.Добавить("ИмяСтруктуры");
	ТабОписания.Колонки.Добавить("ЭтоСписок");
	ТабОписания.Колонки.Добавить("ТипEDI");
	
	ТабОписания.Индексы.Добавить("Путь");
	
	ИмяДокумента = "";
	ИмяКоличества = "";
	ДатаПоставки = "";
	ОпределитьИменаРеквизитовСообщения(ТипСообщения,ИмяДокумента,ИмяКоличества,ДатаПоставки);
	
	Если ИмяСтруктуры = "Документ" Тогда	
		
		// Документ
		ДобавитьОписаниеПоля(ТабОписания,"ID",					"id");
		ДобавитьОписаниеПоля(ТабОписания,"Отправитель",			"interchangeHeader.sender");
		ДобавитьОписаниеПоля(ТабОписания,"Получатель",			"interchangeHeader.recipient");
		ДобавитьОписаниеПоля(ТабОписания,"ДатаСоздания",		"interchangeHeader.creationDateTime");
		
		ДобавитьОписаниеПоля(ТабОписания,"НомерДокумента",		ИмяДокумента+".number");
		ДобавитьОписаниеПоля(ТабОписания,"ДатаДокумента",		ИмяДокумента+".date");
		ДобавитьОписаниеПоля(ТабОписания,"Статус",				ИмяДокумента+".status");
		
		ДобавитьОписаниеПоля(ТабОписания,"НомерСерииЗаказов",	ИмяДокумента+".blanketOrderIdentificator.number");
		ДобавитьОписаниеПоля(ТабОписания,"НомерЗаказа",			ИмяДокумента+".originOrder.number");
		ДобавитьОписаниеПоля(ТабОписания,"ДатаЗаказа",			ИмяДокумента+".originOrder.date");
		ДобавитьОписаниеПоля(ТабОписания,"НомерКонтракта",		ИмяДокумента+".contractIdentificator.number");
		ДобавитьОписаниеПоля(ТабОписания,"ДатаКонтракта",		ИмяДокумента+".contractIdentificator.date");
		ДобавитьОписаниеПоля(ТабОписания,"Контракты",			ИмяДокумента+".contractIdentificator", "Контракты", Истина);
		
		Если ТипСообщения = "RETDES" Тогда 
			ДобавитьОписаниеПоля(ТабОписания,"НомерНакладной",		ИмяДокумента+".deliveryNoteIdentificator.number");
			ДобавитьОписаниеПоля(ТабОписания,"ДатаНакладной",		ИмяДокумента+".deliveryNoteIdentificator.date");
