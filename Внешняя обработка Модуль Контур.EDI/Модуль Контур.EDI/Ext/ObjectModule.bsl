Процедура ЗаполнитьСтрокуПоступления_ДалионТРЕНД(СтрокаПоступления, СтрокаДокумента, флСуммаВключаетНДС);
	
	СтрокаПоступления.ЕдиницаИзмерения			= СтрокаДокумента.ЕдиницаИзмерения;
	СтрокаПоступления.Количество				= СтрокаДокумента.Количество;      
	СтрокаПоступления.КоличествоЕдиницИзмерения	= СтрокаДокумента.Количество;    
	
	Если флСуммаВключаетНДС Тогда
		СтрокаПоступления.Цена					= СтрокаДокумента.ЦенаСНДС;
		СтрокаПоступления.Сумма					= СтрокаДокумента.СуммаСНДС;
	Иначе
		СтрокаПоступления.Цена					= СтрокаДокумента.ЦенаБезНДС;
		СтрокаПоступления.Сумма					= СтрокаДокумента.СуммаБезНДС;
	КонецЕсли;
	
	СтрокаПоступления.СтавкаНДС					= СтрокаДокумента.СтавкаНДС1С; 	
	
КонецПроцедуры

Процедура ЗаполнитьСтрокуПоступления_ШтрихМ_РС(Документ, Заказ, СтрокаПоступления, СтрокаСообщения, флСуммаВключаетНДС,ЕстьКоэффициент)
	
	Выполнить("ПриИзмененииНоменклатурыВСтрокеДокумента(СтрокаПоступления, Документ, Документ.Метаданные().Имя, Неопределено, Неопределено);");
	
	СтрокаПоступления.Единица				= СтрокаСообщения.ЕдиницаИзмерения;
	Если ЕстьКоэффициент Тогда
		СтрокаПоступления.Коэффициент			= СтрокаСообщения.ЕдиницаИзмерения.Коэффициент;
	КонецЕсли;	
	СтрокаПоступления.Количество			= СтрокаСообщения.Количество;
	
	Если флСуммаВключаетНДС Тогда
		СтрокаПоступления.ПриходнаяЦена	= СтрокаСообщения.ЦенаСНДС;
		СтрокаПоступления.ПриходнаяСумма	= СтрокаСообщения.СуммаСНДС;
	Иначе
		СтрокаПоступления.ПриходнаяЦена	= СтрокаСообщения.ЦенаБезНДС;
		СтрокаПоступления.ПриходнаяСумма	= СтрокаСообщения.СуммаБезНДС;
	КонецЕсли;
	
	СтрокаПоступления.СтавкаНДС			= СтрокаСообщения.СтавкаНДС1С;
	
	СтрокаПоступления.ДокументЗаказаПоставщику = Заказ;
	
	Выполнить("ПриИзмененииКоличестваВСтрокеДокумента(СтрокаПоступления, Документ, Документ.Метаданные().Имя);");
	Выполнить("ПриИзмененииПриходнойЦеныВСтрокеДокумента(СтрокаПоступления, Документ, Документ.Метаданные().Имя);");
	
КонецПроцедуры

Процедура ЗаполнитьСтрокуПоступления_УФ_УНФ(СтрокаТабличнойЧасти,СтрокаСообщения,флСуммаВключаетНДС)   
	
	
	СтрокаТабличнойЧасти.Характеристика		= СтрокаСообщения.ХарактеристикаНоменклатуры;
	СтрокаТабличнойЧасти.ЕдиницаИзмерения	= СтрокаСообщения.ЕдиницаИзмерения;
	СтрокаТабличнойЧасти.Количество			= СтрокаСообщения.Количество;
	СтрокаТабличнойЧасти.СтавкаНДС			= СтрокаСообщения.СтавкаНДС1С;

	Если флСуммаВключаетНДС Тогда
		СтрокаТабличнойЧасти.Цена = СтрокаСообщения.ЦенаСНДС;
		СтрокаТабличнойЧасти.Сумма = СтрокаСообщения.СуммаСНДС;
	Иначе
		СтрокаТабличнойЧасти.Цена = СтрокаСообщения.ЦенаБезНДС;
		СтрокаТабличнойЧасти.Сумма = СтрокаСообщения.СуммаБезНДС;
	КонецЕсли;
	
	ОбщийМодуль_ТабличныеЧастиУНФКлиентСервер = Неопределено;
	Если ЕстьОбщийМодуль1С_КонтурEDI("ТабличныеЧастиУНФКлиентСервер",ОбщийМодуль_ТабличныеЧастиУНФКлиентСервер) Тогда 
		Попытка
			ОбщийМодуль_ТабличныеЧастиУНФКлиентСервер.РассчитатьСуммыВСтрокеТЧ(СтрокаТабличнойЧасти,Новый Структура("СуммаВключаетНДС",флСуммаВключаетНДС));
		Исключение
			ТекстОшибки =  ОписаниеОшибки();
		КонецПопытки;
	КонецЕсли;	
	
КонецПроцедуры

Процедура ПослеЗаполненияТабличнойЧастиПоступления(Документ)
	
	Если ИмяКонфигурации1С = "УФ_БП" Тогда 
		Попытка
			//Появилось где-то между 3.0.36 и 3.0.43 релизом
			Выполнить("СчетаУчетаВДокументах.ЗаполнитьПередОтображениемПользователю(Документ)");
		Исключение
			Если ЗначениеЗаполнено(Документ.Организация)
				И ЗначениеЗаполнено(Документ.Контрагент)
				И ЗначениеЗаполнено(Документ.ДоговорКонтрагента) Тогда
				Выполнить("Документы.ПоступлениеТоваровУслуг.ЗаполнитьСчетаУчетаРасчетов(Документ)");
			КонецЕсли;
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Возвращает список счетов учета товаров для получения остатков в прайс-листах.
// 
// Возвращаемое значение:
//  Массив - счета и субсчета учета товаров.
//
Функция ПолучитьСчетаУчетаТоваров_УФ_БП()
	
	СчетаУчетаТоваров = ЭДО_Кэш_Прочитать("СчетаУчетаТоваровНаСкладах_УФ_БП");
	
	Если СчетаУчетаТоваров = Неопределено Тогда
		
		СчетаУчетаТоваров = Новый Массив;
		
		ОбщийМодульБухгалтерскийУчет = ОбщийМодуль1С_КонтурEDI("БухгалтерскийУчет");
		
		Если ЕстьНеобходимыеМетаданные("ПланыСчетов.Хозрасчетный")
			И Не ОбщийМодульБухгалтерскийУчет = Неопределено Тогда
			
			Если ПеременнаяСодержитСвойство(ПланыСчетов.Хозрасчетный, "Товары") Тогда
				СчетаУчетаТоваров.Добавить(ПланыСчетов.Хозрасчетный.Товары);
			КонецЕсли;
			
			Если ПеременнаяСодержитСвойство(ПланыСчетов.Хозрасчетный, "ГотоваяПродукция") Тогда
				СчетаУчетаТоваров.Добавить(ПланыСчетов.Хозрасчетный.ГотоваяПродукция);
			КонецЕсли;
			
			СчетаУчетаТоваров = ОбщийМодульБухгалтерскийУчет.СформироватьМассивСубсчетов(СчетаУчетаТоваров);
			
		КонецЕсли;
		
		ЭДО_Кэш_Поместить("СчетаУчетаТоваровНаСкладах_УФ_БП", СчетаУчетаТоваров);
		
	КонецЕсли;
	
	Возврат СчетаУчетаТоваров;
	
КонецФункции

// Возвращает список элементов плана видов характеристик ВидыСубконтоХозрасчетные.
// 
// Возвращаемое значение:
//  Массив - содержит предопределенные элементы плана видов характеристик ВидыСубконтоХозрасчетные 
//			 Номенклатура и Склады при их одновременном наличии в конфигурации.
//
Функция ПолучитьВидыСубконтоУчетаТоваров_УФ_БП()
	
	ВидыСубконтоУчетаТоваров = ЭДО_Кэш_Прочитать("ВидыСубконтоНоменклатураСклад");
	
	Если ВидыСубконтоУчетаТоваров = Неопределено Тогда
		
		ВидыСубконтоУчетаТоваров = Новый Массив;
		
		Если ЕстьНеобходимыеМетаданные("ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные") Тогда
			
			Если ПеременнаяСодержитСвойство(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные, "Номенклатура") Тогда
				ВидыСубконтоУчетаТоваров.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Номенклатура);
			КонецЕсли;
			
			Если ПеременнаяСодержитСвойство(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные, "Склады")
				И ЕстьНеобходимыеМетаданные("ПланыСчетов.Хозрасчетный")
				И ПеременнаяСодержитСвойство(ПланыСчетов.Хозрасчетный, "Товары") Тогда
				
				ВидыСубконтоСчетТовары = ПланыСчетов.Хозрасчетный.Товары.ВидыСубконто;
				Если Не ВидыСубконтоСчетТовары.Найти(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Склады) = Неопределено Тогда
					ВидыСубконтоУчетаТоваров.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Склады);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;

		ЭДО_Кэш_Поместить("ВидыСубконтоНоменклатураСклад", ВидыСубконтоУчетаТоваров);
		
	КонецЕсли;
	
	Возврат ВидыСубконтоУчетаТоваров;
	
КонецФункции

//Облегчим работу с поиском реквизитов.
//Можно заодно кэшировать
Функция ЕстьРеквизитОбъекта_Контур(Объект, ИмяРеквизита, ИмяТабличнойЧасти = Неопределено) Экспорт
	
	Результат = Ложь;
	
	_Метаданные = Объект.Метаданные();
	Если ЗначениеЗаполнено(ИмяТабличнойЧасти) Тогда
		Результат = НЕ _Метаданные.ТабличныеЧасти[ИмяТабличнойЧасти].Реквизиты.Найти(ИмяРеквизита)=Неопределено
	Иначе	
		Результат = НЕ _Метаданные.Реквизиты.Найти(ИмяРеквизита)=Неопределено
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

Функция ЕстьТабличнаяЧастьОбъекта_Контур(Объект, ИмяТабличнойЧасти, МетаданныеОбъекта = Неопределено) Экспорт
	
	Если МетаданныеОбъекта = Неопределено Тогда 
		МетаданныеОбъекта = Объект.Метаданные();   
	КонецЕсли;    
	
	ТабличныеЧасти = МетаданныеОбъекта.ТабличныеЧасти;
	
	Возврат НЕ (ТабличныеЧасти.Найти(ИмяТабличнойЧасти) = Неопределено);
	
КонецФункции

// Возвращает менеджер объекта документа, справочника или перечисления по ссылке на объект.
Функция МенеджерОбъектаПоСсылке_КонтурEDI(Ссылка)
	
	Если Ссылка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипСсылки = ТипЗнч(Ссылка);
	МенеджерОбъекта = ЭДО_Кэш_Прочитать("МенеджерОбъекта" + Строка(ТипСсылки));
	
	Если Не МенеджерОбъекта = Неопределено Тогда
		Возврат МенеджерОбъекта;
	КонецЕсли;
    	
	ИмяОбъекта = Ссылка.Метаданные().Имя;
	
	Если Справочники.ТипВсеСсылки().СодержитТип(ТипСсылки) Тогда
		
		МенеджерОбъекта = Справочники[ИмяОбъекта];
		
	ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипСсылки) Тогда
		
		МенеджерОбъекта = Документы[ИмяОбъекта];
		
	ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(ТипСсылки) Тогда
		
		МенеджерОбъекта = Перечисления[ИмяОбъекта];
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	ЭДО_Кэш_Поместить("МенеджерОбъекта" + Строка(ТипСсылки), МенеджерОбъекта);
	
	Возврат МенеджерОбъекта;
	
КонецФункции

//Функция проверяет существование и доступность в рамках ограничения на уровне записей объекта по переданной ссылке
Функция СсылкаСуществуетИДоступна_КонтурEDI(ПроизвольнаяСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИСТИНА КАК Поле
		|ИЗ
		|	&ИмяОбъектаМетаданных КАК ОбъектМетаданных
		|ГДЕ
		|	ОбъектМетаданных.Ссылка = &Ссылка";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИмяОбъектаМетаданных", ПроизвольнаяСсылка.Метаданные().ПолноеИмя());
	Запрос.УстановитьПараметр("Ссылка", ПроизвольнаяСсылка);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции


// #КонецОбласти //Конфигурация


// #Область ОбработкаРасхожденийСообщенияДокумента
	
//Вынесены общие блоки из форм ОбработкаРасхожденийПриемки (управляемой и обычной).
//Это пересекается с областью 20 Конфигурация, продумать размещение методов.
	
//разворачивает дерево Таб, которое видит пользователь, в плоскую ТаблицуЗначений
Функция ПроверитьСуществованиеРеквизитаобъектаМетаданных_КонтурEDI(Объект, ИмяРеквизита)  Экспорт

	Идентификатор = "" + ТипЗнч(Объект) + "_" + ИмяРеквизита; 
	
	ЕстьРеквизит = ЭДО_Кэш_Прочитать(Идентификатор);
	
	Если ЕстьРеквизит = Неопределено Тогда
		ЕстьРеквизит = (Метаданные.НайтиПоТипу(ТипЗнч(Объект)).Реквизиты.Найти(ИмяРеквизита) <> Неопределено);
		ЭДО_Кэш_Поместить(Идентификатор, ЕстьРеквизит);
	Конецесли;
		
	Возврат ЕстьРеквизит;

КонецФункции 

Функция СтруктураИзСтрокиТабЧасти_КонтурEDI(Объект)

	 Идентификатор = "" + ТипЗнч(Объект) + "_Реквизиты";
	 
	 Структура = ЭДО_Кэш_Прочитать(Идентификатор);
	 
	 Если Структура = Неопределено Тогда
		 Структура = Новый Структура;
		 Для Каждого Рек Из Метаданные.НайтиПоТипу(ТипЗнч(Объект)).Реквизиты Цикл
			 Структура.Вставить("" + Рек.Имя);
		 КонецЦикла;
	 КонецЕсли;
	 
	 Для Каждого ЭлементСтруктуры Из Структура Цикл
		  Структура.Вставить(ЭлементСтруктуры.Ключ, Неопределено);
	 КонецЦикла;
	 	 
	 Возврат Структура;

КонецФункции

Функция РазложитьДеревоСоответствийВТаблицу(ДеревоСоответствий) Экспорт
	
	ТабСоответствий = Новый ТаблицаЗначений;
	ДобавитьКолонкиВТаблицуЗначений(ТабСоответствий,
			"Номенклатура
			|ЕдиницаИзмерения
			|ХарактеристикаНоменклатуры
			|СерияНоменклатуры
			|КоэффициентEDIВ1С
			|КоличествоВНакладной
			|КоличествоПринято
			|ЦенаБезНДСВНакладной
			|ЦенаСНДСВНакладной
			|СуммаБезНДСВНакладной
			|СуммаСНДСВНакладной
			|ЦенаБезНДСПринято
			|ЦенаСНДСПринято
			|СуммаБезНДСПринято
			|СуммаСНДСПринято"
		);
	
	Для Каждого СтрОсн Из ДеревоСоответствий.Строки Цикл
		
		Если СтрОсн.ГруппаНоменклатур Тогда
			Для Каждого Стр Из СтрОсн.Строки Цикл
				НоваяСтрока = ТабСоответствий.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,Стр);
			КонецЦикла;
		Иначе
			НоваяСтрока = ТабСоответствий.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрОсн);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТабСоответствий;
	
КонецФункции	

Процедура ПересчитатьТабРасхожденийПриемки(ТабСоответствий) Экспорт
	
	МассивКолонокДляПересчета_Разделить = ПолучитьМассивКолонокДляПересчета_КонтурEDI(
	"КоличествоВНакладной,КоличествоПринято", ТабСоответствий);
	
	МассивКолонокДляПересчета_Умножить = ПолучитьМассивКолонокДляПересчета_КонтурEDI(
	"ЦенаБезНДСВНакладной,ЦенаБезНДСПринято,ЦенаСНДСВНакладной,ЦенаСНДСПринято", ТабСоответствий);
	
	Для Каждого СтрТаб Из ТабСоответствий Цикл		
		
		Коэффициент = КоэффициентEDIВ1С_Расчетный_КонтурEDI("В1С", СтрТаб.КоэффициентEDIВ1С);
		
		ПересчетСтроки_КонтурEDI(СтрТаб, Коэффициент, МассивКолонокДляПересчета_Разделить, МассивКолонокДляПересчета_Умножить); 		
		
	КонецЦикла;

КонецПроцедуры

Процедура ПриИзмененииНоменклатурыВСтрокеДокумента_КонтурEDI(СтрокаТабЧасти, ДокументОбъект) Экспорт

	СтандартнаяОбработкаEDI = Истина;
	
	РезультатПМ = ОбработкаСобытияПодключаемогоМодуля("ПриИзмененииНоменклатурыВСтрокеДокумента",СтандартнаяОбработкаEDI, Новый Структура("СтрокаТабЧасти, ДокументОбъект", СтрокаТабЧасти, ДокументОбъект));
	
	ИмяТабличнойЧасти = Метаданные.НайтиПоТипу(ТипЗнч(СтрокаТабЧасти)).Имя;  
	
	КонфигурацияДляЗапроса = ПолучитьИмяКонфигурацииДляЗапроса();
	
	Если СтандартнаяОбработкаEDI = Истина Тогда
		
		ПриИзмененииНоменклатурыВСтрокеДокументаПоКонфигурациям_КонтурEDI(ДокументОбъект, ИмяТабличнойЧасти, КонфигурацияДляЗапроса, СтрокаТабЧасти);

	КонецЕсли;
	
КонецПроцедуры

Процедура ПриИзмененииНоменклатурыВСтрокеДокументаПоКонфигурациям_КонтурEDI(ДокументОбъект, ИмяТабличнойЧасти, КонфигурацияДляЗапроса, СтрокаТабЧасти)
	 		
	Если КонфигурацияДляЗапроса = "БП_16" Тогда
		
		Выполнить("ОбработкаТабличныхЧастей.ПриИзмененииНоменклатурыТабЧасти(СтрокаТабЧасти, ДокументОбъект);"); 			
		Выполнить("ОбработкаТабличныхЧастей.ЗаполнитьНомерГТДИСтрануПроисхождения(СтрокаТабЧасти, Ложь, ДокументОбъект.Организация, ДокументОбъект.Дата);");  			
		Выполнить("ДокументОбъект.ЗаполнитьСчетаУчетаВСтрокеТабЧасти(СтрокаТабЧасти, ИмяТабличнойЧасти, Истина, ДокументОбъект.ОтражатьВНалоговомУчете);");
		Выполнить("ОбработкаТабличныхЧастей.ЗаполнитьСтавкуНДСТабЧасти(СтрокаТабЧасти, ДокументОбъект);");   
		
	ИначеЕсли КонфигурацияДляЗапроса = "БП_20" Тогда
		
		Если ТипЗнч(ДокументОбъект) <> Тип("ДокументОбъект.КорректировкаРеализации") Тогда 
			Выполнить("ОбработкаТабличныхЧастей.ПриИзмененииНоменклатурыТабЧасти(СтрокаТабЧасти, ДокументОбъект);");
			Выполнить("ОбработкаТабличныхЧастей.ЗаполнитьКодТНВЭД(СтрокаТабЧасти, ДокументОбъект.Дата);");			
		КонецЕсли;
		
		Выполнить("ОбработкаТабличныхЧастей.ЗаполнитьНомерГТДИСтрануПроисхождения(СтрокаТабЧасти, Ложь, ДокументОбъект.Организация, ДокументОбъект.Дата);"); 			
		Выполнить("ДокументОбъект.ЗаполнитьСчетаУчетаВСтрокеТабЧасти(СтрокаТабЧасти, ИмяТабличнойЧасти, Истина);");
		Выполнить("ОбработкаТабличныхЧастей.ЗаполнитьСтавкуНДСТабЧасти(СтрокаТабЧасти, ДокументОбъект);");
		
	ИначеЕсли КонфигурацияДляЗапроса = "БСХП_20" Тогда
		
		Выполнить("ОбработкаТабличныхЧастей.ПриИзмененииНоменклатурыТабЧасти(СтрокаТабЧасти, ДокументОбъект);"); 			
		Выполнить("ОбработкаТабличныхЧастей.ЗаполнитьНомерГТДИСтрануПроисхождения(СтрокаТабЧасти, Ложь, ДокументОбъект.Организация, ДокументОбъект.Дата);"); 			
		Выполнить("ОбработкаТабличныхЧастей.ЗаполнитьКодТНВЭД(СтрокаТабЧасти, ДокументОбъект.Дата);");			
		Выполнить("ДокументОбъект.ЗаполнитьСчетаУчетаВСтрокеТабЧасти(СтрокаТабЧасти, ИмяТабличнойЧасти, Истина);");
		Выполнить("ОбработкаТабличныхЧастей.ЗаполнитьСтавкуНДСТабЧасти(СтрокаТабЧасти, ДокументОбъект);");
				
	ИначеЕсли КонфигурацияДляЗапроса = "УТ_10_2" Тогда
		
		Выполнить("ПриИзмененииНоменклатурыТабЧасти(СтрокаТабЧасти, ДокументОбъект);");
		Выполнить("ЗаполнитьСтавкуНДСТабЧасти(СтрокаТабЧасти, ДокументОбъект);");
		Выполнить("ЗаполнитьСпособСписанияОстаткаТоваровТабЧасти(СтрокаТабЧасти, ДокументОбъект);");
		
	ИначеЕсли КонфигурацияДляЗапроса = "УТ_УПП_КА" Тогда
		
		Выполнить("ОбработкаТабличныхЧастей.ПриИзмененииНоменклатурыТабЧасти(СтрокаТабЧасти, ДокументОбъект);");
		
		Если Не ЗначениеЗаполнено(СтрокаТабЧасти.СтавкаНДС) Тогда
			Выполнить("ОбработкаТабличныхЧастей.ЗаполнитьСтавкуНДСТабЧасти(СтрокаТабЧасти, ДокументОбъект);");
		КонецЕсли;
	
		Если ПеременнаяСодержитСвойство(СтрокаТабЧасти, "СпособСписанияОстаткаТоваров") Тогда
			Выполнить("ОбработкаТабличныхЧастей.ЗаполнитьСпособСписанияОстаткаТоваровТабЧасти(СтрокаТабЧасти, ДокументОбъект);"); 
		КонецЕсли;
		
	ИначеЕсли КонфигурацияДляЗапроса = "УФ_БП" Тогда
		
		ПриИзмененииНоменклатурыВСтрокеДокументаУФ_БП_КонтурEDI(ИмяТабличнойЧасти, СтрокаТабЧасти, ДокументОбъект); 		
			
	ИначеЕсли КонфигурацияДляЗапроса = "УФ_УТ" Тогда
		
		ПриИзмененииНоменклатурыВСтрокеДокументаУФ_УТ_КонтурEDI(ДокументОбъект, СтрокаТабЧасти);
		
	ИначеЕсли КонфигурацияДляЗапроса = "УФ_Розница" Тогда
		
		ПриИзмененииНоменклатурыВСтрокеДокументаУФ_Розница_КонтурEDI(ДокументОбъект, СтрокаТабЧасти);
		
	Иначе
		
		//	ИначеЕсли КонфигурацияДляЗапроса = "ДалионУМ" Тогда 	
		//	ИначеЕсли КонфигурацияДляЗапроса = "ХБКП_УСП" Тогда 		
		//	ИначеЕсли КонфигурацияДляЗапроса = "УФ_УНФ" Тогда 		
		//	ИначеЕсли КонфигурацияДляЗапроса = "ТКПТ" Тогда 		
		// 	ИначеЕсли КонфигурацияДляЗапроса = "Астор" Тогда
		
	КонецЕсли;

КонецПроцедуры

Процедура ПриИзмененииНоменклатурыВСтрокеДокументаУФ_БП_КонтурEDI(ИмяТабличнойЧасти, СтрокаТабЧасти, ДокументОбъект)

	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		
		ПриИзмененииНоменклатурыВСтрокеДокументаРеализацияТоваровУслугУФ_БП_КонтурEDI(ИмяТабличнойЧасти, СтрокаТабЧасти, ДокументОбъект);
		
	КонецЕсли;
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КорректировкаРеализации") Тогда
		
		ПриИзмененииНоменклатурыВСтрокеДокументаКорректировкаРеализацииУФ_БП_КонтурEDI(ИмяТабличнойЧасти, СтрокаТабЧасти, ДокументОбъект);
		
