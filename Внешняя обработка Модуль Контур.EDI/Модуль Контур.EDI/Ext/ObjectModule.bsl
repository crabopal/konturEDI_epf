		Прокси.Вставить("username"  , НастройкиПрокси.ЛогинПрокси);
		Прокси.Вставить("password"  , НастройкиПрокси.ПарольПрокси);
		Прокси.Вставить("ИспользоватьСистемныеНастройкиПрокси", НастройкиПрокси.ИспользоватьСистемныеНастройкиПрокси);
		Прокси.Вставить("СпособАутентификацииПрокси", НастройкиПрокси.СпособАутентификацииПрокси);
		
		ПараметрыЗапроса.Вставить("Прокси", Прокси);
		
	КонецЕсли;
	
	Возврат ВыполнитьHTTPЗапрос(Метод, АдресРесурса, ПараметрыЗапроса);
	
КонецФункции

// Выполняет HTTP запрос к серверу.
//
// Параметры:
//	 Метод 			  - Строка 	  - Метод запроса, например: "GET", "POST".
//	 АдресРесурса 	  - Строка 	  - Адрес ресурса, например: "https://diadoc-api.kontur.ru/GetBox"
//	 ПараметрыЗапроса - Структура - Различные параметры запроса
//	 Состав структуры:
//		Параметры		- Соответствие - (необязательный) Параметры строки запроса, где:
//											Ключ 	 - Имя параметра
//											Значение - Значение параметра
//		Заголовки		- Соответствие - (необязательный) Заголовки запроса, где:
//											Ключ 	 - Имя заголовка
//											Значение - Значение заголовка
//		ТелоЗапроса					   - (необязательный) 
//														 Примеры: Новый Структура("ДвоичныеДанные", ДвоичныеДанные)
//			  													  Новый Структура("file", ПолноеИмяФайла)
//																  Новый Структура("Файл", ПолноеИмяФайла)
//																  Новый Структура("Строка", Строка)
//																  Новый Структура("string", Строка)
//		ТелоОтвета					   - (необязательный)
//														 Примеры: Новый Структура("ДвоичныеДанные", ДвоичныеДанные)
//			  													  Новый Структура("file", ПолноеИмяФайла)
//																  Новый Структура("Файл", ПолноеИмяФайла)
//																  Новый Структура("Строка", Строка)
//																  Новый Структура("string", Строка)
Функция ВыполнитьHTTPЗапрос(Метод, Адрес, ПараметрыЗапроса) Экспорт
		
	Если ЗначениеЗаполнено(ТаблицаКэшИсполняемогоКодаРасширений) Тогда//Если модуль инициализирован	
		РезультатПМ = ОбработкаСобытияПодключаемогоМодуля("ВыполнитьHTTPЗапрос",, Новый Структура("Метод,Адрес,ПараметрыЗапроса", Метод, Адрес, ПараметрыЗапроса));
		Если НЕ РезультатПМ = Неопределено Тогда
			Возврат РезультатПМ;
		КонецЕсли;
	КонецЕсли;
	
	СоставАдреса = Новый Структура;	
	СоставАдреса = СтруктураURI(Адрес);
	
	Если ПустаяСтрока(СоставАдреса.Порт) Тогда
		Протокол = ВРег(СоставАдреса.Схема);
		Если Протокол = "HTTP" Тогда
			СоставАдреса.Порт = 80;
		ИначеЕсли Протокол = "HTTPS" Тогда
			СоставАдреса.Порт = 443;
		КонецЕсли;
	КонецЕсли;
	
	Если ИспользоватьКонтурPlugin = Истина Тогда
		
		Ответ = КонтурПлагин().ВыполнитьHTTPЗапрос(Метод, Адрес, ПараметрыЗапроса);
		
	Иначе
		
		Прокси = Новый ИнтернетПрокси;

		Если ПараметрыЗапроса.Свойство("Прокси") Тогда
					
			СоставАдресаПрокси = Новый Структура;
			СоставАдресаПрокси = СтруктураURI(ПараметрыЗапроса.Прокси.host);
			
			ИспользоватьСистемныеНастройкиПрокси = КонтурСтандарт_ЗначениеПоКлючу(ПараметрыЗапроса.Прокси, "ИспользоватьСистемныеНастройкиПрокси", Ложь);
			СпособАутентификацииПрокси = КонтурСтандарт_ЗначениеПоКлючу(ПараметрыЗапроса.Прокси, "СпособАутентификацииПрокси", Неопределено);
			
			Прокси = СоздатьИнтернетПрокси(СоставАдресаПрокси.Хост, 
									   	   СоставАдресаПрокси.Порт, 
									   	   ПараметрыЗапроса.Прокси.username, 
									  	   ПараметрыЗапроса.Прокси.password,
									   	   ИспользоватьСистемныеНастройкиПрокси,
									   	   СпособАутентификацииПрокси);
			
		КонецЕсли;
		
		СтрокаПараметрыЗапроса = ПолучитьСтрокуПараметровHTTPЗапроса(ПараметрыЗапроса.Параметры);
		АдресРесурса 		   = СоставАдреса.ПутьНаСервере + ?( ПустаяСтрока(СтрокаПараметрыЗапроса), "", "?" ) + СтрокаПараметрыЗапроса;
		
		Если ВРег(СоставАдреса.Схема) = "HTTPS" Тогда
			ЗащищенноеСоединение = Вычислить("Новый ЗащищенноеСоединениеOpenSSL");
		Иначе
			ЗащищенноеСоединение = Неопределено;
		КонецЕсли;
		
		HTTPЗапрос = Вычислить("Новый HTTPЗапрос(АдресРесурса, ПараметрыЗапроса.Заголовки)");
		
		УстановитьТелоHTTPЗапроса(HTTPЗапрос, ПараметрыЗапроса);
		ИмяВыходногоФайла = ОпределитьИмяВыходногоФайлаHTTPЗапроса(ПараметрыЗапроса);
		HTTPКодыПеренаправления = HTTPКодыПеренаправления();
		
		СчетчикПеренаправлений = 0;
		КоличествоПопыток = 5;
		Таймаут = 20;

		ПеременнаяСодержитСвойство(ПараметрыЗапроса, "Таймаут", Таймаут, Истина); 

        Для Счетчик = 1 По КоличествоПопыток Цикл
			
			Попытка 
				
				HTTPСоединение = Новый HTTPСоединение(СоставАдреса.Хост, СоставАдреса.Порт, , , Прокси, Таймаут, ЗащищенноеСоединение);
				
				HTTPОтвет = ВызватьHTTPМетод_КонтурEDI(HTTPСоединение, Метод, HTTPЗапрос, ИмяВыходногоФайла);
				
				Пока СчетчикПеренаправлений < 10 
					И HTTPКодыПеренаправления.Найти(HTTPОтвет.КодСостояния) <> Неопределено 
					И ЗначениеЗаполнено(HTTPОтвет.Заголовки["Location"]) Цикл
					
					СчетчикПеренаправлений = СчетчикПеренаправлений + 1;
					
					URI = СтруктураURI(HTTPОтвет.Заголовки["Location"]);
					
					HTTPЗапрос = Вычислить("Новый HTTPЗапрос(URI.ПутьНаСервере, ПараметрыЗапроса.Заголовки)");
					
					HTTPСоединение = Новый HTTPСоединение(URI.Хост, URI.Порт, , , Прокси, Таймаут, ЗащищенноеСоединение);
					
					HTTPОтвет = ВызватьHTTPМетод_КонтурEDI(HTTPСоединение, Метод, HTTPЗапрос, ИмяВыходногоФайла);
					
				КонецЦикла;
				
				Прервать;
				
			Исключение 
				
				Если Счетчик < КоличествоПопыток  Тогда 
					
					Продолжить;
					
				КонецЕсли;
				
				ТекстОшибки = "Не удалось выполнить HTTP запрос - " + Адрес + " - " + ОписаниеОшибки();
				ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);
				ВызватьИсключение ТекстОшибки;
				
			КонецПопытки;
			
		КонецЦикла;
		
		Ответ = Новый Структура;
		Ответ.Вставить("КодСостояния" , Строка(HTTPОтвет.КодСостояния));
		Ответ.Вставить("Заголовки", HTTPОтвет.Заголовки);
		
		Если ПараметрыЗапроса.ТелоОтвета.Свойство("string") Или
			ПараметрыЗапроса.ТелоОтвета.Свойство("Строка") Тогда

			Ответ.Вставить("ТелоОтвета" , HTTPОтвет.ПолучитьТелоКакСтроку());
			
		ИначеЕсли ПараметрыЗапроса.ТелоОтвета.Свойство("ДвоичныеДанные") Тогда
			
			Ответ.Вставить("ТелоОтвета"	 , HTTPОтвет.ПолучитьТелоКакДвоичныеДанные());
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ответ;

КонецФункции

Функция ВыполнитьHTTPЗапросКонтурПлагин(Сессия, ПодготовленныйЗапрос, Настройки) Экспорт

	ПараметрыКонтурПлагин = КонтурПлагин().НовыеПараметрыHTTPЗапроса();
	
	ПараметрыКонтурПлагин.Заголовки = ПодготовленныйЗапрос.Заголовки;
	
	Если Настройки.Прокси <> Неопределено Тогда
		НастройкиПрокси = Настройки.Прокси; 	
	ИначеЕсли Сессия.Прокси <> Неопределено Тогда
		НастройкиПрокси = Сессия.Прокси;	
	Иначе
		НастройкиПрокси = Неопределено;	
	КонецЕсли;
	
	Если НастройкиПрокси <> Неопределено Тогда
		
		СтруктураURL = КлиентHTTP_РазобратьURL(ПодготовленныйЗапрос.URL);
		
		Прокси = Новый Структура;
		Прокси.Вставить("host"		, НастройкиПрокси.Сервер(СтруктураURL.Схема) + ":" + Формат(НастройкиПрокси.Порт(СтруктураURL.Схема),"ЧГ=0"));
		Прокси.Вставить("username"  , "");
		Прокси.Вставить("password"  , "");
		
		Если КонтурСтандарт_ВерсияРежимСовместимостиНеНижеУказанной("8.3.6") Тогда
			
			Прокси.username = НастройкиПрокси.Пользователь(СтруктураURL.Схема);
			Прокси.password = НастройкиПрокси.Пароль(СтруктураURL.Схема);

		Иначе
			
			Прокси.username = НастройкиПрокси.Пользователь;
			Прокси.password = НастройкиПрокси.Пароль;
			
		КонецЕсли;
		
		ПараметрыКонтурПлагин.Вставить("Прокси", Прокси);
	КонецЕсли;
	
	Если Настройки.Свойство("Таймаут") Тогда
		
		ПараметрыКонтурПлагин.Вставить("Таймаут", Настройки.Таймаут);	
		
	КонецЕсли;
	
	ТелоЗапроса = ПодготовленныйЗапрос.HTTPЗапрос.ПолучитьТелоКакДвоичныеДанные();  
	
	Если ЗначениеЗаполнено(ТелоЗапроса) Тогда 
		Если ТипЗнч(ТелоЗапроса) = Тип("ДвоичныеДанные") Тогда
			ПараметрыКонтурПлагин.ТелоЗапроса = Новый Структура("ДвоичныеДанные", ТелоЗапроса);
		ИначеЕсли ТипЗнч(ТелоЗапроса) = Тип("Строка") Тогда 
			ПараметрыКонтурПлагин.ТелоЗапроса = Новый Структура("Строка", ТелоЗапроса);
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыКонтурПлагин.ТелоОтвета  = Новый Структура("ДвоичныеДанные");
	
	
	Ответ = КонтурПлагин().ВыполнитьHTTPЗапрос(ПодготовленныйЗапрос.Метод, ПодготовленныйЗапрос.URL, ПараметрыКонтурПлагин);	
	
	Возврат Ответ;
	
КонецФункции

Функция HTTPКодыПеренаправления()
	
	МассивКодовПеренаправления = Новый Массив;
	МассивКодовПеренаправления.Добавить(301);
	МассивКодовПеренаправления.Добавить(302);
	МассивКодовПеренаправления.Добавить(303);
	МассивКодовПеренаправления.Добавить(307);
	МассивКодовПеренаправления.Добавить(308);
	
	Возврат МассивКодовПеренаправления
	
КонецФункции

Процедура УстановитьТелоHTTPЗапроса(HTTPЗапрос, ПараметрыЗапроса)
	
	Если ПараметрыЗапроса.ТелоЗапроса.Свойство("string")
		ИЛИ ПараметрыЗапроса.ТелоЗапроса.Свойство("Строка") Тогда
		
		ТелоЗапроса = ?(ПараметрыЗапроса.ТелоЗапроса.Свойство("string"), ПараметрыЗапроса.ТелоЗапроса.string,
		ПараметрыЗапроса.ТелоЗапроса.Строка);   
		
		HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса, "CESU-8");
		
	ИначеЕсли ПараметрыЗапроса.ТелоЗапроса.Свойство("ДвоичныеДанные") Тогда
		
		HTTPЗапрос.УстановитьТелоИзДвоичныхДанных(ПараметрыЗапроса.ТелоЗапроса.ДвоичныеДанные); 
		
	ИначеЕсли ПараметрыЗапроса.ТелоЗапроса.Свойство("файл")
		ИЛИ ПараметрыЗапроса.ТелоЗапроса.Свойство("file") Тогда
		
		ТелоЗапроса = ?(ПараметрыЗапроса.ТелоЗапроса.Свойство("файл"), ПараметрыЗапроса.ТелоЗапроса.файл,
		ПараметрыЗапроса.ТелоЗапроса.file);   
		
		HTTPЗапрос.УстановитьИмяФайлаТела(ТелоЗапроса);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ОпределитьИмяВыходногоФайлаHTTPЗапроса(ПараметрыЗапроса)
	
	ИмяВыходногоФайла = Неопределено;
	
	Если ПараметрыЗапроса.ТелоОтвета.Свойство("file")
		ИЛИ ПараметрыЗапроса.ТелоОтвета.Свойство("файл") Тогда
		
		ИмяВыходногоФайла = ?(ПараметрыЗапроса.ТелоОтвета.Свойство("файл"), ПараметрыЗапроса.ТелоОтвета.файл,
			ПараметрыЗапроса.ТелоОтвета.file);   
			
	КонецЕсли;
		
	Возврат ИмяВыходногоФайла;
	
КонецФункции

Функция ВызватьHTTPМетод_КонтурEDI(HTTPСоединение, HTTPМетод, HTTPЗапрос, ИмяВыходногоФайла = "")
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	
	Если СравнитьВерсииПрограммногоПродукта(СистемнаяИнформация.ВерсияПриложения,"8.3.6",3) = ВидСравнения.Больше Тогда
		
		HTTPОтвет = HTTPСоединение.ВызватьHTTPМетод(HTTPМетод, HTTPЗапрос, ИмяВыходногоФайла);
		
	Иначе
		
		Если ВРег(HTTPМетод) = "GET" Тогда 
			
			HTTPОтвет = HTTPСоединение.Получить(HTTPЗапрос, ИмяВыходногоФайла);
			
		ИначеЕсли ВРег(HTTPМетод) = "POST" Тогда 
			
			HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос, ИмяВыходногоФайла);
			
		ИначеЕсли ВРег(HTTPМетод) = "PUT" Тогда 
			
			HTTPОтвет = HTTPСоединение.Записать(HTTPЗапрос);
			
		Иначе
			
			ВызватьИсключение "Не реализована работа с HTTP методом: " + HTTPМетод;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат HTTPОтвет;

КонецФункции

// Метод для отправки сообщения.
// Имя ресурса: /V1/Messages/SendMessage
// HTTP метод: POST
// Параметры строки запроса:
//							boxId - идентификатор ящика.
//
// Результат: Структура - КодСостояния , ТелоОтвета (структура UsersInfo) , Заголовки
//
// В теле запроса должен быть передан массив байт - содержимое сообщения.
// В ответе сервер вернет структуру OutboxMessageMeta, которая идентифицирует исходящее сообщение.
Функция EDI_API_SendMessage(Токен, ИдентификаторЯщика, ТелоЗапроса) Экспорт
	
	ПараметрыЗапроса = НовыеПараметрыHTTPЗапроса();
	ПараметрыЗапроса.Параметры.Вставить("boxId" , ИдентификаторЯщика);
	ПараметрыЗапроса.ТелоЗапроса = Новый Структура("Строка", ТелоЗапроса);
	ПараметрыЗапроса.ТелоОтвета  = Новый Структура("Строка");
	
	Возврат ВыполнитьHTTPЗапрос_EDI("POST", "/V1/Messages/SendMessage", ПараметрыЗапроса, Токен);
	
КонецФункции

