			КонецЕсли;
			
			ДобавитьОписаниеМетаданныхПоляСообщения(ТабМетаданныхПоля, ПолеОсобенности.Идентификатор, ПолеОсобенности.ТипЗначенияEDI);
			
		КонецЦикла;
		
	КонецЕсли;
	
	ЭДО_Кэш_Поместить("МетаданныеПоляСообщения_"+ВидСтруктуры,ТабМетаданныхПоля);
	
