	Если ЗначениеЗаполнено(СообщениеRETANN) Тогда 
		
		Сообщение.УведомлениеОВозвратеEDI.Номер = СообщениеRETANN.НомерДокумента;
		Сообщение.УведомлениеОВозвратеEDI.Дата  = СообщениеRETANN.ДатаДокумента;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СообщениеRETINS) Тогда 
		
		Сообщение.УведомлениеОПодтвержденииВозвратаEDI.Номер = СообщениеRETINS.НомерДокумента;
		Сообщение.УведомлениеОПодтвержденииВозвратаEDI.Дата  = СообщениеRETINS.ДатаДокумента;
		
	КонецЕсли;
	
	Сообщение.ВозвратнаяНакладнаяEDI.Номер = ДокументСсылка.Номер;
	Сообщение.ВозвратнаяНакладнаяEDI.Дата  = ДокументСсылка.Дата;
	
	ТоварыДокумента = ПолучитьТоварыДокументаДляСообщения(ДокументСсылка, Истина, "ПодготовитьУведомлениеОбОтгрузкеВозврата", Сообщение);
	ЕстьКолонкаСтавкаНДС = ТоварыДокумента.Колонки.Найти("СтавкаНДС") <> Неопределено; 
	
	Для Каждого СтрокаТоваровДокумента Из ТоварыДокумента Цикл
		
		СтрокаТоваровСообщения = Сообщение.Товары.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаТоваровСообщения, СтрокаТоваровДокумента);
		
		Если ЕстьКолонкаСтавкаНДС Тогда
			СтрокаТоваровСообщения.СтавкаНДС1С = СтрокаТоваровДокумента.СтавкаНДС;
		КонецЕсли;
		
		СтрокаТоваровСообщения.ТекстПересчета = ТекстПересчета_КонтурEDI(
			СтрокаТоваровСообщения.ЕдиницаИзмерения, 
			СтрокаТоваровСообщения.КодЕдиницыИзмеренияEDI, 
			СтрокаТоваровСообщения.КоэффициентEDIВ1С);
		
	КонецЦикла;
	
	ЗаполнитьПредставлениеЕдиницыИзмеренияВТаблицеТоваров(Сообщение.Товары);
	
КонецПроцедуры

//INVOIC
Функция ПодготовитьСчетФактуру(ДокументСсылка, Сообщение, Параметры = Неопределено)
	
	Если ЕстьКоррИспрСФ Тогда
		
		ТипИсходящийКСФ = ПолучитьТипЗначенияОбъекта("ИсходящийКСФ");
		ТипДокументаСчетФактура = ПолучитьТипЗначенияОбъекта("ТипДокументаСчетФактура");
		
		Если ЗначениеЗаполнено(ТипИсходящийКСФ) И ТипЗнч(ДокументСсылка) = Тип(ТипИсходящийКСФ) Тогда
			КорректировкаРеализации = ДокументСсылка;
		ИначеЕсли ЗначениеЗаполнено(ТипДокументаСчетФактура) И ТипЗнч(ДокументСсылка) = Тип(ТипДокументаСчетФактура) Тогда
			КорректировкаРеализации = ПолучитьКорректировкуРеализацииСчетаФактуры(ДокументСсылка);
		КонецЕсли;
		
		// заполняем исправительный СФ в отдельной процедуре
		Если ЗначениеЗаполнено(КорректировкаРеализации) Тогда
			ПодготовитьИсправительныйКорректировочныйСчетФактуру(ДокументСсылка, Сообщение, Параметры);
			Возврат Сообщение;	
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИспользоватьМаппингМетаданных Тогда
		Маппинг_ПодготовитьСчетФактуру(ДокументСсылка,Сообщение,Параметры);
		Возврат Неопределено;
	КонецЕсли;
	
	Сообщение.Документ1С 		= ДокументСсылка;
	Сообщение.СчетФактура1С		= ДокументСсылка;
	Сообщение.Заказ1С			= НайтиСвязанныйДокументПоТипуСообщения(ДокументСсылка,"ORDERS");
	
	ТипРеализации = ПолучитьТипЗначенияОбъекта("ИсходящееУведомлениеОбОтгрузке");
	ТипДокумента = ТипЗнч(ДокументСсылка);
	
	Если ЗначениеЗаполнено(ТипРеализации) И Тип(ТипРеализации) = ТипДокумента Тогда
		Сообщение.Накладная1С = ДокументСсылка;
	Иначе
		Сообщение.Накладная1С = НайтиСвязанныйДокументПоТипуСообщения(ДокументСсылка,"DESADV");
	КонецЕсли; 	
	
	Сообщение.Приемка1С			= НайтиСвязанныйДокументПоТипуСообщения(ДокументСсылка,"RECADV");
	
	Накладная = Сообщение.Накладная1С;
	
	Организация = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Организация");
	Сообщение.Отправитель1С = Организация;
	Сообщение.Продавец1С 	= Организация;
	
	Контрагент = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Контрагент");
	РезультатОпределения = ОпределитьПартнераИКонтрагентаДляИсходящегоСообщения(Контрагент, Сообщение);
	
	Сообщение.Партнер = РезультатОпределения.Партнер;
	Сообщение.Получатель1С = РезультатОпределения.Партнер;
	Сообщение.Покупатель1С = РезультатОпределения.Контрагент;
	
	Сообщение.Грузоотправитель1С = ПолучитьРеквизитДокументаДляСообщения(Накладная, "Грузоотправитель");
	Сообщение.Грузополучатель1С = ПолучитьРеквизитДокументаДляСообщения(Накладная, "Грузополучатель");
	
	Сообщение.Валюта1С			= ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Валюта");
	Сообщение.Договор			= ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Договор");
	Сообщение.Контракт1С		= Сообщение.Договор;//это поле будет записано в contractIdentificator
	
	Сообщение.ДатаПоставки	= ОпределитьДатуПоставки(Сообщение); //опирается на знание партнера сообщения
	
	Если Не ЗначениеЗаполнено(Сообщение.ДатаПоставкиФактическая) И ЗначениеЗаполнено(Накладная) Тогда
		Сообщение.ДатаПоставкиФактическая = ПолучитьРеквизитДокументаДляСообщения(Накладная, "ФактическаяДатаПоставки", Сообщение);
	КонецЕсли;
	
	Сообщение.СуммаТоваровНДС = 0;
	Сообщение.СуммаТоваровВсего = 0;
	Сообщение.СуммаТоваровВсегоБезНДС = 0;
	
	ДокументДляПолученияТоваров = ОпределитьДокументДляПолученияТоваровСообщения(Сообщение);
	
	ИсточникПодготовкиТоваров = "ПодготовкаСчетФактурыКОтправке";
	КонтекстСообщенияДляПодготовкиТоваров = Сообщение;
	
	Если ЗначениеЗаполнено(Параметры) Тогда
		
		Если ПеременнаяСодержитСвойство(Параметры, "ИсточникПодготовкиТоваров",,Истина) Тогда
			ИсточникПодготовкиТоваров = Параметры.ИсточникПодготовкиТоваров;
		КонецЕсли;
		
		Если ПеременнаяСодержитСвойство(Параметры, "КонтекстСообщенияДляПодготовкиТоваров",,Истина) Тогда 
			КонтекстСообщенияДляПодготовкиТоваров = Параметры.КонтекстСообщенияДляПодготовкиТоваров;
		КонецЕсли;
		
	КонецЕсли;
	
	МассивВозвратов = ПолучитьСвязанныеДокументыВходящихВозвратов(Сообщение);
	
	Товары = ПолучитьТоварыДокументаДляСообщения(ДокументДляПолученияТоваров,
												 Истина, 
												 ИсточникПодготовкиТоваров, 
												 МассивВозвратов, 
												 КонтекстСообщенияДляПодготовкиТоваров);
	
	Для Каждого Стр Из Товары Цикл
		
		НоваяСтрока = Сообщение.Товары.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Стр);
		
		НоваяСтрока.СтавкаНДС1С = Стр.СтавкаНДС;
		НоваяСтрока.НомерГТД1С = Стр.НомерГТД;
		НоваяСтрока.Страна1С = Стр.Страна;
		
		НоваяСтрока.ТекстПересчета = ТекстПересчета_КонтурEDI(
			НоваяСтрока.ЕдиницаИзмерения, 
			НоваяСтрока.КодЕдиницыИзмеренияEDI, 
			НоваяСтрока.КоэффициентEDIВ1С);

		Если Стр.ТипЕдиницы <> "RC" Тогда//по возвратной таре сумму не считаем
			Сообщение.СуммаТоваровНДС			= Сообщение.СуммаТоваровНДС + Стр.СуммаНДС;
			Сообщение.СуммаТоваровВсего			= Сообщение.СуммаТоваровВсего + Стр.СуммаСНДС;
			Сообщение.СуммаТоваровВсегоБезНДС	= Сообщение.СуммаТоваровВсегоБезНДС + Стр.СуммаБезНДС;
		КонецЕсли;	
		
	КонецЦикла;
	
	ЗаполнитьПредставлениеЕдиницыИзмеренияВТаблицеТоваров(Сообщение.Товары);
	ЗаполнитьТипыМаркируемойПродукции(Сообщение); 
	
	ДополнитьСообщениеСохраненнымиДанными(Сообщение, Параметры);
	
КонецФункции

Функция ПолучитьИлиСоздать_Diadoc_operationID(СообщениеСсылка) Экспорт
	
	operationID = Diadoc_operationID(СообщениеСсылка);
	
	Если operationID = Неопределено Тогда
		
		operationID = Новый_Diadoc_operationID(СообщениеСсылка);
		
	КонецЕсли;
	
	Возврат operationID;
	
КонецФункции

Функция Diadoc_operationID(СообщениеСсылка) Экспорт
	
	Возврат	ПолучитьЗначениеДопРеквизитаСправочника_КонтурEDI(СообщениеСсылка, "operationID");
	
КонецФункции

Функция Новый_Diadoc_operationID(СообщениеСсылка) Экспорт
	
	operationID = Строка(Новый УникальныйИдентификатор());
	
	РеквизитыКЗаполенению = Новый Структура("operationID", operationID);
	
	Если ТипЗнч(СообщениеСсылка) = Тип("СправочникСсылка.КонтурEDI_Сообщения") Тогда
		СправочникОбъект = СообщениеСсылка.ПолучитьОбъект();
	Иначе
		СправочникОбъект = СообщениеСсылка;
	КонецЕсли;
	
	ЗаполнитьДопРеквизитыОбъектаСправочника_КонтурEDI(СправочникОбъект, РеквизитыКЗаполенению);
	
	Возврат operationID;
	
КонецФункции

// пока только в режиме поставщика
Функция ОпределитьДокументДляПолученияТоваровСообщения(Сообщение) Экспорт
	
	Документ 	= Неопределено;
	МыПоставщик = (ОпределитьКемМыЯвляемся(Сообщение) = "Поставщик");
	
	Если МыПоставщик Тогда
		
		Если Сообщение.ТипСообщения = "INVOIC" Тогда
			Если ПодготовитьINVOICПоДокументуСчетФактура() Тогда
				Документ = Сообщение.СчетФактура1С;
			Иначе
				Документ = Сообщение.Накладная1С;
			КонецЕсли;
		Иначе
			Документ = Сообщение.ДокументСсылка;
		КонецЕсли;
		
	Иначе
		Документ = Сообщение.ДокументСсылка;	
	КонецЕсли;
	
	Возврат Документ;
	
КонецФункции

Функция ПодготовитьINVOICПоДокументуСчетФактура() Экспорт
	
	ТипДокументаDESADV 	= ПолучитьТипЗначенияОбъекта("ИсходящееУведомлениеОбОтгрузке", 	Истина);
	ТипДокументаINVOIC 	= ПолучитьТипЗначенияОбъекта("ИсходящийСчетФактура",			Истина);
	
	Если ИмяКонфигурации1С = "УФ_УНФ"
		И НЕ ТипДокументаDESADV = ТипДокументаINVOIC
		И ЕстьНеобходимыеМетаданные("Документы.СчетФактура.ТабличныеЧасти.Запасы") Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
		
КонецФункции

Функция ОснованиеINVOICСчетФактура()
	
	ТипДокументаDESADV 	= ПолучитьТипЗначенияОбъекта("ИсходящееУведомлениеОбОтгрузке", 	Истина);
	ТипДокументаINVOIC 	= ПолучитьТипЗначенияОбъекта("ИсходящийСчетФактура",			Истина);
	
	Возврат НЕ ТипДокументаDESADV = ТипДокументаINVOIC;
	
КонецФункции

Процедура ЗаполнитьТипыМаркируемойПродукции(Сообщение)

	СпособЗаполнения = СпособЗаполненияТиповПродукции();
	СпособыЗаполненияТиповПродукции = ПеречисленияEDI_СпособыЗаполненияТиповПродукции(); 

	Если СпособЗаполнения = СпособыЗаполненияТиповПродукции.ОсобенностьУчета Тогда
		ЗаполнитьТипыМаркируемойПродукции_ОсобенностьУчета(Сообщение);
	ИначеЕсли СпособЗаполнения = СпособыЗаполненияТиповПродукции.КлючВидовПродукции Тогда
		ЗаполнитьТипыМаркируемойПродукции_КлючВидовПродукции(Сообщение);
	ИначеЕсли СпособЗаполнения = СпособыЗаполненияТиповПродукции.ВидПродукцииИС Тогда
		ЗаполнитьТипыМаркируемойПродукции_ВидПродукцииИС(Сообщение);
	ИначеЕсли СпособЗаполнения = СпособыЗаполненияТиповПродукции.ВидМаркировки Тогда
		ЗаполнитьТипыМаркируемойПродукции_ВидПродукцииИС(Сообщение, "ВидМаркировки");
	ИначеЕсли СпособЗаполнения = СпособыЗаполненияТиповПродукции.УФ_БП Тогда
		ЗаполнитьТипыМаркируемойПродукции_УФ_БП(Сообщение);
	КонецЕсли;
	
КонецПроцедуры

Функция СпособЗаполненияТиповПродукции()
	
	СпособЗаполнения = ЭДО_Кэш_Прочитать("СпособЗаполненияТиповМаркируемойПродукции");
	
	Если СпособЗаполнения = Неопределено Тогда
		
		СпособЗаполнения = "";
		Если ЕстьНеобходимыеМетаданные("Справочники.КлючиВидовПродукцииИС")
			И ЕстьНеобходимыеМетаданные("РегистрыСведений.ОписаниеНоменклатурыИС") 
			И ЕстьОбщийМодуль1С_КонтурEDI("КонструкторИСОбщегоНазначенияКлиентСервер") Тогда
			
			//УФ_УНФ, УФ_УТ, УТ_УПП_КА, Розница 3.0
			СпособЗаполнения = ПеречисленияEDI_СпособыЗаполненияТиповПродукции().КлючВидовПродукции;
			
		ИначеЕсли ЕстьНеобходимыеМетаданные("Справочники.ВидыНоменклатуры.Реквизиты.ОсобенностьУчета")
			И ЕстьНеобходимыеМетаданные("Перечисления.ОсобенностиУчетаНоменклатуры")
			И ЕстьНеобходимыеМетаданные("Справочники.Номенклатура.Реквизиты.ВидНоменклатуры") Тогда 
			
			//УФ_УТ, Розница 2.3, УТАП
			СпособЗаполнения = ПеречисленияEDI_СпособыЗаполненияТиповПродукции().ОсобенностьУчета;
			
		ИначеЕсли ЕстьНеобходимыеМетаданные("Перечисления.ВидыПродукцииИС") 
			И ЕстьНеобходимыеМетаданные("Справочники.Номенклатура.Реквизиты.ВидПродукцииИС") Тогда 

			//УФ_УНФ, УТ_УПП_КА, Розница 3.0
			СпособЗаполнения = ПеречисленияEDI_СпособыЗаполненияТиповПродукции().ВидПродукцииИС;
		
		ИначеЕсли ЕстьНеобходимыеМетаданные("Перечисления.ВидыПродукцииИС")
			И ЕстьНеобходимыеМетаданные("Справочники.Номенклатура.Реквизиты.ВидМаркировки") Тогда
			
			//Актуальная УФ_БП
			СпособЗаполнения = ПеречисленияEDI_СпособыЗаполненияТиповПродукции().ВидМаркировки;
		
		ИначеЕсли ПолучитьИмяКонфигурацииДляЗапроса() = "УФ_БП" Тогда
			
			СпособЗаполнения = ПеречисленияEDI_СпособыЗаполненияТиповПродукции().УФ_БП;
			
		КонецЕсли;
		
		ЭДО_Кэш_Поместить("СпособЗаполненияТиповМаркируемойПродукции", СпособЗаполнения);
		
	КонецЕсли;		
	
	Возврат СпособЗаполнения;
	
КонецФункции

Процедура ЗаполнитьТипыМаркируемойПродукции_УФ_БП(Сообщение)
	
	ТекстЗапроса = ЭДО_Кэш_Прочитать("ТекстЗапросаТипМаркируемойПродукции");	
	
	Если ТекстЗапроса = Неопределено Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		               |	ВЫБОР
		               |		КОГДА Номенклатура.ТабачнаяПродукция
		               |				ИЛИ Номенклатура.НикотиносодержащаяПродукция
		               |				ИЛИ Номенклатура.АльтернативныйТабак
		               |			ТОГДА ""Tobacco""
		               |		КОГДА Номенклатура.Пиво
		               |				ИЛИ Номенклатура.ПивоВПотребительскихУпаковках
					   |				ИЛИ Номенклатура.АлкогольнаяПродукцияДо9Процентов
		               |			ТОГДА ""Alcohol""
		               |		ИНАЧЕ """"
		               |	КОНЕЦ КАК ОсобенностьУчета
		               |ИЗ
		               |	Справочник.Номенклатура КАК Номенклатура
		               |ГДЕ
		               |	Номенклатура.Ссылка В (&НоменклатураСообщения)";
		
		РеквизитыДляПроверки = Новый Массив;
		РеквизитыДляПроверки.Добавить("ТабачнаяПродукция");
		РеквизитыДляПроверки.Добавить("НикотиносодержащаяПродукция");
		РеквизитыДляПроверки.Добавить("АльтернативныйТабак");
		РеквизитыДляПроверки.Добавить("ПивоВПотребительскихУпаковках");
		РеквизитыДляПроверки.Добавить("Пиво");
		РеквизитыДляПроверки.Добавить("АлкогольнаяПродукцияДо9Процентов");
		
		ЕстьРеквизиты = Ложь;
		
		Для каждого РеквизитНоменклатуры Из РеквизитыДляПроверки Цикл

			Если ЕстьНеобходимыеМетаданные("Справочники.Номенклатура.Реквизиты." + РеквизитНоменклатуры) Тогда
				ЕстьРеквизиты = Истина;
				Продолжить;
			КонецЕсли;
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Номенклатура." + РеквизитНоменклатуры, "ЛОЖЬ");
			
		КонецЦикла;
		
		Если ЕстьРеквизиты = Ложь Тогда
			ТекстЗапроса = "";
		КонецЕсли;
		
		ЭДО_Кэш_Поместить("ТекстЗапросаТипМаркируемойПродукции", ТекстЗапроса);
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекстЗапроса) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("НоменклатураСообщения", ПолучитьНоменклатуруСообщения_КонтурEDI(Сообщение));
		
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	ПеречислениеEDI = ПолучитьСписокЗначенийПеречисленияEDI("ТипыМаркированнойПродукции");
    
	Пока Выборка.Следующий() Цикл
		
		Если Не ЗначениеЗаполнено(Выборка.ОсобенностьУчета) Тогда
			Продолжить;
		КонецЕсли;
		
		ТипПродукции = ПеречислениеEDI.НайтиПоЗначению(Выборка.ОсобенностьУчета);
		Сообщение.ТипыМаркируемойПродукции.Добавить(ТипПродукции.Значение, ТипПродукции.Представление);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТипыМаркируемойПродукции_ОсобенностьУчета(Сообщение)
	
	СопоставлениеПеречислений = ЭДО_Кэш_Прочитать("СопоставлениеПеречисленийТиповМаркируемойПродукции");
	
	Если СопоставлениеПеречислений = Неопределено Тогда
		
		СопоставлениеПеречислений = Новый Соответствие;
		
		ИмяПеречисленияТипПродукции = Новый Структура;
		ИмяПеречисленияТипПродукции.Вставить("Пиво", "Alcohol");
		ИмяПеречисленияТипПродукции.Вставить("ПивоВПотребительскихУпаковках", "Alcohol");
		ИмяПеречисленияТипПродукции.Вставить("АлкогольнаяПродукцияДо9Процентов", "Alcohol");
		ИмяПеречисленияТипПродукции.Вставить("ТабачнаяПродукция", "Tobacco");
		ИмяПеречисленияТипПродукции.Вставить("НикотиносодержащаяПродукция", "Tobacco");
		ИмяПеречисленияТипПродукции.Вставить("АльтернативныйТабак", "Tobacco");
		
		Для каждого КлючЗначение Из ИмяПеречисленияТипПродукции Цикл
			
			СтрокаМетаданных = "Перечисления.ОсобенностиУчетаНоменклатуры.ЗначенияПеречисления." + КлючЗначение.Ключ; 
			
			Если Не ЕстьНеобходимыеМетаданные(СтрокаМетаданных) Тогда
				Продолжить;
			КонецЕсли;
			
			ЗначениеПеречисления1С = Перечисления.ОсобенностиУчетаНоменклатуры[КлючЗначение.Ключ];
			ЗначениеПеречисленияEDI = КлючЗначение.Значение;
			
			СопоставлениеПеречислений.Вставить(ЗначениеПеречисления1С, ЗначениеПеречисленияEDI);
			
		КонецЦикла;
			
		ЭДО_Кэш_Поместить("СопоставлениеПеречисленийТиповМаркируемойПродукции", СопоставлениеПеречислений);
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СопоставлениеПеречислений) Тогда
		Возврат;
	КонецЕсли;
	
	НоменклатураСообщения = ПолучитьНоменклатуруСообщения_КонтурEDI(Сообщение); 
	ТипыПродукцииEDI = ПолучитьСписокЗначенийПеречисленияEDI("ТипыМаркированнойПродукции");

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	спрВидыНоменклатуры.ОсобенностьУчета КАК ОсобенностьУчета
	               |ИЗ
	               |	Справочник.Номенклатура КАК спрНоменклатура
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры КАК спрВидыНоменклатуры
	               |		ПО спрНоменклатура.ВидНоменклатуры = спрВидыНоменклатуры.Ссылка
	               |ГДЕ
	               |	спрНоменклатура.Ссылка В(&НоменклатураСообщения)";
	
	Запрос.УстановитьПараметр("НоменклатураСообщения", НоменклатураСообщения);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ТипПродукции = СопоставлениеПеречислений.Получить(Выборка.ОсобенностьУчета);
		Если ТипПродукции = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеПеречисленияEDI = ТипыПродукцииEDI.НайтиПоЗначению(ТипПродукции);
		Если Сообщение.ТипыМаркируемойПродукции.НайтиПоЗначению(ЗначениеПеречисленияEDI.Значение) = Неопределено Тогда
			Сообщение.ТипыМаркируемойПродукции.Добавить(ЗначениеПеречисленияEDI.Значение, ЗначениеПеречисленияEDI.Представление);
		КонецЕсли;
			
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТипыМаркируемойПродукции_ВидПродукцииИС(Сообщение, ИмяРеквизитаНоменклатуры = "ВидПродукцииИС")
	
