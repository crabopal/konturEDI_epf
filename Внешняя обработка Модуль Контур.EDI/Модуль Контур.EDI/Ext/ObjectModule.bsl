// Выбирает сессии из хранилища.
//
// Параметры:
//   Отбор - Структура - см. МодельОтборСессий
//
// Возвращаемое значение:
//   ВыборкаИзРезультатаЗапроса - выборка с данными сессий.
Функция ХранилищеСессий_ВыбратьСессии(Отбор) Экспорт
	
	Пользователь = ХранилищеСессий_ОпределитьПользователя(Отбор);
	
	Если Не ХранилищеСессий_ПроверитьДоступ(Пользователь) Тогда
		ВызватьИсключение ХранилищеСессий_СообщениеОшибкаДоступа();
	КонецЕсли;	
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Сессия = ХранилищеОбщихНастроек.Загрузить(Отбор.КлючОбъекта, Отбор.КлючНастроек,, Пользователь);	
	УстановитьПривилегированныйРежим(Ложь);
	
	Таблица = ХранилищеСессий_ТаблицаЗначенийСессии();
	Если Сессия <> Неопределено Тогда
		НоваяСтрока = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Сессия);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВременнаяТаблица", Таблица);	
	Запрос.Текст = ХранилищеСессий_ТекстЗапросаВыбратьСессии();
	
	Результат = Запрос.Выполнить();
	Возврат Результат.Выбрать();	
	
КонецФункции

// Находит сессию по идентификатору.
