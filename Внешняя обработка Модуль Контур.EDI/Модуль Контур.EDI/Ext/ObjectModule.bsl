	// структура данных объекта
	
	ДанныеОбъекта = Новый Структура(
		"Дата, ТипЦен, ВидОперации, Организация, ДеятельностьНаПатенте,
		|ВалютаДокумента, КурсВзаиморасчетов, КратностьВзаиморасчетов,
