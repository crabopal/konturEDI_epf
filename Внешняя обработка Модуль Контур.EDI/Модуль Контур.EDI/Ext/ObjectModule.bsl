Функция ПолучитьДеревоТочекДоставки(КодСети, Фильтр = "все") Экспорт
	                                             
	СтруктураСети = ПолучитьСтруктуруДанныхТорговойСети(КодСети);
	Если СтруктураСети=Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПартнерСсылка  			= ПолучитьТорговуюСетьПоКоду(КодСети);
	
//	ТаблицаРегионов 		= ПодготовитьТаблицуРегионов();
	
	ТаблицаСсылокТекущихТД	= ПодготовитьТаблицуСсылокТекущихТД(СтруктураСети.ТочкиДоставки, ПартнерСсылка);
	ТаблицаТочекДоставки 	= СформироватьТаблицуТочекДоставки(СтруктураСети.ТочкиДоставки, ТаблицаСсылокТекущихТД, ТаблицаКодовРегионов(), Фильтр);
	ДеревоТочекДоставки		= ЗаполнитьДеревоТочекДоставки(ТаблицаТочекДоставки);            	
	
	Возврат ДеревоТочекДоставки;
					
КонецФункции

Функция ЗаписатьДанныеТочекДоставки(КодСети, ОбновленныеТД) Экспорт
	
	РезультатСохранения		= ИнициализироватьРезультатСохраненияТД();
	СтруктураСети = ПолучитьСтруктуруДанныхТорговойСети(КодСети);
	ПартнерСсылка           = ПолучитьТорговуюСетьПоКоду(КодСети);
	ТаблицаСсылокТекущихТД 	= ПодготовитьТаблицуСсылокТекущихТД(СтруктураСети.ТочкиДоставки,ПартнерСсылка);
	ДанныеТДДляЗаписи 		= ПодготовитьДанныеТДДляЗаписи(ПартнерСсылка, ТаблицаСсылокТекущихТД, ОбновленныеТД);	
	
	Состояние_КонтурEDI("Сохраняем данные точек доставки...");
	
	СохранитьДанныеТД(ДанныеТДДляЗаписи, РезультатСохранения);
	
	Возврат РезультатСохранения; 
	
КонецФункции

Функция МожноАвтоматическиДобавитьТочкуДоставки(Сообщение)
	
	Если ПараметрыПользователяEDI.ФильтрОбменаПоТочкамДоставки = Истина Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ПараметрыПользователяEDI.ФильтрОбменаПоСетям = Истина Тогда
		
		Партнер = ?(ЗначениеЗаполнено(Сообщение.Партнер), Сообщение.Партнер, ОпределитьПартнера(Новый Структура("ТипЗначения,Сообщение", "Сообщение", Сообщение)));
		
		Если Не ЗначениеЗаполнено(Партнер) Тогда
			//мы не знаем эту торговую сеть
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ЗаписатьТочкуДоставкиВСправочник(Сообщение)
	
	Если Не ЗначениеЗаполнено(Сообщение.ГрузополучательEDI) Тогда
		Возврат Неопределено
	КонецЕсли;
	
	Партнер = ?(ЗначениеЗаполнено(Сообщение.Партнер), Сообщение.Партнер, ОпределитьПартнера(Новый Структура("ТипЗначения,Сообщение", "Сообщение", Сообщение)));
	
	Если Не ЗначениеЗаполнено(Партнер) Тогда
		Возврат Неопределено
	КонецЕсли;
	
	ТочкаДоставкиСвойСправочник = ОбработкаСобытияПодключаемогоМодуля("НайтиВСвоёмСправочникеТочкуДоставкиПоGLN", , Новый Структура("GLN", Сообщение.ГрузополучательEDI.GLN));
	
	ДанныеТочкиДоставки = Новый Структура();
	ДанныеТочкиДоставки.Вставить("Партнер",								Партнер);
	ДанныеТочкиДоставки.Вставить("Наименование",						Сообщение.ГрузополучательEDI.Наименование);
	ДанныеТочкиДоставки.Вставить("GLN",									Сообщение.ГрузополучательEDI.GLN);
	ДанныеТочкиДоставки.Вставить("АдресДоставки",						ПолучитьПредставлениеАдресаEDI(Сообщение.ГрузополучательEDI.Адрес));
	ДанныеТочкиДоставки.Вставить("ЮрФизЛицо",							Неопределено);
	ДанныеТочкиДоставки.Вставить("ТочкаДоставкиСвойСправочник",			ТочкаДоставкиСвойСправочник);
	ДанныеТочкиДоставки.Вставить("Подразделение",						Неопределено);
	ДанныеТочкиДоставки.Вставить("ЗагружатьСообщенияПоТочкеДоставки",	Ложь);
	ДанныеТочкиДоставки.Вставить("Удалить",								Ложь);
	ДанныеТочкиДоставки.Вставить("СменаПартнера",						Ложь);
	ДанныеТочкиДоставки.Вставить("СсылкаТД",							Неопределено);
	
	Отказ = Ложь;
	СохранитьЭлементСправочника("ТочкиДоставкиСторонние", ДанныеТочкиДоставки.СсылкаТД, ДанныеТочкиДоставки, Отказ);
	
	Если Отказ = Ложь Тогда
		УстановитьОбъектПоЗначениюСвойстваВКэшДлительнойОперации(ДанныеТочкиДоставки.СсылкаТД, "GLN_ТочкиДоставки", ДанныеТочкиДоставки.GLN);
	КонецЕсли;
	
	Возврат ДанныеТочкиДоставки.СсылкаТД
	
КонецФункции

Процедура ЗаписатьНастройкиСкладовОстатков(АдресВХ, НаименованиеПартнера, Значение) Экспорт
	
	Если НЕ ЭтоАдресВременногоХранилища(АдресВХ) Тогда
		Возврат;
	КонецЕсли;
	
	ПолученнаяТаблицаЗначенийСкладовОстатков = ПолучитьИзВременногоХранилища(АдресВХ);
	
	Если ПолученнаяТаблицаЗначенийСкладовОстатков = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Значение)
		И ТипЗнч(Значение) = Тип("СправочникСсылка.КонтурEDI_ДополнительныеСправочники") Тогда 
		
		ТекущийОбъект = Значение.ПолучитьОбъект();
		
	Иначе 
		
		ТекущийОбъект = Справочники.КонтурEDI_ДополнительныеСправочники.СоздатьЭлемент();
		ТекущийОбъект.ИмяСправочника = "СкладыОстатков";
		ТекущийОбъект.Наименование = НаименованиеПартнера + " (Склады остатков)";			
		
	КонецЕсли;
	
	ТекущийОбъект.ДополнительныеРеквизиты.Очистить();
	
	Для Каждого СтрокаСкладОстатков ИЗ ПолученнаяТаблицаЗначенийСкладовОстатков Цикл 
		
		НовыйСклад = ТекущийОбъект.ДополнительныеРеквизиты.Добавить();
		НовыйСклад.ИмяРеквизита = "Склад";
		НовыйСклад.Значение = СтрокаСкладОстатков.СкладыОстатков;
		
	КонецЦикла;
	
	ТекущийОбъект.Записать();
	
	Значение = ТекущийОбъект.Ссылка;
	
КонецПроцедуры

Функция ИнициализироватьРезультатСохраненияТД()
	
	ТаблицаУведомлений = Новый ТаблицаЗначений;
	ТаблицаУведомлений.Колонки.Добавить("Текст");
	
	РезультатСохранения = Новый Структура("Успешно,ТаблицаУведомлений",Ложь,ТаблицаУведомлений);	
	
	Возврат РезультатСохранения;
	
КонецФункции

Функция ЗаполнитьДеревоТочекДоставки(ТаблицаТочекДоставки)
    	
	ПЗ = Новый ПостроительЗапроса;
	ПЗ.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТаблицаТочекДоставки);
	ПЗ.ДобавлениеПредставлений = ТипДобавленияПредставлений.НеДобавлять;
	ПЗ.ИсточникДанных.Колонки["Регион"].Измерение = Истина;
	ПЗ.ЗаполнитьНастройки();
	ПЗ.Выполнить();
	ДеревоТочекДоставки = ПЗ.Результат.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	Для Каждого Строка Из ДеревоТочекДоставки.Строки Цикл
		Строка.ЭтоРегион = Истина;
	КонецЦикла;
	
	Возврат ДеревоТочекДоставки;
				
КонецФункции

Функция СформироватьТаблицуТочекДоставки(ТекущиеТД, ТаблицаСсылокТекущихТД, ТаблицаРегионов, Фильтр)
	
	ТаблицаТочекДоставки = Новый ТаблицаЗначений;
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТочекДоставки,
		"Регион
		|Обновить
		|GLN
		|НаименованиеТекущее
		|АдресТочкиДоставкиТекущий
		|НаименованиеТС
		|АдресТочкиДоставкиТС
		|НаименованиеНовое
		|АдресТочкиДоставкиНовый
		|НоваяТД
		|ИзмениласьТД
		|УдалилиТД
		|СменаПартнера_в_ТД
		|ТекущийПартнер
		|ОтредактированаТД
		|ЭтоРегион
		|ТипЛокализации"
	);
	
	ТаблицаТочекДоставки.Индексы.Добавить("Регион");
	ТаблицаТочекДоставки.Индексы.Добавить("GLN");
	
	Счетчик 	 = 0;
	КоличествоТД = ТекущиеТД.Количество();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущиеТД",ТекущиеТД);
	Запрос.УстановитьПараметр("ТаблицаСсылокТекущихТД",ТаблицаСсылокТекущихТД);
	Запрос.УстановитьПараметр("Фильтр",Фильтр);

	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТекущиеТД.id КАК id,
	|	ТекущиеТД.GLN КАК GLN,
	|	ТекущиеТД.КодРегиона КАК КодРегиона,
	|	ТекущиеТД.Наименование КАК Наименование,
	|	ТекущиеТД.Адрес КАК Адрес,
	|	ТекущиеТД.ПолныйАдрес КАК ПолныйАдрес,
	|	ТекущиеТД.id_ЮрФизЛица КАК id_ЮрФизЛица,
	|	ТекущиеТД.id_Подразделения КАК id_Подразделения,
	|	ТекущиеТД.Индекс КАК Индекс,
	|	ТекущиеТД.ТипЛокализации КАК ТипЛокализации
	|ПОМЕСТИТЬ табТекущихТД
	|ИЗ
	|	&ТекущиеТД КАК ТекущиеТД
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаСсылокТекущихТД.Ссылка КАК Ссылка,
	|	ТаблицаСсылокТекущихТД.GLN КАК GLN,
	|	ТаблицаСсылокТекущихТД.Наименование КАК Наименование,
	|	ТаблицаСсылокТекущихТД.АдресДоставки КАК АдресДоставки,
	|	ТаблицаСсылокТекущихТД.Партнер КАК Партнер,
	|	ТаблицаСсылокТекущихТД.ИзменилсяПартнер КАК ИзменилсяПартнер,
	|	ТаблицаСсылокТекущихТД.ТипЛокализации КАК ТипЛокализации
	|ПОМЕСТИТЬ табТаблицаСсылокТекущихТД
	|ИЗ
	|	&ТаблицаСсылокТекущихТД КАК ТаблицаСсылокТекущихТД
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	табТекущихТД.КодРегиона КАК КодРегиона,
	|	ВЫБОР
	|		КОГДА табТекущихТД.GLN ЕСТЬ NULL
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Обновить,
	|	ЕСТЬNULL(табТекущихТД.GLN, табТаблицаСсылокТекущихТД.GLN) КАК GLN,
	|	ЕСТЬNULL(табТаблицаСсылокТекущихТД.Наименование, """") КАК НаименованиеТекущее,
	|	ЕСТЬNULL(табТаблицаСсылокТекущихТД.АдресДоставки, """") КАК АдресТочкиДоставкиТекущий,
	|	ВЫБОР
	|		КОГДА табТекущихТД.GLN ЕСТЬ НЕ NULL 
	|			ТОГДА ВЫБОР
	|					КОГДА ЕСТЬNULL(табТекущихТД.Наименование, """") = """"
	|						ТОГДА ЕСТЬNULL(табТекущихТД.Адрес, """")
	|					ИНАЧЕ ЕСТЬNULL(табТекущихТД.Наименование, """")
	|				КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ЕСТЬNULL(табТаблицаСсылокТекущихТД.Наименование, """") = """"
	|					ТОГДА ЕСТЬNULL(табТаблицаСсылокТекущихТД.АдресДоставки, """")
	|				ИНАЧЕ ЕСТЬNULL(табТаблицаСсылокТекущихТД.Наименование, """")
	|			КОНЕЦ
	|	КОНЕЦ КАК НаименованиеТС,
	|	ЕстьNULL(табТекущихТД.ПолныйАдрес,табТаблицаСсылокТекущихТД.АдресДоставки) КАК АдресТочкиДоставкиТС,
	|	ВЫБОР
	|		КОГДА табТекущихТД.GLN ЕСТЬ НЕ NULL 
	|			ТОГДА ВЫБОР
	|					КОГДА ЕСТЬNULL(табТекущихТД.Наименование, """") = """"
	|						ТОГДА ЕСТЬNULL(табТекущихТД.Адрес, """")
	|					ИНАЧЕ ЕСТЬNULL(табТекущихТД.Наименование, """")
	|				КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ЕСТЬNULL(табТаблицаСсылокТекущихТД.Наименование, """") = """"
	|					ТОГДА ЕСТЬNULL(табТаблицаСсылокТекущихТД.АдресДоставки, """")
	|				ИНАЧЕ ЕСТЬNULL(табТаблицаСсылокТекущихТД.Наименование, """")
	|			КОНЕЦ
	|	КОНЕЦ КАК НаименованиеНовое,
	|	ВЫБОР
	|		КОГДА табТекущихТД.ПолныйАдрес ЕСТЬ NULL
	|			ТОГДА табТаблицаСсылокТекущихТД.АдресДоставки
	|		ИНАЧЕ табТекущихТД.ПолныйАдрес
	|	КОНЕЦ КАК АдресТочкиДоставкиНовый,
	|	ВЫБОР
	|		КОГДА табТаблицаСсылокТекущихТД.GLN ЕСТЬ NULL
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК НоваяТД,
	|	ВЫБОР
	|		КОГДА (ЕСТЬNULL(табТаблицаСсылокТекущихТД.Наименование, """") <> ВЫБОР
	|					КОГДА ЕСТЬNULL(табТекущихТД.Наименование, """") = """"
	|						ТОГДА ЕСТЬNULL(табТекущихТД.Адрес, """")
	|					ИНАЧЕ ЕСТЬNULL(табТекущихТД.Наименование, """")
	|				КОНЕЦ
	|				ИЛИ ЕСТЬNULL(табТекущихТД.ТипЛокализации, """") <> ЕСТЬNULL(табТаблицаСсылокТекущихТД.ТипЛокализации, """")
	|				ИЛИ ЕСТЬNULL(табТаблицаСсылокТекущихТД.АдресДоставки, """") <> ЕстьNULL(табТекущихТД.ПолныйАдрес, """")
	|				ИЛИ ЕСТЬNULL(табТаблицаСсылокТекущихТД.ИзменилсяПартнер, ЛОЖЬ))
	|				И НЕ табТаблицаСсылокТекущихТД.GLN ЕСТЬ NULL
	|				И НЕ табТекущихТД.GLN ЕСТЬ NULL
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ИзмениласьТД,
	|	0 КАК ОтредактированаТД,
	|	ЛОЖЬ КАК ЭтоРегион,
	|	ВЫБОР
	|		КОГДА табТекущихТД.GLN ЕСТЬ NULL
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК УдалилиТД,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(табТаблицаСсылокТекущихТД.ИзменилсяПартнер, ЛОЖЬ)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СменаПартнера_в_ТД,
	|	табТаблицаСсылокТекущихТД.Партнер КАК ТекущийПартнер,
	|	ЕСТЬNULL(табТекущихТД.ТипЛокализации, """") КАК ТипЛокализации,
	|	ЕСТЬNULL(табТаблицаСсылокТекущихТД.ТипЛокализации, """") КАК ТипЛокализации_Текущий
	|ИЗ
	|	табТекущихТД КАК табТекущихТД
	|		ПОЛНОЕ СОЕДИНЕНИЕ табТаблицаСсылокТекущихТД КАК табТаблицаСсылокТекущихТД
	|		ПО табТекущихТД.GLN = табТаблицаСсылокТекущихТД.GLN
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &Фильтр = ""все""
	|				ТОГДА ИСТИНА
	|			КОГДА &Фильтр = ""новые""
	|				ТОГДА табТаблицаСсылокТекущихТД.GLN ЕСТЬ NULL
	|			КОГДА &Фильтр = ""изменившиеся""
	|				ТОГДА (ЕСТЬNULL(табТаблицаСсылокТекущихТД.Наименование, """") <> ВЫБОР
	|							КОГДА ЕСТЬNULL(табТекущихТД.Наименование, """") = """"
	|								ТОГДА ЕСТЬNULL(табТекущихТД.Адрес, """")
	|							ИНАЧЕ ЕСТЬNULL(табТекущихТД.Наименование, """")
	|						КОНЕЦ
	|						ИЛИ ЕСТЬNULL(табТаблицаСсылокТекущихТД.АдресДоставки, """") <> ЕстьNULL(табТекущихТД.ПолныйАдрес, """")
	|						ИЛИ ЕСТЬNULL(табТаблицаСсылокТекущихТД.ИзменилсяПартнер, ЛОЖЬ)
	|						ИЛИ ЕСТЬNULL(табТекущихТД.ТипЛокализации, """") <> ЕСТЬNULL(табТаблицаСсылокТекущихТД.ТипЛокализации, """"))
	|						И НЕ табТаблицаСсылокТекущихТД.GLN ЕСТЬ NULL
	|						И НЕ табТекущихТД.GLN ЕСТЬ NULL
	|			КОГДА &Фильтр = ""на_удаление""
	|				ТОГДА табТекущихТД.GLN ЕСТЬ NULL
	|			КОГДА &Фильтр = ""смена_партнера""
	|				ТОГДА ЕСТЬNULL(табТаблицаСсылокТекущихТД.ИзменилсяПартнер, ЛОЖЬ)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ";
	
	ТаблицаТД_С_Отбором = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Строка Из ТаблицаТД_С_Отбором Цикл
						
		НоваяСтрока = ТаблицаТочекДоставки.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
		
		НоваяСтрока.Регион 					= ПолучитьНаименованиеРегиона(ТаблицаРегионов, Строка.КодРегиона);
					
	КонецЦикла;
	
	ТаблицаТочекДоставки.Сортировать("Регион,GLN");
	
	Возврат ТаблицаТочекДоставки;
	
КонецФункции

Функция ПолучитьНаименованиеРегиона(ТаблицаРегионов, КодРегиона)
	
	НаименованиеРегиона = "";
	
	СтрокаРегиона = ТаблицаРегионов.Найти(КодРегиона, "КодЧисло");
	
	Если Не СтрокаРегиона = Неопределено Тогда
		НаименованиеРегиона = СтрокаРегиона.Наименование;
	Иначе
		НаименованиеРегиона = "Неопределено";
	КонецЕсли;
	
	Возврат НаименованиеРегиона;
	
КонецФункции

Функция ПодготовитьТаблицуСсылокТекущихТД(ТекущиеТД, ПартнерСсылка = Неопределено)
	
	МассивGLNТекущихТД 		= ТекущиеТД.ВыгрузитьКолонку("GLN");
	ТаблицаСсылокТекущихТД	= ПолучитьТаблицуСсылокТочекДоставки(МассивGLNТекущихТД,ПартнерСсылка);
	
	Возврат ТаблицаСсылокТекущихТД; 
		
КонецФункции

Функция ПодготовитьДанныеТДДляЗаписи(Партнер, ТаблицаСсылокТекущихТД, ОбновленныеТД)
	
	ДанныеДляЗаписи = Новый Массив;
	
	Для Каждого СтрокаРегион Из ОбновленныеТД.Строки Цикл
		
		Для Каждого СтрокаТД Из СтрокаРегион.Строки Цикл
			
			СсылкаТД 		= Неопределено;
			СтруктураПолей  = Неопределено;
			
			//добавляем новую точку доставки
			Если (СтрокаТД.НоваяТД = 1 и СтрокаТД.Обновить = 1) или
				(СтрокаТД.НоваяТД = 1 и СтрокаТД.Обновить = 0 и СтрокаТД.ОтредактированаТД = 1) Тогда
				
				ТочкаДоставкиСвойСправочник = ОбработкаСобытияПодключаемогоМодуля("НайтиВСвоёмСправочникеТочкуДоставкиПоGLN",,Новый Структура("GLN", СокрЛП(СтрокаТД.GLN)));

				СтруктураПолей = Новый Структура();
				СтруктураПолей.Вставить("Партнер",								Партнер);
				СтруктураПолей.Вставить("Наименование",							СокрЛП(СтрокаТД.НаименованиеНовое));
				СтруктураПолей.Вставить("GLN",									СокрЛП(СтрокаТД.GLN));
				СтруктураПолей.Вставить("АдресДоставки",						СокрЛП(СтрокаТД.АдресТочкиДоставкиНовый));
				СтруктураПолей.Вставить("ЮрФизЛицо",							Неопределено);
				СтруктураПолей.Вставить("ТочкаДоставкиСвойСправочник",			ТочкаДоставкиСвойСправочник);
				СтруктураПолей.Вставить("Подразделение",						Неопределено);
				СтруктураПолей.Вставить("ЗагружатьСообщенияПоТочкеДоставки",	Ложь);
				СтруктураПолей.Вставить("Удалить",								Ложь);
				СтруктураПолей.Вставить("СменаПартнера",						Ложь);
								
			КонецЕсли;
			
			//добавляем изменившуюсь точку доставки
			Если ((СтрокаТД.ИзмениласьТД = 1 и СтрокаТД.Обновить = 1) 
				ИЛИ (СтрокаТД.ИзмениласьТД = 1 и СтрокаТД.Обновить = 0 и СтрокаТД.ОтредактированаТД = 1) 
				ИЛИ (СтрокаТД.ИзмениласьТД = 0 и СтрокаТД.Обновить = 0 и СтрокаТД.ОтредактированаТД = 1 и СтрокаТД.НоваяТД = 0)
				ИЛИ (СтрокаТД.СменаПартнера_в_ТД = 1 и СтрокаТД.Обновить = 1)) 
				И Не СтрокаТД.УдалилиТД = 1 Тогда
				
				СсылкаТД = ПолучитьСсылкуТДПоGLN(ТаблицаСсылокТекущихТД, СтрокаТД.GLN);
				Если ЗначениеЗаполнено(СсылкаТД) Тогда
					СтруктураПолей = ПолучитьЭлементСправочника("ТочкиДоставкиСторонние",СсылкаТД);
					Если ЗначениеЗаполнено(СтруктураПолей) Тогда
						Если Не СокрЛП(СтруктураПолей.Наименование)  = СокрЛП(СтрокаТД.НаименованиеНовое) Тогда
							СтруктураПолей.Вставить("Наименование",				СокрЛП(СтрокаТД.НаименованиеНовое));
						КонецЕсли;
						Если Не СокрЛП(СтруктураПолей.АдресДоставки) = СокрЛП(СтрокаТД.АдресТочкиДоставкиНовый) Тогда
							СтруктураПолей.Вставить("АдресДоставки",			СокрЛП(СтрокаТД.АдресТочкиДоставкиНовый));
						КонецЕсли;
						
						СтруктураПолей.Вставить("Удалить",								Ложь); 
						СтруктураПолей.Вставить("СменаПартнера",						Ложь);
						
						Если СтрокаТД.СменаПартнера_в_ТД = 1 Тогда
							СтруктураПолей.Вставить("СменаПартнера", Истина);
							СтруктураПолей.Вставить("Партнер", 		Партнер);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если ТипЗнч(СтруктураПолей) = Тип("Структура") Тогда
				СтруктураПолей.Вставить("ТипЛокализации",						СокрЛП(СтрокаТД.ТипЛокализации)); 
			КонецЕсли;
			//добавляем удаленную точку доставки  
			Если (СтрокаТД.УдалилиТД = 1 и СтрокаТД.Обновить = 1 и СтрокаТД.НоваяТД = 0) Тогда
				
				СсылкаТД = ПолучитьСсылкуТДПоGLN(ТаблицаСсылокТекущихТД, СтрокаТД.GLN);
				
				Если ЗначениеЗаполнено(СсылкаТД) Тогда
					СтруктураПолей = ПолучитьЭлементСправочника("ТочкиДоставкиСторонние",СсылкаТД);
					СтруктураПолей.Вставить("Удалить",	Истина);
					СтруктураПолей.Вставить("СменаПартнера",Ложь);
				КонецЕсли;
				
			КонецЕсли;	
			
			Если ЗначениеЗаполнено(СтруктураПолей) Тогда
				СтруктураПолей.Вставить("СсылкаТД", СсылкаТД);
				ДанныеДляЗаписи.Добавить(СтруктураПолей); 				
			КонецЕсли; 			
		КонецЦикла; 	
	КонецЦикла;
	
	Возврат ДанныеДляЗаписи;
	
КонецФункции

Процедура СохранитьДанныеТД(ДанныеТДДляЗаписи, РезультатСохранения)

	Для Каждого СтруктураПолей Из ДанныеТДДляЗаписи Цикл
		
		НоваяТД 		= Не ЗначениеЗаполнено(СтруктураПолей.СсылкаТД);
		УдалитьТД		= СтруктураПолей.Удалить;
		СменаПартнера	= СтруктураПолей.СменаПартнера;
		
		Если СменаПартнера Тогда
			СохранитьЭлементСправочника("ТочкиДоставкиСторонние",СтруктураПолей.СсылкаТД,СтруктураПолей);   //Создаем новую точку для текущего партнера
		ИначеЕсли Не УдалитьТД Тогда 
			СохранитьЭлементСправочника("ТочкиДоставкиСторонние",СтруктураПолей.СсылкаТД,СтруктураПолей);
		Иначе
			УдалитьЭлементСправочника("ТочкиДоставкиСторонние",СтруктураПолей.СсылкаТД, Истина);
		КонецЕсли;
		
		НовоеУведомление = РезультатСохранения.ТаблицаУведомлений.Добавить();
		Если СменаПартнера Тогда
			НовоеУведомление.Текст = "Обновлена новая точка доставки """ + СтруктураПолей.Наименование + """ с адресом """ + СтруктураПолей.АдресДоставки + """. У точки сменился партнер.";
		ИначеЕсли НоваяТД Тогда
			НовоеУведомление.Текст = "Добавлена новая точка доставки """ + СтруктураПолей.Наименование + """ с адресом """ + СтруктураПолей.АдресДоставки + """.";
		ИначеЕсли УдалитьТД Тогда
			НовоеУведомление.Текст = "Удалена точка доставки """ + СтруктураПолей.Наименование + """ с адресом """ + СтруктураПолей.АдресДоставки + """.";
		Иначе
			НовоеУведомление.Текст = "Обновлена точка доставки """ + СтруктураПолей.Наименование + """ с адресом """ + СтруктураПолей.АдресДоставки + """.";
		КонецЕсли;
		
	КонецЦикла;
	
	РезультатСохранения.Успешно = Истина;
	
КонецПроцедуры

Функция ПолучитьТаблицуСсылокТочекДоставки(МассивGLN, ПартнерСсылка = Неопределено)
	
	Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_ТочкиДоставки.Ссылка КАК Ссылка,
	|	КонтурEDI_ТочкиДоставки.GLN КАК GLN,
	|	КонтурEDI_ТочкиДоставки.Наименование КАК Наименование,
	|	КонтурEDI_ТочкиДоставки.АдресДоставки КАК АдресДоставки,
	|	КонтурEDI_ТочкиДоставки.Партнер,
	|	ВЫБОР
	|		КОГДА КонтурEDI_ТочкиДоставки.GLN В (&МассивGLN)
	|				И НЕ ВЫБОР
	|						КОГДА &ПартнерСсылка = НЕОПРЕДЕЛЕНО
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ КонтурEDI_ТочкиДоставки.Партнер = &ПартнерСсылка
	|					КОНЕЦ
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ИзменилсяПартнер,
	|	ЕСТЬNULL(КонтурEDI_ТочкиДоставкиДополнительныеРеквизиты.Значение, """") КАК ТипЛокализации
	|ИЗ
	|	Справочник.КонтурEDI_ТочкиДоставки КАК КонтурEDI_ТочкиДоставки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ТочкиДоставки.ДополнительныеРеквизиты КАК КонтурEDI_ТочкиДоставкиДополнительныеРеквизиты
	|		ПО КонтурEDI_ТочкиДоставки.Ссылка = КонтурEDI_ТочкиДоставкиДополнительныеРеквизиты.Ссылка
	|			И (КонтурEDI_ТочкиДоставкиДополнительныеРеквизиты.ИмяРеквизита = ""ТипЛокализации"")
	|ГДЕ
	|	(КонтурEDI_ТочкиДоставки.GLN В (&МассивGLN)
	|			ИЛИ ВЫБОР
	|				КОГДА &ПартнерСсылка = НЕОПРЕДЕЛЕНО
	|					ТОГДА ЛОЖЬ
	|				ИНАЧЕ КонтурEDI_ТочкиДоставки.Партнер = &ПартнерСсылка
	|			КОНЕЦ)";
	Если ВнешнееХранилище Тогда
		Запрос.УстановитьПараметр("МассивGLN", СоединениеСХранилищем.ЗначениеИзСтрокиВнутр(ЗначениеВСтрокуВнутр(МассивGLN)));
	Иначе
		Запрос.УстановитьПараметр("МассивGLN", МассивGLN);
	КонецЕсли;	
	Запрос.УстановитьПараметр("ПартнерСсылка", ПартнерСсылка);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если ВнешнееХранилище Тогда
		Результат = ПолучитьТаблицуИзВнешнейБазы(Результат);
	КонецЕсли;	
	
	Результат.Индексы.Добавить("GLN");
	Результат.Индексы.Добавить("Ссылка");//может, и не пригодитс
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСсылкуТДПоGLN(ТаблицаСсылокТекущихТД, GLN)
	
	НайденнаяТочкаДоставки = Неопределено;
	
	СтрокаТД 				= Неопределено;
	НайденнаяТочкаДоставки 	= Неопределено;
	СтрокаТД = ТаблицаСсылокТекущихТД.Найти(GLN, "GLN");
	Если ЗначениеЗаполнено(СтрокаТД) Тогда
		НайденнаяТочкаДоставки = СтрокаТД.Ссылка;
	КонецЕсли;
		
	Возврат НайденнаяТочкаДоставки;
	
КонецФункции

Функция ОпределитьТочкуДоставкиПоGLN(GLN, РежимРаботы) Экспорт
	
	Запрос = Новый Запрос;
	Если РежимРаботы = "Поставщик" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	КонтурEDI_ТочкиДоставки.Ссылка КАК ТочкаДоставки
		|ИЗ
		|	Справочник.КонтурEDI_ТочкиДоставки КАК КонтурEDI_ТочкиДоставки
		|ГДЕ
		|	КонтурEDI_ТочкиДоставки.GLN = &GLN";
		
	ИначеЕсли РежимРаботы = "Покупатель" Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	КонтурEDI_ДополнительныеРеквизиты.Объект КАК ТочкаДоставки
		|ИЗ
		|	РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеРеквизиты
		|ГДЕ
		|	КонтурEDI_ДополнительныеРеквизиты.Свойство = &Свойство
		|	И КонтурEDI_ДополнительныеРеквизиты.Значение = &GLN";
		
		Запрос.УстановитьПараметр("Свойство", "GLN_НашейТочкиДоставки");
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("GLN", GLN);
	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	Если ВыборкаЗапроса.Следующий() Тогда
		Возврат ВыборкаЗапроса.ТочкаДоставки;	
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции
