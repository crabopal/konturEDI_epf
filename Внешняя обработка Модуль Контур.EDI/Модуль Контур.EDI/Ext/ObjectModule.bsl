//с версии 4.52.0
Процедура ПроверкаНовойВерсии_РазделитьНастройкиПартнеров()
	
	РазделяемыеНастройки = ТипыОсновныхСообщенийЦепочки();
	
	ТекстПоляНастройки = "
						 |	ЕстьNULL(РеквизитИмяНастройки.Значение, ЛОЖЬ) Как ИмяНастройки,";
	
	ТекстСоединенияНастройки = "
								|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК РеквизитИмяНастройки
	               				|		ПО КонтурEDI_ДополнительныеСправочники.Ссылка = РеквизитИмяНастройки.Объект
	               				|			И (РеквизитИмяНастройки.Свойство = ""ИмяНастройки"")";
	
	ТекстПолейНастроек = "";
	ТекстСоединенияНастроек = "";
	
	Для каждого Настройка Из РазделяемыеНастройки Цикл
		
		ТекстПолейНастроек = ТекстПолейНастроек + СтрЗаменить(ТекстПоляНастройки, "ИмяНастройки", Настройка);
		ТекстСоединенияНастроек = ТекстСоединенияНастроек + СтрЗаменить(ТекстСоединенияНастройки, "ИмяНастройки", Настройка);
				
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтурEDI_ДополнительныеСправочники.Ссылка КАК Партнер,"
				   + ТекстПолейНастроек + "
	               |	ВЫРАЗИТЬ(ТаблицаРеквизитПоставщик.Значение КАК БУЛЕВО) КАК Поставщик,
	               |	ВЫРАЗИТЬ(ТаблицаРеквизитТорговаяСеть.Значение КАК БУЛЕВО) КАК ТорговаяСеть
	               |ИЗ
	               |	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК ТаблицаРеквизитТорговаяСеть
	               |		ПО КонтурEDI_ДополнительныеСправочники.Ссылка = ТаблицаРеквизитТорговаяСеть.Объект
	               |			И (ТаблицаРеквизитТорговаяСеть.Свойство = ""ПартнерКакТорговаяСеть"")
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК ТаблицаРеквизитПоставщик
	               |		ПО КонтурEDI_ДополнительныеСправочники.Ссылка = ТаблицаРеквизитПоставщик.Объект
	               |			И (ТаблицаРеквизитПоставщик.Свойство = ""ПартнерКакПоставщик"")
				   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК ТаблицаРеквизитНастройкиРазделены
	               |		ПО КонтурEDI_ДополнительныеСправочники.Ссылка = ТаблицаРеквизитНастройкиРазделены.Объект
	               |			И (ТаблицаРеквизитНастройкиРазделены.Свойство = ""НастройкиСообщенийРазделены"")"
				   + ТекстСоединенияНастроек + "
				   |ГДЕ
	               |	КонтурEDI_ДополнительныеСправочники.ИмяСправочника = ""Партнеры""
				   |	И ВЫРАЗИТЬ(ЕстьNULL(ТаблицаРеквизитНастройкиРазделены.Значение,ЛОЖЬ) КАК БУЛЕВО) = ЛОЖЬ";
				   
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеНастройкиПартнеров = РезультатЗапроса.Выгрузить();          
	
	ИдентификаторыНастроекСообщений = ПолучитьСтруктуруИдентификаторовНастроекСообщений();
	
	Для каждого НастройкиПартнера Из ТекущиеНастройкиПартнеров Цикл
		Для каждого Настройка Из РазделяемыеНастройки Цикл
			
			Если НастройкиПартнера.ТорговаяСеть = Истина Тогда
				УстановитьЗначениеСвойстваОбъекта(НастройкиПартнера.Партнер, 
											  	  ИдентификаторыНастроекСообщений.Поставщик[Настройка], 
											  	  НастройкиПартнера[Настройка]);
			КонецЕсли;
			
			Если НастройкиПартнера.Поставщик = Истина Тогда
				УстановитьЗначениеСвойстваОбъекта(НастройкиПартнера.Партнер,
												  ИдентификаторыНастроекСообщений.Покупатель[Настройка],
												  НастройкиПартнера[Настройка]);
			КонецЕсли;
			
		КонецЦикла;

		УстановитьЗначениеСвойстваОбъекта(НастройкиПартнера.Партнер,
										  "НастройкиСообщенийРазделены",
										  Истина);

	КонецЦикла;
	
	ЭДО_Кэш_Очистить("ДатаВремяОбновленияКэшаПартнеровПоставщик");
	ЭДО_Кэш_Очистить("ДатаВремяОбновленияКэшаПартнеровПокупатель");
	
	ОбновитьКэшПартнеров();
	
КонецПроцедуры

// с версии 4.83.0
// настройка ИспользоватьПортальнуюАвторизацию после обновления выключена
//
Процедура ПроверкаНовойВерсии_НеИспользоватьПортальнуюАвторизацию()

	ИспользоватьПортальнуюАвторизацию = ПолучитьКонстантуEDI("ИспользоватьПортальнуюАвторизацию");
	Если Не ЗначениеЗаполнено(ИспользоватьПортальнуюАвторизацию) Тогда
		
		// настройка ИспользоватьПортальнуюАвторизацию после обновления выключена
				
		УстановитьКонстантуEDI("ИспользоватьПортальнуюАвторизацию", Ложь);
		
	КонецЕсли;

КонецПроцедуры
	
//{{{ Конвертации из EDI в 1C

Процедура КонвертироватьСообщениеEDIв1С(Сообщение,НеДополнятьСообщение = Ложь) Экспорт
	
	//Двери покрепче справим, рядом на цепь посадим восемь больших, голодных псов.
	Если Сообщение.Направление <> "Входящее" Тогда
		ВызватьИсключение "Метод вызывается только для входящих сообщений";
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Сообщение.Партнер) Тогда
		Сообщение.Партнер = ОпределитьПартнера(Новый Структура("ТипЗначения,Сообщение","Сообщение",Сообщение));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Сообщение.Грузополучатель1С)
		И НЕ СсылкаСуществуетИДоступна_КонтурEDI(Сообщение.Грузополучатель1С) Тогда
		
		Сообщение.Грузополучатель1С = Неопределено;	
		
	КонецЕсли;
	
	КонвертироватьШапкуСообщенияEDIв1С(Сообщение);
	Если Сообщение.ТипСообщения = "IFTMBF"
		ИЛИ Сообщение.ТипСообщения = "IFTMBC" Тогда
		ИмяТЧ = "Грузополучатели";
	ИначеЕсли Сообщение.ТипСообщения = "DELFOR" Тогда
		ИмяТЧ = "Графики"	
	Иначе	
		ИмяТЧ =  "Товары";
	КонецЕсли;
	
	КонвертироватьТабличнуюЧастьСообщенияEDIв1С(Сообщение, ИмяТЧ, НеДополнятьСообщение);
			
	Сообщение.Отправитель1С = Сообщение.Партнер;
	
	Если Сообщение.ТипСообщения = "ORDERS"  Тогда
		
		Если Сообщение.Статус = "Provisional" Тогда
			
			Сообщение.ЭтоПредварительныйЗаказ = Истина;
			
		ИначеЕсли НЕ ЗначениеЗаполнено(Сообщение.СписокПредварительныхЗаказов) Тогда
			
			Сообщение.СписокПредварительныхЗаказов = ПолучитьСписокПредыдущихЗаказов_КонтурEDI(Сообщение);
			
		КонецЕсли;
		
	КонецЕсли;   
	
	СтандартнаяОбработкаEDI = Истина;
	
	ПараметрыПМ = Новый Структура("Сообщение", Сообщение); 
	
	РезультатПМ = 
	ОбработкаСобытияПодключаемогоМодуля("ПослеКонвертацииСообщенияEDIв1С", СтандартнаяОбработкаEDI, ПараметрыПМ);
			
	Если РезультатПМ <> Неопределено Тогда
		Сообщение = РезультатПМ;
	КонецЕсли;

	Если СтандартнаяОбработкаEDI Тогда
	
		ПослеКонвертацииСообщенияEDIв1С(Сообщение);
		
	КонецЕсли;
		
КонецПроцедуры

Процедура КонвертироватьШапкуСообщенияEDIв1С(Сообщение)
	
	МетаданныеСообщения = ПолучитьМетаданныеСообщения(Сообщение.ТипСообщения, Сообщение.Направление);		
	ДополнитьМетаданныеПоСообщению(МетаданныеСообщения, Сообщение); 	

	Для Каждого ПолеСообщения Из МетаданныеСообщения Цикл
		
		Если ПолеСообщения.ИмяТаблицы = Неопределено Тогда
			
			Если ПолеСообщения.Принадлежность = Неопределено Тогда
				
				Если ПолеСообщения.ВидСтруктурыEDI = Неопределено Тогда
					ТипEDI = ПолеСообщения.ТипEDI;
				Иначе
					ТипEDI = ПолеСообщения.ВидСтруктурыEDI;
				КонецЕсли;
				
				Если    ТипEDI = "Заказ" 
					ИЛИ ТипEDI = "Накладная" 
					ИЛИ ТипEDI = "Приемка" 
					ИЛИ ТипEDI = "СчетФактура" 
					ИЛИ ТипEDI = "Возврат" Тогда
					
					Если НЕ ЗначениеЗаполнено(ПолеСообщения.Тип1С) Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				                                                         
				Если Сообщение.Свойство(ПолеСообщения.ИмяПоля+"EDI") Тогда // в структуру сообщений могли добавить новое поле
					РезультатКонвертации = КонвертироватьЗначениеEDIв1С(Сообщение[ПолеСообщения.ИмяПоля+"EDI"],ТипEDI,ПолеСообщения.Тип1С,Сообщение);
					
					Если НЕ РезультатКонвертации = Неопределено Тогда
						
						Сообщение[ПолеСообщения.ИмяПоля + "1С"] = РезультатКонвертации;
						
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДополнитьМетаданныеПоСообщению(МетаданныеСообщения, Сообщение)
	
	Если Сообщение.ТипСообщения = "DELFOR" Тогда
		//Так как из метаданных нельзя получить направление для DELFOR, то дополнительно проверяем само сообщение
		КемМыЯвляемся = ОпределитьКемМыЯвляемся(Сообщение);
		Если КемМыЯвляемся = "Поставщик" Тогда
			ТипПродавец = "ЮрФизЛицоСвое";
			ТипПокупатель = "ЮрФизЛицоСтороннее";
		ИначеЕсли КемМыЯвляемся = "Покупатель" Тогда
			ТипПродавец = "ЮрФизЛицоСтороннее";
			ТипПокупатель = "ЮрФизЛицоСвое";
		КонецЕсли;
		
		//Если строка не найдена, то будет ошибка и в данном случае это правильно 
		МетаданныеСообщения.Найти("Продавец", "ИмяПоля").Тип1С = ТипПродавец;
		МетаданныеСообщения.Найти("Покупатель", "ИмяПоля").Тип1С = ТипПокупатель;
	КонецЕсли;
	
КонецПроцедуры

Функция ПараметрыСопоставления_КонтурEDI() Экспорт

	ПараметрыСопоставления = Новый Структура();
	ПараметрыСопоставления.Вставить("ТаблицаТоваров");
	ПараметрыСопоставления.Вставить("ТаблицаСоответствий");
	ПараметрыСопоставления.Вставить("ТаблицаТоваровВходящегоСообщения");
	ПараметрыСопоставления.Вставить("ИменаРеквизитовКлюча");
	ПараметрыСопоставления.Вставить("МыПоставщик");
	ПараметрыСопоставления.Вставить("ТипСообщения");
	ПараметрыСопоставления.Вставить("ЭтоEDI_В_1С", Ложь);	
	
	Возврат ПараметрыСопоставления;

КонецФункции 

Функция КонвертироватьТабличнуюЧастьСообщенияEDIв1С(Сообщение,ИмяТабличнойЧасти,НеДополнятьСообщение = Ложь) Экспорт
	
	СтандартнаяОбработкаEDI = Истина;
	ОбработкаСобытияПодключаемогоМодуля("КонвертироватьТабличнуюЧастьСообщенияEDIв1С",СтандартнаяОбработкаEDI,Новый Структура("Сообщение,ИмяТабличнойЧасти",Сообщение,ИмяТабличнойЧасти));
	Если СтандартнаяОбработкаEDI = Ложь Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	МетаданныеСообщения = ПолучитьМетаданныеСообщения(Сообщение.ТипСообщения, Сообщение.Направление);
	
	ТабличнаяЧастьСообщения = Сообщение[ИмяТабличнойЧасти];	
	
	Если ИмяТабличнойЧасти = "Товары" Тогда
		
		// определить важные переменные
		// ... кто мы в этом сообщении
		ЭтоОбратнаяОтгрузка = ЭтоОбратнаяОтгрузка(Сообщение.ТипСообщения);
		МыПоставщик = (ОпределитьКемМыЯвляемся(Сообщение) = "Поставщик");
		
		// ... имена реквизитов ключа для сопоставления
		НастройкаТолькоПоШК					= ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, "СинхронизироватьТоварыТолькоПоGTIN");
		НастройкаТолькоПоВнутреннемуКоду	= ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, "СинхронизироватьТоварыТолькоПоКодуПартнера");
		
		ИменаРеквизитовКлюча = ИменаРеквизитовДляКлючаПоискаРеквизитов(НастройкаТолькоПоШК, НастройкаТолькоПоВнутреннемуКоду, ЭтоОбратнаяОтгрузка, МыПоставщик); 
		
		// получить необходимые таблицы для конвертации
		// ... получить таблицу соответствий
		КолонкиДляКопирования = "GTIN, КодТовараПокупателя, КодТовараПоставщика, КодЕдиницыИзмеренияEDI";
		КолонкиДляКопирования = ?(ЕстьМетаданныеТипЕдиницы, КолонкиДляКопирования + ", ТипЕдиницы", КолонкиДляКопирования);
		ТаблицаТоваров = ТабличнаяЧастьСообщения.Скопировать(, КолонкиДляКопирования);
		
		ТипизироватьКолонкиВТаблицеЗначений(ТаблицаТоваров, "КодЕдиницыИзмеренияEDI", ОписаниеТипаСтрока_КонтурEDI(3)); 		
		
		Для Каждого ИмяРеквизита Из ИменаРеквизитовКлюча Цикл
			Если ПеременнаяСодержитСвойство(ТаблицаТоваров.Колонки, ИмяРеквизита.Имя) Тогда
				ТаблицаТоваров.Колонки[ИмяРеквизита.Имя].Имя = ИмяРеквизита.ИмяВСоответствиях;
			КонецЕсли;   			
		КонецЦикла;
				
		ТаблицаСоответствий = КонвертироватьТоварыEDIв1С(ТаблицаТоваров, Сообщение);  
		
		// ... получить и подготовить таблицу товаров исходного сообщения
		ИсходноеСообщение = ПолучитьПредыдущееСообщение_КонтурEDI(Сообщение);   		
		ТаблицаТоваровИсходногоСообщения = ПолучитьТаблицуТоваровИсходногоСообщения_КонтурEDI(ИсходноеСообщение);
		
		ТабличнаяЧастьСообщения.Индексы.Добавить("GTIN, КодТовараПокупателя, КодТовараПоставщика");
		
		// ... подготовить таблицу товаров к конвертации
		ДопПараметры = ПараметрыПодготовкиТаблицыТоваров();
		
		ДопПараметры.СуммаВключаетНДС = Ложь;
		ДопПараметры.ЭтоТиповойЗапросПоПроведенномуЗаказу_УТ_УПП_КА = Ложь;
		ДопПараметры.Направление = "Входящее";
		ДопПараметры.ТипСообщения = Сообщение.ТипСообщения;
		ДопПараметры.МыПоставщик = МыПоставщик;
		ДопПараметры.ЭтоОбратнаяОтгрузка = ЭтоОбратнаяОтгрузка; 
				
		ПодготовитьТаблицуТоваровККонвертации1СВEDI(ТабличнаяЧастьСообщения, Сообщение.Партнер, Сообщение.ТипСообщения, ДопПараметры);
		
		ТабличнаяЧастьСообщения.ЗаполнитьЗначения(Неопределено, "Номенклатура");
		ТабличнаяЧастьСообщения.ЗаполнитьЗначения(Неопределено, "ЕдиницаИзмерения");
		ТабличнаяЧастьСообщения.ЗаполнитьЗначения(Неопределено, "ХарактеристикаНоменклатуры");		
		
		// ... выполнить сопоставление
		ПараметрыСопоставления = ПараметрыСопоставления_КонтурEDI();
		
		ПараметрыСопоставления.ТаблицаТоваров					= ТабличнаяЧастьСообщения;
		ПараметрыСопоставления.ТаблицаСоответствий				= ТаблицаСоответствий;
		ПараметрыСопоставления.ТаблицаТоваровВходящегоСообщения = ТаблицаТоваровИсходногоСообщения;
		
		ПараметрыСопоставления.ИменаРеквизитовКлюча = ИменаРеквизитовКлюча;
		ПараметрыСопоставления.МыПоставщик 			= МыПоставщик;
		ПараметрыСопоставления.ТипСообщения 		= Сообщение.ТипСообщения;
		ПараметрыСопоставления.ЭтоEDI_В_1С 			= Истина;
		
		Попытка
			
			ВыполнитьСопоставлениеТоваров_КонтурEDI(ПараметрыСопоставления); 

		Исключение 
			
			_ОписаниеОшибки = ОписаниеОшибки();
			
			ТекстОшибки = КонтурСтандарт_СтрШаблон_("Не удалось выполнить сопоставление товаров в сообщении %1 №%2 по причине: %3", 
													Сообщение.ТипСообщения, 
													Сообщение.ДокументEDI.Номер,  
													_ОписаниеОшибки);									
			Сообщить_КонтурEDI(ТекстОшибки);										
													
		КонецПопытки;
		
		ТабличнаяЧастьСообщения.ЗаполнитьЗначения(Неопределено, "СтрокаВходящегоСообщения");
		
		ЗаполнитьТипыПродукцииВСообщении(Сообщение);
		
	КонецЕсли;
	
	ОтборКонвертируемыхПолей = Новый Структура();
	ОтборКонвертируемыхПолей.Вставить("ИмяТаблицы", ИмяТабличнойЧасти);
	ОтборКонвертируемыхПолей.Вставить("Принадлежность", Неопределено);
	
	ПорогКоличестваСтрокБезДлительнойОперации = 100;
	
	НачатьДлительнуюОперациюПриКонвертации = ДлительнаяОперация <> Истина 
		И ТабличнаяЧастьСообщения.Количество() > ПорогКоличестваСтрокБезДлительнойОперации;
		
	Если НачатьДлительнуюОперациюПриКонвертации Тогда
		ДлительнаяОперация_Начать();
	КонецЕсли;
	
	Если ДлительнаяОперация = Истина Тогда
		
		ТаблицаКонвертацииЗначенийEDIв1С = КэшДлительнойОперации.Получить("ТаблицаКонвертацииЗначенийEDIв1С");
		Если ТаблицаКонвертацииЗначенийEDIв1С = Неопределено Тогда
			
			ТаблицаКонвертацииЗначенийEDIв1С = Новый ТаблицаЗначений;
			ТаблицаКонвертацииЗначенийEDIв1С.Колонки.Добавить("ТипEDI");
			ТаблицаКонвертацииЗначенийEDIв1С.Колонки.Добавить("Тип1С");
			ТаблицаКонвертацииЗначенийEDIв1С.Колонки.Добавить("ЗначениеEDI");
			ТаблицаКонвертацииЗначенийEDIв1С.Колонки.Добавить("Значение1С");
			
			ТаблицаКонвертацииЗначенийEDIв1С.Индексы.Добавить("ТипEDI");
			ТаблицаКонвертацииЗначенийEDIв1С.Индексы.Добавить("Тип1С");
			ТаблицаКонвертацииЗначенийEDIв1С.Индексы.Добавить("ЗначениеEDI");
			
			КэшДлительнойОперации.Вставить("ТаблицаКонвертацииЗначенийEDIв1С",ТаблицаКонвертацииЗначенийEDIв1С);
			
		КонецЕсли;
	КонецЕсли;
	
	ТипТЗ = Тип("ТаблицаЗначений");
	
	// отбираем поля, которые нужно конвертить
	КонвертируемыеПоля = МетаданныеСообщения.Скопировать(ОтборКонвертируемыхПолей);
	
	Если КонвертируемыеПоля.Количество()>0 Тогда
		
		НомерСтроки = 0;
		
		Для Каждого СтрокаТоваров ИЗ ТабличнаяЧастьСообщения Цикл
			
			НомерСтроки = НомерСтроки + 1;
			
			Если ИмяТабличнойЧасти = "Товары" 
				И Не ЗначениеЗаполнено(СтрокаТоваров.УИД_СтрокиТовара) Тогда
				
				СтрокаТоваров.УИД_СтрокиТовара = УИД_СтрокиТовара_КонтурEDI(НомерСтроки, Сообщение.ТипСообщения);
								
			КонецЕсли;
			
			Если ИмяТабличнойЧасти = "Товары" 
				И Не ЗначениеЗаполнено(СтрокаТоваров.УИД_СтрокиПервоначальногоСообщения) Тогда
				
				СтрокаТоваров.УИД_СтрокиПервоначальногоСообщения = СтрокаТоваров.УИД_СтрокиТовара;
				
			КонецЕсли;
			
			Для Каждого ПолеТоваров ИЗ КонвертируемыеПоля Цикл
				
				Если ПолеТоваров.ВидСтруктурыEDI = Неопределено Тогда
					ТипEDI = ПолеТоваров.ТипEDI;
				Иначе
					ТипEDI = ПолеТоваров.ВидСтруктурыEDI;
				КонецЕсли;
				
				НашлиРезультатКонвертации = Ложь;
				
				ЗначениеEDI = СтрокаТоваров[ПолеТоваров.ИмяПоля+"EDI"];
				
				Если ДлительнаяОперация = Истина Тогда
					
					Если ПолеТоваров.ВидСтруктурыEDI = Неопределено Тогда
						
						Если Найти("\КодСтраны\НомерГТД\","\"+ТипEDI+"\")>0 Тогда
							Если ТипЗнч(ЗначениеEDI) = ТипТЗ Тогда
								Если ЗначениеEDI.Количество()=0 Тогда 
									Продолжить;
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
						
						НайденныеСтроки = ТаблицаКонвертацииЗначенийEDIв1С.НайтиСтроки(Новый Структура("ТипEDI,Тип1С,ЗначениеEDI",ТипEDI,ПолеТоваров.Тип1С,ЗначениеEDI));
						Если НайденныеСтроки.Количество()>0 Тогда
							РезультатКонвертации = НайденныеСтроки[0].Значение1С;
							НашлиРезультатКонвертации = Истина;
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
				Если НашлиРезультатКонвертации = Ложь Тогда
					РезультатКонвертации = КонвертироватьЗначениеEDIв1С(ЗначениеEDI,ТипEDI,ПолеТоваров.Тип1С);
					Если ДлительнаяОперация = Истина Тогда
						НоваяСтрока = ТаблицаКонвертацииЗначенийEDIв1С.Добавить();
						НоваяСтрока.ТипEDI = ТипEDI;
						НоваяСтрока.Тип1С = ПолеТоваров.Тип1С;
						НоваяСтрока.ЗначениеEDI = ЗначениеEDI;
						НоваяСтрока.Значение1С = РезультатКонвертации;
					КонецЕсли;	
				КонецЕсли;	
				
				Если НЕ РезультатКонвертации = Неопределено Тогда
					
					СтрокаТоваров[ПолеТоваров.ИмяПоля + "1С"] = РезультатКонвертации;
					
				КонецЕсли; 					
				
			КонецЦикла;  			
			
			Если ИмяТабличнойЧасти = "Товары" Тогда
				СтрокаТоваров.ТекстПересчета = 
				ТекстПересчета_КонтурEDI(СтрокаТоваров.ЕдиницаИзмерения, СтрокаТоваров.КодЕдиницыИзмеренияEDI, СтрокаТоваров.КоэффициентEDIВ1С);
			КонецЕсли;
			
			Если ИмяТабличнойЧасти = "Товары"
				И ЗначениеЗаполнено(Сообщение) И Сообщение.ТипСообщения <> "PRICELIST" Тогда
				СтрокаТоваров.Статус = КонвертироватьЗначениеEDIв1С(СтрокаТоваров.Статус, "Статус", "Статус");
			КонецЕсли;	
			
			Если ИмяТабличнойЧасти = "Товары" Тогда
				ЗаполнитьНедостающиеПоляСтрокиТоваров(СтрокаТоваров);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если НачатьДлительнуюОперациюПриКонвертации Тогда
		ДлительнаяОперация_Завершить();	
	КонецЕсли;
	
КонецФункции

Функция КонвертироватьЗначениеEDIв1С(Значение,ТипEDI,Тип1С,Сообщение=Неопределено) Экспорт
	
	СтандартнаяОбработкаEDI = Истина;
	
	РезультатКонвертации = ОбработкаСобытияПодключаемогоМодуля("КонвертироватьЗначениеEDIв1С",СтандартнаяОбработкаEDI,
			Новый Структура("ЗначениеEDI,ТипПоляEDI,ТипПоля1C,Сообщение",
			Значение, ТипEDI, Тип1С, Сообщение));

	Если Не СтандартнаяОбработкаEDI Тогда
		
		Возврат РезультатКонвертации;
		
	КонецЕсли;
	
	Если ТипEDI = "ЮрФизЛицо" Тогда
		
		Если ТипЗнч(Значение) = Тип("Структура") 
			И Значение.Свойство("GLN") 
			И НЕ ПустаяСтрока(Значение.GLN) Тогда
			
			Если Тип1С = "ТочкаДоставкиСторонняя" Тогда
				
				Возврат НайтиОбъектПоЗначениюСвойства("GLN_ТочкиДоставки",Значение.GLN); 
				
			ИначеЕсли Тип1С = "ТочкаДоставкиСвоя" Тогда
				
				Возврат НайтиОбъектПоЗначениюСвойства("GLN_НашейТочкиДоставки",Значение.GLN);
				
			ИначеЕсли Тип1С = "ЮрФизЛицоСвое" Тогда
				
				ЮрЛицо = НайтиОбъектПоЗначениюСвойства("GLN_Организации",Значение.GLN); 

				Возврат ЮрЛицо;
				
			ИначеЕсли Тип1С = "ЮрФизЛицоСтороннее" Тогда
				
				ЮрЛицо = НайтиОбъектПоЗначениюСвойства("GLN_Контрагента",Значение.GLN); 
				
				Возврат ЮрЛицо;
				
			КонецЕсли;
			
		Иначе
			
			Возврат Неопределено;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипEDI = "УчастникОбмена" Тогда
		Если Тип1С = "ПодразделениеСвое" Тогда
			
			Возврат НайтиОбъектПоЗначениюСвойства("GLN_Организации",Значение.GLN);
			
		ИначеЕсли Тип1С = "ПодразделениеСтороннее" Тогда
			
			Возврат НайтиОбъектПоЗначениюСвойства("GLN_Партнера",Значение.GLN); 
			
		КонецЕсли;
	КонецЕсли;
	
	Если ТипEDI = "Документ" Тогда
		Если Тип1С = "ВходящийЗаказПокупателя" Тогда
			
			Возврат Неопределено; //по-идее можно будет поискать, для отказоустойчивости (не загружать несколько раз документ).
			                      //с другой стороны - тогда пожертвуем быстродействием
		ИначеЕсли Тип1С = "ВходящееУведомлениеОПриемке" Тогда
			
			Возврат Неопределено; //тоже нужно будет проверять
			
		ИначеЕсли Тип1С = "ВходящийСчетФактура" Тогда
			//для входящей СЧФ заполним
			ТипДокумента = ПолучитьТипЗначенияОбъекта("ВходящийСчетФактура",,Истина);
			
			Если ТипДокумента<>Неопределено Тогда
				
				Запрос = Новый Запрос();
				Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				|	ДокументЗаказ.Ссылка
				|ИЗ
				|	Документ."+ТипДокумента+" КАК ДокументЗаказ
				|ГДЕ
				|	ДокументЗаказ.Номер = &Номер
				|   И ДокументЗаказ.Дата > &ОграничениеПоДате
				|
				|УПОРЯДОЧИТЬ ПО
				|	ДокументЗаказ.Дата УБЫВ";
				
				Запрос.УстановитьПараметр("Номер",СокрЛП(Значение.Номер));			   
				Запрос.УстановитьПараметр("ОграничениеПоДате",ДобавитьМесяц(ТекущаяДата(),-6));
				
				РезультатЗапроса = Запрос.Выполнить();
				
				Если РезультатЗапроса.Пустой() Тогда
					
					ВходящийСчетФактура = Неопределено;
					
				Иначе
					
					Выборка = РезультатЗапроса.Выбрать();
					Выборка.Следующий();
					
					ВходящийСчетФактура = Выборка.Ссылка;
					
				КонецЕсли;
				
				Возврат ВходящийСчетФактура;
				
			Иначе//для данного документа не задан тип. Значит, мы не поставщик, или же не указан шаблон документов
				Возврат Неопределено;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	Если ТипEDI = "Заказ" Тогда
		Если Тип1С = "ВходящийЗаказПокупателя" 
		 ИЛИ Тип1С = "ИсходящийЗаказПоставщику" Тогда
		 
		    ТипСообщения	= "ORDERS";
			Направление		= ?(Тип1С = "ИсходящийЗаказПоставщику", "Исходящее", "Входящее");
			
		 	Возврат НайтиДокументПоРеквизитамСообщения_КонтурEDI(Значение.Номер, Значение.Дата, ТипСообщения, Направление, Сообщение.Партнер, Сообщение.Грузополучатель1С);
				
		КонецЕсли;
	КонецЕсли;
	
	Если ТипEDI = "Накладная" Тогда
		Если Тип1С = "ИсходящееУведомлениеОбОтгрузке" Тогда
			
			ТипСообщения	= "DESADV";
			Направление		= "Исходящее";
			
			Документ = НайтиДокументПоНомеруИДатеСообщения_КонтурEDI(Значение.Номер, Значение.Дата, ТипСообщения, Направление, Сообщение.Партнер, Сообщение.Грузополучатель1С);
			
			Если НЕ ЗначениеЗаполнено(Документ) Тогда
				Документ = НайтиИПолучитьНакладную(Сообщение);
			КонецЕсли;	
			
			Возврат Документ;
			
		ИначеЕсли Тип1С = "ВходящееУведомлениеОбОтгрузке" Тогда
			
			ТипСообщения	= "DESADV";
			Направление		= "Входящее";
			
			Возврат НайтиДокументПоРеквизитамСообщения_КонтурEDI(Значение.Номер, Значение.Дата, ТипСообщения, Направление, Сообщение.Партнер, Сообщение.Грузополучатель1С);
			
		КонецЕсли; 			
	КонецЕсли;

	Если ТипEDI = "Возврат" Тогда
		Если Тип1С = "ВходящийВозвратОтПокупателя" Тогда
			
		КонецЕсли;
	КонецЕсли;
		
	Если ТипEDI = "ОбратныйЗаказ" Тогда
		
		Если Тип1С = "ИсходящийОбратныйЗаказ" Тогда
		
			ТипДокумента = ПолучитьТипЗначенияОбъекта("ВходящийЗаказПокупателя",,Истина);
			
			Если ТипДокумента <> Неопределено 
				И СокрЛП(Значение.Номер) <> "" 
				И ЕстьЦифрыВСтроке_КонтурEDI(Значение.Номер) Тогда 
				
				Запрос = Новый Запрос();
				Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				|	ДокументЗаказ.Ссылка
				|ИЗ
				|	Документ."+ТипДокумента+" КАК ДокументЗаказ
				|ГДЕ
				|	ДокументЗаказ.Номер = &Номер
				|   И ДокументЗаказ.Дата > &ОграничениеПоДате
				|
				|УПОРЯДОЧИТЬ ПО
				|	ДокументЗаказ.Дата УБЫВ";
				
				Запрос.УстановитьПараметр("Номер",СокрЛП(Значение.Номер));			   
				Запрос.УстановитьПараметр("ОграничениеПоДате",ДобавитьМесяц(ТекущаяДата(),-6));
				
				РезультатЗапроса = Запрос.Выполнить();
				
				Если РезультатЗапроса.Пустой() Тогда
					
					ИсходящийОбратныйЗаказ = Неопределено;
					
				Иначе
					
					Выборка = РезультатЗапроса.Выбрать();
					Выборка.Следующий();
					
					ИсходящийОбратныйЗаказ = Выборка.Ссылка;
					
				КонецЕсли;  
				
				Возврат ИсходящийОбратныйЗаказ;
				
			Иначе
				
				Возврат Неопределено;
				
			КонецЕсли;
			
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипEDI = "Приемка" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипEDI = "Статус" Тогда
		
		Если НЕ ЗначениеЗаполнено(Значение) Тогда
			Возврат "";
		КонецЕсли;
		
		Если Значение = "Accepted" Тогда
			Возврат "Подтвержден";
		ИначеЕсли Значение = "Changed" Тогда
			Возврат "Уточнен";
		ИначеЕсли Значение = "Declined" ИЛИ Значение = "Rejected" Тогда
			Возврат "Отклонен";
		КонецЕсли;
		
		Возврат Значение;
		
	КонецЕсли;	
	
	Если ТипEDI = "СчетФактура" Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Если ТипEDI = "ТипСФ" Тогда
		Если Тип1С = "ВходящийСчетФактура" Тогда
			
			ТипСообщения	= "INVOIC";
			Направление		= "Входящее";
			
		 	Возврат НайтиДокументПоРеквизитамСообщения_КонтурEDI(Значение.Номер, Значение.Дата, ТипСообщения, Направление, Сообщение.Партнер, Сообщение.Грузополучатель1С);
			
		КонецЕсли;
	КонецЕсли;
	
	Если ТипEDI = "Валюта" Тогда
		
		Возврат ВалютаУчета_КонтурEDI();
		
	КонецЕсли;
	
	// ТОВАРЫ
	
	Если ТипEDI = "КодЕдиницы" Тогда
		
		Возврат Значение;
		
	КонецЕсли;
	
	Если ТипEDI = "СтавкаНДС" Тогда
		
		Возврат КонвертироватьСтавкуНДС_EDIв1С(Значение);
		
	КонецЕсли;
	
	Если ТипEDI = "Страна" Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Если ТипEDI = "НомерГТД" Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Если ТипEDI = "КоличествоКВозвратуИПричина" Тогда
		
		Если ТипЗнч(Значение) = Тип("ТаблицаЗначений") 
			И ЗначениеЗаполнено(Значение) Тогда
			
			Таб = Значение.Скопировать();
			
			Для каждого Строка Из Таб Цикл
				
				Строка.ПричинаВозврата = ПолучитьПредставлениеПеречисленияEDI(Строка.ПричинаВозврата, "ПричинаВозврата");	
				                         
			КонецЦикла;
			
			Возврат Таб;
			
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	//	Сообщить("Не нашлась пара EDI: "+ТипEDI+" и 1С:"+Тип1С);
	
	// если не нашлась пара, то вернуть error
	
КонецФункции

Функция ВалютаУчета_КонтурEDI() Экспорт
	
	ВалютаУчета = ЭДО_Кэш_Прочитать("ВалютаУчета");
	
	Если ВалютаУчета = Неопределено Тогда
		
		ВалютаУчета = ОбработкаСобытияПодключаемогоМодуля("ПолучитьВалютаУчета");
		
		Если ВалютаУчета = Неопределено Тогда
			
			Если ИмяКонфигурации1С = "Розница" ИЛИ ИмяКонфигурации1С = "УФ_Розница" Тогда
				
				ВалютаУчета = Неопределено;
				
			ИначеЕсли ИмяКонфигурации1С = "ТКПТ" Тогда
				
				ВалютаУчета = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();	
				
			ИначеЕсли ИмяКонфигурации1С = "АСТОР" Тогда
				
				ВалютаУчета = "RUB";
				
			ИначеЕсли ИмяКонфигурации1С = "УФ_УНФ" Тогда
				
				ВалютаУчета = Константы.ВалютаУчета.Получить();
				
			ИначеЕсли ИмяКонфигурации1С = "ШтрихМ_РС" Тогда
				
				ВалютаУчета = Константы.ВалютаРегиональногоУчета.Получить();
				
			Иначе
				
				ВалютаУчета = Константы.ВалютаРегламентированногоУчета.Получить();
				
			КонецЕсли;
			
		КонецЕсли; 	
		
		ЭДО_Кэш_Поместить("ВалютаУчета", ВалютаУчета);
		
	КонецЕсли;

	Возврат ВалютаУчета;

КонецФункции

// Для поиска документа 1С по ссылкам на предыдущие сообщения в шапке сообщения
//
// Параметры:
// 		НомерСообщения  - Строка 	- номер сообщения, например, в поле xml сообщения originOrder.number
// 		ДатаСообщения  	- Дата 		- дата сообщения, например, в поле xml сообщения originOrder.date
//		ТипСообщения  	- Строка 	- тип сообщения, например, ORDRSP
//		Направление  	- Строка 	- Входящее, Исходящее
//
// Возвращаемое значение:
//		ДокументСсылка  - ссылка на найденный документ 1С
//
Функция НайтиДокументПоРеквизитамСообщения_КонтурEDI(НомерСообщения, ДатаСообщения, ТипСообщения, Направление, Партнер, ТочкаДоставки)
	
	Документ = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(НомерСообщения)
		И НЕ ЗначениеЗаполнено(ДатаСообщения) Тогда
		
		Возврат Документ;
		
	КонецЕсли;
	
	Документ = НайтиДокументПоНомеруИДатеСообщения_КонтурEDI(НомерСообщения, ДатаСообщения, ТипСообщения, Направление, Партнер, ТочкаДоставки);
	
	Если НЕ ЗначениеЗаполнено(Документ) Тогда
		
		ПустаяДата = Неопределено;		
		Документ = НайтиДокументПоНомеруИДатеСообщения_КонтурEDI(НомерСообщения, ПустаяДата, ТипСообщения, Направление, Партнер, ТочкаДоставки);
		
	КонецЕсли;
	
	Возврат Документ;
	
КонецФункции

// Для поиска документа 1С по ссылкам на предыдущие сообщения в шапке сообщения
//
// Параметры:
// 		НомерСообщения  - Строка 	- номер сообщения, например, в поле xml сообщения originOrder.number
// 		ДатаСообщения  	- Дата 		- дата сообщения, например, в поле xml сообщения originOrder.date
//		ТипСообщения  	- Строка 	- тип сообщения, например, ORDRSP
//		Направление  	- Строка 	- Входящее, Исходящее
//
// Возвращаемое значение:
//		ДокументСсылка  - ссылка на найденный документ 1С
//
Функция НайтиДокументПоНомеруИДатеСообщения_КонтурEDI(НомерСообщения, ДатаСообщения, ТипСообщения, Направление, Партнер, ТочкаДоставки)
	
	Документ = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(НомерСообщения) Тогда
		
		Возврат Документ;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДатаСообщения) Тогда
		
		УсловиеОтбораПоДатеДокумента = "КонтурEDI_Сообщения.ДатаДокумента >= &ДатаДокумента";
		КоличествоМесяцев = 12;
		ДатаДокумента = ДобавитьМесяц(ТекущаяДатаСеанса(), - КоличествоМесяцев);
		
	Иначе 
		
		УсловиеОтбораПоДатеДокумента = "КонтурEDI_Сообщения.ДатаДокумента = &ДатаДокумента";
		ДатаДокумента = ДатаСообщения;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	КонтурEDI_Сообщения.Документ
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|ГДЕ
	|	КонтурEDI_Сообщения.Партнер = &Партнер
	|	И КонтурEDI_Сообщения.Направление = &Направление
	|	И КонтурEDI_Сообщения.ТипСообщения = &ТипСообщения
	|	И КонтурEDI_Сообщения.НомерДокумента = &НомерДокумента
	|	И (КонтурEDI_Сообщения.ТочкаДоставки = &ТочкаДоставки
	|			ИЛИ &ТочкаДоставки = НЕОПРЕДЕЛЕНО)
	|	И #УсловиеОтбораПоДатеДокумента#  
	|
	|УПОРЯДОЧИТЬ ПО
	|	КонтурEDI_Сообщения.ДатаДокумента УБЫВ,
	|	КонтурEDI_Сообщения.Код УБЫВ";     	
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#УсловиеОтбораПоДатеДокумента#", УсловиеОтбораПоДатеДокумента);  
	
	Запрос.УстановитьПараметр("Партнер", Партнер);
	
	Если Не ЗначениеЗаполнено(ТочкаДоставки) 
		ИЛИ ТипЗнч(ТочкаДоставки) <> Тип("СправочникСсылка.КонтурEDI_ТочкиДоставки") Тогда
		Запрос.УстановитьПараметр("ТочкаДоставки", 	Неопределено); 
	Иначе
		Запрос.УстановитьПараметр("ТочкаДоставки", 	ТочкаДоставки);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НомерДокумента", СокрЛП(НомерСообщения));
	Запрос.УстановитьПараметр("ДатаДокумента", 	ДатаДокумента);
	Запрос.УстановитьПараметр("ТипСообщения",	ТипСообщения);
	Запрос.УстановитьПараметр("Направление",	Направление);
	   	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Документ = Неопределено;
		
	Иначе
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Документ = Выборка.Документ;
		
	КонецЕсли;
		
	Возврат Документ;
	
КонецФункции

Функция ПолучитьСтруктуруПредопределенныхСтавокНДС()

	СтруктураПредопределенныхСтавокНДС = ЭДО_Кэш_Прочитать("СтруктураПредопределенныхСтавокНДС");

	Если СтруктураПредопределенныхСтавокНДС = Неопределено Тогда
		
		СтруктураПредопределенныхСтавокНДС = ПолучитьОписаниеСтруктурыПредопределенныхСтавокНДС(); 
		
		ЕстьСправочникСтавокНДС = ПеременнаяСодержитСвойство(Справочники, "СтавкиНДС");
		ЕстьПеречислениеСтавокНДС = ПеременнаяСодержитСвойство(Перечисления, "СтавкиНДС");
		
		КоллекцияСтавкиНДС = Новый Соответствие;
		МетаданныеМенеджерСтавкаНДС = Неопределено;
		ТипМетаданных = Неопределено;
		СоответствиеЗначенияСтавкиНДСЧислу = Новый Соответствие;
		СоответствиеЗначенияСтавкиНДССтроке = Новый Соответствие;
		
		СтруктураСоответствий = Новый Структура;
		СтруктураСоответствий.Вставить("СоответствиеЗначенияСтавкиНДСЧислу", СоответствиеЗначенияСтавкиНДСЧислу);
		СтруктураСоответствий.Вставить("СоответствиеЗначенияСтавкиНДССтроке", СоответствиеЗначенияСтавкиНДССтроке);

		Если ЕстьПеречислениеСтавокНДС Тогда
			
			ТипМетаданных 			    = "Перечисления";
			ТипМетаданныхСтавкаНДС      = "СтавкиНДС";
			МетаданныеМенеджерСтавкаНДС = Вычислить(ТипМетаданных+"."+ТипМетаданныхСтавкаНДС);
			ЗначенияПеречисления 		= Метаданные[ТипМетаданных][ТипМетаданныхСтавкаНДС].ЗначенияПеречисления;
			
			Для Каждого ЗначениеПеречисления Из ЗначенияПеречисления Цикл
				
				ПредопределенноеИмя = ЗначениеПеречисления.Имя;
				ЗначениеСтавкиНДС = МетаданныеМенеджерСтавкаНДС[ПредопределенноеИмя];
				
				КоллекцияСтавкиНДС.Вставить(ПредопределенноеИмя,ЗначениеСтавкиНДС);
				
			КонецЦикла;  	
			
			ЗаполнитьСоответствияПредопределенныхСтавокНДС(КоллекцияСтавкиНДС, СтруктураСоответствий);
			
		КонецЕсли;
		
		Если ЕстьСправочникСтавокНДС Тогда
			
			КоллекцияСтавкиНДС.Очистить();
			
			ТипМетаданных 				= "Справочники";
			ТипМетаданныхСтавкаНДС  	= "СтавкиНДС";
			МетаданныеМенеджерСтавкаНДС = Вычислить(ТипМетаданных+"."+ТипМетаданныхСтавкаНДС);
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ   
			|	СтавкиНДС.Ссылка
			|ИЗ
			|	Справочник." + ТипМетаданныхСтавкаНДС + " КАК СтавкиНДС
			|ГДЕ
			|	СтавкиНДС.Предопределенный";
			ВыборкаСтавкиНДС = Запрос.Выполнить().Выбрать();
			
			Пока ВыборкаСтавкиНДС.Следующий() Цикл
				
				ЗначениеСтавкиНДС = ВыборкаСтавкиНДС.Ссылка;
				ПредопределенноеИмя = МетаданныеМенеджерСтавкаНДС.ПолучитьИмяПредопределенного(ЗначениеСтавкиНДС);
				
				КоллекцияСтавкиНДС.Вставить(ПредопределенноеИмя,ЗначениеСтавкиНДС);
								
			КонецЦикла;
			
			ЗаполнитьСоответствияПредопределенныхСтавокНДС(КоллекцияСтавкиНДС, СтруктураСоответствий);
			
		КонецЕсли;
		
		СтруктураПредопределенныхСтавокНДС.Вставить("МетаданныеМенеджерСтавкаНДС",				МетаданныеМенеджерСтавкаНДС);
		СтруктураПредопределенныхСтавокНДС.Вставить("КоллекцияСтавкиНДС",						КоллекцияСтавкиНДС);
		СтруктураПредопределенныхСтавокНДС.Вставить("ТипМетаданных",							ТипМетаданных);  
		СтруктураПредопределенныхСтавокНДС.Вставить("ТипМетаданныхСтавкаНДС",					ТипМетаданныхСтавкаНДС); 
		СтруктураПредопределенныхСтавокНДС.Вставить("СоответствиеЗначенияСтавкиНДСЧислу",		СоответствиеЗначенияСтавкиНДСЧислу); 
		СтруктураПредопределенныхСтавокНДС.Вставить("СоответствиеЗначенияСтавкиНДССтроке",		СоответствиеЗначенияСтавкиНДССтроке); 
		
		ЭДО_Кэш_Поместить("СтруктураПредопределенныхСтавокНДС", СтруктураПредопределенныхСтавокНДС);
		
	КонецЕсли;

	Возврат СтруктураПредопределенныхСтавокНДС;

КонецФункции

Процедура ЗаполнитьСоответствияПредопределенныхСтавокНДС(КоллекцияСтавкиНДС, СтруктураСоответствий)
		
	СоответствиеПредопределенногоИмениСтавкиНДСЧислу = ПолучитьСоответствиеПредопределенногоИмениСтавкиНДСЧислу();
	СоответствиеПредопределенногоИмениСтавкиНДССтроке = ПолучитьСоответствиеПредопределенногоИмениСтавкиНДССтроке();
	
	Для каждого Элемент Из КоллекцияСтавкиНДС Цикл
	
		ПредопределенноеИмя = Элемент.Ключ;
		ЗначениеСтавкиНДС = Элемент.Значение;
		
		ЧислоИзЗначения = СоответствиеПредопределенногоИмениСтавкиНДСЧислу[ПредопределенноеИмя];
		СтрокаИзЗначения = СоответствиеПредопределенногоИмениСтавкиНДССтроке[ПредопределенноеИмя];
		
		Если НЕ ЧислоИзЗначения = Неопределено Тогда
			СтруктураСоответствий.СоответствиеЗначенияСтавкиНДСЧислу.Вставить(ЗначениеСтавкиНДС, ЧислоИзЗначения);
		КонецЕсли;
		
		Если НЕ СтрокаИзЗначения = Неопределено Тогда
			СтруктураСоответствий.СоответствиеЗначенияСтавкиНДССтроке.Вставить(ЗначениеСтавкиНДС, СтрокаИзЗначения);
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьОписаниеСтруктурыПредопределенныхСтавокНДС()
	
	Структура = Новый Структура;
	Структура.Вставить("МетаданныеМенеджерСтавкаНДС");
