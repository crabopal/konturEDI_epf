	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ТипПродукции = СопоставлениеПеречислений.Получить(Выборка.ВидПродукцииИС);
		Если ТипПродукции = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеПеречисленияEDI = ТипыПродукцииEDI.НайтиПоЗначению(ТипПродукции);
		
		Если Сообщение.ТипыМаркируемойПродукции.НайтиПоЗначению(ЗначениеПеречисленияEDI.Значение) = Неопределено Тогда
			Сообщение.ТипыМаркируемойПродукции.Добавить(ЗначениеПеречисленияEDI.Значение, ЗначениеПеречисленияEDI.Представление);
		КонецЕсли;
			
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТипыМаркируемойПродукции_КлючВидовПродукции(Сообщение)
	
	СопоставлениеПеречислений = СопоставлениеПеречисленийТиповМаркируемойПродукции_ВидыПродукцииИС();
		
	Если Не ЗначениеЗаполнено(СопоставлениеПеречислений) Тогда
		Возврат;
	КонецЕсли;
	
	НоменклатураСообщения = ПолучитьНоменклатуруСообщения_КонтурEDI(Сообщение); 
	ТипыПродукцииEDI = ПолучитьСписокЗначенийПеречисленияEDI("ТипыМаркированнойПродукции");
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	                  |	ОписаниеНоменклатурыИС.Номенклатура КАК Номенклатура,
					  |	КлючиВидовПродукцииИС.ВидПродукцииГИСМТ КАК ВидПродукцииГИСМТ
	                  |ИЗ
	                  |	РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
	                  |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиВидовПродукцииИС КАК КлючиВидовПродукцииИС
	                  |		ПО ОписаниеНоменклатурыИС.КлючВидовПродукции = КлючиВидовПродукцииИС.Ссылка
	                  |ГДЕ
	                  |	ОписаниеНоменклатурыИС.Номенклатура В(&НоменклатураСообщения)";
	
	Запрос.УстановитьПараметр("НоменклатураСообщения", НоменклатураСообщения);
	
	Результат = Запрос.Выполнить(); 
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	СопоставлениеВидовПродукции = СопоставлениеСправочникаВидыПродукцииПеречислению();
	
	Пока Выборка.Следующий() Цикл
		
		ЗначениеПеречисленияИС = СопоставлениеВидовПродукции.Получить(Выборка.ВидПродукцииГИСМТ);
		
		ТипПродукции = СопоставлениеПеречислений.Получить(ЗначениеПеречисленияИС);
		
		Если ТипПродукции = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеПеречисленияEDI = ТипыПродукцииEDI.НайтиПоЗначению(ТипПродукции);
		
		Если Сообщение.ТипыМаркируемойПродукции.НайтиПоЗначению(ЗначениеПеречисленияEDI.Значение) = Неопределено Тогда
			Сообщение.ТипыМаркируемойПродукции.Добавить(ЗначениеПеречисленияEDI.Значение, ЗначениеПеречисленияEDI.Представление);
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры

Функция СопоставлениеПеречисленийТиповМаркируемойПродукции_ВидыПродукцииИС()

	СопоставлениеПеречислений = ЭДО_Кэш_Прочитать("СопоставлениеПеречисленийТиповМаркируемойПродукции");
	
	Если СопоставлениеПеречислений <> Неопределено Тогда
		Возврат СопоставлениеПеречислений;
	КонецЕсли;
	
	СопоставлениеПеречислений = Новый Соответствие;
	
	ИмяПеречисленияТипПродукции = Новый Структура;
	ИмяПеречисленияТипПродукции.Вставить("Пиво", "Alcohol");
	ИмяПеречисленияТипПродукции.Вставить("ПивоВПотребительскихУпаковках", "Alcohol");
	ИмяПеречисленияТипПродукции.Вставить("АлкогольнаяПродукцияДо9Процентов", "Alcohol");
	ИмяПеречисленияТипПродукции.Вставить("Табак", "Tobacco");
	ИмяПеречисленияТипПродукции.Вставить("НикотиносодержащаяПродукция", "Tobacco");
	ИмяПеречисленияТипПродукции.Вставить("АльтернативныйТабак", "Tobacco");
	
	Для каждого КлючЗначение Из ИмяПеречисленияТипПродукции Цикл
		
		СтрокаМетаданных = "Перечисления.ВидыПродукцииИС.ЗначенияПеречисления." + КлючЗначение.Ключ; 
		
		Если Не ЕстьНеобходимыеМетаданные(СтрокаМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеПеречисления1С = Перечисления.ВидыПродукцииИС[КлючЗначение.Ключ];
		ЗначениеПеречисленияEDI = КлючЗначение.Значение;
		
		СопоставлениеПеречислений.Вставить(ЗначениеПеречисления1С, ЗначениеПеречисленияEDI);
		
	КонецЦикла;
		
	ЭДО_Кэш_Поместить("СопоставлениеПеречисленийТиповМаркируемойПродукции", СопоставлениеПеречислений);
		
	Возврат СопоставлениеПеречислений;	
	
КонецФункции

Функция СопоставлениеСправочникаВидыПродукцииПеречислению()
	
    КлючКэша = "РезультатФункции_СопоставлениеСправочникаВидыПродукцииПеречислению";
	СопоставлениеСправочника = ЭДО_Кэш_Прочитать(КлючКэша);
	
	Если СопоставлениеСправочника <> Неопределено Тогда
		Возврат СопоставлениеСправочника;
	КонецЕсли;                       
	
	СопоставлениеСправочника = Новый Соответствие;
	СопоставлениеПеречислений = СопоставлениеПеречисленийТиповМаркируемойПродукции_ВидыПродукцииИС();
		
	Если Не ЗначениеЗаполнено(СопоставлениеПеречислений) Тогда
		Возврат СопоставлениеСправочника; 
	КонецЕсли;
	
	ОбщийМодуль_КонструкторИСОбщегоНазначенияКлиентСервер = ОбщийМодуль1С_КонтурEDI("КонструкторИСОбщегоНазначенияКлиентСервер");
	
	Для Каждого ТекущееПеречисление Из СопоставлениеПеречислений Цикл
		
		МассивВидовПродукции = ОбщийМодуль_КонструкторИСОбщегоНазначенияКлиентСервер.ВидыПродукцииПоЗначениюПеречисления(ТекущееПеречисление.Ключ);
		Для Каждого ТекущийВидПродукции Из МассивВидовПродукции Цикл
			СопоставлениеСправочника.Вставить(ТекущийВидПродукции, ТекущееПеречисление.Ключ);
		КонецЦикла; 
		
	КонецЦикла;
	
	ЭДО_Кэш_Поместить(КлючКэша, СопоставлениеСправочника);
	
	Возврат СопоставлениеСправочника;
	
КонецФункции

//RETINS
Функция ПодготовитьОтветНаУведомлениеОВозврате(ДокументСсылка, Сообщение, Параметры)
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;	
	
	Если Параметры.Свойство("ЭтоОтклонениеНезагруженногоВозврата") Тогда
		
		Сообщение = ПрочитатьСообщение(Параметры.ВходящийВозврат);
		
		ИнвертироватьСтороныТранспортаСообщения(Сообщение);
		
		Если НЕ ЗначениеЗаполнено(Сообщение.ГрузополучательEDI.GLN) Тогда
			Сообщение.ГрузополучательEDI.GLN = Сообщение.ПолучательEDI.GLN;	
		КонецЕсли;	
			
		Сообщение.ТипСообщения		= "RETINS";
		Сообщение.Направление		= "Исходящее";
		
		Сообщение.Статус 			= "Отклонен";
		
		Если НЕ ЗначениеЗаполнено(Сообщение.ВалютаEDI) Тогда
			Сообщение.ВалютаEDI = "RUB";
		КонецЕсли;
		
		Эталон = ПолучитьСтруктуруСообщения(Сообщение.ТипСообщения, Сообщение.Направление);
		ДополнитьСтруктуруСообщенияИзЭталона(Сообщение, Эталон);
		
		Сообщение.УведомлениеОВозвратеEDI.Номер = Сообщение.ДокументEDI.Номер;
		Сообщение.УведомлениеОВозвратеEDI.Дата 	= Сообщение.ДокументEDI.Дата;
		
		ЕстьКолонкаЗапрашиваемоеДействиеEDI	= (НЕ Сообщение.Товары.Колонки.Найти("ЗапрашиваемоеДействиеEDI") = Неопределено);
		
		Для каждого Стр Из Сообщение.Товары Цикл
			
			Стр.КоличествоПредложеноКВозврату 	= Стр.Количество;
			
			Стр.Количество 		= 0;
			Стр.ЦенаБезНДС 		= 0;
			Стр.ЦенаСНДС 		= 0;
			Стр.СуммаБезНДС 	= 0;
			Стр.СуммаСНДС 		= 0;
			Стр.СуммаНДС 		= 0;
			Стр.СтавкаНДС1С 	= Неопределено;
			Стр.СтавкаНДСEDI 	= Неопределено;
			
			Если ЕстьКолонкаЗапрашиваемоеДействиеEDI Тогда
				Стр.ЗапрашиваемоеДействие 	= ПолучитьПредставлениеПеречисленияEDI(Стр.ЗапрашиваемоеДействиеEDI, "ДействиеПоВозврату");
			Иначе
				Стр.ЗапрашиваемоеДействие 	= ПолучитьПредставлениеПеречисленияEDI(Стр.ЗапрашиваемоеДействие, "ДействиеПоВозврату");
			КонецЕсли;
			
			Стр.РешениеПоВозврату			= "В возврате отказано";
			Стр.Статус						= "Отклонен";
			Стр.ПричинаРешенияОтПокупателя	= Стр.ПричинаВозврата;
				
		КонецЦикла;
		
		Сообщение.Вставить("ВходящийВозврат", Сообщение.СообщениеСсылка);//понадобится в процедуре СохранитьСообщение
		Сообщение.СообщениеСсылка = Неопределено;//это будет новое сообщение
		
		Возврат Сообщение;
		
	КонецЕсли;
		
	Сообщение.Документ1С = ДокументСсылка;
	
	Организация = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Организация");
	Сообщение.Отправитель1С = Организация;
	Сообщение.Продавец1С 	= Организация;
	
	Контрагент = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Контрагент");
	
	РезультатОпределения = ОпределитьПартнераИКонтрагентаДляИсходящегоСообщения(Контрагент, Сообщение);
	
	Сообщение.Партнер = РезультатОпределения.Партнер;
	Сообщение.Получатель1С = РезультатОпределения.Партнер;
	Сообщение.Покупатель1С = РезультатОпределения.Контрагент;
	
	Сообщение.Грузополучатель1С		= Организация; 		
	Сообщение.Грузоотправитель1С	= РезультатОпределения.Контрагент; 		
	
	Сообщение.Валюта1С = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, 	"Валюта");
	флСуммаВключаетНДС = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка,	"СуммаВключаетНДС");   	
	
	РазрядностьОкругленияСуммИЦен = ПолучитьРазрядностьОкругленияДляСуммИЦен(Сообщение.Партнер);  
	
	Сообщение.ДатаПоставки	= ОпределитьДатуПоставки(Сообщение);
		
	Статус = ПодготовитьТовары_ОтветНаУведомлениеОВозврате(ДокументСсылка, Сообщение);
	
	Сообщение.Статус = Статус;  
		
КонецФункции

Функция ПодготовитьТовары_ОтветНаУведомлениеОВозврате(ДокументСсылка, Сообщение)
	
	ТоварыОтветаНаВозврат = ПолучитьТоварыДокументаДляСообщения(ДокументСсылка, Истина, "ПодготовитьОтветНаУведомлениеОВозврате",, Сообщение);
	ТоварыОтветаНаВозврат.ЗаполнитьЗначения(Ложь, "Пометка");
	
	СообщениеRETANN = ПрочитатьСообщение(, ДокументСсылка, "RETANN", "Входящее");
	ТоварыRETANN = СообщениеRETANN.Товары;
	
	// В старых RETANN не будет колонки "ЗапрашиваемоеДействие"
	ДобавитьКолонкиВТаблицуЗначений(ТоварыRETANN, "ЗапрашиваемоеДействие", ОписаниеТипаСтрока_КонтурEDI());
	ЕстьКолонкаЗапрашиваемоеДействиеEDI	= (НЕ ТоварыRETANN.Колонки.Найти("ЗапрашиваемоеДействиеEDI") = Неопределено);
	
	ЕстьОтклонения		= Ложь;
	ЕстьИзменения		= Ложь;
	ЕстьПодтверждения	= Ложь;
	
	МассивСопоставленныхСтрок = Новый Массив;
	
	сч = 0;
	
	Для Каждого СтрокаRETANN Из ТоварыRETANN Цикл
		
		сч = сч + 1;
		
		НоваяСтрока = Сообщение.Товары.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаRETANN, "Наименование,GTIN,КодТовараПокупателя,КодТовараПоставщика");
		
		НоваяСтрока.Количество 	= 0; 
		НоваяСтрока.ЦенаБезНДС 	= 0;
		НоваяСтрока.ЦенаСНДС 	= 0;
		НоваяСтрока.СуммаБезНДС = 0;
		НоваяСтрока.СуммаСНДС 	= 0;
		НоваяСтрока.СуммаНДС 	= 0;
				
		Если ЕстьКолонкаЗапрашиваемоеДействиеEDI Тогда
			НоваяСтрока.ЗапрашиваемоеДействие 	= ПолучитьПредставлениеПеречисленияEDI(СтрокаRETANN.ЗапрашиваемоеДействиеEDI, "ДействиеПоВозврату");
		Иначе
			НоваяСтрока.ЗапрашиваемоеДействие 	= ПолучитьПредставлениеПеречисленияEDI(СтрокаRETANN.ЗапрашиваемоеДействие, "ДействиеПоВозврату");
		КонецЕсли;
		
		НоваяСтрока.КоличествоПредложеноКВозврату 	= СтрокаRETANN.Количество;
		НоваяСтрока.ПричинаВозврата					= СтрокаRETANN.ПричинаВозврата;
		
		Если НастройкиМодуля.ИспользоватьХарактеристикиНоменклатуры Тогда
			НоваяСтрока.ХарактеристикаНоменклатуры = СтрокаRETANN.ХарактеристикаНоменклатуры;
		КонецЕсли;	
		
		СтрокиОтветаНаВозврат = ТоварыОтветаНаВозврат.НайтиСтроки(Новый Структура("УИД_СтрокиПредыдущегоСообщения", СтрокаRETANN.УИД_СтрокиТовара));
		
		ЗаполнитьСтрокуТоваровОтветаНаУведомлениеОВозврате(МассивСопоставленныхСтрок, НоваяСтрока, СтрокиОтветаНаВозврат);   		
		
		СтатусСтроки = "";
		Если НоваяСтрока.РешениеПоВозврату = "В возврате отказано" ИЛИ НоваяСтрока.Количество = 0 Тогда
			
			СтатусСтроки = "Отклонен";
			ЕстьОтклонения = Истина;
			
		ИначеЕсли НоваяСтрока.Количество <> НоваяСтрока.КоличествоПредложеноКВозврату Тогда
			
			СтатусСтроки = "Уточнен";
			ЕстьИзменения = Истина;
			
		Иначе
			
			СтатусСтроки = "Подтвержден";
			ЕстьПодтверждения = Истина;
			
		КонецЕсли;	
		
		НоваяСтрока.Статус = СтатусСтроки;
		
		НоваяСтрока.ПричинаРешенияОтПокупателя	= СтрокаRETANN.ПричинаВозврата;
		НоваяСтрока.ПричинаРешения				= СтрокаRETANN.ПричинаВозврата;
		
		НоваяСтрока.УИД_СтрокиТовара = УИД_СтрокиТовара_КонтурEDI(сч, Сообщение.ТипСообщения);
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.УИД_СтрокиПервоначальногоСообщения) Тогда			
			НоваяСтрока.УИД_СтрокиПервоначальногоСообщения = НоваяСтрока.УИД_СтрокиТовара;			
		КонецЕсли; 
		
		НоваяСтрока.ТекстПересчета = ТекстПересчета_КонтурEDI(
		НоваяСтрока.ЕдиницаИзмерения, 
		НоваяСтрока.КодЕдиницыИзмеренияEDI, 
		НоваяСтрока.КоэффициентEDIВ1С);
		
	КонецЦикла;
	
	Для Каждого СтрокаОтветаНаВозврат Из ТоварыОтветаНаВозврат Цикл
		
		Если МассивСопоставленныхСтрок.Найти(СтрокаОтветаНаВозврат) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		сч = сч + 1;		
		
		НоваяСтрока = Сообщение.Товары.Добавить();
		
		НоваяСтрока.НомерСтроки = сч;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОтветаНаВозврат);
		
		Если ПеременнаяСодержитСвойство(СтрокаОтветаНаВозврат, "СтавкаНДС") Тогда
			НоваяСтрока.СтавкаНДС1С = СтрокаОтветаНаВозврат.СтавкаНДС;
		КонецЕсли;
		
		НоваяСтрока.РешениеПоВозврату = "Возврат";
		
		НоваяСтрока.Статус			= "Уточнен";
		ЕстьИзменения 				= Истина;
		
		НоваяСтрока.УИД_СтрокиТовара = УИД_СтрокиТовара_КонтурEDI(сч, Сообщение.ТипСообщения);
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.УИД_СтрокиПервоначальногоСообщения) Тогда			
			НоваяСтрока.УИД_СтрокиПервоначальногоСообщения = НоваяСтрока.УИД_СтрокиТовара;			
		КонецЕсли;
		
		НоваяСтрока.ТекстПересчета = ТекстПересчета_КонтурEDI(
		НоваяСтрока.ЕдиницаИзмерения, 
		НоваяСтрока.КодЕдиницыИзмеренияEDI, 
		НоваяСтрока.КоэффициентEDIВ1С);
		
	КонецЦикла;
	
	Сообщение.Товары.Сортировать("УИД_СтрокиПервоначальногоСообщения,УИД_СтрокиПредыдущегоСообщения");
	
	ЗаполнитьПредставлениеЕдиницыИзмеренияВТаблицеТоваров(Сообщение.Товары);
	
	Если ЕстьИзменения ИЛИ (ЕстьПодтверждения И ЕстьОтклонения) Тогда
		Статус = "Уточнен";
	ИначеЕсли ЕстьПодтверждения Тогда
		Статус = "Подтвержден";
	Иначе
		Статус = "Отклонен";
	КонецЕсли;
	
	Возврат Статус;

КонецФункции

Процедура ЗаполнитьСтрокуТоваровОтветаНаУведомлениеОВозврате(МассивСопоставленныхСтрок, НоваяСтрока, СтрокиОтветаНаВозврат)
			
	Если СтрокиОтветаНаВозврат.Количество() = 0 Тогда
		
		ЕстьОтклонения = Истина;
		
		Если НоваяСтрока.ЗапрашиваемоеДействие = "Возврат" Тогда
			НоваяСтрока.РешениеПоВозврату = "В возврате отказано";   
		Иначе
			НоваяСтрока.РешениеПоВозврату = "";                      
		КонецЕсли;
				
	ИначеЕсли СтрокиОтветаНаВозврат.Количество() = 1 Тогда
		
		МассивСопоставленныхСтрок.Добавить(СтрокиОтветаНаВозврат[0]);
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокиОтветаНаВозврат[0]);
		
		Если ПеременнаяСодержитСвойство(СтрокиОтветаНаВозврат[0], "СтавкаНДС") Тогда
			НоваяСтрока.СтавкаНДС1С = СтрокиОтветаНаВозврат[0].СтавкаНДС;
		КонецЕсли;    
		
		НоваяСтрока.РешениеПоВозврату = "Возврат";
		
	Иначе  			
		
		Количество = 0;
		СуммаБезНДС = 0;
		СуммаСНДС = 0;
		СуммаНДС = 0;
		
		СписокНоменклатуры = Новый СписокЗначений;
		СписокХарактеристикНоменклатуры = Новый СписокЗначений;
		СписокСерийНоменклатуры = Новый СписокЗначений;
		
		МинимальныйКоэффициентEDIВ1С = Неопределено;
		СоответствиеКоэффициентEDIВ1С = Новый Соответствие;
		
		Для Каждого СтрокаОтветаНаВозврат Из СтрокиОтветаНаВозврат Цикл
			
			МассивСопоставленныхСтрок.Добавить(СтрокаОтветаНаВозврат);
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОтветаНаВозврат, , "ЦенаБезНДС,ЦенаСНДС,СуммаБезНДС,СуммаСНДС,СуммаНДС,Количество");
			
			Если ПеременнаяСодержитСвойство(СтрокаОтветаНаВозврат, "СтавкаНДС") Тогда
				НоваяСтрока.СтавкаНДС1С = СтрокаОтветаНаВозврат.СтавкаНДС;
			КонецЕсли;
			
			Количество	= Количество + СтрокаОтветаНаВозврат.Количество;
			СуммаБезНДС = СуммаБезНДС + СтрокаОтветаНаВозврат.СуммаБезНДС;
			СуммаСНДС	= СуммаСНДС + СтрокаОтветаНаВозврат.СуммаСНДС;
			СуммаНДС	= СуммаНДС + СтрокаОтветаНаВозврат.СуммаНДС;
			
			ДобавитьОтсутствующийЭлементВСписок_КонтурEDI(СписокНоменклатуры, СтрокаОтветаНаВозврат.Номенклатура);
			ДобавитьОтсутствующийЭлементВСписок_КонтурEDI(СписокХарактеристикНоменклатуры, СтрокаОтветаНаВозврат.ХарактеристикаНоменклатуры);
			
			Если ПеременнаяСодержитСвойство(СтрокаОтветаНаВозврат, "СерияНоменклатуры") Тогда
				ДобавитьОтсутствующийЭлементВСписок_КонтурEDI(СписокСерийНоменклатуры, СтрокаОтветаНаВозврат.СерияНоменклатуры);
			КонецЕсли;
			
			Если МинимальныйКоэффициентEDIВ1С = Неопределено ИЛИ МинимальныйКоэффициентEDIВ1С > СтрокаОтветаНаВозврат.КоэффициентEDIВ1С Тогда
				
				МинимальныйКоэффициентEDIВ1С = СтрокаОтветаНаВозврат.КоэффициентEDIВ1С;
				
			КонецЕсли;
			
			СоответствиеКоэффициентEDIВ1С.Вставить(СтрокаОтветаНаВозврат.КоэффициентEDIВ1С, СтрокаОтветаНаВозврат.ЕдиницаИзмерения);
			
		КонецЦикла;
		
		НоваяСтрока.Количество = Количество;
		НоваяСтрока.СуммаБезНДС = СуммаБезНДС;
		НоваяСтрока.СуммаСНДС = СуммаСНДС;
		НоваяСтрока.СуммаНДС = СуммаНДС;
		
		Если Количество <> 0 Тогда
			
			НоваяСтрока.ЦенаБезНДС = СуммаБезНДС/Количество;
			НоваяСтрока.ЦенаСНДС = СуммаСНДС/Количество;
			
			НоваяСтрока.РешениеПоВозврату = "Возврат";
			
		Иначе
			
			НоваяСтрока.ЦенаБезНДС = 0;
			НоваяСтрока.ЦенаСНДС = 0;
			
			Если НоваяСтрока.ЗапрашиваемоеДействие = "Возврат" Тогда
				НоваяСтрока.РешениеПоВозврату = "В возврате отказано";   
			Иначе
				НоваяСтрока.РешениеПоВозврату = "";                      
			КонецЕсли;
			
		КонецЕсли;
		
		Если СписокНоменклатуры.Количество() > 1 Тогда
			
			НоваяСтрока.Номенклатура = Неопределено;
			НоваяСтрока.СписокНоменклатуры = СписокНоменклатуры;
			
			НоваяСтрока.КоэффициентEDIВ1С = 1;
			НоваяСтрока.ЕдиницаИзмерения = Неопределено;
			
		Иначе
			
			НоваяСтрока.КоэффициентEDIВ1С = МинимальныйКоэффициентEDIВ1С;
			НоваяСтрока.ЕдиницаИзмерения = СоответствиеКоэффициентEDIВ1С[МинимальныйКоэффициентEDIВ1С];
			
		КонецЕсли;
		
		Если СписокХарактеристикНоменклатуры.Количество() > 1 Тогда
			НоваяСтрока.ХарактеристикаНоменклатуры = Неопределено;
			НоваяСтрока.СписокХарактеристикНоменклатуры = СписокХарактеристикНоменклатуры;
		КонецЕсли;
		
		Если СписокСерийНоменклатуры.Количество() > 1 Тогда
			НоваяСтрока.СерияНоменклатуры = Неопределено;
			НоваяСтрока.СписокСерийНоменклатуры = СписокСерийНоменклатуры;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

//RETREC
Функция ПодготовитьУведомлениеОПриемкеВозврата(ДокументСсылка,Сообщение,Параметры)
	
	Если Параметры=Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;	
	
	Если Параметры.Свойство("ЭтоОтклонениеНезагруженногоВозврата") Тогда
		
		Сообщение = ПрочитатьСообщение(Параметры.ВходящийВозврат);
		
		ИнвертироватьСтороныТранспортаСообщения(Сообщение);
		
		Сообщение.ТипСообщения		= "RETREC";
		Сообщение.Направление		= "Исходящее";
		Сообщение.НакладнаяEDI		= Сообщение.ДокументEDI;
		Сообщение.Статус 			= "Отклонен";
		
		Если НЕ ЗначениеЗаполнено(Сообщение.ВалютаEDI) Тогда
			Сообщение.ВалютаEDI = "RUB";
		КонецЕсли;
		
		Для каждого Стр Из Сообщение.Товары Цикл
			Стр.Количество 	= 0;
			Стр.СуммаБезНДС = 0;
			Стр.СуммаНДС 	= 0;
			Стр.СуммаСНДС 	= 0;
			Стр.Статус = "Отклонен";
		КонецЦикла;
		
		Эталон = ПолучитьСтруктуруСообщения(Сообщение.ТипСообщения,Сообщение.Направление);
		ДополнитьСтруктуруСообщенияИзЭталона(Сообщение,Эталон);
		Сообщение.Вставить("ВходящийВозврат",Сообщение.СообщениеСсылка);//понадобится в процедуре СохранитьСообщение
		Сообщение.СообщениеСсылка = Неопределено;//это будет новое сообщение
		
		Возврат Сообщение;
		
	КонецЕсли;
	
	Сообщение.Документ1С 	= ДокументСсылка;
	
	Организация = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Организация");
	Сообщение.Отправитель1С = Организация;
	Сообщение.Покупатель1С 	= Организация;
	
	Контрагент = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Контрагент");
	РезультатОпределения = ОпределитьПартнераИКонтрагентаДляИсходящегоСообщения(Контрагент, Сообщение);
	
	Сообщение.Партнер = РезультатОпределения.Партнер;
	Сообщение.Получатель1С = РезультатОпределения.Партнер;
	Сообщение.Продавец1С = РезультатОпределения.Контрагент;  
	
	Сообщение.Грузополучатель1С		= Организация; 		
	Сообщение.Грузоотправитель1С	= РезультатОпределения.Контрагент; 		
	
	Сообщение.Валюта1С = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Валюта");
	Сообщение.ДатаПоставки	= ОпределитьДатуПоставки(Сообщение);
	 	
	Товары = ПолучитьТоварыДокументаДляСообщения(ДокументСсылка,Истина,"ПодготовитьУведомлениеОПриемкеВозврата",,Сообщение);
	
	СообщениеRETDES = ПрочитатьСообщение(, ДокументСсылка, "RETDES", "Входящее");
	
	СравниваемыеПоля = Новый СписокЗначений;
	СравниваемыеПоля.Добавить("Количество");
	
	РассчитыватьНДС = Ложь; 
	ПропускатьНулевыеЗначения = Ложь; 
	РезультатСравнения	= ПолучитьРезультатСравненияТаблицСообщений_КонтурEDI(СообщениеRETDES.Товары, Товары, СравниваемыеПоля, "RETDES", "RETREC", 
																				РассчитыватьНДС, ПропускатьНулевыеЗначения, СообщениеRETDES, Сообщение); 
	ТаблицаСравнения 	= РезультатСравнения.ТаблицаСравнения;
	СчетчикОтклоненных 	= 0;
	
	Для Каждого Стр Из ТаблицаСравнения Цикл
		
		Если Стр.Статус = "Отклонен" Тогда
			
			СчетчикОтклоненных = СчетчикОтклоненных + 1;
			НоваяСтрока = Сообщение.Товары.Добавить();
			СписокСвойств = "GTIN,КодТовараПокупателя,КодТовараПоставщика,Наименование,Статус";
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр, СписокСвойств);
			
			Продолжить;
			
		КонецЕсли;
		
		ПоискПоТоварам = Новый Структура;
		
		Если ЗначениеЗаполнено(Стр.GTIN) Тогда
			ПоискПоТоварам.Вставить("GTIN", Стр.GTIN);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.КодТовараПоставщика) Тогда
			ПоискПоТоварам.Вставить("КодТовараПоставщика", Стр.КодТовараПоставщика);
		КонецЕсли;
		
		НайденныеСтрокиRETREC = Товары.НайтиСтроки(ПоискПоТоварам);
		
		Если НайденныеСтрокиRETREC.Количество() = 0 Тогда
			
			ПоискПоТоварам.Вставить("КодТовараПоставщика", УбратьЛидирующиеНулиВСтроке_КонтурEDI(Стр.КодТовараПоставщика));
			НайденныеСтрокиRETREC = Товары.НайтиСтроки(ПоискПоТоварам);
			
		КонецЕсли;
		
		Для каждого СтрRETREC Из НайденныеСтрокиRETREC Цикл
			
			НоваяСтрока = Сообщение.Товары.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрRETREC);
			НоваяСтрока.СтавкаНДС1С = СтрRETREC.СтавкаНДС;
			НоваяСтрока.НомерГТД1С 	= СтрRETREC.НомерГТД;
			НоваяСтрока.Страна1С 	= СтрRETREC.Страна;
			НоваяСтрока.Статус 		= Стр.Статус;  
			
			НоваяСтрока.ТекстПересчета = ТекстПересчета_КонтурEDI(
			НоваяСтрока.ЕдиницаИзмерения, 
			НоваяСтрока.КодЕдиницыИзмеренияEDI, 
			НоваяСтрока.КоэффициентEDIВ1С);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если НЕ РезультатСравнения.ЕстьРасхождения Тогда
		Сообщение.Статус = "Подтвержден";
	ИначеЕсли СчетчикОтклоненных = ТаблицаСравнения.Количество() Тогда
		Сообщение.Статус = "Отклонен";
	Иначе
		Сообщение.Статус = "Уточнен"; 
	КонецЕсли;
	
	ЗаполнитьПредставлениеЕдиницыИзмеренияВТаблицеТоваров(Сообщение.Товары);
	
КонецФункции

Функция ПолучитьИсходныйДокументОтгрузкиКорректировкиРеализации(КорректировкаРеализации) Экспорт
	
	ТипИсходящийКСФ = ПолучитьТипЗначенияОбъекта("ИсходящийКСФ");
	
	Если КорректировкаРеализации = Неопределено
		ИЛИ Не ЗначениеЗаполнено(ТипИсходящийКСФ) 
		ИЛИ Не ТипЗнч(КорректировкаРеализации) = Тип(ТипИсходящийКСФ) Тогда
		
		Возврат КорректировкаРеализации;
		
	КонецЕсли;
	
	ДокументОснование = ПолучитьРеквизитДокументаДляСообщения(КорректировкаРеализации, "ДокументОснованиеКорректировки");
	
	Если ДокументОснование = Неопределено Или ДокументОснование = КорректировкаРеализации Тогда
		Возврат Неопределено;
	Иначе
		Возврат ПолучитьИсходныйДокументОтгрузкиКорректировкиРеализации(ДокументОснование);
	КонецЕсли;
	
КонецФункции

Функция ПолучитьКорректировкуРеализацииСчетаФактуры(СчетФактура) Экспорт
	
	КорректировкаРеализации = Неопределено;
	
	ТипИсходящийКСФ = ПолучитьТипЗначенияОбъекта("ИсходящийКСФ");
	
	ДокументОснование = ПолучитьРеквизитДокументаДляСообщения(СчетФактура, "ДокументОснованиеСчетаФактуры"); 
	
	Если (ЗначениеЗаполнено(ТипИсходящийКСФ) И ТипЗнч(ДокументОснование) = Тип(ТипИсходящийКСФ)) ИЛИ ЭтоВозвратТоваровОтКлиентаУФ_УТ(ДокументОснование) Тогда
		
		КорректировкаРеализации = ДокументОснование; 
		
	КонецЕсли;
	
	Возврат КорректировкаРеализации;
	
КонецФункции

Функция РеквизитДокумента_СчетФактураПоДокументуОснованию(ДокументОснование, Сообщение = Неопределено)
	
	СчетФактура = Неопределено;
	
	ИмяВМетаданных = Истина;	
	ТипДокументаСчетФактура = ПолучитьТипЗначенияОбъекта("ТипДокументаСчетФактура", , ИмяВМетаданных);
	
	Запрос = Новый Запрос;
	
	ЕстьРеквизитДокументОснование = ЕстьНеобходимыеМетаданные("Документы." + ТипДокументаСчетФактура + ".Реквизиты.ДокументОснование");	
	ЕстьТабЧастьДокументыОснования = ЕстьНеобходимыеМетаданные("Документы." + ТипДокументаСчетФактура + ".ТабличныеЧасти.ДокументыОснования");	
	
	Если ЕстьРеквизитДокументОснование И ЕстьТабЧастьДокументыОснования Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетФактураВыданный.Ссылка КАК Ссылка,
		|	1 КАК Приоритет,
		|	СчетФактураВыданный.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|ГДЕ
		|	СчетФактураВыданный.ДокументОснование = &ДокументОснование
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СчетФактураВыданныйДокументыОснования.Ссылка,
		|	2,
		|	СчетФактураВыданныйДокументыОснования.Ссылка.ПометкаУдаления
		|ИЗ
		|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
		|ГДЕ
		|	СчетФактураВыданныйДокументыОснования.ДокументОснование = &ДокументОснование
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПометкаУдаления,
		|	Приоритет";
		
	ИначеЕсли ЕстьРеквизитДокументОснование Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетФактура.Ссылка
		|ИЗ
		|	Документ.СчетФактураВыданный КАК СчетФактура
		|ГДЕ
		|	СчетФактура.ДокументОснование = &ДокументОснование";
		
	ИначеЕсли ЕстьТабЧастьДокументыОснования Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетФактураДокументыОснования.Ссылка
		|ИЗ
		|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураДокументыОснования
		|ГДЕ
		|	СчетФактураДокументыОснования.ДокументОснование = &ДокументОснование";
		
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.СчетФактураВыданный", "Документ." + ТипДокументаСчетФактура);
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		СчетФактура = Выборка.Ссылка;
	КонецЕсли;
		
	Возврат СчетФактура;
	
КонецФункции

Функция РеквизитДокумента_ДокументОснованиеПоСчетуФактуре(СчетФактура, Сообщение = Неопределено)
	
	ДокументОснование = Неопределено;
	
	ИмяВМетаданных = Истина;	
	ТипДокументаСчетФактура = ПолучитьТипЗначенияОбъекта("ТипДокументаСчетФактура", , ИмяВМетаданных);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СчетФактура", СчетФактура);
	
	Если ЕстьНеобходимыеМетаданные("Документы." + ТипДокументаСчетФактура + ".Реквизиты.ДокументОснование") Тогда
		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетФактура.ДокументОснование
		|ИЗ
		|	Документ.СчетФактураВыданный КАК СчетФактура
		|ГДЕ
		|	СчетФактура.Ссылка = &СчетФактура";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.СчетФактураВыданный", "Документ." + ТипДокументаСчетФактура);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ДокументОснование = Выборка.ДокументОснование;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокументОснование) И ЕстьНеобходимыеМетаданные("Документы." + ТипДокументаСчетФактура + ".ТабличныеЧасти.ДокументыОснования") Тогда
		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетФактураДокументыОснования.ДокументОснование
		|ИЗ
		|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураДокументыОснования
		|ГДЕ
		|	СчетФактураДокументыОснования.Ссылка = &СчетФактура";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.СчетФактураВыданный", "Документ." + ТипДокументаСчетФактура);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ДокументОснование = Выборка.ДокументОснование;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ДокументОснование;
	
КонецФункции

Процедура ЗаполнитьСуммыУвеличениеУменьшениеВCOINVOIC(Сообщение)

	СуммаУвеличение 	= Сообщение.Товары.Итог("СуммаСНДСУвеличение");
	СуммаУменьшение 	= Сообщение.Товары.Итог("СуммаСНДСУменьшение");
	СуммаНДСУвеличение 	= Сообщение.Товары.Итог("СуммаНДСУвеличение");
	СуммаНДСУменьшение  = Сообщение.Товары.Итог("СуммаНДСУменьшение");
			
	Сообщение.СуммаВсегоУвеличение			= СуммаУвеличение;
	Сообщение.СуммаВсегоУменьшение			= СуммаУменьшение;
	Сообщение.СуммаВсегоБезНДСУвеличение	= СуммаУвеличение - СуммаНДСУвеличение;
	Сообщение.СуммаВсегоБезНДСУменьшение	= СуммаУменьшение - СуммаНДСУменьшение;
	Сообщение.СуммаВсегоНДСУвеличение		= СуммаНДСУвеличение;
	Сообщение.СуммаВсегоНДСУменьшение		= СуммаНДСУменьшение; 	
	
КонецПроцедуры

// COINVOIC, iINVOIC, iCOINVOIC
Процедура ПодготовитьИсправительныйКорректировочныйСчетФактуру(ДокументСсылка, Сообщение, Параметры = Неопределено)
	
	Если ИспользоватьМаппингМетаданных Тогда
		Маппинг_ЗаполнитьИсправительныйКорректировочныйСчетФактуру(ДокументСсылка, Сообщение);
		Возврат;
	КонецЕсли;
	
	ТипДокументаСчетФактура = ПолучитьТипЗначенияОбъекта("ТипДокументаСчетФактура");
	
	Если ЗначениеЗаполнено(ТипДокументаСчетФактура) И ТипЗнч(ДокументСсылка) = Тип(ТипДокументаСчетФактура) Тогда 
		КорректировкаРеализации = ПолучитьКорректировкуРеализацииСчетаФактуры(ДокументСсылка);
		СчетФактураКорректировки = ДокументСсылка;
	Иначе
		КорректировкаРеализации = ДокументСсылка;
		СчетФактураКорректировки = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "СчетФактураДокументаОснования");
	КонецЕсли;
	
	ОсновнойСчетФактура = НайтиСвязанныйДокументПоТипуСообщения(КорректировкаРеализации, "INVOIC");
	
	Если ЭтоВозвратТоваровОтКлиентаУФ_УТ(КорректировкаРеализации) Тогда 
		ИсправляемыйДокументРеализации = ПолучитьРеквизитДокументаДляСообщения(КорректировкаРеализации,"ДокументОснованиеКорректировки");
		
		ОсновнойСчетФактура = НайтиСвязанныйДокументПоТипуСообщения(ИсправляемыйДокументРеализации, "INVOIC");	
		ИсправляемыйСчетФактура = ПолучитьРеквизитДокументаДляСообщения(ИсправляемыйДокументРеализации, "СчетФактураДокументаОснования");
	Иначе	
		Если ЗначениеЗаполнено(СчетФактураКорректировки) Тогда
			ИсправляемыйСчетФактура = ПолучитьРеквизитДокументаДляСообщения(СчетФактураКорректировки, "ИсправляемыйСчетФактура");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИсправляемыйСчетФактура) Тогда
			ИсправляемыйДокументРеализации = ПолучитьРеквизитДокументаДляСообщения(ИсправляемыйСчетФактура, "ДокументОснованиеСчетаФактуры");
			
			Если ЭтоВозвратТоваровОтКлиентаУФ_УТ(ИсправляемыйДокументРеализации) Тогда
				ИсправляемыйДокументРеализации = ПолучитьРеквизитДокументаДляСообщения(ИсправляемыйДокументРеализации, "ДокументОснованиеВозврата");				
			КонецЕсли;
			
		Иначе
			ИсправляемыйДокументРеализации = ПолучитьРеквизитДокументаДляСообщения(КорректировкаРеализации, "ДокументОснованиеКорректировки");
			ИсправляемыйСчетФактура = ПолучитьРеквизитДокументаДляСообщения(ИсправляемыйДокументРеализации, "СчетФактураДокументаОснования");
		КонецЕсли; 
	КонецЕсли;
	
	ПереопределитьСтруктуруСообщенияПриИзмененииДанныхСФ1С(Сообщение, СчетФактураКорректировки, Параметры);
	
	Сообщение.Исправление = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "ИсправлениеСчетаФактуры");
	
	ДокументПоиска = ?(ЭтоВозвратТоваровОтКлиентаУФ_УТ(КорректировкаРеализации),ИсправляемыйДокументРеализации,КорректировкаРеализации);
	
	Сообщение.Документ1С 	= ДокументСсылка;
	Сообщение.Заказ1С		= НайтиСвязанныйДокументПоТипуСообщения(ДокументПоиска, "ORDERS");
	Сообщение.Накладная1С	= НайтиСвязанныйДокументПоТипуСообщения(ДокументПоиска, "DESADV");
	Сообщение.Приемка1С		= НайтиСвязанныйДокументПоТипуСообщения(ДокументПоиска, "RECADV"); 
	
	
	Сообщение.СчетФактура1С	= ОсновнойСчетФактура;
	
    ТипИсходящийКСФ = ПолучитьТипЗначенияОбъекта("ИсходящийКСФ");
	
	Если ЗначениеЗаполнено(ТипИсходящийКСФ) И ТипЗнч(ИсправляемыйДокументРеализации) = Тип(ТипИсходящийКСФ) Тогда
		
		Сообщение.ИсправляемыйДокументРеализации1С = ИсправляемыйДокументРеализации;
		Сообщение.ИсправляемыйСчетФактура1С = ИсправляемыйСчетФактура;
		
	ИначеЕсли ИсправляемыйДокументРеализации = Сообщение.Накладная1С Тогда
		
		Сообщение.ИсправляемыйДокументРеализации1С = Сообщение.Накладная1С;
		Сообщение.ИсправляемыйСчетФактура1С = ПолучитьРеквизитДокументаДляСообщения(Сообщение.Накладная1С, "СчетФактураДокументаОснования");
		
	Иначе
		
		ТекстКомментария = "Не удалось определить исправляемые документы для сообщения - " + Сообщение.ТипСообщения;
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстКомментария, ДокументСсылка); 
		ВызватьИсключение ТекстКомментария;
		
	КонецЕсли;
	
	Организация = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Организация");
	Сообщение.Отправитель1С = Организация;
	Сообщение.Продавец1С 	= Организация;
	
	Контрагент = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Контрагент");
	РезультатОпределения = ОпределитьПартнераИКонтрагентаДляИсходящегоСообщения(Контрагент, Сообщение);
	
	Сообщение.Партнер = РезультатОпределения.Партнер;
	Сообщение.Получатель1С = РезультатОпределения.Партнер;
	Сообщение.Покупатель1С = РезультатОпределения.Контрагент; 
	
	Сообщение.Грузоотправитель1С = ПолучитьРеквизитДокументаДляСообщения(КорректировкаРеализации, "Грузоотправитель");
	Сообщение.Грузополучатель1С = ПолучитьРеквизитДокументаДляСообщения(КорректировкаРеализации, "Грузополучатель");
	
	Сообщение.Валюта1С			= ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Валюта");
	Сообщение.Договор			= ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Договор");
	Сообщение.Контракт1С		= Сообщение.Договор; //это поле будет записано в contractIdentificator    	
 	
	Сообщение.ДатаПоставки	= ОпределитьДатуПоставки(Сообщение); //опирается на знание партнера сообщения
	
	Если Сообщение.ТипСообщения = "INVOIC" 
		И Не ЗначениеЗаполнено(Сообщение.ДатаПоставкиФактическая) Тогда
		                                   
		Сообщение.ДатаПоставкиФактическая = ПолучитьРеквизитДокументаДляСообщения(Сообщение.Накладная1С, "ФактическаяДатаПоставки", Сообщение);
		
	КонецЕсли;
	
	Товары = ПолучитьТоварыДокументаДляСообщения(КорректировкаРеализации,Истина,?(Сообщение.ТипСообщения = "INVOIC","ПодготовкаИсправительногоСчетаФактурыКОтправке","ПодготовкаКорректировочногоСчетаФактурыКОтправке"),,Сообщение);
		
	Если Сообщение.ТипСообщения = "COINVOIC" Тогда
		
		ПодготовитьТоварыКорректировочныйСчетФактура(Сообщение, Товары);    
		
		ЗаполнитьСуммыУвеличениеУменьшениеВCOINVOIC(Сообщение);
		
	Иначе
		
		ПодготовитьТоварыИсправительныйСчетФактура(Сообщение, Товары);
		ЗаполнитьТипыМаркируемойПродукции(Сообщение);
		
	КонецЕсли;
	
	ЗаполнитьПредставлениеЕдиницыИзмеренияВТаблицеТоваров(Сообщение.Товары);
	
	ДополнитьСообщениеСохраненнымиДанными(Сообщение, Параметры);

КонецПроцедуры

Процедура ПодготовитьТоварыИсправительныйСчетФактура(Сообщение, Товары)
	
	НомерСтроки = 0;
	
	Сообщение.СуммаТоваровНДС			= 0;
	Сообщение.СуммаТоваровВсего			= 0;
	Сообщение.СуммаТоваровВсегоБезНДС	= 0;
	
	Для Каждого Стр Из Товары Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		НоваяСтрока = Сообщение.Товары.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Стр);
		
		Если ЗначениеЗаполнено(Стр.УИД_СтрокиПредыдущегоСообщения) Тогда
			НоваяСтрока.УИД_СтрокиТовара = Стр.УИД_СтрокиПредыдущегоСообщения;
		Иначе
			НоваяСтрока.УИД_СтрокиТовара = УИД_СтрокиТовара_КонтурEDI(НомерСтроки, Сообщение.ТипСообщения);
		КонецЕсли;
		
		НоваяСтрока.СтавкаНДС1С	= Стр.СтавкаНДС;
		
		// возвратной тары не видно в корректрировке реализации, ее не проверяем
		Сообщение.СуммаТоваровНДС			= Сообщение.СуммаТоваровНДС			+ Стр.СуммаНДС;
		Сообщение.СуммаТоваровВсего			= Сообщение.СуммаТоваровВсего		+ Стр.СуммаСНДС;
		Сообщение.СуммаТоваровВсегоБезНДС	= Сообщение.СуммаТоваровВсегоБезНДС	+ Стр.СуммаБезНДС;
		
		НоваяСтрока.НомерГТД1С		= Стр.НомерГТД;
		НоваяСтрока.Страна1С		= Стр.Страна; 
		
		НоваяСтрока.ТекстПересчета = ТекстПересчета_КонтурEDI(
		НоваяСтрока.ЕдиницаИзмерения, 
		НоваяСтрока.КодЕдиницыИзмеренияEDI, 
		НоваяСтрока.КоэффициентEDIВ1С);
		
	КонецЦикла;

КонецПроцедуры

Функция СообщениеСодержитСвернутыеСтроки(Сообщение, ОтборСтрок = Неопределено)
		
	Если Не ЗначениеЗаполнено(Сообщение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Содержит = Ложь;
	
	Если ОтборСтрок = Неопределено Тогда
		СтрокиТоваров = Сообщение.Товары;
	Иначе
		СтрокиТоваров = Сообщение.Товары.НайтиСтроки(ОтборСтрок);	
	КонецЕсли;	

	Для Каждого СтрТовары Из СтрокиТоваров Цикл

		ИсходныеСтрокиТовара = СтрТовары.ИсходныеСтрокиТовара;
		
		Если ТипЗнч(ИсходныеСтрокиТовара) = Тип("Массив") И ИсходныеСтрокиТовара.Количество() > 1 Тогда
			
			Содержит = Истина;
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Содержит;
	
КонецФункции

Процедура ПодготовитьТоварыКорректировочныйСчетФактура(Сообщение, Товары)
    
	СписокСвойствПартнера = ПолучитьСписокСвойствEDI(
	"СворачиватьТаблицуТоваровДляСообщения", 
	Сообщение.Партнер);

	ПредыдущееСообщение = ПолучитьПредыдущееСообщение_КонтурEDI(Сообщение);
	
	СворачиватьТовары = СписокСвойствПартнера.СворачиватьТаблицуТоваровДляСообщения;

	КолонкиАналитики = 
	"GTIN,КодТовараПокупателя,КодЕдиницыИзмеренияEDI,КодТовараВнутренний," + 
	"ЦенаБезНДС,ЦенаБезНДСДоКорректировки,ЦенаСНДС,ЦенаСНДСДоКорректировки,СтавкаНДС,СтавкаНДСДоКорректировки";
	
	КолонкиРесурсов = "Количество,КоличествоДоКорректировки,СуммаБезНДС,СуммаБезНДСДоКорректировки,СуммаСНДС,СуммаСНДСДоКорректировки,СуммаНДС,СуммаНДСДоКорректировки";
	
	АналитикаТоваровEDI = Товары.Скопировать(, КолонкиАналитики + "," + КолонкиРесурсов);
	АналитикаТоваровEDI.Свернуть(КолонкиАналитики, КолонкиРесурсов);
	
	НомерСтроки = 0;
	
	ПоискТоваров = Новый Структура(КолонкиАналитики);
	
	СписокИменКоличественныхПолей = "КоличествоДо,КоличествоПосле,КоличествоУвеличение,КоличествоУменьшение";
	
	ТипыКоличественныхПолей = Новый Структура(СписокИменКоличественныхПолей);
	
	Для Каждого КлючЗначение Из ТипыКоличественныхПолей Цикл
		
		ИмяПоля = КлючЗначение.Ключ;
		
		ТипыКоличественныхПолей[ИмяПоля] = Сообщение.Товары.Колонки[ИмяПоля].ТипЗначения;
				
	КонецЦикла;
		
	//... увеличение разрядности для точного подсчета количества
	ТипизироватьКолонкиВТаблицеЗначений(Сообщение.Товары, СписокИменКоличественныхПолей, ОписаниеТипаЧисло_КонтурEDI());
	
	Для Каждого СтрАналитика Из АналитикаТоваровEDI Цикл
		
		ЕстьКорректировкаПоАналитике = ЕстьКорректировкаСтрокиСчетаФактуры_КонтурEDI(СтрАналитика);
		
		Если НЕ ЕстьКорректировкаПоАналитике Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ПоискТоваров, СтрАналитика);
		
		ТоварыПоАналитике = Товары.НайтиСтроки(ПоискТоваров);
		
		Для Каждого Стр Из ТоварыПоАналитике Цикл
			
			СтрокаПредыдущегоСообщенияСвёрнута = СообщениеСодержитСвернутыеСтроки(ПредыдущееСообщение, Новый Структура("УИД_СтрокиТовара", Стр.УИД_СтрокиПредыдущегоСообщения)) = Истина;
			
			ЕстьКорректировка = СворачиватьТовары И СтрокаПредыдущегоСообщенияСвёрнута ИЛИ ЕстьКорректировкаСтрокиСчетаФактуры_КонтурEDI(Стр);
			
			Если НЕ ЕстьКорректировка Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = Неопределено;
			
			Если ЗначениеЗаполнено(Стр.УИД_СтрокиПредыдущегоСообщения) Тогда
				
				СтруктураПоиска = Новый Структура;
				СтруктураПоиска.Вставить("УИД_СтрокиПредыдущегоСообщения", Стр.УИД_СтрокиПредыдущегоСообщения);
				СтруктураПоиска.Вставить("ЦенаБезНДСДо", Стр.ЦенаБезНДСДоКорректировки);
				СтруктураПоиска.Вставить("ЦенаСНДСДо", Стр.ЦенаСНДСДоКорректировки);
				СтруктураПоиска.Вставить("ЦенаБезНДСПосле", Стр.ЦенаБезНДС);
				СтруктураПоиска.Вставить("ЦенаСНДСПосле", Стр.ЦенаСНДС);
				СтруктураПоиска.Вставить("СтавкаНДСДо1С", Стр.СтавкаНДСДоКорректировки);
				СтруктураПоиска.Вставить("СтавкаНДСПосле1С", Стр.СтавкаНДС);
				
				Если НЕ СворачиватьТовары Тогда
					СтруктураПоиска.Вставить("УИД_СтрокиДокумента", Стр.УИД_СтрокиДокумента);	
				КонецЕсли;
				
				ПоискСтроки = Сообщение.Товары.НайтиСтроки(СтруктураПоиска);
				
				Если ПоискСтроки.Количество() > 0 Тогда
					НоваяСтрока = ПоискСтроки[0];
				КонецЕсли;
				
			КонецЕсли;
			
			Если НоваяСтрока = Неопределено Тогда
				
				НомерСтроки = НомерСтроки + 1;
				
				НоваяСтрока = Сообщение.Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,Стр);
				
				ЗаполнитьКорректировочноеПолеСФ(НоваяСтрока, "ЦенаБезНДС", Стр, Ложь);
				ЗаполнитьКорректировочноеПолеСФ(НоваяСтрока, "ЦенаСНДС", Стр, Ложь);
				
				Если ЗначениеЗаполнено(Стр.УИД_СтрокиПредыдущегоСообщения) Тогда
					НоваяСтрока.УИД_СтрокиТовара = Стр.УИД_СтрокиПредыдущегоСообщения;
				Иначе
					НоваяСтрока.УИД_СтрокиТовара = УИД_СтрокиТовара_КонтурEDI(НомерСтроки, Сообщение.ТипСообщения);					
				КонецЕсли;	
				
				НоваяСтрока.ТекстПересчета = ТекстПересчета_КонтурEDI(
				НоваяСтрока.ЕдиницаИзмерения, 
				НоваяСтрока.КодЕдиницыИзмеренияEDI, 
				НоваяСтрока.КоэффициентEDIВ1С);
				
			КонецЕсли;
			
			ИсходнаяСтрока = ОсновныеПоляСтрокиТоваровСообщения(Стр);	
			НоваяСтрока.ИсходныеСтрокиТовара.Добавить(ИсходнаяСтрока);
			
			Если ЗначениеЗаполнено(Стр.УИД_СтрокиПредыдущегоСообщения) Тогда
				НоваяСтрока.УИД_СтрокиТовара = Стр.УИД_СтрокиПредыдущегоСообщения;
			Иначе
				НоваяСтрока.УИД_СтрокиТовара = УИД_СтрокиТовара_КонтурEDI(НомерСтроки, Сообщение.ТипСообщения);
			КонецЕсли;	
			
			ЗаполнитьКорректировочноеПолеСФ(НоваяСтрока, "Количество", Стр);
			
			ЗаполнитьКорректировочноеПолеСФ(НоваяСтрока, "СуммаБезНДС", Стр);
			ЗаполнитьКорректировочноеПолеСФ(НоваяСтрока, "СуммаНДС", Стр);
			ЗаполнитьКорректировочноеПолеСФ(НоваяСтрока, "СуммаСНДС", Стр); 		
			
			НоваяСтрока.СтавкаНДСДо1С	 = Стр.СтавкаНДСДоКорректировки;
			НоваяСтрока.СтавкаНДСПосле1С = Стр.СтавкаНДС;
			
			Если НЕ ЗначениеЗаполнено(НоваяСтрока.СтавкаНДСПосле1С) Тогда
				Если НоваяСтрока.КоличествоПосле = 0 Тогда
					НоваяСтрока.СтавкаНДСПосле1С  = НоваяСтрока.СтавкаНДСДо1С;
				КонецЕсли;
			КонецЕсли;
			
			НоваяСтрока.НомерГТД1С		= Стр.НомерГТД;
			НоваяСтрока.Страна1С		= Стр.Страна;
			
		КонецЦикла;
		
	КонецЦикла;
	
	//... восстановление разрядности Количественных полей
	Для Каждого КлючЗначение Из ТипыКоличественныхПолей Цикл
		
		ИмяПоля = КлючЗначение.Ключ;
		ТипЗначенияПоля = КлючЗначение.Значение;
		
		ТипизироватьКолонкиВТаблицеЗначений(Сообщение.Товары, ИмяПоля, ТипЗначенияПоля);
				
	КонецЦикла;
	
КонецПроцедуры

Функция ЕстьКорректировкаСтрокиСчетаФактуры_КонтурEDI(Стр)
	
	НулеваяСтрока = (Стр.КоличествоДоКорректировки = 0 И Стр.Количество = 0);
	
	Если НЕ НулеваяСтрока Тогда
		
		КоличествоРавно = (Стр.КоличествоДоКорректировки = Стр.Количество);
		СуммаНДСРавно = (Стр.СуммаНДСДоКорректировки = Стр.СуммаНДС);
		СуммаСНДСРавно = (Стр.СуммаСНДСДоКорректировки = Стр.СуммаСНДС);
		
		ЦенаБезНДСРавно = Истина;
		Если ПеременнаяСодержитСвойство(Стр, "ЦенаБезНДСДоКорректировки") Тогда
			ЦенаБезНДСРавно = (Стр.ЦенаБезНДСДоКорректировки = Стр.ЦенаБезНДС);
		КонецЕсли;
		
		ЦенаСНДСРавно = Истина;
		Если ПеременнаяСодержитСвойство(Стр, "ЦенаСНДСДоКорректировки") Тогда
			ЦенаСНДСРавно = (Стр.ЦенаСНДСДоКорректировки = Стр.ЦенаСНДС);
		КонецЕсли;  		
		
		ЕстьКорректировкаСтрокиСчетаФактуры = НЕ( 
		КоличествоРавно 
		И СуммаНДСРавно 
		И СуммаСНДСРавно 
		И ЦенаБезНДСРавно 
		И ЦенаСНДСРавно);
		
	Иначе
		
		ЕстьКорректировкаСтрокиСчетаФактуры = Ложь;
		
	КонецЕсли;
		
	Возврат ЕстьКорректировкаСтрокиСчетаФактуры;

КонецФункции

Процедура ЗаполнитьКорректировочноеПолеСФ(СтрокаСообщения, ИмяПоля, СтрокаДанных, СуммироватьЗначенияПолей = Истина)
	
	Если НЕ СуммироватьЗначенияПолей Тогда
		
		СтрокаСообщения[ИмяПоля + "До"] = 0;
		СтрокаСообщения[ИмяПоля + "После"] = 0;
		СтрокаСообщения[ИмяПоля + "Увеличение"] = 0;
		СтрокаСообщения[ИмяПоля + "Уменьшение"] = 0;
		
	КонецЕсли;
	
	ЗначениеДо = СтрокаДанных[ИмяПоля+"ДоКорректировки"];
	ЗначениеПосле = СтрокаДанных[ИмяПоля];
	
	СтрокаСообщения[ИмяПоля + "До"] = СтрокаСообщения[ИмяПоля + "До"] + ЗначениеДо;
	СтрокаСообщения[ИмяПоля + "После"] = СтрокаСообщения[ИмяПоля + "После"] + ЗначениеПосле;
	
	Если ЗначениеДо < ЗначениеПосле Тогда
		
		СтрокаСообщения[ИмяПоля + "Увеличение"] = СтрокаСообщения[ИмяПоля + "Увеличение"] + (ЗначениеПосле - ЗначениеДо);
		
	ИначеЕсли ЗначениеДо > ЗначениеПосле Тогда
		
		СтрокаСообщения[ИмяПоля + "Уменьшение"] = СтрокаСообщения[ИмяПоля + "Уменьшение"] + (ЗначениеДо - ЗначениеПосле);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПереопределитьСтруктуруСообщенияПриИзмененииДанныхСФ1С(Сообщение, СчетФактура, ПараметрыПодготовкиСообщения = Неопределено)
	
	Если Не ЗначениеЗаполнено(СчетФактура) Тогда
		Возврат;
	КонецЕсли;
	
	ПравильныйТипСообщения = ТипИсходящегоСообщенияПоСчетуФактуре(СчетФактура);
	
	Если ПравильныйТипСообщения = Неопределено 
			ИЛИ ПравильныйТипСообщения = Сообщение.ТипСообщения Тогда
		Возврат;
	КонецЕсли;
	
	ПравильнаяСтруктураСообщения = ПолучитьСтруктуруСообщения(ПравильныйТипСообщения, Сообщение.Направление);
	ПравильнаяСтруктураСообщения.ДокументСсылка = Сообщение.ДокументСсылка;
	
	Если ПеременнаяСодержитСвойство(Сообщение, "ПереотправляемоеСообщениеСсылка",,Истина) Тогда
		ПравильнаяСтруктураСообщения.Вставить("ПереотправляемоеСообщениеСсылка", Сообщение.ПереотправляемоеСообщениеСсылка);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыПодготовкиСообщения) 
		И ПеременнаяСодержитСвойство(ПараметрыПодготовкиСообщения, "СообщениеСсылка",,Истина)
		И ПараметрыПодготовкиСообщения.СообщениеСсылка.Документ = Сообщение.ДокументСсылка Тогда
		ПравильнаяСтруктураСообщения.Вставить("СообщениеСсылка", ПараметрыПодготовкиСообщения.СообщениеСсылка);
	КонецЕсли;
	
	Сообщение = ПравильнаяСтруктураСообщения;
	
КонецПроцедуры

Функция ТипИсходящегоСообщенияПоСчетуФактуре(СчетФактура)
	
	ЭтоКорректировка = ПолучитьРеквизитДокументаДляСообщения(СчетФактура, "Корректировочный");
	
	Если ЭтоКорректировка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЭтоКорректировка Тогда
		Возврат "COINVOIC";
	Иначе
		Возврат "INVOIC";
	КонецЕсли;
	
КонецФункции

// IFTMBC
Функция ПодготовитьОтветНаЗаказПеревозки(ДокументСсылка, Сообщение, Параметры)
	
	СообщениеСсылка = Неопределено;
	ПереотправляемоеСообщениеСсылка = Неопределено;
	СообщениеЗаказПеревозки = Неопределено;
	
	Если ПроверитьСвойствоПоляВСтруктуре(Параметры, "ПереотправляемоеСообщениеСсылка", ПереотправляемоеСообщениеСсылка) Тогда
		СообщениеЗаказПеревозки = ПрочитатьСообщение(ПереотправляемоеСообщениеСсылка);
	ИначеЕсли ПроверитьСвойствоПоляВСтруктуре(Параметры, "СообщениеСсылка", СообщениеСсылка) Тогда
		СообщениеЗаказПеревозки = ПрочитатьСообщение(СообщениеСсылка);
	КонецЕсли;
		
	Если НЕ СообщениеЗаказПеревозки = Неопределено Тогда
		
		Сообщение = СообщениеЗаказПеревозки;
		
		Если Сообщение.ТипСообщения = "IFTMBF" Тогда
			КонвертироватьСообщениеEDIв1С(Сообщение); 
			ИнвертироватьСтороныТранспортаСообщения(Сообщение);
		КонецЕсли;
		
		// Для ВнешнегоХранилища
		Если ВнешнееХранилище Тогда
			Сообщение.Отправитель1С = ЗначениеИзСтрокиВнутр(Сообщение.Отправитель1С);
		КонецЕсли;
		
		Сообщение.ТипСообщения		= "IFTMBC";
		Сообщение.Направление		= "Исходящее";
		
		Сообщение.ЗаказПеревозкиEDI.Номер = Сообщение.ДокументEDI.Номер;
		Сообщение.ЗаказПеревозкиEDI.Дата = Сообщение.ДокументEDI.Дата;
		
		Сообщение.ДокументEDI.Номер = Формат(ТекущаяДата(), "ДФ=ггггММддЧЧммсс"); 
		Сообщение.ДокументEDI.Дата 	= ТекущаяДата();
		
		Если Параметры.Свойство("ЭтоОтклонениеЗаказа") Тогда
			Сообщение.Статус = "Rejected";
		Иначе
			Сообщение.Статус = "Original";
		КонецЕсли;
		
		Если Сообщение.Свойство("Архив") Тогда
			Сообщение.Архив = Ложь;
		КонецЕсли;
		
		Сообщение.СообщениеСсылка = Неопределено;//это будет новое сообщение
		
		Если ЗначениеЗаполнено(ПереотправляемоеСообщениеСсылка) Тогда
			Сообщение.Вставить("ПереотправляемоеСообщениеСсылка", ПереотправляемоеСообщениеСсылка);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Сообщение;
	
КонецФункции

// Меняем местами отправителя с получателем, чтобы отправить ответное сообщение
Процедура ИнвертироватьСтороныТранспортаСообщения(Сообщение)
	
	ОтправительEDI				= Сообщение.ОтправительEDI;
	Отправитель1С	    		= Сообщение.Отправитель1С;
	
	Сообщение.ОтправительEDI	= Сообщение.ПолучательEDI;
	Сообщение.Отправитель1С		= Сообщение.Получатель1С;
	
	Сообщение.ПолучательEDI		= ОтправительEDI;
	Сообщение.Получатель1С		= Отправитель1С;
	
КонецПроцедуры

 //ускорим заполнение поля КодЕдиницыИзмерения1С
 Процедура ЗаполнитьПредставлениеЕдиницыИзмеренияВТаблицеТоваров(ТаблицаТоваров) Экспорт //т.к. возможен вызов из ПМ
	 
	СтандартнаяОбработкаEDI = Истина;
	ОбработкаСобытияПодключаемогоМодуля("ЗаполнитьПредставлениеЕдиницыИзмеренияВТаблицеТоваров", 
										СтандартнаяОбработкаEDI,
										Новый Структура("ТаблицаТоваров",ТаблицаТоваров)
										);
										
	Если СтандартнаяОбработкаEDI = Ложь Тогда 
		Возврат;
	КонецЕсли;
	
	//TODO продумать перенос в основной запрос по товарам. UPD: будет решаться в рамках 3-й части конструктора.
	Запрос = Новый Запрос;
	
	Если ИмяКонфигурации1С = "БП" Или ИмяКонфигурации1С = "УФ_БП" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕдиницыИзмерения.Ссылка,
		|	ЕдиницыИзмерения.Наименование КАК Наименование
		|ИЗ
		|	Справочник.КлассификаторЕдиницИзмерения КАК ЕдиницыИзмерения
		|ГДЕ
		|	ЕдиницыИзмерения.Ссылка В(&МассивЕдиниц)";
		
		Если ЕстьНеобходимыеМетаданные("Справочники.УНИ_ЕдиницыИзмерений") Тогда
			
			Запрос.Текст = Запрос.Текст + "
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	УНИ_ЕдиницыИзмерений.Ссылка,
			|	УНИ_ЕдиницыИзмерений.Наименование
			|ИЗ
			|	Справочник.УНИ_ЕдиницыИзмерений КАК УНИ_ЕдиницыИзмерений
			|ГДЕ
			|	УНИ_ЕдиницыИзмерений.Ссылка В(&МассивЕдиниц)";
			
		КонецЕсли;
		
		Если ЕстьНеобходимыеМетаданные("Справочники.МОЛ_ЕдиницыИзмерений") Тогда
			
			Запрос.Текст = Запрос.Текст + "
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	МОЛ_ЕдиницыИзмерений.Ссылка,
			|	МОЛ_ЕдиницыИзмерений.Наименование
			|ИЗ
			|	Справочник.МОЛ_ЕдиницыИзмерений КАК МОЛ_ЕдиницыИзмерений
			|ГДЕ
			|	МОЛ_ЕдиницыИзмерений.Ссылка В(&МассивЕдиниц)";
			
		КонецЕсли;
		
	ИначеЕсли ИмяКонфигурации1С = "УФ_УТ" и ОпределитьРелизКонфигурации() = "11.2" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕдиницыИзмерения.Ссылка,
		|	ЕдиницыИзмерения.Наименование КАК Наименование
		|ИЗ
		|	Справочник.УпаковкиЕдиницыИзмерения КАК ЕдиницыИзмерения
		|ГДЕ
		|	ЕдиницыИзмерения.Ссылка В(&МассивЕдиниц)";
		
	ИначеЕсли ИмяКонфигурации1С = "УФ_УТ" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕдиницыИзмерения.Ссылка,
		|	ЕдиницыИзмерения.Наименование КАК Наименование
		|ИЗ
		|	Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
		|ГДЕ
		|	ЕдиницыИзмерения.Ссылка В(&МассивЕдиниц)";
		
	ИначеЕсли ИмяКонфигурации1С = "УФ_УНФ" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕдиницыИзмерения.Ссылка КАК Ссылка,
		|	ЕдиницыИзмерения.Наименование КАК Наименование
		|ИЗ
		|	Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
		|ГДЕ
		|	ЕдиницыИзмерения.Ссылка В(&МассивЕдиниц)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КлассификаторЕдиницИзмерения.Ссылка,
		|	КлассификаторЕдиницИзмерения.Наименование
		|ИЗ
		|	Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения
		|ГДЕ
		|	КлассификаторЕдиницИзмерения.Ссылка В(&МассивЕдиниц)"; 	
		
	ИначеЕсли ИмяКонфигурации1С = "УФ_Розница" Тогда
		
		Запрос.Текст = 
        "ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |    ЕдиницыИзмерения.Ссылка, 
        |   ЕдиницыИзмерения.Наименование КАК Наименование
        |ИЗ
        |    Справочник.БазовыеЕдиницыИзмерения КАК ЕдиницыИзмерения
        |ГДЕ
        |    ЕдиницыИзмерения.Ссылка В(&МассивЕдиниц)";
	ИначеЕсли ИмяКонфигурации1С = "ДалионТРЕНД" ИЛИ ИмяКонфигурации1С = "УФ_ДалионТРЕНД"  Тогда
		
		Для Каждого Строка Из ТаблицаТоваров Цикл
			Строка.КодЕдиницыИзмерения1С = нрег(Строка.ЕдиницаИзмерения.Наименование);
		КонецЦикла;	
		
		Возврат;  
		
	Иначе
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕдиницыИзмерения.Ссылка,
		|	ЕдиницыИзмерения.ЕдиницаПоКлассификатору.Наименование КАК Наименование
		|ИЗ
		|	Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
		|ГДЕ
		|	ЕдиницыИзмерения.Ссылка В(&МассивЕдиниц)";
		
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("МассивЕдиниц",ТаблицаТоваров.ВыгрузитьКолонку("ЕдиницаИзмерения"));
	ВыбЕдиниц = Запрос.Выполнить().Выбрать();
	Пока ВыбЕдиниц.Следующий() Цикл
		Строки = ТаблицаТоваров.НайтиСтроки(Новый Структура("ЕдиницаИзмерения",ВыбЕдиниц.Ссылка));
		Для Каждого Строка Из Строки Цикл
			Строка.КодЕдиницыИзмерения1С = нрег(ВыбЕдиниц.Наименование);
		КонецЦикла;	
	КонецЦикла;	
	
КонецПроцедуры	

Функция КонечныйГрузополучательЗаполнен(Товары) Экспорт
	
	Если Товары.Колонки.Найти("КонечныйГрузополучательGLN") = Неопределено Тогда 
		Возврат Ложь;
	КонецЕсли;
		
	Заполнен = Ложь;
	Для Каждого СТрокаТоваров Из Товары Цикл
		Если ЗначениеЗаполнено(СтрокаТоваров.КонечныйГрузополучательGLN) Тогда 
			Заполнен = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Заполнен;
	
КонецФункции

Функция ПолучитьНоменклатуруСообщения_КонтурEDI(Сообщение) Экспорт
	
	НоменклатураСообщения = Новый Массив;
	СворачиваниеВозможно = Не Сообщение.Товары.Колонки.Найти("СписокНоменклатуры") = Неопределено;
	
	Для каждого СтрокаТовара Из Сообщение.Товары Цикл
		
		Если ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
			НоменклатураСообщения.Добавить(СтрокаТовара.Номенклатура);
			Продолжить;
		КонецЕсли;
		
		Если СворачиваниеВозможно И ЗначениеЗаполнено(СтрокаТовара.СписокНоменклатуры) Тогда
			
			Для каждого СвернутаяНоменклатура Из СтрокаТовара.СписокНоменклатуры Цикл
				НоменклатураСообщения.Добавить(СвернутаяНоменклатура.Значение);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат НоменклатураСообщения;
	
КонецФункции

// Заполняет произвольную колонку товаров данными из соответствия значений номенклатуры.
// Учитывает возможность сворачивания товаров и обрабатывает как простые строки, так и свёрнутые.
//
// Параметры:
//   ТоварыСообщения - ТаблицаЗначений - Таблица товаров сообщения, в которую нужно заполнить данные
//   ИмяКолонки - Строка - Имя колонки, которую нужно заполнить
//   СоответствиеЗначенийНоменклатуре - Соответствие - Соответствие, где ключ - номенклатура, значение - значение для заполнения колонки
//
Процедура ЗаполнитьПроизвольнуюКолонкуТоваровПоДаннымНоменклатуры(ТоварыСообщения, ИмяКолонки, СоответствиеЗначенийНоменклатуре)
	
	Если ТоварыСообщения.Колонки.Найти(ИмяКолонки) = Неопределено
		ИЛИ ТоварыСообщения.Колонки.Найти("Номенклатура") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СоответствиеЗначенийНоменклатуре.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СворачиваниеВозможно = Истина;
	
	Если ТоварыСообщения.Колонки.Найти("СписокНоменклатуры") = Неопределено Тогда
		СворачиваниеВозможно = Ложь;
	КонецЕсли;
	
	Для каждого СтрокаТовара Из ТоварыСообщения Цикл
		
		Если ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
			СтрокаТовара[ИмяКолонки] = СоответствиеЗначенийНоменклатуре[СтрокаТовара.Номенклатура];
			Продолжить;
		КонецЕсли;
		
		Если СворачиваниеВозможно И ЗначениеЗаполнено(СтрокаТовара.СписокНоменклатуры) Тогда
			Для каждого СвернутаяНоменклатура Из СтрокаТовара.СписокНоменклатуры Цикл
				СтрокаТовара[ИмяКолонки] = СоответствиеЗначенийНоменклатуре[СвернутаяНоменклатура.Значение];
				Если ЗначениеЗаполнено(СтрокаТовара[ИмяКолонки]) Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

