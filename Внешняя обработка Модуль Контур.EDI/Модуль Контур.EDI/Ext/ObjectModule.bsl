// Находит сессию по указанному реквизиту и его значению.
//
// Параметры:
//	Отбор				- Структура - см. МодельОтборСессий
//  ИмяРеквизита 		- Строка - имя реквизита (например, "Тип", "Ид")
//  ЗначениеРеквизита 	- Произвольный - значение реквизита
//
// Возвращаемое значение:
// 	Структура - см. Авторизатор.МодельОтветТокен
//
Функция ХранилищеСессий_НайтиСессиюПоРеквизиту(Отбор, ИмяРеквизита, ЗначениеРеквизита) Экспорт
	
	Пользователь = ХранилищеСессий_ОпределитьПользователя(Отбор);
	
	Если Не ХранилищеСессий_ПроверитьДоступ(Пользователь) Тогда
		ВызватьИсключение ХранилищеСессий_СообщениеОшибкаДоступа();
	КонецЕсли;
	
	Результат = Неопределено;
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	СписокНастроек = ХранилищеОбщихНастроек.ПолучитьСписок(Отбор.КлючОбъекта);
	
	Для Каждого Настройка Из СписокНастроек Цикл 
		Сессия = ХранилищеОбщихНастроек.Загрузить(Отбор.КлючОбъекта, Настройка.Значение,, Пользователь);
		Если Сессия[ИмяРеквизита] <> ЗначениеРеквизита Тогда
			Продолжить;	
		КонецЕсли;
		Результат = Сессия;
		Прервать;
	КонецЦикла;

	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

// Сохраняет сессию в хранилище общих настроек
//
// Параметры:
//	Отбор 	- Структура - см. МодельОтборСессий
//	Сессия	- Структура - см. Авторизатор.МодельОтветТокен
//			Если указан пользователь, не являющийся текущим пользователем, 
//			т.е. делается попытка обратиться к настройкам, не принадлежащим текущему пользователю, 
//			то требуется наличие у текущего пользователя права АдминистрированиеДанных.
//			Либо при обращению к хранилищу общих настроек использовать привилегированный режим.
//
Процедура ХранилищеСессий_СохранитьСессию(Отбор, Сессия) Экспорт
	
	Пользователь = ХранилищеСессий_ОпределитьПользователя(Отбор);
	
	Если Не ХранилищеСессий_ПроверитьДоступ(Пользователь) Тогда
		ВызватьИсключение ХранилищеСессий_СообщениеОшибкаДоступа();
	КонецЕсли;
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	ХранилищеОбщихНастроек.Сохранить(Отбор.КлючОбъекта, Отбор.КлючНастроек, Сессия,, Пользователь);
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Удаляет сессию в хранилище общих настроек
//
// Параметры:
//	Отбор 	- Структура - см. МодельОтборСессий
//
Процедура ХранилищеСессий_УдалитьСессию(Отбор) Экспорт
	
	Пользователь = ХранилищеСессий_ОпределитьПользователя(Отбор);
	
	Если Не ХранилищеСессий_ПроверитьДоступ(Пользователь) Тогда
		ВызватьИсключение ХранилищеСессий_СообщениеОшибкаДоступа();
	КонецЕсли;
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	ХранилищеОбщихНастроек.Сохранить(Отбор.КлючОбъекта, Отбор.КлючНастроек, Неопределено,, Пользователь);
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Удаляет сессию по значению токена доступа
//
// Параметры:
//	Отбор 		- Структура - см. МодельОтборСессий
//  Значение	- Строка - значение токена доступа
//
Процедура ХранилищеСессий_УдалитьСессиюПоТокенуДоступа(Отбор, Значение) Экспорт                

	ХранилищеСессий_УдалитьСессиюПоРеквизиту(Отбор, "ТокенДоступа", Значение);
	
КонецПроцедуры

// Удаляет сессию по указанному реквизиту и его значению.
//
// Параметры:
//	Отбор 				- Структура - см. МодельОтборСессий
//  ИмяРеквизита 		- Строка - имя реквизита (например, "ТокенДоступа").
//  ЗначениеРеквизита 	- Произвольный - значение реквизита.
//
Процедура ХранилищеСессий_УдалитьСессиюПоРеквизиту(Отбор, ИмяРеквизита, ЗначениеРеквизита) Экспорт

	Пользователь = ХранилищеСессий_ОпределитьПользователя(Отбор);
	
	Если Не ХранилищеСессий_ПроверитьДоступ(Пользователь) Тогда
		ВызватьИсключение ХранилищеСессий_СообщениеОшибкаДоступа();
	КонецЕсли;
	
	КлючНастроек = Неопределено;
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	СписокНастроек = ХранилищеОбщихНастроек.ПолучитьСписок(Отбор.КлючОбъекта);
	
	Для Каждого Настройка Из СписокНастроек Цикл
		Сессия = ХранилищеОбщихНастроек.Загрузить(Отбор.КлючОбъекта, Настройка.Значение,, Пользователь);
		Если Сессия[ИмяРеквизита] <> ЗначениеРеквизита Тогда
			Продолжить;	
		КонецЕсли;
		КлючНастроек = Настройка.Значение;
		Прервать;
	КонецЦикла;
	
	Если КлючНастроек <> Неопределено Тогда
		ХранилищеОбщихНастроек.Сохранить(Отбор.КлючОбъекта, КлючНастроек, Неопределено,, Пользователь);
	КонецЕсли;

	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Возвращает контракт отбора сессий стандартного хранилища
//
// Возвращаемое значение:
//	- Структура: 
//		КлючОбъекта - Строка - Формируется методом аутентификатора "СобратьКлючОбъекта"
//		КлючНастроек - Строка - Идентификаор настройки 
//		Пользователь - Строка(Необязательный) - Имя пользователя, под которым будет обращениее к хранилищу.
//												Если не заполнено - используется имя текущего пользователя из ПользователиИнформационнойБазы
//
Функция ХранилищеСессий_МодельОтборСессий() Экспорт

	Модель = Новый Структура;
	Модель.Вставить("КлючОбъекта");
	Модель.Вставить("КлючНастроек");
	Модель.Вставить("Пользователь");
	
	Возврат Модель;
	
КонецФункции

