Процедура ОперацииОбмена_Выполнить()
	
	ДлительнаяОперация_Начать();
	
	// ... подключаемый модуль
	ПараметрыОбмена = ПараметрыОбменаССервером();
	ПараметрыОбмена.Вставить("ЭтоФоновоеЗадание", Истина);
	
	ПараметрыПМ = Новый Структура("ИмяСписка,ПараметрыОбмена", "", ПараметрыОбмена);
	ОбработкаСобытияПодключаемогоМодуля("ПередВыполнениемОбмена",, ПараметрыПМ);
	
	ПараметрыВыполнения = Новый Структура("ВОтдельномФоновомЗадании, ПараметрыОбмена", ФоновыеЗаданияКонтурEDI_Доступны(), ПараметрыОбмена);
	
	// ... основные действия
	ОперацииОбмена_ЗагрузитьНовыеСообщения(ПараметрыВыполнения);
	ОперацииОбмена_ПринятьВходящиеСообщенияАвтоматически(ПараметрыВыполнения);
	ОперацииОбмена_ЗапуститьОперацию("ОперацииОбмена_ПроверитьПредварительныеЗаказы", ПараметрыВыполнения);
	ОперацииОбмена_ЗапуститьОперацию("ОперацииОбмена_ПодготовитьАвтоматическиОтправляемыеСообщения", ПараметрыВыполнения);
	ОперацииОбмена_ЗапуститьОперацию("ОперацииОбмена_ОтправитьALCRPT", ПараметрыВыполнения);
	ОперацииОбмена_ЗапуститьОперацию("ОперацииОбмена_ОтправитьPRICELISTПоРасписанию", ПараметрыВыполнения);
	ОперацииОбмена_ЗапуститьОперацию("ОперацииОбмена_ОтправитьСообщенияОжидающиеОтправки", ПараметрыВыполнения);
	ОперацииОбмена_ЗапуститьОперацию("ОперацииОбмена_ОтправитьУведомленияОПрочтенииСообщений", ПараметрыВыполнения);
	ОперацииОбмена_ЗапуститьОперацию("ОперацииОбмена_ВыполнитьОбменССерверомДополнительныеМодули", ПараметрыВыполнения);
	ОперацииОбмена_ЗапуститьОперацию("ОперацииОбмена_Метрика_ОтправитьВсеСобытияСтека", ПараметрыВыполнения);
	
	// ... диадок
	Если МодульСервернойКриптографииДоступен()
		ИЛИ ЭтоУФ()
		ИЛИ EDI_ИнформационнаяБазаФайловая() Тогда
		
		ОперацииОбмена_ЗапуститьОперацию("ОперацииОбмена_ПодписатьДокументыВДиадок", ПараметрыВыполнения);
		ОперацииОбмена_ЗапуститьОперацию("ОперацииОбмена_ОтправитьСлужебныеУниверсальныеСообщения", ПараметрыВыполнения);
		
	КонецЕсли;
	
	УстановитьКонстантуEDI("ДатаПоследнегоВыполненияОбмена", Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm:ss'"));
	
	ДлительнаяОперация_Завершить();
	
КонецПроцедуры

Процедура ОперацииОбмена_ЗапуститьОперацию(ИмяМетода, ПараметрыВыполнения)
	
	ВОтдельномФоновомЗадании = КонтурСтандарт_ЗначениеПоКлючу(ПараметрыВыполнения, "ВОтдельномФоновомЗадании", Ложь);
	
	Если ВОтдельномФоновомЗадании Тогда
		
		ИдентификаторФоновогоЗадания =  КонтурСтандарт_ЗначениеПоКлючу(ПараметрыВыполнения, "ИдентификаторЗадания", ИмяМетода);
		
		Если Не ФоновыеЗаданияКонтурEDI_ЕстьАктивноеЗадание(ИдентификаторФоновогоЗадания) Тогда
			ФоновыеЗаданияКонтурEDI_ВыполнитьЗадание(ИмяМетода, ПараметрыВыполнения, ИдентификаторФоновогоЗадания);
		Иначе
			ТекстПредупреждения = КонтурСтандарт_СтрШаблон_("Есть активное задание: %1", ИдентификаторФоновогоЗадания);
			ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Предупреждение, ТекстПредупреждения);
		КонецЕсли;
		
	Иначе 
		ТекстВызоваМетода = КонтурСтандарт_СтрШаблон_("%1(ПараметрыВыполнения)", ИмяМетода);
		РезультатВыполнения = Вычислить(ТекстВызоваМетода);
	КонецЕсли;
	
КонецПроцедуры

