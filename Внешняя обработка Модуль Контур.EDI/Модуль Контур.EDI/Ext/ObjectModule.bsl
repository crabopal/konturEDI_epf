Функция Отчетность_ЕстьДополнительнаяСтатистикаПоТоварам()
	
	ЕстьДополнительныеРеквизитыТовара = Истина;
		
	ДополнительныеРеквизитыТовара = Новый Массив;
	ДополнительныеРеквизитыТовара.Добавить("КодТовараПоставщика");
	ДополнительныеРеквизитыТовара.Добавить("КодТовараПокупателя");
	ДополнительныеРеквизитыТовара.Добавить("GTIN");
	ДополнительныеРеквизитыТовара.Добавить("Наименование");
	ДополнительныеРеквизитыТовара.Добавить("ЕдиницаИзмерения");
	ДополнительныеРеквизитыТовара.Добавить("ЕдиницаEDI");
	
	РеквизитыРегистраСтатистики = Метаданные.РегистрыСведений.КонтурEDI_Статистика.Реквизиты;
	
	Для каждого ИмяРеквизита Из ДополнительныеРеквизитыТовара Цикл
		
		ЕстьДополнительныеРеквизитыТовара = ЕстьДополнительныеРеквизитыТовара 
			И РеквизитыРегистраСтатистики.Найти(ИмяРеквизита) <> Неопределено;	
		
	КонецЦикла;
	
	Возврат ЕстьДополнительныеРеквизитыТовара;
	
КонецФункции

Функция Отчетность_ПолучитьИдентификаторыВиртуальныхORDERS(МассивСообщений)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	КонтурEDI_Сообщения.ID
	               |ПОМЕСТИТЬ ИДСообщений
	               |ИЗ
	               |	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	               |ГДЕ
	               |	КонтурEDI_Сообщения.Ссылка В(&МассивСообщений)
	               |	И (КонтурEDI_Сообщения.ТипСообщения = ""ORDERS""
	               |			ИЛИ КонтурEDI_Сообщения.ТипСообщения = ""ORDRSP"")
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ИДСообщений.ID,
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КонтурEDI_Сообщения.Ссылка) КАК КоличествоСообщенийПоID
	               |ИЗ
	               |	ИДСообщений КАК ИДСообщений
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	               |		ПО ИДСообщений.ID = КонтурEDI_Сообщения.ID
	               |			И (КонтурEDI_Сообщения.ТипСообщения = ""ORDERS""
	               |				ИЛИ КонтурEDI_Сообщения.ТипСообщения = ""ORDRSP"")
	               |			И (НЕ КонтурEDI_Сообщения.ПометкаУдаления)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ИДСообщений.ID
	               |
	               |ИМЕЮЩИЕ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КонтурEDI_Сообщения.Ссылка) > 1";
	Запрос.УстановитьПараметр("МассивСообщений", МассивСообщений);
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Возврат Результат.Выгрузить().ВыгрузитьКолонку("ID");
	КонецЕсли;
	
	Возврат Новый Массив;
	
КонецФункции

Функция ПолучитьКопиюСтруктуры(Структура) Экспорт
	
	Результат = Новый Структура;
	
	Для Каждого ЭлементСтруктуры Из Структура Цикл 
		
		Результат.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ОтфильтроватьТаблицуТоваровПоСкладам(Товары, МассивСкладов) Экспорт
	
	Если МассивСкладов.Количество() = 0 Тогда 
		Возврат Товары;
	КонецЕсли;
	
	СписокЗначенийСкладовОстатков = Новый СписокЗначений;
	СписокЗначенийСкладовОстатков.ЗагрузитьЗначения(МассивСкладов);
	
	ПостроительЗапроса = Новый ПостроительЗапроса; 
	ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(Товары); 
	НовыйОтбор = ПостроительЗапроса.Отбор.Добавить("МестонахождениеТовара1С"); 
	НовыйОтбор.ВидСравнения = ВидСравнения.ВСписке;
	НовыйОтбор.Значение = СписокЗначенийСкладовОстатков; 
	НовыйОтбор.Использование = Истина; 
	Результат = ПостроительЗапроса.Результат;     
	
	Возврат Результат.Выгрузить();
	
КонецФункции

Функция УдалитьЗакрытыеЗаказыИзТаблицы(Товары, МассивЗаказов) Экспорт
	
	Если МассивЗаказов.Количество() = 0 Тогда 
		Возврат Товары;
