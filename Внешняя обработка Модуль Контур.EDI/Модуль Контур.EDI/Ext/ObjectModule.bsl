Функция ПолучитьТипЗначенияОбъекта(ИмяОбъекта, ДляЗапроса = Ложь, ВернутьИмяВМетаданных = Ложь) Экспорт
	
	Если ТаблицаТипов = Неопределено Тогда
		ОбновитьТаблицуТиповЗначенияОбъектов();
	КонецЕсли;
	
	ТипЗначенияОбъекта = Неопределено;
	НайденнаяСтрока = ТаблицаТипов.Найти(ИмяОбъекта, "ИмяОбъекта");
	Если НайденнаяСтрока <> Неопределено Тогда
		// Например, "СправочникСсылка.Номенклатура"
		ТипЗначенияОбъекта = НайденнаяСтрока.ИмяТипа;
	КонецЕсли;
	
	Если ВернутьИмяВМетаданных Тогда
		// Например, "Номенклатура"
		ТипЗначенияОбъекта = ИмяТипаОбъектаВМетаданных_КонтурEDI(ТипЗначенияОбъекта);
		
		Если ТипЗначенияОбъекта = "" Тогда
			Возврат Неопределено;
		КонецЕсли;	
		
	КонецЕсли;
	
	Если ДляЗапроса Тогда
		// Например, "Справочник.Номенклатура"
		ТипЗначенияОбъекта = ИмяТипаОбъектаДляЗапроса_КонтурEDI(ТипЗначенияОбъекта);
	КонецЕсли;
	
	Возврат ТипЗначенияОбъекта;
	
КонецФункции

Функция ИмяТипаОбъектаВМетаданных_КонтурEDI(Знач ИмяТипаОбъекта) Экспорт
	
	ИмяТипаОбъекта = СтрЗаменить(ИмяТипаОбъекта, "ДокументСсылка.", "");
	ИмяТипаОбъекта = СтрЗаменить(ИмяТипаОбъекта, "СправочникСсылка.", "");
	ИмяТипаОбъекта = СтрЗаменить(ИмяТипаОбъекта, "ПеречислениеСсылка.", "");
	
	Возврат ИмяТипаОбъекта;
		
КонецФункции

Функция ИмяТипаОбъектаДляЗапроса_КонтурEDI(Знач ИмяТипаОбъекта) Экспорт
	
	ИмяТипаОбъекта = СтрЗаменить(ИмяТипаОбъекта, "Ссылка.", ".");
	Возврат ИмяТипаОбъекта;
	
КонецФункции

Функция ПолучитьИмяРеквизитаВладельцаПоИмениТипа(ИмяТипаВладельца, ИмяТипаРеквизита,СтандартнаяОбработкаEDI = Истина) Экспорт 
	
	ИмяРеквизита = "";
	
	ПараметрыПМ = Новый Структура("ИмяТипаВладельца,ИмяТипаРеквизита,ИмяРеквизита",ИмяТипаВладельца,ИмяТипаРеквизита,ИмяРеквизита);
	
	ОбработкаСобытияПодключаемогоМодуля("ПолучитьИмяРеквизитаВладельцаПоИмениТипа", СтандартнаяОбработкаEDI, ПараметрыПМ);
	
	Если СтандартнаяОбработкаEDI = Истина Тогда 		
		
		ТипВладельца = ПолучитьТипЗначенияОбъекта(ИмяТипаВладельца,		, Ложь);
		ТипРеквизита = ПолучитьТипЗначенияОбъекта(ИмяТипаРеквизита, 	, Ложь);
		
		Если ЗначениеЗаполнено(ТипВладельца) И ЗначениеЗаполнено(ТипРеквизита) Тогда
			
			ОписаниеТипРеквизита = Новый ОписаниеТипов(ТипРеквизита);
			
			МетаданныеВладельца = Метаданные.НайтиПоПолномуИмени(СтрЗаменить(ТипВладельца, "Ссылка.", "."));
			
			Если МетаданныеВладельца <> Неопределено Тогда
				Для Каждого Реквизит Из МетаданныеВладельца.Реквизиты Цикл
					
					Для Каждого ТипЭлемент Из ОписаниеТипРеквизита.Типы() Цикл
						  						
						Если Реквизит.Тип.СодержитТип(ТипЭлемент) Тогда
							
							ИмяРеквизита = Реквизит.Имя;
							Прервать;
							
						КонецЕсли;
						
					КонецЦикла;
					
					Если ЗначениеЗаполнено(ИмяРеквизита) Тогда 
						Прервать;
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		ИмяРеквизита = ПараметрыПМ.ИмяРеквизита;
		
	КонецЕсли;
	
	Возврат ИмяРеквизита;
	
КонецФункции 

Функция ПолучитьКопиюСообщения(Сообщение) Экспорт
	
	Перем КопияСообщения;
	
	КопияСообщения = Новый Структура();
	
	СтрокаСтруктуры = ЗначениеВСтрокуВнутр(Сообщение);
	
	КопияСообщения = ЗначениеИзСтрокиВнутр(СтрокаСтруктуры);
	
	Возврат КопияСообщения;
	
КонецФункции

Функция ПолучитьПустуюСсылкуОбъекта(ИмяПоля) Экспорт
	
	ТипПоля = ПолучитьТипЗначенияОбъекта(ИмяПоля);
	
	ПустаяСсылка = Неопределено;
	
	Если ТипПоля = Неопределено ИЛИ (ВнешнееХранилище И Найти(ТипПоля,"КонтурEDI_")>0) Тогда
		Возврат ПустаяСсылка;
	КонецЕсли;
	
	Если Найти(ТипПоля,"СправочникСсылка.")>0 Тогда
		ИмяМетаданных	= СтрЗаменить(ТипПоля,"СправочникСсылка.","");
		//Если ИмяКонфигурации1С = "Розница" Тогда
		//	Если Найти("\Валюты\НомераГТД\","\"+ИмяМетаданных+"\")>0 Тогда
		//		Возврат Неопределено;
		//	КонецЕсли;
		//КонецЕсли;
		ПустаяСсылка = Неопределено;
		
		КоличествоТипов = СтрЧислоСтрок(ИмяМетаданных);
		
		Для К = 1 По КоличествоТипов Цикл  				
			СтрокаТипа = СокрЛП(СтрПолучитьСтроку(ИмяМетаданных, К));  			
			Если ЗначениеЗаполнено(СтрокаТипа) Тогда
				
				Попытка
					ПустаяСсылка	= Справочники[СтрокаТипа].ПустаяСсылка();
					Прервать;
				Исключение
					ПустаяСсылка = Неопределено;	
				КонецПопытки;
				
			КонецЕсли;				
		КонецЦикла;			
	КонецЕсли;
	Если Найти(ТипПоля,"ДокументСсылка.")>0 Тогда
		ИмяМетаданных	= СтрЗаменить(ТипПоля,"ДокументСсылка.","");
		ПустаяСсылка	= Документы[ИмяМетаданных].ПустаяСсылка();
	КонецЕсли;
	Если Найти(ТипПоля,"ПеречислениеСсылка.")>0 Тогда
		ИмяМетаданных	= СтрЗаменить(ТипПоля,"ПеречислениеСсылка.","");
		ПустаяСсылка	= Перечисления[ИмяМетаданных].ПустаяСсылка();
	КонецЕсли;
	
	Возврат ПустаяСсылка;
	
КонецФункции

//}}}

