// Вывод ссылок в форме сообщения

//неправильный раздел: должно быть в печатных формах или около того.
//кроме того, некорректно преобразуется регион (здесь он идет кодом ISO)
Функция ПолучитьПредставлениеАдресаEDI(Адрес) Экспорт
	
	СписокРеквизитов = Новый СписокЗначений;
		
	Если Адрес.ВидАдреса = "Иностранный" Тогда
		
		СписокРеквизитов.Добавить("КодСтраны"	, " Код страны: ");
		СписокРеквизитов.Добавить("Адрес"		, " ");
		
	Иначе
		
		СписокРеквизитов.Добавить("Индекс"			, " ");
		СписокРеквизитов.Добавить("Регион"			, " ");
		СписокРеквизитов.Добавить("Район"			, " ");
		СписокРеквизитов.Добавить("Город"			, " ");
		СписокРеквизитов.Добавить("НаселенныйПункт"	, " ");
		СписокРеквизитов.Добавить("Улица"			, " ");
		СписокРеквизитов.Добавить("Дом"				, " д. ");
		СписокРеквизитов.Добавить("Корпус"			, " корп. ");
		СписокРеквизитов.Добавить("Квартира"		, " кв. ");
		
	КонецЕсли;
	
	Представление = "";
	
	Для каждого Стр Из СписокРеквизитов Цикл
		
		ИмяПоля			= Стр.Значение;
		
		Если ИмяПоля="Регион" Тогда//Регион у нас приходит в ISO (RU-YAR, например)
			ЗначениеПоля	= ПредставлениеРегионаПоКоду(Адрес.Регион);
		Иначе	
			ЗначениеПоля	= СокрЛП(Адрес[ИмяПоля]);
		КонецЕсли;
		
		Префикс			= Стр.Представление;
		
		Если ЗначениеЗаполнено(ЗначениеПоля) Тогда
			
			Знак = ?(Представление = "","",",");
			
			Представление = Представление+Знак+Префикс+ЗначениеПоля;
			
		КонецЕсли;
			
	КонецЦикла;
	
	Возврат СокрЛП(Представление);
	
КонецФункции

Функция ПолучитьПолноеНаименованиеЮрФизЛица(ЮрФизЛицоEDI) Экспорт
	
	Если ЮрФизЛицоEDI.Вид = "ЮрЛицо" Тогда
		
		Возврат ЮрФизЛицоEDI.Наименование;
		
	Иначе
		
		Возврат СокрЛП(СокрЛП(ЮрФизЛицоEDI.Фамилия)+" "+СокрЛП(ЮрФизЛицоEDI.Имя)+" "+СокрЛП(ЮрФизЛицоEDI.Отчество));
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьПредставлениеТочкиДоставки(ТочкаДоставки) Экспорт
	
	Представление = "";
	
	Если НЕ ЗначениеЗаполнено(ТочкаДоставки) Тогда 
		
		Возврат Представление;
		
	КонецЕсли;
	
	Если ТипЗнч(ТочкаДоставки) = Тип("СправочникСсылка.КонтурEDI_ТочкиДоставки") Тогда 
		
		Наименование = ТочкаДоставки.Наименование;
		Партнер = ТочкаДоставки.Партнер;
		GLN = ТочкаДоставки.GLN;
		АдресДоставки = ТочкаДоставки.АдресДоставки; 
		
		Представление = Наименование + "; " + Партнер + "; " + GLN + "; " + АдресДоставки;
		
	Иначе 
		
		Если ПеременнаяСодержитСвойство(ТочкаДоставки, "Наименование") Тогда 
			Представление = ТочкаДоставки.Наименование;
		Иначе 
			Представление = Строка(ТочкаДоставки);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Представление;	
	
КонецФункции

Функция ПолучитьПредставлениеЮрФизЛица(ЮрФизЛицоEDI,ЮрФизЛицо1С,ТочкаДоставки = Ложь) Экспорт
	
	
	Наименование = ПолучитьПолноеНаименованиеЮрФизЛица(ЮрФизЛицоEDI);
	
	Если ПустаяСтрока(Наименование) Тогда
		Наименование = СокрЛП(ЮрФизЛицо1С);
	КонецЕсли;
	
	Адрес = ПолучитьПредставлениеАдресаEDI(ЮрФизЛицоEDI.Адрес);
	
	СписокРеквизитов = Новый СписокЗначений;
	СписокРеквизитов.Добавить("GLN"				, " GLN ");
	СписокРеквизитов.Добавить("ИНН"				, " ИНН ");
	СписокРеквизитов.Добавить("КПП"				, " КПП ");
	СписокРеквизитов.Добавить("Телефон"			, " тел.: ");
	СписокРеквизитов.Добавить("НомерСчета"		, " р/с ");
	СписокРеквизитов.Добавить("КоррСчет"		, " к/с ");
	СписокРеквизитов.Добавить("Банк"			, " в банке ");
	СписокРеквизитов.Добавить("БИК"				, " БИК ");
	СписокРеквизитов.Добавить("Руководитель"	, " руков.: ");
	СписокРеквизитов.Добавить("ГлавныйБухгалтер", " гл. бух.: ");
	
	ПредставлениеДопРеквизитов = "";
	
	Для каждого Стр Из СписокРеквизитов Цикл
		
		ИмяПоля	= Стр.Значение;
		Префикс	= Стр.Представление;
		ЗначениеПоля = СокрЛП(ЮрФизЛицоEDI[ИмяПоля]);
		
		Если ЗначениеЗаполнено(ЗначениеПоля) Тогда
			
			Знак = ?(ПредставлениеДопРеквизитов = "","",",");
			
			ПредставлениеДопРеквизитов = ПредставлениеДопРеквизитов+Знак+Префикс+ЗначениеПоля;
			
		КонецЕсли;
			
	КонецЦикла;
	
	ПредставлениеДопРеквизитов = СокрЛП(ПредставлениеДопРеквизитов);
	
	СписокПолей = Новый СписокЗначений;
	
	Если ТочкаДоставки Тогда
		
		СписокПолей.Добавить(Адрес						, " Адрес: ");
		СписокПолей.Добавить(Наименование				, " ");
		СписокПолей.Добавить(ПредставлениеДопРеквизитов	, " ");
		
	Иначе
		
		СписокПолей.Добавить(Наименование				, " ");
		СписокПолей.Добавить(ПредставлениеДопРеквизитов	, " ");
		СписокПолей.Добавить(Адрес						, " Адрес: ");
		
	КонецЕсли;
	
	Представление = "";
	
	Для каждого Стр Из СписокПолей Цикл
		
		ЗначениеПоля	= СокрЛП(Стр.Значение);
		Префикс			= Стр.Представление;
		
		Если ЗначениеЗаполнено(ЗначениеПоля) Тогда
			
			Знак = ?(Представление = "","",",");
			
			Представление = Представление+Знак+Префикс+ЗначениеПоля;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПустаяСтрока(Представление) Тогда
		Представление = "не указан";
	КонецЕсли;
	
	Возврат СокрЛП(Представление);
	
КонецФункции

Процедура ДобавитьНастройкуВыводаСсылки(ТаблицаНастроек, ИмяПоля, ТипСсылки, ТекстСсылки, ВыполнятьПерезаполнениеСообщения = Истина)
	
	НоваяСтрока = ТаблицаНастроек.Добавить();
	
	НоваяСтрока.ИмяПоля		= ИмяПоля;
	НоваяСтрока.ТипСсылки	= ТипСсылки;
	НоваяСтрока.ТекстСсылки = ТекстСсылки;
	НоваяСтрока.ВыполнятьПерезаполнениеСообщения = ВыполнятьПерезаполнениеСообщения;
	
КонецПроцедуры

Функция ПолучитьНастройкуВыводаСсылокНаОбъектыСообщения() Экспорт
	
	ТаблицаНастроек = Новый ТаблицаЗначений;
	ТаблицаНастроек.Колонки.Добавить("ИмяПоля");
	ТаблицаНастроек.Колонки.Добавить("ТипСсылки");
	ТаблицаНастроек.Колонки.Добавить("ТекстСсылки");
	ТаблицаНастроек.Колонки.Добавить("ВыполнятьПерезаполнениеСообщения");
	
	ТаблицаНастроек.Индексы.Добавить("ИмяПоля");
	
	ДобавитьНастройкуВыводаСсылки(ТаблицаНастроек, "Покупатель1С", "КарточкаКонтрагента", "Нажмите, чтобы настроить");
	ДобавитьНастройкуВыводаСсылки(ТаблицаНастроек, "Продавец1С", "КарточкаКонтрагента", "Нажмите, чтобы настроить");
	ДобавитьНастройкуВыводаСсылки(ТаблицаНастроек, "Грузоотправитель1С", "КарточкаКонтрагента", "Нажмите, чтобы настроить");
	ДобавитьНастройкуВыводаСсылки(ТаблицаНастроек, "Грузополучатель1С", "КарточкаКонтрагента", "Нажмите, чтобы настроить");
		
	ДобавитьНастройкуВыводаСсылки(ТаблицаНастроек, "ПокупательEDI", "КарточкаКонтрагента", "Открыть карточку организации");
	ДобавитьНастройкуВыводаСсылки(ТаблицаНастроек, "ПродавецEDI", "КарточкаКонтрагента", "Открыть карточку продавца");
	ДобавитьНастройкуВыводаСсылки(ТаблицаНастроек, "ГрузоотправительEDI", "КарточкаКонтрагента", "Открыть карточку грузоотправителя");
	ДобавитьНастройкуВыводаСсылки(ТаблицаНастроек, "ГрузополучательEDI", "КарточкаКонтрагента", "Открыть карточку грузополучателя");
	
	ДобавитьНастройкуВыводаСсылки(ТаблицаНастроек, "СтавкаНДСEDI", "Документ1С", "Открыть документ");
		
	ДобавитьНастройкуВыводаСсылки(ТаблицаНастроек, "GTIN", "НоменклатураСсылка", "Заполнить штрихкод");
	
	ДобавитьНастройкуВыводаСсылки(ТаблицаНастроек, "СтатусДиадок", "ДокументДиадок", "Открыть документ");
	ДобавитьНастройкуВыводаСсылки(ТаблицаНастроек, "МашиночитаемыеДоверенности", "ДоверенностиДокумента", "Показать доверенности", Ложь);
	
	ДобавитьНастройкуВыводаСсылки(ТаблицаНастроек, "Номенклатура", "СоответствиеНоменклатуры", "Нажмите, чтобы настроить");
	
	ДобавитьНастройкуВыводаСсылки(ТаблицаНастроек, "КодыМаркировки", "КодыМаркировки", "Открыть коды маркировки", Ложь);
	ДобавитьНастройкуВыводаСсылки(ТаблицаНастроек, "КодыМаркировкиВУпаковках","КодыМаркировкиВУпаковках", "Открыть окно распределения", Ложь);
	
	ДобавитьНастройкуВыводаСсылки(ТаблицаНастроек, "ДокументУчетаМаркировка", "ДокументУчетаМаркировка", "Открыть документ", Ложь); 
	
	ДобавитьНастройкуВыводаСсылки(ТаблицаНастроек, "Сообщение", "СообщениеСОшибкой", "Посмотреть ошибку");
	
	ОбработкаСобытияПодключаемогоМодуля("НастройкаСсылокИсправленияОшибок",, Новый Структура("ТаблицаНастроек",	ТаблицаНастроек));    
		
	Возврат ТаблицаНастроек;
	
КонецФункции

Функция ВыполнитьДействиеДляИсправлениеОшибкиСообщения(Сообщение, ИмяПоля, ТипСсылки, НомерСтроки = Неопределено, ТекстОшибки = Неопределено, ВладелецФормы = Неопределено, ОригиналСообщения) Экспорт //Только для ОФ. Для УФ эта клиентская функция определена в ФормаСообщенияУправляемая
																																				  
	СтандартнаяОбработкаEDI = Истина;
	
	ОбработкаСобытияПодключаемогоМодуля("ВыполнитьДействиеДляИсправлениеОшибки", СтандартнаяОбработкаEDI, Новый Структура("ИмяПоля, ТипСсылки, КопияСообщения, ОригиналСообщения, ФормаСообщения",	ИмяПоля, ТипСсылки, Сообщение, ОригиналСообщения, ВладелецФормы));
	
	Если Не СтандартнаяОбработкаEDI Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипСсылки = "КарточкаКонтрагента" Тогда
		
		Если ИмяПоля = "Грузополучатель1С" Тогда
			Если Сообщение.ТипСообщения = "ORDERS" Тогда
				Если Найти(ТекстОшибки,"не указана связь с точкой доставк")>0 или Найти(ТекстОшибки,"не указана связь с юр.")>0 Тогда
					
					ФормаТД = ПолучитьФорму("ФормаТочкиДоставкиСторонние_Элемент", ВладелецФормы);
					ФормаТД.СсылкаТочкиДоставки = Сообщение.Грузополучатель1С;
					ФормаТД.ОткрытьМодально();
					
					Возврат Неопределено;        
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если Прав(ИмяПоля,3) = "EDI" Тогда
			ИмяПоляКонтрагента = Лев(ИмяПоля,СтрДлина(ИмяПоля)-3);
		ИначеЕсли Прав(ИмяПоля,2) = "1С" Тогда
			ИмяПоляКонтрагента = Лев(ИмяПоля,СтрДлина(ИмяПоля)-2);
		Иначе 
			ИмяПоляКонтрагента = ИмяПоля;
		КонецЕсли;
		
		Форма = ПолучитьФорму("ФормаКонтрагента", ВладелецФормы);
		Форма.Сообщение			= Сообщение;
		Форма.ИмяПоляСообщения 	= ИмяПоляКонтрагента;
		
		Форма.ОткрытьМодально();
		
	ИначеЕсли ТипСсылки = "Документ1С" Тогда
		
		Сообщение.ДокументСсылка.ПолучитьФорму().ОткрытьМодально();
		
	ИначеЕсли ТипСсылки = "НоменклатураСсылка" Тогда
		
		Если Сообщение.ТипСообщения = "PORDERS" Тогда
			
			Если НомерСтроки > 0 Тогда
				Номенклатура  		= Сообщение.Товары[НомерСтроки-1].Номенклатура;
				ЕдиницаИзмерения 	= Сообщение.Товары[НомерСтроки-1].ЕдиницаИзмерения;
				Если ЗначениеЗаполнено(Номенклатура) и ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
					ХарактеристикаНоменклатуры = Сообщение.Товары[НомерСтроки-1].ХарактеристикаНоменклатуры;
					Штрихкод = ПолучитьШтрихкодНоменклатуры(Новый Структура("Номенклатура,ХарактеристикаНоменклатуры,ЕдиницаИзмерения",Номенклатура,ХарактеристикаНоменклатуры,ЕдиницаИзмерения));
					ФормаНоменклатуры = ПолучитьФорму("ФормаНоменклатура_Элемент", ВладелецФормы);
					ФормаНоменклатуры.Партнер				= Сообщение.Получатель1С;
					ФормаНоменклатуры.Наименование			= Номенклатура.Наименование;
					ФормаНоменклатуры.GTIN					= Штрихкод;
					ФормаНоменклатуры.КодТовараВнутренний 	= Номенклатура.Код;
					СписокНоменклатуры = ФормаНоменклатуры.СписокНоменклатуры;
					НоваяСтрока = СписокНоменклатуры.Добавить();
					НоваяСтрока.Номенклатура 				= Номенклатура;
					НоваяСтрока.ХарактеристикаНоменклатуры 	= ХарактеристикаНоменклатуры;
					НоваяСтрока.ЕдиницаИзмерения 			= ЕдиницаИзмерения;
					ФормаНоменклатуры.ОткрытьМодально();
				КонецЕсли;				
			КонецЕсли;
			
		Иначе
		
			Если НомерСтроки > 0 Тогда
				
				ДанныеСтроки = Сообщение.Товары[НомерСтроки - 1];
				ОткрытьФормуПросмотраСоответствий(Сообщение, ДанныеСтроки);
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ТипСсылки = "ДокументДиадок" Тогда
		
		СписокСсылок = ПолучитьСписокСсылокНаДокументыВВебДиадок(Сообщение.СообщениеСсылка, Сообщение.ДокументСсылка);
		
		Если СписокСсылок.Количество() = 1 Тогда
			
			ЗапуститьПриложение(СписокСсылок[0].Значение);
			
		ИначеЕсли СписокСсылок.Количество() > 1 Тогда
			
			ВыбранноеЗначение = СписокСсылок.ВыбратьЭлемент("Выберите документ для его просмотра в Диадоке");
			Если НЕ ВыбранноеЗначение = Неопределено Тогда
				ЗапуститьПриложение(ВыбранноеЗначение.Значение);
			КонецЕсли;                                          			
			
		Иначе
			
			ТекстПредупреждения = 	"Не удалось найти ссылки на созданные документы в Диадок.
									|Попробуйте зайти в Диадок через ваш веб-браузер.";
			ВывестиПредупреждение_КонтурEDI(ТекстПредупреждения);
			
		КонецЕсли;
		
	ИначеЕсли ТипСсылки = "СоответствиеНоменклатуры" Тогда
		
		ДанныеСтроки = Сообщение.Товары[НомерСтроки - 1];
				
		Режим = ОпределитьКемМыЯвляемся(Сообщение);
		
		ИдентификаторыТовара = ПолучитьСтруктуруИдентификаторовТовара(ДанныеСтроки, Сообщение.ТипСообщения, Режим);
		
		СписокВыбора = СоставитьСписокВыбораСоответствийПоТовару(
		ИдентификаторыТовара.GTIN, 
		ИдентификаторыТовара.КодТовараПартнера, 
		ИдентификаторыТовара.КодЕдиницыИзмеренияEDI, 
		Сообщение.Партнер);
		
		Если Сообщение.Направление = "Входящее" 
			И (СписокВыбора.Количество() = 1 
			И СписокВыбора.НайтиПоЗначению("Настроить соответствие товаров") <> Неопределено) Тогда
			
			ОткрытьФормаНоменклатура_Элемент(ДанныеСтроки, ИдентификаторыТовара, Сообщение.Партнер, ВладелецФормы);
			
		Иначе
			
			ОткрытьФормуПросмотраСоответствий(Сообщение, ДанныеСтроки);
			
		КонецЕсли;
		
	ИначеЕсли ТипСсылки = "КодыМаркировки" Тогда
		
		ВладелецФормы.ОткрытьФормуКодовМаркировки(0);
		
	ИначеЕсли ТипСсылки = "КодыМаркировкиВУпаковках" Тогда
		
		ВладелецФормы.ОткрытьФормуРаспределенияКодовМаркировки();
		
	ИначеЕсли ТипСсылки = "ДоверенностиДокумента" Тогда
		
		ВладелецФормы.ОткрытьФормуПросмотраДоверенностей();
		
	ИначеЕсли ТипСсылки = "ДокументУчетаМаркировка" Тогда
		
		ОбщийМодуль_ВзаимодействиеКонтурМаркировкаКлиент = ОбщийМодуль1С_КонтурEDI("ВзаимодействиеКонтурМаркировкаКлиент");
		
		Если ОбщийМодуль_ВзаимодействиеКонтурМаркировкаКлиент <> Неопределено Тогда 
			
			ДокументСодержащийКоды = ОпределитьДокументСодержащийКодыМаркировки(Сообщение);	
			
			Попытка
				ОбщийМодуль_ВзаимодействиеКонтурМаркировкаКлиент.ОткрытьФормуДокументаУчетаПоДокументу1С(ДокументСодержащийКоды, ВладелецФормы);
			Исключение
				ОбщийМодуль_ВзаимодействиеКонтурМаркировкаКлиент.ОткрытьФормуДокументаУчетаПоДокументу1С(ДокументСодержащийКоды);
			КонецПопытки;
			
		КонецЕсли;
		
	ИначеЕсли ТипСсылки = "СообщениеСОшибкой" Тогда 
		
		ВывестиПредупреждение_КонтурEDI(Сообщение.ОписаниеОшибки,,"Произошла ошибка чтения сообщения"); 
		
	КонецЕсли;
	
КонецФункции

Процедура ОткрытьФормаНоменклатура_Элемент(ВыбраннаяСтрока, ИдентификаторыТовара, Партнер, ЭтаФорма = Неопределено) Экспорт
		
	ФормаНоменклатуры = ПолучитьФорму("ФормаНоменклатура_Элемент", ЭтаФорма);
	
	ФормаНоменклатуры.Партнер = Партнер;
	ФормаНоменклатуры.Наименование = ВыбраннаяСтрока.Наименование;
	ФормаНоменклатуры.GTIN = ИдентификаторыТовара.GTIN;
	ФормаНоменклатуры.КодТовараПартнера = ИдентификаторыТовара.КодТовараПартнера;
	ФормаНоменклатуры.КодТовараВнутренний = ИдентификаторыТовара.КодТовараВнутренний;
	ФормаНоменклатуры.КодЕдиницыИзмеренияEDI = ВыбраннаяСтрока.КодЕдиницыИзмеренияEDI;
	
	Если ЗначениеЗаполнено(ВыбраннаяСтрока.ТипЕдиницы) Тогда
		ФормаНоменклатуры.ТипЕдиницы = ВыбраннаяСтрока.ТипЕдиницы;
	КонецЕсли;
	
	ФормаНоменклатуры.ОткрытьМодально();
	
	СоответствиеТоваров = СоответствиеТоваров_НайтиНоменклатуру(ИдентификаторыТовара.GTIN, ИдентификаторыТовара.КодТовараПартнера, ФормаНоменклатуры.Партнер);
	
	Если НЕ ЗначениеЗаполнено(ВыбраннаяСтрока.Номенклатура) Тогда
				
		УстановитьОсновноеСоответствиеВСтрокуТоваров(ВыбраннаяСтрока, СоответствиеТоваров); 
		
	Иначе
		
		ПоискУстановленногоСоответствия = Новый Структура("Номенклатура,ХарактеристикаНоменклатуры,ЕдиницаИзмерения,КоэффициентEDIВ1С");
		ЗаполнитьЗначенияСвойств(ПоискУстановленногоСоответствия, ВыбраннаяСтрока);
		
		НайденныеСоответствия = СоответствиеТоваров.НайтиСтроки(ПоискУстановленногоСоответствия);
		
		Если НайденныеСоответствия.Количество() = 0 Тогда
			
			ВыбраннаяСтрока.Номенклатура = Неопределено;
			ВыбраннаяСтрока.ХарактеристикаНоменклатуры = Неопределено;
			ВыбраннаяСтрока.ЕдиницаИзмерения = Неопределено;
			ВыбраннаяСтрока.КоэффициентEDIВ1С = 0;      			
			
			УстановитьОсновноеСоответствиеВСтрокуТоваров(ВыбраннаяСтрока, СоответствиеТоваров);
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьОсновноеСоответствиеВСтрокуТоваров(ВыбраннаяСтрока, СоответствиеТоваров)
		
	СтрокаСоответствия = СоответствиеТоваров.Найти(Истина, "Основной");
	
	Если СтрокаСоответствия <> Неопределено Тогда
		
		ЗаполнитьЗначенияСвойств(
		ВыбраннаяСтрока,
		СтрокаСоответствия,
		"Номенклатура,ХарактеристикаНоменклатуры,ЕдиницаИзмерения,КоэффициентEDIВ1С,ТипЕдиницы");
		
		ТекстПересчета = ТекстПересчета_КонтурEDI(СтрокаСоответствия.ЕдиницаИзмерения, СтрокаСоответствия.ЕдиницаEDI, СтрокаСоответствия.КоэффициентEDIВ1С);
		
		ВыбраннаяСтрока.ТекстПересчета = ТекстПересчета;
		
		Если ВыбраннаяСтрока.НеЗагружать Тогда
			// Скинем флаг НеЗагружать
			ВыбраннаяСтрока.НеЗагружать = Ложь;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьСтруктуруИдентификаторовТовара(ВыбраннаяСтрока, ТипСообщения, КтоМы) Экспорт
	
	Структура = Новый Структура;
	
	Структура.Вставить("GTIN", ВыбраннаяСтрока.GTIN);
	Структура.Вставить("КодЕдиницыИзмеренияEDI", ВыбраннаяСтрока.КодЕдиницыИзмеренияEDI);
	
	ЭтоОбратнаяОтгрузка = ЭтоОбратнаяОтгрузка(ТипСообщения);
	
	// supplier code & buyer code поменяны местами EDI_An-354
	Если ЭтоОбратнаяОтгрузка 
		ИЛИ КтоМы = "Покупатель" Тогда
		
		Структура.Вставить("КодТовараПартнера", ВыбраннаяСтрока.КодТовараПоставщика);
		Структура.Вставить("КодТовараВнутренний", ВыбраннаяСтрока.КодТовараПокупателя);
		
	Иначе
		
		Структура.Вставить("КодТовараПартнера", ВыбраннаяСтрока.КодТовараПокупателя);
		Структура.Вставить("КодТовараВнутренний", ВыбраннаяСтрока.КодТовараПоставщика);
		
	КонецЕсли;
	
	Возврат Структура;
	
КонецФункции

Процедура ОткрытьФормуПросмотраСоответствий(Сообщение, ДанныеСтроки) Экспорт
	
	ФормаПросмотраСоответствий = ПолучитьФорму("СопоставлениеНоменклатурыИзКарточкиСообщения", ОсновнаяФормаОФ());
	
	ФормаПросмотраСоответствий.Партнер = Сообщение.Партнер;
	ФормаПросмотраСоответствий.Направление = Сообщение.Направление;
		
	Если Сообщение.Направление = "Входящее" Тогда
		
		КтоМы = ОпределитьКемМыЯвляемся(Сообщение);
		
		ИдентификаторыТовара = ПолучитьСтруктуруИдентификаторовТовара(ДанныеСтроки, Сообщение.ТипСообщения, КтоМы);
				
		ФормаПросмотраСоответствий.ИсходноеНаименованиеПартнера		= ДанныеСтроки.Наименование;  		
		ФормаПросмотраСоответствий.ИсходныйGTIN						= ИдентификаторыТовара.GTIN;
		ФормаПросмотраСоответствий.ИсходныйКодЕдиницыИзмеренияEDI	= ИдентификаторыТовара.КодЕдиницыИзмеренияEDI;
		ФормаПросмотраСоответствий.ИсходныйКодТовараПартнера		= ИдентификаторыТовара.КодТовараПартнера;
		ФормаПросмотраСоответствий.КодТовараВнутренний				= ИдентификаторыТовара.КодТовараВнутренний;
		
	Иначе
		
		ФормаПросмотраСоответствий.Документ1С					= Сообщение.Документ1С;
		ФормаПросмотраСоответствий.Номенклатура					= ДанныеСтроки.Номенклатура;
		ФормаПросмотраСоответствий.ХарактеристикаНоменклатуры	= ДанныеСтроки.ХарактеристикаНоменклатуры;
		ФормаПросмотраСоответствий.ЕдиницаИзмерения				= ДанныеСтроки.ЕдиницаИзмерения;
		
	КонецЕсли;
	
	ФормаПросмотраСоответствий.ОткрытьМодально();

КонецПроцедуры

