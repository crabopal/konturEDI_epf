		СтруктураТипа.ТочностьЧисла    	= 0;
		СтруктураТипа.ЧастиДаты    		= ЧастиДаты.Время;
	ИначеЕсли ИмяТипа = "Структура" Тогда  
		СтруктураТипа.ИмяТипа			= "Структура";
		СтруктураТипа.ДлинаСтроки		= 0;
		СтруктураТипа.ДлинаЧисла    	= 0;
		СтруктураТипа.ТочностьЧисла    	= 0;
