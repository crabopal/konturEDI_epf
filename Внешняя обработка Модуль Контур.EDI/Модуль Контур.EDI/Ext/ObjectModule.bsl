			СтрокаТЧ.Представление = КонтурСтандарт_СтрШаблон_("06.3. Загрузить новые сообщения: %1", ТипСообщения);
			СтрокаТЧ.ПоказыватьОповещение = Ложь;
			СтрокаТЧ.Использование = "ВызовСерверногоМетода";
			
		КонецЦикла;
		
		СтрокаТЧ = ТаблицаКоманд.Добавить();
		СтрокаТЧ.Идентификатор = "ОперацииОбмена_ПринятьВходящиеСообщенияАвтоматически";
		СтрокаТЧ.Представление = "07. Принять входящие сообщения автоматически";
