Функция ПолучитьСписокТорговыхСетей() Экспорт
	
	СтруктураТС = ПолучитьСтруктуруДанныхТорговойСети("list");
		
	Если ( ТипЗнч(СтруктураТС) = Тип("Структура") ) и ( ТипЗнч(СтруктураТС.Сети) = Тип("ТаблицаЗначений") ) Тогда
		
		ТипизироватьКолонкиВТаблицеЗначений(СтруктураТС.Сети, "Код,Наименование,GLN", ОписаниеТипаСтрока_КонтурEDI(150));
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаСетей.Код,
		|	ТаблицаСетей.Наименование,
		|	ТаблицаСетей.GLN
		|ПОМЕСТИТЬ табСети
		|ИЗ
		|	&ТаблицаСетей КАК ТаблицаСетей
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	табСети.Код,
		|	табСети.Наименование,
		|	табСети.GLN,
		|	ВЫБОР
		|		КОГДА КонтурEDI_ДополнительныеРеквизиты.Объект ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК Подключена
		|ИЗ
		|	табСети КАК табСети
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеРеквизиты
		|		ПО (КонтурEDI_ДополнительныеРеквизиты.Свойство = ""КодСети"")
		|			И табСети.Код = КонтурEDI_ДополнительныеРеквизиты.Значение";
		
		Запрос.УстановитьПараметр("ТаблицаСетей", СтруктураТС.Сети);
		
		ТаблицаСетей = Запрос.Выполнить().Выгрузить();
				
		Возврат ТаблицаСетей;
		
	Иначе
		
		Возврат Новый ТаблицаЗначений;
		
	КонецЕсли;

КонецФункции

Функция ПолучитьСтруктуруДанныхТорговойСети(КодСети, Событие = Неопределено) Экспорт
	
	//идет на сервер, качает оттуда XML с PARTIN, парсит, возвращает.
	//на рефакторинг: разбить пополам - закачка отдельно, парсинг отдельно.
	
	//будем обрабатывать его
	ПутьКФайлуСДаннымиБезРасширения = мРабочийКаталог + КодСети;
	
	ПолучилиФайлССервера = Ложь;
	
	Если ПротоколОбмена_КонтурEDI = "Каталог" Тогда
		
		//Предполагаем, что файлы лежат в каталоге PARTIN, а поставщик каким-то образом подтягивает их туда с веба, после чего разжимает самостоятельно.
		ИмяФайлаЛокальнойПапкиБезРасширения = ПолучитьПараметрыИнтернетСоединения_KE().АдресКаталогаОбменаEDI + "\PARTIN\" + КодСети;
		ЛокальныйФайл = Новый Файл(ИмяФайлаЛокальнойПапкиБезРасширения + ".xml");
		
		Если ЛокальныйФайл.Существует() Тогда
			//скопируем в темп для единообразия кода
			КопироватьФайл(ИмяФайлаЛокальнойПапкиБезРасширения + ".xml", ПутьКФайлуСДаннымиБезРасширения + ".xml");
			
		ИначеЕсли Событие = "АвтоматическаяПроверкаПриОткрытииМодуля" Тогда
			Возврат Неопределено;
			
		Иначе
			Если КодСети = "list" Тогда
				ТекстСообщения = "В локальном каталоге обмена " + ПолучитьПараметрыИнтернетСоединения_KE().АдресКаталогаОбменаEDI + "\PARTIN\" + 
									" не нашли файл list.xml со списком партнеров для обновления.";
			Иначе
				ТекстСообщения = "В локальном каталоге обмена " + ПолучитьПараметрыИнтернетСоединения_KE().АдресКаталогаОбменаEDI + "\PARTIN\" + 
									" не нашли файл " + КодСети + ".xml с данными о юр./физ. лицах и точках доставок партнера для обновления.";
			КонецЕсли;
			
			Сообщить_КонтурEDI(ТекстСообщения);
			Возврат Неопределено;
		КонецЕсли;
		
	Иначе
		//все сети будем загружать с http
		Состояние_КонтурEDI("Загружаем актуальные данные торговых сетей...");
		
		Результат = ПолучитьФайл_EDI("/1c/nets/V2/"+КодСети+".zip");
		
		Если Результат = Неопределено Тогда 
			
			ВывестиПредупреждение_КонтурEDI("Не удалось загрузить описание " + ?(КодСети = "list", "списка сетей", "сети """ + КодСети + """") + " с сервера. 
			|Возможные проблемы: отсутствует соединение с сервером или файл на сервере.");
			
			Возврат Неопределено;
		КонецЕсли;
		
		Результат.Записать(ПутьКФайлуСДаннымиБезРасширения+".zip");
				
		Попытка
			Зип = 	Новый ЧтениеZipФайла(ПутьКФайлуСДаннымиБезРасширения + ".zip");
			Эл 	=	Зип.Элементы.Найти(КодСети + ".xml");
			Зип.Извлечь(Эл, мРабочийКаталог);
			УдалитьФайлы(ПутьКФайлуСДаннымиБезРасширения + ".zip");
		Исключение
			ВывестиПредупреждение_КонтурEDI("Проблема при работе с файлом " + ПутьКФайлуСДаннымиБезРасширения + ".zip
											|Возможные проблемы: Файл отсутствует или удален.");
			Сообщить_КонтурEDI(ОписаниеОшибки());
		КонецПопытки;
		
	КонецЕсли;
	
	Состояние_КонтурEDI("");
	ДанныеПоТС = ПрочитатьДанныеПоТорговойСети(ПутьКФайлуСДаннымиБезРасширения + ".xml");
	УдалитьФайлы(ПутьКФайлуСДаннымиБезРасширения + ".xml");
		
	Возврат ДанныеПоТС;
	
КонецФункции

Функция НайтиЮрФизЛицоСтороннееПоРеквизитам(ИНН,КПП) Экспорт
	
	Если ПустаяСтрока(ИНН) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяСправочникаКонтрагенты = ПолучитьТипЗначенияОбъекта("ЮрФизЛицоСтороннее",,Истина);
	РеквизитыСправочника = Метаданные.Справочники[ИмяСправочникаКонтрагенты].Реквизиты;
	Если РеквизитыСправочника.Найти("ИНН")=Неопределено
		Или РеквизитыСправочника.Найти("КПП")=Неопределено
		Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Контрагенты.Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН = &ИНН
	|	И Контрагенты.КПП = &КПП";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,".Контрагенты","."+ИмяСправочникаКонтрагенты);
	
	Запрос.УстановитьПараметр("ИНН",СокрЛП(ИНН));
	Запрос.УстановитьПараметр("КПП",СокрЛП(КПП));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		ЮрФизЛицоСтороннее = Неопределено;
		
	Иначе
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		ЮрФизЛицоСтороннее = Выборка.Ссылка;
		
	КонецЕсли;
	
	Возврат ЮрФизЛицоСтороннее;
	
КонецФункции

Функция ПолучитьТорговуюСетьПоКоду(КодСети) Экспорт
	
	НайденнаяСеть = НайтиОбъектПоЗначениюСвойства("КодСети",КодСети);
	
	Если ВнешнееХранилище Тогда
		Если ТипЗнч(НайденнаяСеть) = Тип("COMОбъект") Тогда
			НайденнаяСеть = СоединениеСХранилищем.ЗначениеВСтрокуВнутр(НайденнаяСеть);
		КонецЕсли;
	КонецЕсли;
	
	Возврат НайденнаяСеть;	
	
КонецФункции

Процедура СохранитьТорговуюСеть(КодСети,
								ТаблицаКонтрагентов,
								GLN=Неопределено,
								Наименование="",
								ОбновитьСписокТочекДоставки = Истина, 
								ЭтоТорговаяСеть = Истина,
								ЭтоПоставщик = Ложь) Экспорт
	
	ЭтоТестоваяСеть = ЗначениеЗаполнено(GLN);//для тестовых торговых сетей, которых нет в PARTIN, не будем выводить предупреждение о невозможности загрузки файла
	
	Если ЭтоТестоваяСеть Тогда
		//эмулируем пустую сеть
		СтруктураСети = Новый Структура("GLN",КодСети);
		СтруктураСети.Вставить("Подразделения",Новый ТаблицаЗначений);
		СтруктураСети.Вставить("ТочкиДоставки",Новый ТаблицаЗначений);
		СтруктураСети.Вставить("ЮрФизЛица",Новый ТаблицаЗначений);
		СтруктураСети.Вставить("НастройкиПоУмолчанию",Новый ТаблицаЗначений);
	Иначе
		СтруктураСети = ПолучитьСтруктуруДанныхТорговойСети(КодСети);
	КонецЕсли;
	
	СсылкаСети = ПолучитьТорговуюСетьПоКоду(КодСети);
	
	//Наименование = "";
	
	ТаблицаСетей	= ПолучитьСписокТорговыхСетей();
	НайденнаяСеть	= ТаблицаСетей.Найти(КодСети,"Код");
	
	Если НЕ НайденнаяСеть = Неопределено Тогда
		Наименование = НайденнаяСеть.Наименование;
	КонецЕсли;
	
	СтруктураПолейПартнера = Новый Структура();
	СтруктураПолейПартнера.Вставить("Наименование",		Наименование);
	СтруктураПолейПартнера.Вставить("GLN",				СтруктураСети.GLN);
	СтруктураПолейПартнера.Вставить("КодСети",			КодСети);
	СтруктураПолейПартнера.Вставить("ЭтоТорговаяСеть",	ЭтоТорговаяСеть);
	СтруктураПолейПартнера.Вставить("ЭтоПоставщик",		ЭтоПоставщик);

	СтруктураПолейПартнера.Вставить("ORDERS_Входящее",	Истина);
	СтруктураПолейПартнера.Вставить("ORDRSP_Исходящее",	Истина);
	СтруктураПолейПартнера.Вставить("DESADV_Исходящее",	Истина);
	СтруктураПолейПартнера.Вставить("RECADV_Входящее",	Истина);
	СтруктураПолейПартнера.Вставить("INVOIC_Исходящее",	Истина);
		
	//прочитаем из макета описание настроек партнеров и приведем данные, полученные с сервера, к данным типам
	ДеревоНастроек = ПолучитьДеревоНастроек("Партнеры", Неопределено);
	
	Для Каждого СтрокаНастройкиПоУмолчанию Из СтруктураСети.НастройкиПоУмолчанию Цикл
		
		СтрокиНастроекИзМакета = ДеревоНастроек.Строки.НайтиСтроки(Новый Структура("НастройкаИД",СтрокаНастройкиПоУмолчанию.ИмяНастройки),Истина);
		Если СтрокиНастроекИзМакета.Количество() = 1 Тогда
			ТипНастройки = СтрокиНастроекИзМакета[0].ОписаниеТипа;
			СтруктураПолейПартнера.Вставить(СтрокаНастройкиПоУмолчанию.ИмяНастройки,ТипНастройки.ПривестиЗначение(СтрокаНастройкиПоУмолчанию.Значение));
		КонецЕсли;
		
	КонецЦикла;
	
	СохранитьЭлементСправочника("Партнеры",СсылкаСети,СтруктураПолейПартнера);
	
	ТаблицаЮрФизЛиц = Новый ТаблицаЗначений;
	ТаблицаЮрФизЛиц.Колонки.Добавить("ЮрФизЛицо");
	ТаблицаЮрФизЛиц.Колонки.Добавить("GLN");
	ТаблицаЮрФизЛиц.Колонки.Добавить("Основной");
	
	Для каждого Стр Из ТаблицаКонтрагентов Цикл
		
		НоваяСтрока = ТаблицаЮрФизЛиц.Добавить();
		
		НоваяСтрока.ЮрФизЛицо	= Стр.ЮрФизЛицо;
		НоваяСтрока.GLN			= Стр.GLN;
		НоваяСтрока.Основной	= Истина;
		
	КонецЦикла;
	
	СохранитьСписокЭлементовСправочника("ЮрФизЛицаСторонние",ТаблицаЮрФизЛиц,СсылкаСети);
    	
КонецПроцедуры

Процедура ОбновитьСписокТорговыхСетейССервера() Экспорт
	
	ТаблицаПартнеров_API = Новый ТаблицаЗначений;
	
	МассивНастроек = Новый Массив;
	МассивНастроек.Добавить("ORDERS_Исходящее");
	МассивНастроек.Добавить("ORDERS_Входящее");
	МассивНастроек.Добавить("ORDRSP_Исходящее");
	МассивНастроек.Добавить("ORDRSP_Входящее"); 
	МассивНастроек.Добавить("DESADV_Исходящее");
	МассивНастроек.Добавить("DESADV_Входящее");
	МассивНастроек.Добавить("RECADV_Исходящее");
	МассивНастроек.Добавить("RECADV_Входящее");
	МассивНастроек.Добавить("INVOIC_Исходящее");
	МассивНастроек.Добавить("INVOIC_Входящее");
	МассивНастроек.Добавить("ЭтоПоставщик");
	МассивНастроек.Добавить("ЭтоПокупатель");
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаПартнеров_API,МассивНастроек,Новый ОписаниеТипов("Булево"));
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаПартнеров_API,"GLN,Наименование");
	
	ТаблицаПартнеров_Подключенных = ПолучитьСписокЭлементовСправочника("Партнеры");
	УчетныеЗаписи = ПолучитьСписокЭлементовСправочника("УчетныеЗаписи");
	
	Для Каждого СтрокаУчетнойЗаписи Из УчетныеЗаписи Цикл
		
		УчетнаяЗапись = ПолучитьЭлементСправочника("УчетныеЗаписи",СтрокаУчетнойЗаписи.Ссылка);
		
		Если УчетнаяЗапись.Неактивная = Истина Тогда 
			Продолжить; 
		КонецЕсли;
		#Если Клиент Тогда
			Состояние("Получение настроек партнеров...");
		#КонецЕсли
	
	    Попытка
			
			НастройкиПартнеров = API_ПолучитьПараметрыСообщений(УчетнаяЗапись);
			
		Исключение
			
			ТекстОшибки = "Не удалось получить параметры сообщений по причине:" + ОписаниеОшибки(); 
			ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);	
			Сообщить(ТекстОшибки);
			Продолжить;
			
		КонецПопытки;

		Если НастройкиПартнеров = Неопределено Тогда 
			Продолжить;
		КонецЕсли;	
			
		#Если Клиент Тогда
		Состояние("Обновление настроек партнеров в модуле...");
		#КонецЕсли
	
		Для Каждого Партнер Из НастройкиПартнеров Цикл
			
			СтрокаТаблицыПартнеров = ТаблицаПартнеров_API.Найти(Партнер.Partner.PartnerGln,"GLN");
			Если СтрокаТаблицыПартнеров = Неопределено Тогда
				СтрокаТаблицыПартнеров = ТаблицаПартнеров_API.Добавить();
				СтрокаТаблицыПартнеров.GLN = Партнер.Partner.PartnerGln;
				СтрокаТаблицыПартнеров.Наименование = Партнер.Partner.PartnerName
			КонецЕсли;	
			
			Для Каждого СтрокаСообщения Из Партнер.DocumentSettings Цикл

				НаправленияСообщения = Новый Массив;
				ТипСообщения = ВРЕГ(СтрокаСообщения.DocumentType);
				НаправлениеНаСервере = НРег(СтрокаСообщения.DocumentDirection); 
				
				Если НаправлениеНаСервере = "tome" ИЛИ НаправлениеНаСервере = "bidirectional" Тогда
					НаправленияСообщения.Добавить("Входящее");
				КонецЕсли;
				
				Если НаправлениеНаСервере = "fromme" ИЛИ НаправлениеНаСервере = "bidirectional" Тогда
					НаправленияСообщения.Добавить("Исходящее");
				КонецЕсли;
				
				Для каждого Направление Из НаправленияСообщения Цикл
					
					ИмяКолонки = ТипСообщения + "_" + Направление;
					КолонкаТаблицы = ТаблицаПартнеров_API.Колонки.Найти(ИмяКолонки); 
					
					Если КолонкаТаблицы<>Неопределено Тогда
						
						СтрокаТаблицыПартнеров[КолонкаТаблицы.Имя] = Истина;
						
						РежимРаботыEDI = ПолучитьРежимРаботыПоНаправлениюСообщения(ТипСообщения, Направление);
						Если РежимРаботыEDI = "Поставщик" Тогда
							СтрокаТаблицыПартнеров.ЭтоПокупатель = Истина;
						ИначеЕсли РежимРаботыEDI = "Покупатель" Тогда
							СтрокаТаблицыПартнеров.ЭтоПоставщик = Истина;
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
			КонецЦикла;	
			
		КонецЦикла;	
		
	КонецЦикла;	
	
	//теперь пройдемся по таблице партнеров из API и добавим недостающих партнеров
	//а у существующих обновим настройки цепочки
	
	ТорговыеСети = ПолучитьСписокТорговыхСетей();
	
	Если ТорговыеСети.Количество() = 0 Тогда
		ВывестиПредупреждение_КонтурEDI("Не удалось загрузить актуальный список сетей.");
	КонецЕсли;
	
	Для Каждого СтрокаПартнеровAPI Из ТаблицаПартнеров_API Цикл
		ПодключенныйПартнер = ТаблицаПартнеров_Подключенных.Найти(СтрокаПартнеровAPI.GLN,"GLN");
		
		Если ПодключенныйПартнер=Неопределено Тогда
			
			СтрокаТорговойСети = ТорговыеСети.Найти(СтрокаПартнеровAPI.GLN,"GLN");
			
			ТаблицаКонтрагентов = Новый ТаблицаЗначений;//пустая таблица для совместимости
			ТаблицаКонтрагентов.Колонки.Добавить("GLN");
			ТаблицаКонтрагентов.Колонки.Добавить("ЮрФизЛицо");
			ТаблицаКонтрагентов.Колонки.Добавить("Основной");
			
			Если СтрокаТорговойСети<>Неопределено Тогда //нашли такого партнера в PARTIN
			//подключим его
			
				ТаблицаКонтрагентов = Новый ТаблицаЗначений;
				ТаблицаКонтрагентов.Колонки.Добавить("GLN");
				ТаблицаКонтрагентов.Колонки.Добавить("ЮрФизЛицо");
				ТаблицаКонтрагентов.Колонки.Добавить("Основной");
					
				СохранитьТорговуюСеть(СокрЛП(СтрокаТорговойСети.Код),ТаблицаКонтрагентов,,,Ложь);
				Сообщить("Добавлена торговая сеть: "+СокрЛП(СтрокаТорговойСети.Наименование)+" (GLN "+СтрокаТорговойСети.GLN+")");
				//и отсюда же перейти во второй цикл, в настройки
				ПодключенныйПартнер = ТаблицаПартнеров_Подключенных.Добавить();
				ПодключенныйПартнер.Ссылка = ПолучитьТорговуюСетьПоКоду(СтрокаТорговойСети.Код);
			Иначе	//партнера нет в PARTIN, добавим его с названием, GLN и цепочкой сообщений
				
				КодТорговойСети = СокрЛП(СтрокаПартнеровAPI.GLN);
				
				СохранитьТорговуюСеть(КодТорговойСети,
									  ТаблицаКонтрагентов,
									  КодТорговойСети,
									  СтрокаПартнеровAPI.Наименование,
									  Ложь,
									  СтрокаПартнеровAPI.ЭтоПокупатель,
									  СтрокаПартнеровAPI.ЭтоПоставщик);
									  
				ПодключенныйПартнер = ТаблицаПартнеров_Подключенных.Добавить();
				ПодключенныйПартнер.Ссылка = ПолучитьТорговуюСетьПоКоду(КодТорговойСети);
				
			КонецЕсли;	
			
		КонецЕсли;	
			
		Если ПодключенныйПартнер<>Неопределено Тогда
			//проверим цепочку сообщений
			Партнер = ПолучитьЭлементСправочника("Партнеры",ПодключенныйПартнер.Ссылка);
			Если Партнер=Неопределено Тогда
				Сообщить("Не удалось добавить партнера: "+СтрокаПартнеровAPI.Наименование+" (GLN: "+СтрокаПартнеровAPI.GLN+"). Добавьте его вручную");
				Продолжить;
			КонецЕсли;	
			ЕстьИзменения = Ложь;
			
			ТипБулево = Новый ОписаниеТипов("Булево");
			
			Для Каждого КолонкаНастроек Из ТаблицаПартнеров_API.Колонки Цикл
				
				Если Не КолонкаНастроек.Имя = "ЭтоПоставщик"
					И Не КолонкаНастроек.Имя = "ЭтоПокупатель" 
					И КолонкаНастроек.ТипЗначения = ТипБулево Тогда
					
					Если Не ПеременнаяСодержитСвойство(Партнер, КолонкаНастроек.Имя) Тогда
						Партнер.Вставить(КолонкаНастроек.Имя, Ложь);
					КонецЕсли;
					
					Если Партнер[КолонкаНастроек.Имя] <> СтрокаПартнеровAPI[КолонкаНастроек.Имя] Тогда
						
						Сообщить("Обновлена настройка цепочки для партнера: "+Партнер.Наименование+" : сообщение "+КолонкаНастроек.Имя+?(СтрокаПартнеровAPI[КолонкаНастроек.Имя]=Истина," включено"," выключено"));
						Партнер[КолонкаНастроек.Имя] = СтрокаПартнеровAPI[КолонкаНастроек.Имя];
						ЕстьИзменения = Истина;
						
					КонецЕсли;
					
				КонецЕсли;	
			КонецЦикла;	
			
			Если ЕстьИзменения Тогда
				//запишем его
				Партнер.Вставить("ЭтоТорговаяСеть",Партнер.ТорговаяСеть);
				Партнер.Вставить("ЭтоПоставщик",Партнер.Поставщик);//костыль
				СохранитьЭлементСправочника("Партнеры",ПодключенныйПартнер.Ссылка,Партнер)
			КонецЕсли;	
			
		Иначе
			Сообщить("Не удалось добавить партнера: "+СтрокаПартнеровAPI.Наименование+" (GLN: "+СтрокаПартнеровAPI.GLN+"). Добавьте его вручную");
		КонецЕсли;	
		
	КонецЦикла;	
	
КонецПроцедуры

Функция ОпределитьНеобходимостьПроверкиОбновленийPARTIN() Экспорт

	Пользователь = ПолучитьТекущегоПользователя1С();
	
	Если ПараметрыПользователяEDI.ЭтоАвтообмен = Истина
		Или ПолучитьКонстантуEDI("АвтоматическаяПроверкаОбновлений") = Ложь 
		Или ПолучитьЗначениеСвойстваОбъектаEDI(Пользователь,"ПоказыватьИзмененияPARTIN") = Ложь Тогда
		Возврат Ложь;
	КонецЕсли;
		
	ДатаОчереднойПроверкиДанныхPARTIN = ПолучитьЗначениеСвойстваОбъектаEDI(Пользователь,"ДатаОчереднойПроверкиДанныхPARTIN");
	
	Если ЗначениеЗаполнено(ДатаОчереднойПроверкиДанныхPARTIN)
			И НачалоДня(ДатаОчереднойПроверкиДанныхPARTIN) > ТекущаяДата() Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьТаблицуИННТорговыхСетей()
	
	ТипСтрока = ОписаниеТипаСтрока_КонтурEDI(50); 
	 
	ТаблицаИНН = Новый ТаблицаЗначений;
	ТаблицаИНН.Колонки.Добавить("Наименование",	ТипСтрока);
	ТаблицаИНН.Колонки.Добавить("КодСети",		ТипСтрока);
	ТаблицаИНН.Колонки.Добавить("ИНН",			ТипСтрока);
	ТаблицаИНН.Колонки.Добавить("СсылкаНаСайте",ТипСтрока);
	
	ТабДок 	= Новый ТабличныйДокумент;
	Макет 	= ПолучитьМакет("ИННСетей");
	
	ТабДок.Вывести(Макет.ПолучитьОбласть("Данные"));
	
	сч = 1;
	Пока Истина Цикл
		
		НомерСтроки = Формат(сч,"ЧГ=");
		
		ТекстНаименование	= ТабДок.Область("R"+НомерСтроки+"C1").Текст;
		
		Если ПустаяСтрока(ТекстНаименование) Тогда
			Прервать;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаИНН.Добавить();
		НоваяСтрока.Наименование	= ТекстНаименование;
		НоваяСтрока.КодСети			= ТабДок.Область("R"+НомерСтроки+"C3").Текст;
		НоваяСтрока.ИНН				= ТабДок.Область("R"+НомерСтроки+"C4").Текст;
		НоваяСтрока.СсылкаНаСайте	= ТабДок.Область("R"+НомерСтроки+"C5").Текст;
		
		сч = сч+1;
		
	КонецЦикла;
	
	Возврат ТаблицаИНН;
	
КонецФункции

Функция ПолучитьСписокНеподключенныхТорговыхСетей() Экспорт
	
	// для начала просто будем искать контрагентов по ИНН
	// в будущем можно смотреть были ли отгрузки по этим контрагентом и получали ли сообщения по уже настроенным сетям (может просто добавили, но не подключены)
	
	МассивСетей = Новый Массив;
	
	Если НЕ ПолучитьКонстантуEDI("МыПоставщик") = Истина Тогда
		Возврат МассивСетей;
	КонецЕсли;
	
	Если Метаданные.НайтиПоПолномуИмени("Справочник.Контрагенты") = Неопределено Тогда
		Возврат МассивСетей;
	Иначе		
		СправочникКонтрагентов = Метаданные.НайтиПоПолномуИмени("Справочник.Контрагенты");
		Если СправочникКонтрагентов.Реквизиты.Найти("ИНН")=Неопределено Тогда
			Возврат МассивСетей;
		КонецЕсли;
	КонецЕсли;
	
	ТаблицаИНН = ПолучитьТаблицуИННТорговыхСетей();
	
	Если ТаблицаИНН.Количество()=0 Тогда
		Возврат МассивСетей;
	КонецЕсли;	
		
	Запрос = Новый Запрос();
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	*
	|ПОМЕСТИТЬ ТаблицаИНН
	|ИЗ
	|	&ТаблицаИНН КАК ТаблицаИНН
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИНН
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ 
	|	ТаблицаИНН.Наименование,
	|	ТаблицаИНН.КодСети КАК КодСети,
	|	ТаблицаИНН.СсылкаНаСайте
	|ИЗ
	|	ТаблицаИНН КАК ТаблицаИНН
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО ТаблицаИНН.ИНН = Контрагенты.ИНН
	|ГДЕ
	|	НЕ Контрагенты.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	КодСети";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Справочник.Контрагенты", ПолучитьТипЗначенияОбъекта("ЮрФизЛицоСтороннее", Истина));

	Запрос.УстановитьПараметр("ТаблицаИНН",ТаблицаИНН);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НайденнаяСеть = ПолучитьТорговуюСетьПоКоду(Выборка.КодСети);
		Если НЕ ЗначениеЗаполнено(НайденнаяСеть) Тогда
			
			СтруктураСети = Новый Структура("Наименование, КодСети, СсылкаНаСайте");
			ЗаполнитьЗначенияСвойств(СтруктураСети,Выборка);
			
			МассивСетей.Добавить(СтруктураСети);
			
		КонецЕсли;
			
	КонецЦикла;	
	
	Возврат МассивСетей;
	
КонецФункции

Функция ПроверитьОбновлениеТочекДоставки(ПолнаяПроверка = Ложь, Событие = Неопределено) Экспорт
	
	РезультатыПроверки = Новый ТаблицаЗначений;
	РезультатыПроверки.Колонки.Добавить("СсылкаНаСеть");
	РезультатыПроверки.Колонки.Добавить("НаименованиеСети");
	РезультатыПроверки.Колонки.Добавить("КодСети");
	РезультатыПроверки.Колонки.Добавить("ПоказателиСравнения");
	РезультатыПроверки.Колонки.Добавить("ДатаПоследнегоОбновленияСети");
	
	СтруктураСетей = ПолучитьСтруктуруДанныхТорговойСети("list", Событие);
	Если СтруктураСетей = Неопределено Тогда
		Возврат РезультатыПроверки;
	КонецЕсли;	
	
	СписокСетей = СтруктураСетей.Сети;
	
	НедоступныеПартнеры = Новый Массив;
	Если ЗначениеЗаполнено(ПараметрыПользователяEDI.НедоступныеПартнеры) Тогда
		НедоступныеПартнеры = ПараметрыПользователяEDI.НедоступныеПартнеры;
	КонецЕсли;	
	
	СетиДляПроверки = ПолучитьТорговыеСетиДляПроверки(СписокСетей, НедоступныеПартнеры, ПолнаяПроверка);
	
	Для Каждого ДанныеСети Из СетиДляПроверки.Строки Цикл
		
		Если Не ПолнаяПроверка И Дата(ДанныеСети.ДатаПоследнегоОбновления) >= ДанныеСети.ДатаОбновления Тогда
			Продолжить;
		КонецЕсли;
		
		СсылкаНаСеть = ДанныеСети.СсылкаНаСеть;
		СтруктураСети = ПолучитьСтруктуруДанныхТорговойСети(ДанныеСети.Код, Событие);
		
		Если СтруктураСети = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТочкиДоставки = СтруктураСети.ТочкиДоставки;
		ТочкиДоставкиВБазе = ДанныеСети.Строки;
		
		РезультатСравнения = СравнитьТочкиДоставки(ТочкиДоставки, ТочкиДоставкиВБазе);
		
		Если РезультатСравнения.ЕстьИзменения Тогда
			
			РезультатПроверки = РезультатыПроверки.Добавить();
			РезультатПроверки.СсылкаНаСеть 					= СсылкаНаСеть;
			РезультатПроверки.НаименованиеСети 				= ДанныеСети.Наименование;
			РезультатПроверки.КодСети						= ДанныеСети.Код;
			РезультатПроверки.ПоказателиСравнения 			= РезультатСравнения;
			РезультатПроверки.ДатаПоследнегоОбновленияСети 	= Формат(ДанныеСети.ДатаОбновления,"ДФ=yyyyMMddHHmmss");
			
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат РезультатыПроверки;
	
КонецФункции

Функция СравнитьТочкиДоставки(НовыеДанныеТочек, ДанныеТочекБазы)
	
	РезультатСравнения = Новый Структура;
	РезультатСравнения.Вставить("Новые",0);
	РезультатСравнения.Вставить("Измененные", 0);
	РезультатСравнения.Вставить("Удаленные", 0);
	РезультатСравнения.Вставить("ЕстьИзменения", Ложь);
		
	ДобавитьКолонкиВТаблицуЗначений(НовыеДанныеТочек,"Расхождения",Новый ОписаниеТипов("Число")); 
	ДобавитьКолонкиВТаблицуЗначений(НовыеДанныеТочек,"ЕстьВНовыхДанных, ЕстьВБазе", Новый ОписаниеТипов("Булево"));
	НовыеДанныеТочек.ЗаполнитьЗначения(Истина,"ЕстьВНовыхДанных");
			
	Для каждого ТочкаБазы Из ДанныеТочекБазы Цикл
		
		ДобавленнаяЗапись = НовыеДанныеТочек.Добавить();
		ДобавленнаяЗапись.GLN 				= ТочкаБазы.GLNТочки;
		ДобавленнаяЗапись.Наименование 		= ТочкаБазы.НаименованиеТочки;
		ДобавленнаяЗапись.ПолныйАдрес 		= ТочкаБазы.АдресДоставки;
		ДобавленнаяЗапись.ТипЛокализации 	= ТочкаБазы.ТипЛокализации;
		ДобавленнаяЗапись.ЕстьВБазе 		= Истина;
	
	КонецЦикла;
	
	НовыеДанныеТочек.ЗаполнитьЗначения(1,"Расхождения");
	НовыеДанныеТочек.Свернуть("GLN, Наименование, ПолныйАдрес, ТипЛокализации", "Расхождения, ЕстьВНовыхДанных, ЕстьВБазе");
	
	ОтборРасхождения = Новый Структура("Расхождения", 1);
	Расхождения = НовыеДанныеТочек.Скопировать(НовыеДанныеТочек.НайтиСтроки(ОтборРасхождения));
	
	Расхождения.Свернуть("GLN", "ЕстьВНовыхДанных, ЕстьВБазе");
	РезультатСравнения.ЕстьИзменения = Расхождения.Количество() > 0;
	
	Если РезультатСравнения.ЕстьИзменения Тогда
		
		ОтборИзмененные = Новый Структура("ЕстьВНовыхДанных, ЕстьВБазе",Истина,Истина);
		ОтборНовые = Новый Структура("ЕстьВНовыхДанных, ЕстьВБазе",Истина,Ложь);
		ОтборУдаленные = Новый Структура("ЕстьВНовыхДанных, ЕстьВБазе",Ложь,Истина);
		
		РезультатСравнения.Новые = Расхождения.НайтиСтроки(ОтборНовые).Количество();
		РезультатСравнения.Измененные = Расхождения.НайтиСтроки(ОтборИзмененные).Количество();
		РезультатСравнения.Удаленные = Расхождения.НайтиСтроки(ОтборУдаленные).Количество();
	
	КонецЕсли;
		
	Возврат РезультатСравнения;
	
КонецФункции

Функция ПолучитьТорговыеСетиДляПроверки(ПолныйСписокСетей, НедоступныеСети, ПолнаяПроверка = Ложь) 
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Строка"));
	МассивТипов.Добавить(Тип("Дата"));
	
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов,,,,Новый КвалификаторыСтроки(100),Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя));
	ТипизироватьКолонкиВТаблицеЗначений(ПолныйСписокСетей,"GLN,Код,ДатаОбновления,Наименование", ОписаниеТипов);
		
	Запрос = ИнициализироватьЗапрос_КонтурEDI();     
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаСетей.GLN,
	               |	ТаблицаСетей.ДатаОбновления,
	               |	ТаблицаСетей.Код,
	               |	ТаблицаСетей.Наименование
	               |ПОМЕСТИТЬ ТаблицаСетей
	               |ИЗ
	               |	&ТаблицаСетей КАК ТаблицаСетей
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаСетей.GLN,
	               |	ТаблицаСетей.ДатаОбновления КАК ДатаОбновления,
	               |	ТаблицаСетей.Код,
	               |	ТаблицаСетей.Наименование,
	               |	ПодключенныеСети.Объект КАК СсылкаНаСеть
	               |ПОМЕСТИТЬ ТолькоПодключенныеСети
	               |ИЗ
	               |	ТаблицаСетей КАК ТаблицаСетей
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК ПодключенныеСети
	               |		ПО ТаблицаСетей.Код = ПодключенныеСети.Значение
	               |			И (ПодключенныеСети.Свойство = ""КодСети"")
	               |ГДЕ
	               |	НЕ ПодключенныеСети.Объект ЕСТЬ NULL
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТолькоПодключенныеСети.GLN,
	               |	ТолькоПодключенныеСети.Код,
	               |	ТолькоПодключенныеСети.Наименование,
	               |	ТолькоПодключенныеСети.СсылкаНаСеть,
	               |	ТолькоПодключенныеСети.ДатаОбновления,
	               |	ЕСТЬNULL(ДатыПоследнегоОбновления.Значение, ""00010101000000"") КАК ДатаПоследнегоОбновления
	               |ПОМЕСТИТЬ ОтфильтрованныеСети
	               |ИЗ
	               |	ТолькоПодключенныеСети КАК ТолькоПодключенныеСети
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК ДатыПоследнегоОбновления
	               |		ПО ТолькоПодключенныеСети.СсылкаНаСеть = ДатыПоследнегоОбновления.Объект
	               |			И (ДатыПоследнегоОбновления.Свойство = ""ДатаОбновленияPARTIN"")
	               |ГДЕ
	               |	НЕ ТолькоПодключенныеСети.СсылкаНаСеть В (&НедоступныеСети)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОтфильтрованныеСети.GLN КАК GLN,
	               |	ОтфильтрованныеСети.Код КАК Код,
	               |	ОтфильтрованныеСети.Наименование КАК Наименование,
	               |	ОтфильтрованныеСети.СсылкаНаСеть КАК СсылкаНаСеть,
	               |	КонтурEDI_ТочкиДоставки.GLN КАК GLNТочки,
	               |	КонтурEDI_ТочкиДоставки.АдресДоставки,
	               |	КонтурEDI_ТочкиДоставки.Наименование КАК НаименованиеТочки,
	               |	ОтфильтрованныеСети.ДатаОбновления КАК ДатаОбновления,
	               |	ОтфильтрованныеСети.ДатаПоследнегоОбновления КАК ДатаПоследнегоОбновления,
	               |	ЕСТЬNULL(РеквизитТипЛокализации.Значение, """") КАК ТипЛокализации
	               |ИЗ
	               |	ОтфильтрованныеСети КАК ОтфильтрованныеСети
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ТочкиДоставки КАК КонтурEDI_ТочкиДоставки
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ТочкиДоставки.ДополнительныеРеквизиты КАК РеквизитТипЛокализации
	               |			ПО КонтурEDI_ТочкиДоставки.Ссылка = РеквизитТипЛокализации.Ссылка
	               |				И (РеквизитТипЛокализации.ИмяРеквизита = ""ТипЛокализации"")
	               |		ПО ОтфильтрованныеСети.СсылкаНаСеть = КонтурEDI_ТочкиДоставки.Партнер
	               |ИТОГИ
	               |	МАКСИМУМ(GLN),
	               |	МАКСИМУМ(Код),
	               |	МАКСИМУМ(Наименование),
	               |	МАКСИМУМ(ДатаОбновления),
	               |	МАКСИМУМ(ДатаПоследнегоОбновления)
	               |ПО
	               |	СсылкаНаСеть";
	
	Запрос.УстановитьПараметр("ТаблицаСетей", ПолныйСписокСетей);
	Запрос.УстановитьПараметр("НедоступныеСети", НедоступныеСети);
	Запрос.УстановитьПараметр("ПолнаяПроверка", ПолнаяПроверка);
	
	Результат = Запрос.Выполнить();
	Возврат Результат.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
КонецФункции

