Функция ПреобразоватьXMLПоXSL_КонтурEDI(СтрокаXML, ИмяТаблицыПреобразования) Экспорт
		
	СхемаXSLT_ДвоичныеДанные = ПолучитьСхемуXSL_КонтурEDI(ИмяТаблицыПреобразования);
	Если СхемаXSLT_ДвоичныеДанные = Неопределено Тогда
		ВызватьИсключение "Не удалось получить схему XSL с сервера!";
	КонецЕсли;
	
	ФайлXSLT = ПолучитьИмяВременногоФайла("xslt");
	СхемаXSLT_ДвоичныеДанные.Записать(ФайлXSLT);
	
	Попытка
		
		ПроцессорПреобразования = Новый ПреобразованиеXSL;
		ПроцессорПреобразования.ЗагрузитьИзФайла(ФайлXSLT);
		ДанныеXML = ПроцессорПреобразования.ПреобразоватьИзСтроки(СтрокаXML);
		НовыйСериализаторXDTO = Новый СериализаторXDTO(ФабрикаXDTO);
		
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(ДанныеXML);
		
		РезультатСериализации = НовыйСериализаторXDTO.ПрочитатьXML(Чтение);
		
		УдалитьФайлы_КонтурEDI(ФайлXSLT);
		
		Возврат РезультатСериализации;
		
	Исключение
		Метрика_Переменные = Новый Структура;
		Метрика_Переменные.Вставить("СтрокаXML", СтрокаXML);
		Метрика_Переменные.Вставить("ИмяТаблицыПреобразования", ИмяТаблицыПреобразования);
		Метрика_Переменные.Вставить("ДвоичныеДанныеXSLT",  Base64Строка(СхемаXSLT_ДвоичныеДанные));
		
		_ОписаниеОшибки = ОписаниеОшибки();
		_ИнформацияОбОшибке = ИнформацияОбОшибке();
		Метрика_ОтправитьСразу = Истина;
		Метрика_Ошибка("ПреобразоватьXMLПоXSL_КонтурEDI", _ОписаниеОшибки, _ИнформацияОбОшибке, Метрика_Переменные, Метрика_ОтправитьСразу);	
		ВызватьИсключение "Не удалось преобразовать строку XML с помощью схемы " + ИмяТаблицыПреобразования;
	КонецПопытки;
		

КонецФункции

Функция ПолучитьСхемуXSL_КонтурEDI(ИмяСхемыXSL) Экспорт
	
	 	ДвоичныеДанные = ЭДО_Кэш_Прочитать("xslt_" + ИмяСхемыXSL);
		
		Если ДвоичныеДанные = Неопределено Тогда 
			
			ДвоичныеДанные = ПолучитьФайл_EDI("/1c/KonturEDI_82/xslt/" + ИмяСхемыXSL + ".xslt");
			
			ЭДО_Кэш_Поместить("xslt_" + ИмяСхемыXSL, ДвоичныеДанные)		
			
		КонецЕсли;
		
		Возврат ДвоичныеДанные;	
	
КонецФункции

Процедура УдалитьФайлы_КонтурEDI(Путь)
	
	ФайловыйОбъект = Новый Файл(Путь);
	
	Если ФайловыйОбъект.Существует() Тогда
		Попытка
			УдалитьФайлы(Путь);
		Исключение
			ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Предупреждение, "Не удалось удалить файлы - " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОткрытьИнструкцию(АдресСтраницы, НоваяМетрика) Экспорт
	
	РезультатОткрытия = Новый Структура();
	РезультатОткрытия.Вставить("БраузерОткрылся", Ложь);
	РезультатОткрытия.Вставить("ТекстОшибки", "");
	
	ПерейтиНаСтраницуСайта(АдресСтраницы, РезультатОткрытия);
	
	НоваяМетрика.ДобавитьПеременную("ИнструкцияОткрытаВБраузере"	, РезультатОткрытия.БраузерОткрылся);
	
	Если Не РезультатОткрытия.БраузерОткрылся Тогда
		НоваяМетрика.ДобавитьПеременную("ОшибкаОткрытияБраузера"	, РезультатОткрытия.ТекстОшибки);
	КонецЕсли;
	
	НоваяМетрика.ПоместитьВОчередь();
	
КонецПроцедуры

Процедура ПерейтиНаСтраницуСайта(АдресСтраницы, РезультатОткрытия) Экспорт
	
	Попытка
		КодВозврата = Неопределено;
		ЗапуститьПриложение(АдресСтраницы,, Истина, КодВозврата);
		РезультатОткрытия.БраузерОткрылся = КодВозврата <> Неопределено;
	Исключение
		РезультатОткрытия.БраузерОткрылся = Ложь;
		РезультатОткрытия.ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	
КонецПроцедуры

