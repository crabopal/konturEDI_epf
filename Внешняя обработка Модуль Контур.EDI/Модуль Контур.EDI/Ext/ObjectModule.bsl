Функция ЗагрузитьКлассификаторИзМакета(Тип) Экспорт
	
	Результат = ЭДО_Кэш_Прочитать("Классификатор_"+Тип);
	
	Если Результат=Неопределено Тогда
		
		Результат = Новый СписокЗначений;
		
		Макет = ПолучитьМакет("Классификатор_"+Тип);
		Таб = Макет.ПолучитьОбласть("Данные");
		
		Для Сч=1 По Таб.ВысотаТаблицы Цикл
			
			НомерСтроки = Формат(сч,"ЧГ=");
			
			ТекстЗначения = Таб.Область("R"+НомерСтроки+"C1").Текст;
			ТекстПредставления = Таб.Область("R"+НомерСтроки+"C2").Текст;
			
			Результат.Добавить(ТекстЗначения,ТекстПредставления);
			
		КонецЦикла;
		
		ЭДО_Кэш_Поместить("Классификатор_"+Тип,Результат);
		
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

Функция ПолучитьКлассификаторПеречисленийEDI() Экспорт
	
	Результат = ЭДО_Кэш_Прочитать("ПеречисленияEDI");
	
	Если Результат = Неопределено Тогда
		
		СоответствиеПеречисленийEDI = Новый Соответствие;
		
		ТаблицаПеречислений = ДанныеПеречислений_КонтурEDI();
		
		Для каждого Перечисление_КонтурEDI Из ТаблицаПеречислений Цикл
			
			Наименование = Перечисление_КонтурEDI.Наименование;
			СписокЗначений = Перечисление_КонтурEDI.СписокЗначений;
			
			СоответствиеПеречисленийEDI.Вставить(Наименование + "СписокЗначений", СписокЗначений);
			СоответствиеПеречисленийEDI.Вставить(Наименование + "Значения", СоответствиеПредставленийЗначениям(СписокЗначений));
			СоответствиеПеречисленийEDI.Вставить(Наименование + "Представления", СоответствиеЗначенийПредставлениям(СписокЗначений));
			
		КонецЦикла;
		
		ЭДО_Кэш_Поместить("ПеречисленияEDI", СоответствиеПеречисленийEDI);
		Результат = СоответствиеПеречисленийEDI;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СоответствиеПредставленийЗначениям(СписокЗначений)
	
	Соответствие = Новый Соответствие;
	
	Для каждого КлючЗначение Из СписокЗначений Цикл
		
		Соответствие.Вставить(НРег(КлючЗначение.Значение), КлючЗначение.Представление);
		
	КонецЦикла;
	
	Возврат Соответствие;
	
КонецФункции

Функция СоответствиеЗначенийПредставлениям(СписокЗначений)
	
	Соответствие = Новый Соответствие;
	
	Для каждого КлючЗначение Из СписокЗначений Цикл
		
		Соответствие.Вставить(НРег(КлючЗначение.Представление), КлючЗначение.Значение);
		
	КонецЦикла;
	
	Возврат Соответствие;
	
КонецФункции

Функция ДанныеПеречислений_КонтурEDI()
	
	ДанныеПеречислений = ИнициализироватьДанныеПеречислений_КонтурEDI();
	
	ДобавитьПеречисление_КонтурEDI(ДанныеПеречислений, "РежимПеревозки", ЗначенияПеречисленияРежимПеревозки_КонтурEDI());
	ДобавитьПеречисление_КонтурEDI(ДанныеПеречислений, "НаличиеГидроборта", ЗначенияПеречисленияНаличиеГидроборта_КонтурEDI());
	ДобавитьПеречисление_КонтурEDI(ДанныеПеречислений, "ТипТранспортногоСредства", ЗначенияПеречисленияТипТранспортногоСредства_КонтурEDI());
	ДобавитьПеречисление_КонтурEDI(ДанныеПеречислений, "ПричинаВозврата", ЗначенияПеречисленияПричинаВозврата_КонтурEDI());
	ДобавитьПеречисление_КонтурEDI(ДанныеПеречислений, "ДействиеПоВозврату", ЗначенияПеречисленияДействиеПоВозврату_КонтурEDI());
	ДобавитьПеречисление_КонтурEDI(ДанныеПеречислений, "СпособДоставки", ЗначенияПеречисленияСпособДоставки_КонтурEDI());
	ДобавитьПеречисление_КонтурEDI(ДанныеПеречислений, "ТипТарифа", ЗначенияПеречисленияТипТарифа_КонтурEDI());
