//{{ Работа с признаком модифицированности модуля 

// Конструктор описания новой версии модуля
// 
// Возвращаемое значение:
//  Структура - содержит свойства:
//   * ЗаполненоАвтоматически - Булево           - Истина, если расположение удалось определить автоматически;
//   * ИмяОбработки           - Строка           - имя обработки если модуль расположен в конфигурации;
//   * ПутьКФайлу             - Строка           - указан если модуль расположен в файле с диске;
//   * Ссылка                 - СправочникСсылка - заполнена если модуль расположен в справочнике;
//   * Местоположение         - Строка           - место откуда запущен файл;
//      допустимые значения:
//       * "ЭлементСправочника"    - если модуль расположен в справочнике внешних обработок
//       * "ФайлНаДиске"           - если модуль расположен в файле на диске
//       * "ОбработкаКонфигурации" - если модуль расположен в конфигурации
//
Функция НовоеОписаниеРасположенияМодуля()
	
	Результат = Новый Структура;
	
	Результат.Вставить("ЗаполненоАвтоматически"	, Ложь);
	Результат.Вставить("Местоположение"			, "");
	Результат.Вставить("ИмяОбработки"			, "");
	Результат.Вставить("ПутьКФайлу"				, "");
	Результат.Вставить("Ссылка"					, Неопределено);
	Результат.Вставить("ИспользуемоеИмяФайла"	, "");
	Результат.Вставить("ПолноеИмяОбработки"		, "");
	
	Возврат Результат;
	
КонецФункции

Функция РасположениеТекущегоМодуля() Экспорт
	
	Результат = НовоеОписаниеРасположенияМодуля();
	
	ВерсияМодуля	 = ПараметрыКлиентСервер.НомерРелизаМодуля;
	ИсточникЗапуска	 = ПараметрыКлиентСервер.РежимИспользованияОбработки;
	
	ЗначениеИспользуемоеИмяФайла = ИспользуемоеИмяФайлаТекущейОбработки();
	
	Результат.ИмяОбработки = ИмяОбработки();
	Результат.Местоположение = ИсточникЗапуска;
	Результат.ПолноеИмяОбработки = ПолноеИмяОбработки();
	Результат.ИспользуемоеИмяФайла = ЗначениеИспользуемоеИмяФайла;
		
	РасположенияМодуля = ПеречисленияEDI_ВариантыРасположенияМодуля();
	
	Если ИсточникЗапуска = РасположенияМодуля.Файл Тогда
		
		Результат.ПутьКФайлу = ЗначениеИспользуемоеИмяФайла;
		Результат.ЗаполненоАвтоматически = Истина;
		
	ИначеЕсли ИсточникЗапуска = РасположенияМодуля.Справочник Тогда
		
		СсылкаНаМодуль = СсылкаНаМодульИзСправочникаВнешнихОбработок(ВерсияМодуля);
		Если ЗначениеЗаполнено(СсылкаНаМодуль) Тогда
			Результат.Ссылка = СсылкаНаМодуль;
			Результат.ЗаполненоАвтоматически = Истина;
		КонецЕсли;
		
	ИначеЕсли ИсточникЗапуска = РасположенияМодуля.Конфигурация
		ИЛИ ИсточникЗапуска = РасположенияМодуля.Расширение Тогда
		
		Результат.ЗаполненоАвтоматически = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

// Получает новую версию модуля из сервиса обновлений
// и записывает его файл на диске
//
// Параметры:
//  ПутьКФайлу         - Строка    - путь к файлу на диске, в который нужно записать новую версию модуля;
//  НоваяВерсия 	   - Строка    - номер версии контента;
//
Процедура ВыполнитьОбновлениеМодуляВФайлНаДиске(ПутьКФайлу, НоваяВерсия)
		
	ФайлНовойВерсии = ФайлМодуляИзСервисаОбновлений(НоваяВерсия).ДвоичныеДанные; 
	
	Если ФайлНовойВерсии <> Неопределено  Тогда	
		ФайлНовойВерсии.Записать(ПутьКФайлу);
	Иначе
		ВызватьИсключение "Не удалось загрузить версию обновления модуля 1С: " + НоваяВерсия;
	КонецЕсли;
	
КонецПроцедуры

// Получает новую версию модуля из сервиса обновлений
// и обновляет его в справочнике внешних обработок
//
// Параметры:
//  ВнешняяОбработка - СправочникСсылка - элемент в справочнике внешних обработок,
//                                        в который нужно записать файл модуля;
//  НоваяВерсия 	   - Строка    - номер версии контента;
//
Процедура ВыполнитьОбновлениеМодуляВСправочнике(ВнешняяОбработка, НоваяВерсия) Экспорт
		
	ФайлНовойВерсии = ФайлМодуляИзСервисаОбновлений(НоваяВерсия).ДвоичныеДанные;
	
	Если ФайлНовойВерсии <> Неопределено Тогда
		ОбновитьФайлВСправочникеВнешнихОбработок(ВнешняяОбработка, НоваяВерсия, ФайлНовойВерсии);
	Иначе
		ВызватьИсключение "Не удалось загрузить версию обновления модуля 1С: " + НоваяВерсия;
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьОбновлениеМодуляВРасширении(НоваяВерсия, ТипКонтента) Экспорт
	
	НовыеДанныеРасширения = ЭДО_Кэш_Прочитать("ДвоичныеДанныеОбновленияРасширенияEDI");
	
	Если НовыеДанныеРасширения = Неопределено Тогда
		НовыеДанныеРасширения = СкачатьКонтентВерсии_КонтурEDI(НоваяВерсия, ТипКонтента).ДвоичныеДанные;
	Иначе
		ЭДО_Кэш_Очистить("ДвоичныеДанныеОбновленияРасширенияEDI");	
	КонецЕсли;
	
	ОбновитьРасширениеEDI_КонтурEDI(НовыеДанныеРасширения);
	
КонецПроцедуры

// Скачивает новую версию файла модуля из сервиса обновлений
// и записывает его на диск или в справочник внешних обработок
//
// Параметры:
//  КонтекстОбновленияМодуля - Структура - см. функцию КонтекстОбновленияМодуля_КонтурEDI();
//
Процедура ВыполнитьОбновлениеМодуля(КонтекстОбновленияМодуля, ТипОбновления = "Полуавтоматически") Экспорт
	
	// Метод присутствует в клиентском и серверном модулях
	
	РасположенияМодуля = ПеречисленияEDI_ВариантыРасположенияМодуля();
	ПутьКМодулю = КонтекстОбновленияМодуля.ПутьКМодулю;
	НоваяВерсия = КонтекстОбновленияМодуля.НоваяВерсия;	
	ТипКонтента = КонтекстОбновленияМодуля.ТипКонтента;	
	Расположение = КонтекстОбновленияМодуля.Расположение;
	
	Если Расположение = РасположенияМодуля.Файл Тогда
		
		ВыполнитьОбновлениеМодуляВФайлНаДиске(ПутьКМодулю, НоваяВерсия);
		
	ИначеЕсли Расположение = РасположенияМодуля.Справочник Тогда
		
		ВыполнитьОбновлениеМодуляВСправочнике(ПутьКМодулю, НоваяВерсия);
		
	ИначеЕсли Расположение = РасположенияМодуля.Расширение Тогда
		
		ВыполнитьОбновлениеМодуляВРасширении(НоваяВерсия, ТипКонтента);
		
	Иначе
		
		ТекстОшибки = ШаблонСтр(НСтр(
		"ru = 'Не удалось обновить модуль!
		|Некорректное расположение модуля: %1'"), Расположение);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	УстановитьПризнакМодульБылОбновленАвтоматически();	
	
	Метрика_ОбновлениеМодуля(КонтекстОбновленияМодуля,, ТипОбновления);
	
КонецПроцедуры

Функция МодульБылОбновленАвтоматически() Экспорт
	
	Возврат ПолучитьКонстантуEDI("МодульБылОбновленАвтоматически") = Истина;
	
КонецФункции

Процедура УстановитьПризнакМодульБылОбновленАвтоматически() Экспорт
	
	УстановитьКонстантуEDI("МодульБылОбновленАвтоматически", Истина);
	
КонецПроцедуры

Процедура СнятьПризнакМодульБылОбновленАвтоматически() Экспорт
	
	УстановитьКонстантуEDI("МодульБылОбновленАвтоматически", Ложь);
	
КонецПроцедуры

// Записывает новый файл в справочник внешних обработок
//
// Параметры:
//  ВнешняяОбработка - СправочникСсылка - элемент в справочнике внешних обработок,
//                                        в который нужно записать файл модуля;
//  ВерсияОбработки  - Строка           - версия нового модуля;
//  ДвоичныеДанные   - ДвоичныеДанные   - файл нового модуля;
//
Процедура ОбновитьФайлВСправочникеВнешнихОбработок(ВнешняяОбработка, ВерсияОбработки, ДвоичныеДанные)
	
	Если ПараметрыКлиентСервер.ТипИспользуемыхФорм = "Обычные" Тогда
		ОбновитьОбработкуВСправочнике_ОФ(ВнешняяОбработка, ВерсияОбработки, ДвоичныеДанные);
	Иначе
		ОбновитьОбработкуВСправочнике_УФ(ВнешняяОбработка, ВерсияОбработки, ДвоичныеДанные);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьОбработкуВСправочнике_ОФ(ВнешняяОбработка, ВерсияОбработки, ДвоичныеДанные)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИмяФайла = "KonturEDI" + "_" + ВерсияОбработки + ".epf";
	КомментарийКФайлу = ИмяФайла + "; сохранен в ИБ: " + ТекущаяДата();
	СведенияОбОбработке = СведенияОВнешнейОбработкеИзФайла(ДвоичныеДанные);
	
	ОбъектСправочника = ВнешняяОбработка.ПолучитьОбъект();
	ОбъектСправочника.ОбменДанными.Загрузка = Истина;
	ОбъектСправочника.Наименование = СведенияОбОбработке.Наименование;
	ОбъектСправочника.ХранилищеВнешнейОбработки = Новый ХранилищеЗначения(ДвоичныеДанные);
	Если ЕстьРеквизитОбъекта_Контур(ОбъектСправочника, "КомментарийКФайлуИсточнику") Тогда
		ОбъектСправочника.КомментарийКФайлуИсточнику = КомментарийКФайлу;
	КонецЕсли;
	ОбъектСправочника.Записать();
	
КонецПроцедуры

Процедура ОбновитьОбработкуВСправочнике_УФ(ВнешняяОбработка, ВерсияОбработки, ДвоичныеДанные)
	
	УстановитьПривилегированныйРежим(Истина);
	
	СведенияОбОбработке = СведенияОВнешнейОбработкеИзФайла(ДвоичныеДанные);
	
	ОбработкаОбъект = ВнешняяОбработка.ПолучитьОбъект();
	ОбработкаОбъект.Версия = ВерсияОбработки;
	ОбработкаОбъект.Наименование = СведенияОбОбработке.Наименование;	
	ОбработкаОбъект.ХранилищеОбработки = Новый ХранилищеЗначения(ДвоичныеДанные);
	ОбновитьКомандыОбработкиВСправочнике_УФ(ОбработкаОбъект, СведенияОбОбработке);
	ОбработкаОбъект.ОбменДанными.Загрузка = Истина;
	ОбработкаОбъект.Записать();
	
КонецПроцедуры

Процедура ОбновитьКомандыОбработкиВСправочнике_УФ(ОбработкаОбъект, СведенияОбОбработке)
	
	ТаблицаРеглЗаданий = ОбработкаОбъект.Команды.Выгрузить(, "Идентификатор, РегламентноеЗаданиеGUID");
	
	ОбработкаОбъект.Команды.Очистить();
	
	Для Каждого ОписаниеКоманды Из СведенияОбОбработке.Команды Цикл
		
		Команда = ОбработкаОбъект.Команды.Добавить();
		
		ЗаполнитьЗначенияСвойств(Команда, ОписаниеКоманды);
		
		Команда.ВариантЗапуска = Перечисления.СпособыВызоваДополнительныхОбработок[ОписаниеКоманды.Использование];
		
	КонецЦикла;
	
	ПустойИдентификатор = "00000000-0000-0000-0000-000000000000";
	
	Для Каждого СтрокаТЗ Из ТаблицаРеглЗаданий Цикл
		
		ИдентификаторКоманды = СтрокаТЗ.Идентификатор;
		ИдентификаторЗадания = СтрокаТЗ.РегламентноеЗаданиеGUID;
		
		Если Не ЗначениеЗаполнено(ИдентификаторЗадания)
			Или ИдентификаторЗадания = ПустойИдентификатор Тогда
			Продолжить;
		КонецЕсли;
		
		Команда = ОбработкаОбъект.Команды.Найти(ИдентификаторКоманды, "Идентификатор");
		
		Если Команда <> Неопределено Тогда
			Команда.РегламентноеЗаданиеGUID = ИдентификаторЗадания;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

