	firmBooking.status = Сообщение.Статус;
	
	xmlЗаполнитьDocumentIdentificator(firmBooking, "originOrder", 		Сообщение, "ЗаказEDI");
	xmlЗаполнитьDocumentIdentificator(firmBooking, "forwardingOrder", 	Сообщение, "ЭкспедиционныйЗаказEDI");
	xmlЗаполнитьDocumentIdentificator(firmBooking, "contractIdentificator", Сообщение, "Контракт"); 
	
