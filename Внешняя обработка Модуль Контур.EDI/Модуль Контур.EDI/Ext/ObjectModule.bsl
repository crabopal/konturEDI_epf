Процедура ПоместитьВоВХ(Имя,Значение) Экспорт
	
	ПоместитьВоВременноеХранилище(Значение, ПараметрыКлиентСервер.АдресаВХ[Имя]);
				
КонецПроцедуры

Функция ИзвлечьИзВХ(Имя) Экспорт
	
	АдресВХ = ПараметрыКлиентСервер.АдресаВХ[Имя];
	
	Если Не ЭтоАдресВременногоХранилища(АдресВХ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПолучитьИзВременногоХранилища(АдресВХ);
			
КонецФункции

Функция ПоместитьАрхивФайлаВоВХ(ПутьКФайлу,УникальныйИдентификатор = Неопределено)
	
	Файл = Новый Файл(ПутьКФайлу);
	
	Если Не Файл.Существует() Тогда
		Возврат Неопределено;			
	КонецЕсли;
	
	ИмяФайлаАрхива = ПолучитьИмяВременногоФайла("zip");
	
	ЗаписьZIP = Новый ЗаписьZipФайла(ИмяФайлаАрхива);
    ЗаписьZIP.Добавить(ПутьКФайлу);
	ЗаписьZIP.Записать();
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайлаАрхива);
	АдресАрхиваФайлаВоВХ = ПоместитьВоВременноеХранилище(ДвоичныеДанные,УникальныйИдентификатор);
	
	УдалитьФайлы(ИмяФайлаАрхива);
	
	Возврат АдресАрхиваФайлаВоВХ;
	
КонецФункции

Функция ПолучитьРезультатЗапроса(Запрос,ИмяПоля = "Ссылка") Экспорт
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Возврат Неопределено;
		
	Иначе
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Возврат Выборка[ИмяПоля];
		
	КонецЕсли;
	
КонецФункции

Функция ДобавленыСвоиОбъектыВКонфигурацию() Экспорт
	
	КлючКэша = "РезультатФункции_ДобавленыСвоиОбъектыВКонфигурацию";
	
	ОбъектыДобавлены = ЭДО_Кэш_Прочитать(КлючКэша);
	
	Если ОбъектыДобавлены = Неопределено Тогда
		
		ОбъектыДобавлены = Метаданные.Справочники.Найти("КонтурEDI_Сообщения") <> Неопределено
							И Метаданные.Справочники.Найти("КонтурEDI_ТочкиДоставки") <> Неопределено
							И Метаданные.Справочники.Найти("КонтурEDI_ДополнительныеСправочники") <> Неопределено
							И Метаданные.РегистрыСведений.Найти("КонтурEDI_СтатусыДокументов") <> Неопределено
							И Метаданные.РегистрыСведений.Найти("КонтурEDI_СоответствияТоваров") <> Неопределено
							И Метаданные.РегистрыСведений.Найти("КонтурEDI_ДополнительныеРеквизиты") <> Неопределено;

		ЭДО_Кэш_Поместить(КлючКэша, ОбъектыДобавлены);
		
	КонецЕсли;

	Возврат ОбъектыДобавлены;
		
КонецФункции

// для регистрации модуля в УФ базах
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = ПараметрыРегистрацииВнешнейОбработки_КонтурEDI();
	
	МассивНазначений = Новый Массив;
	ОписаниеВерсии = ОписаниеВерсии_КонтурEDI();
	ОписаниеДляВнешнейОбработки = "Интеграционный модуль для обмена EDI сообщениями в сервисе Контур.EDI " + 
		"и для подписания исходящих документов в сервисе Контур.Диадок"; 
	
	ТаблицаКоманд = ТаблицаКоманд_КонтурEDI();
	ДобавитьКомандыОбработки_КонтурEDI(ТаблицаКоманд);
	
	ПараметрыРегистрации.Вид = "ДополнительнаяОбработка";
	ПараметрыРегистрации.Назначение = МассивНазначений;
	ПараметрыРегистрации.Наименование = "Модуль Контур.EDI";
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	ПараметрыРегистрации.Версия = ОписаниеВерсии.ПолнаяСемантикВерсия;
	ПараметрыРегистрации.Информация = ОписаниеДляВнешнейОбработки;
	ПараметрыРегистрации.Команды = ТаблицаКоманд;
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Возвращает структуру параметров для регистрации внешней обработки в справочнике внешних обработок
// 	Результат - Структура - содержит ключи:
//			
//		Вид	- 	вид обработки, который система должна зарегистрировать, допустимые типы: 
// 				ДополнительнаяОбработка, ДополнительныйОтчет, ЗаполнениеОбъекта, Отчет, ПечатнаяФорма, СозданиеСвязанныхОбъектов
//		Назначение	-	массив имен, к чему будет подключена внешняя обработка,
// 						можно задать имя в таком виде: Документ.* - в этом случае обработка будет подключена ко всем документам в системе, 
// 						которые поддерживают механизм
//		Наименование	-	имя, под которым обработка будет зарегистрирована в справочнике внешних обработок	
//      БезопасныйРежим 	-	право обработке на использование безопасного режима. 
//								Более подробно можно узнать в справке к платформе (метод УстановитьБезопасныйРежим)
//		Версия	-	версия внешней обработки, видна пользователю в справочнике внешних обработок
//		Информация	-	информация о внешней обработке, видна пользователю в справочнике внешних обработок
//		Команды	-	команды, которые поддерживает обработка в фоновом режиме
//		
Функция ПараметрыРегистрацииВнешнейОбработки_КонтурEDI()
	
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид");
	ПараметрыРегистрации.Вставить("Назначение");
	ПараметрыРегистрации.Вставить("Наименование");
	ПараметрыРегистрации.Вставить("БезопасныйРежим");
	ПараметрыРегистрации.Вставить("Версия");
	ПараметрыРегистрации.Вставить("Информация");
	ПараметрыРегистрации.Вставить("Команды");
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Добавим команды внешней обработки Контур.EDI в таблицу команд
//
Процедура ДобавитьКомандыОбработки_КонтурEDI(ТаблицаКоманд)
	
	// Добавление открытия основной формы
	СтрокаТЧ = ТаблицаКоманд.Добавить();
	СтрокаТЧ.Идентификатор = "ОткрытьМодульКонтурEDI";
	СтрокаТЧ.Представление = "01. Открыть модуль Контур.EDI";
	СтрокаТЧ.ПоказыватьОповещение = Ложь;
	СтрокаТЧ.Использование = "ОткрытиеФормы";
	
	// Добавление фонового выполнения обмена 
	// спасибо этому человеку http://infostart.ru/profile/97746/
	СтрокаТЧ = ТаблицаКоманд.Добавить();
	СтрокаТЧ.Идентификатор = "ВыполнитьФоновыйОбмен";
	СтрокаТЧ.Представление = "02. Выполнить фоновый обмен Контур.EDI";
	СтрокаТЧ.ПоказыватьОповещение = Ложь;
	СтрокаТЧ.Использование = "ВызовСерверногоМетода";
	
	// Добавление фонового расчета статистики по сообщениям
	СтрокаТЧ = ТаблицаКоманд.Добавить();
	СтрокаТЧ.Идентификатор = "РассчитатьСтатистикуПоСообщениям";
	СтрокаТЧ.Представление = "03. Рассчитать статистику по сообщениям Контур.EDI";
	СтрокаТЧ.ПоказыватьОповещение = Ложь;
	СтрокаТЧ.Использование = "ВызовСерверногоМетода";
	
	// Добавление фонового удаления неактуальных данных
	СтрокаТЧ = ТаблицаКоманд.Добавить();
	СтрокаТЧ.Идентификатор = "УдалитьНеактуальныеДанные";
	СтрокаТЧ.Представление = "04. Удалить неактуальные данные статистики сообщений Контур.EDI";
	СтрокаТЧ.ПоказыватьОповещение = Ложь;
	СтрокаТЧ.Использование = "ВызовСерверногоМетода";

	// Добавление фонового удаления неактуальных сообщений
	СтрокаТЧ = ТаблицаКоманд.Добавить();
	СтрокаТЧ.Идентификатор = "УдалитьНеактуальныеСообщения";
	СтрокаТЧ.Представление = "05. Удалить неактуальные сообщения Контур.EDI";
	СтрокаТЧ.ПоказыватьОповещение = Ложь;
	СтрокаТЧ.Использование = "ВызовСерверногоМетода";
	
	ДобавитьКомандыОперацийОбмена_КонтурEDI(ТаблицаКоманд);
	
КонецПроцедуры

Процедура ДобавитьКомандыОперацийОбмена_КонтурEDI(Знач ТаблицаКоманд)
	
	РазделятьФоновыйОбменНаПотоки = ПолучитьКонстантуEDI("РазделятьФоновыйОбменНаПотоки");
	
	Если РазделятьФоновыйОбменНаПотоки = Истина Тогда
		
		СписокСвойствEDI = 
		"МыПоставщик
		|МыТорговаяСеть";
		
		РежимыРаботы = ПолучитьСписокСвойствEDI(СписокСвойствEDI);
		
		МыПоставщик = РежимыРаботы.МыПоставщик = Истина;
		МыТорговаяСеть = РежимыРаботы.МыТорговаяСеть = Истина;
		
		Если МыПоставщик Тогда
			
			Для Каждого ТипСообщения Из ОперацииОбмена_ТипыСообщенийДляЗагрузкиПоставщик() Цикл
				
				СтрокаТЧ = ТаблицаКоманд.Добавить();
				СтрокаТЧ.Идентификатор = КонтурСтандарт_СтрШаблон_("ОперацииОбмена_ЗагрузитьНовыеСообщенияПоТипуСообщения_%1", ТипСообщения);
				СтрокаТЧ.Представление = КонтурСтандарт_СтрШаблон_("06.1. Загрузить новые сообщения: %1", ТипСообщения);
				СтрокаТЧ.ПоказыватьОповещение = Ложь;
				СтрокаТЧ.Использование = "ВызовСерверногоМетода";
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если МыТорговаяСеть Тогда
			
			Для Каждого ТипСообщения Из ОперацииОбмена_ТипыСообщенийДляЗагрузкиСеть() Цикл
				
				СтрокаТЧ = ТаблицаКоманд.Добавить();
				СтрокаТЧ.Идентификатор = КонтурСтандарт_СтрШаблон_("ОперацииОбмена_ЗагрузитьНовыеСообщенияПоТипуСообщения_%1", ТипСообщения);
				СтрокаТЧ.Представление = КонтурСтандарт_СтрШаблон_("06.2. Загрузить новые сообщения: %1", ТипСообщения);
				СтрокаТЧ.ПоказыватьОповещение = Ложь;
				СтрокаТЧ.Использование = "ВызовСерверногоМетода";
				
			КонецЦикла;
			
		КонецЕсли;
		
		Для Каждого ТипСообщения Из ОперацииОбмена_ТипыСообщенийДляЗагрузкиСтатусные() Цикл
			
			СтрокаТЧ = ТаблицаКоманд.Добавить();
