КонецФункции

Функция ВерсияКонфигурации1С_КонтурEDI() Экспорт
	
	Возврат РазобратьВерсиюСтрокой_КонтурEDI(Метаданные.Версия);		
	
КонецФункции

Функция РазобратьВерсиюСтрокой_КонтурEDI(Версия) Экспорт
	
	СтруктураВерсия = Новый Структура;
	СтруктураВерсия.Вставить("Версия", 		"");
	СтруктураВерсия.Вставить("Основная", 	0);
	СтруктураВерсия.Вставить("Младшая", 	0);
	СтруктураВерсия.Вставить("Релиз",		0);
	СтруктураВерсия.Вставить("Сборка",	 	0);
	
	Если Не ЗначениеЗаполнено(Версия)
		ИЛИ НЕ ТипЗнч(Версия) = Тип("Строка") Тогда
		Возврат СтруктураВерсия;
	КонецЕсли;
	
	СтруктураВерсия.Версия = Версия;
	
	МассивРазрядов = Новый Массив;
	ТекРазряд = "";
	ДлинаСтроки = СтрДлина(Версия);
	
	Для Сч = 1 По ДлинаСтроки Цикл
		
		ДобавитьРазряд = Ложь;
		
		ТекСимвол = Сред(Версия, Сч, 1);
		Если ТекСимвол >= "0"
			И ТекСимвол <= "9" Тогда
			ТекРазряд = ТекРазряд + ТекСимвол;
		Иначе
			ДобавитьРазряд = Истина;
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(ТекРазряд)
			И (ДобавитьРазряд
			ИЛИ Сч = ДлинаСтроки) Тогда
			МассивРазрядов.Добавить(ТекРазряд);
			ТекРазряд = "";
	    КонецЕсли;
		Если МассивРазрядов.Количество() = 4 Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Разряды = Новый Соответствие;
	Разряды.Вставить(1, "Основная");
	Разряды.Вставить(2, "Младшая");
	Разряды.Вставить(3, "Релиз");
	Разряды.Вставить(4, "Сборка");
	
	Сч = 0;
	Для каждого Разряд Из МассивРазрядов Цикл
		Сч = Сч + 1;
		СтруктураВерсия[Разряды[Сч]] = Число(Разряд);		
	КонецЦикла;
	
	Возврат СтруктураВерсия;
	
КонецФункции

Функция ВерсияПрограмногоПродуктаРавнаИлиВыше(СтрокаВерсии1, СтрокаВерсии2) Экспорт
	
	//Метод присутствует в клиентском и серверном модулях
	
	//СтрокаВерсии1 - версия программного продукта, СтрокаВерсии2 - эталонная версия
	
	Массив1 = EDI_РазложитьСтрокуВМассивСлов(СтрокаВерсии1, ".");
	Массив2 = EDI_РазложитьСтрокуВМассивСлов(СтрокаВерсии2, ".");
	
	МаксИндекс1 = Массив1.ВГраница();
	МаксИндекс2 = Массив2.ВГраница();
	МаксИндекс = Макс(МаксИндекс1, МаксИндекс2);
		
	Для К = 0 По МаксИндекс Цикл
		
		Строка1 = ?(К <= МаксИндекс1, Массив1[К], "0");
		Строка2 = ?(К <= МаксИндекс2, Массив2[К], "0");
		
		Длина1 = СтрДлина(Строка1);
		Длина2 = СтрДлина(Строка2);
				
		МодульРазницы = Макс(Длина1 - Длина2, Длина2 - Длина1);
		Для КК = 1 По МодульРазницы Цикл			
			Если Длина1 > Длина2 Тогда
				Строка2 = "0" + Строка2;
			Иначе
				Строка1 = "0" + Строка1;
			КонецЕсли;			
		КонецЦикла;
		
		Если Строка1 > Строка2 Тогда
			Возврат Истина;
		ИначеЕсли Строка1 < Строка2 Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
		
КонецФункции
// Сравнивает две версии продукта
// 	Параметры:
// 		СтрокаВерсии1 - Строка - версия программного продукта 
//		СтрокаВерсии2 - Строка - эталонная версия
//		КоличествоРазрядовСравнения - Число - количество разрядов, которые нужно сравнить, максимум 4
// 	Результат:
// 		Перечисление ВидСравнения - результат сравнения версий программных продуктов
//
Функция СравнитьВерсииПрограммногоПродукта(СтрокаВерсии1, СтрокаВерсии2, КоличествоРазрядовСравнения = 4) Экспорт
	
	СтруктураВерсии1 = РазобратьВерсиюСтрокой_КонтурEDI(СтрокаВерсии1);
	СтруктураВерсии2 = РазобратьВерсиюСтрокой_КонтурEDI(СтрокаВерсии2);
	
	РезультатСравнения = СравнитьРазрядыВерсииПродукта(СтруктураВерсии1, СтруктураВерсии2, КоличествоРазрядовСравнения);
	
	Возврат РезультатСравнения;
		
КонецФункции

// Сравнивает две семантик версии
// Пример: 1.0.0-alpha < 1.0.0-alpha.1 < 1.0.0-alpha.beta < 1.0.0-beta < 1.0.0-beta.2 < 1.0.0-beta.11 < 1.0.0-rc.1 < 1.0.0
// Подробнее: https://semver.org/lang/ru/
// 	Параметры:
// 		СтрокаВерсии1 - Строка - сравниваемая семантик версия 
//		СтрокаВерсии2 - Строка - эталонная семантик версия
// 	Результат:
// 		Перечисление ВидСравнения - результат сравнения семантик версий
//                                 
Функция СравнитьСемантикВерсии(СтрокаВерсии1, СтрокаВерсии2) Экспорт
	
	СтруктураВерсии1 = РазобратьВерсиюСтрокой_КонтурEDI(СтрокаВерсии1);
	СтруктураВерсии2 = РазобратьВерсиюСтрокой_КонтурEDI(СтрокаВерсии2);
	
	КоличествоРазрядовСравнения = 3;
	
	РезультатСравнения = СравнитьРазрядыВерсииПродукта(СтруктураВерсии1, СтруктураВерсии2, КоличествоРазрядовСравнения);
	
	Если РезультатСравнения = ВидСравнения.Равно Тогда
		
		ПредРелизныйТег1 = ПредРелизныйТегВерсии(СтрокаВерсии1);
		ПредРелизныйТег2 = ПредРелизныйТегВерсии(СтрокаВерсии2);
		
		Если ЗначениеЗаполнено(ПредРелизныйТег1) 
			И ЗначениеЗаполнено(ПредРелизныйТег2) Тогда
			
			Если ПредРелизныйТег1 > ПредРелизныйТег2 Тогда
				
				РезультатСравнения = ВидСравнения.Больше;
				
			ИначеЕсли ПредРелизныйТег1 < ПредРелизныйТег2 Тогда
				
				РезультатСравнения = ВидСравнения.Меньше;
				
			ИначеЕсли ПредРелизныйТег1 = ПредРелизныйТег2 Тогда
				
				РезультатСравнения = ВидСравнения.Равно;

			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(ПредРелизныйТег2) Тогда
			
			РезультатСравнения = ВидСравнения.Больше;
			
		ИначеЕсли ЗначениеЗаполнено(ПредРелизныйТег1) Тогда
			
			РезультатСравнения = ВидСравнения.Меньше;	
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РезультатСравнения;
		
КонецФункции

Функция СравнитьРазрядыВерсииПродукта(СтруктураВерсии1, СтруктураВерсии2, КоличествоРазрядовСравнения)
	
	КлючиИменРазрядов = Новый Массив;        
	КлючиИменРазрядов.Добавить("Основная");
	КлючиИменРазрядов.Добавить("Младшая");
	КлючиИменРазрядов.Добавить("Релиз");
	КлючиИменРазрядов.Добавить("Сборка");
	
	КлючиИменРазрядовСравнения = Новый Массив;
	
	Для Сч = 1 По КоличествоРазрядовСравнения Цикл
		КлючиИменРазрядовСравнения.Добавить(КлючиИменРазрядов[Сч - 1]);	
	КонецЦикла;
	
	Для каждого ИмяРазряда Из КлючиИменРазрядовСравнения Цикл
		
		Если СтруктураВерсии1[ИмяРазряда] = СтруктураВерсии2[ИмяРазряда] Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтруктураВерсии1[ИмяРазряда] > СтруктураВерсии2[ИмяРазряда] Тогда
			Возврат ВидСравнения.Больше;
		Иначе
			Возврат ВидСравнения.Меньше;
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат ВидСравнения.Равно;
	
КонецФункции

Функция ПредРелизныйТегВерсии(Знач СтрокаВерсии)
	
	ПредРелизныйТег = "";
	
	Если ТипЗнч(СтрокаВерсии) = Тип("Строка") Тогда
		
		ПозицияРазделителя = Найти(СтрокаВерсии, "-");
		
		Если ПозицияРазделителя <> 0 Тогда
			
			ПредРелизныйТег = Сред(СтрокаВерсии, ПозицияРазделителя + 1); 	
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ПредРелизныйТег;
	
КонецФункции

// Точка входа для регламентного задания обмена с сервером
//
Процедура ФоновоеЗадание_ВыполнитьОбмен() Экспорт
	
	Метрика_ВремяНачала = Метрика_ОтметкаВремени();
	
	ПараметрыКлиентСервер = ИнициализироватьПараметрыКлиентСервер();
	ИнициализироватьПодключаемыеМодули();
	ЗаполнитьКонтекстноЗависимыеПараметрыКлиентСервер(ПараметрыКлиентСервер);

	ПараметрыКлиентСерверМетрика = Метрика_ИнициализироватьПараметрыКлиентСервер();
	
	АвтообновлениеРасширений();
	
	Метрика_ИдЗамера = Метрика_НовыйУИД();
	Метрика_НачатьЗамер(Метрика_ИдЗамера, "ФоновоеЗадание_ВыполнитьОбмен", Метрика_ВремяНачала);
	Метрика_НачалоСеанса();
	Метрика_КонтекстМодуля("session");
	
	ПараметрыОбмена = ПараметрыОбменаССервером();
	ПараметрыОбмена.Вставить("ЭтоФоновоеЗадание", Истина);
	
	ДатаВремяПроверкиОбновления = ПолучитьКонстантуEDI("ДатаВремяПроверкиОбновленияВФоне");	
	Если ДатаВремяПроверкиОбновления = Неопределено 
		ИЛИ ТекущаяДата() > ДатаВремяПроверкиОбновления Тогда
		
		КонтекстОбновленияМодуля = КонтекстОбновленияМодуля_КонтурEDI();
		ОбновитьМодульАвтоматически(КонтекстОбновленияМодуля);
		
		СледующаяДатаВремяПроверки = ТекущаяДата() + 3*60*60;
		УстановитьКонстантуEDI("ДатаВремяПроверкиОбновленияВФоне", СледующаяДатаВремяПроверки);
		
	КонецЕсли;
	
	РазделятьФоновыйОбменНаПотоки = ПолучитьКонстантуEDI("РазделятьФоновыйОбменНаПотоки");
	Если РазделятьФоновыйОбменНаПотоки = Истина Тогда
		ОперацииОбмена_Выполнить();
	Иначе
		
		ВыполнитьОбменССервером(,ПараметрыОбмена);
		
		Если МодульСервернойКриптографииДоступен()
			ИЛИ ЭтоУФ()
			ИЛИ EDI_ИнформационнаяБазаФайловая() Тогда
			
			ПодписатьДокументыВДиадок();
			ОтправитьСлужебныеУниверсальныеСообщения();
			
		КонецЕсли;
		
	КонецЕсли;
	
	Метрика_КонецСеанса();
	ОтправитьСразу = Истина;
	Метрика_ЗакончитьЗамер(Метрика_ИдЗамера, "ФоновоеЗадание_ВыполнитьОбмен", , , , , , ОтправитьСразу);
	
	ФинализироватьПодключаемыеМодули();
	
КонецПроцедуры

