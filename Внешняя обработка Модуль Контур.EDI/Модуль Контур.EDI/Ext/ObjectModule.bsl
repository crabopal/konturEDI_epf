	ВидыДоговора = Новый Массив;
	ВидыДоговора.Добавить(Перечисления.ВидыДоговоров.СПокупателем);
	ВидыДоговора.Добавить(Перечисления.ВидыДоговоров.СКомисcионером);
	Документ.Договор = Справочники.Договоры.ПолучитьДоговорКонтрагентаПоУмолчаниюСУчетомТорговогоОбъекта(Документ.Контрагент, Документ.Организация, Документ.ВалютаДокумента, ВидыДоговора, Документ.Склад.ТорговыйОбъект);
	
	Документ.КатегорияЦен = ПолучитьЗначениеРеквизитаОбъекта_КонтурEDI(Документ.Договор, "КатегорияЦен");
	
	флСуммаВключаетНДС = Документ.ЦенаВключаетНДС; 	
	
	ТипПоставки = ТипПоставкиСообщения(Сообщение);
	
	Документ.Комментарий = "Загружен из Контур-EDI";
	Если ЗначениеЗаполнено(ТипПоставки) Тогда
		Документ.Комментарий = Документ.Комментарий + КонтурСтандарт_СтрШаблон_(", тип поставки: %1", ТипПоставки);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Документ.Дата) Тогда 
		Документ.Дата = ТекущаяДата();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Сообщение.Грузополучатель1С) Тогда
		Если ЕстьРеквизитОбъекта_Контур(Документ, "АдресДоставки") Тогда 
			Документ.АдресДоставки = Сообщение.Грузополучатель1С.АдресДоставки;
		КонецЕсли;
	КонецЕсли;

	ПараметрыПМ = Новый Структура("ДокументОбъект, Сообщение", Документ, Сообщение);
	ОбработкаСобытияПодключаемогоМодуля("ПослеЗаполненияШапкиВходящегоДокумента", , ПараметрыПМ);
	
	ИмяТабЧастиТовары = "Товары";
	ИмяТабЧастиУслуги = "Услуги";
	
	Документ[ИмяТабЧастиТовары].Очистить();

	Если ПараметрыЗаполнения.РаботаСУслугами Тогда
		Если ПараметрыЗаполнения.ЗагружатьУслугиВТабЧастьУслуги
			И ПараметрыЗаполнения.ЕстьТабЧастьУслуги Тогда
		    Документ[ИмяТабЧастиУслуги].Очистить();
		Иначе
			ИмяТабЧастиУслуги = ИмяТабЧастиТовары;	
		КонецЕсли;
	КонецЕсли;	
	
	КэшированныеЗначения = ОбработкаТабличнойЧасти_КэшированныеЗначения();

	ТоварыЗаказа = Сообщение.Товары;
	
	Для Каждого Стр Из ТоварыЗаказа Цикл
		
		Если Стр.НеЗагружать = Истина Тогда 
			Продолжить; 
		КонецЕсли;
		
		Если Стр.ТипЕдиницы = "Services" Тогда
			Если ПараметрыЗаполнения.РаботаСУслугами Тогда
				ИмяТабЧасти = ИмяТабЧастиУслуги;
			Иначе 
				Продолжить;
			КонецЕсли;
		Иначе
			ИмяТабЧасти = ИмяТабЧастиТовары;
		КонецЕсли;
		
		НоваяСтрока = Документ[ИмяТабЧасти].Добавить();
		
		НоваяСтрока.Номенклатура = Стр.Номенклатура;   
		
		Если ЗначениеЗаполнено(Стр.ХарактеристикаНоменклатуры) Тогда 
			НоваяСтрока.Характеристика = Стр.ХарактеристикаНоменклатуры;
		КонецЕсли;  
		
		НоваяСтрока.ЕдиницаИзмерения   		  = Стр.ЕдиницаИзмерения;
		НоваяСтрока.КоличествоЕдиницИзмерения = Стр.Количество; 
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения) Тогда 
			НоваяСтрока.Количество = Стр.Количество;
		Иначе                           
			НоваяСтрока.Количество = Стр.Количество * ПолучитьКоэффициентУпаковкиУФ_УТ(НоваяСтрока.ЕдиницаИзмерения);  
		КонецЕсли;     
		
		ЗаполнитьСтавкуНДСВСтрокеТовараДокумента(Стр, НоваяСтрока, Документ.Дата);
		
		ЗаполнитьНедостающиеПоляСтрокиТоваров(Стр);
		
		Если флСуммаВключаетНДС Тогда
			НоваяСтрока.Цена = Стр.ЦенаСНДС;
		Иначе        
			НоваяСтрока.Цена = Стр.ЦенаБезНДС;
		КонецЕсли;	
		
		ОбщийМодуль_ОбработкаТабличнойЧастиТоварыКлиентСервер = ОбщийМодуль1С_КонтурEDI("ОбработкаТабличнойЧастиТоварыКлиентСервер");
		ОбщийМодуль_ОбработкаТабличнойЧастиТоварыСервер       = ОбщийМодуль1С_КонтурEDI("ОбработкаТабличнойЧастиТоварыСервер");
		
		Если НЕ ОбщийМодуль_ОбработкаТабличнойЧастиТоварыКлиентСервер = Неопределено
			И НЕ ОбщийМодуль_ОбработкаТабличнойЧастиТоварыСервер = Неопределено Тогда 
			
			СтруктураПересчетаСуммыНДС = ОбщийМодуль_ОбработкаТабличнойЧастиТоварыКлиентСервер.ПолучитьСтруктуруПересчетаСуммыНДСВСтрокеТЧ(Документ);	
			
			СтруктураДействий = Новый Структура;
			СтруктураДействий.Вставить("ПересчитатьСумму"		, ОбщийМодуль_ОбработкаТабличнойЧастиТоварыКлиентСервер.ПолучитьСтруктуруПересчетаСуммовыхКолонок(Документ));
			СтруктураДействий.Вставить("ПересчитатьСуммуНДС"	, СтруктураПересчетаСуммыНДС);
			
			Если ПараметрыЗаполнения.УстанавливатьСобственныеЦеныВЗаказах Тогда
				СтруктураДействий.Вставить("ЗаполнитьЦену", ОбщийМодуль_ОбработкаТабличнойЧастиТоварыКлиентСервер.ПолучитьСтруктуруЗаполненияЦены(Документ));
			КонецЕсли;
			
			ОбщийМодуль_ОбработкаТабличнойЧастиТоварыСервер.ОбработатьСтрокуТЧСервер(НоваяСтрока, СтруктураДействий, КэшированныеЗначения);
			
		КонецЕсли;

		ПараметрыПМ = Новый Структура("СтрокаТабЧасти, СтрокаСообщения, ДокументОбъект, Сообщение", НоваяСтрока, Стр, Документ, Сообщение);
		ОбработкаСобытияПодключаемогоМодуля("ПослеЗаполненияСтрокиТабличнойЧастиВходящегоДокумента", , ПараметрыПМ);
		
	КонецЦикла; 
	
	Документ.СуммаДокумента = Документ[ИмяТабЧасти].Итог("Сумма");
	
КонецПроцедуры

Процедура ЗаполнитьВходящийДокументПоСообщению_ORDERS_УФ_БП(Документ, Сообщение, ПараметрыЗаполнения)
	
	Документ.Контрагент			= Сообщение.Покупатель1С;
	Документ.Организация		= Сообщение.Продавец1С;
	Документ.Заполнить(Неопределено);       
	
	ИмяДокументаЗаказ  = ПараметрыЗаполнения.ИмяДокументаЗаказ;
	Грузополучатель    = Сообщение.Грузополучатель1С;
	
	Если ИмяДокументаЗаказ = "РеализацияТоваровУслуг" Тогда
		
		Если ПараметрыЗаполнения.РаботаСУслугами
			И ПараметрыЗаполнения.ЗагружатьУслугиВТабЧастьУслуги
			И ПараметрыЗаполнения.ЕстьТабЧастьУслуги
			И СообщениеСодержитУслуги(Сообщение) Тогда
			
			Если СообщениеСодержитТолькоУслуги(Сообщение) Тогда
				Документ.ВидОперации = Перечисления.ВидыОперацийРеализацияТоваров.Услуги;
			Иначе
				Документ.ВидОперации = Перечисления.ВидыОперацийРеализацияТоваров.ПродажаКомиссия;
			КонецЕсли;
			
		Иначе	
			Документ.ВидОперации = Перечисления.ВидыОперацийРеализацияТоваров.Товары;
		КонецЕсли;	
		
		Документ.СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.Автоматически;
		Документы.РеализацияТоваровУслуг.ЗаполнитьСчетаУчетаРасчетов(Документ);
		Документ.БанковскийСчетОрганизации = ПараметрыПользователяEDI.СозданиеЗаказаРСчет;
		Если ЗначениеЗаполнено(Грузополучатель) Тогда 
			Документ.Грузополучатель = Грузополучатель.СвязанныйСправочник1;
			Документ.АдресДоставки   = Грузополучатель.АдресДоставки;
		КонецЕсли;
		
	ИначеЕсли ИмяДокументаЗаказ = "СчетНаОплатуПокупателю" Тогда
		
		Если ЗначениеЗаполнено(Грузополучатель) Тогда 
			Документ.АдресДоставки = Грузополучатель.АдресДоставки;
		КонецЕсли;
		Документ.СтруктурнаяЕдиница	= ПараметрыПользователяEDI.СозданиеЗаказаРСчет;
		
	КонецЕсли;
	
	флСуммаВключаетНДС = Документ.СуммаВключаетНДС;
	
	Документ.Склад				= ПараметрыЗаполнения.СоздаваемыйДокументСклад;
	Документ.ВалютаДокумента	= ВалютаУчета_КонтурEDI();
	
	ОбщийМодуль_БухгалтерскийУчетПереопределяемый = ОбщийМодуль1С_КонтурEDI("БухгалтерскийУчетПереопределяемый");
	Документ.ПодразделениеОрганизации = ОбщийМодуль_БухгалтерскийУчетПереопределяемый.ПолучитьЗначениеПоУмолчанию("ОсновноеПодразделениеОрганизации");
	
	Документ.Ответственный = ПараметрыЗаполнения.ТекущийПользователь1С;	
	
	СписокВидовДоговоров = Новый Массив;   
	Если ЕстьНеобходимыеМетаданные("Перечисления.ВидыДоговоровКонтрагентов.ЗначенияПеречисления.СПокупателем") Тогда
		СписокВидовДоговоров.Добавить(Перечисления["ВидыДоговоровКонтрагентов"].СПокупателем);
	КонецЕсли;                                                                    
	
	Попытка // реорганизация в типовой БП30 
		ОбщийМодуль_РаботаСДоговорамиКонтрагентовБП = ОбщийМодуль1С_КонтурEDI("РаботаСДоговорамиКонтрагентовБП"); 
		
		ОбщийМодуль_РаботаСДоговорамиКонтрагентовБП.УстановитьДоговорКонтрагента(Документ.ДоговорКонтрагента, Документ.Контрагент, Документ.Организация, СписокВидовДоговоров);
	Исключение 
		ОбщийМодуль_БухгалтерскийУчетПереопределяемый = ОбщийМодуль1С_КонтурEDI("БухгалтерскийУчетПереопределяемый");
		
		ОбщийМодуль_БухгалтерскийУчетПереопределяемый.УстановитьДоговорКонтрагента(Документ.ДоговорКонтрагента, Документ.Контрагент, Документ.Организация, СписокВидовДоговоров);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Документ.ДоговорКонтрагента) И ЗначениеЗаполнено(Сообщение.Договор) Тогда 
		Документ.ДоговорКонтрагента = Сообщение.Договор;
	КонецЕсли;
	
	Если ЕстьОбщийМодуль1С_КонтурEDI("УчетнаяПолитика") Тогда 
		
		ОбщийМодуль_УчетнаяПолитика = ОбщийМодуль1С_КонтурEDI("УчетнаяПолитика");
		ПлательщикНДС 				= Неопределено;
		ПлательщикНДСПрименяющийУСН = Неопределено; 
		
		Попытка
			ПлательщикНДС = ОбщийМодуль_УчетнаяПолитика.ПлательщикНДС(Документ.Организация, Документ.Дата);
			ПлательщикНДСПрименяющийУСН = ОбщийМодуль_УчетнаяПолитика.ПлательщикНДСПрименяющийУСН(Документ.Организация, Документ.Дата);
		Исключение
			ТекстОшибки = ОписаниеОшибки();
		КонецПопытки;
		
		Если ЕстьРеквизитОбъекта_Контур(Документ, "ДокументБезНДС") Тогда 
			Документ.ДокументБезНДС = НЕ (ПлательщикНДС = Истина) И НЕ (ПлательщикНДСПрименяющийУСН = Истина);
		КонецЕсли;	
		
	КонецЕсли;	
	
	РеквизитыДоговора = ПолучитьЗначенияРеквизитовОбъекта(Документ.ДоговорКонтрагента, НовыйМассив("Владелец", "ТипЦен", "ВидДоговора"));
	Если ЗначениеЗаполнено(РеквизитыДоговора.ТипЦен) Тогда
		Документ.ТипЦен           = РеквизитыДоговора.ТипЦен;
		Документ.СуммаВключаетНДС = РеквизитыДоговора.ТипЦен.ЦенаВключаетНДС;
		флСуммаВключаетНДС   	  = Документ.СуммаВключаетНДС;
	КонецЕсли;
	
	СтруктураКурсаДокумента = Неопределено;
	ОбщийМодуль_РаботаСКурсамиВалют = ОбщийМодуль1С_КонтурEDI("РаботаСКурсамиВалют");
	
	СтруктураКурсаДокумента     	 = ОбщийМодуль_РаботаСКурсамиВалют.ПолучитьКурсВалюты(Документ.ВалютаДокумента, ТекущаяДата());
	Документ.КурсВзаиморасчетов      = СтруктураКурсаДокумента.Курс;
	Документ.КратностьВзаиморасчетов = СтруктураКурсаДокумента.Кратность;
	
	ОбщийМодуль_ОтветственныеЛицаБП = ОбщийМодуль1С_КонтурEDI("ОтветственныеЛицаБП");  
	
	Если ОбщийМодуль_ОтветственныеЛицаБП <> Неопределено Тогда 
		
		Попытка
			ОбщийМодуль_ОтветственныеЛицаБП.УстановитьОтветственныхЛиц(Документ);
		Исключение 
			ТекстОшибки = ОписаниеОшибки();
		КонецПопытки;
		
		Если ИмяДокументаЗаказ = "РеализацияТоваровУслуг" 
			И ЗначениеЗаполнено(Документ.Склад) Тогда 
			Документ.ОтпускПроизвел = ОбщийМодуль_ОтветственныеЛицаБП.ОтветственноеЛицоНаСкладе(Документ.Склад, Документ.Дата);
		КонецЕсли;
		
	КонецЕсли;
	
	ТипПоставки = ТипПоставкиСообщения(Сообщение);
	
	Документ.Комментарий = "Загружен из Контур-EDI";
	Если ЗначениеЗаполнено(ТипПоставки) Тогда
		Документ.Комментарий = Документ.Комментарий + КонтурСтандарт_СтрШаблон_(", тип поставки: %1", ТипПоставки);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Документ.Дата) Тогда 
		Документ.Дата = ТекущаяДата();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Сообщение.Грузополучатель1С) Тогда
		Если ЕстьРеквизитОбъекта_Контур(Документ, "АдресДоставки") Тогда 
			Документ.АдресДоставки = Сообщение.Грузополучатель1С.АдресДоставки;
		КонецЕсли;
	КонецЕсли;

	ПараметрыПМ = Новый Структура("ДокументОбъект, Сообщение", Документ, Сообщение);
	ОбработкаСобытияПодключаемогоМодуля("ПослеЗаполненияШапкиВходящегоДокумента", , ПараметрыПМ);
	
	ИмяТабЧастиТовары = "Товары";
	ИмяТабЧастиУслуги = "Услуги";
	
	Документ[ИмяТабЧастиТовары].Очистить();

	Если ПараметрыЗаполнения.РаботаСУслугами Тогда
		Если ПараметрыЗаполнения.ЗагружатьУслугиВТабЧастьУслуги
			И ПараметрыЗаполнения.ЕстьТабЧастьУслуги Тогда
		    Документ[ИмяТабЧастиУслуги].Очистить();
		Иначе
			ИмяТабЧастиУслуги = ИмяТабЧастиТовары;	
		КонецЕсли;
	КонецЕсли;	
	
	КэшированныеЗначения = ОбработкаТабличнойЧасти_КэшированныеЗначения();

	ТоварыЗаказа = Сообщение.Товары;	
	
	Для Каждого Стр Из ТоварыЗаказа Цикл
		
		Если Стр.НеЗагружать = Истина Тогда 
			Продолжить; 
		КонецЕсли;
		
		Если Стр.ТипЕдиницы = "Services" Тогда
			Если ПараметрыЗаполнения.РаботаСУслугами Тогда
				ИмяТабЧасти = ИмяТабЧастиУслуги;
			Иначе 
				Продолжить;
			КонецЕсли;
		Иначе
			ИмяТабЧасти = ИмяТабЧастиТовары;
		КонецЕсли;
		
		НоваяСтрока = Документ[ИмяТабЧасти].Добавить();
		
		НоваяСтрока.Номенклатура = Стр.Номенклатура;
		
		// В конфигурации Бухгалтерия Универсал, редакция 3.0 (3.0.44.204) в Счет добавлены реквизиты
		Если ЕстьРеквизитОбъекта_Контур(Документ, "ЕдиницаИзмерения", ИмяТабЧасти) Тогда
			НоваяСтрока.ЕдиницаИзмерения = Стр.ЕдиницаИзмерения;
		КонецЕсли;
		Если ЕстьРеквизитОбъекта_Контур(Документ, "Коэффициент", ИмяТабЧасти) Тогда
			НоваяСтрока.Коэффициент = 1;
		КонецЕсли;			
		
		НоваяСтрока.Количество = Стр.Количество;
		
		ЗаполнитьСтавкуНДСВСтрокеТовараДокумента(Стр, НоваяСтрока, Документ.Дата);
		
		ЗаполнитьНедостающиеПоляСтрокиТоваров(Стр);
		
		Если флСуммаВключаетНДС Тогда
			НоваяСтрока.Цена = Стр.ЦенаСНДС;
		Иначе        
			НоваяСтрока.Цена = Стр.ЦенаБезНДС;
		КонецЕсли;	
		
		Модуль_ОбработкаТабличныхЧастейКлиентСервер = ОбщийМодуль1С_КонтурEDI("ОбработкаТабличныхЧастейКлиентСервер");
		Если НЕ Модуль_ОбработкаТабличныхЧастейКлиентСервер = Неопределено Тогда
			Модуль_ОбработкаТабличныхЧастейКлиентСервер.РассчитатьСуммуТабЧасти(НоваяСтрока);
			Модуль_ОбработкаТабличныхЧастейКлиентСервер.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, флСуммаВключаетНДС);
		КонецЕсли;
		
		ПараметрыПМ = Новый Структура("СтрокаТабЧасти, СтрокаСообщения, ДокументОбъект, Сообщение", НоваяСтрока, Стр, Документ, Сообщение);
		ОбработкаСобытияПодключаемогоМодуля("ПослеЗаполненияСтрокиТабличнойЧастиВходящегоДокумента", , ПараметрыПМ);
		
	КонецЦикла;
	
	Если ИмяДокументаЗаказ = "РеализацияТоваровУслуг" Тогда
		Документы.РеализацияТоваровУслуг.ЗаполнитьСчетаУчетаВТабличнойЧасти(Документ, ИмяТабЧасти);
		Документ.ДополнительныеСвойства.Вставить("ЗаполнитьСчетаУчетаПередЗаписью", Истина);
	КонецЕсли;
	
	Документ.СуммаДокумента = Документ[ИмяТабЧасти].Итог("Сумма");
	
	Если ЗначениеЗаполнено(Сообщение.Партнер) И ПараметрыЗаполнения.УстанавливатьСобственныеЦеныВЗаказах Тогда 
		ЦеныУстановлены = УстановитьСобственныеценыВЗаказ_БП(Документ);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьВходящийДокументПоСообщению_ORDERS_УФ_УТ(Документ, Сообщение, ПараметрыЗаполнения)
	
	СоздаваемыйЗаказСтатус		= ПолучитьКонстантуEDI("СоздаваемыйЗаказСтатус");
	СоздаваемыйЗаказПриоритет	= ПолучитьКонстантуEDI("СоздаваемыйЗаказПриоритет");
	ИмяДокументаЗаказ  			= ПараметрыЗаполнения.ИмяДокументаЗаказ;
	Грузополучатель    			= Сообщение.Грузополучатель1С;
	ДатаПоставки				= Сообщение.ДатаПоставки;
	
	Если ИмяДокументаЗаказ = "РеализацияТоваровУслуг" Тогда
		
		Документ.Заполнить(Неопределено);
		
		Документ.Дата	   = ТекущаяДата();
		Документ.Основание = КонтурСтандарт_СтрШаблон_("Заказ № %1 от %2", Сообщение.ДокументEDI.Номер, Сообщение.ДокументEDI.Дата);
		
		Если ЗначениеЗаполнено(ПараметрыПользователяEDI.СозданиеЗаказаРСчет) Тогда
			Документ.БанковскийСчетОрганизации = ПараметрыПользователяEDI.СозданиеЗаказаРСчет;
		КонецЕсли;
		
	Иначе
		Документ.Заполнить(Неопределено);
		
		Если ЗначениеЗаполнено(СоздаваемыйЗаказПриоритет) Тогда
			Документ.Приоритет = СоздаваемыйЗаказПриоритет;
		ИначеЕсли Не ЗначениеЗаполнено(Документ.Приоритет) Тогда
			Попытка
				СоздаваемыйЗаказПриоритет = Справочники.Приоритеты.ПолучитьПриоритетПоУмолчанию();	
			Исключение
				Попытка
					ВыборкаВсехПриоритетов = Справочники.Приоритеты.Выбрать();
					Если ВыборкаВсехПриоритетов.Следующий() Тогда 
						СоздаваемыйЗаказПриоритет = ВыборкаВсехПриоритетов.Ссылка;
					Иначе 
						СоздаваемыйЗаказПриоритет = Справочники.Приоритеты.ПустаяСсылка();
					КонецЕсли;
				Исключение // ут 11.0
					СоздаваемыйЗаказПриоритет = Перечисления.Приоритеты.Средний;
				КонецПопытки;	
			КонецПопытки;
			Документ.Приоритет = СоздаваемыйЗаказПриоритет;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СоздаваемыйЗаказСтатус) Тогда
			Документ.Статус = СоздаваемыйЗаказСтатус;
		ИначеЕсли Не ЗначениеЗаполнено(Документ.Статус) Тогда
			Документ.Статус = Перечисления.СтатусыЗаказовКлиентов.НеСогласован;	
		КонецЕсли;
		
		Документ.НомерПоДаннымКлиента = Сообщение.ДокументEDI.Номер;
		Документ.ДатаПоДаннымКлиента  = Сообщение.ДокументEDI.Дата;
		Если ЗначениеЗаполнено(ПараметрыПользователяEDI.СозданиеЗаказаРСчет) Тогда
			Документ.БанковскийСчет = ПараметрыПользователяEDI.СозданиеЗаказаРСчет;
		КонецЕсли;
		
		Документ.Склад = ПараметрыЗаполнения.СоздаваемыйДокументСклад;
		
		Если РелизКонфигурации1С = "11.2" Тогда 
			Документ.СпособДоставки = ПредопределенноеЗначение("Перечисление.СпособыДоставки.ДоКлиента");
		КонецЕсли;
		
		Документ.НеОтгружатьЧастями = Истина;
		
	КонецЕсли;
	
	Документ.Менеджер = ПараметрыЗаполнения.ТекущийПользователь1С;
	
	Если ЕстьРеквизитОбъекта_Контур(Документ, "Подразделение") Тогда   
		
		ПодразделениеМенеджера = Новый Структура("ТекущееПодразделение,Подразделение");
		ЗаполнитьЗначенияСвойств(ПодразделениеМенеджера, Документ.Менеджер);
		
		Если ЗначениеЗаполнено(ПодразделениеМенеджера.ТекущееПодразделение) Тогда
			
			Документ.Подразделение = ПодразделениеМенеджера.ТекущееПодразделение;
			
		ИначеЕсли ЗначениеЗаполнено(ПодразделениеМенеджера.Подразделение) Тогда
			
			Документ.Подразделение = ПодразделениеМенеджера.Подразделение;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Документ.Валюта			= ВалютаУчета_КонтурEDI();
	Документ.Организация	= Сообщение.Продавец1С;
	
	Документ.Контрагент		= Сообщение.Покупатель1С;
	
	// Посмотрим на значение функц. опции раздельного учета Партнеров и контрагентов
	Если УТ11_1_Константа_ИспользоватьПартнеровИКонтрагентов() 
		И СокрЛП(ПолучитьКонстантуEDI("СвойСправочникТочекДоставки")) <> "" Тогда
		
		// использованы магазины-партнеры(клиенты). Правильный учет по рекомендациям 1С.
		Документ.Партнер = Грузополучатель.СвязанныйСправочник2;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Документ.Партнер) Тогда
		ПартнерКонтрагента = ПолучитьЗначениеРеквизитаОбъекта_КонтурEDI(Документ.Контрагент, "Партнер");
		Документ.Партнер = ПартнерКонтрагента;
	КонецЕсли;
	
	Документ.Грузополучатель = Грузополучатель.СвязанныйСправочник1; // точка доставки в грузополучателе
	
	ОпределитьСоглашениеДляДокумента(Документ, Сообщение);
	
	ИспользоватьДоговорыСКлиентами = Истина;
	
	Если ЕстьНеобходимыеМетаданные("ФункциональныеОпции.ИспользоватьДоговорыСКлиентами") Тогда
		ИспользоватьДоговорыСКлиентами = ПолучитьФункциональнуюОпцию("ИспользоватьДоговорыСКлиентами");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Документ.Соглашение) Тогда
		
		Попытка
			Документ.ЗаполнитьУсловияПродажПоСоглашению();
		Исключение                                        
			// "В этом релизе УТ11.1 присутствует ошибка именования процедуры ЗаполнитьУсловияПродажПоCоглашению (Буква С - латиницей)";
			Документ.ЗаполнитьУсловияПродажПоCоглашению();
		КонецПопытки;
		
		Документ.Валюта = ПолучитьЗначениеРеквизитаОбъекта_КонтурEDI(Документ.Соглашение, "Валюта");
		
		Если ЕстьРеквизитОбъекта_Контур(Документ, "ПорядокРасчетов") Тогда 
			
			ПорядокРасчетов = Неопределено;
			ЕстьРеквизитОбъекта_Контур(Документ.Соглашение, "ПорядокРасчетов", ПорядокРасчетов);
			
			Документ.ПорядокРасчетов = ПорядокРасчетов;
			
		КонецЕсли;
		
		Если ИспользоватьДоговорыСКлиентами = Истина
			И ЕстьРеквизитОбъекта_Контур(Документ.Соглашение, "ИспользуютсяДоговорыКонтрагентов") Тогда
			
			ИспользоватьДоговорыСКлиентами = ПолучитьЗначениеРеквизитаОбъекта_КонтурEDI(Документ.Соглашение, "ИспользуютсяДоговорыКонтрагентов");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИспользоватьДоговорыСКлиентами = Истина
		И Не ЗначениеЗаполнено(Документ.Договор) 
		И ЗначениеЗаполнено(Сообщение.Договор) Тогда
		
		Документ.Договор = Сообщение.Договор;
		
	КонецЕсли; 
	
	Если ЕстьРеквизитОбъекта_Контур(Документ, "ХозяйственнаяОперация")
		И НЕ ЗначениеЗаполнено(Документ.ХозяйственнаяОперация)
		И ЕстьНеобходимыеМетаданные("Перечисления.ХозяйственныеОперации.ЗначенияПеречисления.РеализацияКлиенту") Тогда
		
		Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
		
	КонецЕсли;
		
	СкладПоУмолчанию = ПараметрыЗаполнения.СоздаваемыйДокументСклад;
	Если ЗначениеЗаполнено(СкладПоУмолчанию) Тогда
		Документ.Склад = СкладПоУмолчанию;
	КонецЕсли;
	
	УФ_УТ_ПерезаполнитьНалогообложениеНДС(Документ);
	
	флСуммаВключаетНДС = Документ.ЦенаВключаетНДС;
	
	Если ЗначениеЗаполнено(ДатаПоставки) Тогда 
		
		Если ЕстьРеквизитОбъекта_Контур(Документ, "ЖелаемаяДатаОтгрузки") Тогда			
			Документ.ЖелаемаяДатаОтгрузки = ДатаПоставки;
		КонецЕсли;
		
		Если ЕстьРеквизитОбъекта_Контур(Документ, "ДатаОтгрузки") Тогда
			Документ.ДатаОтгрузки = ДатаПоставки;
		КонецЕсли;
		
	КонецЕсли;
	
	ОбщийМодуль_ОтветственныеЛицаСервер = ОбщийМодуль1С_КонтурEDI("ОтветственныеЛицаСервер");  
	
	Если ОбщийМодуль_ОтветственныеЛицаСервер <> Неопределено Тогда 	
		
		Попытка 	                                                                     
			ОбщийМодуль_ОтветственныеЛицаСервер.ПриИзмененииСвязанныхРеквизитовДокумента(Документ);		
		Исключение
			ТекстОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
	ТипПоставки = ТипПоставкиСообщения(Сообщение);
	
	Документ.Комментарий = "Загружен из Контур-EDI";
	Если ЗначениеЗаполнено(ТипПоставки) Тогда
		Документ.Комментарий = Документ.Комментарий + КонтурСтандарт_СтрШаблон_(", тип поставки: %1", ТипПоставки);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Документ.Дата) Тогда 
		Документ.Дата = ТекущаяДата();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Сообщение.Грузополучатель1С) Тогда
		Если ЕстьРеквизитОбъекта_Контур(Документ, "АдресДоставки") Тогда 
			Документ.АдресДоставки = Сообщение.Грузополучатель1С.АдресДоставки;
		КонецЕсли;
	КонецЕсли;

	ПараметрыПМ = Новый Структура("ДокументОбъект, Сообщение", Документ, Сообщение);
	ОбработкаСобытияПодключаемогоМодуля("ПослеЗаполненияШапкиВходящегоДокумента", , ПараметрыПМ);
	
	ИмяТабЧастиТовары = "Товары";
	ИмяТабЧастиУслуги = "Услуги";
	
	Документ[ИмяТабЧастиТовары].Очистить();

	Если ПараметрыЗаполнения.РаботаСУслугами Тогда
		Если ПараметрыЗаполнения.ЗагружатьУслугиВТабЧастьУслуги
			И ПараметрыЗаполнения.ЕстьТабЧастьУслуги Тогда
		    Документ[ИмяТабЧастиУслуги].Очистить();
		Иначе
			ИмяТабЧастиУслуги = ИмяТабЧастиТовары;	
		КонецЕсли;
	КонецЕсли;	

	ЕстьРеквизитВариантОбеспечения = ЕстьРеквизитОбъекта_Контур(Документ, "ВариантОбеспечения", ИмяТабЧастиТовары);
	
	КэшированныеЗначения = ОбработкаТабличнойЧасти_КэшированныеЗначения();

	ТоварыЗаказа = Сообщение.Товары;
	
	Для Каждого Стр Из ТоварыЗаказа Цикл
		
		Если Стр.НеЗагружать = Истина Тогда 
			Продолжить; 
		КонецЕсли;
		
		Если Стр.ТипЕдиницы = "Services" Тогда
			Если ПараметрыЗаполнения.РаботаСУслугами Тогда
				ИмяТабЧасти = ИмяТабЧастиУслуги;
			Иначе 
				Продолжить;
			КонецЕсли;
		Иначе
			ИмяТабЧасти = ИмяТабЧастиТовары;
		КонецЕсли;
		
		НоваяСтрока = Документ[ИмяТабЧасти].Добавить();
		
		НоваяСтрока.Номенклатура		= Стр.Номенклатура;
		НоваяСтрока.Упаковка			= Стр.ЕдиницаИзмерения;
		НоваяСтрока.КоличествоУпаковок	= Стр.Количество;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.Упаковка) Тогда 
			НоваяСтрока.Количество = Стр.Количество;//базовая единица
		Иначе
			Если РелизКонфигурации1С = "11.2" Тогда
				//Смотреть Форма документа (Реализация товаров и услуг) ТоварыНоменклатураПриИзмененииВопросПользователюЗавершение
				
				СтруктураДействий = Новый Структура;
				
				СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
				СтруктураДействий.Вставить("ПроверитьЗаполнитьУпаковкуПоВладельцу", НоваяСтрока.Упаковка);								
				
				ОбработкаТабличнойЧастиСервер_ОбработатьСтрокуТЧ(НоваяСтрока, СтруктураДействий, КэшированныеЗначения);
				
			Иначе
				НоваяСтрока.Количество = Стр.Количество * ПолучитьКоэффициентУпаковкиУФ_УТ(НоваяСтрока.Упаковка);//в упаковках
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтрока.Склад = Документ.Склад;
		
		Если НЕ ИмяДокументаЗаказ = "РеализацияТоваровУслуг" Тогда
			
			Если ЕстьРеквизитОбъекта_Контур(Документ, "ДатаОтгрузки", ИмяТабЧасти) 
				И ЕстьРеквизитОбъекта_Контур(Документ, "ДатаОтгрузки") Тогда
				
				НоваяСтрока.ДатаОтгрузки = Документ.ДатаОтгрузки;
				
			КонецЕсли;
			
		КонецЕсли;
		
		НоваяСтрока.Характеристика = Стр.ХарактеристикаНоменклатуры;
		
		ЗаполнитьСтавкуНДСВСтрокеТовараДокумента(Стр, НоваяСтрока, Документ.Дата);
		
		ЗаполнитьНедостающиеПоляСтрокиТоваров(Стр);
		
		Если флСуммаВключаетНДС Тогда
			НоваяСтрока.Цена = Стр.ЦенаСНДС;
		Иначе        
			НоваяСтрока.Цена = Стр.ЦенаБезНДС;
		КонецЕсли;	
		
		Модуль_Ценообразование = ОбщийМодуль1С_КонтурEDI("Ценообразование");
		
		Попытка
			НоваяСтрока.СуммаНДС = Модуль_Ценообразование.РассчитатьСуммуНДС(НоваяСтрока.Сумма, НоваяСтрока.СтавкаНДС, флСуммаВключаетНДС);
		Исключение 
			Модуль_ЦенообразованиеКлиентСервер = ОбщийМодуль1С_КонтурEDI("ЦенообразованиеКлиентСервер");
			
			НоваяСтрока.СуммаНДС = Модуль_ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(НоваяСтрока.Сумма, НоваяСтрока.СтавкаНДС, флСуммаВключаетНДС);
		КонецПопытки;
		Модуль_Ценообразование.ПересчитатьСуммыВСтроке(НоваяСтрока,ложь,ложь,ложь,флСуммаВключаетНДС);
		
		Если ЕстьРеквизитВариантОбеспечения Тогда 
			Попытка //11.1 несколько из релизов
				Модуль_ОбеспечениеКлиентСервер = ОбщийМодуль1С_КонтурEDI("ОбеспечениеКлиентСервер");
				Если НЕ Модуль_ОбеспечениеКлиентСервер = Неопределено Тогда
					НоваяСтрока.ВариантОбеспечения = Модуль_ОбеспечениеКлиентСервер.ВариантОбеспеченияПоУмолчанию(НоваяСтрока.Номенклатура.ТипНоменклатуры, Ложь);
				КонецЕсли;	
			Исключение 
			КонецПопытки;
		КонецЕсли; 

		ПараметрыПМ = Новый Структура("СтрокаТабЧасти, СтрокаСообщения, ДокументОбъект, Сообщение", НоваяСтрока, Стр, Документ, Сообщение);
		ОбработкаСобытияПодключаемогоМодуля("ПослеЗаполненияСтрокиТабличнойЧастиВходящегоДокумента", , ПараметрыПМ);
		
	КонецЦикла;
	
	Если ЕстьРеквизитВариантОбеспечения и (РелизКонфигурации1С = "11.1" или РелизКонфигурации1С = "11.2") Тогда 
		
		Попытка //11.1,11.2
					
			МодульОбеспечениеВДокументах = ОбщийМодуль1С_КонтурEDI("ОбеспечениеВДокументахСервер"); 
			
			Если МодульОбеспечениеВДокументах = Неопределено Тогда
				
				МодульОбеспечениеВДокументах = ОбщийМодуль1С_КонтурEDI("ОбеспечениеСервер");
				
			КонецЕсли;
			
			ЗаполнитьОбособленно = Ложь;
					
			Попытка
				
				МодульОбеспечениеВДокументах.ЗаполнитьВариантОбеспеченияПоУмолчанию(Документ[ИмяТабЧасти], ЗаполнитьОбособленно, Документ.Статус);
				
			Исключение
								
				МодульОбеспечениеВДокументах.ЗаполнитьВариантОбеспеченияПоУмолчанию(Документ[ИмяТабЧасти], ЗаполнитьОбособленно);
				
			КонецПопытки;
			
		Исключение	
			
			Текст = ОписаниеОшибки();
						
		КонецПопытки;
		
	КонецЕсли;
	
	Если флСуммаВключаетНДС Тогда 
		Документ.СуммаДокумента = Документ[ИмяТабЧасти].Итог("Сумма");
	иначе
		Документ.СуммаДокумента = Документ[ИмяТабЧасти].Итог("СуммаСНДС");
	КонецЕсли;

	ЗаполнитьЭтапыОплатыДокументаПродажи_УФ_УТ(Документ);
			
	Если РелизКонфигурации1С = "11.1" или РелизКонфигурации1С = "11.2" Тогда 
		СкладГруппа = Справочники.Склады.ЭтоГруппаИСкладыИспользуютсяВТЧДокументовПродажи(Документ.Склад);
		Модуль_СкладыСервер = ОбщийМодуль1С_КонтурEDI("СкладыСервер");
		
		Модуль_СкладыСервер.ЗаполнитьСкладыВТабличнойЧасти(Документ.Склад, СкладГруппа, Документ[ИмяТабЧасти], Ложь);
		
		УФ_УТ_ПрименитьАвтоматическиеСкидки(Документ);
		
	ИначеЕсли РелизКонфигурации1С = "11.0" Тогда
		
		СкладГруппа = Справочники.Склады.ПустаяСсылка();
		ПараметрыУказанияСерий = Неопределено;
		
		Модуль_ЗначениеНастроекПовтИсп = ОбщийМодуль1С_КонтурEDI("ЗначениеНастроекПовтИсп");   
		
		СкладГруппа = Модуль_ЗначениеНастроекПовтИсп.ПолучитьПризнакСкладГруппаВПродажах(Документ.Склад);  
		
		Модуль_ОбработкаТабличнойЧастиСервер = ОбщийМодуль1С_КонтурEDI("ОбработкаТабличнойЧастиСервер"); 
		
		Модуль_ОбработкаТабличнойЧастиСервер.ЗаполнитьСкладыВТабличнойЧасти(Документ.Склад, СкладГруппа, Документ[ИмяТабЧасти], Ложь);
		ПараметрыУказанияСерий = Новый ФиксированнаяСтруктура(Документы.ЗаказКлиента.ПараметрыУказанияСерий(Документ));
		Если НЕ ИмяДокументаЗаказ = "РеализацияТоваровУслуг" Тогда
			Модуль_ОбработкаТабличнойЧастиСервер.ЗаполнитьСтатусыУказанияСерий(Документ, ПараметрыУказанияСерий);
		КонецЕсли;	
		
	КонецЕсли;
	
	Если НЕ ИмяДокументаЗаказ = "РеализацияТоваровУслуг" Тогда 
		Попытка   //неизвестно, начиная с какой версии они вынесли это в перед записью документа
			Выполнить("Документ.РассчитатьДатуОтгрузки()");
		Исключение
			ТекстОшибки = ОписаниеОшибки();
		КонецПопытки;
	КонецЕсли;

	Если ЗначениеЗаполнено(Сообщение.Партнер) И ПараметрыЗаполнения.УстанавливатьСобственныеЦеныВЗаказах Тогда 
		
		ЦеныУстановлены = УстановитьСобственныеценыВЗаказ_УТ(Документ);
		УФ_УТ_ПрименитьАвтоматическиеСкидки(Документ);
		ЗаполнитьЭтапыОплатыДокументаПродажи_УФ_УТ(Документ);	
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УФ_УТ_ПерезаполнитьНалогообложениеНДС(ДокументОбъект)
	
	МодульУчетНДСУП = ОбщийМодуль1С_КонтурEDI("УчетНДСУП");
	
	Если МодульУчетНДСУП = Неопределено 
		ИЛИ ДокументОбъект = Неопределено
		ИЛИ Не ПеременнаяСодержитСвойство(ДокументОбъект, "НалогообложениеНДС") Тогда
		
		Возврат;
		
	КонецЕсли;
	
	НалогообложениеДоПерезаполнения = ДокументОбъект.НалогообложениеНДС;
	ДоговорДоПерезаполнения = ДокументОбъект.Договор;
	СкладДоПерезаполнения = ДокументОбъект.Склад;
	
	Попытка
		
		МенеджерДокумента = МенеджерОбъектаПоСсылке_КонтурEDI(ДокументОбъект.Ссылка);
		
		ДокументОбъект.Договор = Неопределено;
		ДокументОбъект.Склад = Неопределено;
		
		КэшированныеЗначенияПараметров = Неопределено;
		
		ПараметрыЗаполненияНалогообложения = МенеджерДокумента.ПараметрыЗаполненияНалогообложенияНДСПродажи(ДокументОбъект);
		МодульУчетНДСУП.ЗаполнитьНалогообложениеНДСПродажи(ДокументОбъект.НалогообложениеНДС, ПараметрыЗаполненияНалогообложения, КэшированныеЗначенияПараметров);		
		
		ДокументОбъект.Договор = ДоговорДоПерезаполнения;
		ДокументОбъект.Склад = СкладДоПерезаполнения;
		
		ДокументОбъект.НалогообложениеНДС = Неопределено;
		
		ПараметрыЗаполненияНалогообложения = МенеджерДокумента.ПараметрыЗаполненияНалогообложенияНДСПродажи(ДокументОбъект);
		МодульУчетНДСУП.ЗаполнитьНалогообложениеНДСПродажи(ДокументОбъект.НалогообложениеНДС, ПараметрыЗаполненияНалогообложения, КэшированныеЗначенияПараметров);
		
		Если ДокументОбъект.НалогообложениеНДС = Неопределено Тогда
			ДокументОбъект.НалогообложениеНДС = НалогообложениеДоПерезаполнения;
		КонецЕсли;
		
	Исключение
		
		ДокументОбъект.НалогообложениеНДС = НалогообложениеДоПерезаполнения;
		ДокументОбъект.Договор = ДоговорДоПерезаполнения;
		ДокументОбъект.Склад = СкладДоПерезаполнения;
		
	КонецПопытки;	
	
КонецПроцедуры

Функция ОбработкаТабличнойЧасти_КэшированныеЗначения()
	
	КэшированныеЗначения = ЭДО_Кэш_Прочитать("ОбработкаТЧ_КэшированныеЗначения");
		
	Если КэшированныеЗначения = Неопределено Тогда
		
		Попытка
			КэшированныеЗначения = ОбработкаТабличнойЧастиКлиентСервер_ПолучитьСтруктуруКэшируемыеЗначения();
		Исключение
			ТекстОшибки = ОписаниеОшибки();	
		КонецПопытки;
		
		Если КэшированныеЗначения  = Неопределено Тогда
			ОбщийМодуль_ОбработкаТабличнойЧастиТоварыКлиентСервер = ОбщийМодуль1С_КонтурEDI("ОбработкаТабличнойЧастиТоварыКлиентСервер");
			
			Если ОбщийМодуль_ОбработкаТабличнойЧастиТоварыКлиентСервер <> Неопределено Тогда
				
				Попытка 
					
					КэшированныеЗначения = ОбщийМодуль_ОбработкаТабличнойЧастиТоварыКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
					
				Исключение       
					
					Попытка
						
						КэшированныеЗначения = ОбщийМодуль_ОбработкаТабличнойЧастиТоварыКлиентСервер.СтруктураКэшируемыхЗначений(); 
						
					Исключение 
						
						КэшированныеЗначения = Неопределено;	
						
					КонецПопытки; 
					
				КонецПопытки;
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли;	 
	
	ЭДО_Кэш_Поместить("ОбработкаТЧ_КэшированныеЗначения", КэшированныеЗначения);
	
	Возврат КэшированныеЗначения;
	
КонецФункции

Процедура УстановитьПризнакОбменДаннымиВДокументе_КонтурEDI(Документ)
		
	ПризнакОбменДаннымиПриСозданииДокументов = 
	(ПолучитьКонстантуEDI("ПризнакОбменДаннымиПриСозданииДокументов") = Истина);
	
	Если ПризнакОбменДаннымиПриСозданииДокументов Тогда
		
		Документ.ОбменДанными.Загрузка = Истина;
		
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьДокументВыставленЭлектронно(ДокументСсылка, ДатаВыставления = Неопределено)
	
	НачатьТранзакцию();
	
	Попытка
		
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
		
		ЗаполнитьДокументВыставленЭлектронно(ДокументОбъект);
		ЗаполнитьДатуВыставления(ДокументОбъект, ДатаВыставления);
		
		ДокументОбъект.Записать(?(ДокументОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		
		ТекстОшибки = "Не удалось установить признак ""выставлен электронно"" документу " + Строка(ДокументСсылка) + Символы.ПС + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаполнитьДатуВыставления(ДокументОбъект, ДатаВыставления)
	
	Если ДокументОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ПеременнаяСодержитСвойство(ДокументОбъект, "ДатаВыставления") Тогда
		ДокументОбъект.ДатаВыставления = ДатаВыставления;		
	КонецЕсли;                                           
	
КонецПроцедуры
	
Процедура ЗаполнитьДокументВыставленЭлектронно(ДокументОбъект)
	
	Если ДокументОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ПеременнаяСодержитСвойство(ДокументОбъект, "ВыставленВЭлектронномВиде") Тогда
		ДокументОбъект.ВыставленВЭлектронномВиде = Истина;
	КонецЕсли;
	
	Если ПеременнаяСодержитСвойство(ДокументОбъект, "КодСпособаВыставления") Тогда
		ДокументОбъект.КодСпособаВыставления = 2;
	КонецЕсли;
	
	Если ПеременнаяСодержитСвойство(ДокументОбъект, "Выставлен") Тогда
		ДокументОбъект.Выставлен = Истина;
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьКоэффициентУпаковкиУФ_УТ(Упаковка)
	
	Если ПеременнаяСодержитСвойство(Упаковка, "Коэффициент") Тогда
		Коэффициент = Упаковка.Коэффициент;
	ИначеЕсли Упаковка.Знаменатель > 0 Тогда
		Коэффициент = Упаковка.Числитель / Упаковка.Знаменатель;
	Иначе
		Коэффициент = 1;	
	КонецЕсли;
	
	Возврат Коэффициент;
	
Конецфункции

Процедура ОпределитьСоглашениеДляДокумента(Документ, Сообщение)
	
	//Порядок подбора соглашения:
	//1) Определяем из события ПМа
	//2) Определяем из настройки партнера
	//3) Определяем типовым методом документа "ЗаполнитьУсловияПродажПоУмолчанию"                        
	//4) Определяем собственной функцией "ПолучитьСоглашенияДляЗаказаКлиента_КонтурEDI"
	
	Документ.Соглашение = Неопределено;
		
	РезультатПМ = ОбработкаСобытияПодключаемогоМодуля("ПолучитьСоглашениеДляДокументаУТ_УФ",,
													  Новый Структура("Документ,Сообщение", 
													  			Документ, Сообщение));
													  													
	Если ЗначениеЗаполнено(РезультатПМ) Тогда
		Документ.Соглашение = РезультатПМ;													  
  	КонецЕсли;

	Если Не ЗначениеЗаполнено(Документ.Соглашение) Тогда
		Документ.Соглашение = ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, "СоглашениеПоУмолчанию"); 
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Документ.Соглашение) Тогда
		Документ.ЗаполнитьУсловияПродажПоУмолчанию();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Документ.Соглашение) Тогда
		Попытка
			Документ.Соглашение = ПолучитьСоглашенияДляЗаказаКлиента_КонтурEDI(Документ, Сообщение);
		Исключение
			ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось получить соглашение для документа. " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьЭтапыОплатыДокументаПродажи_УФ_УТ(Документ)
	
	Попытка
		
		Если НЕ ЕстьТабличнаяЧастьОбъекта_Контур(Документ, "ЭтапыГрафикаОплаты") Тогда
			Возврат;
		КонецЕсли;
		
		
		Попытка
			
			Документ.ЗаполнитьЭтапыГрафикаОплаты();
			
		Исключение
			
			ОбщийМодуль_ВзаиморасчетыСервер = ОбщийМодуль1С_КонтурEDI("ВзаиморасчетыСервер");
			
			Если ОбщийМодуль_ВзаиморасчетыСервер <> Неопределено Тогда			
				ОбщийМодуль_ВзаиморасчетыСервер.ПроверитьЗаполнитьЭтапыГрафикаОплаты(Документ);  
			КонецЕсли;
			
		КонецПопытки;
		
	Исключение 
		
		Метрика_Переменные = Новый Структура;
		Метрика_Переменные.Вставить("СинонимКонфигурации" , Метаданные.Синоним);
		Метрика_Переменные.Вставить("ПодробнаяИнформация" , Метаданные.ПодробнаяИнформация);
		Метрика_Переменные.Вставить("ВерсияКонфигурации"  , Метаданные.Версия);
		Метрика_Переменные.Вставить("ТипДокумента"		  , Строка(ТипЗнч(Документ)));
		
		Контрагент = ПолучитьРеквизитДокументаДляСообщения(Документ,"Контрагент");		
		Если ЗначениеЗаполнено(Контрагент) Тогда
			Партнер = ОпределитьПартнера(Новый Структура("ТипЗначения, ЮрФизЛицо", "ЮрФизЛицо", Контрагент));
			Если Не Партнер = Неопределено Тогда
				Метрика_Переменные.Вставить("НастройкиПартнера", ПолучитьЗначенияНастроекПартнеров(Партнер,Истина));
			КонецЕсли;
		КонецЕсли;
		
		_ОписаниеОшибки = ОписаниеОшибки();
		_ИнформацияОбОшибке = ИнформацияОбОшибке();
		
		Метрика_ОтправитьСразу = Истина;
		Метрика_Ошибка("ЗаполнитьЭтапыОплатыДокументаПродажи_УФ_УТ", _ОписаниеОшибки, _ИнформацияОбОшибке, Метрика_Переменные, Метрика_ОтправитьСразу);	
		
	КонецПопытки;
	
КонецПроцедуры

Функция ПолучитьСоглашенияДляЗаказаКлиента_КонтурEDI(Док, Сообщение)
		
	СоглашениеПоУмолчанию = ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, "СоглашениеПоУмолчанию"); 
	Если ЗначениеЗаполнено(СоглашениеПоУмолчанию) Тогда
		Возврат СоглашениеПоУмолчанию;
	КонецЕсли;
	
	Соглашение = Док.Соглашение;
	
	Если Не ПолучитьФункциональнуюОпцию_КонтурEDI("ИспользоватьСоглашенияСКлиентами") = Истина Тогда
		Возврат Соглашение;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СправочникСоглашенияСКлиентами.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА СправочникСоглашенияСКлиентами.Организация = &Организация
	|				И СправочникСоглашенияСКлиентами.Контрагент = &Контрагент
	|			ТОГДА 3
	|		КОГДА СправочникСоглашенияСКлиентами.Контрагент = &Контрагент
	|			ТОГДА 2
	|		КОГДА СправочникСоглашенияСКлиентами.Организация = &Организация
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Приоритет
	|ИЗ
	|	Справочник.СоглашенияСКлиентами КАК СправочникСоглашенияСКлиентами
	|ГДЕ
	|	СправочникСоглашенияСКлиентами.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыСоглашенийСКлиентами.Действует)
	|	И НЕ СправочникСоглашенияСКлиентами.ПометкаУдаления
	|	И ВЫБОР
	|			КОГДА &ТолькоТиповые = ИСТИНА
	|					И &ТолькоИндивидуальные = ЛОЖЬ
	|					И (СправочникСоглашенияСКлиентами.Типовое
	|						И (СправочникСоглашенияСКлиентами.СегментПартнеров = ЗНАЧЕНИЕ(Справочник.СегментыПартнеров.ПустаяСсылка)
	|							ИЛИ СправочникСоглашенияСКлиентами.СегментПартнеров В
	|								(ВЫБРАТЬ
	|									ПартнерыСегмента.Сегмент
	|								ИЗ
	|									РегистрСведений.ПартнерыСегмента КАК ПартнерыСегмента
	|								ГДЕ
	|									ПартнерыСегмента.Партнер = &Партнер)))
	|				ТОГДА ИСТИНА
	|			КОГДА &ТолькоИндивидуальные = ИСТИНА
	|					И НЕ &ТолькоТиповые = ИСТИНА
	|					И (НЕ СправочникСоглашенияСКлиентами.Типовое
	|						И (СправочникСоглашенияСКлиентами.СегментПартнеров = ЗНАЧЕНИЕ(Справочник.СегментыПартнеров.ПустаяСсылка)
	|							ИЛИ СправочникСоглашенияСКлиентами.СегментПартнеров В
	|								(ВЫБРАТЬ
	|									ПартнерыСегмента.Сегмент
	|								ИЗ
	|									РегистрСведений.ПартнерыСегмента КАК ПартнерыСегмента
	|								ГДЕ
	|									ПартнерыСегмента.Партнер = &Партнер)))
	|					И (&Партнер = ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
	|						ИЛИ СправочникСоглашенияСКлиентами.Партнер = &Партнер)
	|				ТОГДА ИСТИНА
	|			КОГДА &ТолькоТиповые = ЛОЖЬ
	|					И &ТолькоИндивидуальные = ЛОЖЬ
	|					И (СправочникСоглашенияСКлиентами.СегментПартнеров = ЗНАЧЕНИЕ(Справочник.СегментыПартнеров.ПустаяСсылка)
	|						ИЛИ СправочникСоглашенияСКлиентами.СегментПартнеров В
	|							(ВЫБРАТЬ
	|								ПартнерыСегмента.Сегмент
	|							ИЗ
	|								РегистрСведений.ПартнерыСегмента КАК ПартнерыСегмента
	|							ГДЕ
	|								ПартнерыСегмента.Партнер = &Партнер)
	|						ИЛИ &Партнер = ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка))
	|					И (&Партнер = ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
	|						ИЛИ СправочникСоглашенияСКлиентами.Партнер = ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
	|						ИЛИ СправочникСоглашенияСКлиентами.Партнер = &Партнер)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ
	|	И (СправочникСоглашенияСКлиентами.Организация = &Организация
	|			ИЛИ СправочникСоглашенияСКлиентами.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	|
	|УПОРЯДОЧИТЬ ПО
	|	СправочникСоглашенияСКлиентами.Типовое,
	|	Приоритет УБЫВ";
	
	Запрос.УстановитьПараметр("Организация",			Док.Организация);
	Запрос.УстановитьПараметр("Партнер",				Док.Партнер);	
	Запрос.УстановитьПараметр("Контрагент",				Док.Контрагент);
	Запрос.УстановитьПараметр("ДатаДокумента",			?(ЗначениеЗаполнено(Док.Дата), НачалоДня(Док.Дата), НачалоДня(ТекущаяДатаСеанса()))); 	
	
	ИспользоватьТиповыеСоглашенияСКлиентами			= ПолучитьФункциональнуюОпцию_КонтурEDI("ИспользоватьТиповыеСоглашенияСКлиентами") = Истина;
	ИспользоватьИндивидуальныеСоглашенияСКлиентами	= ПолучитьФункциональнуюОпцию_КонтурEDI("ИспользоватьИндивидуальныеСоглашенияСКлиентами") = Истина;
	
	ТолькоТиповые = ИспользоватьТиповыеСоглашенияСКлиентами И НЕ ИспользоватьИндивидуальныеСоглашенияСКлиентами;
	ТолькоИндивидуальные = НЕ ИспользоватьТиповыеСоглашенияСКлиентами И ИспользоватьИндивидуальныеСоглашенияСКлиентами;
	
	Запрос.УстановитьПараметр("ТолькоТиповые",			ТолькоТиповые);
	Запрос.УстановитьПараметр("ТолькоИндивидуальные",	ТолькоИндивидуальные);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Соглашение = ВыборкаДетальныеЗаписи.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Соглашение;

КонецФункции 

Процедура УФ_УТ_ПрименитьАвтоматическиеСкидки(ДокОбъект)
	
	Если НЕ (ЕстьНеобходимыеМетаданные("ФункциональныеОпции.ИспользоватьАвтоматическиеСкидкиВПродажах") И
			ПолучитьФункциональнуюОпцию("ИспользоватьАвтоматическиеСкидкиВПродажах") = Истина) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	
	Попытка
		
		Модуль_СкидкиНаценкиЗаполнениеСервер = Неопределено;
		
		Если ЕстьОбщийМодуль1С_КонтурEDI("СкидкиНаценкиЗаполнениеСервер", Модуль_СкидкиНаценкиЗаполнениеСервер) Тогда
			
			СтруктураПараметры = Модуль_СкидкиНаценкиЗаполнениеСервер.НовыйПараметрыРассчитать();
			
			СтруктураПараметры.ПрименятьКОбъекту 				= Истина;
			СтруктураПараметры.ВосстанавливатьУправляемыеСкидки = Истина;
			
			Если СтруктураПараметры.Свойство("РеализацияСверхЗаказа") 
				И ЕстьРеквизитОбъекта_Контур(ДокОбъект, "РеализацияПоЗаказам") Тогда  
				
				Модуль_ПраваПользователяПовтИсп = ОбщийМодуль1С_КонтурEDI("ПраваПользователяПовтИсп");
				
				Если НЕ Модуль_ПраваПользователяПовтИсп = Неопределено Тогда
					
					СтруктураПараметры.РеализацияСверхЗаказа = Модуль_ПраваПользователяПовтИсп.РеализацияСверхЗаказа() И ДокОбъект.РеализацияПоЗаказам;  			
					
				КонецЕсли;
				
			КонецЕсли;
			
			
		Иначе
			
			СтруктураПараметры = Новый Структура;
			СтруктураПараметры.Вставить("ПрименятьКОбъекту",                Истина);
			СтруктураПараметры.Вставить("ТолькоПредварительныйРасчет",      Ложь);
			СтруктураПараметры.Вставить("ВосстанавливатьУправляемыеСкидки", Истина);
			СтруктураПараметры.Вставить("УправляемыеСкидки", Новый СписокЗначений);

		КонецЕсли;
		
		Модуль_СкидкиНаценкиСервер = ОбщийМодуль1С_КонтурEDI("СкидкиНаценкиСервер");
		
		Модуль_СкидкиНаценкиСервер.Рассчитать(ДокОбъект, СтруктураПараметры);
		
		ДокОбъект.СуммаДокумента = ДокОбъект.Товары.Итог("Сумма");        
		
	Исключение
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось применить скидки в документе - " + ОписаниеОшибки());	
	КонецПопытки;
	
КонецПроцедуры

Процедура ПреобразоватьТипыЕдиницыИзмеренияЗапросаУФ_УНФ(ЗапросКонвертацииТоваров1СвEDI) Экспорт
	
	
КонецПроцедуры 

Процедура ПреобразоватьТипыЕдиницыИзмеренияЗапросаУФ_УТ(Запрос) Экспорт
	
	ТабТоваровНетипизированная = Запрос.Параметры.ТаблицаТоваров;
	ТабТоваровТипизированная   = ТабТоваровНетипизированная.Скопировать(,"Номенклатура, ХарактеристикаНоменклатуры");
	ТабТоваровТипизированная.Очистить();
	
	МассивТиповУпаковки 		= Новый Массив;
	МассивТиповЕдиницыИзмерения = Новый Массив;
	
	Если ЕстьНеобходимыеМетаданные("Справочники.ЕдиницыИзмерения") Тогда
		МассивТиповЕдиницыИзмерения.Добавить(Тип("СправочникСсылка.ЕдиницыИзмерения"));
	КонецЕсли;
	
	Если ЕстьНеобходимыеМетаданные("Справочники.УпаковкиНоменклатуры") Тогда
		МассивТиповЕдиницыИзмерения.Добавить(Тип("СправочникСсылка.УпаковкиНоменклатуры"));
		МассивТиповУпаковки.Добавить(Тип("СправочникСсылка.УпаковкиНоменклатуры"));
	КонецЕсли;
	
	Если ЕстьНеобходимыеМетаданные("Справочники.УпаковкиЕдиницыИзмерения") Тогда
		МассивТиповЕдиницыИзмерения.Добавить(Тип("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
		МассивТиповУпаковки.Добавить(Тип("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	КонецЕсли;
	
	ТипУпаковки 	    = Новый ОписаниеТипов(МассивТиповУпаковки);
	ТипЕдиницыИзмерения = Новый ОписаниеТипов(МассивТиповЕдиницыИзмерения);
	
	ТабТоваровТипизированная.Колонки.Добавить("Упаковка"		, ТипУпаковки);
	ТабТоваровТипизированная.Колонки.Добавить("ЕдиницаИзмерения", ТипЕдиницыИзмерения);	
	
	ТипХарактеристикаНоменклатуры     = ПолучитьТипЗначенияОбъекта("ХарактеристикаНоменклатуры");
	ЕстьТипХарактеристикаНоменклатуры = НЕ ТипХарактеристикаНоменклатуры = Неопределено;
	
	Если ЕстьТипХарактеристикаНоменклатуры Тогда
		ОписаниеТипаХарактеристикаНоменклатуры = Новый ОписаниеТипов(ТипХарактеристикаНоменклатуры);
	КонецЕсли;
	
	Для каждого СтрокаТоваровНетипизированнойТЗ из ТабТоваровНетипизированная Цикл
		
		НоваяСтрокаТипизированнойТЗ = ТабТоваровТипизированная.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТипизированнойТЗ, СтрокаТоваровНетипизированнойТЗ); 
		
		Если ТипЗнч(СтрокаТоваровНетипизированнойТЗ.ЕдиницаИзмерения) = ТипЗнч(НоваяСтрокаТипизированнойТЗ.Упаковка) Тогда
			НоваяСтрокаТипизированнойТЗ.Упаковка = СтрокаТоваровНетипизированнойТЗ.ЕдиницаИзмерения;
		КонецЕсли;
		
		Если ЕстьТипХарактеристикаНоменклатуры
			И СтрокаТоваровНетипизированнойТЗ.ХарактеристикаНоменклатуры = Неопределено Тогда
			НоваяСтрокаТипизированнойТЗ.ХарактеристикаНоменклатуры = ОписаниеТипаХарактеристикаНоменклатуры.ПривестиЗначение();
		КонецЕсли;
		
	КонецЦикла;
	
	ОписаниеТипаУпаковки = Новый ОписаниеТипов(ТипУпаковки);
	ПустаяСсылкаУпаковки = ОписаниеТипаУпаковки.ПривестиЗначение(); 
	
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВЫБРАТЬ РАЗЛИЧНЫЕ
											|	Таб.Номенклатура КАК Номенклатура,
											|	Таб.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
											|	Таб.ЕдиницаИзмерения КАК ЕдиницаИзмерения",
											 "ВЫБРАТЬ РАЗЛИЧНЫЕ
											|	Таб.Номенклатура КАК Номенклатура,
											|	Таб.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
											|	Таб.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
											|	Таб.Упаковка КАК Упаковка");
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИНДЕКСИРОВАТЬ ПО
											|	Номенклатура,
											|	ХарактеристикаНоменклатуры,
											|	ЕдиницаИзмерения",
											 "ИНДЕКСИРОВАТЬ ПО
											|	Номенклатура,
											|	ХарактеристикаНоменклатуры,
											|	ЕдиницаИзмерения,
											|	Упаковка"); 					
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВЫБРАТЬ РАЗЛИЧНЫЕ
											|	_ТабТоваров.Номенклатура,
											|	_ТабТоваров.ХарактеристикаНоменклатуры,
											|	_ТабТоваров.ЕдиницаИзмерения,
											|	_ТабТоваров.Номенклатура.Код КАК КодТовараСвой",
											"ВЫБРАТЬ РАЗЛИЧНЫЕ
											|	_ТабТоваров.Номенклатура,
											|	_ТабТоваров.ХарактеристикаНоменклатуры,
											|	_ТабТоваров.ЕдиницаИзмерения,
											|	_ТабТоваров.Номенклатура.Код КАК КодТовараСвой,
											|	_ТабТоваров.Упаковка КАК Упаковка");
	
	
	Запрос.УстановитьПараметр("ПустаяСсылкаУпаковки", ПустаяСсылкаУпаковки);  
	Запрос.Параметры.ТаблицаТоваров = ТабТоваровТипизированная;
	
КонецПроцедуры

Функция ПолучитьТаблицуДокументовДляПривязки_к_ORDERS(ДокументСсылка,НачалоПериода,КонецПериода) Экспорт
	
	//предложим привязать другие заказы/реализации к ORDERS	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РеализацияТоваровУслуг.Ссылка,
	|	РеализацияТоваровУслуг.Номер,
	|	РеализацияТоваровУслуг.Дата,
	|	РеализацияТоваровУслуг.Проведен,
	|	РеализацияТоваровУслуг.СуммаДокумента КАК СуммаДокумента,
	|	РеализацияТоваровУслуг.Склад КАК Склад,
	|	РеализацияТоваровУслуг.Комментарий КАК Комментарий,
	|	РеализацияТоваровУслуг.Контрагент КАК Контрагент,
	|	РеализацияТоваровУслуг.Организация КАК Организация,
	|	РеализацияТоваровУслуг.Грузополучатель КАК Грузополучатель
	|ПОМЕСТИТЬ ВТДокументы
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|ГДЕ
	|	РеализацияТоваровУслуг.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И РеализацияТоваровУслуг.Организация = &Организация
	|	И РеализацияТоваровУслуг.Контрагент = &Контрагент
	|	И НЕ РеализацияТоваровУслуг.ПометкаУдаления
	|	И РеализацияТоваровУслуг.Грузополучатель = &Грузополучатель
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|");
	
	_ТипДокументаЗаказ = ПолучитьТипЗначенияОбъекта("ВходящийЗаказПокупателя",, Истина);
	
	Если ИспользоватьМаппингМетаданных Тогда
		
		МассивИдентификаторов = Новый Массив;
		МассивИдентификаторов.Добавить("СуммаДокумента");
		МассивИдентификаторов.Добавить("Склад");
		МассивИдентификаторов.Добавить("Комментарий");
		МассивИдентификаторов.Добавить("Контрагент");
		МассивИдентификаторов.Добавить("Организация");
		МассивИдентификаторов.Добавить("Грузополучатель");
		
		Для каждого Идентификатор Из МассивИдентификаторов Цикл
			ИмяРеквизита = ПолучитьИмяРеквизитаПоИдентификаторуОбъектаМетаданных(_ТипДокументаЗаказ, Идентификатор);
			
			Если Идентификатор = "Организация" Тогда
				ИмяРеквизитаОрганизация = ИмяРеквизита;
			ИначеЕсли Идентификатор = "Контрагент" Тогда 
				ИмяРеквизитаКонтрагент = ИмяРеквизита;
			ИначеЕсли Идентификатор = "Грузополучатель" Тогда 
				ИмяРеквизитаГрузополучатель = ИмяРеквизита;
			КонецЕсли;
			
			Если ИмяРеквизита <> Неопределено Тогда
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "РеализацияТоваровУслуг." + Идентификатор, "РеализацияТоваровУслуг." + ИмяРеквизита);
			Иначе
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "РеализацияТоваровУслуг." + Идентификатор, """""");
			КонецЕсли;
		КонецЦикла;

		Если ИмяРеквизитаГрузополучатель = Неопределено Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И РеализацияТоваровУслуг.Грузополучатель = &Грузополучатель", "");
		Иначе
			Запрос.УстановитьПараметр("Грузополучатель", ДокументСсылка[ИмяРеквизитаГрузополучатель]);
		КонецЕсли;
		
	Иначе
		
		МетаданныеДокументаЗаказа = Метаданные.Документы[_ТипДокументаЗаказ];
		
		Если МетаданныеДокументаЗаказа.Реквизиты.Найти("Грузополучатель") = Неопределено Тогда
			//уберем этот реквизит из запроса
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И РеализацияТоваровУслуг.Грузополучатель = &Грузополучатель", "");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "РеализацияТоваровУслуг.Грузополучатель", """""");
		Иначе
			Запрос.УстановитьПараметр("Грузополучатель", ДокументСсылка.Грузополучатель);
		КонецЕсли;	
		
		//Поле Склад может в документе называться по-другому или вообще отсутствовать. Соберем наиболее часто встречающиеся случаи:
		Если МетаданныеДокументаЗаказа.Реквизиты.Найти("СкладГруппа") <> Неопределено Тогда
			//если у нас ЗаказПокупателя из УТ,УПП,КА
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "РеализацияТоваровУслуг.Склад", "РеализацияТоваровУслуг.СкладГруппа");
			
		ИначеЕсли МетаданныеДокументаЗаказа.Реквизиты.Найти("СкладКомпании") <> Неопределено Тогда
			//для ТКПТ
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "РеализацияТоваровУслуг.Склад", "РеализацияТоваровУслуг.СкладКомпании");
			
		ИначеЕсли МетаданныеДокументаЗаказа.Реквизиты.Найти("Склад") = Неопределено Тогда
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "РеализацияТоваровУслуг.Склад", """""");
			
		КонецЕсли;	
		
		Если МетаданныеДокументаЗаказа.Реквизиты.Найти("СуммаДокумента") = Неопределено Тогда
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "РеализацияТоваровУслуг.СуммаДокумента", "0");
			
		КонецЕсли;
		
		ИмяРеквизитаОрганизация = ?(ИмяКонфигурации1С = "ДалионУМ" ИЛИ ИмяКонфигурации1С = "АСТОР", "Фирма", "Организация");
		ИмяРеквизитаКонтрагент = "Контрагент";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "РеализацияТоваровУслуг.Организация", "РеализацияТоваровУслуг." + ИмяРеквизитаОрганизация);
		
	КонецЕсли;	

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "РеализацияТоваровУслуг", _ТипДокументаЗаказ);
	
	Запрос.УстановитьПараметр("ДатаНач",		НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("ДатаКон",		КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("Организация",	ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Организация"));
	Запрос.УстановитьПараметр("Контрагент",		ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Контрагент"));
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	РезультатПМ = ОбработкаСобытияПодключаемогоМодуля("ИзменитьЗапросПоДокументамДляПривязки_к_ORDERS",,
														Новый Структура("Запрос,ДокументСсылка", Запрос, ДокументСсылка));
	
	Если РезультатПМ <> Неопределено И ТипЗнч(РезультатПМ) = Тип("Запрос") Тогда
		Запрос = РезультатПМ;
	КонецЕсли;

	
	Запрос.Выполнить();
	
	ТекстЗапросаПоСообщениям = 
	"
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТДокументы.Ссылка,
	|	ВТДокументы.Номер,
	|	ВТДокументы.Дата,
	|	ВТДокументы.Проведен,
	|	ВТДокументы.СуммаДокумента,
	|	ВТДокументы.Склад,
	|	ВТДокументы.Комментарий,
	|	ВТДокументы.Контрагент,
	|	ВТДокументы.Организация,
	|	ВТДокументы.Грузополучатель
	|ИЗ
	|	ВТДокументы КАК ВТДокументы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|		ПО ВТДокументы.Ссылка = КонтурEDI_Сообщения.Документ
	|			И (КонтурEDI_Сообщения.ТипСообщения = ""ORDERS"")
	|ГДЕ
	|	КонтурEDI_Сообщения.Ссылка ЕСТЬ NULL ";
	
	Если ВнешнееХранилище Тогда
		Запрос.Текст = "Выбрать * Из ВТДокументы";
		ВремТаб = Запрос.Выполнить().Выгрузить();
		Запрос_Внешний = СоединениеСХранилищем.NewObject("Запрос");
		Запрос_Внешний.УстановитьПараметр("ВТДокументы", ПоместитьТаблицуВоВнешнююБазу(ВремТаб));
		Запрос_Внешний.Текст = "Выбрать _ВТДокументы.* Поместить ВТДокументы Из &ВТДокументы как _ВТДокументы Индексировать по Ссылка; "
								+ ТекстЗапросаПоСообщениям;
		Таб = Запрос_Внешний.Выполнить().Выгрузить();
		
		СтруктураПреобразованияКолонок = Новый Структура;
		СтруктураПреобразованияКолонок.Вставить("Организация",		Новый ОписаниеТипов(ПолучитьТипЗначенияОбъекта("ЮрФизЛицоСвое",,)));
		СтруктураПреобразованияКолонок.Вставить("Контрагент",		Новый ОписаниеТипов(ПолучитьТипЗначенияОбъекта("ЮрФизЛицоСтороннее",,)));
		СтруктураПреобразованияКолонок.Вставить("Грузополучатель",	Новый ОписаниеТипов(ПолучитьТипЗначенияОбъекта("ЮрФизЛицоСтороннее",,)));
		
		ТипСклад = ПолучитьТипЗначенияОбъекта("ТочкаДоставкиСвоя");
		СтруктураПреобразованияКолонок.Вставить("Склад",	Новый ОписаниеТипов(ТипСклад));
		
		СтруктураПреобразованияКолонок.Вставить("Ссылка",	Документы.ТипВсеСсылки());
		
		Таб = ПолучитьТаблицуИзВнешнейБазы(Таб, СтруктураПреобразованияКолонок);
		
	Иначе
		Запрос.Текст = ТекстЗапросаПоСообщениям;
		Таб = Запрос.Выполнить().Выгрузить();
	КонецЕсли;	
	
	Возврат Таб;
	
КонецФункции

Процедура ЗаполнитьДокументПоступленияНаОснованииСообщения(Сообщение, Документ, Заказ)	
	
	ПризнакиУчетаНДС = ЗаполнитьШапкуПоступленияИПолучитьПризнакиУчетаНДС(Документ, Сообщение, Заказ);
	
	ЗаполнитьТабличнуюЧастьПоступленияНаОснованииСообщения(Сообщение, Документ, Заказ, ПризнакиУчетаНДС);
	
	ПослеЗаполненияТабличнойЧастиПоступления(Документ);
	
	ЗаписатьОтменитьПроведениеДокумента(Документ);
	
КонецПроцедуры

Процедура ЗаписатьОтменитьПроведениеДокумента(ДокументОбъект) Экспорт
	
	Если ДокументОбъект.Проведен Тогда
		РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения;
	Иначе
		РежимЗаписи = РежимЗаписиДокумента.Запись;
	КонецЕсли;
	
	ДокументОбъект.Записать(РежимЗаписи);			
		
КонецПроцедуры

Функция ЗаполнитьШапкуПоступленияИПолучитьПризнакиУчетаНДС(Документ, Сообщение, Заказ)
	
	флУчитыватьНДС = Неопределено;
	флСуммаВключаетНДС = Неопределено;
	
	Если ИмяКонфигурации1С = "ТКПТ" Тогда
		
		Документ.ВхДокНомер	= Сообщение.ДокументEDI.Номер;
		Документ.ВхДокДата	= Сообщение.ДокументEDI.Дата;
		
		флСуммаВключаетНДС = Истина;
		Если ЗначениеЗаполнено(Документ.ТипЦен) Тогда
			ФлСуммаВключаетНДС = Документ.ТипЦен.ЦенаВключаетНДС;
		КонецЕсли;
		
	ИначеЕсли ИмяКонфигурации1С = "АСТОР" Тогда
		Документ.СтруктурнаяЕдиница = Заказ.СтруктурнаяЕдиница;
		Запрос = Новый Запрос( 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияСвойствОбъектов.Значение КАК Склад
		|ИЗ
		|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
		|ГДЕ
		|	ЗначенияСвойствОбъектов.Объект = &Объект
		|	И ЗначенияСвойствОбъектов.СтруктурнаяЕдиница = &СтруктурнаяЕдиница
		|	И ЗначенияСвойствОбъектов.Свойство = &Свойство");
		
		ТекПользователь = Неопределено;
		Выполнить("ТекПользователь = глЗначениеПеременной(""глТекущийПользователь"")");
		Запрос.УстановитьПараметр("Объект", 			ТекПользователь);
		Запрос.УстановитьПараметр("СтруктурнаяЕдиница", Документ.СтруктурнаяЕдиница);
		Запрос.УстановитьПараметр("Свойство", 			ПланыВидовХарактеристик.СвойстваОбъектов.Склад);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если НЕ РезультатЗапроса.Пустой() Тогда
			
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			
			Документ.Склад = Выборка.Склад;
			
		КонецЕсли;
		
		Документ.НомерДокумента	= Сообщение.ДокументEDI.Номер;
		Документ.ДатаДокумента	= Сообщение.ДокументEDI.Дата;
		
		флСуммаВключаетНДС = Истина;
		Попытка
			Выполнить("флУчитыватьНДС = ОмУчетНДС.НДС(Документ.Фирма);");
		Исключение
			ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось определить признак учета НДС для конфигурации - " + ОписаниеОшибки());
		КонецПопытки;
		
	ИначеЕсли ИмяКонфигурации1С = "ДалионУМ" Тогда
		Документ.ВидОперации 		= Перечисления.ВидыОперацийПриходнаяНакладная.НаСклад;
		Документ.ВходящийНомер 		= Сообщение.ДокументEDI.Номер;
		Документ.ДатаСчетаФактуры    = Сообщение.ДокументEDI.Дата;	//почему-то реквизит называется "ДатаСчетаФактуры"
		флУчитыватьНДС			= Документ.УчитыватьНДС;
		флСуммаВключаетНДС		= Документ.СуммаВключаетНДС;
	ИначеЕсли ИмяКонфигурации1С = "ДалионТРЕНД" ИЛИ ИмяКонфигурации1С = "УФ_ДалионТРЕНД"  Тогда
		
		Документ.ВидОперации				= Перечисления.ВидыОперацийПриходнойНакладной.НаСклад;
		Документ.НомерВходящегоДокумента	= Сообщение.ДокументEDI.Номер;
		Документ.ДатаВходящегоДокумента  = Сообщение.ДокументEDI.Дата;	
		флУчитыватьНДС				= Документ.УчитыватьНДС;
		флСуммаВключаетНДС			= Документ.ЦенаВключаетНДС;	
	ИначеЕсли ИмяКонфигурации1С = "ШтрихМ_РС" Тогда
		Документ.ВходящийНомерДокумента	= Сообщение.ДокументEDI.Номер;
		Документ.ВходящаяДатаДокумента	= Сообщение.ДокументEDI.Дата;	
		флСуммаВключаетНДС = Истина;
		Если ЗначениеЗаполнено(Документ.ТипЦен) Тогда
			ФлСуммаВключаетНДС = Документ.ТипЦен.ЦенаВключаетНДС;
		КонецЕсли;	
	ИначеЕсли ИмяКонфигурации1С = "УФ_УТ" Тогда
		Документ.НомерВходящегоДокумента	= Сообщение.ДокументEDI.Номер;
		Документ.ДатаВходящегоДокумента	= Сообщение.ДокументEDI.Дата;
		//флУчитыватьНДС		= Док.УчитыватьНДС;  //не будет использоваться
		флСуммаВключаетНДС	= Документ.ЦенаВключаетНДС;	
	ИначеЕсли ИмяКонфигурации1С = "УФ_Розница" Тогда
		
		Документ.НомерВходящегоДокумента	= Сообщение.ДокументEDI.Номер;
		Документ.ДатаВходящегоДокумента	= Сообщение.ДокументEDI.Дата;  
		
		Документ.ЦенаВключаетНДС = ПолучитьРеквизитДокументаДляСообщения(Заказ, "СуммаВключаетНДС");
        	
		флСуммаВключаетНДС	= Документ.ЦенаВключаетНДС;
		
	ИначеЕсли ИмяКонфигурации1С = "УФ_БП" Тогда
		Документ.НомерВходящегоДокумента	= Сообщение.ДокументEDI.Номер;
		Документ.ДатаВходящегоДокумента	= Сообщение.ДокументEDI.Дата;
		//флУчитыватьНДС		= Док.УчитыватьНДС;  //не будет использоваться
		флСуммаВключаетНДС	= Документ.СуммаВключаетНДС;
	ИначеЕсли ИмяКонфигурации1С = "УФ_УНФ" Тогда
		Документ.НомерВходящегоДокумента	= Сообщение.ДокументEDI.Номер;
		Документ.ДатаВходящегоДокумента	= Сообщение.ДокументEDI.Дата;
		флСуммаВключаетНДС	= ПолучитьРеквизитДокументаДляСообщения(Заказ, "СуммаВключаетНДС");	
	Иначе
		Документ.НомерВходящегоДокумента	= Сообщение.ДокументEDI.Номер;
		Документ.ДатаВходящегоДокумента	= Сообщение.ДокументEDI.Дата;
		флУчитыватьНДС		= Документ.УчитыватьНДС;
		флСуммаВключаетНДС	= Документ.СуммаВключаетНДС;
	КонецЕсли;
	
	Возврат Новый Структура("флУчитыватьНДС, флСуммаВключаетНДС", флУчитыватьНДС, флСуммаВключаетНДС);
	
КонецФункции

Процедура ЗаполнитьТабличнуюЧастьПоступленияНаОснованииСообщения(Сообщение, Документ, ЗаказСсылка, ПризнакиУчетаНДС)
	
	флУчитыватьНДС = ПризнакиУчетаНДС.флУчитыватьНДС;
	флСуммаВключаетНДС = ПризнакиУчетаНДС.флСуммаВключаетНДС;
	
	Если ИмяКонфигурации1С = "УФ_УНФ" Тогда
		ИмяТабЧастиТовары = "Запасы";
	ИначеЕсли ИмяКонфигурации1С = "АСТОР" Тогда
		ИмяТабЧастиТовары = "Состав";
	Иначе
		ИмяТабЧастиТовары =  "Товары";
	КонецЕсли;
	
	ИмяТабЧастиУслуги = "Услуги";
	
	Документ[ИмяТабЧастиТовары].Очистить();
	
	РаботаСУслугами					= (ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, "РаботаСУслугами") = Истина);
	ЗагружатьУслугиВТабЧастьУслуги	= (ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, "ЗагружатьУслугиВТабЧастьУслуги") = Истина);
	ЕстьТабЧастьУслуги				= (НЕ (Документ.Метаданные().ТабличныеЧасти.Найти(ИмяТабЧастиУслуги) = Неопределено));
	ЕстьКолонкаХарактеристикаНоменклатуры = НЕ Документ.Метаданные().ТабличныеЧасти[ИмяТабЧастиТовары].Реквизиты.Найти("ХарактеристикаНоменклатуры") = Неопределено;  
	
	ТипЕдиницыИзмерения 			= ПолучитьТипЗначенияОбъекта("ЕдиницаИзмерения",,Истина);   
	ЕстьКоэффициент 				= ЕстьРеквизитОбъекта_Контур(Документ,"Коэффициент",ИмяТабЧастиТовары) И 
									  ЕстьНеобходимыеМетаданные("Справочники." +ТипЕдиницыИзмерения+ ".Реквизиты.Коэффициент");
	
	Если РаботаСУслугами
		И ЗагружатьУслугиВТабЧастьУслуги 
		И ЕстьТабЧастьУслуги Тогда
		
		Документ[ИмяТабЧастиУслуги].Очистить();
		
	КонецЕсли;
			
	ПроверятьНаличиеТовараВЗаказе = 
	(ИмяКонфигурации1С = "ТКПТ" ИЛИ ИмяКонфигурации1С = "АСТОР") И ПеременнаяСодержитСвойство(ЗаказСсылка, "Товары") ;
	
	Если ПроверятьНаличиеТовараВЗаказе Тогда
		
		ТоварыЗаказа = ЗаказСсылка.Товары.Выгрузить();
		ТоварыЗаказа.Индексы.Добавить("Номенклатура");
		
	Иначе
		
		ТоварыЗаказа = Неопределено;
		
	КонецЕсли;
	
	Для Каждого СтрокаСообщения Из Сообщение.Товары Цикл
		
		Если ПроверятьНаличиеТовараВЗаказе Тогда
			// исключаем товары, по которым не смогли найти соответствия
			Если НЕ ЗначениеЗаполнено(СтрокаСообщения.Номенклатура) Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(СтрокаСообщения.ЕдиницаИзмерения) Тогда
				Продолжить;
			КонецЕсли;
			// исключаем товар, которого не было в заказе
			Если ТоварыЗаказа.Найти(СтрокаСообщения.Номенклатура) = Неопределено Тогда
				Продолжить;
			КонецЕсли;	
		КонецЕсли;
		
		Если СтрокаСообщения.ТипЕдиницы = "Services" и ИмяКонфигурации1С = "УТ_10_3" Тогда
			Если РаботаСУслугами Тогда
				Если ЗагружатьУслугиВТабЧастьУслуги 
					И ЕстьТабЧастьУслуги Тогда
					ИмяТабЧастиДокумента = ИмяТабЧастиУслуги;
				Иначе
					ИмяТабЧастиДокумента = ИмяТабЧастиТовары;
				КонецЕсли;
			Иначе 
				ИмяТабЧастиДокумента = ИмяТабЧастиТовары;
			КонецЕсли;
		Иначе
			ИмяТабЧастиДокумента = ИмяТабЧастиТовары;
		КонецЕсли;

		НоваяСтрока = Документ[ИмяТабЧастиДокумента].Добавить();
		НоваяСтрока.Номенклатура		= СтрокаСообщения.Номенклатура;
		
		Если ИмяКонфигурации1С = "УФ_УТ" Тогда
			
			ЗаполнитьСтрокуПоступления_УФ(Документ,НоваяСтрока,СтрокаСообщения,ЗаказСсылка,флСуммаВключаетНДС);
			
		ИначеЕсли ИмяКонфигурации1С = "УФ_БП" Тогда 
			
			ЗаполнитьСтрокуПоступления_УФ_БП(Документ,НоваяСтрока,СтрокаСообщения,ЗаказСсылка,флСуммаВключаетНДС);
			
		ИначеЕсли ИмяКонфигурации1С = "БП" Тогда
			
			ЗаполнитьСтрокуПоступления_БП(Документ,НоваяСтрока,СтрокаСообщения,ЗаказСсылка,флСуммаВключаетНДС);
			
		ИначеЕсли ИмяКонфигурации1С = "УФ_Розница" Тогда
			
			ЗаполнитьСтрокуПоступления_УФ_Розница(Документ,НоваяСтрока,СтрокаСообщения,ЗаказСсылка,флСуммаВключаетНДС);
			
		ИначеЕсли ИмяКонфигурации1С = "ДалионТРЕНД" ИЛИ ИмяКонфигурации1С = "УФ_ДалионТРЕНД" Тогда 	
			
			ЗаполнитьСтрокуПоступления_ДалионТРЕНД(НоваяСтрока, СтрокаСообщения, флСуммаВключаетНДС);	 
			
		ИначеЕсли ИмяКонфигурации1С = "ШтрихМ_РС" Тогда
			
			ЗаполнитьСтрокуПоступления_ШтрихМ_РС(Документ, ЗаказСсылка, НоваяСтрока, СтрокаСообщения, флСуммаВключаетНДС,ЕстьКоэффициент); 
		ИначеЕсли ИмяКонфигурации1С = "УФ_УНФ" Тогда 
			                                             
			ЗаполнитьСтрокуПоступления_УФ_УНФ(НоваяСтрока,СтрокаСообщения,флСуммаВключаетНДС);
			
		Иначе  //Все остальные конфигурации кроме УФ_УТ и УФ_БП и УФ_Розница
			
			Если ИмяТабЧастиДокумента <> "Услуги" Тогда
				
				НоваяСтрока.ЕдиницаИзмерения	= СтрокаСообщения.ЕдиницаИзмерения;
				
				Если ИмяКонфигурации1С <> "УФ_УНФ" Тогда                         
					Если ЕстьКоэффициент Тогда
						НоваяСтрока.Коэффициент			= СтрокаСообщения.ЕдиницаИзмерения.Коэффициент;
					КонецЕсли;
				КонецЕсли;
				
				Если ЕстьКолонкаХарактеристикаНоменклатуры Тогда
					НоваяСтрока.ХарактеристикаНоменклатуры	= СтрокаСообщения.ХарактеристикаНоменклатуры;
				КонецЕсли;
				
			КонецЕсли;
						
			Если ИмяТабЧастиДокумента = "Услуги" Тогда
				Если ИмяКонфигурации1С = "УТ_10_3" Тогда
					НоваяСтрока.Содержание = СтрокаСообщения.Номенклатура;
				КонецЕсли;
			КонецЕсли;
			
			НоваяСтрока.Количество			= СтрокаСообщения.Количество;
			
			Если флСуммаВключаетНДС Тогда
				НоваяСтрока.Цена			= СтрокаСообщения.ЦенаСНДС;
				НоваяСтрока.Сумма			= СтрокаСообщения.СуммаСНДС;
			Иначе
				НоваяСтрока.Цена			= СтрокаСообщения.ЦенаБезНДС;
				НоваяСтрока.Сумма			= СтрокаСообщения.СуммаБезНДС;
			КонецЕсли;
			
			НоваяСтрока.СтавкаНДС			= СтрокаСообщения.СтавкаНДС1С;
		КонецЕсли;
		
		Если ИмяКонфигурации1С = "Розница" Тогда
			
			Выполнить("ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, Документ, флУчитыватьНДС, флСуммаВключаетНДС);");
			
		ИначеЕсли ИмяКонфигурации1С = "УФ_Розница" Тогда
			
			Попытка
				Выполнить("НоваяСтрока.СуммаНДС = ОбработкаТабличнойЧастиТоварыСервер.РассчитатьСуммуНДС(НоваяСтрока.Сумма, НоваяСтрока.СтавкаНДС, флСуммаВключаетНДС)");
			Исключение
				Выполнить("НоваяСтрока.СуммаНДС = ОбработкаТабличнойЧастиТоварыКлиентСервер.СуммаНДС(НоваяСтрока.Сумма, НоваяСтрока.СтавкаНДС, флСуммаВключаетНДС)");
			КонецПопытки;
			
			Выполнить("ОбработкаТабличнойЧастиТоварыСервер.ОбработатьСтрокуТЧСервер(НоваяСтрока, Новый Структура(""ПересчитатьСумму""), Неопределено)");
			
		ИначеЕсли ИмяКонфигурации1С = "ТКПТ" Тогда
			
			Документ.ОбработкаРеквизита("Товары.Количество", НоваяСтрока);
			Документ.ОбработкаРеквизита("УстановитьРозничнуюЦену", НоваяСтрока);
			НоваяСтрока.СуммаВсего	= СтрокаСообщения.СуммаСНДС;
			Документ.ОбработкаРеквизита("Товары.СуммаВсего", НоваяСтрока);
			
		ИначеЕсли ИмяКонфигурации1С = "АСТОР" Тогда
			НоваяСтрока.КоличествоПоДокументу = СтрокаСообщения.Количество;
			Выполнить("ОмРаботаСФормами.РассчитатьСуммуТабЧасти(НоваяСтрока);");
			Выполнить("ОмРаботаСФормами.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, Документ.ВариантРасчетаНДС);");
			Выполнить("ОмРаботаСФормами.РассчитатьВсегоТабЧасти(НоваяСтрока, Документ.ВариантРасчетаНДС);");
			
		ИначеЕсли ИмяКонфигурации1С = "ДалионУМ" Тогда
			
			НоваяСтрока.ХарактеристикаНоменклатуры = СтрокаСообщения.ХарактеристикаНоменклатуры;
			
			СвойстваТЧТовары = Новый Структура;
			СвойстваТЧТовары.Вставить("ИмяТЧ", "Товары");
			СвойстваТЧТовары.Вставить("ХарактеристикаНоменклатуры");
			СвойстваТЧТовары.Вставить("ЕдиницаИзмерения");
			СвойстваТЧТовары.Вставить("Цена");
			СвойстваТЧТовары.Вставить("НомерГТД");
			СвойстваТЧТовары.Вставить("СрокГодности");
			СвойстваТЧТовары.Вставить("КатегорияЦен", Справочники.КатегорииЦен.Закупочная);
			
			//Выполнить("тчПриИзмененииКоличестваТабЧасти(НоваяСтрока, Документ, СвойстваТЧТовары);");
			Выполнить("тчПриИзмененииСтавкиНДСТабЧасти(НоваяСтрока, Документ, СвойстваТЧТовары);");
			
		ИначеЕсли ИмяКонфигурации1С = "УФ_УТ" 
			ИЛИ ИмяКонфигурации1С = "УФ_БП"
			ИЛИ ИмяКонфигурации1С = "УФ_УНФ"
			ИЛИ ИмяКонфигурации1С = "ШтрихМ_РС" Тогда
			//специфических действий не требуется
			
		Иначе
			
			Попытка
				Выполнить("НоваяСтрока.СуммаНДС = УчетНДС.РассчитатьСуммуНДС(НоваяСтрока.Сумма,флУчитыватьНДС, флСуммаВключаетНДС, УчетНДС.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС));");
			Исключение
				Выполнить("НоваяСтрока.СуммаНДС = МодульТиповой_РассчитатьСуммуНДС(НоваяСтрока.Сумма,флУчитыватьНДС, флСуммаВключаетНДС, ПолучитьСтавкуНДС_КонтурEDI(НоваяСтрока.СтавкаНДС));");
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;	
КонецПроцедуры

Процедура ЗаполнитьСтрокуПоступления_УФ(Док,НоваяСтрока,Стр,НайденныйЗаказ,флСуммаВключаетНДС)
	
	НоваяСтрока.Характеристика		= Стр.ХарактеристикаНоменклатуры;
	НоваяСтрока.Упаковка			= Стр.ЕдиницаИзмерения;
	НоваяСтрока.КоличествоУпаковок	= Стр.Количество;
	НоваяСтрока.ЗаказПоставщику		= НайденныйЗаказ;
	Если Не ЗначениеЗаполнено(НоваяСтрока.Упаковка) Тогда 
		НоваяСтрока.Количество			= Стр.Количество;//базовая единица
	иначе
		Если ОпределитьРелизКонфигурации() = "11.2" Тогда
			СтруктураДействий=Новый Структура;
			СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
			ОбработкаТабличнойЧастиСервер_ОбработатьСтрокуТЧ(НоваяСтрока, СтруктураДействий, Неопределено);
		Иначе
			НоваяСтрока.Количество			= Стр.Количество * ПолучитьКоэффициентУпаковкиУФ_УТ(НоваяСтрока.Упаковка);//в упаковках
		КонецЕсли;
	КонецЕсли;
	НоваяСтрока.Склад				= Док.Склад;
	НоваяСтрока.СтавкаНДС			= Стр.СтавкаНДС1С;
	Если флСуммаВключаетНДС Тогда
		НоваяСтрока.Цена			= Стр.ЦенаСНДС;
		НоваяСтрока.Сумма			= Стр.СуммаСНДС;
	Иначе
		НоваяСтрока.Цена			= Стр.ЦенаБезНДС;
		НоваяСтрока.Сумма			= Стр.СуммаБезНДС;
	КонецЕсли;
	
	Попытка
		Выполнить("НоваяСтрока.СуммаНДС = Ценообразование.РассчитатьСуммуНДС(НоваяСтрока.Сумма, НоваяСтрока.СтавкаНДС, флСуммаВключаетНДС)");
	Исключение
		Выполнить("НоваяСтрока.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(НоваяСтрока.Сумма, НоваяСтрока.СтавкаНДС, флСуммаВключаетНДС)");
	КонецПопытки;
	Выполнить("Ценообразование.ПересчитатьСуммыВСтроке(НоваяСтрока,ложь,ложь,ложь,флСуммаВключаетНДС)");
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Номенклатура", 				Стр.Номенклатура);
	СтруктураПоиска.Вставить("Характеристика", 				Стр.ХарактеристикаНоменклатуры);
	СтруктураПоиска.Вставить("Упаковка", 					Стр.ЕдиницаИзмерения);
	СтруктураПоиска.Вставить("Количество",					Стр.Количество);
	СтруктураПоиска.Вставить("Отменено",					Ложь);
	
	ВариантыПоиска = Новый Массив;
	ВариантыПоиска.Добавить("Отменено,Номенклатура,Характеристика,Упаковка,Количество");
	ВариантыПоиска.Добавить("Отменено,Номенклатура,Характеристика,Упаковка");
	ВариантыПоиска.Добавить("Отменено,Номенклатура,Характеристика,Количество");
	ВариантыПоиска.Добавить("Отменено,Номенклатура,Характеристика");
	ВариантыПоиска.Добавить("Отменено,Номенклатура,Количество");
	ВариантыПоиска.Добавить("Отменено,Номенклатура");
	
	НайденнаяСтрокаЗаказа = ОднозначноОпределитьСоответствиеСтрокиВТаблице(НайденныйЗаказ.Товары, СтруктураПоиска, ВариантыПоиска);
	
	Если НайденнаяСтрокаЗаказа = Неопределено Тогда 
		
		Возврат;
		
	КонецЕсли;
	
	Если НоваяСтрока.Номенклатура <> Неопределено Тогда 
		НоваяСтрока.КодСтроки = НайденнаяСтрокаЗаказа.КодСтроки;
	иначе
		НоваяСтрока.КодСтроки = 0;
		НоваяСтрока.РасхождениеЗаказ = 1;
	КонецЕсли;
	
	Если ПеременнаяСодержитСвойство(НоваяСтрока, "НомерСтрокиДокументаПоставщика") Тогда
		НоваяСтрока.НомерСтрокиДокументаПоставщика = НоваяСтрока.НомерСтроки;	
	КонецЕсли;
	
	НоваяСтрока.Характеристика = НайденнаяСтрокаЗаказа.Характеристика;
	
КонецПроцедуры

Процедура ЗаполнитьСтрокуПоступления_УФ_БП(Док,НоваяСтрока,Стр,НайденныйЗаказ,флСуммаВключаетНДС);
	
	НоваяСтрока.ЕдиницаИзмерения	= Стр.ЕдиницаИзмерения;
	НоваяСтрока.Количество			= Стр.Количество;
	НоваяСтрока.Коэффициент			= 1;
	НоваяСтрока.СтавкаНДС			= Стр.СтавкаНДС1С;
	
	Если флСуммаВключаетНДС Тогда
		НоваяСтрока.Цена			= Стр.ЦенаСНДС;
		НоваяСтрока.Сумма			= Стр.СуммаСНДС;
	Иначе
		НоваяСтрока.Цена			= Стр.ЦенаБезНДС;
		НоваяСтрока.Сумма			= Стр.СуммаБезНДС;
	КонецЕсли;
	
	ЗаполнитьНедостающиеПоляСтрокиТоваров(Стр);
	Выполнить("ОбработкаТабличныхЧастейКлиентСервер.РассчитатьСуммуТабЧасти(НоваяСтрока)");
	Выполнить("ОбработкаТабличныхЧастейКлиентСервер.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, флСуммаВключаетНДС)");
	
КонецПроцедуры 

Процедура ЗаполнитьСтрокуПоступления_БП(Док,НоваяСтрока,Стр,НайденныйЗаказ,флСуммаВключаетНДС);
	
	НоваяСтрока.ЕдиницаИзмерения	= Стр.ЕдиницаИзмерения;
