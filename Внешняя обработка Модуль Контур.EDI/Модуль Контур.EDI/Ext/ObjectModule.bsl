//ИНИЦИАЛИЗАЦИЯ

// Выполняется инициализация основных параметров для работы с метриками 
// 
// Параметры: 
//  ОсновнаяФорма  - Неопределено, Форма - основная форма обработки. Для обычных форм - неопределено 
// 
// Возвращаемое значение: 
//   Структура   - структура всех параметров метрики 
// 
Функция Метрика_ИнициализироватьПараметрыКлиентСервер(ОсновнаяФорма = Неопределено) Экспорт
	
	ПараметрыКлиентСерверМетрика = Новый Структура;
	ПараметрыКлиентСерверМетрика.Вставить("АдресаВХ");
	
	ПараметрыКлиентСерверМетрика.Вставить("URLАдреса");
	ПараметрыКлиентСерверМетрика.Вставить("ПутьКФормам");
	
	ПараметрыКлиентСерверМетрика.Вставить("ИдентификаторКлиента");
	ПараметрыКлиентСерверМетрика.Вставить("ИдентификаторСессии");
	
	ПараметрыКлиентСерверМетрика.Вставить("СессияEDI");
	ПараметрыКлиентСерверМетрика.Вставить("СессияОбщепродуктовая");
	ПараметрыКлиентСерверМетрика.Вставить("СессияNormative");
	ПараметрыКлиентСерверМетрика.Вставить("КонтекстПриложенияСервер");
	ПараметрыКлиентСерверМетрика.Вставить("КонтекстПриложенияКлиент"); 
	
	ПараметрыКлиентСерверМетрика.Вставить("ДополнительныеСвойстваКонфигурации");
	
	УникальныйИдентификатор	= ПолучитьУникальныйИдентификаторДляВХ(ОсновнаяФорма);
	
	АдресаВХ = Новый Структура;
	АдресаВХ.Вставить("СтекСобытий",				ПоместитьВоВременноеХранилище(Новый Массив,									УникальныйИдентификатор)); // сюда стек событий
	АдресаВХ.Вставить("Замеры",						ПоместитьВоВременноеХранилище(Новый Соответствие,							УникальныйИдентификатор)); // сюда соответствие ИдЗамера - ВремяНачала
	// Почему в ВХ? Потому что надо будет обрабатывать параметр ПараметрЗапуска, а он доступен только на клиенте 
	// Бесконтекстным вызовом отправим
	
	// ВАЖНО! Для корректности тестирования данные будут 
	// собираться, но не будут отправляться. 
	// Проверка надо отправлять или нет 
	// будет в финальных методах Отправить и ОтправитьСтекСобытий 	
	АдресаВХ.Вставить("ОтправкаЗапрещена",			ПоместитьВоВременноеХранилище(Метрика_ОтправкаЗапрещена(),					УникальныйИдентификатор)); // не будем отправлять данные в метрику 
	АдресаВХ.Вставить("КонтекстМодуля",				ПоместитьВоВременноеХранилище(Метрика_СформироватьКонтекстМодуля(),			УникальныйИдентификатор)); // Много контекста, поэтому в ВХ 
	
	ПараметрыКлиентСерверМетрика.АдресаВХ					= АдресаВХ;
	
	ПараметрыКлиентСерверМетрика.URLАдреса					= Метрика_URLАдреса();
	ПараметрыКлиентСерверМетрика.ПутьКФормам				= Метаданные().ПолноеИмя() + ".Форма.";
	
	ПараметрыКлиентСерверМетрика.ИдентификаторКлиента		= Строка(ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);
	ПараметрыКлиентСерверМетрика.ИдентификаторСессии		= Строка(УникальныйИдентификатор);
	
	ПараметрыКлиентСерверМетрика.СессияEDI					= Метрика_СформироватьСессиюEDI();
	ПараметрыКлиентСерверМетрика.СессияОбщепродуктовая		= МетрикаКонтур_НовыйKeSession();
    ПараметрыКлиентСерверМетрика.СессияNormative			= Метрика_СформироватьСессиюNormative();
	ПараметрыКлиентСерверМетрика.КонтекстПриложенияСервер	= Метрика_СформироватьКонтекстПриложенияСервер();
	ПараметрыКлиентСерверМетрика.ДополнительныеСвойстваКонфигурации = Метрика_СформироватьДополнительныеСвойстваКонфигурации();
	
	Возврат ПараметрыКлиентСерверМетрика;
	
КонецФункции // Метрика_ИнициализироватьПараметрыКлиентСервер()

Функция Метрика_СформироватьКонтекстМодуля()

	КонтекстМодуля = Новый Структура;
	
	// Дополнительный контекст базы и окружения
	КонтекстМодуля.Вставить("ТипСоединенияБазы", 						РазобратьСтрокуСоединенияИнформационнойБазы().ТипСоединения);
	КонтекстМодуля.Вставить("РазмерФайловойБазы", 						ОпределитьРазмерФайловойБазы());
	КонтекстМодуля.Вставить("КоличествоПользовательскихСеансовБазы", 	ОпределитьКоличествоПользовательскихСеансовБазы());
	КонтекстМодуля.Вставить("КоличествоСеансовБазы", 					ОпределитьКоличествоСеансовБазы());
	ПользовательБазы = ПользователиИнформационнойБазы.ТекущийПользователь();
	КонтекстМодуля.Вставить("РолиПользователяБазы", 					Метрика_СформироватьИнформациюОРоляхПользователяБазы(ПользовательБазы));
	КонтекстМодуля.Вставить("ИнформацияОПроцессоре", 					ПолучитьИнформациюОПроцессоре());
	КонтекстМодуля.Вставить("СинонимКонфигурации1С", 					ИмяКонфигурации1С);
	
	Если НЕ ЕстьОбъектыХраненияДанных_КонтурEDI() Тогда
		Возврат КонтекстМодуля;
	КонецЕсли;

	// Контекст EDI
	КонтекстМодуля.Вставить("РежимЗапускаОбработки",			РежимИспользованияОбработки());
	КонтекстМодуля.Вставить("ИспользуетсяВнешнееХранилище",		ВнешнееХранилище = Истина);
	КонтекстМодуля.Вставить("УстановленЧерезРасширение1С",		ЕстьРасширениеКонфигурацииКонтурEDI());
	КонтекстМодуля.Вставить("ИспользуетсяПодключаемыйМодуль",	ИспользуетсяПодключаемыйМодуль = Истина);
	КонтекстМодуля.Вставить("НастройкиПодключаемогоМодуля",		НастройкиПодключаемогоМодуля);
	КонтекстМодуля.Вставить("МодульИзменен",					МодульEDIИзменен());
	КонтекстМодуля.Вставить("ИспользуютсяРасширения",			(ТипЗнч(ТаблицаКэшИсполняемогоКодаРасширений) = Тип("ТаблицаЗначений") 
																					И НЕ ТаблицаКэшИсполняемогоКодаРасширений.Количество() = 0));
	КонтекстМодуля.Вставить("Расширения",						Метрика_СформироватьИнформациюОРасширениях());
	КонтекстМодуля.Вставить("КоличествоСообщенийВБазе",			ПоcчитатьКоличествоСообщенийВБазе());
	КонтекстМодуля.Вставить("ИспользуетсяМеркурий",				ИспользуетсяМеркурий = Истина);
	КонтекстМодуля.Вставить("НастройкиМодуляМеркурий",			ПолучитьНастройкиМодуляМеркурий());
	КонтекстМодуля.Вставить("КастомныеПараметры",				Метрика_ПолучитьКастомныеПараметры());
	КонтекстМодуля.Вставить("ИдентификаторБазы",				ИдентификаторБазы());
	
	
	КастомныеПараметры = КонтекстМодуля.КастомныеПараметры;
	Если ТипЗнч(КастомныеПараметры) = Тип("Структура") 	И КастомныеПараметры.Свойство("Успешно") Тогда
		КонтекстМодуля.Вставить("ЕстьКастомныеПараметры", КастомныеПараметры.Успешно);
	КонецЕсли;
	
	Если НастройкиМодуля = Неопределено Тогда
		Возврат КонтекстМодуля;
	КонецЕсли;
	
	КонтекстМодуля.Вставить("НастройкиМодуля",                        	НастройкиМодуля); // здесь уже подготовленная структура
	КонтекстМодуля.Вставить("ПараметрыПользователяEDI",               	Метрика_СформироватьИнформациюОПользователеEDI());
	КонтекстМодуля.Вставить("УчетныеЗаписиEDI",               			Метрика_СформироватьИнформациюОбУчетныхЗаписяхEDI());
	КонтекстМодуля.Вставить("ПользователиEDI",               			Метрика_СформироватьИнформациюОПользователяхEDI());
	КонтекстМодуля.Вставить("ОрганизацииEDI",               			Метрика_СформироватьИнформациюОбОрганизацияхEDI());
	КонтекстМодуля.Вставить("ЮрФизЛицаСвоиEDI",               			Метрика_СформироватьИнформациюОЮрФизЛицахСвоихEDI());
	
	//КонтекстМодуля.Вставить("ОсобенностиСообщений",               		Метрика_СформироватьОсобенностиСообщений());
	
	Возврат КонтекстМодуля;

КонецФункции // Метрика_СформироватьКонтекстМодуля()

Функция ОпределитьКоличествоПользовательскихСеансовБазы()

	КоличествоСеансов = 0;
	Попытка
		МассивСеансов = ПолучитьСеансыИнформационнойБазы();
		
		Для каждого Сеанс Из МассивСеансов Цикл
			Если НЕ Сеанс.ИмяПриложения = "1CV8C" Тогда
				Продолжить;
			КонецЕсли;
			КоличествоСеансов = КоличествоСеансов + 1;
		КонецЦикла;
	Исключение
			Возврат Неопределено;
