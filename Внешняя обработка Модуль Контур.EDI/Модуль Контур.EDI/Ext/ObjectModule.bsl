Функция Криптография_МенеджерНастроек(МенеджерНастроек = Неопределено) Экспорт
	
	Если МенеджерНастроек = Неопределено Тогда
		
		МенеджерНастроек = КриптографияПереопределяемый_МенеджерНастроек();
		
		Если МенеджерНастроек = Неопределено Тогда
			
			МенеджерНастроек = Криптография_НовыйМенеджерНастроек();	
	
		КонецЕсли;	
		
	КонецЕсли;
	
	Возврат МенеджерНастроек;	

КонецФункции

Функция Криптография_ИнициализироватьМенеджерКриптографии(ПарольДоступаКЗакрытомуКлючу = Неопределено, ПараметрыСозданияМенеджераКриптографии = Неопределено) Экспорт
	
	Если ПараметрыСозданияМенеджераКриптографии = Неопределено Тогда
		ВариантНастройки = Криптография_ПодходящийВариантНастройкиКриптографии();	
	Иначе
		ВариантНастройки = ПараметрыСозданияМенеджераКриптографии;
	КонецЕсли;
	
	Если ВариантНастройки = Неопределено Тогда
		ВызватьИсключение "Не удалось инициализировать менеджер криптографии по причине: не найден подходящий криптопровайдер на устройстве";	
	КонецЕсли;
	
	Попытка
		ПараметрыКонструктора = Новый Массив;
		ПараметрыКонструктора.Добавить(ВариантНастройки.ИмяМодуляКриптографии);
		ПараметрыКонструктора.Добавить(ВариантНастройки.ПутьМодуляКриптографии);
		ПараметрыКонструктора.Добавить(ВариантНастройки.ТипМодуляКриптографии);
		
		МенеджерКриптографии = Новый("МенеджерКриптографии", ПараметрыКонструктора);
	Исключение    
		ТекстОшибки = ОписаниеОшибки();
		ВызватьИсключение "Не удалось инициализировать менеджер криптографии по причине: " + ТекстОшибки;	
	КонецПопытки; 
		
	Криптография_УстановитьПарольДоступаКЗакрытомуКлючу(МенеджерКриптографии, ПарольДоступаКЗакрытомуКлючу);
	
	Возврат МенеджерКриптографии;
	
КонецФункции

Функция Криптография_ПолучитьХранилищеСертификатов(ТипХранилища, РасположениеХранилища) Экспорт
	
	МенеджерКриптографии = Криптография_ИнициализироватьМенеджерКриптографии();
	
	ХранилищеСертификатовКриптографии = МенеджерКриптографии.ПолучитьХранилищеСертификатов(ТипХранилища, РасположениеХранилища);	
		
	Возврат ХранилищеСертификатовКриптографии;
	
КонецФункции

Функция Криптография_Расшифровать(ИсходныеДанные, Сертификат = Неопределено, ПарольДоступаКЗакрытомуКлючу = Неопределено, Расположение = "сервер") Экспорт
	
	Результат = КриптографияПереопределяемый_Расшифровать(ИсходныеДанные, Сертификат, ПарольДоступаКЗакрытомуКлючу, Расположение);
	
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВариантыНастройки = Криптография_ВариантыНастройкиПоТипуПлатформы();
	
	Для Каждого ВариантНастройки Из ВариантыНастройки Цикл
		
		Попытка	
			
			Результат = Криптография_РасшифроватьКонтент(ИсходныеДанные, Сертификат, ПарольДоступаКЗакрытомуКлючу, ВариантНастройки);
			
			Прервать;
			
		Исключение  
			
			ТекстОшибки = ОписаниеОшибки();
			
			Если ВариантыНастройки.Найти(ВариантНастройки) = ВариантыНастройки.ВГраница() 
				ИЛИ Криптография_ЕстьБлокирующиеОшибки(ТекстОшибки) Тогда
				ВызватьИсключение ТекстОшибки;	
			КонецЕсли;
			
			ВариантНастройкиИзТекстаОшибки = Криптография_ОбработатьВариантНастройкиИзТекстаОшибки(ТекстОшибки);
			
			Если НЕ ВариантНастройкиИзТекстаОшибки = Неопределено Тогда
				Результат = Криптография_РасшифроватьКонтент(ИсходныеДанные, Сертификат, ПарольДоступаКЗакрытомуКлючу, ВариантНастройкиИзТекстаОшибки);   
				Прервать;	
			КонецЕсли;
			
		КонецПопытки;		
		
	КонецЦикла; 	 
	
	Возврат Результат;
	
КонецФункции 

Функция Криптография_НайтиПоОтпечатку(Отпечаток, Расположение = "сервер") Экспорт
	
	Результат = КриптографияПереопределяемый_НайтиПоОтпечатку(Отпечаток, Расположение);
	
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПараметрыПоиска = Криптография_ПараметрыПоискаСертификатов();
	
	Сертификат = Криптография_ПолучитьДанныеСертификата(Отпечаток, ПараметрыПоиска);
		
	Возврат Сертификат;
	
КонецФункции

Функция Криптография_Подписать(ИсходныеДанные, ОтпечатокСертификата, ПарольДоступаКЗакрытомуКлючу = Неопределено, Расположение = "сервер") Экспорт
	
	Результат = КриптографияПереопределяемый_Подписать(ИсходныеДанные, ОтпечатокСертификата, ПарольДоступаКЗакрытомуКлючу, Расположение);
	
	Если Результат <> Неопределено Тогда
		Возврат Результат;	
	КонецЕсли;
	
	МенеджерНастроек = Криптография_МенеджерНастроек();
	
	// Получаем сертификат	
	СтруктураСертификата = Криптография_НайтиПоОтпечатку(ОтпечатокСертификата, Расположение);	
	СертификатКриптографии = Новый СертификатКриптографии(СтруктураСертификата.ДвоичныеДанные);
	
	ОтпечатокСертификатаСтрокой = СтруктураСертификата.Отпечаток;
	
	ВариантыНастройки = Криптография_ВариантыНастройкиПоТипуПлатформы();
	
	ВариантНастройкиСертификата = МенеджерНастроек.ВариантыНастройкиСертификатов.Получить(ОтпечатокСертификатаСтрокой);
	
	Если НЕ ВариантНастройкиСертификата = Неопределено Тогда
		ВариантыНастройки.Вставить(0, ВариантНастройкиСертификата);	
	КонецЕсли;
	
	Для Каждого ВариантНастройки Из ВариантыНастройки Цикл
		
		Попытка	
			
			Результат = Криптография_ПодписатьКонтент(ИсходныеДанные, СертификатКриптографии, ПарольДоступаКЗакрытомуКлючу, ВариантНастройки);
			
			МенеджерНастроек.ВариантыНастройкиСертификатов.Вставить(ОтпечатокСертификатаСтрокой, ВариантНастройки);
			
			Прервать;
			
		Исключение  
			
			ТекстОшибки = ОписаниеОшибки();
			
			Если ВариантыНастройки.Найти(ВариантНастройки) = ВариантыНастройки.ВГраница() 
				ИЛИ Криптография_ЕстьБлокирующиеОшибки(ТекстОшибки) Тогда
				ВызватьИсключение ТекстОшибки;	
			КонецЕсли;
			
			ВариантНастройкиИзТекстаОшибки = Криптография_ОбработатьВариантНастройкиИзТекстаОшибки(ТекстОшибки);
			
			Если НЕ ВариантНастройкиИзТекстаОшибки = Неопределено Тогда
				Результат = Криптография_ПодписатьКонтент(ИсходныеДанные, СертификатКриптографии, ПарольДоступаКЗакрытомуКлючу, ВариантНастройкиИзТекстаОшибки);   
				МенеджерНастроек.ВариантыНастройкиСертификатов.Вставить(ОтпечатокСертификатаСтрокой, ВариантНастройкиИзТекстаОшибки);
				Прервать;	
			КонецЕсли;
			
		КонецПопытки;		
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Криптография_ПолучитьСертификатыДляПодписиШифрования(ТолькоДействующие = Истина, Расположение = "сервер") Экспорт
	
	Результат = КриптографияПереопределяемый_ПолучитьСертификатыДляПодписиШифрования(ТолькоДействующие, Расположение);
	
	Если Результат <> Неопределено Тогда
		Возврат Результат;	
	КонецЕсли;
	
	Результат = Новый Массив;
	
	ПараметрыПоиска = Криптография_ПараметрыПоискаСертификатов();
	
	ХранилищеСертификатовКриптографии = Криптография_ПолучитьХранилищеСертификатов(ПараметрыПоиска.Тип, ПараметрыПоиска.Расположение);
	
	КоллекцияСертификатовХранилища = ХранилищеСертификатовКриптографии.ПолучитьВсе();
	
	Для Каждого Сертификат Из КоллекцияСертификатовХранилища Цикл
		
		Если Сертификат.ИспользоватьДляПодписи = Ложь 
			ИЛИ Сертификат.ИспользоватьДляШифрования = Ложь Тогда
			Продолжить;	
		КонецЕсли;
		
		Если ТолькоДействующие
			И КонецДня(Сертификат.ДатаОкончания) < ТекущаяДата() Тогда
			Продолжить;
		КонецЕсли;
		
		РеквизитыСертификата = Криптография_НовыйОписаниеСертификата(Сертификат);
		Результат.Добавить(РеквизитыСертификата);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

