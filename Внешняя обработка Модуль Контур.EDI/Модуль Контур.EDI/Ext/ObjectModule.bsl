Функция ПолучитьСтавкуНДС_EDI(СтавкаНДС_EDI)
	
	Если СтавкаНДС_EDI = "18" Тогда
		Возврат 18;
	ИначеЕсли СтавкаНДС_EDI = "10" Тогда
