// #Область СхемыКомпоновки

// Формирует схему компоновки запроса для справочника номенклатуры.
//
// Возвращаемое значение:
//   СхемаКомпоновкиДанных - схема компоновки данных для справочника номенклатуры.
Функция СхемаКомпоновкиЗапросСправочникНоменклатуры(ВключитьОтборНоменклатуры = Ложь) Экспорт
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	спрНоменклатура.Ссылка КАК Номенклатура
	               |ИЗ
	               |	&СправочникНоменклатуры КАК спрНоменклатура";	    
	
	Если ВключитьОтборНоменклатуры Тогда
		ТекстЗапроса = ТекстЗапроса + "
					|ГДЕ
					|	спрНоменклатура.Ссылка В (&МассивНоменклатуры)";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СправочникНоменклатуры", ПолучитьТипЗначенияОбъекта("Номенклатура", Истина));
	
	СхемаКомпоновкиПоУмолчанию = КонтурСКД_НовыйСхемаКомпоновкиЗапросПоУмолчанию(ТекстЗапроса);
	
	СхемаКомпоновки = СхемаКомпоновкиПоУмолчанию.СхемаКомпоновки;
	НастройкиКомпоновки = СхемаКомпоновкиПоУмолчанию.НастройкиКомпоновки;
	
	КонтурСКД_НовыйВыбранноеПолеКомпоновки(НастройкиКомпоновки, "Номенклатура");
	
	Возврат СхемаКомпоновки;
	
КонецФункции

// Формирует схему компоновки данных для определения типов продукции.
//
// Возвращаемое значение:
//   СхемаКомпоновкиДанных - схема компоновки данных для определения типов продукции.
Функция СхемаКомпоновкиОпределениеТиповПродукции(ВключитьОтборНоменклатуры = Ложь) Экспорт
	
	СхемаКомпоновки = СхемаКомпоновкиЗапросСправочникНоменклатуры(ВключитьОтборНоменклатуры);
	НастройкиКомпоновки = КонтурСКД_НастройкиКомопновкиПоУмолчанию(СхемаКомпоновки);
	
	ПолеТипПродукции = КонтурСКД_НовыйПользовательскоеПолеВыбор(НастройкиКомпоновки, "ТипПродукции");
	КонтурСКД_НовыйВыбранноеПолеКомпоновки(НастройкиКомпоновки, ПолеТипПродукции.ПутьКДанным, "Тип продукции");
	
	Возврат СхемаКомпоновки;
	
КонецФункции

// Формирует схему компоновки данных для определения типов продукции для сценария определения по справочнику КлючиВидовПродукцииИС.
//
// Возвращаемое значение:
//   СхемаКомпоновкиДанных - схема компоновки данных для определения типов продукции.
Функция СхемаКомпоновкиОпределениеТиповПродукции_КлючиВидовПродукции(ВключитьОтборНоменклатуры = Ложь) Экспорт
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	спрНоменклатура.Ссылка КАК Номенклатура,
	               |	ОписаниеНоменклатурыИС.КлючВидовПродукции КАК КлючВидовПродукции
	               |ИЗ
	               |	&СправочникНоменклатуры КАК спрНоменклатура
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
	               |		ПО спрНоменклатура.Ссылка = ОписаниеНоменклатурыИС.Номенклатура";
	
	Если ВключитьОтборНоменклатуры Тогда
		ТекстЗапроса = ТекстЗапроса + "
					|ГДЕ
					|	спрНоменклатура.Ссылка В (&МассивНоменклатуры)";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СправочникНоменклатуры", ПолучитьТипЗначенияОбъекта("Номенклатура", Истина));
	
	СхемаКомпоновкиПоУмолчанию = КонтурСКД_НовыйСхемаКомпоновкиЗапросПоУмолчанию(ТекстЗапроса);
	
	СхемаКомпоновки = СхемаКомпоновкиПоУмолчанию.СхемаКомпоновки;
	НастройкиКомпоновки = СхемаКомпоновкиПоУмолчанию.НастройкиКомпоновки;
	
	КонтурСКД_НовыйВыбранноеПолеКомпоновки(НастройкиКомпоновки, "Номенклатура");
	КонтурСКД_НовыйВыбранноеПолеКомпоновки(НастройкиКомпоновки, "КлючВидовПродукции");
	
	ПолеТипПродукции = КонтурСКД_НовыйПользовательскоеПолеВыбор(НастройкиКомпоновки, "ТипПродукции");
	КонтурСКД_НовыйВыбранноеПолеКомпоновки(НастройкиКомпоновки, ПолеТипПродукции.ПутьКДанным, "Тип продукции");
	
	Возврат СхемаКомпоновки;
	
КонецФункции


// #КонецОбласти

// #Область ОбновлениеПоставки

Функция ПолучитьСписокВерсийОтСервисаОбновлений() Экспорт
	
	СтруктураРезультата = Новый Структура("Успешно, Ошибка, ТаблицаВерсий",
										  Ложь, "", Неопределено);
										  
	Попытка									  
		СписокВерсийСтруктура = КлиентСервисОбновлений_ИнформацияОВерсияхПродукта(); 
		ТаблицаВерсий = Новый ТаблицаЗначений;
		ТаблицаВерсий.Колонки.Добавить("НомерВерсии");
		ТаблицаВерсий.Колонки.Добавить("ДатаВыхода");
		ТаблицаВерсий.Колонки.Добавить("Описание");
		
		Для Каждого Версия Из СписокВерсийСтруктура.versions Цикл
			
			НоваяСтрока = ТаблицаВерсий.Добавить();
			НоваяСтрока.НомерВерсии = Версия.version;
			НоваяСтрока.ДатаВыхода = Версия.release_date;
			НоваяСтрока.Описание = Версия.description;
			
		КонецЦикла;
		
		СтруктураРезультата.Успешно = Истина;
		СтруктураРезультата.ТаблицаВерсий = ТаблицаВерсий;
		
	Исключение   
		
		СтруктураРезультата.Успешно = Ложь;
		СтруктураРезультата.Ошибка = ОписаниеОшибки();
		
	КонецПопытки;   
	
	Возврат СтруктураРезультата;
	
КонецФункции

Функция НужноПроверитьНаличиеОбновленийМодуляEDI() Экспорт
	
	Если ПолучитьКонстантуEDI("ЕстьОбновленияМодуля") = Истина Тогда
		Возврат Истина;
	КонецЕсли;
		
	ДатаПоследнейПроверкиНаличияОбновления = ПолучитьКонстантуEDI("ДатаПоследнейПроверкиНаличияОбновления");
	
	ОдинДень = 24 * 3600;
	Если ТипЗнч(ДатаПоследнейПроверкиНаличияОбновления) = Тип("Дата")
		И (ДатаПоследнейПроверкиНаличияОбновления + ОдинДень) > ТекущаяДата() Тогда
		 
		 Возврат Ложь;
	
	КонецЕсли;
	
	Возврат Истина;
		
КонецФункции

Функция УстановленаНастойкаУстанавливатьПредварительныеВерсии()
	
	УстанавливатьПредварительныеВерсии = (ПолучитьКонстантуEDI("УстанавливатьПредварительныеВерсии") <> Ложь);
	Возврат УстанавливатьПредварительныеВерсии;
	
КонецФункции

Функция АвтообновлениеМодуляВключено() Экспорт
	
	АвтообновлениеМодуля = ПолучитьКонстантуEDI("АвтообновлениеМодуля");
	
	Если АвтообновлениеМодуля = Истина Тогда
		Возврат Истина;                     
	ИначеЕсли АвтообновлениеМодуля = Ложь Тогда
		Возврат Ложь;
	Иначе
		Возврат Не ПараметрыКлиентСервер.ДоменПользователяКонтур;
	КонецЕсли;
	
КонецФункции

Функция ФайлМодуляИзСервисаОбновлений(Версия) Экспорт
	
	Результат = Новый Структура("ДвоичныеДанные, ИмяФайла", Неопределено, Неопределено);
	
	Попытка
		Ответ = КлиентСервисОбновлений_СкачатьКонтентВерсии(Версия); 
		Результат.ИмяФайла 			= Ответ.ИмяФайла;
		Результат.ДвоичныеДанные	= Ответ.ДвоичныеДанные;
	Исключение
		
		_ОписаниеОшибки = "Не удалось загрузить версию обновления модуля 1С: " + Версия;
		Метрика_Переменные = Новый Структура;
		Метрика_Переменные.Вставить("Версия", Версия);
		Метрика_ОтправитьСразу = Ложь;
		Метрика_Ошибка("ФайлМодуляИзСервисаОбновлений", _ОписаниеОшибки, ИнформацияОбОшибке(), Метрика_Переменные, Метрика_ОтправитьСразу);
		
	КонецПопытки;  
	
	Возврат Результат;
	
КонецФункции

Процедура ОбновитьМодульАвтоматически(КонтекстОбновленияМодуля) Экспорт
	
	Если Не ВозможноОбновитьМодульАвтоматически(КонтекстОбновленияМодуля) Тогда
		Возврат;
	КонецЕсли;
			
	Попытка
		ВыполнитьОбновлениеМодуля(КонтекстОбновленияМодуля, "Автоматически");
	Исключение
		Метрика_ОбновлениеМодуля(КонтекстОбновленияМодуля, ОписаниеОшибки(), "Автоматически");
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

Функция ВозможноОбновитьМодульАвтоматически(КонтекстОбновленияМодуля) Экспорт
	
	Если НЕ (КонтекстОбновленияМодуля.АвтообновлениеВключено
			И КонтекстОбновленияМодуля.ЕстьОбновление
			И ЭтоОбновляемыйВариантМодуля(КонтекстОбновленияМодуля)) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПризнакиМодифицированностиМодуля = ПеречисленияEDI_ПризнакиМодифицированностиКонтента();
	
	МожноОбновитьИзмененныйМодуль = КонтекстОбновленияМодуля.УстановленыТолькоИсправленияКонтур 
									И КонтекстОбновленияМодуля.ИсправленияКонтурВыпущены;
	
	Если КонтекстОбновленияМодуля.Модифицированность = ПризнакиМодифицированностиМодуля.Неизвестно
		ИЛИ (КонтекстОбновленияМодуля.Модифицированность = ПризнакиМодифицированностиМодуля.Изменен И НЕ МожноОбновитьИзмененныйМодуль) Тогда
			 
		Возврат Ложь;
			
	КонецЕсли;
	
	РасположенияМодуля = ПеречисленияEDI_ВариантыРасположенияМодуля();
	
	ТекстОшибки = "";
	Если КонтекстОбновленияМодуля.Расположение = РасположенияМодуля.Файл Тогда
		ТекстОшибки = ПроверитьВозможностьОбновленияФайлаМодуля(КонтекстОбновленияМодуля.ПутьКМодулю);
	ИначеЕсли КонтекстОбновленияМодуля.Расположение = РасположенияМодуля.Справочник Тогда
		ТекстОшибки = ПроверитьВозможностьОбновленияЭлементаСправочникаМодуля(КонтекстОбновленияМодуля.ПутьКМодулю);
	КонецЕсли;    
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Метрика_ОбновлениеМодуля(КонтекстОбновленияМодуля, ТекстОшибки, "Автоматически");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;

КонецФункции

Функция ЭтоОбновляемыйВариантМодуля(КонтекстОбновленияМодуля)
	
	Результат = Истина;
	
	РасположенияМодуля = ПеречисленияEDI_ВариантыРасположенияМодуля();
	
	Если КонтекстОбновленияМодуля.Расположение = РасположенияМодуля.Расширение
		ИЛИ КонтекстОбновленияМодуля.Расположение = РасположенияМодуля.Конфигурация Тогда
		Результат = Ложь;
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

Функция РежимЗапускаПриложения()
	
	ТекущийРежимЗапуска = ТекущийРежимЗапуска();
	
	Если ТекущийРежимЗапуска = Неопределено Тогда
		РежимЗапуска = "Регламентное задание";
	Иначе
		РежимЗапуска = Строка(ТекущийРежимЗапуска);
	КонецЕсли;
	
	Возврат РежимЗапуска;
	
КонецФункции

Функция ВнутреннееИмяДоступногоРасширения_КонтурEDI()
	
	КлючКэшаРезультатФункции = "РезультатФункции_ВнутреннееИмяДоступногоРасширения_КонтурEDI";            
	
	ВнутреннееИмяРасширения = ЭДО_Кэш_Прочитать(КлючКэшаРезультатФункции);	
	
	Если ВнутреннееИмяРасширения = Неопределено Тогда
		
		ВнутреннееИмяРасширения = "";
		
		Если ЗначениеЗаполнено(ИмяКонфигурации1С) ИЛИ ЗначениеЗаполнено(ОпределитьКонфигурацию()) Тогда    
			
			Результат = ПолучитьФайл_EDI("/1c/KonturEDI_82/templates/edi_extension_list.json");
			
			Если НЕ Результат = Неопределено Тогда 
				
				ТекстРезультата = КонтурСтандарт_ПолучитьСтрокуИзДвоичныхДанных_(Результат);
				
			Иначе    
				
				ТекстРезультата = ПолучитьМакет("СписокРасширенийКонфигурацииEDI").ПолучитьТекст();
				
			КонецЕсли;
			
			ИнформацияРасширений = КонтурСтандарт_ЗначениеИзСтрокиJSON(ТекстРезультата);
			
			ВариантыРасширений = Новый Массив;
			
			Если ИнформацияРасширений.Свойство(ИмяКонфигурации1С, ВариантыРасширений) Тогда
				
				ТекущийПриоритет = 0;
				
				Для Каждого ВариантРасширения Из ВариантыРасширений Цикл
					
					Если ВариантРасширения.Приоритет > ТекущийПриоритет Тогда
						
						ЕстьНужныеМетаданные = Истина;
						
						Для Каждого ТекМетаданные Из ВариантРасширения.Метаданные Цикл
							
							Если НЕ ЕстьНеобходимыеМетаданные(ТекМетаданные) Тогда
								
								ЕстьНужныеМетаданные = Ложь;
								Прервать;
								
							КонецЕсли;
							
						КонецЦикла;
						
						Если ЕстьНужныеМетаданные Тогда
							
							ВнутреннееИмяРасширения = ВариантРасширения.Имя;
							ТекущийПриоритет 		= ВариантРасширения.Приоритет;
							
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;	
				
			КонецЕсли;	  
			
		КонецЕсли;
		
		ЭДО_Кэш_Поместить(КлючКэшаРезультатФункции, ВнутреннееИмяРасширения);
		
	КонецЕсли;
	
	Возврат ВнутреннееИмяРасширения;

КонецФункции

Функция КонтекстОбновленияПоставки_КонтурEDI() Экспорт

	КонтекстОбновленияПоставки = Новый Структура;
	
	КонтекстОбновленияПоставки.Вставить("Модуль", КонтекстОбновленияМодуля_КонтурEDI());
	КонтекстОбновленияПоставки.Вставить("СистемаХранения", КонтекстОбновленияСистемыХранения_КонтурEDI());
		
	Возврат КонтекстОбновленияПоставки;

КонецФункции

Функция КонтекстОбновленияМодуля_КонтурEDI()

	КонтекстОбновленияМодуля = Новый Структура;
	
	РасположениеМодуля 					= ОпределитьРасположениеМодуля_КонтурEDI();
	ПутьКМодулю							= ОпределитьПутьКМодулю_КонтурEDI(РасположениеМодуля);
	ВерсияМодуля 						= ПараметрыКлиентСервер.ОписаниеВерсии.МажорМинорПатч;    
	МодифицированностьМодуля 			= ПеречисленияEDI_ПризнакиМодифицированностиКонтента().Неизвестно;  
	ТипКонтентаМодуля 					= ОпределитьТипКонтентаМодуля_КонтурEDI(РасположениеМодуля);
	АвтообновлениеВключено				= АвтообновлениеМодуляВключено();
	УстановленныеИсправленияКонтур 		= УстановленныеИсправленияМодуля_КонтурEDI();
	ХешСумма							= ХэшСуммаТекущегоМодуля();
	УстанавливатьПредварительныеВерсии 	= УстановленаНастойкаУстанавливатьПредварительныеВерсии();
	
	КонтекстОбновленияМодуля.Вставить("Расположение", 							РасположениеМодуля);
	КонтекстОбновленияМодуля.Вставить("ПутьКМодулю", 							ПутьКМодулю);
	КонтекстОбновленияМодуля.Вставить("Версия", 								ВерсияМодуля);
	КонтекстОбновленияМодуля.Вставить("Модифицированность", 					МодифицированностьМодуля);
	КонтекстОбновленияМодуля.Вставить("ТипКонтента", 							ТипКонтентаМодуля);  
	КонтекстОбновленияМодуля.Вставить("АвтообновлениеВключено", 				АвтообновлениеВключено);
	КонтекстОбновленияМодуля.Вставить("УстанавливатьПредварительныеВерсии", 	УстанавливатьПредварительныеВерсии);
	КонтекстОбновленияМодуля.Вставить("УстановленныеИсправленияКонтур", 		УстановленныеИсправленияКонтур);
	КонтекстОбновленияМодуля.Вставить("ХешСумма", 								ХешСумма);
	КонтекстОбновленияМодуля.Вставить("НоваяВерсия", 							"");
	КонтекстОбновленияМодуля.Вставить("СтабильнаяВерсия", 						"");
	КонтекстОбновленияМодуля.Вставить("ОписаниеОбновления", 					""); 
	КонтекстОбновленияМодуля.Вставить("ДатаРелизаОбновления", 					"");
	КонтекстОбновленияМодуля.Вставить("ЕстьОбновление", 						Ложь);
	КонтекстОбновленияМодуля.Вставить("УстановленыТолькоИсправленияКонтур", 	Ложь);
	КонтекстОбновленияМодуля.Вставить("ИсправленияКонтурВыпущены", 				Ложь);

	ДополнитьКонтекстОбновленияМодуляИзСервиса_КонтурEDI(КонтекстОбновленияМодуля);
	
	Возврат КонтекстОбновленияМодуля; 
	
КонецФункции  

Процедура ДополнитьКонтекстОбновленияМодуляИзСервиса_КонтурEDI(КонтекстОбновленияМодуля) 
	
	Если (РежимЗапускаПриложения() = "Регламентное задание" И НЕ ЭтоОбновляемыйВариантМодуля(КонтекстОбновленияМодуля))
		ИЛИ НЕ КлиентСервисОбновлений_ИнтернетРесурсДоступен() Тогда
		Возврат;
	КонецЕсли;

	Попытка

		Если КонтекстОбновленияМодуля.ТипКонтента = ПеречисленияEDI_ТипыКонтентаСервисаОбновлений().epf Тогда  
			
			КонтекстОбновленияМодуля.Модифицированность = ОпределитьМодифицированностьМодуля_КонтурEDI();
			
		Иначе
			
			КонтекстОбновленияМодуля.Модифицированность = ОпределитьМодифицированностьРасширенияКонфигурации_КонтурEDI();
			
		КонецЕсли;  
		
		ДополнениеТелаЗапроса = Новый Структура;
		ДополнениеТелаЗапроса.Вставить("ModuleContext", Новый Структура("МодульИзменен", КонтекстОбновленияМодуля.Модифицированность));
		ДополнениеТелаЗапроса.Вставить("set_experimental", КонтекстОбновленияМодуля.УстанавливатьПредварительныеВерсии);
		
		ИнформацияОбновления = КлиентСервисОбновлений_ПроверитьОбновление(, ДополнениеТелаЗапроса);
		
		МодульТиповой = (КонтекстОбновленияМодуля.Модифицированность = ПеречисленияEDI_ПризнакиМодифицированностиКонтента().НеИзменен);
		
		Если МодульТиповой 
			И ЭтоОбновляемыйВариантМодуля(КонтекстОбновленияМодуля)
			И КонтекстОбновленияМодуля.АвтообновлениеВключено 
			И КонтекстОбновленияМодуля.УстанавливатьПредварительныеВерсии Тогда
			
			Если ЭтоИсключеннаяВерсияМодуляАвтообновления(ИнформацияОбновления.name) Тогда
				ДополнениеТелаЗапроса.set_experimental = Ложь;
				ИнформацияОбновления = КлиентСервисОбновлений_ПроверитьОбновление(, ДополнениеТелаЗапроса);
				КонтекстОбновленияМодуля.СтабильнаяВерсия = ИнформацияОбновления.name;	
			Иначе            
				// запрос без контекста модуля возвращает только стабильные версии
				ДополнениеТелаЗапроса = Новый Структура("version", "0");
				ИнформацияСтабильнойВерсии = КлиентСервисОбновлений_ПроверитьОбновление(, ДополнениеТелаЗапроса);
				КонтекстОбновленияМодуля.СтабильнаяВерсия = ИнформацияСтабильнойВерсии.name;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(КонтекстОбновленияМодуля.СтабильнаяВерсия) Тогда
				КонтекстОбновленияМодуля.СтабильнаяВерсия = КонтекстОбновленияМодуля.Версия;
			КонецЕсли;
			
		КонецЕсли;
		
		КонтекстОбновленияМодуля.НоваяВерсия 		  = ИнформацияОбновления.name;
		КонтекстОбновленияМодуля.ЕстьОбновление 	  = ИнформацияОбновления.contain_update;
		КонтекстОбновленияМодуля.ДатаРелизаОбновления = ИнформацияОбновления.release_date;
		КонтекстОбновленияМодуля.ОписаниеОбновления   = ИнформацияОбновления.description;
		
		МодульИзменен 		= (КонтекстОбновленияМодуля.Модифицированность = ПеречисленияEDI_ПризнакиМодифицированностиКонтента().Изменен);
		ЭтоТипКонтентаФайл 	= (КонтекстОбновленияМодуля.ТипКонтента = ПеречисленияEDI_ТипыКонтентаСервисаОбновлений().epf);
		
		КонтекстОбновленияМодуля.УстановленыТолькоИсправленияКонтур = ЭтоТипКонтентаФайл 
																	И МодульИзменен 
																	И ЕстьУстановленныеИсправленияМодуля_КонтурEDI()
																	И УстановленыТолькоИсправленияКонтур_КонтурEDI();
																	
		КонтекстОбновленияМодуля.ИсправленияКонтурВыпущены = КонтекстОбновленияМодуля.ЕстьОбновление
															И КонтекстОбновленияМодуля.АвтообновлениеВключено
															И КонтекстОбновленияМодуля.УстановленыТолькоИсправленияКонтур
															И ИсправленияМодуляВыпущеныВРелиз_КонтурEDI(КонтекстОбновленияМодуля.НоваяВерсия);
		
	Исключение   
		_ОписаниеОшибки = ОписаниеОшибки();
	КонецПопытки;
	
КонецПроцедуры

Функция ОпределитьТипКонтентаМодуля_КонтурEDI(РасположениеМодуля) 
	
	ВариантыРасположенияМодуля = ПеречисленияEDI_ВариантыРасположенияМодуля();
		
	ТипКонтента = ПеречисленияEDI_ТипыКонтентаСервисаОбновлений().epf;
		
	Если РасположениеМодуля = ВариантыРасположенияМодуля.Расширение Тогда
		
		ТипКонтента = ОпределитьТипКонтентаРасширенияКонфигурации_КонтурEDI();
		
	КонецЕсли;
		
	Возврат ТипКонтента;
	
КонецФункции

Функция ОпределитьРасположениеМодуля_КонтурEDI()

	ВариантыРасположенияМодуля = ПеречисленияEDI_ВариантыРасположенияМодуля();
	
	ВариантРасположения = ВариантыРасположенияМодуля.Неизвестно;
	
	ИмяФайла = ИспользуемоеИмяФайлаТекущейОбработки();
	
	ИмяФайлаОтсутствует = ПустаяСтрока(ИмяФайла);
	ИмяФайлаСодержитРасширениеEpf = (Прав(НРег(ИмяФайла), 4) = ".epf");
	ИмяФайлаСодержитКаталогВременныхФайлов = (Найти(ИмяФайла, КаталогВременныхФайлов()) > 0);
	ИмяФайлаСодержитАдресВременногоХранилища = СтрокаСодержитАдресВременногоХранилища(ИмяФайла);
	
	Если ИмяФайлаОтсутствует Тогда
		
		Если МодульЗапущенИзРасширенияКонтурEDI() Тогда
			
			ВариантРасположения = ВариантыРасположенияМодуля.Расширение;
			
		Иначе
			
			ВариантРасположения = ВариантыРасположенияМодуля.Конфигурация;
			
		КонецЕсли;	
		
	ИначеЕсли ИмяФайлаСодержитАдресВременногоХранилища
		ИЛИ ИмяФайлаСодержитКаталогВременныхФайлов Тогда
			  
		ВариантРасположения = ВариантыРасположенияМодуля.Справочник;
		
	ИначеЕсли ИмяФайлаСодержитРасширениеEpf Тогда
		
		ВариантРасположения = ВариантыРасположенияМодуля.Файл;
		
	Иначе 
		
		ВариантРасположения = ВариантыРасположенияМодуля.Неизвестно;
		
	КонецЕсли;

	Возврат ВариантРасположения;		
	
КонецФункции

Функция ОпределитьПутьКМодулю_КонтурEDI(Расположение)
	
	ВариантыРасположенияМодуля = ПеречисленияEDI_ВариантыРасположенияМодуля();

	Если Расположение = ВариантыРасположенияМодуля.Файл Тогда
		
		ПутьКМодулю = ИспользуемоеИмяФайлаТекущейОбработки();
		
	ИначеЕсли Расположение = ВариантыРасположенияМодуля.Справочник Тогда
		
		ВерсияМодуля = ПолучитьНомерРелиза_КонтурEDI();
		ПутьКМодулю = СсылкаНаМодульИзСправочникаВнешнихОбработок(ВерсияМодуля);
		
	Иначе
		
		ПутьКМодулю = Неопределено;	
		
	КонецЕсли;
	
	Возврат ПутьКМодулю;
	
КонецФункции

Функция ОпределитьМодифицированностьМодуля_КонтурEDI()
	
	ПризнакиМодифицированностиКонтента = ПеречисленияEDI_ПризнакиМодифицированностиКонтента();
	
	МодифицированностьМодуля = ПризнакиМодифицированностиКонтента.Неизвестно;
	
	ХэшСуммаТекущегоМодуля = ХэшСуммаТекущегоМодуля();
	ХэшСуммаТиповогоМодуля = "";
	
	Если ЗначениеЗаполнено(ХэшСуммаТекущегоМодуля) Тогда
		ХэшСуммаТиповогоМодуля = ХэшСуммаТиповогоМодуля();	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ХэшСуммаТиповогоМодуля) И ЗначениеЗаполнено(ХэшСуммаТекущегоМодуля) Тогда
		Если Врег(ХэшСуммаТиповогоМодуля) = Врег(ХэшСуммаТекущегоМодуля) Тогда
			МодифицированностьМодуля = ПризнакиМодифицированностиКонтента.НеИзменен;
		Иначе
			МодифицированностьМодуля = ПризнакиМодифицированностиКонтента.Изменен;
		КонецЕсли;
	КонецЕсли;
	
	Если ЕстьОбъектыХраненияДанных_КонтурEDI() Тогда
		УстановитьПривилегированныйРежим(Истина);    
	    УстановитьКонстантуEDI("МодульEDIИзменен", МодифицированностьМодуля);
	КонецЕсли;
	
	Возврат МодифицированностьМодуля;		
	
КонецФункции

Функция ОпределитьМодифицированностьРасширенияКонфигурации_КонтурEDI()

	ПризнакиМодифицированностиКонтента = ПеречисленияEDI_ПризнакиМодифицированностиКонтента();
	
	МодифицированностьМодуля = ПризнакиМодифицированностиКонтента.Неизвестно;
	Версия 					 = ПараметрыКлиентСервер.ОписаниеВерсии.МажорМинорПатч;
	ТипКонтента 			 = ОпределитьТипКонтентаРасширенияКонфигурации_КонтурEDI();   	
	ХешИсточника 			 = ХешКонтентаСервисОбновлений_КонтурEDI(Версия, ТипКонтента);	
	
	Если НЕ ПустаяСтрока(ХешИсточника) Тогда
		
		Если ХешРасширенияEDIСовпадает_КонтурEDI(ХешИсточника) Тогда
			
			МодифицированностьМодуля = ПризнакиМодифицированностиКонтента.НеИзменен;
			
		Иначе
			
			МодифицированностьМодуля = ПризнакиМодифицированностиКонтента.Изменен;
			
		КонецЕсли;
		
		Если ЕстьОбъектыХраненияДанных_КонтурEDI() Тогда
			УстановитьПривилегированныйРежим(Истина);
			УстановитьКонстантуEDI("МодульEDIИзменен", МодифицированностьМодуля);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат МодифицированностьМодуля;
	
КонецФункции
	
Функция УстановленыТолькоИсправленияКонтур_КонтурEDI()
		
	КлючКэша = "РезультатФункции_УстановленыТолькоИсправленияКонтур_КонтурEDI";
	
	УстановленыТолькоИсправленияКонтур = ЭДО_Кэш_Прочитать(КлючКэша);
	
	Если НЕ УстановленыТолькоИсправленияКонтур = Неопределено Тогда
		Возврат УстановленыТолькоИсправленияКонтур;	
	КонецЕсли;	
	
	УстановленыТолькоИсправленияКонтур = Ложь;		
	
	ХэшСуммаТекущегоМодуля = ХэшСуммаТекущегоМодуля();
	ХэшСуммаИсправленногоМодуля = "";
	
	Если ЗначениеЗаполнено(ХэшСуммаТекущегоМодуля) Тогда
		ХэшСуммаИсправленногоМодуля = ХэшСуммаИсправленногоМодуля();	
	КонецЕсли;
	
	УстановленыТолькоИсправленияКонтур = ЗначениеЗаполнено(ХэшСуммаИсправленногоМодуля) 
										И ЗначениеЗаполнено(ХэшСуммаТекущегоМодуля) 
										И НРег(ХэшСуммаИсправленногоМодуля) = НРег(ХэшСуммаТекущегоМодуля);
								
	ЭДО_Кэш_Поместить(КлючКэша, УстановленыТолькоИсправленияКонтур); 						
								
	Возврат УстановленыТолькоИсправленияКонтур;
	
КонецФункции

Функция КонтекстОбновленияСистемыХранения_КонтурEDI()

	КонтекстОбновленияСистемыХранения = Новый Структура;
	
	РасположениеСистемыХранения 		= ОпределитьРасположениеСистемыХранения_КонтурEDI();
	ВерсияСистемыХранения 				= "1.0.0";
	МодифицированностьСистемыХранения 	= ПеречисленияEDI_ПризнакиМодифицированностиКонтента().Неизвестно; 
	
	КонтекстОбновленияСистемыХранения.Вставить("Расположение", РасположениеСистемыХранения);
	КонтекстОбновленияСистемыХранения.Вставить("Версия", ВерсияСистемыХранения);
	КонтекстОбновленияСистемыХранения.Вставить("Модифицированность", МодифицированностьСистемыХранения);
	КонтекстОбновленияСистемыХранения.Вставить("ХешИсточника", Неопределено);
	КонтекстОбновленияСистемыХранения.Вставить("ТипКонтента", "");
	КонтекстОбновленияСистемыХранения.Вставить("НоваяВерсия", "");
	КонтекстОбновленияСистемыХранения.Вставить("ЕстьОбновление", Ложь);
	
	КонтекстОбновленияСистемыХранения.ТипКонтента = ОпределитьТипКонтентаСистемыХранения_КонтурEDI(РасположениеСистемыХранения);
	КонтекстОбновленияСистемыХранения.ХешИсточника = ОпределитьХешИсточникаСистемыХранения_КонтурEDI();
	
	Возврат КонтекстОбновленияСистемыХранения; 
	
КонецФункции 

Процедура ДополнитьКонтекстОбновленияСистемыХраненияИзСервиса_КонтурEDI(КонтекстОбновленияСистемыХранения) Экспорт
		
	Если НЕ КлиентСервисОбновлений_ИнтернетРесурсДоступен() Тогда
		Возврат;	
	КонецЕсли;
	
	ВариантыРасположенияСистемыХранения = ПеречисленияEDI_ВариантыРасположенияСистемыХранения();
	
	Если КонтекстОбновленияСистемыХранения.Расположение = ВариантыРасположенияСистемыХранения.Конфигурация
		ИЛИ КонтекстОбновленияСистемыХранения.Расположение = ВариантыРасположенияСистемыХранения.Расширение
		И КонтурСтандарт_ДоступныНаборыТиповРасширения() Тогда
		
		ХешИсточникаКонтента = ХешКонтентаСервисОбновлений_КонтурEDI(КонтекстОбновленияСистемыХранения.НоваяВерсия, 
		КонтекстОбновленияСистемыХранения.ТипКонтента);
		
		Если ЗначениеЗаполнено(ХешИсточникаКонтента)
			И ЗначениеЗаполнено(КонтекстОбновленияСистемыХранения.ХешИсточника)
			И НЕ ВРег(КонтекстОбновленияСистемыХранения.ХешИсточника) = ВРег(ХешИсточникаКонтента) Тогда
			
			КонтекстОбновленияСистемыХранения.НоваяВерсия = "1.0.0";
			КонтекстОбновленияСистемыХранения.ЕстьОбновление = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ХешКонтентаСервисОбновлений_КонтурEDI(ВерсияПродукта, ТипКонтента)

	ХешИсточникаКонтента = "";
	
	Попытка                 
		 
		МенеджерНастроек = ОпределитьМенеджерНастроекПоТипуКонтента_КонтурEDI(ТипКонтента);
		ИнформацияКонтентаВерсии = КлиентСервисОбновлений_ИнформацияКонтентаВерсии(МенеджерНастроек.ВерсияПродукта, ТипКонтента, МенеджерНастроек.ИмяПродукта);
		ХешИсточникаКонтента = ИнформацияКонтентаВерсии.src_checksum;
		
	Исключение
	    _ОписаниеОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат ХешИсточникаКонтента;
	
КонецФункции

Функция ОпределитьРасположениеСистемыХранения_КонтурEDI()
	
	ВариантыРасположенияСистемыХранения = ПеречисленияEDI_ВариантыРасположенияСистемыХранения();
	
	ВариантРасположения = ВариантыРасположенияСистемыХранения.Неизвестно;
	
	Если ЕстьНеобходимыеМетаданные("Справочники.КонтурEDI_Сообщения") Тогда
		
		ВариантРасположения = ВариантыРасположенияСистемыХранения.Конфигурация;
		
		Если КонтурСтандарт_ДоступныРасширенияКонфигурации() Тогда

			РасширениеКонфигурацииСправочника = Метаданные.Справочники.КонтурEDI_Сообщения.РасширениеКонфигурации();
			
			Если НЕ РасширениеКонфигурацииСправочника = Неопределено Тогда
				ВариантРасположения = ВариантыРасположенияСистемыХранения.Расширение;	
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;	 
	
	Возврат ВариантРасположения;

КонецФункции

Функция ОпределитьХешИсточникаСистемыХранения_КонтурEDI()

	ХешИсточника = ""; 
	
	Попытка            
		
		КонтурEDI_СистемаХраненияВызовСервера = Неопределено;	 
		
	Исключение  
		
		ХешИсточника = КонтурEDI_СистемаХраненияВызовСервера.ХешИсточника();	
		
	КонецПопытки;
		
	Возврат ХешИсточника;
	
КонецФункции

Функция ОпределитьТипКонтентаСистемыХранения_КонтурEDI(Расположение)

	ВариантыРасположенияСистемыХранения = ПеречисленияEDI_ВариантыРасположенияСистемыХранения();
	ТипыКонтентаСервисаОбновлений = ПеречисленияEDI_ТипыКонтентаСервисаОбновлений();
	
	Если Расположение = ВариантыРасположенияСистемыХранения.Конфигурация Тогда
		
		ТипКонтентаСистемыХранения = ТипыКонтентаСервисаОбновлений.storage_cf;     
		
	ИначеЕсли Расположение = ВариантыРасположенияСистемыХранения.Расширение Тогда                    
		
		ТипКонтентаСистемыХранения = ОпределитьТипКонтентаРасширенияКонфигурации_КонтурEDI();
		
	Иначе 
		
		ТипКонтентаСистемыХранения = "";
		
	КонецЕсли;
	
	Возврат ТипКонтентаСистемыХранения;
	
КонецФункции

Функция ОпределитьТипКонтентаРасширенияКонфигурации_КонтурEDI() Экспорт
	
	ТипКонтента = "";
	
	УстановитьПривилегированныйРежим(Истина);
	
	РасширениеEDI = РасширениеEDI_КонтурEDI();
	
	Если НЕ РасширениеEDI = Неопределено Тогда
		
		ВнутреннееИмяРасширения = ВнутреннееИмяДоступногоРасширения_КонтурEDI();
		
		Если ЗначениеЗаполнено(ВнутреннееИмяРасширения) Тогда
			
			Если РасширениеEDI.Версия = "1.0.0" Тогда
				ТипКонтента = ПеречисленияEDI_ТипыКонтентаСервисаОбновлений().storage_cfe;	
			Иначе
				ТипКонтента = ПеречисленияEDI_ТипыКонтентаСервисаОбновлений().storage_epf_cfe;	
			КонецЕсли;	
			
			ТипКонтента = КонтурСтандарт_СтрШаблон_("%1_%2", ВнутреннееИмяРасширения, ТипКонтента);
			
		КонецЕсли;

	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);                            

	Возврат ТипКонтента; 
	
КонецФункции

Функция АдресХранилищаСистемыХраненияИзСервиса_КонтурEDI(ТипКонтента) Экспорт
	
	Результат = Новый Структура("АдресХранилища, ТекстОшибки", Неопределено, "");
	
	Попытка
		
		МенеджерНастроек = ОпределитьМенеджерНастроекПоТипуКонтента_КонтурEDI(ТипКонтента);
		ОписаниеФайла = КлиентСервисОбновлений_СкачатьКонтентВерсии(МенеджерНастроек.ВерсияПродукта, ТипКонтента, МенеджерНастроек.ИмяПродукта);
		Результат.АдресХранилища = ПоместитьВоВременноеХранилище(ОписаниеФайла.ДвоичныеДанные);
		
	Исключение   
		
		_ОписаниеОшибки = ОписаниеОшибки();
		
		Если ПараметрыКлиентСервер.ДоменПользователяКонтур
			И НЕ МенеджерНастроек.ТестовоеОкружение
			И Найти(НРег(_ОписаниеОшибки), "продукта edi не найдена") Тогда
			
			МенеджерНастроек.ТестовоеОкружение = Истина;	
			Результат = АдресХранилищаСистемыХраненияИзСервиса_КонтурEDI(ТипКонтента);
			
		Иначе
			Результат.ТекстОшибки = _ОписаниеОшибки;	
		КонецЕсли;

	КонецПопытки;
	
	Возврат Результат; 
	
КонецФункции

Функция ИнформацияРекомендуемойСистемыХранения_КонтурEDI() Экспорт
	
	ИнформацияСистемыХранения = Новый Структура("Расположение,ТипКонтента");  
	
	ВариантыРасположенияСистемыХранения = ПеречисленияEDI_ВариантыРасположенияСистемыХранения();
	ТипыКонтентаСервисаОбновлений = ПеречисленияEDI_ТипыКонтентаСервисаОбновлений();
	
	ИнформацияСистемыХранения.Расположение = ВариантыРасположенияСистемыХранения.Конфигурация;
	ИнформацияСистемыХранения.ТипКонтента = ТипыКонтентаСервисаОбновлений.storage_cf;
	
	Если КонтурСтандарт_ДоступныРасширенияКонфигурации() Тогда
		
		ВнутреннееИмяРасширения = ВнутреннееИмяДоступногоРасширения_КонтурEDI();
		
		Если ЗначениеЗаполнено(ВнутреннееИмяРасширения) Тогда
			
			ИнформацияСистемыХранения.Расположение = ВариантыРасположенияСистемыХранения.Расширение;	
			
			Если КонтурСтандарт_ДоступныНаборыТиповРасширения() Тогда
				ТипКонтента  = ТипыКонтентаСервисаОбновлений.storage_cfe;	
			Иначе
				ТипКонтента  = ТипыКонтентаСервисаОбновлений.storage_epf_cfe;	
			КонецЕсли;
			ИнформацияСистемыХранения.ТипКонтента = КонтурСтандарт_СтрШаблон_("%1_%2", ВнутреннееИмяРасширения, ТипКонтента);	
		КонецЕсли;
				
	КонецЕсли;	
	
	Возврат ИнформацияСистемыХранения;
	
КонецФункции

Функция СкачатьКонтентВерсии_КонтурEDI(Версия, ТипКонтента = "epf") Экспорт
	
	Результат = Новый Структура("Успешно, ДвоичныеДанные, ИмяФайла", Ложь, Неопределено, Неопределено);
	
	Попытка
 
		МенеджерНастроек = ОпределитьМенеджерНастроекПоТипуКонтента_КонтурEDI(ТипКонтента);
		
		Ответ = КлиентСервисОбновлений_СкачатьКонтентВерсии(Версия, ТипКонтента, МенеджерНастроек.ИмяПродукта); 
		Результат.ИмяФайла 			= Ответ.ИмяФайла;
		Результат.ДвоичныеДанные	= Ответ.ДвоичныеДанные;
		Результат.Успешно = Истина;
	Исключение
		
		_ОписаниеОшибки = КонтурСтандарт_СтрШаблон_("Не удалось загрузить файл контента из сервиса обновлений: %1 (ver. %2)", ТипКонтента, Версия);
		Метрика_Переменные = Новый Структура;
		Метрика_Переменные.Вставить("Версия", Версия);
		Метрика_ОтправитьСразу = Ложь;
		Метрика_Ошибка("СкачатьКонтентВерсии_КонтурEDI", _ОписаниеОшибки, ИнформацияОбОшибке(), Метрика_Переменные, Метрика_ОтправитьСразу);

	КонецПопытки;  
	
	Возврат Результат;
	
КонецФункции

Функция ОпределитьМенеджерНастроекПоТипуКонтента_КонтурEDI(ТипКонтента)
	
	ТипыКонтента = ПеречисленияEDI_ТипыКонтентаСервисаОбновлений();
	
	МенеджерНастроек = Неопределено;
	
	Если Найти(ТипКонтента, ТипыКонтента.storage_cf)
		ИЛИ Найти(ТипКонтента, ТипыКонтента.storage_cfe) Тогда
		
		МенеджерНастроек = МенеджерНастроекСервисаОбновленийСистемыХранения();
		
	Иначе
		
		МенеджерНастроек = МенеджерНастроекСервисаОбновленийМодуля();	
		
	КонецЕсли;
	
	Возврат МенеджерНастроек;
	
КонецФункции

Функция РасширениеEDI_КонтурEDI() Экспорт
	
	РасширениеEDI = Неопределено;
	
	Если КонтурСтандарт_ДоступныРасширенияКонфигурации() Тогда
		
		ОписаниеТипа_МенеджерРасширенийКонфигурации = Новый ОписаниеТипов("МенеджерРасширенийКонфигурации");
		МенеджерРасширенийИзОписанияТипов = ОписаниеТипа_МенеджерРасширенийКонфигурации.ПривестиЗначение();
		
		ОтборПоиска = Новый Структура("Имя", ИмяРасширенияКонфигурацииКонтурEDI());
		МассивРасширений = МенеджерРасширенийИзОписанияТипов.Получить(ОтборПоиска);
		
		Если МассивРасширений.Количество() Тогда
			
			РасширениеEDI = МассивРасширений[0];	
				
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РасширениеEDI;
	
КонецФункции

Функция ХешРасширенияEDIСовпадает_КонтурEDI(ХешРасширения) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	РасширениеEDI = РасширениеEDI_КонтурEDI();
	ХешСовпадает = Ложь;
	
	Если НЕ РасширениеEDI = Неопределено И НЕ ПустаяСтрока(ХешРасширения) Тогда
		
		ХешСовпадает = (НРег(Base64Строка(РасширениеEDI.ХешСумма)) = НРег(ХешРасширения));	
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ХешСовпадает;
	
КонецФункции 

Функция ПроверитьВозможностьОбновленияРасширенияEDI_КонтурEDI(НоваяВерсия, ТипКонтента) Экспорт
	
	ТекстОшибки = "";

	НовыеДвоичныеДанные = СкачатьКонтентВерсии_КонтурEDI(НоваяВерсия, ТипКонтента).ДвоичныеДанные;
	
	Если НовыеДвоичныеДанные = Неопределено Тогда
		
		ТекстОшибки = "Не найден файл обновления расширения в сервисе";
		
	Иначе
		
        ЭДО_Кэш_Поместить("ДвоичныеДанныеОбновленияРасширенияEDI", НовыеДвоичныеДанные);
		
		УстановитьПривилегированныйРежим(Истина);
		
		РасширениеEDI = РасширениеEDI_КонтурEDI();
		
		Ошибки = РасширениеEDI.ПроверитьВозможностьПрименения(НовыеДвоичныеДанные, Ложь);		
		
		Для Каждого Ошибка Из Ошибки Цикл
			
			Если Ошибка.Важность <> ПредопределенноеЗначение("ВажностьПроблемыПримененияРасширенияКонфигурации.Критичная") Тогда
				Продолжить;
			КонецЕсли;
			
			ТекстОшибки = ТекстОшибки + Символы.ПС + Ошибка.Описание; 
			
		КонецЦикла;
		
		УстановитьПривилегированныйРежим(Ложь);
				
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			ТекстОшибки = КонтурСтандарт_СтрШаблон_(
			"Новое расширение не может быть применено по причине:
			|%1",
			ТекстОшибки);
		КонецЕсли;  
		
	КонецЕсли;
	
	Возврат ТекстОшибки;
	
КонецФункции

Процедура ОбновитьРасширениеEDI_КонтурEDI(НовыеДвоичныеДанные) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	РасширениеEDI = РасширениеEDI_КонтурEDI();
	
	Если РасширениеEDI = Неопределено Тогда
		УстановитьПривилегированныйРежим(Ложь);
		Возврат;
	КонецЕсли;	

	Если КонтурСтандарт_ВерсияПлатформыНеНижеУказанной("8.3.12") Тогда
		РасширениеEDI.ЗащитаОтОпасныхДействий = Новый("ОписаниеЗащитыОтОпасныхДействий");
		РасширениеEDI.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Ложь;
	КонецЕсли;              
	
	Попытка
		РасширениеEDI.Записать(НовыеДвоичныеДанные); 
	Исключение 
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение "Для установки расширения требуется монопольный режим";	
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь); 
	
КонецПроцедуры

Функция КонтекстОбновленияПодключаемыйМодуль_КонтурEDI()
	
	КонтекстОбновленияПодключаемыйМодуль = Новый Структура;
	
	РасположениеМодуля	 = ОпределитьРасположениеПодключаемогоМодуля_КонтурEDI();
	ПутьКМодулю			 = ОпределитьПутьКПодключаемомуМодулю_КонтурEDI(РасположениеМодуля);
	ДвоичныеДанныеМодуля = ДвоичныеДанныеПодключаемогоМодуля_КонтурEDI(РасположениеМодуля, ПутьКМодулю);
	ИмяФайлаМодуля 		 = ОпределитьИмяФайлаПодключаемогоМодуля_КонтурEDI(РасположениеМодуля, ПутьКМодулю);
	
	Если ДвоичныеДанныеМодуля = Неопределено Тогда
		ХешМодуля  = "";
	Иначе
		ХешМодуля  = ХэшСумма(ДвоичныеДанныеМодуля);	
	КонецЕсли;
	
	ХешСервис  = ПолучитьКонстантуEDI("ХешПодключаемогоМодуляСервис");

	КонтекстОбновленияПодключаемыйМодуль.Вставить("Расположение", 	РасположениеМодуля);
	КонтекстОбновленияПодключаемыйМодуль.Вставить("ПутьКМодулю", 	ПутьКМодулю);
	КонтекстОбновленияПодключаемыйМодуль.Вставить("ИмяФайла", 		ИмяФайлаМодуля);	
	КонтекстОбновленияПодключаемыйМодуль.Вставить("ДвоичныеДанные", ДвоичныеДанныеМодуля); 
	КонтекстОбновленияПодключаемыйМодуль.Вставить("ХешМодуля", 		ХешМодуля);
	КонтекстОбновленияПодключаемыйМодуль.Вставить("ТипПлагина", 	"pm");
	
	КонтекстОбновленияПодключаемыйМодуль.Вставить("ПроверятьОбновление", 		Ложь);
	КонтекстОбновленияПодключаемыйМодуль.Вставить("ИдентификаторСервис", 		"");
	КонтекстОбновленияПодключаемыйМодуль.Вставить("ИдентификаторОбновления", 	"");	
	КонтекстОбновленияПодключаемыйМодуль.Вставить("ХешСервис", 					ХешСервис);
	КонтекстОбновленияПодключаемыйМодуль.Вставить("ХешОбновления", 				"");
	
	ДополнитьКонтекстОбновленияПодключаемыйМодульИзСервиса_КонтурEDI(КонтекстОбновленияПодключаемыйМодуль);
	
	Возврат КонтекстОбновленияПодключаемыйМодуль;         

КонецФункции

Функция ОпределитьРасположениеПодключаемогоМодуля_КонтурEDI()
	
	ВариантыРасположенияМодуля = ПеречисленияEDI_ВариантыРасположенияМодуля();
	
	ПодключаемыйМодульТип = НастройкиПодключаемогоМодуля.ПодключаемыйМодульТип;	
	
	Если ПодключаемыйМодульТип = "1С" Тогда
		ВариантРасположения = ВариантыРасположенияМодуля.Справочник;	
	ИначеЕсли ПодключаемыйМодульТип = "Диск" Тогда
		ВариантРасположения = ВариантыРасположенияМодуля.Файл;
	Иначе
		ВариантРасположения = ВариантыРасположенияМодуля.Неизвестно;	
	КонецЕсли;
	
	Возврат ВариантРасположения;
	
КонецФункции

Функция ОпределитьПутьКПодключаемомуМодулю_КонтурEDI(РасположениеМодуля)

	ВариантыРасположенияМодуля = ПеречисленияEDI_ВариантыРасположенияМодуля();
	
	Если РасположениеМодуля = ВариантыРасположенияМодуля.Файл Тогда
		
		ПутьКМодулю = НастройкиПодключаемогоМодуля.ПодключаемыйМодульПуть;
		
	ИначеЕсли РасположениеМодуля = ВариантыРасположенияМодуля.Справочник Тогда
		
		ПутьКМодулю = ПолучитьСсылкуНаПодключаемыйМодуль();
		
	Иначе
		
		ПутьКМодулю = Неопределено;	
		
	КонецЕсли;
	
	Возврат ПутьКМодулю;		

КонецФункции

Функция ДвоичныеДанныеПодключаемогоМодуля_КонтурEDI(РасположениеМодуля, ПутьКМодулю)
	
	ДвоичныеДанныеМодуля = Неопределено;

	Если ЗначениеЗаполнено(ПутьКМодулю) Тогда
		
		ВариантыРасположенияМодуля = ПеречисленияEDI_ВариантыРасположенияМодуля();	
		
		Если РасположениеМодуля = ВариантыРасположенияМодуля.Файл И ПроверитьСуществованиеФайлаКаталога(ПутьКМодулю) Тогда
			
			ДвоичныеДанныеМодуля = Новый ДвоичныеДанные(ПутьКМодулю);
			
		ИначеЕсли РасположениеМодуля = ВариантыРасположенияМодуля.Справочник И ПутьКМодулю <> Неопределено  Тогда
			Реквизит = ?(ПараметрыКлиентСервер.ТипИспользуемыхФорм = "Обычные","ХранилищеВнешнейОбработки","ХранилищеОбработки");
			Если ЕстьРеквизитОбъекта_Контур(ПутьКМодулю, Реквизит) Тогда
				ДвоичныеДанныеМодуля = ФайлОбработкиИзСправочникаВнешнихОбработок(ПутьКМодулю);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ДвоичныеДанныеМодуля;
	
КонецФункции

Функция ОпределитьИмяФайлаПодключаемогоМодуля_КонтурEDI(РасположениеМодуля, ПутьКМодулю)
		
	ВариантыРасположенияМодуля = ПеречисленияEDI_ВариантыРасположенияМодуля();
	
	Если РасположениеМодуля = ВариантыРасположенияМодуля.Файл Тогда
		
		ФайлМодуля = Новый Файл(ПутьКМодулю);
		
		ИмяФайлаМодуля = ФайлМодуля.Имя;
		
	ИначеЕсли РасположениеМодуля = ВариантыРасположенияМодуля.Справочник И ПутьКМодулю <> Неопределено Тогда
		
		Если ЕстьРеквизитОбъекта_Контур(ПутьКМодулю,"ИмяФайла") Тогда
			ИмяФайлаМодуля = ПолучитьЗначениеРеквизитаОбъекта_КонтурEDI(ПутьКМодулю, "ИмяФайла");
		Иначе
			ЗначениеРеквизита = ПолучитьЗначениеРеквизитаОбъекта_КонтурEDI(ПутьКМодулю, "Наименование");
			ИмяФайлаМодуля = КонтурСтандарт_СтрШаблон_("%1.epf", ЗначениеРеквизита);
		КонецЕсли;	
		
	Иначе
		
		ИмяФайлаМодуля = "";	
		
	КонецЕсли;
	
	Возврат ИмяФайлаМодуля;
	
КонецФункции

Процедура ДополнитьКонтекстОбновленияПодключаемыйМодульИзСервиса_КонтурEDI(КонтекстОбновления)
	
	Если КонтекстОбновления.Расположение = ПеречисленияEDI_ВариантыРасположенияМодуля().Неизвестно Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		Если КонтекстОбновления.ПроверятьОбновление 
			ИЛИ КонтекстОбновления.ХешМодуля <> КонтекстОбновления.ХешСервис Тогда 
			
			ДанныеПлагина = Неопределено;
			ДанныеСервиса = КлиентСервисОбновлений_СписокПлагинов(КонтекстОбновления.ТипПлагина, 1);
			Если ДанныеСервиса.count > 0 Тогда
				ДанныеПлагина = ДанныеСервиса.plugins[0];
				КонтекстОбновления.ИдентификаторСервис = ДанныеПлагина.id;
				КонтекстОбновления.ХешСервис = ВРег(ДанныеПлагина.hash_md5);
			КонецЕсли;
			
		КонецЕсли;
		
		Если КонтекстОбновления.ПроверятьОбновление Тогда
			ДанныеСервиса = КлиентСервисОбновлений_СписокПлагинов("plugin-dd", 1, НРег(КонтекстОбновления.ХешМодуля));
			Если ДанныеСервиса.count > 0 Тогда
				ДанныеОбновления = ДанныеСервиса.plugins[0];
				ИсключаемыйИдентификаторОбновления = ПолучитьКонстантуEDI("ИсключаемыйИдентификаторОбновленияПМ");			
				Если (ДанныеПлагина = Неопределено
					ИЛИ ДанныеПлагина.updated < ДанныеОбновления.updated) И ДанныеОбновления.id <> ИсключаемыйИдентификаторОбновления Тогда 
					КонтекстОбновления.ИдентификаторОбновления = ДанныеОбновления.id;
					КонтекстОбновления.ХешОбновления = ВРег(ДанныеОбновления.hash_md5);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	Исключение  
		ТекстОшибки = ОписаниеОшибки();	
	КонецПопытки;
	
КонецПроцедуры

Функция КонтекстОбновленияРасширений_КонтурEDI()
	
	УстановленныеРасширения = ПолучитьИнформациюОбУстановленныхРасширениях();
	ТипПлагина  			 = "pm-standard";
	ИмяФайла 			 	 = "КонтурEDI_Расширения.zip"; 
	
	Если УстановленныеРасширения.Количество() Тогда
		ХешСумма = ХэшСумма(ЗначениеВСтрокуВнутр(УстановленныеРасширения));	 
	Иначе
		ХешСумма = "";                                            
	КонецЕсли;
	
	ХешСервис = ПолучитьКонстантуEDI("ХешРасширенийСервис");
	
	КонтекстОбновленияРасширений = Новый Структура;
	
	КонтекстОбновленияРасширений.Вставить("УстановленныеРасширения", 	УстановленныеРасширения);
	КонтекстОбновленияРасширений.Вставить("ТипПлагина", 				ТипПлагина);
	КонтекстОбновленияРасширений.Вставить("ХешСумма", 					ХешСумма);
	КонтекстОбновленияРасширений.Вставить("ИмяФайла", 					ИмяФайла);
	КонтекстОбновленияРасширений.Вставить("ИдентификаторСервис", 		"");
	КонтекстОбновленияРасширений.Вставить("ХешСервис", 				ХешСервис);
	
	ДополнитьКонтекстОбновленияРасширенийИзСервиса_КонтурEDI(КонтекстОбновленияРасширений);
	
	Возврат КонтекстОбновленияРасширений;
	
КонецФункции
 
Процедура ДополнитьКонтекстОбновленияРасширенийИзСервиса_КонтурEDI(КонтекстОбновления)
	
	Если НЕ ЗначениеЗаполнено(КонтекстОбновления.ХешСумма) Тогда	
		Возврат;		
	КонецЕсли;
	
	Попытка
		Если КонтекстОбновления.ХешСумма <> КонтекстОбновления.ХешСервис Тогда
			ДанныеПлагина = Неопределено;
			ДанныеСервиса = КлиентСервисОбновлений_СписокПлагинов(КонтекстОбновления.ТипПлагина, 1);
			Если ДанныеСервиса.count > 0 Тогда
				ДанныеПлагина = ДанныеСервиса.plugins[0];
				КонтекстОбновления.ИдентификаторСервис = ДанныеПлагина.id;
			КонецЕсли;
		КонецЕсли;
	Исключение
		КонтекстОбновления.ХешСервис = КонтекстОбновления.ХешСумма;
		ТекстОшибки = ОписаниеОшибки();	
	КонецПопытки;
	
КонецПроцедуры

Функция ИсключенныеВерсииМодуляАвтообновления()
	
	ИсключенныеВерсииМодуля = Новый Массив;
	
	ИсключенныеВерсииМодуляСтрокой = ПолучитьКонстантуEDI("ИсключенныеВерсииМодуляАвтообновления");
	
	Если НЕ ИсключенныеВерсииМодуляСтрокой = Неопределено Тогда
		РазделительВерсий = "/";
		ИсключенныеВерсииМодуля = КонтурСтандарт_СтрРазделить_(ИсключенныеВерсииМодуляСтрокой, РазделительВерсий, Ложь);		
	КонецЕсли;
	
	Возврат ИсключенныеВерсииМодуля;
	
КонецФункции

Функция ЭтоИсключеннаяВерсияМодуляАвтообновления(НомерВерсии)
	
	Если НЕ ЗначениеЗаполнено(НомерВерсии) Тогда
		Возврат Ложь;
	КонецЕсли;      
	
	ИсключенныеВерсии = ИсключенныеВерсииМодуляАвтообновления();		
	
	Возврат ИсключенныеВерсии.Найти(НомерВерсии) <> Неопределено;
	
КонецФункции

Процедура ДобавитьВерсиюМодуляВИсключениеАвтообновления(НомерВерсии) Экспорт
	
	Если НЕ ЭтоИсключеннаяВерсияМодуляАвтообновления(НомерВерсии) Тогда
		
		ИсключенныеВерсии = ИсключенныеВерсииМодуляАвтообновления();
		ИсключенныеВерсии.Добавить(НомерВерсии);	
		
		КоличествоХранимыхВерсий = 20;
		Если ИсключенныеВерсии.Количество() > КоличествоХранимыхВерсий Тогда
			ИсключенныеВерсии.Удалить(0);		
		КонецЕсли;
		
		РазделительВерсий = "/";
		ИсключенныеВерсииСтрокой = КонтурСтандарт_СтрСоединить_(ИсключенныеВерсии, РазделительВерсий);
		УстановитьКонстантуEDI("ИсключенныеВерсииМодуляАвтообновления", ИсключенныеВерсииСтрокой);
		
	КонецЕсли;
	
КонецПроцедуры

// #КонецОбласти

// #Область Синхронизация_данных_сервис_обновлений

Процедура СинхронизироватьДанныеСервисОбновлений() Экспорт
	
	СинхронизироватьРасширенияСервисОбновлений();
	СинхронизироватьПодключаемыйМодульСервисОбновлений();
	
КонецПроцедуры

Функция ДоступнаСинхронизацияДанныхСервисОбновлений() Экспорт
	
	Возврат НЕ (ПараметрыКлиентСервер.ДоменПользователяКонтур
			ИЛИ ЭтоТестовыйAPI()
			ИЛИ РаботаСВнешнимиРесурсамиЗаблокирована_КонтурEDI());
	
КонецФункции
			
Функция РаботаСВнешнимиРесурсамиЗаблокирована_КонтурEDI()
	
	Результат = Ложь; 
	
	Если ЕстьНеобходимыеМетаданные("Константы.ПараметрыБлокировкиРаботыСВнешнимиРесурсами") Тогда
		
		Попытка
			
			// BSLLS:SetPrivilegedMode-off
			УстановитьПривилегированныйРежим(Истина);
			// BSLLS:SetPrivilegedMode-on
			
			СохраненныеПараметры = Вычислить("Константы.ПараметрыБлокировкиРаботыСВнешнимиРесурсами.Получить().Получить()");
			УстановитьПривилегированныйРежим(Ложь);
			
		Исключение
			СохраненныеПараметры = Неопределено;
		КонецПопытки;
		
		Результат = КонтурСтандарт_ЗначениеПоКлючу(СохраненныеПараметры, "РаботаСВнешнимиРесурсамиЗаблокирована", Ложь);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти

// #Область Управление_расширениями

Процедура СинхронизироватьРасширенияСервисОбновлений() Экспорт
	
	Если НЕ (ТипЗнч(ТаблицаКэшИсполняемогоКодаРасширений) = Тип("ТаблицаЗначений")
				И ТаблицаКэшИсполняемогоКодаРасширений.Количество()
				И ВозможноСинхронизироватьРасширения()) Тогда
		Возврат;
	КонецЕсли;
	
	КонтекстОбновленияРасширений = КонтекстОбновленияРасширений_КонтурEDI();
	
	ВыгрузитьРасширенияСервисОбновлений(КонтекстОбновленияРасширений);
	
КонецПроцедуры

Функция ВозможноСинхронизироватьРасширения()
	
	СинхронизироватьРасширения = ПолучитьКонстантуEDI("СинхронизироватьРасширения"); 
	
	Если СинхронизироватьРасширения = Неопределено Тогда

		СинхронизироватьРасширения = ДоступнаСинхронизацияДанныхСервисОбновлений();
		
	КонецЕсли;
	
	Возврат СинхронизироватьРасширения;
	
КонецФункции

Процедура ВыгрузитьРасширенияСервисОбновлений(КонтекстОбновления)

	Если ЗначениеЗаполнено(КонтекстОбновления.ХешСумма) 
		И КонтекстОбновления.ХешСумма <> КонтекстОбновления.ХешСервис Тогда	

		Попытка   
			
			РезультатАрхивирования = ПолучитьДвоичныеДанныеФайлаАрхиваРасширенийМодуля_КонтурEDI(КонтекстОбновления.УстановленныеРасширения);
			
			Если НЕ РезультатАрхивирования.Успешно Тогда
				ВызватьИсключение "Не удалось получить двоичные данные zip-архива расширений";
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(КонтекстОбновления.ИдентификаторСервис) Тогда	
				ДанныеСервиса = КлиентСервисОбновлений_ОтправитьПлагин(РезультатАрхивирования.ДвоичныеДанные, КонтекстОбновления.ИмяФайла, КонтекстОбновления.ТипПлагина, "Файл обновлен модулем Контур.EDI"); 
			Иначе
				ДанныеСервиса = КлиентСервисОбновлений_ИзменитьПлагин(КонтекстОбновления.ИдентификаторСервис, РезультатАрхивирования.ДвоичныеДанные, КонтекстОбновления.ИмяФайла, КонтекстОбновления.ТипПлагина, "Файл выгружен модулем Контур.EDI");						
			КонецЕсли;
			УстановитьКонстантуEDI("ХешРасширенийСервис", КонтекстОбновления.ХешСумма);
			КонтекстОбновления.ИдентификаторСервис = ДанныеСервиса.id;
		Исключение
			ТекстОшибки = ОписаниеОшибки();
		КонецПопытки;	
		
	КонецЕсли;
	
КонецПроцедуры

// #КонецОбласти

// #Область Синхронизация_кастомных_модулей 

Функция ВозможноСинхронизироватьКастомныйМодуль() Экспорт

	СинхронизироватьКастомныйМодуль = ПолучитьКонстантуEDI("СинхронизироватьКастомныйМодуль"); 
	
	Если СинхронизироватьКастомныйМодуль = Неопределено Тогда

		СинхронизироватьКастомныйМодуль = ДоступнаСинхронизацияДанныхСервисОбновлений();
		
	КонецЕсли;
	
	Возврат СинхронизироватьКастомныйМодуль;

КонецФункции

Процедура СинхронизироватьКастомныйМодульСервисОбновлений(Знач КонтекстОбновленияМодуля) Экспорт
	
	ПризнакиМодифицированностиКонтента = ПеречисленияEDI_ПризнакиМодифицированностиКонтента();
	
	Если КонтекстОбновленияМодуля.Модифицированность <> ПризнакиМодифицированностиКонтента.Изменен 
		ИЛИ НЕ ВозможноСинхронизироватьКастомныйМодуль() Тогда
		Возврат;	
	КонецЕсли;
	
	ХешСервис = ПолучитьКонстантуEDI("ХешКастомногоМодуляСервис");
	ИмяФайла = КонтурСтандарт_СтрШаблон_("КонтурEDI_%1_Кастом.epf", КонтекстОбновленияМодуля.Версия);	
	
	КонтекстОбновленияМодуля.Вставить("ТипПлагина", "pm");
	КонтекстОбновленияМодуля.Вставить("ХешСервис", ХешСервис);
	КонтекстОбновленияМодуля.Вставить("ИдентификаторСервис", "");
	КонтекстОбновленияМодуля.Вставить("ДвоичныеДанные", Неопределено);
	КонтекстОбновленияМодуля.Вставить("ИмяФайла", ИмяФайла);
	
 	ДополнитьКонтекстОбновленияКастомныйМодульИзСервиса_КонтурEDI(КонтекстОбновленияМодуля);	
	
	ВыгрузитьКастомныйМодульСервисОбновлений(КонтекстОбновленияМодуля);
	
КонецПроцедуры

Процедура ДополнитьКонтекстОбновленияКастомныйМодульИзСервиса_КонтурEDI(КонтекстОбновления)
	
	Если НЕ КонтурСтандарт_ЭтоСтруктура(КонтекстОбновления) 
		ИЛИ КонтекстОбновления.ХешСумма = КонтекстОбновления.ХешСервис Тогда
		Возврат;
	КонецЕсли; 
	
	МенеджерНастроек = МенеджерНастроекСервисаОбновленийКастомныеМодули();
	
	Попытка
		ДанныеПлагина = Неопределено;
		ДанныеСервиса = КлиентСервисОбновлений_СписокПлагинов(КонтекстОбновления.ТипПлагина, 1, , МенеджерНастроек);
		Если ДанныеСервиса.count > 0 Тогда
			ДанныеПлагина = ДанныеСервиса.plugins[0];
			КонтекстОбновления.ИдентификаторСервис = ДанныеПлагина.id;
			КонтекстОбновления.ХешСервис = ВРег(ДанныеПлагина.hash_md5);
		КонецЕсли;
	Исключение
		КонтекстОбновления.ХешСервис = КонтекстОбновления.ХешСумма;	
	КонецПопытки;
	
КонецПроцедуры

Процедура ВыгрузитьКастомныйМодульСервисОбновлений(КонтекстОбновления)
	
	Если ЗначениеЗаполнено(КонтекстОбновления.ХешСумма) 
		И КонтекстОбновления.ХешСумма <> КонтекстОбновления.ХешСервис Тогда
		
		МенеджерНастроек = МенеджерНастроекСервисаОбновленийКастомныеМодули();
		КонтекстОбновления.ДвоичныеДанные = ДвоичныеДанныеТекущегоМодуля();
		
		Попытка	
			Если НЕ ЗначениеЗаполнено(КонтекстОбновления.ИдентификаторСервис) Тогда	
				ДанныеСервиса = КлиентСервисОбновлений_ОтправитьПлагин(КонтекстОбновления.ДвоичныеДанные, 
																		КонтекстОбновления.ИмяФайла, 
																		КонтекстОбновления.ТипПлагина,
																		"Файл выгружен модулем Контур.EDI",
																		, 
																		, 
																		МенеджерНастроек); 
			Иначе
				ДанныеСервиса = КлиентСервисОбновлений_ИзменитьПлагин(КонтекстОбновления.ИдентификаторСервис, 
																		КонтекстОбновления.ДвоичныеДанные, 
																		КонтекстОбновления.ИмяФайла, 
																		КонтекстОбновления.ТипПлагина, 
																		"Файл обновлен модулем Контур.EDI", 
																		, 
																		, 
																		МенеджерНастроек);						
			КонецЕсли;
			КонтекстОбновления.ИдентификаторСервис = ДанныеСервиса.id;
			УстановитьКонстантуEDI("ХешКастомногоМодуляСервис", КонтекстОбновления.ХешСумма);
		Исключение
			ТекстОшибки = ОписаниеОшибки();
		КонецПопытки;	
		
	КонецЕсли;
	
КонецПроцедуры

// #КонецОбласти

// #Область Управление_подключаемым_модулем

Процедура СинхронизироватьПодключаемыйМодульСервисОбновлений() Экспорт
	
	Если НЕ ИспользуетсяПодключаемыйМодуль = Истина 
		ИЛИ НЕ ВозможноСинхронизироватьПодключаемыйМодуль()
		ИЛИ НЕ КлиентСервисОбновлений_ИнтернетРесурсДоступен() Тогда
		Возврат;
	КонецЕсли;

	Попытка 
		КонтекстОбновленияПМ = КонтекстОбновленияПодключаемыйМодуль_КонтурEDI();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	ВыгрузитьПодключаемыйМодульСервисОбновлений(КонтекстОбновленияПМ);
	
КонецПроцедуры

Процедура ВыгрузитьПодключаемыйМодульСервисОбновлений(КонтекстПМ)
	
	Если ЗначениеЗаполнено(КонтекстПМ.ХешМодуля) 
		И КонтекстПМ.ХешМодуля <> КонтекстПМ.ХешСервис Тогда
		
		Попытка	
			Если КонтекстПМ.ХешМодуля = КонтекстПМ.ХешОбновления ИЛИ НЕ ЗначениеЗаполнено(КонтекстПМ.ИдентификаторСервис) Тогда	
				ДанныеСервиса = КлиентСервисОбновлений_ОтправитьПлагин(КонтекстПМ.ДвоичныеДанные, КонтекстПМ.ИмяФайла, КонтекстПМ.ТипПлагина, "Файл обновлен модулем Контур.EDI"); 
			Иначе
				ДанныеСервиса = КлиентСервисОбновлений_ИзменитьПлагин(КонтекстПМ.ИдентификаторСервис,КонтекстПМ.ДвоичныеДанные, КонтекстПМ.ИмяФайла, КонтекстПМ.ТипПлагина, "Файл выгружен модулем Контур.EDI");						
			КонецЕсли;
			КонтекстПМ.ИдентификаторСервис = ДанныеСервиса.id;
			УстановитьКонстантуEDI("ХешПодключаемогоМодуляСервис", КонтекстПМ.ХешМодуля);
		Исключение
			ТекстОшибки = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры 

Процедура ОбновитьПодключаемыйМодульСервисОбновлений(КонтекстОбновленияПМ) Экспорт
	
	Если ЗначениеЗаполнено(КонтекстОбновленияПМ.ХешОбновления)
		И КонтекстОбновленияПМ.ХешМодуля <> КонтекстОбновленияПМ.ХешОбновления Тогда
		
		Попытка
			
			Результат = КлиентСервисОбновлений_СкачатьПлагин(КонтекстОбновленияПМ.ИдентификаторОбновления);
			
			Если Результат <> Неопределено Тогда
				ДвоичныеДанныеМодуля = КонтекстОбновленияПМ.ДвоичныеДанные;
				РасположениеМодуля   = КонтекстОбновленияПМ.Расположение;
				ПутьКМодулю 	     = КонтекстОбновленияПМ.ПутьКМодулю;
				  
				ДвоичныеДанныеОбновления = Результат.ДвоичныеДанные;
				
				ФайлОбновлен = ОбновитьПодключаемыйМодульПоПути(ПутьКМодулю, ДвоичныеДанныеОбновления);

				Если ФайлОбновлен Тогда
					
					КонтекстОбновленияПМ.ДвоичныеДанные = ДвоичныеДанныеОбновления;
					КонтекстОбновленияПМ.ХешМодуля		= КонтекстОбновленияПМ.ХешОбновления;
					
				Иначе
					
					УстановитьКонстантуEDI("ИсключаемыйИдентификаторОбновленияПМ", КонтекстОбновленияПМ.ИдентификаторОбновления);
					ОбновитьПодключаемыйМодульПоПути(ПутьКМодулю, ДвоичныеДанныеМодуля);
					
				КонецЕсли;
								
			КонецЕсли;
			
		Исключение
			ТекстОшибки = ОписаниеОшибки()
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ОбновитьПодключаемыйМодульПоПути(ПутьКФайлу, ДвоичныеДанныеОбновления)
	
	Успешно = Ложь;
	
	Попытка
		
		Если ТипЗнч(ПутьКФайлу) = Тип("Строка") Тогда
			
			ДвоичныеДанныеОбновления.Записать(ПутьКФайлу);
			
		Иначе 	
			
			ИмяРеквизитаХранения = ПолучитьИмяРеквизитаХраненияОбработки_КонтурEDI(ПутьКФайлу);
			
			ОбъектСправочникаОбработок = ПутьКФайлу.ПолучитьОбъект();
			ОбъектСправочникаОбработок[ИмяРеквизитаХранения] = Новый ХранилищеЗначения(ДвоичныеДанныеОбновления);
			ОбъектСправочникаОбработок.Записать();
			
		КонецЕсли;
		
		ВнешнийМодуль = Неопределено;
		ИспользуетсяПодключаемыйМодуль = Истина;
		ИнициализироватьВнешнийПодключаемыйМодуль();
			
		Успешно = ИспользуетсяПодключаемыйМодуль;
	
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Успешно;
	
КонецФункции

Функция ВозможноСинхронизироватьПодключаемыйМодуль()
	
	СинхронизироватьПодключаемыйМодуль = ПолучитьКонстантуEDI("СинхронизироватьПодключаемыйМодуль"); 
	
	Если СинхронизироватьПодключаемыйМодуль = Неопределено Тогда
    
		СинхронизироватьПодключаемыйМодуль = ДоступнаСинхронизацияДанныхСервисОбновлений();

	КонецЕсли;
	
	Возврат СинхронизироватьПодключаемыйМодуль;
	
КонецФункции

// #КонецОбласти

// #Область Функциональные_опции_EDI 
	
Функция ПолучитьФункциональнуюОпциюEDI(ИмяОпции, ЗначениеПоУмолчанию) Экспорт
	
	ПолноеИмяОпции = КонтурСтандарт_СтрШаблон_("ОпцияEDI_%1", ИмяОпции); 
	
	ЗначениеОпции = ЭДО_Кэш_Прочитать(ПолноеИмяОпции);
	
	Если ЗначениеОпции = Неопределено Тогда
		
		Попытка
			
			Если НЕ КлиентСервисОбновлений_ИнтернетРесурсДоступен() Тогда
				ВызватьИсключение ТекстОшибкиОтсутствуетИнтернетСоединение();	
			КонецЕсли;
			
			ОсновнойGLN = ПолучитьКонстантуEDI("GLN_Основной");
			ПараметрОпции = КлиентСервисОбновлений_ПараметрФункциональнойОпции(ИмяОпции, ОсновнойGLN);
			
			ТипЗначенияПоУмолчанию = ТипЗнч(ЗначениеПоУмолчанию); 
			
			Если ТипЗначенияПоУмолчанию = Тип("Булево") Тогда
				ЗначениеОпции = XMLЗначение(Тип("Булево"), ПараметрОпции.value);
			Иначе
				ОписаниеТипаПоУмолчанию = Новый ОписаниеТипов(КонтурСтандарт_МассивЗначений(ТипЗначенияПоУмолчанию));
				ЗначениеОпции = ОписаниеТипаПоУмолчанию.ПривестиЗначение(ПараметрОпции.value);
			КонецЕсли;
			
			УстановитьКонстантуEDI(ПолноеИмяОпции, ЗначениеОпции);      
			
		Исключение
			
			ТекстОшибки = ОписаниеОшибки();
			
			ЗначениеОпции = ПолучитьКонстантуEDI(ПолноеИмяОпции); 
			
			Если ЗначениеОпции = Неопределено Тогда
				ЗначениеОпции = ЗначениеПоУмолчанию;
			КонецЕсли;

		КонецПопытки;
		
		ЭДО_Кэш_Поместить(ПолноеИмяОпции, ЗначениеОпции); 
		                   
	КонецЕсли;

	Возврат ЗначениеОпции;
	
КонецФункции

// #КонецОбласти

// #Область УведомленияEDI

Функция УведомленияEDI_ПараметрыЗапросаСервиса()
	
	КлючКэша = "РезультатФункции_УведомленияEDI_ПараметрыЗапросаСервиса";
		
	ПараметрыЗапросаСервиса = ЭДО_Кэш_Прочитать(КлючКэша);
	
	Если ПараметрыЗапросаСервиса = Неопределено Тогда
		
		МенеджерНастроек = КлиентСервисОбновлений_МенеджерНастроек();
		
		ПараметрыЗапросаСервиса 			= КлиентСервисОбновлений_Привести("NotificatinPostRequest");
		ПараметрыЗапросаСервиса.client_id   = ПараметрыКлиентСервер.ИдентификаторБазы;
		ПараметрыЗапросаСервиса.version	  	= ПараметрыКлиентСервер.ОписаниеВерсии.МажорМинорПатч;
		
		ПараметрыЗапросаСервиса.Вставить("conf_version"			, Метаданные.Версия);
		ПараметрыЗапросаСервиса.Вставить("conf_name"			, УведомленияEDI_ВозможныеВариантыИмениКонфигурации());
		ПараметрыЗапросаСервиса.Вставить("platform_version"		, ПараметрыКлиентСервер.ВерсияПлатформы1С);
		ПараметрыЗапросаСервиса.Вставить("client_gln"			, ПолучитьКонстантуEDI("GLN_Основной"));
		ПараметрыЗапросаСервиса.Вставить("partner_gln"			, УведомленияEDI_ИдентификаторыПартнеров());
		ПараметрыЗапросаСервиса.Вставить("seller"				, XMLСтрока(НастройкиМодуля.МыПоставщик));
		ПараметрыЗапросаСервиса.Вставить("buyer"				, XMLСтрока(НастройкиМодуля.МыТорговаяСеть));
		
		ЭДО_Кэш_Поместить(КлючКэша, ПараметрыЗапросаСервиса);
		
	КонецЕсли;
	
	Возврат ПараметрыЗапросаСервиса;
	
КонецФункции

Функция УведомленияEDI_ВозможныеВариантыИмениКонфигурации()
	
	ИменаКонфигурации = Новый Массив;
	
	ИменаКонфигурации.Добавить(НРег(Метаданные.Имя));
	ИменаКонфигурации.Добавить(НРег(Метаданные.КраткаяИнформация));
	ИменаКонфигурации.Добавить(НРег(ИмяКонфигурации1С));
	
	Возврат ИменаКонфигурации;
	
КонецФункции

Функция УведомленияEDI_ИдентификаторыПартнеров()
	
	ИдентификаторыПартнеров = Новый Массив;
	
	НастройкиПартнеров = ПолучитьЗначенияНастроекПартнеров( , Истина);
	
	Для Каждого КлючЗначение Из НастройкиПартнеров Цикл
		
		ИдентификаторыПартнеров.Добавить(КлючЗначение.Ключ);
		
	КонецЦикла;
	
	Возврат ИдентификаторыПартнеров;
	
КонецФункции  

Функция УведомленияEDI_СкрытыеУведомленияСеанса()
	
	АдресСкрытыхУведомлений = ПараметрыКлиентСервер.АдресаВХ.СкрытыеУведомленияСеанса;
	
	СкрытыеУведомления = Неопределено;
	
	Если ЭтоАдресВременногоХранилища(АдресСкрытыхУведомлений) Тогда
		СкрытыеУведомления = ПолучитьИзВременногоХранилища(АдресСкрытыхУведомлений);		
	КонецЕсли;
	
	Если СкрытыеУведомления = Неопределено Тогда 
		СкрытыеУведомления = Новый Соответствие;
	КонецЕсли;
	
	Возврат СкрытыеУведомления;	
	
КонецФункции

Процедура УведомленияEDI_СкрытьУведомленияСеанса(СписокУведомлений) Экспорт
	
	АдресСкрытыхУведомлений = ПараметрыКлиентСервер.АдресаВХ.СкрытыеУведомленияСеанса;
	
	СкрытыеУведомления = УведомленияEDI_СкрытыеУведомленияСеанса();
	
	Для Каждого ТекУведомление Из СписокУведомлений Цикл
		Если ТекУведомление.Приоритет = "high" Тогда
			Идентификатор = ТекУведомление.Идентификатор;
			СкрытыеУведомления.Вставить(Идентификатор, Идентификатор);
		КонецЕсли;
	КонецЦикла;	
	АдресСкрытыхУведомлений = ПоместитьВоВременноеХранилище(СкрытыеУведомления, АдресСкрытыхУведомлений);	
	
КонецПроцедуры

Функция УведомленияEDI_УведомленияСервиса() Экспорт
	
	Результат = Новый Структура("УведомленияEDI, ЕстьНепрочитанные, ЕстьНепрочитанныеВажные", Новый Массив, Ложь, Ложь);
	
	Если НЕ КлиентСервисОбновлений_ИнтернетРесурсДоступен() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		
		ТелоЗапроса = УведомленияEDI_ПараметрыЗапросаСервиса(); 
		
		Если НЕ ЗначениеЗаполнено(ТелоЗапроса.client_gln) Тогда
			Возврат Результат;
		КонецЕсли;
		
		ОтветСервиса = КлиентСервисОбновлений_СписокУведомлений(ТелоЗапроса);
		
		СписокУведомлений = ОтветСервиса.notifications;
		
		СкрытыеУведомленияСеанса = УведомленияEDI_СкрытыеУведомленияСеанса();			
		
		Для Каждого ТекущееУведомление Из СписокУведомлений Цикл
			
			КонтентУведомления = ТекущееУведомление.content;
			
			ИдентификаторУведомления = ТекущееУведомление.id;
			
			УведомлениеEDI = УведомленияEDI_НовыйУведомление();
			УведомлениеEDI.Идентификатор 		= ИдентификаторУведомления;
			УведомлениеEDI.Приоритет 			= ТекущееУведомление.priority;
			УведомлениеEDI.ДатаНачала 			= XMLЗначение(Тип("Дата"), ТекущееУведомление.date_from);
			УведомлениеEDI.ДатаКонца 			= XMLЗначение(Тип("Дата"), ТекущееУведомление.date_to);
			УведомлениеEDI.ЗаголовокКонтента 	= КонтентУведомления.title;
			УведомлениеEDI.ТелоКонтента 		= КонтентУведомления.body;
			
			Если НЕ КонтурСтандарт_ДоступныЗаписьЧтениеJSON() Тогда
				// в тексте контента остаются переносы вида \n
				УведомлениеEDI.ТелоКонтента = СтрЗаменить(УведомлениеEDI.ТелоКонтента, "\n", Символы.ПС);	
				УведомлениеEDI.ТелоКонтента = СтрЗаменить(УведомлениеEDI.ТелоКонтента, "\t", Символы.Таб);	
			КонецЕсли;
			
			ХешСуммаУведомления = ХэшСумма(ЗначениеВСтрокуВнутр(ТекущееУведомление));
			
			УведомлениеEDI.ХешСумма  = ХешСуммаУведомления;
			УведомлениеEDI.Прочитано = УведомлениеEDI_УведомлениеПрочитано(ИдентификаторУведомления, ХешСуммаУведомления);
			
			Результат.ЕстьНепрочитанные = Результат.ЕстьНепрочитанные ИЛИ НЕ УведомлениеEDI.Прочитано;
			
			Результат.ЕстьНепрочитанныеВажные = Результат.ЕстьНепрочитанныеВажные 
			ИЛИ (УведомлениеEDI.Приоритет = "high" 
			И НЕ УведомлениеEDI.Прочитано
			И СкрытыеУведомленияСеанса.Получить(ИдентификаторУведомления) = Неопределено);
			
			Результат.УведомленияEDI.Добавить(УведомлениеEDI);
			
		КонецЦикла;
		
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Процедура УведомленияEDI_ОбработатьПодменыПараметровКонтента(УведомленияEDI) Экспорт
	
	ПараметрыПодмены = УведомленияEDI_ПараметрыПодменыКонтента();	
	
	Для Каждого ТекУведомление Из УведомленияEDI Цикл

		ТелоКонтента = ТекУведомление.ТелоКонтента;
		
		Для Каждого ТекущийПараметрПодмены Из ПараметрыПодмены Цикл
			
			ИмяПараметра = КонтурСтандарт_СтрШаблон_("{{%1}}", ТекущийПараметрПодмены.Ключ);
			
			ТелоКонтента = СтрЗаменить(ТелоКонтента, ИмяПараметра, ТекущийПараметрПодмены.Значение); 
			ТелоКонтента = СтрЗаменить(ТелоКонтента, ВРег(ИмяПараметра), ТекущийПараметрПодмены.Значение); 
			ТелоКонтента = СтрЗаменить(ТелоКонтента, НРег(ИмяПараметра), ТекущийПараметрПодмены.Значение); 
			
		КонецЦикла;
		
		ТекУведомление.ТелоКонтента = ТелоКонтента; 
		
	КонецЦикла;

КонецПроцедуры

Функция УведомленияEDI_ПараметрыПодменыКонтента()
	
	КлючКэша = "РезультатФункции_УведомленияEDI_ПараметрыПодменыКонтента";
	
	ПараметрыПодмены = ЭДО_Кэш_Прочитать(КлючКэша);
	
	Если ПараметрыПодмены = Неопределено Тогда
		
		ПараметрыПодмены = Новый Структура;
		
		ПараметрыПодмены.Вставить("GLN", ПараметрыПользователяEDI.GLN_Подразделения);
		ПараметрыПодмены.Вставить("partyName", "");
		ПараметрыПодмены.Вставить("partyId", "");
		
		НашиОрганизации = ПолучитьСписокЭлементовСправочника("НашиОрганизации");
		НайденнаяСтрока = НашиОрганизации.Найти(ПараметрыПользователяEDI.GLN_Подразделения, "GLN");
		
		Если НайденнаяСтрока <> Неопределено Тогда
			ПараметрыПодмены.partyName = НайденнаяСтрока.Наименование;
			ПараметрыПодмены.partyId = НайденнаяСтрока.partyId;
		КонецЕсли;
		
		ПараметрыПодмены.Вставить("accountLogin", ПараметрыПользователяEDI.Логин);
		
		ПараметрыПодмены.Вставить("currentVersion", ПараметрыКлиентСервер.НомерРелизаМодуля);
		
		ЭДО_Кэш_Поместить(КлючКэша, ПараметрыПодмены);
		
	КонецЕсли;

	Возврат ПараметрыПодмены; 
	
КонецФункции

Функция УведомлениеEDI_УведомлениеПрочитано(ИдентификаторУведомления, ХешСуммаСервер)
		
	КлючНастроек = КонтурСтандарт_СтрШаблон_("ХешСумма_%1", СтрЗаменить(ИдентификаторУведомления, "-", ""));
	 
	ХешСуммаКлиент = УведомленияEDI_ЗагрузитьНастройку(КлючНастроек);
		
	Возврат ВРег(ХешСуммаКлиент) = ВРег(ХешСуммаСервер); 
	
КонецФункции

Процедура УведомленияEDI_УстановитьХешСумму(ИдентификаторУведомления, ХешСуммаСервер) Экспорт
	
	КлючНастроек = КонтурСтандарт_СтрШаблон_("ХешСумма_%1", СтрЗаменить(ИдентификаторУведомления, "-", ""));
	УведомленияEDI_СохранитьНастройку(КлючНастроек, ХешСуммаСервер);
	
КонецПроцедуры 

Функция УведомленияEDI_КлючОбъектаСохраненияНастроек()
	
	Возврат "КонтурEDI/УведомленияEDI";	
	
КонецФункции

Функция УведомленияEDI_ЗагрузитьНастройку(КлючНастроек)
	
	ЗначениеНастройки 	= Неопределено;
	КлючОбъекта 		= УведомленияEDI_КлючОбъектаСохраненияНастроек();
	
	Попытка                 
		ЗначениеНастройки = Вычислить("ХранилищеОбщихНастроек.Загрузить(КлючОбъекта, КлючНастроек)");
	Исключение
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Предупреждение, "Не удалось загрузить настройку уведомления EDI: " + ОписаниеОшибки());	
	КонецПопытки;
	
	Возврат ЗначениеНастройки;
	
КонецФункции

Процедура УведомленияEDI_СохранитьНастройку(ИмяНастройки, ЗначениеНастройки)
	
	КлючОбъекта = УведомленияEDI_КлючОбъектаСохраненияНастроек();
	
	Попытка
		Выполнить("ХранилищеОбщихНастроек.Сохранить(КлючОбъекта, ИмяНастройки, ЗначениеНастройки)");
	Исключение
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Предупреждение, "Не удалось сохранить настройку уведомления EDI: " + ОписаниеОшибки());	
