Функция ПолучитьТаблицуСохраненныхСертификатов(Отбор = Неопределено) Экспорт

	// Вернем таблицу сертификатов в соответствии с параметрами
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_ДополнительныеСправочники.Ссылка,
	|	КонтурEDI_ДополнительныеСправочники.Наименование КАК Отпечаток,
	|	КонтурEDI_ДопСпрДопРеквизиты_Расположение.Значение КАК Расположение,
	|	КонтурEDI_ДопСпрДопРеквизиты_СертификатДействуетПо.Значение КАК СертификатДействуетПо,
	|	КонтурEDI_ДопСпрДопРеквизиты_Организация.Значение КАК Организация,
	|	КонтурEDI_ДопСпрДопРеквизиты_ПоУмолчанию.Значение КАК ПоУмолчанию,
	|	КонтурEDI_ДопСпрДопРеквизиты_ИмяМодуляКриптографии.Значение КАК ИмяМодуляКриптографии,
	|	КонтурEDI_ДопСпрДопРеквизиты_ТипМодуляКриптографии.Значение КАК ТипМодуляКриптографии,
	|	КонтурEDI_ДопСпрДопРеквизиты_PowerOfAttorney.ЗначениеХранилищеЗначения КАК PowerOfAttorney,
	|	КонтурEDI_ДопСпрДопРеквизиты_Доверенность.Значение КАК Доверенность,
	|	КонтурEDI_ДопСпрДопРеквизиты_Доверенность.ЗначениеХранилищеЗначения КАК ДоверенностьСтруктура,
	|	КонтурEDI_ДопСпрДопРеквизиты_СвойстваСертификата.ЗначениеХранилищеЗначения КАК СвойстваСертификата,
	|	КонтурEDI_ДопСпрДопРеквизиты_ТребуетсяДоверенность.Значение КАК ТребуетсяДоверенность,
	|	КонтурEDI_ДопСпрДопРеквизиты_ИгнорируемыеОшибкиДоверенности.Значение КАК ИгнорируемыеОшибкиДоверенности
	|ПОМЕСТИТЬ ВТ_ДопРеквизиты
	|ИЗ
	|	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК КонтурEDI_ДопСпрДопРеквизиты_Расположение
	|		ПО (КонтурEDI_ДопСпрДопРеквизиты_Расположение.Ссылка = КонтурEDI_ДополнительныеСправочники.Ссылка)
	|			И (КонтурEDI_ДопСпрДопРеквизиты_Расположение.ИмяРеквизита = ""Расположение"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК КонтурEDI_ДопСпрДопРеквизиты_СертификатДействуетПо
	|		ПО (КонтурEDI_ДопСпрДопРеквизиты_СертификатДействуетПо.Ссылка = КонтурEDI_ДополнительныеСправочники.Ссылка)
	|			И (КонтурEDI_ДопСпрДопРеквизиты_СертификатДействуетПо.ИмяРеквизита = ""СертификатДействуетПо"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК КонтурEDI_ДопСпрДопРеквизиты_Пользователь1С
	|		ПО (КонтурEDI_ДопСпрДопРеквизиты_Пользователь1С.Ссылка = КонтурEDI_ДополнительныеСправочники.Ссылка)
	|			И (КонтурEDI_ДопСпрДопРеквизиты_Пользователь1С.ИмяРеквизита = ""Пользователь1С"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК КонтурEDI_ДопСпрДопРеквизиты_Организация
	|		ПО (КонтурEDI_ДопСпрДопРеквизиты_Организация.Ссылка = КонтурEDI_ДополнительныеСправочники.Ссылка)
	|			И (КонтурEDI_ДопСпрДопРеквизиты_Организация.ИмяРеквизита = ""Организация"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК КонтурEDI_ДопСпрДопРеквизиты_ПоУмолчанию
	|		ПО (КонтурEDI_ДопСпрДопРеквизиты_ПоУмолчанию.Ссылка = КонтурEDI_ДополнительныеСправочники.Ссылка)
	|			И (КонтурEDI_ДопСпрДопРеквизиты_ПоУмолчанию.ИмяРеквизита = ""ПоУмолчанию"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК КонтурEDI_ДопСпрДопРеквизиты_ИмяМодуляКриптографии
	|		ПО (КонтурEDI_ДопСпрДопРеквизиты_ИмяМодуляКриптографии.Ссылка = КонтурEDI_ДополнительныеСправочники.Ссылка)
	|			И (КонтурEDI_ДопСпрДопРеквизиты_ИмяМодуляКриптографии.ИмяРеквизита = ""ИмяМодуляКриптографии"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК КонтурEDI_ДопСпрДопРеквизиты_ТипМодуляКриптографии
	|		ПО (КонтурEDI_ДопСпрДопРеквизиты_ТипМодуляКриптографии.Ссылка = КонтурEDI_ДополнительныеСправочники.Ссылка)
	|			И (КонтурEDI_ДопСпрДопРеквизиты_ТипМодуляКриптографии.ИмяРеквизита = ""ТипМодуляКриптографии"")	
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК КонтурEDI_ДопСпрДопРеквизиты_PowerOfAttorney
	|		ПО (КонтурEDI_ДопСпрДопРеквизиты_PowerOfAttorney.Ссылка = КонтурEDI_ДополнительныеСправочники.Ссылка)
	|			И (КонтурEDI_ДопСпрДопРеквизиты_PowerOfAttorney.ИмяРеквизита = ""PowerOfAttorney"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК КонтурEDI_ДопСпрДопРеквизиты_Доверенность
	|		ПО (КонтурEDI_ДопСпрДопРеквизиты_Доверенность.Ссылка = КонтурEDI_ДополнительныеСправочники.Ссылка)
	|			И (КонтурEDI_ДопСпрДопРеквизиты_Доверенность.ИмяРеквизита = ""Доверенность"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК КонтурEDI_ДопСпрДопРеквизиты_СвойстваСертификата
	|		ПО (КонтурEDI_ДопСпрДопРеквизиты_СвойстваСертификата.Ссылка = КонтурEDI_ДополнительныеСправочники.Ссылка)
	|			И (КонтурEDI_ДопСпрДопРеквизиты_СвойстваСертификата.ИмяРеквизита = ""СвойстваСертификата"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК КонтурEDI_ДопСпрДопРеквизиты_ТребуетсяДоверенность
	|		ПО (КонтурEDI_ДопСпрДопРеквизиты_ТребуетсяДоверенность.Ссылка = КонтурEDI_ДополнительныеСправочники.Ссылка)
	|			И (КонтурEDI_ДопСпрДопРеквизиты_ТребуетсяДоверенность.ИмяРеквизита = ""ТребуетсяДоверенность"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК КонтурEDI_ДопСпрДопРеквизиты_ИгнорируемыеОшибкиДоверенности
	|		ПО (КонтурEDI_ДопСпрДопРеквизиты_ИгнорируемыеОшибкиДоверенности.Ссылка = КонтурEDI_ДополнительныеСправочники.Ссылка)
	|			И (КонтурEDI_ДопСпрДопРеквизиты_ИгнорируемыеОшибкиДоверенности.ИмяРеквизита = ""ИгнорируемыеОшибкиДоверенности"")
	|ГДЕ
	|	КонтурEDI_ДополнительныеСправочники.ИмяСправочника = ""Сертификаты""
	|	И НЕ КонтурEDI_ДополнительныеСправочники.ПометкаУдаления
	|	И КонтурEDI_ДопСпрДопРеквизиты_Пользователь1С.Значение = &Пользователь1С
	|	И &УсловиеПоОтпечатку
	|	И &УсловиеПоОрганизации
	|	И &УсловиеСертификатыПоУмолчанию
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ДопРеквизиты.Ссылка,
	|	ВТ_ДопРеквизиты.Организация,
	|	ВТ_ДопРеквизиты.Отпечаток,
	|	ЕСТЬNULL(ВТ_ДопРеквизиты.Расположение, ""клиент"") КАК Расположение,
	|	ЕСТЬNULL(ВТ_ДопРеквизиты.СертификатДействуетПо, ДАТАВРЕМЯ(1, 1, 1)) КАК СертификатДействуетПо,
	|	ЕСТЬNULL(ВТ_ДопРеквизиты.ПоУмолчанию, ЛОЖЬ) КАК ПоУмолчанию,
	|	ЕСТЬNULL(ВТ_ДопРеквизиты.ИмяМодуляКриптографии, """") КАК ИмяМодуляКриптографии,
	|	ЕСТЬNULL(ВТ_ДопРеквизиты.ТипМодуляКриптографии, 0) КАК ТипМодуляКриптографии, 
	|	ВТ_ДопРеквизиты.PowerOfAttorney КАК PowerOfAttorney, 
	|	ВТ_ДопРеквизиты.Доверенность КАК Доверенность, 
	|	ВТ_ДопРеквизиты.ДоверенностьСтруктура КАК ДоверенностьСтруктура, 
	|	ВТ_ДопРеквизиты.СвойстваСертификата КАК СвойстваСертификата, 
	|	ВТ_ДопРеквизиты.ТребуетсяДоверенность КАК ТребуетсяДоверенность, 
	|	ЕСТЬNULL(ВТ_ДопРеквизиты.ИгнорируемыеОшибкиДоверенности, """") КАК ИгнорируемыеОшибкиДоверенности
	|ПОМЕСТИТЬ ВТ_ДопРеквизиты_ПоПользователю
	|ИЗ
	|	ВТ_ДопРеквизиты КАК ВТ_ДопРеквизиты";
	
	Запрос.УстановитьПараметр("Пользователь1С", ПолучитьТекущегоПользователя1С());	
	Запрос.УстановитьПараметр("УсловиеПоОтпечатку", Истина);	
	Запрос.УстановитьПараметр("УсловиеПоОрганизации", Истина);	
	Запрос.УстановитьПараметр("УсловиеСертификатыПоУмолчанию", Истина);	
	
	Если ТипЗнч(Отбор) = Тип("Структура") 
		И Отбор.Свойство("СертификатыПоУмолчанию") 
		И Отбор.СертификатыПоУмолчанию = Истина Тогда
		
		Запрос.Текст = Запрос.Текст +
		"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_Организации
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	НЕ Организации.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Организации.Ссылка КАК Организация,
		|	ЕСТЬNULL(ВТ_ДопРеквизиты_ПоПользователю.Отпечаток, """") КАК Отпечаток,
		|	ЕСТЬNULL(ВТ_ДопРеквизиты_ПоПользователю.Расположение, ""клиент"") КАК Расположение,
		|	ЕСТЬNULL(ВТ_ДопРеквизиты_ПоПользователю.СертификатДействуетПо, ДАТАВРЕМЯ(1, 1, 1)) КАК СертификатДействуетПо,
		|	ЕСТЬNULL(ВТ_ДопРеквизиты_ПоПользователю.ИмяМодуляКриптографии, """") КАК ИмяМодуляКриптографии,
		|	ЕСТЬNULL(ВТ_ДопРеквизиты_ПоПользователю.ТипМодуляКриптографии, 0) ТипМодуляКриптографии,
		|	ВТ_ДопРеквизиты_ПоПользователю.PowerOfAttorney КАК PowerOfAttorney,
		|	ВТ_ДопРеквизиты_ПоПользователю.Доверенность КАК Доверенность,
		|	ВТ_ДопРеквизиты_ПоПользователю.ДоверенностьСтруктура КАК ДоверенностьСтруктура,
		|	ВТ_ДопРеквизиты_ПоПользователю.СвойстваСертификата КАК СвойстваСертификата,
		|	ВТ_ДопРеквизиты_ПоПользователю.ТребуетсяДоверенность КАК ТребуетсяДоверенность,
		|	ВТ_ДопРеквизиты_ПоПользователю.ИгнорируемыеОшибкиДоверенности КАК ИгнорируемыеОшибкиДоверенности		
		|ИЗ
		|	ВТ_Организации КАК ВТ_Организации
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДопРеквизиты_ПоПользователю КАК ВТ_ДопРеквизиты_ПоПользователю
		|		ПО ВТ_Организации.Ссылка = ВТ_ДопРеквизиты_ПоПользователю.Организация";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеСертификатыПоУмолчанию", "КонтурEDI_ДопСпрДопРеквизиты_ПоУмолчанию.Значение = ИСТИНА"); 
		
	Иначе
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПОМЕСТИТЬ ВТ_ДопРеквизиты_ПоПользователю", ""); 
		
	КонецЕсли;
		
	Если ТипЗнч(Отбор) = Тип("Структура") Тогда
		
		Если Отбор.Свойство("Организация") Тогда
			
			Запрос.УстановитьПараметр("Организация", Отбор.Организация);
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоОрганизации", "КонтурEDI_ДопСпрДопРеквизиты_Организация.Значение = &Организация"); 
			
		КонецЕсли;
		
		Если Отбор.Свойство("Отпечаток") Тогда
			
			Запрос.УстановитьПараметр("Отпечаток", Отбор.Отпечаток);
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоОтпечатку", "КонтурEDI_ДополнительныеСправочники.Наименование = &Отпечаток"); 
			
		КонецЕсли;
		
	КонецЕсли;
	
	// выразим типы
	ТипПользователи = ПолучитьТипЗначенияОбъекта("Пользователь", , Истина);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, 
		"КонтурEDI_ДопСпрДопРеквизиты_Пользователь1С.Значение", 
		"(ВЫРАЗИТЬ(КонтурEDI_ДопСпрДопРеквизиты_Пользователь1С.Значение КАК Справочник." + ТипПользователи + "))");
	
	ТипОрганизации = ПолучитьТипЗначенияОбъекта("ЮрФизЛицоСвое", , Истина);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Справочник.Организации", "Справочник." + ТипОрганизации);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, 
		"КонтурEDI_ДопСпрДопРеквизиты_Организация.Значение", 
		"(ВЫРАЗИТЬ(КонтурEDI_ДопСпрДопРеквизиты_Организация.Значение КАК Справочник." + ТипОрганизации + "))");
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, 
		"КонтурEDI_ДопСпрДопРеквизиты_ПоУмолчанию.Значение", 
		"(ВЫРАЗИТЬ(КонтурEDI_ДопСпрДопРеквизиты_ПоУмолчанию.Значение КАК Булево))");
	
	Таб = Запрос.Выполнить().Выгрузить();
	
	Таб.Колонки.Добавить("Доверенность_нов");
	Таб.Колонки.Добавить("СвойстваСертификата_нов");
	
	Для Каждого Строка Из Таб Цикл
		
		Если ЗначениеЗаполнено(Строка.Доверенность)
			И ТипЗнч(Строка.Доверенность) = Тип("СправочникСсылка.КонтурEDI_ДополнительныеСправочники") Тогда
			
			Строка.Доверенность_нов = ДовереностьСсылка_В_Новый_Доверенность(Строка.Доверенность);	
			
		ИначеЕсли ЗначениеЗаполнено(Строка.ДоверенностьСтруктура)
			И ТипЗнч(Строка.ДоверенностьСтруктура) = Тип("ХранилищеЗначения") Тогда
			
			Контракт_МашиночитаемаяДоверенность = Строка.ДоверенностьСтруктура.Получить();
			
			Если ТипЗнч(Контракт_МашиночитаемаяДоверенность) = Тип("Структура") Тогда
			
				Если Контракт_МашиночитаемаяДоверенность.Свойство("Идентификатор") Тогда 
					Строка.Доверенность_нов = Контракт_СтараяМашиночитаемаяДоверенность_В_МашиночитаемаяДоверенность(Строка.ДоверенностьСтруктура.Получить());
				Иначе
					
					ИННПредставителя = СвойствоСтруктуры(Контракт_МашиночитаемаяДоверенность, "Представитель.ИНН", "");
					ИННПредставителя = СвойствоСтруктуры(Контракт_МашиночитаемаяДоверенность, "СоставнойИдентификатор.ИННПредставителя", ИННПредставителя);
					
					Контракт_МашиночитаемаяДоверенность.СоставнойИдентификатор.Вставить("ИННПредставителя", ИННПредставителя);
				
					Строка.Доверенность_нов = Контракт_МашиночитаемаяДоверенность;
				КонецЕсли;

			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(Строка.PowerOfAttorney)
			И ТипЗнч(Строка.PowerOfAttorney) = Тип("ХранилищеЗначения") Тогда
			
			PoA_СтарыйФормат = Строка.PowerOfAttorney.Получить();
			
			Если ЗначениеЗаполнено(PoA_СтарыйФормат) Тогда
			
				Строка.Доверенность_нов = КонтурДиадокAPI_Привести("PowerOfAttorney", PoA_СтарыйФормат.PowerOfAttorney, Истина);
				Строка.Доверенность_нов.ДатаНачала = КонтурСтандарт_Ticks_to_Date(Строка.Доверенность_нов.ДатаНачала.КоличествоТиков); 	
				Строка.Доверенность_нов.СрокДействия = КонтурСтандарт_Ticks_to_Date(Строка.Доверенность_нов.СрокДействия.КоличествоТиков); 				
	
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Строка.СвойстваСертификата) Тогда
			Строка.СвойстваСертификата_нов = Строка.СвойстваСертификата.Получить();
		КонецЕсли;
		
	КонецЦикла;
	
	Таб.Колонки.Удалить("Доверенность");
	Таб.Колонки.Удалить("СвойстваСертификата");
	Таб.Колонки.Доверенность_нов.Имя = "Доверенность";
	Таб.Колонки.СвойстваСертификата_нов.Имя = "СвойстваСертификата";
	
	Возврат Таб;

КонецФункции

Процедура СохранитьСертификатыПоУмолчанию(ТаблицаСертификатов) Экспорт
	
	// прочитаем все текущие сертификаты
	ТаблицаНазначенныхСертификатов = ПолучитьТаблицуСохраненныхСертификатов();
	
	Для каждого Строка Из ТаблицаСертификатов Цикл
		
		ДанныеСертификата = Новый Структура;
		ДанныеСертификата.Вставить("Организация", 			Строка.Организация);
		ДанныеСертификата.Вставить("Отпечаток", 			Строка.Отпечаток);
		ДанныеСертификата.Вставить("Расположение", 			Строка.Расположение);
		ДанныеСертификата.Вставить("СертификатДействуетПо", Строка.ОкончаниеПериодаДействия);
		ДанныеСертификата.Вставить("Доверенность",			Строка.Доверенность);	
		ДанныеСертификата.Вставить("СвойстваСертификата",   Строка.СвойстваСертификата);
		ДанныеСертификата.Вставить("ТребуетсяДоверенность", Строка.ТребуетсяДоверенность);
		ДанныеСертификата.Вставить("ИгнорируемыеОшибкиДоверенности", Строка.ИгнорируемыеОшибкиДоверенности);
		СохранитьСертификатПоУмолчанию(ДанныеСертификата, ТаблицаНазначенныхСертификатов);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СохранитьСертификатПоУмолчанию(ДанныеСертификата, ТаблицаНазначенныхСертификатов = Неопределено) Экспорт
	
	Организация				= ДанныеСертификата.Организация;
	Отпечаток				= ДанныеСертификата.Отпечаток;
	Расположение			= ДанныеСертификата.Расположение;
	СертификатДействуетПо	= ДанныеСертификата.СертификатДействуетПо;
	Доверенность			= ДанныеСертификата.Доверенность;	
	СвойстваСертификата		= ДанныеСертификата.СвойстваСертификата;	
	ТребуетсяДоверенность	= ДанныеСертификата.ТребуетсяДоверенность;               
	ИгнорируемыеОшибкиДоверенности = ДанныеСертификата.ИгнорируемыеОшибкиДоверенности;
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		// Что-то пошло не так, не будем ничего сохранять
		Возврат;
	КонецЕсли;
	
	Если ТаблицаНазначенныхСертификатов = Неопределено Тогда
		ОтборПоСертификатам = Новый Структура;
		ОтборПоСертификатам.Вставить("Организация", Организация);
		
		ТаблицаНазначенныхСертификатов = ПолучитьТаблицуСохраненныхСертификатов(ОтборПоСертификатам);
	КонецЕсли;
	
	// найдем сертификат организации по умолчанию
	НайденныеСтроки 		= ТаблицаНазначенныхСертификатов.НайтиСтроки(Новый Структура("Организация, ПоУмолчанию", Организация, Истина));
	СертификатПоУмолчанию 	= ?(НайденныеСтроки.Количество() > 0, НайденныеСтроки[0], Неопределено);
	НайденныеСтроки 		= Неопределено;
	
	Если Не ЗначениеЗаполнено(Отпечаток) Тогда
		
		Если СертификатПоУмолчанию <> Неопределено Тогда
		
			// отпечаток не передан, убираем сертификат по умолчанию
	        ЗаписатьДопРеквизитСправочника_КонтурEDI(СертификатПоУмолчанию.Ссылка, "ПоУмолчанию", Ложь);
		
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	// найдем сертификат с текущим отпечатком
	НайденныеСтроки 				= ТаблицаНазначенныхСертификатов.НайтиСтроки(Новый Структура("Организация, Отпечаток", Организация, Отпечаток));
	СертификатСТекущимОтпечатком 	= ?(НайденныеСтроки.Количество() > 0, НайденныеСтроки[0], Неопределено);
	НайденныеСтроки 				= Неопределено;
	
	Если СертификатСТекущимОтпечатком = Неопределено Тогда
	
		Если СертификатПоУмолчанию <> Неопределено
			И СертификатПоУмолчанию.Отпечаток <> Отпечаток Тогда
			
			// сбросим признак по умолчанию для другого сертификата
	        ЗаписатьДопРеквизитСправочника_КонтурEDI(СертификатПоУмолчанию.Ссылка, "ПоУмолчанию", Ложь);
			
		КонецЕсли;
		
		// нет записей с этим отпечатком, создаем новую
		СоздатьНовуюЗаписьСертификата(ДанныеСертификата);	
		
	ИначеЕсли СертификатСТекущимОтпечатком <> Неопределено
		И СертификатСТекущимОтпечатком <> СертификатПоУмолчанию Тогда
		
		Если СертификатПоУмолчанию <> Неопределено Тогда
			
			// установим старый сертификат не по умолчанию
	        ЗаписатьДопРеквизитСправочника_КонтурEDI(СертификатПоУмолчанию.Ссылка, "ПоУмолчанию", Ложь);

		КонецЕсли;
		
		// сертификат уже создан, установим по умолчанию
		ЗаписатьДопРеквизитСправочника_КонтурEDI(СертификатСТекущимОтпечатком.Ссылка, "ПоУмолчанию", Истина);
		ЗаписатьДопРеквизитСправочника_КонтурEDI(СертификатСТекущимОтпечатком.Ссылка, "ТребуетсяДоверенность", ТребуетсяДоверенность);
		
	КонецЕсли;
	
	Если СертификатСТекущимОтпечатком <> Неопределено Тогда
		
		// и обновим его расположение
		ЗаписатьДопРеквизитСправочника_КонтурEDI(СертификатСТекущимОтпечатком.Ссылка, "Расположение", Расположение);

		ЗаписатьДопРеквизитСправочника_КонтурEDI(СертификатСТекущимОтпечатком.Ссылка, "ТребуетсяДоверенность", ТребуетсяДоверенность);
		ЗаписатьДопРеквизитСправочника_КонтурEDI(СертификатСТекущимОтпечатком.Ссылка, "ИгнорируемыеОшибкиДоверенности", ИгнорируемыеОшибкиДоверенности);
	КонецЕсли;		
	
	Если ЗначениеЗаполнено(СертификатСТекущимОтпечатком) И ЗначениеЗаполнено(СертификатСТекущимОтпечатком.Ссылка) Тогда		
		
		СертификатСТекущимОтпечаткомОбъект = СертификатСТекущимОтпечатком.Ссылка.ПолучитьОбъект();
		ДополнительныеРеквизитыХранилищеЗначений = Новый Массив;
		ДополнительныеРеквизитыХранилищеЗначений.Добавить("СвойстваСертификата");             
		
		Для Каждого ДополнительныйРеквизит Из ДополнительныеРеквизитыХранилищеЗначений Цикл
			
			СтрокаРеквизита = СертификатСТекущимОтпечаткомОбъект.ДополнительныеРеквизиты.Найти(ДополнительныйРеквизит, "ИмяРеквизита");
			Если СтрокаРеквизита = Неопределено Тогда
				
				СтрокаРеквизита = СертификатСТекущимОтпечаткомОбъект.ДополнительныеРеквизиты.Добавить();
				СтрокаРеквизита.ИмяРеквизита = ДополнительныйРеквизит;
				СтрокаРеквизита.Значение = "ХранилищеЗначений";
				
			КонецЕсли;
			
			СтрокаРеквизита.ЗначениеХранилищеЗначения = Новый ХранилищеЗначения(ДанныеСертификата[ДополнительныйРеквизит]);
			
		КонецЦикла; 
		
		СохранитьДоверенностьКСертификату(СертификатСТекущимОтпечаткомОбъект, ДанныеСертификата.Доверенность);
		
		СертификатСТекущимОтпечаткомОбъект.Записать(); 
		
	КонецЕсли;	
	
КонецПроцедуры

Процедура СохранитьДоверенностьКСертификату(СертификатОбъект, Доверенность) Экспорт
	
	ДопРеквизитыСертификата = СертификатОбъект.ДополнительныеРеквизиты;
	
	ДопРеквизитДоверенность = ДопРеквизитыСертификата.Найти("Доверенность", "ИмяРеквизита");
	
	Если ДопРеквизитДоверенность = Неопределено И ЗначениеЗаполнено(Доверенность) Тогда
		
		ДопРеквизитДоверенность = ДопРеквизитыСертификата.Добавить();
		ДопРеквизитДоверенность.ИмяРеквизита = "Доверенность";
		
	ИначеЕсли ДопРеквизитДоверенность <> Неопределено И Не ЗначениеЗаполнено(Доверенность) Тогда
		
		ДопРеквизитыСертификата.Удалить(ДопРеквизитыСертификата.Индекс(ДопРеквизитДоверенность));
		
	КонецЕсли;

	Если ЗначениеЗаполнено(Доверенность) Тогда
		
		ДопРеквизитДоверенность.Значение = "Структура";
		ДопРеквизитДоверенность.ЗначениеХранилищеЗначения = Новый ХранилищеЗначения(Доверенность);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СоздатьНовуюЗаписьСертификата(ДанныеСертификата, ПоУмолчанию = Истина)
	
	Организация				= ДанныеСертификата.Организация;
	Отпечаток				= ДанныеСертификата.Отпечаток;
	Расположение			= ДанныеСертификата.Расположение;
	СертификатДействуетПо	= ДанныеСертификата.СертификатДействуетПо;
	ТребуетсяДоверенность	= ДанныеСертификата.ТребуетсяДоверенность; 
	
	ПарольКонтейнера = "";
	ДанныеСертификата.Свойство("ПарольКонтейнера", ПарольКонтейнера);

	Если ВнешнееХранилище Тогда
		ЭлементОбъект = СоединениеСХранилищем.Справочники.КонтурEDI_ДополнительныеСправочники.СоздатьЭлемент();
	Иначе
		ЭлементОбъект = Справочники.КонтурEDI_ДополнительныеСправочники.СоздатьЭлемент();
	КонецЕсли;
	
	ЭлементОбъект.Наименование = Отпечаток;
	ЭлементОбъект.ИмяСправочника = "Сертификаты";
	
	ДопРеквизиты = Новый Структура;
	ДопРеквизиты.Вставить("Организация", 			Организация);
	ДопРеквизиты.Вставить("СертификатДействуетПо", 	СертификатДействуетПо);
	ДопРеквизиты.Вставить("Пользователь1С", 		ПолучитьТекущегоПользователя1С());
	ДопРеквизиты.Вставить("ПоУмолчанию", 			ПоУмолчанию);
	ДопРеквизиты.Вставить("Расположение", 			Расположение);
	ДопРеквизиты.Вставить("ТребуетсяДоверенность", 	ТребуетсяДоверенность);
	
	ЗаполнитьДопРеквизитыОбъектаСправочника_КонтурEDI(ЭлементОбъект, ДопРеквизиты);
	
	НоваяСтрока = ЭлементОбъект.ДополнительныеРеквизиты.Добавить();
	НоваяСтрока.ИмяРеквизита = "УникальныйИдентификатор";
	ЗашифрованныйПарольКонтейнера = СимметричноеШифрованиеТабличнымСмещением_Контур(ПарольКонтейнера, "Прямое");
	НоваяСтрока.ЗначениеХранилищеЗначения = Новый ХранилищеЗначения(ЗашифрованныйПарольКонтейнера);
	
	ДополнительныеРеквизитыХранилищеЗначений = Новый Массив;

	Если ДанныеСертификата.Свойство("СвойстваСертификата") Тогда
		ДополнительныеРеквизитыХранилищеЗначений.Добавить("СвойстваСертификата");
	КонецЕсли;
	
	Для Каждого ДополнительныйРеквизит Из ДополнительныеРеквизитыХранилищеЗначений Цикл
		
		НоваяЗапись = ЭлементОбъект.ДополнительныеРеквизиты.Добавить();
		НоваяЗапись.ИмяРеквизита = ДополнительныйРеквизит;
		НоваяЗапись.Значение = "ХранилищеЗначений";
		НоваяЗапись.ЗначениеХранилищеЗначения = Новый ХранилищеЗначения(ДанныеСертификата[ДополнительныйРеквизит]);
		
	КонецЦикла;
	
	СохранитьДоверенностьКСертификату(ЭлементОбъект, ДанныеСертификата.Доверенность); 
	
	ЭлементОбъект.Записать();
	
КонецПроцедуры

Процедура СохранитьПараметрыСертификата(ДанныеСертификата) Экспорт
	
	Организация				= ДанныеСертификата.Организация;
	Отпечаток				= ДанныеСертификата.Отпечаток;
	
	Если Не ЗначениеЗаполнено(Отпечаток) Тогда
		Возврат;
	КонецЕсли;
	
	ОтборПоСертификатам = Новый Структура;
	ОтборПоСертификатам.Вставить("Организация", Организация);
	ОтборПоСертификатам.Вставить("Отпечаток", Отпечаток);
	
	// прочитаем сертификат организации с отпечатком
	ТаблицаСертификатовОрганизации = ПолучитьТаблицуСохраненныхСертификатов(ОтборПоСертификатам);
	
	СертификатСТекущимОтпечатком = ?(ТаблицаСертификатовОрганизации.Количество() > 0, ТаблицаСертификатовОрганизации[0], Неопределено);

	Если СертификатСТекущимОтпечатком = Неопределено Тогда
		
		// нет записей с этим отпечатком, создаем новую
		СертификатПоУмолчанию = Ложь;
		СоздатьНовуюЗаписьСертификата(ДанныеСертификата, СертификатПоУмолчанию);
		
	Иначе
		
		// запись уже есть, просто запишем пароль
		СертификатОбъект 	= СертификатСТекущимОтпечатком.Ссылка.ПолучитьОбъект();
		СтрокаСПаролем 		= СертификатОбъект.ДополнительныеРеквизиты.Найти("УникальныйИдентификатор", "ИмяРеквизита");
		
		ПарольКонтейнера = Неопределено;
		ДанныеСертификата.Свойство("ПарольКонтейнера", ПарольКонтейнера);
		
		ДопРеквизиты = Новый Структура;
		Если ДанныеСертификата.Свойство("ИмяМодуляКриптографии") Тогда
			ДопРеквизиты.Вставить("ИмяМодуляКриптографии", 	ДанныеСертификата.ИмяМодуляКриптографии);
		КонецЕсли;
		Если ДанныеСертификата.Свойство("ТипМодуляКриптографии") Тогда
			ДопРеквизиты.Вставить("ТипМодуляКриптографии", 	ДанныеСертификата.ТипМодуляКриптографии);
		КонецЕсли;
		
		ЗаполнитьДопРеквизитыОбъектаСправочника_КонтурEDI(СертификатОбъект, ДопРеквизиты);
		
		Если НЕ ПарольКонтейнера = Неопределено Тогда
			
			Если СтрокаСПаролем = Неопределено Тогда
				СтрокаСПаролем = СертификатОбъект.ДополнительныеРеквизиты.Добавить();
				СтрокаСПаролем.ИмяРеквизита = "УникальныйИдентификатор";
			КонецЕсли;
			
			ЗашифрованныйПарольКонтейнера = СимметричноеШифрованиеТабличнымСмещением_Контур(ПарольКонтейнера, "Прямое");
			СтрокаСПаролем.ЗначениеХранилищеЗначения = Новый ХранилищеЗначения(ЗашифрованныйПарольКонтейнера);
			
		КонецЕсли;
		
		СертификатОбъект.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПарольКонтейнераСертификата(Организация, Отпечаток) Экспорт
	
	ПарольКонтейнера = "";
	
	ОтборПоСертификатам = Новый Структура;
	ОтборПоСертификатам.Вставить("Организация", Организация);
	ОтборПоСертификатам.Вставить("Отпечаток", Отпечаток);
	
	ТабСертификатовОрганизации = ПолучитьТаблицуСохраненныхСертификатов(ОтборПоСертификатам);
	
	СертификатСТекущимОтпечатком = ?(ТабСертификатовОрганизации.Количество() > 0, ТабСертификатовОрганизации[0], Неопределено);
	
	Если СертификатСТекущимОтпечатком <> Неопределено Тогда
		
		СертификатСсылка 	= СертификатСТекущимОтпечатком.Ссылка;
		СтрокаСПаролем 		= СертификатСсылка.ДополнительныеРеквизиты.Найти("УникальныйИдентификатор", "ИмяРеквизита");
		
		Если СтрокаСПаролем <> Неопределено Тогда
			
			ПарольКонтейнера = СтрокаСПаролем.ЗначениеХранилищеЗначения.Получить();
			ПарольКонтейнера = ?(ЗначениеЗаполнено(ПарольКонтейнера), ПарольКонтейнера, "");
			ПарольКонтейнера = СимметричноеШифрованиеТабличнымСмещением_Контур(ПарольКонтейнера, "Обратное");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ПарольКонтейнера;
	
КонецФункции

//-------------------------------------------------------------------------------------------------
// Вызовы модуля криптографии ---------------------------------------------------------------------
//-------------------------------------------------------------------------------------------------

Функция МодульСервернойКриптографии()
	
	Если МодульСервернойКриптографии = Неопределено Тогда
		МодульСервернойКриптографии = Вычислить("КонтурEDI_Криптография");
	КонецЕсли;
	
	Возврат МодульСервернойКриптографии;
	
КонецФункции

Функция МодульСервернойКриптографииДоступен() Экспорт
	
	Если МодульСервернойКриптографииДоступен = Неопределено Тогда
		
		МодульСервернойКриптографииДоступен = Ложь;

		Если НЕ EDI_ИнформационнаяБазаФайловая() 
			И ЕстьНеобходимыеМетаданные("ОбщиеМодули.КонтурEDI_Криптография") 
			И Не ЭтоУФ() Тогда
			
			Если Число(МодульСервернойКриптографии().Версия()) >= 1.02 Тогда
				МодульСервернойКриптографииДоступен = Истина;
			КонецЕсли;	
			
		КонецЕсли;	
		
	КонецЕсли;
	
	Возврат МодульСервернойКриптографииДоступен;
	
КонецФункции

Функция МассивСертификатов_КонтурEDI(ТолькоДействующие = Истина) Экспорт
	
	МассивСертификатов = Новый Массив;
	
	Если МодульСервернойКриптографииДоступен() Тогда
		
		Расположение = ВариантРасположенияКриптографииСервер();
		КоллекцияСертификатовХранилища = Криптография_ПолучитьСертификатыДляПодписиШифрования(ТолькоДействующие, Расположение); 
		
		Для каждого ОписаниеСертификата Из КоллекцияСертификатовХранилища Цикл
			
			СвойстваСертификата = СвойстваСертификата(ОписаниеСертификата, Расположение);
			МассивСертификатов.Добавить(СвойстваСертификата);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЭтоУФ() И EDI_ИнформационнаяБазаФайловая() Тогда
		Возврат МассивСертификатов;
	КонецЕсли;
	
	Если ЭтоУФ() Тогда 
		Расположение = ВариантРасположенияКриптографииСервер();
	Иначе
		Расположение = ВариантРасположенияКриптографииКлиент();
	КонецЕсли;
	
	Попытка
		КоллекцияСертификатовХранилища = Криптография_ПолучитьСертификатыДляПодписиШифрования(ТолькоДействующие, Расположение);
		
		Для каждого ОписаниеСертификата Из КоллекцияСертификатовХранилища Цикл
			
			СвойстваСертификата = СвойстваСертификата(ОписаниеСертификата, Расположение);
			МассивСертификатов.Добавить(СвойстваСертификата);
			
		КонецЦикла;
	Исключение
		
		_ОписаниеОшибки = ОписаниеОшибки();
		
		Если Найти(_ОписаниеОшибки, "Не удалось определить настройки криптографии") <> 0 Тогда
			
			ТекстСообщения = "Не удалось определить настройки криптографии " + ?(Расположение = "клиент", "локально", "на сервере");
			
		Иначе
			
			Если ЭтоУФ() Тогда
				ТекстОшибки = "Не удалось получить сертификаты из серверного хранилища сертификатов по причине:";
			Иначе
				ТекстОшибки = "Не удалось получить сертификаты из локального хранилища сертификатов по причине:";
			КонецЕсли;
			
			ТекстСообщения = ТекстОшибки + Символы.ПС + _ОписаниеОшибки;
			
		КонецЕсли;	
		
		Сообщить(ТекстСообщения);
		
	КонецПопытки;

	Возврат МассивСертификатов;
	
КонецФункции

Функция ПолучитьПодписьФайлаДокумента_КонтурEDI(АдресФайла, ДанныеАвторизации) Экспорт
	
	Результат = ИнициализироватьСтруктуруРезультатаФункции(Ложь);
	
	Попытка 
		
		Если ЭтоАдресВременногоХранилища(АдресФайла) Тогда	
			ПутьКФайлу = ПолучитьИмяВременногоФайла();
			Файл = ПолучитьИзВременногоХранилища(АдресФайла);
			Файл.Записать(ПутьКФайлу);
			
			Контент = ПутьКФайлу;
			
		Иначе     
			
			Контент = АдресФайла;				
			
		КонецЕсли;
		
		Подпись = Криптография_Подписать(Контент, ДанныеАвторизации.Отпечаток, ДанныеАвторизации.ПарольКонтейнера, ДанныеАвторизации.Расположение);
		
		ШифрованнаяПодпись = Base64Строка(Подпись);
		
		Результат.Успешно = Истина;
		Результат.Вставить("ШифрованнаяПодпись", ШифрованнаяПодпись);
	Исключение
		Результат.ОписаниеОшибки = ОписаниеОшибки();	
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьРеквизитыСертификата_КонтурEDI(ДанныеАвторизации) Экспорт
	
	РеквизитыСертификата = Неопределено;	
	
	Сертификат = Криптография_НайтиПоОтпечатку(ДанныеАвторизации.Отпечаток, ДанныеАвторизации.Расположение);
	
	РеквизитыСертификата = ПолучитьРеквизиты1ССертификата(Сертификат, ДанныеАвторизации.Расположение);
	
	Возврат РеквизитыСертификата;
	
КонецФункции

Функция ПолучитьСертификат1СПоОтпечатку_КонтурEDI(ДанныеАвторизации, ЭкспортСертификата = Ложь) Экспорт		
	
	Сертификат = Криптография_НайтиПоОтпечатку(ДанныеАвторизации.Отпечаток, ДанныеАвторизации.Расположение);
	
	Если НЕ Сертификат = Неопределено И ЭкспортСертификата Тогда
		Сертификат = Base64Строка(Сертификат.ДвоичныеДанные);		
	КонецЕсли;	
	
	Возврат Сертификат;
	
КонецФункции

Функция ПолучитьСвойстваСертификата_КонтурEDI(ДанныеАвторизации) Экспорт
	
	СвойстваСертификата = Неопределено;	
	
	ДанныеСертификата = Криптография_НайтиПоОтпечатку(ДанныеАвторизации.Отпечаток, ДанныеАвторизации.Расположение);
	
	СвойстваСертификата = СвойстваСертификата(ДанныеСертификата, ДанныеАвторизации.Расположение);
	
	Возврат СвойстваСертификата;
	
КонецФункции

Функция РасшифроватьЗашифрованныйТокен_КонтурEDI(ЗашифрованныйТокен, ДанныеАвторизации) Экспорт
		
	РасшифрованныеДанные = Криптография_Расшифровать(ЗашифрованныйТокен, , ДанныеАвторизации.ПарольКонтейнера, ДанныеАвторизации.Расположение);
	
	Токен = КонтурСтандарт_Base64Строка(РасшифрованныеДанные);

	Возврат Токен;
	
КонецФункции

//-------------------------------------------------------------------------------------------------
// Дополнительные процедуры и функции криптографии ------------------------------------------------------------
//-------------------------------------------------------------------------------------------------

Функция ВариантРасположенияКриптографииСервер() Экспорт
	
	Возврат "сервер";
	
КонецФункции

Функция ВариантРасположенияКриптографииКлиент() Экспорт
	
	Возврат "клиент";
	
КонецФункции

Процедура ДополнитьСтруктуруНастройкамиКриптографииДляСервера(Структура = Неопределено)
	
	Структура.Вставить("ВариантыНастроекКриптографии", Криптография_ВариантыНастройкиКриптографии());
	Структура.Вставить("СписокСвойствСертификата", СписокСвойствСертификата_КонтурEDI());
	
КонецПроцедуры

Функция СписокСвойствСертификата_КонтурEDI()
	
	Возврат "Версия,
			 |ДатаНачала,
			 |ДатаОкончания,
			 |Издатель,
			 |ИспользоватьДляПодписи,
			 |ИспользоватьДляШифрования,
			 |ОткрытыйКлюч,
			 |Отпечаток,
			 |РасширенныеСвойства,
			 |СерийныйНомер,
			 |Субъект";

КонецФункции

Функция ПолучитьРеквизиты1ССертификата(Сертификат, Расположение = "сервер") Экспорт
	
	РеквизитыСертификата = ШаблонРеквизитовСертификата();

	РеквизитыСертификата.Расположение = Расположение;
	РеквизитыСертификата.СвойстваСертификата = СвойстваСертификата(Сертификат, Расположение);
	
	НаименованиеОрганизацииСубъекта	= "";
	Если Сертификат.Субъект.Свойство("O") Тогда
		НаименованиеОрганизацииСубъекта = Сертификат.Субъект.O;
	КонецЕсли;
	
	НаименованиеСубъекта = "";
	Если Сертификат.Субъект.Свойство("SN") 
		И Сертификат.Субъект.Свойство("GN") Тогда
		НаименованиеСубъекта = Сертификат.Субъект.SN + " " + Сертификат.Субъект.GN;
	ИначеЕсли Сертификат.Субъект.Свойство("SN") 
		И Сертификат.Субъект.Свойство("G") Тогда
		НаименованиеСубъекта = Сертификат.Субъект.SN + " " + Сертификат.Субъект.G;
	ИначеЕсли Сертификат.Субъект.Свойство("CN") Тогда
		НаименованиеСубъекта = Сертификат.Субъект.CN;
	КонецЕсли;
		
	НаименованиеУдостоверяющегоЦентра = ""; 
	Если Сертификат.Издатель.Свойство("O") Тогда
		НаименованиеУдостоверяющегоЦентра = Сертификат.Издатель.O;
	ИначеЕсли Сертификат.Издатель.Свойство("CN") Тогда
		НаименованиеУдостоверяющегоЦентра = Сертификат.Издатель.CN;
	КонецЕсли;
	
	РеквизитыСертификата.НаименованиеОрганизацииСубъекта 	= НаименованиеОрганизацииСубъекта;
	РеквизитыСертификата.НаименованиеСубъекта 				= НаименованиеСубъекта;
	РеквизитыСертификата.НачалоПериодаДействия 				= Сертификат.ДатаНачала;
	РеквизитыСертификата.ОкончаниеПериодаДействия 			= Сертификат.ДатаОкончания;
	РеквизитыСертификата.НаименованиеУдостоверяющегоЦентра 	= НаименованиеУдостоверяющегоЦентра;
	РеквизитыСертификата.Отпечаток 							= СтрЗаменить(Строка(Сертификат.Отпечаток), " ", "");
	
	Возврат РеквизитыСертификата;	
	
КонецФункции

Функция ШаблонРеквизитовСертификата() Экспорт 
	
	Структура = Новый Структура;
	Структура.Вставить("НаименованиеОрганизацииСубъекта",	"");
	Структура.Вставить("НаименованиеСубъекта",				"");
	Структура.Вставить("НачалоПериодаДействия",				Дата(1,1,1));
	Структура.Вставить("ОкончаниеПериодаДействия",			Дата(1,1,1));
	Структура.Вставить("НаименованиеУдостоверяющегоЦентра",	"");
	Структура.Вставить("Отпечаток",							"");
	Структура.Вставить("Расположение",						""); 
	Структура.Вставить("ПарольКонтейнера",					""); 
	Структура.Вставить("СвойстваСертификата",				Неопределено);
	Структура.Вставить("ТребуетсяДоверенность",				Ложь);
	Возврат Структура;
	
КонецФункции

Функция СвойстваСертификата(Сертификат, РасположениеСертификата = "сервер") Экспорт
	
	ДатыСертификата = ДатыСертификата(Сертификат, ДобавкаВремени());
	
	Свойства = Новый Структура;
	Свойства.Вставить("Отпечаток",      СтрЗаменить(Строка(Сертификат.Отпечаток), " ", ""));
	Свойства.Вставить("Расположение",	РасположениеСертификата); 
	Свойства.Вставить("СерийныйНомер",  Сертификат.СерийныйНомер);
	Свойства.Вставить("Субъект",  		СвойстваСубъектаСертификата(Сертификат));
	Свойства.Вставить("Издатель",  		СвойстваИздателяСертификата(Сертификат));
	Свойства.Вставить("ДатаНачала",     ДатыСертификата.ДатаНачала);
	Свойства.Вставить("ДатаОкончания",  ДатыСертификата.ДатаОкончания);
	Свойства.Вставить("ДействителенДо", ДатыСертификата.ДатаОкончания);
	Свойства.Вставить("Назначение",     ПолучитьНазначение(Сертификат));
	Свойства.Вставить("Подписание",     Сертификат.ИспользоватьДляПодписи);
	Свойства.Вставить("Шифрование",     Сертификат.ИспользоватьДляШифрования);
	
	Возврат Свойства;
	
КонецФункции

Функция ДатыСертификата(Сертификат, ДобавкаВремени)
	
	ДатыСертификата = Новый Структура;
	ДатыСертификата.Вставить("ДатаНачала",    Сертификат.ДатаНачала    + ДобавкаВремени);
	ДатыСертификата.Вставить("ДатаОкончания", Сертификат.ДатаОкончания + ДобавкаВремени);
	
	Возврат ДатыСертификата;
	
КонецФункции

Функция ДобавкаВремени() 
	
	Возврат ТекущаяДатаСеанса() - ТекущаяУниверсальнаяДата();
	
КонецФункции 

Функция ПолучитьНазначение(Сертификат)
	
	Если Не Сертификат.РасширенныеСвойства.Свойство("EKU") Тогда
		Возврат "";
	КонецЕсли;
	
	ФиксированныйМассивСвойств = Сертификат.РасширенныеСвойства.EKU;
	
	Назначение = "";
	
	Для Индекс = 0 По ФиксированныйМассивСвойств.Количество() - 1 Цикл
		Назначение = Назначение + ФиксированныйМассивСвойств.Получить(Индекс);
		Назначение = Назначение + Символы.ПС;
	КонецЦикла;
	
	Возврат ПодготовитьСтроку(Назначение);
	
КонецФункции

Функция СвойстваИздателяСертификата(Сертификат)
	
	Издатель = Сертификат.Издатель;
	
	Свойства = Новый Структура;
	Свойства.Вставить("ОбщееИмя");
	Свойства.Вставить("Страна");
	Свойства.Вставить("Регион");
	Свойства.Вставить("НаселенныйПункт");
	Свойства.Вставить("Улица");
	Свойства.Вставить("Организация");
	Свойства.Вставить("Подразделение");
	Свойства.Вставить("ЭлектроннаяПочта");
	Свойства.Вставить("ОГРН");
	Свойства.Вставить("ИНН");
	Свойства.Вставить("ИННЮЛ");
	
	Если Издатель.Свойство("CN") Тогда
		Свойства.ОбщееИмя = ПодготовитьСтроку(Издатель.CN);
	КонецЕсли;
	
	Если Издатель.Свойство("C") Тогда
		Свойства.Страна = ПодготовитьСтроку(Издатель.C);
	КонецЕсли;
	
	Если Издатель.Свойство("ST") Тогда
		Свойства.Регион = ПодготовитьСтроку(Издатель.ST);
	КонецЕсли;
	
	Если Издатель.Свойство("L") Тогда
		Свойства.НаселенныйПункт = ПодготовитьСтроку(Издатель.L);
	КонецЕсли;
	
	Если Издатель.Свойство("Street") Тогда
		Свойства.Улица = ПодготовитьСтроку(Издатель.Street);
	КонецЕсли;
	
	Если Издатель.Свойство("O") Тогда
		Свойства.Организация = ПодготовитьСтроку(Издатель.O);
	КонецЕсли;
	
	Если Издатель.Свойство("OU") Тогда
		Свойства.Подразделение = ПодготовитьСтроку(Издатель.OU);
	КонецЕсли;
	
	Если Издатель.Свойство("E") Тогда
		Свойства.ЭлектроннаяПочта = ПодготовитьСтроку(Издатель.E);
	КонецЕсли;
	
	Если Издатель.Свойство("OGRN") Тогда
		Свойства.ОГРН = ПодготовитьСтроку(Издатель.OGRN);
	ИначеЕсли Издатель.Свойство("OID1_2_643_100_1") Тогда
		Свойства.ОГРН = ПодготовитьСтроку(Издатель.OID1_2_643_100_1);
	КонецЕсли;
	
	ЗаполнитьИНН(Свойства, Издатель);
	
	Возврат Свойства;
	
КонецФункции

Функция СвойстваСубъектаСертификата(Сертификат)
	
	Если КонтурСтандарт_ВерсияПлатформыНеНижеУказанной("8.3.7") Тогда 
		Субъект = Сертификат.Субъект;
	Иначе
		Попытка
			Если ТипЗнч(Сертификат) = Тип("Структура") Тогда
				ДвоичныеДанныеСертификата = Сертификат.ДвоичныеДанные;
			Иначе
				ДвоичныеДанныеСертификата = Сертификат.Выгрузить();
			КонецЕсли;
			ДанныеСертификата = КонтурПлагин().ПолучитьДанныеСертификата(ДвоичныеДанныеСертификата, Новый Структура("Субъект"));
			Субъект = ДанныеСертификата.Субъект;
		Исключение
			Субъект = Сертификат.Субъект;
		КонецПопытки;
	КонецЕсли;
		
	Свойства = Новый Структура;
	Свойства.Вставить("Страна");
	Свойства.Вставить("Регион");
	Свойства.Вставить("НаселенныйПункт");
	Свойства.Вставить("Улица");
	Свойства.Вставить("Подразделение");
	Свойства.Вставить("ЭлектроннаяПочта");
	Свойства.Вставить("ОГРН");
	Свойства.Вставить("ОГРНИП");
	Свойства.Вставить("СНИЛС");
	Свойства.Вставить("ИНН");
	Свойства.Вставить("Фамилия");
	Свойства.Вставить("Имя");
	Свойства.Вставить("Отчество");
	Свойства.Вставить("Должность");
	Свойства.Вставить("Организация");
	Свойства.Вставить("ОбщееИмя");
	Свойства.Вставить("ИННЮЛ");
	
	Если Субъект.Свойство("CN") Тогда
		Свойства.ОбщееИмя = ПодготовитьСтроку(Субъект.CN);
	КонецЕсли;
	
	Если Субъект.Свойство("C") Тогда
		Свойства.Страна = ПодготовитьСтроку(Субъект.C);
	КонецЕсли;
	
	Если Субъект.Свойство("ST") Тогда
		Свойства.Регион = ПодготовитьСтроку(Субъект.ST);
	ИначеЕсли Субъект.Свойство("S") Тогда
		Свойства.Регион = ПодготовитьСтроку(Субъект.S);
	КонецЕсли;
	
	Если Субъект.Свойство("L") Тогда
		Свойства.НаселенныйПункт = ПодготовитьСтроку(Субъект.L);
	КонецЕсли;
	
	Если Субъект.Свойство("Street") Тогда
		Свойства.Улица = ПодготовитьСтроку(Субъект.Street);
	КонецЕсли;
	
	Если Субъект.Свойство("O") Тогда
		Свойства.Организация = ПодготовитьСтроку(Субъект.O);
	КонецЕсли;
	
	Если Субъект.Свойство("OU") Тогда
		Свойства.Подразделение = ПодготовитьСтроку(Субъект.OU);
	КонецЕсли;
	
	Если Субъект.Свойство("E") Тогда
		Свойства.ЭлектроннаяПочта = ПодготовитьСтроку(Субъект.E);
	КонецЕсли;
	
	Если Субъект.Свойство("OGRN")Тогда
		Свойства.ОГРН = ПодготовитьСтроку(Субъект.OGRN);
	ИначеЕсли Субъект.Свойство("ОГРН") Тогда
		Свойства.ОГРН = ПодготовитьСтроку(Субъект.ОГРН);
	ИначеЕсли Субъект.Свойство("OID1_2_643_100_1") Тогда
		Свойства.ОГРН = ПодготовитьСтроку(Субъект.OID1_2_643_100_1);
	КонецЕсли;
	
	Если Субъект.Свойство("OGRNIP") Тогда
		Свойства.ОГРНИП = ПодготовитьСтроку(Субъект.OGRNIP);
	ИначеЕсли Субъект.Свойство("ОГРНИП") Тогда
		Свойства.ОГРНИП = ПодготовитьСтроку(Субъект.ОГРНИП);
	ИначеЕсли Субъект.Свойство("OID1_2_643_100_5") Тогда
		Свойства.ОГРНИП = ПодготовитьСтроку(Субъект.OID1_2_643_100_5);
	КонецЕсли;
	
	Если Субъект.Свойство("SNILS") Тогда
		Свойства.СНИЛС = ПодготовитьСтроку(Субъект.SNILS);
	ИначеЕсли Субъект.Свойство("СНИЛС") Тогда
		Свойства.СНИЛС = ПодготовитьСтроку(Субъект.СНИЛС);
	ИначеЕсли Субъект.Свойство("OID1_2_643_100_3") Тогда
		Свойства.СНИЛС = ПодготовитьСтроку(Субъект.OID1_2_643_100_3);
	КонецЕсли;
	
	ЗаполнитьИНН(Свойства, Субъект);
	
	Если Субъект.Свойство("CN") Тогда
		Свойства.ОбщееИмя = ПодготовитьСтроку(Субъект.CN);
	КонецЕсли;
	
	Если Субъект.Свойство("O") Тогда
		Свойства.Организация = ПодготовитьСтроку(Субъект.O);
	КонецЕсли;
	
	Если Субъект.Свойство("SN") Тогда // Наличие фамилии (обычно для должностного лица).
		
		// Извлечение ФИО из поля SN и GN.
		Свойства.Фамилия = ПодготовитьСтроку(Субъект.SN);
		
		ИмяОтчество = Неопределено;
		
		Если Субъект.Свойство("GN") Тогда
			ИмяОтчество = ПодготовитьСтроку(Субъект.GN);
		ИначеЕсли Субъект.Свойство("G") Тогда
			ИмяОтчество = ПодготовитьСтроку(Субъект.G);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИмяОтчество) Тогда
			
			Позиция = Найти(ИмяОтчество, " ");
			
			Если Позиция = 0 Тогда
				Свойства.Имя = ИмяОтчество;
			Иначе
				Свойства.Имя = Лев(ИмяОтчество, Позиция - 1);
				Свойства.Отчество = ПодготовитьСтроку(Сред(ИмяОтчество, Позиция + 1));
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(Свойства.ОГРНИП)    // Признак индивидуального предпринимателя.
		Или Субъект.Свойство("T")                 // Признак должностного лица.
		Или Субъект.Свойство("OID2_5_4_12")       // Признак должностного лица.
		Или ЗначениеЗаполнено(Свойства.СНИЛС)     // Признак физического лица.
		Или ЭтоИННФизЛица(Свойства.ИНН) И НЕ ЗначениеЗаполнено(Свойства.ИННЮЛ) Тогда // Признак физического лица.
		
		Если Свойства.ОбщееИмя <> Свойства.Организация
			И Не (Субъект.Свойство("T")           И Свойства.ОбщееИмя = ПодготовитьСтроку(Субъект.T))
			И Не (Субъект.Свойство("OID2_5_4_12") И Свойства.ОбщееИмя = ПодготовитьСтроку(Субъект.OID2_5_4_12)) Тогда
			
			// Извлечение ФИО из поля CN.
			Массив = EDI_РазложитьСтрокуВМассивСлов(Свойства.ОбщееИмя, " ");
			
			Если Массив.Количество() < 4 Тогда
				Если Массив.Количество() > 0 Тогда
					Свойства.Фамилия = СокрЛП(Массив[0]);
				КонецЕсли;
				Если Массив.Количество() > 1 Тогда
					Свойства.Имя = СокрЛП(Массив[1]);
				КонецЕсли;
				Если Массив.Количество() > 2 Тогда
					Свойства.Отчество = СокрЛП(Массив[2]);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Свойства.Фамилия) Или ЗначениеЗаполнено(Свойства.Имя) Тогда
		Если Субъект.Свойство("T") Тогда
			Свойства.Должность = ПодготовитьСтроку(Субъект.T);
			
		ИначеЕсли Субъект.Свойство("OID2_5_4_12") Тогда
			Свойства.Должность = ПодготовитьСтроку(Субъект.OID2_5_4_12);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Свойства;
	
КонецФункции

Функция ЭтоИННФизЛица(ИНН)
	
	Если СтрДлина(ИНН) <> 12 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для НомерСимвола = 1 По 12 Цикл
		Если Найти("0123456789", Сред(ИНН,НомерСимвола,1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Если Найти(ИНН, "00") = 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура ЗаполнитьИНН(Свойства, Данные)
	
	ИННЮЛ = Неопределено;
	ИНН = Неопределено;
	
	Если Данные.Свойство("INN") Тогда
		ИНН = Данные.INN;
	ИначеЕсли Данные.Свойство("ИНН") Тогда
		ИНН = Данные.ИНН;
	ИначеЕсли Данные.Свойство("OID1_2_643_3_131_1_1") Тогда
		ИНН = ПодготовитьСтроку(Данные.OID1_2_643_3_131_1_1);
	КонецЕсли;
	
	Если Данные.Свойство("INNLE") Тогда
		ИННЮЛ = Данные.INNLE;
	ИначеЕсли Данные.Свойство("ИННЮЛ") Тогда
		ИННЮЛ = Данные.ИННЮЛ;
	ИначеЕсли Данные.Свойство("OID1_2_643_100_4")
			И СтрДлина(Данные.OID1_2_643_100_4) = 10 Тогда
		ИННЮЛ = ПодготовитьСтроку(Данные.OID1_2_643_100_4);
	ИначеЕсли Данные.Свойство("_1_2_643_100_4") Тогда
		ИННЮЛ = ПодготовитьСтроку(Данные._1_2_643_100_4);
	КонецЕсли;
		
	Свойства.ИННЮЛ = ИННЮЛ;
	Свойства.ИНН = ИНН;
	
КонецПроцедуры

Функция ПодготовитьСтроку(СтрокаИзСертификата)
	
	Возврат ЗаменитьНедопустимыеСимволыXML(СтрокаИзСертификата);
	
КонецФункции

Функция ЗаменитьНедопустимыеСимволыXML(Знач Текст, СимволЗамены = " ") Экспорт
	
	ПозицияНачала = 1;
	Позиция = НайтиНедопустимыеСимволыXML(Текст, ПозицияНачала);
	Пока Позиция > 0 Цикл
		НедопустимыйСимвол = Сред(Текст, Позиция, 1);
		Текст = СтрЗаменить(Текст, НедопустимыйСимвол, СимволЗамены);
		ПозицияНачала = Позиция + СтрДлина(СимволЗамены);
		Если ПозицияНачала > СтрДлина(Текст) Тогда
			Прервать;
		КонецЕсли;
		Позиция = НайтиНедопустимыеСимволыXML(Текст, ПозицияНачала);
	КонецЦикла;
	
	Возврат Текст;

КонецФункции

Функция ПреобразоватьСтрокуДанныхВДвоичныеДанные(СтрокаДанных) Экспорт

	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку("<foo xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" 
	|xmlns:xsd=""http://www.w3.org/2001/XMLSchema"" xsi:type=""xsd:hexBinary"">" + СтрокаДанных + "</foo>");
	ДвоичныеДанныеДокумента = СериализаторXDTO.ПрочитатьXML(ЧтениеXML);
	
	Возврат ДвоичныеДанныеДокумента;

КонецФункции

//-------------------------------------------------------------------------------------------------
// Подписание документов в Диадок в регламентном задании на сервере
//-------------------------------------------------------------------------------------------------

Процедура ПодписатьДокументыВДиадокВнешнийВызов() Экспорт
	
	ПодписатьДокументыВДиадок();
	ОтправитьСлужебныеУниверсальныеСообщения();
	
КонецПроцедуры

Процедура ПодписатьДокументыВДиадок()

	МассивСообщений = ПолучитьМассивСообщенийДляАвтоматическогоПодписания();
	
	Если МассивСообщений.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	СчетаФактурыНаПодписание = ПолучитьТаблицуСчетовФактурНаПодписание(МассивСообщений);
	
	СчетаФактурыНаПодписание.Колонки.Добавить("invoiceId_new");
	СчетаФактурыНаПодписание.Колонки.Добавить("torg12Id_new");
	СчетаФактурыНаПодписание.Колонки.Добавить("UniversalTransferDocumentId_new");
	СчетаФактурыНаПодписание.Колонки.Добавить("MessageId_new");
	СчетаФактурыНаПодписание.Колонки.Добавить("isDraft");
			
	ЗаполнитьТаблицуАвторизацииПоУмолчанию();
	
	СброситьПроверкиДанныхАвторизации();
	
	ПодписатьСчетаФактурыРазнымиСертификатами(СчетаФактурыНаПодписание);
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуАвторизацииПоУмолчанию() //выбранные в качестве умолчаний
	
	ИнициализироватьТаблицуАвторизации();
	
	ОтборПоСертификатам = Новый Структура;
	ОтборПоСертификатам.Вставить("СертификатыПоУмолчанию", Истина);
	
	СертификатыПоУмолчанию = ПолучитьТаблицуСохраненныхСертификатов(ОтборПоСертификатам);
	// Пока нет хранения логина пароля ДД в разрезе организации 
	// обойдем и заполним все строки ТаблицаАвторизации одинаковыми значениями
	СтруктураЛогинПарольДД = ПолучитьСписокСвойствEDI("ЛогинСлужебныйДиадок,ПарольСлужебныйДиадок");
	
	Для Каждого СертПоУмолчанию Из СертификатыПоУмолчанию Цикл
		НоваяСтрока = ТаблицаАвторизации.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СертПоУмолчанию);
		
		НоваяСтрока.ЛогинДД 	= СтруктураЛогинПарольДД.ЛогинСлужебныйДиадок;
		НоваяСтрока.ПарольДД 	= СтруктураЛогинПарольДД.ПарольСлужебныйДиадок;
	КонецЦикла;
	
КонецПроцедуры

Процедура ИнициализироватьТаблицуАвторизации()
	
	ТаблицаАвторизации = Новый ТаблицаЗначений;
	ТаблицаАвторизации.Колонки.Добавить("Организация");
	ТаблицаАвторизации.Колонки.Добавить("Отпечаток",						ОписаниеТипаСтрока_КонтурEDI());
	ТаблицаАвторизации.Колонки.Добавить("Расположение",						ОписаниеТипаСтрока_КонтурEDI());
	ТаблицаАвторизации.Колонки.Добавить("ЛогинДД", 							ОписаниеТипаСтрока_КонтурEDI());
	ТаблицаАвторизации.Колонки.Добавить("ПарольДД", 						ОписаниеТипаСтрока_КонтурEDI());
	ТаблицаАвторизации.Колонки.Добавить("ЛогинПарольДДПроверен",			Новый ОписаниеТипов("Булево"));
	ТаблицаАвторизации.Колонки.Добавить("СертификатПроверен",				Новый ОписаниеТипов("Булево"));
	ТаблицаАвторизации.Колонки.Добавить("СертификатДействуетПо",			ОписаниеТипаДата_КонтурEDI());
	ТаблицаАвторизации.Колонки.Добавить("ВалидацияЛогинаПароляДДПройдена",	Новый ОписаниеТипов("Булево"));
	ТаблицаАвторизации.Колонки.Добавить("ВалидацияСертификатаПройдена",		Новый ОписаниеТипов("Булево"));
	ТаблицаАвторизации.Колонки.Добавить("ПарольКонтейнера",					ОписаниеТипаСтрока_КонтурEDI());
	ТаблицаАвторизации.Колонки.Добавить("ТипАвторизации",					ОписаниеТипаСтрока_КонтурEDI());
	ТаблицаАвторизации.Колонки.Добавить("ИмяМодуляКриптографии",			ОписаниеТипаСтрока_КонтурEDI());
	ТаблицаАвторизации.Колонки.Добавить("ТипМодуляКриптографии",			ОписаниеТипаЧисло_КонтурEDI());
	ТаблицаАвторизации.Колонки.Добавить("Доверенность");
	ТаблицаАвторизации.Колонки.Добавить("СвойстваСертификата");
	ТаблицаАвторизации.Колонки.Добавить("ТребуетсяДоверенность", 			Новый ОписаниеТипов("Булево"));
	ТаблицаАвторизации.Колонки.Добавить("ВалидацияДоверенностиПройдена",	Новый ОписаниеТипов("Булево"));
	ТаблицаАвторизации.Колонки.Добавить("ИгнорируемыеОшибкиДоверенности",	ОписаниеТипаСтрока_КонтурEDI());
	
КонецПроцедуры

Процедура СброситьПроверкиДанныхАвторизации()
	
	Если ТипЗнч(ТаблицаАвторизации) = Тип("ТаблицаЗначений") Тогда
		Для каждого Строка Из ТаблицаАвторизации Цикл
			
			Строка.ЛогинПарольДДПроверен 			= Ложь;
			Строка.СертификатПроверен 				= Ложь;
			Строка.ВалидацияЛогинаПароляДДПройдена 	= Ложь;
			Строка.ВалидацияСертификатаПройдена 	= Ложь;
			Строка.ВалидацияДоверенностиПройдена 	= Ложь;
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ИнициализироватьДанныеАвторизации(Организация)
	
	ДанныеАвторизации = ПолучитьСтруктуруДанныхАвторизации();
	
	Если ТаблицаАвторизации = Неопределено ИЛИ ТаблицаАвторизации.Количество() = 0 Тогда 
		ЗаполнитьТаблицуАвторизацииПоУмолчанию();
	КонецЕсли;
	
	НайденныеСтроки = ТаблицаАвторизации.НайтиСтроки(Новый Структура("Организация",Организация));
	
	Если НайденныеСтроки.Количество() = 1  Тогда
		ЗаполнитьЗначенияСвойств(ДанныеАвторизации, НайденныеСтроки[0]);
		Если ЗначениеЗаполнено(ДанныеАвторизации.Отпечаток) Тогда
			ДанныеАвторизации.ПарольКонтейнера = ПолучитьПарольКонтейнераСертификата(ДанныеАвторизации.Организация, ДанныеАвторизации.Отпечаток);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСтруктуруДанныхАвторизации()
	
	СтруктураДанныхАвторизации = Новый Структура;
	СтруктураДанныхАвторизации.Вставить("Организация", 						Неопределено);
	СтруктураДанныхАвторизации.Вставить("Отпечаток", 						"");
	СтруктураДанныхАвторизации.Вставить("Расположение", 					""); // "клиент" / "сервер"
	СтруктураДанныхАвторизации.Вставить("ЛогинДД", 							"");
	СтруктураДанныхАвторизации.Вставить("ПарольДД", 						"");
	СтруктураДанныхАвторизации.Вставить("ЛогинПарольДДПроверен", 			Ложь);
	СтруктураДанныхАвторизации.Вставить("СертификатПроверен", 				Ложь);
	СтруктураДанныхАвторизации.Вставить("СертификатДействуетПо", 			Дата(1, 1, 1));
	СтруктураДанныхАвторизации.Вставить("ВалидацияЛогинаПароляДДПройдена", 	Ложь);
	СтруктураДанныхАвторизации.Вставить("ВалидацияСертификатаПройдена", 	Ложь);
	СтруктураДанныхАвторизации.Вставить("ПарольКонтейнера", 				"");
	СтруктураДанныхАвторизации.Вставить("ТипАвторизации", 					"");
	СтруктураДанныхАвторизации.Вставить("ТипМодуляКриптографии",			0);
	СтруктураДанныхАвторизации.Вставить("ИмяМодуляКриптографии", 			"");
	СтруктураДанныхАвторизации.Вставить("Доверенность", 					Неопределено);
	СтруктураДанныхАвторизации.Вставить("СвойстваСертификата", 				Неопределено);
	СтруктураДанныхАвторизации.Вставить("ТребуетсяДоверенность", 			Ложь);
	СтруктураДанныхАвторизации.Вставить("ВалидацияДоверенностиПройдена", 	Ложь);
	СтруктураДанныхАвторизации.Вставить("ИгнорируемыеОшибкиДоверенности", 	"");

	Возврат СтруктураДанныхАвторизации;
	
КонецФункции

Процедура ОбновитьДанныеАвторизации(Ключ, Значение)
	
	Если ДанныеАвторизации = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Обновим данные в структуре ДанныеАвторизации
	ДанныеАвторизации[Ключ] = Значение;
	
	// Обновим данные в таблице ТаблицаАвторизации
	НайденныеСтроки = ТаблицаАвторизации.НайтиСтроки(Новый Структура("Организация", ДанныеАвторизации.Организация));
	Если НайденныеСтроки.Количество() = 1 Тогда
		ЗаполнитьЗначенияСвойств(НайденныеСтроки[0], ДанныеАвторизации);
	КонецЕсли;

КонецПроцедуры

Процедура СброситьПарольКонтейнераДанныхАвторизации()
	
	ОбновитьДанныеАвторизации("ПарольКонтейнера", "");

	Для каждого Строка Из ТаблицаАвторизации Цикл
		Строка.ПарольКонтейнера	= "";
	КонецЦикла;

КонецПроцедуры

Процедура ПодписатьСчетаФактурыРазнымиСертификатами(СчетаФактурыНаПодписание)
	
	// По каждой СЧФ попробуем взять серт по-умолчанию, если не удастся, то пропустим
	ТекОрганизация = Неопределено;
	ИсключитьСчетаФактурыИзПодписания = Новый Массив;
	
	Для Каждого СчетФактураКПодписи Из СчетаФактурыНаПодписание Цикл
		
		Если СобытиеСертификаты_НазначитьСертификат(СчетФактураКПодписи).Переопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекОрганизация <> СчетФактураКПодписи.Организация Тогда 
			
			ТекОрганизация = СчетФактураКПодписи.Организация;
			ИнициализироватьДанныеАвторизации(ТекОрганизация);
			ОбновитьДанныеАвторизации("ТипАвторизации", "Сертификат"); 

			Если ПропускСертификатаПоОрганизации(ТекОрганизация) Тогда
				// по какой-то причине не удалось выбрать сертификат или не прошли проверку с сертификатом
				ИсключитьСчетаФактурыИзПодписания.Добавить(СчетФактураКПодписи); 
				Продолжить;
			КонецЕсли;
			
			Если НЕ МожемПодписатьДокументыСертификатом(ТекОрганизация, ДанныеАвторизации) Тогда
				ИсключитьСчетаФактурыИзПодписания.Добавить(СчетФактураКПодписи);
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Для каждого СчетФактураКИсключению Из ИсключитьСчетаФактурыИзПодписания Цикл
		СчетаФактурыНаПодписание.Удалить(СчетФактураКИсключению);		
	КонецЦикла;
	
	ПодписатьСчетаФактуры(СчетаФактурыНаПодписание);
	СброситьПарольКонтейнераДанныхАвторизации();
	
КонецПроцедуры

Функция ПропускСертификатаПоОрганизации(Организация)
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		// не знаем данные авторизации
		Возврат Истина;
	КонецЕсли;

	НайденныеСтроки = ТаблицаАвторизации.НайтиСтроки(Новый Структура("Организация",Организация));
	Если НайденныеСтроки.Количество() = 1
		И НайденныеСтроки[0].СертификатПроверен = Истина
		И (НайденныеСтроки[0].ВалидацияСертификатаПройдена = Ложь
		ИЛИ (ЗначениеЗаполнено(НайденныеСтроки[0].СертификатДействуетПо)
		И КонецДня(НайденныеСтроки[0].СертификатДействуетПо) < ТекущаяДата())) Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция СертификатПоОрганизацииНазначен(Организация)
	
	НайденныеСтроки = ТаблицаАвторизации.НайтиСтроки(Новый Структура("Организация",Организация));
	Если НайденныеСтроки.Количество() = 1
		И ЗначениеЗаполнено(НайденныеСТроки[0].Отпечаток) Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
		
КонецФункции

Функция МожемПодписатьДокументыСертификатом(Организация, ДанныеАвторизации)
	
	Если НЕ СертификатПоОрганизацииНазначен(Организация) Тогда 
		
		Возврат Ложь; //не готовы подписывать, сначала надо выбрать сертификат
		
	ИначеЕсли НЕ ДанныеАвторизации.Расположение = ВариантРасположенияКриптографииСервер()
		И Не EDI_ИнформационнаяБазаФайловая() Тогда
		
		Возврат Ложь; //не готовы подписывать, сертификат должен быть серверный
		
	ИначеЕсли ДанныеАвторизации.СертификатПроверен = Ложь Тогда
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("Действие",	 			"ПроверкаПодписания");
		ДопПараметры.Вставить("Организация", 			ДанныеАвторизации.Организация);
		ДопПараметры.Вставить("Отпечаток",   			ДанныеАвторизации.Отпечаток);
		ДопПараметры.Вставить("Расположение",  			ДанныеАвторизации.Расположение);
		ДопПараметры.Вставить("СертификатДействуетПо",  ДанныеАвторизации.СертификатДействуетПо);
		ДопПараметры.Вставить("ЗапомнитьВыбор", 		Ложь);
		ДопПараметры.Вставить("НомерПопытки", 			1);
		ДопПараметры.Вставить("Успешно", 				Ложь);
		ДопПараметры.Вставить("ОписаниеОшибки", 		"");
		ДопПараметры.Вставить("Доверенность", 			ДанныеАвторизации.Доверенность);
		ДопПараметры.Вставить("СвойстваСертификата", 	ДанныеАвторизации.СвойстваСертификата); 
		ДопПараметры.Вставить("ТребуетсяДоверенность", 	ДанныеАвторизации.ТребуетсяДоверенность);
		
		Если НЕ ОбработчикПроверкиПодписанияСертификатом(ДанныеАвторизации.ПарольКонтейнера, ДопПараметры) Тогда
			Возврат Ложь; //сертификат не прошел проверку подписания
		КонецЕсли;	
		
		// доверенность назначена	
		Если ЗначениеЗаполнено(ДанныеАвторизации.Доверенность) Тогда
			
			ОбработчикВалидацииМЧД(ДанныеАвторизации);
			
			Если НЕ ДанныеАвторизации.ВалидацияДоверенностиПройдена Тогда
				Возврат Ложь; //не готовы подписывать, доверенность не прошла валидацию
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура ОбработчикВалидацииМЧД(ДанныеАвторизации)

	Доверенность = ДанныеАвторизации.Доверенность;
	
	ИдентификаторОрганизацииДиадок = ИдентификаторОрганизацииДиадок(ДанныеАвторизации.Организация);
	Если ИдентификаторОрганизацииДиадок = Неопределено Тогда
		ВызватьИсключение "Для организации " + Строка(ДанныеАвторизации.Организация) + " не настроена связка с diadoc.ru
		|обратитесь в техническую поддержку";		
	КонецЕсли;
	ИдентификаторЯщикаДиадок = ИдентификаторЯщикаДиадок(ДанныеАвторизации, ИдентификаторОрганизацииДиадок); 

	СоставнойИдентификаторМЧД = Доверенность.СоставнойИдентификатор;

	Сертификат = ПолучитьСертификат1СПоОтпечатку_КонтурEDI(ДанныеАвторизации, Истина);
	
	РезультатПроверкиМашиночитаемойДоверенности = ПредварительнаяПроверкаМЧД(ДанныеАвторизации, ИдентификаторЯщикаДиадок, СоставнойИдентификаторМЧД, Сертификат);

	Ошибки = ОшибкиВалидацииМЧД(РезультатПроверкиМашиночитаемойДоверенности);
	
	Если Не ПустаяСтрока(Ошибки) Тогда
		
		ОбновитьДанныеАвторизации("ВалидацияДоверенностиПройдена", Ошибки = ДанныеАвторизации.ИгнорируемыеОшибкиДоверенности);
						
	Иначе
		
		ОбновитьДанныеАвторизации("ВалидацияДоверенностиПройдена", Истина);
		
	КонецЕсли;

КонецПроцедуры

Функция ОшибкиВалидацииМЧД(РезультатПроверкиМашиночитаемойДоверенности)

	Ошибки = "";
	
	ТекстОшибки = РезультатПроверкиМашиночитаемойДоверенности.СтатусПроверки.ОшибкаОперации.Текст;
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		Ошибки = " - " + ТекстОшибки + Символы.ПС;	
	КонецЕсли;	

	Если РезультатПроверкиМашиночитаемойДоверенности.СтатусПроверки.ПротоколВалидации.РезультатПроверкиВалидации.Количество() > 0 Тогда
		Для Каждого РезультатПроверкиВалидации Из РезультатПроверкиМашиночитаемойДоверенности.СтатусПроверки.ПротоколВалидации.РезультатПроверкиВалидации Цикл
			
			ТекстОшибки = РезультатПроверкиВалидации.Ошибка.Текст;
			Если Не ПустаяСтрока(ТекстОшибки) Тогда
				Ошибки = Ошибки + " - " + ТекстОшибки + Символы.ПС;	
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;	

	Если ПустаяСтрока(Ошибки) И РезультатПроверкиМашиночитаемойДоверенности.СтатусПроверки.Ошибки.Количество() > 0 Тогда
		
		ПараметрыФормы = Новый Структура;
		
		Для Каждого Ошибка Из РезультатПроверкиМашиночитаемойДоверенности.СтатусПроверки.Ошибки Цикл // устарело
			
			Ошибки = Ошибки + " - " + Ошибка.Текст + Символы.ПС;
			
		КонецЦикла;
		
	КонецЕсли;

	Если Не ПустаяСтрока(Ошибки) Тогда
		
		Ошибки = РезультатПроверкиМашиночитаемойДоверенности.СтатусПроверки.ТекстСтатуса + "
		|
		|" + Ошибки;
		
	КонецЕсли;

	Возврат Ошибки;
	
КонецФункции

Функция ПредварительнаяПроверкаМЧД(ДанныеАвторизации, ИдентификаторЯщика, СоставнойИдентификаторМЧД, Сертификат)
	
	СоставнойИдентификатор = КонтурДиадокAPI_Привести("PowerOfAttorneyFullId", СоставнойИдентификаторМЧД); 
	ДанныеАвторизацииДиадок = ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизации);
	
	РезультатПроверкиМашиночитаемойДоверенности = КонтурДиадокAPI_ПредварительнаяПроверкаДоверенности(ДанныеАвторизацииДиадок, ИдентификаторЯщика, СоставнойИдентификатор, ДанныеАвторизацииДиадок.Отпечаток, Истина);

	Возврат РезультатПроверкиМашиночитаемойДоверенности;
		
КонецФункции
	
Функция ОбработчикПроверкиПодписанияСертификатом(ВыбранноеЗначение, ДопПараметры)

	ПарольКонтейнера = ВыбранноеЗначение;
		
	РезультатПроверки = ПроверитьВыбранныйСертификат(ДопПараметры.Организация, ДопПараметры.Отпечаток, ДопПараметры.Расположение, ДопПараметры.СертификатДействуетПо, ПарольКонтейнера);
	
	Если РезультатПроверки.Успешно = Ложь
		И ОшибкаНеправильныйПарольКонтейнера(РезультатПроверки.ОписаниеОшибки)
		И ДопПараметры.НомерПопытки = 1 Тогда
		
		ПарольКонтейнера = ПолучитьПарольКонтейнераСертификата(ДопПараметры.Организация, ДопПараметры.Отпечаток);
		РезультатПроверки = ПроверитьВыбранныйСертификат(ДопПараметры.Организация, ДопПараметры.Отпечаток, ДопПараметры.Расположение, ДопПараметры.СертификатДействуетПо, ПарольКонтейнера);
		
	КонецЕсли;

	ОбновитьДанныеАвторизации("СертификатПроверен", Истина);
	
	Если РезультатПроверки.Успешно = Истина Тогда

		ДопПараметры.Успешно = Истина;
		ОбновитьДанныеАвторизации("ВалидацияСертификатаПройдена", 	Истина);
		ОбновитьДанныеАвторизации("ПарольКонтейнера", 				ПарольКонтейнера);
				
	Иначе

		ОбновитьДанныеАвторизации("ВалидацияСертификатаПройдена", Ложь);
		ДопПараметры.ОписаниеОшибки = РезультатПроверки.ОписаниеОшибки;
	
		Если ОшибкаДействиеОтмененоПользователем(РезультатПроверки.ОписаниеОшибки) Тогда
			ДопПараметры.ОписаниеОшибки = "Действие было отменено пользователем";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДопПараметры.СертификатДействуетПо) 
			И КонецДня(ДопПараметры.СертификатДействуетПо) < ТекущаяДата() Тогда
			ДопПараметры.ОписаниеОшибки = "Истек срок действия сертификата." + Символы.ПС + ДопПараметры.ОписаниеОшибки;				

		КонецЕсли;
		
		Если ОшибкаНеправильныйПарольКонтейнера(РезультатПроверки.ОписаниеОшибки) Тогда
			Возврат РезультатПроверки.Успешно;
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат РезультатПроверки.Успешно;
	
КонецФункции

// Проверим что можем получить реквизиты серта и что с ним нам удастся авторизоваться
Функция ПроверитьВыбранныйСертификат(Организация, Отпечаток, Расположение, СертификатДействуетПо, ПарольКонтейнера = "")
	
	// Проверим, что можем подписать файл выбранным сертификатом
	Результат = ИнициализироватьСтруктуруРезультатаФункции();
	
	Если Не ЗначениеЗаполнено(Отпечаток) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИмяФайлаДляТеста = ПолучитьИмяВременногоФайла();
	ТестовыйФайл = Новый ТекстовыйДокумент;
	ТестовыйФайл.Записать(ИмяФайлаДляТеста);
	
	ДанныеСертификата = Новый Структура;
	ДанныеСертификата.Вставить("Организация", 			Организация);
	ДанныеСертификата.Вставить("Отпечаток", 			Отпечаток);
	ДанныеСертификата.Вставить("Расположение", 			Расположение);
	ДанныеСертификата.Вставить("СертификатДействуетПо", СертификатДействуетПо);
	
	ДанныеАвторизацииДляТеста = ПолучитьСтруктуруДанныхАвторизации();
	ДанныеАвторизацииДляТеста.Отпечаток = Отпечаток;
	ДанныеАвторизацииДляТеста.Расположение = Расположение;
	ДанныеАвторизацииДляТеста.ПарольКонтейнера = ПарольКонтейнера;

	АдресФайлаДляТеста = ПоместитьВоВременноеХранилище(ТестовыйФайл, Новый УникальныйИдентификатор);
	
	Для Сч = 1 По 2 Цикл
		
		Если Расположение = ВариантРасположенияКриптографииСервер()
			Или EDI_ИнформационнаяБазаФайловая() Тогда
			
			РезультатПодписания = ПолучитьПодписьФайлаДокумента_КонтурEDI(АдресФайлаДляТеста, ДанныеАвторизацииДляТеста);
			
		Иначе
			
			РезультатПодписания = Новый Структура;
			РезультатПодписания.Вставить("Успешно",Ложь);
			РезультатПодписания.Вставить("ОписаниеОшибки","Сертификат не доступен в текущем контексте");
			Прервать;
			
		КонецЕсли;	
		
		Если ОбработкаИсключенияТипМодуляКриптографии(РезультатПодписания.ОписаниеОшибки, ДанныеСертификата) Тогда
			ДанныеАвторизацииДляТеста.ИмяМодуляКриптографии = ДанныеСертификата.ИмяМодуляКриптографии;
			ДанныеАвторизацииДляТеста.ТипМодуляКриптографии = ДанныеСертификата.ТипМодуляКриптографии;
			Продолжить; // еще раз, уже с нужным типом модуля криптографии
		КонецЕсли;
		
		Если РезультатПодписания.Успешно Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
		
	УдалитьФайлы(ИмяФайлаДляТеста);
	
	Если РезультатПодписания.Успешно Тогда

		ДанныеАвторизацииДляТеста.Организация =	Организация;
		ДанныеАвторизацииДляТеста.ТипАвторизации = "Сертификат";

		Если СертификатКвалифицированный(ДанныеАвторизацииДляТеста) = Ложь Тогда
			Результат.ОписаниеОшибки = "Сертификат не является квалифицированным";
			Результат.Успешно = Ложь;
		Иначе
			Результат.Успешно = Истина;	
		КонецЕсли;
		
	Иначе
		
		Результат.ОписаниеОшибки = РезультатПодписания.ОписаниеОшибки;
		Результат.Успешно = РезультатПодписания.Успешно;
		
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

Функция СертификатКвалифицированный(ДанныеАвторизации)
	
	Результат = Ложь;
	ДанныеАвторизацииДиадок = ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизации);
	
	Попытка
		ИдентификаторОрганизацииДиадок = ИдентификаторОрганизацииДиадок(ДанныеАвторизации.Организация);
		ИдентификаторЯщикаДиадок = ИдентификаторЯщикаДиадок(ДанныеАвторизации, ИдентификаторОрганизацииДиадок);
		Ответ = КонтурДиадокAPI_ПроверкаКвалифицированностиСертификата(ДанныеАвторизацииДиадок, ИдентификаторЯщикаДиадок, ДанныеАвторизацииДиадок.Отпечаток);	
		Результат = Ответ.IsValid;	
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		ТекстСообщения = КонтурСтандарт_СтрШаблон_("По организации ""%1"" не удалось проверить сертификат на квалифицированность по причине:%2%3", Строка(ДанныеАвторизации.Организация), Символы.ПС, ОписаниеОшибки);		
		Сообщить_КонтурEDI(ТекстСообщения);
	КонецПопытки;
		
	Возврат Результат;
	
КонецФункции

Функция ОбработкаИсключенияТипМодуляКриптографии(ОписаниеОшибки, ДанныеСертификата)
	
	ОписаниеОшибкиНРег = НРег(ОписаниеОшибки);
	
	Если Найти(ОписаниеОшибкиНРег, НРег("Сертификат, связанный с закрытым ключом, указывает на модуль криптографии, отличный от текущего")) = 0 Тогда
		Возврат Ложь;	
	КонецЕсли;
	
	ТипыМодуляКриптографии = Новый Структура;
	
	Если МодульСервернойКриптографииДоступен() Тогда
	
		ТипыМодуляКриптографии = Криптография_ВариантыНастройкиКриптографии();
		
	Иначе
		
		ТипыМодуляКриптографии = Криптография_ВариантыНастройкиПоТипуПлатформы();
		
	КонецЕсли;	
	
	Для Каждого МодульКриптографии Из ТипыМодуляКриптографии Цикл
		
		Если Найти(ОписаниеОшибкиНРег, НРег(МодульКриптографии.ИмяМодуляКриптографии)) <> 0
			И Найти(ОписаниеОшибкиНРег, НРег(МодульКриптографии.ТипМодуляКриптографии)) <> 0 Тогда
			
			ДанныеСертификата.Вставить("ИмяМодуляКриптографии", МодульКриптографии.ИмяМодуляКриптографии);
			ДанныеСертификата.Вставить("ТипМодуляКриптографии", МодульКриптографии.ТипМодуляКриптографии);
			
			СохранитьПараметрыСертификата(ДанныеСертификата);
			
			Возврат Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ТипПлатформы1С_КонтурEDI() Экспорт
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ТипПлатформы1С = СистемнаяИнформация.ТипПлатформы;	
	Если ТипПлатформы1С = Неопределено Тогда
		ТипПлатформы1С = "";
	КонецЕсли;	

	Возврат ТипПлатформы1С;

КонецФункции	

Функция ОшибкаНеправильныйПарольКонтейнера(ОписаниеОшибки = "")

	ШаблоныОшибокПароляКонтейнера = Новый Массив;
	ШаблоныОшибокПароляКонтейнера.Добавить("неправильный пароль доступа к закрытому ключу");
	ШаблоныОшибокПароляКонтейнера.Добавить("контекст был получен в ограниченном режиме");
	ШаблоныОшибокПароляКонтейнера.Добавить("incorrect access password to a private key");
	ШаблоныОшибокПароляКонтейнера.Добавить("ошибка при установке параметра модуля криптографии");
	ШаблоныОшибокПароляКонтейнера.Добавить("ошибка при расшифровании криптографических данных");
	
	ЭтоОшибкаПароляКонтейнера = Ложь;
	
	Для Каждого ШаблонОшибки Из ШаблоныОшибокПароляКонтейнера Цикл
		
		ЭтоОшибкаПароляКонтейнера = 
		Найти(Нрег(ОписаниеОшибки), ШаблонОшибки) <> 0;
		
		Если ЭтоОшибкаПароляКонтейнера Тогда
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ЭтоОшибкаПароляКонтейнера;

КонецФункции

Функция ОшибкаДействиеОтмененоПользователем(ОписаниеОшибки = "")

	Если Найти(Нрег(ОписаниеОшибки), "0x8010006e") <> 0 
		ИЛИ Найти(Нрег(ОписаниеОшибки), "отменено пользователем") <> 0 Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции // ОшибкаДействиеОтмененоПользователем()

Процедура ПодписатьСчетаФактуры(СчетаФактурыНаПодписание)

	Для Каждого СтрокаСчетФактура Из СчетаФактурыНаПодписание Цикл
		
		Отказ = Ложь;
		НазначенныеДанныеАвторизации = Новый_НазначенныеДанныеАвторизации(СтрокаСчетФактура, Отказ);
		
		Если Отказ = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		MessageId = СтрокаСчетФактура.MessageId;
		BoxId 	  = СтрокаСчетФактура.BoxId;
		
		СчетФактураСсылка = СтрокаСчетФактура.Ссылка;

		operationID = ПолучитьИлиСоздать_Diadoc_operationID(СчетФактураСсылка);		
		
		Попытка
			Message = ПолучитьMessage(BoxId, MessageId, НазначенныеДанныеАвторизации);
		Исключение
			ОписаниеОшибки = ОписаниеОшибки();
			ЗафиксироватьОшибку_НеУдалосьПолучитьДокументыДляПодписанияСчетФактуры(СтрокаСчетФактура, ОписаниеОшибки);
			Продолжить;
		КонецПопытки;
		
		ЭтоЧерновик 			  = Message.IsDraft; 
		СтрокаСчетФактура.IsDraft = ЭтоЧерновик;
		                              	
		Попытка
			PrepareDocumentsToSignResponse = ПолучитьPatchedEntities(Message, BoxId, MessageId, НазначенныеДанныеАвторизации, ЭтоЧерновик);
		Исключение                                                                         
			ОписаниеОшибки = ОписаниеОшибки();
			ЗафиксироватьОшибку_НеУдалосьЗаполнитьПодписанта(СтрокаСчетФактура, ОписаниеОшибки);
			Продолжить;
		КонецПопытки;
		
		Если НЕ ЭтоЧерновик Тогда
			
			MessagePatchToPost = КонтурДиадокAPI_СоздатьПоСхеме("MessagePatchToPostV2");
			
			MessagePatchToPost.BoxId 	 = BoxId;
			MessagePatchToPost.MessageId = MessageId;
			
			PowerOfAttorneyToPost = PowerOfAttorneyToPost(НазначенныеДанныеАвторизации);	
			
			Для Каждого DocumentPatchedContent Из PrepareDocumentsToSignResponse.DocumentPatchedContents Цикл
				
				Content = DocumentPatchedContent.Content;
				Контент = Base64Значение(Content);
				
				Попытка
					Подпись = ПодписатьКонтент(Контент, НазначенныеДанныеАвторизации);				
				Исключение
					ОписаниеОшибки = ОписаниеОшибки();
					ЗафиксироватьОшибку_НеУдалосьПодписатьСчетФактуру(СтрокаСчетФактура, ОписаниеОшибки);
					Продолжить;
				КонецПопытки;
				
				DocumentSignature = КонтурДиадокAPI_СоздатьПоСхеме("DocumentSignature");
				
				DocumentSignature.ParentEntityId 	= DocumentPatchedContent.DocumentId.EntityId;
				DocumentSignature.Signature 	 	= Подпись;
				DocumentSignature.PatchedContentId 	= DocumentPatchedContent.PatchedContentId; 
				DocumentSignature.PowerOfAttorney  	= PowerOfAttorneyToPost; 
				
				MessagePatchToPost.Signatures.Добавить(DocumentSignature);
				
			КонецЦикла;
			
			Попытка
				MessagePatch = PostMessagePatch(MessagePatchToPost, operationID, НазначенныеДанныеАвторизации);
			Исключение
				ОписаниеОшибки = ОписаниеОшибки();
				ЗафиксироватьОшибку_НеУдалосьОтправитьДокумент(СтрокаСчетФактура, ОписаниеОшибки);
				Продолжить;
			КонецПопытки;
			
			// ?
			СтрокаСчетФактура.MessageId_new						= MessagePatch.MessageId;
			СтрокаСчетФактура.invoiceId_new						= СтрокаСчетФактура.invoiceId;
			СтрокаСчетФактура.UniversalTransferDocumentId_new	= СтрокаСчетФактура.UniversalTransferDocumentId;
			СтрокаСчетФактура.torg12Id_new						= СтрокаСчетФактура.torg12Id;
			
			ВыполнитьОбработкуПодписанногоДокумента_КонтурEDI(СтрокаСчетФактура);  
			
		Иначе
			
			DraftToSend = КонтурДиадокAPI_СоздатьПоСхеме("DraftToSend");
			
			DraftToSend.BoxId 	= BoxId;
			DraftToSend.DraftId = MessageId;
			
			PowerOfAttorneyToPost = PowerOfAttorneyToPost(НазначенныеДанныеАвторизации);	
			
			Для Каждого DocumentPatchedContent Из PrepareDocumentsToSignResponse.DocumentPatchedContents Цикл
				
				Content = DocumentPatchedContent.Content;
				Контент = Base64Значение(Content);
				
				Попытка
					Подпись = ПодписатьКонтент(Контент, НазначенныеДанныеАвторизации);				
				Исключение
					ОписаниеОшибки = ОписаниеОшибки();
					ЗафиксироватьОшибку_НеУдалосьПодписатьСчетФактуру(СтрокаСчетФактура, ОписаниеОшибки);
					Продолжить;
				КонецПопытки;
				
				DocumentSenderSignature = КонтурДиадокAPI_СоздатьПоСхеме("DocumentSenderSignature");
				
				DocumentSenderSignature.ParentEntityId 		= DocumentPatchedContent.DocumentId.EntityId;
				DocumentSenderSignature.Signature 	 		= Подпись;
				DocumentSenderSignature.PatchedContentId 	= DocumentPatchedContent.PatchedContentId; 
				DocumentSenderSignature.PowerOfAttorney  	= PowerOfAttorneyToPost; 
				
				DraftToSend.DocumentSignatures.Добавить(DocumentSenderSignature);
				
			КонецЦикла;
			
			Попытка
				Message = ОтправитьSendDraft(DraftToSend, НазначенныеДанныеАвторизации, operationID);
			Исключение
				ОписаниеОшибки = ОписаниеОшибки();
				ЗафиксироватьОшибку_НеУдалосьОтправитьДокумент(СтрокаСчетФактура, ОписаниеОшибки);
				Продолжить;
			КонецПопытки;
			
			// ?
			
			//Отражение результатов - укажем в нашей табличке новые идентификаторы
			СтрокаСчетФактура.MessageId_new = Message.MessageId;
			//теперь найти invoiceID, torg12Id, updID
			Для Каждого Entity из Message.Entities Цикл
				Если Entity.AttachmentType = "Invoice" или Entity.AttachmentType = "InvoiceCorrection" Тогда 
					СтрокаСчетФактура.InvoiceId_new = Entity.EntityId;
				ИначеЕсли Entity.AttachmentType="XmlTorg12" Тогда 
					СтрокаСчетФактура.torg12Id_new = Entity.EntityId;
				ИначеЕсли Entity.AttachmentType = "UniversalTransferDocument" или Entity.AttachmentType = "UniversalTransferDocumentRevision" Тогда 
					СтрокаСчетФактура.UniversalTransferDocumentId_new = Entity.EntityId;     //УПД
				ИначеЕсли Entity.AttachmentType = "UniversalCorrectionDocument" или Entity.AttachmentType = "UniversalCorrectionDocumentRevision" Тогда 
					СтрокаСчетФактура.UniversalTransferDocumentId_new = Entity.EntityId;     //УКД пишем тоже в  UniversalTransferDocumentId
				КонецЕсли;
			КонецЦикла;
			
			ВыполнитьОбработкуПодписанногоДокумента_КонтурEDI(СтрокаСчетФактура);				
			
		КонецЕсли;
				
	КонецЦикла;
	
КонецПроцедуры

Функция ПодписатьКонтент(Контент, ДанныеАвторизации)
	
	Для Сч = 1 По 2 Цикл
		
		РезультатПодписания = ПолучитьПодписьФайлаДокумента_КонтурEDI(Контент, ДанныеАвторизации);
		
		Если ОбработкаИсключенияТипМодуляКриптографии(РезультатПодписания.ОписаниеОшибки, ДанныеАвторизации) Тогда
			Продолжить; // еще раз, уже с нужным типом модуля криптографии
		Иначе
			Прервать;
		КонецЕсли;	
		
	КонецЦикла;
	
	Если РезультатПодписания.Успешно = Истина Тогда
		Возврат РезультатПодписания.ШифрованнаяПодпись;
	Иначе
		ВызватьИсключение РезультатПодписания.ОписаниеОшибки;
	КонецЕсли;
	
КонецФункции


Функция Новый_НазначенныеДанныеАвторизации(СтрокаСчетФактура, Отказ)
	
	СтруктураСобытия = СобытиеСертификаты_НазначитьСертификат(СтрокаСчетФактура);
	
	Если СтруктураСобытия.Переопределено Тогда 
		
		НазначенныеДанныеАвторизации = ПолучитьСтруктуруДанныхАвторизации();
		НазначенныеДанныеАвторизации.Организация = СтруктураСобытия.Организация;
		НазначенныеДанныеАвторизации.Отпечаток = СтруктураСобытия.Сертификат.Отпечаток;
		НазначенныеДанныеАвторизации.ПарольКонтейнера = СтруктураСобытия.Сертификат.Пароль;
		НазначенныеДанныеАвторизации.Расположение = СтруктураСобытия.Сертификат.Расположение;
		НазначенныеДанныеАвторизации.ТребуетсяДоверенность = СтруктураСобытия.Доверенность.ИспользоватьПоУмолчанию;
		НазначенныеДанныеАвторизации.ТипАвторизации = "Сертификат";
		
		СтруктураСобытия.Доверенность.Вставить("ДвоичныеДанныеДоверенности", СтруктураСобытия.ДвоичныеДанныеДоверенности);
		СтруктураСобытия.Доверенность.Вставить("ДвоичныеДанныеПодписи", СтруктураСобытия.ДвоичныеДанныеПодписи);
		
		НазначенныеДанныеАвторизации.Доверенность = СтруктураСобытия.Доверенность;
		
	Иначе 
		
		Если НЕ СтрокаСчетФактура.Организация = ДанныеАвторизации.Организация Тогда
			ИнициализироватьДанныеАвторизации(СтрокаСчетФактура.Организация);
		КонецЕсли;
		
		НазначенныеДанныеАвторизации = ДанныеАвторизации; 
		
		Если ПропускСертификатаПоОрганизации(СтрокаСчетФактура.Организация) Тогда
			// по какой-то причине не удалось выбрать сертификат или не прошли проверку с сертификатом
			Отказ = Истина;
			Возврат НазначенныеДанныеАвторизации;
		КонецЕсли; 
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НазначенныеДанныеАвторизации.Доверенность) Тогда
		СпособПередачиМашиночитаемойДоверенности = СпособПередачиМашиночитаемойДоверенности(СтрокаСчетФактура.Ссылка.Партнер);
		НазначенныеДанныеАвторизации.Вставить("СпособПередачиДоверенности", СпособПередачиМашиночитаемойДоверенности);
	КонецЕсли;
	
	ЕстьДоверенностьПоУмолчаниюВДиадок = ЗначениеЗаполнено(ДоверенностьПоУмолчанию(НазначенныеДанныеАвторизации));
	НазначенныеДанныеАвторизации.Вставить("ЕстьДоверенностьПоУмолчаниюВДиадок", ЕстьДоверенностьПоУмолчаниюВДиадок);

	Возврат НазначенныеДанныеАвторизации;
	
КонецФункции

