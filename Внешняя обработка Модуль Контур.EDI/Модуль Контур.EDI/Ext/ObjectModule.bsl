Процедура ОперацииОбмена_СинхронизироватьОбщуюГраницуСобытийЛенты()
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИдентификаторыСобытий.ИдентификаторДатыСобытия КАК ИдентификаторДатыСобытия
		|ПОМЕСТИТЬ ДатыСобытий
		|ИЗ
		|	&ИдентификаторыСобытий КАК ИдентификаторыСобытий
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КонтурEDI_ДополнительныеСправочники.Ссылка КАК ТранспортныйЯщик,
		|	ЕСТЬNULL(КонтурEDI_ДополнительныеРеквизиты.Значение, """") КАК lastEventId
		|ПОМЕСТИТЬ ТранспортныеЯщики
		|ИЗ
		|	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеРеквизиты
		|		ПО КонтурEDI_ДополнительныеСправочники.Ссылка = КонтурEDI_ДополнительныеРеквизиты.Объект
		|			И (КонтурEDI_ДополнительныеРеквизиты.Свойство = ""lastEventId"")
		|ГДЕ
		|	КонтурEDI_ДополнительныеСправочники.ИмяСправочника = ""ТранспортныеЯщики""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТранспортныеЯщики.ТранспортныйЯщик КАК ТранспортныйЯщик,
		|	ТранспортныеЯщики.lastEventId КАК lastEventId,
		|	ДатыСобытий.ИдентификаторДатыСобытия КАК ИдентификаторДатыСобытия
		|ПОМЕСТИТЬ ТраспортныеЯщикиСвойства
		|ИЗ
		|	ТранспортныеЯщики КАК ТранспортныеЯщики,
		|	ДатыСобытий КАК ДатыСобытий
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТраспортныеЯщикиСвойства.ТранспортныйЯщик КАК ТранспортныйЯщик,
		|	ТраспортныеЯщикиСвойства.lastEventId КАК lastEventId,
		|	МИНИМУМ(ЕСТЬNULL(КонтурEDI_ДополнительныеРеквизиты.Значение, ДАТАВРЕМЯ(1, 1, 1))) КАК МинимальнаяДатаСобытий
		|ПОМЕСТИТЬ ТранспортныеЯщикиМинимальныеДатыСобытий
		|ИЗ
		|	ТраспортныеЯщикиСвойства КАК ТраспортныеЯщикиСвойства
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеРеквизиты
		|		ПО ТраспортныеЯщикиСвойства.ТранспортныйЯщик = КонтурEDI_ДополнительныеРеквизиты.Объект
		|			И ТраспортныеЯщикиСвойства.ИдентификаторДатыСобытия = КонтурEDI_ДополнительныеРеквизиты.Свойство
		|
		|СГРУППИРОВАТЬ ПО
		|	ТраспортныеЯщикиСвойства.ТранспортныйЯщик,
		|	ТраспортныеЯщикиСвойства.lastEventId
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТранспортныеЯщикиМинимальныеДатыСобытий.ТранспортныйЯщик КАК ТранспортныйЯщик,
		|	ВЫБОР
		|		КОГДА ТранспортныеЯщикиМинимальныеДатыСобытий.МинимальнаяДатаСобытий = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ТранспортныеЯщикиМинимальныеДатыСобытий.lastEventId
		|		ИНАЧЕ ТранспортныеЯщикиМинимальныеДатыСобытий.МинимальнаяДатаСобытий
		|	КОНЕЦ КАК lastEventId_Значение
		|ИЗ
		|	ТранспортныеЯщикиМинимальныеДатыСобытий КАК ТранспортныеЯщикиМинимальныеДатыСобытий";
	
	ИдентификаторыСобытий = Новый ТаблицаЗначений;
	ДобавитьКолонкиВТаблицуЗначений(ИдентификаторыСобытий, "ИдентификаторДатыСобытия", ОписаниеТипаСтрока_КонтурEDI(100));
	
		СписокСвойствEDI = 
	"МыПоставщик
	|МыТорговаяСеть";
	
	РежимыРаботы = ПолучитьСписокСвойствEDI(СписокСвойствEDI);
	
	МыПоставщик = РежимыРаботы.МыПоставщик = Истина;
	МыТорговаяСеть = РежимыРаботы.МыТорговаяСеть = Истина;
	
	Если МыПоставщик Тогда
		Для Каждого ТипСообщения Из ОперацииОбмена_ТипыСообщенийДляЗагрузкиПоставщик() Цикл
			СтрокаТаблицы = ИдентификаторыСобытий.Добавить();
			СтрокаТаблицы.ИдентификаторДатыСобытия = КонтурСтандарт_СтрШаблон_("Дата_Id_%1", ТипСообщения);
		КонецЦикла;
	КонецЕсли;
	
	Если МыТорговаяСеть Тогда
		Для Каждого ТипСообщения Из ОперацииОбмена_ТипыСообщенийДляЗагрузкиСеть() Цикл
			СтрокаТаблицы = ИдентификаторыСобытий.Добавить();
			СтрокаТаблицы.ИдентификаторДатыСобытия = КонтурСтандарт_СтрШаблон_("Дата_Id_%1", ТипСообщения);
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого ТипСообщения Из ОперацииОбмена_ТипыСообщенийДляЗагрузкиСтатусные() Цикл
		СтрокаТаблицы = ИдентификаторыСобытий.Добавить();
		СтрокаТаблицы.ИдентификаторДатыСобытия = КонтурСтандарт_СтрШаблон_("Дата_Id_%1", ТипСообщения);
	КонецЦикла;
	
	Запрос.УстановитьПараметр("ИдентификаторыСобытий", ИдентификаторыСобытий);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	СвойствоlastEventId = "lastEventId";
	РазницаСВременемПоМСК = ТекущаяДата() - (ТекущаяУниверсальнаяДата() + 60 * 60 * 3);
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ТипЗнч(ВыборкаДетальныеЗаписи.lastEventId_Значение) = Тип("Дата") Тогда
			ИдентификаторПоследнегоСобытия = Формат(ВыборкаДетальныеЗаписи.lastEventId_Значение - РазницаСВременемПоМСК, "ДФ=yyyyMMddHHmmss");
		Иначе
			ИдентификаторПоследнегоСобытия = ВыборкаДетальныеЗаписи.lastEventId_Значение;
		КонецЕсли;
		
		УстановитьЗначениеСвойстваОбъекта(ВыборкаДетальныеЗаписи.ТранспортныйЯщик, СвойствоlastEventId, ИдентификаторПоследнегоСобытия);
		
	КонецЦикла;
	
КонецПроцедуры

// #КонецОбласти

// #Область ФоновыеЗаданияКонтурEDI

Функция ФоновыеЗаданияКонтурEDI_ВыполнитьЗадание(ИмяМетода, ПараметрыМетода, ИдентификаторФоновогоЗадания, ВыполнитьФункцию = Ложь) Экспорт
	
	СтандартнаяОбработкаEDI = Истина;
	РезультатДлительнаяОперация = ФоновыеЗаданияКонтурEDIПереопределяемый_ВыполнитьЗадание(ИмяМетода, ПараметрыМетода, ИдентификаторФоновогоЗадания, ВыполнитьФункцию, СтандартнаяОбработкаEDI);
	
	Если СтандартнаяОбработкаEDI Тогда
		
		ДлительныеОперацииОбщийМодуль = ОбщийМодуль1С_КонтурEDI("ДлительныеОперации");
		
		ПараметрыВыполнения = ДлительныеОперацииОбщийМодуль.ПараметрыВыполненияПроцедуры();
		ПараметрыВыполнения.НаименованиеФоновогоЗадания = ИдентификаторФоновогоЗадания;
		ПараметрыВыполнения.ЗапуститьВФоне = Истина;
		
		АдресВХранилище = ПоместитьВоВременноеХранилище(Неопределено);
		
		ПараметрыЗадания = Новый Структура;
		ПараметрыЗадания.Вставить("ИмяОбработки",                  "КонтурEDI");
		ПараметрыЗадания.Вставить("ИмяМетода",                     ИмяМетода);
		ПараметрыЗадания.Вставить("ПараметрыВыполнения",           ПараметрыМетода);
		ПараметрыЗадания.Вставить("ЭтоВнешняяОбработка",           ФоновыеЗаданияКонтурEDI_ЭтоВнешняяОбработкаСправочник());
		ПараметрыЗадания.Вставить("ДополнительнаяОбработкаСсылка", ФоновыеЗаданияКонтурEDI_СсылкаНаМодульКонтурEDI());
		
		ИмяФункцииИлиПроцедуры = "ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки";
		
		Если ВыполнитьФункцию Тогда
			
			РезультатДлительнаяОперация = ДлительныеОперацииОбщийМодуль.ВыполнитьФункцию(
			ПараметрыВыполнения,
			ИмяФункцииИлиПроцедуры,
			ПараметрыЗадания,
			АдресВХранилище);
			
		Иначе
			
			РезультатДлительнаяОперация = ДлительныеОперацииОбщийМодуль.ВыполнитьПроцедуру(
			ПараметрыВыполнения,
			ИмяФункцииИлиПроцедуры,
			ПараметрыЗадания,
			АдресВХранилище);
			
		КонецЕсли;
		
		Если РезультатДлительнаяОперация.Статус = "Ошибка" Тогда
			ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, РезультатДлительнаяОперация.ПодробноеПредставлениеОшибки);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РезультатДлительнаяОперация;
	
КонецФункции

Функция ФоновыеЗаданияКонтурEDI_Доступны() Экспорт
	
	Результат = Неопределено;
	ФоновыеЗаданияКонтурEDIПереопределяемый_Доступны(Результат);
	
	Если Результат = Неопределено Тогда
		
		Результат = Ложь;
				
		ВерсияБСП = ПолучитьВерсиюБСП_КонтурEDI();
		Если ВерсияБСП <> Неопределено Тогда			
			
			Результат = 
			КонтурСтандарт_СравнитьВерсии(ВерсияБСП, "3.0") > 0 И НЕ ФоновыеЗаданияКонтурEDI_ЭтоВнешняяОбработкаФайл();
			
			Если Результат Тогда
				
				Попытка
					ПараметрыВыполнения = Новый Структура("ВОтдельномФоновомЗадании", Истина);
					ИмяМетода = "ФоновыеЗаданияКонтурEDI_ПроверитьВыполнение";
					ИдентификаторФоновогоЗадания = ИмяМетода;
					ФоновыеЗаданияКонтурEDI_ВыполнитьЗадание(ИмяМетода, ПараметрыВыполнения, ИдентификаторФоновогоЗадания);
				Исключение
					Результат = Ложь;
				КонецПопытки;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

