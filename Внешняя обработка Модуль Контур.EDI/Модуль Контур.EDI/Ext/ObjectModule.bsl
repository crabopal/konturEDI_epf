Функция ПолучитьСтрокуРеквизитаДопСправочника_КонтурEDI(СправочникОбъект, ИмяРеквизита)
	
	СтрокаРеквизита = Неопределено;
	
	Если СправочникОбъект = Неопределено
		ИЛИ НЕ ЗначениеЗаполнено(ИмяРеквизита) Тогда
		Возврат СтрокаРеквизита;
	КонецЕсли;
	
	СтрокаРеквизита = СправочникОбъект.ДополнительныеРеквизиты.Найти(ИмяРеквизита, "ИмяРеквизита");
	
	Если СтрокаРеквизита = Неопределено Тогда
		СтрокаРеквизита = СправочникОбъект.ДополнительныеРеквизиты.Добавить();
		СтрокаРеквизита.ИмяРеквизита = ИмяРеквизита;
	КонецЕсли;
	
	Возврат СтрокаРеквизита;
	
КонецФункции

Функция НовыйСтруктураДопСправочника_КонтурEDI(ИмяСправочника = Неопределено) Экспорт
	
	Структура = Новый Структура;
	Структура.Вставить("Ссылка");
	Структура.Вставить("Наименование");
	Структура.Вставить("ИмяСправочника", ИмяСправочника);
	
	Если ИмяСправочника = Неопределено Тогда
		Возврат Структура;
	КонецЕсли;
	
	МетаданныеСправочников = ПолучитьМетаданныеДопСправочников_КонтурEDI();
	
	Если НЕ ТипЗнч(МетаданныеСправочников) = Тип("ТаблицаЗначений") Тогда
		Возврат Структура;
	КонецЕсли;
	
	СоздатьСтруктуруПоМаппингу_КонтурEDI(Структура, ИмяСправочника, МетаданныеСправочников);
	
	Возврат Структура;
	
КонецФункции

Процедура СоздатьСтруктуруПоМаппингу_КонтурEDI(ЗначениеРодителя, ИмяСтруктуры, ТаблицаМетаданных) Экспорт
	
	СтрокиМетаданных = ТаблицаМетаданных.НайтиСтроки(Новый Структура("ИмяОбъекта", ИмяСтруктуры));	
	
	Для каждого ВложенноеПоле Из СтрокиМетаданных Цикл
	
		ЗначениеСтруктуры = Неопределено;
	
		Если ВложенноеПоле.ТипПоля = "Структура" Тогда
			ЗначениеСтруктуры = Новый Структура;
		ИначеЕсли ВложенноеПоле.ТипПоля = "СписокЗначений" Тогда
			ЗначениеСтруктуры = Новый СписокЗначений;
		ИначеЕсли ВложенноеПоле.ТипПоля = "ТаблицаЗначений" Тогда
			ЗначениеСтруктуры = Новый ТаблицаЗначений;
		ИначеЕсли ВложенноеПоле.ТипПоля = "ДеревоЗначений" Тогда
			ЗначениеСтруктуры = Новый ДеревоЗначений;
		Иначе
			ТипПоля = ПолучитьТип_КонтурEDI(ВложенноеПоле.ТипПоля);
			Если НЕ ТипПоля = Неопределено Тогда
				ЗначениеСтруктуры = ТипПоля.ПривестиЗначение();
			КонецЕсли;
		КонецЕсли;
		
		Если ВложенноеПоле.ТипПоля = "Структура"
			ИЛИ ВложенноеПоле.ТипПоля = "ТаблицаЗначений"
			ИЛИ ВложенноеПоле.ТипПоля = "ДеревоЗначений" Тогда
			СоздатьСтруктуруПоМаппингу_КонтурEDI(ЗначениеСтруктуры, ВложенноеПоле.ИмяСтруктуры, ТаблицаМетаданных);	
		КонецЕсли;
		
		Если НЕ ЗначениеРодителя = Неопределено Тогда
			Если ТипЗнч(ЗначениеРодителя) = Тип("Структура") Тогда
				
				ЗначениеРодителя.Вставить(ВложенноеПоле.ИмяПоля, ЗначениеСтруктуры);
				
			ИначеЕсли ТипЗнч(ЗначениеРодителя) = Тип("ТаблицаЗначений") 
				ИЛИ ТипЗнч(ЗначениеРодителя) = Тип("ДеревоЗначений") Тогда
				
				ТипПоля = ПолучитьТип_КонтурEDI(ВложенноеПоле.ТипПоля);
				
				Если ТипПоля = Неопределено Тогда
					ЗначениеРодителя.Колонки.Добавить(ВложенноеПоле.ИмяПоля);
				Иначе
					ЗначениеРодителя.Колонки.Добавить(ВложенноеПоле.ИмяПоля, ТипПоля);
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

Функция ПрочитатьЭлементДопСправочника_КонтурEDI(СправочникСсылка) Экспорт
	
	Если СправочникСсылка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СправочникОбъект = СправочникСсылка.ПолучитьОбъект();
	Структура = НовыйСтруктураДопСправочника_КонтурEDI(СправочникОбъект.ИмяСправочника);
	
	Структура.Ссылка 			= СправочникОбъект.Ссылка;
	Структура.Наименование 		= СправочникОбъект.Наименование;
	
	ОписаниеРеквизитов = ПолучитьОписаниеРеквизитовДопСправочника_КонтурEDI(СправочникОбъект.ИмяСправочника);
	
	Для каждого СтрокаОписания Из ОписаниеРеквизитов Цикл
		ЗначениеРеквизита = Неопределено;
		СтрокаРеквизита = СправочникОбъект.ДополнительныеРеквизиты.Найти(СтрокаОписания.ИмяПоля, "ИмяРеквизита");	
		Если НЕ СтрокаРеквизита = Неопределено Тогда
			Если СтрокаОписания.ИмяРеквизитаОбъекта = "ЗначениеХранилищеЗначения" Тогда
				ЗначениеРеквизита = СтрокаРеквизита[СтрокаОписания.ИмяРеквизитаОбъекта].Получить(); 	
			Иначе	
				ЗначениеРеквизита = СтрокаРеквизита[СтрокаОписания.ИмяРеквизитаОбъекта]; 	
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
			Структура[СтрокаОписания.ИмяПоля] = ЗначениеРеквизита;	
		КонецЕсли;		
	КонецЦикла;	
	
	Возврат Структура;
	
КонецФункции

Процедура ЗаписатьЭлементДопСправочника_КонтурEDI(СтруктураЭлемента) Экспорт
	
	Если НЕ ТипЗнч(СтруктураЭлемента) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если СтруктураЭлемента.Свойство("Ссылка")
		И ЗначениеЗаполнено(СтруктураЭлемента.Ссылка) Тогда
		СправочникОбъект = СтруктураЭлемента.Ссылка.ПолучитьОбъект();
	Иначе
		СправочникОбъект = Справочники.КонтурEDI_ДополнительныеСправочники.СоздатьЭлемент();
	КонецЕсли;
	
	СправочникОбъект.Наименование 	= СтруктураЭлемента.Наименование;
	СправочникОбъект.ИмяСправочника = СтруктураЭлемента.ИмяСправочника;
	
	ОписаниеРеквизитов = ПолучитьОписаниеРеквизитовДопСправочника_КонтурEDI(СправочникОбъект.ИмяСправочника);
	
	Для каждого СтрокаОписания Из ОписаниеРеквизитов Цикл
		
		Если НЕ СтруктураЭлемента.Свойство(СтрокаОписания.ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаРеквизита = ПолучитьСтрокуРеквизитаДопСправочника_КонтурEDI(СправочникОбъект, СтрокаОписания.ИмяПоля);
		Если СтрокаОписания.ИмяРеквизитаОбъекта = "ЗначениеХранилищеЗначения" Тогда
			СтрокаРеквизита[СтрокаОписания.ИмяРеквизитаОбъекта] = Новый ХранилищеЗначения(СтруктураЭлемента[СтрокаОписания.ИмяПоля], Новый СжатиеДанных(9)); 	
		Иначе	
			СтрокаРеквизита[СтрокаОписания.ИмяРеквизитаОбъекта] = СтруктураЭлемента[СтрокаОписания.ИмяПоля]; 	
		КонецЕсли;
		
	КонецЦикла;
	
	СправочникОбъект.Записать();
	
	СтруктураЭлемента.Вставить("Ссылка", СправочникОбъект.Ссылка);
	
КонецПроцедуры

Функция ПолучитьОписаниеРеквизитовДопСправочника_КонтурEDI(ИмяСправочника = Неопределено) Экспорт
	
	ОписаниеРеквизитов = Неопределено;
	
	Если ИмяСправочника = Неопределено Тогда
		Возврат ОписаниеРеквизитов;
	КонецЕсли;
	
	МетаданныеДопСправочников = ПолучитьМетаданныеДопСправочников_КонтурEDI();
	ТаблицаМетаданных = МетаданныеДопСправочников.СкопироватьКолонки();
	
	ДобавитьОписаниеРеквизитовДопСправочникаРекурсивно_КонтурEDI(МетаданныеДопСправочников, ТаблицаМетаданных, ИмяСправочника);
	
	Возврат ТаблицаМетаданных;
	
КонецФункции
																				
Процедура ДобавитьОписаниеРеквизитовДопСправочникаРекурсивно_КонтурEDI(МетаданныеДопСправочников,
																		ТаблицаМетаданных,
																		ИмяСправочника = Неопределено)
																		
	СтрокиРеквизитовСправочника = МетаданныеДопСправочников.НайтиСтроки(Новый Структура("ИмяОбъекта", ИмяСправочника));
	
	Для каждого Строка Из СтрокиРеквизитовСправочника Цикл
		
		НайденныеСтроки = ТаблицаМетаданных.НайтиСтроки(Новый Структура("ИмяОбъекта,ИмяПоля", Строка.ИмяОбъекта, Строка.ИмяПоля));
		Если НЕ НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока =  ТаблицаМетаданных.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);

		Если ЗначениеЗаполнено(Строка.ИмяСтруктуры) Тогда
			// вложенные метаданные
			ДобавитьОписаниеРеквизитовДопСправочникаРекурсивно_КонтурEDI(МетаданныеДопСправочников, ТаблицаМетаданных, Строка.ИмяСтруктуры);
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьМетаданныеДопСправочников_КонтурEDI() Экспорт
	
	ТаблицаМетаданных = ЭДО_Кэш_Прочитать("ДопСправочники_Метаданные");
	
	Если ТаблицаМетаданных = Неопределено Тогда
		
		Макет = ПолучитьМакет_КонтурEDI("Маппинг_ДопСправочники", "mxl");
		ТаблицаМетаданных = ПолучитьТаблицуМетаданныхДопСправочников_КонтурEDI(Макет);
		
		ОбработкаСобытияПодключаемогоМодуля("ИзменитьМетаданныеДопСправочников",,Новый Структура("ТаблицаМетаданных", ТаблицаМетаданных));
		ЭДО_Кэш_Поместить("ДопСправочники_Метаданные", ТаблицаМетаданных);
		
	КонецЕсли;
	
	Возврат ТаблицаМетаданных;
	
КонецФункции

Функция ПолучитьМетаданныеОсобенностиСообщения(Знач ПараметрыОсобенности, Знач МетаданныеСообщения) Экспорт
	
	Результат = Новый ТаблицаЗначений;
	ДобавитьКолонкиВТаблицуЗначений(Результат, "ИмяОбъекта,ИмяПоля,ТипПоля,ИмяСтруктуры,Представление,ИмяСпискаВыбора");
	СтруктураПоиска = Новый Структура("ИмяТаблицы,ИмяПоля");

	Если ПараметрыОсобенности.ЭтоСтруктура
		И ЗначениеЗаполнено(ПараметрыОсобенности.ИмяСтруктуры) Тогда
		НайденныеМетаданные = ПолучитьМетаданныеПоляСообщения(ПараметрыОсобенности.ИмяСтруктуры);
	Иначе
		Если ЗначениеЗаполнено(ПараметрыОсобенности.ИмяТаблицы) Тогда
			СтруктураПоиска.Вставить("ИмяТаблицы", 	ПараметрыОсобенности.ИмяТаблицы);
		КонецЕсли;
		СтруктураПоиска.Вставить("ИмяПоля", 	ПараметрыОсобенности.Идентификатор);
		НайденныеСтроки = МетаданныеСообщения.НайтиСтроки(СтруктураПоиска);
		НайденныеМетаданные = МетаданныеСообщения.Скопировать(НайденныеСтроки);
	КонецЕсли;
	
	Если НайденныеМетаданные.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИмяОбъекта = ПараметрыОсобенности.Идентификатор;
	
	Если ЗначениеЗаполнено(ПараметрыОсобенности.ИмяСтруктуры) Тогда
		ИмяОбъекта = ПараметрыОсобенности.ИмяСтруктуры;	
	КонецЕсли;
	
	ПреобразоватьМетаданныеСообщенияВМаппингУниверсальнойФормыРекурсивно(ИмяОбъекта, НайденныеМетаданные, МетаданныеСообщения, Результат);
	
	Возврат Результат;
	
КонецФункции

Процедура ПреобразоватьМетаданныеСообщенияВМаппингУниверсальнойФормыРекурсивно(ИмяОбъекта, ТабМетаданных, МетаданныеСообщения, ТабМаппинга) Экспорт

	Для каждого СтрокаМетаданных из ТабМетаданных Цикл
		
		ВложенныеМетаданные = Неопределено;
		ТипПоля = Неопределено;
		Если ЗначениеЗаполнено(СтрокаМетаданных.ВидСтруктурыEDI) Тогда
			ТипПоля = СтрокаМетаданных.ТипEDI;
			ВложенныеМетаданные = ПолучитьМетаданныеПоляСообщения(СтрокаМетаданных.ВидСтруктурыEDI);
		ИначеЕсли СтрокаМетаданных.ТипEDI = "ТабличнаяЧасть"
			ИЛИ СтрокаМетаданных.ТипEDI = "ДеревоЗначений" Тогда
			ТипПоля = СтрЗаменить(СтрокаМетаданных.ТипEDI, "ТабличнаяЧасть", "ТаблицаЗначений");
			ВложенныеМетаданные = МетаданныеСообщения.Скопировать(Новый Структура("ИмяТаблицы", СтрокаМетаданных.ИмяТаблицы));
		Иначе
			Если ПеременнаяСодержитСвойство(СтрокаМетаданных, "Тип1С")
				И ЗначениеЗаполнено(СтрокаМетаданных.Тип1С) Тогда
				ТипПоля = СтрокаМетаданных.Тип1С;
			Иначе
				ТипПоля = СтрокаМетаданных.ТипEDI;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ИмяОбъекта = СтрокаМетаданных.ИмяПоля Тогда
			ДобавитьСтрокуМаппингаУниверсальнойФормы(ТабМаппинга, ИмяОбъекта, СтрокаМетаданных.ИмяПоля, ТипПоля, СтрокаМетаданных.ВидСтруктурыEDI);
		КонецЕсли;
		
		Если НЕ ВложенныеМетаданные = Неопределено Тогда
			СтрокаРодителя = ВложенныеМетаданные.Найти(ИмяОбъекта, "ИмяПоля");
			Если НЕ СтрокаРодителя = Неопределено Тогда
				ВложенныеМетаданные.Удалить(СтрокаРодителя);
			КонецЕсли;
			ПреобразоватьМетаданныеСообщенияВМаппингУниверсальнойФормыРекурсивно(СтрокаМетаданных.ИмяПоля, ВложенныеМетаданные, МетаданныеСообщения, ТабМаппинга);
		КонецЕсли;
		
	КОнецЦикла;
	
КонецПроцедуры
 
Процедура ДобавитьСтрокуМаппингаУниверсальнойФормы(Таб, 
													ИмяОбъекта, 
													ИмяПоля, 
													ТипПоля = Неопределено, 
													ИмяСтруктуры = Неопределено, 
													Представление = Неопределено, 
													ИмяСпискаВыбора = Неопределено)
	
	НоваяСтрока = Таб.Добавить();
	НоваяСтрока.ИмяОбъекта = ИмяОбъекта;
	НоваяСтрока.ИмяПоля = ИмяПоля;
	НоваяСтрока.ТипПоля = ТипПоля;
	НоваяСтрока.ИмяСтруктуры = ИмяСтруктуры;
	НоваяСтрока.Представление = Представление;
	НоваяСтрока.ИмяСпискаВыбора = ИмяСпискаВыбора;

КонецПроцедуры

Функция ПолучитьСписокВыбораПоИмени_КонтурEDI(ИмяСпискаВыбора, ИмяПеречисления = Неопределено) Экспорт
	
	СписокВыбора = Новый СписокЗначений;
	
	Если ИмяСпискаВыбора = Неопределено Тогда
		Возврат СписокВыбора;
	КонецЕсли;	
	
	Если ИмяСпискаВыбора = "Классификатор_ПеречисленияEDI"
		И ЗначениеЗаполнено(ИмяПеречисления) Тогда
		Возврат ПолучитьСписокЗначенийПеречисленияEDI(ИмяПеречисления);
		
	ИначеЕсли НЕ Найти(ИмяСпискаВыбора, "Классификатор_") = 0 Тогда
		ТипКлассификатора = СтрЗаменить(ИмяСпискаВыбора, "Классификатор_", "");
		Возврат ЗагрузитьКлассификаторИзМакета(ТипКлассификатора);
		
	КонецЕсли;
	
	Возврат СписокВыбора;
	
КонецФункции

Функция ПолучитьТаблицуМетаданныхДопСправочников_КонтурEDI(Макет)
	
	ТабМетаданных = Новый ТаблицаЗначений;
	ДобавитьКолонкиВТаблицуЗначений(ТабМетаданных, "ИмяОбъекта,ИмяПоля,ТипПоля,ИмяСтруктуры,ИмяРеквизитаОбъекта,Представление,ИмяСпискаВыбора");
	
	Если Макет = Неопределено Тогда
		Возврат ТабМетаданных;
	КонецЕсли;
	
	ОбластьДопСправочники = Макет.ПолучитьОбласть("Метаданные");
	
	Для Сч = 1 По ОбластьДопСправочники.ВысотаТаблицы Цикл
		НоваяСтрока = ТабМетаданных.Добавить();
		НоваяСтрока.ИмяОбъекта				= ПолучитьТекстЯчейкиОбласти(ОбластьДопСправочники, Сч, 1);
		НоваяСтрока.ИмяПоля					= ПолучитьТекстЯчейкиОбласти(ОбластьДопСправочники, Сч, 2);
		НоваяСтрока.ТипПоля					= ПолучитьТекстЯчейкиОбласти(ОбластьДопСправочники, Сч, 3);
		НоваяСтрока.ИмяСтруктуры			= ПолучитьТекстЯчейкиОбласти(ОбластьДопСправочники, Сч, 4);
		НоваяСтрока.ИмяРеквизитаОбъекта		= ПолучитьТекстЯчейкиОбласти(ОбластьДопСправочники, Сч, 5);
		НоваяСтрока.Представление			= ПолучитьТекстЯчейкиОбласти(ОбластьДопСправочники, Сч, 6);
		НоваяСтрока.ИмяСпискаВыбора			= ПолучитьТекстЯчейкиОбласти(ОбластьДопСправочники, Сч, 7);
	КонецЦикла;
	
	Возврат ТабМетаданных;
	
КонецФункции

Функция ПолучитьХранилищеРеквизитаДопСправочника_КонтурEDI(СправочникСсылка, ИмяРеквизита)
	
	ЗначениеХранилища = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(СправочникСсылка)
		ИЛИ НЕ ЗначениеЗаполнено(ИмяРеквизита) Тогда
		Возврат ЗначениеХранилища;
	КонецЕсли;
	
	СправочникОбъект = СправочникСсылка.ПолучитьОбъект();
	СтрокаРеквизита = ПолучитьСтрокуРеквизитаДопСправочника_КонтурEDI(СправочникОбъект, ИмяРеквизита);
	
	Если СтрокаРеквизита = Неопределено Тогда
		Возврат ЗначениеХранилища;
	КонецЕсли;
	
	ЗначениеХранилища = СтрокаРеквизита.ЗначениеХранилищеЗначения.Получить();
	
	Возврат ЗначениеХранилища;
	
КонецФункции

Функция ПолучитьТип_КонтурEDI(ИмяТипа = Неопределено) Экспорт
	
	Тип = Неопределено;
	
	Если ИмяТипа = Неопределено Тогда
		Возврат Тип;
	КонецЕсли;
	
	СоответствиеТипов = ЭДО_Кэш_Прочитать("ТипыОбъектов");
	
	Если СоответствиеТипов = Неопределено Тогда
		СоответствиеТипов = Новый Соответствие;
	КонецЕсли;
	
	Тип = СоответствиеТипов[ИмяТипа];
	Если НЕ Тип = Неопределено Тогда
		Возврат Тип;
	КонецЕсли;
	
	// сначала примитивные типы
	МассивТипов = Новый Массив;
	
	МассивИменТипов = СтрЗаменить(ИмяТипа, ",", Символы.ПС);
	КоличествоИменТипов = СтрЧислоСтрок(МассивИменТипов);
	
	ДлинаСтроки		= 0;
	ДлинаЧисла		= 0;
	ТочностьЧисла	= 0;
	пЧастиДаты		= Неопределено;
	
	Для Счетчик = 1 По КоличествоИменТипов Цикл
		
		ПолученноеИмяТипа = СтрПолучитьСтроку(МассивИменТипов, Счетчик);
		СтруктуруДляСозданияТипа = КонтурEDI_ПолучитьСтруктуруДляСозданияТипа(ПолученноеИмяТипа);
		
		Если НЕ ЗначениеЗаполнено(СтруктуруДляСозданияТипа.ИмяТипа) Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоСтрок = СтрЧислоСтрок(СтруктуруДляСозданияТипа.ИмяТипа);
		
		Для К = 1 По КоличествоСтрок Цикл
			ИмяТипаИзСтроки = СокрЛП(СтрПолучитьСтроку(СтруктуруДляСозданияТипа.ИмяТипа,К));
			Если ЗначениеЗаполнено(ИмяТипаИзСтроки) Тогда
				МассивТипов.Добавить(Тип(ИмяТипаИзСтроки));
			КонецЕсли;
		КонецЦикла;  		
				
		Если ДлинаСтроки < СтруктуруДляСозданияТипа.ДлинаСтроки Тогда
			ДлинаСтроки = СтруктуруДляСозданияТипа.ДлинаСтроки;
		КонецЕсли;
		Если ДлинаЧисла < СтруктуруДляСозданияТипа.ДлинаЧисла Тогда
			ДлинаЧисла = СтруктуруДляСозданияТипа.ДлинаЧисла;
		КонецЕсли;
		Если ТочностьЧисла < СтруктуруДляСозданияТипа.ТочностьЧисла Тогда
			ТочностьЧисла = СтруктуруДляСозданияТипа.ТочностьЧисла;
		КонецЕсли;
		
		Если пЧастиДаты = Неопределено Тогда
			пЧастиДаты = СтруктуруДляСозданияТипа.ЧастиДаты; 
		ИначеЕсли СтруктуруДляСозданияТипа.ЧастиДаты = ЧастиДаты.ДатаВремя Тогда
			пЧастиДаты = СтруктуруДляСозданияТипа.ЧастиДаты;
		ИначеЕсли пЧастиДаты <> СтруктуруДляСозданияТипа.ЧастиДаты Тогда
			пЧастиДаты = ЧастиДаты.ДатаВремя;
		Иначе
			пЧастиДаты = СтруктуруДляСозданияТипа.ЧастиДаты;
		КонецЕсли; 
		
	КонецЦикла;
	
	Если ДлинаСтроки > 0 Тогда
		ПараметрыСтроки = Новый КвалификаторыСтроки(ДлинаСтроки); 
	Иначе
		ПараметрыСтроки = Неопределено;
	КонецЕсли;
	
	Если ДлинаЧисла > 0 Тогда
		ПараметрыЧисла	= Новый КвалификаторыЧисла(ДлинаЧисла, ТочностьЧисла);
	Иначе
		ПараметрыЧисла	= Неопределено;
	КонецЕсли;
	
	Если пЧастиДаты	<> Неопределено Тогда
		ПараметрыДаты	= Новый КвалификаторыДаты(пЧастиДаты);
	Иначе
		ПараметрыДаты	= Неопределено;
	КонецЕсли; 
	
	Если МассивТипов.Количество() > 0 Тогда
		Тип = Новый ОписаниеТипов(МассивТипов, ПараметрыЧисла, ПараметрыСтроки, ПараметрыДаты);
	Иначе
		Тип = Неопределено;
	КонецЕсли;
		
	СоответствиеТипов.Вставить(ИмяТипа, Тип);
	ЭДО_Кэш_Поместить("ТипыОбъектов", СоответствиеТипов);
	
	Возврат Тип;
	
КонецФункции

Функция КонтурEDI_ПолучитьСтруктуруДляСозданияТипа(ИмяТипа)

	СтруктураТипа = Новый Структура("ИмяТипа,ДлинаСтроки,ДлинаЧисла,ТочностьЧисла,ЧастиДаты");
	
	Если ИмяТипа = "GTIN" Тогда
		СтруктураТипа.ИмяТипа			= "Строка";
		СтруктураТипа.ДлинаСтроки		= 14;
		СтруктураТипа.ДлинаЧисла    	= 0;
		СтруктураТипа.ТочностьЧисла    	= 0;
		СтруктураТипа.ЧастиДаты    		= Неопределено;
	ИначеЕсли ИмяТипа = "Артикул" Тогда	
		СтруктураТипа.ИмяТипа			= "Строка";
		СтруктураТипа.ДлинаСтроки		= 36;
		СтруктураТипа.ДлинаЧисла    	= 0;
		СтруктураТипа.ТочностьЧисла    	= 0;
		СтруктураТипа.ЧастиДаты    		= Неопределено;
	ИначеЕсли ИмяТипа = "КоэффициентEDIВ1С" Тогда
		
		РазрядностьКоэффициентEDIВ1С = ОпределитьРазрядностьКоэффициентаEDIВ1С_КонтурEDI();
		
		СтруктураТипа.ИмяТипа			= "Число";
		СтруктураТипа.ДлинаСтроки		= 0;
		СтруктураТипа.ДлинаЧисла    	= РазрядностьКоэффициентEDIВ1С.ДлинаЧисла;
		СтруктураТипа.ТочностьЧисла    	= РазрядностьКоэффициентEDIВ1С.ТочностьЧисла;
		СтруктураТипа.ЧастиДаты    		= Неопределено;
	ИначеЕсли ИмяТипа = "ЧислоКоличество" 
		ИЛИ ИмяТипа = "Число" Тогда
		
		СтруктураТипа.ИмяТипа			= "Число";
		СтруктураТипа.ДлинаСтроки		= 0;
		СтруктураТипа.ДлинаЧисла    	= 12;
		СтруктураТипа.ТочностьЧисла    	= 3;
		СтруктураТипа.ЧастиДаты    		= Неопределено;
		
