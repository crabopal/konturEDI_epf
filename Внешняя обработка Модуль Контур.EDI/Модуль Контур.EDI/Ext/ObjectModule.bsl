Функция ИсправленияРелиза_КонтурEDI(НомерРелиза)
	
	СписокИсправлений = Новый Массив;
	Результат = СкачатьКонтентВерсии_КонтурEDI(НомерРелиза, ПеречисленияEDI_ТипыКонтентаСервисаОбновлений().release_patches);
	
	Если Результат.Успешно Тогда
		
		ТаблицаИсправлений = КонтурСтандарт_ЗначениеИзСтрокиJSON(Результат.ДвоичныеДанные);
		
		Для Каждого ТекИсправление Из ТаблицаИсправлений Цикл
				
			СписокИсправлений.Добавить(ВРег(ТекИсправление.patch_id));	
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат СписокИсправлений;
	
КонецФункции

Функция ИсправленияМодуляВыпущеныВРелиз_КонтурEDI(НомерРелиза)
	
	ИсправленияВыпущены = Ложь;      
	
	УстановленныеИсправления = УстановленныеИсправленияМодуля_КонтурEDI(); 
	
	Если УстановленныеИсправления.Количество() Тогда
		
		ИсправленияРелиза = ИсправленияРелиза_КонтурEDI(НомерРелиза);
		
		Если ИсправленияРелиза.Количество() Тогда
			
			ИсправленияВыпущены = Истина;
			
			Для Каждого НомерИсправления Из УстановленныеИсправления Цикл
				
				Если ИсправленияРелиза.Найти(ВРег(НомерИсправления)) = Неопределено Тогда
					ИсправленияВыпущены = Ложь;
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;	
		
	КонецЕсли;  
	
	Возврат ИсправленияВыпущены;	

КонецФункции

