// СЛУЖЕБНЫЙ ПРОГРАММНЫЙ ИНТЕРФЕЙС

Функция Аутентификатор_НовыйКодУстройства() Экспорт
	
	Возврат Аутентификатор_КодУстройства();

КонецФункции

Функция Аутентификатор_НоваяСессия(КодУстройства = Неопределено) Экспорт
	
	Если КодУстройства = Неопределено И КонфигурацияПровайдера.Тип <> Аутентификатор_ТипАутентификацииКлиентУчетныеДанные() Тогда
		ВызватьИсключение "Для данного типа аутентификации требуется код устройства";
	КонецЕсли;
	
	Результат = Аутентификатор_Токен(КодУстройства);	
	Если Аутентификатор_СессияВалидна(Результат) Тогда
		Аутентификатор_СохранитьСессию(Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает конфигурацию провайдера по умолчанию
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - см. МодельКонфигурацияПровайдера
//
Функция Аутентификатор_КонфигурацияПровайдераПоУмолчанию() Экспорт

	Результат = Аутентификатор_МодельКонфигурацияПровайдера();
	Результат.Хост = "https://identity.kontur.ru";
	Результат.Тип  = Аутентификатор_ТипАутентификацииКодУстройства();
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

// Возвращает данные компоненты
//
// Возвращаемое значение:
// - ДвоичныеДанные
//
Функция Аутентификатор_ДанныеКомпонентыГенератораQr() Экспорт
	
	Если Не Аутентификатор_КомпонентаГенератораQrЕсть() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПолучитьМакет(Аутентификатор_ИмяКомпонентыГенератораQr());
	
КонецФункции

// Если есть макет с компонентой для генерации Qr-кода, возвращает истина
//
// Возвращаемое значение:
// - Булево
//
Функция Аутентификатор_КомпонентаГенератораQrЕсть() Экспорт

	Возврат Метаданные().Макеты.Найти(Аутентификатор_ИмяКомпонентыГенератораQr()) <> Неопределено;
	
КонецФункции

