			ДобавитьОписаниеПоля(ТабОписания, "ДатаНакладной",				"deliveryNoteIdentificator.date");
		КонецЕсли;
		
		Если ТипСообщения = "RETINS" Тогда
			ДобавитьОписаниеПоля(ТабОписания, "ПричинаРешения", 			"physicalOrLogicalState.stateDescription");
			ДобавитьОписаниеПоля(ТабОписания, "ПричинаРешенияОтПокупателя",	"physicalOrLogicalState.stateDescriptionFromBuyer");
			ДобавитьОписаниеПоля(ТабОписания, "РешениеПоВозврату", 			"physicalOrLogicalState.state");
		КонецЕсли;
		
		ДобавитьОписаниеПоля(ТабОписания, 	"ТипЕдиницы", "typeOfUnit");
		
		Если ТипСообщения = "RECADV" Тогда			
			ДобавитьОписаниеПоля(ТабОписания,	"КоличествоКВозвратуИПричина", 	"toBeReturnedQuantity", "КоличествоКВозвратуИПричины", Истина);
			ДобавитьОписаниеПоля(ТабОписания,	"КоличествоСверхпоставки", 		"overshippedQuantity");
			ДобавитьОписаниеПоля(ТабОписания,	"КоличествоНедопоставки", 		"notDeliveredQuantity");
		КонецЕсли;
		
		ДобавитьОписаниеПоля(ТабОписания, "ДополнительнаяИнформация", "additionalInformation.keyValuePair", "КлючЗначениеТоваров", Истина);
		
		Если ТипСообщения = "COINVOIC" Тогда
			ДобавитьОписаниеПоля(ТабОписания, "КодыМаркировкиДо", "controlIdentificationMarksBefore", "КодыМаркировки", Истина);
			ДобавитьОписаниеПоля(ТабОписания, "КодыМаркировкиПосле", "controlIdentificationMarksAfter", "КодыМаркировки", Истина);
		Иначе
			ДобавитьОписаниеПоля(ТабОписания, "КодыМаркировки", "controlIdentificationMarks", "КодыМаркировки", Истина);
		КонецЕсли;
		
	ИначеЕсли ИмяСтруктуры = "ТочкиДоставкиDELFOR" Тогда 
		
		ДобавитьОписаниеПоля(ТабОписания,"ТорговаяТочкаGLN", 	"shipTo.gln");
		ДобавитьОписаниеПоля(ТабОписания,"Графики", 			"deliveryForecast", "ГрафикиDELFOR", Истина);
		
	ИначеЕсли ИмяСтруктуры = "ГрафикиDELFOR" Тогда 
		ДобавитьОписаниеПоля(ТабОписания,	"НомерГрафикаПоставок", 				"number");
		ДобавитьОписаниеПоля(ТабОписания,	"ИмяГрафикаПоставок", 					"name");
		ДобавитьОписаниеПоля(ТабОписания,	"СтатусГрафика", 						"status");
		ДобавитьОписаниеПоля(ТабОписания,	"НомерГрафикаЗаказов", 					"orderForecastIdentificator.number");
		ДобавитьОписаниеПоля(ТабОписания,	"ИмяГрафикаЗаказов", 					"orderForecastIdentificator.name");
		ДобавитьОписаниеПоля(ТабОписания,	"ДлительностьГрафика", 					"duration");
		ДобавитьОписаниеПоля(ТабОписания,	"НачалоДействияГрафика", 				"startDate");
		ДобавитьОписаниеПоля(ТабОписания,	"ОкончаниеДействияГрафика", 			"endDate");
		ДобавитьОписаниеПоля(ТабОписания,	"ДатаУдаления", 						"DeletionDate");
		ДобавитьОписаниеПоля(ТабОписания,	"ВремяОтЗаказаДоПоставки", 				"DaysForDelivery");
		ДобавитьОписаниеПоля(ТабОписания,	"ЗаказыПринимаютсяДо", 					"SendOrderToTime");
		ДобавитьОписаниеПоля(ТабОписания,	"ДатаЗаказа", 							"plannedDeliveryDate");
		ДобавитьОписаниеПоля(ТабОписания,	"ДатаПоставки", 						"PlannedOrderDate");
		ДобавитьОписаниеПоля(ТабОписания,	"МинимальнаяСуммаЗаказа", 				"MinimumNetAmount");
		ДобавитьОписаниеПоля(ТабОписания,	"МинимальныйВесЗаказаЕдИзм", 			"minimumNetWeight.unitOfMeasure");
		ДобавитьОписаниеПоля(ТабОписания,	"МинимальныйВесЗаказа", 				"minimumNetWeight");
		ДобавитьОписаниеПоля(ТабОписания,	"МинимальноеКолличествоПаллетЕдИзм", 	"minimumNumberOfPalletPlaces.unitOfMeasure");
		ДобавитьОписаниеПоля(ТабОписания,	"МинимальноеКолличествоПаллет", 		"minimumNumberOfPalletPlaces");
		ДобавитьОписаниеПоля(ТабОписания,	"ВремяПоставкиС", 						"transportation.vehicleArrivalFromTime");
		ДобавитьОписаниеПоля(ТабОписания,	"ВремяПоставкиДо", 						"transportation.vehicleArrivalToTime");
		ДобавитьОписаниеПоля(ТабОписания,	"РегулярностьВНеделях", 				"frequencyOfDelivery.Weeks");
		ДобавитьОписаниеПоля(ТабОписания,	"РегулярностьВДнях", 					"frequencyOfDelivery.Days");			

	ИначеЕсли ИмяСтруктуры = "Контракты" Тогда 
		
		ДобавитьОписаниеПоля(ТабОписания,	"НомерКонтракта",	"number");
		ДобавитьОписаниеПоля(ТабОписания,	"ДатаКонтракта",	"date");
		
	КонецЕсли;
	
	// Особенности сообщения, созданные в событии ПМ "ДобавитьОсобенностиСообщений"
	ДобавитьМаппингОсобенностей(ТабОписания, ТипСообщения, ИмяДокумента, ИмяСтруктуры);
	
	Если ДлительнаяОперация = Истина Тогда
		
		СоответствиеПутей = Новый Соответствие;
		Для Каждого Стр Из ТабОписания Цикл
			СписокСлов = EDI_РазложитьСтрокуВМассивСлов(Стр.Путь,".");
			ТекПутьПодстроки = "";
			Для Каждого Эл Из СписокСлов Цикл
				Если ТекПутьПодстроки = "" Тогда
					ТекПутьПодстроки = Эл;
				Иначе
					ТекПутьПодстроки = ТекПутьПодстроки+"."+Эл;
				КонецЕсли;
				Если СоответствиеПутей.Получить(ТекПутьПодстроки)=Неопределено Тогда
					СоответствиеПутей.Вставить(ТекПутьПодстроки,Истина);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		СтруктураКэша = Новый Структура("ТабОписания,СоответствиеПутей",ТабОписания,СоответствиеПутей);
		
		КэшМаппингаСообщения.Вставить(ИмяСтруктуры, СтруктураКэша);
		
	КонецЕсли;
		
	Возврат ТабОписания;
	
КонецФункции

Процедура ДобавитьМаппингОсобенностей(ТабОписания, ТипСообщения, ИмяДокумента ="", ИмяСтруктуры = "")
	
	Для каждого ОсобенностьСообщения Из ОсобенностиСообщений Цикл
		
		Если НЕ ОсобенностьСообщения.ТипыСообщения = "" 
			И Найти(ОсобенностьСообщения.ТипыСообщения, ТипСообщения) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ОсобенностьСообщения.Направление = "" 
			И Найти(Нрег(ОсобенностьСообщения.Направление), "входящее") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ОсобенностьСообщения.Ревенство1СEDI = Неопределено
			ИЛИ Врег(ОсобенностьСообщения.Ревенство1СEDI) = "1С" Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ОсобенностьСообщения.Путьxml) Тогда
			Продолжить;
		КонецЕсли;
		
		ЭтоРеквизитТоваров = ЭтоОсобенностьТоваров(ОсобенностьСообщения);
		
		// проверим существование такого поля в метаданных
		Если (ИмяСтруктуры = ОсобенностьСообщения.ИмяТаблицы
			ИЛИ (ЭтоРеквизитТоваров И ИмяСтруктуры = "Товары")
			ИЛИ (НЕ ЭтоРеквизитТоваров И ОсобенностьСообщения.ИмяТаблицы = Неопределено))
			И НЕ ТабОписания.Найти(ОсобенностьСообщения.Идентификатор, "ИмяПоля") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяВложеннойСтруктуры = ?(ОсобенностьСообщения.ЭтоСтруктура, ОсобенностьСообщения.ИмяСтруктуры, Неопределено);
		
		ЭтоСписок = 
		ЭтоОсобенностьСложногоТипа(ОсобенностьСообщения.ТипЗначенияEDI) 
		И НЕ ОсобенностьСообщения.ТипЗначенияEDI = "Структура";  
		
		НужноДобавитьОсобенность = Ложь;
		
		Если ЭтоРеквизитТоваров 
			И ИмяСтруктуры = "Товары" Тогда
			
			НужноДобавитьОсобенность = Истина;
			ПутьXmlОсобенности = СтрЗаменить(ОсобенностьСообщения.Путьxml, "lineItem.", "");
			
		ИначеЕсли НЕ ЭтоРеквизитТоваров 
			И ИмяСтруктуры = "Документ" 
			И ОсобенностьСообщения.ИмяТаблицы = Неопределено Тогда
			
			НужноДобавитьОсобенность = Истина;
			ПутьXmlОсобенности = ИмяДокумента + "." + ОсобенностьСообщения.Путьxml;
			
		ИначеЕсли НЕ ЭтоРеквизитТоваров
			И ЗначениеЗаполнено(ИмяСтруктуры)
			И ОсобенностьСообщения.ИмяТаблицы = ИмяСтруктуры Тогда
			
			НужноДобавитьОсобенность = Истина;
			ПутьXmlОсобенности = ОсобенностьСообщения.Путьxml;
			
		КонецЕсли;
		
		Если НужноДобавитьОсобенность Тогда
			
			ДобавитьОписаниеПоля(
			ТабОписания, 
			ОсобенностьСообщения.Идентификатор, 		
			ПутьXmlОсобенности, 		
			ИмяВложеннойСтруктуры, 
			ЭтоСписок,
			ОсобенностьСообщения.ТипЗначенияEDI);
									
		КонецЕсли;
				
	КонецЦикла;
	
КонецПроцедуры


