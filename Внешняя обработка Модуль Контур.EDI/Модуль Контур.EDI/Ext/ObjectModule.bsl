		СтруктураТипа.ДлинаЧисла    	= 0;
		СтруктураТипа.ТочностьЧисла    	= 0;
		СтруктураТипа.ЧастиДаты    		= Неопределено;
	ИначеЕсли ИмяТипа = "Массив" Тогда
		СтруктураТипа.ИмяТипа			= "Массив";
		СтруктураТипа.ДлинаСтроки		= 0;
		СтруктураТипа.ДлинаЧисла    	= 0;
		СтруктураТипа.ТочностьЧисла    	= 0;
		СтруктураТипа.ЧастиДаты    		= Неопределено;
	ИначеЕсли ЗначениеЗаполнено(ИмяТипа) 
		И НЕ ПолучитьТипЗначенияОбъекта(ИмяТипа) = Неопределено Тогда
		// здесь типы объектов EDI
		СтруктураТипа.ИмяТипа			= ПолучитьТипЗначенияОбъекта(ИмяТипа);
		СтруктураТипа.ДлинаСтроки		= 0;
