		ДобавитьОписаниеПоля(ТабОписания,"Товары",				ИмяДокумента+".lineItems.lineItem"		, "Товары", Истина);
				
	ИначеЕсли ИмяСтруктуры = "ОтветственноеЛицо" Тогда
		
		ДобавитьОписаниеПоля(ТабОписания,"ФИО", 				"name");
		ДобавитьОписаниеПоля(ТабОписания,"Должность", 			"function");
		ДобавитьОписаниеПоля(ТабОписания,"Телефон", 			"phone");
