// КОД УСТРОЙСТВА

Функция Аутентификатор_КодУстройства() Экспорт
	
	ПараметрыЗапроса = Аутентификатор_ДевайКодСформироватьПараметры();
	Запрос = Аутентификатор_ЗапросКодУстройства(ПараметрыЗапроса);
	Результат = КлиентHTTP_Post(Запрос.Адрес, Запрос.Параметры,, СессияHttpЛок);
	Ответ = КлиентHTTP_КакJson(Результат);
	
	Если Ответ.Получить("error") <> Неопределено Тогда
		ВызватьИсключение КонтурСтандарт_СтрШаблон_("error: %1, TraceId: %2", Ответ.Получить("error"),
			Результат.Заголовки.Получить("X-Kontur-Trace-Id"));
	КонецЕсли;
	
	Результат = Аутентификатор_РазобратьОтветКодУстройства(Ответ);
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

Функция Аутентификатор_ДевайКодСформироватьПараметры() 
	
	Результат = Новый Соответствие;
	Результат.Вставить("client_id", КонфигурацияПриложения.Имя);
	Результат.Вставить("client_secret", КонфигурацияПриложения.Ключ);
	Результат.Вставить("scope", КонфигурацияПриложения.Разрешения);
	
	Возврат Результат;
	
КонецФункции

Функция Аутентификатор_РазобратьОтветКодУстройства(Ответ)
	
	Результат = Аутентификатор_МодельОтветКодУстройства();
	
	Результат.Код = Ответ.Получить("device_code");
	Результат.КодПользователя = Ответ.Получить("user_code");
	Результат.Ссылка = Ответ.Получить("verification_uri");
	Результат.СсылкаАвторизации = Ответ.Получить("verification_uri_complete");
	Результат.Интервал = Ответ.Получить("interval");
	Результат.ВремяЖизни = Ответ.Получить("expires_in");
	
	ВМиллисекундах = 1000;	
	Если ЗначениеЗаполнено(Результат.ВремяЖизни) Тогда
		Результат.УниверсальнаяДатаОкончания = ТекущаяУниверсальнаяДата() + Число(Результат.ВремяЖизни);
		Результат.УниверсальнаяДатаОкончанияМС = (Дата(1, 1, 1) - Результат.УниверсальнаяДатаОкончания) 
			* ВМиллисекундах * -1; 
	Иначе
		Результат.УниверсальнаяДатаОкончания = Дата(1, 1, 1);
		Результат.УниверсальнаяДатаОкончанияМС = 0;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// ТОКЕН ДОСТУПА

Функция Аутентификатор_Токен(КодУстройства)
	
	ПараметрыЗапроса = Аутентификатор_ТокенСформироватьПараметры(КодУстройства); 
	Запрос = Аутентификатор_ЗапросТокен(ПараметрыЗапроса);
	
	Результат = КлиентHTTP_Post(Запрос.Адрес, Запрос.Параметры,, СессияHttpЛок);
	Ответ = Неопределено;
	Если Результат.КодСостояния >= КлиентHTTP_КодыСостоянияHTTP().НеверныйЗапрос_400 Тогда
		След = Результат.Заголовки.Получить("X-Kontur-Trace-Id");
		Попытка
			Ответ = КлиентHTTP_КакJson(Результат);
		Исключение
			ВызватьИсключение КонтурСтандарт_СтрШаблон_("error: %1, TraceId: %2", "Неизвестная ошибка", След);	
		КонецПопытки;
		Если Аутентификатор_ОтветСОшибкой(Ответ) Тогда
			ВызватьИсключение КонтурСтандарт_СтрШаблон_("error: %1, TraceId: %2", Ответ.Получить("error"), След);
		КонецЕсли;
	КонецЕсли;
	
	Если Ответ = Неопределено Тогда
		Ответ = КлиентHTTP_КакJson(Результат);
	КонецЕсли;
	Результат = Аутентификатор_ТокенРазобратьОтвет(Ответ);
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

Функция Аутентификатор_ТокенСформироватьПараметры(КодУстройства)
	
	Результат = Новый Соответствие;
	
	Результат.Вставить("grant_type", КонфигурацияПровайдера.Тип);
	Результат.Вставить("client_id", КонфигурацияПриложения.Имя);
	Результат.Вставить("client_secret", КонфигурацияПриложения.Ключ);
	Результат.Вставить("scope", КонфигурацияПриложения.Разрешения);
	Результат.Вставить("device_code", КодУстройства);
	
	Аутентификатор_УдалитьПустые(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция Аутентификатор_ТокенРазобратьОтвет(Ответ)
	
	Результат = Аутентификатор_МодельОтветТокен();
	
	ДанныеТокена = Аутентификатор_КакJwt(Ответ.Получить("id_token"));
	
	Результат.ТокенДоступа = Ответ.Получить("access_token");
	Результат.ТокенОбновления = Ответ.Получить("refresh_token");
	Результат.ВремяЖизни = Ответ.Получить("expires_in");
	Результат.Тип = Ответ.Получить("token_type");
	Результат.ПортальныйИд = ДанныеТокена.Тело.Получить("sub");
	Результат.Имя = ДанныеТокена.Тело.Получить("given_name");
	Результат.Фамилия = ДанныеТокена.Тело.Получить("family_name");
	Результат.Отчество = ДанныеТокена.Тело.Получить("middle_name");
	Результат.ФИО = ДанныеТокена.Тело.Получить("name");
	Результат.Телефон = ДанныеТокена.Тело.Получить("phone_number");
	Результат.Почта = ДанныеТокена.Тело.Получить("email");
	
	ВМиллисекундах = 1000;	
	Если ЗначениеЗаполнено(Результат.ВремяЖизни) Тогда
		Результат.УниверсальнаяДатаОкончания = ТекущаяУниверсальнаяДата() + Число(Результат.ВремяЖизни);
		Результат.УниверсальнаяДатаОкончанияМС = (Дата(1, 1, 1) - Результат.УниверсальнаяДатаОкончания) 
			* ВМиллисекундах * -1; 
	Иначе
		Результат.УниверсальнаяДатаОкончания = Дата(1, 1, 1);
		Результат.УниверсальнаяДатаОкончанияМС = 0;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

Функция Аутентификатор_ВалидацияСессии(Знач Сессия)
	
	Если ТипЗнч(Сессия) = Тип("Структура") Тогда
		Сессия = Новый ФиксированнаяСтруктура(Сессия);
	КонецЕсли;

	Если Аутентификатор_СессияВалидна(Сессия) = Ложь Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	Если Аутентификатор_ТребуетсяОбновитьСессию(Сессия) Тогда
		Результат = Аутентификатор_ОбновитьСессию(Сессия);
	ИначеЕсли Аутентификатор_СессияЗавершена(Сессия) Или Аутентификатор_ТокенОтозван(Сессия.ТокенДоступа) Тогда
		Результат = Неопределено;
	Иначе
		Результат = Сессия;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция Аутентификатор_ТребуетсяОбновитьСессию(Сессия)
	
	ОбновитьСессию = Аутентификатор_СессияЗавершена(Сессия) И ЗначениеЗаполнено(Сессия.ТокенОбновления);
	
	Если КонфигурацияПриложения.ПроверятьАктуальностьТокена Тогда
		ТокенОтозван = Аутентификатор_ТокенОтозван(Сессия.ТокенДоступа);
	Иначе
		ТокенОтозван = Ложь;
	КонецЕсли;
	
	Возврат ОбновитьСессию И Не ТокенОтозван;
	
КонецФункции

Функция Аутентификатор_СессияЗавершена(Сессия)

	Возврат  ТекущаяУниверсальнаяДата() >= Сессия.УниверсальнаяДатаОкончания;
	
КонецФункции

// ТОКЕН ОБНОВЛЕНИЯ

Функция Аутентификатор_ОбновитьСессиюТокеном(Сессия)
	
	ПараметрыЗапроса = Аутентификатор_ОбновитьСессиюСформироватьПараметры(Сессия.ТокенОбновления);
	Запрос = Аутентификатор_ЗапросТокен(ПараметрыЗапроса);
	
	Результат = КлиентHTTP_Post(Запрос.Адрес, Запрос.Параметры,, СессияHttpЛок);
	Ответ = КлиентHTTP_КакJson(Результат);
	
	Если Аутентификатор_ОтветСОшибкой(Ответ) Тогда
		ВызватьИсключение КонтурСтандарт_СтрШаблон_("error: %1, TraceId: %2", Ответ.Получить("error"), 
			Результат.Заголовки.Получить("X-Kontur-Trace-Id"));
	КонецЕсли;
	
	Результат = Аутентификатор_ТокенРазобратьОтвет(Ответ);
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

Функция Аутентификатор_ОбновитьСессиюСформироватьПараметры(ТокенОбновления)
	
	Результат = Новый Соответствие;
	
	Результат.Вставить("grant_type", "refresh_token");
	Результат.Вставить("client_id", КонфигурацияПриложения.Имя);
	Результат.Вставить("client_secret", КонфигурацияПриложения.Ключ);	
	Результат.Вставить("refresh_token", ТокенОбновления);
	
	Возврат Результат;
	
КонецФункции

// ПРОВЕРИТЬ ТОКЕН

Функция Аутентификатор_ТокенОтозван(Токен)
	
	Если КонфигурацияПровайдера.Тип = Аутентификатор_ТипАутентификацииКодУстройства() Тогда
		Результат = ЗначениеЗаполнено(Аутентификатор_ДанныеПользователя(Токен).ПортальныйИд) = Ложь;
	ИначеЕсли КонфигурацияПровайдера.Тип = Аутентификатор_ТипАутентификацииКлиентУчетныеДанные() Тогда
		Попытка
			Результат = Не Аутентификатор_ДанныеТокена(Токен).Активный;	
		Исключение
			Результат = Истина;
		КонецПопытки;
	Иначе
		ВызватьИсключение КонтурСтандарт_СтрШаблон_("Не ожидаемый тип конфигурации провайдера: %1", КонфигурацияПровайдера.Тип);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// ДАННЫЕ ПОЛЬЗОВАТЕЛЯ

Функция Аутентификатор_ДанныеПользователя(Токен)

	Запрос = Аутентификатор_ЗапросДанныеПользователя(Токен);	
	
	ДополнительныеПараметры = Новый Структура("Заголовки", Запрос.Заголовки);
	
	Результат = КлиентHTTP_Post(Запрос.Адрес, Запрос.Параметры, ДополнительныеПараметры, СессияHttpЛок);
	Если Результат.КодСостояния >= КлиентHTTP_КодыСостоянияHTTP().НеверныйЗапрос_400 Тогда
		Возврат Аутентификатор_МодельОтветДанныеПользователя();
	КонецЕсли;
	
	Ответ = КлиентHTTP_КакJson(Результат);
	
	Возврат Аутентификатор_ДанныеПользователяРазобратьОтвет(Ответ);
	
КонецФункции

Функция Аутентификатор_ЗапросДанныеПользователя(ТокенДоступа)
	
	Результат = Аутентификатор_МодельЗапрос();
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Заголовки.Вставить("Authorization", КонтурСтандарт_СтрШаблон_("Bearer %1", ТокенДоступа));
		
	Результат.Хост = КонфигурацияПровайдера.Хост;
	Результат.Ресурс = "/connect/userinfo";
	Результат.Адрес = КонтурСтандарт_СтрШаблон_("%1%2", Результат.Хост, Результат.Ресурс);
	Результат.Метод = "POST";
	Результат.Заголовки = Заголовки;
	
	Возврат Результат;
	
КонецФункции

Функция Аутентификатор_ДанныеПользователяРазобратьОтвет(Ответ)
	
	Результат = Аутентификатор_МодельОтветДанныеПользователя();
	Результат.ПортальныйИд = Ответ.Получить("sub");
	Результат.Имя = Ответ.Получить("name");
	Результат.Почта = Ответ.Получить("email");
	
	Возврат Результат;
	
КонецФункции

// АНАЛИЗ ТОКЕНА

Функция Аутентификатор_ДанныеТокена(Токен)

	ПараметрыЗапроса = Аутентификатор_ДанныеТокенаСформироватьПараметры(Токен);
	Запрос = Аутентификатор_ЗапросДанныеТокена(ПараметрыЗапроса);	

	ДополнительныеПараметры = Новый Структура("Заголовки", Запрос.Заголовки);
	
	Результат = КлиентHTTP_Post(Запрос.Адрес, Запрос.Параметры, ДополнительныеПараметры, СессияHttpЛок);
	Если Результат.КодСостояния > КлиентHTTP_КодыСостоянияHTTP().НеАвторизован_401 Тогда
		Возврат "Не удалось получить данные токена";
	КонецЕсли;
	
	Ответ = КлиентHTTP_КакJson(Результат);
	
	Возврат Аутентификатор_ДанныеТокенаРазобратьОтвет(Ответ);
	
КонецФункции

Функция Аутентификатор_ДанныеТокенаСформироватьПараметры(Токен)

	Результат = Новый Соответствие;
		
	Результат.Вставить("token", Токен);
	
	Возврат Результат;
	
КонецФункции

Функция Аутентификатор_ДанныеТокенаРазобратьОтвет(Ответ)
	
	Результат = Аутентификатор_МодельОтветДанныеТокена();
	
	Результат.Активный = Ответ.Получить("active");
	Результат.ПортальныйИд = Ответ.Получить("sub");
	Результат.Ресурсы = Ответ.Получить("aud");
	Результат.Разрешения = Ответ.Получить("scope");
	Результат.ИмяПриложения = Ответ.Получить("client_id");
	Результат.Провайдер = Ответ.Получить("iss");
	
	Год = 1970;
	
	Если Ответ.Получить("auth_time") <> Неопределено Тогда
		Результат.УниверсальнаяДатаСоздания = Дата(Год, 1, 1, 1, 0, 0) + Ответ.Получить("auth_time");
	КонецЕсли;
	Если Ответ.Получить("nbf") <> Неопределено Тогда
		Результат.УниверсальнаяДатаВыдачи = Дата(Год, 1, 1, 1, 0, 0) + Ответ.Получить("nbf");
	КонецЕсли;
	Если Ответ.Получить("exp") <> Неопределено Тогда
		Результат.УниверсальнаяДатаОкончания = Дата(Год, 1, 1, 1, 0, 0) + Ответ.Получить("exp");
	КонецЕсли;
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

// ОТОЗВАТЬ ТОКЕН

Процедура Аутентификатор_ОтозватьТокен(Сессия)
		
	// Токен доступа
	
	ПараметрыЗапроса = Аутентификатор_ОтозватьТокенСформироватьПараметры(Сессия.ТокенДоступа, "access_token");
	Запрос = Аутентификатор_ЗапросОтозватьТокен(ПараметрыЗапроса);

	ДополнительныеПараметры = Новый Структура("Заголовки", Запрос.Заголовки);
	
	Результат = КлиентHTTP_Post(Запрос.Адрес, Запрос.Параметры, ДополнительныеПараметры, СессияHttpЛок);
	
	// Токен обновления
	
	Если ЗначениеЗаполнено(Сессия.ТокенОбновления) Тогда
		
		ПараметрыЗапроса = Аутентификатор_ОтозватьТокенСформироватьПараметры(Сессия.ТокенОбновления, "refresh_token");
		Запрос = Аутентификатор_ЗапросОтозватьТокен(ПараметрыЗапроса);
		
		ДополнительныеПараметры = Новый Структура("Заголовки", Запрос.Заголовки);
		
		Результат = КлиентHTTP_Post(Запрос.Адрес, Запрос.Параметры, ДополнительныеПараметры, СессияHttpЛок);
		
	КонецЕсли;

КонецПроцедуры

Функция Аутентификатор_ОтозватьТокенСформироватьПараметры(Токен, Тип)

	Результат = Новый Соответствие;
	
	Результат.Вставить("token_type_hint", Тип);	
	Результат.Вставить("token", Токен);
	
	Возврат Результат;
	
КонецФункции

// ВЫХОД

Функция Аутентификатор_Выйти(Сессия)
	
	Если Не ЗначениеЗаполнено(Сессия.ПортальныйИд) Тогда
		ВызватьИсключение "Для отзыва всех токенов необходим портальный идентификатор пользователя";
	КонецЕсли;
	
	Запрос = Аутентификатор_ЗапросВыйти(Сессия);	
	ДополнительныеПараметры = Новый Структура("Заголовки", Запрос.Заголовки);
	
	Результат = КлиентHTTP_Post(Запрос.Адрес,, ДополнительныеПараметры, СессияHttpЛок);
	Успех = Результат.КодСостояния < КлиентHTTP_КодыСостоянияHTTP().НеверныйЗапрос_400;
	
	Если Успех Тогда
		Аутентификатор_ХранилищеСессий().ХранилищеСессий_УдалитьСессию(ОтборСессий);
	КонецЕсли;
	
	Возврат Успех;
	
КонецФункции

// ДРУГОЕ

Функция Аутентификатор_ПолучитьСессиюИзХранилища()

	Выборка = Аутентификатор_ХранилищеСессий().ХранилищеСессий_ВыбратьСессии(ОтборСессий);	
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Сессия = Аутентификатор_МодельОтветТокен();
	ЗаполнитьЗначенияСвойств(Сессия, Выборка);
	
	Сессия = Новый ФиксированнаяСтруктура(Сессия);	
	Возврат Аутентификатор_ВалидацияСессии(Сессия);
	
КонецФункции

Функция Аутентификатор_КакJwt(Знач Токен)  

	Токен = СтрЗаменить(Токен, "-", "+");
	Токен = СтрЗаменить(Токен, "_", "/");

	МассивДанных = КонтурСтандарт_СтрРазделить_(Токен, ".");
	Результат = Новый Структура;
	Результат.Вставить("Заголовок", Новый Соответствие);
	Результат.Вставить("Тело", Новый Соответствие);
	
	КоличествоЭлементовТокена = 3;
	
	Если МассивДанных.Количество() <> КоличествоЭлементовТокена Тогда
		Возврат Результат;
	КонецЕсли;
		
	Результат.Заголовок = КлиентHTTP_JsonВОбъект(Base64Значение(МассивДанных[0] + Аутентификатор_Base64Постфикс(МассивДанных[0]))); 
	Результат.Тело = КлиентHTTP_JsonВОбъект(Base64Значение(МассивДанных[1] + Аутентификатор_Base64Постфикс(МассивДанных[1])));
	
	Возврат Результат;
	
КонецФункции

Функция Аутентификатор_Base64Постфикс(СтрокаBase64)
	
	Результат = "";
	КоличествоСимволов = 4;
	КоличествоДополнительныхСимволов = КоличествоСимволов - (СтрДлина(СтрокаBase64) % КоличествоСимволов);

	Пока КоличествоДополнительныхСимволов > 0 Цикл
		
		Результат = Результат + "=";
		КоличествоДополнительныхСимволов = КоличествоДополнительныхСимволов - 1;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Аутентификатор_ОтветСОшибкой(Ответ)
	
	Возврат Ответ.Получить("error") <> Неопределено И Ответ.Получить("error") <> "authorization_pending";
	
КонецФункции

Процедура Аутентификатор_ПроверитьКонфигурациюПриложения(Значение)
		
	Результат = Аутентификатор_ПроверитьКоллекцию(Аутентификатор_МодельКонфигурацияПриложения(), Значение);
	
	Если Результат.Количество() Тогда
		Ошибки = КонтурСтандарт_СтрСоединить_(Результат, ", ");
		Сообщение = КонтурСтандарт_СтрШаблон_("При проверке конфигурации приложения обнаружены ошибки: %1", Ошибки);
		ВызватьИсключение Сообщение;
	КонецЕсли;
	
КонецПроцедуры

Процедура Аутентификатор_ПроверитьКонфигурациюПровайдера(Значение)
	
	Результат = Аутентификатор_ПроверитьКоллекцию(Аутентификатор_МодельКонфигурацияПровайдера(), Значение);
	
	Если Результат.Количество() Тогда
		Ошибки = КонтурСтандарт_СтрСоединить_(Результат, ", ");
		Сообщение = КонтурСтандарт_СтрШаблон_("При проверке конфигурации провайдера обнаружены ошибки: %1", Ошибки);
		ВызватьИсключение Сообщение;
	КонецЕсли;
	
КонецПроцедуры

Функция Аутентификатор_ПроверитьКоллекцию(Модель, Коллекция)
	
	Ошибки = Новый Массив;
	Для Каждого Элемент Из Модель Цикл
		Если Элемент.Ключ = "Опции" Тогда
			Продолжить;
		КонецЕсли;
		Если Коллекция.Свойство(Элемент.Ключ) = Ложь Тогда
				Ошибки.Добавить(КонтурСтандарт_СтрШаблон_("Не найден ключ: %1", Элемент.Ключ));
				Продолжить;
		КонецЕсли;
		Если Аутентификатор_ЗначениеКоллекцииЗаполнено(Коллекция[Элемент.Ключ]) = Ложь Тогда
				Ошибки.Добавить(КонтурСтандарт_СтрШаблон_("Пустое значение ключа: %1", Элемент.Ключ));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ошибки;
	
КонецФункции

Функция Аутентификатор_ЗначениеКоллекцииЗаполнено(Значение)
	
	ТипЗнч = ТипЗнч(Значение);
	
	Если ТипЗнч = Тип("Строка") Тогда
		Результат = Значение <> "";
	ИначеЕсли ТипЗнч = Тип("Массив") Тогда
		Результат = Значение.Количество() > 0;
	ИначеЕсли Значение = Неопределено Тогда
		Результат = Ложь;
	ИначеЕсли ТипЗнч = Тип("Булево") Или ТипЗнч = Тип("Число") Тогда
		Результат = Истина;
	Иначе
		ВызватьИсключение "Неопределенный ключ конфигурации";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает контракт опций конифгурации приложения
//
// Возвращаемое значение:
//	- Структура:
// Ссылка - Строка - Наименование опциональной гиперссылки на основной форме. Необязательный
// ПредставлениеСсылки - Строка - Адрес перехода по опциональной ссылке на форме. Необязательный
//
Функция Аутентификатор_МодельОпции()

	Результат = Новый Структура;
	Результат.Вставить("Ссылка");
	Результат.Вставить("ПредставлениеСсылки");
	
	Возврат Результат;
	
КонецФункции

Функция Аутентификатор_УдалитьПустые(Коллекция)

	Пустые = Новый Массив;
	Для Каждого Элемент Из Коллекция Цикл
		Если Не ЗначениеЗаполнено(Элемент.Значение) Тогда
			Пустые.Добавить(Элемент.Ключ);
		КонецЕсли;
	КонецЦикла;    
	
	Для Каждого Элемент Из Пустые Цикл
		Коллекция.Удалить(Элемент);
	КонецЦикла; 
	
	Возврат Коллекция;
	
КонецФункции

Функция Аутентификатор_Авторизация(Тип, Значение)

	Возврат  КонтурСтандарт_СтрШаблон_("%1 %2", Тип, Значение);
	
КонецФункции

Функция Аутентификатор_АвторизацияБазовая()
	
	Ключ = КонтурСтандарт_СтрШаблон_("%1:%2", КонфигурацияПриложения.Имя, КонфигурацияПриложения.Ключ);
	Значение = Base64Строка(КонтурСтандарт_ПолучитьДвоичныеДанныеИзСтроки_(Ключ));
	Значение = СтрЗаменить(Значение, Символы.ПС, "");
	Значение = СтрЗаменить(Значение, Символы.ВК, "");
	
	Возврат Аутентификатор_Авторизация("Basic", Значение);
	
КонецФункции

Функция Аутентификатор_СессияВалидна(Сессия)
	
	Возврат ТипЗнч(Сессия) = Тип("ФиксированнаяСтруктура")
		И Сессия.Свойство("ТокенДоступа")
		И Не ПустаяСтрока(Сессия.ТокенДоступа)
		И Сессия.Свойство("Тип")
		И ЗначениеЗаполнено(Сессия.Тип);
		
КонецФункции

Функция Аутентификатор_СортироватьРазрешения(Разрешения)
	
	Массив = КонтурСтандарт_СтрРазделить_(Разрешения, " ");
	
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(Массив);
	Список.СортироватьПоЗначению(НаправлениеСортировки.Возр);
	
	Возврат КонтурСтандарт_СтрСоединить_(Список.ВыгрузитьЗначения(), " "); 
	
КонецФункции

Функция Аутентификатор_ВерсияСовместимостиБольшеРавно(ВерсияСтрокой) Экспорт
	
		ВерсияСовместимостиБольшеРавно = Истина;
		Если Метаданные.РежимСовместимости = Неопределено Или Метаданные.РежимСовместимости
			= Метаданные.СвойстваОбъектов.РежимСовместимости.НеИспользовать Тогда
			// BSLLS:UseSystemInformation-off
			СистемнаяИнфо = Новый СистемнаяИнформация;
			// BSLLS:UseSystemInformation-on
			Результат = КонтурСтандарт_СравнитьВерсии(СистемнаяИнфо.ВерсияПриложения, ВерсияСтрокой) >= 0;
		Иначе
			РежимСовместимости = Строка(Метаданные.РежимСовместимости);
			РежимСовместимости = СтрЗаменить(РежимСовместимости, "Версия", "");
			РежимСовместимости = СтрЗаменить(РежимСовместимости, "Version", "");
			РежимСовместимости = СтрЗаменить(РежимСовместимости, "_", ".");
			Результат = КонтурСтандарт_СравнитьВерсии(РежимСовместимости, ВерсияСтрокой) >= 0;
		КонецЕсли;

	Возврат Результат;
	
КонецФункции

Функция Аутентификатор_ТипАутентификацииКодУстройства()

	Возврат "urn:ietf:params:oauth:grant-type:device_code";
	
КонецФункции

