Функция КлиентСервисОбновлений_ТипыОтветаСервиса()   
	
	Структура = Новый Структура;
	
	Структура.Вставить("BASE64"	,	"BASE64");
	Структура.Вставить("BIN"	,	"BIN"	);
	Структура.Вставить("JSON"	,	"JSON"	);
