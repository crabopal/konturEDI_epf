	xmlЗаполнитьЗначениеXDTO(firmBooking, 		"totalPackagesQuantity", 	Сообщение.КоличествоУпаковок);	
	
	ВыгружатьТолькоОрганизацию = Истина;

	Если ЗначениеЗаполнено(Сообщение.ПродавецEDI.GLN) Тогда
		xmlСоздатьДочернийЭлементXDTO(firmBooking,		"seller");
		xmlЗаписатьContractor_XDTO(firmBooking.seller,	"seller", 	Сообщение.ПродавецEDI, 	ВыгружатьТолькоОрганизацию);
	КонецЕсли;

	Если ЗначениеЗаполнено(Сообщение.ПокупательEDI.GLN) Тогда
		xmlСоздатьДочернийЭлементXDTO(firmBooking,		"buyer");
		xmlЗаписатьContractor_XDTO(firmBooking.buyer,	"buyer", 	Сообщение.ПокупательEDI, 	ВыгружатьТолькоОрганизацию);
	КонецЕсли;	

	Если ЗначениеЗаполнено(Сообщение.ПеревозчикEDI.GLN) Тогда
		xmlСоздатьДочернийЭлементXDTO(firmBooking,		"carrier");
		xmlЗаписатьContractor_XDTO(firmBooking.carrier,	"carrier", 	Сообщение.ПеревозчикEDI, 	ВыгружатьТолькоОрганизацию);
	КонецЕсли;
	
	deliveryInfo = xmlСоздатьДочернийЭлементXDTO(firmBooking, "deliveryInfo");
	
	Если ЗначениеЗаполнено(Сообщение.ГрузоотправительEDI.GLN)
		ИЛИ ЗначениеЗаполнено(Сообщение.ТарифНаПеревозку) Тогда
		
		despatchParty = xmlСоздатьДочернийЭлементXDTO(deliveryInfo,		"despatchParty");
		
		Если ЗначениеЗаполнено(Сообщение.ГрузоотправительEDI.GLN) Тогда
			xmlЗаписатьContractor_XDTO(despatchParty,	"despatchParty", 	Сообщение.ГрузоотправительEDI, 	ВыгружатьТолькоОрганизацию);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Сообщение.ТарифНаПеревозку) Тогда
			tariffInfo = xmlСоздатьДочернийЭлементXDTO(despatchParty, "tariffInfo");
			xmlЗаполнитьЗначениеXDTO(tariffInfo, "typeOfTariff", 	Сообщение.ТарифНаПеревозку.ТипТарифа);	
			xmlЗаполнитьЗначениеXDTO(tariffInfo, "tariffRegion", 	Сообщение.ТарифНаПеревозку.РегионТарифа);	
			xmlЗаполнитьЗначениеXDTO(tariffInfo, "plannedAmount", 	Сообщение.ТарифНаПеревозку.ПлановаяСтоимость);	
		КонецЕсли;
		
	КонецЕсли;

	transportation = xmlСоздатьДочернийЭлементXDTO(deliveryInfo, "transportation");
	
	xmlЗаполнитьЗначениеXDTO(transportation, "transportMode", 			Сообщение.ИнформацияОТранспорте.РежимПеревозки);	
	xmlЗаполнитьЗначениеXDTO(transportation, "tailLift", 				Сообщение.ИнформацияОТранспорте.НаличиеГидроборта);	
	xmlЗаполнитьЗначениеXDTO(transportation, "truckCapacity", 			Сообщение.ИнформацияОТранспорте.Грузоподъемность);	
	xmlЗаполнитьЗначениеXDTO(transportation, "numberOfPalletPlaces", 	Сообщение.ИнформацияОТранспорте.КоличествоПаллетоМест);	
	xmlЗаполнитьЗначениеXDTO(transportation, "typeOfTransportCode", 	Сообщение.ИнформацияОТранспорте.ТипТранспортногоСредства);	
	xmlЗаполнитьЗначениеXDTO(transportation, "voyageNumber", 			Сообщение.ИнформацияОТранспорте.НомерРейса);	
	xmlЗаполнитьЗначениеXDTO(transportation, "vehicleNumber", 			Сообщение.ИнформацияОТранспорте.НомерТранспортногоСредства);	
	xmlЗаполнитьЗначениеXDTO(transportation, "vehicleBrand", 			Сообщение.ИнформацияОТранспорте.МаркаТранспортногоСредства);	
	xmlЗаполнитьЗначениеXDTO(transportation, "nameOfCarrier", 			Сообщение.ИнформацияОТранспорте.ИмяВодителя);	
	xmlЗаполнитьЗначениеXDTO(transportation, "phoneOfCarrier", 			Сообщение.ИнформацияОТранспорте.ТелефонВодителя);	
	xmlЗаполнитьЗначениеXDTO(transportation, "driverLicenseNumber", 	Сообщение.ИнформацияОТранспорте.НомерЛицензииВодителя);	
	xmlЗаполнитьЗначениеXDTO(transportation, "commentForTransport", 	Сообщение.ИнформацияОТранспорте.Комментарий);	

	Для каждого Строка Из Сообщение.Грузополучатели Цикл
		
		shipTo = ДобавитьЭлементСпискаXDTO(deliveryInfo.shipTo, ФабрикаXDTO_EdiXml());
		xmlЗаписатьContractor_XDTO(shipTo,	"shipTo", 	Строка.ГрузополучательEDI);
		
		xmlЗаполнитьЗначениеXDTO(shipTo, "deliveryPartyType", 			Строка.ТипТочкиДоставки);	
		xmlЗаполнитьЗначениеXDTO(shipTo, "countingNumber", 				Строка.ПорядковыйНомер);	
		xmlЗаполнитьЗначениеXDTO(shipTo, "requestedDeliveryDateTime", 	Строка.ДатаВремяДоставки);	
		xmlЗаполнитьЗначениеXDTO(shipTo, "comment", 					Строка.Комментарий);	
		
		Если ЗначениеЗаполнено(Строка.ТарифНаПеревозку) Тогда
			tariffInfo = xmlСоздатьДочернийЭлементXDTO(shipTo, "tariffInfo");
			xmlЗаполнитьЗначениеXDTO(tariffInfo, "typeOfTariff", 	Строка.ТарифНаПеревозку.ТипТарифа);	
			xmlЗаполнитьЗначениеXDTO(tariffInfo, "tariffRegion", 	Строка.ТарифНаПеревозку.РегионТарифа);	
			xmlЗаполнитьЗначениеXDTO(tariffInfo, "plannedAmount", 	Строка.ТарифНаПеревозку.ПлановаяСтоимость);	
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

//Заполнение всего сообщения EdiMessage, точка входа
Процедура xmlЗаписатьEdiMessage_XDTO(СообщениеОбъект,Сообщение)
	
	ТипСообщения = Сообщение.ТипСообщения;
			
	ИмяДокумента = "";
	ИмяКоличества = "";
	ДатаПоставки = "";
	ОпределитьИменаРеквизитовСообщения(ТипСообщения,ИмяДокумента,ИмяКоличества,ДатаПоставки);

	СообщениеОбъект.id					= Сообщение.id;
	
    //секция "interchangeHeader"
	xmlСоздатьДочернийЭлементXDTO(СообщениеОбъект, "interchangeHeader");
	xmlЗаписатьInterchangeHeader_XDTO(СообщениеОбъект.interchangeHeader,Сообщение);

	//сам документ
	ОбъектДокумента = xmlСоздатьДочернийЭлементXDTO(СообщениеОбъект, ИмяДокумента);//создали секцию, соответствующую имени документа: PORDERS....INVOIC
	xmlЗаписатьДанныеДокумента_XDTO(ОбъектДокумента, Сообщение.ДокументEDI.Номер, Сообщение.ДокументEDI.Дата);//номер/дата документа

	//статусы документа (атрибуты внутри тега)
	Если Сообщение.ТипСообщения = "INVOIC"
		ИЛИ Сообщение.ТипСообщения = "COINVOIC" Тогда
		
		Если Сообщение.Исправление = Истина Тогда
			
			ОбъектДокумента.type			= "Replace";
			ОбъектДокумента.revisionNumber	= СокрЛП(Сообщение.ДокументEDI.НомерИсправления);
			ОбъектДокумента.revisionDate	= Сообщение.ДокументEDI.ДатаИсправления;
			
		Иначе
			ОбъектДокумента.type = "Original";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Сообщение.ФункцияУПД) Тогда
			ИмяПоляФункцияУПД = ?(Сообщение.ТипСообщения = "INVOIC", "utdFunction", "ucdFunction");
			ОбъектДокумента[ИмяПоляФункцияУПД] = Сообщение.ФункцияУПД;
		КонецЕсли;
				
	ИначеЕсли Сообщение.ТипСообщения = "ORDERS" Тогда
		
		Если ЗначениеЗаполнено(Сообщение.Статус) Тогда
			Если (Сообщение.Статус = "Отменен" ИЛИ Сообщение.Статус = "Canceled" ИЛИ Сообщение.Статус = "Отмена") Тогда
				ОбъектДокумента.status = "Canceled";
			ИначеЕсли Сообщение.Статус = "Уточнен" Тогда 
				ОбъектДокумента.status = "Replace";
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли Сообщение.ТипСообщения = "ORDRSP"
		ИЛИ Сообщение.ТипСообщения = "DESADV"
		ИЛИ Сообщение.ТипСообщения = "RETINS" Тогда //ИЛИ Сообщение.ТипСообщения = "RETREC"
		
		xmlЗаполнитьЗначениеXDTO(ОбъектДокумента,	"status",	ПреобразоватьСтатус(Сообщение.Статус));
		
	ИначеЕсли Сообщение.ТипСообщения = "ALCRPT" Тогда
		
		Если Сообщение.БылОтправленALCRPT Тогда
			ОбъектДокумента.status = "Replace";
		КонецЕсли;
		
	КонецЕсли;
	
	//теперь запишем идентификаторы предыдущих/связанных документов
	//теги вроде despatchIdentificator, originOrder, contractIdentificator, egaisRegistrationIdentificator и т.е.
	xmlЗаписатьИдентификаторыДокументовВСообщениеXDTO(ОбъектДокумента,Сообщение);
	
	//факторинг: уступочная надпись
	Если Сообщение.ТипСообщения = "INVOIC" ИЛИ ТипСообщения = "COINVOIC" Тогда
		Если Сообщение.Свойство("ФакторингУступочнаяНадпись") И ЗначениеЗаполнено(Сообщение.ФакторингУступочнаяНадпись) Тогда
			ОбъектДокумента.factoringEncription = Лев(СокрЛП(Сообщение.ФакторингУступочнаяНадпись),2000);
		КонецЕсли;
	КонецЕсли;

	ВыгружатьТолькоОрганизацию = (Сообщение.ТипСообщения = "ALCRPT");
	
	xmlСоздатьДочернийЭлементXDTO(ОбъектДокумента,	"seller");
	xmlЗаписатьContractor_XDTO(ОбъектДокумента.seller,		"seller", 	Сообщение.ПродавецEDI, 		ВыгружатьТолькоОрганизацию);
	
	Если Сообщение.Свойство("ОтветственныйЗаПередачуГрузаEDI") И ЗначениеЗаполнено(Сообщение.ОтветственныйЗаПередачуГрузаEDI) Тогда
		xmlЗаписатьContactInfo_XDTO(ОбъектДокумента.seller,	"DeliveryContact", 	Сообщение.ОтветственныйЗаПередачуГрузаEDI);
	КонецЕсли;
	
	xmlСоздатьДочернийЭлементXDTO(ОбъектДокумента,	"buyer");
	xmlЗаписатьContractor_XDTO(ОбъектДокумента.buyer,		"buyer", 	Сообщение.ПокупательEDI, 	ВыгружатьТолькоОрганизацию);
	xmlСоздатьДочернийЭлементXDTO(ОбъектДокумента,	"invoicee");
	xmlЗаписатьContractor_XDTO(ОбъектДокумента.invoicee,	"invoicee", Сообщение.ПлательщикEDI, 	ВыгружатьТолькоОрганизацию);
		
	
	//секция "deliveryInfo"
	xmlСоздатьДочернийЭлементXDTO(ОбъектДокумента,	"deliveryInfo");
	xmlЗаписатьDeliveryInfo_XDTO(ОбъектДокумента.deliveryInfo,Сообщение,ДатаПоставки,ВыгружатьТолькоОрганизацию);
	Если Сообщение.ТипСообщения = "ORDRSP" Тогда 
		xmlСоздатьДочернийЭлементXDTO(ОбъектДокумента,	"packages");
		xmlЗаписатьПаллетоМестаВ_packages_XDTO(ОбъектДокумента.packages,Сообщение,ДатаПоставки,ВыгружатьТолькоОрганизацию);
	КонецЕсли;
			
	//комментарий в ORDERS и во всех исходящих сообщениях, где он есть
	Если ПередаватьКомментарийВИсходящихСообщениях(Сообщение.Направление, Сообщение.ТипСообщения, Сообщение.Партнер) Тогда
		ОбъектДокумента.comment = Лев(СокрЛП(Сообщение.Комментарий),2560);
	КонецЕсли;
	
	//данные об упаковках ORDRSP
	Если ТипСообщения = "ORDRSP" 
		И Сообщение.Свойство("ТранспортныеУпаковки")
		И ЗначениеЗаполнено(Сообщение.ТранспортныеУпаковки)
		И НЕ Сообщение.ТранспортныеУпаковки.Строки.Количество() = 0 Тогда
		
		//секция "packages" 
		packages = xmlСоздатьДочернийЭлементXDTO(ОбъектДокумента,	"packages");
		
		Для каждого Упаковка Из Сообщение.ТранспортныеУпаковки.Строки Цикл
			НовЭлементУпаковки = ДобавитьЭлементСпискаXDTO(packages.package, ФабрикаXDTO_EdiXml());
			xmlСоздатьДочернийЭлементXDTO(НовЭлементУпаковки, "packageQuantity");
			НовЭлементУпаковки.packageQuantity.typeOfPackage	= Упаковка.ТипУпаковки;
			НовЭлементУпаковки.packageQuantity.__content		= Упаковка.Количество;
		КонецЦикла;
		
	КонецЕсли;

	Если Сообщение.Свойство("Фасовка") Тогда
		ИсходнаяТаблицаФасовка = Сообщение.Фасовка.Скопировать(); //сохраним исходный состав фасовки
	КонецЕсли;
	
	//данные об упаковках DESADV|INVOIC - SSCC
	КоличествоУпаковок = 0;
	Если (ТипСообщения = "DESADV" ИЛИ ТипСообщения = "INVOIC") 
		 И Сообщение.Свойство("ТранспортныеУпаковки")
		 И ЗначениеЗаполнено(Сообщение.ТранспортныеУпаковки) Тогда
		КоличествоУпаковок = Сообщение.ТранспортныеУпаковки.Строки.Количество();
		
		Если Не КоличествоУпаковок = 0 Тогда
			
			//секция "packages" (SSCC)
			xmlСоздатьДочернийЭлементXDTO(ОбъектДокумента,	"packages");
			xmlЗаписатьPackages_XDTO(ОбъектДокумента.packages,Сообщение);

			//дополнение табличной части данными об упаковках (возможна разбивка строк табличной части)
			ИсходнаяТаблицаТовары = Сообщение.Товары.Скопировать(); //сохраним исходный товарный состав
			ДополнитьТаблицуТоваровДаннымиОбУпаковке(Сообщение);    //скорректируем товарный состав с учетом распределения по упаковкам
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипСообщения = "INVOIC" И СообщениеСодержитКодыМаркировки(Сообщение) Тогда
		
		Если Сообщение.ТипыМаркируемойПродукции.НайтиПоЗначению("Mark") = Неопределено Тогда
			Сообщение.ТипыМаркируемойПродукции.Добавить("Mark", "Товары, подлежащие маркировке");
		КонецЕсли;
		
		xmlЗаполнитьЗначениеXDTO(ОбъектДокумента, "goodsMarkTypes", Сообщение.ТипыМаркируемойПродукции); 
		
	КонецЕсли;
	
	Если Сообщение.Свойство("ДополнительнаяИнформация") Тогда
		xmlЗаполнитьKeyValueTypeXDTO(ОбъектДокумента, Сообщение.ДополнительнаяИнформация);
	КонецЕсли;
	
	//запишем Особенности сообщения, созданные в событии ПМ ДобавитьОсобенностиСообщений
	ЗаполнитьОсобенностиДокумента_XDTO(ОбъектДокумента,Сообщение,ТипСообщения);	
	
	//запишем lineItems - товары сообщения
	lineItems = xmlСоздатьДочернийЭлементXDTO(ОбъектДокумента,"lineItems");
	xmlЗаписатьLineItemS_XDTO(lineItems,Сообщение,ИмяКоличества);
	
	СкорректироватьТипКодовОСУВТоварах(lineItems.lineItem);
	
	//вернем обратно таблицу товаров
	Если Не КоличествоУпаковок = 0 Тогда
		Сообщение.Товары.Очистить();
		Сообщение.Товары = ИсходнаяТаблицаТовары.Скопировать(); //восстановим исходный товарный состав после корректировки с учетом распределения по упаковкам
	КонецЕсли;
 	Если Сообщение.Свойство("Фасовка") Тогда
		Сообщение.Фасовка.Очистить();
		Сообщение.Фасовка = ИсходнаяТаблицаФасовка.Скопировать(); //восстановим исходный товарный состав после корректировки с учетом распределения по упаковкам
	КонецЕсли;

КонецПроцедуры

Функция ПередаватьКомментарийВИсходящихСообщениях(Направление, ТипСообщения,  Партнер) Экспорт
	
	ПередаватьКомментарий = ТипСообщения = "ORDERS" 
	ИЛИ  (Направление = "Исходящее" 
	И ЭтоТипСообщенияСКомментарием(ТипСообщения) 
	И (ПолучитьЗначениеСвойстваОбъектаEDI(Партнер, "ПередаватьКомментарийВИсходящихСообщениях") = Истина));
	
	Возврат ПередаватьКомментарий;

КонецФункции

//Заполнение секций с типом DocumentIdentificator
Процедура xmlЗаписатьДанныеДокумента_XDTO(ОбъектXDTO, НомерДокумента, ДатаДокумента)
	
	Если ЗначениеЗаполнено(НомерДокумента) Тогда
		ОбъектXDTO.number	= НомерДокумента;
		ОбъектXDTO.date		= ДатаДокумента;
	КонецЕсли;	
	
КонецПроцедуры

//Заполнение секции InterchangeHeader
Процедура xmlЗаписатьInterchangeHeader_XDTO(ОбъектXDTO,Сообщение)
	
	ЗначениеТипаСообщения=Сообщение.ТипСообщения;
	Если ЗначениеТипаСообщения="PRICELIST" Тогда
		ЗначениеТипаСообщения="PRICAT"; //Формат теперь требует слово PRICAT в сообщении вместо PRICELIST, при этом пользователь будет видеть везде (втч и в веб) PRICELIST
	КонецЕсли;
	
	ОбъектXDTO.sender = Сообщение.ОтправительEDI.GLN;
	ОбъектXDTO.recipient = Сообщение.ПолучательEDI.GLN;
	ОбъектXDTO.documentType = ЗначениеТипаСообщения;
	Если Сообщение.Свойство("ДатаСоздания") И ЗначениеЗаполнено(Сообщение.ДатаСоздания) Тогда
		ОбъектXDTO.creationDateTime = Сообщение.ДатаСоздания;
	КонецЕсли;
	
	Если Сообщение.Свойство("isTest") И Сообщение.IsTest = 1 Тогда
		ОбъектXDTO.isTest = "1";
	КонецЕсли;
	
	Если НЕ Сообщение.ТипСообщения = "ALCRPT" Тогда
		data1C = xmlСоздатьДочернийЭлементXDTO(ОбъектXDTO,"data1C");
		data1C.version = ОписаниеВерсииСтрокойСОсобенностями_КонтурEDI();
		data1C.name = ИмяКонфигурации1С;
	КонецЕсли;
	
КонецПроцедуры

//Заполнение секции DeliveryInfo
Процедура xmlЗаписатьDeliveryInfo_XDTO(ОбъектXDTO,Сообщение,ДатаПоставки,ВыгружатьТолькоОрганизацию)

	Если Сообщение.ТипСообщения = "ALCRPT" Тогда
		
		xmlЗаполнитьDocumentIdentificator(ОбъектXDTO, "waybill", Сообщение, "ТранспортнаяНакладнаяEDI");
		
	Иначе
		
		Если Сообщение.Свойство("ДатаПоставкиФактическая") Тогда
			//+для АТАК
			xmlЗаполнитьЗначениеXDTO(ОбъектXDTO,		ДатаПоставки,			Сообщение.ДатаПоставкиФактическая);
		ИначеЕсли ЗначениеЗаполнено(ДатаПоставки) Тогда
			xmlЗаполнитьЗначениеXDTO(ОбъектXDTO,		ДатаПоставки,			Сообщение.ДатаПоставки);//вариативное название
		КонецЕсли;
		
		Если Сообщение.Свойство("ДатаВывозаОтПоставщика")Тогда
			//+Для Магнита
			xmlЗаполнитьЗначениеXDTO(ОбъектXDTO,		"exportDateTimeFromSupplier",		Сообщение.ДатаВывозаОтПоставщика);
		КонецЕсли;
		
		// +++ 1 бит Балицкий В.В. 07.10.2026
		// В DESADV передаём waybill из связанной транспортной накладной (если заполнена).
		Если Сообщение.ТипСообщения = "DESADV"
			И Сообщение.Свойство("ТранспортнаяНакладнаяEDI")
			И ТипЗнч(Сообщение.ТранспортнаяНакладнаяEDI) = Тип("Структура")
			И Сообщение.ТранспортнаяНакладнаяEDI.Свойство("Номер")
			И ЗначениеЗаполнено(Сообщение.ТранспортнаяНакладнаяEDI.Номер) Тогда
			xmlЗаполнитьDocumentIdentificator(ОбъектXDTO, "waybill", Сообщение, "ТранспортнаяНакладнаяEDI");
		КонецЕсли;
		// --- 1 бит Балицкий В.В. 07.10.2026	

	КонецЕсли;	
	
	Если Сообщение.ТипСообщения = "DESADV" Тогда
		Если Сообщение.Свойство("ДатаОтгрузки") Тогда	//проверки на наличие свойства в Структуре тоже можно обернуть
			xmlЗаполнитьЗначениеXDTO(ОбъектXDTO,		"shippingDateTime",		Сообщение.ДатаОтгрузки);
		КонецЕсли;		
	КонецЕсли;
		
	xmlСоздатьДочернийЭлементXDTO(ОбъектXDTO,"shipFrom");
	xmlЗаписатьContractor_XDTO(ОбъектXDTO.shipFrom, "shipFrom",	Сообщение.ГрузоотправительEDI, ВыгружатьТолькоОрганизацию);
	
	xmlСоздатьДочернийЭлементXDTO(ОбъектXDTO,"shipTo");
	Если Сообщение.ТипСообщения = "ALCRPT" Тогда
		xmlЗаписатьContractor_XDTO(ОбъектXDTO.shipTo, "shipTo",	Сообщение.ГрузополучательEDI, Истина);
	Иначе
		Если ЗначениеЗаполнено(Сообщение.ГрузополучательEDI.GLN) Тогда
			xmlЗаписатьContractor_XDTO(ОбъектXDTO.shipTo, "shipTo",	Сообщение.ГрузополучательEDI);
		Иначе
			xmlЗаписатьContractor_XDTO(ОбъектXDTO.shipTo, "shipTo",	Сообщение.ПокупательEDI);
		КонецЕсли;
	КонецЕсли;
	
	Если Сообщение.Свойство("КонечныйГрузополучательEDI") И ЗначениеЗаполнено(Сообщение.КонечныйГрузополучательEDI.GLN) Тогда
		xmlСоздатьДочернийЭлементXDTO(ОбъектXDTO,"ultimateCustomer");
		xmlЗаписатьContractor_XDTO(ОбъектXDTO.ultimateCustomer, "ultimateCustomer",	Сообщение.КонечныйГрузополучательEDI);
	КонецЕсли;
	
	Если Сообщение.Свойство("ОтветственныйЗаДоставку") И ЗначениеЗаполнено(Сообщение.ОтветственныйЗаДоставку) Тогда
		xmlЗаполнитьЗначениеXDTO(ОбъектXDTO,		"transportBy",			Сообщение.ОтветственныйЗаДоставку);
	КонецЕсли;
	Если Сообщение.Свойство("ТочкиСамовывоза") 
		И Сообщение.ТочкиСамовывоза<>неопределено 
		И Сообщение.ТочкиСамовывоза.Количество()>0 Тогда
		
		НоваяСтрока = ДобавитьЭлементСпискаXDTO(ОбъектXDTO.despatchParty,ФабрикаXDTO_EdiXml());
		
		xmlЗаполнитьЗначениеXDTO(НоваяСтрока,						"gln",			Сообщение.ТочкиСамовывоза[0].GLN);
		
		xmlСоздатьДочернийЭлементXDTO(НоваяСтрока,"organization");
		xmlЗаполнитьЗначениеXDTO(НоваяСтрока.organization,			"name",			Сообщение.ТочкиСамовывоза[0].Наименование);
		
		xmlСоздатьДочернийЭлементXDTO(НоваяСтрока,"russianAddress");
		xmlЗаполнитьЗначениеXDTO(НоваяСтрока.russianAddress,		"regionISOCode",Сообщение.ТочкиСамовывоза[0].Регион);
		xmlЗаполнитьЗначениеXDTO(НоваяСтрока.russianAddress,		"city",			Сообщение.ТочкиСамовывоза[0].Город);
		xmlЗаполнитьЗначениеXDTO(НоваяСтрока.russianAddress,		"street",		Сообщение.ТочкиСамовывоза[0].Улица);
		xmlЗаполнитьЗначениеXDTO(НоваяСтрока.russianAddress,		"house",		Сообщение.ТочкиСамовывоза[0].Дом);
		xmlЗаполнитьЗначениеXDTO(НоваяСтрока.russianAddress,		"block",		Сообщение.ТочкиСамовывоза[0].Корпус);
		xmlЗаполнитьЗначениеXDTO(НоваяСтрока.russianAddress,		"postalCode",	Сообщение.ТочкиСамовывоза[0].Индекс);
		
		xmlЗаполнитьЗначениеXDTO(НоваяСтрока,			"additionalIdentificator",	Сообщение.ТочкиСамовывоза[0].Идентификатор);
		
	КонецЕсли;
	
//тип ТС
	Если Сообщение.Свойство("Транспортировка") 
		И Сообщение.Транспортировка<>неопределено 
		И Сообщение.Транспортировка.Свойство("ТипТранспортногоСредства")
		И ЗначениеЗаполнено(Сообщение.Транспортировка.ТипТранспортногоСредства)
		И Сообщение.Транспортировка.ТипТранспортногоСредства.Количество()>0	Тогда
		
		Для Каждого ТипТС из Сообщение.Транспортировка.ТипТранспортногоСредства Цикл
			Если ТипТС.Пометка=Истина ИЛИ Сообщение.ТипСообщения = "ORDERS" Тогда  //для ответа на заказ только выбранный, для заказа - все
				НовЭлемент = ДобавитьЭлементСпискаXDTO(ОбъектXDTO.transportation,ФабрикаXDTO_EdiXml());
				НовЭлемент.typeOfTransportCode = ТипТС.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	
	Если Сообщение.Свойство("ПромежуточныйГрузополучательEDI") И ЗначениеЗаполнено(Сообщение.ПромежуточныйГрузополучательEDI.GLN) Тогда
		xmlСоздатьДочернийЭлементXDTO(ОбъектXDTO,"warehouseKeeper");
		xmlЗаписатьContractor_XDTO(ОбъектXDTO.warehouseKeeper, "warehouseKeeper",	Сообщение.ПромежуточныйГрузополучательEDI);
	КонецЕсли;
	
	Если Сообщение.ТипСообщения = "DESADV" Тогда
		
		НовЭлемент = ДобавитьЭлементСпискаXDTO(ОбъектXDTO.transportation,ФабрикаXDTO_EdiXml());//это массив!!!
		
		xmlЗаполнитьЗначениеXDTO(НовЭлемент,	"transportMode",	Сообщение.Транспортировка.РежимПеревозки);
		xmlЗаполнитьЗначениеXDTO(НовЭлемент,	"vehicleNumber",	Сообщение.Транспортировка.НомерТранспортногоСредства);
		xmlЗаполнитьЗначениеXDTO(НовЭлемент,	"vehicleBrand",		Сообщение.Транспортировка.МаркаТранспортногоСредства);
		xmlЗаполнитьЗначениеXDTO(НовЭлемент,	"nameOfCarrier",	Сообщение.Транспортировка.ИмяВодителя);
		
	//врата и не только, структура "Транспортировка"
	ИначеЕсли Сообщение.ТипСообщения = "ORDERS" или Сообщение.ТипСообщения = "ORDRSP" Тогда
		
		РежимПеревозки = Неопределено;
		
		Если ПроверитьСвойствоПоляВСтруктуре(Сообщение, "Транспортировка.РежимПеревозки", РежимПеревозки)
			И ЗначениеЗаполнено(РежимПеревозки) Тогда
			НовЭлемент = ДобавитьЭлементСпискаXDTO(ОбъектXDTO.transportation,ФабрикаXDTO_EdiXml());
			xmlЗаполнитьЗначениеXDTO(НовЭлемент,	"transportMode",	РежимПеревозки);
		КонецЕсли;
			
		ДатаВремяПрибытия = Неопределено;
		Если ПроверитьСвойствоПоляВСтруктуре(Сообщение, "Транспортировка.ДатаВремяПрибытия", ДатаВремяПрибытия)
			И ЗначениеЗаполнено(ДатаВремяПрибытия) Тогда
			ТекКоличествоЭлементов = ОбъектXDTO.transportation.Количество();
			Сч = 1;
			Для Каждого ЭлементВорот Из ДатаВремяПрибытия Цикл
				Если Сообщение.ТипСообщения = "ORDRSP" 
					И НЕ ЭлементВорот.Пометка Тогда
					Продолжить;
				КонецЕсли;
				Если Сч > ТекКоличествоЭлементов Тогда
					НовЭлемент = ДобавитьЭлементСпискаXDTO(ОбъектXDTO.transportation,ФабрикаXDTO_EdiXml());
				КонецЕсли;
				ОбъектXDTO.transportation[Сч-1].vehicleArrivalDateTime = ЭлементВорот.Значение;
				Сч = Сч + 1;	
			КонецЦикла;
		КонецЕсли;
		
		ВремяНачалаПогрузки = Неопределено;
		ВремяОкончанияПогрузки = Неопределено;
		
		Если ПроверитьСвойствоПоляВСтруктуре(Сообщение, "Транспортировка.ВремяНачалаПогрузки", ВремяНачалаПогрузки)
			И ЗначениеЗаполнено(ВремяНачалаПогрузки) Тогда
			ТекКоличествоЭлементов = ОбъектXDTO.transportation.Количество();
			Сч = 1;
			Для каждого Эл Из Сообщение.Транспортировка.ВремяНачалаПогрузки Цикл
				Если Сч > ТекКоличествоЭлементов Тогда
					НовЭлемент = ДобавитьЭлементСпискаXDTO(ОбъектXDTO.transportation,ФабрикаXDTO_EdiXml());
				КонецЕсли;
				ОбъектXDTO.transportation[Сч-1].startOfLoadingOnVehicleFromSupplier = Дата1С_в_ДатаВремяXML(Эл.Значение);
				Сч = Сч + 1;	
			КонецЦикла;
		КонецЕсли;
		
		Если ПроверитьСвойствоПоляВСтруктуре(Сообщение, "Транспортировка.ВремяОкончанияПогрузки", ВремяОкончанияПогрузки)
			И ЗначениеЗаполнено(ВремяОкончанияПогрузки) Тогда
			ТекКоличествоЭлементов = ОбъектXDTO.transportation.Количество();
			Сч = 1;
			Для каждого Эл Из Сообщение.Транспортировка.ВремяОкончанияПогрузки Цикл
				Если Сч > ТекКоличествоЭлементов Тогда
					НовЭлемент = ДобавитьЭлементСпискаXDTO(ОбъектXDTO.transportation,ФабрикаXDTO_EdiXml());
				КонецЕсли;
				ОбъектXDTO.transportation[Сч-1].endOfLoadingOnVehicleFromSupplier = Дата1С_в_ДатаВремяXML(Эл.Значение);
				Сч = Сч + 1;	
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

//Заполнение секции packages
Процедура xmlЗаписатьПаллетоМестаВ_packages_XDTO(ОбъектXDTO,Сообщение,ДатаПоставки,ВыгружатьТолькоОрганизацию)

	Если Сообщение.Свойство("ПаллетоМеста") 
		И Сообщение.ПаллетоМеста.Свойство("КоличествоПаллетоМест") 
		И Сообщение.ПаллетоМеста.Свойство("КоличествоПаллет") 
		И Сообщение.ПаллетоМеста.Свойство("ЕдиницаEDI") 
		И ЗначениеЗаполнено(Сообщение.ПаллетоМеста.КоличествоПаллет)
		И Сообщение.ПаллетоМеста.КоличествоПаллет <> 0 Тогда
		
		Если ЗначениеЗаполнено(Сообщение.ПаллетоМеста.КоличествоПаллет) Тогда 
			НовЭлементУпаковки = ДобавитьЭлементСпискаXDTO(ОбъектXDTO.package,ФабрикаXDTO_EdiXml());
			xmlСоздатьДочернийЭлементXDTO(НовЭлементУпаковки,"packageQuantity");
			НовЭлементУпаковки.packageQuantity.__content		= Сообщение.ПаллетоМеста.КоличествоПаллет;
			Если ЗначениеЗаполнено(Сообщение.ПаллетоМеста.КоличествоПаллетоМест) Тогда
				packageMeasurementInfo = xmlСоздатьДочернийЭлементXDTO(НовЭлементУпаковки, "packageMeasurementInfo");
				ЕдиницаИзмеренияПаллетоМест = ?(ЗначениеЗаполнено(Сообщение.ПаллетоМеста.ЕдиницаEDI), Сообщение.ПаллетоМеста.ЕдиницаEDI, "NAR");
				xmlЗаписатьQuantityType_XDTO(packageMeasurementInfo, "numberOfPalletPlaces", Сообщение.ПаллетоМеста.КоличествоПаллетоМест, ЕдиницаИзмеренияПаллетоМест);
			КонецЕсли;	
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры

//Заполнение секций с типом Contractor (ЮрФизлицо)
Процедура xmlЗаписатьContractor_XDTO(ПолеXDTO,ИмяПоля,ЮрФизЛицо,ВыгрузкаТолькоОрганизации = Ложь)
	
	Если НЕ (ЗначениеЗаполнено(ЮрФизЛицо.GLN) 
		ИЛИ ВыгрузкаТолькоОрганизации 
		ИЛИ ИмяПоля = "manufacturer" 
		ИЛИ ИмяПоля = "foreignManufacturer"
		ИЛИ ИмяПоля = "location"
		ИЛИ ИмяПоля = "inventoryReporter"
		ИЛИ ИмяПоля = "locationOfGoods") Тогда
		//и дропнем само поле. TODO сделать отдельную обертку
		ПолеXDTO.Владелец().Сбросить(ИмяПоля);
		Возврат;
	КонецЕсли;
	
	xmlЗаполнитьЗначениеXDTO(ПолеXDTO,		"gln",			ЮрФизЛицо.GLN);
	
	Если ИмяПоля = "seller"
		ИЛИ  ИмяПоля = "shipFrom"	
		ИЛИ  ИмяПоля = "shipTo" тогда
		
		Если ЮрФизЛицо.Свойство("КодВСистемеПокупателя") Тогда
			xmlЗаполнитьЗначениеXDTO(ПолеXDTO,		"additionalIdentificator",			ЮрФизЛицо.КодВСистемеПокупателя);
		КонецЕсли;
		
	КонецЕсли;
	
	ВидКонтрагента = ЮрФизЛицо.Вид;
	
	Если ВидКонтрагента = "ЮрЛицо" Тогда
		
		xmlСоздатьДочернийЭлементXDTO(ПолеXDTO,"organization");
		
		xmlЗаполнитьЗначениеXDTO(ПолеXDTO.organization,		"inn",			ЮрФизЛицо.ИНН);
		xmlЗаполнитьЗначениеXDTO(ПолеXDTO.organization,		"kpp",			ЮрФизЛицо.КПП);
		xmlЗаполнитьЗначениеXDTO(ПолеXDTO.organization,		"name",			ЮрФизЛицо.Наименование);

	ИначеЕсли ВидКонтрагента = "ФизЛицо" Тогда
		
		xmlСоздатьДочернийЭлементXDTO(ПолеXDTO,"selfEmployed");
		
		xmlЗаполнитьЗначениеXDTO(ПолеXDTO.selfEmployed,				"inn",			ЮрФизЛицо.ИНН);
		
		xmlСоздатьДочернийЭлементXDTO(ПолеXDTO.selfEmployed,"fullName");
		
		xmlЗаполнитьЗначениеXDTO(ПолеXDTO.selfEmployed.fullName,	"lastName",		ЮрФизЛицо.Фамилия);
		xmlЗаполнитьЗначениеXDTO(ПолеXDTO.selfEmployed.fullName,	"firstName",	ЮрФизЛицо.Имя);
		xmlЗаполнитьЗначениеXDTO(ПолеXDTO.selfEmployed.fullName,	"middleName",	ЮрФизЛицо.Отчество);
		
	ИначеЕсли ВидКонтрагента = "Нерезидент" Тогда
		
		КодСтраны = ЮрФизЛицо.Адрес.КодСтраны;
		
		Если ЗначениеЗаполнено(КодСтраны) Тогда
			Если КодСтраны = "398" Тогда
				КодСтраны = "KZ";
			ИначеЕсли КодСтраны = "112" Тогда
				КодСтраны = "BY";
			ИначеЕсли КодСтраны = "051" Тогда
				КодСтраны = "AM";
			КонецЕсли;
		КонецЕсли;
				
		xmlСоздатьДочернийЭлементXDTO(ПолеXDTO,"foreignOrganization");
		
		xmlЗаполнитьЗначениеXDTO(ПолеXDTO.foreignOrganization,	"countryCode",	КодСтраны);
		xmlЗаполнитьЗначениеXDTO(ПолеXDTO.foreignOrganization,	"tin",			ЮрФизЛицо.ИНН);
		xmlЗаполнитьЗначениеXDTO(ПолеXDTO.foreignOrganization,	"name",			ЮрФизЛицо.Наименование);
		
	КонецЕсли;
	
	Если ИмяПоля = "manufacturer" ИЛИ ИмяПоля = "foreignManufacturer" Тогда
		
//			ЗаписьХМЛ.ЗаписатьКонецЭлемента();
		Возврат;
		
	КонецЕсли;

	Если ВыгрузкаТолькоОрганизации И (ИмяПоля = "buyer" ИЛИ ИмяПоля = "seller" ИЛИ ИмяПоля = "shipFrom" ИЛИ ИмяПоля = "shipTo") Тогда
		
		Если ЗначениеЗаполнено(ЮрФизЛицо.Адрес) Тогда
			
			СвойствоАдрес = ЮрФизЛицо.Адрес;
			
			ВидАдреса = СвойствоАдрес.ВидАдреса;
			
			Если ВидАдреса = "Российский" Тогда
				
				КодРегиона = КонвертироватьКодРегионаВЦифры(СвойствоАдрес.Регион);
					
				xmlСоздатьДочернийЭлементXDTO(ПолеXDTO,"russianAddress");
		
				xmlЗаполнитьЗначениеXDTO(ПолеXDTO.russianAddress,	"regionISOCode",КодРегиона);
				xmlЗаполнитьЗначениеXDTO(ПолеXDTO.russianAddress,	"district",		СвойствоАдрес.Район);
				xmlЗаполнитьЗначениеXDTO(ПолеXDTO.russianAddress,	"city",			СвойствоАдрес.Город);
				xmlЗаполнитьЗначениеXDTO(ПолеXDTO.russianAddress,	"settlement",	СвойствоАдрес.НаселенныйПункт);
				xmlЗаполнитьЗначениеXDTO(ПолеXDTO.russianAddress,	"street",		СвойствоАдрес.Улица);
				xmlЗаполнитьЗначениеXDTO(ПолеXDTO.russianAddress,	"house",		СвойствоАдрес.Дом);
				xmlЗаполнитьЗначениеXDTO(ПолеXDTO.russianAddress,	"block",		СвойствоАдрес.Корпус);
				xmlЗаполнитьЗначениеXDTO(ПолеXDTO.russianAddress,	"flat",			СвойствоАдрес.Квартира);
				xmlЗаполнитьЗначениеXDTO(ПолеXDTO.russianAddress,	"postalCode",	СвойствоАдрес.Индекс);
				
			КонецЕсли;
		КонецЕсли;
		
	Иначе//гора неочевидных условий, отрефакторить по возможности
		
		Если НЕ ВидКонтрагента = "ТолькоGLN" Тогда
			
			Если ЗначениеЗаполнено(ЮрФизЛицо.Адрес) Тогда
				
				СвойствоАдрес = ЮрФизЛицо.Адрес;
				
				ВидАдреса = СвойствоАдрес.ВидАдреса;
				
				Если ВидАдреса = "Российский" Тогда
					
					xmlСоздатьДочернийЭлементXDTO(ПолеXDTO,"russianAddress");
		
					xmlЗаполнитьЗначениеXDTO(ПолеXDTO.russianAddress,	"regionISOCode",	СвойствоАдрес.Регион);
					xmlЗаполнитьЗначениеXDTO(ПолеXDTO.russianAddress,	"district",		СвойствоАдрес.Район);
					xmlЗаполнитьЗначениеXDTO(ПолеXDTO.russianAddress,	"city",			СвойствоАдрес.Город);
					xmlЗаполнитьЗначениеXDTO(ПолеXDTO.russianAddress,	"settlement",	СвойствоАдрес.НаселенныйПункт);
					xmlЗаполнитьЗначениеXDTO(ПолеXDTO.russianAddress,	"street",		СвойствоАдрес.Улица);
					xmlЗаполнитьЗначениеXDTO(ПолеXDTO.russianAddress,	"house",		СвойствоАдрес.Дом);
					xmlЗаполнитьЗначениеXDTO(ПолеXDTO.russianAddress,	"block",		СвойствоАдрес.Корпус);
					xmlЗаполнитьЗначениеXDTO(ПолеXDTO.russianAddress,	"flat",			СвойствоАдрес.Квартира);
					xmlЗаполнитьЗначениеXDTO(ПолеXDTO.russianAddress,	"postalCode",	СвойствоАдрес.Индекс);
					
				КонецЕсли;
			КонецЕсли;
			
			xmlСоздатьДочернийЭлементXDTO(ПолеXDTO,"additionalInfo");
		
			xmlЗаполнитьЗначениеXDTO(ПолеXDTO.additionalInfo,"phone", 						СокрЛП(Лев(СокрЛП(ЮрФизЛицо.Телефон),20)));
			xmlЗаполнитьЗначениеXDTO(ПолеXDTO.additionalInfo,"bankAccountNumber",		    ЮрФизЛицо.НомерСчета);
			xmlЗаполнитьЗначениеXDTO(ПолеXDTO.additionalInfo,"correspondentAccountNumber",	ЮрФизЛицо.КоррСчет);
			xmlЗаполнитьЗначениеXDTO(ПолеXDTO.additionalInfo,"bankName",					ЮрФизЛицо.Банк);
			xmlЗаполнитьЗначениеXDTO(ПолеXDTO.additionalInfo,"BIK",							ЮрФизЛицо.БИК);
			xmlЗаполнитьЗначениеXDTO(ПолеXDTO.additionalInfo,"nameOfCEO",					ЮрФизЛицо.Руководитель);
			xmlЗаполнитьЗначениеXDTO(ПолеXDTO.additionalInfo,"nameOfAccountant",			ЮрФизЛицо.ГлавныйБухгалтер);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЮрФизЛицо.Свойство("ТипЛокализации") Тогда
		xmlЗаполнитьЗначениеXDTO(ПолеXDTO, "localizationType", ЮрФизЛицо.ТипЛокализации);
	КонецЕсли;
		
КонецПроцедуры

//Заполнение секции packages (SSCC) в DESADV и INVOIC
Процедура xmlЗаписатьPackages_XDTO(ОбъектXDTO,Сообщение)
	
	ОписаниеРодительскойУпаковки = ПолучитьОписаниеРодительскойУпаковки(Сообщение.ТранспортныеУпаковки.Строки);
	
	РодительскаяУпаковка = ДобавитьЭлементСпискаXDTO(ОбъектXDTO.package,ФабрикаXDTO_EdiXml());
	xmlСоздатьДочернийЭлементXDTO(РодительскаяУпаковка,"packageQuantity");
	
	РодительскаяУпаковка.packageLevel = 1;
	РодительскаяУпаковка.packageQuantity.__content = ОписаниеРодительскойУпаковки.Количество;
	Если ЗначениеЗаполнено(ОписаниеРодительскойУпаковки.Тип) Тогда
		РодительскаяУпаковка.packageQuantity.typeOfPackage = ОписаниеРодительскойУпаковки.Тип;
	КонецЕсли;
	
	//когда вложенность увеличится - использовать рекурсию для обхода вложенных упаковок
	//								- изменить механизм получения родителя
	Для Каждого Упаковка Из Сообщение.ТранспортныеУпаковки.Строки Цикл
		
		НовЭлементУпаковки = ДобавитьЭлементСпискаXDTO(ОбъектXDTO.package,ФабрикаXDTO_EdiXml());
		xmlСоздатьДочернийЭлементXDTO(НовЭлементУпаковки,"packageQuantity");
		
		НовЭлементУпаковки.parentLevel	= 1;
		xmlЗаполнитьЗначениеXDTO(НовЭлементУпаковки,	"packageLevel",	Упаковка.НомерУпаковки);
		xmlЗаполнитьЗначениеXDTO(НовЭлементУпаковки,	"SSCC",			Упаковка.SSCC);
		
		НовЭлементУпаковки.packageQuantity.typeOfPackage	= Упаковка.ТипУпаковки;
		НовЭлементУпаковки.packageQuantity.__content		= 1;
		
		packageMeasurementInfo = xmlСоздатьДочернийЭлементXDTO(НовЭлементУпаковки, "packageMeasurementInfo");
		
		Если ЗначениеЗаполнено(Упаковка.ВесНетто) Тогда
			xmlЗаписатьQuantityType_XDTO(packageMeasurementInfo, "totalNetWeight", 		Упаковка.ВесНетто, 	Упаковка.КодЕдиницыИзмеренияВесаНетто);
		КонецЕсли;
		Если ЗначениеЗаполнено(Упаковка.ВесБрутто) Тогда
			xmlЗаписатьQuantityType_XDTO(packageMeasurementInfo, "totalGrossWeight", 	Упаковка.ВесБрутто, Упаковка.КодЕдиницыИзмеренияВесаБрутто);
		КонецЕсли;
		Если ЗначениеЗаполнено(Упаковка.Длина) Тогда
			xmlЗаписатьQuantityType_XDTO(packageMeasurementInfo, "totalLength", 		Упаковка.Длина, 	Упаковка.КодЕдиницыИзмеренияДлины);
		КонецЕсли;
		Если ЗначениеЗаполнено(Упаковка.Ширина) Тогда
			xmlЗаписатьQuantityType_XDTO(packageMeasurementInfo, "totalWidth", 			Упаковка.Ширина, 	Упаковка.КодЕдиницыИзмеренияШирины);
		КонецЕсли;
		Если ЗначениеЗаполнено(Упаковка.Высота) Тогда
			xmlЗаписатьQuantityType_XDTO(packageMeasurementInfo, "totalHeight", 		Упаковка.Высота, 	Упаковка.КодЕдиницыИзмеренияВысоты);
		КонецЕсли;
		Если Упаковка.ТребуетсяТемпературныйРежим = Истина Тогда
			xmlЗаписатьQuantityType_XDTO(packageMeasurementInfo, "storageTemperature", 	Упаковка.ТемпературныйРежим,	"CEL", Истина);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьОписаниеРодительскойУпаковки(КоллекцияУпаковок) Экспорт
	
	Результат = Новый Структура("Тип, Количество",Неопределено,0);
	
	Если КоллекцияУпаковок.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОдинТипУпаковки = Истина;
	ТипУпаковки = КоллекцияУпаковок[0].ТипУпаковки;
	
	Для каждого Упаковка Из КоллекцияУпаковок Цикл                                                                     
		
		Если Не Упаковка.ТипУпаковки = ТипУпаковки Тогда
			ОдинТипУпаковки = Ложь;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ОдинТипУпаковки Тогда 
		Результат.Тип = ТипУпаковки;
	КонецЕсли;
	
	Результат.Количество = КоллекцияУпаковок.Количество();
	
	Возврат Результат;
	
КонецФункции

//Заполнение секции lot внутри lineItem в ALCRPT
Процедура xmlЗаписатьAlcoLot_XDTO(НовЛотXDTO,СтрокаЛота,ЕстьИностранныйПроизводитель)
	
	xmlЗаполнитьЗначениеXDTO(НовЛотXDTO,	"description",	СтрокаЛота.Наименование);
	
	Если ЗначениеЗаполнено(СтрокаЛота.ЕГАИС)  Тогда
		xmlЗаполнитьЗначениеXDTO(НовЛотXDTO,	"codeOfEgais",		СтрокаЛота.ЕГАИС.КодТовараВЕГАИС);
		xmlЗаполнитьЗначениеXDTO(НовЛотXDTO,	"lotNumberEgais",	СтрокаЛота.ЕГАИС.ИдентификаторТовараВТТНЕГАИС);
	КонецЕсли;
	
	xmlСоздатьДочернийЭлементXDTO(НовЛотXDTO,"volume");
	
	НовЛотXDTO.volume.volumeTypeQualifier	= "despatchVolume";
	xmlЗаполнитьЗначениеXDTO(НовЛотXDTO.volume,	"unitOfMeasure",	СтрокаЛота.КодЕдиницыИзмеренияEDI);
	xmlЗаполнитьЗначениеXDTO(НовЛотXDTO.volume,	"__content",		СтрокаЛота.Количество);
	
	НовЛотXDTO.volumeOfUnitInLiter	= СтрокаЛота.АлкоОбъем;
	
	xmlСоздатьДочернийЭлементXDTO(НовЛотXDTO,"manufacturer");
	xmlЗаписатьContractor_XDTO(НовЛотXDTO.manufacturer,	"manufacturer",	СтрокаЛота.АлкоПроизводительEDI);
	
	Если ЕстьИностранныйПроизводитель Тогда
		xmlСоздатьДочернийЭлементXDTO(НовЛотXDTO,"foreignManufacturer");
		xmlЗаписатьContractor_XDTO(НовЛотXDTO.foreignManufacturer, "foreignManufacturer",	СтрокаЛота.АлкоИностранныйПроизводительEDI);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаЛота.АлкоЛицензияПоставщика) Тогда
		
		xmlСоздатьДочернийЭлементXDTO(НовЛотXDTO,"licenseSeller");
		
		xmlЗаполнитьЗначениеXDTO(НовЛотXDTO.licenseSeller,	"issuerOf",		СтрокаЛота.АлкоЛицензияПоставщика.КемВыдана);
		xmlЗаполнитьЗначениеXDTO(НовЛотXDTO.licenseSeller,	"enddate",		СтрокаЛота.АлкоЛицензияПоставщика.ДатаОкончания);
		xmlЗаполнитьЗначениеXDTO(НовЛотXDTO.licenseSeller,	"startdate",	СтрокаЛота.АлкоЛицензияПоставщика.ДатаНачала);
		xmlЗаполнитьЗначениеXDTO(НовЛотXDTO.licenseSeller,	"seriesNumber",	СтрокаЛота.АлкоЛицензияПоставщика.Серия);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаЛота.АлкоСертификатПродукции) Тогда
		
		xmlСоздатьДочернийЭлементXDTO(НовЛотXDTO,"certificate");
		
		xmlЗаполнитьЗначениеXDTO(НовЛотXDTO.certificate,	"issuerOf",		СтрокаЛота.АлкоСертификатПродукции.КемВыдана);
		xmlЗаполнитьЗначениеXDTO(НовЛотXDTO.certificate,	"enddate",		СтрокаЛота.АлкоСертификатПродукции.ДатаОкончания);
		xmlЗаполнитьЗначениеXDTO(НовЛотXDTO.certificate,	"startdate",	СтрокаЛота.АлкоСертификатПродукции.ДатаНачала);
		xmlЗаполнитьЗначениеXDTO(НовЛотXDTO.certificate,	"number",	СтрокаЛота.АлкоСертификатПродукции.Серия);
		
	КонецЕсли;
	
	АлкоКодПродукции = "";
	Если ЗначениеЗаполнено(СтрокаЛота.АлкоКодПродукции) Тогда
		АлкоКодПродукции = СокрЛП(СтрокаЛота.АлкоКодПродукции);
	КонецЕсли;
	
	xmlЗаполнитьЗначениеXDTO(НовЛотXDTO,	"typeOfAlco",	СокрЛП(АлкоКодПродукции));
	xmlЗаполнитьЗначениеXDTO(НовЛотXDTO,	"signOfAlco",	СокрЛП(СтрокаЛота.АлкоПризнакТипаПродукции));
	xmlЗаполнитьЗначениеXDTO(НовЛотXDTO,	"bottlingDate",	СтрокаЛота.АлкоДатаРозлива);
	
	xmlЗаполнитьЗначениеXDTO(НовЛотXDTO,	"countryOfOriginISOCode",	СтрокаЛота.СтранаEDI);
	xmlЗаполнитьЗначениеXDTO(НовЛотXDTO,	"customsDeclarationNumber",	СтрокаЛота.НомерГТДEDI);
	
КонецПроцедуры

//Заполнение секции lineItems - контейнер для массива lineItem, не путать с единичным lineItem
Процедура xmlЗаписатьLineItemS_XDTO(ОбъектlineItems,Сообщение,ИмяКоличества)
	
	НеОтправлятьКодПоставщика = (ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, "НеОтправлятьКодПоставщика") = Истина);
	
	Если НЕ Сообщение.ТипСообщения = "ALCRPT" Тогда
		ОбъектlineItems.currencyISOCode = Сообщение.ВалютаEDI;
	КонецЕсли;
	
	Если Сообщение.ТипСообщения = "ALCRPT" Тогда //разбил на 2 отдельных условия, так удобнее визуально
		
		// Поправил чтобы Номенклатура шла в LineItem, а серия в lot
			//таблица товаров сворачивается: 
			//Номенклатура+Серия пишется в lineItem
			//А номера ГТД и лицензии идут в LOT
		
		ЕстьИностранныйПроизводитель = НЕ (Сообщение.Товары.Колонки.Найти("АлкоИностранныйПроизводительEDI") = Неопределено);
		
		//КолонкиДляСвертки = "Номенклатура,СерияНоменклатуры";
		КолонкиДляСвертки = "Номенклатура";
		
		ТаблицаТоваров_Свернутая = Сообщение.Товары.Скопировать(,КолонкиДляСвертки);
		ТаблицаТоваров_Свернутая.Свернуть(КолонкиДляСвертки);
		Для Каждого СтрокаТовара_Свернутая Из ТаблицаТоваров_Свернутая Цикл
			
			СтруктураПоиска = Новый Структура(КолонкиДляСвертки,СтрокаТовара_Свернутая.Номенклатура);
			СтрокиЛота = Сообщение.Товары.НайтиСтроки(СтруктураПоиска);
			ПерваяСтрокаЛота = СтрокиЛота[0];//отсюда возьмем коды товара. Проверка в данном случае не требуется.
			
			НовСтрокаLineItem = ДобавитьЭлементСпискаXDTO(ОбъектlineItems.lineItem,ФабрикаXDTO_EdiXml());
			
			xmlЗаполнитьЗначениеXDTO(НовСтрокаLineItem, "gtin",					ПерваяСтрокаЛота.GTIN);
						
			Если ЗначениеЗаполнено(ПерваяСтрокаЛота.КодТовараВнутренний) Тогда
				xmlЗаполнитьЗначениеXDTO(НовСтрокаLineItem, "externalProductId", ПерваяСтрокаЛота.КодТовараВнутренний);
			КонецЕсли;
						
			xmlЗаполнитьКодыТовара_LineItemXDTO(
			НовСтрокаLineItem, 
			ПерваяСтрокаЛота.КодТовараПокупателя, 
			ПерваяСтрокаЛота.КодТовараПоставщика, 
			НеОтправлятьКодПоставщика, 
			Сообщение.ТипСообщения); 
			 												
			Для Каждого СтрокаЛота Из СтрокиЛота Цикл
				
				НовЛотXDTO = ДобавитьЭлементСпискаXDTO(НовСтрокаLineItem.lot,ФабрикаXDTO_EdiXml());
				//секция "lot"
				xmlЗаписатьAlcoLot_XDTO(НовЛотXDTO,СтрокаЛота,ЕстьИностранныйПроизводитель);

			КонецЦикла;
			
		КонецЦикла;	
		
	КонецЕсли;
	
	Если Не Сообщение.ТипСообщения = "ALCRPT" Тогда //разбил на 2 отдельных условия, так удобнее визуально
	
		СтруктураКолонок = Новый Структура;
		
		СтруктураКолонок.Вставить("ЕстьКомментарий", 				НЕ (Сообщение.Товары.Колонки.Найти("Комментарий") = Неопределено));
		СтруктураКолонок.Вставить("ЕстьТипЕдиницы",					НЕ (Сообщение.Товары.Колонки.Найти("ТипЕдиницы") = Неопределено));
		СтруктураКолонок.Вставить("ЕстьКоличествоЗаказанное", 		НЕ (Сообщение.Товары.Колонки.Найти("КоличествоЗаказанное") = Неопределено));
		СтруктураКолонок.Вставить("ЕстьКоличествоВОдномМесте",		НЕ (Сообщение.Товары.Колонки.Найти("КоличествоВОдномМесте") = Неопределено));
		СтруктураКолонок.Вставить("ЕстьКодТовараЕГАИС",				Не (Сообщение.Товары.Колонки.Найти("КодТовараВЕГАИС") = Неопределено));
		СтруктураКолонок.Вставить("ЕстьНомерУпаковки", 				Не (Сообщение.Товары.Колонки.Найти("НомерУпаковки") = Неопределено));
		СтруктураКолонок.Вставить("ЕстьДополнительнаяИнформация", 	Не (Сообщение.Товары.Колонки.Найти("ДополнительнаяИнформация") = Неопределено));
		СтруктураКолонок.Вставить("ЕстьДанныеОПроизводителе", 		Не (Сообщение.Товары.Колонки.Найти("ПроизводительEDI") = Неопределено));

		Для Каждого Стр ИЗ Сообщение.Товары Цикл
			
			НоваяСтрока = ДобавитьЭлементСпискаXDTO(ОбъектlineItems.lineItem,ФабрикаXDTO_EdiXml());
			
			ЕстьЕдиницаИзмеренияКоличества = Истина;
			Если Сообщение.ТипСообщения = "ORDRSP" И Не ЗначениеЗаполнено(Стр.КодЕдиницыИзмерения1С) Тогда
				ЕстьЕдиницаИзмеренияКоличества = Ложь;
			КонецЕсли;
			
			СтруктураКолонок.Вставить("ЕстьЕдиницаИзмеренияКоличества", ЕстьЕдиницаИзмеренияКоличества);
			
			//секция lineitem
			xmlЗаписатьLineItem_XDTO(НоваяСтрока, Стр, Сообщение, НеОтправлятьКодПоставщика, ИмяКоличества, СтруктураКолонок);
			
		КонецЦикла;
		
		//lineItems итоги
		Если Сообщение.ТипСообщения = "COINVOIC" Тогда
			xmlЗаполнитьЗначениеXDTO(ОбъектlineItems, "totalSumExcludingTaxesIncrease",		Сообщение.СуммаВсегоБезНДСУвеличение,	Истина);
			xmlЗаполнитьЗначениеXDTO(ОбъектlineItems, "totalSumExcludingTaxesDecrease",		Сообщение.СуммаВсегоБезНДСУменьшение,	Истина);
			xmlЗаполнитьЗначениеXDTO(ОбъектlineItems, "totalVATAmountIncrease",			 	Сообщение.СуммаВсегоНДСУвеличение,		Истина);
			xmlЗаполнитьЗначениеXDTO(ОбъектlineItems, "totalVATAmountDecrease",			 	Сообщение.СуммаВсегоНДСУменьшение,		Истина);
			xmlЗаполнитьЗначениеXDTO(ОбъектlineItems, "totalAmountIncrease",			 	Сообщение.СуммаВсегоУвеличение,			Истина);
			xmlЗаполнитьЗначениеXDTO(ОбъектlineItems, "totalAmountDecrease",			 	Сообщение.СуммаВсегоУменьшение,			Истина);
			
		Иначе
			xmlЗаполнитьЗначениеXDTO(ОбъектlineItems, "totalAmount",			 	Сообщение.СуммаВсего, Истина); //эта сумма должна быть всегда
			xmlЗаполнитьЗначениеXDTO(ОбъектlineItems, "totalSumExcludingTaxes",	 	Сообщение.СуммаВсегоБезНДС, Истина);
			xmlЗаполнитьЗначениеXDTO(ОбъектlineItems, "totalVATAmount",	 			Сообщение.СуммаВсегоНДС, Истина); //эта сумма должна быть всегда
		КонецЕсли;
		
		
		
		Если Сообщение.ТипСообщения = "INVOIC"
			И Сообщение.Свойство("СуммаТоваровВсего")
			И Сообщение.Свойство("СуммаТоваровВсегоБезНДС")
			И Сообщение.Свойство("СуммаТоваровНДС")
			Тогда
			
			//3 тега "ForIV" для Счет-фактуры
			
			xmlЗаписатьTotalSumFor_XDTO(ОбъектlineItems,	"totalAmountForIV",				Сообщение.ДокументEDI.Номер,	Сообщение.СуммаТоваровВсего);
			xmlЗаписатьTotalSumFor_XDTO(ОбъектlineItems,	"totalSumExcludingTaxesForIV",	Сообщение.ДокументEDI.Номер,	Сообщение.СуммаТоваровВсегоБезНДС);
			xmlЗаписатьTotalSumFor_XDTO(ОбъектlineItems,	"totalVATAmountForIV",			Сообщение.ДокументEDI.Номер,	Сообщение.СуммаТоваровНДС);
			
			//и еще 3 тега "ForDQ" для ТОРГ12
			
			xmlЗаписатьTotalSumFor_XDTO(ОбъектlineItems,	"totalAmountForDQ",				Сообщение.НакладнаяEDI.Номер,	Сообщение.Товары.Итог("СуммаСНДС"));
			xmlЗаписатьTotalSumFor_XDTO(ОбъектlineItems,	"totalSumExcludingTaxesForDQ",	Сообщение.НакладнаяEDI.Номер,	Сообщение.Товары.Итог("СуммаБезНДС"));
			xmlЗаписатьTotalSumFor_XDTO(ОбъектlineItems,	"totalVATAmountForDQ",			Сообщение.НакладнаяEDI.Номер,	Сообщение.Товары.Итог("СуммаНДС"));
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

//Заполнение секции lineItem - одна строка товаров
Процедура xmlЗаписатьLineItem_XDTO(lineItem, СтрокаТоваров, Сообщение, НеОтправлятьКодПоставщика, ИмяКоличества, СтруктураКолонок)
	
	Если СтруктураКолонок.ЕстьНомерУпаковки Тогда
		xmlЗаполнитьЗначениеXDTO(lineItem,	"packageLevel",	СтрокаТоваров.НомерУпаковки);
	КонецЕсли;

	Если Сообщение.ТипСообщения = "ORDRSP" ИЛИ Сообщение.ТипСообщения = "RETREC" ИЛИ Сообщение.ТипСообщения = "RETINS" Тогда  //   
		xmlЗаполнитьЗначениеXDTO(lineItem,	"status",	ПреобразоватьСтатус(СтрокаТоваров.Статус));
	КонецЕсли;

	xmlЗаполнитьЗначениеXDTO(lineItem,	"gtin",	СтрокаТоваров.GTIN);
		
	Если Сообщение.ТипСообщения = "DESADV" Тогда
		xmlЗаполнитьЗначениеXDTO(lineItem,	"lotNumberEgais",	СтрокаТоваров.ИдентификаторПозицииВТТНЕГАИС);	
		Если СтруктураКолонок.ЕстьКодТовараЕГАИС Тогда
			xmlЗаполнитьЗначениеXDTO(lineItem,	"codeOfEgais",	СтрокаТоваров.КодТовараВЕГАИС);	
		КонецЕсли;
		Если СтруктураКолонок.ЕстьДанныеОПроизводителе И ЗначениеЗаполнено(СтрокаТоваров.ПроизводительEDI) Тогда
			xmlСоздатьДочернийЭлементXDTO(lineItem, "manufacturer");
			xmlЗаписатьContractor_XDTO(lineItem.manufacturer,	"manufacturer",	СтрокаТоваров.ПроизводительEDI, Истина);
		КонецЕсли;	
	КонецЕсли;

	xmlЗаполнитьЗначениеXDTO(lineItem,"description",			СтрокаТоваров.Наименование);
	        		
	xmlЗаполнитьКодыТовара_LineItemXDTO(
	lineItem, 
	СтрокаТоваров.КодТовараПокупателя, 
	СтрокаТоваров.КодТовараПоставщика, 
	НеОтправлятьКодПоставщика, 
	Сообщение.ТипСообщения);    	 
	
	Если ЗначениеЗаполнено(СтрокаТоваров.КодТовараВнутренний) Тогда
		xmlЗаполнитьЗначениеXDTO(lineItem,"externalProductId",	СтрокаТоваров.КодТовараВнутренний);
	КонецЕсли; 
	
	Если СтруктураКолонок.ЕстьКоличествоЗаказанное Тогда
		//в Coinvoic вроде не требуется
		xmlЗаписатьQuantityType_XDTO(lineItem,	"orderedQuantity",	СтрокаТоваров.КоличествоЗаказанное);
	КонецЕсли;
	
	_КодЕдиницыИзмеренияEDI = ?(СтруктураКолонок.ЕстьЕдиницаИзмеренияКоличества, СтрокаТоваров.КодЕдиницыИзмеренияEDI, "");
	
	_КоличествоВОдномМесте = ?(СтруктураКолонок.ЕстьКоличествоВОдномМесте, СтрокаТоваров.КоличествоВОдномМесте, "");
	xmlЗаписатьQuantityType_XDTO(lineItem,	"onePlaceQuantity",	_КоличествоВОдномМесте);
	
	Если Сообщение.ТипСообщения = "RETINS" Тогда
		xmlСоздатьДочернийЭлементXDTO(lineItem, "physicalOrLogicalState");
		
		xmlЗаполнитьЗначениеXDTO(lineItem.physicalOrLogicalState, "state",						ПолучитьЗначениеПеречисленияEDI(СтрокаТоваров.РешениеПоВозврату, "ДействиеПоВозврату"));
		
		xmlЗаполнитьЗначениеXDTO(lineItem.physicalOrLogicalState, "stateDescription",			СтрокаТоваров.ПричинаРешения);
		xmlЗаполнитьЗначениеXDTO(lineItem.physicalOrLogicalState, "stateDescriptionFromBuyer", 	СтрокаТоваров.ПричинаРешенияОтПокупателя);
		
		xmlЗаписатьQuantityType_XDTO(lineItem,	"offeredReturnQuantity", СтрокаТоваров.КоличествоПредложеноКВозврату);
	КонецЕсли;
	
	Если Сообщение.ТипСообщения = "RETANN" Тогда
		xmlСоздатьДочернийЭлементXDTO(lineItem, "physicalOrLogicalState");
		
		xmlЗаполнитьЗначениеXDTO(lineItem.physicalOrLogicalState, "state",	 		  ПолучитьЗначениеПеречисленияEDI(СтрокаТоваров.ЗапрашиваемоеДействие, "ДействиеПоВозврату"));
		xmlЗаполнитьЗначениеXDTO(lineItem.physicalOrLogicalState, "stateDescription", ПолучитьЗначениеПеречисленияEDI(СтрокаТоваров.ПричинаВозврата, "ПричинаВозврата"));
		
		physicalDimensions = xmlСоздатьДочернийЭлементXDTO(lineItem, "physicalDimensions");
		
		Если ЗначениеЗаполнено(СтрокаТоваров.ВесНетто) Тогда
			xmlЗаписатьQuantityType_XDTO(physicalDimensions, "netWeight", 	СтрокаТоваров.ВесНетто, 	СтрокаТоваров.КодЕдиницыИзмеренияНетто);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТоваров.ВесБрутто) Тогда
			xmlЗаписатьQuantityType_XDTO(physicalDimensions, "grossWeight", 	СтрокаТоваров.ВесБрутто, 	СтрокаТоваров.КодЕдиницыИзмеренияБрутто);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТоваров.НомерНакладной) Тогда
			xmlСоздатьДочернийЭлементXDTO(lineItem,		"deliveryNoteIdentificator");
			xmlЗаписатьdeliveryNoteIdentificatorType_XDTO(lineItem.deliveryNoteIdentificator, СтрокаТоваров.НомерНакладной, СтрокаТоваров.ДатаНакладной,"", Ложь);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Сообщение.ТипСообщения = "COINVOIC" Тогда
		
		Если СтрокаТоваров.КоличествоДо <> 0 Тогда
			xmlЗаписатьQuantityType_XDTO(lineItem,"quantityBefore",		СтрокаТоваров.КоличествоДо, _КодЕдиницыИзмеренияEDI,	Истина);
		КонецЕсли;
		
		//все поля ниже должны обязательно присутствовать в файле, даже если 0  		
		xmlЗаписатьQuantityType_XDTO(lineItem,"quantityAfter",		СтрокаТоваров.КоличествоПосле, _КодЕдиницыИзмеренияEDI,	Истина);
		xmlЗаписатьQuantityType_XDTO(lineItem,"quantityIncrease",	СтрокаТоваров.КоличествоУвеличение, _КодЕдиницыИзмеренияEDI);
		xmlЗаписатьQuantityType_XDTO(lineItem,"quantityDecrease",	СтрокаТоваров.КоличествоУменьшение, _КодЕдиницыИзмеренияEDI);
		
		lineItem.netPriceBefore		= СтрокаТоваров.ЦенаБезНДСДо;
		lineItem.netPriceAfter		= СтрокаТоваров.ЦенаБезНДСПосле;
		xmlЗаполнитьЗначениеXDTO(lineItem, "netPriceIncrease",		СтрокаТоваров.ЦенаБезНДСУвеличение);
		xmlЗаполнитьЗначениеXDTO(lineItem, "netPriceDecrease",		СтрокаТоваров.ЦенаБезНДСУменьшение);
		
		lineItem.netPriceWithVAT	= СтрокаТоваров.ЦенаСНДСПосле;
		
		lineItem.netAmountBefore	= СтрокаТоваров.СуммаБезНДСДо;
		lineItem.netAmountAfter		= СтрокаТоваров.СуммаБезНДСПосле;
		xmlЗаполнитьЗначениеXDTO(lineItem, "netAmountIncrease",		СтрокаТоваров.СуммаБезНДСУвеличение,	Истина);
		xmlЗаполнитьЗначениеXDTO(lineItem, "netAmountDecrease",		СтрокаТоваров.СуммаБезНДСУменьшение,	Истина);
		
		lineItem.amountBefore		= СтрокаТоваров.СуммаСНДСДо;
		lineItem.amountAfter		= СтрокаТоваров.СуммаСНДСПосле;
		xmlЗаполнитьЗначениеXDTO(lineItem, "amountIncrease",		СтрокаТоваров.СуммаСНДСУвеличение,		Истина);
		xmlЗаполнитьЗначениеXDTO(lineItem, "amountDecrease",		СтрокаТоваров.СуммаСНДСУменьшение,		Истина);
		
		xmlЗаполнитьЗначениеXDTO(lineItem,	"vatRateBefore",		СтрокаТоваров.СтавкаНДСДоEDI);
		xmlЗаполнитьЗначениеXDTO(lineItem,	"vatRateAfter",			СтрокаТоваров.СтавкаНДСПослеEDI);
		
		lineItem.vatAmountBefore	= СтрокаТоваров.СуммаНДСДо;
		lineItem.vatAmountAfter		= СтрокаТоваров.СуммаНДСПосле;
		// EDI1C-2370
		НезаполненоКакНоль = ?(СтрокаТоваров.СуммаНДСДо = СтрокаТоваров.СуммаНДСПосле, Истина, Ложь);
		xmlЗаполнитьЗначениеXDTO(lineItem, "vatAmountIncrease",		СтрокаТоваров.СуммаНДСУвеличение, 	НезаполненоКакНоль);
		xmlЗаполнитьЗначениеXDTO(lineItem, "vatAmountDecrease",		СтрокаТоваров.СуммаНДСУменьшение);
		
	Иначе
		
		Если ИмяКоличества = "confirmedQuantity" 
			ИЛИ ИмяКоличества = "confirmedReturnQuantity" Тогда
			xmlЗаписатьQuantityType_XDTO(lineItem,	ИмяКоличества,	СтрокаТоваров.Количество,	_КодЕдиницыИзмеренияEDI, Истина);//0?
		Иначе
			xmlЗаписатьQuantityType_XDTO(lineItem,	ИмяКоличества,	СтрокаТоваров.Количество,	_КодЕдиницыИзмеренияEDI);//0?
		КонецЕсли;	
			
		xmlЗаполнитьЗначениеXDTO(lineItem,	"netPrice",				СтрокаТоваров.ЦенаБезНДС);
		xmlЗаполнитьЗначениеXDTO(lineItem,	"netAmount",			СтрокаТоваров.СуммаБезНДС);
		xmlЗаполнитьЗначениеXDTO(lineItem,	"netPriceWithVAT",		СтрокаТоваров.ЦенаСНДС);
		xmlЗаполнитьЗначениеXDTO(lineItem,	"amount",				СтрокаТоваров.СуммаСНДС);
		xmlЗаполнитьЗначениеXDTO(lineItem,	"vATRate",				СтрокаТоваров.СтавкаНДСEDI);
		
		lineItem.vATAmount = СтрокаТоваров.СуммаНДС;
		
	КонецЕсли;
	
	//xmlЗаполнитьЗначениеXDTO(lineItem,	"countryOfOriginISOCode",	СтрокаТоваров.СтранаEDI);
	xmlЗаписатьcountryOfOriginISOCode_XDTO(lineItem,СтрокаТоваров);	
	xmlЗаписатьcustomsDeclarationNumber_XDTO(lineItem,СтрокаТоваров);	
	
	Если СтруктураКолонок.ЕстьКомментарий Тогда
		xmlЗаполнитьЗначениеXDTO(lineItem,	"comment",		СтрокаТоваров.Комментарий);
	КонецЕсли;

	Если СтруктураКолонок.ЕстьТипЕдиницы	Тогда
		xmlЗаполнитьЗначениеXDTO(lineItem,	"typeOfUnit",	Строка(СтрокаТоваров.ТипЕдиницы));
	КонецЕсли;
 
	Если СтрСодержит_КонтурEDI("ORDERS,ORDRSP,DESADV", Сообщение.ТипСообщения) Тогда
		
		Если ЗначениеЗаполнено(СтрокаТоваров.ФасовкаТовара) Тогда
			
			СтрокиФасовки = Сообщение.Фасовка.НайтиСтроки(Новый Структура("ФасовкаТовара", СтрокаТоваров.ФасовкаТовара));
			
			//секция "packages" 
			packages = xmlСоздатьДочернийЭлементXDTO(lineItem,	"packages");
			
			Для каждого Упаковка Из СтрокиФасовки Цикл
				packageForItem = ДобавитьЭлементСпискаXDTO(packages.packageForItem, ФабрикаXDTO_EdiXml());
				
				xmlЗаполнитьЗначениеXDTO(packageForItem, "packageTypeCode", Упаковка.КодТипаУпаковки); 
				xmlЗаполнитьЗначениеXDTO(packageForItem, "packageQuantity", Упаковка.Количество); 
				
				Если ЗначениеЗаполнено(Упаковка.КоличествоВОднойУпаковке) Тогда
					xmlЗаписатьQuantityType_XDTO(packageForItem, "onePackageQuantity", Упаковка.КоличествоВОднойУпаковке, Упаковка.КодЕдиницыИзмеренияКоличестваВОднойУпаковке);
				КонецЕсли;
				packageMeasurementInfo = xmlСоздатьДочернийЭлементXDTO(packageForItem, "packageMeasurementInfo");
				Если ЗначениеЗаполнено(Упаковка.КоличествоСлоев) Тогда
					xmlЗаписатьQuantityType_XDTO(packageMeasurementInfo, "numberOfLayers", Упаковка.КоличествоСлоев, Упаковка.КодЕдиницыИзмеренияКоличестваСлоев);
				КонецЕсли;
				Если ЗначениеЗаполнено(Упаковка.КоличествоВСлое) Тогда
					xmlЗаписатьQuantityType_XDTO(packageMeasurementInfo, "numberOfItemsPerLayer", Упаковка.КоличествоВСлое, Упаковка.КодЕдиницыИзмеренияКоличестваВСлое);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТоваров.МаксимальныйВесПалеты) Тогда
			xmlЗаписатьQuantityType_XDTO(lineItem, "maximumPalletWeight", СтрокаТоваров.МаксимальныйВесПалеты, СтрокаТоваров.КодЕдиницыИзмеренияМаксимальногоВесаПалеты);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТоваров.МаксимальнаяВысотаПалеты) Тогда
			xmlЗаписатьQuantityType_XDTO(lineItem, "maximumPalletHeight", СтрокаТоваров.МаксимальнаяВысотаПалеты, СтрокаТоваров.КодЕдиницыИзмеренияМаксимальнойВысотыПалеты);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТоваров.КоличествоВБлоке) Тогда
			xmlЗаписатьQuantityType_XDTO(lineItem, "innerPackQuantity", СтрокаТоваров.КоличествоВБлоке, СтрокаТоваров.КодЕдиницыИзмеренияКоличестваВБлоке);
		КонецЕсли;
		
		xmlЗаполнитьЗначениеXDTO(lineItem, "dimensions", 	СтрокаТоваров.Калибр); 
	КонецЕсли;
	
	xmlЗаполнитьЗначениеXDTO(lineItem, "flowType", 		СтрокаТоваров.ТипПоставки); 
	
	Если СтруктураКолонок.ЕстьДополнительнаяИнформация Тогда
		xmlЗаполнитьKeyValueTypeXDTO(lineItem, СтрокаТоваров.ДополнительнаяИнформация);
	КонецЕсли;

	Если СтрокаТоваров.ОтменаСуммированияПоПолям = Истина Тогда
		xmlЗаполнитьЗначениеXDTO(lineItem, "excludeFromSummation", СтрокаТоваров.ОтменаСуммированияПоПолям);
	КонецЕсли;
	
	Если Сообщение.ТипСообщения = "COINVOIC" Тогда
		xmlЗаполнитьКодыМаркировкиВСтрокеТовараИсходящегоСообщения(lineItem, СтрокаТоваров.КодыМаркировкиДо, "controlIdentificationMarksBefore");	
		xmlЗаполнитьКодыМаркировкиВСтрокеТовараИсходящегоСообщения(lineItem, СтрокаТоваров.КодыМаркировкиПосле, "controlIdentificationMarksAfter")
	Иначе
		xmlЗаполнитьКодыМаркировкиВСтрокеТовараИсходящегоСообщения(lineItem, СтрокаТоваров.КодыМаркировки);
	КонецЕсли;
		
	//Особенности сообщений, сформированные с помощью события ПМ ДобавитьОсобенностиСообщений
	ЗаполнитьОсобенностиLineitem_XDTO(lineItem, СтрокаТоваров, Сообщение);
	
	ОбработкаСобытияПодключаемогоМодуля("ПослеЗаполнения_LineItem_XDTO",,Новый Структура("lineItem,Сообщение,СтрокаТоваров",lineItem,Сообщение,СтрокаТоваров));
	
КонецПроцедуры

// Заполняет internalSupplierCode и internalBuyerCode в lineItem. 
// Заполнение зависит от параметра НеОтправлятьКодПоставщика
//
// Параметры:
//  lineItem  - ОбъектXDTO
//  КодТовараПокупателя  - Строка - код товара покупателя из строки сообщения
//  КодТовараПоставщика  - Строка - код товара поставщика из строки сообщения
//  НеОтправлятьКодПоставщика  - Булево - 
//									Если передано Истина и это не обратная отгрузка, то будет заполнен только internalBuyerCode.
//									Если передано Истина и это обратная отгрузка, то будет заполнен только internalSupplierCode.
//                                  Если передано Ложь, то будут заполнены internalBuyerCode и internalSupplierCode
//  ТипСообщения - Строка - Тип сообщения нужен для определения направления отгрузки (это обратная огрузка или обычная отгрузка).
Процедура xmlЗаполнитьКодыТовара_LineItemXDTO(
	lineItem, 
	КодТовараПокупателя, 
	КодТовараПоставщика, 
	НеОтправлятьКодПоставщика, 
	ТипСообщения)
	
	Если НеОтправлятьКодПоставщика = Истина Тогда
		
		Если ЭтоОбратнаяОтгрузка(ТипСообщения) Тогда			
			xmlЗаполнитьЗначениеXDTO(lineItem, "internalSupplierCode", КодТовараПоставщика);			
		Иначе      			
			xmlЗаполнитьЗначениеXDTO(lineItem, "internalBuyerCode", КодТовараПокупателя); 			
		КонецЕсли;
		
	Иначе
		
		xmlЗаполнитьЗначениеXDTO(lineItem, "internalBuyerCode", КодТовараПокупателя);
		xmlЗаполнитьЗначениеXDTO(lineItem, "internalSupplierCode", КодТовараПоставщика);
		
	КонецЕсли;

КонецПроцедуры

Процедура xmlЗаполнитьКодыМаркировкиВСтрокеТовараИсходящегоСообщения(lineItem, КодыМаркировки, ИмяЭлементаXDTO = "controlIdentificationMarks")
	
	Если НЕ ЗначениеЗаполнено(КодыМаркировки) Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого Элемент Из КодыМаркировки Цикл
		
		Код = Элемент.Значение;
		
		ВидКодаEDI = ПолучитьЗначениеПеречисленияEDI(Элемент.Представление, "ВидыКодовМаркировки");
		
		Если Не ЗначениеЗаполнено(ВидКодаEDI) Тогда
			ВидКодаEDI = "Unit";
		КонецЕсли;
		
		controlIdentificationMarks = xmlСоздатьДочернийЭлементXDTO(lineItem, ИмяЭлементаXDTO);
		xmlЗаполнитьЗначениеXDTO(controlIdentificationMarks, "__content", 	Код);
		xmlЗаполнитьЗначениеXDTO(controlIdentificationMarks, "type", 	ВидКодаEDI);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьОсобенностиLineitem_XDTO(lineItem,СтрокаТоваров,Сообщение)
	
	ТипСообщения = Сообщение.ТипСообщения;
	
	Для каждого ОсобенностьСообщения Из ОсобенностиСообщений Цикл
		
		Если НЕ ОсобенностьЕстьВСообщении(ОсобенностьСообщения,Сообщение) Тогда
			Продолжить;
		КонецЕсли;
		Если ОсобенностьСообщения.НеОтправлятьДанные Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ОсобенностьСообщения.Путьxml) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЭтоОсобенностьТоваров(ОсобенностьСообщения) Тогда
			Продолжить;
		КонецЕсли;
		
		ПолныйПутьОсобенности = ПолучитьПолныйПутьОсобенностиСообщения(ОсобенностьСообщения);
		
		ЗначениеПоляТоваров = "";
		Если НЕ ОсобенностьСообщения.ЭтоСтруктура
			И ЗначениеЗаполнено(ОсобенностьСообщения.ИмяСтруктуры) 
			И ЗначениеЗаполнено(ОсобенностьСообщения.ИмяТаблицы) Тогда
			ПроверитьСвойствоПоляВСтруктуре(СтрокаТоваров[ОсобенностьСообщения.ИмяТаблицы], ОсобенностьСообщения.Идентификатор, ЗначениеПоляТоваров); 
		Иначе
			ЗначениеПоляТоваров = СтрокаТоваров[ОсобенностьСообщения.Идентификатор]
		КонецЕсли;

		xmlЗаполнитьОсобенностьXDTO(lineItem, СтрЗаменить(ОсобенностьСообщения.Путьxml, "lineItem.", ""), ЗначениеПоляТоваров, , ОсобенностьСообщения);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура xmlЗаполнитьОсобенностьXDTO(ОбъектXDTO, ИмяПоля, Значение, НезаполненоКакНоль = Ложь, ОсобенностьСообщения = Неопределено) Экспорт
	//Отличается от xmlЗаполнитьЗначениеXDTO тем что можено передавать ИмяПоля с точками, при этом содержимое переменной "Значение" будет проброшено в последнее свойство
	//А если на пути встретится Список XDTO - то будет создан или заполнен первый элемент списка
	
	РазложенноеИмя = РазложитьСтроку(ИмяПоля,".");
	
	//проверка существования
	Если ОбъектXDTO.Свойства().Получить(РазложенноеИмя[0].Значение) = Неопределено Тогда
		Сообщить("Неудачная попытка заполнить поле XDTO: "+РазложенноеИмя[0].Значение);
		Возврат; //нечего заполнять
	КонецЕсли;
	
	Если РазложенноеИмя.Количество()>1 Тогда
		ТекущееИмя =  РазложенноеИмя[0].Значение;
		
		НовоеИмяПоля = СтрЗаменить(ИмяПоля,ТекущееИмя+".","");
		
		Если ОбъектXDTO[ТекущееИмя] = Неопределено Тогда
			//дочерний элемент объекта 
			xmlСоздатьДочернийЭлементXDTO(ОбъектXDTO, ТекущееИмя, Истина);
			xmlЗаполнитьОсобенностьXDTO(ОбъектXDTO[ТекущееИмя], НовоеИмяПоля, Значение, НезаполненоКакНоль, ОсобенностьСообщения);
			
		ИначеЕсли ТипЗнч(ОбъектXDTO[ТекущееИмя]) = Тип("СписокXDTO") Тогда
			
			Если ТипЗНЧ(Значение) = Тип("СписокЗначений") Тогда
				// нам передали колонку таблицы значений которую надо положить в Список XDTO
				//здесь важно понимать что мы можем заполнять таблицы значений с писок XDTO - для этого таблица пилится на списки значений
				//а списки значений уже толкаются в список XDTO
				//интерфейсно же, в карточке сообщения, таблица собирается из списков значений и отдается на редактирование пользователю
				
				//обойдем массив, проверим наличие строк и заполним
				й=0;
				Для каждого ЭлементСписка Из Значение Цикл
					й=й+1;
					Если ОбъектXDTO[ТекущееИмя].Количество() < й Тогда
						xmlСоздатьДочернийЭлементXDTO(ОбъектXDTO,ТекущееИмя,Истина); //+1 строка
					КонецЕсли;
					xmlЗаполнитьОсобенностьXDTO(ОбъектXDTO[ТекущееИмя][й-1],НовоеИмяПоля,ЭлементСписка.Значение, НезаполненоКакНоль, ОсобенностьСообщения);
				КонецЦикла;
			Иначе
				//мы будем пробрасывать с список XDTO не простое значение в первую строку (список будет содержать только 1 строку)
				//дочерний первый элемент списка
				Если ОбъектXDTO[ТекущееИмя].Количество() = 0 Тогда
					xmlСоздатьДочернийЭлементXDTO(ОбъектXDTO,ТекущееИмя,Истина); //+1 единственная строка
				КонецЕсли;
				xmlЗаполнитьОсобенностьXDTO(ОбъектXDTO[ТекущееИмя][0],НовоеИмяПоля,Значение, НезаполненоКакНоль, ОсобенностьСообщения);
			КонецЕсли;
		Иначе
			
			xmlЗаполнитьОсобенностьXDTO(ОбъектXDTO[ТекущееИмя],НовоеИмяПоля,Значение, НезаполненоКакНоль, ОсобенностьСообщения);
			
		КонецЕсли;
		
		
	Иначе
		//Это конечное свойство
		_Свойство = ОбъектXDTO.Свойства().Получить(ИмяПоля);
		Если НЕ Найти(Нрег(_Свойство.Тип.Имя), "quantitytype") = 0
			ИЛИ НЕ Найти(Нрег(_Свойство.Тип.Имя), "xmltimeinterval") = 0 Тогда
			ЕдиницаИзмерения = Неопределено;
			xmlЗаписатьQuantityType_XDTO(ОбъектXDTO, ИмяПоля, Значение, ЕдиницаИзмерения, НезаполненоКакНоль);
		ИначеЕсли НЕ Найти(Нрег(_Свойство.Тип.Имя), "contractor") = 0 Тогда
			ВыгрузкаТолькоОрганизации = Ложь;
			xmlЗаписатьContractor_XDTO(ОбъектXDTO, ИмяПоля, Значение, ВыгрузкаТолькоОрганизации);	
		ИначеЕсли _Свойство.Тип.Имя = "keyValuePairType" Тогда
			// Теперь в коробке, здесь заглушка
			
			//Если ЗначениеЗаполнено(Значение) Тогда
			//	КлючЗначениеСтроки = xmlСоздатьДочернийЭлементXDTO(ОбъектXDTO, "keyValuePair");
			//	КлючЗначениеСтроки.__content = Значение; 
			//	xmlЗаполнитьЗначениеXDTO(КлючЗначениеСтроки, "key", ОсобенностьСообщения.Идентификатор, НезаполненоКакНоль);
			//КонецЕсли;
				
		Иначе
			xmlЗаполнитьЗначениеXDTO(ОбъектXDTO, ИмяПоля, Значение, НезаполненоКакНоль);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура xmlЗаполнитьKeyValueTypeXDTO(ОбъектXDTO, Значение)
	
	Если ТипЗнч(Значение) = Тип("Структура")
		И ЗначениеЗаполнено(Значение) Тогда
		
		additionalInformation = xmlСоздатьДочернийЭлементXDTO(ОбъектXDTO, "additionalInformation");
		
		Для каждого Эл Из Значение Цикл
			
			НезаполненоКакНоль = ТипЗнч(Эл.Значение) = Тип("Число");
			Если НЕ ЗначениеЗаполнено(Эл.Значение)
				И НЕ НезаполненоКакНоль Тогда
				Продолжить;
			КонецЕсли;
			
			keyValuePair = xmlСоздатьДочернийЭлементXDTO(additionalInformation, "keyValuePair");
			
			xmlЗаполнитьЗначениеXDTO(keyValuePair, "key", 		Эл.Ключ);
			xmlЗаполнитьЗначениеXDTO(keyValuePair, "__content", Эл.Значение, 	НезаполненоКакНоль);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьОсобенностиДокумента_XDTO(ОбъектДокумента,Сообщение,ТипСообщения)
	
	Для каждого ОсобенностьСообщения Из ОсобенностиСообщений Цикл
		
		Если НЕ ОсобенностьЕстьВСообщении(ОсобенностьСообщения,Сообщение) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОсобенностьСообщения.НеОтправлятьДанные Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ОсобенностьСообщения.Путьxml) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭтоОсобенностьТоваров(ОсобенностьСообщения) Тогда
			Продолжить;
		КонецЕсли;
		
		ПолныйПутьОсобенности = ПолучитьПолныйПутьОсобенностиСообщения(ОсобенностьСообщения);
		ПолныйПутьОсобенностиXML = ПолучитьПолныйПутьОсобенностиXML(ОсобенностиСообщений, ОсобенностьСообщения);
		
		ЗначениеСвойстваСообщения = "";
		
		Если ПроверитьСвойствоПоляВСтруктуре(Сообщение, ПолныйПутьОсобенности, ЗначениеСвойстваСообщения) Тогда 
			
			xmlЗаполнитьОсобенностьXDTO(ОбъектДокумента, ПолныйПутьОсобенностиXML, ЗначениеСвойстваСообщения, , ОсобенностьСообщения);
						
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СкорректироватьТипКодовОСУВТоварах(lineItems)
	
	Если Не ТипЗнч(lineItems) = Тип("СписокXDTO") 
		ИЛИ lineItems.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	ВозможныеЭлементыКодовМаркировки = Новый Массив;
	ВозможныеЭлементыКодовМаркировки.Добавить("controlIdentificationMarks");
	ВозможныеЭлементыКодовМаркировки.Добавить("controlIdentificationMarksBefore");
	ВозможныеЭлементыКодовМаркировки.Добавить("controlIdentificationMarksAfter");
	
	СвойстваСтроки = lineItems.ВладеющееСвойство.Тип.Свойства;
	
	Для каждого ИмяЭлемента Из ВозможныеЭлементыКодовМаркировки Цикл
		
		Если СвойстваСтроки.Получить(ИмяЭлемента) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для каждого СтрокаТовара Из lineItems Цикл
			СкорректироватьТипКодаОСУВКодахМаркировкиXDTO(СтрокаТовара[ИмяЭлемента]);
		КонецЦикла;
		
	КонецЦикла;
		
КонецПроцедуры

Процедура СкорректироватьТипКодаОСУВКодахМаркировкиXDTO(КодыМаркировкиXDTO)
	
	Если Не ТипЗнч(КодыМаркировкиXDTO) = Тип("СписокXDTO") Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого КодМаркировкиXDTO Из КодыМаркировкиXDTO Цикл
		
		Тип = НРег(КодМаркировкиXDTO.type);
		Код = КодМаркировкиXDTO.__content;
		
		Если Тип = "group" И ЭтоКодОСУ_КонтурEDI(Код) Тогда 
			КодМаркировкиXDTO.type = "osu";
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ЭтоКодОСУ_КонтурEDI(Код) 
	
	ЭтоКодОСУ = Ложь;
	
	Если ЗначениеЗаполнено(Код) 
		И СтрДлина(Код) > 18 
		И Лев(Код, 2) = "02" 
		И Сред(Код, 17, 2) = "37" Тогда
		
		ЭтоКодОСУ = Истина;
		
	КонецЕсли;
	
	Возврат ЭтоКодОСУ;
	
КонецФункции

Функция ПолучитьПолныйПутьОсобенностиXML(ОсобенностиСообщений, ОсобенностьСообщения)
	
	Путьxml = "";
	ОсобенностьРодитель = Неопределено;
	
	Если ЗначениеЗаполнено(ОсобенностьСообщения.ИмяСтруктуры)
		И Найти(ОсобенностьСообщения.Путьxml, ".") = 0 Тогда
		
		Отбор = Новый Структура("ЭтоСтруктура,ИмяСтруктуры", Истина, ОсобенностьСообщения.ИмяСтруктуры);
		НайденныеОсобенности = ОсобенностиСообщений.НайтиСтроки(Отбор);
		
		Если ЗначениеЗаполнено(НайденныеОсобенности) Тогда
			ОсобенностьРодитель = НайденныеОсобенности[0];	
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОсобенностьРодитель <> Неопределено Тогда
		
		Путьxml = ОсобенностьРодитель.Путьxml + "." + ОсобенностьСообщения.Путьxml;	
		
	Иначе
		
		Путьxml = ОсобенностьСообщения.Путьxml;
		
	КонецЕсли;
	
	Возврат Путьxml; 
	
КонецФункции

//Заполнение секций с типом quantityType
Процедура xmlЗаписатьQuantityType_XDTO(ОбъектXDTO, ИмяРеквизита, Количество, ЕдиницаИзмерения = Неопределено, ЗаписьОбязательна = Ложь, ВалютаЦены = Неопределено)  

	Если Не ЗначениеЗаполнено(Количество)
		И Не ЗначениеЗаполнено(ЕдиницаИзмерения) 
		И Не ЗаписьОбязательна Тогда
		Возврат;
	КонецЕсли;
	
	xmlСоздатьДочернийЭлементXDTO(ОбъектXDTO, ИмяРеквизита);
	
	ОбъектXDTO[ИмяРеквизита].__content = Количество;
	Если НЕ ЕдиницаИзмерения = Неопределено Тогда
		xmlЗаполнитьЗначениеXDTO(ОбъектXDTO[ИмяРеквизита], "unitOfMeasure",	ЕдиницаИзмерения);
	КонецЕсли;
	
	Если НЕ ВалютаЦены = Неопределено Тогда
		xmlЗаполнитьЗначениеXDTO(ОбъектXDTO[ИмяРеквизита], "currencyISOCode", ВалютаЦены);
	КонецЕсли;  

КонецПроцедуры

Процедура xmlЗаписатьdeliveryNoteIdentificatorType_XDTO(ПолеXDTO, НомерНакладной, ДатаНакладной = Неопределено,id = "", ЗаписьОбязательна = Ложь)

	Если Не ЗначениеЗаполнено(НомерНакладной)
		И Не ЗначениеЗаполнено(ДатаНакладной) 
		И Не ЗаписьОбязательна Тогда
		Возврат;
	КонецЕсли;
	
	xmlЗаполнитьЗначениеXDTO(ПолеXDTO, "number",	НомерНакладной);
	xmlЗаполнитьЗначениеXDTO(ПолеXDTO, "date",		?(ЗначениеЗаполнено(ДатаНакладной),ДатаНакладной,Дата(1,1,1)));
	xmlЗаполнитьЗначениеXDTO(ПолеXDTO, "id",	?(ЗначениеЗаполнено(id),id,""));
	
КонецПроцедуры 

//Заполнение секций с типом shelfLifeType
Процедура xmlЗаписатьShelfLifeType_XDTO(ОбъектXDTO,ИмяРеквизита,Количество,ЕдиницаИзмерения=Неопределено,ЗаписьОбязательна = Ложь)
	
	Если Не ЗначениеЗаполнено(Количество)
		И (Не ЗначениеЗаполнено(ЕдиницаИзмерения) И ТипЗнч(Количество) = Тип("Число")) 
		И Не ЗаписьОбязательна Тогда
		Возврат;
	КонецЕсли;
	
	xmlСоздатьДочернийЭлементXDTO(ОбъектXDTO,ИмяРеквизита);
	ОбъектXDTO[ИмяРеквизита].__content = Формат(Количество, "ЧЦ=10; ЧГ=; ДФ=yyyy-MM-dd");
	
	Если ТипЗнч(Количество) = Тип("Дата") Тогда		
		xmlЗаполнитьЗначениеXDTO(ОбъектXDTO[ИмяРеквизита], "unit",	"Date");    
	Иначе
		xmlЗаполнитьЗначениеXDTO(ОбъектXDTO[ИмяРеквизита], "unit",	ЕдиницаИзмерения); 
	КонецЕсли;
		
КонецПроцедуры

//Заполнение секций с типом totalSumFor... (IV,DQ)
Процедура xmlЗаписатьTotalSumFor_XDTO(ОбъектXDTO,ИмяРеквизита,НомерДокумента,Сумма)
	
	xmlСоздатьДочернийЭлементXDTO(ОбъектXDTO,ИмяРеквизита);
	
	ОбъектXDTO[ИмяРеквизита].__content		= Сумма;
	ОбъектXDTO[ИмяРеквизита].documentNumber = НомерДокумента;
	
КонецПроцедуры

//блок заполнения тегов вроде despatchIdentificator, originOrder, contractIdentificator, egaisRegistrationIdentificator и т.е.
Процедура xmlЗаписатьИдентификаторыДокументовВСообщениеXDTO(ОбъектДокумента,Сообщение)
	
	xmlЗаполнитьDocumentIdentificator(ОбъектДокумента, "proposalOrdersIdentificator",	Сообщение, "ОбратныйЗаказEDI");
	xmlЗаполнитьDocumentIdentificator(ОбъектДокумента, "originOrder",					Сообщение, "ЗаказEDI");

	Если Сообщение.ТипСообщения = "RETREC" Тогда   
		xmlЗаполнитьDocumentIdentificator(ОбъектДокумента, "returnDespatchIdentificator",	Сообщение, "НакладнаяEDI");
	Иначе
		xmlЗаполнитьDocumentIdentificator(ОбъектДокумента, "despatchIdentificator",		Сообщение, "НакладнаяEDI");
	КонецЕсли;
	
	Если Сообщение.ТипСообщения = "ALCRPT" Тогда                                                   
		xmlЗаполнитьDocumentIdentificator(ОбъектДокумента, "receivingIdentificator", Сообщение, "НакладнаяEDI");
	КонецЕсли;
	
	Если Сообщение.Свойство("НомерПриемкиПокупателя") Тогда
		Если ЗначениеЗаполнено(Сообщение.НомерПриемкиПокупателя) Тогда
			xmlСоздатьДочернийЭлементXDTO(ОбъектДокумента,	"receivingAdviceIdentificatorInBuyerSystem").number = Сообщение.НомерПриемкиПокупателя; 
		КонецЕсли;
	КонецЕсли;
	
	Если Сообщение.ТипСообщения = "DESADV" Тогда
		xmlЗаполнитьDocumentIdentificator(ОбъектДокумента, "invoiceIdentificator",				Сообщение, "СчетФактураEDI");
		xmlЗаполнитьDocumentIdentificator(ОбъектДокумента, "egaisRegistrationIdentificator",	Сообщение, "ТТНвЕГАИС");
		xmlЗаполнитьDocumentIdentificator(ОбъектДокумента, "egaisFixationIdentificator",		Сообщение, "ФиксацияВЕГАИС");
	КонецЕсли;
	
	Если Сообщение.ТипСообщения = "INVOIC" ИЛИ Сообщение.ТипСообщения = "COINVOIC" Тогда
		
		xmlЗаполнитьDocumentIdentificator(ОбъектДокумента, "orderResponse",				Сообщение, "ОтветНаЗаказEDI");
		xmlЗаполнитьDocumentIdentificator(ОбъектДокумента, "receivingIdentificator",	Сообщение, "ПриемкаEDI");
		// поле КонтрактEDI, чтобы конвертировать типовыми механизмами
		xmlЗаполнитьDocumentIdentificator(ОбъектДокумента, "contractIdentificator",		Сообщение, "КонтрактEDI");

	КонецЕсли;
	
	// поле Контракт не конвертируемое
	xmlЗаполнитьDocumentIdentificator(ОбъектДокумента, "contractIdentificator", Сообщение, "Контракт"); //Теперь называется Контракт а не КОнтрактEDI
	
	НомерИсправляемогоДокумента = Неопределено;
	
	Если ПроверитьСвойствоПоляВСтруктуре(Сообщение, "ИсправляемыйСчетФактураEDI.Номер", НомерИсправляемогоДокумента)
		И ЗначениеЗаполнено(НомерИсправляемогоДокумента) Тогда
		
		ИсправляемыйДокументEDI = Сообщение.ИсправляемыйСчетФактураEDI;
		
	ИначеЕсли ПроверитьСвойствоПоляВСтруктуре(Сообщение, "ИсправляемыйДокументРеализацииEDI.Номер", НомерИсправляемогоДокумента)
		И ЗначениеЗаполнено(НомерИсправляемогоДокумента) Тогда


		ИсправляемыйДокументEDI = Сообщение.ИсправляемыйДокументРеализацииEDI;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИсправляемыйДокументEDI) Тогда
		
		originInvoic = xmlСоздатьДочернийЭлементXDTO(ОбъектДокумента, "originInvoic");
		originInvoic.number	= ИсправляемыйДокументEDI.Номер;
		originInvoic.date = ИсправляемыйДокументEDI.Дата;
		
		Если ИсправляемыйДокументEDI.Исправление = Истина Тогда
			originInvoic.revisionNumber	= ИсправляемыйДокументEDI.НомерИсправления;
			originInvoic.revisionDate = ИсправляемыйДокументEDI.ДатаИсправления;
		КонецЕсли;
		
		ДиадокID = Неопределено;
		ПроверитьСвойствоПоляВСтруктуре(Сообщение, "ИсправляемыйСчетФактураEDI.ДиадокID", ДиадокID);
		
		Если НЕ ЗначениеЗаполнено(ДиадокID) Тогда
			ПроверитьСвойствоПоляВСтруктуре(Сообщение, "ИсправляемыйДокументРеализацииEDI.ДиадокID", ДиадокID);
		КонецЕсли;
			
		Если ЗначениеЗаполнено(ДиадокID) Тогда
			originInvoic.diadocInvoicId	= ДиадокID;
		КонецЕсли;
		
	КонецЕсли;
		
	Если ЗначениеЗаполнено(Сообщение.НомерСерииЗаказов) Тогда
		xmlСоздатьДочернийЭлементXDTO(ОбъектДокумента,	"blanketOrderIdentificator").number = Сообщение.НомерСерииЗаказов;
	КонецЕсли;
	
	Если Сообщение.ТипСообщения = "RETINS" 
		ИЛИ Сообщение.ТипСообщения = "RETREC"
		ИЛИ Сообщение.ТипСообщения = "COINVOIC" Тогда
		xmlЗаполнитьDocumentIdentificator(ОбъектДокумента, "announcementForReturns", 		Сообщение, "УведомлениеОВозвратеEDI");
		xmlЗаполнитьDocumentIdentificator(ОбъектДокумента, "returnDespatchIdentificator", 	Сообщение, "ВозвратнаяНакладнаяEDI");
	КонецЕсли;
	
	Если Сообщение.ТипСообщения = "RETDES" Тогда 
		xmlЗаполнитьDocumentIdentificator(ОбъектДокумента, "announcementForReturns",  		  Сообщение, "УведомлениеОВозвратеEDI");
		xmlЗаполнитьDocumentIdentificator(ОбъектДокумента, "instructionsForReturns", 		  Сообщение, "УведомлениеОПодтвержденииВозвратаEDI");
		xmlЗаполнитьDocumentIdentificator(ОбъектДокумента, "returnDeliveryNoteIdentificator", Сообщение, "ВозвратнаяНакладнаяEDI");
		xmlЗаполнитьDocumentIdentificator(ОбъектДокумента, "deliveryNoteIdentificator", 	  Сообщение, "НакладнаяEDI");
		xmlЗаполнитьDocumentIdentificator(ОбъектДокумента, "returnInvoiceIdentificator", 	  Сообщение, "ОбратныйСчетEDI");
	КонецЕсли;
	
КонецПроцедуры

//Создает в Приемник тег с именем ИмяПоляПриемника, если таковой присутствует в схеме. 
//И заполняет его данными из Источник.ИмяПоляИсточника, если в источнике есть такое поле. 
Процедура xmlЗаполнитьDocumentIdentificator(Приемник, ИмяПоляПриемника, Источник, ИмяПоляИсточника)
	
	Если Источник.Свойство(ИмяПоляИсточника)=Ложь Тогда
		Возврат;
	КонецЕсли;
	
	_Номер	= Неопределено;
	_Дата	= Неопределено;
	
	Источник[ИмяПоляИсточника].Свойство("Номер",_Номер);
	Источник[ИмяПоляИсточника].Свойство("Дата",_Дата);
	
	Если Не ЗначениеЗаполнено(_Номер) Тогда
		Возврат;//а пустую дату пока разрешим
	КонецЕсли;
	
	Если НЕ Приемник.Тип().Свойства.Получить(ИмяПоляПриемника)=Неопределено Тогда
		xmlСоздатьДочернийЭлементXDTO(Приемник,	ИмяПоляПриемника);
		Если ТипЗнч(Приемник[ИмяПоляПриемника]) = Тип("СписокXDTO") Тогда
			ЭлементСпискаПоляПриемника = Приемник[ИмяПоляПриемника][0];
			ЭлементСпискаПоляПриемника.number	= _Номер;
			Если ЗначениеЗаполнено(_Дата) Тогда
				ЭлементСпискаПоляПриемника.date		= _Дата;
			КонецЕсли;
		Иначе	
			Приемник[ИмяПоляПриемника].number	= _Номер;
			Если ЗначениеЗаполнено(_Дата) Тогда
				Приемник[ИмяПоляПриемника].date		= _Дата;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура xmlЗаписатьcountryOfOriginISOCode_XDTO(lineItem,СтрокаТоваров)
	
	//СтранаEDI  countryOfOriginISOCode
	
	Если ТипЗнч(СтрокаТоваров.СтранаEDI) = Тип("Строка") 
		И ЗначениеЗаполнено(СтрокаТоваров.СтранаEDI) Тогда
		xmlСоздатьДочернийЭлементXDTO(lineItem,"countryOfOriginISOCode",ложь);
		lineItem.countryOfOriginISOCode.Добавить(СтрокаТоваров.СтранаEDI);
	ИначеЕсли ТипЗнч(СтрокаТоваров.СтранаEDI) = Тип("ТаблицаЗначений") 
		И СтрокаТоваров.СтранаEDI.Количество()>0 Тогда
		xmlСоздатьДочернийЭлементXDTO(lineItem,"countryOfOriginISOCode",ложь);
		Для Каждого СтрокаТаблицы Из СтрокаТоваров.СтранаEDI Цикл
			lineItem.countryOfOriginISOCode.Добавить(СтрокаТаблицы.КодСтраны);
		КонецЦикла;
	ИначеЕсли ТипЗнч(СтрокаТоваров.СтранаEDI) = Тип("СписокЗначений") 
		И СтрокаТоваров.СтранаEDI.Количество()>0 Тогда
		xmlСоздатьДочернийЭлементXDTO(lineItem,"countryOfOriginISOCode",ложь);
		Для Каждого СтрокаТаблицы Из СтрокаТоваров.СтранаEDI Цикл
			lineItem.countryOfOriginISOCode.Добавить(СтрокаТаблицы.Значение);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура xmlЗаписатьcustomsDeclarationNumber_XDTO(lineItem,СтрокаТоваров)
	
	Если ТипЗнч(СтрокаТоваров.НомерГТДEDI) = Тип("Строка") 
		И ЗначениеЗаполнено(СтрокаТоваров.НомерГТДEDI) Тогда
		xmlСоздатьДочернийЭлементXDTO(lineItem,"customsDeclarationNumber",ложь);
		lineItem.customsDeclarationNumber.Добавить(СтрокаТоваров.НомерГТДEDI);
	ИначеЕсли ТипЗнч(СтрокаТоваров.НомерГТДEDI) = Тип("ТаблицаЗначений") 
		И СтрокаТоваров.НомерГТДEDI.Количество()>0 Тогда
		xmlСоздатьДочернийЭлементXDTO(lineItem,"customsDeclarationNumber",ложь);
		Для Каждого СтрокаТаблицы Из СтрокаТоваров.НомерГТДEDI Цикл
			lineItem.customsDeclarationNumber.Добавить(СтрокаТаблицы.НомерГТД);
		КонецЦикла;
	ИначеЕсли ТипЗнч(СтрокаТоваров.НомерГТДEDI) = Тип("СписокЗначений") 
		И СтрокаТоваров.НомерГТДEDI.Количество()>0 Тогда
		xmlСоздатьДочернийЭлементXDTO(lineItem,"customsDeclarationNumber",ложь);
		Для Каждого СтрокаТаблицы Из СтрокаТоваров.НомерГТДEDI Цикл
			lineItem.customsDeclarationNumber.Добавить(СтрокаТаблицы.Значение);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

//ленивая функция для создания дочернего объекта XDTO по его имени
Функция xmlСоздатьДочернийЭлементXDTO(ТекущийЭлемент,Имя,ПрисвоитьСразу = Истина) Экспорт
	
	Если ПеременнаяСодержитСвойство(ТекущийЭлемент, Имя) 
		И ТекущийЭлемент[Имя] <> Неопределено
		И НЕ ТипЗнч(ТекущийЭлемент[Имя]) = Тип("СписокXDTO") Тогда
		Возврат ТекущийЭлемент[Имя];
	КонецЕсли;

	_Свойство = ТекущийЭлемент.Свойства().Получить(Имя);
	ТипНовогоЭлемента = _Свойство.Тип;
	_Фабрика = xmlПолучитьФабрикуПоПространствуИмен(_Свойство.URIПространстваИмен);
	
	НовыйЭлемент = _Фабрика.Создать(ТипНовогоЭлемента);	
	Если ПрисвоитьСразу И Не НовыйЭлемент = Неопределено Тогда
		Если ТипЗнч(ТекущийЭлемент[Имя]) = Тип("СписокXDTO") Тогда
			ТекущийЭлемент[Имя].Добавить(НовыйЭлемент);
		Иначе		
			ТекущийЭлемент[Имя] = НовыйЭлемент;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат НовыйЭлемент;
	
КонецФункции

Функция xmlПолучитьФабрикуПоПространствуИмен(URIПространстваИмен)
	
	Возврат ФабрикаXDTO_EdiXml();//заглушка, в будущем задействовать кэш
	
КонецФункции

Процедура xmlЗаполнитьЗначениеXDTO(ОбъектXDTO,ИмяПоля,Значение, НезаполненоКакНоль=Ложь) Экспорт
	
	Если ОбъектXDTO.Свойства().Получить(ИмяПоля) = Неопределено Тогда
		Сообщить("Неудачная попытка заполнить поле XDTO: "+ИмяПоля);
		Возврат; //нечего заполнять
	КонецЕсли;
	
	Если ТипЗнч(ОбъектXDTO[ИмяПоля]) = Тип("СписокXDTO") 
		И ТипЗнч(Значение) = Тип("СписокЗначений") 
		И Значение.Количество() <> 0 Тогда
		
		xmlСоздатьДочернийЭлементXDTO(ОбъектXDTO, ИмяПоля, Ложь);
		
		Для Каждого Эл Из Значение Цикл
			
			ОбъектXDTO[ИмяПоля].Добавить(ЗначениеДляXML_КонтурEDI(Эл.Значение));
		КонецЦикла;
		
	ИначеЕсли ЭтоЗначениеСложногоТипа_КонтурEDI(Значение) Тогда
		
		// ... ничего не делать
		
	ИначеЕсли ЗначениеЗаполнено(Значение) Тогда
				
		ОбъектXDTO[ИмяПоля] = ЗначениеДляXML_КонтурEDI(Значение);
		
	ИначеЕсли НезаполненоКакНоль = Истина Тогда
		
		ОбъектXDTO[ИмяПоля] = 0;
		
	Иначе
		// ... ничего не делать
	КонецЕсли;
	
КонецПроцедуры

Процедура xmlОбработатьЭкранируемыеСимволы(СтрокаXML) Экспорт
	
	СтрокаXML = СтрЗаменить(СтрокаXML, "&quot;", """");
	СтрокаXML = СтрЗаменить(СтрокаXML, "&apos;", "'");
	СтрокаXML = СтрЗаменить(СтрокаXML, "&lt;", "<");
	СтрокаXML = СтрЗаменить(СтрокаXML, "&gt;", ">");
	СтрокаXML = СтрЗаменить(СтрокаXML, "&amp;", "&");
	
КонецПроцедуры	

Функция ЗначениеДляXML_КонтурEDI(Значение)
	
	Если ЭтоПримитивныйТип_КонтурEDI(Значение) Тогда
		ЗначениеXML = Значение; 		   
	Иначе
		ЗначениеXML = Строка(Значение);  
	КонецЕсли;
	
	Возврат ЗначениеXML;

КонецФункции

//Фабрика для записи сообщений EdiXML
Функция ФабрикаXDTO_EdiXml() Экспорт
	
	Результат = ЭДО_Кэш_Прочитать("ФабрикаXDTO_EdiXml");
	
	Если Результат = Неопределено Тогда
		
		ФайлСхемы = ПолучитьИмяВременногоФайла("xsd");
		
		СхемаЗагруженаССервера = ЗагрузитьXSDСхему();
		Если СхемаЗагруженаССервера.Успешно = Истина Тогда
			Попытка
				ФайлСхемы = СхемаЗагруженаССервера.МассивЗагруженныхФайлов[0];
				Результат = СоздатьФабрикуXDTO(ФайлСхемы);
			Исключение
				Сообщить("Не удалось загрузить актуальную схему сообщений с сервера");
				ПолучитьМакет("СхемыСообщений").Записать(ФайлСхемы);
				Результат = СоздатьФабрикуXDTO(ФайлСхемы);
			КонецПопытки;
		Иначе	
			ПолучитьМакет("СхемыСообщений").Записать(ФайлСхемы);
			Результат = СоздатьФабрикуXDTO(ФайлСхемы);
		КонецЕсли;
		
		УдалитьФайлы(ФайлСхемы);
		
		ЭДО_Кэш_Поместить("ФабрикаXDTO_EdiXml",Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


/////////////////////////////////////  РАСШИРЕНИЯ  /////////////////////////////////////
Функция ПрочитатьXMLпоXSL(ПутьКФайлуXML, ПутьКФайлуXSL) Экспорт
	
	РезультатЧтения = Новый Структура("Успешно,ОписаниеОшибки,ДанныеЧтения",Ложь,"",Неопределено);

	Попытка 
		ПроцессорПреобразования = Новый ПреобразованиеXSL;
		ПроцессорПреобразования.ЗагрузитьИзФайла(ПутьКФайлуXSL);
		ДанныеXML = ПроцессорПреобразования.ПреобразоватьИзФайла(ПутьКФайлуXML);
		НовыйСериализаторXDTO = Новый СериализаторXDTO(ФабрикаXDTO);
		
		Чтение=Новый ЧтениеXML;
		Чтение.УстановитьСтроку(ДанныеXML);
		
		ПолученнаяСтруктураРасширений = НовыйСериализаторXDTO.ПрочитатьXML(Чтение);
		
		РезультатЧтения.Успешно = Истина;
		РезультатЧтения.ДанныеЧтения = ПолученнаяСтруктураРасширений;
	Исключение
		_ОписаниеОшибки = ОписаниеОшибки();
		РезультатЧтения.ОписаниеОшибки = "Не удалось прочитать файл данных : """ + _ОписаниеОшибки + """.";
	КонецПопытки;
		
	Возврат РезультатЧтения;
	
КонецФункции

Функция ПолучитьДанныеДляВыгрузкиРасширения(РасширениеСсылка, Типовое = Ложь, Измененное = Ложь) Экспорт
	
	СтруктураВозврата = Новый Структура;	
	
	ЗначенияРеквизитовРасширения = ПолучитьЗначенияРеквизитовРасширения(РасширениеСсылка, Истина);

	Если Не ЗначениеЗаполнено(ЗначенияРеквизитовРасширения.ВерсияРасширения) Тогда
		ЗначенияРеквизитовРасширения.ВерсияРасширения = "0.0";
	КонецЕсли;
	ЗначенияРеквизитовРасширения.Вставить("ВерсияМодуля", ПараметрыКлиентСервер.ОписаниеВерсии.ПолнаяСемантикВерсия);
	ЗначенияРеквизитовРасширения.Обязательный = ?(ЗначенияРеквизитовРасширения.Обязательный, "true", "false");
	ЗначенияРеквизитовРасширения.Интерфейс = ?(ЗначенияРеквизитовРасширения.Интерфейс, "true", "false");
	ЗначенияРеквизитовРасширения.Использование = ?(ЗначенияРеквизитовРасширения.Использование, "true", "false");

	СтруктураВозврата.Вставить("ИнтерфейсФайл", ЗначенияРеквизитовРасширения.ИнтерфейсФайл);
	СтруктураВозврата.Вставить("Файлы", ЗначенияРеквизитовРасширения.Файлы);

	//Основной файл расширения
	XMLРасширения = ПолучитьXMLРасширения(ЗначенияРеквизитовРасширения, "Основной", Типовое);
	СтруктураВозврата.Вставить("XMLРасширения", XMLРасширения);
	
	Если Типовое И Измененное Тогда
		//Дополнительные файлы измененного расширения
		XMLРасширенияИзмененный = ПолучитьXMLРасширения(ЗначенияРеквизитовРасширения, "Измененный", Типовое);
		СтруктураВозврата.Вставить("XMLРасширенияИзмененный", XMLРасширенияИзмененный);

		XMLРасширенияИсходный = ПолучитьXMLРасширения(ЗначенияРеквизитовРасширения, "Исходный", Типовое);
		СтруктураВозврата.Вставить("XMLРасширенияИсходный", XMLРасширенияИсходный);
	КонецЕсли;
	
	Если Типовое Тогда
		//Вспомогательный файл для типового расширения
		ВспомогательныйXMLТиповогоРасширения = ПолучитьВспомогательныйXMLРасширения(ЗначенияРеквизитовРасширения);
		СтруктураВозврата.Вставить("ВспомогательныйXMLТиповогоРасширения", ВспомогательныйXMLТиповогоРасширения);
	КонецЕсли;	
	
	Возврат СтруктураВозврата;
		
КонецФункции

Функция ПолучитьXMLРасширения(ЗначенияРеквизитовРасширения, ВариантXMLРасширения, Типовое = Ложь)

	ЗаписьХМЛ = Новый ЗаписьXML;
	ЗаписьХМЛ.УстановитьСтроку();
	ЗаписьХМЛ.ЗаписатьОбъявлениеXML();
	
	//корень сообщения
	ЗаписьХМЛ.ЗаписатьНачалоЭлемента("extension");                                       
	ЗаписьХМЛ.ЗаписатьАтрибут("id",ЗначенияРеквизитовРасширения.Идентификатор);
	ЗаписатьЭлементХМЛ(ЗаписьХМЛ,"name",ЗначенияРеквизитовРасширения.Наименование);
		
	ЗаписатьЭлементХМЛ(ЗаписьХМЛ,"version", ЗначенияРеквизитовРасширения.ВерсияРасширения);	
	ЗаписатьЭлементХМЛ(ЗаписьХМЛ,"moduleVersion", ЗначенияРеквизитовРасширения.ВерсияМодуля);	
	ЗаписатьЭлементХМЛ(ЗаписьХМЛ,"compulsory", ЗначенияРеквизитовРасширения.Обязательный);
	ЗаписатьЭлементХМЛ(ЗаписьХМЛ,"interface", ЗначенияРеквизитовРасширения.Интерфейс);
	ЗаписатьЭлементХМЛ(ЗаписьХМЛ,"usage", ЗначенияРеквизитовРасширения.Использование);	
	ЗаписатьЭлементХМЛ(ЗаписьХМЛ,"description",ЗначенияРеквизитовРасширения.ОписаниеПолное,Ложь);
		
	//События
	ЗаписьХМЛ.ЗаписатьНачалоЭлемента("events");
	Для Каждого СобытиеРасширения из ЗначенияРеквизитовРасширения.События Цикл
		ЗаписьХМЛ.ЗаписатьНачалоЭлемента("event");
		ЗаписатьЭлементХМЛ(ЗаписьХМЛ,"Name",СобытиеРасширения.ИмяСобытия,Ложь);
		Если ВариантXMLРасширения = "Основной" Тогда
			ЗаписатьЭлементХМЛ(ЗаписьХМЛ,"Code",СобытиеРасширения.ИсполняемыйКод,Ложь);
			Если Типовое Тогда
				ЗаписатьЭлементХМЛ(ЗаписьХМЛ,"OriginalCode",СобытиеРасширения.ИсходныйИсполняемыйКод,Ложь);
			КонецЕсли;
		ИначеЕсли ВариантXMLРасширения = "Измененный" Тогда
			ЗаписатьЭлементХМЛ(ЗаписьХМЛ,"Code",СобытиеРасширения.ИсполняемыйКод,Ложь);
		ИначеЕсли ВариантXMLРасширения = "Исходный" Тогда
			ЗаписатьЭлементХМЛ(ЗаписьХМЛ,"Code",СобытиеРасширения.ИсходныйИсполняемыйКод,Ложь);
		КонецЕсли;
		ЗаписьХМЛ.ЗаписатьКонецЭлемента();
	КонецЦикла;
	ЗаписьХМЛ.ЗаписатьКонецЭлемента(); 
	
	//Файлы
	Если ЗначениеЗаполнено(ЗначенияРеквизитовРасширения.Файлы) Тогда
		ЗаписьХМЛ.ЗаписатьНачалоЭлемента("files");
		Для Каждого Файл из ЗначенияРеквизитовРасширения.Файлы Цикл
			ЗаписьХМЛ.ЗаписатьНачалоЭлемента("file");
			ЗаписатьЭлементХМЛ(ЗаписьХМЛ,"name",Файл.ИмяФайла);
			ЗаписатьЭлементХМЛ(ЗаписьХМЛ,"description",Файл.Описание);
			ЗаписьХМЛ.ЗаписатьКонецЭлемента();
		КонецЦикла;
		ЗаписьХМЛ.ЗаписатьКонецЭлемента(); 
	КонецЕсли;

	ЗаписьХМЛ.ЗаписатьКонецЭлемента();
	XMLРасширения = ЗаписьХМЛ.Закрыть();
	
	Возврат XMLРасширения; 
	
КонецФункции

Функция ПолучитьВспомогательныйXMLРасширения(ЗначенияРеквизитовРасширения)

	ЗаписьХМЛ = Новый ЗаписьXML;
	ЗаписьХМЛ.УстановитьСтроку();
	ЗаписьХМЛ.ЗаписатьОбъявлениеXML();
	
	//корень сообщения
	ЗаписьХМЛ.ЗаписатьНачалоЭлемента("extension");                                       
	ЗаписьХМЛ.ЗаписатьАтрибут("id",ЗначенияРеквизитовРасширения.Идентификатор);
	ЗаписатьЭлементХМЛ(ЗаписьХМЛ,"name",ЗначенияРеквизитовРасширения.Наименование);
	ЗаписатьЭлементХМЛ(ЗаписьХМЛ,"outdated","false");
		
	//оф-уф	
	ЗаписьХМЛ.ЗаписатьНачалоЭлемента("ApplicationTypes");
	ЗаписатьЭлементХМЛ(ЗаписьХМЛ,"ApplicationType","ОФ");	
	ЗаписатьЭлементХМЛ(ЗаписьХМЛ,"ApplicationType","УФ");	
	ЗаписьХМЛ.ЗаписатьКонецЭлемента(); //оф-уф
	
	//сети
	ЗаписьХМЛ.ЗаписатьНачалоЭлемента("Nets");
	ЗаписьХМЛ.ЗаписатьКонецЭлемента(); //оф-уф

	ЗаписатьЭлементХМЛ(ЗаписьХМЛ,"version", ЗначенияРеквизитовРасширения.ВерсияРасширения);	
	ЗаписатьЭлементХМЛ(ЗаписьХМЛ,"moduleVersion", ЗначенияРеквизитовРасширения.ВерсияМодуля);	
	ЗаписатьЭлементХМЛ(ЗаписьХМЛ,"compulsory", ЗначенияРеквизитовРасширения.Обязательный);
	ЗаписатьЭлементХМЛ(ЗаписьХМЛ,"interface", ЗначенияРеквизитовРасширения.Интерфейс);
	ЗаписатьЭлементХМЛ(ЗаписьХМЛ,"description",ЗначенияРеквизитовРасширения.ОписаниеПолное,Ложь);

	ЗаписьХМЛ.ЗаписатьКонецЭлемента();
	ВспомогательныйXMLРасширения = ЗаписьХМЛ.Закрыть();
	
	Возврат ВспомогательныйXMLРасширения; 	
	
КонецФункции		

Функция ПолучитьЗначенияРеквизитовРасширения(РасширениеСсылка, СФайлами = Ложь, ССобытиями = Истина) Экспорт
	
	СтруктураЗначенийДопРеквизитов = Новый Структура;
	СтруктураЗначенийДопРеквизитов.Вставить("Наименование", РасширениеСсылка.Наименование);
	СтруктураЗначенийДопРеквизитов.Вставить("Идентификатор");
	СтруктураЗначенийДопРеквизитов.Вставить("ВерсияРасширения");
	СтруктураЗначенийДопРеквизитов.Вставить("РекомендуемаяВерсияМодуля");
	СтруктураЗначенийДопРеквизитов.Вставить("Обязательный", Ложь);
	СтруктураЗначенийДопРеквизитов.Вставить("ОписаниеПолное", "");
	СтруктураЗначенийДопРеквизитов.Вставить("ПорядокВыполнения");
	СтруктураЗначенийДопРеквизитов.Вставить("Использование", Ложь);
	СтруктураЗначенийДопРеквизитов.Вставить("Интерфейс", Ложь);

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(Идентификатор.Значение, """") КАК Идентификатор,
		|	ЕСТЬNULL(ВерсияРасширения.Значение, """") КАК ВерсияРасширения,
		|	ЕСТЬNULL(РекомендуемаяВерсияМодуля.Значение, """") КАК РекомендуемаяВерсияМодуля,
		|	ЕСТЬNULL(Обязательный.Значение, ЛОЖЬ) КАК Обязательный,
		|	ЕСТЬNULL(ОписаниеПолное.ЗначениеСтрока, """") КАК ОписаниеПолное,
		|	ЕСТЬNULL(ПорядокВыполнения.Значение, 0) КАК ПорядокВыполнения,
		|	ЕСТЬNULL(Использование.Значение, ЛОЖЬ) КАК Использование
		|ИЗ
		|	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК Идентификатор
		|		ПО КонтурEDI_ДополнительныеСправочники.Ссылка = Идентификатор.Ссылка
		|			И (Идентификатор.ИмяРеквизита = ""Идентификатор"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК ВерсияРасширения
		|		ПО КонтурEDI_ДополнительныеСправочники.Ссылка = ВерсияРасширения.Ссылка
		|			И (ВерсияРасширения.ИмяРеквизита = ""ВерсияРасширения"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК РекомендуемаяВерсияМодуля
		|		ПО КонтурEDI_ДополнительныеСправочники.Ссылка = РекомендуемаяВерсияМодуля.Ссылка
		|			И (РекомендуемаяВерсияМодуля.ИмяРеквизита = ""РекомендуемаяВерсияМодуля"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК Обязательный
		|		ПО КонтурEDI_ДополнительныеСправочники.Ссылка = Обязательный.Ссылка
		|			И (Обязательный.ИмяРеквизита = ""Обязательный"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК ОписаниеПолное
		|		ПО КонтурEDI_ДополнительныеСправочники.Ссылка = ОписаниеПолное.Ссылка
		|			И (ОписаниеПолное.ИмяРеквизита = ""ОписаниеПолное"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК ПорядокВыполнения
		|		ПО КонтурEDI_ДополнительныеСправочники.Ссылка = ПорядокВыполнения.Ссылка
		|			И (ПорядокВыполнения.ИмяРеквизита = ""ПорядокВыполнения"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК Использование
		|		ПО КонтурEDI_ДополнительныеСправочники.Ссылка = Использование.Ссылка
		|			И (Использование.ИмяРеквизита = ""Использование"")
		|ГДЕ
		|	КонтурEDI_ДополнительныеСправочники.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", РасширениеСсылка);
	РезультатЗапроса = Запрос.Выполнить();
		
	ВыборкаСвойств = РезультатЗапроса.Выбрать();
	Если ВыборкаСвойств.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураЗначенийДопРеквизитов,ВыборкаСвойств);
	КонецЕсли;
	
	Если ССобытиями Тогда
		
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ИсполняемыйКод.НомерСтроки КАК НомерСтроки,
			|	ИсполняемыйКод.Значение КАК ИмяСобытия,
			|	ИсполняемыйКод.ЗначениеСтрока КАК ИсполняемыйКод,
			|	ЕСТЬNULL(ИсходныйИсполняемыйКод.ЗначениеСтрока, ""//Исходный код отсутствует"") КАК ИсходныйИсполняемыйКод
			|ИЗ
			|	Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК ИсполняемыйКод
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК ИсходныйИсполняемыйКод
			|		ПО ИсполняемыйКод.Ссылка = ИсходныйИсполняемыйКод.Ссылка
			|			И (ИсходныйИсполняемыйКод.ИмяРеквизита = ""ИсходныйИсполняемыйКод"")
			|			И ИсполняемыйКод.Значение = ИсходныйИсполняемыйКод.Значение
			|ГДЕ
			|	ИсполняемыйКод.Ссылка = &Ссылка
			|	И ИсполняемыйКод.ИмяРеквизита = ""ИсполняемыйКод""
			|
			|УПОРЯДОЧИТЬ ПО
			|	НомерСтроки";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		МассивСобытий = Новый Массив;
		ВыборкаСобытий = РезультатЗапроса.Выбрать();
		Пока ВыборкаСобытий.Следующий() Цикл
			СтруктураСобытия = Новый Структура("ИмяСобытия, ИсполняемыйКод, ИсходныйИсполняемыйКод");
			ЗаполнитьЗначенияСвойств(СтруктураСобытия, ВыборкаСобытий);
			МассивСобытий.Добавить(СтруктураСобытия);
		КонецЦикла;
		СтруктураЗначенийДопРеквизитов.Вставить("События", МассивСобытий);
	
	КонецЕсли;
	
	Если СФайлами Тогда
		СтруктураЗначенийДопРеквизитов.Вставить("ИнтерфейсФайл");
		СтруктураЗначенийДопРеквизитов.Вставить("Файлы");
		
		Реквизиты = РасширениеСсылка.ДополнительныеРеквизиты;
		
		РеквизитИнтерфейс = Реквизиты.Найти("Интерфейс","ИмяРеквизита");
		Если Не РеквизитИнтерфейс = Неопределено И РеквизитИнтерфейс.Значение  Тогда
			СтруктураЗначенийДопРеквизитов.Интерфейс = Истина;
			СтруктураЗначенийДопРеквизитов.ИнтерфейсФайл = РеквизитИнтерфейс.ЗначениеХранилищеЗначения.Получить();	
		КонецЕсли;	
		
		МассивФайлов = Новый Массив;
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ИмяРеквизита","Файл");
		РеквизитыФайлы = Реквизиты.НайтиСтроки(ПараметрыОтбора);
		Для Каждого СтрокаРеквизитовФайл Из РеквизитыФайлы Цикл
			МассивФайлов.Добавить(Новый Структура("ИмяФайла, Описание, ДвоичныеДанные",
			СтрокаРеквизитовФайл.Значение,  СтрокаРеквизитовФайл.ЗначениеСтрока, СтрокаРеквизитовФайл.ЗначениеХранилищеЗначения.Получить()));	
		КонецЦикла;
		СтруктураЗначенийДопРеквизитов.Файлы = МассивФайлов;
	КонецЕсли;
		
	Возврат СтруктураЗначенийДопРеквизитов;
	
КонецФункции
