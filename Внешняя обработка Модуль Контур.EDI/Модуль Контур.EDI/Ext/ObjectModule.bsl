Процедура ЗаписатьДопРеквизитСправочника_КонтурEDI(СправочникСсылка, ИмяРеквизита, ЗначениеРеквизита = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(СправочникСсылка) Тогда
		Возврат;
	КонецЕсли;

	СправочникОбъект = СправочникСсылка.ПолучитьОбъект();
	
	Если НЕ ТипЗнч(ИмяРеквизита) = Тип("Структура") Тогда
		ИмяРеквизита = Новый Структура(ИмяРеквизита,ЗначениеРеквизита)
	КонецЕсли;
	
	Для каждого РеквизитЗначение Из ИмяРеквизита Цикл
		СтрокаРеквизита = СправочникОбъект.ДополнительныеРеквизиты.Найти(РеквизитЗначение.Ключ, "ИмяРеквизита");
		
		Если СтрокаРеквизита = Неопределено Тогда
			СтрокаРеквизита = СправочникОбъект.ДополнительныеРеквизиты.Добавить();
			СтрокаРеквизита.ИмяРеквизита = РеквизитЗначение.Ключ;
		КонецЕсли;	
		
		СтрокаРеквизита.Значение = РеквизитЗначение.Значение;
	КонецЦикла;

	СправочникОбъект.Записать();

КонецПроцедуры

Процедура ЗаполнитьДопРеквизитыОбъектаСправочника_КонтурEDI(СправочникОбъект, РеквизитыКЗаполенению) Экспорт  	
		
	Для каждого РеквизитЗначение Из РеквизитыКЗаполенению Цикл
		СтрокаРеквизита = СправочникОбъект.ДополнительныеРеквизиты.Найти(РеквизитЗначение.Ключ, "ИмяРеквизита");
		
		Если СтрокаРеквизита = Неопределено Тогда
			СтрокаРеквизита = СправочникОбъект.ДополнительныеРеквизиты.Добавить();
			СтрокаРеквизита.ИмяРеквизита = РеквизитЗначение.Ключ;
		КонецЕсли;	
		
		СтрокаРеквизита.Значение = РеквизитЗначение.Значение;
	КонецЦикла;  

КонецПроцедуры

Функция ПолучитьЗначениеДопРеквизитаСправочника_КонтурEDI(СправочникСсылка, ИмяРеквизита) Экспорт
	
	Типы_Ссылка = ТипыСсылка_КонтурEDI();    	
	Типы_Объект = ТипыОбъект_КонтурEDI();    
	
	СправочникСсылка_Тип = ТипЗнч(СправочникСсылка);
	
	Если Типы_Ссылка.Найти(СправочникСсылка_Тип) <> Неопределено Тогда
		СправочникОбъект = СправочникСсылка.ПолучитьОбъект();
	ИначеЕсли Типы_Объект.Найти(СправочникСсылка_Тип) <> Неопределено Тогда
		СправочникОбъект = СправочникСсылка;
	Иначе
		Возврат Неопределено;		
	КонецЕсли; 
	
	ЗначениеРеквизита = Неопределено;
	
	СтрокаРеквизита = СправочникОбъект.ДополнительныеРеквизиты.Найти(ИмяРеквизита, "ИмяРеквизита");
	
	Если НЕ СтрокаРеквизита = Неопределено Тогда
		ЗначениеРеквизита = СтрокаРеквизита.Значение;
	КонецЕсли;	
	
	Возврат ЗначениеРеквизита;
	
КонецФункции

Функция ТипыОбъект_КонтурEDI()
	
	Типы_Объект = Новый Массив;
	Типы_Объект.Добавить(Тип("СправочникОбъект.КонтурEDI_ДополнительныеСправочники"));
	Типы_Объект.Добавить(Тип("СправочникОбъект.КонтурEDI_Сообщения"));
	Типы_Объект.Добавить(Тип("СправочникОбъект.КонтурEDI_ТочкиДоставки"));
	
	Возврат Типы_Объект;

КонецФункции

Функция ТипыСсылка_КонтурEDI()
		
	Типы_Ссылка = Новый Массив;
	Типы_Ссылка.Добавить(Тип("СправочникСсылка.КонтурEDI_ДополнительныеСправочники"));
	Типы_Ссылка.Добавить(Тип("СправочникСсылка.КонтурEDI_Сообщения"));
	Типы_Ссылка.Добавить(Тип("СправочникСсылка.КонтурEDI_ТочкиДоставки"));
	
	Возврат Типы_Ссылка;

КонецФункции

Процедура УдалитьДопРеквизитыСправочника_КонтурEDI(СправочникСсылка, Реквизиты) Экспорт

	Если (ВнешнееХранилище И СправочникСсылка = Неопределено)
        ИЛИ (НЕ ВнешнееХранилище И НЕ ЗначениеЗаполнено(СправочникСсылка))
		ИЛИ НЕ ЗначениеЗаполнено(Реквизиты) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Реквизиты) = Тип("Строка") Тогда
		МассивРеквизитов = EDI_РазложитьСтрокуВМассивСлов(Реквизиты, ",");
	ИначеЕсли ТипЗнч(Реквизиты) = Тип("Массив") Тогда
	    МассивРеквизитов = Реквизиты;
	Иначе
		Возврат;
	КонецЕсли;
	
	СправочникОбъект = ПреобразоватьЗначениеДляВнешнегоХранилища(СправочникСсылка).ПолучитьОбъект();

	Для каждого ИмяРеквизита Из МассивРеквизитов Цикл
		СтрокаРеквизита = СправочникОбъект.ДополнительныеРеквизиты.Найти(ИмяРеквизита, "ИмяРеквизита");
		Если НЕ СтрокаРеквизита = Неопределено Тогда
			СправочникОбъект.ДополнительныеРеквизиты.Удалить(СтрокаРеквизита);
		КонецЕсли;	
	КонецЦикла;
	
	СправочникОбъект.Записать();

КонецПроцедуры

Функция СимметричноеШифрованиеТабличнымСмещением_Контур(Значение = "", НаправлениеПреобразования = "Прямое")
	
	НовоеЗначение = "";
	
	Если Значение = "" Тогда
		Возврат НовоеЗначение;
	КонецЕсли;
	
	Смещение = Новый Массив(10);
	Смещение[0] = 1236;
	Смещение[1] = 765;
	Смещение[2] = 478;
	Смещение[3] = 4;
	Смещение[4] = 774;
	Смещение[5] = 123;
	Смещение[6] = 14;
	Смещение[7] = 76;
	Смещение[8] = 949;
	Смещение[9] = 8;
	
	Индекс = 0;
	
	Для НомерСимвола = 1 По СтрДлина(Значение) Цикл
		
		Если НаправлениеПреобразования = "Прямое" Тогда
			
			НовыйКодСимвола = КодСимвола(Значение, НомерСимвола) + Смещение[Индекс];
			ДобавленныйКодСимвола = НовыйКодСимвола + Смещение[Индекс];
			НовоеЗначение = НовоеЗначение + Символ(НовыйКодСимвола) + Символ(ДобавленныйКодСимвола); 

		ИначеЕсли НаправлениеПреобразования = "Обратное" Тогда
			
			НовыйКодСимвола = КодСимвола(Значение, НомерСимвола) - Смещение[Индекс];
			НомерСимвола = НомерСимвола + 1;
			НовоеЗначение = НовоеЗначение + Символ(НовыйКодСимвола);

		КонецЕсли;
		
		Индекс = ?(Индекс = 9, 0, Индекс + 1);
		
	КонецЦикла;
	
	Возврат НовоеЗначение;
	
КонецФункции

Функция ПодготовитьМассивИстекающихСертификатов() Экспорт

	МассивИстекающихСертификатов = Новый Массив;
	
	ОтборПоСертификатам = Новый Структура;
	ОтборПоСертификатам.Вставить("СертификатыПоУмолчанию", Истина);
	
	Таб = ПолучитьТаблицуСохраненныхСертификатов(ОтборПоСертификатам);	
	
	Для каждого Строка Из Таб Цикл
		Если ЗначениеЗаполнено(Строка.Отпечаток)
			И ЗначениеЗаполнено(Строка.СертификатДействуетПо) Тогда
			
			ОсталосьДней = Окр((НачалоДня(Строка.СертификатДействуетПо) - НачалоДня(ТекущаяДата())) / (60*60*24));
			
			Если ОсталосьДней < 30 Тогда
				СтруктураСертификата = Новый Структура;
				СтруктураСертификата.Вставить("Организация", 			Строка.Организация);
				СтруктураСертификата.Вставить("СертификатДействуетПо", 	Строка.СертификатДействуетПо);
				СтруктураСертификата.Вставить("ОсталосьДней", 			ОсталосьДней);
				
				МассивИстекающихСертификатов.Добавить(СтруктураСертификата);	
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Строка.Доверенность) И ТипЗнч(Строка.Доверенность) = Тип("Структура") 
				И Строка.Доверенность.Свойство("СрокДействия") И ЗначениеЗаполнено(Строка.Доверенность.СрокДействия) Тогда
				
				ОсталосьДней = Окр((НачалоДня(Строка.Доверенность.СрокДействия) - НачалоДня(ТекущаяДата())) / (60*60*24));
				
				Если ОсталосьДней < 30 Тогда
					СтруктураДоверенности = Новый Структура;
					СтруктураДоверенности.Вставить("Организация", 			Представление_МашиночитаемаяДоверенность_Краткое(Строка.Доверенность));
					СтруктураДоверенности.Вставить("СертификатДействуетПо", Строка.Доверенность.СрокДействия);
					СтруктураДоверенности.Вставить("ОсталосьДней", 			ОсталосьДней);
					
					МассивИстекающихСертификатов.Добавить(СтруктураДоверенности);	
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;	
	КонецЦикла;
	
	Возврат МассивИстекающихСертификатов;

КонецФункции // ПодготовитьМассивИстекающихСертификатов()

// Получить структуру предложения продления всех наших организации
//
// Возвращаемое значение:
//  Структура - результат проверки в виде структуры:
//		ПредложенияПродления - массив - массив предложений продления, данные по каждому в виде структуры: 
//			ТипПредложения - строка - тип предложения продления: "Пакет" или "Подписка"
//			ПредложениеПродления - структура - структура предложения продления подписки или пакета,
//									см. СтруктураПредложенияПродленияПодписки() и СтруктураПредложенияПродленияПакета()
//		MD5 - строка - составная хэш сумма текущих наборов предложений продления для всех наших организаций
//		Количество - число - количество пакетов и подписок в предложении
//		ЕстьНовые - булево - признак наличия новых предложений продления
//		ЗаголовокКнопки - строка - заголовок для кнопки основной формы
//		ЗаголовокФормы - строка - заголовок для формы предложения продления
//
Функция ПолучитьСтруктуруПредложенияПродления() Экспорт

	СтруктуруПредложенияПродления = Новый Структура("ПредложенияПродления, 	MD5, Количество, ЕстьНовые, ЗаголовокКнопки, ЗаголовокФормы", 
													Новый Массив, 			"",  0, 		 Ложь,		"",				 "");
													
													
	Если НЕ КонтурEDIAPI_ИнтернетРесурсДоступен() Тогда
		Возврат СтруктуруПредложенияПродления;	
	КонецЕсли;
	
	НашиОрганизации = ПолучитьСписокЭлементовСправочника("НашиОрганизации");
	
	Для Каждого НашаОрганизация Из НашиОрганизации Цикл

		Если НашаОрганизация.Неактивная Тогда
			Продолжить;
		КонецЕсли;
		
		УчетнаяЗапись = ПолучитьЭлементСправочника("УчетныеЗаписи", НашаОрганизация.УчетнаяЗапись);
		
		Если УчетнаяЗапись = Неопределено Тогда
			Продолжить;
		КонецЕсли;
			
		ПредложенияПродленияОрганизации = ПолучитьСтруктуруПредложенияПродленияОрганизации_EDI(УчетнаяЗапись, НашаОрганизация.partyId);
		
		СтруктуруПредложенияПродления.MD5 = СтруктуруПредложенияПродления.MD5 + ПредложенияПродленияОрганизации.MD5;
		
		Для Каждого ПредложениеПродления Из ПредложенияПродленияОрганизации.ПредложенияПродления Цикл
			
			СтруктуруПредложенияПродления.ПредложенияПродления.Добавить(ПредложениеПродления);
			
		КонецЦикла;
		
	КонецЦикла;
		
	ПроанализироватьИДополнитьСтруктуруПредложенияПродления(СтруктуруПредложенияПродления);
	
	Возврат СтруктуруПредложенияПродления;

КонецФункции // ПолучитьСтруктуруПредложенияПродления()

// Проанализировать структуру предложения продления пакетов и подписок, и дополнить информацией для её вывода
//
// Параметр:
//  Структура - структура - структура предложения продления подписок или пакетов,
//							смотреть описание результата функций ПолучитьСтруктуруПредложенияПродления
//
Процедура ПроанализироватьИДополнитьСтруктуруПредложенияПродления(СтруктуруПредложенияПродления)
		
	СтруктуруПредложенияПродления.Количество = СтруктуруПредложенияПродления.ПредложенияПродления.Количество();
	
	КоличествоПакетов = 0;
	КоличествоПодписок = 0;
	
	Если СтруктуруПредложенияПродления.Количество > 0 Тогда
		
		Пользователь = ПолучитьТекущегоПользователя1С();
	
		СтруктуруПредложенияПродления.ЕстьНовые = СтруктуруПредложенияПродления.MD5 <> ПолучитьЗначениеСвойстваОбъектаEDI(Пользователь,"MD5ПредложенияПродления");
		
		ЕстьИстекшие = Ложь;
		
		Для Каждого Элемент Из СтруктуруПредложенияПродления.ПредложенияПродления Цикл
			
			Если Элемент.ТипПредложения = "Пакет" Тогда

				КоличествоПакетов = КоличествоПакетов + 1;
				Пакет = Элемент.ПредложениеПродления; 

				Если Пакет.ОсталосьДней <= 0 Или Пакет.ПроцентОстатка = 0 Тогда		
					ЕстьИстекшие = Истина;
					Прервать;
				КонецЕсли;
				
			ИначеЕсли Элемент.ТипПредложения = "Подписка" Тогда

				КоличествоПодписок = КоличествоПодписок + 1;
				Подписка = Элемент.ПредложениеПродления; 

				Если Подписка.ОсталосьДней <= 0 Тогда		
					ЕстьИстекшие = Истина;
					Прервать;
				КонецЕсли;
				
			КонецЕсли;
				
		КонецЦикла;
			
		Если СтруктуруПредложенияПродления.Количество > 1 Тогда
			
			Если ЕстьИстекшие Тогда
				СтруктуруПредложенияПродления.ЗаголовокКнопки = "Требуется оплата услуг";
			Иначе
				СтруктуруПредложенияПродления.ЗаголовокКнопки = "Заканчивается срок действия услуг";
			КонецЕсли;
			
			СтруктуруПредложенияПродления.ЗаголовокФормы = "Продление услуг";
			
		ИначеЕсли КоличествоПакетов = 0  И КоличествоПодписок = 1 Тогда
			
			Если ЕстьИстекшие Тогда
				СтруктуруПредложенияПродления.ЗаголовокКнопки = "Требуется оплата подписки на услугу";
				СтруктуруПредложенияПродления.ЗаголовокФормы = "Истёк срок действия подписки";
			Иначе
				СтруктуруПредложенияПродления.ЗаголовокКнопки = "Заканчивается подписка на услугу";
				СтруктуруПредложенияПродления.ЗаголовокФормы = "Подписка заканчивается";
			КонецЕсли;
			
			Подписка.Предложение = СтрЗаменить(Подписка.Предложение, СтруктуруПредложенияПродления.ЗаголовокФормы + ". ", "");
			
		ИначеЕсли КоличествоПакетов = 1  И КоличествоПодписок = 0 Тогда
			
			Если ЕстьИстекшие Тогда

				СтруктуруПредложенияПродления.ЗаголовокКнопки = "Требуется оплата пакета документов";
				
				Если Пакет.ОсталосьДней <= 0 Тогда
					СтруктуруПредложенияПродления.ЗаголовокФормы = "Срок действия пакета документов истёк";		
				ИначеЕсли Пакет.ПроцентОстатка = 0 Тогда
					СтруктуруПредложенияПродления.ЗаголовокФормы = "Пакет документов закончился";
				КонецЕсли;
				
			ИначеЕсли Пакет.ПредполагаемаяДатаИстечения < Пакет.ДатаИстечения Тогда // признак преждевременного израсходования пакета

				СтруктуруПредложенияПродления.ЗаголовокКнопки = "Осталось " + Пакет.ПроцентОстатка + "% документов в пакете";
				СтруктуруПредложенияПродления.ЗаголовокФормы = "Пакет документов заканчивается";
				
			Иначе
				
				СтруктуруПредложенияПродления.ЗаголовокКнопки = "Истекает срок действия пакета";
				СтруктуруПредложенияПродления.ЗаголовокФормы = "Истекает срок действия пакета документов";
				
			КонецЕсли;

			Пакет.Предложение = СтрЗаменить(Пакет.Предложение, СтруктуруПредложенияПродления.ЗаголовокФормы + ". ", "");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ПроанализироватьИДополнитьСтруктуруПредложенияПродления()

Функция ПоместитьЗаписиДопСравочникаВо_ВременноеХранилище(ИмяСправочника, КлючиПоиска = Неопределено) Экспорт
	
	АдресВХранилище = Неопределено;
	
	ЗаписиСправочника = ПолучитьЗаписиДопСправочника_КонтурEDI(ИмяСправочника, КлючиПоиска);
	
	Если ЗаписиСправочника.Количество() <> 0 Тогда
		АдресВХранилище = ПоместитьВоВременноеХранилище(ЗаписиСправочника);
	КонецЕсли;
	
	Возврат АдресВХранилище;
	
КонецФункции 

Функция ПолучитьРезультатВыбораИзУниверсальнойФормы(АдресВременногоХранилища) Экспорт
	
	Результат = Неопределено;
	
	Если ЭтоАдресВременногоХранилища(АдресВременногоХранилища) Тогда
		
		ТаблицаВыбора = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);
		
		Если ТипЗнч(ТаблицаВыбора) = Тип("ТаблицаЗначений") 
			И ТаблицаВыбора.Количество() <> 0 Тогда 
			
			ПараметрыОтбора = Новый Структура("Выбор", Истина);
			ВыбранныеСтроки = ТаблицаВыбора.НайтиСтроки(ПараметрыОтбора);
			
			Результат = ВыбранныеСтроки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции



Функция ПолучитьЗаписиДопСправочника_КонтурEDI(ИмяСправочника, КлючиПоиска = Неопределено, ИскатьВхождения = Ложь) Экспорт
	
	Если ИмяСправочника = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОписаниеРеквизитов = ПолучитьОписаниеРеквизитовДопСправочника_КонтурEDI(ИмяСправочника);
	
	Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_ДополнительныеСправочники.Ссылка,
	|	КонтурEDI_ДополнительныеСправочники.Наименование КАК Наименование";
	Для каждого Реквизит Из ОписаниеРеквизитов Цикл
		ТекстЗапроса = ТекстЗапроса + 
		",
		|	ЕСТЬNULL(КонтурEDI_ДопРеквизиты_" + Реквизит.ИмяПоля + ".Значение, Неопределено) КАК " + Реквизит.ИмяПоля; 
	КонецЦикла;
	ТекстЗапроса = ТекстЗапроса + 
	"
	|ИЗ
	|	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники";
	Для каждого Реквизит Из ОписаниеРеквизитов Цикл
		ТекстЗапроса = ТекстЗапроса + 
		"
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК КонтурEDI_ДопРеквизиты_" + Реквизит.ИмяПоля + "
		|		ПО (КонтурEDI_ДопРеквизиты_" + Реквизит.ИмяПоля + ".Ссылка = КонтурEDI_ДополнительныеСправочники.Ссылка)
		|			И (КонтурEDI_ДопРеквизиты_" + Реквизит.ИмяПоля + ".ИмяРеквизита = """ + Реквизит.ИмяПоля + """)";
	КонецЦикла;
	ТекстЗапроса = ТекстЗапроса +
	"
	|ГДЕ
	|	КонтурEDI_ДополнительныеСправочники.ИмяСправочника = """ + ИмяСправочника + """
	|	И НЕ КонтурEDI_ДополнительныеСправочники.ПометкаУдаления";
	Если ТипЗнч(КлючиПоиска) = Тип("Структура") Тогда
		Для каждого КлючПоиска Из КлючиПоиска Цикл
			Если ИскатьВхождения Тогда
				ТекстЗапроса = ТекстЗапроса +
				"
				|	И КонтурEDI_ДопРеквизиты_" + КлючПоиска.Ключ + ".Значение В(&" + КлючПоиска.Ключ + ")";
			Иначе
				ТекстЗапроса = ТекстЗапроса +
				"
				|	И КонтурEDI_ДопРеквизиты_" + КлючПоиска.Ключ + ".Значение = &" + КлючПоиска.Ключ;
			КонецЕсли;
			Запрос.УстановитьПараметр(КлючПоиска.Ключ, КлючПоиска.Значение);
		КонецЦикла;
	КонецЕсли;
	Запрос.Текст = ТекстЗапроса;
	Таб = Запрос.Выполнить().Выгрузить();
	
	Возврат Таб;
	
КонецФункции

