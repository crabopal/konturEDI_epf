// Возвращает структуру хранящую настройки для работы модуля.
//
// Возвращаемое значение:
//   См. КонтурДиадокAPI_НовыйМенеджерНастроек.
//
Функция КонтурДиадокAPI_МенеджерНастроек() Экспорт
	
	Возврат КонтурДиадокAPIПереопределяемый_МенеджерНастроек();
	
КонецФункции

// Метод возвращает структуру, содержащую доступные типы авторизации для работы с API Диадок.
//
// Возвращаемое значение:
//   Структура - Содержит ключи и соответствующие им строковые значения типов авторизации:
//     * ЛогинПароль        - Строка - Авторизация по логину и паролю.
//     * Сертификат         - Строка - Авторизация по сертификату.
//     * ИдентификаторСессии - Строка - Авторизация по идентификатору сессии.
//
Функция КонтурДиадокAPI_ТипыАвторизации() Экспорт
	
	ТипыАвторизации = Новый Структура;
	
	ТипыАвторизации.Вставить("ЛогинПароль", 		"password");
	ТипыАвторизации.Вставить("Сертификат", 			"certificate");
	ТипыАвторизации.Вставить("ИдентификаторСессии", "sid");
	
	Возврат ТипыАвторизации;
	
КонецФункции 

// Метод для создания и инициализации структуры данных авторизации в API Диадок.
// В зависимости от выбранного типа авторизации заполняет структуру соответствующими полями.
//
// Параметры:
//   ТипАвторизации - Строка - Тип авторизации, значение из метода КонтурДиадокAPI_ТипыАвторизации.
//
// Возвращаемое значение:
//   Структура - Структура, содержащая поля для авторизации в зависимости от типа:
//     * ТипАвторизации - Строка - Выбранный тип авторизации.
//     Для типа "ЛогинПароль":
//       ** Логин  - Строка - Логин пользователя.
//       ** Пароль - Строка - Пароль пользователя.
//       ** Токен  - Строка - Токен доступа (заполняется после авторизации).
//     Для типа "Сертификат":
//       ** Отпечаток           - Строка - Отпечаток сертификата.
//       ** Расположение        - Строка - Путь к файлу сертификата.
//       ** ПарольЗакрытогоКлюча - Строка - Пароль к закрытому ключу.
//       ** ДвоичныеДанные      - ДвоичныеДанные, Неопределено - Данные сертификата в двоичном виде.
//       ** Токен               - Строка - Токен доступа (заполняется после авторизации).
//     Для типа "ИдентификаторСессии":
//       ** ИдентификаторСессии - Строка - Идентификатор активной сессии.
//       ** Токен               - Строка - Токен доступа (заполняется после авторизации).
//
Функция КонтурДиадокAPI_НовыйДанныеАвторизации(ТипАвторизации) Экспорт
	
	ДанныеАвторизацииДиадок = Новый Структура("ТипАвторизации");
	ТипыАвторизации = КонтурДиадокAPI_ТипыАвторизации();               
	
	Если ТипАвторизации = ТипыАвторизации.ЛогинПароль Тогда
		
		ДанныеАвторизацииДиадок.ТипАвторизации = ТипыАвторизации.ЛогинПароль;	
		ДанныеАвторизацииДиадок.Вставить("Логин", "");
		ДанныеАвторизацииДиадок.Вставить("Пароль", "");
		ДанныеАвторизацииДиадок.Вставить("Токен", "");
		
	ИначеЕсли ТипАвторизации = ТипыАвторизации.Сертификат Тогда
		
		ДанныеАвторизацииДиадок.ТипАвторизации = ТипыАвторизации.Сертификат;	
		ДанныеАвторизацииДиадок.Вставить("Отпечаток", "");
		ДанныеАвторизацииДиадок.Вставить("Расположение", "");
		ДанныеАвторизацииДиадок.Вставить("ПарольЗакрытогоКлюча", "");
		ДанныеАвторизацииДиадок.Вставить("ДвоичныеДанные", Неопределено);
		ДанныеАвторизацииДиадок.Вставить("Токен", "");
		
	ИначеЕсли ТипАвторизации = ТипыАвторизации.ИдентификаторСессии Тогда
		
		ДанныеАвторизацииДиадок.ТипАвторизации = ТипыАвторизации.ИдентификаторСессии;	
		ДанныеАвторизацииДиадок.Вставить("ИдентификаторСессии", "");
		ДанныеАвторизацииДиадок.Вставить("Токен", "");
		
	Иначе
		
		ВызватьИсключение "Задан некорректный способ авторизации";
		
	КонецЕсли;
	
    Возврат ДанныеАвторизацииДиадок;
	
КонецФункции

// Метод для получения авторизационного токена в API Диадок.
// Поддерживает три способа авторизации: по логину и паролю, по сертификату и по идентификатору сессии.
// При авторизации по сертификату возвращает подтверждение авторизации после расшифровки ответа.
// В случае HTTP ответа отличного от "200", выбрасывает исключение.
//
// Параметры:
//   ДанныеАвторизацииДиадок - Структура - см. метод КонтурДиадокAPI_НовыйДанныеАвторизации.
//
// Возвращаемое значение:
//   Строка - Токен для доступа к API Диадок.
//
Функция КонтурДиадокAPI_Авторизоваться(Знач ДанныеАвторизацииДиадок) Экспорт   
	
	МенеджерНастроек = КонтурДиадокAPI_МенеджерНастроек();
	
	КонтурДиадокAPI_УстановитьЗаголовокАвторизации(ДанныеАвторизацииДиадок);	                                                                         					                                                                 					
	
	ТипыАвторизации = КонтурДиадокAPI_ТипыАвторизации(); 
	
	ДополнительныеПараметры = Новый Структура("ПараметрыЗапроса, Данные, Json, Заголовки");
	
	ПараметрыСервиса = КонтурДиадокAPI_AuthenticateV1();
	
	Если ДанныеАвторизацииДиадок.ТипАвторизации = ТипыАвторизации.ЛогинПароль Тогда
		
		ТелоЗапроса = КонтурДиадокAPI_СоздатьПоСхеме("LoginPassword");
		ТелоЗапроса.Login = ДанныеАвторизацииДиадок.Логин;
		ТелоЗапроса.Password = ДанныеАвторизацииДиадок.Пароль; 
		
		ДополнительныеПараметры.Json = ТелоЗапроса;
		
	ИначеЕсли ДанныеАвторизацииДиадок.ТипАвторизации = ТипыАвторизации.Сертификат Тогда
		
		Если ЗначениеЗаполнено(ДанныеАвторизацииДиадок.ДвоичныеДанные) Тогда
			ДанныеСертификата = ДанныеАвторизацииДиадок.ДвоичныеДанные;
		ИначеЕсли КонтурДиадокAPI_СертификатДоступенНаСервере(ДанныеАвторизацииДиадок) Тогда
			Сертификат = КонтурДиадокAPIПереопределяемый_НайтиПоОтпечатку(ДанныеАвторизацииДиадок);			
			ДанныеСертификата = Сертификат.ДвоичныеДанные;				
		Иначе
			ВызватьИсключение "Не удалось определить данные сертификата";
		КонецЕсли;
		
		ДополнительныеПараметры.Данные = ДанныеСертификата; 
		
	ИначеЕсли ДанныеАвторизацииДиадок.ТипАвторизации = ТипыАвторизации.ИдентификаторСессии Тогда
		
		ДополнительныеПараметры.Данные = ДанныеАвторизацииДиадок.ИдентификаторСессии;
		
	Иначе
		
		ВызватьИсключение "Задан некорректный способ авторизации";	
		
	КонецЕсли; 
	
	ДополнительныеПараметры.ПараметрыЗапроса = ПараметрыСервиса.Параметры;
	ДополнительныеПараметры.Заголовки = ПараметрыСервиса.Заголовки; 
	
	Ответ = КонтурДиадокAPI_Post(Неопределено, ПараметрыСервиса.URL, ДополнительныеПараметры.Данные, ДополнительныеПараметры, МенеджерНастроек.Сессия); 	
	
	ПодготовленныйОтветКлиента = КонтурДиадокAPI_ОбработатьРезультатHTTPЗапроса(ПараметрыСервиса, Ответ);	
		
	Возврат ПодготовленныйОтветКлиента.Результат;
	 
КонецФункции

// Метод для подтверждения авторизации при использовании сертификата.
// Отправляет расшифрованный токен и отпечаток сертификата для завершения процедуры аутентификации.
// В случае HTTP ответа отличного от "200", выбрасывает исключение.
//
// Параметры:
//   РасшифрованныйТокен - Строка - Расшифрованное содержимое ответа, полученного при первичной авторизации.
//   Отпечаток           - Строка - Отпечаток сертификата, использованного для авторизации.
//
// Возвращаемое значение:
//   Строка - Токен для доступа к API Диадок.
//
Функция КонтурДиадокAPI_ПодтверждениеАвторизации(РасшифрованныйТокен, Отпечаток) Экспорт
	
	МенеджерНастроек = КонтурДиадокAPI_МенеджерНастроек();
		
	ПараметрыСервиса = КонтурДиадокAPI_AuthenticateConfirm();
 
	ПараметрыСервиса.Параметры.token = РасшифрованныйТокен; 
	ПараметрыСервиса.Параметры.thumbprint = Отпечаток; 
	ПараметрыСервиса.Параметры.saveBinding = "false"; 
	
	ДополнительныеПараметры = Новый Структура("ПараметрыЗапроса", ПараметрыСервиса.Параметры);
	
	Ответ = КонтурДиадокAPI_Post(Неопределено, ПараметрыСервиса.URL, , ДополнительныеПараметры, МенеджерНастроек.Сессия);
	
	ПодготовленныйОтветКлиента = КонтурДиадокAPI_ОбработатьРезультатHTTPЗапроса(ПараметрыСервиса, Ответ);
	
	Возврат ПодготовленныйОтветКлиента.Результат;
	
КонецФункции

// Метод для проверки квалифицированности сертификата электронной подписи в системе Диадок.
// Позволяет определить, является ли сертификат квалифицированным и действительным для работы с указанным ящиком.
// В случае HTTP ответа отличного от "200", выбрасывает исключение.
//
// Параметры:
//   ДанныеАвторизацииДиадок - Структура - см. метод КонтурДиадокAPI_НовыйДанныеАвторизации.
//   ИдентификаторЯщика      - Строка - Идентификатор ящика организации в Диадок.
//   ОтпечатокСертификата    - Строка - Отпечаток проверяемого сертификата.
//   ОтветВЛокальныхИменах   - Булево - Признак приведения имен свойств ответа к локальному формату (по умолчанию Ложь).
//
// Возвращаемое значение:
//   Структура - См. свойства в методе КонтурДиадокAPI_Схема_CertificateVerificationResponse.
//
Функция КонтурДиадокAPI_ПроверкаКвалифицированностиСертификата(Знач ДанныеАвторизацииДиадок, ИдентификаторЯщика, ОтпечатокСертификата, ОтветВЛокальныхИменах = Ложь) Экспорт
	
	КонтурДиадокAPI_УстановитьТокенДляЗапроса(ДанныеАвторизацииДиадок);
	
	МенеджерНастроек = КонтурДиадокAPI_МенеджерНастроек();

	ПараметрыСервиса = КонтурДиадокAPI_VerifyCertificate();
	
	Если ЗначениеЗаполнено(ДанныеАвторизацииДиадок.ДвоичныеДанные) Тогда
		ДанныеСертификата =	ДанныеАвторизацииДиадок.ДвоичныеДанные;
	ИначеЕсли КонтурДиадокAPI_СертификатДоступенНаСервере(ДанныеАвторизацииДиадок) Тогда
		Сертификат = КонтурДиадокAPIПереопределяемый_НайтиПоОтпечатку(ДанныеАвторизацииДиадок);
		ДанныеСертификата = Сертификат.ДвоичныеДанные;
	Иначе
		ВызватьИсключение "Не удалось определить данные сертификата";
	КонецЕсли;
			
	ТелоЗапроса = КонтурДиадокAPI_СоздатьПоСхеме("CertificateVerificationRequest");
	ТелоЗапроса.CertificateContent = КонтурСтандарт_Base64Строка(ДанныеСертификата);	
	
	ПараметрыЗапроса = Новый Структура("boxId", ИдентификаторЯщика);
		
	ДополнительныеПараметры = Новый Структура("Json, ПараметрыЗапроса, Заголовки", ТелоЗапроса, ПараметрыЗапроса, ПараметрыСервиса.Заголовки);
	
	Ответ = КонтурДиадокAPI_Post(ДанныеАвторизацииДиадок, ПараметрыСервиса.URL, Неопределено, ДополнительныеПараметры, МенеджерНастроек.Сессия); 	
	
	ПодготовленныйОтветКлиента = КонтурДиадокAPI_ОбработатьРезультатHTTPЗапроса(ПараметрыСервиса, Ответ);
	
	Возврат КонтурДиадокAPI_Привести("CertificateVerificationResponse", ПодготовленныйОтветКлиента.Результат, ОтветВЛокальныхИменах); 
	
КонецФункции

// Метод для получения информации о текущем авторизованном пользователе в системе Диадок.
// Возвращает данные учетной записи, включая идентификатор, имя, права доступа и связанные организации.
// В случае HTTP ответа отличного от "200", выбрасывает исключение.
//
// Параметры:
//   ДанныеАвторизацииДиадок - Структура - см. метод КонтурДиадокAPI_НовыйДанныеАвторизации.
//   ОтветВЛокальныхИменах   - Булево - Признак приведения имен свойств ответа к локальному формату (по умолчанию Ложь).
//
// Возвращаемое значение:
//   Структура - См. свойства в методе КонтурДиадокAPI_Схема_UserV2.
//
Функция КонтурДиадокAPI_ИнформацияТекущегоПользователя(Знач ДанныеАвторизацииДиадок, ОтветВЛокальныхИменах = Ложь) Экспорт
	
	КонтурДиадокAPI_УстановитьТокенДляЗапроса(ДанныеАвторизацииДиадок);
	
	МенеджерНастроек = КонтурДиадокAPI_МенеджерНастроек();

	ПараметрыСервиса = КонтурДиадокAPI_GetMyUser();
	
	ДополнительныеПараметры = Новый Структура("Заголовки", ПараметрыСервиса.Заголовки);
	
	Ответ = КонтурДиадокAPI_Get(ДанныеАвторизацииДиадок, ПараметрыСервиса.URL, Неопределено, ДополнительныеПараметры, МенеджерНастроек.Сессия); 	
	
	ПодготовленныйОтветКлиента = КонтурДиадокAPI_ОбработатьРезультатHTTPЗапроса(ПараметрыСервиса, Ответ);
	
	Возврат КонтурДиадокAPI_Привести("UserV2", ПодготовленныйОтветКлиента.Результат, ОтветВЛокальныхИменах);
	
КонецФункции

// Метод для получения списка сертификатов электронной подписи, доступных текущему пользователю в указанном ящике Диадок.
// Возвращает информацию об отпечатках, сроках действия и статусе сертификатов.
// В случае HTTP ответа отличного от "200", выбрасывает исключение.
//
// Параметры:
//   ДанныеАвторизацииДиадок - Структура - см. метод КонтурДиадокAPI_НовыйДанныеАвторизации.
//   ИдентификаторЯщика      - Строка - Идентификатор ящика организации в Диадок.
//   ОтветВЛокальныхИменах   - Булево - Признак приведения имен свойств ответа к локальному формату (по умолчанию Ложь).
//
// Возвращаемое значение:
//   Структура - См. свойства в методе КонтурДиадокAPI_Схема_CertificateList.
//
Функция КонтурДиадокAPI_ИнформацияОСертификатах(Знач ДанныеАвторизацииДиадок, ИдентификаторЯщика, ОтветВЛокальныхИменах = Ложь) Экспорт
	
	КонтурДиадокAPI_УстановитьТокенДляЗапроса(ДанныеАвторизацииДиадок);
	
	МенеджерНастроек = КонтурДиадокAPI_МенеджерНастроек();

	ПараметрыСервиса = КонтурДиадокAPI_GetMyCertificates();
	
	ПараметрыСервиса.Параметры.boxId = ИдентификаторЯщика;
	
	ДополнительныеПараметры = Новый Структура("Заголовки", ПараметрыСервиса.Заголовки);
	
	Ответ = КонтурДиадокAPI_Get(ДанныеАвторизацииДиадок, ПараметрыСервиса.URL, ПараметрыСервиса.Параметры, ДополнительныеПараметры, МенеджерНастроек.Сессия); 	
	
	ПодготовленныйОтветКлиента = КонтурДиадокAPI_ОбработатьРезультатHTTPЗапроса(ПараметрыСервиса, Ответ);
	
	Возврат КонтурДиадокAPI_Привести("CertificateList", ПодготовленныйОтветКлиента.Результат, ОтветВЛокальныхИменах);
	
КонецФункции

// Метод для проверки возможности использования сертификата для подписания документов в указанном ящике Диадок.
// Выполняет проверку на сервере Диадок, отправляя двоичные данные сертификата.
// В случае HTTP ответа отличного от "200", выбрасывает исключение.
//
// Параметры:
//   ДанныеАвторизацииДиадок - Структура - см. метод КонтурДиадокAPI_НовыйДанныеАвторизации.
//   ИдентификаторЯщика      - Строка - Идентификатор ящика организации в Диадок.
//   Отпечаток               - Строка - Отпечаток проверяемого сертификата.
//
// Возвращаемое значение:
//   Булево - Истина, если сертификат может использоваться для подписания документов в указанном ящике.
//
Функция КонтурДиадокAPI_СертификатИспользуетсяДляПодписания(Знач ДанныеАвторизацииДиадок, ИдентификаторЯщика, Отпечаток) Экспорт
	
	КонтурДиадокAPI_УстановитьТокенДляЗапроса(ДанныеАвторизацииДиадок);
	
	МенеджерНастроек = КонтурДиадокAPI_МенеджерНастроек();

	ПараметрыСервиса = КонтурДиадокAPI_CanSendInvoice();
	
	ПараметрыСервиса.Параметры.boxId = ИдентификаторЯщика;
	
	Если ЗначениеЗаполнено(ДанныеАвторизацииДиадок.ДвоичныеДанные) Тогда
		ДанныеСертификата =	ДанныеАвторизацииДиадок.ДвоичныеДанные;
	ИначеЕсли КонтурДиадокAPI_СертификатДоступенНаСервере(ДанныеАвторизацииДиадок) Тогда
		Сертификат = КонтурДиадокAPIПереопределяемый_НайтиПоОтпечатку(ДанныеАвторизацииДиадок);
		ДанныеСертификата = Сертификат.ДвоичныеДанные;
	Иначе
		ВызватьИсключение "Не удалось определить данные сертификата";
	КонецЕсли;
			
	Данные = ДанныеСертификата;
	
	ДополнительныеПараметры = Новый Структура("Заголовки, ПараметрыЗапроса", ПараметрыСервиса.Заголовки, ПараметрыСервиса.Параметры);
	
	Ответ = КонтурДиадокAPI_Post(ДанныеАвторизацииДиадок, ПараметрыСервиса.URL, Данные, ДополнительныеПараметры, МенеджерНастроек.Сессия); 	
	
	ПодготовленныйОтветКлиента = КонтурДиадокAPI_ОбработатьРезультатHTTPЗапроса(ПараметрыСервиса, Ответ);
	
	Возврат Ответ.КодСостояния = КлиентHTTP_КодыСостоянияHTTP().ОК_200;
	
КонецФункции 

