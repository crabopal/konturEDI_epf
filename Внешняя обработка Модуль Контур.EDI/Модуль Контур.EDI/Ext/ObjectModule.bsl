КонецФункции

Функция КлиентHTTP_ВызватьHTTPМетод(Сессия, Метод, URL, ДополнительныеПараметры)
	
	ПодготовленныйЗапрос = КлиентHTTP_ПодготовитьЗапрос(Сессия, Метод, URL, ДополнительныеПараметры);
	
	Ответ = КлиентHTTP_Переопределяемый_ВызватьHTTPМетод(Сессия, Метод, URL, ДополнительныеПараметры);
	
	Если НЕ Ответ = Неопределено Тогда 
		
		Возврат Ответ;
	
	КонецЕсли;
	
	НастройкиПодключения = КлиентHTTP_НастройкиПодключения(Метод, URL, ДополнительныеПараметры);
	
	Ответ = КлиентHTTP_ОтправитьЗапрос(Сессия, ПодготовленныйЗапрос, НастройкиПодключения);

	Возврат Ответ;
	
КонецФункции

Функция КлиентHTTP_ОтправитьЗапрос(Сессия, ПодготовленныйЗапрос, Настройки)
	
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	МиллисекундВСекунде = 1000;
	
	Повтор = 0;
	Длительность = 0;
	Ошибки = Новый Массив;
	
	Пока Истина Цикл
		Попытка
			Ответ = КлиентHTTP_ОтправитьHTTPЗапрос(Сессия, ПодготовленныйЗапрос, Настройки);
			ОшибкаВыполненияЗапроса = Неопределено;
		Исключение
			ОшибкаВыполненияЗапроса = ИнформацияОбОшибке();
			
			ТекстОшибки = КонтурСтандарт_СтрШаблон_(
			НСтр("ru = 'HTTP %1 %2
			|Network error:
			|%3'"),
			ПодготовленныйЗапрос.Метод,
			ПодготовленныйЗапрос.URL,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
			);
			Ошибки.Добавить(ТекстОшибки);
		КонецПопытки;
		
		Повтор = Повтор + 1;
		Длительность = (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / МиллисекундВСекунде;
		
		Если Не КлиентHTTP_НеобходимоПовторитьЗапрос(Ответ, Настройки, ОшибкаВыполненияЗапроса) Тогда
			Прервать;
		КонецЕсли;
		
		Если Повтор > Настройки.МаксимальноеКоличествоПовторов
			ИЛИ Длительность > Настройки.МаксимальноеВремяПовторов Тогда
			Прервать;
		КонецЕсли;
		
		Если ОшибкаВыполненияЗапроса <> Неопределено
			ИЛИ НЕ КлиентHTTP_ЭтоКодСостоянияПриКоторомНужноУчитыватьЗаголовокRetryAfter(Ответ.КодСостояния) Тогда
			ЗаголовокRetryAfter = Ложь;
		Иначе
			ЗаголовокRetryAfter = КлиентHTTP_ЗначениеЗаголовка("retry-after", Ответ.Заголовки);
		КонецЕсли;
				
	 	ДлительностьПриостановки = КлиентHTTP_РассчитатьДлительностьПриостановки(
		Повтор,
		Настройки.КоэффициентЭкспоненциальнойЗадержки,
		ЗаголовокRetryAfter,
		Настройки.МаксимальноеВремяПовторов - Длительность);
		
		КлиентHTTP_Приостановить(ДлительностьПриостановки);
		
	КонецЦикла;
	
	Если ОшибкаВыполненияЗапроса <> Неопределено Тогда
		ВызватьИсключение(ПодробноеПредставлениеОшибки(ОшибкаВыполненияЗапроса));
	КонецЕсли;
	
	ЗаголовокContentType = КлиентHTTP_ЗначениеЗаголовка("content-type", Ответ.Заголовки);
	Если ЗаголовокContentType = Ложь Тогда
		ЗаголовокContentType = "";
	КонецЕсли;
	
	ПодготовленныйОтвет = КлиентHTTP_НовыйОтвет();
	ПодготовленныйОтвет.Метод = ПодготовленныйЗапрос.Метод;
	ПодготовленныйОтвет.URL = ПодготовленныйЗапрос.URL;
	ПодготовленныйОтвет.КодСостояния = Ответ.КодСостояния;
	ПодготовленныйОтвет.Заголовки = Ответ.Заголовки;
	
	Если ТипЗнч(Ответ) = Тип("HTTPОтвет") Тогда
		ПодготовленныйОтвет.Тело = Ответ.ПолучитьТелоКакДвоичныеДанные();	
	Иначе     
		ПодготовленныйОтвет.Тело = Ответ.ТелоОтвета;		
	КонецЕсли; 

	ПодготовленныйОтвет.Кодировка = КлиентHTTP_КодировкаИзЗаголовка(ЗаголовокContentType);
	ПодготовленныйОтвет.ВремяВыполнения = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	
	Возврат ПодготовленныйОтвет;
	
КонецФункции

Функция КлиентHTTP_НеобходимоПовторитьЗапрос(Ответ, Настройки, ОшибкаВыполненияЗапроса)
	
	Если Настройки.МаксимальноеКоличествоПовторов < 1 Тогда
		ПовторитьЗапрос = Ложь;
	ИначеЕсли ОшибкаВыполненияЗапроса <> Неопределено ИЛИ КлиентHTTP_ПовторятьПриКодеСостояния(Ответ.КодСостояния, Настройки) Тогда
		ПовторитьЗапрос = Истина;
	Иначе
		ЗаголовокRetryAfter = КлиентHTTP_ЗначениеЗаголовка("retry-after", Ответ.Заголовки);
		ПовторитьЗапрос = ЗаголовокRetryAfter <> Ложь
		И КлиентHTTP_ЭтоКодСостоянияПриКоторомНужноУчитыватьЗаголовокRetryAfter(Ответ.КодСостояния);
	КонецЕсли;
	
	Возврат ПовторитьЗапрос;         
	
КонецФункции

Функция КлиентHTTP_ЭтоКодСостоянияПриКоторомНужноУчитыватьЗаголовокRetryAfter(КодСостояния)
	
	КодыСостоянияHTTP = КлиентHTTP_КодыСостоянияHTTP();
	
	Возврат КодСостояния = КодыСостоянияHTTP.ПолезнаяНагрузкаСлишкомВелика_413
	ИЛИ КодСостояния = КодыСостоянияHTTP.СлишкомМногоЗапросов_429
	ИЛИ КодСостояния = КодыСостоянияHTTP.СервисНедоступен_503;
	
КонецФункции

Функция КлиентHTTP_ПовторятьПриКодеСостояния(КодСостояния, Настройки)
	
	ПовторПриЛюбомКодеСостоянияБольшеИлиРавным500 = Настройки.ПовторятьДляКодовСостояний = Неопределено
	И КодСостояния >= 500;
	КодСостоянияСоответствуетКодуСостоянияПовтора = ТипЗнч(Настройки.ПовторятьДляКодовСостояний) = Тип("Массив")
	И Настройки.ПовторятьДляКодовСостояний.Найти(КодСостояния) <> Неопределено;
	Возврат ПовторПриЛюбомКодеСостоянияБольшеИлиРавным500 ИЛИ КодСостоянияСоответствуетКодуСостоянияПовтора;
	
КонецФункции

Функция КлиентHTTP_ОтправитьHTTPЗапрос(Сессия, ПодготовленныйЗапрос, Настройки)
	
	МенеджерНастроек = КлиентHTTP_МенеджерНастроек();
	
	СтруктураURL = КлиентHTTP_РазобратьURL(ПодготовленныйЗапрос.URL);
	
	Если НЕ МенеджерНастроек.ИспользоватьВнешнийАлгоритм Тогда 
		
		Соединение = КлиентHTTP_Соединение(СтруктураURL, Настройки, Сессия);
		
		Если КонтурСтандарт_ВерсияПлатформыНеНижеУказанной("8.3.6") Тогда
			
			Ответ = Соединение.ВызватьHTTPМетод(ПодготовленныйЗапрос.Метод, ПодготовленныйЗапрос.HTTPЗапрос);
			
		Иначе
			
			Если ВРег(ПодготовленныйЗапрос.Метод) = "GET" Тогда 
				
				Ответ = Соединение.Получить(ПодготовленныйЗапрос.HTTPЗапрос);
				
			ИначеЕсли ВРег(ПодготовленныйЗапрос.Метод) = "POST" Тогда 
				
				Ответ = Соединение.ОтправитьДляОбработки(ПодготовленныйЗапрос.HTTPЗапрос);
				
			ИначеЕсли ВРег(ПодготовленныйЗапрос.Метод) = "PUT" Тогда 
				
				Ответ = Соединение.Записать(ПодготовленныйЗапрос.HTTPЗапрос);
				
			ИначеЕсли ВРег(ПодготовленныйЗапрос.Метод) = "DELETE" Тогда 
				
				Ответ = Соединение.Удалить(ПодготовленныйЗапрос.HTTPЗапрос);
				
			Иначе
				
				ВызватьИсключение "Не реализована работа с HTTP методом: " + ПодготовленныйЗапрос.Метод;
				
			КонецЕсли;
			
		КонецЕсли;

	Иначе  
		ИмяФункцииHTTPЗапроса = МенеджерНастроек.ИмяФункцииHTTPЗапроса;
		
		Если НЕ ТипЗнч(ИмяФункцииHTTPЗапроса) = Тип("Строка") 
			ИЛИ ПустаяСтрока(ИмяФункцииHTTPЗапроса) Тогда
			
			ВызватьИсключение "В менеджере настроек модуля КлиентHTTP неправильно указано имя функции для выполнения запроса."; 	
			
		КонецЕсли;
		
		МодульФункцииHTTPЗапроса = МенеджерНастроек.МодульФункцииHTTPЗапроса;
		
		Если МодульФункцииHTTPЗапроса = Неопределено Тогда
			
			МодульФункцииHTTPЗапроса = ЭтотОбъект;
			
		КонецЕсли;
		
		ВыражениеДляВычисления = КонтурСтандарт_СтрШаблон_("МодульФункцииHTTPЗапроса.%1(Сессия, ПодготовленныйЗапрос, Настройки)", ИмяФункцииHTTPЗапроса);
		
		Ответ = Вычислить(ВыражениеДляВычисления);
		
		Ответ.КодСостояния = Число(Ответ.КодСостояния);
		
	КонецЕсли;

	Возврат Ответ;
	
КонецФункции

Функция КлиентHTTP_Соединение(ПараметрыСоединения, ДополнительныеПараметры, Сессия)
	
	Если Не ЗначениеЗаполнено(ПараметрыСоединения.Порт) Тогда
		Если ПараметрыСоединения.Схема = "https" Тогда
			ПараметрыСоединения.Порт = 443;
		Иначе
			ПараметрыСоединения.Порт = 80;
		КонецЕсли;
	КонецЕсли;
	
	ЗащищенноеСоединение = Неопределено;
	Если ПараметрыСоединения.Схема = "https" Тогда
		ЗащищенноеСоединение = Вычислить("Новый ЗащищенноеСоединениеOpenSSL");
	КонецЕсли;

	Если ДополнительныеПараметры.Прокси <> Неопределено Тогда
		ПроксиСоединения = ДополнительныеПараметры.Прокси; 	
	ИначеЕсли Сессия.Прокси <>  Неопределено Тогда
		ПроксиСоединения = Сессия.Прокси;	
	Иначе
		ПроксиСоединения = Неопределено;	
	КонецЕсли;
	
	ПараметрыДляРасчетаИдентификатора = Новый Массив;
	ПараметрыДляРасчетаИдентификатора.Добавить(ПараметрыСоединения.Сервер);
	ПараметрыДляРасчетаИдентификатора.Добавить(ПараметрыСоединения.Порт);
	ПараметрыДляРасчетаИдентификатора.Добавить(ДополнительныеПараметры.Таймаут);
	ПараметрыДляРасчетаИдентификатора.Добавить(ЗащищенноеСоединение);
	ПараметрыДляРасчетаИдентификатора.Добавить(ПроксиСоединения);
	
	Если Не Сессия.Свойство("СлужебныеДанные") ИЛИ ТипЗнч(Сессия.СлужебныеДанные) <> Тип("Структура") Тогда
		Сессия.Вставить("СлужебныеДанные", Новый Структура);
	КонецЕсли;
	
	Если Не Сессия.СлужебныеДанные.Свойство("ПулСоединений") Тогда
		Сессия.СлужебныеДанные.Вставить("ПулСоединений", Новый Соответствие);
	КонецЕсли;
	ПулСоединений = Сессия.СлужебныеДанные.ПулСоединений;
	
	ИдентификаторСоединения = КлиентHTTP_ИдентификаторСоединения(ПараметрыДляРасчетаИдентификатора);
	
	Если ПулСоединений.Получить(ИдентификаторСоединения) = Неопределено Тогда
		Если КонтурСтандарт_ВерсияПлатформыНеНижеУказанной("8.3.7") Тогда
			НовоеСоединение =  Вычислить("Новый HTTPСоединение(
			|ПараметрыСоединения.Сервер,
			|ПараметрыСоединения.Порт,
			|, ,
			|ПроксиСоединения,
			|ДополнительныеПараметры.Таймаут, 
			|ЗащищенноеСоединение)"); 
		ИначеЕсли КонтурСтандарт_ВерсияПлатформыНеНижеУказанной("8.2.19.130") Тогда
			НовоеСоединение = Вычислить("Новый HTTPСоединение(
			|ПараметрыСоединения.Сервер,
			|ПараметрыСоединения.Порт,
			|, ,
			|ПроксиСоединения,
			|ДополнительныеПараметры.Таймаут, 
			|ЗащищенноеСоединение)");	
		Иначе
			НовоеСоединение = Новый HTTPСоединение(
			ПараметрыСоединения.Сервер,
			ПараметрыСоединения.Порт,
			, ,
			ПроксиСоединения,
			ЗащищенноеСоединение <> Неопределено); 
		КонецЕсли;
		ПулСоединений.Вставить(ИдентификаторСоединения, НовоеСоединение);
	КонецЕсли;
	
	Возврат ПулСоединений[ИдентификаторСоединения];
	
КонецФункции

Функция КлиентHTTP_ИдентификаторСоединения(ПараметрыСоединения)
	
	ПараметрыДляРасчетаИдентификатора = Новый Массив;
	
	Для Каждого Элемент Из ПараметрыСоединения Цикл 
		
		ТипЭлемента = ТипЗнч(Элемент);
		Если ТипЭлемента = Тип("ИнтернетПрокси") Тогда
			ПараметрыДляРасчетаИдентификатора.Добавить(КонтурСтандарт_СтрСоединить_(Элемент.НеИспользоватьПроксиДляАдресов, ""));
			ПараметрыДляРасчетаИдентификатора.Добавить(XMLСтрока(Элемент.НеИспользоватьПроксиДляЛокальныхАдресов));
			ПараметрыДляРасчетаИдентификатора.Добавить(Элемент.Пользователь);
			ПараметрыДляРасчетаИдентификатора.Добавить(Элемент.Пароль);
		ИначеЕсли ТипЭлемента = Тип("ЗащищенноеСоединениеOpenSSL") Тогда 
			
		Иначе
			ПараметрыДляРасчетаИдентификатора.Добавить(XMLСтрока(Элемент));
		КонецЕсли; 
		
	КонецЦикла;
		
	
	Возврат КонтурСтандарт_ХешированиеFNV1A128(КонтурСтандарт_СтрСоединить_(ПараметрыДляРасчетаИдентификатора, ""));

	
КонецФункции

Функция КлиентHTTP_НовыйОтвет() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Метод", "GET");
	Результат.Вставить("URL", "");
	Результат.Вставить("КодСостояния", 600); // Сетевая ошибка (>500)
	Результат.Вставить("Заголовки", Новый Соответствие);
	Результат.Вставить("Тело", Base64Значение(""));
	Результат.Вставить("Кодировка", "utf-8");
	Результат.Вставить("ВремяВыполнения", Неопределено);
	Результат.Вставить("Ошибки", Новый Массив);
	
	Возврат Результат;
	
КонецФункции

Функция КлиентHTTP_НастройкиПодключения(Метод, URL, ДополнительныеПараметры)
	
	ПроверятьSSL = КонтурСтандарт_ЗначениеПоКлючу(ДополнительныеПараметры, "ПроверятьSSL", Истина);
	Прокси = КонтурСтандарт_ЗначениеПоКлючу(ДополнительныеПараметры, "Прокси", Новый ИнтернетПрокси);
	
	МаксимальноеКоличествоПовторов = КонтурСтандарт_ЗначениеПоКлючу(ДополнительныеПараметры, "МаксимальноеКоличествоПовторов", 3);
	ПовторятьДляКодовСостояний = КонтурСтандарт_ЗначениеПоКлючу(ДополнительныеПараметры, "ПовторятьДляКодовСостояний", Неопределено);
	КоэффициентЭкспоненциальнойЗадержки = КонтурСтандарт_ЗначениеПоКлючу(ДополнительныеПараметры, "КоэффициентЭкспоненциальнойЗадержки", 1);
	МаксимальноеВремяПовторов = КонтурСтандарт_ЗначениеПоКлючу(ДополнительныеПараметры, "МаксимальноеВремяПовторов", 600);

	
	Настройки = Новый Структура;
	Настройки.Вставить("Таймаут", КлиентHTTP_Таймаут(ДополнительныеПараметры));
	Настройки.Вставить("ПроверятьSSL", ПроверятьSSL);
	Настройки.Вставить("Прокси", Прокси);
	Настройки.Вставить("МаксимальноеКоличествоПовторов", МаксимальноеКоличествоПовторов);
	Настройки.Вставить("ПовторятьДляКодовСостояний", ПовторятьДляКодовСостояний);
	Настройки.Вставить("КоэффициентЭкспоненциальнойЗадержки", КоэффициентЭкспоненциальнойЗадержки);
	Настройки.Вставить("МаксимальноеВремяПовторов", МаксимальноеВремяПовторов);
	
	Возврат Настройки;
	
КонецФункции

Функция КлиентHTTP_ПодготовитьЗапрос(Сессия, Метод, URL, ДополнительныеПараметры) Экспорт
	
	Перем Json, Файлы, Данные;
	
	ПараметрыЗапросаИзДополнительныхПараметров =
	КлиентHTTP_ВыбратьЗначение(Неопределено, ДополнительныеПараметры, "ПараметрыЗапроса", Новый Структура);
	ЗаголовкиИзДополнительныхПараметров =
	КлиентHTTP_ВыбратьЗначение(Неопределено, ДополнительныеПараметры, "Заголовки", Новый Соответствие);
	
	ПараметрыЗапроса = КлиентHTTP_Объединить(КлиентHTTP_Скопировать(ПараметрыЗапросаИзДополнительныхПараметров), Сессия.ПараметрыЗапроса);
	Заголовки = КлиентHTTP_Объединить(КлиентHTTP_Скопировать(ЗаголовкиИзДополнительныхПараметров), Сессия.Заголовки);
	
	ПодготовленныйЗапрос = Новый Структура;
	ПодготовленныйЗапрос.Вставить("Метод", Метод);
	ПодготовленныйЗапрос.Вставить("Заголовки", Заголовки);
	ПодготовленныйЗапрос.Вставить("ПараметрыЗапроса", ПараметрыЗапроса);
	ПодготовленныйЗапрос.Вставить("URL", КлиентHTTP_ПодготовитьURL(URL, ПараметрыЗапроса));
	
	
	Данные = КлиентHTTP_ВыбратьЗначение(Неопределено, ДополнительныеПараметры, "Данные", Новый Структура);
	Файлы = КлиентHTTP_ВыбратьЗначение(Неопределено, ДополнительныеПараметры, "Файлы", Новый Массив);
	Json = КлиентHTTP_ВыбратьЗначение(Неопределено, ДополнительныеПараметры, "Json", Неопределено);
	
	КлиентHTTP_ПодготовитьТелоЗапроса(ПодготовленныйЗапрос, Данные, Файлы, Json);
	
	Возврат ПодготовленныйЗапрос;
	
КонецФункции

Процедура КлиентHTTP_ПодготовитьТелоЗапроса(ПодготовленныйЗапрос, Данные, Файлы, Json)
	
	СтруктураURL = КлиентHTTP_РазобратьURL(ПодготовленныйЗапрос.URL);
	
	HTTPЗапрос = Новый HTTPЗапрос;
	HTTPЗапрос.АдресРесурса = КлиентHTTP_СобратьАдресРесурса(СтруктураURL, ПодготовленныйЗапрос.ПараметрыЗапроса);
	Если ЗначениеЗаполнено(Файлы) Тогда
		ContentType = КлиентHTTP_ЗакодироватьФайлы(HTTPЗапрос, Файлы, Данные);
	ИначеЕсли ЗначениеЗаполнено(Данные) Тогда
		ContentType = "application/x-www-form-urlencoded";
		Если ТипЗнч(Данные) = Тип("ДвоичныеДанные") Тогда
			HTTPЗапрос.УстановитьТелоИзДвоичныхДанных(Данные);
		Иначе
			Если ТипЗнч(Данные) = Тип("Строка") Тогда
				Тело = Данные;
			Иначе
				Тело = КлиентHTTP_КодироватьПараметрыЗапроса(Данные);
			КонецЕсли;
			ContentType = "application/x-www-form-urlencoded; charset=utf-8";
			
			Если КонтурСтандарт_ВерсияПлатформыНеНижеУказанной("8.3.6") Тогда
				HTTPЗапрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, Вычислить("ИспользованиеByteOrderMark.НеИспользовать"));	
			ИначеЕсли ТипЗнч(КонфигурацияПровайдера) = Тип("ФиксированнаяСтруктура") 
				И Найти(ПодготовленныйЗапрос.URL, КонфигурацияПровайдера.Хост) > 0 Тогда
				HTTPЗапрос.УстановитьТелоИзСтроки(Тело, "CESU-8"); // аналог UTF8 без BOM для 1С 8.2
			Иначе
				HTTPЗапрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);
			КонецЕсли;
			
		КонецЕсли;
	ИначеЕсли Json <> Неопределено Тогда
		ContentType = "application/json; charset=utf-8";
		СтрокаJson = КонтурСтандарт_ЗначениеВСтрокуJSON(Json);
		
		Если КонтурСтандарт_ВерсияПлатформыНеНижеУказанной("8.3.6") Тогда
			HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаJson, КодировкаТекста.UTF8, Вычислить("ИспользованиеByteOrderMark.НеИспользовать"));	
		Иначе
			HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаJson, КодировкаТекста.UTF8);
		КонецЕсли;
		
	Иначе
		ContentType = Неопределено;
	КонецЕсли;
	ЗначениеЗаголовка = КлиентHTTP_ЗначениеЗаголовка("content-type", ПодготовленныйЗапрос.Заголовки);
	Если ЗначениеЗаголовка = Ложь И ЗначениеЗаполнено(ContentType) Тогда
		ПодготовленныйЗапрос.Заголовки.Вставить("Content-Type", ContentType);
	КонецЕсли;
	
	HTTPЗапрос.Заголовки = ПодготовленныйЗапрос.Заголовки;
	
	ПодготовленныйЗапрос.Вставить("HTTPЗапрос", HTTPЗапрос);
	
КонецПроцедуры

Функция КлиентHTTP_ЗакодироватьФайлы(HTTPЗапрос, Файлы, Данные)
	
	Части = Новый Массив;
	Если ЗначениеЗаполнено(Данные) Тогда
		Для Каждого Поле Из Данные Цикл
			Части.Добавить(КлиентHTTP_СоздатьПолеФормы(Новый Структура("Имя,Данные", Поле.Ключ, Поле.Значение)));
		КонецЦикла;
	КонецЕсли;
	Если ТипЗнч(Файлы) = Тип("Массив") Тогда
		Для Каждого Файл Из Файлы Цикл
			Части.Добавить(КлиентHTTP_СоздатьПолеФормы(Файл));
		КонецЦикла;
	Иначе
		Части.Добавить(КлиентHTTP_СоздатьПолеФормы(Файлы));
	КонецЕсли;
	
	Разделитель = СтрЗаменить(Новый УникальныйИдентификатор, "-", "");
		
	Если КонтурСтандарт_ДоступнаРаботаСПотоками() Тогда
		
		РазделительСтрок = Символы.ВК + Символы.ПС;
		
		ТелоЗапроса = HTTPЗапрос.ПолучитьТелоКакПоток();
 
		ЗаписьДанных = Вычислить("Новый ЗаписьДанных(ТелоЗапроса, КодировкаТекста.UTF8, ПорядокБайтов.LittleEndian, """", """", Ложь)");
		Для Каждого Часть Из Части Цикл
			ЗаписьДанных.ЗаписатьСтроку("--" + Разделитель + РазделительСтрок);
			ЗаписьДанных.ЗаписатьСтроку(КлиентHTTP_ЗаголовкиВСтроку(Часть.Заголовки));
			Если ТипЗнч(Часть.Данные) = Тип("ДвоичныеДанные") Тогда
				ЗаписьДанных.Записать(Часть.Данные);
			Иначе
				ЗаписьДанных.ЗаписатьСтроку(Часть.Данные);
			КонецЕсли;
			ЗаписьДанных.ЗаписатьСтроку(РазделительСтрок);
		КонецЦикла;
		ЗаписьДанных.ЗаписатьСтроку("--" + Разделитель + "--" + РазделительСтрок);
		ЗаписьДанных.Закрыть();
		
	Иначе   
		ИмяВременногоФайлаТела = ПолучитьИмяВременногоФайла();
		МассивИменВременныхФайлов = Новый Массив;
		
		Для Каждого Часть Из Части Цикл
			ИмяВФ = ПолучитьИмяВременногоФайла();
			МассивИменВременныхФайлов.Добавить(ИмяВФ);
			
			// кодировка CESU-8 совместима с UTF-8, но позволяет писать файл без BOM
			ЗаписьТекста = Новый ЗаписьТекста(ИмяВФ, "CESU-8", Символы.ПС, Ложь, Символы.ПС);
			
			ЗаписьТекста.ЗаписатьСтроку("--" + Разделитель);
			ЗаписьТекста.ЗаписатьСтроку(КлиентHTTP_ЗаголовкиВСтроку(Часть.Заголовки));
			ЗаписьТекста.ЗаписатьСтроку("");
			Если ТипЗнч(Часть.Данные) = Тип("ДвоичныеДанные") Тогда
				ЗаписьТекста.Закрыть();
				
				ИмяВФ = ПолучитьИмяВременногоФайла();
				МассивИменВременныхФайлов.Добавить(ИмяВФ);
				Часть.Данные.Записать(ИмяВФ);
				
				ИмяВФ = ПолучитьИмяВременногоФайла();
				МассивИменВременныхФайлов.Добавить(ИмяВФ);
				
				ЗаписьТекста = Новый ЗаписьТекста(ИмяВФ, "CESU-8", Символы.ПС, Ложь, Символы.ПС);
				ЗаписьТекста.ЗаписатьСтроку("");
				ЗаписьТекста.Закрыть();
			Иначе
				ЗаписьТекста.ЗаписатьСтроку(Часть.Данные);
				ЗаписьТекста.Закрыть();
			КонецЕсли;
		КонецЦикла;
		ИмяВФ = ПолучитьИмяВременногоФайла();
		МассивИменВременныхФайлов.Добавить(ИмяВФ);
		ЗаписьТекста = Новый ЗаписьТекста(ИмяВФ, "CESU-8", Символы.ПС, Ложь, Символы.ПС);
		ЗаписьТекста.ЗаписатьСтроку("--" + Разделитель + "--");
		ЗаписьТекста.ЗаписатьСтроку("");
		ЗаписьТекста.Закрыть();
		ОбъединитьФайлы(МассивИменВременныхФайлов, ИмяВременногоФайлаТела);
		
		HTTPЗапрос.УстановитьТелоИзДвоичныхДанных(Новый ДвоичныеДанные(ИмяВременногоФайлаТела));
		
		Для Каждого ИмяВФ Из МассивИменВременныхФайлов Цикл
			Попытка
				УдалитьФайлы(ИмяВФ);
			Исключение
			КонецПопытки;
		КонецЦикла;
		Попытка
			УдалитьФайлы(ИмяВременногоФайлаТела);
		Исключение
		КонецПопытки;
		
	КонецЕсли;  
	
	Возврат КонтурСтандарт_СтрШаблон_("multipart/form-data; boundary=%1", Разделитель);
	
КонецФункции

Функция КлиентHTTP_СоздатьПолеФормы(ИсходныеПараметры)
	
	Поле = Новый Структура("Имя,ИмяФайла,Данные,Тип,Заголовки");
	Поле.Имя = ИсходныеПараметры.Имя;
	Поле.Данные = ИсходныеПараметры.Данные;
	
	Поле.Тип = КонтурСтандарт_ЗначениеПоКлючу(ИсходныеПараметры, "Тип");
	Поле.Заголовки = КонтурСтандарт_ЗначениеПоКлючу(ИсходныеПараметры, "Заголовки", Новый Соответствие);
	Поле.ИмяФайла = КонтурСтандарт_ЗначениеПоКлючу(ИсходныеПараметры, "ИмяФайла");
	
	Ключ = "Content-Disposition";
	Если КлиентHTTP_ЗначениеЗаголовка("content-disposition", Поле.Заголовки, Ключ) = Ложь Тогда
		Поле.Заголовки.Вставить("Content-Disposition", "form-data");
	КонецЕсли;
	
	Части = Новый Массив;
	Части.Добавить(Поле.Заголовки[Ключ]);
	Части.Добавить(КонтурСтандарт_СтрШаблон_("name=""%1""", Поле.Имя));
	Если ЗначениеЗаполнено(Поле.ИмяФайла) Тогда
		Части.Добавить(КонтурСтандарт_СтрШаблон_("filename=""%1""", Поле.ИмяФайла));
	КонецЕсли;
	
	Поле.Заголовки[Ключ] = КонтурСтандарт_СтрСоединить_(Части, "; ");
	Поле.Заголовки["Content-Type"] = Поле.Тип;
	
	Возврат Поле;
	
КонецФункции

Функция КлиентHTTP_ЗаголовкиВСтроку(Заголовки)
	
	РазделительСтрок = Символы.ВК + Символы.ПС;
	Строки = Новый Массив;
	
	СортированныеЗаголовки = "Content-Disposition,Content-Type,Content-Location";
	Для Каждого Ключ Из КонтурСтандарт_СтрРазделить_(СортированныеЗаголовки, ",") Цикл
		Значение = КлиентHTTP_ЗначениеЗаголовка(Ключ, Заголовки);
		Если Значение <> Ложь И ЗначениеЗаполнено(Значение) Тогда
			Строки.Добавить(КонтурСтандарт_СтрШаблон_("%1: %2", Ключ, Значение));
		КонецЕсли;
	КонецЦикла;
	
	Ключи = КонтурСтандарт_СтрРазделить_(ВРег(СортированныеЗаголовки), ",");
	Для Каждого Заголовок Из Заголовки Цикл
		Если Ключи.Найти(ВРег(Заголовок.Ключ)) = Неопределено Тогда
			Строки.Добавить(КонтурСтандарт_СтрШаблон_("%1: %2", Заголовок.Ключ, Заголовок.Значение));
		КонецЕсли;
	КонецЦикла;
	Строки.Добавить(РазделительСтрок);
	
	Возврат КонтурСтандарт_СтрСоединить_(Строки, РазделительСтрок);
	
КонецФункции

Процедура КлиентHTTP_УдалитьЗаголовки(Заголовки, СписокЗаголовковСтрокой)
	
	ЗаголовкиДляУдаления = Новый Массив;
	СписокЗаголовков = КонтурСтандарт_СтрРазделить_(СписокЗаголовковСтрокой, ",", Ложь);
	Для Каждого Заголовок Из Заголовки Цикл
		Если СписокЗаголовков.Найти(НРег(Заголовок.Ключ)) <> Неопределено Тогда
			ЗаголовкиДляУдаления.Добавить(Заголовок.Ключ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ЗаголовокДляУдаления Из ЗаголовкиДляУдаления Цикл
		Заголовки.Удалить(ЗаголовокДляУдаления);
	КонецЦикла;
	
КонецПроцедуры

Функция КлиентHTTP_ПодготовитьURL(Знач URL, ПараметрыЗапроса = Неопределено)
	
	URL = СокрЛ(URL);
	
	СтруктураURL = КлиентHTTP_РазобратьURL(URL);
	
	ПодготовленныйURL = СтруктураURL.Схема + "://";
	Если ЗначениеЗаполнено(СтруктураURL.Аутентификация.Пользователь) Тогда
		ПодготовленныйURL = ПодготовленныйURL
		+ СтруктураURL.Аутентификация.Пользователь + ":"
		+ СтруктураURL.Аутентификация.Пароль + "@";
	КонецЕсли;
	ПодготовленныйURL = ПодготовленныйURL + СтруктураURL.Сервер;
	Если ЗначениеЗаполнено(СтруктураURL.Порт) Тогда
		ПодготовленныйURL = ПодготовленныйURL + ":" + Формат(СтруктураURL.Порт, "ЧРГ=; ЧГ=");
	КонецЕсли;
	
	ПодготовленныйURL = ПодготовленныйURL + КлиентHTTP_СобратьАдресРесурса(СтруктураURL, ПараметрыЗапроса);
	ПодготовленныйURL = КонтурСтандарт_КодироватьСтроку_(ПодготовленныйURL,КонтурСтандарт_СпособКодированияСтроки().URLВКодировкеURL);
	Возврат ПодготовленныйURL;
	
КонецФункции

Функция КлиентHTTP_СобратьАдресРесурса(СтруктураURL, ПараметрыЗапроса)
	
	АдресРесурса = СтруктураURL.Путь;
	
	ОбъединенныеПараметрыЗапроса = КлиентHTTP_Объединить(КлиентHTTP_Скопировать(ПараметрыЗапроса), СтруктураURL.ПараметрыЗапроса);
	Если ЗначениеЗаполнено(ОбъединенныеПараметрыЗапроса) Тогда
		АдресРесурса = АдресРесурса + "?" + КлиентHTTP_КодироватьПараметрыЗапроса(ОбъединенныеПараметрыЗапроса);
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураURL.Фрагмент) Тогда
		АдресРесурса = АдресРесурса + "#" + СтруктураURL.Фрагмент;
	КонецЕсли;
	
	Возврат АдресРесурса;
	
КонецФункции

Функция КлиентHTTP_КодироватьПараметрыЗапроса(ПараметрыЗапроса)
	
	ЧастиПараметрыЗапроса = Новый Массив;
	Для Каждого Параметр Из ПараметрыЗапроса Цикл
		Если ТипЗнч(Параметр.Значение) = Тип("Массив") Тогда
			Значения = Параметр.Значение;
		Иначе
			Значения = Новый Массив;
			Значения.Добавить(Параметр.Значение);
		КонецЕсли;
		
		Если Параметр.Значение = Неопределено Тогда
			ЧастиПараметрыЗапроса.Добавить(Параметр.Ключ);
		Иначе
			Для Каждого Значение Из Значения Цикл
				ЗначениеПараметра = КонтурСтандарт_КодироватьСтроку_(Значение, КонтурСтандарт_СпособКодированияСтроки().КодировкаURL);
				ЧастиПараметрыЗапроса.Добавить(КонтурСтандарт_СтрШаблон_("%1=%2", Параметр.Ключ, ЗначениеПараметра));
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Возврат КонтурСтандарт_СтрСоединить_(ЧастиПараметрыЗапроса, "&");
	
КонецФункции

Функция КлиентHTTP_НовыеПараметры() Экспорт
	
	Параметры = Новый Структура;
	Параметры.Вставить("Заголовки", Новый Соответствие);
	Параметры.Вставить("Прокси", Неопределено);
	Параметры.Вставить("ПараметрыЗапроса", Неопределено);
	Параметры.Вставить("ПроверятьSSL", Истина);
	Параметры.Вставить("Таймаут", КлиентHTTP_СтандартныйТаймаут());
	Параметры.Вставить("Json", Неопределено);
	Параметры.Вставить("Данные", Неопределено);
	Параметры.Вставить("Файлы", Новый Массив);
	
	Возврат Параметры;
	
КонецФункции

Функция КлиентHTTP_СтандартныйТаймаут()
	
	Возврат 30;
	
КонецФункции

Функция КлиентHTTP_ТекущаяСессия(Сессия)
	
	Если Сессия = Неопределено Тогда
		Сессия = КлиентHTTP_СоздатьСессию();
	КонецЕсли;
	
	Возврат Сессия;
	
КонецФункции

Функция КлиентHTTP_СоздатьСессию() Экспорт
	
	Сессия = Новый Структура;
	Сессия.Вставить("Заголовки", КлиентHTTP_ЗаголовкиПоУмолчанию());
	Сессия.Вставить("Прокси", Неопределено);
	Сессия.Вставить("ПараметрыЗапроса", Новый Структура);
	Сессия.Вставить("ПроверятьSSL", Истина);
	Сессия.Вставить("СлужебныеДанные", Новый Структура);
	
	Возврат Сессия;
	
КонецФункции  

Функция КлиентHTTP_ЗаголовкиПоУмолчанию()
	
	Заголовки = Новый Соответствие;

	Заголовки.Вставить("Accept", "*/*");
	Заголовки.Вставить("Connection", "keep-alive");
	
	Возврат Заголовки;
	
КонецФункции

Процедура КлиентHTTP_Дополнить(Приемник, Источник)
	
	Если Источник = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементИсточника Из Источник Цикл
		ПараметрНайден = Ложь;
		
		Если ТипЗнч(Приемник) = Тип("Соответствие") Тогда
			ПараметрНайден = Приемник.Получить(ЭлементИсточника.Ключ) <> Неопределено;
		КонецЕсли;
		
		Если ТипЗнч(Приемник) = Тип("Структура") Тогда
			ПараметрНайден = Приемник.Свойство(ЭлементИсточника.Ключ);
		КонецЕсли;
		
		Если Не ПараметрНайден ИЛИ ПараметрНайден И ЭлементИсточника.Значение <> Неопределено Тогда
			Приемник.Вставить(ЭлементИсточника.Ключ, ЭлементИсточника.Значение);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция КлиентHTTP_ВыбратьЗначение(ОсновноеЗначение, ДополнительныеЗначения, Ключ, ЗначениеПоУмолчанию)
	
	Если ОсновноеЗначение <> Неопределено Тогда
		Возврат ОсновноеЗначение;
	КонецЕсли;
	
	Значение = КонтурСтандарт_ЗначениеПоКлючу(ДополнительныеЗначения, Ключ);
	Если Значение <> Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	
	Возврат ЗначениеПоУмолчанию;
	
КонецФункции

Функция КлиентHTTP_Объединить(ГлавныйИсточник, ДополнительныйИсточник)
	
	Результат = ГлавныйИсточник;
	КлиентHTTP_Дополнить(ГлавныйИсточник, ДополнительныйИсточник);
	Возврат Результат;
	
КонецФункции

Функция КлиентHTTP_Скопировать(Источник)
	
	Возврат КонтурСтандарт_СкопироватьРекурсивно(Источник);
	
КонецФункции

Функция КлиентHTTP_РазобратьURL(Знач URL) Экспорт
	
	Перем Сервер;
	
	Схема = "";
	Путь = "";
	Аутентификация = Новый Структура("Пользователь, Пароль", "", "");
	Сервер = "";
	Порт = "";
	Фрагмент = "";
	
	ДопустимыеСхемы = КонтурСтандарт_СтрРазделить_("http,https", ",");
	
	URLБезСхемы = URL;
	КлиентHTTP_РазбитьСтрокуПоРазделителю(Схема, URLБезСхемы, "://");
	Если ДопустимыеСхемы.Найти(НРег(Схема)) <> Неопределено Тогда
		URL = URLБезСхемы;
	Иначе                                                                             
		Схема = "";
	КонецЕсли;
	
	Результат = КлиентHTTP_РазделитьПоПервомуНайденномуРазделителю(URL, КонтурСтандарт_СтрРазделить_("/,?,#", ","));
	URL = Результат[0];
	Если ЗначениеЗаполнено(Результат[2]) Тогда
		Путь = Результат[2] + Результат[1];
	КонецЕсли;
	
	АутентификацияСтрока = "";
	КлиентHTTP_РазбитьСтрокуПоРазделителю(АутентификацияСтрока, URL, "@");
	Если ЗначениеЗаполнено(АутентификацияСтрока) Тогда
		АутентификацияЧасти = КонтурСтандарт_СтрРазделить_(АутентификацияСтрока, ":");
		Аутентификация.Пользователь = АутентификацияЧасти[0];
		Если АутентификацияЧасти.Количество() > 1 Тогда
			Аутентификация.Пароль = АутентификацияЧасти[1];
		КонецЕсли;
	КонецЕсли;
	
	// IPv6
	КлиентHTTP_РазбитьСтрокуПоРазделителю(Сервер, URL, "]");
	Если ЗначениеЗаполнено(Сервер) Тогда
		Сервер = Сервер + "]";
	КонецЕсли;
	
	URL = СтрЗаменить(URL, "/", "");
	
	КлиентHTTP_РазбитьСтрокуПоРазделителю(Порт, URL, ":", Истина);
	
	Если Не ЗначениеЗаполнено(Сервер) Тогда
		Сервер = URL;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Порт) Тогда
		Порт = Число(Порт);
	Иначе
		Порт = 0;
	КонецЕсли;
	
	КлиентHTTP_РазбитьСтрокуПоРазделителю(Фрагмент, Путь, "#", Истина);
	
	ПараметрыЗапроса = КлиентHTTP_ЗаполнитьПараметрыЗапроса(Путь);
	
	Если Не ЗначениеЗаполнено(Схема) Тогда
		Схема = "http";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Путь) Тогда
		Путь = "/";
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Схема", Схема);
	Результат.Вставить("Аутентификация", Аутентификация);
	Результат.Вставить("Сервер", Сервер);
	Результат.Вставить("Порт", Порт);
	Результат.Вставить("Путь", Путь);
	Результат.Вставить("ПараметрыЗапроса", ПараметрыЗапроса);
	Результат.Вставить("Фрагмент", Фрагмент);
	
	Возврат Результат;
	
КонецФункции

Функция КлиентHTTP_ЗаполнитьПараметрыЗапроса(Путь)
	
	ПараметрыЗапроса = Новый Соответствие;
	
	Запрос = "";
	КлиентHTTP_РазбитьСтрокуПоРазделителю(Запрос, Путь, "?", Истина);
	Для Каждого СтрокаКлючРавноПараметр Из КонтурСтандарт_СтрРазделить_(Запрос, "&", Ложь) Цикл
		СтрокаКлючРавноПараметр = КонтурСтандарт_РаскодироватьСтроку_(
		СтрокаКлючРавноПараметр, КонтурСтандарт_СпособКодированияСтроки().URLВКодировкеURL);
		
		ПозицияРавно = КонтурСтандарт_СтрНайти_(СтрокаКлючРавноПараметр, "=");
		Если ПозицияРавно = 0 Тогда
			Ключ = СтрокаКлючРавноПараметр;
			Значение = Неопределено;
		Иначе
			Ключ = Лев(СтрокаКлючРавноПараметр, ПозицияРавно - 1);
			Значение = Сред(СтрокаКлючРавноПараметр, ПозицияРавно + 1);
		КонецЕсли;
		
		Если ПараметрыЗапроса.Получить(Ключ) <> Неопределено Тогда
			Если ТипЗнч(ПараметрыЗапроса[Ключ]) = Тип("Массив") Тогда
				ПараметрыЗапроса[Ключ].Добавить(Значение);
			Иначе
				Значения = Новый Массив;
				Значения.Добавить(ПараметрыЗапроса[Ключ]);
				Значения.Добавить(Значение);
				ПараметрыЗапроса[Ключ] = Значения;
			КонецЕсли;
		Иначе
			ПараметрыЗапроса.Вставить(Ключ, Значение);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ПараметрыЗапроса;
	
КонецФункции

Процедура КлиентHTTP_РазбитьСтрокуПоРазделителю(ИзвлекаемаяЧасть, ОстальнаяЧасть, Разделитель, Инверсия = Ложь)
	
	Индекс = КонтурСтандарт_СтрНайти_(ОстальнаяЧасть, Разделитель);
	Если Индекс Тогда
		ИзвлекаемаяЧасть = Лев(ОстальнаяЧасть, Индекс - 1);
		ОстальнаяЧасть = Сред(ОстальнаяЧасть, Индекс + СтрДлина(Разделитель));
		Если Инверсия Тогда
			ДляИнверсии = ИзвлекаемаяЧасть;
			ИзвлекаемаяЧасть = ОстальнаяЧасть;
			ОстальнаяЧасть = ДляИнверсии;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция КлиентHTTP_РазделитьПоПервомуНайденномуРазделителю(Строка, Разделители)
	
	МинимальныйИндекс = СтрДлина(Строка);
	ПервыйРазделитель = "";
	
	Для Каждого Разделитель Из Разделители Цикл
		Индекс = КонтурСтандарт_СтрНайти_(Строка, Разделитель);
		Если Индекс = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Индекс < МинимальныйИндекс Тогда
			МинимальныйИндекс = Индекс;
			ПервыйРазделитель = Разделитель;
		КонецЕсли;
	КонецЦикла;
	
	Результат = Новый Массив;
	Если ЗначениеЗаполнено(ПервыйРазделитель) Тогда
		Результат.Добавить(Лев(Строка, МинимальныйИндекс - 1));
		Результат.Добавить(Сред(Строка, МинимальныйИндекс + СтрДлина(ПервыйРазделитель)));
		Результат.Добавить(ПервыйРазделитель);
	Иначе
		Результат.Добавить(Строка);
		Результат.Добавить("");
		Результат.Добавить(Неопределено);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КлиентHTTP_ЗначениеЗаголовка(Заголовок, ВсеЗаголовки, Ключ = Неопределено)
	
	Для Каждого ОчереднойЗаголовок Из ВсеЗаголовки Цикл
		Если НРег(ОчереднойЗаголовок.Ключ) = НРег(Заголовок) Тогда
			Ключ = ОчереднойЗаголовок.Ключ;
			Возврат ОчереднойЗаголовок.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция КлиентHTTP_Таймаут(ДополнительныеПараметры)
	
	Если ДополнительныеПараметры.Свойство("Таймаут") И ДополнительныеПараметры.Таймаут <> Неопределено Тогда
		Таймаут = ДополнительныеПараметры.Таймаут;
	Иначе
		Таймаут = КлиентHTTP_СтандартныйТаймаут();
	КонецЕсли;
	
	Возврат Таймаут;
	
КонецФункции

Функция КлиентHTTP_КодировкаИзЗаголовка(Знач Заголовок)
	
	Кодировка = Неопределено;
	
	Заголовок = НРег(СокрЛП(Заголовок));
	ИндексРазделителя = КонтурСтандарт_СтрНайти_(Заголовок, ";");
	Если ИндексРазделителя Тогда
		ТипСодержимого = СокрЛП(Лев(Заголовок, ИндексРазделителя - 1));
		КлючКодировки = "charset=";
		ИндексКодировки = КонтурСтандарт_СтрНайти_(Заголовок, КлючКодировки);
		Если ИндексКодировки Тогда
			ИндексРазделителя = КонтурСтандарт_СтрНайти_(Заголовок, ";", КонтурСтандарт_НаправлениеПоискаСНачала(), ИндексКодировки);
			НачальнаяПозиция = ИндексКодировки + СтрДлина(КлючКодировки);
			Если ИндексРазделителя Тогда
				ДлинаКодировки = ИндексРазделителя - НачальнаяПозиция;
			Иначе
				ДлинаКодировки = СтрДлина(Заголовок);
			КонецЕсли;
			Кодировка = Сред(Заголовок, НачальнаяПозиция, ДлинаКодировки);
			Кодировка = СтрЗаменить(Кодировка, """", "");
			Кодировка = СтрЗаменить(Кодировка, "'", "");
		КонецЕсли;
	Иначе
		ТипСодержимого = Заголовок;
	КонецЕсли;
	
	Если Кодировка = Неопределено И КонтурСтандарт_СтрНайти_(ТипСодержимого, "text") Тогда
		Кодировка = "iso-8859-1";
	КонецЕсли;
	
	Возврат Кодировка;
	
КонецФункции

Функция КлиентHTTP_КакИсключение(Ответ, Знач ТекстДляПользователя = Неопределено) Экспорт
	
	ТекстИсключения = КонтурСтандарт_СтрШаблон_(
	НСтр("ru = 'HTTP %1 %2
	|%3'"),
	Ответ.Метод,
	Ответ.URL,
	Ответ.КодСостояния
	);
	
	ТелоОтвета = КлиентHTTP_ВырезатьТекст(КлиентHTTP_КакТекст(Ответ));
	
	Если Не ПустаяСтрока(ТелоОтвета) Тогда
		ТекстИсключения = ТекстИсключения + Символы.ПС + КонтурСтандарт_СтрШаблон_(
		НСтр("ru = 'Тело ответа:
		|%1'"),
		ТелоОтвета);
	КонецЕсли;
	
	Если Ответ.Ошибки.Количество() Тогда
		ТекстИсключения = ТекстИсключения + Символы.ПС + Символы.ПС
		+ КонтурСтандарт_СтрСоединить_(Ответ.Ошибки, Символы.ПС + Символы.ПС);
	КонецЕсли;
	
	Если Не ПустаяСтрока(ТекстДляПользователя) Тогда
		ТекстИсключения = ТекстДляПользователя + Символы.ПС + Символы.ПС + ТекстИсключения;
	КонецЕсли;
	
	Возврат ТекстИсключения;
	
КонецФункции

Функция КлиентHTTP_КакТекст(Ответ, Кодировка = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Кодировка) Тогда
		Кодировка = Ответ.Кодировка;
		Если Не ЗначениеЗаполнено(Ответ.Кодировка) Тогда 
			Кодировка = "utf-8";	
		КонецЕсли;
	КонецЕсли;
	
	Текст = КонтурСтандарт_ПолучитьСтрокуИзДвоичныхДанных_(Ответ.Тело, Кодировка);

	Возврат Текст;
	
КонецФункции

// Возвращает преобразованные данные JSON
//
// Параметры:
//  Ответ                        - Струтура       - Структура ответа HTTP, см. КлиентHTTP_НовыйОтвет
//  ПрочитатьВСоответствие       - Булево         - Если установлено Истина, чтение объекта JSON будет выполнено в Соответствие
//
// Возвращаемое значение:
//  Структура, Соответствие - преобразованные данные JSON в типы «1С:Предприятия».
//
Функция КлиентHTTP_КакJson(Ответ, ПрочитатьВСоответствие = Истина) Экспорт
	
	Попытка
		Возврат КонтурСтандарт_ЗначениеИзСтрокиJSON(Ответ.Тело, ПрочитатьВСоответствие);
	Исключение
		ВызватьИсключение КлиентHTTP_КакИсключение(Ответ, НСтр("ru = 'Ошибка при десериализации JSON.'"));
	КонецПопытки;
	
КонецФункции

Функция КлиентHTTP_КакДвоичныеДанные(Ответ) Экспорт
	
	Возврат Ответ.Тело;
	
КонецФункции

Функция КлиентHTTP_ВырезатьТекст(Текст, МаксимальнаяДлинаТекста = 1000)
	
	Если НайтиНедопустимыеСимволыXML(Текст) Тогда
		Возврат НСтр("ru ='<Данные>'");
	КонецЕсли;
	
	Если СтрДлина(Текст) <= МаксимальнаяДлинаТекста Тогда
		Результат = Текст;
	Иначе
		ПоловинаМаксимальнойДлиныТекста = МаксимальнаяДлинаТекста / 2;
		Результат = Лев(Текст, ПоловинаМаксимальнойДлиныТекста);
		Результат = Результат + Символы.ПС + "..." + Символы.ПС;
		Результат = Результат + Прав(Текст, ПоловинаМаксимальнойДлиныТекста);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура КлиентHTTP_Приостановить(ДлительностьОстановкиВСекундах)
	
	// Когда-нибудь в платформе сделают паузу и это можно будет выкинуть
	
	Если ДлительностьОстановкиВСекундах < 1 Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяДата = Окр(ТекущаяУниверсальнаяДатаВМиллисекундах()/1000);
	ЖдатьДо = ТекущаяДата + ДлительностьОстановкиВСекундах;
	
	// BSLLS:UsingHardcodeNetworkAddress-off
	ЛокальныйХост = "127.0.0.0";
	КакойНибудьСвободныйПорт = 56476;
	// BSLLS:UsingHardcodeNetworkAddress-on
	Пока ТекущаяДата < ЖдатьДо Цикл
		Таймаут = ЖдатьДо - ТекущаяДата;
		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Попытка
			Соединение = Новый HTTPСоединение(
			ЛокальныйХост, КакойНибудьСвободныйПорт, Неопределено, Неопределено, Новый ИнтернетПрокси(Ложь), Таймаут);
			Соединение.Получить(Новый HTTPЗапрос("/does_not_matter"));
		Исключение
			РеальныйТаймаут = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
		КонецПопытки;
		МинимальныйТаймаутВМиллисекундах = 1000;
		Если РеальныйТаймаут < МинимальныйТаймаутВМиллисекундах Тогда
			ВызватьИсключение(НСтр("ru = 'Процедура Приостановить не работает должным образом'"));
		КонецЕсли;
		ТекущаяДата = Окр(ТекущаяУниверсальнаяДатаВМиллисекундах()/1000);
	КонецЦикла;
	
КонецПроцедуры

Функция КлиентHTTP_РассчитатьДлительностьПриостановки(Повтор, КоэффициентЭкспоненциальнойЗадержки, ЗаголовокRetryAfter, Остаток)
	
	Если ЗаголовокRetryAfter <> Ложь Тогда
		Длительность = КонтурСтандарт_СтрокаВЧисло(ЗаголовокRetryAfter);
		
		Если Длительность = 0 Тогда
			Дата = КлиентHTTP_ДатаИзСтрокиRFC7231(ЗаголовокRetryAfter);
			Если ЗначениеЗаполнено(Дата) Тогда
				Длительность = Дата - Окр(ТекущаяУниверсальнаяДатаВМиллисекундах()/1000);
			КонецЕсли;
		КонецЕсли;
	Иначе
		Длительность = КоэффициентЭкспоненциальнойЗадержки * Pow(2, Повтор - 1);
	КонецЕсли;
	
	Длительность = Мин(Длительность, Остаток);
	
	Если Длительность < 0 Тогда
		Длительность = 0;
	КонецЕсли;
	
	Возврат Длительность;
	
КонецФункции

Функция КлиентHTTP_ДатаИзСтрокиRFC7231(Знач Строка) Экспорт
	
	Разделители = ",-:/\.";
	Для Индекс = 1 По СтрДлина(Разделители) Цикл
		Разделитель = Сред(Разделители, Индекс, 1);
		Строка = СтрЗаменить(Строка, Разделитель, " ");
	КонецЦикла;
	Строка = СтрЗаменить(Строка, "  ", " ");
	СоставляющиеДаты = КонтурСтандарт_СтрРазделить_(Строка, " ");
	МесяцСтр = СоставляющиеДаты[2];
	
	Месяцы = КонтурСтандарт_СтрРазделить_("Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec", ",");
	Месяц = Месяцы.Найти(МесяцСтр);
	Если Месяц = Неопределено Тогда
		Возврат '00010101';
	КонецЕсли;
	
	Дата = СоставляющиеДаты[3] + Формат(Месяц + 1, "ЧЦ=2; ЧВН=;") + СоставляющиеДаты[1];
	Время = СоставляющиеДаты[4] + СоставляющиеДаты[5] + СоставляющиеДаты[6];
	
	Возврат КлиентHTTP_ДатаИзСтроки(Дата + Время);
	      
КонецФункции

Функция КлиентHTTP_ДатаИзСтроки(Знач Строка) Экспорт
	
	КвалификаторДаты = Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя);
	ОписаниеТипа = Новый ОписаниеТипов("Дата", Неопределено, Неопределено, КвалификаторДаты);
	Возврат ОписаниеТипа.ПривестиЗначение(Строка);
	
КонецФункции

// Возвращает структуру именованных кодов состояний HTTP.
//
// Возвращаемое значение:
//   Структура - именованные коды состояний HTTP.
//
Функция КлиентHTTP_КодыСостоянияHTTP() Экспорт
	
	МенеджерНастроек = КлиентHTTP_МенеджерНастроек();
	
	КодыСостояния = МенеджерНастроек.КодыСостояния;

	Если КодыСостояния = Неопределено Тогда	
		
		КодыСостояния = Новый Структура;
		Для Каждого Описание Из КлиентHTTP_ОписанияКодовСостоянийHTTP() Цикл
			КодыСостояния.Вставить(Описание.Ключ, Описание.Код);
		КонецЦикла;
		
		МенеджерНастроек.КодыСостояния = КодыСостояния;
		
	КонецЕсли;
	
	Возврат КодыСостояния;

КонецФункции 

Функция КлиентHTTP_ОписанияКодовСостоянийHTTP()

	Коды = Новый Массив;
	Коды.Добавить(КлиентHTTP_НовыйКодHTTP(100, "Продолжай_100", "Continue"));
	Коды.Добавить(КлиентHTTP_НовыйКодHTTP(101, "ПереключениеПротокола_101", "Switching Protocols"));
	Коды.Добавить(КлиентHTTP_НовыйКодHTTP(102, "ИдетОбработка_102", "Processing"));
	Коды.Добавить(КлиентHTTP_НовыйКодHTTP(103, "РанняяМетаинформация_103", "Early Hints"));

	Коды.Добавить(КлиентHTTP_НовыйКодHTTP(200, "ОК_200", "OK"));
	Коды.Добавить(КлиентHTTP_НовыйКодHTTP(201, "Создано_201", "Created"));
	Коды.Добавить(КлиентHTTP_НовыйКодHTTP(202, "Принято_202", "Accepted"));
	Коды.Добавить(КлиентHTTP_НовыйКодHTTP(203, "ИнформацияНеАвторитетна_203", "Non-Authoritative Information"));
	Коды.Добавить(КлиентHTTP_НовыйКодHTTP(204, "НетСодержимого_204", "No Content"));
	Коды.Добавить(КлиентHTTP_НовыйКодHTTP(205, "СброситьСодержимое_205", "Reset Content"));
	Коды.Добавить(КлиентHTTP_НовыйКодHTTP(206, "ЧастичноеСодержимое_206", "Partial Content"));
	Коды.Добавить(КлиентHTTP_НовыйКодHTTP(207, "Многостатусный_207", "Multi-Status"));
