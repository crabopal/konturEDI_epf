Функция КлиентHTTP_ВызватьМетод(Метод, URL, ДополнительныеПараметры = Неопределено, Сессия = Неопределено) Экспорт
	
	ТекущаяСессия = КлиентHTTP_ТекущаяСессия(Сессия);
	
	Параметры = КлиентHTTP_НовыеПараметры();
	КлиентHTTP_Дополнить(Параметры, ДополнительныеПараметры);
	
