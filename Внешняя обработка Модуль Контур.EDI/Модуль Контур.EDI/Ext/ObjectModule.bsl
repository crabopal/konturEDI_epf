		СтруктураТипа.ЧастиДаты    		= Неопределено;
	КонецЕсли;
	
	СтруктураТипа.ИмяТипа = СтрЗаменить(СтруктураТипа.ИмяТипа, ",", Символы.ПС);
	
	Возврат СтруктураТипа;

