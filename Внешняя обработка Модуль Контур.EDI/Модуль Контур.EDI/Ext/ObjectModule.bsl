	РезультатПоискаСообщенийПоID = ПолучитьРезультатПоискаСообщенийПоID(IDСообщения);
	
	ИсходящееСообщениеНайдено = РезультатПоискаСообщенийПоID.ИсходящееСообщениеНайдено;
	Партнер    				  = РезультатПоискаСообщенийПоID.Партнер;
	
	Если НЕ ИсходящееСообщениеНайдено Тогда
		Возврат;
	КонецЕсли;
	
	ТабНайденныхСообщений     = РезультатПоискаСообщенийПоID.ТабНайденныхСообщений;
	
	Для Каждого СтрокаСообщенияВБазе Из ТабНайденныхСообщений Цикл
		
		СообщениеСсылка		= СтрокаСообщенияВБазе.Ссылка;
		ТипСообщения		= СтрокаСообщенияВБазе.ТипСообщения;
		Статус 				= СтрокаСообщенияВБазе.Статус;
		Документ 	 = СтрокаСообщенияВБазе.Документ;
		
		ТекущийСтатусСообщения = ПолучитьСтатусСообщения(СообщениеСсылка, , ТипСообщения);
				
		//игнорируем старшие статусы, которые сообщение могло получить автоматически при отработке механизма обновлнеия статусов ДД по СФ
		//иначе говоря, этот статус, который мы сейчас обрабатываем, может быть устаревшим (особенно учитывая наличие у пользователя возможности перенести границу event назад во времени)
		//ВНИМАНИЕ! при реализации полноценных статусных на эти события следует исключить эти проверки.
		Если ТекущийСтатусСообщения<>"Запрос уточнения"
			И ТекущийСтатусСообщения<>"Аннулирован"             
			И ТекущийСтатусСообщения<>"Исправлен" 
			И ТекущийСтатусСообщения<>"Откорректирован" 
			И ТекущийСтатусСообщения<>"Отказано в подписи получателем"   //отказ приоритетнее аннулирования
			//также если текущее сообщение в архиве - мы не можем однозначно быть уверенными в том что это не пользователь принудительно завершил его обработку
			//Однако, обсудив и взвесив за и против решено на данном этапе не считать исключением архивность сообщения.
			Тогда 
			УстановитьСтатусСообщения(СообщениеСсылка,  , ТипСообщения, "ИсходящийЗапросУточнения");
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры 

Процедура ОбработатьСобытие_DocumentPackageSignedByRecipientPartiallyOk(Событие)
	
	СодержимоеСобытия 			   = Событие.СодержимоеСобытия;
	ИдентификаторЯщикаВДиадоке 	   = СодержимоеСобытия.ИдентификаторЯщикаВДиадоке;
	ИдентификаторСообщенияВДиадоке = СодержимоеСобытия.ИдентификаторСообщенияВДиадоке;
	
	IDСообщения = СтрЗаменить(СодержимоеСобытия.МетаинформацияИсходящегоСообщения.ИдентификаторСообщения,"-", "");
	РезультатПоискаСообщенийПоID = ПолучитьРезультатПоискаСообщенийПоID(IDСообщения);
	
	ИсходящееСообщениеНайдено = РезультатПоискаСообщенийПоID.ИсходящееСообщениеНайдено;
	Партнер    				  = РезультатПоискаСообщенийПоID.Партнер;
	
	Если НЕ ИсходящееСообщениеНайдено Тогда
		Возврат;	
	КонецЕсли;	
	
	СтандартнаяОбработкаEDI = Ложь;
	
	ТабНайденныхСообщений     = РезультатПоискаСообщенийПоID.ТабНайденныхСообщений;
	
	Для Каждого СтрокаСообщенияВБазе Из ТабНайденныхСообщений Цикл
		
		СообщениеСсылка		= СтрокаСообщенияВБазе.Ссылка;
		
		Если НЕ СообщениеСсылка.Архив = Истина Тогда
			
			ТипСообщения 	= СтрокаСообщенияВБазе.ТипСообщения;
			Статус			= СтрокаСообщенияВБазе.Статус;
			Документ		= СтрокаСообщенияВБазе.Документ;
			
			УстановитьСтатусСообщения(СообщениеСсылка,  , ТипСообщения, "ИсходящийПодписанПолучателемСРазногласиями");
			
			Если СообщениеСсылка <> Неопределено 
				И ПеременнаяСодержитСвойство(СодержимоеСобытия, "Причины") Тогда
				
				СообщениеОбъект = ПолучитьОбъектСообщения(СообщениеСсылка);
				СообщениеОбъект.ОписаниеОшибки = СодержимоеСобытия.Причины;
				СохранитьОбъектСообщения(СообщениеОбъект);
				
			КонецЕсли;
			
		КонецЕсли;
		
		ЗаписатьПризнакОтправкиИзвещенияОПолучении(СообщениеСсылка);
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура ОбработатьСобытие_DiadocDocumentDelivered(Событие)
	
	СодержимоеСобытия 			   	  = Событие.СодержимоеСобытия;
	МетаинформацияИсходящегоСообщения = СодержимоеСобытия.МетаинформацияИсходящегоСообщения;
	ИдентификаторСообщения 			  = МетаинформацияИсходящегоСообщения.ИдентификаторСообщения;
	
	ФункцияУПД = ОпределитьФункциюУПД_ПоСобытию(Событие);
	
	Если ФункцияУПД = Неопределено Тогда                                    
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Предупреждение,"Не удалось определить функцию УПД в сообщении с id:" + ИдентификаторСообщения);
		Возврат;
	КонецЕсли;
	
	ДокументооборотЗавершен = ФункцияУПД = "СФ(формата УПД)" ИЛИ ФункцияУПД = "УПД СЧФ" ИЛИ ФункцияУПД = "КСФ(формат УПД)"; 
	
	Если НЕ ДокументооборотЗавершен Тогда 
		
		Возврат;	 
		
	КонецЕсли;
		
	IDСообщения = СтрЗаменить(ИдентификаторСообщения,"-", "");
	РезультатПоискаСообщенийПоID = ПолучитьРезультатПоискаСообщенийПоID(IDСообщения);
	
	ИсходящееСообщениеНайдено = РезультатПоискаСообщенийПоID.ИсходящееСообщениеНайдено;
	Партнер    				  = РезультатПоискаСообщенийПоID.Партнер;
	
	Если НЕ ИсходящееСообщениеНайдено Тогда
		Возврат;
	КонецЕсли;
	
	ТабНайденныхСообщений     = РезультатПоискаСообщенийПоID.ТабНайденныхСообщений;
	
	Для Каждого СтрокаСообщенияВБазе Из ТабНайденныхСообщений Цикл
		
		СообщениеСсылка		= СтрокаСообщенияВБазе.Ссылка;
		ТипСообщения		= СтрокаСообщенияВБазе.ТипСообщения;
		Статус 				= СтрокаСообщенияВБазе.Статус;
		Документ 	 		= СтрокаСообщенияВБазе.Документ;
		
		ТекущийСтатусСообщения = ПолучитьСтатусСообщения(СообщениеСсылка, , ТипСообщения);
		
		Если ТекущийСтатусСообщения<>"Запрос уточнения"
			И ТекущийСтатусСообщения<>"Запрос аннулирования"  
			И ТекущийСтатусСообщения<>"Аннулирован" Тогда 
			УстановитьСтатусСообщения(СообщениеСсылка,  , ТипСообщения, "ИсходящийПодписанПолучателем");
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура ОбработатьСобытие_OutboxDiadocDocumentPowerOfAttorneyStatusChanged(Событие)
	
	Если Событие.ТипСобытия = "OutboxDiadocDocumentSenderPowerOfAttorneyStatusChanged" Тогда
		Префикс = "Исх_";
	Иначе
		Префикс = "Вх_";
	КонецЕсли;
	
	СодержимоеСобытия 			   	  = Событие.СодержимоеСобытия;
	ИнформацияОбМЧД 					= СодержимоеСобытия.ИнформацияОбМЧД;
	ИдентификаторСообщения 			  = СодержимоеСобытия.МетаинформацияИсходящегоСообщения.ИдентификаторСообщения;
	
	IDСообщения = СтрЗаменить(ИдентификаторСообщения,"-", "");
	РезультатПоискаСообщенийПоID = ПолучитьРезультатПоискаСообщенийПоID(IDСообщения);
	
	ИсходящееСообщениеНайдено = РезультатПоискаСообщенийПоID.ИсходящееСообщениеНайдено;
	Партнер    				  = РезультатПоискаСообщенийПоID.Партнер;
	
	Если НЕ ИсходящееСообщениеНайдено Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыКЗаполенению = РеквизитыКЗаполенению_ИнформацияОбМЧД(ИнформацияОбМЧД, Префикс);

	ОшибкиПроверкиМЧД = Неопределено;
	
	МассивОшибокПроверкиМЧД = Новый Массив;

	Если ИнформацияОбМЧД.Свойство("СтатусПроверкиМЧД")
		И ИнформацияОбМЧД.СтатусПроверкиМЧД.Свойство("ОшибкаПроверкиСтатусаМЧД")
		И ТипЗнч(ИнформацияОбМЧД.СтатусПроверкиМЧД.ОшибкаПроверкиСтатусаМЧД) = Тип("Структура")
		И Не ПустаяСтрока(ИнформацияОбМЧД.СтатусПроверкиМЧД.ОшибкаПроверкиСтатусаМЧД.Текст) Тогда
		
		МассивОшибокПроверкиМЧД.Добавить(ИнформацияОбМЧД.СтатусПроверкиМЧД.ОшибкаПроверкиСтатусаМЧД);
		
	КонецЕсли;

	Если ИнформацияОбМЧД.Свойство("СтатусПроверкиМЧД")
		И ИнформацияОбМЧД.СтатусПроверкиМЧД.Свойство("ПротоколВалидации") Тогда
		
		Для Каждого РезультатПроверкиМЧД Из ИнформацияОбМЧД.СтатусПроверкиМЧД.ПротоколВалидации.РезультатыВыполненияПроверокМЧД Цикл
			
			Если РезультатПроверкиМЧД.Свойство("ОшибкаПроверкиМЧД") 
				И ТипЗнч(РезультатПроверкиМЧД.ОшибкаПроверкиМЧД) = Тип("Структура")
				И Не ПустаяСтрока(РезультатПроверкиМЧД.ОшибкаПроверкиМЧД.Текст) Тогда
				
				МассивОшибокПроверкиМЧД.Добавить(РезультатПроверкиМЧД.ОшибкаПроверкиМЧД);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;	
	
	Если МассивОшибокПроверкиМЧД.Количество() > 0 Тогда
		
		ОшибкиПроверкиМЧД = ЗначениеВСтрокуВнутр(МассивОшибокПроверкиМЧД);
	
	ИначеЕсли ИнформацияОбМЧД.Свойство("СтатусПроверкиМЧД")
		И ИнформацияОбМЧД.СтатусПроверкиМЧД.Свойство("ОшибкиПроверкиМЧД")
		И ТипЗнч(ИнформацияОбМЧД.СтатусПроверкиМЧД.ОшибкиПроверкиМЧД) = Тип("Массив") Тогда
		
		ОшибкиПроверкиМЧД = ЗначениеВСтрокуВнутр(ИнформацияОбМЧД.СтатусПроверкиМЧД.ОшибкиПроверкиМЧД); // устарело

	КонецЕсли;
	
	МеткиДобавить = Новый Массив;
	МеткиУдалить = Новый Массив;
	
	Представление = ?(Префикс = "Исх_", "Исходящая", "Входящая");
	
	МеткаНеПрошлаПроверку = НайтиСоздатьМетку(Представление + " доверенность не прошла проверку", Новый Цвет(203, 61, 53), Новый Шрифт(,,Истина), Новый Цвет(255, 255, 255));
	МеткаПрошлаПроверку = НайтиСоздатьМетку(Представление + " доверенность прошла проверку", Новый Цвет(83, 138, 27), Новый Шрифт(,,Истина), Новый Цвет(255, 255, 255));
	
	Если МЧДПрошлаПроверку(ИнформацияОбМЧД) Тогда
		
		МеткиУдалить.Добавить(МеткаНеПрошлаПроверку);
		МеткиДобавить.Добавить(МеткаПрошлаПроверку);
		
	Иначе
		
		МеткиУдалить.Добавить(МеткаПрошлаПроверку);
		МеткиДобавить.Добавить(МеткаНеПрошлаПроверку);
		
	КонецЕсли;
	
	ТабНайденныхСообщений     = РезультатПоискаСообщенийПоID.ТабНайденныхСообщений;
	
	Для Каждого СтрокаСообщенияВБазе Из ТабНайденныхСообщений Цикл
		
		СообщениеСсылка		= СтрокаСообщенияВБазе.Ссылка;
		СообщениеОбъект = ПолучитьОбъектСообщения(СообщениеСсылка);
		
		ЗаполнитьДопРеквизитыОбъектаСправочника_КонтурEDI(СообщениеОбъект, РеквизитыКЗаполенению);
		
		Если ЗначениеЗаполнено(ОшибкиПроверкиМЧД) Тогда
			
			СтрокаОшибкиПроверкиМЧД = СообщениеОбъект.ДополнительныеРеквизиты.Найти(Префикс + "ОшибкиПроверкиМЧД", "ИмяРеквизита");
			
			Если СтрокаОшибкиПроверкиМЧД = Неопределено Тогда
				СтрокаОшибкиПроверкиМЧД = СообщениеОбъект.ДополнительныеРеквизиты.Добавить();
				СтрокаОшибкиПроверкиМЧД.ИмяРеквизита = Префикс + "ОшибкиПроверкиМЧД";
			КонецЕсли;	
			
			СтрокаОшибкиПроверкиМЧД.Значение = "Массив";
			СтрокаОшибкиПроверкиМЧД.ЗначениеСтрока = ОшибкиПроверкиМЧД;
			
		КонецЕсли;
		
		УдалитьМетки(СообщениеОбъект, МеткиУдалить);
		ЗаписатьМетки(СообщениеОбъект, МеткиДобавить);
		
		СохранитьОбъектСообщения(СообщениеОбъект);
		
	КонецЦикла;

КонецПроцедуры 

Процедура ОбработатьСобытие_NewOutboxMessage(Событие, УчетнаяЗапись) 
	
	ИмяФайлаСообщения 					= Событие.СодержимоеСобытия.ИмяФайлаСообщения;
	
	Если НЕ ЗначениеЗаполнено(ИмяФайлаСообщения) Тогда 
		Возврат;
	КонецЕсли;  
	
	DocumentCirculationId		= Событие.СодержимоеСобытия.МетаинформацияИсходящегоСообщения.ВнутреннийИдентификаторСообщения;
	BoxId 						= Событие.СодержимоеСобытия.МетаинформацияИсходящегоСообщения.ИдентификаторЯщикаКлиента;
	MessageID					= Событие.СодержимоеСобытия.МетаинформацияИсходящегоСообщения.ИдентификаторСообщения; 
	ParentDocumentCirculationId	= Событие.СодержимоеСобытия.РодительскийВнутреннийИдентификаторСообщения;
	
	ОбъектХранилище = НайтиИлиСоздатьОбъектХранилищеОтправленныхАрхивов_КонтурEDI(ParentDocumentCirculationId);
	
	Сообщение = ОбъектХранилище.ДополнительныеРеквизиты.Найти(ИмяФайлаСообщения,"ЗначениеСтрока");
	
	MessageID = СтрЗаменить(MessageID, "-", "");
	
	Если НЕ Сообщение = Неопределено Тогда
		
		Попытка
			СообщениеОбъект = ПолучитьОбъектСообщения(Сообщение.Значение); 
			
			Если СообщениеОбъект.ID = MessageID Тогда 
				Возврат;
			КонецЕсли;
			
			СообщениеОбъект.ID = MessageID;
			
		Исключение
			СообщениеОбъект = Неопределено;
		КонецПопытки;
		
		Если СообщениеОбъект <> Неопределено Тогда
			СсылкаНаСообщениеВМониторинге = СформироватьСсылкуНаСообщениеВМониторинге(DocumentCirculationId, , BoxId); 
			ЗаполнитьДопРеквизитыОбъектаСправочника_КонтурEDI(СообщениеОбъект, Новый Структура("СсылкаНаСообщениеВМониторинге", СсылкаНаСообщениеВМониторинге)); 
			
			СообщениеОбъект.Записать();
			
			ОбъектХранилище.ДополнительныеРеквизиты.Удалить(Сообщение);
			ОбъектХранилище.Записать();
			
			Если ОбъектХранилище.ДополнительныеРеквизиты.Количество() = 0 Тогда 
				Попытка
					ОбъектХранилище.Удалить();
				Исключение
					_Ошибка = ОписаниеОшибки();
				КонецПопытки;		
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПрочитатьСообщениеИзЛенты_КонтурEDI(Событие, УчетнаяЗапись)
	
	ЕстьМетаинформацияВходящего = Событие.СодержимоеСобытия.Свойство("МетаинформацияВходящегоСообщения");
	
	Если ЕстьМетаинформацияВходящего Тогда 
		ТипСообщения			  = Врег(Событие.СодержимоеСобытия.МетаинформацияВходящегоСообщения.ИнформацияОДокументе.ТипДокумента);
		ИдентификаторСообщения 	  = Событие.СодержимоеСобытия.МетаинформацияВходящегоСообщения.ИдентификаторСообщения;
		ИдентификаторЯщикаКлиента = Событие.СодержимоеСобытия.МетаинформацияВходящегоСообщения.ИдентификаторЯщикаКлиента;
	Иначе
		ТипСообщения			  = Врег(Событие.СодержимоеСобытия.ТипДокумента);
		ИдентификаторСообщения 	  = Событие.СодержимоеСобытия.МетаинформацияИсходящегоСообщения.ИдентификаторСообщения;
		ИдентификаторЯщикаКлиента = Событие.СодержимоеСобытия.МетаинформацияИсходящегоСообщения.ИдентификаторЯщикаКлиента;
	КонецЕсли; 

	ИмяФайлаСообщения		  = ТипСообщения + "_" + ИдентификаторСообщения + "_" + ИдентификаторЯщикаКлиента + ".xml";
	ПолныйПутьФайлаСообщения  = мРабочийКаталог + ИмяФайлаСообщения;
	
	ДанныеАвторизацииEDI = ДанныеАвторизацииДляКонтурEDIAPI(УчетнаяЗапись);
	
	Если ЕстьМетаинформацияВходящего Тогда
		СодержимоеСообщения = КонтурEDIAPI_ВходящееСообщение(ДанныеАвторизацииEDI, ИдентификаторЯщикаКлиента, ИдентификаторСообщения);		
	Иначе
		СодержимоеСообщения = КонтурEDIAPI_ИсходящееСообщение(ДанныеАвторизацииEDI, ИдентификаторЯщикаКлиента, ИдентификаторСообщения);	
	КонецЕсли;
	
	ДвоичныеДанныеСообщения = BASE64Значение(СодержимоеСообщения.Data.MessageBody);
	
	Если КонтурСтандарт_ДоступнаРаботаСПотоками() Тогда 
		ИсточникДанных = ДвоичныеДанныеСообщения.ОткрытьПотокДляЧтения();
	Иначе  
		ДвоичныеДанныеСообщения.Записать(ПолныйПутьФайлаСообщения);	
		ИсточникДанных = ПолныйПутьФайлаСообщения;
	КонецЕсли;
	
	Если ТипСообщения = "STSMSG" Тогда
		ТипСообщения = "reports";
	КонецЕсли;
	
	Сообщение = ПрочитатьСообщениеПоНовому(ИсточникДанных, ТипСообщения, "Входящее"); 
	
	Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
		
		ВызватьИсключение "Не удалось прочитать сообщение " + ИмяФайлаСообщения;
		
	КонецЕсли;    
	
	Если Сообщение.Статус = "ВходящийОшибкаЧтенияФайла"  Тогда
		
		Метрика_Переменные = Новый Структура("ТипСообщения, ИмяФайла", 
											ТипСообщения, ИмяФайлаСообщения);
		
		Метрика_Ошибка("ПрочитатьСообщениеПоНовому", 
						Сообщение.ОписаниеОшибки,
						Сообщение.ИнформацияОбОшибке,
						Метрика_Переменные, 
						Истина);   
		ЗаполнитьСообщениеДаннымиИзСобытия(Сообщение, Событие);		
	КонецЕсли;
	
	Если ТипЗнч(ИсточникДанных) = Тип("Строка") Тогда
		УдалитьФайлы_КонтурEDI(ИсточникДанных);
	Иначе
		ИсточникДанных.Закрыть();
	КонецЕсли;
	
	Возврат Сообщение;
	
КонецФункции

Функция РеквизитыКЗаполенению_ИнформацияОбМЧД(ИнформацияОбМЧД, Префикс = "")
	
	РеквизитыКЗаполенению = Новый Структура;
	
	Если ИнформацияОбМЧД.Свойство("ИдентификаторИзмененияСтатуса") Тогда
		РеквизитыКЗаполенению.Вставить(Префикс + "ИдентификаторИзмененияСтатуса", ИнформацияОбМЧД.ИдентификаторИзмененияСтатуса);
	КонецЕсли;
	
	Если ИнформацияОбМЧД.Свойство("ИдентификаторМЧДВПакетеДокументов") Тогда
		РеквизитыКЗаполенению.Вставить(Префикс + "ИдентификаторМЧДВПакетеДокументов", ИнформацияОбМЧД.ИдентификаторМЧДВПакетеДокументов);
	КонецЕсли;
	
	Если ИнформацияОбМЧД.Свойство("ИдентификаторПодписанногоДокументаВПакетеДокументов") Тогда
		РеквизитыКЗаполенению.Вставить(Префикс + "ИдентификаторПодписанногоДокумента", ИнформацияОбМЧД.ИдентификаторПодписанногоДокументаВПакетеДокументов);
	КонецЕсли;
	
	Если ИнформацияОбМЧД.Свойство("ПолныйИдентификаторМЧД")
		И ИнформацияОбМЧД.ПолныйИдентификаторМЧД.Свойство("ИННВыпустившейМЧДОрганизации") Тогда
		РеквизитыКЗаполенению.Вставить(Префикс + "ИННВыпустившейМЧДОрганизации", ИнформацияОбМЧД.ПолныйИдентификаторМЧД.ИННВыпустившейМЧДОрганизации);
	КонецЕсли;
	
	Если ИнформацияОбМЧД.Свойство("ПолныйИдентификаторМЧД")
		И ИнформацияОбМЧД.ПолныйИдентификаторМЧД.Свойство("РегистрационныйНомерМЧД") Тогда
		РеквизитыКЗаполенению.Вставить(Префикс + "РегистрационныйНомерМЧД", ИнформацияОбМЧД.ПолныйИдентификаторМЧД.РегистрационныйНомерМЧД);
	КонецЕсли;
	
	Если ИнформацияОбМЧД.Свойство("ПолныйИдентификаторМЧД")
		И ИнформацияОбМЧД.ПолныйИдентификаторМЧД.Свойство("ИННПредставителяИзМЧД") Тогда
		РеквизитыКЗаполенению.Вставить(Префикс + "ИННПредставителяИзМЧД", ИнформацияОбМЧД.ПолныйИдентификаторМЧД.ИННПредставителяИзМЧД);
	КонецЕсли;
	
	Если ИнформацияОбМЧД.Свойство("ПолныйИдентификаторМЧД")
		И ИнформацияОбМЧД.ПолныйИдентификаторМЧД.Свойство("ИННПредставителяИзМЧД") Тогда
		РеквизитыКЗаполенению.Вставить(Префикс + "ИННПредставителяИзМЧД", ИнформацияОбМЧД.ПолныйИдентификаторМЧД.ИННПредставителяИзМЧД);
	КонецЕсли;
	
	Если ИнформацияОбМЧД.Свойство("СтатусПроверкиМЧД")
		И ИнформацияОбМЧД.СтатусПроверкиМЧД.Свойство("ИдентификаторСтатусаПроверкиМЧД") Тогда
		РеквизитыКЗаполенению.Вставить(Префикс + "ИдентификаторСтатусаПроверкиМЧД", ИнформацияОбМЧД.СтатусПроверкиМЧД.ИдентификаторСтатусаПроверкиМЧД);
	КонецЕсли;
	
	Если ИнформацияОбМЧД.Свойство("СтатусПроверкиМЧД")
		И ИнформацияОбМЧД.СтатусПроверкиМЧД.Свойство("КритичностьСтатусаПроверкиМЧД") Тогда
		РеквизитыКЗаполенению.Вставить(Префикс + "КритичностьСтатусаПроверкиМЧД", ИнформацияОбМЧД.СтатусПроверкиМЧД.КритичностьСтатусаПроверкиМЧД);
	КонецЕсли;
	
	Если ИнформацияОбМЧД.Свойство("СтатусПроверкиМЧД")
		И ИнформацияОбМЧД.СтатусПроверкиМЧД.Свойство("ТекстСтатуса") Тогда
		РеквизитыКЗаполенению.Вставить(Префикс + "ТекстСтатуса", ИнформацияОбМЧД.СтатусПроверкиМЧД.ТекстСтатуса);
	КонецЕсли;
	
	Возврат РеквизитыКЗаполенению;
	
КонецФункции

Функция МЧДПрошлаПроверку(ИнформацияОбМЧД)
	
	Если ИнформацияОбМЧД.Свойство("СтатусПроверкиМЧД")
		И ИнформацияОбМЧД.СтатусПроверкиМЧД.Свойство("КритичностьСтатусаПроверкиМЧД") Тогда
		
		НеКритичныеСтатусы = Новый Массив;
		НеКритичныеСтатусы.Добавить("Info");
		НеКритичныеСтатусы.Добавить("Success");
		
		Возврат НеКритичныеСтатусы.Найти(ИнформацияОбМЧД.СтатусПроверкиМЧД.КритичностьСтатусаПроверкиМЧД) <> Неопределено; 
		
	ИначеЕсли ИнформацияОбМЧД.Свойство("СтатусПроверкиМЧД")
		И ИнформацияОбМЧД.СтатусПроверкиМЧД.Свойство("ИдентификаторСтатусаПроверкиМЧД") Тогда
		
		Возврат ИнформацияОбМЧД.СтатусПроверкиМЧД.ИдентификаторСтатусаПроверкиМЧД = "IsValid"; 
		
	ИначеЕсли ИнформацияОбМЧД.Свойство("СтатусПроверкиМЧД")
		И ИнформацияОбМЧД.СтатусПроверкиМЧД.Свойство("ОшибкиПроверкиМЧД") Тогда
		
		Возврат ИнформацияОбМЧД.СтатусПроверкиМЧД.ОшибкиПроверкиМЧД.Количество() = 0;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ОпределитьФункциюУПД_ПоСобытию(Событие) Экспорт
	
	СодержимоеСобытия = Событие.СодержимоеСобытия;
	
	ЕстьСчетФактура = СодержимоеСобытия.Свойство("ИдентификаторСчетаФактуры");
	ЕстьТорг12		= СодержимоеСобытия.Свойство("ИдентификаторТорг12");
	ЕстьКСЧ			= СодержимоеСобытия.Свойство("ИдентификаторКорректировочногоСчетаФактуры");
	
	ЕстьФункцияУПД  = СодержимоеСобытия.Свойство("ФункцияУПДСообщенияINVOIC") И ЗначениеЗаполнено(СодержимоеСобытия.ФункцияУПДСообщенияINVOIC);	
	
	Если ЕстьСчетФактура И НЕ ЕстьТорг12 И НЕ ЕстьФункцияУПД Тогда 
		
		Возврат "СФ(формата УПД)";
		
	ИначеЕсли ЕстьСчетФактура И ЕстьТорг12 И НЕ ЕстьФункцияУПД Тогда
		
		Возврат "СФ+ТОРГ-12(формата УПД)";
		
	ИначеЕсли НЕ ЕстьСчетФактура И ЕстьТорг12 И НЕ ЕстьФункцияУПД Тогда 
		
		Возврат "ТОРГ-12(формат УПД)";
		
	ИначеЕсли ЕстьКСЧ И НЕ ЕстьФункцияУПД Тогда 
		
		Возврат "КСФ(формат УПД)";
		
		// Документ/Функция=КСФ - УПД используется в качестве корректирующего счета-фактуры;
		// Документ/Функция=КСЧФДИС - УПД используется в качестве корректировочного счета-фактуры и документа об изменении стоимости отгруженных товаров;
		// Документ/Функция=ДИС - УПД используется в качестве документа об изменении стоимости отгруженных товаров.
		
	ИначеЕсли ЕстьФункцияУПД И СодержимоеСобытия.ФункцияУПДСообщенияINVOIC = "Basic" Тогда 
		
		Возврат "УПД ДОП";
		
	ИначеЕсли ЕстьФункцияУПД И СодержимоеСобытия.ФункцияУПДСообщенияINVOIC = "Invoice" Тогда 
		
		Возврат "УПД СЧФ";
		
	ИначеЕсли ЕстьФункцияУПД И СодержимоеСобытия.ФункцияУПДСообщенияINVOIC = "InvoiceAndBasic" Тогда 
		
		Возврат "УПД СЧФДОП";
			
	КонецЕсли;
		
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьСтруктуруРезультатаПроверок()
	
	Возврат Новый Структура("Успешно, ТекстОшибки", Истина , "");
	
КонецФункции

Функция СтатусыБлокиррующиеОбработкуСтатусныхСообщниеДляСообщенийДД()
	
	СтатусыЗапущеноПодписаниеДД = ЭДО_Кэш_Прочитать("СтатусыЗапущеноПодписаниеДД");
	
	Если СтатусыЗапущеноПодписаниеДД = Неопределено Тогда
		
		СтатусыЗапущеноПодписаниеДД = Новый Массив;
		СтатусыЗапущеноПодписаниеДД.Добавить("Подписан и отправлен");  // нами
		СтатусыЗапущеноПодписаниеДД.Добавить("Подписан получателем");  // партнером
		СтатусыЗапущеноПодписаниеДД.Добавить("Запрос уточнения");         
		СтатусыЗапущеноПодписаниеДД.Добавить("Запрос аннулирования");
		СтатусыЗапущеноПодписаниеДД.Добавить("Аннулирован");
		СтатусыЗапущеноПодписаниеДД.Добавить("Отказано в подписи получателем");
		
		ЭДО_Кэш_Поместить("СтатусыЗапущеноПодписаниеДД", СтатусыЗапущеноПодписаниеДД);
		
	КонецЕсли;
	
	Возврат СтатусыЗапущеноПодписаниеДД;
	
КонецФункции

Функция ЭтоБлокирующийСтатусОбработкиСтатусныхСообщенийДляСообщенийДД(Статус)
	
	СтатусыБлокиррующиеОбработкуСтатусныхСообщниеДляСообщенийДД = СтатусыБлокиррующиеОбработкуСтатусныхСообщниеДляСообщенийДД();
	
	СтатусНайденВБлокирующих = (СтатусыБлокиррующиеОбработкуСтатусныхСообщниеДляСообщенийДД.Найти(Статус) <> Неопределено);
	
	Возврат СтатусНайденВБлокирующих;
	
КонецФункции


Функция ПолучитьРезультатПоискаСообщенийПоID(IDСообщения)
	
	Результат = Новый Структура("ИсходящееСообщениеНайдено, ТабНайденныхСообщений, Партнер", Ложь, Неопределено, Неопределено);
	
	Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_Сообщения.Ссылка КАК Ссылка,
	|	КонтурEDI_Сообщения.ТипСообщения КАК ТипСообщения,
	|	КонтурEDI_Сообщения.Партнер КАК Партнер,
	|	КонтурEDI_Сообщения.Статус КАК Статус,
	|	КонтурEDI_Сообщения.Документ КАК Документ
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|ГДЕ
	|	КонтурEDI_Сообщения.ID = &ID
	|	И КонтурEDI_Сообщения.Направление = ""Исходящее""";
	
	Запрос.УстановитьПараметр("ID", IDСообщения);
	
	ТабНайденныхСообщений = Запрос.Выполнить().Выгрузить();
	Если ВнешнееХранилище Тогда
		ТабНайденныхСообщений = ПолучитьТаблицуИзВнешнейБазы(ТабНайденныхСообщений,Новый Структура("Документ",Документы.ТипВсеСсылки()));
	КонецЕсли;
	
	Результат.Вставить("ИсходящееСообщениеНайдено",	ТабНайденныхСообщений.Количество() > 0);
	Результат.Вставить("ТабНайденныхСообщений",		ТабНайденныхСообщений);
	Результат.Вставить("Партнер",					?(Результат.ИсходящееСообщениеНайдено, ТабНайденныхСообщений[0].Партнер, Неопределено));

	Возврат Результат;
	
КонецФункции

Процедура ОбработатьСтатусноеСообщениеДляALCRPT_API(СтрокаСообщения, IDСообщения, ИсходящееСообщениеНайдено, Партнер)
	
	//попробуем поискать ALCRPT - предполагаем, что они могут приехать только в этих 3 событиях, т.к. все остальное - Диадок
	Если НЕ ИсходящееСообщениеНайдено
		И (СтрокаСообщения.EventType = "MessageDelivered"
		ИЛИ СтрокаСообщения.EventType = "MessageUndelivered"
		ИЛИ СтрокаСообщения.EventType = "MessageCheckingFail") Тогда		
		
		НайденныйДокументALCRPT = НайтиОбъектПоЗначениюСвойства("ALCRPT_ID",IDСообщения);
		
		Если НайденныйДокументALCRPT <> Неопределено Тогда
								
			Если ПолучитьЗначениеСвойстваОбъектаEDI(Партнер, "ОтправлятьALCRPTсINVOIC") Тогда
				ТипОтправленногоСообщения = "INVOIC";
				ДокументДляПоискаСообщения = ПолучитьСчетФактуруНакладной(НайденныйДокументALCRPT);
			Иначе
				ТипОтправленногоСообщения = "DESADV";
				ДокументДляПоискаСообщения = НайденныйДокументALCRPT;
			КонецЕсли;
			
			Если СтрокаСообщения.EventType = "MessageUndelivered"
				Или СтрокаСообщения.EventType = "MessageCheckingFail" Тогда
				
				УстановитьСтатусСообщения(,  ДокументДляПоискаСообщения, ТипОтправленногоСообщения, "ИсходящийALCRPTОжидаетИсправленияОшибок");
				
				//и запишем сам текст ошибки в сообщение DESADV или INVOIC
				ОтправленноеСообщение = ПрочитатьСообщение(,ДокументДляПоискаСообщения,ТипОтправленногоСообщения,"Исходящее");
				
				Если ОтправленноеСообщение <> Неопределено Тогда
					
					СообщениеОбъект = ПолучитьОбъектСообщения(ОтправленноеСообщение.СообщениеСсылка);
					
					Если СтрокаСообщения.EventType = "MessageUndelivered" Тогда
						ОписаниеОшибки = ПолучитьТекстовоеСодержаниеXDTO(СтрокаСообщения.EventContent.MessageUndeliveryReasons.string);
					Иначе
						ОписаниеОшибки = ПолучитьТекстовоеСодержаниеXDTO(СтрокаСообщения.EventContent.Errors.string);
					КонецЕсли;
					
					РеквизитОписаниеОшибкиALCRPT = СообщениеОбъект.ДополнительныеРеквизиты.Найти("ОшибкаALCRPT","ИмяРеквизита");
					
					Если РеквизитОписаниеОшибкиALCRPT = Неопределено Тогда
						РеквизитОписаниеОшибкиALCRPT = СообщениеОбъект.ДополнительныеРеквизиты.Добавить();
						РеквизитОписаниеОшибкиALCRPT.ИмяРеквизита = "ОшибкаALCRPT";
					КонецЕсли;
					
					РеквизитОписаниеОшибкиALCRPT.Значение		= ОписаниеОшибки;
					РеквизитОписаниеОшибкиALCRPT.ЗначениеСтрока	= ОписаниеОшибки;
					
					СообщениеОбъект.Записать();
				КонецЕсли; 				
				
			ИначеЕсли СтрокаСообщения.EventType = "MessageDelivered" Тогда
				
				Если ПолучитьСтатусСообщения(, ДокументДляПоискаСообщения, ТипОтправленногоСообщения) = ПолучитьЗначениеСтатусаСообщения("ИсходящийALCRPTОжидаетИсправленияОшибок") Тогда						
					УстановитьСтатусСообщения(,  ДокументДляПоискаСообщения, ТипОтправленногоСообщения, "ИсходящийДоставлен");
				КонецЕсли;	
				
				УстановитьЗначениеСвойстваОбъекта(ДокументДляПоискаСообщения, "БылОтправленALCRPT",	Истина);
				
			КонецЕсли;
			
			Возврат;
			
		КонецЕсли;
	КонецЕсли; 	
	
КонецПроцедуры

Процедура ПроставитьПризнакОтправкиALCRPT_ПослеПодписанияВДиадок(Документ, Партнер) Экспорт
	
	ОтправлятьALCRPT = ПолучитьЗначениеСвойстваОбъектаEDI(Партнер, "ОтправлятьALCRPTсINVOIC");
	
	Если ОтправлятьALCRPT = Истина Тогда
		Накладная = ПолучитьНакладнуюСчетаФактуры(Документ);
		УстановитьЗначениеСвойстваОбъекта(Накладная, "НужноОтправитьALCRPT",	Истина);
	КонецЕсли; 
	
КонецПроцедуры

Процедура ДобавитьСтатусныеСобытияВКарточкуСообщения(СообщениеОбъект, КонкретноеСобытие = Неопределено)
	
	МассивФиксируемыхСтатусов = Новый Массив;
	
	Если КонкретноеСобытие <> Неопределено Тогда
		МассивФиксируемыхСтатусов.Добавить(КонкретноеСобытие);
	Иначе
		
		ТипСообщения = СообщениеОбъект.ТипСообщения;
				
		Если ТипСообщения = "INVOIC" ИЛИ  ТипСообщения = "COINVOIC" Тогда
			
			МассивФиксируемыхСтатусов.Добавить("DraftOfDocumentPackageSignedByMe");
		
		КонецЕсли;
		
	КонецЕсли;
	
	Для каждого Статус Из МассивФиксируемыхСтатусов Цикл
		
		СтрокаСобытия = СообщениеОбъект.ДополнительныеРеквизиты.Найти(Статус, "ИмяРеквизита");
		
		Если СтрокаСобытия = Неопределено Тогда
			
			СтрокаСобытия = СообщениеОбъект.ДополнительныеРеквизиты.Добавить();
			СтрокаСобытия.ИмяРеквизита 		= Статус;
			СтрокаСобытия.Значение 			= Ложь;
			СтрокаСобытия.ЗначениеСтрока 	= "Ложь";
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьЗначенияВДополнительныеРеквизиты(СообщениеОбъект, СообщениеСтруктура = Неопределено)
	
	ТипСообщения = СообщениеОбъект.ТипСообщения;
	
	Если ТипСообщения = "ORDERS" Тогда 
		
		Если СообщениеСтруктура = Неопределено Тогда
			СообщениеСтруктура = СообщениеОбъект.Хранилище.Получить();
		КонецЕсли;
		
		Если Не ТипЗнч(СообщениеСтруктура) = Тип("Структура") Тогда
			Возврат;
		КонецЕсли;
		
		Если СообщениеСтруктура.Свойство("КрайняяДатаПриемки") 
			И ЗначениеЗаполнено(СообщениеСтруктура.КрайняяДатаПриемки)
			И СообщениеОбъект.ДополнительныеРеквизиты.Найти("КрайняяДатаПриемки", "ИмяРеквизита") = Неопределено Тогда 
			
			СтрокаСобытия = СообщениеОбъект.ДополнительныеРеквизиты.Добавить();
			СтрокаСобытия.ИмяРеквизита 		= "КрайняяДатаПриемки";
			СтрокаСобытия.Значение 			= СообщениеСтруктура.КрайняяДатаПриемки;
			СтрокаСобытия.ЗначениеСтрока 	= Строка(СообщениеСтруктура.КрайняяДатаПриемки);
			
		КонецЕсли;
		
		Если СообщениеСтруктура.Свойство("КрайняяДатаБронирования") 
			И ЗначениеЗаполнено(СообщениеСтруктура.КрайняяДатаБронирования)
			И СообщениеОбъект.ДополнительныеРеквизиты.Найти("КрайняяДатаБронирования", "ИмяРеквизита") = Неопределено Тогда 
			
			СтрокаСобытия = СообщениеОбъект.ДополнительныеРеквизиты.Добавить();
			СтрокаСобытия.ИмяРеквизита 		= "КрайняяДатаБронирования";
			СтрокаСобытия.Значение 			= СообщениеСтруктура.КрайняяДатаБронирования;
			СтрокаСобытия.ЗначениеСтрока 	= Строка(СообщениеСтруктура.КрайняяДатаБронирования);
			
		КонецЕсли;
		
		Если СообщениеСтруктура.Свойство("КрайняяДатаОтвета") 
			И ЗначениеЗаполнено(СообщениеСтруктура.КрайняяДатаОтвета)
			И СообщениеОбъект.ДополнительныеРеквизиты.Найти("КрайняяДатаОтвета", "ИмяРеквизита") = Неопределено Тогда 
			
			СтрокаСобытия = СообщениеОбъект.ДополнительныеРеквизиты.Добавить();
			СтрокаСобытия.ИмяРеквизита 		= "КрайняяДатаОтвета";
			СтрокаСобытия.Значение 			= СообщениеСтруктура.КрайняяДатаОтвета;
			СтрокаСобытия.ЗначениеСтрока 	= Строка(СообщениеСтруктура.КрайняяДатаОтвета);
			
		КонецЕсли;
		
		Если НРег(СообщениеСтруктура.Статус) = "provisional"
			И СообщениеОбъект.ДополнительныеРеквизиты.Найти("ЭтоПредварительныйЗаказ", "ИмяРеквизита") = Неопределено Тогда 
			
			СтрокаСобытия = СообщениеОбъект.ДополнительныеРеквизиты.Добавить();
			СтрокаСобытия.ИмяРеквизита 		= "ЭтоПредварительныйЗаказ";
			СтрокаСобытия.Значение 			= Истина;
			СтрокаСобытия.ЗначениеСтрока 	= "Истина";
			
		КонецЕсли;
			
	ИначеЕсли (ТипСообщения = "INVOIC" ИЛИ ТипСообщения = "COINVOIC")
		И СообщениеОбъект.Направление = "Исходящее" Тогда
		
		ПолучитьИлиСоздать_Diadoc_operationID(СообщениеОбъект);		
		
	КонецЕсли;
	
	СохранитьТипыПродукцииВДополнительныеРеквизитыСообщения(СообщениеОбъект, СообщениеСтруктура);
	
КонецПроцедуры


Процедура ЗафиксироватьПроизошедшееСобытиеВСообщении(СообщениеОбъект, EventType, Значение = Истина)

	СтрокаСобытия = СообщениеОбъект.ДополнительныеРеквизиты.Найти(EventType, "ИмяРеквизита");
	
	Если СтрокаСобытия = Неопределено Тогда
		СтрокаСобытия = СообщениеОбъект.ДополнительныеРеквизиты.Добавить();
	КонецЕсли;
	
	СтрокаСобытия.ИмяРеквизита 		= EventType;
	СтрокаСобытия.Значение 			= Значение;
	СтрокаСобытия.ЗначениеСтрока 	= Строка(Значение);

КонецПроцедуры 

Функция ПолучитьЗначенияЗафиксированныхСтатусныхСобытийСообщения(СообщениеСсылка, События)
	
	Если ТипЗнч(События) <> Тип("Массив") И  ТипЗнч(События) <> Тип("СписокЗначений") Тогда
		
		МассивСобытий = Новый Массив;
		МассивСобытий.Добавить(События);
		
	Иначе
		
		МассивСобытий = События;
		
	КонецЕсли;
	
	СоответствиеСобытийИЗначений = Новый Соответствие;
	
	Для каждого Событие Из МассивСобытий Цикл
		СоответствиеСобытийИЗначений.Вставить(Событие, Ложь);
	КонецЦикла;
	

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтурEDI_СообщенияДополнительныеРеквизиты.ИмяРеквизита КАК Событие,
		|	КонтурEDI_СообщенияДополнительныеРеквизиты.Значение
		|ИЗ
		|	Справочник.КонтурEDI_Сообщения.ДополнительныеРеквизиты КАК КонтурEDI_СообщенияДополнительныеРеквизиты
		|ГДЕ
		|	КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка = &Ссылка
		|	И КонтурEDI_СообщенияДополнительныеРеквизиты.ИмяРеквизита В(&МассивСобытий)";

	Запрос.УстановитьПараметр("МассивСобытий", МассивСобытий);
	Запрос.УстановитьПараметр("Ссылка", СообщениеСсылка);

	Результат = Запрос.Выполнить();

	Если Не Результат.Пустой() Тогда 
		ВыборкаДетальныеЗаписи = Результат.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			СоответствиеСобытийИЗначений.Вставить(ВыборкаДетальныеЗаписи.Событие, ВыборкаДетальныеЗаписи.Значение);
		КонецЦикла;
	КонецЕсли;

	Возврат СоответствиеСобытийИЗначений;
	
КонецФункции

//}Работа со статусными сообщениями  

Функция ПолучитьТекстовоеСодержаниеXDTO(ИсходныйТег)
	//соберем воедино строку/строки из MessageUndeliveryReasons и т.д.
	СтрокаРезультат = "";
	
	Если ТипЗнч(ИсходныйТег)=Тип("Строка") Тогда//этого не бывает
		
		СтрокаРезультат = ИсходныйТег;
		
	ИначеЕсли ТипЗнч(ИсходныйТег)=Тип("СписокXDTO") Тогда
		
		Для Каждого Эл Из ИсходныйТег Цикл
			СтрокаРезультат = СтрокаРезультат+?(СтрокаРезультат="","",Символы.ПС)+Эл;
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ИсходныйТег)=Тип("ОбъектXDTO") Тогда
		
		СтрокаРезультат = ИсходныйТег;
		
	КонецЕсли;
	
	Возврат СтрокаРезультат;
	
КонецФункции

Функция РазложитьСтроку(Знач Строка,Разделитель=",") Экспорт
	
	СЗ=Новый СписокЗначений();
	
	Строка=СтрЗаменить(Строка,Разделитель,Символы.ПС);
	
	ЧислоСтрок = СтрЧислоСтрок(Строка);
	
	Для н=1 По ЧислоСтрок Цикл
		СЗ.Добавить(СтрПолучитьСтроку(Строка,н));
	КонецЦикла;
	
	Возврат СЗ;
	
КонецФункции

Функция ПодготовитьСтруктуруДействий_УФ_ЗаказПокупателя(Объект)
	
	СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер_ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);
	
