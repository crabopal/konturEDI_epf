Функция МетрикаКонтурСлужебный_СвойствоОбъектаИдентификаторИБ(ИмяПВХ)
	
	ИмяСвойства = "КонтурИдентификаторИБ";
	
	МенеджерПВХ = ПланыВидовХарактеристик[ИмяПВХ];
	
	Результат = МенеджерПВХ.НайтиПоНаименованию(ИмяСвойства, Истина);
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		
		// BSLLS:SetPrivilegedMode-off
		УстановитьПривилегированныйРежим(Истина);
		// BSLLS:SetPrivilegedMode-on
		
		СвойствоОбъект = МенеджерПВХ.СоздатьЭлемент();
		
		СвойствоОбъект.Наименование = ИмяСвойства;
		СвойствоОбъект.ТипЗначения = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50));
		СвойствоОбъект.УстановитьНовыйКод();
		
		ЕстьРеквизитЗаголовок =
			(Метаданные.ПланыВидовХарактеристик[ИмяПВХ].Реквизиты.Найти("Заголовок") <> Неопределено);
		Если ЕстьРеквизитЗаголовок Тогда
			СвойствоОбъект.Заголовок = СвойствоОбъект.Наименование;
		КонецЕсли;
		
		СвойствоОбъект.ОбменДанными.Загрузка = Истина;
		СвойствоОбъект.Записать();
		
		Если ПривилегированныйРежим() Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		
		Результат = СвойствоОбъект.Ссылка;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция МетрикаКонтурСлужебный_ИдентификаторИнформационнойБазы_РегистрСведений(ИмяРегистра, ИмяПВХ)	
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Т.Объект КАК Объект,
	|	Т.Свойство.Наименование КАК ИмяСвойства,
	|	Т.Значение КАК ЗначениеСвойства
	|ИЗ
	|	РегистрСведений.%1 КАК Т
	|ГДЕ
	|	Т.Свойство = &Свойство
	|	И Т.Объект = &Объект";
	
	ТекстЗапроса = КонтурСтандарт_СтрШаблон_(ТекстЗапроса, ИмяРегистра);
	
	ИзмерениеСвойство = МетрикаКонтурСлужебный_СвойствоОбъектаИдентификаторИБ(ИмяПВХ);
	ИзмерениеОбъект   = МетрикаКонтурСлужебный_СправочникСсылкаВалютыРубль();
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Свойство", ИзмерениеСвойство);
	Запрос.УстановитьПараметр("Объект", ИзмерениеОбъект);
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаЗапроса.Следующий() Тогда
		Результат = ВыборкаЗапроса.ЗначениеСвойства;
	Иначе
		Результат = "";
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		
		Результат = Строка(Новый УникальныйИдентификатор);
		
		Запись = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
		Запись.Объект = ИзмерениеОбъект;
		Запись.Свойство = ИзмерениеСвойство;
		Запись.Значение = Результат;
		
		Запись.Записать();
		
	КонецЕсли;
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

Функция МетрикаКонтурСлужебный_ДоступенВариантИдентификации_КонстантаКонтур()
	
	ИмяКонстанты = "КонтурИдентификаторИБ";
	
