	                              |					КОГДА ВТ_НастройкиБлокирущиеИсходящиеСообщения.ORDRSP
	                              |						ТОГДА ""ORDRSP""
	                              |					КОГДА ВТ_НастройкиБлокирущиеИсходящиеСообщения.ORDERS
	                              |						ТОГДА ""ORDERS""
	                              |					ИНАЧЕ """"
	                              |				КОНЕЦ
	                              |		ИНАЧЕ ВЫБОР
	                              |				КОГДА ВТ_НастройкиБлокирущиеИсходящиеСообщения.RECADV
	                              |					ТОГДА ""RECADV""
	                              |				КОГДА ВТ_НастройкиБлокирущиеИсходящиеСообщения.DESADV
	                              |					ТОГДА ""DESADV""
	                              |				КОГДА ВТ_НастройкиБлокирущиеИсходящиеСообщения.ORDRSP
	                              |					ТОГДА ""ORDRSP""
	                              |				КОГДА ВТ_НастройкиБлокирущиеИсходящиеСообщения.ORDERS
	                              |					ТОГДА ""ORDERS""
	                              |				ИНАЧЕ """"
	                              |			КОНЕЦ
	                              |	КОНЕЦ КАК СообщениеПредыдущееINVOIC
	                              |ПОМЕСТИТЬ ТипыБлокирующихСообщенийПоВариантамНастроек
	                              |ИЗ
	                              |	ВТ_НастройкиБлокирущиеИсходящиеСообщения КАК ВТ_НастройкиБлокирущиеИсходящиеСообщения
	                              |;
	                              |
	                              |////////////////////////////////////////////////////////////////////////////////
	                              |УНИЧТОЖИТЬ ВТ_НастройкиБлокирущиеИсходящиеСообщения";

	ЗапросСКэшемПартнеров.УстановитьПараметр("ВариантыНастроекБлокирущихИсходящеСообщения", ВариантыНастроекБлокирущихИсходящиеСообщенияПоставщика_КонтурEDI());
	ЗапросСКэшемПартнеров.Выполнить();  	

КонецПроцедуры

Функция УстановленаДатаДействияСообщенийВНастройкахПартнеров(ЗапросСКэшемПартнеров)
	
	ЗапросСКэшемПартнеров.Текст = "ВЫБРАТЬ
	                              |	ИСТИНА
	                              |ИЗ
	                              |	ТаблицаКэшПартнеров КАК ТаблицаКэшПартнеров
	                              |ГДЕ
	                              |	(НЕ ТаблицаКэшПартнеров.ORDRSP_Исходящее_ДатаДействия = ДАТАВРЕМЯ(1, 1, 1)
	                              |			ИЛИ НЕ ТаблицаКэшПартнеров.DESADV_Исходящее_ДатаДействия = ДАТАВРЕМЯ(1, 1, 1)
	                              |			ИЛИ НЕ ТаблицаКэшПартнеров.INVOIC_Исходящее_ДатаДействия = ДАТАВРЕМЯ(1, 1, 1))";
	
	РезультатЗапроса = ЗапросСКэшемПартнеров.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

Процедура ПересоздатьВремТаблицыДокументовСУчетомДатыДействияИсходящихСообщений(ЗапросСКэшемПартнеров, ТекстыВременныхТаблиц)
	
	Если НЕ УстановленаДатаДействияСообщенийВНастройкахПартнеров(ЗапросСКэшемПартнеров) Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьСписокТипыБлокирующихСообщенийПоВариантамНастроек(ЗапросСКэшемПартнеров);
	
	
	ТипДокумента_ORDRSP = ПолучитьТипЗначенияОбъекта("ИсходящийОтветНаЗаказ",, Истина);
	ТипДокумента_DESADV = ПолучитьТипЗначенияОбъекта("ИсходящееУведомлениеОбОтгрузке",, Истина);
	ТипДокумента_INVOIC = ПолучитьТипЗначенияОбъекта("ИсходящийСчетФактура",, Истина);
	
	ОписаниеДокументовЦепочкиПоставщика = Новый Структура;
	ОписаниеДокументовЦепочкиПоставщика.Вставить(ТипДокумента_ORDRSP, "Док_" + ТипДокумента_ORDRSP);
	ОписаниеДокументовЦепочкиПоставщика.Вставить(ТипДокумента_DESADV, "Док_" + ТипДокумента_DESADV);
	ОписаниеДокументовЦепочкиПоставщика.Вставить(ТипДокумента_INVOIC, "Док_" + ТипДокумента_INVOIC);
		
	Для Каждого ОписаниеДокумента Из ОписаниеДокументовЦепочкиПоставщика Цикл	
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	&ВременнаяТаблицаДокументов.Партнер,
		|	&ВременнаяТаблицаДокументов.PORDERS,
		|	&ВременнаяТаблицаДокументов.ORDERS,
		|	ВЫБОР
		|		КОГДА НЕ &ВременнаяТаблицаДокументов.ORDRSP
		|			ТОГДА ЛОЖЬ
		|       КОГДА &ВременнаяТаблицаДокументов.#Док_ЗаказПокупателя# ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|       КОГДА &ВременнаяТаблицаДокументов.#Док_ЗаказПокупателя#.Дата >= ТаблицаКэшПартнеров.ORDRSP_Исходящее_ДатаДействия 
		|			ТОГДА ИСТИНА 
		| 			ИНАЧЕ ЛОЖЬ 
		|	КОНЕЦ КАК ORDRSP,
		|	ВЫБОР
		|		КОГДА НЕ &ВременнаяТаблицаДокументов.DESADV
		|			ТОГДА ЛОЖЬ
		|       КОГДА &ВременнаяТаблицаДокументов.#Док_РеализацияТоваровУслуг# ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|       КОГДА &ВременнаяТаблицаДокументов.#Док_РеализацияТоваровУслуг#.Дата >= ТаблицаКэшПартнеров.DESADV_Исходящее_ДатаДействия 
		|			ТОГДА ИСТИНА 
		| 			ИНАЧЕ ЛОЖЬ 
		|	КОНЕЦ КАК DESADV,
		|	ВЫБОР
		|		КОГДА НЕ &ВременнаяТаблицаДокументов.INVOIC
		|			ТОГДА ЛОЖЬ
		|       КОГДА &ВременнаяТаблицаДокументов.#Док_СчетФактураВыданный# ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|       КОГДА &ВременнаяТаблицаДокументов.#Док_СчетФактураВыданный#.Дата >= ТаблицаКэшПартнеров.INVOIC_Исходящее_ДатаДействия 
		|			ТОГДА ИСТИНА 
		| 			ИНАЧЕ ЛОЖЬ 
		|	КОНЕЦ КАК INVOIC,
		|	&ВременнаяТаблицаДокументов.RECADV,						
		|	ТаблицаКэшПартнеров.INVOICДоОбработкиRECADV,
		|	&ВременнаяТаблицаДокументов.СообщениеБлокирующееPORDERS,
		|	&ВременнаяТаблицаДокументов.СообщениеБлокирующееORDERS,
		|	&ВременнаяТаблицаДокументов.СообщениеБлокирующееORDRSP,
		|	&ВременнаяТаблицаДокументов.СообщениеБлокирующееDESADV,					   
		|	&ВременнаяТаблицаДокументов.СообщениеБлокирующееRECADV,					   
		|	&ВременнаяТаблицаДокументов.СообщениеПредыдущееINVOIC,
		|	&ВременнаяТаблицаДокументов.СообщениеБлокирующееINVOIC,
		|	&ВременнаяТаблицаДокументов.INVOICНеБлокируетсяПредыдущимиСообщениями,
		|	&ВременнаяТаблицаДокументов.Док_Проведен,
		|	&ВременнаяТаблицаДокументов.СуммаДокумента					   
		|ПОМЕСТИТЬ ВТ_ИсточникДанных
		|ИЗ
		|	&ВременнаяТаблицаДокументов КАК &ВременнаяТаблицаДокументов					   
		|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаКэшПартнеров КАК ТаблицаКэшПартнеров
		|		ПО (&ВременнаяТаблицаДокументов.Партнер = ТаблицаКэшПартнеров.Партнер)
		|;
		|////////////////////////////////////////////////////////////////////////////////					   	
		|УНИЧТОЖИТЬ &ВременнаяТаблицаДокументов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ					   
		|	ВТ_ИсточникДанных.Партнер,
		|	ВТ_ИсточникДанных.PORDERS,
		|	ВТ_ИсточникДанных.ORDERS,
		|	ВТ_ИсточникДанных.ORDRSP,					   
		|	ВТ_ИсточникДанных.DESADV,
		|	ВТ_ИсточникДанных.RECADV,
		|	ВТ_ИсточникДанных.INVOIC,					   
		|	ВТ_ИсточникДанных.СообщениеБлокирующееPORDERS,
		|	ВТ_ИсточникДанных.СообщениеБлокирующееORDERS,
		|	ВТ_ИсточникДанных.СообщениеБлокирующееORDRSP,
		|	ТаблицаТипыБлокирующихСообщений.СообщениеБлокирующееDESADV,					   					   
		|	ТаблицаТипыБлокирующихСообщений.СообщениеБлокирующееRECADV,  		   				   					   
		|	ТаблицаТипыБлокирующихСообщений.СообщениеПредыдущееINVOIC,
		|	ТаблицаТипыБлокирующихСообщений.СообщениеБлокирующееINVOIC,		
		|	ВТ_ИсточникДанных.INVOICНеБлокируетсяПредыдущимиСообщениями,
		|	ВТ_ИсточникДанных.Док_Проведен,					   					   
		|	ВТ_ИсточникДанных.СуммаДокумента					   				   					   	
		|ПОМЕСТИТЬ &ВременнаяТаблицаДокументов
		|ИЗ
		|	ВТ_ИсточникДанных КАК ВТ_ИсточникДанных		
		|		ЛЕВОЕ СОЕДИНЕНИЕ ТипыБлокирующихСообщенийПоВариантамНастроек КАК ТаблицаТипыБлокирующихСообщений
		|       ПО ТаблицаТипыБлокирующихСообщений.ORDERS = ВТ_ИсточникДанных.ORDERS
		|			И ТаблицаТипыБлокирующихСообщений.ORDRSP = ВТ_ИсточникДанных.ORDRSP
		|           И ТаблицаТипыБлокирующихСообщений.DESADV = ВТ_ИсточникДанных.DESADV
		|			И ТаблицаТипыБлокирующихСообщений.RECADV = ВТ_ИсточникДанных.RECADV
		|			И ТаблицаТипыБлокирующихСообщений.INVOICНеБлокируетсяПредыдущимиСообщениями = ВТ_ИсточникДанных.INVOICНеБлокируетсяПредыдущимиСообщениями
		|           И ТаблицаТипыБлокирующихСообщений.INVOICДоОбработкиRECADV = ВТ_ИсточникДанных.INVOICДоОбработкиRECADV		
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_ИсточникДанных
		|;
		|";
		
		ИмяВременнойТаблицыДокументов = "ВТ_" + ОписаниеДокумента.Ключ;
		
				
		Для Каждого КлючЗначение Из ОписаниеДокументовЦепочкиПоставщика Цикл
						
			ИмяПоляТаблицы = КлючЗначение.Значение;
			
			ЕстьПолеДок_СчетФактураВыданный = Найти(ТекстыВременныхТаблиц[ИмяВременнойТаблицыДокументов],ИмяПоляТаблицы) > 0;
			
			Если НЕ ЕстьПолеДок_СчетФактураВыданный Тогда
				
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВременнаяТаблицаДокументов.#Док_СчетФактураВыданный# ЕСТЬ NULL"	, "NULL ЕСТЬ NULL");
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВременнаяТаблицаДокументов.#Док_СчетФактураВыданный#.Дата"		, "ДАТАВРЕМЯ(1,1,1)");
				
				Продолжить;			
				
			КонецЕсли;
			
			СтрокаПоиска = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ";
			
			СтрокаЗамены = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ 			
							|	&ВременнаяТаблицаДокументов.%1,";
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, СтрокаПоиска, СтрокаЗамены);
			
			СтрокаПоиска = "ВТ_ИсточникДанных.Партнер,";
			
			СтрокаЗамены = "ВТ_ИсточникДанных.Партнер,			
							|	ВТ_ИсточникДанных.%1,";
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, СтрокаПоиска, СтрокаЗамены);
			
			ТекстЗапроса = КонтурСтандарт_СтрШаблон_(ТекстЗапроса, ИмяПоляТаблицы);
					
		КонецЦикла;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#Док_ЗаказПокупателя#"		, ОписаниеДокументовЦепочкиПоставщика[ТипДокумента_ORDRSP]);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#Док_РеализацияТоваровУслуг#"	, ОписаниеДокументовЦепочкиПоставщика[ТипДокумента_DESADV]);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#Док_СчетФактураВыданный#"	, ОписаниеДокументовЦепочкиПоставщика[ТипДокумента_INVOIC]);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВременнаяТаблицаДокументов"	, ИмяВременнойТаблицыДокументов);
				
		ЗапросСКэшемПартнеров.Текст = ТекстЗапроса;
		
		ЗапросСКэшемПартнеров.Выполнить();		
		
	КонецЦикла;	
			
КонецПроцедуры

Процедура СформироватьВременныеТаблицыДокументов(РежимРаботы,ЗапросСКэшемПартнеров)
	
	ТаблицаСоединенийДокументов = ПолучитьТаблицуДляСборкиЗапросов(РежимРаботы);
	ТекстыВременныхТаблиц  = Новый Структура;
	
	Для Каждого СтрокаОписанияТаблицы Из ТаблицаСоединенийДокументов Цикл
		
		ТекстТекущейТаблицы = ПолучитьТекстЗапросаДляТаблицы(СтрокаОписанияТаблицы.ПсевдонимТаблицы,ТаблицаСоединенийДокументов,"ПостроениеСписка");
		ТекстТекущейТаблицы = СтрЗаменить(ТекстТекущейТаблицы,"&Условия","Истина");//сюда будем подставлять нужные условия
		
		ЗапросСКэшемПартнеров.Текст  = ТекстТекущейТаблицы;
			
		ЗапросСКэшемПартнеров.Выполнить();
		
		ТекстыВременныхТаблиц.Вставить("ВТ_" + СтрокаОписанияТаблицы.ТипДокумента, ТекстТекущейТаблицы);
		
	КонецЦикла;
	
	Если РежимРаботы = "Поставщик" Тогда
		ПересоздатьВремТаблицыДокументовСУчетомДатыДействияИсходящихСообщений(ЗапросСКэшемПартнеров, ТекстыВременныхТаблиц);
	КонецЕсли;
	
КонецПроцедуры	

Процедура СформироватьВременныеТаблицыВозвратныхДокументов(РежимРаботы, ЗапросСКэшемПартнеров)
	
	// TODO Когда переведем возвраты на шаблоны - переделать
	МассивТиповВозвратов = Новый Массив;
	
	Если РежимРаботы = "Поставщик" Тогда
		
		МассивТиповПоставщик = Новый Массив;
		МассивТиповПоставщик.Добавить(ПолучитьТипЗначенияОбъекта("ВходящийВозврат",,Истина));	
		МассивТиповПоставщик.Добавить(ПолучитьТипЗначенияОбъекта("ИсходящийОтветНаУведомлениеОВозврате",,Истина));	
		МассивТиповПоставщик.Добавить(ПолучитьТипЗначенияОбъекта("ВходящееУведомлениеОбОтгрузкеВозврата",,Истина));		
		МассивТиповПоставщик.Добавить(ПолучитьТипЗначенияОбъекта("ИсходящееУведомлениеОПриемкеВозврата",,Истина));
		
		Для каждого ТипДокумента Из МассивТиповПоставщик Цикл
			
			Если НЕ ЗначениеЗаполнено(ТипДокумента) Тогда
				Продолжить;
			КонецЕсли;
			Если МассивТиповВозвратов.Найти(ТипДокумента) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			МассивТиповВозвратов.Добавить(ТипДокумента);	
			
		КонецЦикла; 
		
	ИначеЕсли РежимРаботы = "Покупатель" Тогда
		
		// здесь пока 1 тип
		МассивТиповПокупатель = Новый Массив;
		МассивТиповПокупатель.Добавить(ПолучитьТипЗначенияОбъекта("ИсходящийВозврат",,Истина));
		МассивТиповПокупатель.Добавить(ПолучитьТипЗначенияОбъекта("ИсходящееУведомлениеОбОтгрузкеВозврата",,Истина));		
	
		Для каждого ТипДокумента Из МассивТиповПокупатель Цикл
			
			Если НЕ ЗначениеЗаполнено(ТипДокумента) Тогда
				Продолжить;
			КонецЕсли;
			Если МассивТиповВозвратов.Найти(ТипДокумента) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			МассивТиповВозвратов.Добавить(ТипДокумента);	
				
		КонецЦикла; 

	КонецЕсли;
	
	Для каждого ТипДокумента Из МассивТиповВозвратов Цикл
	
		ЗапросСКэшемПартнеров.Текст = ПолучитьТекстЗапросаДляТаблицыВозврата(ТипДокумента,, "ПостроениеСписка");		
		ЗапросСКэшемПартнеров.Выполнить();
		
	КонецЦикла;

КонецПроцедуры	

//показать действие "Провести заказ" для документов без контрагентов
Процедура СформироватьТаблицуДокументовБезКонтрагентовПоORDERSДляПроведения(РежимРаботы,ЗапросСКэшемПартнеров, МассивВременныхТаблиц)
	
	ТипДокументаORDERS = ПолучитьТипЗначенияОбъекта("ВходящийЗаказПокупателя",,Истина);
	ПредставлениеORDERS = Метаданные.Документы[ТипДокументаORDERS].Синоним;
	НеПроводитьДокументВМодуле = (ПолучитьКонстантуEDI("НПД_" + ТипДокументаORDERS) = Истина);
	
	Если НеПроводитьДокументВМодуле Тогда
		ДействиеЕслиНеПроведен = "Ожидается проведение: " + ПредставлениеORDERS;
	Иначе
		ДействиеЕслиНеПроведен = "Провести " + ПредставлениеORDERS;
	КонецЕсли;
		
	ЗапросСКэшемПартнеров.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_Сообщения.Партнер КАК Партнер,
	|	КонтурEDI_Сообщения.Документ КАК Документ,
	|	КонтурEDI_Сообщения.Ссылка КАК Сообщение,
	|	""ORDERS"" КАК ТипСообщения,
	|	&ДействиеЕслиНеПроведен КАК ТребуемоеДействие,
	|	КонтурEDI_Сообщения.Сумма КАК СуммаСообщения,
	|	КонтурEDI_Сообщения.Статус КАК СтатусДокумента,
	|	ВТ_ЗаказПокупателя.Док_ЗаказПокупателя
	|ПОМЕСТИТЬ ВТ_ПринятыеORDERS
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаКэшПартнеров КАК ТаблицаКэшПартнеров
	|		ПО КонтурEDI_Сообщения.Партнер = ТаблицаКэшПартнеров.Партнер
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗаказПокупателя КАК ВТ_ЗаказПокупателя
	|		ПО КонтурEDI_Сообщения.Партнер = ВТ_ЗаказПокупателя.Партнер
	|			И КонтурEDI_Сообщения.Документ = ВТ_ЗаказПокупателя.Док_ЗаказПокупателя
	|ГДЕ
	|	КонтурEDI_Сообщения.ДатаДокумента МЕЖДУ &НачалоПериода И &КонецПериода
	|	И КонтурEDI_Сообщения.ТипСообщения = ""ORDERS""
	|	И КонтурEDI_Сообщения.ТребуемоеДействие = ""РаботаЗавершена""
	|	И &Условия
	|	И ВТ_ЗаказПокупателя.Док_ЗаказПокупателя ЕСТЬ NULL
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Документ,
	|	КонтурEDI_Сообщения.Ссылка";
	
	ЗапросСКэшемПартнеров.Текст = СтрЗаменить(ЗапросСКэшемПартнеров.Текст, "ВТ_ЗаказПокупателя", "ВТ_" + ТипДокументаORDERS);
	ЗапросСКэшемПартнеров.Текст = СтрЗаменить(ЗапросСКэшемПартнеров.Текст, "Док_ЗаказПокупателя", "Док_" + ТипДокументаORDERS);
	
	ЗапросСКэшемПартнеров.УстановитьПараметр("ДействиеЕслиНеПроведен", ДействиеЕслиНеПроведен);
	Если НЕ ВнешнееХранилище Тогда
		ЗапросСКэшемПартнеров.Текст = СтрЗаменить(ЗапросСКэшемПартнеров.Текст, 
		"&Условия", 
		"НЕ ЕСТЬNULL(ВЫРАЗИТЬ(КонтурEDI_Сообщения.Документ КАК Документ." + ТипДокументаORDERS + ").Проведен, Истина)
		|	И НЕ ЕСТЬNULL(ВЫРАЗИТЬ(КонтурEDI_Сообщения.Документ КАК Документ." + ТипДокументаORDERS + ").ПометкаУдаления, Истина)");
	Иначе
		ЗапросСКэшемПартнеров.Текст = СтрЗаменить(ЗапросСКэшемПартнеров.Текст, 
		"&Условия", "ИСТИНА");
	КонецЕсли;
	
	ЗапросСКэшемПартнеров.Выполнить();
	МассивВременныхТаблиц.Добавить("ВТ_ПринятыеORDERS");
		
КонецПроцедуры

