// #Область Создение_элементов_управляемых_форм

//Добавляет на управляему форму элемент формы Надпись
//
// Параметры:
//  Форма				- ФормаКлиентскогоПриложения - форма, в которую добавляется элемент формы
//  ИмяЭлемента			- Строка - имя добавляемого элемента формы
//  ПараметрыЭлемента	- Структура - параметры добавляемого элемента формы
//  Родитель			- ГруппаФормы - группа, в которую добавляется элемент формы
//
// Возвращаемое значение: 
//   ДекорацияФормы   - Добавленный элемент управляемой формы
// 
Функция ДобавитьНаФормуНадпись(Форма, ИмяЭлемента, ПараметрыЭлемента, Родитель = Неопределено) Экспорт
	
	Если Родитель = Неопределено Тогда
		Родитель = Форма;
	КонецЕсли;
	
	Декорация = Форма.Элементы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), Родитель);
	Декорация.Вид = ВидДекорацииФормы.Надпись;
	ЗаполнитьЗначенияСвойств(Декорация, ПараметрыЭлемента);
	
	Возврат Декорация;

КонецФункции

//Добавляет на управляему форму элемент формы Картинка
//
// Параметры:
//  Форма				- ФормаКлиентскогоПриложения - форма, в которую добавляется элемент формы
//  ИмяЭлемента			- Строка - имя добавляемого элемента формы
//  ПараметрыЭлемента	- Структура - параметры добавляемого элемента формы
//  Родитель			- ГруппаФормы - группа, в которую добавляется элемент формы
//
// Возвращаемое значение: 
//   ДекорацияФормы   - Добавленный элемент управляемой формы
// 
Функция ДобавитьНаФормуКартинку(Форма, ИмяЭлемента, ПараметрыЭлемента, Родитель = Неопределено) Экспорт
	
	Если Родитель = Неопределено Тогда
		Родитель = Форма;
	КонецЕсли;
	
	Декорация = Форма.Элементы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), Родитель);
	Декорация.Вид = ВидДекорацииФормы.Картинка;
	ЗаполнитьЗначенияСвойств(Декорация, ПараметрыЭлемента);
	
	Возврат Декорация;

КонецФункции

//Добавляет на управляему форму элемент формы Группа
//
// Параметры:
//  Форма				- ФормаКлиентскогоПриложения - форма, в которую добавляется элемент формы
//  ИмяЭлемента			- Строка - имя добавляемого элемента формы
//  ПараметрыЭлемента	- Структура - параметры добавляемого элемента формы
//  Родитель			- ГруппаФормы, ТаблицаФормы - группа или таблица, в которую добавляется элемент формы
//
// Возвращаемое значение: 
//   ГруппаФормы   - Добавленный элемент управляемой формы
//
Функция ДобавитьНаФормуГруппу(Форма, ИмяЭлемента, ПараметрыЭлемента, Родитель = Неопределено) Экспорт
	
	Если Родитель = Неопределено Тогда
		Родитель = Форма;
	КонецЕсли;
	
	Группа = Форма.Элементы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), Родитель);
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ЗаполнитьЗначенияСвойств(Группа, ПараметрыЭлемента);
	
	Возврат Группа;

КонецФункции

//Добавляет на управляему форму элемент формы разделитель
//
// Параметры:
//  Форма				- ФормаКлиентскогоПриложения - форма, в которую добавляется элемент формы
//  ИмяЭлемента			- Строка - имя добавляемого элемента формы
//  ПараметрыЭлемента	- Структура - параметры добавляемого элемента формы
//  Родитель			- ГруппаФормы - группа, в которую добавляется элемент формы
//
// Возвращаемое значение: 
//   ДекорацияФормы   - Добавленный элемент управляемой формы
//
Функция ДобавитьНаФормуРазделитель(Форма, ИмяЭлемента, ПараметрыЭлемента, Родитель = Неопределено) Экспорт
	
	Если Родитель = Неопределено Тогда
		Родитель = Форма;
	КонецЕсли;
	
	Декорация = Форма.Элементы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), Родитель);
	Декорация.Вид = ВидДекорацииФормы.Картинка;
	Декорация.Рамка = Новый Рамка(ТипРамкиЭлементаУправления.Подчеркивание);
	ЗаполнитьЗначенияСвойств(Декорация, ПараметрыЭлемента);
	
	Возврат Декорация;

КонецФункции

//Добавляет на управляему форму Команду
//
// Параметры:
//  Форма				- ФормаКлиентскогоПриложения - форма, в которую добавляется команда
//  ИмяКоманды			- Строка - имя добавляемого команды
//  ПараметрыКоманды	- Структура - параметры добавляемой команды
//
// Возвращаемое значение: 
//   Команда   - Добавленная команда управляемой формы
//
Функция ДобавитьНаФормуКоманду(Форма, ИмяКоманды, ПараметрыКоманды) Экспорт
	
	Команда = Форма.Команды.Добавить(ИмяКоманды);
	ЗаполнитьЗначенияСвойств(Команда, ПараметрыКоманды);

	Возврат Команда;
	
КонецФункции
	
//Добавляет на управляему форму элемент формы Кнопка
//
// Параметры:
//  Форма				- ФормаКлиентскогоПриложения - форма, в которую добавляется элемент формы
//  ИмяЭлемента			- Строка - имя добавляемого элемента формы
//  ПараметрыЭлемента	- Структура - параметры добавляемого элемента формы
//  Родитель			- ГруппаФормы - группа, в которую добавляется элемент формы
//
// Возвращаемое значение: 
//   КнопкаФормы   - Добавленный элемент управляемой формы
//
Функция ДобавитьНаФормуКнопку(Форма, ИмяЭлемента, ПараметрыЭлемента, Родитель = Неопределено) Экспорт
	
	Если Родитель = Неопределено Тогда
		Родитель = Форма;
	КонецЕсли;
		
	Кнопка = Форма.Элементы.Добавить(ИмяЭлемента, Тип("КнопкаФормы"), Родитель);
	ЗаполнитьЗначенияСвойств(Кнопка, ПараметрыЭлемента);
 
	Возврат Кнопка;
	
КонецФункции

// #КонецОбласти //Создение_элементов_управляемых_форм

// #Область Предварительные_заказы
Функция ЗакрытьПредварительныеЗаказы(МассивДокументов, СписокПредварительныхЗаказов = Неопределено, ОсновнойЗаказСсылка = Неопределено) Экспорт
	
	Результат = Истина;
	
	Если ЗначениеЗаполнено(СписокПредварительныхЗаказов) Тогда
		ОбработатьСписокПредварительныхЗаказов(СписокПредварительныхЗаказов, ОсновнойЗаказСсылка);
	КонецЕсли;
	
	ЗакрытьЗаказыПокупателей1C_КонтурEDI(МассивДокументов); 
	
	Возврат Результат;

КонецФункции 

Процедура ЗакрытьЗаказыПокупателей1C_КонтурEDI(МассивДокументов) Экспорт
	
	Если НЕ (ТипЗнч(МассивДокументов) = Тип("Массив") И МассивДокументов.Количество()) Тогда 
		Возврат;
	КонецЕсли;  
	
	СтруктураСпособЗакрытия = ПолучитьСпособЗакрытияЗаказов();
	
	НачатьТранзакцию(); 

	Попытка 
		
		Если СтруктураСпособЗакрытия.СпособЗакрытия = "СоздатьЗакрытиеЗаказов" Тогда
			
			ДокументЗакрытияОбъект = Документы[СтруктураСпособЗакрытия.ТипДокумента].СоздатьДокумент();
			ДокументЗакрытияОбъект.Дата = ТекущаяДата();
			
			Для Каждого ПараметрШапки Из СтруктураСпособЗакрытия.ПараметрыЗаполненияШапки Цикл
				ДокументЗакрытияОбъект[ПараметрШапки.Ключ] = ПараметрШапки.Значение;
			КонецЦикла;
			
		КонецЕсли;   
		
		Для Каждого ДокументСсылка Из МассивДокументов Цикл 			
			
			Если СтруктураСпособЗакрытия.СпособЗакрытия = "ВыполнитьМетодОбъекта" Тогда
				
				ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
				
				ВыражениеДляВыполнения = "ДокументОбъект." + СтруктураСпособЗакрытия.ИмяМетода + "(";
				
				СтруктураПараметров = Новый Структура; 				
				Счетчик = 0;
				Для Каждого Параметр Из СтруктураСпособЗакрытия.ПараметрыМетода Цикл
					
					Счетчик = Счетчик + 1;   					
					СтруктураПараметров.Вставить("Параметр" + Счетчик, Параметр);
					
					ВыражениеДляВыполнения = ВыражениеДляВыполнения + ?(Счетчик = 1, "", ", ") + "СтруктураПараметров.Параметр" + Счетчик;
					
				КонецЦикла;
				
				ВыражениеДляВыполнения = ВыражениеДляВыполнения + ")";
				
				Выполнить(ВыражениеДляВыполнения);
				
				РежимЗаписи = РежимЗаписиДокумента.Проведение;
				
				Если ДокументОбъект.ПометкаУдаления ИЛИ НЕ ДокументОбъект.Проведен  Тогда
					
					РежимЗаписи = РежимЗаписиДокумента.Запись;
					
				КонецЕсли;
				
				ДокументОбъект.Записать(РежимЗаписи);
				
			ИначеЕсли СтруктураСпособЗакрытия.СпособЗакрытия = "СоздатьЗакрытиеЗаказов" Тогда
				
				СтрокаЗакрытиеЗаказов = ДокументЗакрытияОбъект[СтруктураСпособЗакрытия.ИмяТабЧасти].Добавить();
				
				СтрокаЗакрытиеЗаказов[СтруктураСпособЗакрытия.РеквизитТабЧастиДляДокумента] = ДокументСсылка;
				
				Для Каждого ПараметрТабЧасти Из СтруктураСпособЗакрытия.ПараметрыЗаполненияТабЧасти Цикл
					
					СтрокаЗакрытиеЗаказов[ПараметрТабЧасти.Ключ] = ПараметрТабЧасти.Значение;
					
				КонецЦикла;
				
			ИначеЕсли СтруктураСпособЗакрытия.СпособЗакрытия = "ПометитьНаУдаление" Тогда
				
				ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
				
				ДокументОбъект.УстановитьПометкуУдаления(Истина);
				
			КонецЕсли;
			
			СообщениеСсылка = НайтиСообщениеДокумента(ДокументСсылка, "ORDRSP", "Исходящее");
			
			Если ЗначениеЗаполнено(СообщениеСсылка) Тогда
				
				СообщениеОбъект			= СообщениеСсылка.ПолучитьОбъект();
				
				СообщениеОбъект.Статус	= "Закрыт";
				
				СохранитьОбъектСообщения(СообщениеОбъект);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если СтруктураСпособЗакрытия.СпособЗакрытия = "СоздатьЗакрытиеЗаказов" Тогда 
			
			ДокументЗакрытияОбъект.Записать(РежимЗаписиДокумента.Проведение);  
			
		КонецЕсли;  
		
		
		ЗафиксироватьТранзакцию();
		
	Исключение 	
		
		Если ТранзакцияАктивна() Тогда 
			
			ОтменитьТранзакцию();
			
		КонецЕсли;          
		
		ОписаниеОшибки = ОписаниеОшибки();
		
		Сообщить_КонтурEDI(ОписаниеОшибки);
		
	КонецПопытки;

КонецПроцедуры 

Функция ПолучитьДеревоПредыдущихЗаказов(СообщениеСсылка =  Неопределено, Знач ДокументСсылка = Неопределено, Знач ТипСообщения = Неопределено) Экспорт
		
	ДеревоПредыдущихЗаказов = Новый ДеревоЗначений;
	ДобавитьКолонкиВТаблицуЗначений(ДеревоПредыдущихЗаказов, 
	"Вид
	|Ссылка
	|Статус
	|Представление
	|Сумма
	|ТипСообщения
	|Направление
	|Проведен
	|ПометкаУдаления
	|Иконка"); 	
	
	СообщениеORDERS = Неопределено;
	
	Если ТипЗнч(СообщениеСсылка) = Тип("Структура") И СообщениеСсылка.Свойство("ТипСообщения") И СообщениеСсылка.ТипСообщения = "ORDERS" Тогда
		
		СообщениеORDERS = СообщениеСсылка;
		
	ИначеЕсли ТипЗнч(СообщениеСсылка) = Тип("СправочникСсылка.КонтурEDI_Сообщения") И ЗначениеЗаполнено(СообщениеСсылка) Тогда
		
		СообщениеСсылкаORDERS = СообщениеСсылка;
		
	ИначеЕсли ТипЗнч(СообщениеСсылка) = Тип("СправочникОбъект.КонтурEDI_Сообщения") И ЗначениеЗаполнено(СообщениеСсылка.Ссылка) Тогда
		
		СообщениеСсылкаORDERS = СообщениеСсылка.Ссылка;
		
	Иначе
		
		ДокORDERS				= НайтиСвязанныйДокументПоТипуСообщения(ДокументСсылка, "ORDERS");
		СообщениеСсылкаORDERS	= НайтиСообщениеДокумента(ДокORDERS, "ORDERS");
		
	КонецЕсли;
	
	Если СообщениеORDERS = Неопределено И ЗначениеЗаполнено(СообщениеСсылкаORDERS) Тогда
		
		СообщениеORDERS = ПрочитатьСообщение(СообщениеСсылкаORDERS);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СообщениеORDERS) Тогда
		
		Если СообщениеORDERS.Свойство("СписокПредварительныхЗаказов") 
			И ТипЗнч(СообщениеORDERS.СписокПредварительныхЗаказов) = Тип("СписокЗначений") Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	КонтурEDI_Сообщения.Ссылка КАК Ссылка,
			|	КонтурEDI_Сообщения.Документ КАК Документ,
			|	КонтурEDI_Сообщения.ТипСообщения КАК ТипСообщения,
			|	КонтурEDI_Сообщения.Направление КАК Направление,
			|	КонтурEDI_Сообщения.Статус КАК Статус
			|ИЗ
			|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
			|ГДЕ
			|	КонтурEDI_Сообщения.Ссылка В(&СписокПредварительныхЗаказов)";
			
			Запрос.УстановитьПараметр("СписокПредварительныхЗаказов", СообщениеORDERS.СписокПредварительныхЗаказов);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			МассивДокументов = Новый Массив;
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
					ДокументСсылка = ВыборкаДетальныеЗаписи.Документ;
				КонецЕсли;
				
				МассивДокументов.Добавить(ВыборкаДетальныеЗаписи.Документ);
			КонецЦикла;
			
			ВыборкаДетальныеЗаписи.Сбросить();
			
			Если ЗначениеЗаполнено(ДокументСсылка) Тогда
				
				Запрос = Новый Запрос;
				ИменаГруппировок = "";		
				
				Если ЗначениеЗаполнено(СообщениеСсылка) Тогда
					Сообщение = ПрочитатьСообщение(СообщениеСсылка);
					РежимРаботы = ОпределитьКемМыЯвляемся(Сообщение);
				Иначе
					РежимРаботы = ОпределитьКемМыЯвляемсяПоДокументуИзТаблицыТипов(ДокументСсылка, ТипСообщения);
				КонецЕсли;
				
				Запрос.Текст = ПолучитьТекстЗапросаПоСвязаннымДокументам(ДокументСсылка, РежимРаботы, ИменаГруппировок);
								
				Запрос.Текст = Запрос.Текст+Символы.ПС+"ИТОГИ ПО "+ИменаГруппировок;
				
				Запрос.УстановитьПараметр("Ссылка",МассивДокументов);
				
				Если Запрос.Текст = "" Тогда
					//если текст запроса пустой, то и вернем пустоту. Это случай, когда конфигурация нам не известна
					Возврат ДеревоПредыдущихЗаказов;
				КонецЕсли;	
				
				ТаблицаРеализаций = Новый ТаблицаЗначений;
				ТаблицаРеализаций.Колонки.Добавить("Реализация");
				ТаблицаРеализаций.Колонки.Добавить("СтрокаДерева");
				
				ДеревоЗапроса = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				ВывестиСтрокиЗапросаСвязанныхСообщенийРекурсивно(ДеревоЗапроса, ДеревоПредыдущихЗаказов, ИменаГруппировок, 1, ТаблицаРеализаций);
				
			КонецЕсли;
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				Если ДеревоПредыдущихЗаказов.Строки.Найти(ВыборкаДетальныеЗаписи.Ссылка, "Ссылка", Истина) = Неопределено Тогда
					
					НоваяСтрокаСообщения = ДеревоПредыдущихЗаказов.Строки.Добавить();
					
					НоваяСтрокаСообщения.Вид			= "Сообщение";
					НоваяСтрокаСообщения.Представление	= ВыборкаДетальныеЗаписи.ТипСообщения + " ("+ СтрЗаменить(НРег(ВыборкаДетальныеЗаписи.Статус), "_предварительныйзаказ", "")+") - без документа";
					НоваяСтрокаСообщения.ТипСообщения	= ВыборкаДетальныеЗаписи.ТипСообщения;
					НоваяСтрокаСообщения.Направление	= ВыборкаДетальныеЗаписи.Направление;
					НоваяСтрокаСообщения.Ссылка			= ВыборкаДетальныеЗаписи.Ссылка;
					
				КонецЕсли;
				
			КонецЦикла; 
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ДеревоПредыдущихЗаказов;

КонецФункции

Функция ПолучитьПараметрыМетодаУстановитьСтатус()

	СтруктураДополнительныхПараметров = Новый Структура;
	СтруктураДополнительныхПараметров.Вставить("ИмяТабличнойЧасти",            			"Товары");
	
	ПричинаОтменыЗаказов = ПричинаОтменыЗаказов_УФ_УТ();
	
	СтруктураДополнительныхПараметров.Вставить("ПричинаОтмены",                			ПричинаОтменыЗаказов);
	
	СтруктураДополнительныхПараметров.Вставить("ПроверятьОстатки",             			Ложь);
	СтруктураДополнительныхПараметров.Вставить("ОтменитьНеотработанныеСтроки", 			Истина);
	СтруктураДополнительныхПараметров.Вставить("СкорректироватьМерныеТовары",  			Истина);
	СтруктураДополнительныхПараметров.Вставить("СкорректироватьМерныеТоварыПоПриемке", 	Истина);
	СтруктураДополнительныхПараметров.Вставить("СкорректироватьЦены",          			Истина);
	СтруктураДополнительныхПараметров.Вставить("ЗакрыватьЗаказы",              			Истина);
	
	ПараметрыМетода = Новый Массив;
	ПараметрыМетода.Добавить("Закрыт");
	ПараметрыМетода.Добавить(СтруктураДополнительныхПараметров);
	
	Возврат ПараметрыМетода;

КонецФункции 

Функция ПричинаОтменыЗаказов_УФ_УТ()
		
	ПричинаОтменыЗаказов = ПолучитьКонстантуEDI("ПричинаОтменыЗаказов");
	
	Если ПричинаОтменыЗаказов = Неопределено 
		И ПеременнаяСодержитСвойство(Справочники.ПричиныОтменыЗаказовКлиентов, "ОтклонениеПриОтгрузкеМерныхТоваров") Тогда
		
		ПричинаОтменыЗаказов = Справочники.ПричиныОтменыЗаказовКлиентов.ОтклонениеПриОтгрузкеМерныхТоваров;
		
	КонецЕсли;
	
	Возврат ПричинаОтменыЗаказов;

КонецФункции

Функция ПолучитьСписокПредыдущихЗаказов_КонтурEDI(Сообщение)

	СписокПредыдущихЗаказов = Новый СписокЗначений;

	СпособПоискаПредварительныхЗаказов = ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, "СпособПоискаПредварительныхЗаказов");
			
	Если НЕ ЗначениеЗаполнено(СпособПоискаПредварительныхЗаказов) 
		ИЛИ СпособПоискаПредварительныхЗаказов = "Не искать" Тогда 
		
		// не искать
		
	ИначеЕсли СпособПоискаПредварительныхЗаказов = "Номер предварительного заказа передается в основном заказе" Тогда
		
		НомерORDRSP = Неопределено;
		
		Если Сообщение.Свойство("ДополнительнаяИнформация")
			И ПеременнаяСодержитСвойство(Сообщение.ДополнительнаяИнформация, "responseNumber", НомерORDRSP, Истина) Тогда 
			
			НайденныйДокумент = НайтиДокументПоРеквизитамСообщения_КонтурEDI(НомерORDRSP, Неопределено, "ORDRSP", "Исходящее", Сообщение.Партнер, Сообщение.ТочкаДоставки);
			СообщениеORDERS = НайтиСообщениеДокумента(НайденныйДокумент, "ORDERS", "Входящее");
			
			Если ЗначениеЗаполнено(СообщениеORDERS) Тогда
				СписокПредыдущихЗаказов.Добавить(СообщениеORDERS.Ссылка);
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		Если СпособПоискаПредварительныхЗаказов = "Номер предварительного заказа равен номеру основного заказа" Тогда
			
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	КонтурEDI_Сообщения.Ссылка
			|ИЗ
			|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_Сообщения.ДополнительныеРеквизиты КАК КонтурEDI_СообщенияДополнительныеРеквизиты
			|		ПО КонтурEDI_Сообщения.Ссылка = КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка
			|			И (КонтурEDI_СообщенияДополнительныеРеквизиты.ИмяРеквизита = ""ЭтоПредварительныйЗаказ"")
			|			И (КонтурEDI_СообщенияДополнительныеРеквизиты.Значение = ИСТИНА)
			|ГДЕ
			|	КонтурEDI_Сообщения.ТипСообщения = ""ORDERS""
			|	И КонтурEDI_Сообщения.НомерЗаказа = &НомерЗаказа
			|	И НАЧАЛОПЕРИОДА(КонтурEDI_Сообщения.ДатаЗаказа, ГОД) = НАЧАЛОПЕРИОДА(&ДатаЗаказа, ГОД)";
			
		Иначе
			
			Запрос.Текст =
			"ВЫБРАТЬ
			|	КонтурEDI_Сообщения.Ссылка КАК Ссылка,
			|	КонтурEDI_Сообщения.Статус
			|ПОМЕСТИТЬ втПредварительныеЗаказы
			|ИЗ
			|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_Сообщения.ДополнительныеРеквизиты КАК КонтурEDI_СообщенияДополнительныеРеквизиты
			|		ПО КонтурEDI_Сообщения.Ссылка = КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка
			|			И (КонтурEDI_СообщенияДополнительныеРеквизиты.ИмяРеквизита = ""ЭтоПредварительныйЗаказ"")
			|			И (КонтурEDI_СообщенияДополнительныеРеквизиты.Значение = ИСТИНА)
			|ГДЕ
			|	КонтурEDI_Сообщения.ТипСообщения = ""ORDERS""
			|	И НАЧАЛОПЕРИОДА(КонтурEDI_Сообщения.ДатаЗаказа, ДЕНЬ) <= НАЧАЛОПЕРИОДА(&ДатаЗаказа, ДЕНЬ)
			|	И КонтурEDI_Сообщения.Партнер = &Партнер
			|
			|СГРУППИРОВАТЬ ПО
			|	КонтурEDI_Сообщения.Ссылка,
			|	КонтурEDI_Сообщения.Статус
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	втПредварительныеЗаказы.Ссылка
			|ИЗ
			|	втПредварительныеЗаказы КАК втПредварительныеЗаказы
			|ГДЕ
			|	(НЕ втПредварительныеЗаказы.Статус ПОДОБНО ""Закрыт%""
			|			ИЛИ втПредварительныеЗаказы.Ссылка В (&СписокПредварительныхЗаказов))";
			
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ДатаЗаказа", 					Сообщение.ДокументEDI.Дата);
		Запрос.УстановитьПараметр("НомерЗаказа", 					Сообщение.ДокументEDI.Номер);
		Запрос.УстановитьПараметр("Партнер",						Сообщение.Партнер);
		Запрос.УстановитьПараметр("СписокПредварительныхЗаказов",	Сообщение.СписокПредварительныхЗаказов);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			СписокПредыдущихЗаказов.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
		КонецЦикла;    
		
	КонецЕсли;  	
	
	Возврат СписокПредыдущихЗаказов;

КонецФункции 

Функция ПолучитьСпособЗакрытияЗаказов() Экспорт 
	
	Структура = Новый Структура("СпособЗакрытия");
	
	ЗаказЗагружаетсяВРеализацию = Ложь;
	
	Если ИмяКонфигурации1С = "УФ_УТ"
		ИЛИ ИмяКонфигурации1С = "УТ_10_3" 
		ИЛИ ИмяКонфигурации1С = "УТ_10_2" 
		ИЛИ ИмяКонфигурации1С = "КА"
		ИЛИ ИмяКонфигурации1С = "УПП" Тогда
		
		Тип_ORDERS = ПолучитьТипЗначенияОбъекта("ВходящийЗаказПокупателя",,Истина);
		Тип_DESADV = ПолучитьТипЗначенияОбъекта("ИсходящееУведомлениеОбОтгрузке",,Истина);
		
		ЗаказЗагружаетсяВРеализацию = (Тип_ORDERS = Тип_DESADV);

	КонецЕсли;
	
	Если ЗаказЗагружаетсяВРеализацию Тогда      
		
		Структура.СпособЗакрытия = "ПометитьНаУдаление";   
		
	ИначеЕсли ИмяКонфигурации1С = "УФ_УТ" 
		И ПолучитьФункциональнуюОпцию_КонтурEDI("ИспользоватьРасширенныеВозможностиЗаказаКлиента") = Истина Тогда
			
		Структура.СпособЗакрытия = "ВыполнитьМетодОбъекта";
		
		Структура.Вставить("ИмяМетода", "УстановитьСтатус");
		
		ПараметрыМетода = ПолучитьПараметрыМетодаУстановитьСтатус();
		
		Структура.Вставить("ПараметрыМетода", ПараметрыМетода);
		
	ИначеЕсли ИмяКонфигурации1С = "УТ_10_3" 
		ИЛИ ИмяКонфигурации1С = "УТ_10_2" 
		ИЛИ ИмяКонфигурации1С = "КА"
		ИЛИ ИмяКонфигурации1С = "УПП" Тогда
		
		Структура.СпособЗакрытия = "СоздатьЗакрытиеЗаказов";
		
		Структура.Вставить("ТипДокумента", 					"ЗакрытиеЗаказовПокупателей");
		
		ПараметрыЗаполненияШапки = Новый Структура;
		ПараметрыЗаполненияШапки.Вставить("ВидОперации", 	Перечисления.ВидыОперацийЗакрытиеЗаказовПокупателей.ЗакрытиеЗаказов);
		ПараметрыЗаполненияШапки.Вставить("Комментарий", 	"Закрытие предварительного заказа EDI");
		
		Структура.Вставить("ПараметрыЗаполненияШапки", 		ПараметрыЗаполненияШапки);
				
		Структура.Вставить("ИмяТабЧасти", 					"Заказы");
		Структура.Вставить("РеквизитТабЧастиДляДокумента", 	"ЗаказПокупателя");
		
		ПараметрыЗаполненияТабЧасти = Новый Структура;
		ПараметрыЗаполненияТабЧасти.Вставить("ПричинаЗакрытияЗаказа", Справочники.ПричиныЗакрытияЗаказов.ПустаяСсылка());
		
		Структура.Вставить("ПараметрыЗаполненияТабЧасти", 	ПараметрыЗаполненияТабЧасти);
		
	Иначе
		
		Структура.СпособЗакрытия = "ПометитьНаУдаление";
		
	КонецЕсли;
	
	Возврат Структура;

КонецФункции 

Функция ПолучитьСпособКорректировкиЗаказа() Экспорт 
	
	Структура = Новый Структура("СпособКорректировки");
	
	Если ИмяКонфигурации1С = "УТ_10_3" ИЛИ ИмяКонфигурации1С = "УТ_10_2" ИЛИ ИмяКонфигурации1С = "КА" Тогда
		
		Структура.СпособКорректировки = "СоздатьКорректировкуЗаказа";
		
		Структура.Вставить("ТипДокумента", 					"КорректировкаЗаказаПокупателя");
		
		ПараметрыЗаполненияШапки = Новый Структура;
		ПараметрыЗаполненияШапки.Вставить("Комментарий", 	"Корректировка предварительного заказа EDI");
		
		Структура.Вставить("ПараметрыЗаполненияШапки", 		ПараметрыЗаполненияШапки);
				
		Структура.Вставить("ИмяТабЧасти", 					"Товары");
		
	КонецЕсли;
	
	Возврат Структура;

КонецФункции 

Процедура ОбработатьСписокПредварительныхЗаказов(СписокПредварительныхЗаказов, ОсновнойЗаказСсылка)

	Попытка   		
		
		НачатьТранзакцию();		
				
		Для Каждого ЭлементСписка Из СписокПредварительныхЗаказов Цикл
			
			СообщениеОбъект = ЭлементСписка.Значение.ПолучитьОбъект();
						
			СообщениеОбъект.Статус	= "Закрыт_ПредварительныйЗаказ";
			
			СтруктураСообщения = ПрочитатьСообщение(СообщениеОбъект.Ссылка);
			СтруктураСообщения.Вставить("ОсновнойЗаказДляПредварительных", ОсновнойЗаказСсылка);
			
			СохранитьОбъектСообщения(СообщениеОбъект, СтруктураСообщения); 
					
		КонецЦикла;
		
		ЗафиксироватьТранзакцию(); 	
		
	Исключение 
		
		Сообщить(ОписаниеОшибки());
		
		ОтменитьТранзакцию();
		
	КонецПопытки;  

КонецПроцедуры

Процедура ПривязатьДокументыПредварительныхЗаказыКОсновномуЗаказу_КонтурEDI(СписокПредварительныхЗаказов, ОсновнойЗаказСообщение)
	
	Документ = Неопределено;
	
	Если ЗначениеЗаполнено(СписокПредварительныхЗаказов)Тогда
		
		Документ = СписокПредварительныхЗаказов[0].Значение.Документ;
		
	КонецЕсли;
	
	Если Документ <> Неопределено Тогда
		
		ОсновнойЗаказСообщение.Документ1С = Документ;
		ОсновнойЗаказСообщение.ДокументСсылка = Документ;
		
		СообщениеОбъект = ОсновнойЗаказСообщение.СообщениеСсылка.ПолучитьОбъект();
		
		СообщениеОбъект.Документ = Документ;
		СообщениеОбъект.Статус = "Загружен";
		СообщениеОбъект.Архив = Истина;											
		СообщениеОбъект.ТребуемоеДействие = "РаботаЗавершена";
		
		СохранитьОбъектСообщения(СообщениеОбъект, ОсновнойЗаказСообщение);
		
	КонецЕсли;
	
	Для Каждого ЭлементСписка Из СписокПредварительныхЗаказов Цикл
		
		// ... ORDERS 
		СообщениеОбъект = ЭлементСписка.Значение.ПолучитьОбъект();
		
		СообщениеОбъект.ТипСообщения = "#ORDERS";				
		СообщениеОбъект.Статус	= "Закрыт_ПредварительныйЗаказ";
				
		СохранитьОбъектСообщения(СообщениеОбъект); 
		
		// ... ORDRSP
		Если ЗначениеЗаполнено(СообщениеОбъект.Документ) Тогда
			
			СообщениеORDRSP = НайтиСообщениеДокумента(СообщениеОбъект.Документ, "ORDRSP", "Исходящее");
			
			Если ЗначениеЗаполнено(СообщениеORDRSP) Тогда
				
				СообщениеORDRSPОбъект			= СообщениеORDRSP.ПолучитьОбъект();
				СообщениеORDRSPОбъект.Статус	= "Доставлен";
				
				СтруктураСообщенияORDRSP = СообщениеORDRSPОбъект.Хранилище.Получить();
				СтруктураСообщенияORDRSP.ЭтоПредварительныйЗаказ = Ложь;
				
				СохранитьОбъектСообщения(СообщениеORDRSPОбъект, СтруктураСообщенияORDRSP);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

// #КонецОбласти //Предварительные_заказы

// #Область Работа_с_SSCC_кодами

// Используется для маркировки транспортных упаковок SSCC кодами и описанием состава 
//	Параметры:
//		ТранспортныеУпаковки - ДеревоЗначений - Дерево транспортных упаковок структуры сообщения, которые нужно промаркировать
//		Организация - СправочникСсылка - Организация, в разрезе которой ведется сквозной учет кодов SSCC
//		Сообщение - Структура - Структура сообщения, в котором маркируются транспортные упаковки
//
Процедура ПромаркироватьУпаковкиКодомSSCC(ТранспортныеУпаковки, Знач Организация, Знач Сообщение) Экспорт
	
	// на будущее: когда появятся вложения - тогда здесь рекурсивно проваливаться вниз
	ПараметрыКодаSSCC = ПолучитьПараметрыКодаSSCC();
	
	СтандартнаяОбработкаEDI = Истина;
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("ТранспортныеУпаковки", ТранспортныеУпаковки);
	ПараметрыПМ.Вставить("Организация", Организация);
	ПараметрыПМ.Вставить("Сообщение", Сообщение);
	ПараметрыПМ.Вставить("ПараметрыКодаSSCC", ПараметрыКодаSSCC);
	
	ОбработкаСобытияПодключаемогоМодуля("ПередМаркировкойУпаковокКодомSSCC", СтандартнаяОбработкаEDI, ПараметрыПМ);
	
	Если СтандартнаяОбработкаEDI = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		Если Не Метаданные.РежимУправленияБлокировкойДанных = Метаданные.СвойстваОбъектов.РежимУправленияБлокировкойДанныхПоУмолчанию.Автоматический
			И Не Метаданные.РежимУправленияБлокировкойДанных = Метаданные.СвойстваОбъектов.РежимУправленияБлокировкойДанныхПоУмолчанию.АвтоматическийИУправляемый Тогда
			БлокировкаДанных = Новый БлокировкаДанных;
			ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.КонтурEDI_ДополнительныеРеквизиты");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.УстановитьЗначение("Объект", Организация);
			ЭлементБлокировки.УстановитьЗначение("Свойство", "ПоследнийSSCCКод");
			БлокировкаДанных.Заблокировать();
		КонецЕсли;
		
		СвойстваОбъекта = Новый Массив;
		СвойстваОбъекта.Добавить("ПоследнийSSCCКод");
		СвойстваОбъекта.Добавить("НомерПоследнейУпаковкиSSCC");
		СвойстваОбъекта.Добавить("GLN_Организации");
		
		СписокСвойствEDI = ПолучитьСписокСвойствEDI(СвойстваОбъекта, Организация);
		
		ПоследнийSSCCКод = СписокСвойствEDI.ПоследнийSSCCКод;
		ИдентификаторКомпании = СписокСвойствEDI.GLN_Организации;
		НомерПоследнейУпаковки = СписокСвойствEDI.НомерПоследнейУпаковкиSSCC;
		
		Если НЕ ЗначениеЗаполнено(НомерПоследнейУпаковки) Тогда
			НомерПоследнейУпаковки = ПорядковыйНомерУпаковкиSSCC(ПоследнийSSCCКод, ПараметрыКодаSSCC);
		КонецЕсли;
		
		НужноСдвинутьСчетчикУпаковокSSCC = Ложь;
		
		Для Каждого Строка Из ТранспортныеУпаковки.Строки Цикл
			
			// маркируем только строки упаковок, в которых не заполнен SSCC код
			Если Не ЗначениеЗаполнено(Строка.ТипУпаковки) ИЛИ ЗначениеЗаполнено(Строка.SSCC) Тогда  
				Продолжить;
			КонецЕсли;
			
			НужноСдвинутьСчетчикУпаковокSSCC = Истина;
			
			НомерПоследнейУпаковки = НомерПоследнейУпаковки + 1;
			ПроверитьСчетчикУпаковкиSSCC(НомерПоследнейУпаковки, ПараметрыКодаSSCC);
			ПоследнийSSCCКод = СгенерироватьSSCC(ИдентификаторКомпании, НомерПоследнейУпаковки, ПараметрыКодаSSCC);
			
			ШаблонСоставаУпаковки = "%1 №%2 (%3)"; 
			// делаем -1 - поскольку в формате имеется корневой узел, начинаем нумеровать упаковки с 2-ки
			ПорядковыйНомерУпаковкиСтрока = Строка(Строка.НомерУпаковки - 1);
			НаименованиеУпаковки = НаименованиеУпаковкиSSCC(Строка.ТипУпаковки);
			
			СоставУпаковки = ПодставитьПараметрыВСтроку_КонтурEDI(ШаблонСоставаУпаковки, 
				НаименованиеУпаковки, ПорядковыйНомерУпаковкиСтрока, ПоследнийSSCCКод);  
			
			Строка.SSCC = ПоследнийSSCCКод;
			Строка.СоставУпаковки = СоставУпаковки;
			
		КонецЦикла;
		
		Если НужноСдвинутьСчетчикУпаковокSSCC = Истина Тогда
			СдвинутьСчетчикУпаковокSSCC(ПоследнийSSCCКод, НомерПоследнейУпаковки, Организация);
		КонецЕсли;
		
		Если ТранзакцияАктивна() Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	
	Исключение
		
		Если ТранзакцияАктивна() Тогда
	        ОтменитьТранзакцию();
		КонецЕсли;
		
		ТекстОшибки = "Не удалось промаркировать транспортные упаковки SSCC кодами - " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);
		ВызватьИсключение ТекстОшибки;
	
	КонецПопытки;
	
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("ТранспортныеУпаковки", ТранспортныеУпаковки);
	ПараметрыПМ.Вставить("Организация", Организация);
	ПараметрыПМ.Вставить("Сообщение", Сообщение);
	ПараметрыПМ.Вставить("ПараметрыКодаSSCC", ПараметрыКодаSSCC);
	
	ОбработкаСобытияПодключаемогоМодуля("ПослеМаркировкиУпаковокКодомSSCC", , ПараметрыПМ);
	
КонецПроцедуры

// Возвращает человекопонятное наименование кода упаковки
// 	Параметры:
//		КодТипа - Строка - Код упаковки SSCC по классификатору
//
Функция НаименованиеУпаковкиSSCC(КодТипа)
	
	ТипыТранспортныхУпаковок = ТипыТранспортныхУпаковок_КонтурEDI();   	
	
	КодУпаковки = "Код" + КодТипа;
	
	СвойстваУпаковки = Неопределено;
		
	Если ТипыТранспортныхУпаковок.Свойство(КодУпаковки, СвойстваУпаковки) Тогда
		НаименованиеУпаковки = СокрЛП(СтрЗаменить(СвойстваУпаковки.Наименование, "(" + КодТипа + ")", ""));
	ИначеЕсли КодТипа = "CS" Тогда
		НаименованиеУпаковки = "Коробка";
	Иначе
		НаименованиеУпаковки = "Упаковка";
	КонецЕсли;
	
	Возврат НаименованиеУпаковки;
	
КонецФункции

// Возвращает заполненную структуру параметров, описывающих код SSCC
//
Функция ПолучитьПараметрыКодаSSCC() Экспорт
	
	ПараметрыКода = НовыйПараметрыКодаSSCC();
	
	ЗаполнитьСтандартныеПараметрыКодаSSCC(ПараметрыКода);
	РассчитатьПараметрыКодаSSCC(ПараметрыКода);	
	
	Возврат ПараметрыКода; 
	
КонецФункции

// Возвращает новую структуру параметров, описывающих код SSCC
//
Функция НовыйПараметрыКодаSSCC()
	
	ПараметрыКода = Новый Структура;
	
	// стандартные
	ПараметрыКода.Вставить("ЦифраРасширения");
	ПараметрыКода.Вставить("ДлинаКода");
	ПараметрыКода.Вставить("ДлинаЦифрыРасширения");
	ПараметрыКода.Вставить("ДлинаКонтрольногоЧисла");
	ПараметрыКода.Вставить("ДлинаПрефиксаКомпании");
	
	// рассчитываемые
	ПараметрыКода.Вставить("НачалоНомераУпаковки");
	ПараметрыКода.Вставить("ДлинаНомераУпаковки");
	ПараметрыКода.Вставить("МаксимальныйНомерУпаковки");
	
	Возврат ПараметрыКода;
	
КонецФункции

// Определяем длину префикса компании для генерации кода SSCC
//		РезервнаяСхемаSSCC - Булево - Используется ли резервная схема формирования кода SSCC, 
//										при которой используется больше знаков идентификатора компании, 
//										но число номеров SSCC в общем пуле при этом сильно сокращается.
//
Функция ПолучитьДлинуПрефиксаКомпанииДляКодаSSCC()
	
	ДлинаПрефиксаКомпании = 9;
	РезервнаяСхемаSSCC = (ПолучитьКонстантуEDI("РезервнаяСхемаSSCC") = Истина);
	
	Если РезервнаяСхемаSSCC = Истина Тогда
		ДлинаПрефиксаКомпании = 12;
	КонецЕсли;
	
	Возврат ДлинаПрефиксаКомпании;
	
КонецФункции

// Заполняет структуру пареметров кода SSCC стандартными значениями 
// 	Параметры:
//		ПараметрыКода - Структура - Набор параметров, влияющих на структуру итогового номера
//
Процедура ЗаполнитьСтандартныеПараметрыКодаSSCC(ПараметрыКода)
	
	ПараметрыКода.ЦифраРасширения 			= 1;
	ПараметрыКода.ДлинаКода 				= 18;
	ПараметрыКода.ДлинаЦифрыРасширения 		= 1;
	ПараметрыКода.ДлинаКонтрольногоЧисла 	= 1;
	ПараметрыКода.ДлинаПрефиксаКомпании 	= ПолучитьДлинуПрефиксаКомпанииДляКодаSSCC();
	
КонецПроцедуры

// Рассчитывает в структуре пареметров кода SSCC зависимые значения 
// 	Параметры:
//		ПараметрыКода - Структура - Набор параметров, влияющих на структуру итогового номера
//
Процедура РассчитатьПараметрыКодаSSCC(ПараметрыКода) Экспорт
	
	СмещениеНаОдинСимвол = 1;
	НачалоНомераУпаковки = ПараметрыКода.ДлинаЦифрыРасширения + ПараметрыКода.ДлинаПрефиксаКомпании + СмещениеНаОдинСимвол;
	ДлинаНомераУпаковки = ПараметрыКода.ДлинаКода - 
		ПараметрыКода.ДлинаЦифрыРасширения - ПараметрыКода.ДлинаПрефиксаКомпании - ПараметрыКода.ДлинаКонтрольногоЧисла;
	
	МаксимальныйНомерУпаковкиСтрока = "";
	СимволДевять = "9"; 
	ДобавитьСимволыВСтроку_КонтурEDI(МаксимальныйНомерУпаковкиСтрока, СимволДевять, ДлинаНомераУпаковки);
	МаксимальныйНомерУпаковки = Число(МаксимальныйНомерУпаковкиСтрока);
	
	ПараметрыКода.НачалоНомераУпаковки = НачалоНомераУпаковки;
	ПараметрыКода.ДлинаНомераУпаковки = ДлинаНомераУпаковки;
	ПараметрыКода.МаксимальныйНомерУпаковки = МаксимальныйНомерУпаковки;
	
КонецПроцедуры

// Получает порядковый номер упаковки из кода SSCC
//		Параметры:
//			SSCCКод - Строка - Код SSCC, из которого необходимо выделить порядковый номер упаковки
//			ПараметрыКодаSSCC - Структура - Набор параметров, влияющих на структуру итогового номера
//
Функция ПорядковыйНомерУпаковкиSSCC(КодSSCC, ПараметрыКодаSSCC)
	
	НомерПоследнейУпаковки = 0;
	
	Если ТипЗнч(КодSSCC) = Тип("Строка")
		И СтрДлина(КодSSCC) = ПараметрыКодаSSCC.ДлинаКода Тогда
		
		НомерПоследнейУпаковки = Число(Сред(КодSSCC, ПараметрыКодаSSCC.НачалоНомераУпаковки, ПараметрыКодаSSCC.ДлинаНомераУпаковки));
		
	КонецЕсли;
	
	ПроверитьСчетчикУпаковкиSSCC(НомерПоследнейУпаковки, ПараметрыКодаSSCC);
		
	Возврат НомерПоследнейУпаковки;
	
КонецФункции

// Проверяет, что номер текущего кода находится в пределах пула кодов SSCC.
// И если номер вышел за предела пула, то нумерация сбрасывается.
//		Параметры:
//			НомерУпаковки - Число - Порядковый номер упаковки
//			ПараметрыКодаSSCC - Структура - Набор параметров, влияющих на структуру итогового номера
//
Процедура ПроверитьСчетчикУпаковкиSSCC(НомерУпаковки, ПараметрыКодаSSCC)
	
	Если НомерУпаковки > ПараметрыКодаSSCC.МаксимальныйНомерУпаковки Тогда
		
		НомерУпаковки = 1;
		
	КонецЕсли;
	
КонецПроцедуры

// Позволяет сформировать код SSCC по шаблону:
// 	[ЦифраРасширения][ПрефиксКомпании][НомерУпаковки][КонтрольноеЧисло]
//		Параметры:
//			ИдентификаторКомпании - Строка - Обычно используется GLN компании
//			НомерУпаковки - Число - Порядковый номер упаковки
//			ПараметрыКодаSSCC - Структура - Набор параметров, влияющих на структуру итогового номера
//
Функция СгенерироватьSSCC(ИдентификаторКомпании, НомерУпаковки, ПараметрыКодаSSCC) Экспорт
	
	ЦифраРасширенияСтрока = Строка(ПараметрыКодаSSCC.ЦифраРасширения);
	ПрефиксКомпании = Лев(ИдентификаторКомпании, ПараметрыКодаSSCC.ДлинаПрефиксаКомпании);
	НомерУпаковкиСтрока = Формат(НомерУпаковки, "ЧГ=");
	
	ДобавитьСНачала = Истина;
	СимволНоль = "0";
	ДобавитьСимволыВСтроку_КонтурEDI(НомерУпаковкиСтрока, СимволНоль, ПараметрыКодаSSCC.ДлинаНомераУпаковки, ДобавитьСНачала);	
	
	КодSSCCСтрока = ЦифраРасширенияСтрока + ПрефиксКомпании + НомерУпаковкиСтрока;
	
	КонтрольноеЧисло = РассчитатьКонтрольноеЧислоКодаSSCC(КодSSCCСтрока);
	КонтрольноеЧислоСтрока = Строка(КонтрольноеЧисло);
	
	ПолныйКодSSCC = КодSSCCСтрока + КонтрольноеЧислоСтрока;
	
	Возврат ПолныйКодSSCC;	
	
КонецФункции

// Позволяет добавить произвольные символы в строку с начала или с конца
//	Параметры:
//		Строка - Строка - Срока, в которую необходимо добавить символы
//		КонечнаяДлинаСтроки - Число - Итоговое количество символов в строке
//		ДобавитьСНачала - Булево - Направление, в котором необходимо добавить символы (с начала или с конца строки)
//
Процедура ДобавитьСимволыВСтроку_КонтурEDI(Строка, Символ, КонечнаяДлинаСтроки, ДобавитьСНачала = Истина) Экспорт
	
	Если ТипЗнч(Строка) <> Тип("Строка") Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяДлина = СтрДлина(Строка);
	КоличествоСимволов = КонечнаяДлинаСтроки - ТекущаяДлина;
	
	Если КоличествоСимволов <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для К = 1 По КоличествоСимволов Цикл
		
		Если ДобавитьСНачала Тогда
			Строка = Символ + Строка;
		Иначе
			Строка = Строка + Символ;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Рассчитывает контрольное число для кода SSCC
// 	Параметры:
//		КодSSCC - Строка - Сформированная часть кода без контрольного числа
//
Функция РассчитатьКонтрольноеЧислоКодаSSCC(Знач КодSSCC)
	
	СуммаЧетных = 0;
	СуммаНечетных = 0;
	
	ЧастьКода = КодSSCC;
	ДлинаКода = СтрДлина(ЧастьКода);
	
	Для Позиция = 1 По ДлинаКода Цикл
		
		ЧислоФрагмента = Число(Прав(ЧастьКода, 1));
		ЧастьКода = Лев(ЧастьКода, ДлинаКода - Позиция);
		
		Если Позиция % 2 = 0 Тогда
			СуммаЧетных = СуммаЧетных + ЧислоФрагмента;
		Иначе	
			СуммаНечетных = СуммаНечетных + ЧислоФрагмента;
		КонецЕсли;
		
	КонецЦикла;
	
	КонтрольнаяСумма = Строка(СуммаНечетных * 3 + СуммаЧетных);
	ЦифраЕдиницКонтрольнойСуммы = Число(Прав(КонтрольнаяСумма, 1));
	
	Если ЦифраЕдиницКонтрольнойСуммы = 0 Тогда
		КонтрольныйРазряд = 0;
	Иначе
		КонтрольныйРазряд = 10 - ЦифраЕдиницКонтрольнойСуммы;
	КонецЕсли;
	
	Возврат КонтрольныйРазряд;
	
КонецФункции

// Устанавливает для организации последний SSCC код и номер упаковки
// 	Параметры:
//		КодSSCC - Строка - Сформированный код SSCC
//		НомерУпаковки - Число - Порядковый номер упаковки
//		Организация - СправочникСсылка - Организация, в разрезе которой ведется сквозной учет кодов SSCC
//
Процедура СдвинутьСчетчикУпаковокSSCC(КодSSCC, НомерУпаковки, Организация)
	
	УстановитьЗначениеСвойстваОбъекта(Организация, "ПоследнийSSCCКод", КодSSCC);
	УстановитьЗначениеСвойстваОбъекта(Организация, "НомерПоследнейУпаковкиSSCC", НомерУпаковки);
	
КонецПроцедуры

// Проверяет формат и корректность SSCC кода относительно всех транспортных упаковок
//	Параметры:
//		КодSSCC - Строка - Сформированный код SSCC
//		ТранспортныеУпаковки - ДеревоЗначений - Дерево транспортных упаковок структуры сообщения
//		ПараметрыКодаSSCC - Структура - Набор параметров, влияющих на структуру итогового номера
//
Функция ВалидироватьКодSSCC(КодSSCC, ТранспортныеУпаковки, ПараметрыКодаSSCC) Экспорт
	
	ДобавитьТаблицуОшибок = Ложь;
	Результат = ИнициализироватьСтруктуруРезультатаФункции(ДобавитьТаблицуОшибок);
	Результат.Успешно = Истина;
	
	ДлинаКода = СтрДлина(КодSSCC);
	
	Если ДлинаКода <> ПараметрыКодаSSCC.ДлинаКода Тогда
		
		ТекстОшибки = "Длина кода SSCC - " + Строка(ДлинаКода) + 
			" не соответствует формату - " + Строка(ПараметрыКодаSSCC.ДлинаКода) + " символов";
		Результат.ОписаниеОшибки = ТекстОшибки;
		Результат.Успешно = Ложь;
		Возврат Результат;
		
	КонецЕсли;
	
	НомерУпаковки = ПорядковыйНомерУпаковкиSSCC(КодSSCC, ПараметрыКодаSSCC);
	КонтрольноеЧислоСтрока = Прав(КодSSCC, ПараметрыКодаSSCC.ДлинаКонтрольногоЧисла);
	КодSSCCБезКонтрольногоЧисла = Лев(КодSSCC, ПараметрыКодаSSCC.ДлинаКода - ПараметрыКодаSSCC.ДлинаКонтрольногоЧисла);
	РасчетноеКонтрольноеЧисло = РассчитатьКонтрольноеЧислоКодаSSCC(КодSSCCБезКонтрольногоЧисла);
	РасчетноеКонтрольноеЧислоСтрока = Строка(РасчетноеКонтрольноеЧисло);
	
	Если КонтрольноеЧислоСтрока <> РасчетноеКонтрольноеЧислоСтрока Тогда
		       		
		ТекстОшибки = "Код SSCC " + КодSSCC + " не прошел проверку." + Символы.ПС + 
			"Контрольный разряд кода SSCC (" + КонтрольноеЧислоСтрока + ") не совпадает " +
			"с расчетным числом (" + РасчетноеКонтрольноеЧислоСтрока + ").";
		Результат.ОписаниеОшибки = ТекстОшибки;
		Результат.Успешно = Ложь;
		Возврат Результат;
		
	КонецЕсли;
	
	ВключатьПодчиненные = Истина;
	НайденнаяСтрока = ТранспортныеУпаковки.Строки.Найти(КодSSCC, "SSCC", ВключатьПодчиненные);
	
	Если НайденнаяСтрока <> Неопределено Тогда
		
		ТекстОшибки = "Код SSCC - " + КодSSCC + " уже используется в текущей отгрузке";
		Результат.ОписаниеОшибки = ТекстОшибки;
		Результат.Успешно = Ложь;
		Возврат Результат;
		
	КонецЕсли;
	
	Возврат Результат;	
	
КонецФункции

// #КонецОбласти //Работа_с_SSCC_кодами

// #Область ТипыДанных

// Создает объект ОписаниеТипов, содержащий тип Строка.
//
// Параметры:
//  ДлинаСтроки - Число - длина строки.
//
// Возвращаемое значение:
//  ОписаниеТипов - описание типа Строка.
//
Функция ОписаниеТипаСтрока_КонтурEDI(ДлинаСтроки = 0, ОграничениеДлины = Неопределено) Экспорт
	
	Если ДлинаСтроки = 0 Тогда
		
		КС = Неопределено;
		
	Иначе
		
		Если ОграничениеДлины = Неопределено Тогда
			ОграничениеДлины = ДопустимаяДлина.Переменная;
		КонецЕсли;
		
		КС = Новый КвалификаторыСтроки(ДлинаСтроки, ОграничениеДлины);
		
	КонецЕсли;
	
	Возврат Новый ОписаниеТипов("Строка", , КС);
	
КонецФункции

// Создает объект ОписаниеТипов, содержащий тип Число.
//
// Параметры:
//  Разрядность - Число - общее количество разрядов числа (количество разрядов
//                        целой части плюс количество разрядов дробной части).
//  РазрядностьДробнойЧасти - Число - число разрядов дробной части.
//  ЗнакЧисла - ДопустимыйЗнак - допустимый знак числа.
//
// Возвращаемое значение:
//  ОписаниеТипов - описание типа Число.
//
Функция ОписаниеТипаЧисло_КонтурEDI(Разрядность = 0, РазрядностьДробнойЧасти = 0, Знач ЗнакЧисла = Неопределено) Экспорт
	
	Если Разрядность = 0 Тогда
		
		КЧ = Неопределено;
		
	Иначе
		
		Если ЗнакЧисла = Неопределено Тогда 
			ЗнакЧисла = ДопустимыйЗнак.Любой;
		КонецЕсли;
		
		КЧ = Новый КвалификаторыЧисла(Разрядность, РазрядностьДробнойЧасти, ЗнакЧисла);
		
	КонецЕсли;	
		
	Возврат Новый ОписаниеТипов("Число", КЧ);
	
КонецФункции

// Создает объект ОписаниеТипов, содержащий тип Дата.
//
// Параметры:
//  ЧастиДаты - ЧастиДаты - набор вариантов использования значений типа Дата.
//
// Возвращаемое значение:
//  ОписаниеТипов - описание типа Дата.
//
Функция ОписаниеТипаДата_КонтурEDI(ЧастиДаты = Неопределено) Экспорт
	
	Если ЧастиДаты = Неопределено Тогда
		
		КД = Неопределено;
		
	Иначе
		
		КД = Новый КвалификаторыДаты(ЧастиДаты);
	
	КонецЕсли;
	
	Возврат Новый ОписаниеТипов("Дата", , , КД);
	
КонецФункции

