Функция ОперацииОбмена_КоличествоПотоковДляОперацииАвтоматическиПриниматьСообщения()
	
	КоличествоПотоковДляПриемкиСообщений = ПолучитьКонстантуEDI("КоличествоПотоковДляПриемкиСообщений");
	
	Если ТипЗнч(КоличествоПотоковДляПриемкиСообщений) <> Тип("Число") Тогда
		
		Попытка
			КоличествоПотоковДляПриемкиСообщений = Число(КоличествоПотоковДляПриемкиСообщений);	
		Исключение
			КоличествоПотоковДляПриемкиСообщений = Неопределено;
		КонецПопытки;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(КоличествоПотоковДляПриемкиСообщений) Тогда
		КоличествоПотоковДляПриемкиСообщений = 1;
	КонецЕсли;
	
	Возврат КоличествоПотоковДляПриемкиСообщений;
	
КонецФункции

Функция ОперацииОбмена_СообщенияПринятьАвтоматически(КоличествоПотоковНаТипСообщения)
	
	СообщенияПринятьАвтоматически = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка КАК Ссылка,
	|	КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка.ТипСообщения КАК ТипСообщения,
	|	КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка.Партнер КАК Партнер
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения.ДополнительныеРеквизиты КАК КонтурEDI_СообщенияДополнительныеРеквизиты
	|ГДЕ
	|	КонтурEDI_СообщенияДополнительныеРеквизиты.ИмяРеквизита = ""ПринятьАвтоматически""
	|	И КонтурEDI_СообщенияДополнительныеРеквизиты.Значение = ИСТИНА
	|	И КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка.ТипСообщения В(&ТипСообщения)
	|
	|СГРУППИРОВАТЬ ПО
	|	КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка,
	|	КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка.ТипСообщения,
	|	КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка.Партнер
	|
	|УПОРЯДОЧИТЬ ПО
	|	КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка.ДатаЗагрузки
	|ИТОГИ ПО
	|	ТипСообщения";
	
	Запрос.УстановитьПараметр("ТипСообщения", МассивТиповСообщенийКоторыеМожемОбработать());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаТипСообщения = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаТипСообщения.Следующий() Цикл
		
		ТипСообщения = ВыборкаТипСообщения.ТипСообщения;
		
		СообщенияПоТипуСообщения = СообщенияПринятьАвтоматически[ТипСообщения];
		Если СообщенияПоТипуСообщения = Неопределено Тогда
			СообщенияПоТипуСообщения = Новый Соответствие;
		КонецЕсли;
		
		ВыборкаДетальныеЗаписи = ВыборкаТипСообщения.Выбрать();
		
		КоличествоВПотоке = Цел(ВыборкаДетальныеЗаписи.Количество()/КоличествоПотоковНаТипСообщения);
		
		НомерПотока = 1;
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			СообщениеВПотоке = СообщенияПоТипуСообщения[НомерПотока];
			Если СообщениеВПотоке = Неопределено Тогда
				СообщениеВПотоке = Новый Массив;
			КонецЕсли;
			
			СообщениеВПотоке.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
			
			СообщенияПоТипуСообщения[НомерПотока] = СообщениеВПотоке;
			
			Если КоличествоВПотоке < СообщениеВПотоке.Количество() Тогда
				НомерПотока = НомерПотока + 1;
			КонецЕсли;
			
		КонецЦикла;
		
		СообщенияПринятьАвтоматически[ТипСообщения] = СообщенияПоТипуСообщения;
		
	КонецЦикла;
	
	Возврат СообщенияПринятьАвтоматически;
	
КонецФункции

