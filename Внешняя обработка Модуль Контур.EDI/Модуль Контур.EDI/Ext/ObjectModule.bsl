Функция ПолучитьИнформациюОбУстановленныхРасширениях()
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	СписокСвойствТаблицы = "Наименование,Идентификатор,ВерсияРасширения,Использование,Измененное,Ссылка";
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаРезультат, СписокСвойствТаблицы);	
	
	ЕстьМетаданныеХраненияРасширений = ПроверитьНаличиеМетаданныхХраненияРасширений();
	Если НЕ ЕстьМетаданныеХраненияРасширений Тогда
		Возврат ТаблицаРезультат;
	КонецЕсли;
	
	Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_ДополнительныеСправочники.Наименование КАК Наименование,
	|	ДопРеквизит_Идентификатор.Значение КАК Идентификатор,
	|	ДопРеквизит_ВерсияРасширения.Значение КАК ВерсияРасширения,
	|	ДопРеквизит_Использование.Значение КАК Использование,
	|	ЕСТЬNULL(ДопРеквизит_Измененное.Значение, НЕОПРЕДЕЛЕНО) КАК Измененное,
	|	КонтурEDI_ДополнительныеСправочники.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК ДопРеквизит_Идентификатор
	|		ПО КонтурEDI_ДополнительныеСправочники.Ссылка = ДопРеквизит_Идентификатор.Ссылка
	|			И (ДопРеквизит_Идентификатор.ИмяРеквизита = ""Идентификатор"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК ДопРеквизит_ВерсияРасширения
	|		ПО КонтурEDI_ДополнительныеСправочники.Ссылка = ДопРеквизит_ВерсияРасширения.Ссылка
	|			И (ДопРеквизит_ВерсияРасширения.ИмяРеквизита = ""ВерсияРасширения"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК ДопРеквизит_Использование
	|		ПО КонтурEDI_ДополнительныеСправочники.Ссылка = ДопРеквизит_Использование.Ссылка
	|			И (ДопРеквизит_Использование.ИмяРеквизита = ""Использование"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК ДопРеквизит_Измененное
	|		ПО КонтурEDI_ДополнительныеСправочники.Ссылка = ДопРеквизит_Измененное.Ссылка
	|			И (ДопРеквизит_Измененное.ИмяРеквизита = ""Измененное"")
	|ГДЕ
	|	КонтурEDI_ДополнительныеСправочники.ИмяСправочника = ""Расширения""
	|	И НЕ КонтурEDI_ДополнительныеСправочники.ПометкаУдаления";
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаРезультат;	
	
КонецФункции // ПолучитьИнформациюОбУстановленныхРасширениях()

