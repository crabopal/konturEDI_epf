Функция Метрика_СформироватьИнформациюОбОрганизацияхEDI()
	
	Массив = Новый Массив;
	
	НашиОрганизацииEDI = ПолучитьСписокЭлементовСправочника("НашиОрганизации");
	ТабОрганизаций = НашиОрганизацииEDI.Скопировать(, "Ссылка,GLN,partyId,УчетнаяЗапись,Неактивная");
	Метрика_ДополнитьИнформациюОбОрганизацияхEDI_ИННКПП(ТабОрганизаций);
   	Массив = ТаблицаЗначенийВМассив_КонтурEDI(ТабОрганизаций);
	
	Для каждого Организация Из Массив Цикл
		ТранспортныеЯщикиEDI = ПолучитьСписокЭлементовСправочника("ТранспортныеЯщики", Организация.Ссылка);
		ТабЯщиков = ТранспортныеЯщикиEDI.Скопировать(, "lastEventId,id,НеАктивный,Тестовый,GLNЯщика");
		МассивЯщиков = ТаблицаЗначенийВМассив_КонтурEDI(ТабЯщиков);
		Организация.Вставить("ТранспортныеЯщики", МассивЯщиков);	
	КонецЦикла;

	Возврат Массив;
	
КонецФункции // Метрика_СформироватьИнформациюОбОрганизацияхEDI()

