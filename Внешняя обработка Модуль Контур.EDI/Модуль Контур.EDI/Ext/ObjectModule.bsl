	ДобавитьНастройкуВДерево(ДанныеДерева, "ОжиданиеСтатуса_CheckingOk_ORDRSP_Предварительный", "Ожидать статус MessageCheckingOk после отправки ORDRSP по предварительному заказу", , "Прочие настройки", "Поставщик", "Булево", Ложь, "Ожидать статус MessageCheckingOk после отправки ORDRSP по предварительному заказу");
	ДобавитьНастройкуВДерево(ДанныеДерева, "ОжиданиеСтатуса_CheckingOk_ORDRSP", "Ожидать статус MessageCheckingOk после отправки ORDRSP по основному заказу", , "Прочие настройки", "Поставщик", "Булево", Ложь, "Ожидать статус MessageCheckingOk после отправки ORDRSP по основному заказу");
	ДобавитьНастройкуВДерево(ДанныеДерева, "СпособПередачиМашиночитаемойДоверенности", "Способ передачи машиночитаемой доверенности", , "Прочие настройки",, СписокСпособПередачиМашиночитаемойДоверенности(), "Метаинформацией", "Способ передачи машиночитаемой доверенности");
	
	
КонецПроцедуры

Процедура ЗаполнитьДеревоНастроекМеркурий(ДанныеДерева)
	
	Если ИспользуетсяМеркурий = Истина Тогда
		МакетНастроек = МодульМеркурий().ПолучитьМакет("НастройкиПараметры");
		ИмяОбластиНастроек = "НастройкиМеркурий";
		ЗаполнитьДеревоНастроекПоМакету(ДанныеДерева, МакетНастроек, ИмяОбластиНастроек);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДеревоНастроекПоМакету(ДанныеДерева, МакетНастроек, ИмяОбластиНастроек = Неопределено)
	
	Если ЗначениеЗаполнено(ИмяОбластиНастроек) Тогда
		ОбластьНастроек = МакетНастроек.ПолучитьОбласть(ИмяОбластиНастроек);
	Иначе
		ОбластьНастроек = МакетНастроек;
	КонецЕсли;
		
	Для Сч = 1 По ОбластьНастроек.ВысотаТаблицы Цикл
				
		Идентификатор				=	ПолучитьТекстЯчейкиОбласти(ОбластьНастроек, Сч, 1);
		
		Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда 
			Продолжить;
		КонецЕсли;
		
		Представление				=	ПолучитьТекстЯчейкиОбласти(ОбластьНастроек, Сч, 2);
		ЭтоГруппаСтрока				=	ПолучитьТекстЯчейкиОбласти(ОбластьНастроек, Сч, 3);
		ЭтоГруппа = Ложь;
		
		Если ЗначениеЗаполнено(ЭтоГруппаСтрока) Тогда
			Попытка
				ЭтоГруппа = Булево(ЭтоГруппаСтрока);	
			Исключение
				Сообщить("Не корректно запонено значение в колонке ЭтоГруппа у настройки " + Идентификатор);
				Продолжить;
			КонецПопытки;
		КонецЕсли;
		
		Родитель					=	ПолучитьТекстЯчейкиОбласти(ОбластьНастроек, Сч, 4);
		Тип_						=	ПолучитьТекстЯчейкиОбласти(ОбластьНастроек, Сч, 5);
		ЗначениеПоУмолчанию			=	ПолучитьТекстЯчейкиОбласти(ОбластьНастроек, Сч, 7);
		Подсказка					=	ПолучитьТекстЯчейкиОбласти(ОбластьНастроек, Сч, 8);
		
		Если Лев(Тип_,7) = "_Список" Тогда
			Тип_ = ПолучитьСписокЗначенийИзМакета(ОбластьНастроек, Тип_);
		КонецЕсли;
		
		ДобавитьНастройкуВДерево(ДанныеДерева, Идентификатор, Представление, ЭтоГруппа, Родитель,, Тип_, ЗначениеПоУмолчанию, Подсказка);
		
	КонецЦикла;
	
КонецПроцедуры 

Процедура ПодготовитьНастройкиПартнера_КонтурEDI(ДеревоНастроек, СтруктураПолейПартнера) Экспорт

	ДобавитьСтрокиДереваВСтруктуру(ДеревоНастроек, СтруктураПолейПартнера);

	// отправка invoic
	Если СтруктураПолейПартнера.Свойство("INVOICДоОбработкиRECADV") И СтруктураПолейПартнера.INVOICДоОбработкиRECADV = Ложь Тогда   		
		СтруктураПолейПартнера.Вставить("ОтправлятьINVOICсDESADV", Ложь); 
	КонецЕсли;	
	
КонецПроцедуры 

Функция ПолучитьТаблицуНаправленийСообщений()
	
	ТаблицаНаправленийСообщений = ЭДО_Кэш_Прочитать("ТаблицаНаправленийСообщений");
	
	Если ТаблицаНаправленийСообщений = Неопределено Тогда
	
		Исходящее = "Исходящее";
		Входящее = "Входящее"; 
		ЛюбоеНаправление = "Любое";
		
		Поставщик = "Поставщик";
		ТорговаяСеть = "Покупатель";
		
		ОписаниеТипаСтрока = ОписаниеТипаСтрока_КонтурEDI(32,ДопустимаяДлина.Переменная);
		ОписаниеТипаБулево = Новый ОписаниеТипов("Булево");
		
		ТаблицаНаправленийСообщений = Новый ТаблицаЗначений;                      
		ТаблицаНаправленийСообщений.Колонки.Добавить("РежимРаботы", ОписаниеТипаСтрока);
		ТаблицаНаправленийСообщений.Колонки.Добавить("ТипСообщения", ОписаниеТипаСтрока);
		ТаблицаНаправленийСообщений.Колонки.Добавить("Направление", ОписаниеТипаСтрока);
		ТаблицаНаправленийСообщений.Колонки.Добавить("ЭтоНезависимоеСообщение", ОписаниеТипаБулево);
		
		//Сообщения цепочки
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,Поставщик,"PORDERS",Исходящее);
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,Поставщик,"ORDERS",Входящее);
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,Поставщик,"ORDRSP",Исходящее);
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,Поставщик,"DESADV",Исходящее);
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,Поставщик,"RECADV",Входящее);
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,Поставщик,"INVOIC",Исходящее);
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,Поставщик,"COINVOIC",Исходящее);
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,Поставщик,"RETANN",Входящее);
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,Поставщик,"RETINS",Исходящее);
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,Поставщик,"RETDES",Входящее);
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,Поставщик,"RETREC",Исходящее); 
		
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,ТорговаяСеть,"PORDERS",Входящее);
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,ТорговаяСеть,"ORDERS",Исходящее);
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,ТорговаяСеть,"ORDRSP",Входящее);
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,ТорговаяСеть,"DESADV",Входящее);
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,ТорговаяСеть,"RECADV",Исходящее);
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,ТорговаяСеть,"INVOIC",Входящее);
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,ТорговаяСеть,"COINVOIC",Входящее);
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,ТорговаяСеть,"RETANN",Исходящее);
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,ТорговаяСеть,"RETINS",Входящее);
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,ТорговаяСеть,"RETDES",Исходящее);
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,ТорговаяСеть,"RETREC",Входящее);
		
		//Независимые сообщения
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,Поставщик,"SLSRPT",Входящее,Истина);    
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,Поставщик,"ALCRPT",Исходящее,Истина);
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,Поставщик,"PRICELIST",Исходящее,Истина);     
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,Поставщик,"IFTMBF",Входящее,Истина);     
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,Поставщик,"IFTMBC",Исходящее,Истина);     
		
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,ТорговаяСеть,"SLSRPT",Исходящее,Истина);    
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,ТорговаяСеть,"ALCRPT",Входящее,Истина);
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,ТорговаяСеть,"PRICELIST",Входящее,Истина);     
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,ТорговаяСеть,"IFTMBF",Исходящее,Истина);     
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,ТорговаяСеть,"IFTMBC",Входящее,Истина);     

		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,Поставщик,"INVRPT",ЛюбоеНаправление,Истина);
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,Поставщик,"DELFOR",ЛюбоеНаправление,Истина);
		
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,ТорговаяСеть,"INVRPT",ЛюбоеНаправление,Истина);
		ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений,ТорговаяСеть,"DELFOR",ЛюбоеНаправление,Истина);
		
		ЭДО_Кэш_Поместить("ТаблицаНаправленийСообщений", ТаблицаНаправленийСообщений);
        
	КонецЕсли;
	
   	Возврат ТаблицаНаправленийСообщений;
	
КонецФункции

Процедура ДобавитьСтрокуТаблицыНаправленийСообщений(ТаблицаНаправленийСообщений, РежимРаботы, ТипСообщения, Направление, ЭтоНезависимоеСообщение = Ложь)

	НоваяСтрока = ТаблицаНаправленийСообщений.Добавить();
	НоваяСтрока.РежимРаботы = РежимРаботы;
	НоваяСтрока.ТипСообщения = ТипСообщения;
	НоваяСтрока.Направление = Направление;
	НоваяСтрока.ЭтоНезависимоеСообщение = ЭтоНезависимоеСообщение;
	
КонецПроцедуры

Функция ПолучитьТаблицуИдентификаторовНастроекСообщений() 

	ИдентификаторыНастроек = ЭДО_Кэш_Прочитать("ИдентификаторыНастроекСообщений");
	
	Если ИдентификаторыНастроек = Неопределено Тогда
		
		ОписаниеТипаСтрока = ОписаниеТипаСтрока_КонтурEDI(128,ДопустимаяДлина.Переменная);
		
		ИдентификаторыНастроек = Новый ТаблицаЗначений;
		ИдентификаторыНастроек.Колонки.Добавить("РежимРаботы", ОписаниеТипаСтрока);
		ИдентификаторыНастроек.Колонки.Добавить("ТипСообщения", ОписаниеТипаСтрока);
		ИдентификаторыНастроек.Колонки.Добавить("ИдентификаторНастройки", ОписаниеТипаСтрока);
		
		ТаблицаНаправленийСообщений = ПолучитьТаблицуНаправленийСообщений();
		
		Для каждого СтрокаНаправления Из ТаблицаНаправленийСообщений Цикл
			
			Если СтрокаНаправления.ЭтоНезависимоеСообщение Тогда
				Продолжить;
			КонецЕсли;
			
			ДобавитьИдентификаторНастройкиСообщения(ИдентификаторыНастроек,
													СтрокаНаправления.РежимРаботы,
													СтрокаНаправления.ТипСообщения,
													СтрокаНаправления.ТипСообщения + "_" + СтрокаНаправления.Направление); 
			
		КонецЦикла;
	
		ЭДО_Кэш_Поместить("ИдентификаторыНастроекСообщений", ИдентификаторыНастроек);
		
	КонецЕсли;
	
	Возврат ИдентификаторыНастроек;
	
КонецФункции

Процедура ДобавитьИдентификаторНастройкиСообщения(ТаблицаИдентификаторов, РежимРаботы, ТипСообщения, ИдентификаторНастройки)

	НоваяСтрока = ТаблицаИдентификаторов.Добавить();
	НоваяСтрока.РежимРаботы = РежимРаботы;
	НоваяСтрока.ТипСообщения = ТипСообщения;
	НоваяСтрока.ИдентификаторНастройки = ИдентификаторНастройки;
	
КонецПроцедуры

Функция ПолучитьСтруктуруИдентификаторовНастроекСообщений()
	
	ИдентификаторыНастроек = ЭДО_Кэш_Прочитать("ИдентификаторыНастроекСообщенийСтруктурой");
	
	Если ИдентификаторыНастроек = Неопределено Тогда
	
		ИдентификаторыНастроек = Новый Структура;
		ИдентификаторыНастроек.Вставить("Поставщик", Новый Структура);
		ИдентификаторыНастроек.Вставить("Покупатель", Новый Структура);

		Для каждого Строка Из ПолучитьТаблицуИдентификаторовНастроекСообщений() Цикл 
			Если Строка.РежимРаботы = "Поставщик" Тогда
				ИдентификаторыНастроек.Поставщик.Вставить(Строка.ТипСообщения, Строка.ИдентификаторНастройки);
			Иначе
				ИдентификаторыНастроек.Покупатель.Вставить(Строка.ТипСообщения, Строка.ИдентификаторНастройки);
			КонецЕсли;
		КонецЦикла;
		
		ЭДО_Кэш_Поместить("ИдентификаторыНастроекСообщенийСтруктурой",ИдентификаторыНастроек);
		
	КонецЕсли;
	
	Возврат ИдентификаторыНастроек;
	
КонецФункции

Функция ТипыОсновныхСообщенийЦепочки()
	
	ТипыСообщений = Новый Массив;
	
	ТаблицаНаправленийСообщений = ПолучитьТаблицуНаправленийСообщений();
	
	Для каждого СтрокаНаправления Из ТаблицаНаправленийСообщений Цикл
		
		Если СтрокаНаправления.ЭтоНезависимоеСообщение Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипыСообщений.Найти(СтрокаНаправления.ТипСообщения) = Неопределено Тогда
			ТипыСообщений.Добавить(СтрокаНаправления.ТипСообщения);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТипыСообщений;
	
КонецФункции

// Функция - Возвращает список установленных значений настроек партнеров.
//
// Параметры:
//  Партнеры - Массив, СправочникСсылка.КонтурEDI_ДополнительныеСправочники	- партнеры, по которым необходимо собрать настройки. При незаполненном значении будут собраны настройки всех партнеров.
//  GLNКакКлюч - Булево - Истина - ключом возвращаемого соответствия будет GLN партнера, Ложь - ключом будет ссылка на элемент справочника партнеров
//
// Возвращаемое значение:
//  Соответствие - Ключ - либо ссылка на элемент справочника партнеров, либо GLN (зависит от флага ДляМетрик). Значение - структура настроек, в которой Ключ - Идентификатор настройки, Значение - установленная настройка
//
Функция ПолучитьЗначенияНастроекПартнеров(Партнеры = Неопределено, GLNКакКлюч = Ложь) Экспорт
	                                                                 
	Если Партнеры = Неопределено Тогда
		Партнеры = ПолучитьСписокЭлементовСправочника("Партнеры").ВыгрузитьКолонку("Ссылка");
	КонецЕсли;
	
	Настройки = ПолучитьМассивДополнительныхНастроек("Партнеры");

	Если GLNКакКлюч И Настройки.Найти("GLN_Партнера") = Неопределено Тогда
		Настройки.Добавить("GLN_Партнера");
	КонецЕсли;
	
	СкрытыеНастройкиПартнеров = Новый Структура;
	
	ДобавитьСкрытыеНастройки(СкрытыеНастройкиПартнеров, "Партнеры");
	
	Для Каждого СкрытаяНастройка Из СкрытыеНастройкиПартнеров Цикл
		
		ИдентификаторНастройки = СкрытаяНастройка.Ключ;
		
		Если НЕ Настройки.Найти(ИдентификаторНастройки) = Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		
		Настройки.Добавить(ИдентификаторНастройки);
		
	КонецЦикла;
	
	НастройкиПартнеров = ПолучитьЗначенияСвойствОбъектовEDI(Настройки, Партнеры);
	
	Если GLNКакКлюч Тогда
		ПерезаполненноеСоответствие = Новый Соответствие;
		Для каждого ЭлементНастройки Из НастройкиПартнеров Цикл
			GLN = ЭлементНастройки.Значение.GLN_Партнера;
			ПерезаполненноеСоответствие.Вставить(GLN, ЭлементНастройки.Значение);
		КонецЦикла;
		НастройкиПартнеров = ПерезаполненноеСоответствие;
	КонецЕсли;
	
	Возврат НастройкиПартнеров;
	
КонецФункции

//рекурсивная процедура, обслуживающая СоздатьДеревоНастроек
Процедура ДобавитьСтрокиДереваВСтруктуру(СтрокаДерева,СтруктураПолейПартнера) Экспорт
	
	//блок для совместимости с 8.1
	ЭтоДанныеДерева = Ложь;
	Попытка
		Выполнить("ЭтоДанныеДерева = (ТипЗнч(Строкадерева) = Тип(""ДанныеФормыДерево"") или ТипЗнч(Строкадерева) = Тип(""ДанныеФормыЭлементДерева""))");
	Исключение
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Информация, "Не удалось определить тип данных для дерева - " + ОписаниеОшибки());	
	КонецПопытки;	
	
	Если ЭтоДанныеДерева Тогда
		Для Каждого Стр Из СтрокаДерева.ПолучитьЭлементы() Цикл
			ДобавитьСтрокиДереваВСтруктуру(Стр,СтруктураПолейПартнера);//обойдем рекурсивно все вложенные строки
			Если Не Стр.ЭтоГруппа Тогда
				СтруктураПолейПартнера.Вставить(Стр.НастройкаИД,Стр.Значение);
			КонецЕсли;	
		КонецЦикла;	
	Иначе 
		
		Для Каждого Стр Из СтрокаДерева.Строки Цикл
			ДобавитьСтрокиДереваВСтруктуру(Стр,СтруктураПолейПартнера);//обойдем рекурсивно все вложенные строки
			Если Не Стр.ЭтоГруппа Тогда
				СтруктураПолейПартнера.Вставить(Стр.НастройкаИД,Стр.Значение);
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры	

Процедура ЗаполнитьКастомныеНастройки(ДанныеДерева, ВидНастроек)
	
	ТабличныйДокументНастроек = Новый ТабличныйДокумент;
	
	Если ВнешнийМодуль <> Неопределено И ВнешнийМодуль.Метаданные().Макеты.Найти("НастройкиПараметры") <> Неопределено Тогда
		ДопНастройкиПартнераМакет = ВнешнийМодуль.ПолучитьМакет("НастройкиПараметры");
		ОбластьНастроекПМ = ДопНастройкиПартнераМакет.ПолучитьОбласть("НастройкиПартнеров");
		ТабличныйДокументНастроек.Присоединить(ОбластьНастроекПМ);
	КонецЕсли;

    ОбработкаСобытияПодключаемогоМодуля("ДобавитьКастомныеНастройкиПартнера",, Новый Структура("ВидСправочника, ИсходныйТабДокНастроекДляДобавления", ВидНастроек, ТабличныйДокументНастроек));
	ОбработкаСобытияПодключаемогоМодуля("ДобавитьКастомныеНастройкиПартнераНовый",, Новый Структура("ВидНастроек, ДанныеДерева", ВидНастроек, ДанныеДерева));
	
	ЗаполнитьДеревоНастроекПоМакету(ДанныеДерева, ТабличныйДокументНастроек);

КонецПроцедуры

Процедура ЗаполнитьНастройкиОсобенностейСообщений(ДанныеДерева)
	
	Если ОсобенностиСообщений = Неопределено Тогда
		ИнициализироватьТаблицуОсобенностейСообщений();
	КонецЕсли;
	
	Для Каждого ОсобенностьСообщения Из ОсобенностиСообщений Цикл
		Если ОсобенностьСообщения.ДобавитьНастройкуПартнера Тогда	
			ОбластьОсобенностей = Новый ТабличныйДокумент;
			Идентификатор = Строка(ОсобенностьСообщения.Идентификатор);
			Представление = Строка(ОсобенностьСообщения.Наименование);
			Подсказка =	"Настройка от особенности: " + ОсобенностьСообщения.Наименование + Символы.ПС + ОсобенностьСообщения.ПодробноеОписание;
			
			ДобавитьНастройкуВДерево(ДанныеДерева,Идентификатор, Представление,, "Прочие настройки",, "Булево", Ложь, Подсказка);				
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьМассивНастроекИзДереваРекурсивно(СтрокаДерева, МассивНастроек)
	
	Если ТипЗнч(СтрокаДерева) = Тип("ДеревоЗначений") Или СтрокаДерева.ЭтоГруппа Тогда
		Для Каждого ПодчиненнаяСтрока Из СтрокаДерева.Строки Цикл
			ЗаполнитьМассивНастроекИзДереваРекурсивно(ПодчиненнаяСтрока, МассивНастроек);	
		КонецЦикла;	
	Иначе
		МассивНастроек.Добавить(СтрокаДерева.НастройкаИД);	
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьМассивДополнительныхНастроек(ВидНастроек) Экспорт
	
	ДеревоНастроек = ПолучитьДеревоНастроек(ВидНастроек, Новый Структура);
	
	МассивНастроек = Новый Массив;
	ЗаполнитьМассивНастроекИзДереваРекурсивно(ДеревоНастроек, МассивНастроек);
		
	Возврат МассивНастроек;
	
КонецФункции

//Оставлено для совместимости
Функция ПолучитьМассивДополнительныхНастроекИзМакета(ВидНастроек) Экспорт
	
	Возврат ПолучитьМассивДополнительныхНастроек(ВидНастроек);
	
КонецФункции

Процедура ЗаполнитьСтруктуруНастроекИзДереваРекурсивно(СтрокаДерева, СтруктураНастроек)
	
	Если ТипЗнч(СтрокаДерева) = Тип("ДеревоЗначений") Или СтрокаДерева.ЭтоГруппа Тогда
		Для Каждого ПодчиненнаяСтрока Из СтрокаДерева.Строки Цикл
			ЗаполнитьСтруктуруНастроекИзДереваРекурсивно(ПодчиненнаяСтрока, СтруктураНастроек);	
		КонецЦикла;	
	Иначе
		СтруктураНастроек.Вставить(СтрокаДерева.НастройкаИД, СтрокаДерева.Значение);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСтруктуруДополнительныхНастроек(ВидНастроек) Экспорт
	
	ДеревоНастроек = ПолучитьДеревоНастроек(ВидНастроек, Новый Структура);

	СтруктураНастроек = Новый Структура;
	ЗаполнитьСтруктуруНастроекИзДереваРекурсивно(ДеревоНастроек, СтруктураНастроек);
		
	Возврат СтруктураНастроек;
	
КонецФункции

Функция ПолучитьДеревоНастроек(ВидНастроек, СтруктураСвойствДереваНастроек)
	
	ДеревоНастроек = Новый ДеревоЗначений;
	ДобавитьКолонкиВТаблицуЗначений(ДеревоНастроек, "ЭтоГруппа,НастройкаИД,НастройкаНаименование,Подсказка,ОписаниеТипа,Список,Значение");
	СоздатьДеревоНастроек(ДеревоНастроек, ВидНастроек, СтруктураСвойствДереваНастроек);
	
	Возврат ДеревоНастроек;

КонецФункции

Функция ПолучитьТаблицуСчетовФактурНаПодписание(МассивСообщений) Экспорт
	
	Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище); 
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_Сообщения.Ссылка КАК Ссылка,
	|	КонтурEDI_Сообщения.Документ КАК Документ,
	|	КонтурEDI_Сообщения.Организация КАК Организация
	|ПОМЕСТИТЬ ВТ_СообщенияГотовыеКПодписи
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|ГДЕ
	|	КонтурEDI_Сообщения.Ссылка В(&Сообщения)
	|	И КонтурEDI_Сообщения.ТребуемоеДействие = ""ПодписатьВДиадок""
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СообщенияГотовыеКПодписи.Ссылка КАК Ссылка,
	|	ВТ_СообщенияГотовыеКПодписи.Документ КАК Документ,
	|	ВТ_СообщенияГотовыеКПодписи.Организация КАК Организация,
	|	ВЫРАЗИТЬ(ИД_Документов_boxId.Значение КАК СТРОКА(36)) КАК boxId,
	|	ВЫРАЗИТЬ(ИД_Документов_messageId.Значение КАК СТРОКА(36)) КАК messageId,
	|	ВЫРАЗИТЬ(ИД_Документов_invoiceId.Значение КАК СТРОКА(36)) КАК invoiceId,
	|	ВЫРАЗИТЬ(ИД_Документов_torg12Id.Значение КАК СТРОКА(36)) КАК torg12Id,
	|	ВЫРАЗИТЬ(ИД_Документов_UTDId.Значение КАК СТРОКА(36)) КАК UniversalTransferDocumentId
	|ИЗ
	|	ВТ_СообщенияГотовыеКПодписи КАК ВТ_СообщенияГотовыеКПодписи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК ИД_Документов_boxId
	|		ПО ВТ_СообщенияГотовыеКПодписи.Документ = ИД_Документов_boxId.Объект
	|			И (ИД_Документов_boxId.Свойство = ""boxId"")
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК ИД_Документов_messageId
	|		ПО ВТ_СообщенияГотовыеКПодписи.Документ = ИД_Документов_messageId.Объект
	|			И (ИД_Документов_messageId.Свойство = ""messageId"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК ИД_Документов_torg12Id
	|		ПО ВТ_СообщенияГотовыеКПодписи.Документ = ИД_Документов_torg12Id.Объект
	|			И (ИД_Документов_torg12Id.Свойство = ""torg12Id"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК ИД_Документов_invoiceId
	|		ПО ВТ_СообщенияГотовыеКПодписи.Документ = ИД_Документов_invoiceId.Объект
	|			И (ИД_Документов_invoiceId.Свойство = ""invoiceId"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК ИД_Документов_UTDId
	|		ПО ВТ_СообщенияГотовыеКПодписи.Документ = ИД_Документов_UTDId.Объект
	|			И (ИД_Документов_UTDId.Свойство = ""UniversalTransferDocumentId"")";
	
	Запрос.УстановитьПараметр("Сообщения",МассивСообщений);
	
	Таб = Запрос.Выполнить().Выгрузить();
	
	//теперь заполним строковые представления документов
	ЗапросПредставленияДокументов = Новый Запрос(
	"ВЫБРАТЬ
	|	_Таб.Ссылка,
	|	_Таб.Документ,
	|	_Таб.Организация,
	|	_Таб.boxId,
	|	_Таб.messageId,
	|	_Таб.UniversalTransferDocumentId,
	|	_Таб.torg12Id,
	|	_Таб.invoiceId
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&Таб КАК _Таб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Ссылка,
	|	ВТ.Организация КАК Организация,
	|	ВТ.Документ КАК Документ,
	|	ВТ.boxId,
	|	ВТ.messageId,
	|	ВТ.UniversalTransferDocumentId,
	|	ВТ.torg12Id,
	|	ВТ.invoiceId,
	|	ВЫБОР
	|		КОГДА ВТ.Документ ЕСТЬ NULL 
	|			ТОГДА """"
	|		КОГДА ВТ.Документ = НЕОПРЕДЕЛЕНО
	|			ТОГДА """"
	|		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(ВТ.Документ)
	|	КОНЕЦ КАК ДокументПредставление
	|ИЗ
	|	ВТ КАК ВТ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организация"
	);
	ЗапросПредставленияДокументов.УстановитьПараметр("Таб",Таб);
	ТабСПредставлениями = ЗапросПредставленияДокументов.Выполнить().Выгрузить();
	//теперь надо заполнить представления документов
	
	Возврат ТабСПредставлениями;
	
КонецФункции

Функция ПроверитьОтсутствиеДублейВходящегоСообщения(ID)
	
	Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КонтурEDI_Сообщения.Ссылка
	               |ИЗ
	               |	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	               |ГДЕ
	               |	КонтурEDI_Сообщения.ID = &ID
	               |
	               |ДЛЯ ИЗМЕНЕНИЯ";
	
	Запрос.УстановитьПараметр("ID",ID);
	
	Если Запрос.Выполнить().Выбрать().Количество() = 1 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьДоговорКонтрагентаДляСообщения(Сообщение,КтоМы) Экспорт
	
	//В документах, создаваемых по входящим документам, необходимо проставить какой-либо договор.
	//По умолчанию мы ищем первый подходящий по условиям: контрагент, организация, вид договора.
	//Затем в форме сообщения позволяем пользователю его выбрать.
	//После создания документа сохраняем выбор кользователя в записи с полем "ИмяРеквизита" = "GUIDДоговораПоУмолчанию" для данного контрагента.
	//Если существует какая-то особая логика определения договора (например, в зависимости от товара, от GLN точки доставки, от поля ContractIdentificator), 
	//	то можно воспользоваться событием "ПолучитьДоговорКонтрагентаДляСообщения" в подключаемом модуле.
	
	СтандартнаяОбработкаEDI = Истина;
	Договор = ОбработкаСобытияПодключаемогоМодуля("ПолучитьДоговорКонтрагентаДляСообщения",СтандартнаяОбработкаEDI,Новый Структура("Сообщение,КтоМы",Сообщение,КтоМы));
	Если Не СтандартнаяОбработкаEDI Тогда
		Возврат Договор;
	КонецЕсли;
	
	Если ИмяКонфигурации1С = "Розница" ИЛИ ИмяКонфигурации1С =  "УФ_Розница" Тогда//в Рознице нет договоров
		Возврат Неопределено;
	КонецЕсли;
	
	//1. Определим параметры для запроса
	Если ЗначениеЗаполнено(Сообщение.Покупатель1С) Тогда
		
		GUIDДоговора = ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Покупатель1С, "GUIDДоговораПоУмолчанию");
		
		Если ЗначениеЗаполнено(GUIDДоговора) Тогда
			
			GUID = Новый УникальныйИдентификатор(GUIDДоговора);
			Договор = Справочники[ПолучитьТипЗначенияОбъекта("Договор",,Истина)].ПолучитьСсылку(GUID);
			
			Если ЗначениеЗаполнено(Договор) И СсылкаСуществуетИДоступна_КонтурEDI(Договор) Тогда
				
				ИмяРеквизитаОрганизация = ?(ИмяКонфигурации1С = "ДалионУМ" ИЛИ ИмяКонфигурации1С = "АСТОР", "Фирма", "Организация");
				
				РеквизитыДоговора = Новый Структура;
				РеквизитыДоговора.Вставить(ИмяРеквизитаОрганизация);
				РеквизитыДоговора.Вставить("Контрагент");
				РеквизитыДоговора.Вставить("Владелец");
				
				ЗаполнитьЗначенияСвойств(РеквизитыДоговора, Договор);
				
				Если РеквизитыДоговора[ИмяРеквизитаОрганизация] = Сообщение.Продавец1С
					И (РеквизитыДоговора.Владелец = Сообщение.Покупатель1С ИЛИ РеквизитыДоговора.Контрагент = Сообщение.Покупатель1С) Тогда
					
					Возврат Договор;
				
				Иначе
					
					Договор = Неопределено;

				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Договор) Тогда//договор удалось "вспомнить" на предыдущем шаге
		Возврат Договор;
	КонецЕсли;
	
	//Если вспоминалка не отработала, то пытаемся вызвать какие-то типовые варианты заполнения.
	Если Не ЗначениеЗаполнено(Сообщение.Продавец1С)
		Или Не ЗначениеЗаполнено(Сообщение.Покупатель1С)	Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	//2. Поищем нужный договор запросом
	
	Запрос = Новый Запрос;
	
	Если ИмяКонфигурации1С = "ТКПТ" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДоговорыКонтрагентов.Ссылка,
		|	ВЫБОР
		|		КОГДА ДоговорыКонтрагентов.Владелец.ОсновнойДоговорВзаиморасчетов = ДоговорыКонтрагентов.Ссылка
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Порядок
		|ИЗ
		|	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.Организация = &Организация
		|	И ДоговорыКонтрагентов.Владелец = &Владелец
		|	И ДоговорыКонтрагентов.ВидДоговора = &ВидДоговора
		|   И НЕ ДоговорыКонтрагентов.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок УБЫВ";
		
	ИначеЕсли ИмяКонфигурации1С = "АСТОР" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Договоры.Ссылка
		|ИЗ
		|	Справочник.Договоры КАК Договоры
		|ГДЕ
		|	Договоры.Фирма = &Организация
		|	И Договоры.Владелец = &Владелец
		|	И Договоры.ВидДоговора = &ВидДоговора
		|   И НЕ Договоры.ПометкаУдаления";
		
	ИначеЕсли ИмяКонфигурации1С = "ШтрихМ_РС" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Договоры.Ссылка
		|ИЗ
		|	Справочник.ДоговорыВзаиморасчетов КАК Договоры
		|ГДЕ
		|	Договоры.Фирма = &Организация
		|	И Договоры.Владелец = &Владелец
		|	И Договоры.ВидДоговораБУ = &ВидДоговора
		|   И НЕ Договоры.ПометкаУдаления";
		
	ИначеЕсли ИмяКонфигурации1С = "ДалионУМ" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Договоры.Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК Договоры
		|ГДЕ
		|	Договоры.Фирма = &Организация
		|	И Договоры.Владелец = &Владелец
		|	И Договоры.ВидДоговора = &ВидДоговора
		|   И НЕ Договоры.ПометкаУдаления";
		
	ИначеЕсли ИмяКонфигурации1С = "ДалионТРЕНД" ИЛИ ИмяКонфигурации1С = "УФ_ДалионТРЕНД" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Договоры.Ссылка
		|ИЗ
		|	Справочник.Договоры КАК Договоры
		|ГДЕ
		|	Договоры.Организация = &Организация
		|	И Договоры.Владелец = &Владелец
		|	И Договоры.ВидДоговора = &ВидДоговора
		|   И НЕ Договоры.ПометкаУдаления";

		
	ИначеЕсли ИмяКонфигурации1С = "УФ_УТ" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Договоры.Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК Договоры
		|ГДЕ
		|	Договоры.Организация = &Организация
		|	И Договоры.Контрагент = &Владелец
		|	И Договоры.ТипДоговора = &ВидДоговора
		|   И НЕ Договоры.ПометкаУдаления";
		
	ИначеЕсли ИмяКонфигурации1С = "УФ_УНФ" Тогда
		
		Если ЕстьНеобходимыеМетаданные("Справочники.Контрагенты.Реквизиты.ДоговорПоУмолчанию") Тогда
			ЕстьДоговорПоУмолчанию_Часть1=",
			|	ВЫБОР
			|		КОГДА ДоговорыКонтрагентов.Владелец.ДоговорПоУмолчанию = ДоговорыКонтрагентов.Ссылка
			|			ТОГДА 1
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК Порядок";
			ЕстьДоговорПоУмолчанию_Часть2="
			|УПОРЯДОЧИТЬ ПО
			|	Порядок УБЫВ";
		Иначе
			ЕстьДоговорПоУмолчанию_Часть1="";
			ЕстьДоговорПоУмолчанию_Часть2="";
		КонецЕсли;
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДоговорыКонтрагентов.Ссылка"+ЕстьДоговорПоУмолчанию_Часть1+"
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.Организация = &Организация
		|	И ДоговорыКонтрагентов.Владелец = &Владелец
		|	И ДоговорыКонтрагентов.ВидДоговора = &ВидДоговора
		|   И НЕ ДоговорыКонтрагентов.ПометкаУдаления
		|"+ЕстьДоговорПоУмолчанию_Часть2;


				
	ИначеЕсли ИмяКонфигурации1С = "УФ_БП" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДоговорыКонтрагентов.Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.Организация = &Организация
		|	И ДоговорыКонтрагентов.Владелец = &Владелец
		|	И ДоговорыКонтрагентов.ВидДоговора = &ВидДоговора
		|   И НЕ ДоговорыКонтрагентов.ПометкаУдаления";
		
	Иначе
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДоговорыКонтрагентов.Ссылка,
		|	ВЫБОР
		|		КОГДА ДоговорыКонтрагентов.Владелец.ОсновнойДоговорКонтрагента = ДоговорыКонтрагентов.Ссылка
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Порядок
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.Организация = &Организация
		|	И ДоговорыКонтрагентов.Владелец = &Владелец
		|	И ДоговорыКонтрагентов.ВидДоговора = &ВидДоговора
		|   И НЕ ДоговорыКонтрагентов.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок УБЫВ";
		
	КонецЕсли;
	
	//определим ВидДоговора для запроса
	Если ИмяКонфигурации1С="УФ_УТ" Тогда
		
		Если НЕ ЕстьНеобходимыеМетаданные("Перечисления.ТипыДоговоров",Истина) Тогда
			Возврат Неопределено;//В ут 11.0.8 или древнее нет перечисления ТипыДоговоров
		КонецЕсли;
		
		ВидДоговора = ?(КтоМы = "Поставщик",	Перечисления.ТипыДоговоров.СПокупателем,				Перечисления.ТипыДоговоров.СПоставщиком);
		
	ИначеЕсли ИмяКонфигурации1С="УФ_УНФ" Тогда
		
		ВидДоговора = ?(КтоМы = "Поставщик",	Перечисления.ВидыДоговоров.СПокупателем,				Перечисления.ВидыДоговоров.СПоставщиком);
		
	ИначеЕсли ИмяКонфигурации1С = "ШтрихМ_РС" Тогда
		
		ВидДоговора = ?(КтоМы = "Поставщик",	Перечисления.ВидыДоговоровКонтрагентов.СПокупателем,	Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
		
	ИначеЕсли ИмяКонфигурации1С="ТКПТ" Тогда
		
		ВидДоговора = ?(КтоМы = "Поставщик",	Перечисления.ВидыДоговоров.Продажа,						Перечисления.ВидыДоговоров.Покупка);
		
	ИначеЕсли ИмяКонфигурации1С="ДалионТРЕНД"  ИЛИ ИмяКонфигурации1С = "УФ_ДалионТРЕНД"  Тогда
		
		ВидДоговора = ?(КтоМы = "Поставщик",	Перечисления.ВидыДоговоров.СПоставщиком,				Перечисления.ВидыДоговоров.СПокупателем);
		
	Иначе//остальные более-менее типовые конфигурации
		
		ВидДоговора = ?(КтоМы = "Поставщик",	Перечисления.ВидыДоговоровКонтрагентов.СПокупателем,	Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ВидДоговора",	ВидДоговора);
	
	Если ЭтоОбратнаяОтгрузка(Сообщение.ТипСообщения) Тогда
		Если КтоМы = "Поставщик" Тогда
			Запрос.УстановитьПараметр("Организация",	Сообщение.Покупатель1С);
			Запрос.УстановитьПараметр("Владелец",		Сообщение.Продавец1С);
		Иначе
			Запрос.УстановитьПараметр("Организация",	Сообщение.Продавец1С);
			Запрос.УстановитьПараметр("Владелец",		Сообщение.Покупатель1С);
		КонецЕсли;
	Иначе
		Если КтоМы = "Поставщик" Тогда
			Запрос.УстановитьПараметр("Организация",	Сообщение.Продавец1С);
			Запрос.УстановитьПараметр("Владелец",		Сообщение.Покупатель1С);
		Иначе
			Запрос.УстановитьПараметр("Организация",	Сообщение.Покупатель1С);
			Запрос.УстановитьПараметр("Владелец",		Сообщение.Продавец1С);
		КонецЕсли;
	КонецЕсли;
			
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Договор = Неопределено;
		
	Иначе
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Договор = Выборка.Ссылка;
		
	КонецЕсли;
	
	Возврат Договор;
	
КонецФункции

Функция КэшШаблоновЗапросов() Экспорт
	
