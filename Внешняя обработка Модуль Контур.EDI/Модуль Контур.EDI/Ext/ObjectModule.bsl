КонецФункции

Функция Диагностика_НовыйОписаниеСвойствСтрокиТаблицы(КоллекцияКолонокТаблицы)
	
	ОписаниеСвойствСтроки = Новый Структура;
	
	Для Каждого Колонка Из КоллекцияКолонокТаблицы Цикл 
		ОписаниеСвойствСтроки.Вставить(Колонка.Имя);	
	КонецЦикла;
	
	ОписаниеСвойствСтроки.Удалить("Ссылка");
	
	Возврат ОписаниеСвойствСтроки;
	
КонецФункции

Функция Диагностика_НовыйПараметрыВыводаТаблицы()
	
	Структура = Новый Структура;
	Структура.Вставить("ИмяПоляГруппировки"		, "");
	Структура.Вставить("ПредставлениеТаблицы"	, "");
	Структура.Вставить("ЭтоТаблицаЗначений"		, Ложь);
	
	Возврат Структура;
	
КонецФункции

Функция Диагностика_ПараметрыВыводаТаблицыВТабличныйДокумент(ПредставлениеТаблицы, ИмяПоляГруппировки = "НомерСтроки", ЭтоТаблицаЗначений = Ложь)
	
	ПараметровВыводаТаблицы = Диагностика_МенеджерНастроек().НовыйПараметрыВыводаТаблицы;
	
	ПараметровВыводаТаблицы.ПредставлениеТаблицы	= ПредставлениеТаблицы;
	ПараметровВыводаТаблицы.ИмяПоляГруппировки		= ИмяПоляГруппировки;
	ПараметровВыводаТаблицы.ЭтоТаблицаЗначений		= ЭтоТаблицаЗначений;
	
	Возврат ПараметровВыводаТаблицы;
	
КонецФункции

Функция ТипПринадлежитДокументуСправочнику(ПроверяемыйТип)
	
	ОписаниеТиповДокументыСправочники = Диагностика_МенеджерНастроек().ОписаниеТиповДокументыСправочники;
		
	Возврат ПроверяемыйТип <> Тип("Неопределено") 
			И (ОписаниеТиповДокументыСправочники.ТипыДокументов.СодержитТип(ПроверяемыйТип)
				Или ОписаниеТиповДокументыСправочники.ТипыСправочников.СодержитТип(ПроверяемыйТип));
	
КонецФункции			
			
Функция ПроверитьДоступностьРеквизитовСправочника(ТипЗначенияОбъекта)
	
	Если ТипЗначенияОбъекта = Тип("Неопределено") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОписаниеТиповСправочников = Диагностика_МенеджерНастроек().ТипыСправочниковБезРеквизитов;
	
	Возврат НЕ ОписаниеТиповСправочников.СодержитТип(ТипЗначенияОбъекта);
	
КонецФункции

Функция Диагностика_КонвертироватьОбъектСсылкаВСтруктуру(ОбъектСсылка, ТипЗначенияОбъекта)
	
	СтруктураСвойствОбъекта = Новый Структура;
	
	Если XMLТипЗнч(ОбъектСсылка) = Неопределено Или ОбъектСсылка.Пустая() Тогда
		Возврат СтруктураСвойствОбъекта;
	КонецЕсли;
		
	МетаданныеОбъекта = ОбъектСсылка.Метаданные();
	
	Диагностика_ДополнитьСтруктуруСтандартнымиРеквизитамиОбъекта(СтруктураСвойствОбъекта, ОбъектСсылка, МетаданныеОбъекта);
	
	ОписаниеТиповДокументыСправочники = Диагностика_МенеджерНастроек().ОписаниеТиповДокументыСправочники;
	
	Если ОписаниеТиповДокументыСправочники.ТипыДокументов.СодержитТип(ТипЗначенияОбъекта) Тогда
		
		Диагностика_ДополнитьСтруктуруРеквизитамиДокумента(СтруктураСвойствОбъекта, ОбъектСсылка, МетаданныеОбъекта.Имя);
		
	ИначеЕсли ПроверитьДоступностьРеквизитовСправочника(ТипЗначенияОбъекта) Тогда 		
		
		Диагностика_ДополнитьСтруктуруРеквизитамиСправочника(СтруктураСвойствОбъекта, ОбъектСсылка, МетаданныеОбъекта);
				
	КонецЕсли;
		
	СтруктураСвойствОбъекта.Вставить("УИД_Ссылки", ОбъектСсылка.УникальныйИдентификатор());
	
	СтруктураСвойствОбъекта.Удалить("Ссылка");
	
	Возврат СтруктураСвойствОбъекта;
		
КонецФункции

Функция Диагностика_РеквизитДокументаВМетаданных(ИмяОбъектаВМетаданных, ИмяРеквизитаОбъекта)
	
	Возврат КонтурСтандарт_СтрШаблон_("Документы.%1.Реквизиты.%2", ИмяОбъектаВМетаданных, ИмяРеквизитаОбъекта);
																 
КонецФункции

Функция Диагностика_ЗначениеРеквизитаДокументаПоДополнительнымИменам(ДокументСсылка, ИмяОбъектаВМетаданных, ИменаРеквизитов)
			
	ЗначениеРеквизита = Неопределено;
	
	Если ИменаРеквизитов = Неопределено Тогда
		Возврат ЗначениеРеквизита;
	КонецЕсли;
	
	Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
		
		РеквизитОбъектаВМетаданных = Диагностика_РеквизитДокументаВМетаданных(ИмяОбъектаВМетаданных, ИмяРеквизита);
		
		Если ЕстьНеобходимыеМетаданные(РеквизитОбъектаВМетаданных) Тогда			
			
			ЗначениеРеквизита = ДокументСсылка[ИмяРеквизита];
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ЗначениеРеквизита;
		
КонецФункции

Функция Диагностика_ЗначениеРеквизитаДокументаПоИмени(ДокументСсылка, ОсновноеИмяРеквизита, ИмяОбъектаВМетаданных, ДопИменаРеквизита = Неопределено)
	
	Попытка			
		ЗначениеРеквизита = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, ОсновноеИмяРеквизита);			
	Исключение
		ЗначениеРеквизита = Неопределено;
	КонецПопытки;
	
	Если ЗначениеРеквизита = Неопределено Тогда
		ЗначениеРеквизита = Диагностика_ЗначениеРеквизитаДокументаПоДополнительнымИменам(ДокументСсылка, ИмяОбъектаВМетаданных, ДопИменаРеквизита);
	КонецЕсли; 
	
	Возврат ЗначениеРеквизита;
	
КонецФункции
	
Процедура Диагностика_ДополнитьСтруктуруРеквизитамиДокумента(СтруктураСвойствОбъекта, ДокументСсылка, ИмяОбъектаВМетаданных)
	
	Перем ОписаниеИменРеквизитовДокумента;
	
	ОписаниеИменРеквизитовДокумента = Диагностика_МенеджерНастроек().ОписаниеИменРеквизитовДокумента;
	ТипДокументаСчетФактура			= Диагностика_МенеджерНастроек().ТипДокументаСчетФактура;
	ТипИсходящийКСФ					= Диагностика_МенеджерНастроек().ТипИсходящийКСФ;
	
	ЭтоДокументКРТУ 				= ЗначениеЗаполнено(ТипИсходящийКСФ) И ТипЗнч(ДокументСсылка) = Тип(ТипИсходящийКСФ);
	ЭтоДокументСчетФактура			= ЗначениеЗаполнено(ТипДокументаСчетФактура) И ТипЗнч(ДокументСсылка) = Тип(ТипДокументаСчетФактура);
				
	Для Каждого ОписаниеИменРеквизитов Из ОписаниеИменРеквизитовДокумента Цикл
						
		ДополнитьСтруктуруРеквизитами = ОписаниеИменРеквизитов.Ключ = "ИменаОбщихРеквизитов"
										Или (ОписаниеИменРеквизитов.Ключ = "ИменаРеквизитовКРТУ" И ЭтоДокументКРТУ)
										Или (ОписаниеИменРеквизитов.Ключ = "ИменаРеквизитовСчетФактуры" И ЭтоДокументСчетФактура);
													
		Если НЕ ДополнитьСтруктуруРеквизитами Тогда
			Продолжить;
		КонецЕсли;
		
		ИменаРеквизитов = ОписаниеИменРеквизитов.Значение;
		
		Для Каждого Элемент Из ИменаРеквизитов Цикл
			
			ОсновноеИмяРеквизита	= Элемент.Ключ;
			ДопИменаРеквизита 		= Элемент.Значение;
				
			ЗначениеРеквизита = Диагностика_ЗначениеРеквизитаДокументаПоИмени(ДокументСсылка, ОсновноеИмяРеквизита, ИмяОбъектаВМетаданных, ДопИменаРеквизита);
					
			СтруктураСвойствОбъекта.Вставить(ОсновноеИмяРеквизита, ЗначениеРеквизита); 
			
		КонецЦикла;
		
		Если НЕ ЭтоДокументСчетФактура Тогда
			Продолжить;
		КонецЕсли;
		
		ДокументОснованиеСчетаФактуры = СтруктураСвойствОбъекта.ДокументОснованиеСчетаФактуры;
		
		ЕстьРеквизитИсправляемыйСчетФактура = ЭтоВозвратТоваровОтКлиентаУФ_УТ(ДокументОснованиеСчетаФактуры)
												Или (ЗначениеЗаполнено(ТипИсходящийКСФ) И ТипЗнч(ДокументОснованиеСчетаФактуры) = Тип(ТипИсходящийКСФ));
		
		Если ЕстьРеквизитИсправляемыйСчетФактура Тогда
			
			ЗначениеРеквизита = Диагностика_ЗначениеРеквизитаДокументаПоИмени(ДокументСсылка, "ИсправляемыйСчетФактура", ИмяОбъектаВМетаданных);		
			
			СтруктураСвойствОбъекта.Вставить("ИсправляемыйСчетФактура", ЗначениеРеквизита);
			
		КонецЕсли;
			
	КонецЦикла;
		
КонецПроцедуры

Процедура Диагностика_ДополнитьСтруктуруРеквизитамиСправочника(СтруктураСвойствОбъекта, ОбъектСсылка, МетаданныеОбъекта)

	Для Каждого РеквизитОбъекта Из МетаданныеОбъекта.Реквизиты Цикл		
		СтруктураСвойствОбъекта.Вставить(РеквизитОбъекта.Имя);		
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(СтруктураСвойствОбъекта, ОбъектСсылка);
	
КонецПроцедуры

Процедура Диагностика_ДополнитьСтруктуруСтандартнымиРеквизитамиОбъекта(СтруктураСвойствОбъекта, ОбъектСсылка, МетаданныеОбъекта)
				
	Для Каждого СтандартныйРеквизитОбъекта Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл		
		СтруктураСвойствОбъекта.Вставить(СтандартныйРеквизитОбъекта.Имя);		
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(СтруктураСвойствОбъекта, ОбъектСсылка);
	
КонецПроцедуры

Процедура Диагностика_ЗаполнитьДополнительныеКолонкиДереваСвязанныхСообщений(КоллекцияСтрокДерева)
	
	Для Каждого СтрокаДерева Из КоллекцияСтрокДерева Цикл
		
		ЗаполнитьЗначенияСвойств(СтрокаДерева, СтрокаДерева.Ссылка);
				
		Диагностика_ЗаполнитьДополнительныеКолонкиДереваСвязанныхСообщений(СтрокаДерева.Строки);
		
	КонецЦикла;
	
КонецПроцедуры

