Функция КлиентСервисОбновлений_НовыйПараметрыСервиса(ТестовоеОкружение = Ложь)
	
	Результат = Новый Структура;
	
	Результат.Вставить("Сервер"							, КлиентСервисОбновлений_АдресСервера(ТестовоеОкружение)			);
	Результат.Вставить("Метод"							, ""						);
	Результат.Вставить("АдресРесурса"					, ""						);
	Результат.Вставить("ТелоЗапроса"					, Неопределено				);
	Результат.Вставить("Параметры"						, Новый Структура			);
	Результат.Вставить("Заголовки"						, Новый Соответствие		);
	Результат.Вставить("ДопустимыеКодыОтвета"			, Новый Массив				);
	Результат.Вставить("ТипОтвета"						, КлиентСервисОбновлений_ТипыОтветаСервиса().JSON	);
	Результат.Вставить("URL"							, ""						);
	
	Результат.Метод = "GET";
	
	Результат.Заголовки.Вставить("Accept"		, "application/json");
	Результат.Заголовки.Вставить("Content-Type"	, "application/json;charset=utf-8");
		
	Возврат Результат;
	
КонецФункции 

Функция КлиентСервисОбновлений_АдресСервера(ТестовоеОкружение = Ложь)
	
