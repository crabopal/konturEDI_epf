// {{ Заполнение документов 1С

Функция ПерезаполнитьСчетФактуру_УНФ(ДокументРеализация) Экспорт
	
	Результат = Новый Структура("Успешно, ОписаниеОшибки", Истина, "");
	
	СчетФактура = Неопределено;
	
	Попытка
		Выполнить("СчетФактура = УправлениеНебольшойФирмойСервер.ПолучитьПодчиненныйСчетФактуру(ДокументРеализация.Ссылка);");
	Исключение
		Попытка
			Выполнить("СчетФактура = СчетаФактурыУНФ.ПолучитьПодчиненныйСчетФактуру(ДокументРеализация.Ссылка);");
		Исключение
			
			Результат.Успешно = Ложь;
			Результат.ОписаниеОшибки = ОписаниеОшибки();
		
		КонецПопытки;
	КонецПопытки;
	
	Если ЗначениеЗаполнено(СчетФактура) Тогда
		
		Попытка
			Выполнить("УправлениеНебольшойФирмойСервер.ИзменитьПодчиненнуюСчетФактуру(СчетФактура.Ссылка);");
		Исключение
			Попытка
				Выполнить("СчетаФактурыУНФ.ИзменитьПодчиненнуюСчетФактуру(СчетФактура.Ссылка);");
			Исключение
				
				Результат.Успешно = Ложь;
				Результат.ОписаниеОшибки = ОписаниеОшибки();
				
			КонецПопытки;
		КонецПопытки;
		
	ИначеЕсли НЕ ЗначениеЗаполнено(Результат.ОписаниеОшибки) Тогда   
		
		Результат.Успешно = Истина;
		Результат.ОписаниеОшибки = "Не найдена счет фактура";
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции   

