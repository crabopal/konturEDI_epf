	|	ЗначенияDESADV.Значение КАК DESADV,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(ЗначенияДатаДействияDESADV.Значение КАК ДАТА), ДатаВремя(1,1,1)) КАК DESADV_Исходящее_ДатаДействия,
	|	ЗначенияRECADV.Значение КАК RECADV,
