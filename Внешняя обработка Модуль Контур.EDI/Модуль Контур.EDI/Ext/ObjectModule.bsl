	ПараметрыЗапроса = НовыеПараметрыHTTPЗапроса();
	ПараметрыЗапроса.Параметры.Вставить("boxId" , ИдентификаторЯщика);
	ПараметрыЗапроса.Параметры.Вставить("messageId" , ИдентификаторСообщения);
	
	Если ЗначениеЗаполнено(ИдентификаторСущности) Тогда 
		ПараметрыЗапроса.Параметры.Вставить("entityId" , ИдентификаторСущности);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТипВозвращаемойПодписи) Тогда 
		ПараметрыЗапроса.Параметры.Вставить("originalSignature" , ТипВозвращаемойПодписи);
	КонецЕсли;
	
	ПараметрыЗапроса.Параметры.Вставить("injectEntityContent", ?(ВозвращатьСодержимоеСущностей, "true", "false"));
	
	Возврат ВыполнитьHTTPЗапрос_Diadoc("GET", "/V6/GetMessage", ПараметрыЗапроса, Токен);
	
КонецФункции

