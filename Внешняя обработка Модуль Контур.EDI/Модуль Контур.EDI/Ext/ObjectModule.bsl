Процедура ТребуемыеДействияКонтурEDI_ОбработатьДействия(ДействияДляГрупповойОбработки) Экспорт
	
	ДлительнаяОперация_Начать();
	
	Для Каждого Элемент Из ДействияДляГрупповойОбработки Цикл
		
		Действие = Элемент.Ключ;
		ОбъектыДействия = Элемент.Значение;
		
		Если Действие = "ОбработатьСообщение" Тогда
			
			ТребуемыеДействияКонтурEDI_ОбработатьВходящиеСообщения(ОбъектыДействия);
			
		ИначеЕсли Действие = "ОтправитьИсходящееСообщение" Тогда
			
			ТребуемыеДействияКонтурEDI_ОтправитьИсходящиеСообщения(ОбъектыДействия, Ложь);
			
		ИначеЕсли Действие = "ЗакрытьПредварительныеЗаказы" Тогда 
			
			ЗаказыДляЗакрытия = Новый Массив;
			
			Для Каждого ОбъектДействия Из ОбъектыДействия Цикл
				
				ДокументСообщения = ОбъектДействия.Документ;
				
				Если ЗначениеЗаполнено(ДокументСообщения) Тогда
					ЗаказыДляЗакрытия.Добавить(ДокументСообщения);
				КонецЕсли;
				
			КонецЦикла;
			
			ЗакрытьПредварительныеЗаказы(ЗаказыДляЗакрытия);
			
		ИначеЕсли Действие = "ПереотправитьСообщение" Тогда
			
			ТребуемыеДействияКонтурEDI_ОтправитьИсходящиеСообщения(ОбъектыДействия, Истина);
			
		ИначеЕсли Действие = "СоздатьДокументНаОсновании" Тогда
			
			ТребуемыеДействияКонтурEDI_СоздатьДокументыНаОснованиии(ОбъектыДействия);
			
		ИначеЕсли Действие = "ПровестиДокумент" Тогда
			
			 ТребуемыеДействияКонтурEDI_ПровестиДокументы(ОбъектыДействия);
			
		ИначеЕсли Действие = "ПодписатьВДиадок" Тогда
			
			// механизм реализован отдельно. 
			
		КонецЕсли;
		
	КонецЦикла;	
	
	ДлительнаяОперация_Завершить();
	 
КонецПроцедуры

Функция ТребуемыеДействияКонтурEDI_ОписаниеОбъектаДействия() Экспорт

	ОписаниеОбъектаДействия = Новый Структура;
	
	ОписаниеОбъектаДействия.Вставить("ТипСообщения");
	ОписаниеОбъектаДействия.Вставить("ТребуемоеДействие");
	ОписаниеОбъектаДействия.Вставить("СообщениеСсылка");
	ОписаниеОбъектаДействия.Вставить("НомерЗаказа");
	ОписаниеОбъектаДействия.Вставить("НомерСообщения");
	ОписаниеОбъектаДействия.Вставить("Документ");
	ОписаниеОбъектаДействия.Вставить("Партнер");
	ОписаниеОбъектаДействия.Вставить("КодДействия");
	ОписаниеОбъектаДействия.Вставить("РежимРаботы");
	ОписаниеОбъектаДействия.Вставить("ВидПриложения");

	Возврат ОписаниеОбъектаДействия;
	
КонецФункции

Процедура ТребуемыеДействияКонтурEDI_СообщитьОшибкуОбработкиСообщения(ОбъектДействия, ТекстОшибокСообщения)
	
	ТекстОбработкиСообщения = КонтурСтандарт_СтрШаблон_(
	"Не удалось %1 по сообщению %2(номер заказа %3): %4
	|Для получения подробной информации выполните действие вручную.", 
	НРег(ОбъектДействия.ТребуемоеДействие), ОбъектДействия.НомерСообщения, ОбъектДействия.НомерЗаказа,  ТекстОшибокСообщения);
	
	Сообщить(ТекстОбработкиСообщения);

КонецПроцедуры

Процедура ТребуемыеДействияКонтурEDI_ОбработатьВходящиеСообщения(ОбъектыДействия)
	
	Для Каждого ОбъектДействия Из ОбъектыДействия Цикл
		
		ТипСообщения = ОбъектДействия.ТипСообщения; 
		СообщениеСсылка = ОбъектДействия.СообщениеСсылка;
		
		Сообщение = ПрочитатьСообщение(СообщениеСсылка, , ТипСообщения, "Входящее");
		КонвертироватьСообщениеEDIв1С(Сообщение);

		РезультатПроверкиДанных = ПроверитьПоля1С(Сообщение);
		
		Если РезультатПроверкиДанных.Успешно Тогда
			
			РезультатВыполненияДействия = ПринятьВходящееСообщение(Сообщение);
			РезультатОбработки = РезультатВыполненияДействия.Успешно;
			
			ТекстОшибокСообщения = "";
			
		Иначе
			
			РезультатОбработки = Ложь;
			
			Ошибки = РезультатПроверкиДанных.СписокОшибок.ВыгрузитьКолонку("ТекстОшибки");
			ТекстОшибокСообщения = КонтурСтандарт_СтрСоединить_(Ошибки, Символы.ПС);
					
		КонецЕсли;
		
		Если НЕ РезультатОбработки Тогда
			
			ТребуемыеДействияКонтурEDI_СообщитьОшибкуОбработкиСообщения(ОбъектДействия, ТекстОшибокСообщения);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ТребуемыеДействияКонтурEDI_ОтправитьИсходящиеСообщения(ОбъектыДействия, Переотправка = Ложь)
	
	Для Каждого ОбъектДействия Из ОбъектыДействия Цикл 
		
		ТипСообщения = ОбъектДействия.ТипСообщения;
		Документ = ОбъектДействия.Документ;	
		
		Если ЭтоТипНезависимогоСообщения(ТипСообщения) Тогда
			
			Если ЗначениеЗаполнено(ОбъектДействия.СообщениеСсылка) Тогда
				Сообщение = ПрочитатьСообщение(ОбъектДействия.СообщениеСсылка, , ТипСообщения, "Исходящее");
			Иначе
				Сообщение = ПолучитьСтруктуруСообщения(ТипСообщения, "Исходящее");
			КонецЕсли;
			
		Иначе
			СообщениеОснование = ТребуемыеДействияКонтурEDI_ПараметрыСообщенияОснование(ОбъектДействия.СообщениеСсылка, Переотправка);
			Сообщение = ПодготовитьИсходящееСообщение(ТипСообщения, Документ, СообщениеОснование);
		КонецЕсли;
		
		Если ТипСообщения = "DESADV" И НЕ Переотправка Тогда
			ТребуемыеДействияКонтурEDI_ОтправитьСообщениеDESADV(Сообщение, Документ);
		Иначе
			ПараметрыДействия = Новый Структура();
			ПараметрыДействия.Вставить("ОтправитьСообщениеИзФормы", Истина);
			ПараметрыДействия.Вставить("Сообщение", Сообщение);
			ОтправитьСообщение(ТипСообщения, Документ, ПараметрыДействия);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СокрЛП(Сообщение.ОписаниеОшибки)) Тогда
			
			ТребуемыеДействияКонтурEDI_СообщитьОшибкуОбработкиСообщения(ОбъектДействия, Сообщение.ОписаниеОшибки);
  	
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ТребуемыеДействияКонтурEDI_ШаблонТекстаОшибкиПодготовкиСвязанногоСообщения()
	 
	Возврат НСтр("ru = 'Подготовка сообщения DESADV была автоматически прервана. 
					   |У вас включена настройка для партнера ""Отправлять %1 вместе с %2"", и  в процессе подготовки сообщения %1 возникли ошибки: %3'");
		                 
КонецФункции

Процедура ТребуемыеДействияКонтурEDI_ОтправитьСообщениеDESADV(Сообщение, Документ)
	
	Если Сообщение.СодержитОшибки Тогда
		Возврат;
	КонецЕсли;
	
	ОтправлятьINVOICсDESADV = ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Получатель1С, "ОтправлятьINVOICсDESADV") = Истина;
	
	ШаблонТекста = ТребуемыеДействияКонтурEDI_ШаблонТекстаОшибкиПодготовкиСвязанногоСообщения();
	
	Если ОтправлятьINVOICсDESADV Тогда
		
		СчетФактура = ПолучитьСчетФактуруНакладной(Документ);
		Если Не ЗначениеЗаполнено(СчетФактура) Тогда
			
			ТекстОшибки = КонтурСтандарт_СтрШаблон_("Не удалось найти счет-фактуру по документу: %1", Документ);
			
			Сообщение.ОписаниеОшибки = КонтурСтандарт_СтрШаблон_(ШаблонТекста, "INVOIC", "DESADV", ТекстОшибки);
			
			Возврат;
			
		КонецЕсли;
		
		СообщениеINVOIC = ПодготовитьИсходящееСообщение("INVOIC", СчетФактура);
		Если СообщениеINVOIC.СодержитОшибки Тогда
			
			Сообщение.ОписаниеОшибки = КонтурСтандарт_СтрШаблон_(ШаблонТекста, "INVOIC", "DESADV", СообщениеINVOIC.ОписаниеОшибки);
			
			Возврат;
			
		Иначе
			
			ПараметрыДействияINVOIC = Новый Структура();
			ПараметрыДействияINVOIC.Вставить("ОтправитьСообщениеИзФормы", Истина);
			ПараметрыДействияINVOIC.Вставить("Сообщение", СообщениеINVOIC);
			
			ОтправитьСообщение("INVOIC", СчетФактура, ПараметрыДействияINVOIC);
			
		КонецЕсли;
		
	КонецЕсли;
	
	НужноПропуститьСообщениеСУслугами = НужноПропуститьСообщениеСУслугами_DESADV(Сообщение);
	
	Если НужноПропуститьСообщениеСУслугами Тогда
		
		СохранитьСообщение(Сообщение, "Пропущен");
		
		ТекстПредупреждения = НСтр("ru = 'Сообщение DESADV было автоматически пропущено. Настройка ""Отправлять DESADV с услугами"" отключена у партнера.'");
		
		Сообщение.ОписаниеОшибки = ТекстПредупреждения;
		
		Возврат;
		
	КонецЕсли;
	
	ОтправлятьALCRPTсDESADV = ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Получатель1С, "ОтправлятьALCRPT") = Истина;
	ОтправлятьALCRPTсINVOIC = ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Получатель1С, "ОтправлятьALCRPTсINVOIC") = Истина;
	
	
	Если ОтправлятьALCRPTсDESADV Или ОтправлятьALCRPTсINVOIC Тогда 
		
		СообщениеALCRPT = ПодготовитьИсходящееСообщение("ALCRPT", Документ, Неопределено);
		
		Если СообщениеALCRPT.СодержитОшибки Тогда
			
			ТипСвязанногоСообщения = ?(ОтправлятьALCRPTсINVOIC, "INVOIC", "DESADV"); 
			ТекстОшибкиALCRPT = КонтурСтандарт_СтрШаблон_(ШаблонТекста, "ALCRPT", ТипСвязанногоСообщения, СообщениеALCRPT.ОписаниеОшибки);
			СообщениеALCRPT.ОписаниеОшибки = ТекстОшибкиALCRPT;
			Сообщение.ОписаниеОшибки = ТекстОшибкиALCRPT;
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрыДействия = Новый Структура();
	ПараметрыДействия.Вставить("ОтправитьСообщениеИзФормы", Истина);
	ПараметрыДействия.Вставить("Сообщение", Сообщение);
	
	ОтправитьСообщение(Сообщение.ТипСообщения, Документ, ПараметрыДействия);
	
КонецПроцедуры

Процедура ТребуемыеДействияКонтурEDI_ПровестиДокументы(ОбъектыДействия)
	
	НачалоДняТекущейДаты = НачалоДня(ТекущаяДата());
	
	Для Каждого ОбъектДействия Из ОбъектыДействия Цикл
		
		ДокументПроведен = ПолучитьЗначениеРеквизитаОбъекта_КонтурEDI(ОбъектДействия.Документ, "Проведен");
		
		Если ДокументПроведен = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		ДокументОбъект = ОбъектДействия.Документ.ПолучитьОбъект();
		
		СтандартнаяОбработкаEDI = Истина;
		ПараметрыПМ = Новый Структура("ДокументСсылка, ДокОбъект", ОбъектДействия.Документ, ДокументОбъект);
		Результат = ОбработкаСобытияПодключаемогоМодуля("ПередПроведениемДокумента", СтандартнаяОбработкаEDI, ПараметрыПМ);
		
		Если Не СтандартнаяОбработкаEDI = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		РазрешеноОперативноеПроведение = ДокументОбъект.Метаданные().ОперативноеПроведение = Метаданные.СвойстваОбъектов.ОперативноеПроведение.Разрешить;
		ДокументОтТекущейДаты = НачалоДня(ДокументОбъект.Дата) = НачалоДняТекущейДаты;
		
		ПроводитьОперативно = РазрешеноОперативноеПроведение И ДокументОтТекущейДаты;
		
		Если ПроводитьОперативно Тогда
			РежимПроведения  = РежимПроведенияДокумента.Оперативный;
		Иначе
			РежимПроведения  = РежимПроведенияДокумента.Неоперативный;
		КонецЕсли;

		Попытка
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведения);
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			ТребуемыеДействияКонтурEDI_СообщитьОшибкуОбработкиСообщения(ОбъектДействия, ТекстОшибки);
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ТребуемыеДействияКонтурEDI_СоздатьДокументыНаОснованиии(ОбъектыДействия)
	
	Для Каждого ОбъектДействия Из ОбъектыДействия Цикл
		
		ИмяСоздаваемогоДокумента = СтрЗаменить(Сред(ОбъектДействия.КодДействия, 17), "_ПоКорректировке", "");
		
		ДокументНаОснованииТекущего = НайтиДокументНаОснованииТекущего(ОбъектДействия.Документ, ОбъектДействия.РежимРаботы, ИмяСоздаваемогоДокумента);
		
		ТекстОшибки = "";
		Если ДокументНаОснованииТекущего = Неопределено Тогда
			ДанныеЗаполнения = ТребуемыеДействияКонтурEDI_ДанныеЗаполненияДокумента();
			ДанныеЗаполнения.Основание = ОбъектДействия.Документ;
			ДанныеЗаполнения.ТипСообщения = ОбъектДействия.ТипСообщения;
			ДанныеЗаполнения.ВидПриложения = ОбъектДействия.ВидПриложения;
			
			СозданныйДокументСсылка = ТребуемыеДействияКонтурEDI_СоздатьДокументНаОсновании(ИмяСоздаваемогоДокумента, ДанныеЗаполнения, ТекстОшибки);
		Иначе
			СозданныйДокументСсылка = Неопределено;
			ТекстОшибки = "Документ на основании %1 уже был создан: %2";
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СозданныйДокументСсылка) Тогда
			ТребуемыеДействияКонтурEDI_СообщитьОшибкуОбработкиСообщения(ОбъектДействия, ТекстОшибки);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ТребуемыеДействияКонтурEDI_ЗаполнитьСчетФактураВыданныйОФ(СчетФактура, ДанныеЗаполнения)
	
	ТребуемыеДействияКонтурEDI_ЗаполнитьДанныеПлатежноРасчетногоДокументаВСчетФактуре(СчетФактура);
	
	Если ИмяКонфигурации1С = "УТ_10_2" Тогда
		
		Если ЕстьНеобходимыеМетаданные("Документы.СчетФактураВыданный.Реквизиты.Организация") 
			И Не ЗначениеЗаполнено(СчетФактура.Организация) Тогда
			
			Если ЕстьРеквизитОбъекта_Контур(ДанныеЗаполнения.Основание, "Организация") Тогда				
				СчетФактура.Организация = ПолучитьЗначениеРеквизитаОбъекта_КонтурEDI(ДанныеЗаполнения.Основание, "Организация");				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ТребуемыеДействияКонтурEDI_ЗаполнитьСчетФактураВыданныйУФ(СчетФактура, ДанныеЗаполнения)
	
	ИмяКонфигурации = ИмяКонфигурации1С;
	
	Если (ИмяКонфигурации = "УФ_УТ" ИЛИ ИмяКонфигурации = "УФ_Розница") Тогда
		
		Попытка
			ДанныеСчетаФактуры = ТребуемыеДействияКонтурEDI_ДанныеДляСозданияСчетаФактуры_УФ_УТ_Розница(ДанныеЗаполнения.Основание);
			СчетФактура.Заполнить(ДанныеСчетаФактуры);
		Исключение
			СчетФактура.Заполнить(ДанныеЗаполнения.Основание);
		КонецПопытки;
		
	ИначеЕсли ИмяКонфигурации = "УФ_БП" Тогда
		
		ДанныеСчетаФактуры = Новый Структура("Основание", ДанныеЗаполнения.Основание);
		СчетФактура.Заполнить(ДанныеСчетаФактуры);
		
	Иначе
		СчетФактура.Заполнить(ДанныеЗаполнения.Основание);
	КонецЕсли;
	
	Если ЕстьНеобходимыеМетаданные("Документы.СчетФактураВыданный.Реквизиты.ВидСчетаФактуры", Истина)
		И ЕстьНеобходимыеМетаданные("Перечисления.ВидСчетаФактурыВыставленного.ЗначенияПеречисления.НаРеализацию") Тогда
		
		СчетФактура.ВидСчетаФактуры = Перечисления.ВидСчетаФактурыВыставленного.НаРеализацию;
		
	КонецЕсли;
	
	ТребуемыеДействияКонтурEDI_ЗаполнитьДанныеПлатежноРасчетногоДокументаВСчетФактуре(СчетФактура);

КонецПроцедуры

Процедура ТребуемыеДействияКонтурEDI_ЗаполнитьДанныеПлатежноРасчетногоДокументаВСчетФактуре(СчетФактура)
	
	Если ЕстьНеобходимыеМетаданные("Документы.СчетФактураВыданный.Реквизиты.ДатаПлатежноРасчетногоДокумента")
		И ЕстьНеобходимыеМетаданные("Документы.СчетФактураВыданный.Реквизиты.НомерПлатежноРасчетногоДокумента")
		И ЕстьНеобходимыеМетаданные("Документы.СчетФактураВыданный.ТабличныеЧасти.ДатаНомерДокументовОплаты")
		И ЕстьНеобходимыеМетаданные("Документы.СчетФактураВыданный.ТабличныеЧасти.Реквизиты.ДатаПлатежноРасчетногоДокумента")
		И ЕстьНеобходимыеМетаданные("Документы.СчетФактураВыданный.ТабличныеЧасти.Реквизиты.НомерПлатежноРасчетногоДокумента") Тогда
		
		
		Если СчетФактура.ДатаНомерДокументовОплаты.Количество() = 0 Тогда
			СчетФактура.ДатаНомерДокументовОплаты.Добавить();
			СчетФактура.ДатаНомерДокументовОплаты[0].ДатаПлатежноРасчетногоДокумента = СчетФактура.ДатаПлатежноРасчетногоДокумента;
			СчетФактура.ДатаНомерДокументовОплаты[0].НомерПлатежноРасчетногоДокумента = СчетФактура.НомерПлатежноРасчетногоДокумента;				
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Функция ТребуемыеДействияКонтурEDI_ПараметрыСообщенияОснование(СообщениеСсылка, Переотправка)
	
	СообщениеОснование = Новый Структура;
	Если Переотправка Тогда
		СообщениеОснование.Вставить("ПереотправляемоеСообщениеСсылка", СообщениеСсылка);
		СообщениеОснование.Вставить("Действие", "Переотправка");
	Иначе
		СообщениеОснование.Вставить("СообщениеСсылка", СообщениеСсылка);
	КонецЕсли;
	
	Возврат СообщениеОснование;

КонецФункции

Функция ТребуемыеДействияКонтурEDI_ДанныеЗаполненияДокумента()
	
	ДанныеЗаполнения = Новый Структура("Основание, ТипСообщения, ВидПриложения");
	Возврат ДанныеЗаполнения;

КонецФункции

Функция ТребуемыеДействияКонтурEDI_СоздатьДокументНаОсновании(ИмяСоздаваемогоДокумента, ДанныеЗаполнения, ТекстОшибки = "")

	СтандартнаяОбработкаEDI = Истина;
	ПараметрыПМ = Новый Структура();
	ПараметрыПМ.Вставить("ДокументОснование", ДанныеЗаполнения.Основание);
	ПараметрыПМ.Вставить("ИмяСоздаваемогоДокумента", ИмяСоздаваемогоДокумента);
	ПараметрыПМ.Вставить("ПакетнаяОбработка", Истина);
	
	ДокументСсылка = ОбработкаСобытияПодключаемогоМодуля("СоздатьДокументНаОсновании", СтандартнаяОбработкаEDI, ПараметрыПМ);
	
	Если НЕ СтандартнаяОбработкаEDI Тогда
		Возврат ДокументСсылка;
	КонецЕсли;
	
	Если ДанныеЗаполнения.ВидПриложения = "Обычное" Тогда
		ДокументСсылка = ТребуемыеДействияКонтурEDI_СоздатьДокументНаОснованииОбычноеПриложение(ИмяСоздаваемогоДокумента, ДанныеЗаполнения, ТекстОшибки);
	Иначе
		ДокументСсылка = ТребуемыеДействияКонтурEDI_СоздатьДокументНаОснованииУправляемоеПриложение(ИмяСоздаваемогоДокумента, ДанныеЗаполнения, ТекстОшибки);
	КонецЕсли;

	Возврат ДокументСсылка;

КонецФункции

Функция ТребуемыеДействияКонтурEDI_СоздатьДокументНаОснованииОбычноеПриложение(ИмяСоздаваемогоДокумента, ДанныеЗаполнения, ТекстОшибки = "")
	
	ПутьКМетаданным = КонтурСтандарт_СтрШаблон_("Документы.%1", ИмяСоздаваемогоДокумента);
	Если НЕ ЕстьНеобходимыеМетаданные(ПутьКМетаданным, Истина) Тогда
		ТекстОшибки = КонтурСтандарт_СтрШаблон_("В конфигурации нет документа с именем: %1", ИмяСоздаваемогоДокумента);
		Возврат Неопределено;
	КонецЕсли;
	
	НовыйДокумент = Документы[ИмяСоздаваемогоДокумента].СоздатьДокумент();
	НовыйДокумент.Заполнить(ДанныеЗаполнения.Основание);
	
	Если НЕ ЗначениеЗаполнено(НовыйДокумент.Дата) Тогда
		НовыйДокумент.Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если ИмяСоздаваемогоДокумента = "СчетФактураВыданный" Тогда		
		ТребуемыеДействияКонтурEDI_ЗаполнитьСчетФактураВыданныйОФ(НовыйДокумент, ДанныеЗаполнения);		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НовыйДокумент.Номер) Тогда
		НовыйДокумент.УстановитьНовыйНомер();
	КонецЕсли;
	
	Если ИмяСоздаваемогоДокумента = "РеализацияТоваровУслуг" 
		Или ИмяСоздаваемогоДокумента = "схРеализацияТоваровУслуг" Тогда
		
		ЕстьТовары = ТребуемыеДействияКонтурEDI_ЕстьДанныеВТабличнойЧастиСТоварами(НовыйДокумент, ИмяСоздаваемогоДокумента);
		ЕстьУслуги = ТребуемыеДействияКонтурEDI_ЕстьДанныеВТабличнойЧастиСУслугами(НовыйДокумент, ИмяСоздаваемогоДокумента);
		
		Если Не ЕстьТовары И НЕ ЕстьУслуги Тогда
			ТекстОшибки = КонтурСтандарт_СтрШаблон_("Не удалось создать документ %1 на основании %2: Не заполнились табличные части.", ИмяСоздаваемогоДокумента, ДанныеЗаполнения.Основание, ОписаниеОшибки());
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	Попытка
		НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);
		СсылкаНаДокумент = НовыйДокумент.Ссылка;
	Исключение
		СсылкаНаДокумент = Неопределено;
		ТекстОшибки = КонтурСтандарт_СтрШаблон_("Не удалось создать документ %1 на основании %2: %3", ИмяСоздаваемогоДокумента, ДанныеЗаполнения.Основание, ОписаниеОшибки());
	КонецПопытки;
	
	Возврат СсылкаНаДокумент;
	
КонецФункции

Функция ТребуемыеДействияКонтурEDI_СоздатьДокументНаОснованииУправляемоеПриложение(ИмяСоздаваемогоДокумента, ДанныеЗаполнения, ТекстОшибки = "")
	
	ПутьКМетаданным = КонтурСтандарт_СтрШаблон_("Документы.%1", ИмяСоздаваемогоДокумента);
	Если НЕ ЕстьНеобходимыеМетаданные(ПутьКМетаданным, Истина) Тогда
		ТекстОшибки = КонтурСтандарт_СтрШаблон_("В конфигурации нет документа с именем: %1", ИмяСоздаваемогоДокумента);
		Возврат Неопределено;
	КонецЕсли;
	
	НовыйДокумент = Документы[ИмяСоздаваемогоДокумента].СоздатьДокумент();
	
	ИмяКонфигурации = ИмяКонфигурации1С;
	
	Если ИмяСоздаваемогоДокумента = "СчетФактураВыданный" Тогда
		ТребуемыеДействияКонтурEDI_ЗаполнитьСчетФактураВыданныйУФ(НовыйДокумент, ДанныеЗаполнения);		
	Иначе
		НовыйДокумент.Заполнить(ДанныеЗаполнения.Основание);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НовыйДокумент.Дата) Тогда
		НовыйДокумент.Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НовыйДокумент.Номер) Тогда
		НовыйДокумент.УстановитьНовыйНомер();
	КонецЕсли;
	
	//еще кастомные проверки. Сюда тоже прокинуть ПМ
	Если ИмяСоздаваемогоДокумента = "РеализацияТоваровУслуг"
		Или ИмяСоздаваемогоДокумента = "схРеализацияТоваровУслуг" Тогда
		
		ЕстьТовары = ТребуемыеДействияКонтурEDI_ЕстьДанныеВТабличнойЧастиСТоварами(НовыйДокумент, ИмяСоздаваемогоДокумента);
		ЕстьУслуги = ТребуемыеДействияКонтурEDI_ЕстьДанныеВТабличнойЧастиСУслугами(НовыйДокумент, ИмяСоздаваемогоДокумента);
		
		Если Не ЕстьТовары И НЕ ЕстьУслуги Тогда
			ТекстОшибки = КонтурСтандарт_СтрШаблон_("Не удалось создать документ %1 на основании %2: Не заполнились табличные части.", ИмяСоздаваемогоДокумента, ДанныеЗаполнения.Основание, ОписаниеОшибки());
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЕстьНеобходимыеМетаданные(КонтурСтандарт_СтрШаблон_("Документы.%1.Реквизиты.СкидкиРассчитаны", ИмяСоздаваемогоДокумента)) Тогда
		
		Если ЕстьРеквизитОбъекта_Контур(ДанныеЗаполнения.Основание, "СкидкиРассчитаны") Тогда
			НовыйДокумент.СкидкиРассчитаны = ПолучитьЗначениеРеквизитаОбъекта_КонтурEDI(ДанныеЗаполнения.Основание, "СкидкиРассчитаны");				
		КонецЕсли;
		
	КонецЕсли;
	
	Попытка
		НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);
		СсылкаНаДокумент = НовыйДокумент.Ссылка;
	Исключение
		СсылкаНаДокумент = Неопределено;
		ТекстОшибки = КонтурСтандарт_СтрШаблон_("Не удалось создать документ %1 на основании %2: %3", ИмяСоздаваемогоДокумента, ДанныеЗаполнения.Основание, ОписаниеОшибки());
	КонецПопытки; 
	
	Возврат СсылкаНаДокумент;

КонецФункции

Функция ТребуемыеДействияКонтурEDI_ЕстьДанныеВТабличнойЧастиСУслугами(Документ, ИмяСоздаваемогоДокумента)
	
	ЕстьУслуги = Истина;
	Если ЕстьНеобходимыеМетаданные(КонтурСтандарт_СтрШаблон_("Документы.%1.ТабличныеЧасти.%2", ИмяСоздаваемогоДокумента, "Услуги")) Тогда
		ЕстьУслуги = Не Документ.Услуги.Количество() = 0;	
	КонецЕсли;
	
	Возврат ЕстьУслуги;

КонецФункции

Функция ТребуемыеДействияКонтурEDI_ЕстьДанныеВТабличнойЧастиСТоварами(Документ, ИмяСоздаваемогоДокумента)
	
	ЕстьТовары = Ложь;
	Если ЕстьНеобходимыеМетаданные(КонтурСтандарт_СтрШаблон_("Документы.%1.ТабличныеЧасти.%2", ИмяСоздаваемогоДокумента, "Товары")) Тогда
		ЕстьТовары = НЕ Документ.Товары.Количество() = 0;
	ИначеЕсли ЕстьНеобходимыеМетаданные(КонтурСтандарт_СтрШаблон_("Документы.%1.ТабличныеЧасти.%2", ИмяСоздаваемогоДокумента, "Запасы")) Тогда
		ЕстьТовары = НЕ Документ.Запасы.Количество() = 0;
	КонецЕсли;
	
	Возврат ЕстьТовары;

КонецФункции

Функция ТребуемыеДействияКонтурEDI_ДанныеДляСозданияСчетаФактуры_УФ_УТ_Розница(ДокументОснование)
	
	ДанныеСчетаФактуры = Новый Структура;
	ДанныеСчетаФактуры.Вставить("ДокументОснование", ДокументОснование);
	ДанныеСчетаФактуры.Вставить("Организация",       ДокументОснование.Организация);
	ДанныеСчетаФактуры.Вставить("Исправление",       Ложь);
	ДанныеСчетаФактуры.Вставить("Корректировочный",  Ложь);
	
	Если ЕстьНеобходимыеМетаданные("Документы.КорректировкаРеализации", Истина)
		И ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		
		Если ЕстьНеобходимыеМетаданные("Документы.КорректировкаРеализации.Реквизиты.ВидКорректировки", Истина) Тогда
			ХозяйственнаяОперация = ПолучитьЗначениеРеквизитаОбъекта_КонтурEDI(ДокументОснование, "ВидКорректировки");
		ИначеЕсли ЕстьНеобходимыеМетаданные("Документы.КорректировкаРеализации.Реквизиты.ХозяйственнаяОперация", Истина) Тогда
			ХозяйственнаяОперация = ПолучитьЗначениеРеквизитаОбъекта_КонтурEDI(ДокументОснование, "ХозяйственнаяОперация");
		Иначе
			ВызватьИсключение("При получении данных для создания счета-фактуры не удалось определить хозяйственную операцию");
		КонецЕсли;
		
		ДанныеСчетаФактуры.Исправление = (ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ИсправлениеОшибок); 
		ДанныеСчетаФактуры.Корректировочный = (ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.КорректировкаПоСогласованиюСторон);
		
	КонецЕсли;
		
	Возврат ДанныеСчетаФактуры;
	
КонецФункции

