//
// Возвращаемое значение:
//	Булево - функции доступны
//
Функция КонтурСтандарт_ДоступенПоискФормыПоИдентификатору() Экспорт

	Возврат КонтурСтандарт_ВерсияРежимСовместимостиНеНижеУказанной("8.3.5");	
	
КонецФункции

// Определяет, является ли переданное значение структурой или фиксированной структурой.
// 
// Параметры:
//  Значение - Произвольный - значение, которое нужно проверить.
// 
// Возвращаемое значение:
//   Булево - Истина, если переданое значение является структрой или фиксированной структурой.
//
Функция КонтурСтандарт_ЭтоСтруктура(Значение) Экспорт
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если Значение = Неопределено Тогда
		
		Результат = Ложь;
		
	ИначеЕсли ТипЗначения = Тип("Структура") Тогда
		
		Результат = Истина;
		
	ИначеЕсли ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		
		Результат = Истина;
		
	Иначе
		
		Результат = Ложь;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверят наличие и получает значение по указанному имени свойства из структуры или соответствия.
// 
// Параметры:
//  Структура - Структура, Соответствие - коллекция для поиска.
//	Ключ - Строка - имя свойства искомого значения
//  ЗначениеПоУмолчанию - значение по умолчанию возвращаемое, если нет свойства в коллекции 
// 
// Возвращаемое значение:
//   Произвольный - значение полученное из коллекции либо значение по умолчанию.
//
Функция КонтурСтандарт_ЗначениеПоКлючу(Структура, Ключ, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Если ТипЗнч(Структура) = Тип("Структура") И Структура.Свойство(Ключ) Тогда
		Значение = Структура[Ключ];
	ИначеЕсли ТипЗнч(Структура) = Тип("Соответствие") И Структура.Получить(Ключ) <> Неопределено Тогда
		Значение = Структура.Получить(Ключ);
	Иначе
		Значение = ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

// Преобразует дату по формату "yyyy-MM-ddTHH:mm:ss+00:00" в строку.
// 
// Параметры:
//  ДатаВремя - Дата - значение, которое нужно преобразовать в строку.
// 
// Возвращаемое значение:
//   Строка - Преобразованная дата по формату.
//
Функция КонтурСтандарт_ДатаВФормате_ISO8601(ДатаВремя) Экспорт
	
	ФорматнаяСтрока = "ДФ=yyyy-MM-ddTHH:mm:ss+00:00; ДП=1970-01-01T00:00:00+00:00";
	Возврат Формат(ДатаВремя, ФорматнаяСтрока);
	
КонецФункции // ДатаВФормате_ISO8601()

// Проверят что текущая версия платформы не ниже указнной.
// 
// Параметры:
//  Версия - Строка - строка версии платформы в формате "X.X.XX.XXXX"/"Х.Х.ХХ".
// 
// Возвращаемое значение:
//   Булево - результат сравнения версий.
//
Функция КонтурСтандарт_ВерсияПлатформыНеНижеУказанной(Версия) Экспорт
	
	МенеджерНастроек = КонтурСтандарт_МенеджерНастроек();
	
	РезультатСравнения = МенеджерНастроек.РезультатФункции_ВерсияПлатформыНеНижеУказанной.Получить(Версия);
	
	Если РезультатСравнения = Неопределено Тогда
		
		СистемнаяИнформация = КонтурСтандарт_НовыйСистемнаяИнформация();
		
	  	РезультатСравнения = (КонтурСтандарт_СравнитьВерсии(СистемнаяИнформация.ВерсияПриложения, Версия) >= 0);
		
		МенеджерНастроек.РезультатФункции_ВерсияПлатформыНеНижеУказанной.Вставить(Версия, РезультатСравнения);
		
	КонецЕсли;
	
	Возврат РезультатСравнения; 
	
КонецФункции

// Проверят что текущая версия совместимости конфигурации не ниже указнной.
// 
// Параметры:
//  Версия - Строка - строка версии платформы в формате "X.X.XX.XXXX"/"Х.Х.ХХ".
//
// Возвращаемое значение:
//   Булево - результат сравнения версий.
//
Функция КонтурСтандарт_ВерсияРежимСовместимостиНеНижеУказанной(Версия) Экспорт 
	
	ВерсияРежимаСовместимости = КонтурСтандарт_РежимСовместимостиСтрокой_Сервер();	
	                                         
	Если ВерсияРежимаСовместимости = "НеИспользовать"
		ИЛИ ВерсияРежимаСовместимости = "DontUse" Тогда 
		                                
		Возврат КонтурСтандарт_ВерсияПлатформыНеНижеУказанной(Версия); 
		
	КонецЕсли;
	
	МенеджерНастроек = КонтурСтандарт_МенеджерНастроек();
	
	РезультатСравнения = МенеджерНастроек.РезультатФункции_ВерсияРежимСовместимостиНеНижеУказанной.Получить(Версия);
	
	Если РезультатСравнения = Неопределено Тогда
		
		ВерсияРежимаСовместимости = СтрЗаменить(ВерсияРежимаСовместимости, "Версия", "");
		ВерсияРежимаСовместимости = СтрЗаменить(ВерсияРежимаСовместимости, "Version", "");
		ВерсияРежимаСовместимости = СтрЗаменить(ВерсияРежимаСовместимости, "_", ".");
		
		РезультатСравнения = (КонтурСтандарт_СравнитьВерсии(ВерсияРежимаСовместимости, Версия) >= 0);  
		
		МенеджерНастроек.РезультатФункции_ВерсияРежимСовместимостиНеНижеУказанной.Вставить(Версия, РезультатСравнения);
		
	КонецЕсли;
	
	Возврат РезультатСравнения;  
	
КонецФункции

// Определяет режим эксплуатации информационной базы файловый (Истина) или серверный (Ложь).
// При проверке используется СтрокаСоединенияИнформационнойБазы, которую можно указать явно.
//
// См. ОбщегоНазначения.ИнформационнаяБазаФайловая
//
// Параметры:
//  СтрокаСоединенияИнформационнойБазы - Строка - параметр используется, если
//                 нужно проверить строку соединения не текущей информационной базы.
//
// Возвращаемое значение:
//  Булево - Истина, если файловая.
//
Функция КонтурСтандарт_ИнформационнаяБазаФайловая(Знач СтрокаСоединенияИнформационнойБазы = "") Экспорт
	
	Если ПустаяСтрока(СтрокаСоединенияИнформационнойБазы) Тогда
		СтрокаСоединенияИнформационнойБазы =  СтрокаСоединенияИнформационнойБазы();
	КонецЕсли;
	Возврат Найти(Врег(СтрокаСоединенияИнформационнойБазы), "FILE=") = 1;
	
КонецФункции    

// Разбивает строку на несколько строк, используя заданный набор разделителей.
// Если параметр РазделителиСлов не задан, то разделителем слов считается любой из символов, 
// не относящихся к символам латиницы, кириллицы, цифры, подчеркивания.
//
// Параметры:
//  Значение        - Строка - исходная строка, которую необходимо разложить на слова.
//  РазделителиСлов - Строка - перечень символов-разделителей. Например, ".,;".
//
// Возвращаемое значение:
//  Массив - список слов.
//
// Пример:
//  СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов("один-@#два2_!три") возвратит массив значений: "один",
//  "два2_", "три"; СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов("один-@#два2_!три", "#@!_") возвратит массив
//  значений: "один-", "два2", "три".
//
Функция КонтурСтандарт_РазложитьСтрокуВМассивСлов(Знач Строка, РазделителиСлов="", РазделительКакЕдиныйСимвол = Ложь) Экспорт
	
	Слова = Новый Массив;
	
	ДлинаРазделителя = СтрДлина(РазделителиСлов);
	
	Если ДлинаРазделителя = 1 ИЛИ РазделительКакЕдиныйСимвол Тогда
		
		НайденныйСимвол = Найти(Строка,РазделителиСлов);
		Пока НайденныйСимвол>0 Цикл
			Слова.Добавить(СокрЛП(Лев(Строка,НайденныйСимвол + ДлинаРазделителя - 2)));
			Строка = Сред(Строка,НайденныйСимвол + ДлинаРазделителя);
			НайденныйСимвол = Найти(Строка,РазделителиСлов);
		КонецЦикла;
		
		Если НЕ ПустаяСтрока(Строка) Тогда
			Слова.Добавить(СокрЛП(Строка));
		КонецЕсли;
		
	Иначе
		
		Для Сч = 1 По СтрДлина(РазделителиСлов) Цикл
			Строка = СтрЗаменить(Строка,Сред(РазделителиСлов,Сч,1),Символы.ПС);
		КонецЦикла;
		
		Для Сч=1 По СтрЧислоСтрок(Строка) Цикл
			ТекСлово = СокрЛП(СтрПолучитьСтроку(Строка,Сч));
			Если ТекСлово<>"" Тогда
				Слова.Добавить(СокрЛП(ТекСлово));
			КонецЕсли;	
		КонецЦикла;	
		
	КонецЕсли;
	
	Возврат Слова;
	
КонецФункции 

// Проверят что переданная строка содержит цифры.
// 
// Параметры:
//  Стр - Строка - проверяемая строка .
// 
// Возвращаемое значение:
//   Булево - результат проверки.
//
Функция КонтурСтандарт_ЕстьЦифрыВСтроке(Стр) Экспорт
	
	Для к = 1 По СтрДлина(Стр) Цикл 
		Если Найти("0123456789",Сред(Стр,к,1))<>0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
			
КонецФункции

// Кодирует строку в соответствии с выбранным способом кодирования.
// 
// Параметры:
//  Строка - Строка - Кодируемая строка.
//  пСпособКодированияСтроки - Строка - см. метод КонтурСтандарт_СпособКодированияСтроки
//
// Возвращаемое значение:
//   Строка - результат кодирования.
//
Функция КонтурСтандарт_КодироватьСтроку_(пСтрока, пСпособКодированияСтроки) Экспорт 
	
	Если КонтурСтандарт_ДоступныБазовыеСтроковыеФункции() Тогда  
		
		Если НЕ пСпособКодированияСтроки = КонтурСтандарт_СпособКодированияСтроки().URLВКодировкеURL
			И НЕ пСпособКодированияСтроки = КонтурСтандарт_СпособКодированияСтроки().КодировкаURL Тогда
			
			ВызватьИсключение "Неверно задан способ кодирования строки";
			
		КонецЕсли;

		Возврат Вычислить("КодироватьСтроку(пСтрока, СпособКодированияСтроки[пСпособКодированияСтроки])");
		
	Иначе
		
		Возврат КонтурСтандарт_URLEncode(пСтрока, пСпособКодированияСтроки = КонтурСтандарт_СпособКодированияСтроки().КодировкаURL);
		
	КонецЕсли;
	
КонецФункции    

// Раскодирует строку, закодированную в соответствии с указанным способом кодирования.
// 
// Параметры:
//  Строка - Строка - Закодированная строка.
//  пСпособКодированияСтроки - Строка - способ, которым была закодирована исходная строка. см. метод КонтурСтандарт_СпособКодированияСтроки
//
// Возвращаемое значение:
//   Строка - раскодированная исходная строка.
//
Функция КонтурСтандарт_РаскодироватьСтроку_(пСтрока, пСпособКодированияСтроки) Экспорт
	
	Если КонтурСтандарт_ДоступныБазовыеСтроковыеФункции() Тогда
		
		Если НЕ пСпособКодированияСтроки = КонтурСтандарт_СпособКодированияСтроки().URLВКодировкеURL
			И НЕ пСпособКодированияСтроки = КонтурСтандарт_СпособКодированияСтроки().КодировкаURL Тогда
			
			ВызватьИсключение "Неверно задан способ кодирования строки";
			
		КонецЕсли;
		
		Возврат Вычислить("РаскодироватьСтроку(пСтрока, СпособКодированияСтроки[пСпособКодированияСтроки])");	
		
	Иначе
		
		Возврат КонтурСтандарт_URLDecode(пСтрока);
		
	КонецЕсли;
	
КонецФункции

// Варианты кодирования строк.
// 
// Возвращаемое значение:
//   Строка - "URLВКодировкеURL", "КодировкаURL".
//
Функция КонтурСтандарт_СпособКодированияСтроки() Экспорт
	
	Структура = Новый Структура(); 
	
	Структура.Вставить("URLВКодировкеURL", "URLВКодировкеURL");
	Структура.Вставить("КодировкаURL", "КодировкаURL");
	                                    
	Возврат Структура; 
	
КонецФункции

// Преобразует переданное число в указанную систему счисления.
// 
// Параметры:
//  Данные - Число - преобразуемое число.
//  Основание - Число - число системы счисления
//
// Возвращаемое значение:
//   Строка - результат преобразования в указанную систему счисления.
//
Функция КонтурСтандарт_ЧислоВСистемеСчисления(Знач Данные, Основание) Экспорт
	
	Словарь = КонтурСтандарт_СловарьСистемыСчисления();
	
	Результат = "";
	Пока Данные > 0 Цикл
		Результат = XMLСтрока(Словарь.Получить(Данные % Основание)) + Результат;

		Данные = Цел(Данные/Основание);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Преобразует переданную строку системы счисления в число.
// 
// Параметры:
//  Данные - Строка - преобразуемые данные в системе счисления.
//  Основание - Число - число системы счисления
//
// Возвращаемое значение:
//   Число - результат преобразования в указанную систему счисления.
//
Функция КонтурСтандарт_ЧислоИзСистемыСчисления(Знач Данные, Основание) Экспорт
	
	Словарь = КонтурСтандарт_СловарьСистемыСчисления();
	ДанныеСтроки = XMLСтрока(ВРег(Данные));
	
	Результат = 0;
	
	Длина = СтрДлина(ДанныеСтроки);
	Для Разряд = 0 По СтрДлина(ДанныеСтроки) - 1 Цикл
		
		ЧислоСловаря = Словарь.Получить(Сред(ДанныеСтроки, Длина - Разряд, 1));
		
		Если ЧислоСловаря >= Основание Тогда
			ВызватьИсключение "Недопустимый символ в данных " + Сред(ДанныеСтроки, Длина - Разряд, 1);	
		КонецЕсли;
		
		Результат = Результат + ЧислоСловаря * Pow(Основание, Разряд);   
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Создаёт объект ФабрикаXDTO по переданному описанию xsd-схемы
//
// Параметры:
//  СтрокаXML - Строка - xml-текст xsd-схемы.
//
// Возвращаемое значение:
//   ФабрикаXDTO - объект ФабрикаXDTO по переданной xsd-схеме.
//
Функция КонтурСтандарт_ФабрикаXDTO(СтрокаXML) Экспорт
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(СтрокаXML);
	
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
	
	ПостроительСхемXML = Новый ПостроительСхемXML;
	СхемаXML = ПостроительСхемXML.СоздатьСхемуXML(ДокументDOM);
	
	НаборСхемXML = Новый НаборСхемXML;
	НаборСхемXML.Добавить(СхемаXML);
	
	Результат = Новый ФабрикаXDTO(НаборСхемXML);
	
	Возврат Результат;
	
КонецФункции		  

// Возвращает пустой объект XDTO по переданному типу пакета XDTO фабрики
//
// Параметры:
//  Фабрика - ФабрикаXDTO - фабрика.
//  ТипПакетаXDTO - Строка - имя пакета XDTO.
//  ПространствоИмен - Строка - имя пространства имен.
//
// Возвращаемое значение:
//   ОбъектXDTO - пустой объект ОбъектXDTO по переданному типу пакета. 
//
Функция КонтурСтандарт_ПолучитьПустойОбъектXDTO(Фабрика, ТипПакетаXDTO, ПространствоИмен = "http://www.w3.org/2001/XMLSchema") Экспорт
	
	Результат = Неопределено;

	ЧастиПути = КонтурСтандарт_РазложитьСтрокуВМассивСлов(ТипПакетаXDTO, ".");
	
	ТипОбъекта = Фабрика.Тип(ПространствоИмен, ЧастиПути[0]);
	
	ЧастиПути.Удалить(0);
	
	Коллекция = ТипОбъекта.Свойства;
	
	Пока ЗначениеЗаполнено(ЧастиПути) Цикл
		
		Если Коллекция = Неопределено Тогда
			ТипОбъекта = Неопределено;
			Прервать;
		КонецЕсли;
		
		Свойство = Коллекция.Получить(ЧастиПути[0]);
		
		Если Свойство = Неопределено Тогда
			ТипОбъекта = Неопределено;
			Прервать;
		КонецЕсли;
		
		ТипОбъекта = Свойство.Тип;
		
		ЧастиПути.Удалить(0);
		
		Попытка
			Коллекция = ТипОбъекта.Свойства;
		Исключение
			Прервать;
		КонецПопытки;
		
	КонецЦикла;
	
	Если ТипОбъекта <> Неопределено Тогда
		Результат = Фабрика.Создать(ТипОбъекта);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет наличие реквизита в объекте XDTO и устанавливает значение реквизита
//
// Параметры:
//  Элемент - ОбъектXDTO - объект XDTO.
//  ИмяРеквизита - Строка - имя реквизита.
//  ЗначениеРеквизита - Произвольный - значение реквизита.
//
Процедура КонтурСтандарт_УстановитьЗначениеXDTO(Элемент, ИмяРеквизита, ЗначениеРеквизита) Экспорт
	
	Если ЗначениеРеквизита = Неопределено
		Или ЗначениеРеквизита = Null Тогда
		Возврат;
	КонецЕсли;
	
	Элемент[ИмяРеквизита] = ЗначениеРеквизита;
	
КонецПроцедуры

// Конвертирует объект XDTO в строку XML
//
// Параметры:
//  Фабрика - ФабрикаXDTO - фабрика.
//  ОбъектXDTO - объект XDTO - объект XDTO.
//  ТипКодировки - Строка - тип кодировки.
//
// Возвращаемое значение:
//   Строка - строка XML преобразованного объекта XDTO. 
//
Функция КонтурСтандарт_ОбъектXDTO_В_СтрокаXML(Фабрика, ОбъектXDTO, ТипКодировки = "windows-1251") Экспорт
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку(ТипКодировки);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	Фабрика.ЗаписатьXML(ЗаписьXML, ОбъектXDTO,,,, НазначениеТипаXML.Неявное);
	
	СтрокаXML = ЗаписьXML.Закрыть();
	
	Возврат СтрокаXML;	
	
КонецФункции

// Создаёт дочерний объект в переданном объекте XDTO по имени и указанной фабрике
//
// Параметры:
//  Фабрика - ФабрикаXDTO - фабрика.
//  Родитель - ОбъектXDTO - объект XDTO.
//  ИмяЭлемента - Строка - имя элемента.
//  ЗначениеЭлемента - Произвольный - значение элемента.
//
// Возвращаемое значение:
//   ОбъектXDTO - созданный объект. 
//
Функция КонтурСтандарт_НовыйДочернийОбъектXDTO(Фабрика, Родитель, ИмяЭлемента, ЗначениеЭлемента = Неопределено) Экспорт
	
	СвойствоДочернего	 = Родитель.Тип().Свойства.Получить(ИмяЭлемента);
	ТипДочернего		 = СвойствоДочернего.Тип;
	ЭтоСписок			 = СвойствоДочернего.ВерхняяГраница <> 1;
	
	Если ЗначениеЭлемента = Неопределено Тогда
		Результат = Фабрика.Создать(ТипДочернего);
	Иначе
		Результат = Фабрика.Создать(ТипДочернего, ЗначениеЭлемента);
	КонецЕсли;
	
	Если ЭтоСписок Тогда
		Родитель[ИмяЭлемента].Добавить(Результат);
	Иначе
		Родитель[ИмяЭлемента] = Результат;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает преобразованные данные JSON
//
// Параметры:
//  Строка                       - Строка         - Строка, содержащая текст в формате JSON.
//  ПрочитатьВСоответствие       - Булево         - Если установлено Истина, чтение объекта JSON будет выполнено в Соответствие
//
// Возвращаемое значение:
//  Структура, Соответствие - преобразованные данные JSON в типы «1С:Предприятия».
//
Функция КонтурСтандарт_ЗначениеИзСтрокиJSON(Знач Строка, ПрочитатьВСоответствие = Ложь) Экспорт 
	
	Если ТипЗнч(Строка) = Тип("ДвоичныеДанные") Тогда
		Строка = КонтурСтандарт_ПолучитьСтрокуИзДвоичныхДанных_(Строка);	
	КонецЕсли;
	
	Если КонтурСтандарт_ДоступныЗаписьЧтениеJSON() Тогда 
		
		ЧтениеJSON = Вычислить("Новый ЧтениеJSON");
		ЧтениеJSON.УстановитьСтроку(Строка);	
		
		Результат = Вычислить("ПрочитатьJSON(ЧтениеJSON, " + XMLСтрока(ПрочитатьВСоответствие) + ", , , ""КонтурСтандарт_ФункцияВосстановленияJSON"", ЭтотОбъект)");	
		
	Иначе   
		
		Результат = КонтурСтандарт_ПрочитатьJSON_Совместимость(Строка, ПрочитатьВСоответствие);
		
	КонецЕсли;   
	
	Возврат Результат;
	
КонецФункции

// Возвращает сериализованное значение в формат JSON
//
// Параметры:
//  Значение - Произвольный	 - Объект записи JSON. Меняет состояние потока записи.
//                             Представляет собой значение произвольного типа.
//
// Возвращаемое значение:
//  Строка - возвращает сериализованное <Значение> в формат JSON.
//
Функция КонтурСтандарт_ЗначениеВСтрокуJSON(Значение) Экспорт 
	        
	Если КонтурСтандарт_ДоступныЗаписьЧтениеJSON() Тогда 
		
		НастройкиСериализации = Вычислить("Новый НастройкиСериализацииJSON");
		НастройкиСериализации.ВариантЗаписиДаты		 = Вычислить("ВариантЗаписиДатыJSON.УниверсальнаяДата");	
		НастройкиСериализации.ФорматСериализацииДаты = Вычислить("ФорматДатыJSON.ISO");
		НастройкиСериализации.СериализовыватьМассивыКакОбъекты = Ложь;
		
		ЗаписьJSON = Вычислить("Новый ЗаписьJSON");
		ЗаписьJSON.УстановитьСтроку();
		
		Выполнить("ЗаписатьJSON(ЗаписьJSON, Значение, НастройкиСериализации)");	
		
		Результат = ЗаписьJSON.Закрыть();	
		
	Иначе   
		
		Результат = КонтурСтандарт_ЗаписатьJSON_Совместимость(Значение);
		
	КонецЕсли;


	Возврат Результат; 

КонецФункции

// Возвращает дату преобразованную из тиков
//
// Параметры:
//  Ticks - Число	 - количество в тиках.
//
// Возвращаемое значение:
//  Дата - дата преобразованная из числа тиков.
//
Функция КонтурСтандарт_Ticks_To_Date(Ticks) Экспорт
	
	КоличествоТиковВМиллисекунде = 10000;
	КоличествоМиллисекундВСекунде = 1000;
	
	Результат = XMLЗначение(Тип("Дата"), XMLСтрока('00010101' + Ticks / (КоличествоТиковВМиллисекунде * КоличествоМиллисекундВСекунде)));
	
	Возврат Результат;
	
КонецФункции

// Возвращает количество тиков из даты
//
// Параметры:
//  Date - Дата	- дата и время.
//
// Возвращаемое значение:
//  Число - возвращает преобразованное значение даты в тиках.
//
Функция КонтурСтандарт_Date_To_Ticks(Date) Экспорт
	
	КоличествоТиковВМиллисекунде = 10000;
	КоличествоМиллисекундВСекунде = 1000;

	Результат = Формат((Дата(Date) - '00010101') * КоличествоТиковВМиллисекунде * КоличествоМиллисекундВСекунде, "ЧГ=");
	
	Возврат Результат;
	
КонецФункции

// Возвращает разность массивов. Разностью двух массивов является массив, содержащий
// все элементы первого массива, не существующие во втором массиве.
//
// Параметры:
//  Массив - Массив - массив элементов, из которого необходимо выполнить вычитание;
//  МассивВычитания - Массив - массив элементов, который будет вычитаться.
// 
// Возвращаемое значение:
//  Массив - разностью двух массивов.
//
// Пример:
//	//А = [1, 3, 5, 7];
//	//В = [3, 7, 9];
//	Результат = ОбщегоНазначенияКлиентСервер.РазностьМассивов(А, В);
//	//Результат = [1, 5];
//
Функция КонтурСтандарт_РазностьМассивов(Знач Массив, Знач МассивВычитания) Экспорт
	
	Результат = Новый Массив;
	Для Каждого Элемент Из Массив Цикл
		Если МассивВычитания.Найти(Элемент) = Неопределено Тогда
			Результат.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

// Удаляет из входной строки недопустимые символы.
//
// Параметры:
//  Строка - Строка - исходная строка, из которой требуется удалить недопустимые символы.
//  НедопустимыеСимволы  - Строка - строка содержащая символы, которые нужно удалить из исходной строки. 
//                         Если параметр опущен, символы по умолчанию: ""'`/\[]{}:;|-=?*<>,.()+#№@!%^&~«» .
//
// Возвращаемое значение:
//   Строка - копия исходной строки с удаленными недопустимыми символами
//
//  Пример:
//  	ИмяФайла = "ООО "ТД" "Радости жизни"";
//		НедопустимыеСимволы = "/\""";
//      Результат "ООО ТД Радости жизни"
//
Функция КонтурСтандарт_УдалитьНедопустимыеСимволы(Строка, НедопустимыеСимволы = "") Экспорт
	
	Если ПустаяСтрока(НедопустимыеСимволы) Тогда
		НедопустимыеСимволы = """'`/\[]{}:;|-=?*<>,.()+#№@!%^&~«» ";	
	КонецЕсли;                
	
	МассивСимволов = КонтурСтандарт_СтрРазделить_(Строка, НедопустимыеСимволы);
	
	Возврат КонтурСтандарт_СтрСоединить_(МассивСимволов, "");

КонецФункции

// #КонецОбласти

// #Область Служебный_интерфейс

Функция КонтурСтандарт_НовыйМенеджерНастроек()
	
	МенеджерНастроек = Новый Структура;
	
    МенеджерНастроек.Вставить("РезультатФункции_ВерсияПлатформыНеНижеУказанной");
	МенеджерНастроек.Вставить("РезультатФункции_ВерсияРежимСовместимостиНеНижеУказанной");
	
	Возврат МенеджерНастроек;
	
КонецФункции

Функция КонтурСтандарт_СтрРазделить_Совместимость(Строка, Разделитель, ВключатьПустые = Истина)
	
	ПропускатьПустыеСтроки = НЕ ВключатьПустые;	
	Результат = Новый Массив;
	
	НачалоСтроки = 1;
	
	Для Позиция = 1 По СтрДлина(Строка) Цикл 
		Символ = Сред(Строка, Позиция, 1);
		Если Найти(Разделитель, Символ) > 0 Тогда
			Результат.Добавить(Сред(Строка, НачалоСтроки, Позиция - НачалоСтроки));	
			НачалоСтроки = Позиция + 1;
		КонецЕсли;
	КонецЦикла;
	
	Значение = Сред(Строка, НачалоСтроки, Позиция - НачалоСтроки);
	Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Значение) Тогда
		Результат.Добавить(Значение);
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

// Вставляет параметры в строку, учитывая, что в параметрах могут использоваться подстановочные слова %1, %2 и т.д. 
Функция КонтурСтандарт_ПодставитьПараметрыСПроцентом(Знач СтрокаПодстановки, Знач Параметр1, Знач Параметр2 = Неопределено, Знач Параметр3 = Неопределено,	
													Знач Параметр4 = Неопределено, Знач Параметр5 = Неопределено, Знач Параметр6 = Неопределено,
													Знач Параметр7 = Неопределено, Знач Параметр8 = Неопределено, Знач Параметр9 = Неопределено,
													Знач Параметр10 = Неопределено)
	
	Результат = "";
	Позиция = КонтурСтандарт_СтрНайти_(СтрокаПодстановки, "%");
		
	КартаПараметров = Новый Соответствие;
	КартаПараметров.Вставить("1", Параметр1);
	КартаПараметров.Вставить("(1)", Параметр1);
	КартаПараметров.Вставить("2", Параметр2);
	КартаПараметров.Вставить("(2)", Параметр2);
	КартаПараметров.Вставить("3", Параметр3);
	КартаПараметров.Вставить("(3)", Параметр3);
	КартаПараметров.Вставить("4", Параметр4);
	КартаПараметров.Вставить("(4)", Параметр4);
	КартаПараметров.Вставить("5", Параметр5);
	КартаПараметров.Вставить("(5)", Параметр5);
	КартаПараметров.Вставить("6", Параметр6);
	КартаПараметров.Вставить("(6)", Параметр6);
	КартаПараметров.Вставить("7", Параметр7);
	КартаПараметров.Вставить("(7)", Параметр7);
	КартаПараметров.Вставить("8", Параметр8);
	КартаПараметров.Вставить("(8)", Параметр8);
	КартаПараметров.Вставить("9", Параметр9);
	КартаПараметров.Вставить("(9)", Параметр9);
	КартаПараметров.Вставить("10", Параметр10);
	КартаПараметров.Вставить("(10)", Параметр10);

	Пока Позиция > 0 Цикл
		Результат = Результат + Лев(СтрокаПодстановки, Позиция - 1);
		СимволПослеПроцента = Сред(СтрокаПодстановки, Позиция + 1, 1);
		Если СимволПослеПроцента = "(" Тогда
			СимволПослеПроцента = Сред(СтрокаПодстановки, Позиция + 1, КонтурСтандарт_СтрНайти_(СтрокаПодстановки, ")", , Позиция) - Позиция);
		КонецЕсли;
		Если Сред(СтрокаПодстановки, Позиция + 1 + 1, 1) = "0" Тогда
			СимволПослеПроцента = СимволПослеПроцента + "0";
		КонецЕсли;
		ПодставляемыйПараметр = КартаПараметров.Получить(СимволПослеПроцента);
		Если ПодставляемыйПараметр = Неопределено Тогда
			СтрокаПодстановки = Сред(СтрокаПодстановки, Позиция + СтрДлина(СимволПослеПроцента) + 1);
		Иначе
			Результат = Результат + ПодставляемыйПараметр;
			СтрокаПодстановки = Сред(СтрокаПодстановки, Позиция + СтрДлина(СимволПослеПроцента) + 1);
		КонецЕсли;
		Позиция = КонтурСтандарт_СтрНайти_(СтрокаПодстановки, "%");
	КонецЦикла;
	
	Результат = Результат + СтрокаПодстановки;
	
	Возврат Результат;
    
КонецФункции

Функция КонтурСтандарт_СкопироватьСтруктуру(СтруктураИсточник, ФиксироватьДанные) 
	
	СтруктураРезультат = Новый Структура;
	
	Для Каждого КлючИЗначение Из СтруктураИсточник Цикл
		СтруктураРезультат.Вставить(КлючИЗначение.Ключ, 
		КонтурСтандарт_СкопироватьРекурсивно(КлючИЗначение.Значение, ФиксироватьДанные));
	КонецЦикла;
	
	Если ФиксироватьДанные = Истина 
		Или ФиксироватьДанные = Неопределено
		И ТипЗнч(СтруктураИсточник) = Тип("ФиксированнаяСтруктура") Тогда 
		Возврат Новый ФиксированнаяСтруктура(СтруктураРезультат);
	КонецЕсли;
	
	Возврат СтруктураРезультат;
	
КонецФункции

Функция КонтурСтандарт_СкопироватьСоответствие(СоответствиеИсточник, ФиксироватьДанные) 
	
	СоответствиеРезультат = Новый Соответствие;
	
	Для Каждого КлючИЗначение Из СоответствиеИсточник Цикл
		СоответствиеРезультат.Вставить(КлючИЗначение.Ключ, 
		КонтурСтандарт_СкопироватьРекурсивно(КлючИЗначение.Значение, ФиксироватьДанные));
	КонецЦикла;
	
	Если ФиксироватьДанные = Истина 
		Или ФиксироватьДанные = Неопределено
		И ТипЗнч(СоответствиеИсточник) = Тип("ФиксированноеСоответствие") Тогда 
		Возврат Новый ФиксированноеСоответствие(СоответствиеРезультат);
	КонецЕсли;
	
	Возврат СоответствиеРезультат;
	
КонецФункции

Функция КонтурСтандарт_СкопироватьМассив(МассивИсточник, ФиксироватьДанные) 
	
	МассивРезультат = Новый Массив;
	
	Для Каждого Элемент Из МассивИсточник Цикл
		МассивРезультат.Добавить(КонтурСтандарт_СкопироватьРекурсивно(Элемент, ФиксироватьДанные));
	КонецЦикла;
	
	Если ФиксироватьДанные = Истина 
		Или ФиксироватьДанные = Неопределено
		И ТипЗнч(МассивИсточник) = Тип("ФиксированныйМассив") Тогда 
		Возврат Новый ФиксированныйМассив(МассивРезультат);
	КонецЕсли;
	
	Возврат МассивРезультат;
	
КонецФункции

Функция КонтурСтандарт_СкопироватьСписокЗначений(СписокИсточник, ФиксироватьДанные)
	
	СписокРезультат = Новый СписокЗначений;
	
	Для Каждого ЭлементСписка Из СписокИсточник Цикл
		СписокРезультат.Добавить(
		КонтурСтандарт_СкопироватьРекурсивно(ЭлементСписка.Значение, ФиксироватьДанные), 
		ЭлементСписка.Представление, 
		ЭлементСписка.Пометка, 
		ЭлементСписка.Картинка);
	КонецЦикла;
	
	Возврат СписокРезультат;
	
КонецФункции

Функция КонтурСтандарт_URLEncode(стр, КодироватьСпецсимволы = Истина)	
	
	СпецсимволыМассив = КонтурСтандарт_СтрРазделить_("! # $ % & ' ( ) * + , / : ; = ? @ [ ]", " ");
	
	_РежимОтладки = Ложь;
	Если _РежимОтладки Тогда
		Длина = СтрДлина(Стр);
		Итог = "";
		
		Для Н=1 По Длина Цикл
			Знак = Сред(Стр, Н, 1);
			Код = КодСимвола(Знак);
			
			Если ((Знак >= "a") И (Знак <= "z")) или
				((Знак >= "A") И (Знак <= "Z")) или
				((Знак>="0") И (Знак <= "9")) 
				или Знак = "." 
				ИЛИ Знак = "-" 
				ИЛИ Знак = "_" 
				ИЛИ Знак = "~" 
				ИЛИ (НЕ КодироватьСпецсимволы И СпецсимволыМассив.Найти(Знак) <> Неопределено)  тогда
				
				Итог = Итог + Знак;
			Иначе
				Если (Код >= КодСимвола("А")) И (Код <= КодСимвола("п")) Тогда
					Итог = Итог + "%" + КонтурСтандарт_ЧислоВСистемеСчисления(208, 16) + "%" + КонтурСтандарт_ЧислоВСистемеСчисления(144 + Код - КодСимвола("А"), 16);
				ИначеЕсли (Код >= КодСимвола("р")) И (Код <= КодСимвола("я")) Тогда
					Итог = Итог + "%" + КонтурСтандарт_ЧислоВСистемеСчисления(209, 16) + "%" + КонтурСтандарт_ЧислоВСистемеСчисления(128 + Код - КодСимвола("р"), 16);
				ИначеЕсли (Знак = "ё") Тогда
					Итог = Итог + "%" + КонтурСтандарт_ЧислоВСистемеСчисления(209, 16) + "%" + КонтурСтандарт_ЧислоВСистемеСчисления(145, 16);
				ИначеЕсли (Знак="Ё") Тогда
					Итог = Итог + "%" + КонтурСтандарт_ЧислоВСистемеСчисления(208, 16) + "%" + КонтурСтандарт_ЧислоВСистемеСчисления(129, 16);
				Иначе
					Итог = Итог + "%" + КонтурСтандарт_ЧислоВСистемеСчисления(Код, 16);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Возврат Итог;
	Иначе  
		Длина = СтрДлина(Стр);		Итог = "";				Для Н=1 По Длина Цикл			Знак = Сред(Стр, Н, 1);			Код = КодСимвола(Знак);						Если ((Знак >= "a") И (Знак <= "z")) или				((Знак >= "A") И (Знак <= "Z")) или				((Знак>="0") И (Знак <= "9")) 				или Знак = "." 				ИЛИ Знак = "-" 				ИЛИ Знак = "_" 				ИЛИ Знак = "~" 				ИЛИ (НЕ КодироватьСпецсимволы И СпецсимволыМассив.Найти(Знак) <> Неопределено)  тогда								Итог = Итог + Знак;			Иначе				Если (Код >= КодСимвола("А")) И (Код <= КодСимвола("п")) Тогда					Итог = Итог + "%" + КонтурСтандарт_ЧислоВСистемеСчисления(208, 16) + "%" + КонтурСтандарт_ЧислоВСистемеСчисления(144 + Код - КодСимвола("А"), 16);				ИначеЕсли (Код >= КодСимвола("р")) И (Код <= КодСимвола("я")) Тогда					Итог = Итог + "%" + КонтурСтандарт_ЧислоВСистемеСчисления(209, 16) + "%" + КонтурСтандарт_ЧислоВСистемеСчисления(128 + Код - КодСимвола("р"), 16);				ИначеЕсли (Знак = "ё") Тогда					Итог = Итог + "%" + КонтурСтандарт_ЧислоВСистемеСчисления(209, 16) + "%" + КонтурСтандарт_ЧислоВСистемеСчисления(145, 16);				ИначеЕсли (Знак="Ё") Тогда					Итог = Итог + "%" + КонтурСтандарт_ЧислоВСистемеСчисления(208, 16) + "%" + КонтурСтандарт_ЧислоВСистемеСчисления(129, 16);				Иначе					Итог = Итог + "%" + КонтурСтандарт_ЧислоВСистемеСчисления(Код, 16);				КонецЕсли;			КонецЕсли;		КонецЦикла;				Возврат Итог;
	КонецЕсли;
	
КонецФункции

Функция КонтурСтандарт_URLDecode(URL)
	
	ДлинаСтроки = СтрДлина(URL);
	Инд = 1;
	Результат = "";
	ПолныйКод = 0;
	ОсталосьСимволов = 0;
	
	Пока Инд <= ДлинаСтроки Цикл
		
		Код = КодСимвола(URL, Инд);
		
		Если Код = 37 Тогда
			// Символ(37) = «%»
			Код = КонтурСтандарт_ЧислоИзСистемыСчисления(Сред(URL, Инд+1, 2), 16);
			Инд = Инд + 2;
		ИначеЕсли ОсталосьСимволов = 0 Тогда   
			Результат = Результат + Символ(Код);
			Инд = Инд + 1;
			Продолжить;
		КонецЕсли;
		
		Если Код <= 127 Тогда
			// Код = 0b0ххххххх
			Результат = Результат + Символ(Код);
		ИначеЕсли Код <= 191 Тогда
			// Код = 0b10хххххх
			ПолныйКод = (ПолныйКод*64) + (Код%64); // shl(ПолныйКод, 6) + (Код & 0x3F)
			ОсталосьСимволов = ОсталосьСимволов - 1;
			Если ОсталосьСимволов = 0 Тогда
				Результат = Результат + Символ(ПолныйКод);
			КонецЕсли;
		ИначеЕсли Код <= 223 Тогда
			// Код = 0b110ххххх
			ПолныйКод = Код % 32; // Код & 0x1F
			ОсталосьСимволов = 1;
		ИначеЕсли Код <= 239 Тогда
			// Код = 0b1110хххх
			ПолныйКод = Код % 16; // Код & 0x0F
			ОсталосьСимволов = 2;
		ИначеЕсли Код <= 247 Тогда
			// Код = 0b11110ххх
			ПолныйКод = Код % 8; // Код & 0x07
			ОсталосьСимволов = 3;
		ИначеЕсли Код <= 251 Тогда
			// Код = 0b111110хх
			ПолныйКод = Код % 4; // Код & 0x03
			ОсталосьСимволов = 4;
		ИначеЕсли Код <= 253 Тогда
			// Код = 0b1111110х
			ПолныйКод = Код % 2; // Код & 0x01
			ОсталосьСимволов = 5;
		КонецЕсли;
		
		Инд = Инд + 1;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция КонтурСтандарт_СловарьСистемыСчисления()
	
	Результат = Новый Соответствие;
	Источник = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	Для НомерСимвола = 1 По СтрДлина(Источник) Цикл
		Результат.Вставить(НомерСимвола - 1, Сред(Источник, НомерСимвола, 1));
		Результат.Вставить(Сред(Источник, НомерСимвола, 1), НомерСимвола - 1);	
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция КонтурСтандарт_ПрочитатьJSON_Совместимость(ЗНАЧ Текст, ПрочитатьВСоответствие = Ложь) Экспорт
	
	Перем Замены;
	
	// Выполним замену экранируемых символов. Конечно же, такие гуиды в тексте никогда не встретятся ))
	Замены = Новый Массив;
	Замены.Добавить(Новый Структура("Что,Чем",	"\\",	Строка(Новый УникальныйИдентификатор)));
	Замены.Добавить(Новый Структура("Что,Чем",	"\""",	Строка(Новый УникальныйИдентификатор)));
	
	КонтурСтандарт_ВыполнитьЗаменыДоОбработки(Текст,Замены);
	
	// Нарежем текст на куски, он будет быстрее обрабатываться
	СимволыДляПереноса = "{}[]:,";
	Для Сч=1 По СтрДлина(СимволыДляПереноса) Цикл
		ТекСимвол = Сред(СимволыДляПереноса, Сч, 1);
		Текст = СтрЗаменить(Текст, ТекСимвол, Символы.ПС + ТекСимвол + Символы.ПС);
	КонецЦикла;
	
	// Преобразуем текст в Массив строк, так обрабатывается гораздо быстрее
	МассивСтрок = КонтурСтандарт_ТекстВМассивСтрок(Текст);
	
	ВсегоСтрок = МассивСтрок.Количество();
	НомерТекущейСтроки = 1;
	
	// Распарсим
	Результат = КонтурСтандарт_ОбработатьТекущееЗначение(НомерТекущейСтроки, ВсегоСтрок, МассивСтрок, ПрочитатьВСоответствие);
	
	// Вернем на место экранированные символы.
	КонтурСтандарт_ВыполнитьЗаменыПослеОбработки(Результат, Замены);
	
	Возврат Результат;
	
КонецФункции

Процедура КонтурСтандарт_ВыполнитьЗаменыДоОбработки(Текст, Замены)
	
	// Экранируются только 2 символа: \ "
	// Экранируются, причем, символом \
	
	// "Name": "Тест [ , %  / \\ \" {",

	Для Каждого Элемент Из Замены Цикл
		
		Текст = СтрЗаменить(Текст,Элемент.Что, Элемент.Чем);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура КонтурСтандарт_ВыполнитьЗаменыПослеОбработки(Результат, Замены)
	
	ТекстСЗаменами = ЗначениеВСтрокуВнутр(Результат);

	Для Каждого Элемент Из Замены Цикл
		
		Если Элемент.Что = "\\" Тогда
			ТекстСЗаменами = СтрЗаменить(ТекстСЗаменами, Элемент.Чем, "\");
		ИначеЕсли Элемент.Что = "\""" Тогда
			ТекстСЗаменами = СтрЗаменить(ТекстСЗаменами, Элемент.Чем, """""");
		КонецЕсли;
		
	КонецЦикла;
	
	Результат = ЗначениеИзСтрокиВнутр(ТекстСЗаменами);
	
КонецПроцедуры

Функция КонтурСтандарт_ОбработатьТекущееЗначение(НомерТекущейСтроки, ВсегоСтрок, МассивСтрок, ПрочитатьВСоответствие = Ложь)
	
	Пока НомерТекущейСтроки <= ВсегоСтрок Цикл
		
		ТекСтрока = СокрЛП(МассивСтрок[НомерТекущейСтроки]);
	
		Если ПустаяСтрока(ТекСтрока) Тогда
			
			НомерТекущейСтроки = НомерТекущейСтроки + 1;
			Продолжить;
			
		ИначеЕсли СтрДлина(ТекСтрока) = 1 Тогда
			
			Если ТекСтрока = "{" Тогда
				
				// Начинается новая структура.
				Результат = КонтурСтандарт_ОбработатьНовуюСтруктуру(НомерТекущейСтроки, ВсегоСтрок, МассивСтрок, ПрочитатьВСоответствие);
				Возврат Результат;
				
			ИначеЕсли ТекСтрока = "[" Тогда
				
				// Начинается новый массив.
				Результат = КонтурСтандарт_ОбработатьНовыйМассив(НомерТекущейСтроки, ВсегоСтрок, МассивСтрок, ПрочитатьВСоответствие);
				Возврат Результат;
				
			ИначеЕсли ТекСтрока = "," или ТекСтрока = ":" Тогда
			//	или ТекСтрока="""" Тогда
				
				// пустота, идем дальше
				
			Иначе// Таки значение
				
				Результат = КонтурСтандарт_ОбработатьКонечноеЗначение(НомерТекущейСтроки, ВсегоСтрок, МассивСтрок);
				Возврат Результат;
				
			КонецЕсли;
				
		ИначеЕсли СокрЛП(ТекСтрока = "") Тогда
			
				// Пустота, идем дальше
				
		Иначе
			
			// Мы попадаем на конечное значение. Оно может быть в кавычках или без
			Результат = КонтурСтандарт_ОбработатьКонечноеЗначение(НомерТекущейСтроки, ВсегоСтрок, МассивСтрок);
			Возврат Результат;
			
		КонецЕсли;
		
		НомерТекущейСтроки = НомерТекущейСтроки + 1;
		
	КонецЦикла;
	
КонецФункции

Функция КонтурСтандарт_ОбработатьКонечноеЗначение(НомерТекущейСтроки, ВсегоСтрок, МассивСтрок)
	
	// В этой строке может быть: одна кавычка, две, ноль
	НачальнаяСтрока = СокрЛП(МассивСтрок[НомерТекущейСтроки]);
	КавычкаОткрыта = (Лев(НачальнаяСтрока, 1) = """");
	КавычкаЗакрыта = (Прав(НачальнаяСтрока, 1) = """") И СтрДлина(НачальнаяСтрока) > 1;
	ЧислоКавычек = 0;
	
	Если КавычкаОткрыта И КавычкаЗакрыта Тогда
		
		Результат = НачальнаяСтрока;
		Результат = СтрЗаменить(Результат, """", "");
		
	ИначеЕсли Не КавычкаЗакрыта И не КавычкаОткрыта Тогда
		
		// Тут еще будут преобразования: булево, числа, даты
		Результат = НачальнаяСтрока;
		
		Если Результат = "true" Тогда
			Возврат Истина;
		ИначеЕсли Результат = "false" Тогда
			Возврат Ложь;
		ИначеЕсли КонтурСтандарт_ЭтоЧисло(Результат) Тогда
			Возврат Число(Результат); 
		ИначеЕсли Результат = "null" И ЧислоКавычек = 0 Тогда
			Возврат Неопределено;	
		КонецЕсли;
		
		Возврат Результат;
		
	Иначе// Многострочное значение, склеим
		//и оно началось с кавычки
		
		Результат = НачальнаяСтрока;
		Пока НомерТекущейСтроки < ВсегоСтрок Цикл
			
			НомерТекущейСтроки = НомерТекущейСтроки + 1;
		
			ТекСтрока = МассивСтрок[НомерТекущейСтроки];
			
			Результат = Результат + ТекСтрока;
			
			Если Найти(ТекСтрока, """") > 0 Тогда 
				Результат = СокрЛП(Сред(Результат, 2, СтрДлина(Результат) - 2));// уберем левую и правую кавычку
				Возврат КонтурСтандарт_ЗначениеJSON(Результат);// Вернемся тогда, когда значение кончится, т.е. встретится кавычка (мы ведь все экранированные кавычки поменяли на гуиды)
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КонтурСтандарт_ОбработатьНовуюСтруктуру(НомерТекущейСтроки, ВсегоСтрок, МассивСтрок, ПрочитатьВСоответствие = Ложь)
	Если ПрочитатьВСоответствие Тогда
		Результат = Новый Соответствие; 	
	Иначе		
		Результат = Новый Структура;     
	КонецЕсли;
	
	Пока НомерТекущейСтроки < ВсегоСтрок Цикл
		
		НомерТекущейСтроки = НомерТекущейСтроки + 1;
		
		ТекСтрока = МассивСтрок[НомерТекущейСтроки];
		
		Если ТекСтрока = "}" Тогда
			// Структура закончилась
			Возврат Результат;

		ИначеЕсли ТекСтрока = "," Тогда
			
			Продолжить;// Дальше должен быть еще одна пара ключ-значение
			
		ИначеЕсли СокрЛП(ТекСтрока) = "" Тогда//пробелы и т.д.
			
			Продолжить;
			
		Иначе// Будем считать, что началась пара ключ-значение
			
			НомерТекущейСтроки = НомерТекущейСтроки + 1;
			ТекЗначение = КонтурСтандарт_ОбработатьТекущееЗначение(НомерТекущейСтроки, ВсегоСтрок, МассивСтрок, ПрочитатьВСоответствие);
			Результат.Вставить(СтрЗаменить(ТекСтрока, """", ""),ТекЗначение);

		КонецЕсли;
	
	КонецЦикла;
	
	НомерТекущейСтроки = НомерТекущейСтроки + 1;
	
	Возврат Результат;
	
КонецФункции

Функция КонтурСтандарт_ОбработатьНовыйМассив(НомерТекущейСтроки, ВсегоСтрок, МассивСтрок, ПрочитатьВСоответствие)
	
	Результат = Новый Массив;
	
	Пока НомерТекущейСтроки < ВсегоСтрок Цикл
		
		НомерТекущейСтроки = НомерТекущейСтроки + 1;
		
		ТекСтрока = СокрЛП(МассивСтрок[НомерТекущейСтроки]);
		
		Если ТекСтрока = "]" Тогда
			// Массив кончился, выходим, оставаясь на текущей строке
			Возврат Результат;
			
		ИначеЕсли ТекСтрока = "," Тогда
			
			// Будет еще один элемент массива
			Продолжить;
			
		ИначеЕсли СокрЛП(ТекСтрока) = "" Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Результат.Добавить(КонтурСтандарт_ОбработатьТекущееЗначение(НомерТекущейСтроки, ВсегоСтрок, МассивСтрок, ПрочитатьВСоответствие));
		
	КонецЦикла;
	
	//можно добавить проверку, что именно кончилось: массив или файл
	НомерТекущейСтроки = НомерТекущейСтроки + 1;
	
	Возврат Результат;
	
КонецФункции 

Функция КонтурСтандарт_ТекстВМассивСтрок(ЗНАЧ мТекст)
	
	мТекст = Символы.ПС + мТекст + Символы.ПС;// Чтобы точно было больше 1 строки
	
	мЧислоСтрок = СтрЧислоСтрок(мТекст);
	
	мТекст = СтрЗаменить(мТекст, """", """"""); // Одинарные кавычки на двойные
	мТекст = СтрЗаменить(мТекст, Символы.ПС, """}," + Символы.ПС + "{""S"","""); 
	
	мТекст = "{""#"",51e7a0d2-530b-11d4-b98a-008048da3034,
	|{" + Формат(мЧислоСтрок + 1, "ЧГ=0") + ",
	|" //+ 1 фиктивный элемент
	+ "{""S"",""" 
	
	+ мТекст
	
	+ """}"// Фиктивный элемент массива в конце, чтоб избежать проблем с запятой
	+ "
	|}
	|}";
	
	Возврат ЗначениеИзСтрокиВнутр(мТекст);
	
КонецФункции

Функция КонтурСтандарт_ЗаписатьJSON_Совместимость(Значение) Экспорт
	
	Разделитель = "";
	
	ТипЗн = ТипЗнч(Значение);

	Если ТипЗн = Тип("Строка") Тогда
		Стр = """" + КонтурСтандарт_ЭкранироватьЗаменитьНедопустимыеСимволы(Значение) + """";

	ИначеЕсли ТипЗн = Тип("Число") Или ТипЗнч(Значение) = Тип("Булево") Тогда
		Стр = XMLСтрока(Значение);

	ИначеЕсли ТипЗн = Тип("Дата") Тогда
		Стр = """" + ?(ЗначениеЗаполнено(Значение), XMLСтрока(Значение), "") + """";

	ИначеЕсли ТипЗн = Тип("Структура") 
		Или ТипЗн = Тип("Соответствие") 
		Или ТипЗн = Тип("ФиксированнаяСтруктура")
		Или ТипЗн = Тип("ФиксированноеСоответствие")
		Тогда
		Стр = "{";
		Для Каждого Параметр Из Значение Цикл
			Стр = Стр + Разделитель + Символы.ПС + """" + Параметр.Ключ + """:" + КонтурСтандарт_ЗаписатьJSON_Совместимость(Параметр.Значение);
			Разделитель = ",";
		КонецЦикла;
		Стр = Стр + Символы.ПС + "}";

	ИначеЕсли ТипЗн = Тип("Массив")
		ИЛИ ТипЗн = Тип("ФиксированныйМассив") Тогда
		Стр = "[";
		Для Каждого Элемент Из Значение Цикл
			Стр = Стр + Разделитель + Символы.ПС + КонтурСтандарт_ЗаписатьJSON_Совместимость(Элемент);
			Разделитель = ",";
		КонецЦикла;
		Стр = Стр + Символы.ПС + "]";

	ИначеЕсли ТипЗн = Тип("ТаблицаЗначений") Тогда
		Колонки = Значение.Колонки;
		Массив = Новый Массив;
		Для Каждого СтрокаТЗ Из Значение Цикл
			Структура = Новый Структура;
			Для Каждого Колонка Из Колонки Цикл
				Структура.Вставить(Колонка.Имя, СтрокаТЗ[Колонка.Имя]);
			КонецЦикла;
			Массив.Добавить(Структура);
		КонецЦикла;
		Стр = КонтурСтандарт_ЗаписатьJSON_Совместимость(Массив);

	ИначеЕсли Значение = Неопределено Тогда
		Стр = "null";

	Иначе
		Стр = """" + КонтурСтандарт_ЭкранироватьЗаменитьНедопустимыеСимволы(Значение) + """";
	КонецЕсли;

	Возврат Стр;
	
КонецФункции

Функция КонтурСтандарт_ЭкранироватьЗаменитьНедопустимыеСимволы(Стр)
	
	Результат = СтрЗаменить(Стр			, "\"	, "\\");
	Результат = СтрЗаменить(Результат	, """"	, "\""");
	Результат = СтрЗаменить(Результат	, "/"	, "\/");
	
	Результат = СтрЗаменить(Результат, Символ(8)	, "\b");
	Результат = СтрЗаменить(Результат, Символы.ПФ	, "\f");
	Результат = СтрЗаменить(Результат, Символы.ПС	, "\n");
	Результат = СтрЗаменить(Результат, Символы.ВК	, "\r");
	Результат = СтрЗаменить(Результат, Символы.ВТаб	, "\t");
	
	Возврат Результат;
	
КонецФункции

Функция КонтурСтандарт_ФункцияВосстановленияJSON(Свойство, Значение, ДополнительныеПараметры) Экспорт 
	
	Возврат	КонтурСтандарт_ЗначениеJSON(Значение)	
	
КонецФункции

Функция КонтурСтандарт_ЗначениеJSON(ЗначениеJSON)
	
	Значение = ЗначениеJSON;
	
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		
		Если Найти(Значение, "T")= 11 Тогда

			Попытка   
				
				Если КонтурСтандарт_ДоступныЗаписьЧтениеJSON() Тогда
					
					Значение = Вычислить("ПрочитатьДатуJSON(ЗначениеJSON, ФорматДатыJSON.ISO)");   
					
				Иначе
					
					Значение = КонтурСтандарт_КонвертироватьДатуISO(ЗначениеJSON);
					
				КонецЕсли; 
				
			Исключение   
				// не удалось конвертировать дату	
			КонецПопытки;
			
			
		КонецЕсли;
				
	КонецЕсли;  
	
	Возврат Значение;
	
КонецФункции

Функция КонтурСтандарт_КонвертироватьДатуISO(Дата) Экспорт
		
	Если ПустаяСтрока(Дата) Тогда 
		АвтоконвертированнаяДата = Дата(1, 1, 1);
	Иначе
		Попытка
			АвтоконвертированнаяДата = XMLЗначение(Тип("Дата"), Дата);
			
			Миллисекунды = Сред(Дата, 21);
			Миллисекунды = СокрЛП(СтрЗаменить(Миллисекунды, "Z", ""));
			
			Если НЕ ПустаяСтрока(Миллисекунды) Тогда
				
				ЧислоМиллисекунд = Число(Миллисекунды);
				
				Если ЧислоМиллисекунд >= 500 Тогда
					
					АвтоконвертированнаяДата = АвтоконвертированнаяДата - 1;
					
				КонецЕсли;
				
			КонецЕсли;
		Исключение  
			ВызватьИсключение "Не удалось конвертировать дату ISO8601 в дату 1С"	
		КонецПопытки;
		
	КонецЕсли; 
		
	Возврат АвтоконвертированнаяДата;
	
КонецФункции 

Функция КонтурСтандарт_ХешированиеFNV1A128(Знач Данные)
	
	Перем Хеш, Байт, Бит;
	
	_РежимОтладки = Ложь;
	
	Если _РежимОтладки Тогда
		FNV_size = Pow(2, 128);
		FNV_prime = 309485009821345068724781371;
		Хеш = 144066263297769815596495629667062367629;

		ДанныеСтроки = XMLСтрока(Данные);
		
		Для НомерСимвола = 1 По СтрДлина(ДанныеСтроки) Цикл
			Байт = КодСимвола(ДанныеСтроки, НомерСимвола);
			
			Число1 = Хеш;
			Число2 = Байт;
			
			Бит = 1;
			Результат = 0;
			Пока Число1 <> 0 И Число2 <> 0 Цикл
				Результат = Бит * (((Число1 % 2) + (Число2 % 2)) % 2) + Результат;
				Бит = Бит * 2;
				Число1 = Цел(Число1 / 2);
				Число2 = Цел(Число2 / 2);
			КонецЦикла;
			
			Хеш = Результат + Макс(Число1, Число2) * Бит;
			
			Хеш = (Хеш * FNV_prime) % FNV_size;
				
		КонецЦикла;
	Иначе     
		FNV_size = Pow(2, 128);		FNV_prime = 309485009821345068724781371;		Хеш = 144066263297769815596495629667062367629;		ДанныеСтроки = XMLСтрока(Данные);				Для НомерСимвола = 1 По СтрДлина(ДанныеСтроки) Цикл			Байт = КодСимвола(ДанныеСтроки, НомерСимвола);						Число1 = Хеш;			Число2 = Байт;						Бит = 1;			Результат = 0;			Пока Число1 <> 0 И Число2 <> 0 Цикл				Результат = Бит * (((Число1 % 2) + (Число2 % 2)) % 2) + Результат;				Бит = Бит * 2;				Число1 = Цел(Число1 / 2);				Число2 = Цел(Число2 / 2);			КонецЦикла;						Хеш = Результат + Макс(Число1, Число2) * Бит;						Хеш = (Хеш * FNV_prime) % FNV_size;						КонецЦикла;	
	КонецЕсли;
		
	Возврат КонтурСтандарт_ЧислоВСистемеСчисления(Хеш, 16);
	
КонецФункции

