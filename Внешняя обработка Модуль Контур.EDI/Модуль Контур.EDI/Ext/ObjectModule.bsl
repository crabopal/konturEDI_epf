Процедура ЗаменитьПоляПоИменамРеквизитовКлюча_КонтурEDI(ИменаРеквизитовКлюча, Текст, МыГлавныеВРазрезеСделки)
	
	// ... определить в завимости от ключевых полей (GTIN, код товара покупателя и т.д.):
	// 1. по каким полям сопоставлять соответствия и входящее сообщение 	
	// 2. поля проверки сопоставленности с данной строкой входящего сообщения
	// 3. организовать использование данных из входящего в первую очередь
	
	Если МыГлавныеВРазрезеСделки Тогда
		 		
		ПоляДляСоединенияТаблицыСоответствийИВходящегоСообщения	= 
		"ВТ_ТаблицаСоответствий.Номенклатура = ВТ_ТаблицаТоваровВходящегоСообщения.Номенклатура 
		| И ВТ_ТаблицаСоответствий.ЕдиницаИзмерения = ВТ_ТаблицаТоваровВходящегоСообщения.ЕдиницаИзмерения
		| И ВЫБОР
		|		КОГДА ВТ_ТаблицаТоваровВходящегоСообщения.ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|        	ИЛИ ВТ_ТаблицаТоваровВходящегоСообщения.ХарактеристикаНоменклатуры = НЕОПРЕДЕЛЕНО
		|    	ТОГДА ВТ_ТаблицаСоответствий.ХарактеристикаНоменклатуры = НЕОПРЕДЕЛЕНО
		|            ИЛИ ВТ_ТаблицаСоответствий.ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|		ИНАЧЕ ВТ_ТаблицаТоваровВходящегоСообщения.ХарактеристикаНоменклатуры = ВТ_ТаблицаСоответствий.ХарактеристикаНоменклатуры
		|        	ИЛИ ВТ_ТаблицаСоответствий.ХарактеристикаНоменклатуры = НЕОПРЕДЕЛЕНО
		|        	ИЛИ ВТ_ТаблицаСоответствий.ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|	КОНЕЦ";
		
	Иначе
		
		ПоляДляСоединенияТаблицыСоответствийИВходящегоСообщения	= "ИСТИНА ";
		
	КонецЕсли;
	
	ТипХарактеристики = ПолучитьТипЗначенияОбъекта("ХарактеристикаНоменклатуры", Истина);
	
	Если ЗначениеЗаполнено(ТипХарактеристики) = Ложь Тогда 
		
		ПоляДляСоединенияТаблицыСоответствийИВходящегоСообщения = СтрЗаменить(ПоляДляСоединенияТаблицыСоответствийИВходящегоСообщения,
		"ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)",
		"Неопределено");
		
	Иначе 
		
		ПоляДляСоединенияТаблицыСоответствийИВходящегоСообщения = СтрЗаменить(ПоляДляСоединенияТаблицыСоответствийИВходящегоСообщения,
		"Справочник.ХарактеристикиНоменклатуры",
		ТипХарактеристики);
		
	КонецЕсли;
	
	ПоляПроверкаСопоставленияСоСтрокойВходящегоСообщения = "ИСТИНА ";
	ПоляДляСоединенияТоваровИСоответствий = "ИСТИНА ";
	ПолеКодТовараСвой = "ВТ_ТаблицаСоответствий.КодТовараСвой";
	ПолеКодТовараСторонний = "ВТ_ТаблицаСоответствий.КодТовараСторонний";
	
	Для Каждого ИмяРеквизитов Из ИменаРеквизитовКлюча Цикл
		
		Если ИмяРеквизитов.Обязательный = Истина Тогда
			
			ПоляДляСоединенияТаблицыСоответствийИВходящегоСообщения = ПоляДляСоединенияТаблицыСоответствийИВходящегоСообщения + 
			" И ВТ_ТаблицаСоответствий." + ИмяРеквизитов.ИмяВСоответствиях + " = ВТ_ТаблицаТоваровВходящегоСообщения." + ИмяРеквизитов.Имя;
			
			ПоляПроверкаСопоставленияСоСтрокойВходящегоСообщения = ПоляПроверкаСопоставленияСоСтрокойВходящегоСообщения + 
			" И ВТ_ТаблицаТоваров.Товары" + ИмяРеквизитов.Имя + " = ВТ_СоединениеСоответствий_и_ВходящегоСообщения." + ИмяРеквизитов.ИмяВСоответствиях;
			
			ПоляДляСоединенияТоваровИСоответствий = ПоляДляСоединенияТоваровИСоответствий +
			" И ВТ_ТаблицаТоваров.Товары" + ИмяРеквизитов.Имя + " = ВТ_СоединениеСоответствий_и_ВходящегоСообщения." + ИмяРеквизитов.ИмяВСоответствиях;
						
		КонецЕсли; 
		
	КонецЦикла;
	
	Текст = СтрЗаменить(Текст, "&ПоляДляСоединенияТаблицыСоответствийИВходящегоСообщения",	ПоляДляСоединенияТаблицыСоответствийИВходящегоСообщения);
	Текст = СтрЗаменить(Текст, "&ПоляПроверкаСопоставленияСоСтрокойВходящегоСообщения",	ПоляПроверкаСопоставленияСоСтрокойВходящегоСообщения);
	Текст = СтрЗаменить(Текст, "&ПоляДляСоединенияТоваровИСоответствий", ПоляДляСоединенияТоваровИСоответствий);
	Текст = СтрЗаменить(Текст, "&ПолеКодТовараСвой", ПолеКодТовараСвой);
	Текст = СтрЗаменить(Текст, "&ПолеКодТовараСторонний", ПолеКодТовараСторонний);

КонецПроцедуры

Процедура ЗаменитьПолеЦенаДоКорректировкиВТаблицеТоваров_КонтурEDI(ТаблицаТоваров, Текст)
	
	Перем ПолеЦенаДоКорректировки;
	
	Если ТаблицаТоваров.Колонки.Найти("ЦенаДоКорректировкиВДокументе1С") <> Неопределено Тогда
		ПолеЦенаДоКорректировки = "ТаблицаТоваров.ЦенаДоКорректировкиВДокументе1С";
	Иначе
		ПолеЦенаДоКорректировки = "0";
	КонецЕсли;
	
	Текст = СтрЗаменить(Текст, "&ПолеЦенаДоКорректировки", ПолеЦенаДоКорректировки);

КонецПроцедуры

Процедура ЗаменитьПолеКоличествоДоКорректировкиВТаблицеТоваров_КонтурEDI(ТаблицаТоваров, Текст)
	
	Если ТаблицаТоваров.Колонки.Найти("КоличествоДоКорректировки") <> Неопределено Тогда 		
		
		ПолеКоличествоДоКорректировки = "ТаблицаТоваров.КоличествоДоКорректировки * " + 
		"ВЫБОР 
		|	КОГДА ТаблицаТоваров.КоэффициентEDIВ1С > 0 
		|		ТОГДА ТаблицаТоваров.КоэффициентEDIВ1С 
		|	КОГДА ТаблицаТоваров.КоэффициентEDIВ1С < 0 
		|		ТОГДА -1 * (1 / ТаблицаТоваров.КоэффициентEDIВ1С) 
		|	ИНАЧЕ 1 
		|КОНЕЦ ";
		
	Иначе   		
		ПолеКоличествоДоКорректировки = "0";	
	КонецЕсли;	
	
	Текст = СтрЗаменить(Текст, "&ПолеКоличествоДоКорректировки", ПолеКоличествоДоКорректировки);

КонецПроцедуры

Процедура ЗаменитьПолеКоличествоВТаблицеТоваров_КонтурEDI(ТаблицаТоваров, Текст)
		
	Если ТаблицаТоваров.Колонки.Найти("Количество") <> Неопределено Тогда  		
		ПолеКоличествоТовары = "ТаблицаТоваров.Количество";		
	ИначеЕсли  ТаблицаТоваров.Колонки.Найти("КоличествоПосле") <> Неопределено  Тогда 		
		ПолеКоличествоТовары = "ТаблицаТоваров.КоличествоПосле"; 		
	Иначе   		
		ПолеКоличествоТовары = "0";  		
	КонецЕсли;
	
	Текст = СтрЗаменить(Текст, "&ПолеКоличествоТовары", ПолеКоличествоТовары);

КонецПроцедуры

Процедура ЗаменитьПолеСерияНоменклатуры_КонтурEDI(ТаблицаТоваров, Текст)
	
	Если ТаблицаТоваров.Колонки.Найти("СерияНоменклатуры") = Неопределено Тогда
		ПолеСерияНоменклатуры = """""";
	Иначе
		ПолеСерияНоменклатуры = "ТаблицаТоваров.СерияНоменклатуры";
	КонецЕсли;
	
	Текст = СтрЗаменить(Текст, "&ПолеСерияНоменклатуры", ПолеСерияНоменклатуры);

КонецПроцедуры

Функция ПолучитьПредыдущееВходящееСообщение(Сообщение = Неопределено, Знач ДокументСсылка = Неопределено) Экспорт
 
   ПредыдущееВходящееСообщение = Неопределено;
   
   Если ДокументСсылка = Неопределено Тогда
	  ДокументСсылка = Сообщение.Документ1С;
   КонецЕсли;
   
   ДеревоПредыдущих = ПолучитьСвязанныеСообщения(, ДокументСсылка);
   
   ПорядокСообщений = Новый Соответствие;
   ПорядокСообщений.Вставить("ORDERS", 1);
   ПорядокСообщений.Вставить("ORDRSP", 2);
   ПорядокСообщений.Вставить("DESADV", 3);
   ПорядокСообщений.Вставить("RECADV", 4);
   ПорядокСообщений.Вставить("INVOIC", 5);
   
   Если ЗначениеЗаполнено(ДеревоПредыдущих) Тогда
       
	   СтрокиВходящих = ДеревоПредыдущих.Строки.НайтиСтроки(Новый Структура("Направление", "Входящее"), Истина);
	   
	   ПредыдущееВходящееСообщениеСсылка = Неопределено;
	   Для Каждого Стр Из СтрокиВходящих Цикл
		   
		   ПорядокСообщения = ?(ПорядокСообщений[Стр.ТипСообщения] <> Неопределено, ПорядокСообщений[Стр.ТипСообщения], 0);
		   Если ПорядокСообщения > 0 Тогда
			   ПредыдущееВходящееСообщениеСсылка = Стр.Ссылка;
		   КонецЕСли;
		   
	   КонецЦикла;
	   
       Если ЗначениеЗаполнено(ПредыдущееВходящееСообщениеСсылка) Тогда
          ПредыдущееВходящееСообщение = ПрочитатьСообщение(ПредыдущееВходящееСообщениеСсылка);
       КонецЕсли;
          
   КонецЕсли;
 
   Возврат ПредыдущееВходящееСообщение;
   
КонецФункции

Функция ПолучитьПредыдущееСообщение_КонтурEDI(Сообщение, Источник = "") Экспорт
	
	ПорядокСообщений = Новый Соответствие; 
	
	Если Сообщение.ТипСообщения = "PORDERS" Тогда
		
		ПорядокСообщений.Вставить("ORDERS", 1);
		
	ИначеЕсли Сообщение.ТипСообщения = "ORDERS" Тогда
		
		ПорядокСообщений.Вставить("PORDERS", 1);
		
	ИначеЕсли Сообщение.ТипСообщения = "ORDRSP" Тогда
		
		ПорядокСообщений.Вставить("ORDERS", 1);
		
	ИначеЕсли Сообщение.ТипСообщения = "DESADV" Тогда
		
		ПорядокСообщений.Вставить("ORDERS", 2);
		ПорядокСообщений.Вставить("RECADV", 1);
		
	ИначеЕсли Сообщение.ТипСообщения = "RECADV" Тогда
		
		ПорядокСообщений.Вставить("ORDERS", 2);
		ПорядокСообщений.Вставить("DESADV", 1);  	
				
	ИначеЕсли Источник = "ОбработкаРасхожденийПриемки" 
		ИЛИ Источник = "ПодготовитьУведомлениеОбОтгрузке_ДляОбработкиРасхождений" Тогда
		
		ПорядокСообщений.Вставить("ORDERS", 1);
		ПорядокСообщений.Вставить("RECADV", 2);
		
	ИначеЕсли Сообщение.ТипСообщения = "INVOIC"
		ИЛИ Сообщение.ТипСообщения = "COINVOIC" Тогда
		
		ПорядокСообщений.Вставить("ORDERS", 3);
		ПорядокСообщений.Вставить("DESADV", 2);
		ПорядокСообщений.Вставить("RECADV", 1);
		ПорядокСообщений.Вставить("INVOIC", 4);
		ПорядокСообщений.Вставить("COINVOIC", 5);
		
	ИначеЕсли Сообщение.ТипСообщения = "RETANN" Тогда
		
		ПорядокСообщений.Вставить("ORDERS", 1);
		ПорядокСообщений.Вставить("DESADV", 2);
		
	ИначеЕсли Сообщение.ТипСообщения = "RETINS" Тогда
		
		ПорядокСообщений.Вставить("RETANN", 1);
		
	ИначеЕсли Сообщение.ТипСообщения = "RETDES" Тогда
		
		ПорядокСообщений.Вставить("ORDERS", 1);
		ПорядокСообщений.Вставить("DESADV", 2);
		
	ИначеЕсли Сообщение.ТипСообщения = "RETREC" Тогда
		
		ПорядокСообщений.Вставить("RETDES", 1);
		
	КонецЕсли;
	
	Документ1С = ДокументДляПоискаПредыдущегоСообщения_КонтурEDI(Сообщение);

	ПредыдущееИсходноеСообщениеСсылка = Неопределено;
	
	Если ЗначениеЗаполнено(Документ1С) Тогда		   
		
		ПредыдущееИсходноеСообщениеСсылка = ПолучитьПредыдущееПоПорядкуСообщение_КонтурEDI(Документ1С, ПорядокСообщений, Сообщение); 
		
	ИначеЕсли ПорядокСообщений.Количество() > 0 И
		(ЕстьНомерДокументаEDI(Сообщение, "ЗаказEDI")
		ИЛИ ЕстьНомерДокументаEDI(Сообщение, "ДокументEDI")) Тогда
				
		ТипСтрока = ОписаниеТипаСтрока_КонтурEDI(50);
		
		ОтборСообщений = Новый ТаблицаЗначений;
		ДобавитьКолонкиВТаблицуЗначений(ОтборСообщений, "ТипСообщения", ТипСтрока);
		ДобавитьКолонкиВТаблицуЗначений(ОтборСообщений, "Направление", ТипСтрока);
		
		Для Каждого СтрокаПорядкаСообщений Из ПорядокСообщений Цикл
			
			СтрокаОтбора = ОтборСообщений.Добавить();
			СтрокаОтбора.ТипСообщения = СтрокаПорядкаСообщений.Ключ;
			СтрокаОтбора.Направление = "Входящее";
			
			СтрокаОтбора = ОтборСообщений.Добавить();
			СтрокаОтбора.ТипСообщения = СтрокаПорядкаСообщений.Ключ;
			СтрокаОтбора.Направление = "Исходящее";
			
		КонецЦикла;  
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОтборСообщений.ТипСообщения,
		|	ОтборСообщений.Направление
		|ПОМЕСТИТЬ табОтбор
		|ИЗ
		|	&ОтборСообщений КАК ОтборСообщений
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КонтурEDI_Сообщения.Ссылка,
		|	КонтурEDI_Сообщения.ТипСообщения
		|ИЗ
		|	табОтбор КАК табОтбор
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
		|		ПО табОтбор.ТипСообщения = КонтурEDI_Сообщения.ТипСообщения
		|			И табОтбор.Направление = КонтурEDI_Сообщения.Направление
		|			И (КонтурEDI_Сообщения.НомерЗаказа = &НомерЗаказа)
		|			И (ГОД(КонтурEDI_Сообщения.ДатаЗаказа) = ГОД(&ДатаЗаказа))
		|			И (КонтурEDI_Сообщения.Партнер = &Партнер)
		|			И (КонтурEDI_Сообщения.ТочкаДоставки = &ТочкаДоставки
		|				ИЛИ &ТочкаДоставки = НЕОПРЕДЕЛЕНО)
		|			И (НЕ КонтурEDI_Сообщения.ПометкаУдаления)
		|			И (НЕ КонтурEDI_Сообщения.Ссылка = &Ссылка)";				
				
		Запрос.УстановитьПараметр("ОтборСообщений",	ОтборСообщений);
		
		Если ЗначениеЗаполнено(Сообщение.ЗаказEDI.Номер) Тогда
			
			Запрос.УстановитьПараметр("НомерЗаказа",	Сообщение.ЗаказEDI.Номер);
			
		Иначе
			
			Запрос.УстановитьПараметр("НомерЗаказа",	Сообщение.ДокументEDI.Номер);
			
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Ссылка",			Сообщение.СообщениеСсылка);
		Запрос.УстановитьПараметр("Партнер",		Сообщение.Партнер);
		Запрос.УстановитьПараметр("ТочкаДоставки",	Сообщение.ТочкаДоставки);
		Запрос.УстановитьПараметр("ДатаЗаказа",		Сообщение.ЗаказEDI.Дата);
				
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Порядок = -1;
				
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если ПорядокСообщений[ВыборкаДетальныеЗаписи.ТипСообщения] = Неопределено Тогда 			
				ПорядокСообщения = 0;      			
			Иначе 			
				ПорядокСообщения =  ПорядокСообщений[ВыборкаДетальныеЗаписи.ТипСообщения];  			
			КонецЕсли;
						
			Если ПорядокСообщения >= Порядок Тогда
				
				ПредыдущееИсходноеСообщениеСсылка = ВыборкаДетальныеЗаписи.Ссылка;
				Порядок = ПорядокСообщения;
				
			КонецЕСли;
			
		КонецЦикла; 	
		
	Иначе
		
		ПредыдущееИсходноеСообщениеСсылка = Неопределено;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПредыдущееИсходноеСообщениеСсылка) Тогда
			
		ПредыдущееИсходноеСообщение = ПрочитатьСообщение(ПредыдущееИсходноеСообщениеСсылка);
		
	Иначе
		
		ПредыдущееИсходноеСообщение = Неопределено;
			
	КонецЕсли;     
	
	Возврат ПредыдущееИсходноеСообщение;
   
КонецФункции

Функция ЕстьНомерДокументаEDI(Сообщение, ИмяДокумента)
	
	Возврат (ПеременнаяСодержитСвойство(Сообщение, ИмяДокумента) И ЗначениеЗаполнено(Сообщение[ИмяДокумента].Номер)); 

КонецФункции

Функция СообщенияЦепочкиРаспределенныеПоТипам(Документ1С) Экспорт
	
	Результат = Новый Соответствие;
	
	ДеревоСвязанныхСообщений = ПолучитьСвязанныеСообщения(,Документ1С);
	
	ОтборСтрокСообщений = Новый Структура("Вид", "Сообщение");
	СтрокиСообщений = ДеревоСвязанныхСообщений.Строки.НайтиСтроки(ОтборСтрокСообщений, Истина);
	
	Для каждого СтрокаСообщения Из СтрокиСообщений Цикл
		
		Список = Результат.Получить(СтрокаСообщения.ТипСообщения);
		
		Если Список = Неопределено Тогда
			
			Результат.Вставить(СтрокаСообщения.ТипСообщения, Новый Массив);
			Список = Результат.Получить(СтрокаСообщения.ТипСообщения);
			
		КонецЕсли;	
		
		Список.Добавить(СтрокаСообщения.Ссылка);
		
	КонецЦикла;
	
	Возврат Результат;
	                                                   
КонецФункции

Функция ПолучитьПредыдущееПоПорядкуСообщение_КонтурEDI(Документ1С, ПорядокСообщений, Сообщение)
	
	ПредыдущееИсходноеСообщениеСсылка = Неопределено;
	
	ТипСообщенияДляПоиска = Неопределено;
	Если ТипЗнч(Сообщение) = Тип("Структура")
		И Сообщение.Свойство("ТипСообщения") Тогда
		ТипСообщенияДляПоиска = Сообщение.ТипСообщения;
	КонецЕсли;
	
	ДеревоПредыдущих = ПолучитьСвязанныеСообщения(, Документ1С, ТипСообщенияДляПоиска);
			    				
	Если ЗначениеЗаполнено(ДеревоПредыдущих) Тогда
		
		ВключатьПодчиненные = Истина;
		СтрокаДокумента = ДеревоПредыдущих.Строки.Найти(Документ1С, "Ссылка", ВключатьПодчиненные);
		
		Если СтрокаДокумента <> Неопределено Тогда
								
			ТаблицаПредыдущихСообщений = НовыйТаблицаПредыдущихСообщений();  			
			
			ЗаполнитьТаблицуПредыдущихСообщенийДокумента(ТаблицаПредыдущихСообщений, ДеревоПредыдущих.Строки);
			
			ПредыдущееИсходноеСообщениеСсылка = ВыбратьПредыдущееСообщениеСогласноПорядку(ПорядокСообщений, ТаблицаПредыдущихСообщений, Сообщение);
			
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат ПредыдущееИсходноеСообщениеСсылка;

КонецФункции

Функция НовыйТаблицаПредыдущихСообщений()
	
	Таблица = Новый ТаблицаЗначений;
	
	Таблица.Колонки.Добавить("СообщениеСсылка");
	Таблица.Колонки.Добавить("ТипСообщения");
	Таблица.Колонки.Добавить("Направление");
	Таблица.Колонки.Добавить("ДатаСоздания");
	Таблица.Колонки.Добавить("Документ1С");   
	
	Возврат Таблица;
	
КонецФункции

Процедура ЗаполнитьТаблицуПредыдущихСообщенийДокумента(ТаблицаПредыдущихСообщений, СтрокиДерева)
	
	Для Каждого СтрокаДерева Из СтрокиДерева  Цикл
		
		Если СтрокаДерева.Вид = "Сообщение" Тогда
			
			НоваяСтрокаТаблицы = ТаблицаПредыдущихСообщений.Добавить();
			НоваяСтрокаТаблицы.СообщениеСсылка = СтрокаДерева.Ссылка;
			НоваяСтрокаТаблицы.ТипСообщения = СтрокаДерева.ТипСообщения;
			НоваяСтрокаТаблицы.Направление = СтрокаДерева.Направление;
			
			РеквизитыСообщения = Новый Структура("ДатаЗагрузки,Документ");
			ЗаполнитьЗначенияСвойств(РеквизитыСообщения, СтрокаДерева.Ссылка);
			
			НоваяСтрокаТаблицы.ДатаСоздания = РеквизитыСообщения.ДатаЗагрузки;
			НоваяСтрокаТаблицы.Документ1С = РеквизитыСообщения.Документ;
			
		КонецЕсли;
		
		ЗаполнитьТаблицуПредыдущихСообщенийДокумента(ТаблицаПредыдущихСообщений, СтрокаДерева.Строки)
		
	КонецЦикла;
	
КонецПроцедуры

Функция ВыбратьПредыдущееСообщениеСогласноПорядку(ПорядокСообщений, ТаблицаПредыдущихСообщений, Сообщение)
	
	ВыбранноеСообщениеСсылка = Неопределено;
	ТекущийПорядок = 0;
	ТекущаяДатаСоздания = Дата(1, 1, 1);
	
	Для Каждого Стр Из ТаблицаПредыдущихСообщений Цикл
		
		Если Стр.ТипСообщения = Сообщение.ТипСообщения
			И Стр.Документ1С = Сообщение.Документ1С Тогда
			
			Прервать;
			
		КонецЕсли;
		
		ПорядокСообщения = ПорядокСообщений[Стр.ТипСообщения];  			
		
		Если ПорядокСообщения = Неопределено Тогда 			
			Продолжить;      			
		КонецЕсли;
		
		Если ПорядокСообщения > ТекущийПорядок Тогда
			
			ВыбранноеСообщениеСсылка = Стр.СообщениеСсылка;
			ТекущийПорядок = ПорядокСообщения;
			ТекущаяДатаСоздания = Стр.ДатаСоздания;
			
		ИначеЕсли ПорядокСообщения = ТекущийПорядок 
			И Стр.ДатаСоздания > ТекущаяДатаСоздания Тогда
			
			ВыбранноеСообщениеСсылка = Стр.СообщениеСсылка;
			
		Иначе
			
			// ничего
			
		КонецЕСли;
		
	КонецЦикла;
	
	Возврат ВыбранноеСообщениеСсылка;
	
КонецФункции

Функция МассивПредыдущихСообщений_КонтурEDI(Сообщение, ТипыСообщений = Неопределено) Экспорт
	
	ЕстьОграничениеПоТипамСообщения = ТипЗнч(ТипыСообщений) = Тип("Массив") И ТипыСообщений.Количество() > 0;
	
	Документ1С = ДокументДляПоискаПредыдущегоСообщения_КонтурEDI(Сообщение);
	
	МассивПредыдущихСообщений = Новый Массив;
	
	Если ЗначениеЗаполнено(Документ1С) Тогда
		
		ДеревоПредыдущих = ПолучитьСвязанныеСообщения(, Документ1С);
		
		Если ЗначениеЗаполнено(ДеревоПредыдущих) Тогда
			
			СтрокиСообщений = ДеревоПредыдущих.Строки.НайтиСтроки(Новый Структура("Вид", "Сообщение"), Истина);
			
			Для Каждого Стр Из СтрокиСообщений Цикл
				
				Если НЕ ЕстьОграничениеПоТипамСообщения
					ИЛИ ТипыСообщений.Найти(Стр.ТипСообщения) <> Неопределено Тогда
					
					ПредыдущееИсходноеСообщение = ПрочитатьСообщение(Стр.Ссылка);
					
					Документ1С_ПредыдущееИсходноеСообщение = ДокументДляПоискаПредыдущегоСообщения_КонтурEDI(ПредыдущееИсходноеСообщение);
					
					Если Стр.ТипСообщения = Сообщение.ТипСообщения 
						И Документ1С_ПредыдущееИсходноеСообщение = Документ1С Тогда
						Прервать;
					Иначе
						МассивПредыдущихСообщений.Добавить(ПредыдущееИсходноеСообщение);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	ИначеЕсли ЕстьНомерДокументаEDI(Сообщение, "ЗаказEDI")
		ИЛИ ЕстьНомерДокументаEDI(Сообщение, "ДокументEDI") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурEDI_Сообщения.Ссылка,
		|	КонтурEDI_Сообщения.ТипСообщения
		|ИЗ
		|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
		|ГДЕ
		|	КонтурEDI_Сообщения.Направление В(&Направление)
		|	И КонтурEDI_Сообщения.НомерЗаказа = &НомерЗаказа
		|	И КонтурEDI_Сообщения.Партнер = &Партнер
		|	И (КонтурEDI_Сообщения.ТочкаДоставки = &ТочкаДоставки
		|			ИЛИ &ТочкаДоставки = НЕОПРЕДЕЛЕНО)
		|	И ГОД(КонтурEDI_Сообщения.ДатаЗаказа) = ГОД(&ДатаЗаказа)";
		
		МассивНаправление = Новый Массив;
		Если ЗначениеЗаполнено(Сообщение.Направление)  Тогда
			
			МассивНаправление.Добавить(Сообщение.Направление);
			
		Иначе
			
			МассивНаправление.Добавить("Исходящее");
			МассивНаправление.Добавить("Входящее");
			
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Направление",	МассивНаправление);
		
		Если ЗначениеЗаполнено(Сообщение.ЗаказEDI.Номер) Тогда
			
			Запрос.УстановитьПараметр("НомерЗаказа",	Сообщение.ЗаказEDI.Номер);
			
		Иначе
			
			Запрос.УстановитьПараметр("НомерЗаказа",	Сообщение.ДокументEDI.Номер);
			
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Партнер",		Сообщение.Партнер);
		Запрос.УстановитьПараметр("ТочкаДоставки",	Сообщение.ТочкаДоставки);
		Запрос.УстановитьПараметр("ДатаЗаказа",		Сообщение.ЗаказEDI.Дата);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если НЕ ЕстьОграничениеПоТипамСообщения 
				ИЛИ ТипыСообщений.Найти(ВыборкаДетальныеЗаписи.ТипСообщения) <> Неопределено Тогда
				
				ПредыдущееИсходноеСообщениеСсылка = ВыборкаДетальныеЗаписи.Ссылка;
				
				МассивПредыдущихСообщений.Добавить(ПрочитатьСообщение(ПредыдущееИсходноеСообщениеСсылка));
				
			КонецЕсли; 
			
		КонецЦикла;
				
	Иначе
		
		
		
	КонецЕсли;            
	
	Возврат МассивПредыдущихСообщений;
   
КонецФункции

Функция ДокументДляПоискаПредыдущегоСообщения_КонтурEDI(Сообщение)

	ВзятьДокументИзЗаказа = НЕ ЗначениеЗаполнено(Сообщение.Документ1С) 
		И Сообщение.ТипСообщения = "ORDRSP" 
		И Сообщение.Направление = "Входящее"
		И ЗначениеЗаполнено(Сообщение.Заказ1С);

	ВзятьДокументИзНакладной = НЕ ЗначениеЗаполнено(Сообщение.Документ1С) 
		И Сообщение.ТипСообщения = "RECADV" 
		И Сообщение.Направление = "Входящее"
		И ЗначениеЗаполнено(Сообщение.Накладная1С);
	
	Если ВзятьДокументИзЗаказа Тогда
		
		Документ1С = Сообщение.Заказ1С;
		
	ИначеЕсли ВзятьДокументИзНакладной Тогда
		
		Документ1С = Сообщение.Накладная1С;
			
	ИначеЕсли Сообщение.ТипСообщения = "COINVOIC" Тогда
		
		ТипДокументаСчетФактура = ПолучитьТипЗначенияОбъекта("ТипДокументаСчетФактура");
		
		Если ЗначениеЗаполнено(ТипДокументаСчетФактура) И ТипЗнч(Сообщение.Документ1С) = Тип(ТипДокументаСчетФактура)  Тогда 
			Документ1С = ПолучитьКорректировкуРеализацииСчетаФактуры(Сообщение.Документ1С); 
		Иначе
			Документ1С = Сообщение.Документ1С; 
		КонецЕсли;   		
		
	Иначе
		
		Документ1С = Сообщение.Документ1С;
		
	КонецЕсли;
	
	Возврат Документ1С;

КонецФункции

Процедура ПодготовитьТаблицуТоваровККонвертации1СВEDI(ТаблицаТоваров, Партнер, ТипСообщения, ДопПараметры) Экспорт
	
	// ... определить необходимости свертки
	ОтменаСуммированияПоПолям = ПолучитьЗначениеСвойстваОбъектаEDI(Партнер, "СворачиватьТаблицуТоваровДляСообщения") = Ложь;
	
	// ... свернуть товары для исключения нескольких строк с товаром
	Если ОтменаСуммированияПоПолям <> Истина Тогда
		СвернутьТоварыДокументаПослеЗапроса_КонтурEDI(ТаблицаТоваров);
	КонецЕсли;
	
	ДополнитьИТипизироватьКолонкиТаблицыТоваров(ТаблицаТоваров, Партнер, ОтменаСуммированияПоПолям);
	
	ДополнитьДанныеВТаблицеТоваров_КонтурEDI(ТаблицаТоваров, Партнер, ДопПараметры);
	
	УдалитьТоварыСНулевымКоличеством(ТаблицаТоваров, ТипСообщения, ДопПараметры.Направление);
		
КонецПроцедуры

Процедура ДополнитьДанныеВТаблицеТоваров_КонтурEDI(ТаблицаТоваров, Партнер, ДопПараметры)
	
	Если ДопПараметры.Направление = "Исходящее" Тогда
		ТаблицаКодовНоменклатуры = ПолучитьТаблицуКодовНоменклатуры(ТаблицаТоваров.ВыгрузитьКолонку("Номенклатура"));
	КонецЕсли;
		
	// ... дозаполнить необходимые колонки
	НомерСтроки = 0;
	Для Каждого СтрокаТоваров Из ТаблицаТоваров Цикл 
		
		НомерСтроки = НомерСтроки + 1;
		
		Если СтрокаТоваров.НомерСтроки = Неопределено Тогда
			СтрокаТоваров.НомерСтроки = НомерСтроки;		
		КонецЕсли;
		
		Если ДопПараметры.Направление = "Исходящее" Тогда
			СтрокаТаблицыКодовНоменклатуры = ТаблицаКодовНоменклатуры.Найти(СтрокаТоваров.Номенклатура, "Номенклатура");
			
			Если СтрокаТаблицыКодовНоменклатуры <> Неопределено Тогда
				
				Если ДопПараметры.МыПоставщик = Истина Тогда
					Если ДопПараметры.ЭтоОбратнаяОтгрузка Тогда
						СтрокаТоваров.КодТовараПокупателя = СтрокаТаблицыКодовНоменклатуры.Код;
					Иначе
						СтрокаТоваров.КодТовараПоставщика = СтрокаТаблицыКодовНоменклатуры.Код;
					КонецЕсли;
				Иначе
					Если ДопПараметры.ЭтоОбратнаяОтгрузка Тогда
						СтрокаТоваров.КодТовараПоставщика = СтрокаТаблицыКодовНоменклатуры.Код;
					Иначе      					
						СтрокаТоваров.КодТовараПокупателя = СтрокаТаблицыКодовНоменклатуры.Код; 
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			Если Не ЗначениеЗаполнено(СтрокаТоваров.УИД_СтрокиТовара) Тогда
				
				СтрокаТоваров.УИД_СтрокиТовара = УИД_СтрокиТовара_КонтурEDI(НомерСтроки, ДопПараметры.ТипСообщения);
								
			КонецЕсли;
			
		КонецЕсли;
		// ... 
		СтрокаТоваров.Пометка_о_сопоставлении = Ложь;
		
		Если ДопПараметры.ЭтоТиповойЗапросПоПроведенномуЗаказу_УТ_УПП_КА = Истина Тогда
			
			Если СтрокаТоваров.ТипЕдиницы = "Services" Тогда
				СтрокаТоваров.СуммаВключаетНДС = ДопПараметры.СуммаВключаетНДС;
			Иначе
				СтрокаТоваров.СуммаВключаетНДС = Истина;
			КонецЕсли;
			
		Иначе
			СтрокаТоваров.СуммаВключаетНДС = ДопПараметры.СуммаВключаетНДС;
		КонецЕсли;
		
		СтрокаТоваров.КоличествоНеСопоставлено = СтрокаТоваров.Количество;
		
		Если ЕстьКолонкаСтрокиТаблицы_КонтурEDI(СтрокаТоваров, "КоличествоДоКорректировки") Тогда
			СтрокаТоваров.КоличествоДоНеСопоставлено = СтрокаТоваров.КоличествоДоКорректировки;
		КонецЕсли;
		
		СтрокаТоваров.КоличествоВДокументе1С = СтрокаТоваров.Количество;
		
		Если ЕстьКолонкаСтрокиТаблицы_КонтурEDI(СтрокаТоваров, "Цена") Тогда
			СтрокаТоваров.ЦенаВДокументе1С = СтрокаТоваров.Цена;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТоваров.УИД_СтрокиДокумента) Тогда 		
			СтрокаТоваров.УИД_СтрокиДокумента = "" + Новый УникальныйИдентификатор; 			
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

Функция ПолучитьТаблицуКодовНоменклатуры(МассивНоменклатуры)
	
	// ... запрос для доп. реквизитов номенклатуры
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	Номенклатура.Код
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В(&МассивНоменклатуры)";
	
	мИмяСправочникаНоменклатура = ПолучитьТипЗначенияОбъекта("Номенклатура", Истина, Ложь);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Справочник.Номенклатура", мИмяСправочникаНоменклатура);
	
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ДополнитьИТипизироватьКолонкиТаблицыТоваров(ТаблицаТоваров, Партнер, ОтменаСуммированияПоПолям)
	
	// ... округлить цены после получения из запроса
	ОкруглитьЦеныТоваровДокументаПослеЗапроса_КонтурEDI(ТаблицаТоваров, Партнер); 
		
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваров,"ОтменаСуммированияПоПолям", Новый ОписаниеТипов("Булево"));
	ТаблицаТоваров.ЗаполнитьЗначения(ОтменаСуммированияПоПолям, "ОтменаСуммированияПоПолям");
		
	ТипБулево 		= Новый ОписаниеТипов("Булево");
	ТипСтрока50 	= ОписаниеТипаСтрока_КонтурEDI(50);
	ТипСтрока1000 	= ОписаниеТипаСтрока_КонтурEDI(1000);
	ТипСтрока256 	= ОписаниеТипаСтрока_КонтурEDI(256);
	ТипЧисло 		= ОписаниеТипаЧисло_КонтурEDI();	
	
	// ... пометка используется где-то дальше
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваров,"Пометка", ТипБулево);
	
	// ... типизировать колонки 
	ТипизироватьКолонку_Номенклатура(ТаблицаТоваров);
	ТипизироватьКолонку_СерияНоменклатуры(ТаблицаТоваров);
	ТипизироватьКолонку_ЕдиницаИзмерения(ТаблицаТоваров);
	ТипизироватьКолонку_Характеристика(ТаблицаТоваров);
	
	// ... только числа в числовых полях.
	ОставитьТолькоЧислаВЧисловыхКолонках(ТаблицаТоваров, "Количество,КоличествоДоКорректировки,Сумма,СуммаДоКорректировки,СуммаНДС,СуммаНДСДоКорректировки,Цена,ЦенаДоКорректировки");
	
	// ... увеличить разрядность для точности пересчетов
	Если ТаблицаТоваров.Колонки.Количество.ТипЗначения.КвалификаторыЧисла.Разрядность > 0 Тогда
		ТипизироватьКолонкиВТаблицеЗначений(ТаблицаТоваров, "Количество", ТипЧисло);
	КонецЕсли;
			
	// ... СуммаВключаетНДС
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваров,"СуммаВключаетНДС", ТипБулево);
	
	// ... дополнить реквизитами сопоставления  	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваров,
	"GTIN,КодТовараПокупателя,КодТовараПоставщика,КодЕдиницыИзмеренияEDI,ТипЕдиницы,КодТовараВнутренний", ТипСтрока50); 
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваров,"Наименование", ТипСтрока1000);
	
	ТипКоэффициентаEDIВ1С = ПолучитьТип_КонтурEDI("КоэффициентEDIВ1С");
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваров,"КоэффициентEDIВ1С", ТипКоэффициентаEDIВ1С);
	
	// ... дополнить колонками для отражения процесса сопоставления "КоличествоНеСопоставлено", Пометка_о_сопоставлении и пр
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваров, "ПриоритетВозможногоСопоставления",ТипЧисло);
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваров, "КоличествоНеСопоставлено,КоличествоДоНеСопоставлено",ТипЧисло);  	    		
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваров, "Пометка_о_сопоставлении,МногиеКоМногим", ТипБулево);
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваров, 
	"УИД_СтрокиДокумента,УИД_СтрокиПредыдущегоСообщения", ТипСтрока256);
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваров, 
	"УИД_СтрокиПервоначальногоСообщения,УИД_СтрокиТовара", ТипСтрока256);
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваров, "НомерСтроки");
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваров, "СтрокаВходящегоСообщения");
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваров,
	"КоличествоВДокументе1С, ЦенаВДокументе1С", ТипЧисло);

	ТипизироватьКолонкуПоДаннымДругойКолонки(ТаблицаТоваров, "Цена", "ЦенаДоКорректировки");
	
КонецПроцедуры

Процедура ТипизироватьКолонкуПоДаннымДругойКолонки(ТаблицаТоваров, ИмяТипизируемойКолонки, ИмяЭталоннойКолонки) Экспорт
	
	ТипизируемаяКолонка = ТаблицаТоваров.Колонки.Найти(ИмяТипизируемойКолонки);
	ЭталоннаяКолонка = ТаблицаТоваров.Колонки.Найти(ИмяЭталоннойКолонки);
	
	Если ТипизируемаяКолонка = Неопределено 
		Или ЭталоннаяКолонка = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ТипизироватьКолонкиВТаблицеЗначений(ТаблицаТоваров, ИмяТипизируемойКолонки, ЭталоннаяКолонка.ТипЗначения);
	
КонецПроцедуры

Процедура ТипизироватьКолонку_Характеристика(ТаблицаТоваров)
	
	ТипСправочникаХарактеристикаНоменклатуры = ПолучитьТипЗначенияОбъекта("ХарактеристикаНоменклатуры");
	
	Если ЗначениеЗаполнено(ТипСправочникаХарактеристикаНоменклатуры) Тогда
		ОписаниеТипаХарактеристикаНоменклатуры = Новый ОписаниеТипов(ТипСправочникаХарактеристикаНоменклатуры, , Новый КвалификаторыСтроки(500));
	Иначе
		ОписаниеТипаХарактеристикаНоменклатуры = ОписаниеТипаСтрока_КонтурEDI(500);
	КонецЕсли;
	
	ТипизироватьКолонкиВТаблицеЗначений(ТаблицаТоваров, "ХарактеристикаНоменклатуры", ОписаниеТипаХарактеристикаНоменклатуры);

КонецПроцедуры

Процедура ТипизироватьКолонку_ЕдиницаИзмерения(ТаблицаТоваров)
	
	ТипСправочникаЕдиницы = ПолучитьТипЗначенияОбъекта("ЕдиницаИзмерения");
	
	Если ЗначениеЗаполнено(ТипСправочникаЕдиницы) Тогда
		ОписаниеТипаЕдиницыИзмерения = Новый ОписаниеТипов(ТипСправочникаЕдиницы, , Новый КвалификаторыСтроки(500));
	Иначе
		ОписаниеТипаЕдиницыИзмерения = ОписаниеТипаСтрока_КонтурEDI(500);
	КонецЕсли;
	
	ТипизироватьКолонкиВТаблицеЗначений(ТаблицаТоваров, "ЕдиницаИзмерения", ОписаниеТипаЕдиницыИзмерения);

КонецПроцедуры

Процедура ТипизироватьКолонку_СерияНоменклатуры(ТаблицаТоваров)
	
	ТипСправочникаСерииНоменклатуры = ПолучитьТипЗначенияОбъекта("СерияНоменклатуры");
	
	ОписаниеТипаСерииНоменклатуры = Неопределено;
		
	Если ЗначениеЗаполнено(ТипСправочникаСерииНоменклатуры) Тогда
		Попытка
			ОписаниеТипаСерииНоменклатуры = Новый ОписаниеТипов(ТипСправочникаСерииНоменклатуры, , Новый КвалификаторыСтроки(500));
		Исключение
			ОписаниеТипаСерииНоменклатуры = Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Если ОписаниеТипаСерииНоменклатуры = Неопределено Тогда
		ОписаниеТипаСерииНоменклатуры = ОписаниеТипаСтрока_КонтурEDI(500);
	КонецЕсли; 	
	
	ТипизироватьКолонкиВТаблицеЗначений(ТаблицаТоваров, "СерияНоменклатуры", ОписаниеТипаСерииНоменклатуры);

КонецПроцедуры

Процедура ТипизироватьКолонку_Номенклатура(ТаблицаТоваров)
	
	ТипСправочникаНоменклатура = ПолучитьТипЗначенияОбъекта("Номенклатура");
	
	Если ЗначениеЗаполнено(ТипСправочникаНоменклатура) Тогда
		ОписаниеТипаНоменклатура = Новый ОписаниеТипов(ТипСправочникаНоменклатура, , Новый КвалификаторыСтроки(500));
	Иначе
		ОписаниеТипаНоменклатура = ОписаниеТипаСтрока_КонтурEDI(500);
	КонецЕсли;
	
	ТипизироватьКолонкиВТаблицеЗначений(ТаблицаТоваров, "Номенклатура", ОписаниеТипаНоменклатура);

КонецПроцедуры

Функция ИменаРеквизитовДляКлючаПоискаРеквизитов(НастройкаТолькоПоШК, НастройкаТолькоПоВнутреннемуКоду, ЭтоОбратнаяОтгрузка, РежимПоставщик) Экспорт
	
	ИменаРеквизитов = Новый ТаблицаЗначений;
	
	ТипСтрока = ОписаниеТипаСтрока_КонтурEDI();
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	ДобавитьКолонкиВТаблицуЗначений(ИменаРеквизитов, "Имя,ИмяВСоответствиях", ТипСтрока);
	ДобавитьКолонкиВТаблицуЗначений(ИменаРеквизитов, "Обязательный", ТипБулево);
	
	ДобавитьGTIN_В_ИменаРеквизитов(ИменаРеквизитов, НастройкаТолькоПоВнутреннемуКоду, НастройкаТолькоПоШК); 

	ДобавитьКодТовараПокупателя_В_ИменаРеквизитов(ИменаРеквизитов, НастройкаТолькоПоВнутреннемуКоду, НастройкаТолькоПоШК, ЭтоОбратнаяОтгрузка, РежимПоставщик);    
	
	ДобавитьКодТовараПоставщика_В_ИменаРеквизитов(ИменаРеквизитов, НастройкаТолькоПоВнутреннемуКоду, НастройкаТолькоПоШК, ЭтоОбратнаяОтгрузка, РежимПоставщик);
			
	Возврат ИменаРеквизитов;
	
КонецФункции

Процедура ДобавитьКодТовараПоставщика_В_ИменаРеквизитов(ИменаРеквизитов, НастройкаТолькоПоВнутреннемуКоду, НастройкаТолькоПоШК, ЭтоОбратнаяОтгрузка, РежимПоставщик)
	
	// есть два процесса "отгрузка" и "приемка". 
	// в случае отгрузки (в том числе обратной) код поставщика это "свой" код
	// в случае приемки (т.е. когда мы находимся в роли покупателя или это обратная отгрузка нам) код поставщика это сторонний код 
	
	Если РежимПоставщик Тогда 
		
		Если ЭтоОбратнаяОтгрузка Тогда 
			
			КодТовараПоставщикаОбязательный = (НастройкаТолькоПоВнутреннемуКоду = Истина ИЛИ НЕ НастройкаТолькоПоШК = Истина); 
			ИмяКодаТовараПоставщика = "КодТовараСторонний";
			
		Иначе
			
			КодТовараПоставщикаОбязательный = Ложь;
			ИмяКодаТовараПоставщика = "КодТовараСвой";
			
		КонецЕсли;
		
	Иначе
		
		Если ЭтоОбратнаяОтгрузка Тогда 
			
			КодТовараПоставщикаОбязательный = (НастройкаТолькоПоВнутреннемуКоду = Истина); ; 
			ИмяКодаТовараПоставщика = "КодТовараСвой";
			
		Иначе
			
			КодТовараПоставщикаОбязательный = Ложь;
			ИмяКодаТовараПоставщика = "КодТовараСторонний";
			
		КонецЕсли;
		
	КонецЕсли;
	
	СтрокаКодаТовараПоставщика = ИменаРеквизитов.Добавить();
	
	СтрокаКодаТовараПоставщика.Имя = "КодТовараПоставщика";
	СтрокаКодаТовараПоставщика.ИмяВСоответствиях = ИмяКодаТовараПоставщика;
	СтрокаКодаТовараПоставщика.Обязательный = КодТовараПоставщикаОбязательный;

КонецПроцедуры

Процедура ДобавитьКодТовараПокупателя_В_ИменаРеквизитов(ИменаРеквизитов, НастройкаТолькоПоВнутреннемуКоду, НастройкаТолькоПоШК, ЭтоОбратнаяОтгрузка, РежимПоставщик)
	
	// есть два процесса "отгрузка" и "приемка". 
	// в случае отгрузки (в том числе обратной) код покупателя это сторонний код
	// в случае приемки (т.е. когда мы находимся в роли покупателя или это обратная отгрузка нам) код покупателя это "свой" код
	
	Если РежимПоставщик Тогда 
		
		Если ЭтоОбратнаяОтгрузка Тогда 
			
			КодТовараПокупателяОбязательный = Ложь; 
			ИмяКодаТовараПокупателя = "КодТовараСвой";
			
		Иначе
			
			КодТовараПокупателяОбязательный = (НастройкаТолькоПоВнутреннемуКоду = Истина ИЛИ НЕ НастройкаТолькоПоШК = Истина);
			ИмяКодаТовараПокупателя = "КодТовараСторонний";
			
		КонецЕсли;
		
	Иначе
		
		Если ЭтоОбратнаяОтгрузка Тогда 
			
			КодТовараПокупателяОбязательный = Ложь; 
			ИмяКодаТовараПокупателя = "КодТовараСторонний";
			
		Иначе
			
			КодТовараПокупателяОбязательный = (НастройкаТолькоПоВнутреннемуКоду = Истина ИЛИ НЕ НастройкаТолькоПоШК = Истина);
			ИмяКодаТовараПокупателя = "КодТовараСвой";
			
		КонецЕсли;
		
	КонецЕсли;
		
	СтрокаКодТовараПокупателя = ИменаРеквизитов.Добавить();
	
	СтрокаКодТовараПокупателя.Имя = "КодТовараПокупателя";
	СтрокаКодТовараПокупателя.ИмяВСоответствиях = ИмяКодаТовараПокупателя;
	СтрокаКодТовараПокупателя.Обязательный = КодТовараПокупателяОбязательный;

КонецПроцедуры

Процедура ДобавитьGTIN_В_ИменаРеквизитов(ИменаРеквизитов, НастройкаТолькоПоВнутреннемуКоду, НастройкаТолькоПоШК)
	
	СтрокаGTIN = ИменаРеквизитов.Добавить();
	
	СтрокаGTIN.Имя = "GTIN";
	СтрокаGTIN.ИмяВСоответствиях = "GTIN";
	СтрокаGTIN.Обязательный = (НастройкаТолькоПоШК = Истина ИЛИ НЕ НастройкаТолькоПоВнутреннемуКоду = Истина);

КонецПроцедуры

//старое название - КонвертироватьТовары1СвEDI_БМИ
Функция ПолучитьТаблицуСоответствийДляТоваров1С(ТаблицаТоваров, ВладелецСпискаТоваров, ИскатьТоварПоШК =  Ложь) Экспорт
	
	Если НастройкиМодуля.ИспользоватьХарактеристикиНоменклатуры Тогда
		ТаблицаТоваров.Свернуть("Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения");
	Иначе
		ТаблицаТоваров.Скопировать(,"Номенклатура, ЕдиницаИзмерения");
		ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваров, "ХарактеристикаНоменклатуры", Новый ОписаниеТипов("NULL,Строка",,Новый КвалификаторыСтроки(1))); 
	КонецЕсли;
	
	ЗапросКонвертацииТоваров1СвEDI = ИнициализироватьЗапрос_КонтурEDI(Ложь);
	ЗапросКонвертацииТоваров1СвEDI.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваров);
	ЗапросКонвертацииТоваров1СвEDI.УстановитьПараметр("ИскатьТоварПоШК", ИскатьТоварПоШК); 
	ЗапросКонвертацииТоваров1СвEDI.УстановитьПараметр("Партнер", ВладелецСпискаТоваров);
	
	// 1. Передать ТаблицаТоваров в параметры запроса и закинем во временную таблицу "ТабТоваров". 
	// И взять в поле "КодТовараСвой" код товара из справочника "Номенклатура" или его местного аналога.
	
	ЗапросКонвертацииТоваров1СвEDI.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Таб.Номенклатура КАК Номенклатура,
	|	Таб.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	Таб.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ПОМЕСТИТЬ _ТабТоваров
	|ИЗ
	|	&ТаблицаТоваров КАК Таб
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	ХарактеристикаНоменклатуры,
	|	ЕдиницаИзмерения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	_ТабТоваров.Номенклатура,
	|	_ТабТоваров.ХарактеристикаНоменклатуры,
	|	_ТабТоваров.ЕдиницаИзмерения,
	|	_ТабТоваров.Номенклатура.Код КАК КодТовараСвой
	|ПОМЕСТИТЬ ТабТоваров
	|ИЗ
	|	_ТабТоваров КАК _ТабТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ _ТабТоваров"
	;
	
	// 2. Соедить ТабТоваров с РС "КонтурEDI_СоответствияТоваров"
	// и дополнительно с РС "Штрихкоды" , если в режиме покупателя
	
	Если ИскатьТоварПоШК Тогда // мы торговая сеть
		
		// все запросы убраны в макет СКД с возможностью кастомизации через ПМ. 
		ТекстЗапросаПоШтрихкодам = ПолучитьТекстЗапросаПоШтрихкодамНоменклатуры(); 
		
		ЗапросКонвертацииТоваров1СвEDI.Текст = ЗапросКонвертацииТоваров1СвEDI.Текст 
		+ " 
		|; 
		|" 
		+ ТекстЗапросаПоШтрихкодам;
		
	КонецЕсли;
	
	// 3. Создать ТабТоваров и, если покупатель, то ВТШтрихкодыТоваров
	РезультатПМ = ОбработкаСобытияПодключаемогоМодуля("ИзменитьЗапросКонвертацииТоваров1СвEDI",,
			Новый Структура("Запрос,ДополнительныеПараметры",
			ЗапросКонвертацииТоваров1СвEDI,));
			
	Если НЕ РезультатПМ = Неопределено Тогда
		ЗапросКонвертацииТоваров1СвEDI = РезультатПМ;
	Иначе
		Если ИмяКонфигурации1С = "УФ_УТ" Тогда
			ПреобразоватьТипыЕдиницыИзмеренияЗапросаУФ_УТ(ЗапросКонвертацииТоваров1СвEDI);
		КонецЕсли;
		Если ИмяКонфигурации1С = "УФ_УНФ" Тогда
			ПреобразоватьТипыЕдиницыИзмеренияЗапросаУФ_УНФ(ЗапросКонвертацииТоваров1СвEDI);
		КонецЕсли;
	КонецЕсли;
	
	ЗапросКонвертацииТоваров1СвEDI.Выполнить(); 
	
	// 4. Выполнить запрос по регистру соответствий 
	ЗапросКонвертацииТоваров1СвEDI.Текст = ТекстЗапросаПоРегиструСведений_КонтурEDI(ИскатьТоварПоШК);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИскатьТоварПоШК" ,ИскатьТоварПоШК);
	
	ПараметрыСобытияПодключаемогоМодуля = Новый Структура;
	ПараметрыСобытияПодключаемогоМодуля.Вставить("Запрос", 					ЗапросКонвертацииТоваров1СвEDI);
	ПараметрыСобытияПодключаемогоМодуля.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
	
	РезультатПМ = ОбработкаСобытияПодключаемогоМодуля("ИзменитьЗапросПоРегиструСоответствий", , ПараметрыСобытияПодключаемогоМодуля);
	
	Если РезультатПМ <> Неопределено Тогда
		ЗапросКонвертацииТоваров1СвEDI = РезультатПМ;
	КонецЕсли;
	
	ТаблицаТоваровССоответствиями = ЗапросКонвертацииТоваров1СвEDI.Выполнить().Выгрузить();
	
	ТипКоэффициентаEDIВ1С = ПолучитьТип_КонтурEDI("КоэффициентEDIВ1С");
	
	ТипизироватьКолонкиВТаблицеЗначений(ТаблицаТоваровССоответствиями, "КоэффициентEDIВ1С", ТипКоэффициентаEDIВ1С);
	
	ТипСтрока500 = ОписаниеТипаСтрока_КонтурEDI(500);
	
	ТипизироватьКолонкиВТаблицеЗначений(ТаблицаТоваровССоответствиями, 
	"НаименованиеПартнера", ТипСтрока500);
	
	Возврат ТаблицаТоваровССоответствиями;
	
КонецФункции

Функция ТекстЗапросаПоРегиструСведений_КонтурEDI(ИскатьТоварПоШК)
	
	Если ИскатьТоварПоШК Тогда // мы торговая сеть
		
		ТекстЗапросаПоРегиструСоответствий =
		"ВЫБРАТЬ
		|	ТабТоваров.Номенклатура,
		|	ТабТоваров.ХарактеристикаНоменклатуры,
		|	ТабТоваров.ЕдиницаИзмерения,
		|	ТабТоваров.КодТовараСвой,
		|	ЕСТЬNULL(ВТШтрихкодыТоваров.GTIN, """") КАК GTIN
		|ПОМЕСТИТЬ табПодборИзШтрихкодов
		|ИЗ
		|	ТабТоваров КАК ТабТоваров
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТШтрихкодыТоваров КАК ВТШтрихкодыТоваров
		|		ПО ТабТоваров.Номенклатура = ВТШтрихкодыТоваров.Номенклатура
		|			И ТабТоваров.ЕдиницаИзмерения = ВТШтрихкодыТоваров.ЕдиницаИзмерения
		|			И (ВТШтрихкодыТоваров.ХарактеристикаНоменклатуры = НЕОПРЕДЕЛЕНО
		|				ИЛИ ТабТоваров.ХарактеристикаНоменклатуры = ВТШтрихкодыТоваров.ХарактеристикаНоменклатуры)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	табПодборИзШтрихкодов.Номенклатура,
		|	табПодборИзШтрихкодов.ХарактеристикаНоменклатуры,
