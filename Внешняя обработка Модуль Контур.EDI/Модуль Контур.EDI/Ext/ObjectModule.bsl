Функция КонтурEDI_ЕстьСобытиеВИспользуемыхРасширениях(ИмяСобытия)
	
	ЕстьСобытиеВРасширениях = ЭДО_Кэш_Прочитать("РезультатФункции_КонтурEDI_ЕстьСобытиеВРасширениях_" + ИмяСобытия);
	
	Если НЕ ЕстьСобытиеВРасширениях = Неопределено Тогда
		
		Возврат ЕстьСобытиеВРасширениях;

	КонецЕсли;           
	
	ЕстьСобытиеВРасширениях = Ложь; 
	
	ТаблицаКодаРасширений = ПолучитьТаблицуИсполняемогоКода(ИмяСобытия);
	
	Если НЕ ТаблицаКодаРасширений = Неопределено Тогда
		
		Для Каждого СтрокаТаблицы Из ТаблицаКодаРасширений Цикл
			
			РасширениеСсылка = СтрокаТаблицы.РасширениеСсылка;
			
			ИспользованиеРасширения = ПолучитьЗначениеДопРеквизитаСправочника_КонтурEDI(РасширениеСсылка, "Использование");  
			
			Если ИспользованиеРасширения = Истина Тогда
				
				ЕстьСобытиеВРасширениях = Истина;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ЭДО_Кэш_Поместить("РезультатФункции_КонтурEDI_ЕстьСобытиеВРасширениях_" + ИмяСобытия, ЕстьСобытиеВРасширениях);
	
	Возврат ЕстьСобытиеВРасширениях;
	
КонецФункции

Функция КонтурEDI_ПараметрыВызватьHTTPМетод_В_ВыполнитьHTTPЗапрос(Сессия, Метод, URL, ДополнительныеПараметры)
	
	ПараметрыВыполнитьHTTPЗапрос = Новый Структура("Метод,Адрес,ПараметрыЗапроса");
    ПараметрыВыполнитьHTTPЗапрос.Метод = Метод;
    ПараметрыВыполнитьHTTPЗапрос.Адрес = URL;
	
	ПараметрыЗапроса = НовыеПараметрыHTTPЗапроса();
	ПараметрыЗапроса.Заголовки = КонтурСтандарт_СкопироватьРекурсивно(ДополнительныеПараметры.Заголовки);
	
	Для Каждого Заголовок Из Сессия.Заголовки Цикл
		
		ПараметрыЗапроса.Заголовки.Вставить(Заголовок.Ключ, Заголовок.Значение);
		
	КонецЦикла;
	
	Если НЕ ДополнительныеПараметры.ПараметрыЗапроса = Неопределено Тогда
		Для Каждого ПараметрЗапроса Из ДополнительныеПараметры.ПараметрыЗапроса Цикл
			ПараметрыЗапроса.Параметры.Вставить(ПараметрЗапроса.Ключ, ПараметрЗапроса.Значение);		
		КонецЦикла;
	КонецЕсли;	
	
	НастройкиПрокси = Сессия.Прокси;
	Если НастройкиПрокси <> Неопределено Тогда
		
		Схема = "http";
		
		СерверПрокси = НастройкиПрокси.Сервер(Схема);
		Если Не ЗначениеЗаполнено(СерверПрокси) Тогда
			Схема = "https";
			СерверПрокси = НастройкиПрокси.Сервер(Схема)
		КонецЕсли;
		
		Порт = Формат(НастройкиПрокси.Порт(Схема),"ЧГ=0");
		
		Прокси = Новый Структура;
		Прокси.Вставить("host"		, СерверПрокси + ":" + Порт);
		Прокси.Вставить("username"  , "");
		Прокси.Вставить("password"  , "");
		
		Если КонтурСтандарт_ВерсияРежимСовместимостиНеНижеУказанной("8.3.6") Тогда
			
			Прокси.username = НастройкиПрокси.Пользователь(Схема);
			Прокси.password = НастройкиПрокси.Пароль(Схема);
			
		Иначе
			
			Прокси.username = НастройкиПрокси.Пользователь;
			Прокси.password = НастройкиПрокси.Пароль;
			
		КонецЕсли;
		
		ДополнительныеНастройкиПрокси = ПолучитьСписокСвойствEDI("ИспользоватьСистемныеНастройкиПрокси
																  |СпособАутентификацииПрокси");
		
		Прокси.Вставить("ИспользоватьСистемныеНастройкиПрокси", ДополнительныеНастройкиПрокси.ИспользоватьСистемныеНастройкиПрокси);
		Прокси.Вставить("СпособАутентификацииПрокси", ДополнительныеНастройкиПрокси.СпособАутентификацииПрокси); 
		
		ПараметрыЗапроса.Вставить("Прокси", Прокси); 
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДополнительныеПараметры.Json) Тогда 	
		
		ПараметрыЗапроса.ТелоЗапроса = Новый Структура("Строка", КонтурСтандарт_ЗначениеВСтрокуJSON(ДополнительныеПараметры.Json));
		
	ИначеЕсли ЗначениеЗаполнено(ДополнительныеПараметры.Данные) Тогда 
		
		Если ТипЗнч(ДополнительныеПараметры.Данные)	= Тип("Строка") Тогда
			
			ПараметрыЗапроса.ТелоЗапроса = Новый Структура("Строка", ДополнительныеПараметры.Данные);
			
		ИначеЕсли ТипЗнч(ДополнительныеПараметры.Данные) = Тип("ДвоичныеДанные") Тогда
			
			ПараметрыЗапроса.ТелоЗапроса = Новый Структура("ДвоичныеДанные", ДополнительныеПараметры.Данные);	
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДополнительныеПараметры.Свойство("Таймаут") Тогда
		
		ПараметрыЗапроса.Вставить("Таймаут", ДополнительныеПараметры.Таймаут);
		
	КонецЕсли;
	
	ПараметрыЗапроса.ТелоОтвета  = Новый Структура("ДвоичныеДанные");
	
	ПараметрыВыполнитьHTTPЗапрос.ПараметрыЗапроса = ПараметрыЗапроса;
	
	Возврат ПараметрыВыполнитьHTTPЗапрос;
	
КонецФункции
                       
Функция КонтурEDI_РезервныеАдресаСерверовКонтур() Экспорт

	РезервныеАдресаКонтур = ЭДО_Кэш_Прочитать("РезервныеАдресаСерверовКонтур");

	Если НЕ РезервныеАдресаКонтур = Неопределено Тогда
		Возврат РезервныеАдресаКонтур;
	КонецЕсли;

	Результат = ПолучитьФайл_EDI("/1c/KonturEDI_82/templates/reserved_server.json");

	Если НЕ Результат = Неопределено Тогда 
			
		ТекстФайла = КонтурСтандарт_ПолучитьСтрокуИзДвоичныхДанных_(Результат);

		РезервныеАдресаКонтур = КонтурСтандарт_ЗначениеИзСтрокиJSON(ТекстФайла, Истина);
		
		КонтурEDI_СохранитьРезервныеАдресаВСправочник(РезервныеАдресаКонтур);
		
	Иначе
		
		//Берём из справочника, если нет создаём.
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.Значение КАК ОсновнойАдрес,
			|	КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.ЗначениеСтрока КАК РезервныйАдрес
			|ИЗ
			|	Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты
			|ГДЕ
			|	НЕ КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.Ссылка.ПометкаУдаления
			|	И КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.Ссылка.ИмяСправочника = ""РезервныеАдреса""
			|	И КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.Ссылка.Наименование = ""Резервные адреса""";
		
		Результат = Запрос.Выполнить();
		
		РезервныеАдресаКонтур = Новый Соответствие;
		
		Если НЕ Результат.Пустой() Тогда
			
			Выборка = Результат.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				Если РезервныеАдресаКонтур.Получить(Выборка.ОсновнойАдрес) = Неопределено Тогда
					
					РезервныеАдресаКонтур.Вставить(Выборка.ОсновнойАдрес, Новый Массив);
					
				КонецЕсли;
				
				РезервныеАдресаКонтур[Выборка.ОсновнойАдрес].Добавить(Выборка.РезервныйАдрес);
			
			КонецЦикла;	
		
		Иначе
			
			РезервныеАдресаКонтур.Вставить("edi-api.kontur.ru", КонтурСтандарт_МассивЗначений("edi-api.kontur.ru", "edi-api2.kontur.ru", "edi-api3.kontur.ru"));
			РезервныеАдресаКонтур.Вставить("diadoc-api.kontur.ru", КонтурСтандарт_МассивЗначений("diadoc-api.kontur.ru", "diadoc-api2.kontur.ru", "diadoc-api3.kontur.ru"));
			
			КонтурEDI_СохранитьРезервныеАдресаВСправочник(РезервныеАдресаКонтур);
			
		КонецЕсли;
		
	КонецЕсли;

	ЭДО_Кэш_Поместить("РезервныеАдресаСерверовКонтур", РезервныеАдресаКонтур);

	Возврат РезервныеАдресаКонтур;
	
КонецФункции


Процедура КонтурEDI_СохранитьРезервныеАдресаВСправочник(РезервныеАдресаКонтур)
	
	Запрос = Новый Запрос; 
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_ДополнительныеСправочники.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
	|ГДЕ
	|	НЕ КонтурEDI_ДополнительныеСправочники.ПометкаУдаления
	|	И КонтурEDI_ДополнительныеСправочники.ИмяСправочника = ""РезервныеАдреса""
	|	И КонтурEDI_ДополнительныеСправочники.Наименование = ""Резервные адреса""";
	
	Результат = Запрос.Выполнить(); 	
	
	Если Результат.Пустой() Тогда
		
		РезервныеАдресаОбъект = Справочники.КонтурEDI_ДополнительныеСправочники.СоздатьЭлемент();
		РезервныеАдресаОбъект.Наименование = "Резервные адреса"; 
		РезервныеАдресаОбъект.ИмяСправочника = "РезервныеАдреса";
		
	Иначе   
		
		РезервныеАдресаСсылка = Результат.Выгрузить()[0].Ссылка;
		РезервныеАдресаОбъект = РезервныеАдресаСсылка.ПолучитьОбъект();
		
	КонецЕсли;
	
	НужноЗаписатьДанные = Ложь;
	
	Для Каждого КлючЗначение Из РезервныеАдресаКонтур Цикл
		
		ОсновнойАдрес = КлючЗначение.Ключ;
		
		Для Каждого РезервныйАдрес Из КлючЗначение.Значение Цикл	
			
			Отбор = Новый Структура("Значение, ЗначениеСтрока", ОсновнойАдрес, РезервныйАдрес);
			НайденныеСтроки = РезервныеАдресаОбъект.ДополнительныеРеквизиты.НайтиСтроки(Отбор);
			
			Если НЕ НайденныеСтроки.Количество() Тогда
				
				НоваяСтрокаСправочника = РезервныеАдресаОбъект.ДополнительныеРеквизиты.Добавить();
				НоваяСтрокаСправочника.Значение = ОсновнойАдрес; 
				НоваяСтрокаСправочника.ЗначениеСтрока = РезервныйАдрес;
				
				НужноЗаписатьДанные = Истина;
				
			КонецЕсли;
						
		КонецЦикла;
		
	КонецЦикла;
	
	Если НужноЗаписатьДанные Тогда
		РезервныеАдресаОбъект.Записать();
	КонецЕсли;
	
КонецПроцедуры

