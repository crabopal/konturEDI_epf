Процедура ОбработатьТаблицуСообщений(ТаблицаСообщений, УчетнаяЗапись = Неопределено)
	
	Если ТаблицаСообщений.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	ТаблицаСообщений.Сортировать("Дата Возр");
	
	Метрика_ИдЗамера = Метрика_НовыйУИД();
	Метрика_НачатьЗамер(Метрика_ИдЗамера, "ЗагрузитьНовыеСообщенияИзЯщика");
	Метрика_МассивСообщений = Новый Массив;
	
	Для Каждого СтрокаСообщения Из ТаблицаСообщений Цикл
		
		Метрика_ВремяНачала = Метрика_ОтметкаВремени();
		
		ИмяФайла 		 = СтрокаСообщения.ИмяФайла;
		ПолныйПутьКФайлу = СтрокаСообщения.ПолныйПутьКФайлу; 
		ТипСообщения 	 = СтрокаСообщения.ТипСообщения; 
		
		Сообщение = ПрочитатьСообщениеПоНовому(ПолныйПутьКФайлу, ТипСообщения, "Входящее");
		Если Сообщение.Статус = "ВходящийОшибкаЧтенияФайла" Тогда 
			
			Метрика_Переменные = Новый Структура("ТипСообщения, ИмяФайла", ТипСообщения, ИмяФайла);
			Метрика_Ошибка("ПрочитатьСообщениеПоНовому", Сообщение.ОписаниеОшибки,
			Сообщение.ИнформацияОбОшибке, Метрика_Переменные, Истина);
			Продолжить;
			
		КонецЕсли;	
		
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Сообщение",					Сообщение);
		СтруктураПараметров.Вставить("EventType", 					"");
		СтруктураПараметров.Вставить("boxId", 						"");
		СтруктураПараметров.Вставить("УчетнаяЗапись",				"");
		СтруктураПараметров.Вставить("ПрекратитьЗагрузкуСообщения",	Ложь);
		
		Если НЕ ТипСообщения = "reports" И НЕ ЗначениеЗаполнено(Сообщение.ID) Тогда
			СтруктураПараметров.ПрекратитьЗагрузкуСообщения = Истина;
			ТекстОшибки = КонтурСтандарт_СтрШаблон_("Не удалось обработать входящее сообщение - %1, по причине: не заполнен ID сообщения", ИмяФайла);
			ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);
		КонецЕсли;
		
		ПередОбработкойВходящегоСообщения(СтруктураПараметров);
		
		Если СтруктураПараметров.ПрекратитьЗагрузкуСообщения = Истина Тогда
			Продолжить;
		Иначе
			Сообщение = СтруктураПараметров.Сообщение;
		КонецЕсли;
		
		РезультатСохранения = ОбработатьВходящееСообщение(Сообщение);
		
		Если РезультатСохранения.Свойство("Сообщение") Тогда
			ДействияПослеСохраненияВходящегоСообщения(РезультатСохранения.Сообщение);
		КонецЕсли;
		
		Если РезультатСохранения.МожноУдалятьСообщение 
			И НЕ НастройкиМодуля.ПротоколОбмена_КонтурEDI = "Каталог"
			И НЕ НастройкиМодуля.ПротоколОбмена_КонтурEDI = "API" Тогда
			
			ПараметрыЗагрузки = Новый Структура;
			ПараметрыЗагрузки.Вставить("ПутьКФайлу", Сообщение.ПутьКФайлу);
			ПараметрыЗагрузки.Вставить("GLN", УчетнаяЗапись.GLN);
			
			ПослеУспешнойЗагрузкиСообщения(ПараметрыЗагрузки, СтрокаСообщения.Каталог);
			
		КонецЕсли;
		
		УдалитьФайлы_КонтурEDI(ПолныйПутьКФайлу);
		
		Метрика_ВремяОкончания = Метрика_ОтметкаВремени();
		Метрика_МассивСообщений.Добавить(Новый Структура(Врег(ТипСообщения), Метрика_Длительность(Метрика_ВремяНачала, Метрика_ВремяОкончания)));
		
	КонецЦикла;
	
	Метрика_ЗакончитьЗамер(Метрика_ИдЗамера, "ЗагрузитьНовыеСообщенияИзЯщика",,,, Новый Структура("КоличествоСообщений, МассивСообщений", Метрика_МассивСообщений.Количество(),	Метрика_МассивСообщений	));

КонецПроцедуры

Процедура ЗагрузитьНовыеСообщения_Каталог(ТипСообщенияДляОбработки = Неопределено) 
	
	АдресКаталогаОбменаEDI = ПолучитьПараметрыИнтернетСоединения_KE().АдресКаталогаОбменаEDI;
	
	Если НЕ ЗначениеЗаполнено(АдресКаталогаОбменаEDI) Тогда
		ВызватьИсключение "Не указан каталог обмена";
	КонецЕсли;
	
	ТекстОшибки = "";
	МассивКаталогов = EDI_РазложитьСтрокуВМассивСлов("Inbox,Reports",",");
	
	Для Каждого Каталог Из МассивКаталогов Цикл
		Если НЕ ПроверитьСуществованиеФайлаКаталога(АдресКаталогаОбменаEDI + "\" + Каталог) Тогда
			ТекстОшибки = ТекстОшибки + "Отсутствует каталог: " + АдресКаталогаОбменаEDI + "\" + Каталог + Символы.ПС;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ТекстОшибки = "" Тогда 
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Попытка
			
		ТаблицаСообщений = ПолучитьТаблицуСообщений_Каталог(МассивКаталогов, ТипСообщенияДляОбработки);
		
		ОбработатьТаблицуСообщений(ТаблицаСообщений);
		
	Исключение 
		
		ТекстОшибки = "Не удалось загрузить новые сообщения из каталога по причине: " + ОписаниеОшибки(); 
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);	
		Сообщить(ТекстОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗагрузитьНовыеСообщения_DialMail(ТипСообщенияДляОбработки = Неопределено) 
	
	УчетныеЗаписи   = ПолучитьСписокЭлементовСправочника("УчетныеЗаписи");
	МассивКаталогов = EDI_РазложитьСтрокуВМассивСлов("Inbox,Reports", ",");
	
	Для Каждого УчетнаяЗапись Из УчетныеЗаписи Цикл
		
		Если УчетнаяЗапись.НеАктивна = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			
			ТаблицаСообщений = ПолучитьТаблицуСообщений_DialMail(МассивКаталогов, УчетнаяЗапись, ТипСообщенияДляОбработки);
			
			ОбработатьТаблицуСообщений(ТаблицаСообщений, УчетнаяЗапись);
			
		Исключение 
			
			ТекстОшибки = "Не удалось загрузить новые сообщения DialMail по причине: " + ОписаниеОшибки(); 
			ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);	
			Сообщить(ТекстОшибки);
			Продолжить
			
		КонецПопытки;

	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьНовыеСообщения_FTP(ТипСообщенияДляОбработки = Неопределено) 
	
	УчетныеЗаписи = ПолучитьСписокЭлементовСправочника("УчетныеЗаписи");
	МассивКаталогов = EDI_РазложитьСтрокуВМассивСлов("Inbox,Reports" , ",");
	
	Для Каждого УчетнаяЗапись Из УчетныеЗаписи Цикл
		
		Если УчетнаяЗапись.НеАктивна = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			
			ТаблицаСообщений = ПолучитьТаблицуСообщений_FTP(МассивКаталогов, УчетнаяЗапись, ТипСообщенияДляОбработки);
			ОбработатьТаблицуСообщений(ТаблицаСообщений, УчетнаяЗапись);
		
		Исключение 
			
			ТекстОшибки = "Не удалось загрузить новые сообщения FTP по причине: " + ОписаниеОшибки(); 
			ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);	
			Сообщить(ТекстОшибки);
			Продолжить
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

//Для сообщения, отправляемого от имени организации с "GLN", возвращает boxId нужного транспортного ящика в API
Функция ПолучитьЯщикДляОтправкиСообщения(GLN)

	//торговые сети с РБД могут переопределить здесь ящики для отправки исходящих сообщений
	СтандартнаяОбработкаEDI = Истина;
	Результат = ОбработкаСобытияПодключаемогоМодуля("ПолучитьЯщикДляОтправкиСообщения",СтандартнаяОбработкаEDI,Новый Структура("GLN",GLN));
	Если СтандартнаяОбработкаEDI=Ложь Тогда
		Возврат Результат;
	КонецЕсли;
	
	СписокОрганизаций = ПолучитьСписокЭлементовСправочника("НашиОрганизации");
	
	СтрокиОрганизаций = СписокОрганизаций.НайтиСтроки(Новый Структура("GLN,Неактивная",GLN,Ложь));
	Если СтрокиОрганизаций.Количество()<>1 Тогда
		Возврат "";
	КонецЕсли;
	
	ОсновнойЯщик = ПолучитьЗначениеСвойстваОбъектаEDI(СтрокиОрганизаций[0].Ссылка, "ОсновнойЯщик");
	Если ОсновнойЯщик=Неопределено Тогда
		Возврат "";
	КонецЕсли;	
	
	Возврат ПолучитьЗначениеСвойстваОбъектаEDI(ОсновнойЯщик, "id");

	
КонецФункции	

Функция ОтправитьСообщение(ТипСообщения,ДокументСсылка,Параметры = Неопределено,ОтправитьСразу = Ложь) Экспорт
	
	СообщениеОтправляетсяИзФормы = (НЕ Параметры = Неопределено И Параметры.Свойство("ОтправитьСообщениеИзФормы"));
	
	//Пачка костылей для совместимости со старыми подключаемыми модулями. Видимо, навсегда.
	Если ОтправитьСразу Тогда // сообщения уже созданы, нужно их только отправить
		Сообщение = ПрочитатьСообщение(,ДокументСсылка,ТипСообщения,"Исходящее");
	ИначеЕсли СообщениеОтправляетсяИзФормы Тогда	
		Сообщение = Параметры.Сообщение;//отправляем сообщение, которое уже заполнено, но еще не записано в базу. Надо его сначала записать.
	Иначе
		Сообщение = ПодготовитьИсходящееСообщение(ТипСообщения,ДокументСсылка,Параметры);//сообщение еще не подготовлено, надо подготовить его здесь.
	КонецЕсли;
	
	Если Сообщение = Неопределено
		Или Сообщение.СодержитОшибки = Истина Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ ОтправитьСразу Тогда
		СохранитьСообщение(Сообщение);
	КонецЕсли;
	
	ОтдельныйORDRSPНаКаждыйДокументЗаказа = (ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, "ОтдельныйORDRSPНаКаждыйДокументЗаказа") = Истина);

	Если ТипСообщения = "ORDRSP" И 
		НЕ ОтдельныйORDRSPНаКаждыйДокументЗаказа Тогда
		
		//Блок для ORDRSP в случае множественных заказов
		СообщениеУжеОтправлено = СформироватьORDRSPДляВиртуальныхСвязанныхORDERS(Сообщение, ДокументСсылка, Параметры);
		Если СообщениеУжеОтправлено Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	//Здесь сообщение подготовлено, сохранено в базу с нужным статусом.
	//Можем отправить его сразу или дождаться нажатия кнопки "Выполнить обмен".
	
	Если (ПараметрыПользователяEDI.ВариантОбмена = "Автоматический" Или ОтправитьСразу)
		И Сообщение.СообщениеСсылка <> Неопределено Тогда 
		ОтправитьПодготовленноеСообщение(Сообщение.СообщениеСсылка);
	Иначе
		Возврат Неопределено;//сообщение будет передано на сервер после нажатия "Выполнить обмен"
	КонецЕсли;
	
КонецФункции

Функция СформироватьORDRSPДляВиртуальныхСвязанныхORDERS(Сообщение, ДокументСсылка, Параметры)

	Если НЕ ДокументСсылка = Неопределено Тогда
		//продублируем ORDRSP на все связанные сообщения
		ТабВиртуальныхСообщений = ПолучитьВиртуальныеСвязанныеORDERS(ДокументСсылка);
		ТабСвязанныхДокументов 	= ПолучитьТаблицуСвязанныхДокументовПоТипамСообщений(НайтиСвязанныйДокументПоТипуСообщения(ДокументСсылка,"ORDERS"));
		
		Если ЗначениеЗаполнено(ТабСвязанныхДокументов) Тогда 			
			Для Каждого Стр Из ТабВиртуальныхСообщений Цикл
				Если Не ЗначениеЗаполнено(Стр.ORDRSP) Тогда
					
					НайденнаяСтрока = ТабСвязанныхДокументов.Найти(Стр.Документ, "Документ_ORDERS");
					Если НайденнаяСтрока = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					Док_ORDRSP = НайденнаяСтрока.Документ_ORDRSP;
					Если НЕ ЗначениеЗаполнено(Док_ORDRSP) Тогда
						Продолжить;
					КонецЕсли;
					
					//создадим копию
					_НовВиртуальноеСообщение			= ПреобразоватьЗначениеДляВнешнегоХранилища(Сообщение.СообщениеСсылка).Скопировать();
					_НовВиртуальноеСообщение.Документ	= ПреобразоватьЗначениеДляВнешнегоХранилища(Док_ORDRSP);
					_НовВиртуальноеСообщение.Статус		= "Отправлен";
					_НовВиртуальноеСообщение.УстановитьНовыйКод();
					
					СохранитьОбъектСообщения(_НовВиртуальноеСообщение);
					
					//и еще статус документа продублируем
					МЗ = РегистрыСведений.КонтурEDI_СтатусыДокументов.СоздатьМенеджерЗаписи();

					МЗ.Документ = ПреобразоватьЗначениеДляВнешнегоХранилища(Док_ORDRSP);
					
					МЗ.ИмяСтатуса = "Заказ";
					МЗ.Статус = Сообщение.Статус;
					МЗ.Записать();
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;
	КонецЕсли;	
	
	//Возможно, в пачке связанных ORDRSP текущее сообщение уже было отправлено
	СтатусДоставки = ПолучитьСтатусСообщения(Сообщение.СообщениеСсылка, , "ORDRSP");
	Если СтатусДоставки = "Ожидает отправки"
		Или СтатусДоставки = "Отправляется" Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции // СформироватьORDRSPДляВиртуальныхСвязанныхORDERS
	
Функция ПреобразоватьвСистему(Число10, Система)
	
	Если Система > 36 ИЛИ Система < 2 Тогда
		Сообщить("Выбранная система исчисления не поддерживается");
		Возврат -1;
	КонецЕсли;
	
	СтрокаЗначений = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	СтрокаСистема = "";
	Пока Число10 > 0 Цикл
		РезДеления 			= Число10 / Система;
		ЧислоСистема 		= Цел(РезДеления);
		ОстатокОтДеления 	= Число10 - Система * (ЧислоСистема);
		СтрокаСистема 		= Сред(СтрокаЗначений, ОстатокОтДеления + 1, 1) + СтрокаСистема;
		Число10 			= ?(ЧислоСистема = 0, 0, РезДеления); 
	КонецЦикла;
	
	Нечётное = СтрДлина(СтрокаСистема) - Цел(СтрДлина(СтрокаСистема) / 2) * 2;
	Если Нечётное Тогда
		СтрокаСистема = "0" + СтрокаСистема;
	КонецЕсли;
	
	Возврат СтрокаСистема;
	
КонецФункции

Функция ПреобразоватьКURL_КонтурEDI(Стр) Экспорт
	
	Длина = СтрДлина(Стр);
	Итог = "";
	
	Для Н = 1 По Длина Цикл
		
		Знак = Сред(Стр, Н, 1);
		Код  = КодСимвола(Знак);
		
		Если Знак = " " Тогда
			Итог = Итог + "%20";
		//ИначеЕсли Знак = "/" Тогда
		//	Итог = Итог + "%2F";
		ИначеЕсли Знак = "\" Тогда
			Итог = Итог + "%5C";
		ИначеЕсли ((Знак >= "a") И (Знак <= "z")) 
			ИЛИ	((Знак >= "A" ) И (Знак <= "Z")) 
			ИЛИ	((Знак >= "0" ) И (Знак <= "9")) Тогда
			
			Итог = Итог + Знак;
			
		Иначе
			
			Если (Код >= КодСимвола("А")) И (Код <= КодСимвола("п")) Тогда
				
				Итог = Итог + "%" + ПреобразоватьвСистему(208, 16) + "%" + ПреобразоватьвСистему(144 + Код - КодСимвола("А"), 16);
				
			ИначеЕсли (Код >= КодСимвола("р")) И (Код <= КодСимвола("я")) Тогда
				
				Итог = Итог + "%" + ПреобразоватьвСистему(209, 16) + "%" + ПреобразоватьвСистему(128 + Код - КодСимвола("р"), 16);
				
			ИначеЕсли (Знак = "ё") Тогда
				
				Итог = Итог + "%" + ПреобразоватьвСистему(209, 16) + "%" + ПреобразоватьвСистему(145, 16);
				
			ИначеЕсли (Знак = "Ё") Тогда
				
				Итог = Итог + "%" + ПреобразоватьвСистему(208, 16) + "%" + ПреобразоватьвСистему(129, 16);
				
			Иначе
				Итог = Итог + Знак;
			КонецЕсли;
		
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат Итог;
	
КонецФункции

Функция ЗагрузитьФайлы_КонтурEDI(МассивИменФайлов, КаталогНаСервере, КаталогЛокальный) Экспорт
	
	РезультатЗагрузки = Новый Структура("Успешно,ОписаниеОшибки,МассивЗагруженныхФайлов", Ложь, "", Новый Массив);
	
	// создаем каталог
	Каталог = Новый Файл(КаталогЛокальный);
	Если Не Каталог.Существует() Тогда
		СоздатьКаталог(КаталогЛокальный);
	КонецЕсли;
	
	Для Каждого ИмяФайлМассива Из МассивИменФайлов Цикл
		
		// создаем подкаталог   
		ПозицияРазделителя = Найти(ИмяФайлМассива, "/");
		Если Не ПозицияРазделителя = 0 Тогда
			ПутьКаталога = КаталогЛокальный + "\" + Лев(ИмяФайлМассива, ПозицияРазделителя - 1);
			Каталог = Новый Файл(ПутьКаталога);
			Если Не Каталог.Существует() Тогда
				СоздатьКаталог(ПутьКаталога);
			КонецЕсли;
		КонецЕсли;
		
		Результат = ПолучитьФайл_EDI(КаталогНаСервере + ИмяФайлМассива);
		
		Если Результат = Неопределено Тогда 
			РезультатЗагрузки.Успешно = Ложь;
			РезультатЗагрузки.ОписаниеОшибки = "Не удалось получить файл " + ИмяФайлМассива + " с сервера. Проверьте Ваше подключение к Интернет.";
			Возврат РезультатЗагрузки;	
		КонецЕсли;
		
		Результат.Записать(КаталогЛокальный + СтрЗаменить(ИмяФайлМассива, "/", "\"));
		
		// отладка
		// КопироватьФайл("C:\20160801\" + ИмяФайлМассива, КаталогЛокальный + СтрЗаменить(ИмяФайлМассива, "/", "\"));
		
		РезультатЗагрузки.Успешно  = Истина;
		РезультатЗагрузки.МассивЗагруженныхФайлов.Добавить(КаталогЛокальный + СтрЗаменить(ИмяФайлМассива, "/", "\"));
	
	КонецЦикла;
	
	Возврат РезультатЗагрузки;

КонецФункции

Функция ПолучитьМакет_КонтурEDI(ИмяМакета,
                                РасширениеФайла, 
								Кэшировать = Истина,
                                ИскатьНаСервере = Истина,
                                ИскатьВОсновномМодуле = Истина,
                                ИскатьВоВнешнемМодуле = Истина) Экспорт
								
	Результат = Неопределено;								
								
	Если ИскатьВоВнешнемМодуле 
		И НЕ ВнешнийМодуль = Неопределено 
		И НЕ ВнешнийМодуль.Метаданные().Макеты.Найти(ИмяМакета) = Неопределено Тогда
		
		ПолноеИмяМакета = "Макет_ВнешнийМодуль_" + ИмяМакета;
		Результат = ЭДО_Кэш_Прочитать(ПолноеИмяМакета);
		Если Результат = Неопределено Тогда
			Результат = ВнешнийМодуль.ПолучитьМакет(ИмяМакета);
		КонецЕсли;
	КонецЕсли;
	
	Если Результат = Неопределено
		И ИскатьНаСервере Тогда
		
		ПолноеИмяМакета = "Макет_Сервер_" + ИмяМакета;
		Результат = ЭДО_Кэш_Прочитать(ПолноеИмяМакета);
		Если Результат = Неопределено Тогда
			Результат = ПолучитьМакетССервера_КонтурEDI(ИмяМакета, РасширениеФайла);
		КонецЕсли;
	КонецЕсли;
	
	Если Результат = Неопределено
		И ИскатьВОсновномМодуле
		И НЕ ЭтотОбъект.Метаданные().Макеты.Найти(ИмяМакета) = Неопределено Тогда
		
		ПолноеИмяМакета = "Макет_ОсновнойМодуль_" + ИмяМакета;
		Результат = ЭДО_Кэш_Прочитать(ПолноеИмяМакета);
		Если Результат = Неопределено Тогда
			Результат = ЭтотОбъект.ПолучитьМакет(ИмяМакета);
		КонецЕсли;
	КонецЕсли;
	
	Если Кэшировать
		И НЕ Результат = Неопределено Тогда
		ЭДО_Кэш_Поместить(ПолноеИмяМакета, Результат);
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

Функция ПолучитьМакетССервера_КонтурEDI(ИмяМакета, РасширениеФайла)
	
	МассивИменФайлов = Новый Массив;
	МассивИменФайлов.Добавить(ИмяМакета + "." + РасширениеФайла);
	
	РезультатЗагрузки 	= 	ЗагрузитьФайлы_КонтурEDI(МассивИменФайлов, 
														ПолучитьКаталогМакетовEDI("НаСервере"), 
														ПолучитьКаталогМакетовEDI("Локальный"));
	
	Если РезультатЗагрузки.Успешно
		И НЕ РезультатЗагрузки.МассивЗагруженныхФайлов.Количество() = 0 Тогда
		Попытка
			ИмяФайлаДанных = РезультатЗагрузки.МассивЗагруженныхФайлов[0];
			Если РасширениеФайла = "mxl" Тогда
				Результат = Новый ТабличныйДокумент;
				Результат.Прочитать(ИмяФайлаДанных);
			ИначеЕсли РасширениеФайла = "xml" Тогда
				ТекстДок = Новый ТекстовыйДокумент;
				ТекстДок.Прочитать(ИмяФайлаДанных);
				Если НЕ Найти(Нрег(ТекстДок.ПолучитьСтроку(1)), "datacompositionschema") = 0
					ИЛИ НЕ Найти(Нрег(ТекстДок.ПолучитьСтроку(2)), "datacompositionschema") = 0 Тогда
					ЧтениеСхемы = Новый ЧтениеXML;
					ЧтениеСхемы.ОткрытьФайл(ИмяФайлаДанных);
					Результат = СериализаторXDTO.ПрочитатьXML(ЧтениеСхемы);
				Иначе
					// двоичные данные
					Результат = Новый ДвоичныеДанные(ИмяФайлаДанных);
				КонецЕсли;
			Иначе
				// двоичные данные
				Результат = Новый ДвоичныеДанные(ИмяФайлаДанных);
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось получить макет с сервера - " + ОписаниеОшибки());	
		КонецПопытки;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция СоединениеОбъектDialMail(УчетнаяЗапись)
	
	Перем Сервер;
	
	СоединениеОбъект = ПолучитьОбъектСоединенияИзКэша(УчетнаяЗапись);
	
	Если СоединениеОбъект = Неопределено 
		ИЛИ НЕ (Строка(ТипЗнч(СоединениеОбъект)) = "НеизвестныйОбъект"	ИЛИ Строка(ТипЗнч(СоединениеОбъект)) = "AddIn.FTP")
		И НЕ СокрЛП(СоединениеОбъект.Команда("noop")) = ("200 OK") Тогда
		
		ПараметрыТранспорта = ПолучитьПараметрыИнтернетСоединения_KE();
		
		Сервер = ПараметрыТранспорта.Сервер;
		Порт   = ПараметрыТранспорта.Порт;
		Логин  = УчетнаяЗапись.Логин;
		Пароль = УчетнаяЗапись.Пароль;
		
		ИспользуетсяПрокси = ПараметрыТранспорта.ИспользуетсяПрокси;
		СерверПрокси 	   = ПараметрыТранспорта.СерверПрокси;
		ПортПрокси 		   = ПараметрыТранспорта.ПортПрокси;
		ЛогинПрокси 	   = ПараметрыТранспорта.ЛогинПрокси;
		ПарольПрокси	   = ПараметрыТранспорта.ПарольПрокси;
		ТипПрокси  		   = ПараметрыТранспорта.ТипПрокси;
		ПассивныйРежим 	   = ПараметрыТранспорта.ПассивныйРежим;
		КоличествоПопыток  = 10;
				
		Для Счетчик = 1 По 5 Цикл 
							
				Если НЕ КомпонентаDialMailПодключена = Истина Тогда
					
					КомпонентаDialMailПодключена = ПодключитьВнешнююКомпоненту_КонтурEDI("AddIn.FTP");
					
				КонецЕсли;
				
				Если НЕ КомпонентаDialMailПодключена Тогда 
										
					ВызватьИсключение "Не удалось подключить компоненту ""AddIn.FTP"", обратитесь в техническую поддержку";  

				КонецЕсли;
				
				Попытка
					
				СоединениеОбъект = Новый("Addin.FTP");
				
				Если ИспользуетсяПрокси Тогда
					СоединениеОбъект.ХостПрокси 			 = СерверПрокси;
					СоединениеОбъект.ПортПрокси 			 = ПортПрокси;
					СоединениеОбъект.ИмяПользователяПрокси 	 = ЛогинПрокси;
					СоединениеОбъект.ПарольПрокси 		 	 = ПарольПрокси;
					СоединениеОбъект.ИспользоватьПрокси 	 = ТипПрокси;
				КонецЕсли;
				
				Если СоединениеОбъект.Подключиться(Сервер, Порт, Логин, Пароль, ПассивныйРежим, КоличествоПопыток) = 1 Тогда
					
					ПоместитьОбъектСоединенияВКэш(УчетнаяЗапись,СоединениеОбъект);
					Возврат СоединениеОбъект;
					
				Иначе
					Если СокрЛП(СоединениеОбъект.lastserveranswer) = "530 Login or password incorrect!" Тогда
						ВызватьИсключение "Неправильный пароль для логина " + Логин;;
					КонецЕсли;	
				КонецЕсли;
				
			Исключение
				Состояние_КонтурEDI("Потеряно соединение с ФТП сервером, восстанавливаю...");
				ОписаниеОшибки = ОписаниеОшибки(); 
				
				Если НЕ Найти(ОписаниеОшибки, "Неправильный пароль для логина") = 0 Тогда
					ВывестиПредупреждение_КонтурEDI(ОписаниеОшибки);
					Возврат Неопределено;
				КонецЕсли;	
				
			КонецПопытки;
		КонецЦикла;
		
	КонецЕсли;
	
	Если СоединениеОбъект = Неопределено Тогда 
		ВывестиПредупреждение_КонтурEDI("Не удалось подключиться к серверу."+Символы.ПС
		+ "Проверьте наличие доступа в интернет, настройки подключения модуля и правильность логина/пароля учетной записи " + УчетнаяЗапись.GLN);
	КонецЕсли;
	
	Возврат СоединениеОбъект;
	
КонецФункции

Функция СоединениеОбъектFTP(УчетнаяЗапись)
	
	Перем Сервер;
	
	СоединениеОбъект = ПолучитьОбъектСоединенияИзКэша(УчетнаяЗапись);
	Таймаут = 15;
	
	Если (СоединениеОбъект = Неопределено) ИЛИ (НЕ ТипЗнч(СоединениеОбъект) = Тип("FTPСоединение")) Тогда
		
		Для Счетчик = 1 По 5 Цикл 
			
			Попытка
				
				ПараметрыТранспорта = ПолучитьПараметрыИнтернетСоединения_KE();
				
				Сервер = ПараметрыТранспорта.Сервер; 
				Порт   = ПараметрыТранспорта.Порт; 
				Логин  = УчетнаяЗапись.Логин;
				Пароль = УчетнаяЗапись.Пароль; 
				ПассивныйРежим = ПараметрыТранспорта.ПассивныйРежим; 
				
				СоединениеОбъект = Новый FTPСоединение(Сервер, Порт, Логин, Пароль, , ПассивныйРежим, Таймаут);
				
				ПоместитьОбъектСоединенияВКэш(УчетнаяЗапись, СоединениеОбъект);
				
				Прервать;
				
			Исключение
				
				Состояние_КонтурEDI("Потеряно соединение с ФТП сервером, восстанавливаю...");
				
				ОписаниеОшибки = ОписаниеОшибки(); 
				
				Если НЕ Найти(ОписаниеОшибки, "Login denied") = 0 Тогда
					ВывестиПредупреждение_КонтурEDI("Неправильный пароль для логина " + УчетнаяЗапись.Логин);
					Возврат Неопределено;
				КонецЕсли;	
				
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если СоединениеОбъект = Неопределено Тогда 
		ВывестиПредупреждение_КонтурEDI("Не удалось подключиться к серверу."+Символы.ПС
		+ "Проверьте наличие доступа в интернет, настройки подключения модуля и правильность логина/пароля учетной записи " + УчетнаяЗапись.GLN);
	КонецЕсли; 

	Возврат СоединениеОбъект;
	
КонецФункции

Функция ДанныеАвторизацииДляКонтурEDIAPI(ДанныеАвторизацииВнешние)

	ТипыАвторизации = КонтурEDIAPI_ТипыАвторизации();

	Если ДанныеАвторизацииВнешние.Свойство("ТипАвторизации") Тогда
		ТипАвторизации = ДанныеАвторизацииВнешние.ТипАвторизации;
	Иначе
		ТипАвторизации = ТипыАвторизации.ЛогинПароль;
	КонецЕсли;

	ИспользоватьПортальнуюАвторизацию = ПолучитьКонстантуEDI("ИспользоватьПортальнуюАвторизацию") = Истина;
	
	Если ТипАвторизации = ТипыАвторизации.ТокенДоступа И Не ИспользоватьПортальнуюАвторизацию Тогда
		
		ВызватьИсключение("Использование авторизации через портал Контура отключено в настройках модуля");
		
	КонецЕсли;
	
	ДанныеАвторизацииEDI = КонтурEDIAPI_НовыйДанныеАвторизации(ТипАвторизации);
	
	Если ТипАвторизации = ТипыАвторизации.ЛогинПароль Тогда
		
		ДанныеАвторизацииEDI.Логин  = ДанныеАвторизацииВнешние.Логин;
		ДанныеАвторизацииEDI.Пароль = ДанныеАвторизацииВнешние.Пароль;
		
	ИначеЕсли ТипАвторизации = ТипыАвторизации.ТокенДоступа Тогда
		
		ДанныеАвторизацииEDI.Организация  = ДанныеАвторизацииВнешние.Организация;
		ДанныеАвторизацииEDI.ПортальныйИд  = ДанныеАвторизацииВнешние.ПортальныйИд;
		
	КонецЕсли;		
	
	Возврат ДанныеАвторизацииEDI;
	
КонецФункции

//**********************************************************
//	ОСНОВНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ


//Декомпозиция метода "ПередатьСообщениенаСервер"
//Определим по GLN отправителя нужные параметры:
//	учетная запись, каталог обмена (для offline), boxId (для API)
//И допишем их в Структуру "Результат"
Процедура ОпределитьПараметрыОтправкиСообщения(GLN, Результат)
	
	//в Результат добавляются:
	//УчетнаяЗапись
	//boxId
	//АдресКаталогаОбменаEDI
	
	УчетнаяЗаписьEDI = НайтиУчетнуюЗаписьПоGLN_КонтурEDI(GLN);
	
	Если УчетнаяЗаписьEDI = Неопределено Тогда
		ЗарегистрироватьОшибку(Результат, "Не найдена активная учетная запись для GLN: " + GLN);
		Возврат;
	КонецЕсли;
	
	Результат.Вставить("УчетнаяЗапись",	ПолучитьЭлементСправочника("УчетныеЗаписи", УчетнаяЗаписьEDI.Ссылка));
	
	Если ПротоколОбмена_КонтурEDI = "API" Тогда
		
		Результат.Вставить("boxId", ПолучитьЯщикДляОтправкиСообщения(УчетнаяЗаписьEDI.GLN));
		
		Если Не ЗначениеЗаполнено(Результат.boxId) Тогда
			ЗарегистрироватьОшибку(Результат, "Не найден активный транспортный ящик для отправки сообщения от GLN " + УчетнаяЗаписьEDI.GLN);
			Возврат;
		КонецЕсли;	
		
	ИначеЕсли ПротоколОбмена_КонтурEDI = "Каталог" Тогда
		
		Результат.Вставить("АдресКаталогаОбменаEDI", ПолучитьПараметрыИнтернетСоединения_KE().АдресКаталогаОбменаEDI);
		
	КонецЕсли;	
	
КонецПроцедуры

Функция НайтиУчетнуюЗаписьПоGLN_КонтурEDI(Знач GLN, ИскатьПоСинонимам = Истина)
	
	УчетнаяЗаписьEDI = Неопределено;
	
	Если УчетныеЗаписи = Неопределено Тогда
		УчетныеЗаписи = ПолучитьСписокЭлементовСправочника("УчетныеЗаписи");
	КонецЕсли;  
	
	СтруктураПоиска = Новый Структура("GLN,НеАктивна", GLN, Ложь);	
	СтрокиУчетныхЗаписей = УчетныеЗаписи.НайтиСтроки(СтруктураПоиска);
	
	Если СтрокиУчетныхЗаписей.Количество() Тогда
		
		УчетнаяЗаписьEDI = СтрокиУчетныхЗаписей[0];	
		
	ИначеЕсли ИскатьПоСинонимам Тогда	
		
		ОрганизацияСинонима = НайтиОбъектПоЗначениюСвойства("GLN_Организации", GLN);	
		
		Если НЕ ОрганизацияСинонима = Неопределено Тогда
			GLN = ПолучитьЗначениеСвойстваОбъектаEDI(ОрганизацияСинонима, "GLN_Организации");	
			УчетнаяЗаписьEDI = НайтиУчетнуюЗаписьПоGLN_КонтурEDI(GLN, Ложь);		
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат УчетнаяЗаписьEDI;
	
КонецФункции

//**********************************************************
//	ОСНОВНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

//в Параметры должны быть:
//GLN - от чьего имени отправляем сообщение
//ИмяФайла - имя готового файла с сообщением (обычно формируется в %TEMP%, после успешной отправки удаляется)
Функция ПередатьСообщениеНаСервер(Параметры) Экспорт
	
	Результат = ИнициализироватьСтруктуруРезультатаФункции();
	
	ОпределитьПараметрыОтправкиСообщения(Параметры.GLN,Результат);
	
	Если Результат.ТаблицаОшибок.Количество()>0 Тогда
		//не удалось найти учетную запись или boxId для отправки сообщения
		Возврат Результат;
	КонецЕсли;

	ТекущееСоединение = Неопределено;
	Если Параметры.Свойство("ПутьКФайлу") Тогда
		Файл = Новый Файл(Параметры.ПутьКФайлу);
	КонецЕсли;

	Для НомерПопытки=1 По 2 Цикл//у нас 2 прохода: если в первый раз что-то пошло не так, то попробуем переподключиться и уйдем на второй круг. После второго выходим насовсем.
		
		Попытка
			
			ПроверитьАктивностьПодключения(Результат.УчетнаяЗапись,ТекущееСоединение);
			
			Если ПротоколОбмена_КонтурEDI = "DialMail" Тогда
				
				Если ТекущееСоединение.ОтправитьФайл(Параметры.ПутьКФайлу,"outbox/"+Файл.Имя) = 0 Тогда
					РазорватьСоединениеDialMail(ТекущееСоединение);
				КонецЕсли;
				
			ИначеЕсли ПротоколОбмена_КонтурEDI = "FTP" Тогда
				
				ТекущееСоединение.Записать(Параметры.ПутьКФайлу,"outbox/"+Файл.Имя);	
				
			ИначеЕсли ПротоколОбмена_КонтурEDI = "Каталог" Тогда
				
				КопироватьФайл(Параметры.ПутьКФайлу,Результат.АдресКаталогаОбменаEDI+"/outbox/"+Файл.Имя);
				
			ИначеЕсли ПротоколОбмена_КонтурEDI = "API" Тогда
				
				Если НЕ КонтурEDIAPI_ИнтернетРесурсДоступен() Тогда
					ВызватьИсключение ТекстОшибкиОтсутствуетИнтернетСоединение();
				КонецЕсли;
				
				ИмяФайлаZIP = Неопределено; 
				Если КонтурСтандарт_ЗначениеПоКлючу(Параметры, "ПакетнаяОтправка", Ложь) Тогда 
					
					Тело = Параметры.ДвоичныеДанные;
					ИмяФайлаZIP = Параметры.ИмяФайлаZIP;
				
				ИначеЕсли Параметры.Свойство("СтрокаXML") И ЗначениеЗаполнено(Параметры.СтрокаXML) Тогда
					
					Тело = Параметры.СтрокаXML;
					
				Иначе
					
					ТекстовыйДокумент = Новый ТекстовыйДокумент;
					ТекстовыйДокумент.Прочитать(Параметры.ПутьКФайлу, "UTF8");
					Тело = ТекстовыйДокумент.ПолучитьТекст();
					
				КонецЕсли;
				
				ДанныеАвторизацииEDI = ДанныеАвторизацииДляКонтурEDIAPI(Результат.УчетнаяЗапись);
				_РезультатРазобранный = КонтурEDIAPI_ОтправитьСообщение(ДанныеАвторизацииEDI, Результат.boxId, Тело, ИмяФайлаZIP);

				Результат.Вставить("MessageId",	_РезультатРазобранный.MessageId);//сервер назначает нам новый MessageId
				Результат.Вставить("BoxId",		_РезультатРазобранный.BoxId);
				Результат.Вставить("DocumentCirculationId", _РезультатРазобранный.DocumentCirculationId);
				
				Если МетрикаКонтур_ИспользоватьМетрики() Тогда
					УчетныеЗаписиОтправленныхСообщений = ЭДО_Кэш_Прочитать("УчетныеЗаписиОтправленныхСообщений");
					
					Если НЕ ТипЗнч(УчетныеЗаписиОтправленныхСообщений) = Тип("Соответствие") Тогда
						УчетныеЗаписиОтправленныхСообщений = Новый Соответствие;
						ЭДО_Кэш_Поместить("УчетныеЗаписиОтправленныхСообщений", УчетныеЗаписиОтправленныхСообщений); 
					КонецЕсли;

					GLN = Результат.УчетнаяЗапись.GLN;
					УчетныеЗаписиОтправленныхСообщений.Вставить(GLN, GLN);	

				КонецЕсли;   
				
			КонецЕсли;	
			Результат.Успешно = Истина;
			Прервать;//все успешно
		Исключение
			_Ошибка = ОписаниеОшибки();
			ТекущееСоединение=Неопределено; 
			Если НомерПопытки=2 Тогда
				Сообщить_КонтурEDI(_Ошибка);
				Результат.Успешно = Ложь;
				ЗарегистрироватьОшибку(Результат,"Не получилось подключиться к серверу");
				Возврат Результат;
			КонецЕсли;	
		КонецПопытки;
	КонецЦикла;
	
	Если Параметры.Свойство("ПутьКФайлу") Тогда
		УдалитьФайлы(Параметры.ПутьКФайлу);
	КонецЕсли;
	Результат.Успешно = Истина;
		
	Возврат Результат;
	
КонецФункции

Функция ИнициализироватьСтруктуруРезультатаЗагрузкиСообщений()
	
	РезультатЗагрузки = ИнициализироватьСтруктуруРезультатаФункции();
	
	РезультатЗагрузки.Вставить("ПутьКЗагруженнымФайлам");
	РезультатЗагрузки.Вставить("КаталогОбмена");//похоже, дубль
	РезультатЗагрузки.Вставить("ИдентификаторПоследнегоСообщения");//только для API.
	РезультатЗагрузки.Вставить("ВсеСообщенияЗагружены",	Ложь);
	РезультатЗагрузки.Вставить("ТаблицаСообщений",		Новый ТаблицаЗначений);//основная таблица, куда пишется информация о загруженных сообщениях
	
	РезультатЗагрузки.ТаблицаСообщений.Колонки.Добавить("ИмяФайла",				ОписаниеТипаСтрока_КонтурEDI());
	РезультатЗагрузки.ТаблицаСообщений.Колонки.Добавить("ИмяФайлаНаСервере",	ОписаниеТипаСтрока_КонтурEDI());	//только для FTP, DialMail, Каталог
	РезультатЗагрузки.ТаблицаСообщений.Колонки.Добавить("box_id",				ОписаниеТипаСтрока_КонтурEDI());	//только для API	
	РезультатЗагрузки.ТаблицаСообщений.Колонки.Добавить("event_id",				ОписаниеТипаСтрока_КонтурEDI());	//только для API
	РезультатЗагрузки.ТаблицаСообщений.Колонки.Добавить("eventPointer",			ОписаниеТипаСтрока_КонтурEDI());	//только для API
	РезультатЗагрузки.ТаблицаСообщений.Колонки.Добавить("message_id",			ОписаниеТипаСтрока_КонтурEDI());	//только для API
	РезультатЗагрузки.ТаблицаСообщений.Колонки.Добавить("ТипСообщения",			ОписаниеТипаСтрока_КонтурEDI());
	РезультатЗагрузки.ТаблицаСообщений.Колонки.Добавить("EventType",			ОписаниеТипаСтрока_КонтурEDI());	//только для API - вид события (новое сообщение / событие доставки)
	РезультатЗагрузки.ТаблицаСообщений.Колонки.Добавить("EventContent",			);	//только для API - новое, для статусных. Сюда будут писаться ОбъектXDTO
	РезультатЗагрузки.ТаблицаСообщений.Колонки.Добавить("Дата",					ОписаниеТипаДата_КонтурEDI(ЧастиДаты.ДатаВремя));
	//С этой же таблицей лучше и использовать ПослеУспешнойЗагрузкиСообщения в будущем. 
	Возврат РезультатЗагрузки;
	
КонецФункции	

Функция ЗагрузитьСообщениеВоВременныйФайл(СтрокаСообщения,КаталогОбмена,УчетнаяЗапись,ЭтоВходящееСообщение = Истина)

	ТекущееСоединение = Неопределено;
	
	ВременныйФайл = Новый Файл(КаталогОбмена + СтрокаСообщения.ИмяФайла);
	Если ВременныйФайл.Существует() Тогда
		УдалитьФайлы(ВременныйФайл.ПолноеИмя);//Если такой файл уже есть в temp, значит, он остался от предыдущей сессии, когда чо-то пошло не так. Удалим его.
	КонецЕсли;	
		
	Для НомерПопытки=1 По 2 Цикл//у нас 2 прохода: если в первый раз что-то пошло не так, то попробуем переподключиться и уйдем на второй круг. После второго выходим насовсем.
		
		Попытка
			ПроверитьАктивностьПодключения(УчетнаяЗапись,ТекущееСоединение);
			Если ПротоколОбмена_КонтурEDI = "DialMail" Тогда
				
				Если ТекущееСоединение.ПолучитьФайл("/"+СтрокаСообщения.ИмяФайлаНаСервере, КаталогОбмена + СтрокаСообщения.ИмяФайла) = 0 Тогда
					РазорватьСоединениеDialMail(ТекущееСоединение);
				КонецЕсли;
				
			ИначеЕсли ПротоколОбмена_КонтурEDI = "FTP" Тогда
				
				ТекущееСоединение.Получить(СтрокаСообщения.ИмяФайлаНаСервере, КаталогОбмена + СтрокаСообщения.ИмяФайла);
				
			ИначеЕсли ПротоколОбмена_КонтурEDI = "Каталог" Тогда
				
				КопироватьФайл(СтрокаСообщения.ИмяФайлаНаСервере, КаталогОбмена + СтрокаСообщения.ИмяФайла);
				
			ИначеЕсли ПротоколОбмена_КонтурEDI = "API" Тогда
				
				ДанныеАвторизацииEDI = ДанныеАвторизацииДляКонтурEDIAPI(УчетнаяЗапись);
				
				Если ЭтоВходящееСообщение Тогда
					Сообщение = КонтурEDIAPI_ВходящееСообщение(ДанныеАвторизацииEDI, СтрокаСообщения.box_id, СтрокаСообщения.message_id);
				Иначе
					Сообщение = КонтурEDIAPI_ИсходящееСообщение(ДанныеАвторизацииEDI, СтрокаСообщения.box_id, СтрокаСообщения.message_id);
				КонецЕсли;
				
				BASE64Значение(Сообщение.Data.MessageBody).Записать(КаталогОбмена + СтрокаСообщения.ИмяФайла);
				
			КонецЕсли;
			
			//установить файлу дату изменения равной дате этого файла на FTP
			ВремФайл= новый Файл(КаталогОбмена + СтрокаСообщения.ИмяФайла);
			Если ВремФайл.Существует() Тогда
				ВремФайл.УстановитьВремяИзменения(СтрокаСообщения.Дата);
			КонецЕсли;
			
			Возврат КаталогОбмена + СтрокаСообщения.ИмяФайла;//успешно загрузили, вернем имя полученного файла
			
		Исключение
			
			_Ошибка = ОписаниеОшибки();
			Если НомерПопытки=2 Тогда
				Возврат "";
			КонецЕсли;	
			
		КонецПопытки;
		
	КонецЦикла;	//2 попытки переподключения
	
	Возврат "";
	
КонецФункции

Функция ПослеУспешнойЗагрузкиСообщения(Параметры,Папка = "inbox") //удаляет либо фтп файл либо локальный фтп файл
	
	Перем ПутьКФайлу;
	
	Если Не Параметры.Свойство("ПутьКФайлу",ПутьКФайлу) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ПротоколОбмена_КонтурEDI = "API" Тогда
		//не надо больше ничего делать, файлы из API не удаляются
		Возврат Неопределено;
	КонецЕсли;	
	
	УчетнаяЗапись = НайтиУчетнуюЗаписьДляУдаленияСообщения(УчетныеЗаписи,Параметры.GLN,Параметры.ПутьКФайлу);
	Если УчетнаяЗапись=Неопределено Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	Если ПротоколОбмена_КонтурEDI = "Каталог" Тогда
		
		Если ПроверитьАктивностьПодключения(УчетнаяЗапись) Тогда
			
			Файл = Новый Файл(ПутьКФайлу);
			Попытка 
				УдалитьФайлы(ПолучитьПараметрыИнтернетСоединения_KE().АдресКаталогаОбменаEDI+"\"+Папка+"\"+Файл.Имя); //с псевдо фтп
			Исключение
				ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Предупреждение, "Не удалось удалить файл сообщения после загрузки - " + ОписаниеОшибки());	
			КонецПопытки;
			
		КонецЕсли;
		
	ИначеЕсли ПротоколОбмена_КонтурEDI = "DialMail" Или ПротоколОбмена_КонтурEDI = "FTP" Тогда
		
		ТекущееСоединение = Неопределено;
		Файл = Новый Файл(ПутьКФайлу);
		
		Для НомерПопытки=1 По 2 Цикл//у нас 2 прохода: если в первый раз что-то пошло не так, то попробуем переподключиться и уйдем на второй круг. После второго выходим насовсем.
		
			Попытка
				
				ПроверитьАктивностьПодключения(УчетнаяЗапись,ТекущееСоединение);
				Если ПротоколОбмена_КонтурEDI = "DialMail" Тогда
					Если ТекущееСоединение.УдалитьФайл("/"+Папка+"/"+Файл.Имя) = 0
						И СокрЛП(ТекущееСоединение.lastserveranswer)<>"550 File not found" Тогда
						//файла могло уже и не быть на сервере. 
						//На самом деле это костыль, т.к. в ОбработатьВходящиеСообщения сохранение сообщения иногда вызывается дважды
						РазорватьСоединениеDialMail(ТекущееСоединение);	
				    КонецЕсли;	
				Иначе
					ТекущееСоединение.Удалить(Папка+"/"+Файл.Имя);
				КонецЕсли;
				Прервать; //все успешно
				
			Исключение
				
				_Ошибка = ОписаниеОшибки();
				
				Если Найти(_Ошибка,"Путь не найден")<>0 Тогда
					Прервать;//все ок, просто файл был уже удален кем-то, например, с соседнего компа при обмене
				КонецЕсли;	
				
				Если НомерПопытки=2 Тогда
					Возврат Неопределено;
				КонецЕсли;	
				
			КонецПопытки;
			
		КонецЦикла;//2 попытки переподключения
			
	КонецЕсли;
	
КонецФункции

Функция НайтиУчетнуюЗаписьДляУдаленияСообщения(УчетныеЗаписи,GLN,ПутьКФайлу)
	
	УчетнаяЗапись = неопределено;
	 
	//найдем, по какой учетной записи удалять
	ЕстьАктивнаяУЗДляУдаления = истина;
	УчетнаяЗапись=Неопределено;
	
	ПараметрыОтбораУЗ = Новый Структура;
	ПараметрыОтбораУЗ.Вставить("GLN",GLN);
	ПараметрыОтбораУЗ.Вставить("НеАктивна",ложь);
	
	ПодходящиеУчетныеЗаписи = УчетныеЗаписи.НайтиСтроки(ПараметрыОтбораУЗ);
	Если ПодходящиеУчетныеЗаписи.Количество()>0 Тогда 
		УчетнаяЗапись = ПодходящиеУчетныеЗаписи[0];
	иначе
		УчетнаяЗапись = УчетныеЗаписи.Найти(GLN,"GLN");
		ЕстьАктивнаяУЗДляУдаления = ложь;
	КонецЕсли;
	
	Если УчетнаяЗапись = Неопределено 
		Или (УчетнаяЗапись.НеАктивна = Истина и ЕстьАктивнаяУЗДляУдаления)
	Тогда
		Сообщить_КонтурEDI("Сообщение "+ПутьКФайлу+" не было удалено с сервера. Проверьте настройки учетной записи с GLN "+GLN);
		//такое может возникнуть, если в учетной записи указали неправильный GLN. В будущем будем пересматривать логику работы с учетными записями.
		Возврат Неопределено;
	КонецЕсли;
	
	 Возврат УчетнаяЗапись;
КонецФункции


//**********************************************************
//	ПОЛУЧЕНИЕ СПИСКОВ СООБЩЕНИЙ

Процедура ПолучитьСписокНовыхСообщений(РезультатЗагрузки,УчетнаяЗапись,ДанныеТранспортногоЯщика)
	                    
	ТекущееСоединение = Неопределено;
	РезультатЗагрузки.Успешно = Истина;
	
	Если ДанныеТранспортногоЯщика.ЭтоЯщикДляСтатусныхСообщений Тогда
		Состояние_КонтурEDI("Запрашиваем статусные сообщения");
		ЯщикПоискаФайлов = "reports";
	Иначе
		Состояние_КонтурEDI("Запрашиваем новые сообщения");
		ЯщикПоискаФайлов = "inbox";
	КонецЕсли;
	
	//сначала получим список сообщений
	
	Для НомерПопытки=1 По 2 Цикл//у нас 2 прохода: если в первый раз что-то пошло не так, то попробуем переподключиться и уйдем на второй круг. После второго выходим насовсем.
		
		Попытка
			ПроверитьАктивностьПодключения(УчетнаяЗапись, ТекущееСоединение);
			//маску поиска файлов оставить внутри функций поиска
			Если ПротоколОбмена_КонтурEDI = "DialMail" Тогда
				НайтиФайлы_DialMail(ЯщикПоискаФайлов, "*.xml", ТекущееСоединение, РезультатЗагрузки);
			ИначеЕсли ПротоколОбмена_КонтурEDI = "FTP"
				Или ПротоколОбмена_КонтурEDI = "Каталог" Тогда
				НайтиФайлы_FTP_Каталог(ЯщикПоискаФайлов, "*.xml", ТекущееСоединение, РезультатЗагрузки);
			ИначеЕсли ПротоколОбмена_КонтурEDI = "API" Тогда
				НайтиФайлы_API(УчетнаяЗапись, ДанныеТранспортногоЯщика, РезультатЗагрузки);
			КонецЕсли;
			
			Если ПротоколОбмена_КонтурEDI = "DialMail"
				Или ПротоколОбмена_КонтурEDI = "FTP"
				Или ПротоколОбмена_КонтурEDI = "Каталог"
			Тогда
			    РезультатЗагрузки.ВсеСообщенияЗагружены = Истина;
			КонецЕсли;	
			
			Прервать;//успешно нашли, идем дальше за цикл
			
		Исключение
			РезультатЗагрузки.ТаблицаСообщений.Очистить();
			_Ошибка = ОписаниеОшибки();
			Сообщить_КонтурEDI(_Ошибка);
			
			Если НомерПопытки=2 Тогда
				РезультатЗагрузки.Успешно = Ложь;
				ЗарегистрироватьОшибку(РезультатЗагрузки,"Не получилось подключиться к серверу");
				Возврат;
			КонецЕсли;	
		КонецПопытки;
	КонецЦикла;	
	
КонецПроцедуры

Функция НайтиФайлы_FTP_Каталог(Каталог, МаскаФильтра,Соединение,РезультатЗагрузки)
	
	//работа с FTP и каталогом очень похожа, поэтому оставим их в единой функции
	Если ПротоколОбмена_КонтурEDI = "Каталог" Тогда //добавить тут автоопределение каталога - эмулятора FTP
		НайденныеФайлы = НайтиФайлы(ПолучитьПараметрыИнтернетСоединения_KE().АдресКаталогаОбменаEDI+"\"+Каталог, МаскаФильтра);
	Иначе	
		НайденныеФайлы = Соединение.НайтиФайлы("/"+Каталог, МаскаФильтра);
	КонецЕсли;	
	
	Для Каждого ТекущийФайл Из НайденныеФайлы Цикл
		
		Если НЕ ТекущийФайл.ЭтоФайл() 
			ИЛИ ТекущийФайл.Размер() = 0 Тогда
			//пропускаем каталоги и пустые файлы
			Продолжить;
		КонецЕсли;
		
		Если Каталог = "reports" Тогда
			ТипСообщения = "reports";
		Иначе
			ТипСообщения = ПолучитьТипСообщенияИзИмениФайла(ТекущийФайл.ИмяБезРасширения);
			
			Если ЗначениеЗаполнено(ТипСообщения) 
				И НЕ МожемОбработатьТипВходящегоСообщения(ТипСообщения) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтрока						= РезультатЗагрузки.ТаблицаСообщений.Добавить();
		НоваяСтрока.ИмяФайлаНаСервере	= ТекущийФайл.ПолноеИмя;
		НоваяСтрока.ИмяФайла			= ТекущийФайл.ИмяБезРасширения+ТекущийФайл.Расширение;
		НоваяСтрока.Дата				= ТекущийФайл.ПолучитьВремяИзменения();
		НоваяСтрока.ТипСообщения		= ТипСообщения;
			
	КонецЦикла;
	
	РезультатЗагрузки.ТаблицаСообщений.Сортировать("Дата Возр");
	
	Возврат РезультатЗагрузки.ТаблицаСообщений;
	
КонецФункции

Функция НайтиФайлы_DialMail(Каталог, МаскаФильтра,Соединение,РезультатЗагрузки)
	
	РезультатПолученияСписка = Соединение.Лист("/"+Каталог, МаскаФильтра);
	
	Если РезультатПолученияСписка = 1 Тогда
		
		КоличествоФайлов = Соединение.КоличествоФайлов();
		
		Для к = 1 По КоличествоФайлов Цикл
			Если Соединение.ЭтоКаталог(к) = 0 Тогда
				
				ИмяТекущегоФайла = Соединение.ПолучитьИмяФайла(к);
				ТекущийФайл = Новый Файл("/"+Каталог+"/"+ИмяТекущегоФайла);
				
				Если Каталог = "reports" Тогда
					ТипСообщения = "reports";
				Иначе
					ТипСообщения = ПолучитьТипСообщенияИзИмениФайла(ИмяТекущегоФайла);
					
					Если ЗначениеЗаполнено(ТипСообщения) 
						И НЕ МожемОбработатьТипВходящегоСообщения(ТипСообщения) Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
									
				Дата  = Соединение.ПолучитьДатуФайла(к);
				Время = Соединение.ПолучитьВремяФайла(к);
				
				НоваяСтрока = РезультатЗагрузки.ТаблицаСообщений.Добавить();
				НоваяСтрока.ИмяФайлаНаСервере	= "/"+Каталог+"/"+ИмяТекущегоФайла;
				НоваяСтрока.ИмяФайла			= ИмяТекущегоФайла;
				НоваяСтрока.Дата				= Дата( Число(Прав(Дата, 4)), Число(Сред(Дата,4,2)),  Число(Лев(Дата,2)),   Число(Лев(Время,2)), Число(Сред(Время,4,2)), Число(Прав(Время,2)) );
				НоваяСтрока.ТипСообщения		= ТипСообщения;
				
			КонецЕсли;
		КонецЦикла;
		
		РезультатЗагрузки.ТаблицаСообщений.Сортировать("Дата Возр");
		
	Иначе
		
		//считаем, что соединение пропало, вызываем исключение
		РазорватьСоединениеDialMail(Соединение);	
		
	КонецЕсли;
	
	Возврат Истина;//убрать
	
КонецФункции

Функция НайтиФайлы_API(УчетнаяЗапись,ДанныеТранспортногоЯщика,РезультатЗагрузки)
	
	РазмерБуфера = 100;//сколько сообщений грузить за один раз
	
	ТекНачальноеСобытие = Неопределено; //точка отсчета, с которой будем грузить сообщения
	
	Если СтрДлина(ДанныеТранспортногоЯщика.lastEventId) = 8 Тогда
		//есть возможность в настройках учетной записи прописать сюда дату в формате ГГГГММДД
		//тогда первые сообщения будем грузить с этой даты, а не с ID сообщения
		//так можно перезагружать потерянные сообщения
		
		Попытка
			НачалоПериода = Дата(ДанныеТранспортногоЯщика.lastEventId);
		Исключение
			ВызватьИсключение "Неправильная дата в настройках транспортного ящика";
		КонецПопытки;
		
	Иначе
		
		Попытка
			_ТестИД = Новый УникальныйИдентификатор(ДанныеТранспортногоЯщика.lastEventId);
			ТекНачальноеСобытие = ДанныеТранспортногоЯщика.lastEventId;
		Исключение
			ВызватьИсключение "Неправильный ID последнего сообщения в настройках транспортного ящика";
		КонецПопытки;
		
	КонецЕсли;
		
	Параметры = Новый Структура;
	
	Если Не ЗначениеЗаполнено(ТекНачальноеСобытие) Тогда
		Параметры.Вставить("fromDateTime", Формат(НачалоПериода,"ДФ=yyyy-MM-dd; ДП=00010101"));
	Иначе
		Параметры.Вставить("exclusiveEventId", ТекНачальноеСобытие);
	КонецЕсли;
	
	мСобытия = ПолучитьСобытияЯщика_EDI(УчетнаяЗапись, ДанныеТранспортногоЯщика.boxId, Параметры);
	
	МассивСобытий = мСобытия.Events.BoxEvent;
	КоличествоСобытий = МассивСобытий.Количество();
	ТекНачальноеСобытие = Неопределено;
	
	Для н = 1 по КоличествоСобытий Цикл
		
		
		#Если Клиент Тогда
		ОбработкаПрерыванияПользователя();
		#КонецЕсли
		
		ИДСообщения = Неопределено;
		
		ТекущееСобытие = МассивСобытий[н-1];
		ТекНачальноеСобытие = ТекущееСобытие.EventPointer;//отметка, с которой будем грузить следующую пачку сообщений
		Если ЗначениеЗаполнено(ТекНачальноеСобытие) Тогда
			РезультатЗагрузки.ИдентификаторПоследнегоСообщения = Строка(ТекНачальноеСобытие);
			//запомним ID сообщения, с которого надо выполнять обмен в следующий раз
		КонецЕсли;	
		
		Если ТекущееСобытие.EventType = "NewInboxMessage" Тогда
			
			Если ТекущееСобытие.EventContent.InboxMessageMeta.MessageFormat<>"KonturXml" Тогда
				Сообщить_КонтурEDI("Получено сообщение в неправильном формате. Обратитесь в техподдержку.");
				Продолжить;//нет смысла читать сообщения в чужом формате, если они вдруг сюда попали
			КонецЕсли;
			
			Если ВРЕГ(ТекущееСобытие.EventContent.InboxMessageMeta.DocumentDetails.DocumentType)="STSMSG" Тогда
				
				Если НастройкиМодуля.НеЗагружатьСтатусныеСообщения Тогда
					// это входящие STSMSG через API, их можно не грузить в режиме поставщика
					// вместо них можно сразу вычитывать события из ленты API
					Продолжить;
				КонецЕсли;
				
				ТипСообщения = "reports";
				ТипСообщенияКаталог = "reports";
				ИДСообщения = ТекущееСобытие.EventContent.InboxMessageMeta.MessageId;
				_boxid = ТекущееСобытие.EventContent.InboxMessageMeta.boxId;
				
			Иначе
				
				//это входящие, их грузим
				ТипСообщения = ВРЕГ(ТекущееСобытие.EventContent.InboxMessageMeta.DocumentDetails.DocumentType);
				
				Если НЕ МожемОбработатьТипВходящегоСообщения(ТипСообщения) Тогда
					Продолжить;
				КонецЕсли;
				
				ТипСообщенияКаталог = "inbox";
				ИДСообщения = ТекущееСобытие.EventContent.InboxMessageMeta.MessageId;
				_boxid = ТекущееСобытие.EventContent.InboxMessageMeta.boxId;

			КонецЕсли;
			
			//создадим запись в списке сообщений на загрузку
			НовСтрока = РезультатЗагрузки.ТаблицаСообщений.Добавить();
			НовСтрока.box_id				= _boxid;
			НовСтрока.message_id			= ИДСообщения;
			НовСтрока.event_id				= ТекущееСобытие.EventId;
			НовСтрока.eventPointer			= ТекущееСобытие.EventPointer;
			НовСтрока.ТипСообщения			= ТипСообщения;
			НовСтрока.ИмяФайлаНаСервере		= ""+ТипСообщения+"_"+ИДСообщения+"_"+_boxid+".xml";//надо ли это здесь?
			НовСтрока.ИмяФайла				= НовСтрока.ИмяФайлаНаСервере;
			НовСтрока.Дата					= ДатаXML_в_ДатаВремя1С(ТекущееСобытие.EventDateTime);
			НовСтрока.EventType				= ТекущееСобытие.EventType;
			НовСтрока.EventContent			= ТекущееСобытие.EventContent;
			
		ИначеЕсли ТекущееСобытие.EventType = "NewOutboxMessage" Тогда
			//Это следы исходящих сообщений, они нам не нужны
			Продолжить;
		
		ИначеЕсли ТекущееСобытие.EventType = "RecognizeMessage" Тогда
			
			ТипСообщения = ВРег(ТекущееСобытие.EventContent.DocumentType);
			ИДСообщения = ТекущееСобытие.EventContent.OutboxMessageMeta.MessageId;
			_boxid = ТекущееСобытие.EventContent.OutboxMessageMeta.boxId;
			
			НовСтрока = РезультатЗагрузки.ТаблицаСообщений.Добавить();
			НовСтрока.EventContent			= ТекущееСобытие.EventContent;
			НовСтрока.EventType				= ТекущееСобытие.EventType;
			НовСтрока.event_id				= ТекущееСобытие.EventId;
			НовСтрока.box_id				= _boxid;
			НовСтрока.message_id			= ИДСообщения;
			НовСтрока.ТипСообщения			= ТипСообщения;			
			НовСтрока.ИмяФайлаНаСервере		= ""+ТипСообщения+"_"+ИДСообщения+"_"+_boxid+".xml";//надо ли это здесь?
			НовСтрока.ИмяФайла				= НовСтрока.ИмяФайлаНаСервере;
			НовСтрока.Дата					= ДатаXML_в_ДатаВремя1С(ТекущееСобытие.EventDateTime);
			
		Иначе// не NewInboxMessage, не NewOutboxMessage, значит, событие доставки
			
			НовСтрока = РезультатЗагрузки.ТаблицаСообщений.Добавить();
			НовСтрока.EventContent			= ТекущееСобытие.EventContent;
			НовСтрока.EventType				= ТекущееСобытие.EventType;
			НовСтрока.event_id				= ТекущееСобытие.EventId;
			НовСтрока.eventPointer			= ТекущееСобытие.EventPointer;
		
		КонецЕсли;	
		
	КонецЦикла;
	
	Если КоличествоСобытий<РазмерБуфера Тогда
		РезультатЗагрузки.ВсеСообщенияЗагружены = Истина;
	КонецЕсли;	
		
	Если КоличествоСобытий=0 Тогда//нет новых сообщений
		РезультатЗагрузки.ИдентификаторПоследнегоСообщения = ДанныеТранспортногоЯщика.lastEventId;//оставим входящий ID последнего сообщения
		РезультатЗагрузки.ВсеСообщенияЗагружены = Истина;
	Иначе
		РезультатЗагрузки.ИдентификаторПоследнегоСообщения = мСобытия.LastEventId;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьТипСообщенияИзИмениФайла(ИмяФайла = "")
	
	ПозицияРазделителя = Найти(ИмяФайла, "_");
	ТипСообщенияИзФайла = ВРег(Лев(ИмяФайла, ПозицияРазделителя - 1));

	МассивВсехТиповСообщенийEDI = ПолучитьМассивТиповСообщенийEDI();
	
	Если МассивВсехТиповСообщенийEDI.Найти(ТипСообщенияИзФайла) = Неопределено Тогда
		
		ТипСообщения = "";
		
		ДлинНаименованияТипа = 0;
		
		Для Каждого РабочийТип Из МассивВсехТиповСообщенийEDI Цикл  			
			
			Если Найти(ТипСообщенияИзФайла, РабочийТип) > 0 И ДлинНаименованияТипа < СтрДлина(РабочийТип) Тогда
				
				ДлинНаименованияТипа	= СтрДлина(РабочийТип);
				ТипСообщения			= Строка(РабочийТип);
				
			КонецЕсли;
			
		КонецЦикла;
	Иначе
		ТипСообщения = ТипСообщенияИзФайла;
	КонецЕсли;
	
    Возврат ТипСообщения;
	
КонецФункции // ПолучитьТипСообщенияИзИмениФайла()

Функция МассивТиповСообщенийКоторыеМожемОбработать()
	
	МассивТиповСообщений = ЭДО_Кэш_Прочитать("МассивТиповСообщенийКоторыеМожемОбработать");
	
	Если МассивТиповСообщений = Неопределено Тогда
		
		МассивТиповСообщений = Новый Массив;
		
		МассивТиповСообщений.Добавить("PORDERS");
		МассивТиповСообщений.Добавить("ORDERS");
		МассивТиповСообщений.Добавить("ORDRSP");
		МассивТиповСообщений.Добавить("DESADV");
		МассивТиповСообщений.Добавить("RECADV");
		МассивТиповСообщений.Добавить("INVOIC");
		МассивТиповСообщений.Добавить("RETANN");
		МассивТиповСообщений.Добавить("RETDES");
		МассивТиповСообщений.Добавить("IFTMBF");
		МассивТиповСообщений.Добавить("DELFOR");
		МассивТиповСообщений.Добавить("PRICELIST");
		МассивТиповСообщений.Добавить("PRICAT");
		   		
		Если НастройкиМодуля.НеЗагружатьСтатусныеСообщения <> Истина Тогда
			МассивТиповСообщений.Добавить("STSMSG");
		КонецЕсли; 		
		
		ЭДО_Кэш_Поместить("МассивТиповСообщенийКоторыеМожемОбработать", МассивТиповСообщений);
		
	КонецЕсли;
	
	Возврат МассивТиповСообщений;
	
КонецФункции

Функция ВключенПодходящийРежимДляОбработкиВходящегоСообщения(ТипСообщения)
	
	Если НастройкиМодуля = Неопределено Тогда 
		НастройкиМодуля = ПолучитьНастройкиМодуля();
	КонецЕсли;

	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("ТипСообщения", ТипСообщения);
	
	РезультатПМ = ОбработкаСобытияПодключаемогоМодуля("ПроверитьРежимРаботыДляОбработкиВходящегоСообщения", , ПараметрыПМ);
	
	Если Не РезультатПМ = Неопределено Тогда
		Возврат РезультатПМ;
	КонецЕсли;	
	
	НашаРольВСообщении = ПолучитьРежимРаботыПоНаправлениюСообщения(ТипСообщения, "Входящее");
	
	МыПоставщик = НастройкиМодуля.МыПоставщик = Истина;
	МыПокупатель = НастройкиМодуля.МыТорговаяСеть = Истина;
	
	ВключенПодходящийРежим = Ложь;
	
	Если НашаРольВСообщении = Неопределено 
		ИЛИ НашаРольВСообщении = "Поставщик" И МыПоставщик 
		ИЛИ НашаРольВСообщении = "Покупатель" И МыПокупатель Тогда
		
		ВключенПодходящийРежим = Истина;
		
	КонецЕсли;
	
	Возврат ВключенПодходящийРежим;
	
КонецФункции

Функция МожемОбработатьТипВходящегоСообщения(ТипСообщения = "")
	
	МожемОбработатьТипВходящегоСообщения = ЭДО_Кэш_Прочитать("МожемОбработатьТипВходящегоСообщения" + ТипСообщения);
	
	Если МожемОбработатьТипВходящегоСообщения = Неопределено Тогда
	
		Массив = МассивТиповСообщенийКоторыеМожемОбработать();
		МожемОбработатьТипВходящегоСообщения = НЕ Массив.Найти(ТипСообщения) = Неопределено;
	
		Если МожемОбработатьТипВходящегоСообщения Тогда
			МожемОбработатьТипВходящегоСообщения = ВключенПодходящийРежимДляОбработкиВходящегоСообщения(ТипСообщения);
		КонецЕсли;
		
		ЭДО_Кэш_Поместить("МожемОбработатьТипВходящегоСообщения" + ТипСообщения, МожемОбработатьТипВходящегоСообщения);
		
	КонецЕсли;
		
	Возврат МожемОбработатьТипВходящегоСообщения;
	
КонецФункции


//**********************************************************
//	ИНИЦИАЛИЗАЦИЯ ПОДКЛЮЧЕНИЙ

//Проверяет, живо ли соединение для УчетнаяЗапись, и при необходимости переподключает.
//Новое соединение передает в СоединениеОбъект, а возвращает Истина или Ложь, в зависимости от того, живо ли соединение и удалось ли переподключиться
Функция ПроверитьАктивностьПодключения(УчетнаяЗапись,СоединениеОбъект=Неопределено)
	
	Если ПротоколОбмена_КонтурEDI = Неопределено Тогда 
		ПротоколОбмена_КонтурEDI = ПолучитьКонстантуEDI("ПротоколОбмена_КонтурEDI");
	КонецЕсли;
	
	СоединениеОбъект = ПолучитьОбъектСоединенияИзКэша(УчетнаяЗапись);
	
	Если ПротоколОбмена_КонтурEDI = "DialMail" Тогда
		
		Если (Строка(ТипЗнч(СоединениеОбъект)) = "НеизвестныйОбъект"
			или Строка(ТипЗнч(СоединениеОбъект)) = "AddIn.FTP")
			И СокрЛП(СоединениеОбъект.Команда("noop")) = ("200 OK") Тогда
			Возврат Истина;
		КонецЕсли;	
		
	ИначеЕсли ПротоколОбмена_КонтурEDI = "FTP" Тогда
		
		Если НЕ СоединениеОбъект = Неопределено И ТипЗнч(СоединениеОбъект) = Тип("FTPСоединение") Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись.Логин) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	мПараметрыТранспорта = ПолучитьПараметрыИнтернетСоединения_KE();
	Таймаут = 15;
	
	Для Сч = 1 По 5 Цикл 	
		
		СоединениеОбъект = Неопределено;
		
		Попытка
			
			Если ПротоколОбмена_КонтурEDI = "DialMail" Тогда
				СоединениеОбъект = ПолучитьСоединениеDialMail(УчетнаяЗапись.Логин, УчетнаяЗапись.Пароль);
			ИначеЕсли ПротоколОбмена_КонтурEDI = "FTP" Тогда
				СоединениеОбъект = Новый FTPСоединение(
							СокрЛП(мПараметрыТранспорта.Сервер), 
							мПараметрыТранспорта.Порт, 
							СокрЛП(УчетнаяЗапись.Логин), 
							СокрЛП(УчетнаяЗапись.Пароль),
							, 
							мПараметрыТранспорта.ПассивныйРежим,
							Таймаут);
			КонецЕсли;
			
			ПоместитьОбъектСоединенияВКэш(УчетнаяЗапись,СоединениеОбъект);
			
			Возврат Истина;

		Исключение
			
			Состояние_КонтурEDI("Потеряно соединение с ФТП сервером, восстанавливаю...");
			_ОписаниеОшибки = ОписаниеОшибки(); //Встроенный механизм FTP выдаст "Login denied", DialMail - "530 Login or password incorrect!"
			Если Найти(_ОписаниеОшибки,"Login denied")<>0 Тогда
				ВывестиПредупреждение_КонтурEDI("Неправильный пароль для логина "+УчетнаяЗапись.Логин);
				Возврат Ложь;//Прервать;
			КонецЕсли;	
			
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьСоединениеDialMail(ЛогинFTP, ПарольFTP, КоличествоПопыток = 10)
	
	мПараметрыТранспорта = ПолучитьПараметрыИнтернетСоединения_KE();
	
	Если КомпонентаDialMailПодключена <> Истина Тогда
		
		КомпонентаDialMailПодключена = ПодключитьВнешнююКомпоненту_КонтурEDI("AddIn.FTP");
				
	КонецЕсли;
	
	Если КомпонентаDialMailПодключена Тогда
	
		Соединение = Новый("Addin.FTP");
		
		Если мПараметрыТранспорта.ИспользуетсяПрокси Тогда
			Соединение.ХостПрокси 			 = СокрЛП(мПараметрыТранспорта.СерверПрокси);
			Соединение.ПортПрокси 			 = СокрЛП(мПараметрыТранспорта.ПортПрокси);
			Соединение.ИмяПользователяПрокси = СокрЛП(мПараметрыТранспорта.ЛогинПрокси);
			Соединение.ПарольПрокси 		 = СокрЛП(мПараметрыТранспорта.ПарольПрокси);
			Соединение.ИспользоватьПрокси 	 = мПараметрыТранспорта.ТипПрокси;
		КонецЕсли;
			
		Если Соединение.Подключиться(
				СокрЛП(мПараметрыТранспорта.Сервер), 
				мПараметрыТранспорта.Порт, 
				СокрЛП(ЛогинFTP), 
				СокрЛП(ПарольFTP), 
				мПараметрыТранспорта.ПассивныйРежим, 
				КоличествоПопыток)
				= 1 Тогда
			Возврат Соединение;
		Иначе
			Если СокрЛП(Соединение.lastserveranswer)="530 Login or password incorrect!" Тогда
				Соединение = Неопределено;
				ВызватьИсключение "Login denied";//эмулируем ошибку FTP, встроенного в платформу
			КонецЕсли;	
			РазорватьСоединениеDialMail(Соединение);
		КонецЕсли;
		
	Иначе
	    РазорватьСоединениеDialMail(Соединение);
	КонецЕсли;
	
КонецФункции

Процедура РазорватьСоединениеDialMail(Соединение)
	
	Соединение = Неопределено;
	ВызовИсключения = 1/0;	
	
КонецПроцедуры

//при работе с несколькими учетными записями будем кэшировать подключения для обмена по FTP
Функция ПолучитьОбъектСоединенияИзКэша(УчетнаяЗапись)
	//переделать на ТаблицуЗначений, или, возможно, писать прямо в УчетнуюЗапись
	Если КэшСоединений_КонтурEDI=Неопределено Тогда
		КэшСоединений_КонтурEDI = Новый Структура;
	КонецЕсли;
	
	ТекОбъект = Неопределено;
	КэшСоединений_КонтурEDI.Свойство("_"+УчетнаяЗапись.GLN,ТекОбъект);
		
	Возврат ТекОбъект;
КонецФункции	

Процедура ПоместитьОбъектСоединенияВКэш(УчетнаяЗапись,ОбъектСоединения)
	Если КэшСоединений_КонтурEDI=Неопределено Тогда
		КэшСоединений_КонтурEDI = Новый Структура;
	КонецЕсли;
	
	Если КэшСоединений_КонтурEDI.Свойство("_"+УчетнаяЗапись.GLN) Тогда
		КэшСоединений_КонтурEDI.Удалить("_"+УчетнаяЗапись.GLN);
	КонецЕсли;	
	
	КэшСоединений_КонтурEDI.Вставить("_"+УчетнаяЗапись.GLN,ОбъектСоединения);
КонецПроцедуры

Функция ПолучитьЛокальныйКаталогОбменаСFTP(ВидКаталога,GLN_УчетнойЗаписи)
	
	_Разделитель = "\";
	ПутьКВременномуКаталогу =  КаталогВременныхФайлов()+"КонтурEDI_"+GLN_УчетнойЗаписи+_Разделитель+ВидКаталога;
	КаталогНаДиске = Новый Файл(ПутьКВременномуКаталогу);
	Если НЕ КаталогНаДиске.Существует() Тогда
		СоздатьКаталог(ПутьКВременномуКаталогу);
	КонецЕсли;
	
	Возврат ПутьКВременномуКаталогу+?(Прав(ПутьКВременномуКаталогу,1)=_Разделитель,"",_Разделитель);
	
КонецФункции

//Возвращает Структуру с параметрами прокси, сервером FTP, адресом каталога обмена и т.д.
Функция ПолучитьПараметрыИнтернетСоединения_KE() Экспорт
	
	Результат = ЭДО_Кэш_Прочитать("ПолучитьПараметрыИнтернетСоединения_KE");
	
	Если Результат = Неопределено Тогда
		
		Результат = ПолучитьСписокСвойствEDI(
				"ИспользуетсяПрокси
				|ЛогинПрокси
				|ПарольПрокси
				|СерверПрокси
				|ПортПрокси
				|ТипПрокси
				|ИспользоватьСистемныеНастройкиПрокси
				|СпособАутентификацииПрокси
				|Сервер
				|Порт
				|АдресКаталогаОбменаEDI"
			);
		
		Результат.ИспользуетсяПрокси = (Результат.ИспользуетсяПрокси = Истина);
		Результат.Вставить("ПассивныйРежим",			Истина);//никто не снимает этот флаг, и правильно.
		
		Если Не ЗначениеЗаполнено(Результат.Порт) Тогда
			Результат.Порт = 21;
		КонецЕсли;
	
		ЭДО_Кэш_Поместить("ПолучитьПараметрыИнтернетСоединения_KE",Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	

Функция ПолучитьИнтернетПрокси() Экспорт 
	
	Прокси = Неопределено;
	
	НастройкиПрокси = ПолучитьПараметрыИнтернетСоединения_KE();
	
	Если НастройкиПрокси.ИспользуетсяПрокси Тогда 
		
		Прокси = СоздатьИнтернетПрокси(НастройкиПрокси.СерверПрокси, 
									   НастройкиПрокси.ПортПрокси, 
									   НастройкиПрокси.ЛогинПрокси, 
									   НастройкиПрокси.ПарольПрокси,
									   НастройкиПрокси.ИспользоватьСистемныеНастройкиПрокси,
									   НастройкиПрокси.СпособАутентификацииПрокси);
				
	КонецЕсли;  
	
	Возврат Прокси; 
	
КонецФункции   

Функция СоздатьИнтернетПрокси(Сервер, 
							  Порт, 
							  Логин = "", 
							  Пароль = "", 
							  ИспользоватьСистемныеНастройки = Ложь,
							  СпособАутентификации = Неопределено) Экспорт 
							  
	Если ИспользоватьСистемныеНастройки = Истина Тогда
		Возврат Новый ИнтернетПрокси(Истина);
	КонецЕсли;
							  
	Прокси = Новый ИнтернетПрокси;
	
	СоставАдресаПрокси = Новый Структура;
	СоставАдресаПрокси = СтруктураURI(Сервер + ":" + Формат(Порт,"ЧГ=0"));
	
	СерверПрокси = СокрЛП(СоставАдресаПрокси.Хост);
	ПортПрокси 	 = СоставАдресаПрокси.Порт;
	ЛогинПрокси  = СокрЛП(Логин); 
	ПарольПрокси = Пароль;
	
	Если ПеременнаяСодержитСвойство(Прокси, "Пользователь") Тогда 
		Прокси.Пользователь = ЛогинПрокси;
	КонецЕсли;
	
	Если ПеременнаяСодержитСвойство(Прокси, "Пароль") Тогда 
		Прокси.Пароль = ПарольПрокси;
	КонецЕсли;
	
	СпособыАутентификацииПрокси = ПеречисленияEDI_СпособыАутентификацииПрокси();
	ИспользоватьАутентификациюОС = СпособАутентификации = СпособыАутентификацииПрокси.ОперационнаяСистема;
	ПротоколыПрокси = КонтурСтандарт_СтрРазделить_("http,https", ",", Ложь);
	
	Для Каждого Протокол Из ПротоколыПрокси Цикл
		
		Попытка 
			Прокси.Установить(Протокол, СерверПрокси, ПортПрокси, ЛогинПрокси, ПарольПрокси, ИспользоватьАутентификациюОС);
			Продолжить;
		Исключение
			ТекстОшибки = ОписаниеОшибки();
		КонецПопытки;
		
		Попытка
			Прокси.Установить(Протокол, СерверПрокси, ПортПрокси, ЛогинПрокси, ПарольПрокси);
		Исключение 
			Прокси.Установить(Протокол, СерверПрокси, ПортПрокси);
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Прокси;
	
КонецФункции

Функция СписокСпособовАутентификацииПрокси_КонтурEDI() Экспорт
	
	ПеречислениеСпособыАутентификации = ПеречисленияEDI_СпособыАутентификацииПрокси();
	
