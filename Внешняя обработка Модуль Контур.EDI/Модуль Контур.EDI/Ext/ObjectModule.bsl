КонецФункции

Функция ПолучитьЗначениеРеквизитаОбъекта_КонтурEDI(Объект, ИмяРеквизита) Экспорт
	
	ЗначенияРеквизитов = ПолучитьЗначенияРеквизитовОбъекта(Объект, НовыйМассив(ИмяРеквизита));
	
	Результат = ЗначенияРеквизитов[ИмяРеквизита];
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьЗначенияРеквизитовОбъекта(Объект, МассивИменРеквизитов)
	
	ЗначенияРеквизитов = Новый Структура;
	
	Если МассивИменРеквизитов.Количество() = 0 Тогда
		Возврат ЗначенияРеквизитов;
	КонецЕсли;
	
	ТекстРеквизиты = "";
	Для Каждого ИмяРеквизита Из МассивИменРеквизитов Цикл
		ЗначенияРеквизитов.Вставить(ИмяРеквизита);
		ТекстРеквизиты = ТекстРеквизиты + ?(ПустаяСтрока(ТекстРеквизиты),"",","+Символы.ПС) + ИмяРеквизита + " КАК " + ИмяРеквизита;
	КонецЦикла;
    	
	Запрос = Новый Запрос;
    Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
   	|" + ТекстРеквизиты + "
   	|ИЗ
   	|    " + Объект.Метаданные().ПолноеИмя() + "
   	|ГДЕ
	|    Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Объект);
    РезультатЗапроса = Запрос.Выполнить();
    Выборка = РезультатЗапроса.Выбрать();
    Если Выборка.Следующий() Тогда
    	Для Каждого Колонка из РезультатЗапроса.Колонки Цикл
        	ЗначенияРеквизитов.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);
		КонецЦикла;
    КонецЕсли;
	
	Возврат ЗначенияРеквизитов;
	
КонецФункции

Функция НовыйМассив(Знач1, Знач2 = "4bd67c947236e", Знач3 = "4bd67c947236e", Знач4 = "4bd67c947236e", Знач5 = "4bd67c947236e") Экспорт
	
	//Метод присутствует в клиентском и серверном модулях
	
	Результат = Новый Массив;
	
	Результат.Добавить(Знач1);
	
	ЗначениеПоУмолчанию = "4bd67c947236e";
	
	Если Знач2 <> ЗначениеПоУмолчанию Тогда
		Результат.Добавить(Знач2);		
	КонецЕсли;
	Если Знач3 <> ЗначениеПоУмолчанию Тогда
		Результат.Добавить(Знач3);		
	КонецЕсли;
	Если Знач4 <> ЗначениеПоУмолчанию Тогда
		Результат.Добавить(Знач4);		
	КонецЕсли;
	Если Знач5 <> ЗначениеПоУмолчанию Тогда
		Результат.Добавить(Знач5);		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗначениеКоллекцииПоКлючу(Коллекция, Ключ, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	//Метод присутствует в клиентском и серверном модулях
	
	Структура = Новый Структура(Ключ, ЗначениеПоУмолчанию);
	
	ЗаполнитьЗначенияСвойств(Структура, Коллекция);	
	
	Возврат Структура[Ключ];	
	
КонецФункции

Функция ИмяФормы_КонтурEDI(Форма) Экспорт
	
	ТипПеременнойФорма = ТипЗнч(Форма);
	
	Если ТипПеременнойФорма = Тип("Форма") Тогда
		Если ПеременнаяСодержитСвойство(Форма, "ИмяФормы") Тогда
			Возврат Форма.ИмяФормы;
		Иначе
			Возврат Форма.Заголовок;
		КонецЕсли;
	ИначеЕсли ТипПеременнойФорма = Тип("Строка") Тогда
        Возврат Форма;
	КонецЕсли;
	
	Возврат Неопределено;
		
КонецФункции

Процедура ПрисвоитьЕслиЗаполнено(Приемник, Источник) Экспорт
	
	Если ЗначениеЗаполнено(Источник) Тогда
		
		Приемник = Источник;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПодставитьПараметрыВСтроку_КонтурEDI(Знач СтрокаПодстановки,
	Знач Параметр1, Знач Параметр2 = "", Знач Параметр3 = "",
	Знач Параметр4 = "", Знач Параметр5 = "", Знач Параметр6 = "",
	Знач Параметр7 = "", Знач Параметр8 = "", Знач Параметр9 = "") Экспорт
	
	СтрокаПодстановки = СтрЗаменить(СтрокаПодстановки, "%1", Параметр1);
	СтрокаПодстановки = СтрЗаменить(СтрокаПодстановки, "%2", Параметр2);
	СтрокаПодстановки = СтрЗаменить(СтрокаПодстановки, "%3", Параметр3);
	СтрокаПодстановки = СтрЗаменить(СтрокаПодстановки, "%4", Параметр4);
	СтрокаПодстановки = СтрЗаменить(СтрокаПодстановки, "%5", Параметр5);
	СтрокаПодстановки = СтрЗаменить(СтрокаПодстановки, "%6", Параметр6);
	СтрокаПодстановки = СтрЗаменить(СтрокаПодстановки, "%7", Параметр7);
	СтрокаПодстановки = СтрЗаменить(СтрокаПодстановки, "%8", Параметр8);
	СтрокаПодстановки = СтрЗаменить(СтрокаПодстановки, "%9", Параметр9);
	
	Возврат СтрокаПодстановки;
	
КонецФункции

Функция Метрика_НовыйУИД() Экспорт
	
	Возврат Строка(Новый УникальныйИдентификатор);
	
КонецФункции

Функция РеквизитыОрганизацииПоGLN_КонтурEDI(GLN)
	
	Перем ИНН, КПП;
	
	КлючКэша = "РезультатФункции_РеквизитыОрганизацииПоGLN_КонтурEDI_" + GLN;
	
	Результат = ЭДО_Кэш_Прочитать(КлючКэша);
	
	Если НЕ Результат = Неопределено Тогда
		Возврат Результат;	
	КонецЕсли;
	
	Результат = Новый Структура("ИНН,КПП");
	
	СписокЮрФизЛиц = ПолучитьСписокЭлементовСправочника("ЮрФизЛицаСвои");
	НайденнаяСтрока = СписокЮрФизЛиц.Найти(GLN, "GLN");
	
	Если НЕ НайденнаяСтрока = Неопределено Тогда
		
		Организация = НайденнаяСтрока.ЮрФизЛицо;
				
		ИНН = ПолучитьЗначениеСвойстваОбъектаEDI(Организация, "DiadocOrgInn");
		КПП = ПолучитьЗначениеСвойстваОбъектаEDI(Организация, "DiadocOrgKpp");
		
		Если НЕ ЗначениеЗаполнено(ИНН)
			ИЛИ (ЗначениеЗаполнено(ИНН) И СтрДлина(ИНН) = 10 И НЕ ЗначениеЗаполнено(КПП)) Тогда
			
			ОрганизацияEDI = ОрганизацияEDI(Организация);
			УчетнаяЗаписьСсылка = УчетнаяЗаписьОрганизации(ОрганизацияEDI);
			
			Если НЕ УчетнаяЗаписьСсылка = Неопределено Тогда
				
				УчетнаяЗапись = ПолучитьЭлементСправочника("УчетныеЗаписи", УчетнаяЗаписьСсылка); 
				
				ДанныеАвторизацииEDI = ДанныеАвторизацииДляКонтурEDIAPI(УчетнаяЗапись);
				Попытка
					Ответ = КонтурEDIAPI_РеквизитыПоGLN(ДанныеАвторизацииEDI, GLN); 	

					ИНН = Ответ.inn;
					КПП = Ответ.kpp;
					УстановитьЗначениеСвойстваОбъекта(Организация, "DiadocOrgInn", ИНН);
					УстановитьЗначениеСвойстваОбъекта(Организация, "DiadocOrgKpp", КПП);
					
				Исключение
					ТекстОшибки = ОписаниеОшибки();
				КонецПопытки;
			КонецЕсли;	
		КонецЕсли;

		Результат.ИНН = ИНН;
		Результат.КПП = КПП;

	КонецЕсли;
	
	ЭДО_Кэш_Поместить(КлючКэша, Результат);
	
	Возврат Результат;
	
КонецФункции

