//-------------------------------------------------------------------------------------------------


Процедура ОтправитьСлужебныеУниверсальныеСообщения() Экспорт
	
	Если НЕ ПолучитьФункциональнуюОпциюEDI("SendSus", Ложь) Тогда 
		Возврат;
	КонецЕсли;  
	ОтправлятьИоП = ПолучитьФункциональнуюОпциюEDI("SendIopWithSus", Истина);
	//Получаем список всех организаций по которым будем искать СУСы
	СписокОрганизаций = ПолучитьСписокЭлементовСправочника("ЮрФизЛицаСвои");
	
	
	Для каждого СтрокаОрг Из СписокОрганизаций Цикл
		
        DD_ДокументыНаОтправку = DD_ПолучитьУниверсальныеСообщенияПоОрганизации(СтрокаОрг.ЮрФизЛицо);
		
		Если DD_ДокументыНаОтправку = Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		
		ТаблицаСлужебныхСообщенийНаОтправку = ПолучитьТаблицуДляОтправкиСлужебныхУниверсальныхСообщений(DD_ДокументыНаОтправку); 
		
		Если ТаблицаСлужебныхСообщенийНаОтправку.Количество() = 0 Тогда 
			Продолжить
		КонецЕсли;
		ТекОрганизация = СтрокаОрг.ЮрФизЛицо;
		
		Для каждого Стр Из ТаблицаСлужебныхСообщенийНаОтправку Цикл 
			
			НазначенныеДанныеАвторизации = ДанныеАвторизации;
			Если ОтправлятьИоП Тогда
				СтруктураСобытия = СобытиеСертификаты_НазначитьСертификат(Стр.ДокументСсылка);
				
				Если СтруктураСобытия.Переопределено Тогда 
					
					НазначенныеДанныеАвторизации = ПолучитьСтруктуруДанныхАвторизации();
					НазначенныеДанныеАвторизации.Организация = СтруктураСобытия.Организация;
					НазначенныеДанныеАвторизации.Отпечаток = СтруктураСобытия.Сертификат.Отпечаток;
					НазначенныеДанныеАвторизации.ПарольКонтейнера = СтруктураСобытия.Сертификат.Пароль;
					НазначенныеДанныеАвторизации.Расположение = СтруктураСобытия.Сертификат.Расположение;
					НазначенныеДанныеАвторизации.ТребуетсяДоверенность = СтруктураСобытия.Доверенность.ИспользоватьПоУмолчанию;
					НазначенныеДанныеАвторизации.ТипАвторизации = "Сертификат";
					
					СтруктураСобытия.Доверенность.Вставить("ДвоичныеДанныеДоверенности", СтруктураСобытия.ДвоичныеДанныеДоверенности);
					СтруктураСобытия.Доверенность.Вставить("ДвоичныеДанныеПодписи", СтруктураСобытия.ДвоичныеДанныеПодписи);
					
					НазначенныеДанныеАвторизации.Доверенность = СтруктураСобытия.Доверенность;
					
				ИначеЕсли ТекОрганизация <> Стр.Организация Тогда
					
					ТекОрганизация = Стр.Организация;
					ИнициализироватьДанныеАвторизации(ТекОрганизация);
					ОбновитьДанныеАвторизации("ТипАвторизации", "Сертификат"); 
					
					Если Не СертификатПоОрганизацииНазначен(ТекОрганизация) Тогда //TODO при необходимости выбора сертификата и доверенности - использовать МожемПодписатьДокументыСертификатом
						Продолжить;
					КонецЕсли;
					
					Если Не ДанныеАвторизации.СертификатПроверен Тогда //TODO при необходимости ПроверкаСертификатаВФНС - использовать ОбработчикПроверкиПодписанияСертификатом
						
						ПарольКонтейнера = "";
						РезультатПроверки = ПроверитьВыбранныйСертификат(ДанныеАвторизации.Организация, ДанныеАвторизации.Отпечаток, ДанныеАвторизации.Расположение, ДанныеАвторизации.СертификатДействуетПо, ПарольКонтейнера);
						
						Если РезультатПроверки.Успешно = Ложь
							И ОшибкаНеправильныйПарольКонтейнера(РезультатПроверки.ОписаниеОшибки) Тогда
							
							ПарольКонтейнера = ПолучитьПарольКонтейнераСертификата(ДанныеАвторизации.Организация, ДанныеАвторизации.Отпечаток);
							РезультатПроверки = ПроверитьВыбранныйСертификат(ДанныеАвторизации.Организация, ДанныеАвторизации.Отпечаток, ДанныеАвторизации.Расположение, ДанныеАвторизации.СертификатДействуетПо, ПарольКонтейнера);
							
						КонецЕсли;
						
						ОбновитьДанныеАвторизации("СертификатПроверен", Истина);
						
						Если РезультатПроверки.Успешно = Истина Тогда
							ОбновитьДанныеАвторизации("ПарольКонтейнера", ПарольКонтейнера);
							ОбновитьДанныеАвторизации("ВалидацияСертификатаПройдена", Истина);
						Иначе
							ОбновитьДанныеАвторизации("ВалидацияСертификатаПройдена", Ложь);
						КонецЕсли;
						
					КонецЕсли;
					НазначенныеДанныеАвторизации = ДанныеАвторизации;
				КонецЕсли;
				
				Если ПропускСертификатаПоОрганизации(НазначенныеДанныеАвторизации.Организация) Тогда
					Продолжить; 
				КонецЕсли;
				
				Если ЗначениеЗаполнено(НазначенныеДанныеАвторизации.Доверенность) Тогда
					СпособПередачиМашиночитаемойДоверенности = СпособПередачиМашиночитаемойДоверенности(Стр.Ссылка.Партнер);
					НазначенныеДанныеАвторизации.Вставить("СпособПередачиДоверенности", СпособПередачиМашиночитаемойДоверенности);
				КонецЕсли;
				
				ЕстьДоверенностьПоУмолчаниюВДиадок = ЗначениеЗаполнено(ДоверенностьПоУмолчанию(НазначенныеДанныеАвторизации));
				НазначенныеДанныеАвторизации.Вставить("ЕстьДоверенностьПоУмолчаниюВДиадок", ЕстьДоверенностьПоУмолчаниюВДиадок);
			КонецЕсли;
			СформироватьИОтправитьСлужебноеУниверсальноеСообщение(НазначенныеДанныеАвторизации,Стр.Ссылка,Стр.boxId, Стр.messageId,ОтправлятьИоП);	
		КонецЦикла;	
	КонецЦикла;	
КонецПроцедуры	

Процедура СформироватьИОтправитьСлужебноеУниверсальноеСообщение(ДанныеАвторизации, Ссылка,boxId, messageId,ОтправлятьИоП) 
	
	ДанныеДокумента = Новый Структура;
	ДанныеДокумента.Вставить("ДокументПредставление", Ссылка.Документ);
	ДанныеДокумента.Вставить("Организация", Ссылка.Организация);
	ДанныеДокумента.Вставить("boxId", boxId);
	ДанныеДокумента.Вставить("messageId", messageId);
	
	Попытка
		Message = ПолучитьMessage(boxId, messageId, ДанныеАвторизации, Ложь);
	Исключение                                                                                  
		ОписаниеОшибки = ОписаниеОшибки();
		ЗафиксироватьОшибку_НеУдалосьПолучитьДокументыДляФормированияИзвещений(ДанныеДокумента, ОписаниеОшибки);
		Возврат;
	КонецПопытки;
	
	СписокParentEntityIdИзвещенийДляОтправки = ПолучитьСписокParentEntityIdИзвещенийДляОтправки(Message);
	
	Если СписокParentEntityIdИзвещенийДляОтправки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	MessagePatchToPost = КонтурДиадокAPI_СоздатьПоСхеме("MessagePatchToPostV2");  
	
	MessagePatchToPost.BoxId 	 = boxId;
	MessagePatchToPost.MessageId = messageId;
	
	Если ОтправлятьИоП Тогда 
		SignerContent = SignerContentИоП(ДанныеАвторизации);
		PowerOfAttorneyToPost = PowerOfAttorneyToPost(ДанныеАвторизации);
	КонецЕсли;
	
	Для каждого ЭлементСпискаЗначений Из СписокParentEntityIdИзвещенийДляОтправки Цикл
		
		AttachmentId = ЭлементСпискаЗначений.Значение;
		СтруктураПараметровСУС = ВернутьПараметрыСуС(,,ДанныеАвторизации);
		СтрокаXML = ЗаписатьСлужебноеУниверсальноеСообщение(СтруктураПараметровСУС);  
		Попытка 
			UniversalMessage = API_GenerateUniversalMessage(boxId,
			messageId,
			AttachmentId,
			СтрокаXML); 
		Исключение 
			ОписаниеОшибки = ОписаниеОшибки();
			ЗафиксироватьОшибку_НеУдалосьСформироватьИзвещения(ДанныеДокумента, ОписаниеОшибки);
			Возврат;
		КонецПопытки;
		
		UniversalMessageAttachment = КонтурДиадокAPI_СоздатьПоСхеме("UniversalMessageAttachment");
		UniversalMessageAttachment.ParentEntityId = AttachmentId;
		UniversalMessageAttachment.CodeGroup = Лев(СтруктураПараметровСУС.Код, 1);
		UniversalMessageAttachment.UniversalMessageContent.Content = Base64Строка(UniversalMessage);  
		
		MessagePatchToPost.UniversalMessages.Добавить(UniversalMessageAttachment); 
		Если ОтправлятьИоП Тогда
			ReceiptGenerationRequestV2 = КонтурДиадокAPI_СоздатьПоСхеме("ReceiptGenerationRequestV2");
			
			ReceiptGenerationRequestV2.MessageId 		= messageId;
			ReceiptGenerationRequestV2.AttachmentId 	= AttachmentId;
			ReceiptGenerationRequestV2.SignerContent 	= SignerContent;
			
			Попытка
				ДвоичныеДанныеИзвещения = GenerateReceiptXml(boxId, ReceiptGenerationRequestV2, ДанныеАвторизации);
			Исключение
				ОписаниеОшибки = ОписаниеОшибки();
				ЗафиксироватьОшибку_НеУдалосьСформироватьИзвещения(ДанныеДокумента, ОписаниеОшибки);
				Возврат;
			КонецПопытки;
			
			Попытка
				Подпись = ПодписатьКонтент(ДвоичныеДанныеИзвещения, ДанныеАвторизации);
			Исключение
				ОписаниеОшибки = ОписаниеОшибки();
				ЗафиксироватьОшибку_НеУдалосьПодписатьИзвещения(ДанныеДокумента, ОписаниеОшибки);
				Возврат;
			КонецПопытки;
			
			ReceiptAttachment = КонтурДиадокAPI_СоздатьПоСхеме("ReceiptAttachment");
			
			ReceiptAttachment.ParentEntityId = AttachmentId; 
			ReceiptAttachment.SignedContent.Content = Base64Строка(ДвоичныеДанныеИзвещения);
			ReceiptAttachment.SignedContent.Signature = Подпись;
			ReceiptAttachment.SignedContent.PowerOfAttorney = PowerOfAttorneyToPost;
			
			MessagePatchToPost.Receipts.Добавить(ReceiptAttachment);   
		КонецЕсли
	КонецЦикла;
	
	Если MessagePatchToPost.UniversalMessages.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		MessagePatch = PostMessagePatch(MessagePatchToPost, , ДанныеАвторизации);
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		ЗафиксироватьОшибку_НеУдалосьОтправитьИзвещения(ДанныеДокумента, ОписаниеОшибки);
		Возврат;
	КонецПопытки;
	
	ЗаписатьДопРеквизитыСообщенияInvoiceReceiptId(MessagePatch, СписокParentEntityIdИзвещенийДляОтправки, Ссылка);
	
КонецПроцедуры

Функция DD_GetDocuments(boxId, ДанныеАвторизации, filterCategory) Экспорт  
	
	ИспользоватьСохраненныйТокен	= Истина;
	AfterIndexKey 					= Неопределено;
	Результат 						= Новый Массив;
	ЕстьЕщеДокументы 				= Истина;
	
	ДанныеАвторизацииДиадок = ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизации);
	
	Для НомерПопытки = 1 По 2 Цикл
		Пока ЕстьЕщеДокументы Цикл
			Попытка 	
				Ответ = КонтурДиадокAPI_СписокДокументов(ДанныеАвторизацииДиадок, boxId, filterCategory, AfterIndexKey);				
				
				Если КонтурСтандарт_ЭтоСтруктура(Ответ)
					И Ответ.Свойство("Documents") Тогда  
					
					ЧастьДокументов = Ответ.Documents;
					Результат.Добавить(ЧастьДокументов);
					
					КоличествоЧастиДокументов	= ЧастьДокументов.Количество();
					TotalCount					= Ответ.TotalCount;
					
					AfterIndexKey = ?(TotalCount = 0, "", ЧастьДокументов[КоличествоЧастиДокументов - 1].IndexKey);
					
					Если TotalCount > КоличествоЧастиДокументов Тогда
						ЕстьЕщеДокументы = Истина;
					Иначе	
						ЕстьЕщеДокументы = Ответ.HasMoreResults;
					КонецЕсли;
				Иначе 	
					Прервать;	
				КонецЕсли;	
			Исключение
				ОписаниеОшибки = ОписаниеОшибки();
				ЕстьЕщеДокументы = Ложь;	
			КонецПопытки;	
		КонецЦикла;	
		Возврат Результат;
	КонецЦикла;	
		
	Возврат Результат;
	
КонецФункции

Функция GenerateReceiptXml(boxId, ReceiptGenerationRequestV2, ДанныеАвторизации) 
	
	ДанныеАвторизацииДиадок = ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизации);
	Результат = КонтурДиадокAPI_СгенерироватьИзвещениеОПолучении_V2(ДанныеАвторизацииДиадок, boxId, ReceiptGenerationRequestV2);
	
	Возврат Результат;	
	
КонецФункции

Функция ПолучитьСписокParentEntityIdТитуловПолучателя(Message)
	
	СписокParentEntityId = Новый СписокЗначений;

	МассивAttachmentType = EDI_РазложитьСтрокуВМассивСлов("Title,UniversalTransferDocumentBuyerTitle,UniversalCorrectionDocumentBuyerTitle", ",");	
	
	Для каждого Entity Из Message.Entities Цикл
		Если МассивAttachmentType.Найти(Entity.AttachmentType) <> Неопределено Тогда
			СписокParentEntityId.Добавить(Entity.EntityId, Entity.AttachmentType);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокParentEntityId;
	
КонецФункции // ПолучитьСписокParentEntityIdТитуловПолучателя()

Функция ПолучитьСписокParentEntityIdИзвещенийДляОтправки(Message)
	
	СписокParentEntityId = ПолучитьСписокParentEntityIdТитуловПолучателя(Message);
	
	Для каждого Entity Из Message.Entities Цикл
		Если Прав(Entity.AttachmentType,7) = "Receipt" Тогда
			НайденныйЭлемент = СписокParentEntityId.НайтиПоЗначению(Entity.ParentEntityId);
			Если НЕ НайденныйЭлемент = Неопределено Тогда
				СписокParentEntityId.Удалить(НайденныйЭлемент);	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокParentEntityId;
	
КонецФункции // ПолучитьСписокParentEntityIdИзвещенийДляОтправки()

Функция СохранитьТекстИзвещенияВФайл(entityId, ТекстИзвещения, ПутьКФайлу)
	
	ВременныйФайл = Новый Файл(ПутьКФайлу);
	Если ВременныйФайл.Существует() Тогда
		УдалитьФайлы(ВременныйФайл.ПолноеИмя); //Если такой файл уже есть в temp, значит, он остался от предыдущей сессии, когда чо-то пошло не так. Удалим его.
	КонецЕсли;
	ТД = Новый ТекстовыйДокумент;
	ТД.УстановитьТекст(ТекстИзвещения);
	ТД.Записать(ПутьКФайлу, "windows-1251");
	
	Возврат ТД;
	
КонецФункции

Процедура ЗаписатьДопРеквизитыСообщенияInvoiceReceiptId(MessagePatch, СписокParentEntityId, СообщениеСсылка)
	
	Если MessagePatch.Свойство("Entities") И ТипЗнч(MessagePatch.Entities) = Тип("Массив") Тогда
			Для каждого Entity Из MessagePatch.Entities Цикл
				Если Прав(Entity.AttachmentType,7) = "Receipt" Тогда
					
					НайденныйЭлемент = СписокParentEntityId.НайтиПоЗначению(Entity.ParentEntityId);
					Если НЕ НайденныйЭлемент = Неопределено Тогда
						ЗаписатьДопРеквизитСправочника_КонтурEDI(СообщениеСсылка, "InvoiceReceiptEntityId_HaveToCreateReceipt", Entity.EntityId);
					КонецЕсли;
					
				КонецЕсли;
			КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция ЗаписатьСлужебноеУниверсальноеСообщение(СтруктураПараметров) Экспорт 
	
	Фабрика = XML_ФабрикаXDTO("GenerateUniversalMessageUserContract");
	
	Результат = КонтурСтандарт_ПолучитьПустойОбъектXDTO(Фабрика,"UniversalMessage", "UniversalMessage");
	
	UniversalMessageInfos = КонтурСтандарт_НовыйДочернийОбъектXDTO(Фабрика, Результат, "UniversalMessageInfos");
	UniversalMessageInfo = КонтурСтандарт_НовыйДочернийОбъектXDTO(Фабрика, UniversalMessageInfos, "UniversalMessageInfo");
	
	КонтурСтандарт_УстановитьЗначениеXDTO(UniversalMessageInfo, "StatusCode", СтруктураПараметров.Код);
	
	Если ЗначениеЗаполнено(СтруктураПараметров.ТекстСообщения) Тогда
		КонтурСтандарт_УстановитьЗначениеXDTO(UniversalMessageInfo, "PlainText", СтруктураПараметров.ТекстСообщения);
	КонецЕсли;
	
	Отправитель = СтруктураПараметров.Отправитель;
	
	Sender = КонтурСтандарт_НовыйДочернийОбъектXDTO(Фабрика, Результат, "Sender");
	КонтурСтандарт_УстановитьЗначениеXDTO(Sender, "UseDefaultPersonInfo", Отправитель.ДанныеПоУмолчанию);
	
	Fio = КонтурСтандарт_НовыйДочернийОбъектXDTO(Фабрика, Sender, "Fio");
	
	КонтурСтандарт_УстановитьЗначениеXDTO(Fio, "LastName",  Отправитель.Фамилия);
	КонтурСтандарт_УстановитьЗначениеXDTO(Fio, "FirstName", Отправитель.Имя);   
	
	СтрокаXML = КонтурСтандарт_ОбъектXDTO_В_СтрокаXML(Фабрика, Результат,"utf-8");
	XML_УдалитьОбъявлениеПрефиксовПространстваИмен("UniversalMessage", СтрокаXML);
	
	Возврат СтрокаXML;	
КонецФункции

Функция API_GenerateUniversalMessage(ИдентификаторЯщика, messageId, attachmentId, СтрокаXML) Экспорт  
	
	ДанныеАвторизацииДиадок = ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизации);
	Результат = КонтурДиадокAPI_СгенерироватьУниверсальноеСообщение(ДанныеАвторизацииДиадок, ИдентификаторЯщика, messageId, attachmentId, СтрокаXML);
	
	Возврат Результат;
	
КонецФункции	

Функция ВернутьПараметрыСуС(КодСообщения = "1999",ТекстСообщения = "",ДанныеСертификата) Экспорт 
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Код"				, КодСообщения);
	СтруктураПараметров.Вставить("ТекстСообщения"	, ТекстСообщения);
	Отправитель = Новый Структура;
	Отправитель.Вставить("ДанныеПоУмолчанию"		, "false");//ДанныеПоУмолчанию
	Отправитель.Вставить("Фамилия"					, ДанныеСертификата.СвойстваСертификата.Субъект.Фамилия);
	Отправитель.Вставить("Имя"						, ДанныеСертификата.СвойстваСертификата.Субъект.Имя);
	Отправитель.Вставить("Отчество"					, ДанныеСертификата.СвойстваСертификата.Субъект.Отчество); 
	СтруктураПараметров.Вставить("Отправитель"		, Отправитель); 
	
	Возврат СтруктураПараметров;
КонецФункции

Функция DD_ПолучитьУниверсальныеСообщенияПоОрганизации(Организация) Экспорт 
	
	СброситьПроверкиДанныхАвторизации();	
	ИнициализироватьДанныеАвторизации(Организация);
	
	Если ДанныеАвторизации.ТипАвторизации <> "ЛогинПароль" Тогда  
		ОбновитьДанныеАвторизации("ТипАвторизации", "Сертификат");
	КонецЕсли;
	
	Если Не СертификатПоОрганизацииНазначен(Организация) Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	//Поиск ящика Диадока
	ИдентификаторОрганизацииДиадок = ИдентификаторОрганизацииДиадок(ДанныеАвторизации.Организация);
	ИдентификаторЯщикаДиадок = ИдентификаторЯщикаДиадок(ДанныеАвторизации,ИдентификаторОрганизацииДиадок);  
	
	СписокДокументов = Неопределено;
	
	Попытка
		
		ДанныеАвторизацииДиадок = ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизации);
		
		СписокДокументов = КонтурДиадокAPI_СписокДокументовПолный(ДанныеАвторизацииДиадок, ИдентификаторЯщикаДиадок, "Any.OutboundHaveToCreateReceipt");
		
	Исключение

		ОписаниеОшибки = ОписаниеОшибки();
		ТекстСообщения = КонтурСтандарт_СтрШаблон_("По организации ""%1"" не удалось получить универсальные сообщения по причине:%2%3", Строка(Организация), Символы.ПС, ОписаниеОшибки);		
		Сообщить_КонтурEDI(ТекстСообщения);
				
	КонецПопытки;
	
	Возврат СписокДокументов;
	
КонецФункции

Функция ДанныеАвторизацииДляКонтурДиадокAPI(ДанныеАвторизацииВнешние) Экспорт
	
	ТипыАвторизации = КонтурДиадокAPI_ТипыАвторизации();
	ДанныеАвторизацииДиадок = Неопределено;
	
	Если ДанныеАвторизацииВнешние.ТипАвторизации = "Сертификат" Тогда
		
		ТипАвторизацииСертификат = ТипыАвторизации.Сертификат;
		
		ДанныеАвторизацииДиадок = КонтурДиадокAPI_НовыйДанныеАвторизации(ТипАвторизацииСертификат);
		
		ДанныеАвторизацииДиадок.Отпечаток 			= ДанныеАвторизацииВнешние.Отпечаток;
		ДанныеАвторизацииДиадок.Расположение 		= ДанныеАвторизацииВнешние.Расположение;
		ДанныеАвторизацииДиадок.ПарольЗакрытогоКлюча = ДанныеАвторизацииВнешние.ПарольКонтейнера;
				
	ИначеЕсли ДанныеАвторизацииВнешние.ТипАвторизации = "ЛогинПароль" Тогда
		
		ТипАвторизацииЛогин = ТипыАвторизации.ЛогинПароль;
		
		ДанныеАвторизацииДиадок = КонтурДиадокAPI_НовыйДанныеАвторизации(ТипАвторизацииЛогин);
		
		ДанныеАвторизацииДиадок.Логин  = ДанныеАвторизацииВнешние.Логин;
		ДанныеАвторизацииДиадок.Пароль = ДанныеАвторизацииВнешние.Пароль;
			
	Иначе
		ВызватьИсключение КонтурСтандарт_СтрШаблон_("КонтурДиадокAPI: Недопустимый тип авторизации ""%1"" ", ДанныеАвторизацииВнешние.ТипАвторизации);
	КонецЕсли;
		
	Возврат ДанныеАвторизацииДиадок;
	
КонецФункции

