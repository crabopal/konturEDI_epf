// Контекст_приложения
Функция Метрика_НовыйКонтекстПриложения(Знач AppVersion = Неопределено, 
										КП_Браузер = Неопределено, 
										КП_АппаратноеОбеспечение = Неопределено, 
										КП_ОС = Неопределено, 
										КП_Платформа = Неопределено) Экспорт
		
	КонтекстПриложения = Новый Соответствие;
	КонтекстПриложения.Вставить("AppVersion", AppVersion);
	КонтекстПриложения.Вставить("Browser"	, КП_Браузер);
	КонтекстПриложения.Вставить("Hardware"	, КП_АппаратноеОбеспечение);
	КонтекстПриложения.Вставить("OS"		, КП_ОС);
	КонтекстПриложения.Вставить("Platform"	, КП_Платформа);
	
	Если AppVersion = Неопределено Тогда
		КонтекстПриложения.Удалить("AppVersion");	
	КонецЕсли;
	
	Если КП_Браузер = Неопределено Тогда
		КонтекстПриложения.Удалить("Browser");	
	КонецЕсли;
	
	Если КП_АппаратноеОбеспечение = Неопределено Тогда
		КонтекстПриложения.Удалить("Hardware");	
	КонецЕсли;

	Если КП_ОС = Неопределено Тогда
		КонтекстПриложения.Удалить("OS");	
	КонецЕсли;

	Если КП_Платформа = Неопределено Тогда
		КонтекстПриложения.Удалить("Platform");	
	КонецЕсли;
	
	Возврат КонтекстПриложения; 
	
КонецФункции

Функция Метрика_НовыйКонтекстПриложенияБраузер() Экспорт
	
	Перем UserAgent; 
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	
	UserAgent = СистемнаяИнформация.ИнформацияПрограммыПросмотра;
	
	//
	
	Если ПустаяСтрока(UserAgent) Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	КП_Браузер = Новый Соответствие;
	КП_Браузер.Вставить("UserAgent", UserAgent);
	
	Возврат КП_Браузер; 
	
КонецФункции

Функция Метрика_НовыйКонтекстПриложенияАппаратноеОбеспечение() Экспорт
	
	Перем CoresCount, TotalMemoryGb;
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	
	TotalMemoryGb = Окр(СистемнаяИнформация.ОперативнаяПамять / 1000);
	
	//
	
	КП_АппаратноеОбеспечение = Новый Соответствие;
	КП_АппаратноеОбеспечение.Вставить("TotalMemoryGb", TotalMemoryGb);
	//КП_АппаратноеОбеспечение.Вставить("CoresCount"	 , CoresCount);
	
	Возврат КП_АппаратноеОбеспечение; 
	
КонецФункции

Функция Метрика_НовыйКонтекстПриложенияОС() Экспорт
	
	Перем BitSet, Name, Version;
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	СтрокаТипПлатформы  = НРег(СистемнаяИнформация.ТипПлатформы);	
	
	// 
	
	Если Найти(СтрокаТипПлатформы, "64") <> 0 Тогда
		BitSet = "x64";
	Иначе
		BitSet = "x86";	
	КонецЕсли;
	
	// 
	
	Если Найти(СтрокаТипПлатформы, НРег("Linux")) <> 0 Тогда
		Name = "Linux";
	ИначеЕсли Найти(СтрокаТипПлатформы, НРег("MacOS")) <> 0 Тогда
		Name = "MacOS";
	ИначеЕсли Найти(СтрокаТипПлатформы, НРег("Windows")) <> 0 Тогда	
		Name = "Windows";	
	КонецЕсли;	

	Version = "0.0.0";
	
	// С версией какие-то авантюры нужны
	
	КП_ОС = Новый Соответствие;
	КП_ОС.Вставить("BitSet"	, BitSet);
	КП_ОС.Вставить("Name"	, Name);
	КП_ОС.Вставить("Version", Version);
	
	Возврат КП_ОС; 
	
КонецФункции

Функция Метрика_СформироватьДополнительныеСвойстваКонфигурации() Экспорт
	
	СписокСвойствМетаданных = "РежимУправленияБлокировкойДанных,
							  |РежимИспользованияМодальности,
							  |РежимИспользованияСинхронныхВызововРасширенийПлатформыИВнешнихКомпонент,
							  |РежимСовместимости,
							  |РежимСовместимостиИнтерфейса,
							  |ИспользоватьУправляемыеФормыВОбычномПриложении,
							  |ИспользоватьОбычныеФормыВУправляемомПриложении";
	
	MetadataProperty = Новый Структура(СтрЗаменить(СписокСвойствМетаданных, Символы.ПС, ""));
	ЗаполнитьЗначенияСвойств(MetadataProperty, Метаданные);
	
	КП_ДополнительныеСвойстваКонфигурации = Новый Соответствие;
	КП_ДополнительныеСвойстваКонфигурации.Вставить("DataLockControlMode"	, Строка(MetadataProperty.РежимУправленияБлокировкойДанных));
	КП_ДополнительныеСвойстваКонфигурации.Вставить("ModalityUseMode"		, Строка(MetadataProperty.РежимИспользованияМодальности));
	
	КП_ДополнительныеСвойстваКонфигурации.Вставить("SynchronousPlatformExtensionAndAddInCallUseMode"
	, Строка(MetadataProperty.РежимИспользованияСинхронныхВызововРасширенийПлатформыИВнешнихКомпонент));
	
	КП_ДополнительныеСвойстваКонфигурации.Вставить("CompatibilityMode"					, Строка(MetadataProperty.РежимСовместимости));
	КП_ДополнительныеСвойстваКонфигурации.Вставить("InterfaceCompatibilityMode" 			, Строка(MetadataProperty.РежимСовместимостиИнтерфейса));
	КП_ДополнительныеСвойстваКонфигурации.Вставить("UseManagedFormInOrdinaryApplication" , Строка(MetadataProperty.ИспользоватьУправляемыеФормыВОбычномПриложении));
	КП_ДополнительныеСвойстваКонфигурации.Вставить("UseOrdinaryFormInManagedApplication" , Строка(MetadataProperty.ИспользоватьОбычныеФормыВУправляемомПриложении));
	
	Возврат КП_ДополнительныеСвойстваКонфигурации; 
	
КонецФункции

Функция Метрика_НовыйКонтекстПриложенияПлатформа() Экспорт
	
	СистемнаяИнформация  = Новый СистемнаяИнформация;
	Name		  		 = "1С:Предприятие 8";
	Configuration 		 = Метаданные.Имя;
	ConfigurationVersion = Метаданные.Версия;
	RunMode 	         = РежимЗапускаПриложения();
	Version				 = СистемнаяИнформация.ВерсияПриложения;

	КП_Платформа = Новый Соответствие;
	КП_Платформа.Вставить("Name"				, Name);
	КП_Платформа.Вставить("Configuration"		, Configuration);
	КП_Платформа.Вставить("ConfigurationVersion", Метрика_ПреобразоватьВерсиюВСемантик(ConfigurationVersion));
	КП_Платформа.Вставить("RunMode"				, RunMode);
	КП_Платформа.Вставить("Version"				, Метрика_ПреобразоватьВерсиюВСемантик(Version));
	
	Возврат КП_Платформа; 
	
КонецФункции

Функция Метрика_ОбработатьОтложеннуюОтправку(Знач МассивМетрик, Топик)
	
	Результат = Новый Структура("Успешно, Данные", Ложь, "");
	
	РазмерПакета = Метрика_МинимальныйРазмерПакета(Топик);
	
	Если ТипЗнч(МассивМетрик) = Тип("Массив") И МассивМетрик.Количество() < РазмерПакета Тогда
		
		ОбъектНакопления = Метрика_ПолучитьОбъектНакопления(Топик);
		
		КоличествоНакопленныхМетрик = ОбъектНакопления.ДополнительныеРеквизиты.Количество();	
		
		Если МассивМетрик.Количество() + КоличествоНакопленныхМетрик < РазмерПакета Тогда
			
			Результат.Успешно = Метрика_СохранитьДляОтложеннойОтправки(МассивМетрик, ОбъектНакопления);
			
		Иначе
			
			Результат.Успешно = Метрика_ДополнитьПакетОтложенными(МассивМетрик, ОбъектНакопления);
						
			Если Результат.Успешно Тогда
				
				Результат.Данные = МассивМетрик;
				
			КонецЕсли;
										
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Метрика_МинимальныйРазмерПакета(Топик)
	
	РазмерПакета = ПолучитьКонстантуEDI("МинимальныйРазмерПакетаМетрик");
	
	// не отправлять пакеты меньшего размера
	Если ТипЗнч(РазмерПакета) <> Тип("Число") Или РазмерПакета <= 0 Тогда
		
		Если Топик = "Statistics" Или Топик = "Log" Тогда
			РазмерПакета = 10;
		Иначе // Behavior, Health, Feedback
			РазмерПакета = 20;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РазмерПакета;
		
КонецФункции

Функция Метрика_ПолучитьОбъектНакопления(Топик)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	КонтурEDI_ДополнительныеСправочники.Ссылка Как Ссылка
		|ИЗ
		|	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
		|ГДЕ
		|	КонтурEDI_ДополнительныеСправочники.Наименование = &Наименование
		|	И КонтурEDI_ДополнительныеСправочники.ИмяСправочника = &ИмяСправочника";
	
	Запрос.УстановитьПараметр("ИмяСправочника", "Метрики");
	Запрос.УстановитьПараметр("Наименование", Топик);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда

		НайденнаяСсылка = ВыборкаДетальныеЗаписи.Ссылка;	
		ДопСправочникОбъект = НайденнаяСсылка.ПолучитьОбъект();

	Иначе
		
		ДопСправочникОбъект = Справочники.КонтурEDI_ДополнительныеСправочники.СоздатьЭлемент();
		ДопСправочникОбъект.Наименование = Топик;
		ДопСправочникОбъект.ИмяСправочника = "Метрики";
		
	КонецЕсли;
	
	Возврат ДопСправочникОбъект;
	
КонецФункции	

Функция Метрика_СохранитьДляОтложеннойОтправки(МассивМетрик, ОбъектНакопления)
	
	Результат = Ложь;
	
	СохраненоМетрик = 0;
	
	Для Каждого Метрика Из МассивМетрик Цикл
		
		ЗначениеМетрики = Метрика_ПреобразоватьВJSON(Метрика);

		НоваяСтрока = ОбъектНакопления.ДополнительныеРеквизиты.Добавить();
		НоваяСтрока.ИмяРеквизита = ОбъектНакопления.Наименование;
		НоваяСтрока.ЗначениеСтрока = Метрика["Id"];
		НоваяСтрока.ЗначениеХранилищеЗначения = Новый ХранилищеЗначения(ЗначениеМетрики, Новый СжатиеДанных(9));
				
		СохраненоМетрик = СохраненоМетрик + 1;
		
	КонецЦикла;
	 
	Если СохраненоМетрик = МассивМетрик.Количество() Тогда 

		ОбъектНакопления.Записать();
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Метрика_ДополнитьПакетОтложенными(МассивМетрик, ОбъектНакопления)
	
	Результат = Ложь;
	
	КоличествоНакопленныхМетрик = ОбъектНакопления.ДополнительныеРеквизиты.Количество();
	
	ДобавленоМетрик = 0;
	
 	Для Каждого Метрика Из ОбъектНакопления.ДополнительныеРеквизиты Цикл
		
		ЗначениеМетрики = Метрика.ЗначениеХранилищеЗначения.Получить();

		СохраненнаяМетрика = КонтурСтандарт_ЗначениеИзСтрокиJSON(ЗначениеМетрики, Истина);
		
		Если ТипЗнч(СохраненнаяМетрика) = Тип("Соответствие") Тогда
			
			МоментВремени = Метрика_НовыйМоментВремени();
			СохраненнаяМетрика["Time"]["SendFromClientTime"] = МоментВремени["SendFromClientTime"];
			МассивМетрик.Добавить(СохраненнаяМетрика);
			
			ДобавленоМетрик = ДобавленоМетрик + 1;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ДобавленоМетрик = КоличествоНакопленныхМетрик Тогда
	
		ОбъектНакопления.ДополнительныеРеквизиты.Очистить();
		ОбъектНакопления.Записать();
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

