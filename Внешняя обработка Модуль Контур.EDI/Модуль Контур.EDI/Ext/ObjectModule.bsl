// Интеграция модулей "Аутентификатор" и "АутентификаторХранилище" в модуль КонтурEDI //
////////////////////////////////////////////////////////////////////////////////////////

Процедура АутентификаторEDI_Инициализировать(Организация = Неопределено) Экспорт
	
	Если ХранилищеСессий = Неопределено Тогда
		Аутентификатор_УстановитьХранилищеСессий(ХранилищеСессий);
	КонецЕсли;
	
	Если КонфигурацияПровайдера = Неопределено Тогда
		КонфигурацияПровайдера = Аутентификатор_КонфигурацияПровайдераПоУмолчанию();
		Аутентификатор_УстановитьКонфигурациюПровайдера(КонфигурацияПровайдера);
	КонецЕсли;
	
	Если КонфигурацияПриложения = Неопределено Тогда 
		КонфигурацияПриложения = АутентификаторEDI_КонфигурацияПриложенияПоУмолчанию();
		Аутентификатор_УстановитьКонфигурациюПриложения(КонфигурацияПриложения);
	КонецЕсли;
	
	ОтборСессий = ХранилищеСессийEDI_ОтборСессийПоУмолчанию(Аутентификатор_СобратьКлючОбъекта(Организация));
	
	Если НастройкиПрокси = Неопределено Тогда
		НастройкиПрокси = ПолучитьПараметрыИнтернетСоединения_KE();
	КонецЕсли;
	
	АутентификаторEDI_СоздатьСессиюHttp();
	
КонецПроцедуры

Процедура АутентификаторEDI_СоздатьСессиюHttp() Экспорт

	Если СессияHttpЛок = Неопределено Тогда
		СессияHttpЛок = КлиентHTTP_СоздатьСессию();			
		СессияHttpЛок.Прокси = ПолучитьИнтернетПрокси();
	КонецЕсли;
	
КонецПроцедуры

Процедура АутентификаторEDI_ПодготовитьТаблицуСессий(СессииПортальнойАутентификации) Экспорт
	
	Если СессииПортальнойАутентификации = Неопределено Тогда
		СессииПортальнойАутентификации = Новый ТаблицаЗначений;
	КонецЕсли;
	
	Если СессииПортальнойАутентификации.Колонки.Количество() = 0 Тогда
		СессииПортальнойАутентификации.Колонки.Добавить("УчетнаяЗапись");
		СессииПортальнойАутентификации.Колонки.Добавить("Организация");
		СессииПортальнойАутентификации.Колонки.Добавить("Сессия");
		СессииПортальнойАутентификации.Колонки.Добавить("Активна");
	Иначе
		СессииПортальнойАутентификации.Очистить();
	КонецЕсли;
	
	УчетныеЗаписи = ПолучитьСписокЭлементовСправочника("УчетныеЗаписи");  
	
	ТипыАвторизации = КонтурEDIAPI_ТипыАвторизации();
	
	Для Каждого УчетнаяЗапись Из УчетныеЗаписи Цикл 
		
		Если УчетнаяЗапись.НеАктивна Или Не УчетнаяЗапись.ТипАвторизации = ТипыАвторизации.ТокенДоступа Тогда
			Продолжить;
		КонецЕсли;

		Организация = НайтиОбъектПоЗначениюСвойства("GLN_Организации", УчетнаяЗапись.GLN);
		
		Если ЗначениеЗаполнено(Организация) Тогда
			
			АутентификаторEDI_Инициализировать(Организация);
			
			НоваяСессия = СессииПортальнойАутентификации.Добавить();
			НоваяСессия.УчетнаяЗапись = УчетнаяЗапись.Ссылка;
			НоваяСессия.Организация = Организация;
			НоваяСессия.Сессия = Аутентификатор_ПолучитьСессию();
			НоваяСессия.Активна = Неопределено;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция АутентификаторEDI_ПолучитьЗаголовокОжидания(Организация) Экспорт
	
	Возврат "Ждем, пока войдете" + ?(ЗначениеЗаполнено(Организация), " в учетную запись организации:" + Символы.ПС + Строка(Организация), "");

КонецФункции

// Используем в качестве ключа настроек строку GUID Организации
//
Функция АутентификаторEDI_СобратьКлючОбъекта(Организация)
		
	Если ЗначениеЗаполнено(Организация) Тогда
		Возврат Строка(Организация.УникальныйИдентификатор());
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции	

