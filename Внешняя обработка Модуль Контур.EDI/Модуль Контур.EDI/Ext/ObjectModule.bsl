//{#Область Маркировка

Процедура ДополнитьСообщениеКодамиМаркировки(Сообщение, Параметры) Экспорт
	
	ИгнорироватьНастройкиОтправки = Ложь;
	
	Если Не Параметры = Неопределено 
		И ПеременнаяСодержитСвойство(Параметры, "ИгнорироватьНастройкиОтправкиКодовМаркировки") Тогда
		
		ИгнорироватьНастройкиОтправки = Параметры.ИгнорироватьНастройкиОтправкиКодовМаркировки;
		
	КонецЕсли;
	
	Если Не ИгнорироватьНастройкиОтправки
		И Не ОтправлятьКодыМаркировки(Сообщение) Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоСообщениеINVOIC   = (Сообщение.ТипСообщения = "INVOIC");
	ЭтоСообщениеCOINVOIC = (Сообщение.ТипСообщения = "COINVOIC");
	
	СообщениеДляВосстаноленияКодовМаркировки = ПолучитьСообщениеДляВосстановленияКодовМаркировки(Параметры, Сообщение);
	
	Если Не СообщениеДляВосстаноленияКодовМаркировки = Неопределено Тогда
		
		ВосстанавливаемыеПоля = Новый Массив;
		
		Если ЭтоСообщениеCOINVOIC Тогда
			ВосстанавливаемыеПоля.Добавить(ПоляИсточникаПриемникаКодовМаркировкиПостфикс("До"));
			ВосстанавливаемыеПоля.Добавить(ПоляИсточникаПриемникаКодовМаркировкиПостфикс("После"));
		Иначе
			ВосстанавливаемыеПоля.Добавить(ПоляИсточникаПриемникаКодовМаркировки());
		КонецЕсли;
		
		Для каждого ПоляИсточникаПриемника Из ВосстанавливаемыеПоля Цикл
			ПеренестиКодыМаркировкиМеждуСообщениями(СообщениеДляВосстаноленияКодовМаркировки.Товары, Сообщение, ПоляИсточникаПриемника);
		КонецЦикла;
		
		Сообщение.Вставить("КодыМаркировкиОтредактированыВручную", Истина);
		
		Если ЭтоСообщениеINVOIC И СообщениеСодержитКодыМаркировки(Сообщение) Тогда
			
			Если Сообщение.ТипыМаркируемойПродукции.НайтиПоЗначению("Mark") = Неопределено Тогда
				Сообщение.ТипыМаркируемойПродукции.Добавить("Mark", "Товары, подлежащие маркировке");
			КонецЕсли;
			
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
		
	Если ЭтоСообщениеCOINVOIC Тогда
		
		ТипыСообщений = Новый Массив;
		ТипыСообщений.Добавить("COINVOIC");
		ТипыСообщений.Добавить("INVOIC");
		
		МассивПредыдущихINVOIC_COINVOIC = МассивПредыдущихСообщений_КонтурEDI(Сообщение, ТипыСообщений);
		ТаблицаИсходныхТоваров = ПолучитьТаблицуТоваровИсходногоСообщенияCOINVOIC_КонтурEDI(МассивПредыдущихINVOIC_COINVOIC);
		
		ПоляИсточникаПриемника = ПоляИсточникаПриемникаКодовМаркировки();
		ПоляИсточникаПриемника.КодыМаркировкиПриемник = "КодыМаркировкиДо";
		ПоляИсточникаПриемника.КоличествоПриемник = "КоличествоДо";
		ПоляИсточникаПриемника.ЦенаПриемник = "ЦенаСНДСДо";
			
		ПеренестиКодыМаркировкиМеждуСообщениями(ТаблицаИсходныхТоваров, Сообщение, ПоляИсточникаПриемника, Истина);

	КонецЕсли;
	
	ПараметрыПодбораКодов = ПодготовитьПараметрыПодбораКодовМаркировки(Сообщение);
	РаспределитьКодыМаркировкиПоСообщению(Сообщение, ПараметрыПодбораКодов, ЭтоСообщениеCOINVOIC);
		
	Если ЭтоСообщениеINVOIC И СообщениеСодержитКодыМаркировки(Сообщение) Тогда
		
		Если Сообщение.ТипыМаркируемойПродукции.НайтиПоЗначению("Mark") = Неопределено Тогда
			Сообщение.ТипыМаркируемойПродукции.Добавить("Mark", "Товары, подлежащие маркировке");
		КонецЕсли;
			
	КонецЕсли;
	
КонецПроцедуры

Процедура ПеренестиКодыМаркировкиМеждуСообщениями(ТоварыИсточник, 
												  СообщениеПриемник, 
												  ПоляИсточникаПриемника = Неопределено,
												  ПодборИзПредыдущегоСообщения = Ложь)
	
	Если ПоляИсточникаПриемника = Неопределено Тогда
		ПоляИсточникаПриемника = ПоляИсточникаПриемникаКодовМаркировки();
	КонецЕсли;
	
	ТоварыПриемник = СообщениеПриемник.Товары;
	
	Если ТоварыИсточник.Колонки.Найти(ПоляИсточникаПриемника.КодыМаркировкиИсточник) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТоварыИсточник.Колонки.Найти("СтрокаОбработана") = Неопределено Тогда
		ТоварыИсточник.Колонки.Добавить("СтрокаОбработана", Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	
	ТоварыИсточник.ЗаполнитьЗначения(Ложь, "СтрокаОбработана");
	
	ИспользоватьУИДыСтрок = Истина;
	
	Если ТоварыИсточник.Колонки.Найти("УИД_СтрокиТовара") = Неопределено
		ИЛИ ТоварыПриемник.Колонки.Найти("УИД_СтрокиТовара") = Неопределено Тогда
		
		ИспользоватьУИДыСтрок = Ложь;
		
	КонецЕсли;
	
	СопоставлениеТоваровТолькоПоШК = ПолучитьЗначениеСвойстваОбъектаEDI(СообщениеПриемник.Партнер, "СинхронизироватьТоварыТолькоПоGTIN");
	СопоставлениеТоваровТолькоПоКоду = ПолучитьЗначениеСвойстваОбъектаEDI(СообщениеПриемник.Партнер, "СинхронизироватьТоварыТолькоПоКодуПартнера");
	
	ИспользоватьСерииНоменклатуры = ЗначениеЗаполнено(ПолучитьТипЗначенияОбъекта("СерияНоменклатуры"));
	ИспользоватьХарактеристики = ЗначениеЗаполнено(ПолучитьТипЗначенияОбъекта("ХарактеристикаНоменклатуры"));

	ОбязательныеПоляПоискаСтрокиИсточника = Новый Массив;
	ОбязательныеПоляПоискаСтрокиИсточника.Добавить("СтрокаОбработана");
	
	Если СопоставлениеТоваровТолькоПоШК = Истина Тогда
		ОбязательныеПоляПоискаСтрокиИсточника.Добавить("GTIN");
	ИначеЕсли СопоставлениеТоваровТолькоПоКоду = Истина Тогда
		ОбязательныеПоляПоискаСтрокиИсточника.Добавить("КодТовараПокупателя");
	Иначе
		ОбязательныеПоляПоискаСтрокиИсточника.Добавить("GTIN");
		ОбязательныеПоляПоискаСтрокиИсточника.Добавить("КодТовараПокупателя");
	КонецЕсли;
	
	ОбязательныеПоляПоискаСтрокиИсточника.Добавить("КодЕдиницыИзмеренияEDI");
	
	ПеременныеПоляПоискаСтрокиИсточника = Новый Массив;
	
	Если ИспользоватьУИДыСтрок Тогда
		
		ПеременныеПоляПоискаСтрокиИсточника.Добавить("УИД_СтрокиПервоначальногоСообщения");
	
		Если ПодборИзПредыдущегоСообщения Тогда
			ПеременныеПоляПоискаСтрокиИсточника.Добавить("УИД_СтрокиТовара");
		КонецЕсли;
		
	КонецЕсли;
	
	ПеременныеПоляПоискаСтрокиИсточника.Добавить("Номенклатура");
	ПеременныеПоляПоискаСтрокиИсточника.Добавить("ЕдиницаИзмерения");
	
	Если ИспользоватьХарактеристики Тогда
		ПеременныеПоляПоискаСтрокиИсточника.Добавить("ХарактеристикаНоменклатуры");
	КонецЕсли;
		
	Если ИспользоватьСерииНоменклатуры Тогда
		ПеременныеПоляПоискаСтрокиИсточника.Добавить("СерияНоменклатуры");
	КонецЕсли;
	
	ПеременныеПоляПоискаСтрокиИсточника.Добавить(ПоляИсточникаПриемника.КоличествоИсточник);
	ПеременныеПоляПоискаСтрокиИсточника.Добавить(ПоляИсточникаПриемника.ЦенаИсточник);

	ВариантыПоиска = ПодготовитьВариантыПоискаСтрокиТоваров(ОбязательныеПоляПоискаСтрокиИсточника, ПеременныеПоляПоискаСтрокиИсточника);
	ДанныеДляПоиска = Новый Структура(ВариантыПоиска[0]);
	
	Для каждого СтрокаТовара Из ТоварыПриемник Цикл
		
		СтрокаТовара[ПоляИсточникаПриемника.КодыМаркировкиПриемник].Очистить();
		
		ЗаполнитьЗначенияСвойств(ДанныеДляПоиска, СтрокаТовара);
		
		ДанныеДляПоиска.СтрокаОбработана = Ложь;
		
		Если ПодборИзПредыдущегоСообщения И ИспользоватьУИДыСтрок Тогда
			ДанныеДляПоиска.УИД_СтрокиТовара = СтрокаТовара.УИД_СтрокиПредыдущегоСообщения;
		КонецЕсли;
		
		ДанныеДляПоиска[ПоляИсточникаПриемника.КоличествоИсточник] = СтрокаТовара[ПоляИсточникаПриемника.КоличествоПриемник];
		ДанныеДляПоиска[ПоляИсточникаПриемника.ЦенаИсточник] = СтрокаТовара[ПоляИсточникаПриемника.ЦенаПриемник];
		
		ПодходящиеСтрокиИсточника = НайтиСтрокиВТаблицеПоВариантамПоиска(ТоварыИсточник, ДанныеДляПоиска, ВариантыПоиска);
		
		Если ПодходящиеСтрокиИсточника.Количество() > 0 Тогда
			
			СтрокаИсточника = ПодходящиеСтрокиИсточника[0];
			СтрокаИсточника.СтрокаОбработана = Истина;
			
			СтрокаТовара[ПоляИсточникаПриемника.КодыМаркировкиПриемник] = СтрокаИсточника[ПоляИсточникаПриемника.КодыМаркировкиИсточник];
			
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

Функция ПоляИсточникаПриемникаКодовМаркировки(КодыМаркировкиИсточник = "КодыМаркировки",
											  КодыМаркировкиПриемник = "КодыМаркировки",
											  КоличествоИсточник = "Количество",
											  КоличествоПриемник = "Количество",
											  ЦенаПриемник = "ЦенаСНДС",
											  ЦенаИсточник = "ЦенаСНДС")
	
	СоответствиеПолейДляПереносаКодов = Новый Структура;
	СоответствиеПолейДляПереносаКодов.Вставить("КодыМаркировкиИсточник",КодыМаркировкиИсточник);
	СоответствиеПолейДляПереносаКодов.Вставить("КоличествоИсточник",КоличествоИсточник);
	СоответствиеПолейДляПереносаКодов.Вставить("КодыМаркировкиПриемник",КодыМаркировкиПриемник);
	СоответствиеПолейДляПереносаКодов.Вставить("КоличествоПриемник",КоличествоПриемник);
	СоответствиеПолейДляПереносаКодов.Вставить("ЦенаПриемник",ЦенаПриемник);
	СоответствиеПолейДляПереносаКодов.Вставить("ЦенаИсточник",ЦенаИсточник);
	
	Возврат СоответствиеПолейДляПереносаКодов;
	
КонецФункции

Функция ПоляИсточникаПриемникаКодовМаркировкиПостфикс(Постфикс)
	
	СоответствиеПолей = ПоляИсточникаПриемникаКодовМаркировки();
	Для каждого Соответствие Из СоответствиеПолей Цикл
		СоответствиеПолей[Соответствие.Ключ] = Соответствие.Значение + Постфикс;
	КонецЦикла;
	
	Возврат СоответствиеПолей;
	
КонецФункции

Функция ПолучитьСообщениеДляВосстановленияКодовМаркировки(ПараметрыПодготовкиИсходящегоСообщения, Сообщение)
	
	СохраненноеСообщениеСсылка = Неопределено;
	
	Если ЗначениеЗаполнено(ПараметрыПодготовкиИсходящегоСообщения) 
		И (ПеременнаяСодержитСвойство(ПараметрыПодготовкиИсходящегоСообщения, "ПереотправляемоеСообщениеСсылка", СохраненноеСообщениеСсылка, Истина)
		ИЛИ ПеременнаяСодержитСвойство(ПараметрыПодготовкиИсходящегоСообщения, "СообщениеСсылка", СохраненноеСообщениеСсылка, Истина)) Тогда
		
		СохраненноеСообщение = ПрочитатьСообщение(СохраненноеСообщениеСсылка);
			
		Если ПеременнаяСодержитСвойство(СохраненноеСообщение,"КодыМаркировкиОтредактированыВручную") 
			И СохраненноеСообщение.КодыМаркировкиОтредактированыВручную = Истина 
			И СохраненноеСообщение.ТипСообщения = Сообщение.ТипСообщения 
			И СохраненноеСообщение.Документ1С = Сообщение.Документ1С
			И (Не ПеременнаяСодержитСвойство(СохраненноеСообщение, "Исправление") 
				ИЛИ СохраненноеСообщение.Исправление = Сообщение.Исправление) Тогда
			
			Возврат СохраненноеСообщение;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ОпределитьДокументСодержащийКодыМаркировки(Сообщение) Экспорт
	
	Перем ДокументСодержащийКоды;
	
	Если Сообщение.ТипСообщения = "COINVOIC"
		ИЛИ (Сообщение.ТипСообщения = "INVOIC" И Сообщение.Исправление = Истина) Тогда
		
		ТипДокументаСчетФактура = ПолучитьТипЗначенияОбъекта("ТипДокументаСчетФактура");
		
		Если ЗначениеЗаполнено(ТипДокументаСчетФактура) И ТипЗнч(Сообщение.Документ1С) = Тип(ТипДокументаСчетФактура) Тогда 
			ДокументСодержащийКоды = ПолучитьКорректировкуРеализацииСчетаФактуры(Сообщение.Документ1С);
		Иначе
			ДокументСодержащийКоды = Сообщение.Документ1С;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокументСодержащийКоды) Тогда
		ДокументСодержащийКоды = Сообщение.Накладная1С;
	КонецЕсли;	
	
	Возврат ДокументСодержащийКоды;
	
КонецФункции

Функция ПодготовитьПараметрыПодбораКодовМаркировки(Сообщение, ОшибкиЗаполнения = Неопределено)
	
	ПараметрыПодбораКодов = Новый Структура;
	ПараметрыПодбораКодов.Вставить("СоответствиеВидовКодовМаркировки"	, СоответствиеВидовКодовМаркировки());
	ПараметрыПодбораКодов.Вставить("РазвернутаяТаблицаКодовМаркировки"	, ИнициализироватьРазвернутуюТаблицуКодовМаркировки());
	ПараметрыПодбораКодов.Вставить("ИменаПолейКодовМаркировки"			, ПеречисленияEDI_ИменаПолейКодовМаркировки());
	
	СтандартнаяОбработкаEDI = Истина;
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("Сообщение", Сообщение);
	ПараметрыПМ.Вставить("НастройкиМаркировкиТоваров", НастройкиМаркировкиТоваров());
	ПараметрыПМ.Вставить("ПараметрыПодбораКодов", ПараметрыПодбораКодов);
	
	ОбработкаСобытияПодключаемогоМодуля("ПередПодготовкойПараметровПодбораКодовМаркировки", СтандартнаяОбработкаEDI, ПараметрыПМ);
	
	Если СтандартнаяОбработкаEDI = Истина Тогда
		
		ДокументСодержащийКоды = ОпределитьДокументСодержащийКодыМаркировки(Сообщение);
		
		Попытка 
			
			ПараметрыПодбораКодов.РазвернутаяТаблицаКодовМаркировки = РазвернутаяТаблицаКодовМаркировки_1С(ДокументСодержащийКоды, Сообщение, ОшибкиЗаполнения);	
			
		Исключение
			ОписаниеОшибки = "Не удалось получить коды маркировки из документа " + ДокументСодержащийКоды + " - " + ОписаниеОшибки();
			ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ОписаниеОшибки, ДокументСодержащийКоды);
			
			Метрика_Переменные = Неопределено;
			Метрика_ОтправитьСразу = Истина;
			Метрика_Ошибка("ДополнитьСообщениеКодамиМаркировки", ОписаниеОшибки, ИнформацияОбОшибке(), Метрика_Переменные, Метрика_ОтправитьСразу);
			
			Возврат Неопределено;
		КонецПопытки;
		
	КонецЕсли;
	
	Если ОшибкиЗаполнения <> Неопределено И ОшибкиЗаполнения.Количество() Тогда
		
		ИсточникиОшибокМаркировки = ПеречисленияEDI_ИсточникиОшибокМаркировки();
		Для Каждого ТекущаяОшибка Из ОшибкиЗаполнения Цикл
			
			ТекстОшибки = КонтурСтандарт_СтрШаблон_("%1: %2", ТекущаяОшибка.ИсточникОшибки, ТекущаяОшибка.ТекстОшибки);
			
			ИмяПоля = "";
			Если ТекущаяОшибка.ИсточникОшибки = ИсточникиОшибокМаркировки.КонтурМаркировка Тогда  
				ИмяПоля = "ДокументУчетаМаркировка";
			КонецЕсли;
			
			ОписаниеОшибкиПодготовки = НовыйОписаниеОшибкиПодготовкиСообщенияEDI();
			ОписаниеОшибкиПодготовки.ИмяПоля = ИмяПоля;
			ОписаниеОшибкиПодготовки.СведенияОбОшибках = ТекстОшибки;
			ОписаниеОшибкиПодготовки.ИсточникОшибки = "ПодготовитьПараметрыПодбораКодовМаркировки";
			ОписаниеОшибкиПодготовки.СодержитОписаниеПоля = Истина;
			
			Сообщение.ОшибкиПодготовки.Добавить(ОписаниеОшибкиПодготовки);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ПараметрыПодбораКодов;
	
КонецФункции

Процедура РаспределитьКодыМаркировкиПоСообщению(Сообщение, ПараметрыПодбораКодов, ЭтоКорректировка = Ложь)
	
	Если Не ТипЗнч(ПараметрыПодбораКодов) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	РазвернутаяТаблицаКодовМаркировки = ПараметрыПодбораКодов.РазвернутаяТаблицаКодовМаркировки;
	
	Если РазвернутаяТаблицаКодовМаркировки.Колонки.Найти("ИндексСтроки") <> Неопределено Тогда
		ЗаполнитьКодыМаркировкиВСообщении_КонтурМаркировка32(Сообщение, ПараметрыПодбораКодов, ЭтоКорректировка);	
	Иначе
		РаспределитьКодыМаркировкиВСообщении_РазвернутаяТаблица(Сообщение, ПараметрыПодбораКодов, ЭтоКорректировка);
	КонецЕсли;              

КонецПроцедуры

Функция ОпределитьЗаполняемыеПоляКодовМаркировкиВСообщении(ПараметрыПодбораКодов, ЭтоКорректировка)
	
	ИменаПолейКодовМаркировки = ПараметрыПодбораКодов.ИменаПолейКодовМаркировки;	
	ТипыИзмененияСтроки = ПеречисленияEDI_ТипыИзмененияСтрокиУКД();
	
	ЗаполняемыеПоляКодовМаркировки = Новый Соответствие;	
	
	Если НЕ ЭтоКорректировка Тогда
		
		ЗаполняемыеПоляКодовМаркировки.Вставить(ИменаПолейКодовМаркировки.КодыМаркировки);		
		
		Возврат ЗаполняемыеПоляКодовМаркировки;
		
	КонецЕсли;
	
	РазвернутаяТаблицаКодовМаркировки = ПараметрыПодбораКодов.РазвернутаяТаблицаКодовМаркировки;
	КолонкиТаблицыКодовМаркировки = РазвернутаяТаблицаКодовМаркировки.Колонки;
	
	ЕстьТипИзмененияПоСтроке = КолонкиТаблицыКодовМаркировки.Найти("ТипИзменения") <> Неопределено 
								И РазвернутаяТаблицаКодовМаркировки.Количество()
								И ЗначениеЗаполнено(РазвернутаяТаблицаКодовМаркировки[0].ТипИзменения);
								
	Если ЕстьТипИзмененияПоСтроке Тогда
		
		ЗаполняемыеПоляКодовМаркировки.Вставить(ИменаПолейКодовМаркировки.КодыМаркировкиДо		, ТипыИзмененияСтроки.До);
		ЗаполняемыеПоляКодовМаркировки.Вставить(ИменаПолейКодовМаркировки.КодыМаркировкиПосле	, ТипыИзмененияСтроки.После);
		
	Иначе
		
		ЗаполняемыеПоляКодовМаркировки.Вставить(ИменаПолейКодовМаркировки.КодыМаркировкиПосле);
				
	КонецЕсли;
			
	Возврат ЗаполняемыеПоляКодовМаркировки;
	
КонецФункции

Процедура ЗаполнитьКодыМаркировкиПоИмениПоля_КонтурМаркировка32(ТоварыСообщения, ПараметрыПодбораКодов, ИмяПоляКодовМаркировки, ТипИзмененияСтроки)
	
	РазвернутаяТаблицаКодовМаркировки = ПараметрыПодбораКодов.РазвернутаяТаблицаКодовМаркировки;
	СоответствиеВидовКодовМаркировки = ПараметрыПодбораКодов.СоответствиеВидовКодовМаркировки;
					
	Для Каждого СтрокаТоваров Из ТоварыСообщения Цикл
		
		СтрокаТоваров[ИмяПоляКодовМаркировки].Очистить();
		
		ПараметрыОтбора = Новый Структура("ИндексСтроки", СтрокаТоваров.НомерСтроки);
		
		Если ЗначениеЗаполнено(ТипИзмененияСтроки) Тогда
			ПараметрыОтбора.Вставить("ТипИзменения", ТипИзмененияСтроки);	
		КонецЕсли;
		
		НайденныеСтроки = РазвернутаяТаблицаКодовМаркировки.НайтиСтроки(ПараметрыОтбора);
		
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл 
			
			Для Каждого СтрокаКодаМаркировки Из НайденнаяСтрока.СведенияОМаркировке Цикл
								
				ВидКодаМаркировкиEDI = СоответствиеВидовКодовМаркировки[СтрокаКодаМаркировки.ВидУпаковки]; 
				
				Если ВидКодаМаркировкиEDI = "Транспортный" 
					И СтрокаТоваров[ИмяПоляКодовМаркировки].НайтиПоЗначению(СтрокаКодаМаркировки.ЗначениеШтрихкода) <> Неопределено Тогда
					Продолжить;	
				КонецЕсли;
				
				СтрокаТоваров[ИмяПоляКодовМаркировки].Добавить(СтрокаКодаМаркировки.ЗначениеШтрихкода, ВидКодаМаркировкиEDI);	
				
			КонецЦикла; 
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКодыМаркировкиВСообщении_КонтурМаркировка32(Сообщение, ПараметрыПодбораКодов, ЭтоКорректировка = Ложь)
	
	ЗаполняемыеПоляКодовМаркировки = ОпределитьЗаполняемыеПоляКодовМаркировкиВСообщении(ПараметрыПодбораКодов, ЭтоКорректировка);
	
	Для Каждого ЗаполняемоеПоле Из ЗаполняемыеПоляКодовМаркировки Цикл
		
		ИмяПоляКодовМаркировки = ЗаполняемоеПоле.Ключ;
		ТипИзмененияСтроки = ЗаполняемоеПоле.Значение;
				
		ЗаполнитьКодыМаркировкиПоИмениПоля_КонтурМаркировка32(Сообщение.Товары, ПараметрыПодбораКодов, ИмяПоляКодовМаркировки, ТипИзмененияСтроки);
		
	КонецЦикла;	

КонецПроцедуры

Процедура РаспределитьКодыМаркировкиВСообщении_РазвернутаяТаблица(Сообщение, ПараметрыПодбораКодов, ЭтоКорректировка = Ложь)
	
	РазвернутаяТаблицаКодовМаркировки = ПараметрыПодбораКодов.РазвернутаяТаблицаКодовМаркировки;
	СоответствиеВидовКодовМаркировки = ПараметрыПодбораКодов.СоответствиеВидовКодовМаркировки;
	
	Если НЕ РазвернутаяТаблицаКодовМаркировки.Количество() Тогда
		Возврат;
	КонецЕсли;

	Если ЭтоКорректировка Тогда		
		ИмяПоляКодовМаркировки = "КодыМаркировкиПосле";
		ИмяПоляКоличество = "КоличествоПосле";
	Иначе
		ИмяПоляКодовМаркировки = "КодыМаркировки";
		ИмяПоляКоличество = "Количество";
	КонецЕсли;
	
	ЕстьКоличествоВКодахМаркировки = (РазвернутаяТаблицаКодовМаркировки[0].Количество <> Неопределено);
	
	ТоварыСообщения = Сообщение.Товары;
	ТоварыСообщения.Колонки.Добавить("ПолученоКоличество", ОписаниеТипаЧисло_КонтурEDI());	
	
	Для каждого СтрокаТоваров Из ТоварыСообщения Цикл
		
		СтрокаТоваров[ИмяПоляКодовМаркировки].Очистить();
		
		Если ЭтоКорректировка Тогда
			
			Для каждого КодМаркировки Из СтрокаТоваров.КодыМаркировкиДо Цикл
				
				СтрокаРазвернутойТаблицыКодов = РазвернутаяТаблицаКодовМаркировки.Найти(КодМаркировки.Значение, "ЗначениеШтрихкода");
				Если СтрокаРазвернутойТаблицыКодов = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				Если ЕстьКоличествоВКодахМаркировки Тогда
					ПолученоКоличество = СтрокаРазвернутойТаблицыКодов.Количество;
				Иначе
					ПолученоКоличество = 1;	
				КонецЕсли;

				СтрокаТоваров.ПолученоКоличество = СтрокаТоваров.ПолученоКоличество + ПолученоКоличество;
				
				СтрокаТоваров[ИмяПоляКодовМаркировки].Добавить(КодМаркировки.Значение, КодМаркировки.Представление);
				СтрокаРазвернутойТаблицыКодов.Обработан = Истина;
				
			КонецЦикла;
			
			НеобработанныеКоды = РазвернутаяТаблицаКодовМаркировки.НайтиСтроки(Новый Структура("Обработан", Ложь));
			
			Если НеобработанныеКоды.Количество() = 0 Тогда
				ТоварыСообщения.Колонки.Удалить("ПолученоКоличество");
				Возврат;
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЦикла;
		
	ТоварыСообщения.Сортировать(ИмяПоляКоличество + " Убыв");
	РазвернутаяТаблицаКодовМаркировки.Сортировать("Количество Убыв");	
	
	Для Каждого СтрокаТоваров Из ТоварыСообщения Цикл
		
		КоличествоОсталось = СтрокаТоваров[ИмяПоляКоличество] / КоэффициентEDIВ1С_Расчетный_КонтурEDI("В1С", СтрокаТоваров.КоэффициентEDIВ1С) - СтрокаТоваров.ПолученоКоличество;
		
		Если КоличествоОсталось <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиКодовМаркировки = ПодобратьКодыМаркировкиПоСтрокеТоваров(РазвернутаяТаблицаКодовМаркировки,
																		СтрокаТоваров,
																		КоличествоОсталось);
		ТранспортныеКоды = Новый Соответствие; 
		
		Для каждого СтрокаКодаМаркировки Из СтрокиКодовМаркировки Цикл
			
			ЗначениеШтрихкода = СтрокаКодаМаркировки.ЗначениеШтрихкода;
			
			ВидКодаМаркировкиEDI = СоответствиеВидовКодовМаркировки[СтрокаКодаМаркировки.ВидУпаковки];
			
			Если ВидКодаМаркировкиEDI = "Транспортный" Тогда
				Если ТранспортныеКоды[ЗначениеШтрихкода] = Истина Тогда
					Продолжить;
				Иначе				
					ТранспортныеКоды.Вставить(ЗначениеШтрихкода, Истина);
				КонецЕсли;
			КонецЕсли;
			
			СтрокаТоваров[ИмяПоляКодовМаркировки].Добавить(СтрокаКодаМаркировки.ЗначениеШтрихкода, ВидКодаМаркировкиEDI);
			
		КонецЦикла;
		
	КонецЦикла;
	
	ТоварыСообщения.Сортировать("НомерСтроки");
	ТоварыСообщения.Колонки.Удалить("ПолученоКоличество");

КонецПроцедуры

Функция ПодобратьКодыМаркировкиПоСтрокеТоваров(ТаблицаКодовМаркировки, СтрокаТаблицыТоваров, Знач ТребуемоеКоличество)
	
	СтрокиТаблицыКодовМаркировки = Новый Массив;	
	
	Если ТаблицаКодовМаркировки.Количество() = 0 Тогда
		Возврат СтрокиТаблицыКодовМаркировки;
	КонецЕсли;
	
	ЕстьКоличествоВКодахМаркировки = (ТаблицаКодовМаркировки[0].Количество <> Неопределено);
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Обработан");
	СтруктураПоиска.Вставить("Номенклатура");
	СтруктураПоиска.Вставить("Серия");
	СтруктураПоиска.Вставить("Характеристика");		
	
	ВариантыПоиска = Новый Массив;
	
	Если ЕстьКоличествоВКодахМаркировки Тогда
		
		СтруктураПоиска.Вставить("Количество");
		
		ВариантыПоиска.Добавить("Обработан,Номенклатура,Характеристика,Серия,Количество");
		ВариантыПоиска.Добавить("Обработан,Номенклатура,Характеристика,Количество");
		ВариантыПоиска.Добавить("Обработан,Номенклатура,Количество");
		
	КонецЕсли;  
	
	ВариантыПоиска.Добавить("Обработан,Номенклатура,Характеристика,Серия");
	ВариантыПоиска.Добавить("Обработан,Номенклатура,Характеристика");
	ВариантыПоиска.Добавить("Обработан,Номенклатура");
	
	Для Каждого СтрокаИсходногоТовара Из СтрокаТаблицыТоваров.ИсходныеСтрокиТовара Цикл
		
		СтруктураПоиска.Обработан = Ложь;
		СтруктураПоиска.Номенклатура = СтрокаИсходногоТовара.Номенклатура;
		СтруктураПоиска.Серия = СтрокаИсходногоТовара.Серия;
		СтруктураПоиска.Характеристика = СтрокаИсходногоТовара.Характеристика;
		
		Если ЕстьКоличествоВКодахМаркировки Тогда
			СтруктураПоиска.Количество = СтрокаИсходногоТовара.Количество;		
		КонецЕсли;	
		
		СтрокиКодовМаркировкиНоменклатуры = НайтиСтрокиВТаблицеПоВариантамПоиска(ТаблицаКодовМаркировки, СтруктураПоиска, ВариантыПоиска);
		
		Для Каждого НайденнаяСтрока Из СтрокиКодовМаркировкиНоменклатуры Цикл
			
			Если ТребуемоеКоличество <= 0 Тогда
				Возврат СтрокиТаблицыКодовМаркировки;
			КонецЕсли;
			
			НайденнаяСтрока.Обработан = Истина;
			СтрокиТаблицыКодовМаркировки.Добавить(НайденнаяСтрока);
			
			Если ЕстьКоличествоВКодахМаркировки Тогда
				НайденнаяСтрокаКоличество = НайденнаяСтрока.Количество; 
			Иначе
				НайденнаяСтрокаКоличество = 1;
			КонецЕсли;
			
			ТребуемоеКоличество = ТребуемоеКоличество - НайденнаяСтрокаКоличество;
			
		КонецЦикла;	
		
	КонецЦикла; 
	
	Если ТребуемоеКоличество > 0 Тогда
		
		Если ЗначениеЗаполнено(СтрокаТаблицыТоваров.СписокНоменклатуры) Тогда		
			СписокНоменклатуры = СтрокаТаблицыТоваров.СписокНоменклатуры;     
		Иначе
			СписокНоменклатуры = Новый СписокЗначений;
			СписокНоменклатуры.Добавить(СтрокаТаблицыТоваров.Номенклатура);
		КонецЕсли;
		
		Для Каждого ЭлементСписка Из СписокНоменклатуры Цикл
			
			СтруктураПоиска.Обработан = Ложь;
			СтруктураПоиска.Номенклатура = ЭлементСписка.Значение;
			СтруктураПоиска.Серия = СтрокаТаблицыТоваров.СерияНоменклатуры;
			СтруктураПоиска.Характеристика = СтрокаТаблицыТоваров.ХарактеристикаНоменклатуры;
			
			СтрокиКодовМаркировкиНоменклатуры = НайтиСтрокиВТаблицеПоВариантамПоиска(ТаблицаКодовМаркировки, СтруктураПоиска, ВариантыПоиска);
			
			Для Каждого НайденнаяСтрока Из СтрокиКодовМаркировкиНоменклатуры Цикл
				
				Если ТребуемоеКоличество <= 0 Тогда
					Возврат СтрокиТаблицыКодовМаркировки;
				КонецЕсли;
				
				НайденнаяСтрока.Обработан = Истина;
				СтрокиТаблицыКодовМаркировки.Добавить(НайденнаяСтрока);
				
				Если ЕстьКоличествоВКодахМаркировки Тогда
					НайденнаяСтрокаКоличество = НайденнаяСтрока.Количество; 
				Иначе
					НайденнаяСтрокаКоличество = 1;
				КонецЕсли;
				
				ТребуемоеКоличество = ТребуемоеКоличество - НайденнаяСтрокаКоличество;
				
			КонецЦикла;	
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат СтрокиТаблицыКодовМаркировки;
	
КонецФункции

Функция СоответствиеВидовКодовМаркировки() Экспорт
	
	СоответствиеВидовКодовМаркировки = ЭДО_Кэш_Прочитать("СоответствиеВидовКодовМаркировки");
	Если Не СоответствиеВидовКодовМаркировки = Неопределено Тогда
		Возврат СоответствиеВидовКодовМаркировки;
	КонецЕсли;
	
	СоответствиеВидовКодовМаркировки = Новый Соответствие;
	
	ДополнитьСоответствиеВидовКодовМаркировкиЗначениямиПеречисления(СоответствиеВидовКодовМаркировки, "КонтурМаркировка_ВидыУпаковок");
	ДополнитьСоответствиеВидовКодовМаркировкиЗначениямиПеречисления(СоответствиеВидовКодовМаркировки, "ВидыУпаковокИС");
	
	ЭДО_Кэш_Поместить("СоответствиеВидовКодовМаркировки", СоответствиеВидовКодовМаркировки);
	
	Возврат СоответствиеВидовКодовМаркировки;
	
КонецФункции

Процедура ДополнитьСоответствиеВидовКодовМаркировкиЗначениямиПеречисления(СоответствиеВидовКодовМаркировки, ИмяПеречисления)
	
	Если Не ПеременнаяСодержитСвойство(Перечисления, ИмяПеречисления) Тогда
		Возврат;
	КонецЕсли;
	
	Перечисление = Перечисления[ИмяПеречисления];                            
	
	СоответствиеВидовКодовМаркировки.Вставить(Перечисление.Логистическая, "Транспортный"); 	
	СоответствиеВидовКодовМаркировки.Вставить(Перечисление.Групповая, "Групповой");
	СоответствиеВидовКодовМаркировки.Вставить(Перечисление.Потребительская, "Индивидуальный");
		
КонецПроцедуры

// Возвращает таблицу транспортных и индивидуальных штрихкодов развернутых до номенклатуры, характеристики, серии
// для дальнейшего сопоставления информации с товарной частью
//
// Параметры:
//  Документ1С	 - ДокументСсылка - документ 1С владелец кодов маркировки
//  Сообщение 	 - Структура	  - структура сообщения edi
// 
// Возвращаемое значение:
// ТаблицаЗначений - таблица упаковок с товарными данными:
// 	 * Ссылка             - Произвольный - объект-владелец штрихкода - исходная колонка
// 	 * Штрихкод           - СправочникСсылка - ссылка на индивидуальный штрихкод содержимого или мультитоварную упаковку
// 	 * Номенклатура       - СправочникСсылка - ссылка на элемент справочника номенклатуры
// 	 * Характеристика     - СправочникСсылка - характеристика номенклатуры
// 	 * Серия              - СправочникСсылка - серия номенклатуры
// 	 * ЗначениеШтрихкода  - Строка - текстовое представление исходного штрихкода для передачи в ЭДО
// 	 * Мультитоварная     - Булево - признак мультитоварной упаковки
// 	 * ВидПродукции       - ПеречислениеСсылка - вид продукции номенклатуры для кодировки значения штрихкода
// 	 * ВидУпаковки        - ПеречислениеСсылка - вид упаковки номенклатуры для кодировки значения штрихкода
// 	 * Обработан          - Булево - признак сопоставления строки товарной части документа
Функция РазвернутаяТаблицаКодовМаркировки_1С(Документ1С, Сообщение = Неопределено, ОшибкиЗаполнения = Неопределено) Экспорт
	
	КодыЗаполнены = Ложь;
	РазвернутаяТаблицаКодовМаркировки = РазвернутаяТаблицаКодовМаркировки_КонтурМаркировка(Документ1С, Сообщение, КодыЗаполнены, ОшибкиЗаполнения);
	
	Если НЕ КодыЗаполнены Тогда
		РазвернутаяТаблицаКодовМаркировки = РазвернутаяТаблицаКодовМаркировки_ИСМП(Документ1С); 		
	КонецЕсли;
	
	Возврат РазвернутаяТаблицаКодовМаркировки;
	
КонецФункции

Функция РазвернутаяТаблицаКодовМаркировки_КонтурМаркировка(Документ1С, Сообщение = Неопределено, КодыЗаполнены = Ложь, ОшибкиЗаполнения = Неопределено)
	
	НастройкиМаркировкиТоваров = НастройкиМаркировкиТоваров();
	МодульКонтурМаркировка 	   = НастройкиМаркировкиТоваров.МодульКонтурМаркировка; 
	ВерсияКонтурМаркировка     = НастройкиМаркировкиТоваров.ВерсияКонтурМаркировка;
	
	Если НЕ МодульКонтурМаркировка = Неопределено Тогда	

		// новый метод ЗаполнитьСведенияОМаркировке (Контур.Маркировка > 3.2.1)  
		Если ЗначениеЗаполнено(Сообщение)
			И КонтурСтандарт_СравнитьВерсии(ВерсияКонтурМаркировка, "3.2.1") >= 0 Тогда
						
			РазвернутаяТаблицаКодовМаркировки = ИнициализироватьРазвернутуюТаблицуКодовМаркировки32(ВерсияКонтурМаркировка);	
			
			ЗаполнитьРазвернутуюТаблицуКодовМаркировки(РазвернутаяТаблицаКодовМаркировки, Сообщение, Документ1С);
			
			КонтурМаркировка_ЗаполнитьСведенияОМаркировке(РазвернутаяТаблицаКодовМаркировки, ОшибкиЗаполнения);
			
			КоличествоКодовМаркировки = 0;
			
			Для Каждого ТекСтрока Из РазвернутаяТаблицаКодовМаркировки Цикл
				
				КоличествоКодовМаркировки = КоличествоКодовМаркировки + ТекСтрока.СведенияОМаркировке.Количество(); 
				
			КонецЦикла;
			
			КодыЗаполнены = КоличествоКодовМаркировки > 0 ИЛИ ОшибкиЗаполнения.Количество() > 0;
			
		Иначе        
			// получаем коды маркировки старым методом
			РазвернутаяТаблицаКодовМаркировки = ИнициализироватьРазвернутуюТаблицуКодовМаркировки();
			
			МассивДокументов = КонтурСтандарт_МассивЗначений(Документ1С);	
			ТаблицаКодовМаркировкиИзДанных = МодульКонтурМаркировка.РазвернутаяТаблицаУпаковок(МассивДокументов, ОшибкиЗаполнения);
			
			КоличествоКодовМаркировки = ТаблицаКодовМаркировкиИзДанных.Количество();
			КодыЗаполнены = (КоличествоКодовМаркировки > 0);
			
			Для каждого СтрокаКодаИзДанныхБазы Из ТаблицаКодовМаркировкиИзДанных Цикл
				
				СтрокаРезультат = РазвернутаяТаблицаКодовМаркировки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаРезультат, СтрокаКодаИзДанныхБазы);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(ОшибкиЗаполнения) = Тип("Массив") Тогда 
		
		ИсточникиОшибокМаркировки = ПеречисленияEDI_ИсточникиОшибокМаркировки();
		Для Каждого ТекущаяОшибка Из ОшибкиЗаполнения Цикл	
			ТекущаяОшибка.Вставить("ИсточникОшибки", ИсточникиОшибокМаркировки.КонтурМаркировка);
		КонецЦикла; 
		
	КонецЕсли;
	
	Возврат РазвернутаяТаблицаКодовМаркировки;

КонецФункции

Функция РазвернутаяТаблицаКодовМаркировки_ИСМП(Документ1С)
	
	РазвернутаяТаблицаКодовМаркировки = ИнициализироватьРазвернутуюТаблицуКодовМаркировки();
	
	НастройкиМаркировкиТоваров = НастройкиМаркировкиТоваров();
	МодульГосИС 			   = НастройкиМаркировкиТоваров.МодульГосИС; 
	
	Если Не МодульГосИС = Неопределено
		И ПеременнаяСодержитСвойство(Документ1С, "ШтрихкодыУпаковок") Тогда
		
		ТаблицаУпаковок = ПолучитьТаблицуШтрихкодовУпаковок(Документ1С);
				
		Если ЗначениеЗаполнено(ТаблицаУпаковок) Тогда 
			
			ТаблицаКодовМаркировкиИзДанных = МодульГосИС.ЧастичноеСодержимое(ТаблицаУпаковок);
			
			Для каждого СтрокаКодаИзДанныхБазы Из ТаблицаКодовМаркировкиИзДанных Цикл
				
				СтрокаРезультат = РазвернутаяТаблицаКодовМаркировки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаРезультат, СтрокаКодаИзДанныхБазы);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;

    Возврат РазвернутаяТаблицаКодовМаркировки; 
	
КонецФункции

Функция НовыйПараметрыЗаполненияРазвернутойТаблицыКодовМаркировки32()
	
	ПараметрыЗаполнения = Новый Структура;
		
	ПараметрыЗаполнения.Вставить("ИндексСтроки"				, Неопределено);
	ПараметрыЗаполнения.Вставить("Номенклатура"				, Неопределено);
	ПараметрыЗаполнения.Вставить("Характеристика"			, Неопределено);
	ПараметрыЗаполнения.Вставить("Серия"					, Неопределено);
	ПараметрыЗаполнения.Вставить("Упаковка"					, Неопределено);
	ПараметрыЗаполнения.Вставить("Количество"				, Неопределено);
	ПараметрыЗаполнения.Вставить("Коэффициент"				, Неопределено);
	ПараметрыЗаполнения.Вставить("ТипИзменения"				, Неопределено);
	ПараметрыЗаполнения.Вставить("ТипыИзмененияСтроки"		, Неопределено);
	ПараметрыЗаполнения.Вставить("ЕстьКолонкаТипИзменения"	, Ложь);
	
	Возврат ПараметрыЗаполнения;
	
КонецФункции

Функция ОтправлятьИзмененныеКодыМаркировкиВCOINVOIC(Сообщение)
	
	Возврат Сообщение.ТипСообщения = "COINVOIC"
			И ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, "ОтправлятьИзмененныеКодыМаркировкиВCOINVOIC") = Истина;
	
КонецФункции

Функция ОпределитьЗначениеТипаИзменения_КонтурМаркировка32(Параметры)
	
	Перем ТипИзменения;
	
	Если НЕ Параметры.ЕстьКолонкаТипИзменения Тогда
		Возврат ТипИзменения;	
	КонецЕсли;
	
	Если НужноДобавитьСтрокуСКоличествоДо(Параметры) Тогда
		ТипИзменения = Параметры.ТипыИзмененияСтроки.До;	
	Иначе
		ТипИзменения = Параметры.ТипыИзмененияСтроки.После;
	КонецЕсли;
	
	Возврат ТипИзменения;
	
КонецФункции

Функция НужноДобавитьСтрокуСКоличествоДо(Параметры)

	Возврат Параметры.ТипИзменения = Параметры.ТипыИзмененияСтроки.После;	

КонецФункции

Процедура ЗаполнитьРазвернутуюТаблицуКодовМаркировки(РазвернутаяТаблицаКодовМаркировки, Сообщение, Документ1С)
	
	ПараметрыЗаполнения = НовыйПараметрыЗаполненияРазвернутойТаблицыКодовМаркировки32();
	
	ПараметрыЗаполнения.ТипыИзмененияСтроки	= ПеречисленияEDI_ТипыИзмененияСтрокиУКД();
	ПараметрыЗаполнения.ЕстьКолонкаТипИзменения = РазвернутаяТаблицаКодовМаркировки.Колонки.Найти("ТипИзменения") <> Неопределено;
	
	Если ПараметрыЗаполнения.ЕстьКолонкаТипИзменения
		И НЕ ОтправлятьИзмененныеКодыМаркировкиВCOINVOIC(Сообщение) Тогда
		
		РазвернутаяТаблицаКодовМаркировки.Колонки.Удалить("ТипИзменения");
		ПараметрыЗаполнения.ЕстьКолонкаТипИзменения = Ложь;
		
	КонецЕсли;
	
	Для Каждого СтрокаТоваров Из Сообщение.Товары Цикл
		
		ИсходныеСтрокиТовара = СтрокаТоваров.ИсходныеСтрокиТовара;
		
		Если ТипЗнч(ИсходныеСтрокиТовара) = Тип("Массив") И ИсходныеСтрокиТовара.Количество() Тогда		
						
			Для Каждого ИсходнаяСтрока Из ИсходныеСтрокиТовара Цикл
				
				ПараметрыЗаполнения.ИндексСтроки 	= СтрокаТоваров.НомерСтроки;
				ПараметрыЗаполнения.Номенклатура 	= ИсходнаяСтрока.Номенклатура;	
				ПараметрыЗаполнения.Характеристика 	= ИсходнаяСтрока.Характеристика;
				ПараметрыЗаполнения.Серия 			= ИсходнаяСтрока.Серия;
				ПараметрыЗаполнения.Упаковка 		= ИсходнаяСтрока.Упаковка;				
				ПараметрыЗаполнения.Количество 		= ИсходнаяСтрока.Количество;				
				
				ПараметрыЗаполнения.ТипИзменения = ОпределитьЗначениеТипаИзменения_КонтурМаркировка32(ПараметрыЗаполнения);	
								
				НоваяСтрока = РазвернутаяТаблицаКодовМаркировки.Добавить();
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ПараметрыЗаполнения);
			
				Если НЕ НужноДобавитьСтрокуСКоличествоДо(ПараметрыЗаполнения) Тогда
					Продолжить;
				КонецЕсли;					
				
				ПараметрыЗаполнения.ТипИзменения	= ОпределитьЗначениеТипаИзменения_КонтурМаркировка32(ПараметрыЗаполнения);
				ПараметрыЗаполнения.Количество		= ИсходнаяСтрока.КоличествоДо;
					
				НоваяСтрока = РазвернутаяТаблицаКодовМаркировки.Добавить();
					
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ПараметрыЗаполнения);
					
			КонецЦикла;
			
		Иначе
			
			ПараметрыЗаполнения.ИндексСтроки 	= СтрокаТоваров.НомерСтроки;
			ПараметрыЗаполнения.Номенклатура 	= СтрокаТоваров.Номенклатура;			
			ПараметрыЗаполнения.Характеристика 	= СтрокаТоваров.ХарактеристикаНоменклатуры;
			ПараметрыЗаполнения.Серия 			= СтрокаТоваров.СерияНоменклатуры;
			ПараметрыЗаполнения.Упаковка 		= СтрокаТоваров.ЕдиницаИзмерения;
			ПараметрыЗаполнения.Коэффициент		= КоэффициентEDIВ1С_Расчетный_КонтурEDI("В1С", СтрокаТоваров.КоэффициентEDIВ1С);
			
			Если НЕ Сообщение.Товары.Колонки.Найти("КоличествоПосле") = Неопределено Тогда
				ИмяПоляКоличество = "КоличествоПосле"; 
			Иначе
				ИмяПоляКоличество = "Количество";				
			КонецЕсли;
					
			ПараметрыЗаполнения.Количество = СтрокаТоваров[ИмяПоляКоличество] / ПараметрыЗаполнения.Коэффициент;
			
			ПараметрыЗаполнения.ТипИзменения = ОпределитьЗначениеТипаИзменения_КонтурМаркировка32(ПараметрыЗаполнения);
			
			НоваяСтрока = РазвернутаяТаблицаКодовМаркировки.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ПараметрыЗаполнения);
									
			Если НЕ НужноДобавитьСтрокуСКоличествоДо(ПараметрыЗаполнения) Тогда
				Продолжить;
			КонецЕсли;
							
			ПараметрыЗаполнения.ТипИзменения	= ОпределитьЗначениеТипаИзменения_КонтурМаркировка32(ПараметрыЗаполнения);
			ПараметрыЗаполнения.Количество		= СтрокаТоваров.КоличествоДо / ПараметрыЗаполнения.Коэффициент;
				
			НоваяСтрока = РазвернутаяТаблицаКодовМаркировки.Добавить();
				
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ПараметрыЗаполнения);
				
		КонецЕсли; 
		
	КонецЦикла;
	
	РазвернутаяТаблицаКодовМаркировки.ЗаполнитьЗначения(Документ1С, "ПервичныйДокумент");
	
КонецПроцедуры

Функция ИнициализироватьРазвернутуюТаблицуКодовМаркировки32(ВерсияКонтурМаркировка = Неопределено) Экспорт
	
	ТаблицаКодовМаркировки = Новый ТаблицаЗначений; 
	
	ТаблицаКодовМаркировки.Колонки.Добавить("ИндексСтроки");
	ТаблицаКодовМаркировки.Колонки.Добавить("Количество");
	ТаблицаКодовМаркировки.Колонки.Добавить("Характеристика");
	ТаблицаКодовМаркировки.Колонки.Добавить("Серия");
	ТаблицаКодовМаркировки.Колонки.Добавить("Упаковка");
	ТаблицаКодовМаркировки.Колонки.Добавить("Номенклатура");
	ТаблицаКодовМаркировки.Колонки.Добавить("ПервичныйДокумент");
	ТаблицаКодовМаркировки.Колонки.Добавить("СведенияОМаркировке");
	ТаблицаКодовМаркировки.Колонки.Добавить("КодТоварнойГруппы");
	
	Если КонтурСтандарт_СравнитьВерсии(ВерсияКонтурМаркировка, "3.15.0") >= 0 Тогда
		ТаблицаКодовМаркировки.Колонки.Добавить("ТипИзменения");
	КонецЕсли;
	
	Возврат ТаблицаКодовМаркировки;
	
КонецФункции

Функция ИнициализироватьРазвернутуюТаблицуКодовМаркировки() Экспорт
	
	ТаблицаКодовМаркировки = Новый ТаблицаЗначений;
	ТаблицаКодовМаркировки.Колонки.Добавить("Обработан");
	ТаблицаКодовМаркировки.Колонки.Добавить("Номенклатура");
	ТаблицаКодовМаркировки.Колонки.Добавить("Характеристика");
	ТаблицаКодовМаркировки.Колонки.Добавить("Серия");
	ТаблицаКодовМаркировки.Колонки.Добавить("ВидУпаковки");
	ТаблицаКодовМаркировки.Колонки.Добавить("ЗначениеШтрихкода");
	ТаблицаКодовМаркировки.Колонки.Добавить("Ссылка");
	ТаблицаКодовМаркировки.Колонки.Добавить("Штрихкод");
	ТаблицаКодовМаркировки.Колонки.Добавить("Мультитоварная");
	ТаблицаКодовМаркировки.Колонки.Добавить("ВидПродукции");
	ТаблицаКодовМаркировки.Колонки.Добавить("Количество");
	ТаблицаКодовМаркировки.Колонки.Добавить("КоличествоПотребительскихУпаковок");
	
	ТаблицаКодовМаркировки.Индексы.Добавить("Номенклатура");
	ТаблицаКодовМаркировки.Индексы.Добавить("Характеристика");
	ТаблицаКодовМаркировки.Индексы.Добавить("Серия");
	
	Возврат ТаблицаКодовМаркировки;
	
КонецФункции

Функция ИнициализироватьТаблицуКодовМаркировки_КонтурEDI() Экспорт
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	
	МассивКолонок = Новый Массив;
	МассивКолонок.Добавить("НомерСтроки");
	МассивКолонок.Добавить("Наименование");
	МассивКолонок.Добавить("Номенклатура");
	МассивКолонок.Добавить("Артикул");
	МассивКолонок.Добавить("ХарактеристикаНоменклатуры");
	МассивКолонок.Добавить("ЕдиницаИзмерения");
	МассивКолонок.Добавить("СерияНоменклатуры");
	МассивКолонок.Добавить("Код");
	МассивКолонок.Добавить("Вид");
	МассивКолонок.Добавить("НомерУпаковки");
	МассивКолонок.Добавить("СоставУпаковки");
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаЗначений, МассивКолонок);
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаЗначений, "Обработан", Новый ОписаниеТипов("Булево"));
	
	Возврат ТаблицаЗначений;
	
КонецФункции

Функция ПолучитьТаблицуШтрихкодовУпаковок(Документ1С)
	
	Если ПеременнаяСодержитСвойство(Документ1С, "ШтрихкодыУпаковок") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	ШтрихкодыУпаковок.Ссылка КАК Ссылка,
		               |	ШтрихкодыУпаковок.ШтрихкодУпаковки КАК Штрихкод
		               |ИЗ
		               |	&МетаданныеТаблицыУпаковок КАК ШтрихкодыУпаковок
		               |ГДЕ
		               |	ШтрихкодыУпаковок.Ссылка = &Документ1С";
				
		Запрос.Текст = СтрЗаменить(Запрос.Текст, 
								   "&МетаданныеТаблицыУпаковок",
								   Документ1С.Метаданные().ПолноеИмя() + ".ШтрихкодыУпаковок");
		Запрос.УстановитьПараметр("Документ1С", Документ1С);
			
		Результат = Запрос.Выполнить();
		Возврат Результат.Выгрузить();
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция РазвернутаяТаблицаКодовМаркировки_КонтурEDI(КоллекцияТоваров, ДеревоТранспортныхУпаковок = Неопределено, ВключатьТоварыБезКодов = Ложь, ИмяКолонкиКодов = "КодыМаркировки") Экспорт
	
	ТаблицаКодовМаркировки = ИнициализироватьТаблицуКодовМаркировки_КонтурEDI();
	
	СвойстваТовара = "НомерСтроки,Наименование,Номенклатура,ХарактеристикаНоменклатуры,ЕдиницаИзмерения,СерияНоменклатуры";
	
	Если ПеременнаяСодержитСвойство(КоллекцияТоваров,"Колонки") 
		И Не КоллекцияТоваров.Колонки.Найти("Артикул") = Неопределено Тогда
		СвойстваТовара = СвойстваТовара + ",Артикул";
	КонецЕсли;
	
	Для каждого СтрокаТовара Из КоллекцияТоваров Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаТовара[ИмяКолонкиКодов]) Тогда
			
			Если ВключатьТоварыБезКодов Тогда
				НоваяСтрока = ТаблицаКодовМаркировки.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовара, СвойстваТовара);
			КонецЕсли;
			
			Продолжить;
			
		КонецЕсли;
		
		Для каждого Элемент Из СтрокаТовара[ИмяКолонкиКодов] Цикл
		
			Код = Элемент.Значение;
			ВидКода = Элемент.Представление;
		
			НоваяСтрока = ТаблицаКодовМаркировки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовара, СвойстваТовара);

			НоваяСтрока.Код = Код;
			НоваяСтрока.Вид = ВидКода;
		
		КонецЦикла;
	
	КонецЦикла;
	
	Если ДеревоТранспортныхУпаковок = Неопределено Тогда
		Возврат ТаблицаКодовМаркировки;
	КонецЕсли;
	
	СвойстваУпаковки = "НомерУпаковки,СоставУпаковки";
	
	Для каждого СтрокаУпаковки Из ДеревоТранспортныхУпаковок.Строки Цикл
		
		Для каждого СтрокаТовараУпаковки Из СтрокаУпаковки.Строки Цикл
			
			Если НЕ ЗначениеЗаполнено(СтрокаТовараУпаковки.КодыМаркировки) Тогда
				Продолжить;
			КонецЕсли;
			
			Для каждого Элемент Из СтрокаТовараУпаковки.КодыМаркировки Цикл
			
				Код = Элемент.Значение;
				ВидКода = Элемент.Представление;
				
				НайденнаяСтрока = ТаблицаКодовМаркировки.Найти(Код, "Код");
				
				Если НайденнаяСтрока <> Неопределено Тогда
					ЗаполнитьЗначенияСвойств(НайденнаяСтрока, СтрокаУпаковки, СвойстваУпаковки);
				КонецЕсли;
			                             
			КонецЦикла;
		
		КонецЦикла;
	
	КонецЦикла;
	
	Возврат ТаблицаКодовМаркировки;
	
КонецФункции

Функция ПоместитьТаблицуКодовМаркировкиТоваровУпаковки(ТоварыСообщения, ТранспортныеУпаковки, КоллекцияТоваровУпаковки, УникальныйИдентификатор) Экспорт
	
	КоллекцияТоваров = КоллекцияТоваровРазмещенныхВУпаковке(ТоварыСообщения, КоллекцияТоваровУпаковки);
	ТаблицаКодов = РазвернутаяТаблицаКодовМаркировки_КонтурEDI(КоллекцияТоваров, ТранспортныеУпаковки);
	
	АдресВоВХ = ПоместитьВоВременноеХранилище(ТаблицаКодов, УникальныйИдентификатор);
	
	Возврат АдресВоВХ;
	
КонецФункции

Функция КоллекцияТоваровРазмещенныхВУпаковке(ТоварыСообщения, КоллекцияТоваровУпаковки) Экспорт
	
	КоллекцияТоваров = Новый Массив;
	
	Для каждого ТоварУпаковки Из КоллекцияТоваровУпаковки Цикл
	
		НоваяСтрока = ТоварыСообщения.Найти(ТоварУпаковки.НомерСтроки, "НомерСтроки");
		
		Если НЕ ЗначениеЗаполнено(НоваяСтрока) Тогда
			Продолжить;
		КонецЕсли;
		
		КоллекцияТоваров.Добавить(НоваяСтрока);
	
	КонецЦикла;
	
	Возврат КоллекцияТоваров;
	
КонецФункции

Функция КоличествоТоваровРазмещенныхВУпаковке(КоллекцияТоваровУпаковки) Экспорт
	
	ОбщееКоличество = 0;
	
	Для каждого Товар Из КоллекцияТоваровУпаковки Цикл
		ОбщееКоличество = ОбщееКоличество + Товар.Количество;
	КонецЦикла;
		
	Возврат ОбщееКоличество;
	
КонецФункции

Функция ПредставлениеКодовМаркировки(Знач КодыМаркировки) Экспорт
	
	ПредставлениеКодов = "Количество: 0";
			
	Если ЗначениеЗаполнено(КодыМаркировки) Тогда
	
		КоличествоКодов = КодыМаркировки.Количество();
		ПредставлениеКодов = "Количество: " + Строка(КоличествоКодов);
		
	КонецЕсли;
	
	Возврат ПредставлениеКодов;
	
КонецФункции

Процедура ЗаполнитьПредставлениеКодовМаркировкиТранспортныхУпаковок(ДеревоТранспортныхУпаковок, ТолькоПросмотрСообщения) Экспорт
	
	Для каждого Упаковка Из ДеревоТранспортныхУпаковок.Строки Цикл
		
		КодыУпаковки = КодыМаркировкиУпаковкиТоваров(Упаковка);
		КоличествоКодовУпаковки = КодыУпаковки.Количество();
		
		Если ЗначениеЗаполнено(КоличествоКодовУпаковки)
			ИЛИ ТолькоПросмотрСообщения = Истина Тогда
			
			ПредставлениеКодов = "Выбрано: " + Строка(КоличествоКодовУпаковки);
			
		Иначе
			
			ПредставлениеКодов = "Коды не выбраны";
			
		КонецЕсли;
		
		Упаковка.КодыМаркировкиПредставление = ПредставлениеКодов;
	
	КонецЦикла;	
	
КонецПроцедуры

Функция КодыМаркировкиУпаковкиТоваров(Упаковка) Экспорт
	
	КодыМаркировкиУпаковки = Новый СписокЗначений;
	
	Для каждого Товар Из Упаковка.Строки Цикл
		
		КодыМаркировкиТовара = Товар.КодыМаркировки;
		
		Если НЕ ЗначениеЗаполнено(КодыМаркировкиТовара) Тогда
			Продолжить;
		КонецЕсли;
		
		КодыМаркировкиУпаковки = ОбъединитьСпискиЗначений(КодыМаркировкиУпаковки, КодыМаркировкиТовара);
		
	КонецЦикла;

	Возврат КодыМаркировкиУпаковки;
	
КонецФункции

Функция ОбъединитьСпискиЗначений(Знач СписокЗначений1, Знач СписокЗначений2, ИсключитьДубли = Ложь) Экспорт
	
	СписокЗначений = Новый СписокЗначений;
	
	Для каждого Элемент Из СписокЗначений1 Цикл
		СписокЗначений.Добавить(Элемент.Значение, Элемент.Представление);
	КонецЦикла;
	
	Для каждого Элемент Из СписокЗначений2 Цикл
		
		Если ИсключитьДубли 
			И НЕ СписокЗначений.НайтиПоЗначению(Элемент.Значение) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СписокЗначений.Добавить(Элемент.Значение, Элемент.Представление);
	КонецЦикла;
	
	Возврат СписокЗначений;	
	
КонецФункции

Функция ОбъединитьТаблицыЗначений_КонтурEDI(ИсходнаяТаблица, ВставляемаяТаблица) Экспорт
	
	Результат = ИсходнаяТаблица.Скопировать();
	
	Для каждого Строка Из ВставляемаяТаблица Цикл
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ОбъединитьМассивы_КонтурEDI(ПервыйМассив, ВторойМассив) Экспорт

	Результат = Новый Массив;
	
	Для каждого ЭлементКоллекции Из ПервыйМассив Цикл
		Результат.Добавить(ЭлементКоллекции);
	КонецЦикла;
	
	Для каждого ЭлементКоллекции Из ВторойМассив Цикл
		Результат.Добавить(ЭлементКоллекции);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СообщениеСодержитКодыМаркировки(Сообщение) Экспорт
	
	Результат = Ложь;
	
	Если Сообщение.Свойство("Товары")
		И ТипЗнч(Сообщение.Товары) = Тип("ТаблицаЗначений") Тогда
		
		ИменаКолонок = Новый Массив;
		
		Если Сообщение.ТипСообщения = "COINVOIC" 
			И Сообщение.Товары.Колонки.Найти("КодыМаркировкиДо") <> Неопределено
			И Сообщение.Товары.Колонки.Найти("КодыМаркировкиПосле") <> Неопределено Тогда
			
			ИменаКолонок.Добавить("КодыМаркировкиДо");
			ИменаКолонок.Добавить("КодыМаркировкиПосле");
			
		ИначеЕсли Сообщение.Товары.Колонки.Найти("КодыМаркировки") <> Неопределено Тогда
			
			ИменаКолонок.Добавить("КодыМаркировки");
			
		КонецЕсли;
		
		Для каждого ИмяКолонки Из ИменаКолонок Цикл
			Для каждого СтрокаТовара Из Сообщение.Товары Цикл
				Если ЗначениеЗаполнено(СтрокаТовара[ИмяКолонки]) Тогда
					Результат = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если Результат Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТранспортныеУпаковкиСодержатКодыМаркировки(ТранспортныеУпаковки)
	
	Результат = Ложь;
	
	Если ТипЗнч(ТранспортныеУпаковки) = Тип("ДеревоЗначений")
		И ТранспортныеУпаковки.Колонки.Найти("КодыМаркировки") <> Неопределено Тогда
		
		Для каждого Упаковка Из ТранспортныеУпаковки.Строки Цикл
		
			Для каждого ТоварУпаковки Из Упаковка.Строки Цикл
				
				Если ЗначениеЗаполнено(ТоварУпаковки.КодыМаркировки) Тогда
					
					Результат = Истина;	
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
		
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОтправлятьКодыМаркировки(Сообщение) Экспорт
	
	ТипСообщения = Сообщение.ТипСообщения;
	
	Если ТипСообщения = "COINVOIC" Тогда
		ТипСообщения = "INVOIC";
	КонецЕсли;
	
	НазваниеНастройки = "КодыМаркировкиВ" + ТипСообщения;
	ЗначениеНастройки = ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, НазваниеНастройки);
	
	Возврат ЗначениеНастройки = Истина;
		
КонецФункции

Функция НастройкиМаркировкиТоваров() Экспорт
	
	НастройкиМаркировкиТоваров = ЭДО_Кэш_Прочитать("НастройкиМаркировкиТоваров");
	
	Если Не НастройкиМаркировкиТоваров = Неопределено Тогда
		Возврат НастройкиМаркировкиТоваров;
	КонецЕсли;
		
	НастройкиМаркировкиТоваров = ИнициализироватьСтруктуруНастроекМаркировки();
	
	Если ЕстьНеобходимыеМетаданные("Подсистемы.КонтурМаркировка")
		И ЕстьНеобходимыеМетаданные("ОбщиеМодули.ВзаимодействиеКонтурМаркировка") Тогда
		
		ОбщийМодуль_ВзаимодействиеКонтурМаркировка = Вычислить("ВзаимодействиеКонтурМаркировка");
		
		НастройкиМаркировкиТоваров.МодульКонтурМаркировка = ОбщийМодуль_ВзаимодействиеКонтурМаркировка;
		
		Попытка
			НастройкиМаркировкиТоваров.ВерсияКонтурМаркировка = ОбщийМодуль_ВзаимодействиеКонтурМаркировка.ВерсияМодуля();
		Исключение  
			;
		КонецПопытки;
		
	КонецЕсли;
	
	Если ЕстьНеобходимыеМетаданные("ОбщиеМодули.ЭлектронноеВзаимодействиеИСМП") Тогда
		
		НастройкиМаркировкиТоваров.МодульГосИС = Вычислить("ЭлектронноеВзаимодействиеИСМП");
		НастройкиМаркировкиТоваров.ВерсияГосИС = КонтурСтандарт_ВерсияБиблиотекиИнтеграции("ИСМП");
		
	КонецЕсли;
	
	ЭДО_Кэш_Поместить("НастройкиМаркировкиТоваров",НастройкиМаркировкиТоваров);
	
	Возврат НастройкиМаркировкиТоваров;
	
КонецФункции

Функция ИнициализироватьСтруктуруНастроекМаркировки() Экспорт
	
	НастройкиМаркировкиТоваров = Новый Структура;
	НастройкиМаркировкиТоваров.Вставить("МодульКонтурМаркировка", Неопределено);
	НастройкиМаркировкиТоваров.Вставить("ВерсияКонтурМаркировка", "");
	НастройкиМаркировкиТоваров.Вставить("МодульГосИС", Неопределено);
	НастройкиМаркировкиТоваров.Вставить("ВерсияГосИС", "");
	
	Возврат НастройкиМаркировкиТоваров	
	
КонецФункции

Функция ОписаниеТаблицыКодовМаркировкиДляЗагрузки() Экспорт
	
	КолонкиВнешнейТаблицы = ИнициализироватьКолонкиВнешнейТаблицы();
	
	ДоступныеВидыМаркировки = Новый Массив;
	Для каждого ЭлементПеречисления Из ПолучитьСписокЗначенийПеречисленияEDI("ВидыКодовМаркировки") Цикл
		ДоступныеВидыМаркировки.Добавить(ЭлементПеречисления.Представление);
	КонецЦикла;
	
	ДобавитьОписаниеКолонкиВнешнейТаблицы(КолонкиВнешнейТаблицы, "КодМаркировки", "Код маркировки",Истина);
	ДобавитьОписаниеКолонкиВнешнейТаблицы(КолонкиВнешнейТаблицы, "ВидКодаМаркировки", "Вид кода", Ложь, ДоступныеВидыМаркировки);
	
	Возврат КолонкиВнешнейТаблицы;
	
КонецФункции

Процедура ЗаполнитьДеревоНераспределенныхКодовМаркировки(ДеревоКодовМаркировки, РазвернутаяТаблицаКодов) Экспорт
	
	ПоляОписанияТовара = "НомерСтроки,Номенклатура,Наименование,Артикул,ХарактеристикаНоменклатуры,ЕдиницаИзмерения,СерияНоменклатуры";
	ПоляОписанияТовараМассивом = EDI_РазложитьСтрокуВМассивСлов(ПоляОписанияТовара, ",", Истина);
	
	СтруктураПоискаКодовМаркировки = Новый Структура;
	
	Для каждого Поле Из ПоляОписанияТовараМассивом Цикл
		СтруктураПоискаКодовМаркировки.Вставить(Поле);
	КонецЦикла;
	
	СтруктураПоискаКодовМаркировки.Вставить("НомерУпаковки", Неопределено);
	
	ТаблицаТоваров = РазвернутаяТаблицаКодов.Скопировать(,ПоляОписанияТовара);
	ТаблицаТоваров.Свернуть(ПоляОписанияТовара);
	
	Для каждого Товар Из ТаблицаТоваров Цикл
		
		СтрокаТовара = ДеревоКодовМаркировки.Строки.Добавить();
		СтрокаТовара.ПредставлениеСтроки = ПредставлениеТовараДляТаблицыКодовМаркировки(Товар, ПоляОписанияТовараМассивом);
		
		ЗаполнитьЗначенияСвойств(СтрокаТовара, Товар);
		ЗаполнитьЗначенияСвойств(СтруктураПоискаКодовМаркировки, Товар);
		
		НераспределенныеКоды = РазвернутаяТаблицаКодов.НайтиСтроки(СтруктураПоискаКодовМаркировки);
		
		Для каждого КодМаркировки Из НераспределенныеКоды Цикл
			
			Если Не ЗначениеЗаполнено(КодМаркировки.Код) Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаКода = СтрокаТовара.Строки.Добавить();
			СтрокаКода.КодМаркировки = КодМаркировки.Код;
			СтрокаКода.ВидКода = КодМаркировки.Вид;
			СтрокаКода.НомерСтроки = Товар.НомерСтроки;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДеревоРаспределенныхКодовМаркировки(ДеревоРаспределенныхКодов, ДеревоУпаковок, РазвернутаяТаблицаКодов) Экспорт
	
	СтруктураПоискаКодов = Новый Структура;
	СтруктураПоискаКодов.Вставить("НомерУпаковки");
	СтруктураПоискаКодов.Вставить("НомерСтроки");
	
	Для каждого СтрокаУпаковки Из ДеревоУпаковок.Строки Цикл
		
		Упаковка = ДеревоРаспределенныхКодов.Строки.Добавить();
		Упаковка.ПредставлениеСтроки = СтрокаУпаковки.СоставУпаковки;
		Упаковка.НомерУпаковки = СтрокаУпаковки.НомерУпаковки;
		Упаковка.КоличествоТовара = СтрокаУпаковки.Количество;
		
		Для каждого СтрокаТовара Из СтрокаУпаковки.Строки Цикл
			
			Товар = Упаковка.Строки.Добавить();
			Товар.НомерУпаковки = Упаковка.НомерУпаковки;
			Товар.НомерСтроки = СтрокаТовара.НомерСтроки;
			Товар.КоличествоТовара = СтрокаТовара.Количество;
			Товар.ПредставлениеСтроки = "" + СтрокаТовара.НомерСтроки + ". " + СтрокаТовара.СоставУпаковки;
			
			Если ПеременнаяСодержитСвойство(СтрокаТовара, "Артикул", ,Истина) Тогда
				Товар.ПредставлениеСтроки = Товар.ПредставлениеСтроки + ", " + СтрокаТовара.Артикул;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(СтруктураПоискаКодов, Товар);			
			КодыМаркировки = РазвернутаяТаблицаКодов.НайтиСтроки(СтруктураПоискаКодов);
			
			Товар.КоличествоКодов = КодыМаркировки.Количество();
			
			ПорядковыйНомер = 1;
			
			Для каждого СтрокаКода Из КодыМаркировки Цикл
				
				КодМаркировки = Товар.Строки.Добавить();
				КодМаркировки.НомерСтроки = Товар.НомерСтроки;
				КодМаркировки.НомерУпаковки = Товар.НомерУпаковки;
				КодМаркировки.КодМаркировки = СтрокаКода.Код;
				КодМаркировки.ВидКода = СтрокаКода.Вид;
				КодМаркировки.ПредставлениеСтроки = СтрокаКода.Код;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПредставлениеТовараДляТаблицыКодовМаркировки(СтрокаТовара, ПоляОписанияТовара)
	
	Представление = "";
	
	Для каждого Поле Из ПоляОписанияТовара Цикл
		
		ЗначениеВСтроке = СтрокаТовара[Поле];
		Если ЗначениеЗаполнено(ЗначениеВСтроке) Тогда
			Представление = Представление + ", "  + ЗначениеВСтроке;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Представление) Тогда
		Представление = Сред(Представление, 3);
	КонецЕсли;
	
	Возврат Представление;

КонецФункции

Процедура ДозаполнитьАртикулКодПолноеНаименованиеВТаблицеТоваров(ТаблицаТоваров) Экспорт
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваров,"НоменклатураКод,Артикул,НаименованиеНоменклатурыПолное");
	Если Не ЗначениеЗаполнено(ТаблицаТоваров.Колонки.НомерСтроки.ТипЗначения) Тогда
		ТипизироватьКолонкиВТаблицеЗначений(ТаблицаТоваров, "НомерСтроки", ОписаниеТипаЧисло_КонтурEDI(10,0,ДопустимыйЗнак.Неотрицательный));
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Данные.Номенклатура КАК Номенклатура,
	|	Данные.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ИсходныеДанные
	|ИЗ
	|	&Данные КАК Данные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(спрНоменклатура.Код, """") КАК Код,
	|	ЕСТЬNULL(спрНоменклатура.Артикул, """") КАК Артикул,
	|	ЕСТЬNULL(спрНоменклатура.НаименованиеПолное, """") КАК НаименованиеПолное,
	|	ИсходныеДанные.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	ИсходныеДанные КАК ИсходныеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК спрНоменклатура
	|		ПО ИсходныеДанные.Номенклатура = спрНоменклатура.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	ТипНоменклатура = ПолучитьТипЗначенияОбъекта("Номенклатура", , Истина);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Справочник.Номенклатура", "Справочник." + ТипНоменклатура);
	
	Если НЕ ЕстьНеобходимыеМетаданные("Справочники." + ТипНоменклатура + ".Реквизиты.Артикул") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "спрНоменклатура.Артикул", """""");
	КонецЕсли;
	
	Если НЕ ЕстьНеобходимыеМетаданные("Справочники." + ТипНоменклатура + ".Реквизиты.НаименованиеПолное") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "спрНоменклатура.НаименованиеПолное", "спрНоменклатура.Наименование");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Данные", ТаблицаТоваров);
	ТЗРеквизитов = Запрос.Выполнить().Выгрузить();
	КолонкаКод = ТЗРеквизитов.ВыгрузитьКолонку("Код");
	КолонкаАртикул = ТЗРеквизитов.ВыгрузитьКолонку("Артикул");
	КолонкаНаименованиеПолное = ТЗРеквизитов.ВыгрузитьКолонку("НаименованиеПолное");
	
	ТаблицаТоваров.ЗагрузитьКолонку(КолонкаКод, "НоменклатураКод");
	ТаблицаТоваров.ЗагрузитьКолонку(КолонкаАртикул, "Артикул");
	ТаблицаТоваров.ЗагрузитьКолонку(КолонкаНаименованиеПолное, "НаименованиеНоменклатурыПолное");
	
КонецПроцедуры

Функция СтруктураПараметровФормыПросмотраКодовМаркировки() Экспорт
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресКодовМаркировкиТоваров");
	ПараметрыФормы.Вставить("АдресРасхождений");
	ПараметрыФормы.Вставить("АдресДереваУпаковок");
	ПараметрыФормы.Вставить("АдресСообщения");
	ПараметрыФормы.Вставить("СтрокаПозиционирования");
	ПараметрыФормы.Вставить("ТолькоПросмотр");
	ПараметрыФормы.Вставить("ПросмотрРасхождений");
	ПараметрыФормы.Вставить("СкрытьУпаковки");
	ПараметрыФормы.Вставить("КодыМаркировкиОтредактированыВручную");
	ПараметрыФормы.Вставить("ИмяКолонкиКодовВСообщении");
	
	Возврат ПараметрыФормы;
	
КонецФункции

Функция ЗагрузитьКодыМаркировкиВДокумент_КонтурEDI(ДокументОбъект, 
												   ТаблицаКодовМаркировки, 
												   СистемаУчетаКодовМаркировки = Неопределено, 
												   СообщениеСсылка = Неопределено) Экспорт 
	
	РезультатЗагрузки = РезультатЗагрузкиКодовМаркировки_КонтурEDI();
		
	СтандартнаяОбработкаEDI = Истина;
	
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("ДокументДляЗагрузкиКодов", ДокументОбъект);
	ПараметрыПМ.Вставить("ТаблицаКодовМаркировки", ТаблицаКодовМаркировки);
	ПараметрыПМ.Вставить("СообщениеСсылка", СообщениеСсылка); 	
	ПараметрыПМ.Вставить("РезультатЗагрузкиКодов", РезультатЗагрузки); 	
	ПараметрыПМ.Вставить("СистемаУчетаКодовМаркировки", СистемаУчетаКодовМаркировки);
	
	ОбработкаСобытияПодключаемогоМодуля("ПередЗагрузкойКодовМаркировки", СтандартнаяОбработкаEDI, ПараметрыПМ); 
	
	Если СтандартнаяОбработкаEDI = Ложь Тогда 
		
		Возврат РезультатЗагрузки;
		
	КонецЕсли;
	
	Если СистемаУчетаКодовМаркировки = Неопределено Тогда
		
		РезультатЗагрузки.Успешно = Ложь;
		РезультатЗагрузки.ОписаниеОшибки = "Не удалось определить используемую систему учета кодов маркировки";
		
	ИначеЕсли СистемаУчетаКодовМаркировки = "КонтурМаркировка" Тогда
		
		РезультатЗагрузки = ЗагрузитьКодыМаркировкиВКонтурМаркировку(ДокументОбъект.Ссылка, ТаблицаКодовМаркировки);
		
	ИначеЕсли СистемаУчетаКодовМаркировки = "ИСМП" Тогда
		
		РезультатЗагрузки = ЗагрузитьКодыМаркировкиВДокумент1С(ДокументОбъект, ТаблицаКодовМаркировки);
		
	КонецЕсли;
	
	Возврат РезультатЗагрузки;
	
КонецФункции

Функция ЗагрузитьКодыМаркировкиИзПриемки_КонтурEDI(ДокументОбъект, 
												   ТаблицаКодовМаркировки, 
												   ИсходнаяНакладная, 
												   Сообщение) Экспорт
	
	СистемаУчетаКодовМаркировки = СистемаУчетаМаркировкиДляОбработкиПриемки(ИсходнаяНакладная);
	
	СтрокиСКодамиМаркировки = Новый Массив;
	
	Для каждого Строка Из ТаблицаКодовМаркировки Цикл
		Если ЗначениеЗаполнено(Строка.Код) Тогда
			СтрокиСКодамиМаркировки.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаКодовДляЗагрузки = ТаблицаКодовМаркировки.Скопировать(СтрокиСКодамиМаркировки);
	
	РезультатЗагрузки = ЗагрузитьКодыМаркировкиВДокумент_КонтурEDI(ДокументОбъект, 
																   ТаблицаКодовДляЗагрузки, 
																   СистемаУчетаКодовМаркировки,
																   Сообщение);
	
	Если Не РезультатЗагрузки.Успешно Тогда
		
		ТекстОшибки = "Не удалось загрузить коды маркировки из приемки по документу " + ИсходнаяНакладная + ". По причине: 
					  |" + РезультатЗагрузки.ОписаниеОшибки;                                                                                
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Предупреждение, ТекстОшибки);
		
	КонецЕсли;
	
	Возврат РезультатЗагрузки;
	
КонецФункции

Функция РезультатЗагрузкиКодовМаркировки_КонтурEDI()
	
	РезультатЗагрузки = Новый Структура;
	РезультатЗагрузки.Вставить("Успешно", Истина);
	РезультатЗагрузки.Вставить("ОписаниеОшибки", "");
	
	Возврат РезультатЗагрузки;
	
КонецФункции

Функция ЗагрузитьКодыМаркировкиВКонтурМаркировку(Документ1С, ТаблицаКодовМаркировки)
	
	РезультатЗагрузки = РезультатЗагрузкиКодовМаркировки_КонтурEDI();
	
	Если Не ЕстьВозможностьСоздатьДокументУчетаВМаркировке(Документ1С) Тогда
		
		РезультатЗагрузки.Успешно = Ложь;
		РезультатЗагрузки.ОписаниеОшибки = "В Контур.Маркировке не настроена работа с документами типа " + ТипЗнч(Документ1С);
		Возврат РезультатЗагрузки;
		
	КонецЕсли;
	
	НачатьТранзакцию();
	
	Попытка
		
		ОбщийМодульКонтурМаркировка = НастройкиМаркировкиТоваров().МодульКонтурМаркировка;
		ОбработкаКонтурМаркировка = ОбщийМодульКонтурМаркировка.МодульКонтурМаркировка();

		ДокументУчета = ОбщийМодульКонтурМаркировка.ДокументУчета_Найти(Документ1С);
		Если ДокументУчета = Неопределено Тогда
			ОбщийМодульКонтурМаркировка.ДокументУчета_Создать(Документ1С);
		Иначе
			ОбработкаКонтурМаркировка.ДокументУчета_Перезаполнить(ДокументУчета, Документ1С);
		КонецЕсли;

		МассивКодов = Новый Массив;
		Для каждого СтрокаТаблицыКодов Из ТаблицаКодовМаркировки Цикл
			МассивКодов.Добавить(ОбщийМодульКонтурМаркировка.ОписаниеКодаМаркировки(СтрокаТаблицыКодов.Код));
		КонецЦикла;

		ОбработкаКонтурМаркировка.ДобавитьКодыВДокумент(Документ1С, МассивКодов, Истина);
		 	
		ЗафиксироватьТранзакцию();

	Исключение
		
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
				
		РезультатЗагрузки.Успешно = Ложь;
		РезультатЗагрузки.ОписаниеОшибки = "Непредвиденная ошибка при загрузке кодов маркировки в Контур.Маркировку: " + ОписаниеОшибки();
			
	КонецПопытки;
	
	Возврат РезультатЗагрузки;
	
КонецФункции

Функция ЕстьВозможностьСоздатьДокументУчетаВМаркировке(Документ1С) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КонтурМаркировка_ДопСправочникиДопРеквизиты.Ссылка
	               |ИЗ
	               |	Справочник.КонтурМаркировка_ДопСправочники.ДопРеквизиты КАК КонтурМаркировка_ДопСправочникиДопРеквизиты
	               |ГДЕ
	               |	КонтурМаркировка_ДопСправочникиДопРеквизиты.ИмяРеквизита = ""ТипДокумента""
	               |	И КонтурМаркировка_ДопСправочникиДопРеквизиты.Значение = &Значение
	               |	И КонтурМаркировка_ДопСправочникиДопРеквизиты.Ссылка.ИмяСправочника = ""НастройкиДокументаУчета""";
	
	Запрос.УстановитьПараметр("Значение", Документ1С.Метаданные().Имя);
	Результат = Запрос.Выполнить();
	
	Возврат Не Результат.Пустой();
	
КонецФункции

Функция ЗагрузитьКодыМаркировкиВДокумент1С(ДокументПриемникКодов, ТаблицаКодовМаркировки)
	
	РезультатЗагрузки = РезультатЗагрузкиКодовМаркировки_КонтурEDI();

	МодульШтрихкодированиеИС = ОбщийМодуль1С_КонтурEDI("ШтрихкодированиеИС");
	
	Если МодульШтрихкодированиеИС = Неопределено Тогда
		
		РезультатЗагрузки.Успешно = Ложь;
		РезультатЗагрузки.ОписаниеОшибки = "Не удалось определить общий модуль ШтрихкодированиеИС для подбора существующих штрихкодов упаковок.";
		Возврат РезультатЗагрузки;
		
	КонецЕсли;

	Если Не ПеременнаяСодержитСвойство(ДокументПриемникКодов, "ШтрихкодыУпаковок") Тогда
		
		РезультатЗагрузки.Успешно = Ложь;
		РезультатЗагрузки.ОписаниеОшибки = "В документе отсутствует табличная часть для загрузки кодов маркировки.";
		Возврат РезультатЗагрузки;
		
	КонецЕсли;
	
	ДанныеШтрихкодовУпаковок = МодульШтрихкодированиеИС.ШтрихкодыУпаковок(ТаблицаКодовМаркировки.ВыгрузитьКолонку("Код"));
	
	Если Не ТаблицаКодовМаркировки.Количество() = ДанныеШтрихкодовУпаковок.Количество() Тогда
		
		НеопознанныеКоды = Новый Массив;
		Для каждого СтрокаКодовМаркировки Из ТаблицаКодовМаркировки Цикл
			
			ОбработанныйКод = ДанныеШтрихкодовУпаковок.Найти(СтрокаКодовМаркировки.Код, "Штрихкод");
			Если ОбработанныйКод = Неопределено Тогда
				НеопознанныеКоды.Добавить(СтрокаКодовМаркировки.Код);
			КонецЕсли;
			
		КонецЦикла;
		
		Если НеопознанныеКоды.Количество() > 0 Тогда
			
			ТекстОшибки = "В приемке есть коды маркировки, которые не удается найти в 1С:";
			Для каждого Код Из НеопознанныеКоды Цикл
				ТекстОшибки = ТекстОшибки + Символы.ПС + Код;
			КонецЦикла;
			
			РезультатЗагрузки.Успешно = Ложь;
			РезультатЗагрузки.ОписаниеОшибки = ТекстОшибки;
			Возврат РезультатЗагрузки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ДокументПриемникКодов.ШтрихкодыУпаковок.Очистить();
	
	Для каждого ШтрихкодУпаковки Из ДанныеШтрихкодовУпаковок Цикл
		
		НовыйШтрихкод = ДокументПриемникКодов.ШтрихкодыУпаковок.Добавить();                             
		НовыйШтрихКод.ШтрихкодУпаковки = ШтрихкодУпаковки.Ссылка;
		
		Если ПеременнаяСодержитСвойство(НовыйШтрихкод, "ЗначениеШтрихкода") Тогда
			НовыйШтрихкод.ЗначениеШтрихкода = ШтрихкодУпаковки.ЗначениеШтрихкода;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат РезультатЗагрузки;
	
КонецФункции

Процедура НормализоватьКодыМаркировки_1С(Товары, ШтрихкодыУпаковок) Экспорт
	
	Если НастройкиМаркировкиТоваров().МодульГосИС = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиМаркировкиТоваров().МодульГосИС.НормализоватьШтрихкодыУпаковок(Товары, ШтрихкодыУпаковок);
		
КонецПроцедуры

Функция СистемаУчетаМаркировкиДляОбработкиПриемки(ИсходнаяНакладная) Экспорт
	
	СистемаУчетаКодовМаркировки = СистемаУчетаКодовМаркировкиПоДокументу(ИсходнаяНакладная);
	
	Если СистемаУчетаКодовМаркировки = Неопределено
		И Не НастройкиМаркировкиТоваров().МодульКонтурМаркировка = Неопределено Тогда
		
		СистемаУчетаКодовМаркировки = "КонтурМаркировка";
		
	КонецЕсли;
	
	Если СистемаУчетаКодовМаркировки = Неопределено 
		И Не НастройкиМаркировкиТоваров().МодульГосИС = Неопределено Тогда
		
		СистемаУчетаКодовМаркировки = "ИСМП";
		
	КонецЕсли;
	
	Возврат СистемаУчетаКодовМаркировки;
	
КонецФункции

Функция СистемаУчетаКодовМаркировкиПоДокументу(Документ1С) Экспорт
	
	СистемаУчета = Неопределено;
	НастройкиМаркировки = НастройкиМаркировкиТоваров();
	ИсходныйДокументСКодами = ПолучитьИсходныйДокументОтгрузкиКорректировкиРеализации(Документ1С);
		
	Если Не НастройкиМаркировки.МодульКонтурМаркировка = Неопределено Тогда
				
		ИсходныйДокументУчета = НастройкиМаркировки.МодульКонтурМаркировка.ДокументУчета_Найти(ИсходныйДокументСКодами);
		Если ЗначениеЗаполнено(ИсходныйДокументУчета) Тогда
			СистемаУчета = "КонтурМаркировка";
		КонецЕсли;
		
	КонецЕсли;
	
	Если СистемаУчета = Неопределено 
		И Не НастройкиМаркировки.МодульГосИС = Неопределено Тогда
		
		ИсходныеКодыМаркировки = ПолучитьТаблицуШтрихкодовУпаковок(ИсходныйДокументСКодами);
		Если ЗначениеЗаполнено(ИсходныеКодыМаркировки) Тогда
			СистемаУчета = "ИСМП";
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СистемаУчета;
	
КонецФункции

Функция ПолучитьСообщениеСКодамиМаркировкиДляОбработкиПриемки(Документ1С, НастройкиСравненияRECADV)
	
	СообщениеСКодамиМаркировки = Неопределено;
	
	ТипыСообщенийСКодамиМаркировки = Новый Массив;
	
	Если НастройкиСравненияRECADV.КодыМаркировкиВINVOIC = Истина Тогда
		ТипыСообщенийСКодамиМаркировки.Добавить("INVOIC");
	КонецЕсли;
	
	ТипыСообщенийСКодамиМаркировки.Добавить("DESADV");
	
	СписокСообщенийПоТипам = СообщенияЦепочкиРаспределенныеПоТипам(Документ1С);
	
	Для каждого ТипСообщения Из ТипыСообщенийСКодамиМаркировки Цикл
		
		МассивСообщений = СписокСообщенийПоТипам.Получить(ТипСообщения);

		Если ЗначениеЗаполнено(МассивСообщений) Тогда
			
			ИндексПоследнегоСообщения = МассивСообщений.Количество() - 1;
			СообщениеСКодамиМаркировки = МассивСообщений[ИндексПоследнегоСообщения];
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СообщениеСКодамиМаркировки;
	
КонецФункции

Процедура КонтурМаркировка_ЗаполнитьСведенияОМаркировке(ТоварыДокументов, ОшибкиЗаполнения = Неопределено, ПроверитьЗавершениеРаботы = Истина, ВызывающийМодуль = "") Экспорт
	
	НастройкиМаркировкиТоваров = НастройкиМаркировкиТоваров();
	
	МодульКонтурМаркировка 	   = НастройкиМаркировкиТоваров.МодульКонтурМаркировка; 
	ВерсияКонтурМаркировка     = НастройкиМаркировкиТоваров.ВерсияКонтурМаркировка;
	
	Если КонтурСтандарт_СравнитьВерсии(ВерсияКонтурМаркировка, "3.18.1") >= 0 Тогда
		ВызывающийМодуль = ПараметрыКлиентСервер.ИмяПродукта;
		МодульКонтурМаркировка.МодульМаркировки().ЗаполнитьСведенияОМаркировке(ТоварыДокументов, ОшибкиЗаполнения, ПроверитьЗавершениеРаботы, ВызывающийМодуль);
	Иначе
		МодульКонтурМаркировка.ЗаполнитьСведенияОМаркировке(ТоварыДокументов, ОшибкиЗаполнения, ПроверитьЗавершениеРаботы);	
	КонецЕсли;
	
КонецПроцедуры

