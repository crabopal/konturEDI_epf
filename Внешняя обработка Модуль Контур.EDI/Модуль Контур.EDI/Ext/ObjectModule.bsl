Функция API_SendMetrics(Адрес, ТелоЗапроса = "") Экспорт
	
	Перем Сервер, Сессия;
	
	Сервер = ПараметрыКлиентСерверМетрика.URLАдреса.БоевойСервер;
	
	Сессия = ЭДО_Кэш_Прочитать("Сессия_МетрикаБоевойСервер");
		
	Если Сессия = Неопределено Тогда
		Сессия = КлиентHTTP_СоздатьСессию();			
		Сессия.Прокси = ПолучитьИнтернетПрокси();
		ЭДО_Кэш_Поместить("Сессия_МетрикаБоевойСервер", Сессия);
	КонецЕсли;
	
	АдресРесурса = КонтурСтандарт_СтрШаблон_("%1/%2", Сервер, "metrika-pipe");
	Если НЕ ПроверитьДоступностьИнтернетРесурсаСКэшем(АдресРесурса, Сессия) Тогда 
		ВызватьИсключение ТекстОшибкиОтсутствуетИнтернетСоединение();
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Заголовки", Новый Соответствие);
	ДополнительныеПараметры.Заголовки.Вставить("Content-Type" , "application/json");
	
	Ответ = КлиентHTTP_Post(Сервер + Адрес, ТелоЗапроса, ДополнительныеПараметры, Сессия);

	Возврат Ответ;

КонецФункции

Процедура ПроверитьHTTPКодСостояния200(Ответ)
	
	Если Ответ.КодСостояния <> "200" Тогда
		
		ОписаниеОшибки = "Ошибка HTTP запроса"
		+ ?(ЗначениеЗаполнено(Ответ.КодСостояния), Символы.ПС + Ответ.КодСостояния, "")
		+ ?(ЗначениеЗаполнено(Ответ.ТелоОтвета)  , Символы.ПС + Ответ.ТелоОтвета  , "");

	Иначе
		Возврат;
	КонецЕсли;
	
	ВызватьИсключение ОписаниеОшибки;
		
КонецПроцедуры

Процедура ПроверитьHTTPКодСостояния200_EDI(Ответ, ДанныеАвторизации)
	
	Если Ответ.КодСостояния <> "200" Тогда
		
		
		Если Найти(Ответ.ТелоОтвета, "User") > 0 И
			 Найти(Ответ.ТелоОтвета, "has no access to box") > 0 И
			 ДанныеАвторизации.Свойство("GLN") Тогда
			 
			ОписаниеОшибки = "У пользователя с логином """ + ДанныеАвторизации.Логин + """ отсутствует доступ к организации с GLN: " + ДанныеАвторизации.GLN;
			
		ИначеЕсли Найти(Ответ.ТелоОтвета, "Access is denied") > 0 И
			      Найти(Ответ.ТелоОтвета, "for 1C-module") > 0 И
				  ДанныеАвторизации.Свойство("GLN") Тогда
				  
			Организация = НайтиОбъектПоЗначениюСвойства("GLN_Организации", ДанныеАвторизации.GLN);
			НаименованиеОрганизации = ?(Организация = Неопределено, "", ПолучитьПредставлениеЭлементаСправочника(Организация));
			
			ОписаниеОшибки = "У организации """ + НаименованиеОрганизации + """ с GLN """ + ДанныеАвторизации.GLN + """ заблокирована работа через модуль 1С. Обратитесь к менеджеру своей организации по продукту Контур.EDI.";
		ИначеЕсли Найти(Ответ.ТелоОтвета, "Invalid login/password") > 0 Тогда 
			ОписаниеОшибки = "Неверный логин / пароль";
		Иначе
			ОписаниеОшибки = "Ошибка HTTP запроса"
			+ ?(ЗначениеЗаполнено(Ответ.КодСостояния), Символы.ПС + Ответ.КодСостояния, "")
			+ ?(ЗначениеЗаполнено(Ответ.ТелоОтвета)  , Символы.ПС + Ответ.ТелоОтвета  , "");
		КонецЕсли;

	Иначе
		Возврат;
	КонецЕсли;
	
	ВызватьИсключение ОписаниеОшибки;
		
КонецПроцедуры

Функция НовыеПараметрыHTTPЗапроса() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("Заголовки", Новый Соответствие);
	Результат.Вставить("Параметры", Новый Соответствие);
	
	Результат.Вставить("ТелоЗапроса", Новый Структура("string", "")); // ТелоЗапроса пустая строка
	Результат.Вставить("ТелоОтвета" , Новый Структура("string", "")); // ТелоОтвета вернуть строкой в кодировке сервера
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьТокен_EDI(ДанныеАвторизации, ИспользоватьСохраненныйТокен = Ложь)
	
	Если ИспользоватьСохраненныйТокен И
		ДанныеАвторизации.Свойство("Токен") И
		ЗначениеЗаполнено(ДанныеАвторизации.Токен) Тогда
		
		Возврат ДанныеАвторизации.Токен;
		
	КонецЕсли;
	
	Логин  = ДанныеАвторизации.Логин;
	Пароль = ДанныеАвторизации.Пароль;
	
	Ответ = EDI_API_Authenticate(Логин, Пароль);
	
	ПроверитьHTTPКодСостояния200_EDI(Ответ, ДанныеАвторизации);
	
	Токен = Ответ.ТелоОтвета;
	
	ДанныеАвторизации.Вставить("Токен", Токен);
	
	Если ДанныеАвторизации.Свойство("Ссылка") Тогда	
		УстановитьЗначениеСвойстваОбъекта(ДанныеАвторизации.Ссылка, "Токен", Токен);
	КонецЕсли;
	
	Возврат Токен;
	
КонецФункции

Функция ОрганизацияEDI(Организация) Экспорт
	
	ЮрФизЛица = ПолучитьСписокЭлементовСправочника("ЮрФизЛицаСвои");
	
	Отбор = Новый Структура("ЮрФизЛицо", Организация);
	НайденныеСтрокиЮрФизЛица = ЮрФизЛица.НайтиСтроки(Отбор); 
	
	GLNОрганизации = Неопределено;
	
	Если НайденныеСтрокиЮрФизЛица.Количество() > 0 Тогда
		
		ОрганизацияAPI = НайденныеСтрокиЮрФизЛица[0].ОрганизацияAPI;
		
		Если ЗначениеЗаполнено(ОрганизацияAPI) Тогда 
			Возврат ОрганизацияAPI;	
		Иначе  
			
			НашиОрганизации = ПолучитьСписокЭлементовСправочника("НашиОрганизации");
			GLN = НайденныеСтрокиЮрФизЛица[0].GLN;
			
			НайденныеСтроки = НашиОрганизации.НайтиСтроки(Новый Структура("GLN", GLN)); 
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				Возврат НайденныеСтроки[0].Ссылка;     
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция УчетнаяЗаписьОрганизации(ОрганизацияEDI) Экспорт
	
	Если Не ЗначениеЗаполнено(ОрганизацияEDI) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УчетныеЗаписи = ПолучитьСписокЭлементовСправочника("УчетныеЗаписи");
	GLNОрганизации = ПолучитьЭлементСправочника("НашиОрганизации", ОрганизацияEDI).GLN; 
	Отбор = Новый Структура("GLN, НеАктивна", GLNОрганизации, Ложь);
	
	НайденныеСтроки = УчетныеЗаписи.НайтиСтроки(Отбор);
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		Возврат НайденныеСтроки[0].Ссылка;
		
	КонецЕсли;
	
	Возврат Неопределено;	
	
КонецФункции

Функция ОрганизацияУчетнойЗаписиДоступна(УчетнаяЗапись) Экспорт
	
	ДанныеАвторизацииEDI = ДанныеАвторизацииДляКонтурEDIAPI(УчетнаяЗапись);
	
	ДоступныеОрганизации = КонтурEDIAPI_ДоступныеОрганизации(ДанныеАвторизацииEDI);
	
	Для Каждого PartyInfo Из ДоступныеОрганизации.Parties Цикл
		
		Если PartyInfo.Gln = УчетнаяЗапись.GLN Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ИдентификаторОрганизацииДиадок(Организация) Экспорт
	
	DiadocOrgId = ПолучитьЗначениеСвойстваОбъектаEDI(Организация, "DiadocOrgId"); 
	
	Если НЕ ЗначениеЗаполнено(DiadocOrgId) Тогда
		
		DiadocOrgId = Неопределено;
		
		ОрганизацияEDI = ОрганизацияEDI(Организация);
		
		УчетныеЗаписи = ПолучитьСписокЭлементовСправочника("УчетныеЗаписи");
		GLNОрганизации = ПолучитьЭлементСправочника("НашиОрганизации", ОрганизацияEDI).GLN; 
		Отбор = Новый Структура("GLN, НеАктивна", GLNОрганизации, Ложь);
		
		НайденныеУчетныеЗаписи = УчетныеЗаписи.НайтиСтроки(Отбор);
		
		Если НайденныеУчетныеЗаписи.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ДоступныеОрганизации = Неопределено;
		
		Для Каждого СтрокаУчетнойЗаписи Из НайденныеУчетныеЗаписи Цикл
			
			УчетнаяЗапись = ПолучитьЭлементСправочника("УчетныеЗаписи", СтрокаУчетнойЗаписи.Ссылка); 
			
			Попытка
				ДанныеАвторизацииEDI = ДанныеАвторизацииДляКонтурEDIAPI(УчетнаяЗапись);
				ДоступныеОрганизации = КонтурEDIAPI_ДоступныеОрганизации(ДанныеАвторизацииEDI);
			Исключение 
				ТекстОшибки = ОписаниеОшибки();
				ДоступныеОрганизации = Неопределено;
			КонецПопытки;
			
			Если ДоступныеОрганизации = Неопределено Тогда
				Продолжить;	
			КонецЕсли;
			
			Для Каждого PartyInfo Из ДоступныеОрганизации.Parties Цикл
				
				Если PartyInfo.Gln = УчетнаяЗапись.GLN Тогда
					
					PartyInfoDiadocOrgId = PartyInfo.DiadocOrgId;
					
					Если ТипЗнч(PartyInfoDiadocOrgId) = Тип("Строка") И ЗначениеЗаполнено(PartyInfoDiadocOrgId) Тогда
						DiadocOrgId = PartyInfoDiadocOrgId;
						УстановитьЗначениеСвойстваОбъекта(Организация, "DiadocOrgId", DiadocOrgId);
					КонецЕсли;
					
					PartyInfoInn = PartyInfo.Inn;
					
					Если ТипЗнч(PartyInfoInn) = Тип("Строка") И ЗначениеЗаполнено(PartyInfoInn) Тогда				
						УстановитьЗначениеСвойстваОбъекта(Организация, "DiadocOrgInn", PartyInfo.Inn);
					КонецЕсли;
					
					Прервать;  
					
				КонецЕсли;
				
			КонецЦикла;
			
			Если ЗначениеЗаполнено(DiadocOrgId) Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ДоступныеОрганизации = Неопределено Тогда
			Сообщить(КонтурСтандарт_СтрШаблон_("Не получилось авторизоваться по организации %1: Проверьте учетные записи.", GLNОрганизации));	
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат DiadocOrgId;
	
КонецФункции

Функция ПолучитьТаблицуBoxID_EDI(ДанныеАвторизации, ТипЯщика)
	
	ДанныеАвторизацииEDI = ДанныеАвторизацииДляКонтурEDIAPI(ДанныеАвторизации);
	
	СведенияОЯщиках = КонтурEDIAPI_СписокДоступныхЯщиков(ДанныеАвторизацииEDI);
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("boxId");
	Таблица.Колонки.Добавить("partyId");
	
	Для Каждого Ящик Из СведенияОЯщиках.Boxes Цикл
		
		Если Ящик.BoxSettings.TransportType = "Api"
			Или ВРЕГ(Ящик.BoxSettings.InboxRelativePath) = ВРЕГ(ТипЯщика) Тогда
			
			Нов = Таблица.Добавить();
			Нов.boxId = Строка(Ящик.id);
			Нов.partyId = Строка(Ящик.partyId);
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	Возврат Таблица;
КонецФункции

Функция ПолучитьПараметрыСообщений_EDI(ДанныеАвторизации)
	
	МассивBoxID = Новый Массив;
	
	ТаблицаBoxID = ПолучитьТаблицуBoxID_EDI(ДанныеАвторизации, "inbox");
	МассивBoxID  = ТаблицаBoxID.ВыгрузитьКолонку("boxId");
	
	ИспользоватьСохраненныйТокен = Истина;
	
	Если НЕ МассивBoxID.Количество() = 0 Тогда
		
		ИдентификаторЯщика = МассивBoxID[0]; 
		
		ДанныеАвторизацииEDI = ДанныеАвторизацииДляКонтурEDIAPI(ДанныеАвторизации);
		
		Ответ = КонтурEDIAPI_НастройкиТиповСообщений(ДанныеАвторизацииEDI, ИдентификаторЯщика);
		
		Возврат Ответ.DocumentsSettingsForPartner;

	КонецЕсли;
		
КонецФункции

Функция ПолучитьСобытияЯщика_EDI(ДанныеАвторизации, ИдентификаторЯщика, Параметры)
	
	ИспользоватьСохраненныйТокен = Истина;
	
	Для НомерПопытки = 1 По 2 Цикл
		
		Токен = ПолучитьТокен_EDI(ДанныеАвторизации, ИспользоватьСохраненныйТокен);
		
		Если Параметры.Свойство("exclusiveEventId") Тогда
			
			Ответ = EDI_API_GetEvents(Токен, ИдентификаторЯщика, Параметры.exclusiveEventId);
			
		ИначеЕсли Параметры.Свойство("fromDateTime") Тогда 
			
			Ответ = EDI_API_GetEventsFrom(Токен, ИдентификаторЯщика, Параметры.fromDateTime);
			
		Иначе
			
			ВызватьИсключение "В функцию ПолучитьСобытияЯщика_EDI не переданы параметры exclusiveEventId/fromDateTime";
			
		КонецЕсли;
		
		Если Ответ.КодСостояния = "401" Тогда
			ИспользоватьСохраненныйТокен = Ложь;
			Продолжить;
		КонецЕсли;
		
		ПроверитьHTTPКодСостояния200_EDI(Ответ, ДанныеАвторизации);

		Возврат ПреобразоватьXMLПоXSL_КонтурEDI(Ответ.ТелоОтвета, "BoxEventBatch");
		
	КонецЦикла;
	
КонецФункции

// Получить структуру предложения продления пакетов и подписок организации
//
// Возвращаемое значение:
//  Структура 
//		- ПредложенияПродления - массив - массив предложений продления, данные по каждому в виде структуры: 
//			ТипПредложения - строка - тип предложения продления: "Пакет" или "Подписка"
//			ПредложениеПродления - структура - структура предложения продления подписки или пакета,
//									см. СтруктураПредложенияПродленияПодписки() и СтруктураПредложенияПродленияПакета()
//		- MD5 - строка - хэш-сумма текущего набора предложений продления
//
Функция ПолучитьСтруктуруПредложенияПродленияОрганизации_EDI(УчетнаяЗапись, ИдентификаторОрганизации)
			
	СтруктураПредложенияПродления = Новый Структура("ПредложенияПродления, MD5", Новый Массив, "");
		
	Попытка
		
		ДанныеАвторизацииEDI = ДанныеАвторизацииДляКонтурEDIAPI(УчетнаяЗапись);
		
		ПредложенияПродления = КонтурEDIAPI_ПредложенияПродления(ДанныеАвторизацииEDI, ИдентификаторОрганизации);
					
		СтруктураПредложенияПродления.MD5 = ХэшСумма(ЗначениеВСтрокуВнутр(ПредложенияПродления));

		Для Каждого ЭлементМассива Из ПредложенияПродления Цикл
			
			Если ЭлементМассива.RenewalOfferType = "Subscription" И ТипЗнч(ЭлементМассива.RenewalOfferSubscription) = Тип("Структура") Тогда
				
				СтруктураПодписки = ПодготовитьСтруктуруПредложенияПродленияПодписки_EDI(ЭлементМассива.RenewalOfferSubscription);
				СтруктураПредложенияПродления.ПредложенияПродления.Добавить(Новый Структура("ТипПредложения, ПредложениеПродления", "Подписка", СтруктураПодписки));

			ИначеЕсли ЭлементМассива.RenewalOfferType = "Package" И ТипЗнч(ЭлементМассива.RenewalOfferPackage) = Тип("Структура") Тогда

				СтруктураПакета = ПодготовитьСтруктуруПредложенияПродленияПакета_EDI(ЭлементМассива.RenewalOfferPackage);
				СтруктураПредложенияПродления.ПредложенияПродления.Добавить(Новый Структура("ТипПредложения, ПредложениеПродления", "Пакет", СтруктураПакета));
								
			КонецЕсли;
					
		КонецЦикла;
	
	Исключение
		
		_ОписаниеОшибки = "Не удалось получить предложения продления организации " + ИдентификаторОрганизации + " - " + ОписаниеОшибки();
		Метрика_Переменные = Новый Структура;
		Метрика_Переменные.Вставить("ИдентификаторОрганизации", ИдентификаторОрганизации);
		Метрика_ОтправитьСразу = Истина;
		Метрика_Ошибка("ПолучитьПредложенияПродленияОрганизации_EDI", _ОписаниеОшибки, ИнформацияОбОшибке(), Метрика_Переменные, Метрика_ОтправитьСразу);
		
	КонецПопытки;
	
	Возврат СтруктураПредложенияПродления;
	
КонецФункции		

// Подготавливает пустую структуру предложения продления подписки
//
// Возвращаемое значение:
//  Структура - структура предложения продления подписки 
//		Наименование - Строка - наименование подписки
//		ДатаИстечения - Дата - дата окончания действия подписки
//		ОсталосьДней - Число - количество дней до окончания действия подписки, отрицательное число у истекшей подписки
//		Предложение - Строка - предложение продления подписки
// 		СсылкаДляОплаты - Строка - ссылка для оплаты
//		ЗаголовокКнопки - Строка - заголовок кнопки для оплаты
//
Функция СтруктураПредложенияПродленияПодписки()
	
	Подписка = Новый Структура;
	
	Подписка.Вставить("Наименование", "");
	Подписка.Вставить("ДатаИстечения", Дата(1, 1, 1));
	Подписка.Вставить("ОсталосьДней", 0);
	Подписка.Вставить("Предложение", "");	
	Подписка.Вставить("СсылкаДляОплаты", "");	
	Подписка.Вставить("ЗаголовокКнопки", "");	

	Возврат Подписка;

КонецФункции

// Заполняет структуру предложения продления подписки полученными данными
//
// Параметр:
//  RenewalOfferSubscription - Структура - структура RenewalOfferSubscription EDI API
//
// Возвращаемое значение:
//  Структура - структура предложения продления подписки, см. СтруктураПредложенияПродленияПодписки()  
//
Функция ПодготовитьСтруктуруПредложенияПродленияПодписки_EDI(RenewalOfferSubscription)

	Подписка = СтруктураПредложенияПродленияПодписки();
	
	Подписка.Наименование = RenewalOfferSubscription.SubscriptionName;
	Если ТипЗнч(RenewalOfferSubscription.ExpirationDate) = Тип("Дата") Тогда
		Подписка.ДатаИстечения = МестноеВремя(RenewalOfferSubscription.ExpirationDate);
	КонецЕсли;
	Если Не ПустаяСтрока(RenewalOfferSubscription.PaymentLink) И Не НРег(RenewalOfferSubscription.PaymentLink) = "null" Тогда
		Подписка.СсылкаДляОплаты = RenewalOfferSubscription.PaymentLink;
	КонецЕсли;
	Подписка.ОсталосьДней = Окр((НачалоДня(Подписка.ДатаИстечения) - НачалоДня(ТекущаяДата())) / (60*60*24));

	Если Подписка.ОсталосьДней <= 0 Тогда
		Подписка.Предложение = "Истёк срок действия подписки. Чтобы продолжить работу в сервисе, оплатите новую подписку.";
	Иначе
		Подписка.Предложение = Формат(Подписка.ДатаИстечения, "ДФ=""дд ММММ""") + " заканчивается срок действия подписки. ";
		Если ПустаяСтрока(Подписка.СсылкаДляОплаты) Тогда
			Подписка.Предложение = Подписка.Предложение + "Отправьте заявку менеджеру, чтобы получить счёт.";
		Иначе
			Подписка.Предложение = Подписка.Предложение + "Продлите подписку заранее, чтобы продолжить пользоваться услугой.";
		КонецЕсли;
	КонецЕсли;
	
	Если ПустаяСтрока(Подписка.СсылкаДляОплаты) Тогда
		Подписка.ЗаголовокКнопки = "Отправить заявку";
		Подписка.СсылкаДляОплаты = "https://forms.kontur.ru/form/83d8addd-3bd0-4851-847e-206d2d7a83f5"; // отправить заявку
	Иначе
		Подписка.ЗаголовокКнопки = "Продлить подписку";
	КонецЕсли;
	
	Возврат Подписка;
	
КонецФункции

// Подготавливает пустую структуру предложения продления пакета
//
// Возвращаемое значение:
//  Структура - структура предложения продления пакета 
//		Наименование - Строка - наименование пакета
//		ДатаИстечения - Дата - дата окончания действия пакета
//		ПредполагаемаяДатаИстечения - Дата - предполагаемая дата окончания остатка пакета
//		ПроцентОстатка - Число - остаток пакета в процентах
//		ОсталосьДней - Число - количество дней до окончания действия пакета, отрицательное число у истекшего пакета
//		Предложение - Строка - предложение продления пакета
//		Примечание - Строка - примечание к предложению продления пакета
// 		СсылкаДляОплаты - Строка - ссылка для оплаты
//		ЗаголовокКнопки - Строка - заголовок кнопки для оплаты
//
Функция СтруктураПредложенияПродленияПакета()
	
	Пакет = Новый Структура;
	
	Пакет.Вставить("Наименование", "");
	Пакет.Вставить("ДатаИстечения", Дата(1, 1, 1));
	Пакет.Вставить("ПредполагаемаяДатаИстечения", Дата(1, 1, 1));
	Пакет.Вставить("ПроцентОстатка", 0);
	Пакет.Вставить("ОсталосьДней", 0);
	Пакет.Вставить("Предложение", "");
	Пакет.Вставить("Примечание", "");
	Пакет.Вставить("СсылкаДляОплаты", "");	
	Пакет.Вставить("ЗаголовокКнопки", "");	

	Возврат Пакет;

КонецФункции

// Заполняет структуру предложения продления пакета полученными данными
//
// Параметры:
//  RenewalOfferPackage - Структура - структура RenewalOfferPackage EDI API
//
// Возвращаемое значение:
//  Структура - структура предложения продления пакета, см. СтруктураПредложенияПродленияПакета()  
//
Функция ПодготовитьСтруктуруПредложенияПродленияПакета_EDI(RenewalOfferPackage)
	
	Пакет = СтруктураПредложенияПродленияПакета();
	
	Пакет.Наименование = RenewalOfferPackage.PackageName;
	Если ТипЗнч(RenewalOfferPackage.ExpirationDate) = Тип("Дата") Тогда
		Пакет.ДатаИстечения = МестноеВремя(RenewalOfferPackage.ExpirationDate);
	КонецЕсли;
	Если Не ПустаяСтрока(RenewalOfferPackage.PaymentLink) И Не НРег(RenewalOfferPackage.PaymentLink) = "null" Тогда
		Пакет.СсылкаДляОплаты = RenewalOfferPackage.PaymentLink;
	КонецЕсли;
	Пакет.ОсталосьДней = Окр((НачалоДня(Пакет.ДатаИстечения) - НачалоДня(ТекущаяДата())) / (60*60*24));
	Если ТипЗнч(RenewalOfferPackage.EstimatedTrafficExpirationDate) = Тип("Дата") Тогда
		Пакет.ПредполагаемаяДатаИстечения = МестноеВремя(RenewalOfferPackage.EstimatedTrafficExpirationDate);
	КонецЕсли;
	Пакет.ПроцентОстатка = 100*Число(RenewalOfferPackage.TrafficBalancePercent);
	
	Если Пакет.ОсталосьДней <= 0 Тогда
		Пакет.Предложение = "Срок действия пакета документов истёк. Чтобы продолжить работу в сервисе, оплатите новый пакет документов.";		
	ИначеЕсли Пакет.ПроцентОстатка = 0 Тогда
		Пакет.Предложение = "Пакет документов закончился. Чтобы продолжить работу в сервисе, оплатите новый пакет документов.";
	Иначе
		Если Пакет.ПредполагаемаяДатаИстечения < Пакет.ДатаИстечения Тогда // признак преждевременного израсходования пакета
			Пакет.Предложение = "У вас осталось " + Пакет.ПроцентОстатка + "% документов в пакете. Оплатите новый пакет, чтобы продолжить работать в EDI.";
			Пакет.Примечание = "Документы в пакете " + ?(Пакет.ПроцентОстатка = 0, "закончились", "заканчиваются") + " раньше, чем срок его действия. Возможно, вам будет выгодней купить пакет с большим количеством документов.";
		Иначе
			Пакет.Предложение = Формат(Пакет.ДатаИстечения, "ДФ=""дд ММММ""") + " заканчивается срок действия пакета документов. Перейдите на страницу настройки тарифа, чтобы оплатить новый пакет.";
		КонецЕсли;
	КонецЕсли;		
	
	Если ПустаяСтрока(Пакет.СсылкаДляОплаты) Тогда
		Пакет.ЗаголовокКнопки = "Отправить заявку";
		Пакет.СсылкаДляОплаты = "https://forms.kontur.ru/form/83d8addd-3bd0-4851-847e-206d2d7a83f5"; // отправить заявку
	Иначе
		Пакет.ЗаголовокКнопки = "Выбрать пакет";
	КонецЕсли;
	
	Возврат Пакет;
	
КонецФункции

Функция ПолучитьРеквизитыОрганизации_EDI(ДанныеАвторизации, ИдентификаторОрганизации) Экспорт
	
	ИспользоватьСохраненныйТокен = Истина;
	
	Для НомерПопытки = 1 По 2 Цикл
		
		Токен = ПолучитьТокен_EDI(ДанныеАвторизации, ИспользоватьСохраненныйТокен);
		Ответ = EDI_API_GetPartyInfo(Токен, ИдентификаторОрганизации);
		
		Если Ответ.КодСостояния = "401" Тогда
			ИспользоватьСохраненныйТокен = Ложь;
			Продолжить;
		КонецЕсли;
		
		ПроверитьHTTPКодСостояния200_EDI(Ответ, ДанныеАвторизации);
		
		Результат = Прочитать_XML_API(Ответ.ТелоОтвета, "PartyInfo");
		
		Возврат Результат;
		
	КонецЦикла;	
	
КонецФункции

// Получить действующие на текущую дату подписки организации
//
// Параметры:
//  УчетнаяЗапись - Структура
//  ИдентификаторОрганизации - Строка
//
// Возвращаемое значение:
//  Массив - массив действующих на текущую дату подписок, данные по каждой подписке в виде структуры: 
//			Наименование, Тип, Окончание, Представление
//
Функция ПолучитьПодпискиОрганизации_EDI(УчетнаяЗапись, ИдентификаторОрганизации) Экспорт
			
	ДействующиеПодписки = Новый Массив;
	
	Попытка
		
		ДанныеАвторизацииEDI = ДанныеАвторизацииДляКонтурEDIAPI(УчетнаяЗапись);
		
		РеквизитыОрганизации = КонтурEDIAPI_РеквизитыПоИдентификатору(ДанныеАвторизацииEDI, ИдентификаторОрганизации);
	
		Для Каждого PaidFeatureInfo Из РеквизитыОрганизации.PaidFeatures Цикл
			
			ТипПодписки = PaidFeatureInfo.PaidFeatureType;
			
			Для Каждого PaidPeriod Из PaidFeatureInfo.PaidPeriods Цикл
				
				НачалоДня_PaidPeriod_StartDate = НачалоДня(УниверсальноеВремя(PaidPeriod.StartDate));
				НачалоДня_PaidPeriod_EndDate = НачалоДня(УниверсальноеВремя(PaidPeriod.EndDate));
				КонецДня_PaidPeriod_EndDate = КонецДня(УниверсальноеВремя(PaidPeriod.EndDate));
				
				Если НачалоДня_PaidPeriod_StartDate < ТекущаяДата()
					И КонецДня_PaidPeriod_EndDate > ТекущаяДата()
					Тогда // действующая подписка
					
					СтруктураПодписки = ПодготовитьСтруктуруПодписки(ТипПодписки, НачалоДня_PaidPeriod_EndDate);
					ДействующиеПодписки.Добавить(СтруктураПодписки);
					
					Если ТипПодписки = "Module1C" Тогда // транспорт FTP в комплекте с модулем 1С
						
						СтруктураПодписки = ПодготовитьСтруктуруПодписки("FtpTransport", НачалоДня_PaidPeriod_EndDate);
						ДействующиеПодписки.Добавить(СтруктураПодписки);
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;	
			
		КонецЦикла;		
	
	Исключение
		
		ТекстОшибки = "Не удалось получить подписки организации " + ИдентификаторОрганизации + " - " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);
		
	КонецПопытки;
	
	Возврат ДействующиеПодписки;
	
КонецФункции

// Подготавливают структуру данных о подписке
//
// Параметры:
//  ТипПодписки - Строка
//  ПодпискаДействуетПо - Дата - дата окончания действия подписки
//
// Возвращаемое значение:
//  Структура - данные о подписке (Наименование, Тип, ДействуетПо, Представление)
//
Функция ПодготовитьСтруктуруПодписки(ТипПодписки, ПодпискаДействуетПо)
	
	Подписка = Новый Структура;
	
	Если ТипПодписки = "Module1C" Тогда
		Подписка.Вставить("Наименование", "Модуль 1C API");
	ИначеЕсли ТипПодписки = "FtpTransport" Тогда
		Подписка.Вставить("Наименование", "Транспорт FTP");	
	Иначе // Unknown
		Подписка.Вставить("Наименование", ТипПодписки);	
	КонецЕсли;	
	Подписка.Вставить("Тип", ТипПодписки);
	Подписка.Вставить("ДействуетПо", ПодпискаДействуетПо);
	Подписка.Вставить("Представление", Подписка.Наименование + " оплачен до " + Формат(Подписка.ДействуетПо, "ДЛФ=DD"));
	
	Возврат Подписка;
	
КонецФункции	

Функция ПолучитьФайл_EDI(ИмяФайла) Экспорт
	
	Перем Сервер, Сессия;
	
	Сервер = ПараметрыКлиентСервер.URLАдреса.EDIБоевойСервер;
	
	
	Попытка   
		Сессия = ЭДО_Кэш_Прочитать("Сессия_EDIБоевойСервер");
		
		Если Сессия = Неопределено Тогда
			Сессия = КлиентHTTP_СоздатьСессию();			
			Сессия.Прокси = ПолучитьИнтернетПрокси();
			ЭДО_Кэш_Поместить("Сессия_EDIБоевойСервер", Сессия);
		КонецЕсли; 
		
		Если НЕ ПроверитьДоступностьИнтернетРесурсаСКэшем(Сервер, Сессия) Тогда
			Возврат Неопределено;
		КонецЕсли;

		Ответ = КлиентHTTP_Get(Сервер + ИмяФайла, , , Сессия);
		
		Если Ответ.КодСостояния <> 200 ИЛИ ТипЗнч(Ответ.Тело) = Тип("Структура") Тогда
			Ответ.Тело = Неопределено;	
		КонецЕсли;

		Возврат Ответ.Тело;
	Исключение
		Метрика_Переменные = Новый Структура;
		Метрика_Переменные.Вставить("ИмяФайла", ИмяФайла);
		_ОписаниеОшибки = ОписаниеОшибки();
		Метрика_ОтправитьСразу = Истина;
		Метрика_Ошибка("ПолучитьФайл_EDI", _ОписаниеОшибки, ИнформацияОбОшибке(), Метрика_Переменные, Метрика_ОтправитьСразу);
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция ПолучитьСоединениеHTTP(Адрес, Таймаут = Неопределено) Экспорт
	//#Устарела
	мПараметрыТранспорта = ПолучитьПараметрыИнтернетСоединения_KE();
	
	Прокси = Новый ИнтернетПрокси;
	Если мПараметрыТранспорта.ИспользуетсяПрокси Тогда
		Прокси.Пользователь	= мПараметрыТранспорта.ЛогинПрокси;
		Прокси.Пароль		= мПараметрыТранспорта.ПарольПрокси;
		Если ЗначениеЗаполнено(мПараметрыТранспорта.СерверПрокси) Тогда
			Прокси.Установить("http", мПараметрыТранспорта.СерверПрокси, мПараметрыТранспорта.ПортПрокси);
		КонецЕсли;
	КонецЕсли;
	
	СисИнфо = Новый СистемнаяИнформация;
	ВерсияПлатформы = СисИнфо.ВерсияПриложения;
	СоединениеHTTP = Неопределено;
	ЗащищенноеСоединение=Неопределено;
	Попытка
		Выполнить("ЗащищенноеСоединение=Новый ЗащищенноеСоединениеOpenSSL");
	Исключение
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось установить защищенное соединение - " + ОписаниеОшибки());	
	КонецПопытки;
	
	Если ЗащищенноеСоединение<>Неопределено Тогда
		Выполнить("СоединениеHTTP = Новый HTTPСоединение(Адрес, , , , Прокси, Таймаут, ЗащищенноеСоединение)");
	Иначе
		Выполнить("СоединениеHTTP = Новый HTTPСоединение(Адрес, , , , Прокси, Истина)");
	КонецЕсли;
	
	Возврат СоединениеHTTP;
	
КонецФункции

Функция ПолучитьФайлHTTP(Заглушка = Неопределено, ИмяФайлаНаСервере, ИмяЛокальногоФайла) Экспорт 
	//#Устарела
	
	Результат = ПолучитьФайл_EDI(ИмяФайлаНаСервере);
	
	Если Результат = Неопределено Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	Результат.Записать(ИмяЛокальногоФайла);
	
	Возврат Истина;
Конецфункции

Функция ПолучитьСтрокуПараметровHTTPЗапроса(Соответствие)
	
	Результат = "";
	
	Если ТипЗнч(Соответствие) <> Тип("Соответствие") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Разделитель = "";
	
	Для Каждого Элемент Из Соответствие Цикл
		
		Имя				= Элемент.Ключ;
		Значение		= Элемент.Значение;
		СтрокаЗначение	= Строка(Значение);
		
		Результат = Результат + Разделитель + Имя + ?(ЗначениеЗаполнено(СтрокаЗначение), "=" + СтрокаЗначение, "");
		
		Разделитель = "&";
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

