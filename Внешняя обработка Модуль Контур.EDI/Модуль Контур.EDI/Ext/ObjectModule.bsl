//валидации, приемки, смены статусов, отмены ORDERS/RECADV, проверки дублей
//может, валидации выполнять ДО сохранения сообщения в базу? Так меньше записей будет.
Процедура ДействияПослеСохраненияВходящегоСообщения(Сообщение)
	
	ТипСообщения = Сообщение.ТипСообщения; 
		
	ПрекратитьОбработку = Ложь;
	
	ПрекратитьОбработку = Сообщение.Статус = "ВходящийОшибкаЧтенияФайла";
	
	Если ТипСообщения = "ORDERS" Тогда
		
		ОбработатьЗаказПослеСохранения_КонтурEDI(Сообщение, ПрекратитьОбработку);  		
				
	ИначеЕсли ТипСообщения = "RETANN" Тогда
		
		ОбработатьВозвратПослеСохранения_КонтурEDI(Сообщение, ПрекратитьОбработку);   
		
	ИначеЕсли ТипСообщения = "IFTMBF" Тогда
		
		ОбработатьЗаказНаПеревозкуПослеСохранения_КонтурEDI(Сообщение, ПрекратитьОбработку);   
		
	КонецЕсли;	
	
	Если ПрекратитьОбработку = Ложь Тогда 
		
		ВалидироватьВходящиеСообщения = 
		(ПолучитьКонстантуEDI("ВалидироватьВходящиеСообщения") = Истина)
		ИЛИ ((ОпределитьКемМыЯвляемся(Сообщение) = "Поставщик" И Сообщение.Направление = "Входящее"));	
		
		Если ВалидироватьВходящиеСообщения Тогда
			
			ВалидироватьВходящееСообщение_КонтурEDI(Сообщение, ТипСообщения, ПрекратитьОбработку); 
						
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПрекратитьОбработку = Ложь Тогда
		
		// теперь проверим поля - все ли соответствия заполнены: грузополучатель, покупатель, товары
		РезультатПроверкиДанных = ПроверитьПоля1С(Сообщение);
		Если Не РезультатПроверкиДанных.Успешно Тогда
			
			ПараметрыПМ = Новый Структура;
			ПараметрыПМ.Вставить("Сообщение", Сообщение);
			ПараметрыПМ.Вставить("СписокОшибок", РезультатПроверкиДанных.СписокОшибок);
			ПараметрыПМ.Вставить("ЭтоАвтообмен", ПараметрыПользователяEDI.ЭтоАвтообмен);
			
			СтандартнаяОбработкаEDI = Истина;
			
			ОбработкаСобытияПодключаемогоМодуля("ОбработатьОшибкиЗагрузкиСообщения", СтандартнаяОбработкаEDI, ПараметрыПМ);
			
			Если СтандартнаяОбработкаEDI = Истина Тогда 
				
				УстановитьСтатусСообщения_БМИ(Сообщение.СообщениеСсылка, Сообщение.ДокументСсылка, ТипСообщения, "ВходящийОжидаетУстановкиСоответствий");
				
			КонецЕсли;
			
			ПрекратитьОбработку = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПрекратитьОбработку = Ложь Тогда 
		
		ПриниматьСообщениеАвтоматически_КонтурEDI(Сообщение, ТипСообщения);  
		
	КонецЕсли;
			
КонецПроцедуры

Процедура ПриниматьСообщениеАвтоматически_КонтурEDI(Сообщение, ТипСообщения)
		
	Если НастройкиМодуля = Неопределено Тогда 
		НастройкиМодуля = ПолучитьНастройкиМодуля();
	КонецЕсли;
	
	АвтоматическиПриниматьORDERS = Ложь;
	АвтоматическиПриниматьRETANN = Ложь;
	АвтоматическиПриниматьRETDES = Ложь;
	
	Если ЗначениеЗаполнено(Сообщение.Партнер) Тогда 
		
		НастройкиАвтоматическиПринимаемыхСообщений = ПолучитьСписокСвойствEDI("АвтоматическиПриниматьORDERS
																			  |АвтоматическиПриниматьRETANN
																			  |АвтоматическиПриниматьRETDES", Сообщение.Партнер);
		
		АвтоматическиПриниматьORDERS = ТипСообщения = "ORDERS" И НастройкиАвтоматическиПринимаемыхСообщений.АвтоматическиПриниматьORDERS = Истина;
		АвтоматическиПриниматьRETANN = ТипСообщения = "RETANN" И НастройкиАвтоматическиПринимаемыхСообщений.АвтоматическиПриниматьRETANN = Истина;
		АвтоматическиПриниматьRETDES = ТипСообщения = "RETDES" И НастройкиАвтоматическиПринимаемыхСообщений.АвтоматическиПриниматьRETDES = Истина;
		
	КонецЕсли;
	
	ЭтоОбратныйЗаказ1С = (ТипСообщения = "ORDERS" И Сообщение.Свойство("ОбратныйЗаказ1С") И ЗначениеЗаполнено(Сообщение.ОбратныйЗаказ1С));
	ЭтоВходящийDESADV = (ТипСообщения = "DESADV" И Сообщение.Направление = "Входящее");
	
	
	ПриниматьСообщениеАвтоматически = 
	НастройкиМодуля[ТипСообщения].ПриниматьАвтоматически 
	ИЛИ	ЭтоОбратныйЗаказ1С
	ИЛИ ЭтоВходящийDESADV
	ИЛИ АвтоматическиПриниматьORDERS
	ИЛИ АвтоматическиПриниматьRETANN
	ИЛИ АвтоматическиПриниматьRETDES;
	
	Если ПриниматьСообщениеАвтоматически Тогда
		
		// Автоматически у нас не принимаются: PORDERS и иногда ORDERS. Остальные - автоматически.
		Если ОперацииОбмена_АвтоматическиПриниматьСообщенияВОтдельнойОперации() Тогда
			СообщениеОбъект = Сообщение.СообщениеСсылка.ПолучитьОбъект();
			ОперацииОбмена_ЗаполнитьПризнакПринятьАвтоматически(Истина, СообщениеОбъект)
		Иначе
			ПринятьВходящееСообщение(Сообщение);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ОбработатьЗаказНаПеревозкуПослеСохранения_КонтурEDI(Сообщение, ПрекратитьОбработку)
	
	Статус_ВРег = ВРег(Сообщение.Статус);

	ЭтоОригиниал = (Статус_ВРег = "ORIGINAL");
	ЭтоОтмена = (Статус_ВРег = "CANCELED" ИЛИ Статус_ВРег = "ОТМЕНА");
		
	Если ЭтоОригиниал Тогда
		
		ОбработатьЗагрузкуЗаказаПеревозки(Сообщение);
		ПрекратитьОбработку = Истина;
		
	ИначеЕсли ЭтоОтмена Тогда
		
		ОбработатьОтменуЗаказаПеревозки(Сообщение);
		ПрекратитьОбработку = Истина;
		
	Иначе
		
		// ничего не делать
		
	КонецЕсли;

КонецПроцедуры

Процедура ОбработатьВозвратПослеСохранения_КонтурEDI(Сообщение, ПрекратитьОбработку)
	
	Статус_ВРег = ВРег(Сообщение.Статус);

	ЭтоОтмена = (Статус_ВРег = "CANCELED" ИЛИ Статус_ВРег = "ОТМЕНА");
	ЭтоЗамена = (Статус_ВРег = "REPLACE" ИЛИ Статус_ВРег = "ЗАМЕНА");  	
	
	Если ЭтоОтмена Тогда
		
		РезультатОбработки = ОбработатьОтменуВозврата(Сообщение);
		ПрекратитьОбработку = Истина;
		
	ИначеЕсли ЭтоЗамена Тогда
		
		РезультатОбработки = ОбработатьЗаменуВозврата(Сообщение);
		ПрекратитьОбработку = Истина;
		
	Иначе
		
		// ничего не делать
		
	КонецЕсли;

КонецПроцедуры

Процедура ОбработатьЗаказПослеСохранения_КонтурEDI(Сообщение, ПрекратитьОбработку)
	
	Статус_ВРег = ВРег(Сообщение.Статус);
	
	ЭтоОтмена = (Статус_ВРег = "CANCELED" ИЛИ Статус_ВРег = "ОТМЕНА");
	ЭтоЗамена = (Статус_ВРег = "REPLACE" ИЛИ Статус_ВРег = "ЗАМЕНА");
	
	Переоотправлять = Истина;
	
	Если ЭтоОтмена Тогда
		
		ОбработатьОтменуЗаказа(Сообщение);
		ПрекратитьОбработку = Истина;
		
	ИначеЕсли ЭтоЗамена Тогда
		
		ОбработатьЗаменуЗаказа(Сообщение);
		ПрекратитьОбработку = Истина;
		
	Иначе
		
		ПроверитьЗаказПослеСохранения_КонтурEDI(Сообщение, ПрекратитьОбработку);    
		
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьЗаказПослеСохранения_КонтурEDI(Сообщение, ПрекратитьОбработку)
	
	ВалидироватьВходящееСообщение_КонтурEDI(Сообщение, "ORDERS", ПрекратитьОбработку);
	
	Если ПрекратитьОбработку = Ложь Тогда
		
		Если Сообщение.Свойство("СписокПредварительныхЗаказов") 
			И ЗначениеЗаполнено(Сообщение.СписокПредварительныхЗаказов) Тогда
			
			СпособОбработкиПредварительныхЗаказов = ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, "СпособОбработкиПредварительныхЗаказов");
			
			Если Не ЗначениеЗаполнено(СпособОбработкиПредварительныхЗаказов) Тогда
				СпособОбработкиПредварительныхЗаказов = "Закрыть";
			КонецЕсли;
			
			Если СпособОбработкиПредварительныхЗаказов = "Закрыть" Тогда
				
				ОбработатьСписокПредварительныхЗаказов(Сообщение.СписокПредварительныхЗаказов, Сообщение.СообщениеСсылка);
				
			ИначеЕсли СпособОбработкиПредварительныхЗаказов = "Привязать документ к основному заказу" Тогда
				
				ПривязатьДокументыПредварительныхЗаказыКОсновномуЗаказу_КонтурEDI(Сообщение.СписокПредварительныхЗаказов, Сообщение);
				
			Иначе
				
				// ... ничего не делать
				
			КонецЕсли;
			
		КонецЕсли;
						
		// проверить наличие дублей у данного ORDERS
		Дубли = ПолучитьДублирующиеСообщения(Сообщение.СообщениеСсылка, Истина);
		
		Если Дубли.Количество() > 1 Тогда
			
			СтатусТекущегоСообщения = "НоваяВерсия";
			
			МагическиОбработатьДублиORDERS(Сообщение, СтатусТекущегоСообщения, Дубли);
			УстановитьСтатусСообщения_БМИ(Сообщение.СообщениеСсылка, Сообщение.ДокументСсылка, Сообщение.ТипСообщения, СтатусТекущегоСообщения);
						
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ВалидироватьВходящееСообщение_КонтурEDI(Сообщение, ТипСообщения, ПрекратитьОбработку)
	
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("Сообщение", Сообщение);   		
	РезультатВалидации = ОбработкаСобытияПодключаемогоМодуля("ПолучитьРезультатВалидацииСообщения",, ПараметрыПМ);
	
	Если РезультатВалидации <> Неопределено
		И Не РезультатВалидации.Успешно	Тогда
		
		СообщениеОбъект = ПолучитьОбъектСообщения(Сообщение.СообщениеСсылка);
		
		ЗаписатьОшибкиВалидацииВОбъектСообщения(СообщениеОбъект, РезультатВалидации.ТаблицаОшибок);
		
		УстановитьСтатусСообщения(СообщениеОбъект, Сообщение.ДокументСсылка, ТипСообщения, "ВходящийНеПрошелВалидацию");
		
		ПрекратитьОбработку = Истина
		
	КонецЕсли;

КонецПроцедуры	

//Загружает статусные сообщения, загружает основные сообщения, отправляет отчеты о доставке и исходящие сообщения, вызывает подключаемый модуль при необходимости
//из минусов - не дает вернуться на тонкий клиент при загрузке сообщений транзакциями
Процедура ВыполнитьОбменССервером(ИмяСписка="", ПараметрыОбмена = Неопределено) Экспорт
	//ИмяСписка - устаревший параметр, оставлен для совместимости со старыми подключаемыми модулями
	
	ДлительнаяОперация_Начать();
	
	ПараметрыПМ = Новый Структура("ИмяСписка,ПараметрыОбмена", ИмяСписка, ПараметрыОбмена);
	ОбработкаСобытияПодключаемогоМодуля("ПередВыполнениемОбмена",, ПараметрыПМ);
							
	//Обмен с сервером EDI
	ВыполнитьОбменССерверомEDI(ИмяСписка,ПараметрыОбмена);
	
	//Обмен дополнительных Модулей
	ВыполнитьОбменССерверомДополнительныеМодули(ПараметрыОбмена);
	
	КэшСоединений_КонтурEDI = Неопределено;//сбросим кэш, чтобы не держать FTP соединения если они были созданы в обменах
	
	ДлительнаяОперация_Завершить();
	
	Метрика_ОтправитьВсеСобытияСтека();
	
КонецПроцедуры

Процедура ВыполнитьОбменССерверомEDI(ИмяСписка="", ПараметрыОбмена) Экспорт
	
	ИсходящиеОтправлены = Ложь;
	                                   
	ПроверитьПредварительныеЗаказы();	

	Если ПараметрыОбмена <> Неопределено
		И ПараметрыОбмена.Свойство("ТипыСообщенийОтбор") 
		И ТипЗнч(ПараметрыОбмена.ТипыСообщенийОтбор) = Тип("Массив")
		И НЕ ВМассивеТиповСообщенийЕстьСообщенияEDI(ПараметрыОбмена.ТипыСообщенийОтбор) Тогда
		Возврат; //пользователь сейчас не работает ни с одним из типов сообщений EDI - не будем выполнять сейчас обмен EDI
	КонецЕсли;
	
	Если ПараметрыОбмена <> Неопределено
		И ПараметрыОбмена.Свойство("ТолькоОтправка") 
		И ПараметрыОбмена.ТолькоОтправка = Истина Тогда
		ПодготовитьАвтоматическиОтправляемыеСообщения();
		Если МожноОтправитьВАрхиве() Тогда 
			ОтправитьСообщенияОжидающиеОтправкиПакетом();	
		Иначе
			ОтправитьСообщенияОжидающиеОтправки();
		КонецЕсли;
		ИсходящиеОтправлены = Истина;
		ОтправитьALCRPT();
		ОтправитьPRICELISTПоРасписанию();
		Возврат; //не следует загружать сообщения
	КонецЕсли;
	
	Если Не ЗагрузитьНовыеСообщения(ИмяСписка) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ИсходящиеОтправлены Тогда 
		ПодготовитьАвтоматическиОтправляемыеСообщения();
		Если МожноОтправитьВАрхиве() Тогда 
			ОтправитьСообщенияОжидающиеОтправкиПакетом();	
		Иначе
			ОтправитьСообщенияОжидающиеОтправки();
		КонецЕсли;
		ОтправитьALCRPT();
		ОтправитьPRICELISTПоРасписанию();
	КонецЕсли;
	
	ОтправитьУведомленияОПрочтенииСообщений();
	
	//пишем строкой, т.к. по умолчанию в РС Дата+Время обрезается до Даты
	УстановитьКонстантуEDI("ДатаПоследнегоВыполненияОбмена",Формат(ТекущаяДата(),"ДФ='dd.MM.yyyy HH:mm:ss'"));
	
КонецПроцедуры

Функция ВМассивеТиповСообщенийЕстьСообщенияEDI(МассивТиповСообщений)
	
	ЕстьEDIСообщение = Ложь;
	МассивВсехТиповСообщенийEDI = ПолучитьМассивТиповСообщенийEDI();
	Для Каждого ТипСообщения Из МассивТиповСообщений Цикл
		Если НЕ МассивВсехТиповСообщенийEDI.Найти(ТипСообщения) = Неопределено Тогда
			ЕстьEDIСообщение = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
    Возврат ЕстьEDIСообщение;
	
КонецФункции // ВМассивеТиповСообщенийЕстьСообщенияEDI()

Процедура ВыполнитьОбменССерверомДополнительныеМодули(ПараметрыОбмена) Экспорт
	
	ОбработкаСобытияПодключаемогоМодуля("ВыполнитьОбменДополнительныйМодуль",,
	Новый Структура("ПараметрыОбмена",
	ПараметрыОбмена));
	
	НужноВыполнитьОбменМеркурий = Истина;
	Если ПараметрыОбмена <> Неопределено
		И ПараметрыОбмена.Свойство("ТипыСообщенийОтбор") 
		И ТипЗнч(ПараметрыОбмена.ТипыСообщенийОтбор) = Тип("Массив") Тогда
		НужноВыполнитьОбменМеркурий = Ложь;
		МассивВсехТиповСообщенийМеркурия = ПолучитьМассивТиповСообщенийМеркурия();
		Для Каждого ТипСообщения Из ПараметрыОбмена.ТипыСообщенийОтбор Цикл
			Если НЕ МассивВсехТиповСообщенийМеркурия.Найти(ТипСообщения) = Неопределено Тогда
				НужноВыполнитьОбменМеркурий = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если НужноВыполнитьОбменМеркурий = истина Тогда
		ВыполнитьМетодМодуляМеркурий("МеркурийОбновитьСтатусыТранзакций",ПараметрыОбмена);
	КонецЕсли;
	
КонецПроцедуры

Функция ПараметрыОбменаССервером() Экспорт

	ПараметрыОбмена = Новый Структура;
	ПараметрыОбмена.Вставить("ТипыСообщенийОтбор", Неопределено);
	ПараметрыОбмена.Вставить("ЭтоФоновоеЗадание", Неопределено);
	ПараметрыОбмена.Вставить("ТолькоОтправка"	, Ложь);

	Возврат ПараметрыОбмена;

КонецФункции // ПараметрыОбменаССервером()

// Смотрит в настройки партнеров "Автоотправка", и если они активированы,
// отправляет сообщения PORDERS,ORDRSP,DESADV,INVOIC,COINVOIC в режиме поставщика
// и сообщения ORDERS,RECADV в режиме покупателя
//
Процедура ПодготовитьАвтоматическиОтправляемыеСообщения()
	
	СтандартнаяОбработкаEDI = Истина;
	ОбработкаСобытияПодключаемогоМодуля("ПередПодготовкойАвтоматическиОтправляемыхСообщений", СтандартнаяОбработкаEDI);
	
	Если НЕ СтандартнаяОбработкаEDI = Истина Тогда
		Возврат;
	КонецЕсли;
	
	ДоступныеПартнеры = ДоступныеПартнерыПользователюEDI();
	ТаблицаНастроекАвтоотправкиПартнеров = ТаблицаНастроекАвтоотправкиПартнеров(ДоступныеПартнеры);
	
	Если ТаблицаНастроекАвтоотправкиПартнеров.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПодготовки = ПараметрыПодготовкиАвтоматическиОтправляемыхСообщений();	
	ЗаполнитьПараметрыПодготовкиАвтоматическиОтправляемыхСообщений_Общие(ПараметрыПодготовки);
	
	ЗаполнитьПараметрыПодготовкиАвтоматическиОтправляемыхСообщений_Поставщик(ПараметрыПодготовки, ТаблицаНастроекАвтоотправкиПартнеров);
	ПодготовитьАвтоматическиОтправляемыеСообщенияДляРежимаРаботы(ПараметрыПодготовки, ТаблицаНастроекАвтоотправкиПартнеров);	
	
	ЗаполнитьПараметрыПодготовкиАвтоматическиОтправляемыхСообщений_Покупатель(ПараметрыПодготовки, ТаблицаНастроекАвтоотправкиПартнеров);
	ПодготовитьАвтоматическиОтправляемыеСообщенияДляРежимаРаботы(ПараметрыПодготовки, ТаблицаНастроекАвтоотправкиПартнеров);
	
	ПараметрыОбмена = ПараметрыОбменаССервером();
	ПараметрыОбмена.Вставить("ЭтоФоновоеЗадание", Истина);
	ПараметрыВыполнения = Новый Структура("ВОтдельномФоновомЗадании, ПараметрыОбмена", ФоновыеЗаданияКонтурEDI_Доступны(), ПараметрыОбмена);
	ОперацииОбмена_ЗапуститьОперацию("ОперацииОбмена_ОтправитьСообщенияОжидающиеОтправки", ПараметрыВыполнения);
	
КонецПроцедуры

Процедура ОбработатьТаблицуАвтоматическиПодготавливаемыхСообщений(ТаблицаДокументовСообщений, ТаблицаНастроекАвтоотправкиПартнеров, РежимРаботы)
	
	Для каждого НастройкаАвтоотправки Из ТаблицаНастроекАвтоотправкиПартнеров Цикл
		
		Если РежимРаботы = "Поставщик" И НастройкаАвтоотправки.ПартнерКакТорговаяСеть = Ложь Тогда
			Продолжить;
		КонецЕсли;
		Если РежимРаботы = "Покупатель" И НастройкаАвтоотправки.ПартнерКакПоставщик = Ложь Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыПоиска = Новый Структура;
		ПараметрыПоиска.Вставить("ТипСообщения", НастройкаАвтоотправки.ТипСообщения);
		ПараметрыПоиска.Вставить("Партнер", НастройкаАвтоотправки.Партнер);
		
		СтрокиНаОтправку = ТаблицаДокументовСообщений.НайтиСтроки(ПараметрыПоиска);	
		
		Если СтрокиНаОтправку.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Метрика_ИдЗамера = Метрика_НовыйУИД();
		Метрика_НачатьЗамер(Метрика_ИдЗамера, "ПодготовитьАвтоматическиОтправляемыеСообщения");
		Метрика_МассивСообщений = Новый Массив;
		
		Для Каждого СтрокаСообщения Из СтрокиНаОтправку Цикл
			
			Метрика_ВремяНачала = Метрика_ОтметкаВремени();
			СтандартнаяОбработкаEDI = Истина;
			ПараметрыСобытияПМ = Новый Структура("СтрокаСообщения,ТипСообщения", СтрокаСообщения, НастройкаАвтоотправки.ТипСообщения);
			
			ОбработкаСобытияПодключаемогоМодуля("ПередАвтоотправкойСообщения", СтандартнаяОбработкаEDI, ПараметрыСобытияПМ);
			
			Если СтандартнаяОбработкаEDI = Истина Тогда
				
				ПараметрыПодготовки = Новый Структура;
				ПараметрыПодготовки.Вставить("СообщениеСсылка", СтрокаСообщения.СообщениеСсылка);
				
				Сообщение = ПодготовитьИсходящееСообщение(НастройкаАвтоотправки.ТипСообщения, СтрокаСообщения.Документ, ПараметрыПодготовки);
				
				Если НЕ (Сообщение.СодержитОшибки = Истина) Тогда

					Если МожноОтправитьВАрхиве() Тогда 
						СохранитьСообщение(Сообщение);
					Иначе 
						ПараметрыОтправки = Новый Структура;
						ПараметрыОтправки.Вставить("ОтправитьСообщениеИзФормы",	Истина);
						ПараметрыОтправки.Вставить("Сообщение",	Сообщение);
						ОтправитьСообщение(НастройкаАвтоотправки.ТипСообщения, СтрокаСообщения.Документ, ПараметрыОтправки);
						Сообщить_КонтурEDI("Создано сообщение: " + НастройкаАвтоотправки.ТипСообщения + " по документу: " + СтрокаСообщения.Документ);
					КонецЕсли;
						
				КонецЕсли;
				
			КонецЕсли;
			
			Метрика_ВремяОкончания = Метрика_ОтметкаВремени();
			СтруктураЗамера = Новый Структура(НастройкаАвтоотправки.ТипСообщения, Метрика_Длительность(Метрика_ВремяНачала, Метрика_ВремяОкончания));
			Метрика_МассивСообщений.Добавить(СтруктураЗамера);
			
		КонецЦикла;
		
		Метрика_Переменные = Новый Структура;
		Метрика_Переменные.Вставить("КоличествоСообщений", СтрокиНаОтправку.Количество());	
		Метрика_Переменные.Вставить("МассивСообщений", Метрика_МассивСообщений);	
		Метрика_ЗакончитьЗамер(Метрика_ИдЗамера, "ПодготовитьАвтоматическиОтправляемыеСообщения", , , , Метрика_Переменные);
	
	КонецЦикла;
	
КонецПроцедуры

Функция ТаблицаНастроекАвтоотправкиПартнеров(ДоступныеПартнеры)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_ДополнительныеСправочники.Ссылка КАК Партнер,
	|	ВЫРАЗИТЬ(КонтурEDI_ДополнительныеРеквизиты_Автоотправка.Свойство КАК СТРОКА) КАК ИмяНастройки,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(КонтурEDI_ДополнительныеРеквизиты_Поставщик.Значение КАК БУЛЕВО), ЛОЖЬ) КАК ПартнерКакПоставщик,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(КонтурEDI_ДополнительныеРеквизиты_Сеть.Значение КАК БУЛЕВО), ЛОЖЬ) КАК ПартнерКакТорговаяСеть
	|ИЗ
	|	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеРеквизиты_Автоотправка
	|		ПО КонтурEDI_ДополнительныеСправочники.Ссылка = КонтурEDI_ДополнительныеРеквизиты_Автоотправка.Объект
	|			И (КонтурEDI_ДополнительныеСправочники.Ссылка В (&ДоступныеПартнеры))
	|			И (КонтурEDI_ДополнительныеРеквизиты_Автоотправка.Свойство ПОДОБНО ""Автоотправка_%"")
	|			И (КонтурEDI_ДополнительныеРеквизиты_Автоотправка.Значение = ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеРеквизиты_Поставщик
	|		ПО КонтурEDI_ДополнительныеСправочники.Ссылка = КонтурEDI_ДополнительныеРеквизиты_Поставщик.Объект
	|			И (КонтурEDI_ДополнительныеРеквизиты_Поставщик.Свойство = ""ПартнерКакПоставщик"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеРеквизиты_Сеть
	|		ПО КонтурEDI_ДополнительныеСправочники.Ссылка = КонтурEDI_ДополнительныеРеквизиты_Сеть.Объект
	|			И (КонтурEDI_ДополнительныеРеквизиты_Сеть.Свойство = ""ПартнерКакТорговаяСеть"")";
	
	Запрос.УстановитьПараметр("ДоступныеПартнеры", ДоступныеПартнеры);
	
	ТаблицаНастроекАвтоотправкиПартнеров = Запрос.Выполнить().Выгрузить();
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаНастроекАвтоотправкиПартнеров, "ТипСообщения", ОписаниеТипаСтрока_КонтурEDI());
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаНастроекАвтоотправкиПартнеров, "ПорядокСообщения", ОписаниеТипаЧисло_КонтурEDI());
	
	НачальныйСимволТипаСообщения = 14;
	
	Для каждого Строка Из ТаблицаНастроекАвтоотправкиПартнеров Цикл
		
		ТипСообщения = Сред(Строка.ИмяНастройки, НачальныйСимволТипаСообщения);
		
		Строка.ТипСообщения = ТипСообщения;
		Строка.ПорядокСообщения = ПолучитьПорядокСообщенияВЦепочке(ТипСообщения);
	
	КонецЦикла;
	
	ТаблицаНастроекАвтоотправкиПартнеров.Сортировать("ПорядокСообщения");
	
	Возврат ТаблицаНастроекАвтоотправкиПартнеров;
	
КонецФункции

Функция ПараметрыПодготовкиАвтоматическиОтправляемыхСообщений()
	
	Структура = Новый Структура;
	Структура.Вставить("РежимРаботы");
	Структура.Вставить("МассивПартнеров");
	Структура.Вставить("МассивОрганизаций");
	Структура.Вставить("МассивТребуемыхДействий");
	Структура.Вставить("МассивТиповСообщений");
	Структура.Вставить("НачалоПериода");
	Структура.Вставить("КонецПериода");
	Структура.Вставить("ПоказыватьЗавершенные");
	
	Возврат Структура; 
	
КонецФункции

Процедура ЗаполнитьПараметрыПодготовкиАвтоматическиОтправляемыхСообщений_Общие(ПараметрыПодготовки)
	
	ПериодПодготовкиАвтоматическихОтправляемыхСообщений_ВДнях = ПериодПодготовкиАвтоматическихОтправляемыхСообщений();
	СекундВОдномДне = 60*60*24;
	
	НачалоПериода = НачалоДня(ТекущаяДата() - СекундВОдномДне * ПериодПодготовкиАвтоматическихОтправляемыхСообщений_ВДнях);
	КонецПериода = КонецДня(ТекущаяДата() + СекундВОдномДне * ПериодПодготовкиАвтоматическихОтправляемыхСообщений_ВДнях);
	
	ПараметрыПодготовки.НачалоПериода = НачалоПериода;
	ПараметрыПодготовки.КонецПериода = КонецПериода;
	ПараметрыПодготовки.МассивОрганизаций = ДоступныеОрганизацииПользователюEDI();
	ПараметрыПодготовки.ПоказыватьЗавершенные = Ложь;
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыПодготовкиАвтоматическиОтправляемыхСообщений_Поставщик(ПараметрыПодготовки, ТаблицаНастроекАвтоотправкиПартнеров)
	
	МассивТребуемыхДействий	= Новый Массив;
	МассивТребуемыхДействий.Добавить("Отправить обратный заказ");
	МассивТребуемыхДействий.Добавить("Отправить подтверждение заказа");
	МассивТребуемыхДействий.Добавить("Отправить подтверждение предварительного заказа");
	МассивТребуемыхДействий.Добавить("Отправить уведомление об отгрузке");
	МассивТребуемыхДействий.Добавить("Отправить счет-фактуру");
	МассивТребуемыхДействий.Добавить("Отправить корректировочный счет-фактуру");
	
	МассивТиповСообщений = EDI_РазложитьСтрокуВМассивСлов("PORDERS,ORDRSP,DESADV,INVOIC,COINVOIC", ",");
	НедоступныеСообщения = ПараметрыПользователяEDI.НедоступныеСообщения;
	
	Если ЗначениеЗаполнено(НедоступныеСообщения) Тогда
		МассивИсключений = НедоступныеСообщения.ВыгрузитьЗначения();
		МассивТиповСообщений = ИсключитьЗначенияМассива(МассивТиповСообщений, МассивИсключений);
	КонецЕсли;
	
	МассивПартнеров = Новый Массив;
	
	Для каждого Строка Из ТаблицаНастроекАвтоотправкиПартнеров Цикл
	
		Если Строка.ПартнерКакТорговаяСеть = Истина Тогда
			
			Если МассивПартнеров.Найти(Строка.Партнер) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			МассивПартнеров.Добавить(Строка.Партнер);
			
		КонецЕсли;
	
	КонецЦикла;
	
	ПараметрыПодготовки.МассивТребуемыхДействий = МассивТребуемыхДействий;
	ПараметрыПодготовки.МассивТиповСообщений = МассивТиповСообщений;
	ПараметрыПодготовки.МассивПартнеров = МассивПартнеров;
	ПараметрыПодготовки.РежимРаботы = "Поставщик";
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыПодготовкиАвтоматическиОтправляемыхСообщений_Покупатель(ПараметрыПодготовки, ТаблицаНастроекАвтоотправкиПартнеров)
	
	МассивТребуемыхДействий	= Новый Массив;
	МассивТребуемыхДействий.Добавить("Отправить заказ");
	МассивТребуемыхДействий.Добавить("Отправить уведомление о приемке");
	
	МассивТиповСообщений = EDI_РазложитьСтрокуВМассивСлов("ORDERS,RECADV", ",");
	НедоступныеСообщения = ПараметрыПользователяEDI.НедоступныеСообщения;
	
	Если ЗначениеЗаполнено(НедоступныеСообщения) Тогда
		МассивИсключений = НедоступныеСообщения.ВыгрузитьЗначения();
		МассивТиповСообщений = ИсключитьЗначенияМассива(МассивТиповСообщений, МассивИсключений);
	КонецЕсли;
	
	МассивПартнеров = Новый Массив;
	
	Для каждого Строка Из ТаблицаНастроекАвтоотправкиПартнеров Цикл
	
		Если Строка.ПартнерКакПоставщик = Истина Тогда
			
			Если МассивПартнеров.Найти(Строка.Партнер) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			МассивПартнеров.Добавить(Строка.Партнер);
			
		КонецЕсли;
	
	КонецЦикла;

	ПараметрыПодготовки.МассивТребуемыхДействий = МассивТребуемыхДействий;
	ПараметрыПодготовки.МассивТиповСообщений = МассивТиповСообщений;
	ПараметрыПодготовки.МассивПартнеров = МассивПартнеров;
	ПараметрыПодготовки.РежимРаботы = "Покупатель";
	
КонецПроцедуры

Функция ПериодПодготовкиАвтоматическихОтправляемыхСообщений()
	
	ПериодПодготовкиАвтоматическихОтправляемыхСообщений = ПолучитьКонстантуEDI("ПериодПодготовкиАвтоОтправляемыхСообщений");
	
	Если Не ЗначениеЗаполнено(ПериодПодготовкиАвтоматическихОтправляемыхСообщений) 
		ИЛИ ТипЗнч(ПериодПодготовкиАвтоматическихОтправляемыхСообщений) <> Тип("Число") Тогда
		
		ПериодПодготовкиАвтоматическихОтправляемыхСообщений = 3;
		
	КонецЕсли;
	
	Возврат ПериодПодготовкиАвтоматическихОтправляемыхСообщений;
	
КонецФункции

Процедура ПодготовитьАвтоматическиОтправляемыеСообщенияДляРежимаРаботы(ПараметрыПодготовки, ТаблицаНастроекАвтоотправкиПартнеров)
	
	ОбновитьКэшПартнеров(ПараметрыПодготовки.РежимРаботы);
	
	НеобходимоПодготовитьСообщения = ПроверитьНеобходимостьПодготовкиАвтоматическиОтправляемыхСообщений(ПараметрыПодготовки.РежимРаботы);
	
	Если НеобходимоПодготовитьСообщения = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ЗапросСКэшемПартнеров = ИнициализироватьЗапросСКэшемПартнеров(, 
		ПараметрыПодготовки.НачалоПериода, 
		ПараметрыПодготовки.КонецПериода, 
		ПараметрыПодготовки.МассивПартнеров);
		
	ЗапросСКэшемПартнеров.УстановитьПараметр("ТребуемыеДействия", ПараметрыПодготовки.МассивТребуемыхДействий);
	ЗапросСКэшемПартнеров.УстановитьПараметр("ТипыСообщений", ПараметрыПодготовки.МассивТиповСообщений);
		
	МассивВременныхТаблиц = Новый Массив;
	
	СформироватьВременныеТаблицыДокументов(ПараметрыПодготовки.РежимРаботы, ЗапросСКэшемПартнеров);
	СформироватьВременныеТаблицыСообщений(ЗапросСКэшемПартнеров, МассивВременныхТаблиц, ПараметрыПодготовки.НачалоПериода, ПараметрыПодготовки.КонецПериода);
	СформироватьСписокСообщений(ПараметрыПодготовки.РежимРаботы, 
		ЗапросСКэшемПартнеров, 
		МассивВременныхТаблиц, 
		ПараметрыПодготовки.НачалоПериода,
		ПараметрыПодготовки.КонецПериода,
		ПараметрыПодготовки.МассивПартнеров,
		ПараметрыПодготовки.МассивТиповСообщений,
		ПараметрыПодготовки.МассивТребуемыхДействий,
		ПараметрыПодготовки.МассивОрганизаций,
		ПараметрыПодготовки.ПоказыватьЗавершенные);
	
	СформироватьТаблицыАвтоматическиОтправляемыхСообщений(ЗапросСКэшемПартнеров, МассивВременныхТаблиц, ПараметрыПодготовки.РежимРаботы);
	
	ТаблицаДокументовСообщений = Новый ТаблицаЗначений;
	ВывестиСписокДокументовСообщений(ПараметрыПодготовки.РежимРаботы, 
		ЗапросСКэшемПартнеров, 
		МассивВременныхТаблиц, 
		ПараметрыПодготовки.МассивТребуемыхДействий, 
		ПараметрыПодготовки.МассивОрганизаций, 
		ТаблицаДокументовСообщений);
		
	ОбработатьТаблицуАвтоматическиПодготавливаемыхСообщений(ТаблицаДокументовСообщений, ТаблицаНастроекАвтоотправкиПартнеров, ПараметрыПодготовки.РежимРаботы);	
	
КонецПроцедуры

Функция ПроверитьНеобходимостьПодготовкиАвтоматическиОтправляемыхСообщений(РежимРаботы)
	
	НеобходимоПодготовитьСообщения = Истина;
	
	Если РежимРаботы = "Поставщик" И НЕ НастройкиМодуля.МыПоставщик Тогда
		
		НеобходимоПодготовитьСообщения = Ложь;
		
	КонецЕсли;
	
	Если РежимРаботы = "Покупатель" И НЕ НастройкиМодуля.МыТорговаяСеть Тогда
		
		НеобходимоПодготовитьСообщения = Ложь;
		
	КонецЕсли;
	
	Возврат НеобходимоПодготовитьСообщения; 
	
КонецФункции

Процедура СформироватьТаблицыАвтоматическиОтправляемыхСообщений(ЗапросСКэшемПартнеров, МассивВременныхТаблиц, РежимРаботы)
	
	Если РежимРаботы = "Поставщик" Тогда
		
		ВывестиСписокЗаказов_ДляОтправкиPORDERS(ЗапросСКэшемПартнеров, МассивВременныхТаблиц);
		СформироватьСписокДокументов_ДляОтправкиОжиданияСообщений(РежимРаботы, ЗапросСКэшемПартнеров, МассивВременныхТаблиц, "ORDRSP");
		СформироватьСписокДокументов_ДляОтправкиОжиданияСообщений(РежимРаботы, ЗапросСКэшемПартнеров, МассивВременныхТаблиц, "DESADV");
		СформироватьСписокДокументов_ДляОтправкиОжиданияСообщений(РежимРаботы, ЗапросСКэшемПартнеров, МассивВременныхТаблиц, "INVOIC");
		СформироватьСписокДокументов_ДляОтправкиКоррИспрINVOIC(ЗапросСКэшемПартнеров, МассивВременныхТаблиц);
		
	КонецЕсли;
	
	Если РежимРаботы = "Покупатель" Тогда
		
		СформироватьСписокДокументов_ДляОтправкиОжиданияСообщений(РежимРаботы, ЗапросСКэшемПартнеров, МассивВременныхТаблиц, "ORDERS");
		СформироватьСписокДокументов_ДляОтправкиОжиданияСообщений(РежимРаботы, ЗапросСКэшемПартнеров, МассивВременныхТаблиц, "RECADV");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьВременныеТаблицыСообщений(ЗапросСКэшемПартнеров, МассивВременныхТаблиц, НачалоПериода, КонецПериода)

	ЗапросСКэшемПартнеров.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_Сообщения.Ссылка,
	|	КонтурEDI_Сообщения.Партнер,
	|	КонтурEDI_Сообщения.Архив,
	|	КонтурEDI_Сообщения.Документ,
	|	КонтурEDI_Сообщения.ТипСообщения,
	|	КонтурEDI_Сообщения.Статус,
	|	КонтурEDI_Сообщения.ОтклоненоОтправителем
	|ПОМЕСТИТЬ КонтурEDI_Блокирующие_Первичный_Отбор
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|ГДЕ
	|	КонтурEDI_Сообщения.ДатаДокумента > НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&НачалоПериода, МЕСЯЦ, -2), ДЕНЬ)
	|	И КонтурEDI_Сообщения.ТипСообщения В(&МассивБлокирующихТипов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА КонтурEDI_Сообщения.ТипСообщения = ""PORDERS""
	|				ТОГДА 1
	|			КОГДА КонтурEDI_Сообщения.ТипСообщения = ""ORDERS""
	|				ТОГДА 2
	|			КОГДА КонтурEDI_Сообщения.ТипСообщения = ""ORDRSP""
	|				ТОГДА 3
	|			КОГДА КонтурEDI_Сообщения.ТипСообщения = ""DESADV""
	|				ТОГДА 4
	|			КОГДА КонтурEDI_Сообщения.ТипСообщения = ""RECADV""
	|				ТОГДА 5
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ХронологияСообщения,
	|	КонтурEDI_Сообщения.Документ
	|ПОМЕСТИТЬ ВТ_ХронологияСуществующихСообщений
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|ГДЕ
	|	КонтурEDI_Сообщения.ДатаДокумента > НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&НачалоПериода, МЕСЯЦ, -1), ДЕНЬ)
	|	И КонтурEDI_Сообщения.ТипСообщения В(&МассивБлокирующихТипов)
	|	И КонтурEDI_Сообщения.Документ <> НЕОПРЕДЕЛЕНО
	|
	|СГРУППИРОВАТЬ ПО
	|	КонтурEDI_Сообщения.Документ";
	
	МассивБлокирующихТипов = ПолучитьМассивБлокирующихТипов();
	
	ЗапросСКэшемПартнеров.УстановитьПараметр("МассивБлокирующихТипов", МассивБлокирующихТипов);
	ЗапросСКэшемПартнеров.УстановитьПараметр("НачалоПериода", НачалоПериода);
	ЗапросСКэшемПартнеров.УстановитьПараметр("КонецПериода",  КонецПериода);
	
	ЗапросСКэшемПартнеров.Выполнить();
	
КонецПроцедуры

// Функция - Получить массив блокирующих типов
// 
// Возвращаемое значение 
//   - МассивБлокирующихТипов: Массив имен типов сообщений, которые используются в EDI для блокирования следующих сообщений:
//
Функция ПолучитьМассивБлокирующихТипов()
	
	МассивБлокирующихТипов = Новый Массив;
	
	МассивБлокирующихТипов.Добавить("PORDERS");
	МассивБлокирующихТипов.Добавить("ORDERS");
	МассивБлокирующихТипов.Добавить("ORDRSP");
	МассивБлокирующихТипов.Добавить("DESADV");
	МассивБлокирующихТипов.Добавить("RECADV");
	МассивБлокирующихТипов.Добавить("INVOIC");
	МассивБлокирующихТипов.Добавить("RETANN");
	МассивБлокирующихТипов.Добавить("RETINS");
	МассивБлокирующихТипов.Добавить("RETDES");
	МассивБлокирующихТипов.Добавить("RETREC");
	
	Возврат МассивБлокирующихТипов;

КонецФункции

//возвращает Истина, если загрузка новых сообщений прошла успешно или была перехвачена в подключаемом модуле
Функция ЗагрузитьНовыеСообщения(ИмяСписка = "", ТипСообщенияДляОбработки = Неопределено) Экспорт
	
	СтандартнаяОбработкаEDI = Истина;
	
	Параметры = Новый Структура("ИмяСписка, ТипСообщения", ИмяСписка, ТипСообщенияДляОбработки);
	ОбработкаСобытияПодключаемогоМодуля("ПередЗагрузкойНовыхСообщений", СтандартнаяОбработкаEDI, Параметры);
	
	Если СтандартнаяОбработкаEDI = Истина Тогда
		
		Если НастройкиМодуля.ПротоколОбмена_КонтурEDI = "API" Тогда
			
			ЗагрузитьНовыеСообщения_API(ТипСообщенияДляОбработки);
			
		ИначеЕсли НастройкиМодуля.ПротоколОбмена_КонтурEDI = "Каталог" Тогда
			
			ЗагрузитьНовыеСообщения_Каталог(ТипСообщенияДляОбработки);
			
		ИначеЕсли НастройкиМодуля.ПротоколОбмена_КонтурEDI = "FTP" Тогда
			
			ЗагрузитьНовыеСообщения_FTP(ТипСообщенияДляОбработки);
			
		ИначеЕсли НастройкиМодуля.ПротоколОбмена_КонтурEDI = "DialMail" Тогда
			
			ЗагрузитьНовыеСообщения_DialMail(ТипСообщенияДляОбработки);
			
		КонецЕсли;
			
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура ЗагрузитьНовыеСообщения_API(ТипСообщенияДляОбработки = Неопределено)
	
	УчетныеЗаписи 	= ПолучитьСписокЭлементовСправочника("УчетныеЗаписи");
	НашиОрганизации = ПолучитьСписокЭлементовСправочника("НашиОрганизации");
	
	Для каждого СтрокаУчетнаяЗапись из УчетныеЗаписи Цикл 
		
		Если СтрокаУчетнаяЗапись.НеАктивна Тогда 
			Продолжить;
		КонецЕсли;
		
		УчетнаяЗапись = ПолучитьЭлементСправочника("УчетныеЗаписи", СтрокаУчетнаяЗапись.Ссылка);
		
		Отбор = Новый Структура("GLN, Неактивная", СтрокаУчетнаяЗапись.GLN, Ложь);
		ОрганизацииУчетнойЗаписи = НашиОрганизации.НайтиСтроки(Отбор);
		
		Для каждого ОрганизацияУчетнойЗаписи из ОрганизацииУчетнойЗаписи Цикл 
			
			СтрокиЯщиков = ПолучитьСписокЭлементовСправочника("ТранспортныеЯщики", ОрганизацияУчетнойЗаписи.Ссылка);
			ОбработкаСобытияПодключаемогоМодуля("ОтфильтроватьЯщикиДляПолученияСообщений",,Новый Структура("СтрокиЯщиков", СтрокиЯщиков));
			
			Для каждого СтрокаЯщик из СтрокиЯщиков Цикл 
				
				Если СтрокаЯщик.НеАктивный Тогда
					Продолжить;
				КонецЕсли;
				
				ТранспортныйЯщикСсылка = СтрокаЯщик.Ссылка;
				
				Если ТипСообщенияДляОбработки = Неопределено Тогда
					ОбъектБлокировки = ТранспортныйЯщикСсылка.ПолучитьОбъект();					
				Иначе
					ОбъектБлокировки = БлокировкаТранспортногоЯщикаОбъект_КонтурEDI(ТранспортныйЯщикСсылка, ТипСообщенияДляОбработки);
				КонецЕсли;
				
				ЗаблокированУспешно = ЗаблокироватьТранспортныйЯщикОрганизации(ОбъектБлокировки);
				
				Если ЗаблокированУспешно = Ложь Тогда
					Продолжить;
				КонецЕсли;
				
				Попытка
					
					ЗагрузитьНовыеСообщения_API_ИзЯщика(УчетнаяЗапись, СтрокаЯщик.Ссылка, ТипСообщенияДляОбработки);
					
				Исключение 
					
					ТекстОшибки = "Не удалось загрузить сообщения по причине: " + ОписаниеОшибки(); 
					ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);	
					Сообщить_КонтурEDI(ТекстОшибки);
					
				КонецПопытки;
				
				Если ОбъектБлокировки.Заблокирован() Тогда
					ОбъектБлокировки.Разблокировать();
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция БлокировкаТранспортногоЯщикаОбъект_КонтурEDI(ТранспортныйЯщикСсылка, ТипСообщенияДляОбработки)
	
	БлокировкаТранспортногоЯщика = НайтиБлокировкуТранспортногоЯщика_КонтурEDI(ТранспортныйЯщикСсылка, ТипСообщенияДляОбработки);
	
	Если БлокировкаТранспортногоЯщика = Неопределено Тогда
		
		ОбъектБлокировки = Справочники.КонтурEDI_ДополнительныеСправочники.СоздатьЭлемент();
		ОбъектБлокировки.Наименование = КонтурСтандарт_СтрШаблон_("%1_%2", ТранспортныйЯщикСсылка, ТипСообщенияДляОбработки);
		ОбъектБлокировки.ИмяСправочника = "БлокировкаТранспортногоЯщика";
		
		СтрокаРеквизита = ОбъектБлокировки.ДополнительныеРеквизиты.Добавить();
		СтрокаРеквизита.ИмяРеквизита = "ТранспортныйЯщик";
		СтрокаРеквизита.Значение = ТранспортныйЯщикСсылка;
		
		СтрокаРеквизита = ОбъектБлокировки.ДополнительныеРеквизиты.Добавить();
		СтрокаРеквизита.ИмяРеквизита = "ТипСообщения";
		СтрокаРеквизита.Значение = ТипСообщенияДляОбработки;
		
		ОбъектБлокировки.Записать();
		
	Иначе
		ОбъектБлокировки = БлокировкаТранспортногоЯщика.ПолучитьОбъект();	
	КонецЕсли;
	
	Возврат ОбъектБлокировки;

КонецФункции

Функция НайтиБлокировкуТранспортногоЯщика_КонтурEDI(ТранспортныйЯщикСсылка, ТипСообщенияДляОбработки)
	
	БлокировкаТранспортногоЯщика = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ДанныеОТранспортныхЯщиках
	|ИЗ
	|	Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты
	|ГДЕ
	|	КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.ИмяРеквизита = ""ТранспортныйЯщик""
	|	И КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.Значение = &ТранспортныйЯщик
	|	И КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.Ссылка.ИмяСправочника = ""БлокировкаТранспортногоЯщика""
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеОТранспортныхЯщиках.Ссылка КАК Ссылка
	|ИЗ
	|	ДанныеОТранспортныхЯщиках КАК ДанныеОТранспортныхЯщиках
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты
	|		ПО ДанныеОТранспортныхЯщиках.Ссылка = КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.Ссылка
	|			И (КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.ИмяРеквизита = ""ТипСообщения"")
	|			И (КонтурEDI_ДополнительныеСправочникиДополнительныеРеквизиты.Значение = &ТипСообщения)";
	
	Запрос.УстановитьПараметр("ТипСообщения", ТипСообщенияДляОбработки);
	Запрос.УстановитьПараметр("ТранспортныйЯщик", ТранспортныйЯщикСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		БлокировкаТранспортногоЯщика = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Возврат БлокировкаТранспортногоЯщика;

КонецФункции

Функция ЗаблокироватьТранспортныйЯщикОрганизации(ТранспортныйЯщикОбъект) Экспорт
	
	ЗаблокированУспешно = Истина;
	
	Если ПолучитьКонстантуEDI("БлокироватьТранспортныйЯщикПриОбменеССервером") = Ложь Тогда
		Возврат ЗаблокированУспешно;
	КонецЕсли;
		
	Попытка
		
		ТранспортныйЯщикОбъект.Заблокировать(); 		
		
	Исключение 
		
		ЗаблокированУспешно = Ложь;
		ТекстКомментарияДляПользователя = "В другом сеансе уже выполняется загрузка сообщений " +
			"или редактируются параметры транспортного ящика. Попробуйте позже или отключите блокировку одновременного запуска обмена с сервером в общих настройках.";
		Сообщить_КонтурEDI(ТекстКомментарияДляПользователя);
		ТекстКомментарияДляЖурнала = ТекстКомментарияДляПользователя + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации_КонтурEDI(
			УровеньЖурналаРегистрации.Информация, ТекстКомментарияДляЖурнала, ТранспортныйЯщикОбъект.Ссылка);	
		
	КонецПопытки;
	
	Возврат ЗаблокированУспешно;
	
КонецФункции

Функция ПолучитьПараметры_ПолучитьСобытияЯщика_EDI(ИдентификаторПоследнегоСобытия)
	
	ИдентификаторПоследнегоСобытия_Датой = Неопределено;
	ИдентификаторПоследнегоСобытия_УИД 	 = Неопределено;
	
	Если СтрДлина(ИдентификаторПоследнегоСобытия) = 8 Тогда
		Попытка
			ИдентификаторПоследнегоСобытия_Датой = Дата(ИдентификаторПоследнегоСобытия);
			
		Исключение
			ВызватьИсключение "Неправильная дата последнего события в настройках транспортного ящика";
		КонецПопытки;
	ИначеЕсли СтрДлина(ИдентификаторПоследнегоСобытия) = 14 Тогда
		Попытка
			ИдентификаторПоследнегоСобытия_Датой = Дата(ИдентификаторПоследнегоСобытия);
		Исключение
			ВызватьИсключение "Неправильная дата и время последнего события в настройках транспортного ящика";
		КонецПопытки;
	Иначе
		Попытка
			ИдентификаторПоследнегоСобытия_УИД = Новый УникальныйИдентификатор(ИдентификаторПоследнегоСобытия);
		Исключение
			ВызватьИсключение "Неправильный ID последнего сообщения в настройках транспортного ящика";
		КонецПопытки;
	КонецЕсли;
	
	Параметры = Новый Структура;
	
	Если НЕ ИдентификаторПоследнегоСобытия_Датой = Неопределено Тогда
		Параметры.Вставить("fromDateTime", ИдентификаторПоследнегоСобытия_Датой);
	Иначе
		Параметры.Вставить("exclusiveEventId", ИдентификаторПоследнегоСобытия);
	КонецЕсли;
	
	Возврат Параметры;
	
КонецФункции

Процедура ЗагрузитьНовыеСообщения_API_ИзЯщика(УчетнаяЗапись, ТранспортныйЯщикСсылка, ТипСообщенияДляОбработки = Неопределено)
	
	Если НЕ КонтурEDIAPI_ИнтернетРесурсДоступен() Тогда
		ВызватьИсключение ТекстОшибкиОтсутствуетИнтернетСоединение();
	КонецЕсли;
	
	ТранспортныйЯщик = ПолучитьЭлементСправочника("ТранспортныеЯщики", ТранспортныйЯщикСсылка);
	
	СвойствоlastEventId = "lastEventId";
	ИдентификаторПоследнегоСобытия = ТранспортныйЯщик.lastEventId;
	
	Если ТипСообщенияДляОбработки <> Неопределено Тогда
		СвойствоlastEventId = КонтурСтандарт_СтрШаблон_("Id_%1", ТипСообщенияДляОбработки);
		ИдентификаторПоследнегоСобытия = ПолучитьЗначениеСвойстваОбъектаEDI(ТранспортныйЯщикСсылка, СвойствоlastEventId);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторПоследнегоСобытия) Тогда
		ИдентификаторПоследнегоСобытия = ТранспортныйЯщик.lastEventId;
	КонецЕсли;
	
	НачальноеЗначениеИдентификатораПоследнегоСобытия = ИдентификаторПоследнегоСобытия;
	
	Метрика_ИдЗамера = Метрика_НовыйУИД();
	Метрика_НачатьЗамер(Метрика_ИдЗамера, "ЗагрузитьНовыеСообщенияИзЯщика");
	Метрика_МассивСообщений = Новый Массив;
	
	ДанныеАвторизацииEDI = ДанныеАвторизацииДляКонтурEDIAPI(УчетнаяЗапись);
	
	Пока Истина Цикл;
	
		Состояние_КонтурEDI("Получение сообщений...");
		
		Параметры 		 = ПолучитьПараметры_ПолучитьСобытияЯщика_EDI(ИдентификаторПоследнегоСобытия);
		
		ПараметрИдентификаторСобытия = СвойствоСтруктуры(Параметры, "exclusiveEventId");
		ПараметрДатаВремя 			 = СвойствоСтруктуры(Параметры, "fromDateTime");
		
		КоличествоСобытийВПачке = 500;
		СтруктураСобытий = КонтурEDIAPI_СобытияЯщика(ДанныеАвторизацииEDI, ТранспортныйЯщик.id, ПараметрИдентификаторСобытия, ПараметрДатаВремя,  КоличествоСобытийВПачке, Истина); 	
		
		ТаблицаСобытий = СтруктураСобытий.СписокСобытий;
		
		Если ТаблицаСобытий.Количество() = 0 Тогда 
			Прервать;
		КонецЕсли;
		
		ИдентификаторПоследнегоСобытияПачки = СтруктураСобытий.ИдентификаторПоследнегоСобытия;
		
		Для каждого Событие из ТаблицаСобытий Цикл
			
			СобытиеНужноОбработать = СобытиеЯщикаНужноОбработать(Событие, ТипСообщенияДляОбработки);
			
			Если СобытиеНужноОбработать Тогда
				
				Метрика_ВремяНачала = Метрика_ОтметкаВремени();
				
				Попытка
					
					ОбработатьСобытиеAPI(Событие, УчетнаяЗапись, ТранспортныйЯщикСсылка);
					
				Исключение
					
					Если НЕ ИдентификаторПоследнегоСобытия = НачальноеЗначениеИдентификатораПоследнегоСобытия Тогда
						
						УстановитьЗначениеСвойстваОбъекта(ТранспортныйЯщикСсылка, СвойствоlastEventId, ИдентификаторПоследнегоСобытия);   
						
					КонецЕсли;
					
					ВызватьИсключение;
					
				КонецПопытки;
					
				Метрика_ВремяОкончания = Метрика_ОтметкаВремени();
					
				Если (Событие.ТипСобытия = "NewInboxMessage") Тогда	
					
					Метрика_МассивСообщений.Добавить(
													Новый Структура(
																	Врег(Событие.СодержимоеСобытия.МетаинформацияВходящегоСообщения.ИнформацияОДокументе.ТипДокумента),
																	Метрика_Длительность(Метрика_ВремяНачала, Метрика_ВремяОкончания)
																	)
													);						
				КонецЕсли;
			
			КонецЕсли;
			
			ИдентификаторПоследнегоСобытия = Событие.УказательНаСобытие;
			ДатаИВремяСобытия = Событие.ДатаИВремяСобытия;
			
		КонецЦикла;
		
		Если НЕ ПустаяСтрока(ИдентификаторПоследнегоСобытияПачки) 
			И НЕ ИдентификаторПоследнегоСобытияПачки = НачальноеЗначениеИдентификатораПоследнегоСобытия Тогда
			
			УстановитьЗначениеСвойстваОбъекта(ТранспортныйЯщикСсылка, СвойствоlastEventId, ИдентификаторПоследнегоСобытияПачки);
			УстановитьЗначениеСвойстваОбъекта(ТранспортныйЯщикСсылка, КонтурСтандарт_СтрШаблон_("Дата_%1", СвойствоlastEventId), ДатаИВремяСобытия);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если СвойствоlastEventId = "lastEventId" И ЗначениеЗаполнено(ИдентификаторПоследнегоСобытияПачки) Тогда
		УстановитьЗначениеСвойства_lastEventId(ТранспортныйЯщикСсылка, ИдентификаторПоследнегоСобытияПачки);
    КонецЕсли;
 
	
	Метрика_ЗакончитьЗамер(Метрика_ИдЗамера,
						   "ЗагрузитьНовыеСообщенияИзЯщика"
						   ,,,,
						   Новый Структура(
						   					"КоличествоСообщений, МассивСообщений",
						   					Метрика_МассивСообщений.Количество(),Метрика_МассивСообщений
										   )
						   );
						   
	Если Метрика_МассивСообщений.Количество() Тогда
		МетрикаКонтур_ЗаписатьСобытие_ОбработкаВходящегоСообщения(УчетнаяЗапись.GLN);
	КонецЕсли;
	
КонецПроцедуры

Функция СобытиеЯщикаНужноОбработать(Событие, ТипСообщенияДляОбработки)
	
	Если ТипСообщенияДляОбработки = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	ЭтоСтатусноеСообщение = ЭтоСтатусноеСообщениеКонтурEDI(Событие);
	Если ЭтоСтатусноеСообщение Тогда 
		ТипСообщения = "STSMSG";
	Иначе
		
		Если Событие.ТипСобытия = "NewInboxMessage" Тогда
			ТипСообщения = ВРег(Событие.СодержимоеСобытия.МетаинформацияВходящегоСообщения.ИнформацияОДокументе.ТипДокумента);
		ИначеЕсли Событие.ТипСобытия = "RecognizeMessage" Тогда
			ТипСообщения = ВРег(Событие.СодержимоеСобытия.ТипДокумента);
		Иначе
			ТипСообщения = Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ВРег(ТипСообщенияДляОбработки) = ТипСообщения;
	
КонецФункции

Процедура ОбработатьСобытиеAPI(Событие, УчетнаяЗапись, ТранспортныйЯщикСсылка)
	
	СтандартнаяОбработкаEDI = Истина;
	
	ПараметрПМ = Новый Структура;
	ПараметрПМ.Вставить("Событие", Событие);
	ПараметрПМ.Вставить("ТранспортныйЯщикСсылка", ТранспортныйЯщикСсылка);
	ПараметрПМ.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	ПараметрПМ.Вставить("ПропуститьЗаписьИдентификатораСобытия", Ложь);  
	
	ОбработкаСобытияПодключаемогоМодуля("ПередОбработкойСобытияAPI", СтандартнаяОбработкаEDI, ПараметрПМ);
	
	Если СтандартнаяОбработкаEDI = Ложь Тогда
		
		Возврат;
		
	КонецЕсли; 			
	
	Если Событие.ТипСобытия = "NewInboxMessage" Тогда
		
		ОбработатьСобытие_NewInboxMessage(Событие, УчетнаяЗапись); 
		
	ИначеЕсли Событие.ТипСобытия = "NewOutboxMessage" Тогда 
		
		ОбработатьСобытие_NewOutboxMessage(Событие, УчетнаяЗапись);

	ИначеЕсли Событие.ТипСобытия = "RecognizeMessage" Тогда
		
		ОбработатьСобытие_RecognizeMessage(Событие, УчетнаяЗапись);
		
	ИначеЕсли Событие.ТипСобытия = "MessageDelivered" Тогда
		
		ОбработатьСобытие_MessageDelivered(Событие);
		
	ИначеЕсли Событие.ТипСобытия = "MessageUndelivered" Тогда
		
		ОбработатьСобытие_MessageUndelivered(Событие);
		
	ИначеЕсли Событие.ТипСобытия = "MessageCheckingOk" Тогда
		
		ОбработатьСобытие_MessageCheckingOk(Событие);
		
	ИначеЕсли Событие.ТипСобытия = "MessageCheckingFail" Тогда
		
		ОбработатьСобытие_MessageCheckingFail(Событие);
		
	ИначеЕсли Событие.ТипСобытия = "DraftOfDocumentPackagePostedIntoDiadoc" Тогда
		
		ОбработатьСобытие_DraftOfDocumentPackagePostedIntoDiadoc(Событие);
		
	ИначеЕсли Событие.ТипСобытия = "DraftOfDocumentPackageSignedByMe" Тогда
		
		ОбработатьСобытие_DraftOfDocumentPackageSignedByMe(Событие);
		
	ИначеЕсли Событие.ТипСобытия = "DraftOfDocumentPackageDeletedFromDiadoc" Тогда
		
		ОбработатьСобытие_DraftOfDocumentPackageDeletedFromDiadoc(Событие);
		
	ИначеЕсли Событие.ТипСобытия = "ReceivedDiadocRoamingError" Тогда
		
		ОбработатьСобытие_ReceivedDiadocRoamingError(Событие);
		
	ИначеЕсли Событие.ТипСобытия = "DocumentPackageSignedByRecipientOk" Тогда
		
		ОбработатьСобытие_DocumentPackageSignedByRecipientOk(Событие);
		
	ИначеЕсли Событие.ТипСобытия = "DocumentPackageSignedByRecipientFail" Тогда
		
		ОбработатьСобытие_DocumentPackageSignedByRecipientFail(Событие);
		
	ИначеЕсли Событие.ТипСобытия = "AmendmentRequested" Тогда
		
		ОбработатьСобытие_AmendmentRequested(Событие);
		
	ИначеЕсли Событие.ТипСобытия = "DocumentPackageSignedByRecipientPartiallyOk" Тогда 
		
		ОбработатьСобытие_DocumentPackageSignedByRecipientPartiallyOk(Событие);
		
	ИначеЕсли Событие.ТипСобытия = "DiadocDocumentDelivered" Тогда
		
		ОбработатьСобытие_DiadocDocumentDelivered(Событие);
		
	ИначеЕсли Событие.ТипСобытия = "OutboxDiadocDocumentSenderPowerOfAttorneyStatusChanged"
		Или Событие.ТипСобытия = "OutboxDiadocDocumentRecipientPowerOfAttorneyStatusChanged" Тогда
		
		ОбработатьСобытие_OutboxDiadocDocumentPowerOfAttorneyStatusChanged(Событие);
		
	КонецЕсли;
	
	ПараметрыПМ = Новый Структура(
	"Событие, ТранспортныйЯщикСсылка, УчетнаяЗапись",
	Событие, ТранспортныйЯщикСсылка, УчетнаяЗапись
	);
	
	ОбработкаСобытияПодключаемогоМодуля("ПослеОбработкиСобытияAPI",	СтандартнаяОбработкаEDI, ПараметрыПМ);	
	
КонецПроцедуры

Функция ЭтоСтатусноеСообщениеКонтурEDI(Событие)
	
	Перем ТипДокумента, ЭтоСтатусноеСообщение;
	
	Если Событие.ТипСобытия = "NewInboxMessage" Тогда
		ТипДокумента = Врег(Событие.СодержимоеСобытия.МетаинформацияВходящегоСообщения.ИнформацияОДокументе.ТипДокумента);
		ЭтоСтатусноеСообщение = ТипДокумента = "STSMSG";
	ИначеЕсли Событие.ТипСобытия = "RecognizeMessage" Тогда
		ЭтоСтатусноеСообщение = Ложь;
	Иначе
		ЭтоСтатусноеСообщение = Истина;
	КонецЕсли;
	
	Возврат ЭтоСтатусноеСообщение;

КонецФункции
	
Функция ПолучитьТаблицуСообщений_DialMail(МассивКаталогов, УчетнаяЗапись, ТипСообщенияДляОбработки = Неопределено)
	
	ТаблицаСообщений = ИнициализироватьТаблицуСообщений();
	
	СоединениеОбъект = СоединениеОбъектDialMail(УчетнаяЗапись);
	
	Если СоединениеОбъект = Неопределено Тогда 
		Возврат ТаблицаСообщений;
	КонецЕсли;
	
	Для каждого Каталог из МассивКаталогов Цикл
		
		НайденныеФайлы   = СоединениеОбъект.Лист("/" + Каталог, "*.xml");
		КоличествоФайлов = СоединениеОбъект.КоличествоФайлов();
		
		Для Счетчик = 1 По КоличествоФайлов Цикл
			
			Если СоединениеОбъект.ЭтоКаталог(Счетчик) = 0 Тогда
				
				ИмяТекущегоФайла = СоединениеОбъект.ПолучитьИмяФайла(Счетчик);
				Если СоединениеОбъект.ПолучитьФайл("/" + ИмяТекущегоФайла, мРабочийКаталог + ИмяТекущегоФайла) = 0 Тогда
					ВывестиПредупреждение_КонтурEDI("Не удалось получить файл: " + ИмяТекущегоФайла);
					Продолжить;	
				КонецЕсли;
				
				Если Каталог = "reports" Тогда
					ТипСообщения = "reports";
				Иначе
					ТипСообщения = ПолучитьТипСообщенияИзИмениФайла(ИмяТекущегоФайла);
					
					Если ЗначениеЗаполнено(ТипСообщения) 
						И НЕ МожемОбработатьТипВходящегоСообщения(ТипСообщения) Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				
				ОбработатьСообщение = Истина;
				
				Если ТипСообщенияДляОбработки <> Неопределено Тогда
					
					Если ТипСообщения = "reports" Тогда
						ОбработатьСообщение = ТипСообщенияДляОбработки = "STSMSG";
					Иначе
						ОбработатьСообщение = ТипСообщенияДляОбработки = ТипСообщения;
					КонецЕсли;
					
				КонецЕсли;
				
				Если НЕ ОбработатьСообщение Тогда
					 Продолжить;
				КонецЕсли;
				
				Дата  = СоединениеОбъект.ПолучитьДатуФайла(Счетчик);
				Время = СоединениеОбъект.ПолучитьВремяФайла(Счетчик);
				
				НоваяСтрока = ТаблицаСообщений.Добавить();
				НоваяСтрока.ПолныйПутьКФайлу = мРабочийКаталог + ИмяТекущегоФайла;  
				НоваяСтрока.ИмяФайла 		 = ИмяТекущегоФайла; 
				НоваяСтрока.ТипСообщения 	 = ТипСообщения; 
				НоваяСтрока.Дата  			 = Дата( Число(Прав(Дата, 4)), Число(Сред(Дата,4,2)),  Число(Лев(Дата,2)),   Число(Лев(Время,2)), Число(Сред(Время,4,2)), Число(Прав(Время,2)) );; 
				НоваяСтрока.Каталог			 = Каталог;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаСообщений;
	
КонецФункции

Функция ПолучитьТаблицуСообщений_FTP(МассивКаталогов, УчетнаяЗапись, ТипСообщенияДляОбработки = Неопределено)
	
	ТаблицаСообщений = ИнициализироватьТаблицуСообщений();
	
	СоединениеОбъектFTP = СоединениеОбъектFTP(УчетнаяЗапись);
	
	Если СоединениеОбъектFTP = Неопределено Тогда
		Возврат ТаблицаСообщений;
	КонецЕсли;
	
	Для каждого Каталог из МассивКаталогов Цикл
		
		НайденныеФайлы = СоединениеОбъектFTP.НайтиФайлы("/" + Каталог, "*.xml");
		
		Для Каждого ТекущийФайл Из НайденныеФайлы Цикл
			
			Если НЕ ТекущийФайл.ЭтоФайл() ИЛИ ТекущийФайл.Размер() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			АдресРесурса = ТекущийФайл.ПолноеИмя;
			ИмяФайла 	 = ТекущийФайл.ИмяБезРасширения + ТекущийФайл.Расширение; 
			ПутьКФайлу 	 = мРабочийКаталог + ИмяФайла;
			
			СоединениеОбъектFTP.Получить(АдресРесурса, ПутьКФайлу);
			
			Если Каталог = "Reports" Тогда
				
				ТипСообщения = "reports";
				
			Иначе
				
				ТипСообщения = ПолучитьТипСообщенияИзИмениФайла(ИмяФайла);
				
				Если НЕ ЗначениеЗаполнено(ТипСообщения) Тогда 
					Продолжить;
				КонецЕсли;
				
				Если НЕ МожемОбработатьТипВходящегоСообщения(ТипСообщения) Тогда
					Продолжить;
				КонецЕсли;
				
			КонецЕсли;
			
			ОбработатьСообщение = Истина;
			
			Если ТипСообщенияДляОбработки <> Неопределено Тогда
				
				Если ТипСообщения = "reports" Тогда
					ОбработатьСообщение = ТипСообщенияДляОбработки = "STSMSG";
				Иначе
					ОбработатьСообщение = ТипСообщенияДляОбработки = ТипСообщения;
				КонецЕсли;
				
			КонецЕсли;
			
			Если НЕ ОбработатьСообщение Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаСообщений.Добавить();
			НоваяСтрока.ПолныйПутьКФайлу = ПутьКФайлу;  
			НоваяСтрока.ИмяФайла 		 = ИмяФайла; 
			НоваяСтрока.ТипСообщения 	 = ТипСообщения; 
			НоваяСтрока.Дата  			 = ТекущийФайл.ПолучитьВремяИзменения(); 
			НоваяСтрока.Каталог 		 = Каталог;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаСообщений;

КонецФункции

Функция ИнициализироватьТаблицуСообщений()
	
	ТаблицаСообщений = Новый ТаблицаЗначений;
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаСообщений, "ПолныйПутьКФайлу, ИмяФайла, ТипСообщения, Дата, Каталог");
	
	Возврат ТаблицаСообщений;

КонецФункции

