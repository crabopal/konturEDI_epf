			Сообщение.СообщениеСсылка = СообщениеСсылка;
			ПринятьВходящееСообщение(Сообщение);
			
		КонецЕсли;
			
	КонецЦикла;
	
	Если Параметры.ВОтдельномФоновомЗадании Тогда
		
		// ... финализировать
		ФоновыеЗаданияКонтурEDI_ФинализироватьМодульКонтурEDI(Метрика_ИдЗамера, Идентификатор);
		ДлительнаяОперация_Завершить();
		
	КонецЕсли;
	
