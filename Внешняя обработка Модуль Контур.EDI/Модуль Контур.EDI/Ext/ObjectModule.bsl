Функция ПолучитьТекстЗапросаДляУдаленияСообщений()

	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	КонтурEDI_ДополнительныеСправочники.Ссылка КАК Партнер
	               |ПОМЕСТИТЬ ВТ_ТаблицаКэшПартнеров
	               |ИЗ
	               |	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК СвойствоСФ_Покупатель
	               |		ПО КонтурEDI_ДополнительныеСправочники.Ссылка = СвойствоСФ_Покупатель.Объект
	               |			И (СвойствоСФ_Покупатель.Свойство = ""INVOIC_Входящее"")
	               |ГДЕ
	               |	КонтурEDI_ДополнительныеСправочники.ИмяСправочника = ""Партнеры""
	               |	И (КонтурEDI_ДополнительныеСправочники.Ссылка = &Партнер ИЛИ &Партнер = НЕОПРЕДЕЛЕНО)
	               |	И (ВЫРАЗИТЬ(ЕСТЬNULL(СвойствоСФ_Покупатель.Значение, ЛОЖЬ) КАК БУЛЕВО)) = ИСТИНА
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	КонтурEDI_ДополнительныеСправочники.Ссылка
	               |ИЗ
	               |	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК СвойствоСФ_Поставщик
	               |		ПО КонтурEDI_ДополнительныеСправочники.Ссылка = СвойствоСФ_Поставщик.Объект
	               |			И (СвойствоСФ_Поставщик.Свойство = ""INVOIC_Исходящее"")
	               |ГДЕ
	               |	КонтурEDI_ДополнительныеСправочники.ИмяСправочника = ""Партнеры""
	               |	И (КонтурEDI_ДополнительныеСправочники.Ссылка = &Партнер ИЛИ &Партнер = НЕОПРЕДЕЛЕНО)
				   |	И (ВЫРАЗИТЬ(ЕСТЬNULL(СвойствоСФ_Поставщик.Значение, ЛОЖЬ) КАК БУЛЕВО)) = ИСТИНА
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Партнер
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВЫБОР
	               |		КОГДА КонтурEDI_Сообщения.ДатаЗаказа = ДАТАВРЕМЯ(1, 1, 1)
	               |			ТОГДА КонтурEDI_Сообщения.ДатаДокумента
	               |		ИНАЧЕ КонтурEDI_Сообщения.ДатаЗаказа
	               |	КОНЕЦ КАК ДатаЗаказа,
	               |	ВЫБОР
	               |		КОГДА КонтурEDI_Сообщения.НомерЗаказа = """"
	               |			ТОГДА КонтурEDI_Сообщения.НомерДокумента
	               |		ИНАЧЕ КонтурEDI_Сообщения.НомерЗаказа
	               |	КОНЕЦ КАК НомерЗаказа,
	               |	КонтурEDI_Сообщения.Партнер КАК Партнер
	               |ПОМЕСТИТЬ ВТ_Незавершенные_INVOIC
	               |ИЗ
	               |	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТаблицаКэшПартнеров КАК ВТ_ТаблицаКэшПартнеров
	               |		ПО КонтурEDI_Сообщения.Партнер = ВТ_ТаблицаКэшПартнеров.Партнер
	               |			И (НЕ КонтурEDI_Сообщения.Архив)
	               |			И (КонтурEDI_Сообщения.ТипСообщения = ""INVOIC""
	               |				ИЛИ КонтурEDI_Сообщения.ТипСообщения = ""COINVOIC"")
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА КонтурEDI_Сообщения.ДатаЗаказа = ДАТАВРЕМЯ(1, 1, 1)
	               |				ТОГДА КонтурEDI_Сообщения.ДатаДокумента
	               |			ИНАЧЕ КонтурEDI_Сообщения.ДатаЗаказа
	               |		КОНЕЦ МЕЖДУ &НачалоПериода И &КонецПериода
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА КонтурEDI_Сообщения.ДатаЗаказа = ДАТАВРЕМЯ(1, 1, 1)
	               |			ТОГДА КонтурEDI_Сообщения.ДатаДокумента
	               |		ИНАЧЕ КонтурEDI_Сообщения.ДатаЗаказа
	               |	КОНЕЦ КАК ДатаЗаказа,
	               |	ВЫБОР
	               |		КОГДА КонтурEDI_Сообщения.НомерЗаказа = """"
	               |			ТОГДА КонтурEDI_Сообщения.НомерДокумента
	               |		ИНАЧЕ КонтурEDI_Сообщения.НомерЗаказа
	               |	КОНЕЦ КАК НомерЗаказа,
				   |	КонтурEDI_Сообщения.Ссылка КАК Ссылка,
				   |	КонтурEDI_Сообщения.Архив КАК Архив,
				   |	КонтурEDI_Сообщения.Документ КАК Документ,
				   |	КонтурEDI_Сообщения.ДатаДокумента КАК ДатаДокумента,
				   |	КонтурEDI_Сообщения.Партнер КАК Партнер,
				   |	КонтурEDI_Сообщения.ТипСообщения КАК ТипСообщения
	               |ПОМЕСТИТЬ ВТ_ВсеСообщения
	               |ИЗ
	               |	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА КонтурEDI_Сообщения.ДатаЗаказа = ДАТАВРЕМЯ(1, 1, 1)
	               |				ТОГДА КонтурEDI_Сообщения.ДатаДокумента
	               |			ИНАЧЕ КонтурEDI_Сообщения.ДатаЗаказа
	               |		КОНЕЦ МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И НЕ КонтурEDI_Сообщения.ТипСообщения = ""УдалениеСообщений""
	               |	И (КонтурEDI_Сообщения.Партнер = &Партнер ИЛИ &Партнер = НЕОПРЕДЕЛЕНО)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ВсеСообщения.ДатаЗаказа КАК ДатаЗаказа,
	               |	ВТ_ВсеСообщения.НомерЗаказа КАК НомерЗаказа,
	               |	ВТ_ВсеСообщения.Ссылка КАК Ссылка,
	               |	ВТ_ВсеСообщения.Документ КАК Документ,
	               |	ВТ_ВсеСообщения.ДатаДокумента КАК ДатаДокумента,
	               |	ВТ_ВсеСообщения.ТипСообщения КАК ТипСообщения
	               |ИЗ
	               |	ВТ_ВсеСообщения КАК ВТ_ВсеСообщения
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Незавершенные_INVOIC КАК ВТ_Незавершенные_INVOIC
	               |		ПО ВТ_ВсеСообщения.НомерЗаказа = ВТ_Незавершенные_INVOIC.НомерЗаказа
	               |			И ВТ_ВсеСообщения.ДатаЗаказа = ВТ_Незавершенные_INVOIC.ДатаЗаказа
	               |			И ВТ_ВсеСообщения.Партнер = ВТ_Незавершенные_INVOIC.Партнер
				   |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВсеСообщения КАК ВТ_СвежиеСообщения
				   |		ПО ВТ_ВсеСообщения.НомерЗаказа = ВТ_СвежиеСообщения.НомерЗаказа
				   |			И ВТ_ВсеСообщения.ДатаЗаказа = ВТ_СвежиеСообщения.ДатаЗаказа
				   |			И ВТ_ВсеСообщения.Партнер = ВТ_СвежиеСообщения.Партнер
				   |			И (ВТ_СвежиеСообщения.ДатаДокумента > &КонецПериода)
				   |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВсеСообщения КАК ВТ_НеархивныеСообщения
				   |		ПО ВТ_ВсеСообщения.НомерЗаказа = ВТ_НеархивныеСообщения.НомерЗаказа
				   |			И ВТ_ВсеСообщения.ДатаЗаказа = ВТ_НеархивныеСообщения.ДатаЗаказа
				   |			И ВТ_ВсеСообщения.Партнер = ВТ_НеархивныеСообщения.Партнер
				   |			И Не ВТ_НеархивныеСообщения.Архив
	               |ГДЕ
	               |	ВТ_Незавершенные_INVOIC.НомерЗаказа ЕСТЬ NULL
	               |	И ВТ_Незавершенные_INVOIC.ДатаЗаказа ЕСТЬ NULL
				   |	И ВТ_СвежиеСообщения.Ссылка ЕСТЬ NULL
				   |	И ВТ_НеархивныеСообщения.Ссылка ЕСТЬ NULL
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаЗаказа
	               |ИТОГИ
	               |	КОЛИЧЕСТВО(Ссылка)
	               |ПО
	               |	ОБЩИЕ,
	               |	ДатаЗаказа,
	               |	НомерЗаказа";
	
	Возврат ТекстЗапроса;

КонецФункции

Функция ПолучитьРезультатЗапросаУдаленияСообщений(НачалоПериода, КонецПериода, Партнер)
	
 	ЗапросПоСообщениям = ИнициализироватьЗапрос_КонтурEDI();
	ЗапросПоСообщениям.Текст = ПолучитьТекстЗапросаДляУдаленияСообщений();
	
	ЗапросПоСообщениям.УстановитьПараметр("НачалоПериода", 			НачалоДня(НачалоПериода));
	ЗапросПоСообщениям.УстановитьПараметр("КонецПериода", 			КонецДня(КонецПериода));
	ЗапросПоСообщениям.УстановитьПараметр("Партнер", 				Партнер);	
	
	РезультатЗапроса = ЗапросПоСообщениям.Выполнить();
	
	Возврат РезультатЗапроса;	

КонецФункции

Функция ПосчитатьКоличествоСообщенийДляУдаления(НачалоПериода, КонецПериода, Партнер) Экспорт
	
	КоличествоСообщенийДляУдаления = 0;
	
	РезультатЗапроса = ПолучитьРезультатЗапросаУдаленияСообщений(НачалоПериода, КонецПериода, Партнер);
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
	    ВариантОбхода = ОбходРезультатаЗапроса.ПоГруппировкамСИерархией;
		ВыборкаПоИерархии = РезультатЗапроса.Выбрать(ВариантОбхода);
		
		Если ВыборкаПоИерархии.Следующий() Тогда
			КоличествоСообщенийДляУдаления = ВыборкаПоИерархии.Ссылка;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат КоличествоСообщенийДляУдаления;
	
КонецФункции

Функция УдалитьСообщения_КонтурEDI(НачалоПериода, КонецПериода, Партнер = Неопределено) Экспорт
	
	// Найдем все возможные цепочки для удаления (исключая незавершенные INVOIC)
	РезультатЗапроса = ПолучитьРезультатЗапросаУдаленияСообщений(НачалоПериода, КонецПериода, Партнер);
	Сч = 0;
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		ВариантОбхода = ОбходРезультатаЗапроса.ПоГруппировкамСИерархией;	
		ВыборкаПоИерархии = РезультатЗапроса.Выбрать(ВариантОбхода);
		НовСообщениеСсылка = ПодготовитьСообщениеСсылкуДляОперацииУдаленияСообщений(НачалоПериода, КонецПериода);
		ОбработатьДеревоСообщенийДляУдаленияРекурсивно(ВыборкаПоИерархии, НовСообщениеСсылка, Сч);
		
	КонецЕсли;
	
	Возврат Сч;
	
КонецФункции

Процедура ОбработатьДеревоСообщенийДляУдаленияРекурсивно(ВыборкаПоИерархии, НовСообщениеСсылка, Сч, КоличествоСообщенийДляУдаления = 0)

	ВариантОбхода 		= ОбходРезультатаЗапроса.ПоГруппировкамСИерархией;
	ТипДетальнаяЗапись 	= ТипЗаписиЗапроса.ДетальнаяЗапись;
	ТипОбщийИтог 		= ТипЗаписиЗапроса.ОбщийИтог;
		
	Пока ВыборкаПоИерархии.Следующий() Цикл
		
		Если ВыборкаПоИерархии.ТипЗаписи() = ТипДетальнаяЗапись Тогда
			
			Сч = Сч + 1;
			
			#Если Клиент Тогда
				Состояние("Удаление сообщений: " + Сч + " из " + КоличествоСообщенийДляУдаления);
			#КонецЕсли

			Если ЗначениеЗаполнено(ВыборкаПоИерархии.Документ) Тогда
				
				// 1. Регистр СтатусыДокументов
				УдалитьСтатусДокумента_КонтурEDI(ВыборкаПоИерархии.Документ);
				
				// 2.1 Регистр ДополнительныеРеквизиты - реквизиты документа
				Если ВыборкаПоИерархии.ТипСообщения = "DESADV" // Удаляем ALCRPT_ID
					ИЛИ ВыборкаПоИерархии.ТипСообщения = "INVOIC" 
					ИЛИ ВыборкаПоИерархии.ТипСообщения = "COINVOIC" Тогда
					
					УдалитьДополнительныеРеквизитыОбъекта_КонтурEDI(ВыборкаПоИерархии.Документ);
					
				КонецЕсли;
				
			КонецЕсли;
			
			// 2.2 Регистр ДополнительныеРеквизиты - реквизиты сообщения
			УдалитьДополнительныеРеквизитыОбъекта_КонтурEDI(ВыборкаПоИерархии.Ссылка);
			
			// 3. Регистр Статистика
			Если ЕстьНеобходимыеМетаданные("РегистрыСведений.КонтурEDI_Статистика") Тогда
				ЗаменитьСсылкуСообщенияВСтатистике(ВыборкаПоИерархии.Ссылка, НовСообщениеСсылка);
			КонецЕсли;
			
			// 4. Непосредственное удаление сообщения 
			СообщениеОбъект = ПолучитьОбъектСообщения(ВыборкаПоИерархии.Ссылка); 
			СообщениеОбъект.ОбменДанными.Загрузка = Истина;
			СообщениеОбъект.Удалить();
			
		ИначеЕсли ВыборкаПоИерархии.ТипЗаписи() = ТипОбщийИтог Тогда
				
			КоличествоСообщенийДляУдаления = ВыборкаПоИерархии.Ссылка;
			ДочерняяЗапись = ВыборкаПоИерархии.Выбрать(ВариантОбхода);
			ОбработатьДеревоСообщенийДляУдаленияРекурсивно(ДочерняяЗапись, НовСообщениеСсылка, Сч, КоличествоСообщенийДляУдаления);
			
		Иначе
			
			#Если Клиент Тогда
				ОбработкаПрерыванияПользователя();
			#КонецЕсли

			// Продолжим выборку подчиненных записей
			НачатьТранзакцию();
			Попытка
				
				ДочерняяЗапись = ВыборкаПоИерархии.Выбрать(ВариантОбхода);
				ОбработатьДеревоСообщенийДляУдаленияРекурсивно(ДочерняяЗапись, НовСообщениеСсылка, Сч, КоличествоСообщенийДляУдаления);
				
				Если ТранзакцияАктивна() Тогда
			        ЗафиксироватьТранзакцию();
			    КонецЕсли;
				
			Исключение
				
			    Если ТранзакцияАктивна() Тогда
			        ОтменитьТранзакцию();
				КонецЕсли;
				
				ТекстОшибки = "Пожалуйста, перезапустите процесс удаления. Не удалось удалить цепочку сообщений - " + ОписаниеОшибки();
				ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);
				ВызватьИсключение ТекстОшибки;
				
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;	

КонецПроцедуры

Процедура ЗаменитьСсылкуСообщенияВСтатистике(ТекСообщениеСсылка, НовСообщениеСсылка)
	
	НаборЗаписей = РегистрыСведений.КонтурEDI_Статистика.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.СообщениеСсылка.Установить(ТекСообщениеСсылка);
	НаборЗаписей.Прочитать();
	
	Для каждого Запись Из НаборЗаписей Цикл
		
		// Через новый набор записей уезжает статистика, поэтому через менеджер записи
		МенеджерЗаписи = РегистрыСведений.КонтурEDI_Статистика.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Запись);
		МенеджерЗаписи.Прочитать();
		
		Если МенеджерЗаписи.Выбран() Тогда 
			МенеджерЗаписи.СообщениеСсылка = НовСообщениеСсылка;
			МенеджерЗаписи.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПодготовитьСообщениеСсылкуДляОперацииУдаленияСообщений(НачалоПериода, КонецПериода)
	
	СообщениеОбъект = Справочники.КонтурEDI_Сообщения.СоздатьЭлемент();
	
	СообщениеОбъект.ТипСообщения 		= "УдалениеСообщений";
	СообщениеОбъект.ТребуемоеДействие	= "РаботаЗавершена";
	СообщениеОбъект.Архив 				= Истина;
	СообщениеОбъект.ДатаЗагрузки		= ТекущаяДата();
	
	// укажем пользователя, который выполняет удаление
	НоваяСтрока = СообщениеОбъект.ДополнительныеРеквизиты.Добавить();
	НоваяСтрока.ИмяРеквизита = "Пользователь1С";
	
	Пользователь1С = ПолучитьТекущегоПользователя1С();
	НоваяСтрока.Значение 		= Пользователь1С;
	НоваяСтрока.ЗначениеСтрока 	= Строка(Пользователь1С);

	// укажем период, за который выполняется удаление
	НоваяСтрока = СообщениеОбъект.ДополнительныеРеквизиты.Добавить();
	НоваяСтрока.ИмяРеквизита = "Период";
	
	ПериодСтрокой = ПредставлениеПериода(НачалоПериода, КонецПериода);
	НоваяСтрока.Значение 		= ПериодСтрокой;
	НоваяСтрока.ЗначениеСтрока 	= Строка(ПериодСтрокой);
	
	СообщениеОбъект.Записать();
	
	Возврат СообщениеОбъект.Ссылка;                               
                                            
КонецФункции // ПодготовитьСообщениеСсылкуДляОперацииУдаленияСообщений()

Процедура УдалитьДополнительныеРеквизитыОбъекта_КонтурEDI(ОбъектСсылка)

	НаборЗаписей = РегистрыСведений.КонтурEDI_ДополнительныеРеквизиты.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Установить(ОбъектСсылка);
    НаборЗаписей.Записать();

КонецПроцедуры

Процедура УдалитьСтатусДокумента_КонтурEDI(ДокументСсылка)
	
	НаборЗаписей = РегистрыСведений.КонтурEDI_СтатусыДокументов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Документ.Установить(ДокументСсылка);
    НаборЗаписей.Записать();
	
КонецПроцедуры

Процедура УдалитьНеактуальныеСообщения_КонтурEDI() Экспорт
	
	СрокХраненияСообщений = ПолучитьКонстантуEDI("СрокХраненияСообщенийEDI");
	
	Если ТипЗнч(СрокХраненияСообщений) <> Тип("Число") Или СрокХраненияСообщений <= 0 Тогда
		СрокХраненияСообщений = 366*10; // 10 лет
	КонецЕсли;

	СекундВДне = 24 * 60 * 60;
	СрокХраненияСообщенийВСекундах = СрокХраненияСообщений * СекундВДне;
	
	НачалоПериода = Дата(1, 1, 1);	
	КонецПериода = НачалоДня(ТекущаяДатаСеанса()) - СрокХраненияСообщенийВСекундах;	

	УдалитьСообщения_КонтурEDI(НачалоПериода, КонецПериода);
	
КонецПроцедуры

