// Метод для получения авторизационного токена.
// Имя ресурса: /V1/Authenticate
// HTTP метод: POST
// Результат: авторизационный токен (строка)
Функция EDI_API_Authenticate(Логин, Пароль) Экспорт
	
	Перем Сервер;
	
	Сервер = EDIСерверAPI();
								 
	konturediauth_api_client_id = "konturediauth_api_client_id=" + API_КлючРазработчика();
	konturediauth_login 		= "konturediauth_login="""    	 + Логин + """";
	konturediauth_password 	    = "konturediauth_password=""" 	 + Пароль + """";
	
	Authorization = "KonturEdiAuth " + konturediauth_api_client_id + "," + konturediauth_login + "," + konturediauth_password;
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", Authorization);
	
	ПараметрыЗапроса = НовыеПараметрыHTTPЗапроса();
	ПараметрыЗапроса.Вставить("Заголовки", Заголовки);
	
	НастройкиПрокси = ПолучитьПараметрыИнтернетСоединения_KE();
	
	Если НастройкиПрокси.ИспользуетсяПрокси Тогда
		
		Прокси = Новый Структура;
		Прокси.Вставить("host"		, НастройкиПрокси.СерверПрокси + ":" + Формат(НастройкиПрокси.ПортПрокси,"ЧГ=0"));
		Прокси.Вставить("username"  , НастройкиПрокси.ЛогинПрокси);
		Прокси.Вставить("password"  , НастройкиПрокси.ПарольПрокси);
		Прокси.Вставить("ИспользоватьСистемныеНастройкиПрокси", НастройкиПрокси.ИспользоватьСистемныеНастройкиПрокси);
		Прокси.Вставить("СпособАутентификацииПрокси", НастройкиПрокси.СпособАутентификацииПрокси);

		ПараметрыЗапроса.Вставить("Прокси", Прокси);
		
	КонецЕсли;
	
	Возврат ВыполнитьHTTPЗапрос("POST", Сервер + "/V1/Authenticate", ПараметрыЗапроса);
	
КонецФункции

Функция DD_API_Authenticate(Сертификат = "", Логин = "", Пароль = "") Экспорт 
	
	Результат = "";
	
	Если ЗначениеЗаполнено(Сертификат) Тогда
		
		ПараметрыЗапроса = НовыеПараметрыHTTPЗапроса();
		ПараметрыЗапроса.ТелоЗапроса = Новый Структура("Строка", Сертификат);
		ПараметрыЗапроса.ТелоОтвета  = Новый Структура("ДвоичныеДанные");
		
	Иначе
		
		ПараметрыЗапроса = НовыеПараметрыHTTPЗапроса();
		ПараметрыЗапроса.Параметры.Вставить("login"   , Логин);
		ПараметрыЗапроса.Параметры.Вставить("password", Пароль);
		ПараметрыЗапроса.Параметры.Вставить("КодировкаОтвета", "utf-8");

	КонецЕсли;
	
	Возврат ВыполнитьHTTPЗапрос_Diadoc("POST", "/Authenticate", ПараметрыЗапроса);

КонецФункции

