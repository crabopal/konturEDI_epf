Функция КонтурEDIAPI_Привести_MessageBoxEvent(ХранилищеСхем, Схема, ОбъектКонвертации, ЛокальныеИмена = Ложь)
	
	ПолеТипСобытия = ?(ОбъектКонвертации.Свойство("EventType"), ОбъектКонвертации.EventType, ОбъектКонвертации.ТипСобытия);
	ПолеКонтентСобытия = ?(ОбъектКонвертации.Свойство("EventContent"), ОбъектКонвертации.EventContent, ОбъектКонвертации.КонтентСобытия);
	
	СоответствиеТиповСобытияСхеме = КонтурEDIAPI_СоответствиеТиповСобытияСхеме();
	
	ИмяСхемы = СоответствиеТиповСобытияСхеме.Получить(ПолеТипСобытия);
	
	Если ЗначениеЗаполнено(ИмяСхемы) Тогда
		ПриведенныйОбъект = ПостроительСхем_ПривестиПоСхеме(ХранилищеСхем, ИмяСхемы, ПолеКонтентСобытия, ЛокальныеИмена);
	Иначе
		ПриведенныйОбъект = ПолеКонтентСобытия; 	
	КонецЕсли;  
	
	Возврат ПриведенныйОбъект;
	
КонецФункции

Функция КонтурEDIAPI_Привести_MessageBoxEventBatch(ХранилищеСхем, Схема, ОбъектКонвертации, ЛокальныеИмена = Ложь)
	
	ПриведенныйОбъект = ПостроительСхем_ПривестиПоСхеме(ХранилищеСхем, Схема, ОбъектКонвертации, ЛокальныеИмена);
	
	Схема_MessageBoxEventBatch = КонтурEDIAPI_Схема_MessageBoxEventBatch();		
	
	Если НЕ ОбъектКонвертации = Неопределено И КонтурСтандарт_ЭтоСтруктура(ОбъектКонвертации) Тогда
		
		СвойствоEvents = Схема_MessageBoxEventBatch.Свойства["events"];
		
		ИспользуютсяЛокальныеИмена = Ложь;
		
		Если ПриведенныйОбъект.Свойство("events") Тогда
			СписокСобытий = ПриведенныйОбъект["events"];
		Иначе 
			СписокСобытий = ПриведенныйОбъект[СвойствоEvents.ЛокальноеИмя];
			ИспользуютсяЛокальныеИмена = Истина;
		КонецЕсли;
		
		СоответствиеТиповСобытияСхеме = КонтурEDIAPI_СоответствиеТиповСобытияСхеме();
		
		Для Индекс = 0 По СписокСобытий.Количество() - 1 Цикл
			
			Если НЕ ИспользуютсяЛокальныеИмена Тогда
				
				ИмяПоляКонтента = "eventContent";
				ПолеТипСобытия = СписокСобытий[Индекс].eventType;
				ПолеКонтентСобытия = СписокСобытий[Индекс].eventContent;
				
			Иначе
				
				ИмяПоляКонтента = "СодержимоеСобытия";
				ПолеТипСобытия = СписокСобытий[Индекс].ТипСобытия;
				ПолеКонтентСобытия = СписокСобытий[Индекс].СодержимоеСобытия;
				
			КонецЕсли;
			
			ИмяСхемы = СоответствиеТиповСобытияСхеме.Получить(ПолеТипСобытия);
			Если ЗначениеЗаполнено(ИмяСхемы) Тогда
				СписокСобытий[Индекс][ИмяПоляКонтента] = ПостроительСхем_ПривестиПоСхеме(ХранилищеСхем, ИмяСхемы, ПолеКонтентСобытия, ЛокальныеИмена); 	
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ПриведенныйОбъект;

КонецФункции

