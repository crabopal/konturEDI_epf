//   boxId - Строка - Идентификатор ящика
//	 ДвоичныеДанныеФайла - ДвоичныеДанные - двоичные данные сообщения  
//   messageFileName - Строка - Имя файла (необязательный)
//
// Возвращаемое значение:
//   Структура - См. свойства в методе КонтурEDIAPI_Схема_OutboxMessageMeta 
//
Функция КонтурEDIAPI_ОтправитьСообщение(Знач ДанныеАвторизацииEDI, boxId, ДвоичныеДанныеФайла, messageFileName = Неопределено, ОтветВЛокальныхИменах = Ложь) Экспорт
	
	КонтурEDIAPI_УстановитьТокенДляЗапроса(ДанныеАвторизацииEDI);
	
	МенеджерНастроек = КонтурEDIAPI_МенеджерНастроек();
	
	ПараметрыСервиса =  КонтурEDIAPI_SendMessage();

	ПараметрыСервиса.Параметры.boxId = boxId; 
	
	Если ЗначениеЗаполнено(messageFileName) Тогда
		ПараметрыСервиса.Параметры.messageFileName = messageFileName;
	Иначе
		ПараметрыСервиса.Параметры.Удалить("messageFileName");	
	КонецЕсли;    
	
	ДопПараметры = Новый Структура("ПараметрыЗапроса", ПараметрыСервиса.Параметры);
	
	Ответ = КонтурEDIAPI_Post(ДанныеАвторизацииEDI, ПараметрыСервиса.URL, ДвоичныеДанныеФайла, ДопПараметры, МенеджерНастроек.Сессия);
	
	ПодготовленныйОтветКлиента = КонтурEDIAPI_ОбработатьРезультатHTTPЗапроса(ПараметрыСервиса, Ответ);	
	
	Возврат КонтурEDIAPI_Привести("OutboxMessageMeta", ПодготовленныйОтветКлиента.Результат, ОтветВЛокальныхИменах);
	
КонецФункции

// Метод предназначен для коннекторов и интеграционных решений получателя
// для уведомления отправителя о завершении процесса получения сообщения.
// В случае HTTP ответа отличного от "200", выбрасывает исключение.
//
// Параметры:
//   ДанныеАвторизацииEDI - Структура - см. метод КонтурEDIAPI_НовыйДанныеАвторизации.	
//   boxId - Строка - Идентификатор ящика
//	 messageId - Строка - Идентификатор сообщения 
//   deliveryTimestamp - Строка - Дата и время доставки
//   deliveryError - Строка - Ошибка доставки сообщения 
//	 firstDeliveryAttemptTimestamp - Строка - Дата и время первой попытки доставить сообщение 
//
// Возвращаемое значение:
//	 Булево - Истина - Успешное выполнение запроса метода 
//
Функция КонтурEDIAPI_СтатусДоставки_СообщениеДоставлено(Знач ДанныеАвторизацииEDI, boxId, messageId, deliveryTimestamp, deliveryError, firstDeliveryAttemptTimestamp) Экспорт
	
	КонтурEDIAPI_УстановитьТокенДляЗапроса(ДанныеАвторизацииEDI);
	
	МенеджерНастроек = КонтурEDIAPI_МенеджерНастроек();
	
	ТелоЗапроса = КонтурEDIAPI_СоздатьПоСхеме("MessageDeliveryResult");
	
	Если ЗначениеЗаполнено(deliveryTimestamp) Тогда
		ТелоЗапроса.deliveryTimestamp	 			= КонтурСтандарт_ДатаВФормате_ISO8601(deliveryTimestamp);
	КонецЕсли; 
	Если ЗначениеЗаполнено(deliveryError) Тогда
		ТелоЗапроса.deliveryError	 				= deliveryError;
	КонецЕсли; 
	Если ЗначениеЗаполнено(firstDeliveryAttemptTimestamp) Тогда
		ТелоЗапроса.firstDeliveryAttemptTimestamp	= КонтурСтандарт_ДатаВФормате_ISO8601(firstDeliveryAttemptTimestamp);
	КонецЕсли; 

	ПараметрыСервиса =  КонтурEDIAPI_MessageDeliveryFinished();

	ПараметрыСервиса.Параметры.boxId 	 = boxId; 
	ПараметрыСервиса.Параметры.messageId = messageId;  
		
	ДопПараметры = Новый Структура("ПараметрыЗапроса,Json", ПараметрыСервиса.Параметры, ТелоЗапроса);
	
	Ответ = КонтурEDIAPI_Post(ДанныеАвторизацииEDI, ПараметрыСервиса.URL, , ДопПараметры, МенеджерНастроек.Сессия);
	
	ПодготовленныйОтветКлиента = КонтурEDIAPI_ОбработатьРезультатHTTPЗапроса(ПараметрыСервиса, Ответ);	
	
	Возврат Истина;
	
КонецФункции

// Метод предназначен для коннекторов и интеграционных решений получателя 
// для уведомления отправителя о начале процесса получения сообщения.
