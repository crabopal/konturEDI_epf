Функция ПроверитьДоступностьИнтернетРесурса(АдресРесурса, Параметры = Неопределено) Экспорт
	
	ИнтернетРесурсДоступен = Истина;
	
	Прокси = Неопределено;

	Если НЕ КонтурСтандарт_ЭтоСтруктура(Параметры) ИЛИ НЕ Параметры.Свойство("Прокси", Прокси) Тогда
		Прокси = ПолучитьИнтернетПрокси();	
	КонецЕсли;
	
	Таймаут = 10;
	МаксимальноеКоличествоПовторов = 0;
	ДополнительныеПараметры = Новый Структура("Прокси,Таймаут,МаксимальноеКоличествоПовторов", Прокси, Таймаут, МаксимальноеКоличествоПовторов);
	
	Попытка	
		Ответ = КлиентHTTP_Get(АдресРесурса, , ДополнительныеПараметры);
		
		КодыСостоянияHTTP = КлиентHTTP_КодыСостоянияHTTP(); 			
		ИнтернетРесурсДоступен = (КодыСостоянияHTTP.ОК_200 <= Ответ.КодСостояния И Ответ.КодСостояния < КодыСостоянияHTTP.НеверныйЗапрос_400);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ИнтернетРесурсДоступен = Ложь;
	КонецПопытки;
	
	Возврат ИнтернетРесурсДоступен;	
	
КонецФункции

Функция ПроверитьДоступностьИнтернетРесурсаСКэшем(АдресРесурса = Неопределено, Параметры = Неопределено) Экспорт
	
	КлючКэша = "РезультатФункции_ПроверитьДоступностьИнтернетРесурсаСКэшем";
	
	РезультатФункции = ЭДО_Кэш_Прочитать(КлючКэша);
	
	Если РезультатФункции = Неопределено Тогда
		РезультатФункции = Новый Соответствие;	
	КонецЕсли;                                
	
	ОписаниеДоступностиРесурса = РезультатФункции.Получить(АдресРесурса);
	
	Если ОписаниеДоступностиРесурса = Неопределено Тогда
		
		ОписаниеДоступностиРесурса = Новый Структура;
		ОписаниеДоступностиРесурса.Вставить("ИнтернетРесурсДоступен", Неопределено);
		ОписаниеДоступностиРесурса.Вставить("ДатаПроверкиРесурса", Неопределено);
		
	КонецЕсли;
	
	Если ОписаниеДоступностиРесурса.ИнтернетРесурсДоступен = Ложь 
		И (ОписаниеДоступностиРесурса.ДатаПроверкиРесурса = Неопределено
		ИЛИ НачалоМинуты(ТекущаяДата()) > НачалоМинуты(ОписаниеДоступностиРесурса.ДатаПроверкиРесурса)) Тогда
		
		ОписаниеДоступностиРесурса.ИнтернетРесурсДоступен = Неопределено;		
		
	КонецЕсли;
	
	ИнтернетРесурсДоступен = ОписаниеДоступностиРесурса.ИнтернетРесурсДоступен;
	
	Если ИнтернетРесурсДоступен = Неопределено Тогда
		
		ИнтернетРесурсДоступен = ПроверитьДоступностьИнтернетРесурса(АдресРесурса, Параметры);
		
		ОписаниеДоступностиРесурса.ИнтернетРесурсДоступен = ИнтернетРесурсДоступен;
		ОписаниеДоступностиРесурса.ДатаПроверкиРесурса = ТекущаяДата();
		
		РезультатФункции.Вставить(АдресРесурса, ОписаниеДоступностиРесурса);
		
		ЭДО_Кэш_Поместить(КлючКэша, РезультатФункции);
		
	КонецЕсли;	                                                        
	
	Возврат ИнтернетРесурсДоступен; 
	
КонецФункции

Функция ПроверитьДоступностьИнтернетаЧерезПрокси(Знач Прокси) Экспорт
	
	АдресРесурса = ПараметрыКлиентСервер.URLАдреса.EDIБоевойСервер;
	Параметры = Новый Структура("Прокси", Прокси);
	
	Возврат ПроверитьДоступностьИнтернетРесурса(АдресРесурса, Параметры);
	
КонецФункции 

