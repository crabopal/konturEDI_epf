Функция КоллекцияКолонокТаблицыСообщений_КонтурEDI(Таблица)
	
	КоллекцияКолонокТаблицы = Новый Массив;
	
	Если ТипЗнч(Таблица) = Тип("ТаблицаЗначений") Тогда
		КоллекцияКолонокТаблицы = Таблица.Колонки;	
	ИначеЕсли ЭтотОбъект.ТабСообщения = Таблица Тогда 
		КоллекцияКолонокТаблицы = Таблица.ВыгрузитьКолонки().Колонки;		
	КонецЕсли;
	
	Возврат КоллекцияКолонокТаблицы;
	
КонецФункции

Функция СоответствиеИменКолонокТаблицИсточникаПриемника_КонтурEDI(КолонкиТаблицыИсточник, КолонкиТаблицыПриемник) Экспорт
				
	СоответствиеКолонок = Новый Массив;
				
	Для Каждого Колонка Из КолонкиТаблицыИсточник Цикл
		   
		Если КолонкиТаблицыПриемник.Найти(Колонка.Имя) = Неопределено 
				Или Колонка.Имя = "НомерСтроки" Тогда
			Продолжить;
		КонецЕсли; 
			
		СоответствиеКолонок.Добавить(Колонка.Имя);
		
	КонецЦикла;
	
	Возврат СоответствиеКолонок;
		        
КонецФункции

Процедура ЗагрузитьДанныеТаблицыИсточникаВТаблицуПриемникВертикально_КонтурEDI(ТаблицаИсточник, ТаблицаПриемник) Экспорт
	
	КолонкиИсточника = КоллекцияКолонокТаблицыСообщений_КонтурEDI(ТаблицаИсточник);
	КолонкиПриемника = КоллекцияКолонокТаблицыСообщений_КонтурEDI(ТаблицаПриемник);
	
	ТаблицаПриемник.Очистить();
			
	СоответствиеИменКолонок = СоответствиеИменКолонокТаблицИсточникаПриемника_КонтурEDI(КолонкиИсточника, КолонкиПриемника);
			
	Для Счетчик = 1 По ТаблицаИсточник.Количество() Цикл ТаблицаПриемник.Вставить(0) КонецЦикла;
	
	Для каждого ИмяКолонки Из СоответствиеИменКолонок Цикл
			
		ТаблицаПриемник.ЗагрузитьКолонку(ТаблицаИсточник.ВыгрузитьКолонку(ИмяКолонки), ИмяКолонки);
		
	КонецЦикла;
	
КонецПроцедуры

//для заполнения таблицы требуемых действий и их картинок
Процедура ДобавитьСтрокуОформленияТребуемогоДействия(Таблица,Раздел,Действие,ИмяКартинки,Гиперссылка,КодДействия,Иконка=0) Экспорт
	//проверим, вдруг уже добавили
	
	СтрокаНайденная = Таблица.Найти(Действие,"Значение");
	
	Если СтрокаНайденная <> Неопределено И СтрокаНайденная.Раздел = Раздел Тогда
		Возврат;
	КонецЕсли;	
	
	Нов = Таблица.Добавить();
	Нов.Раздел			= Раздел;
	Нов.Значение		= Действие;
	Нов.ИмяКартинки		= "Картинка"+ИмяКартинки;
	Нов.Гиперссылка		= Гиперссылка;
	Нов.Иконка			= Иконка;
	Нов.КодДействия		= КодДействия;
КонецПроцедуры	

Функция ПолучитьСинонимТипаОбъекта(ИмяТипа = "")
	
	ТипОбъекта = Строка(ИмяТипа);
	
	ТипОбъекта = СтрЗаменить(ТипОбъекта, "ДокументСсылка.", "Документы.");
	ТипОбъекта = СтрЗаменить(ТипОбъекта, "СправочникСсылка.", "Справочники.");
	ТипОбъекта = СтрЗаменить(ТипОбъекта, "ПеречислениеСсылка.", "Перечисления.");
	
	ОбъектМетаданных = ПолучитьОбъектМетаданных_КонтурEDI(ТипОбъекта, Истина);
	
	Если ОбъектМетаданных = Неопределено Тогда
		
		ТипОбъекта = ПолучитьТипЗначенияОбъекта(ИмяТипа);
		
		Если ТипОбъекта <> Неопределено Тогда
			
			ТипОбъекта = СтрЗаменить(ТипОбъекта, "ДокументСсылка.", "Документы.");
			ТипОбъекта = СтрЗаменить(ТипОбъекта, "СправочникСсылка.", "Справочники.");
			ТипОбъекта = СтрЗаменить(ТипОбъекта, "ПеречислениеСсылка.", "Перечисления.");
			
			ОбъектМетаданных = ПолучитьОбъектМетаданных_КонтурEDI(ТипОбъекта, Истина);  			
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОбъектМетаданных <> Неопределено Тогда
		СинонимТипа = ОбъектМетаданных.Синоним;
	Иначе
		СинонимТипа = "";
	КонецЕсли; 
	
	Возврат СинонимТипа;
	
КонецФункции

