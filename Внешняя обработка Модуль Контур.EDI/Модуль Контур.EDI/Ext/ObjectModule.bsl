Функция ИмяФормыСообщенияКонтурEDI(ТипСообщения, УправляемыеФормы = Ложь) Экспорт
	
	СоответствиеФормСообщениям = ЭДО_Кэш_Прочитать("СоответствиеФормСообщениям");
	
	Если СоответствиеФормСообщениям = Неопределено Тогда
		
		СоответствиеФормСообщениям = Новый Соответствие;
		
		СоответствиеФормСообщениям.Вставить("PRICELIST", "ФормаНезависимогоСообщения");
		СоответствиеФормСообщениям.Вставить("PRICAT",	 "ФормаНезависимогоСообщения");
		СоответствиеФормСообщениям.Вставить("SLSRPT",	 "ФормаНезависимогоСообщения");
		СоответствиеФормСообщениям.Вставить("IFTMBF",	 "ФормаСообщенияПеревозки");
		СоответствиеФормСообщениям.Вставить("IFTMBC",	 "ФормаСообщенияПеревозки");
		СоответствиеФормСообщениям.Вставить("DELFOR",	 "ФормаСообщенияDELFOR");
		СоответствиеФормСообщениям.Вставить("INVRPT",	 "ФормаСообщенияINVRPT");
		
		ЭДО_Кэш_Поместить("СоответствиеФормСообщениям", СоответствиеФормСообщениям);
		
	КонецЕсли;
	
	ИмяФормыСообщения = СоответствиеФормСообщениям.Получить(Врег(ТипСообщения));
	
	Если ИмяФормыСообщения = Неопределено Тогда
		ИмяФормыСообщения = "ФормаСообщения";      
	КонецЕсли;
	
	Если УправляемыеФормы = Истина Тогда
		ИмяФормыСообщения = ИмяФормыСообщения + "Управляемая";
	КонецЕсли;
	
	Возврат ИмяФормыСообщения;
	
КонецФункции

