Процедура УдалитьТоварыСНулевымКоличеством(Товары, ТипСообщения, Направление)
	
	Если Направление = "Исходящее" Тогда
		
		ИсключитьТипы = Новый Массив; 
		ИсключитьТипы.Добавить("ORDRSP");
		ИсключитьТипы.Добавить("COINVOIC");
		ИсключитьТипы.Добавить("PRICAT");
		ИсключитьТипы.Добавить("PRICELIST");
		ИсключитьТипы.Добавить("SLSRPT");
		ИсключитьТипы.Добавить("INVRPT");
		
		Если ИсключитьТипы.Найти(ТипСообщения) = Неопределено Тогда
			
			НулевыеПозиции = Товары.НайтиСтроки(Новый Структура("Количество", 0));
			Для Каждого НулеваяСтрока из НулевыеПозиции Цикл
				Товары.Удалить(НулеваяСтрока);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьТипСообщенияПоИсточнику_КонтурEDI(Источник)

	//мостик между старым и новым вариантом
	Если Источник = "ПодготовитьУведомлениеОбОтгрузке" Тогда
		ТипСообщения = "DESADV";
	ИначеЕсли (Источник = "ОбработкаРасхожденийПриемки" ИЛИ Источник = "ПодготовитьУведомлениеОбОтгрузке_ДляОбработкиРасхождений") Тогда
		ТипСообщения = "DESADV";
	ИначеЕсли Источник = "ОбработкаРасхожденийОбратногоЗаказа" Тогда
		ТипСообщения = "PORDERS";
	ИначеЕсли Источник = "ПодготовкаОбратногоЗаказа" Тогда
		ТипСообщения = "PORDERS";
	ИначеЕсли Источник = "ПодготовкаОтветаНаЗаказ" Тогда
		ТипСообщения = "ORDRSP";
	ИначеЕсли Источник = "ПодготовкаСчетФактурыКОтправке" Тогда
		ТипСообщения = ?(ПодготовитьINVOICПоДокументуСчетФактура(), "INVOIC", "DESADV");
		//ТипСообщения = "DESADV";//предположим, что в документе вида "Счет-фактура выданный" нет собственной табличной части для товаров.
	ИначеЕсли Источник = "ПодготовкаЗаказаПоставщику" Тогда
		ТипСообщения = "ORDERS";
	ИначеЕсли Источник = "ПодготовкаУведомленияОПриемке" Тогда
		ТипСообщения = "RECADV";
	ИначеЕсли Источник = "ПодготовкаКорректировочногоСчетаФактурыКОтправке" Тогда
		ТипСообщения = "COINVOIC";
	ИначеЕсли Источник = "ПодготовкаИсправительногоСчетаФактурыКОтправке" Тогда
		ТипСообщения = "INVOIC";
	ИначеЕсли Источник = "ПодготовитьОтветНаУведомлениеОВозврате" Тогда
		ТипСообщения = "RETINS";
	ИначеЕсли Источник = "ПодготовитьУведомлениеОПриемкеВозврата" Тогда
		ТипСообщения = "RETREC";
	ИначеЕсли Источник = "ПодготовитьУведомлениеОВозврате" Тогда
		ТипСообщения = "RETANN";
	ИначеЕсли Источник = "ПодготовитьУведомлениеОбОтгрузкеВозврата" Тогда
		ТипСообщения = "RETDES";
	КонецЕсли;
	
	Возврат ТипСообщения;

КонецФункции 

Функция ПолучитьИсточникИсходящегоСообщенияПоТипуСообщения_КонтурEDI(ТипСообщения)
	
	Если ТипСообщения = "ORDRSP" Тогда 
		
		Источник = "ПодготовкаОтветаНаЗаказ"; 
		
	ИначеЕсли ТипСообщения = "DESADV" Тогда 
		
		Источник = "ПодготовитьУведомлениеОбОтгрузке"; 
		
	ИначеЕсли ТипСообщения = "INVOIC" Тогда 
		
		Источник = "ПодготовкаСчетФактурыКОтправке"; 
		
	ИначеЕсли ТипСообщения = "ORDERS" Тогда 
		
		Источник = "ПодготовкаЗаказаПоставщику"; 
		
	ИначеЕсли ТипСообщения = "RECADV" Тогда 
		
		Источник = "ПодготовкаУведомленияОПриемке"; 
		
	ИначеЕсли ТипСообщения = "PORDERS" Тогда 
		
		Источник = "ПодготовкаОбратногоЗаказа"; 
		
	ИначеЕсли ТипСообщения = "RETINS" Тогда 
		
		Источник = "ПодготовитьОтветНаУведомлениеОВозврате"; 
		
	ИначеЕсли ТипСообщения = "RETREC" Тогда 
		
		Источник = "ПодготовитьУведомлениеОПриемкеВозврата"; 
		
	ИначеЕсли ТипСообщения = "COINVOIC" Тогда 
		
		Источник = "ПодготовкаКорректировочногоСчетаФактурыКОтправке";
		
	ИначеЕсли ТипСообщения = "ALCRPT" Тогда
		
		Источник = "ПодготовкаОтчетаОПродажеАлкоголя";
		
	Иначе 
		
		Источник = Неопределено;
		
	КонецЕсли;
		
	Возврат Источник;
	
КонецФункции

Функция ОпределитьПартнераИзСообщенияИлиДокумента(Сообщение, ДокументСсылка)

	Если НЕ Сообщение = Неопределено И ЗначениеЗаполнено(Сообщение.Партнер) Тогда
		Партнер = Сообщение.Партнер;
	Иначе
        Контрагент = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Контрагент");
		Партнер = ОпределитьПартнера(Новый Структура("ТипЗначения, ЮрФизЛицо, Сообщение", "ЮрФизЛицо", Контрагент, Сообщение));
	КонецЕсли;  
	
	Возврат Партнер; 

КонецФункции 

Функция ИсточникПодготовкиИсправительногоКорректировочногоСчетаФактуры(Источник)
	
	Возврат (Источник = "ПодготовкаИсправительногоСчетаФактурыКОтправке"
				ИЛИ Источник = "ПодготовкаКорректировочногоСчетаФактурыКОтправке");
				
КонецФункции
			
Функция ПолучитьТоварыДокументаДляСообщения(ДокументСсылка, Преобразовать = Ложь, Источник = Неопределено, МассивВозвратов = Неопределено, Сообщение=Неопределено) Экспорт
	//теперь здесь есть сообщение т.к. получение товаров может зависеть от содержимого сообщения (например партнера итд) - уже использовано при определении ОтправлятьВозвратнуюТару по партнеру
	
	Если ТипЗнч(ДокументСсылка) = Тип("Массив") Тогда
		_ОсновнойДокумент = ДокументСсылка[0];
	Иначе	
		_ОсновнойДокумент = ДокументСсылка;
	КонецЕсли;
		
	ТипСообщения = ПолучитьТипСообщенияПоИсточнику_КонтурEDI(Источник);
	
	Партнер = ОпределитьПартнераИзСообщенияИлиДокумента(Сообщение, _ОсновнойДокумент);  	
	
	СписокСвойствПартнера = ПолучитьСписокСвойствEDI(
	"ОтправлятьВозвратнуюТаруВDESADV
	|РаботаСУслугами
	|СворачиватьТаблицуТоваровДляСообщения", 
	Партнер);

	ОтправлятьВозвратнуюТару 	= СписокСвойствПартнера.ОтправлятьВозвратнуюТаруВDESADV = Истина;
	РаботаСУслугами 			= СписокСвойствПартнера.РаботаСУслугами = Истина;
	
	Если ИсточникПодготовкиИсправительногоКорректировочногоСчетаФактуры(Источник) Тогда
		ТипСообщенияДляПолученияТекстаЗапроса = "COINVOIC";
	Иначе
		ТипСообщенияДляПолученияТекстаЗапроса = ТипСообщения;
	КонецЕсли;
	
	СворачиватьСтроки			= ТипСообщенияДляПолученияТекстаЗапроса <> "COINVOIC" И СписокСвойствПартнера.СворачиватьТаблицуТоваровДляСообщения = Истина;
	ДокументПроведен 			= _ОсновнойДокумент.Проведен;
		
	Если ИмяКонфигурации1С = "УФ_УТ" 
		И ИсточникПодготовкиИсправительногоКорректировочногоСчетаФактуры(Источник) 
		И Не ЭтоВозвратТоваровОтКлиентаУФ_УТ(_ОсновнойДокумент) Тогда
		
		флСуммаВключаетНДС = Истина;
		
	Иначе
		
		флСуммаВключаетНДС = ПолучитьРеквизитДокументаДляСообщения(_ОсновнойДокумент,"СуммаВключаетНДС");
		
	Конецесли;
		
	Если МассивВозвратов = Неопределено Тогда
		МассивВозвратов = Новый Массив;
	КонецЕсли; 
	
	Запрос = Новый Запрос();
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ТипСообщения",				ТипСообщения);
	Запрос.УстановитьПараметр("Ссылка",						ДокументСсылка);
	Запрос.УстановитьПараметр("Возвраты", 					МассивВозвратов);			// если параметр сюда не передавали, то будет пустой
	Запрос.УстановитьПараметр("ОтправлятьВозвратнуюТару",	ОтправлятьВозвратнуюТару); 	// используется при подготовке DESADV
	Запрос.УстановитьПараметр("РаботаСУслугами", 			РаботаСУслугами); 			// используется при подготовке ORDRSP, DESADV, INVOIC, COINVOIC
	Запрос.УстановитьПараметр("СуммаВключаетНДС", 			флСуммаВключаетНДС); 		// параметр необходим, т.к. есть конфигурации, в которых значение в поле сумма зависит от флага СуммаВключаетНДС
	Запрос.УстановитьПараметр("СворачиватьСтроки", 			СворачиватьСтроки);
	Запрос.УстановитьПараметр("ДатаЗаказа", 				_ОсновнойДокумент.Дата);
	
	Запрос.Текст = ПолучитьТекстЗапросаПоТоварамДокумента(ТипСообщенияДляПолученияТекстаЗапроса, ДокументПроведен, , _ОсновнойДокумент); 

	Если Найти(Запрос.Текст,  "РегистрНакопления.ЗаказыПокупателей.Обороты(") > 0 
		И ТипЗнч(ДокументСсылка) = Тип("Массив") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДатаЗаказа", "");
	КонецЕсли;

	// событие для получения табличной части из внешних источников
	СтандартнаяОбработкаEDI = Истина; 
	Товары = ОбработкаСобытияПодключаемогоМодуля("ПолучитьТоварыДокумента",	СтандартнаяОбработкаEDI, 
	Новый Структура("Документ,ТипСообщения,Источник,Сообщение,Запрос", _ОсновнойДокумент, ТипСообщения, Источник, Сообщение, Запрос));																
	  	
	Если СтандартнаяОбработкаEDI Тогда 				
		Товары = Запрос.Выполнить().Выгрузить();	
	КонецЕсли;
	
	Если ТипЗнч(ДокументСсылка) = Тип("Массив") Тогда 		
		Для Каждого Документ Из ДокументСсылка Цикл  		
			УчестьАвтоматическиеИРучныеСкидкиДокумента(Товары, Документ, ТипСообщения);		
		КонецЦикла;  		
	Иначе 		
		УчестьАвтоматическиеИРучныеСкидкиДокумента(Товары, ДокументСсылка, ТипСообщения);  		
	КонецЕсли;  		
	     		
	// УФ УТ11, УФ УНФ: Нет жесткого типа единицы измерения. Сейчас здесь может быть: (ЕдиницыИзмерения, Упаковки, NUll)/(КлассификаторЕдиницИзмерения,ЕдиницыИзмерения) В дальнейшем мы не сможем выбрать колонку ЕИ напрямую в ВТ
	// Будет подставлен костыль для УТ11, который разобъет колонку на 2 типизированных перед выбором в ВТ
	// Будет подставлен костыль для УНФ, который разобъет колонку на 2 типизированных перед выбором в ВТ
	
	Если Лев(ИмяКонфигурации1С,3)="УФ_" Тогда
		ОбработатьВозвратнуюТару_УФ(Товары,ОтправлятьВозвратнуюТару,ТипСообщения);  //уничтожим тару если её не должно быть в этом сообщении
	КонецЕсли; 	
		  	
	// ... преобразовать полученные товары в edi
	ПреобразоватьТоварыДокументаВEDI(Товары, _ОсновнойДокумент, Источник, ТипСообщения, Сообщение, флСуммаВключаетНДС);

	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("ДокументСсылка", ДокументСсылка);
	ПараметрыПМ.Вставить("ТаблицаТоваров", Товары);
	ПараметрыПМ.Вставить("Источник", Источник);
	ПараметрыПМ.Вставить("МассивВозвратов", МассивВозвратов);
	ПараметрыПМ.Вставить("Сообщение", Сообщение);   
	
	РезультатПМ = ОбработкаСобытияПодключаемогоМодуля(
	"ПослеПолученияТоваровДокумента1С",, ПараметрыПМ);
	
	Если НЕ РезультатПМ = Неопределено Тогда
		Товары = РезультатПМ;
	КонецЕсли;
	
	Возврат Товары;
	
КонецФункции

Процедура ОкруглитьЦеныТоваровДокументаПослеЗапроса_КонтурEDI(Товары, Партнер)
	 	
	РазрядностьОкругленияСуммИЦен = ПолучитьРазрядностьОкругленияДляСуммИЦен(Партнер);
	
	Для Каждого СтрокаТоваров Из Товары Цикл
		
		Если ЕстьКолонкаСтрокиТаблицы_КонтурEDI(СтрокаТоваров, "ЦенаДоКорректировки") Тогда 		
			СтрокаТоваров.ЦенаДоКорректировки = Окр(СтрокаТоваров.ЦенаДоКорректировки, РазрядностьОкругленияСуммИЦен, 1); 		
		КонецЕсли;
		
		Если ЕстьКолонкаСтрокиТаблицы_КонтурEDI(СтрокаТоваров, "Цена") Тогда 		
			СтрокаТоваров.Цена = Окр(СтрокаТоваров.Цена, РазрядностьОкругленияСуммИЦен, 1); 		
		КонецЕсли;	
		
	КонецЦикла;

КонецПроцедуры

Процедура СвернутьТоварыДокументаПослеЗапроса_КонтурEDI(Товары)
	
	МассивКолонокДляСуммирования = Новый Массив;
	МассивКолонокДляСуммирования.Добавить("Количество");
	МассивКолонокДляСуммирования.Добавить("Сумма");
	МассивКолонокДляСуммирования.Добавить("СуммаНДС");
	МассивКолонокДляСуммирования.Добавить("КоличествоДоКорректировки");
	МассивКолонокДляСуммирования.Добавить("СуммаДоКорректировки");
	МассивКолонокДляСуммирования.Добавить("СуммаНДСДоКорректировки");  	
	МассивКолонокДляСуммирования.Добавить("ОтменаСуммированияПоПолям");
	
	КолонкиГруппировки = "";
	КолонкиСуммирования = "";
	
	Для Каждого КолонкаТоваров Из Товары.Колонки Цикл
		
		Если МассивКолонокДляСуммирования.Найти(КолонкаТоваров.Имя) <> Неопределено Тогда
			
			Если ЗначениеЗаполнено(КолонкиСуммирования) Тогда 			
				КолонкиСуммирования = КолонкиСуммирования + ",";  			
			Иначе 			
				КолонкиСуммирования = КолонкиСуммирования +  ""; 			
			КонецЕсли;
			
			КолонкиСуммирования = КолонкиСуммирования + КолонкаТоваров.Имя;
			
		Иначе 			
			
			Если ЗначениеЗаполнено(КолонкиГруппировки) Тогда			
				КолонкиГруппировки = КолонкиГруппировки + ","; 			
			Иначе    			
				КолонкиГруппировки = КолонкиГруппировки + "";  			
			КонецЕсли;
			
			КолонкиГруппировки = КолонкиГруппировки + КолонкаТоваров.Имя;   
			
		КонецЕсли;
		
	КонецЦикла;
	
	Товары.Свернуть(КолонкиГруппировки, КолонкиСуммирования);

КонецПроцедуры

Процедура ДозаполнитьСуммыВТаблицеТоваровДляCOINVOIC(Товары, РазрядностьОкругленияСуммИЦен)
	
	ДобавитьКолонкиВТаблицуЗначений(Товары,	"ЦенаСНДСДоКорректировки
	|ЦенаБезНДСДоКорректировки
	|СуммаСНДСДоКорректировки
	|СуммаБезНДСДоКорректировки",
	Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 2)));
	
	ТипизироватьКолонкиВТаблицеЗначений(Товары,	"ЦенаСНДСДоКорректировки
	|ЦенаБезНДСДоКорректировки
	|СуммаСНДСДоКорректировки
	|СуммаБезНДСДоКорректировки", ОписаниеТипаЧисло_КонтурEDI(15, 3));
	
	СоответствиеСтавокНДС = Новый Соответствие;
	
	Для каждого Строка Из Товары Цикл
		
		Если НЕ ЗначениеЗаполнено(Строка.СтавкаНДСДоКорректировки) Тогда
			Строка.СтавкаНДСДоКорректировки = Строка.СтавкаНДС;
		КонецЕсли;
		
		СтавкаНДСДоКорректировки = СоответствиеСтавокНДС[Строка.СтавкаНДСДоКорректировки];
		
		Если СтавкаНДСДоКорректировки  = Неопределено Тогда
			
			СтавкаНДСДоКорректировки = ПолучитьСтавкуНДС_КонтурEDI(Строка.СтавкаНДСДоКорректировки);
			
			СоответствиеСтавокНДС.Вставить(Строка.СтавкаНДСДоКорректировки, СтавкаНДСДоКорректировки);
			
		КонецЕсли;
		
		флСуммаВключаетНДС = Строка.СуммаВключаетНДС;

		Если Строка.ЦенаДоКорректировки = 0 И Строка.КоличествоДоКорректировки <> 0 Тогда
		
			Строка.ЦенаДоКорректировки = Окр(Строка.СуммаДоКорректировки / Строка.КоличествоДоКорректировки, РазрядностьОкругленияСуммИЦен, 1);	
		
		КонецЕсли;

		Если Строка.КоличествоДоКорректировки = 0 Тогда
			
			Строка.ЦенаБезНДСДоКорректировки	= 0;
			Строка.ЦенаСНДСДоКорректировки		= 0;
			
		ИначеЕсли Строка.Цена = Строка.ЦенаДоКорректировки Тогда
			
			Строка.ЦенаБезНДСДоКорректировки	= Строка.ЦенаБезНДС;
			Строка.ЦенаСНДСДоКорректировки		= Строка.ЦенаСНДС;
			
		ИначеЕсли Строка.ЦенаДоКорректировки <> 0 Тогда     				
			
			Если флСуммаВключаетНДС Тогда
				
				Строка.ЦенаСНДСДоКорректировки = Строка.ЦенаДоКорректировки;
				Строка.ЦенаБезНДСДоКорректировки = Окр((Строка.СуммаДоКорректировки - Строка.СуммаНДСДоКорректировки) / Строка.КоличествоДоКорректировки, РазрядностьОкругленияСуммИЦен, 1);
				
			Иначе
				
				Строка.ЦенаБезНДСДоКорректировки = Строка.ЦенаДоКорректировки;
				Строка.ЦенаСНДСДоКорректировки = Окр((Строка.СуммаДоКорректировки + Строка.СуммаНДСДоКорректировки) / Строка.КоличествоДоКорректировки, РазрядностьОкругленияСуммИЦен, 1);
				
			КонецЕсли; 	
			
		Иначе
			Строка.ЦенаБезНДСДоКорректировки = Окр((Строка.СуммаДоКорректировки - ?(флСуммаВключаетНДС, Строка.СуммаНДСДоКорректировки, 0)) / Строка.КоличествоДоКорректировки, РазрядностьОкругленияСуммИЦен, 1);
			Строка.ЦенаСНДСДоКорректировки = Окр((Строка.СуммаДоКорректировки + ?(флСуммаВключаетНДС, 0, Строка.СуммаНДСДоКорректировки)) / Строка.КоличествоДоКорректировки, РазрядностьОкругленияСуммИЦен, 1);
		КонецЕсли; 
		
		Если Строка.Количество = 0 Тогда
			Строка.ЦенаСНДС 	= Строка.ЦенаСНДСДоКорректировки;          
			Строка.ЦенаБезНДС 	= Строка.ЦенаБезНДСДоКорректировки;
		КонецЕсли; 
		
		Если Строка.КоличествоДоКорректировки = 0 Тогда
			Строка.ЦенаСНДСДоКорректировки = Строка.ЦенаСНДС;          
			Строка.ЦенаБезНДСДоКорректировки = Строка.ЦенаБезНДС;
		КонецЕсли;
		
		Строка.СуммаБезНДСДоКорректировки	= Строка.СуммаДоКорректировки - ?(флСуммаВключаетНДС, Строка.СуммаНДСДоКорректировки, 0);
		Строка.СуммаСНДСДоКорректировки		= Строка.СуммаДоКорректировки + ?(флСуммаВключаетНДС, 0, Строка.СуммаНДСДоКорректировки);
		Строка.СуммаНДСДоКорректировки		= Строка.СуммаСНДСДоКорректировки - Строка.СуммаБезНДСДоКорректировки;    
		
	КонецЦикла;
			
КонецПроцедуры

Функция ЭтоТиповойЗапросПоПроведенномуЗаказу_УТ_УПП_КА(ТипСообщения, ДокСсылка)
	
	// Чудесный костыль, потому что в выборке товаров Цена зависит от флага СуммаВключаетНДС, 
	// а Сумма - всегда включает НДС. Выбираем товары из регистра ЗаказыПокупателейОбороты 
	// из-за возможных корректировок ЗаказаПокупателя документом КорректировкаЗаказаПокупателя
	
	Если (ТипСообщения = "PORDERS" ИЛИ ТипСообщения = "ORDRSP") 
		И (ПолучитьИмяКонфигурацииДляЗапроса() = "УТ_УПП_КА"
		ИЛИ ПолучитьИмяКонфигурацииДляЗапроса() = "УТ_10_2")
		И ДокСсылка.Метаданные().Имя = "ЗаказПокупателя"
		И ДокСсылка.Проведен Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
		
КонецФункции

Процедура УчестьАвтоматическиеИРучныеСкидкиДокумента(ПолученныеТовары, Документ1С, ТипСообщения)
	
	Попытка
		
		ИмяТабличнойЧасти = ?(ИмяКонфигурации1С = "УФ_УНФ", "Запасы", "Товары");
		
		ИменаРеквизитовДляСкидок = Новый Массив;		
		ИмяДокумента_Документ1С =  Документ1С.Метаданные().Имя;   		
		
		Если ЕстьНеобходимыеМетаданные("Документы." + ИмяДокумента_Документ1С + ".ТабличныеЧасти." + ИмяТабличнойЧасти + ".Реквизиты.ПроцентАвтоматическихСкидок") Тогда 
			ИменаРеквизитовДляСкидок.Добавить("ПроцентАвтоматическихСкидок");
		КонецЕсли;
		
		Если ЕстьНеобходимыеМетаданные("Документы." + ИмяДокумента_Документ1С + ".ТабличныеЧасти." + ИмяТабличнойЧасти + ".Реквизиты.ПроцентАвтоматическойСкидки") Тогда 
			ИменаРеквизитовДляСкидок.Добавить("ПроцентАвтоматическойСкидки");
		КонецЕсли;
		
		Если ЕстьНеобходимыеМетаданные("Документы." + ИмяДокумента_Документ1С + ".ТабличныеЧасти." + ИмяТабличнойЧасти + ".Реквизиты.ПроцентРучнойСкидки") Тогда 
			ИменаРеквизитовДляСкидок.Добавить("ПроцентРучнойСкидки");
		КонецЕсли;
		
		Если ЕстьНеобходимыеМетаданные("Документы." + ИмяДокумента_Документ1С + ".ТабличныеЧасти." + ИмяТабличнойЧасти + ".Реквизиты.ПроцентСкидкиНаценки") Тогда 
			ИменаРеквизитовДляСкидок.Добавить("ПроцентСкидкиНаценки");
		КонецЕсли;
		
		Если ИменаРеквизитовДляСкидок.Количество() = 0 Тогда
			Возврат;   			
		КонецЕсли;
		
		ТекстКолонок = "Номенклатура";
		Для Каждого ИмяРеквизита Из ИменаРеквизитовДляСкидок Цикл
			ТекстКолонок = ТекстКолонок + "," + ИмяРеквизита;  
		КонецЦикла;
		
		ТаблицаСкидок = Документ1С[ИмяТабличнойЧасти].Выгрузить(,ТекстКолонок);
		
		Для Каждого Стр ИЗ ТаблицаСкидок Цикл
			Если АвтоматическаяСкидкаВСтрокеУстановлена(Стр, ИменаРеквизитовДляСкидок) = Истина Тогда
				НайденныеСтроки = ПолученныеТовары.НайтиСтроки(Новый Структура("Номенклатура",Стр.Номенклатура));
				Для Каждого СтрокаТаблицыТоваров Из НайденныеСтроки Цикл
					
					Если ТипСообщения = "COINVOIC" Тогда
						СтрокаТаблицыТоваров.ЦенаДоКорректировки = СтрокаТаблицыТоваров.СуммаДоКорректировки/?(СтрокаТаблицыТоваров.КоличествоДоКорректировки=0,1,СтрокаТаблицыТоваров.КоличествоДоКорректировки);
					КонецЕсли;
					
					СтрокаТаблицыТоваров.Цена = СтрокаТаблицыТоваров.Сумма/?(СтрокаТаблицыТоваров.Количество=0,1,СтрокаТаблицыТоваров.Количество);
					
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
	Исключение
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось учесть скидки в документе - " + ОписаниеОшибки());	
	КонецПопытки;
	
КонецПроцедуры

Функция АвтоматическаяСкидкаВСтрокеУстановлена(СтрокаТоваровДокумента1С, ИменаРеквизитовДляСкидок)
			
	Для Каждого ИмяРеквизита Из ИменаРеквизитовДляСкидок Цикл
		Если ЗначениеЗаполнено(СтрокаТоваровДокумента1С[ИмяРеквизита]) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
		
	Возврат Ложь;
	
КонецФункции

Процедура СравнитьТоварыДляCOINVOIC_УФ_УТ(ТоварыДо,ТоварыПосле,Товары)
	
	//по сути то же самое но только обходимо товары до и по ним ищем овары после
	//УТ11 - в ТЧ КорректировкиТУ "Товары" допускается отсутствие строки которая была в РТУ поэтому будем обходить ТЧ Товары исходной РТУ
	//Не факт что на такой механизм следует переделать все конфигурации, поэтому вынес в отдельную процедуру
	
	//по идее так мы потеряем добавленные в корректировке товары, но будем исходить что сеть не станет принимать незаказанный товар и добавления быть не может
	
	//Товары = ТоварыДо;
	ДобавитьКолонкиВТаблицуЗначений(Товары,	"ЦенаДоКорректировки
	|КоличествоДоКорректировки
	|СуммаДоКорректировки
	|СуммаНДСДоКорректировки
	|ЦенаСНДСДоКорректировки
	|ЦенаБезНДСДоКорректировки
	|СтавкаНДСДоКорректировки
	|СуммаСНДСДоКорректировки
	|СуммаБезНДСДоКорректировки");
	
	Для Каждого Стр Из Товары Цикл
		
		Стр.ЦенаДоКорректировки			= Стр.Цена;
		Стр.КоличествоДоКорректировки	= Стр.Количество;
		Стр.СуммаДоКорректировки		= Стр.Сумма;
		Стр.СуммаНДСДоКорректировки		= Стр.СуммаНДС;
		Стр.ЦенаСНДСДоКорректировки		= Стр.ЦенаСНДС;
		Стр.ЦенаБезНДСДоКорректировки	= Стр.ЦенаБезНДС;
		Стр.СтавкаНДСДоКорректировки	= Стр.СтавкаНДС;
		Стр.СуммаСНДСДоКорректировки	= Стр.СуммаСНДС;
		Стр.СуммаБезНДСДоКорректировки	= Стр.СуммаБезНДС;
		//Скопировали товары в "До"
		
		НайденныеСтроки = ТоварыПосле.НайтиСтроки(Новый Структура("GTIN,КодТовараПокупателя",
																	Стр.GTIN,
																	Стр.КодТовараПокупателя));
		Если НайденныеСтроки.Количество() > 0 Тогда
			Если НайденныеСтроки.Количество() > 1 Тогда
				НайденныеСтрокиПоСериям = ТоварыПосле.НайтиСтроки(Новый Структура("GTIN,КодТовараПокупателя,СерияНоменклатуры",
																					Стр.GTIN,
																					Стр.КодТовараПокупателя,
																					Стр.СерияНоменклатуры));
				Если НайденныеСтрокиПоСериям.Количество() > 0 Тогда
					НайденнаяСтрока = НайденныеСтрокиПоСериям[0];
				Иначе
					НайденнаяСтрока = НайденныеСтроки[0];
				КонецЕсли;
			Иначе						
				НайденнаяСтрока = НайденныеСтроки[0];
			КонецЕсли;
			
			Стр.Цена			= НайденнаяСтрока.Цена;
			Стр.Количество		= НайденнаяСтрока.Количество;
			Стр.Сумма			= НайденнаяСтрока.Сумма;
			Стр.СуммаНДС		= НайденнаяСтрока.СуммаНДС;
			Стр.ЦенаСНДС		= НайденнаяСтрока.ЦенаСНДС;
			Стр.ЦенаБезНДС		= НайденнаяСтрока.ЦенаБезНДС;
			Стр.СтавкаНДС		= НайденнаяСтрока.СтавкаНДС;
			Стр.СуммаСНДС		= НайденнаяСтрока.СуммаСНДС;
			Стр.СуммаБезНДС		= НайденнаяСтрока.СуммаБезНДС;
		Иначе        
			//не нашлась строка в товарах после корректировки - полный недогруз позиции
			
			//Стр.Цена			= НайденнаяСтрока.Цена;    //старая цена
			Стр.Количество		= 0;
			Стр.Сумма			= 0;
			Стр.СуммаНДС		= 0;
			//Стр.ЦенаСНДС		= НайденнаяСтрока.ЦенаСНДС;
			//Стр.ЦенаБезНДС	= НайденнаяСтрока.ЦенаБезНДС;
			Стр.СуммаСНДС		= 0;
			Стр.СуммаБезНДС		= 0;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

//тексты запросов получения товаров документа для исходящих сообщений лежат в ветках макета СКД.
Функция КэшШаблоновЗапросовПоТоварам() Экспорт
	
	Результат = ЭДО_Кэш_Прочитать("КэшШаблоновЗапросовПоТоварам");
	
	Если Результат = Неопределено Тогда
		
		//переинициализируем кэш
		Результат = ПолучитьСоответствиеТиповСообщенийИЗапросовПоТоварам();
		
		ЭДО_Кэш_Поместить("КэшШаблоновЗапросовПоТоварам", Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

Функция НайтиЗапросыПоСостониюДокумента(МассивТиповЗапросовПоСостояниюДокумента, ШаблоныЗапросов, ТипСообщения, ТипДокумента)
	
	СоответствиеЗапросовПоСостояниюДокумента = Новый Соответствие;
	
	Для каждого Шаблон Из ШаблоныЗапросов Цикл
		
		Если Найти(Шаблон.Имя, "_" + ТипСообщения + "_") > 0 Тогда
			
			Для Каждого Элемент Из Шаблон.Элементы Цикл
				
				ИмяШаблона = СокрЛП(Элемент.Имя);
				
				Если Найти(ИмяШаблона, ТипДокумента) > 0 Тогда
					ВариантЗапроса = СтрЗаменить(ИмяШаблона,ТипДокумента,"");
					СоответствиеЗапросовПоСостояниюДокумента.Вставить(ВариантЗапроса, Элемент.Запрос);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли; 
				
	КонецЦикла;
	
	Возврат ?(СоответствиеЗапросовПоСостояниюДокумента.Количество() = 0, Неопределено, СоответствиеЗапросовПоСостояниюДокумента);	
	
КонецФункции

Функция ПолучитьМассивТиповСостоянийДокумента_КонтурEDI()
	
	МассивТиповЗапросовПоСостояниюДокумента = Новый Массив;
	МассивТиповЗапросовПоСостояниюДокумента.Добавить("_Проведен");
	МассивТиповЗапросовПоСостояниюДокумента.Добавить("_НеПроведен");
	МассивТиповЗапросовПоСостояниюДокумента.Добавить("");
	
	Возврат МассивТиповЗапросовПоСостояниюДокумента; 
	
КонецФункции
 
Функция ПолучитьПараметрыПоискаЗапросовПоТоварамДляТиповСообщений()
	
	ПараметрыПоискаПоТипамСообщений = Новый Соответствие;
	
	ПараметрыПоискаПоТипамСообщений.Вставить("PRICELIST",	Новый Структура("ТипДокумента, Сторона", "Ценовой_лист", 			"Поставщик"));
	ПараметрыПоискаПоТипамСообщений.Вставить("PRICAT",		Новый Структура("ТипДокумента, Сторона", "Ценовой_лист", 			"Поставщик"));
	ПараметрыПоискаПоТипамСообщений.Вставить("SLSRPT",		Новый Структура("ТипДокумента, Сторона", "Отчет_о_продажах", 		"Покупатель"));
	
	Если ИмяКонфигурации1С = "УФ_УТ" 
		 И ПеременнаяСодержитСвойство(Метаданные.РегистрыСведений,"РаспределениеЗапасов") Тогда
		ПараметрыПоискаПоТипамСообщений.Вставить("INVRPT",		Новый Структура("ТипДокумента, Сторона", "Отчет_об_инвентаризации_РаспределениеЗапасов", "Покупатель"));
		ПараметрыПоискаПоТипамСообщений.Вставить("INVRPT",		Новый Структура("ТипДокумента, Сторона", "Отчет_об_инвентаризации_РаспределениеЗапасов", "Поставщик"));
	Иначе
		ПараметрыПоискаПоТипамСообщений.Вставить("INVRPT",		Новый Структура("ТипДокумента, Сторона", "Отчет_об_инвентаризации", "Покупатель"));
		ПараметрыПоискаПоТипамСообщений.Вставить("INVRPT",		Новый Структура("ТипДокумента, Сторона", "Отчет_об_инвентаризации", "Поставщик"));
	КонецЕсли; 
	
	МассивТиповСообщений = ПолучитьМассивТиповСообщенийEDI();
	
	Для Каждого ТипСообщения Из МассивТиповСообщений Цикл
		
		НайденныеСтрокиТаблицыТипов	= ТаблицаТипов.НайтиСтроки(Новый Структура("ТипСообщения, Направление", ТипСообщения, "Исходящее"));
		
		Если НайденныеСтрокиТаблицыТипов.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицыТипов = НайденныеСтрокиТаблицыТипов[0];
		
		ПараметрыПоискаПоТипамСообщений.Вставить(ТипСообщения,	Новый Структура("ТипДокумента, Сторона", СтрЗаменить(СтрокаТаблицыТипов.ИмяТипа,"ДокументСсылка.",""), СтрокаТаблицыТипов.Сторона));
						
	КонецЦикла;
		
	Возврат ПараметрыПоискаПоТипамСообщений;
	
КонецФункции

Функция ПолучитьСоответствиеТиповСообщенийИЗапросовПоТоварам()
	
	//Где будет поиск
	ШаблоныЗапросов = ПолучитьВозможныеШаблоныЗапросов(); 
	
	//Поиск чего 
	ПараметрыПоискаЗапросовПоТоварамДляТиповСообщений	= ПолучитьПараметрыПоискаЗапросовПоТоварамДляТиповСообщений(); 
	МассивТиповЗапросовПоСостояниюДокумента				= ПолучитьМассивТиповСостоянийДокумента_КонтурEDI(); 	
	
	//Если нашли, куда сохраним
	СоответствиеТиповСообщенийИЗапросовПоТоварам = Новый Соответствие;
	
	МассивИменВеткиЗапросовПоТоварам = ПолучитьМассивИменЗапросовВЗависимостиОтРелизаКонфигурации("ЗапросПоТоварам");
	
	Для каждого ПараметрыПоискаПоТипуСообщения Из ПараметрыПоискаЗапросовПоТоварамДляТиповСообщений Цикл
		
		ТипСообщения	= ПараметрыПоискаПоТипуСообщения.Ключ;
		Сторона			= ПараметрыПоискаПоТипуСообщения.Значение.Сторона;
		ТипДокумента	= ПараметрыПоискаПоТипуСообщения.Значение.ТипДокумента;
		
		СоответствиеЗапросовПоСостояниюДокумента = Неопределено;  
		
		Для Каждого ВеткаШаблонаЗапросов Из ШаблоныЗапросов Цикл
			
			Если СоответствиеЗапросовПоСостояниюДокумента = Неопределено И ВеткаШаблонаЗапросов <> Неопределено Тогда 
				
				Для Каждого ИмяВетки Из МассивИменВеткиЗапросовПоТоварам Цикл
					
					ЗапросыПоТоварам = ПолучитьСписокЗапросовИзВеткиШаблоновЗапросов(ВеткаШаблонаЗапросов, Сторона, ИмяВетки);
					
					Если Не ЗапросыПоТоварам = Неопределено Тогда 
						СоответствиеЗапросовПоСостояниюДокумента = НайтиЗапросыПоСостониюДокумента(МассивТиповЗапросовПоСостояниюДокумента, ЗапросыПоТоварам.Элементы, ТипСообщения, ТипДокумента);
						Прервать;
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
		СоответствиеТиповСообщенийИЗапросовПоТоварам.Вставить(ТипСообщения, СоответствиеЗапросовПоСостояниюДокумента); 
		                                           
	КонецЦикла;
	
	Возврат СоответствиеТиповСообщенийИЗапросовПоТоварам;
	
КонецФункции

Функция ПолучитьТаблицуПодменДляКонфигурацииЗапроса_КонтурEDI() Экспорт
	
	ТаблицаПодмен = ЭДО_Кэш_Прочитать("ТаблицаПодменДляКонфигурацииЗапроса");
	
	Если ТаблицаПодмен = Неопределено Тогда
		
		ТаблицаПодмен = ШаблоныЗапросов_СформироватьТаблицуПодменПоИмениКонфигурации();	
		
		ЭДО_Кэш_Поместить("ТаблицаПодменДляКонфигурацииЗапроса", ТаблицаПодмен);
		
	КонецЕсли;
	
	Возврат ТаблицаПодмен;		
	
КонецФункции

Функция ЕстьСтрокаПодмены(Текст, ЧтоПодменять, В_какой_таблице_подменять)
	
	Возврат Найти(Текст, ЧтоПодменять) > 0 И ?(В_какой_таблице_подменять = "", Истина, Найти(Текст, В_какой_таблице_подменять) > 0)
	
КонецФункции 

Процедура РазобратьТекстЗапроса(ТекстЗапроса, СобранныеЗапросы, СчетчикВложенныхЗапросов)

	ИмяЗапроса = "ОсновнойЗапрос";
	
	Если СобранныеЗапросы[ИмяЗапроса] = Неопределено Тогда
		 СобранныеЗапросы.Вставить(ИмяЗапроса, "");
	КонецЕсли;
	КоличествоСтрок = СтрЧислоСтрок(ТекстЗапроса);
	
	ЭтоВложенныйЗапрос = Ложь;  	
	
	ПредыдущееИмяЗапроса = "";
	ОжидаемоеКоличествоОбратныхСкобок	= 0;
	
	ДлинаСловаВыбрать = СтрДлина("ВЫБРАТЬ");
	
	Для К = 1 По КоличествоСтрок Цикл
		
		СтрокаЗапроса = СтрПолучитьСтроку(ТекстЗапроса,К);
		
		ЭтоНачалоЗапроса = Ложь;
		ПозицияСловаВыбрать = Найти(СтрокаЗапроса, "ВЫБРАТЬ");
		
		Если ПозицияСловаВыбрать <> 0 Тогда
			Если Сред(СтрокаЗапроса, ПозицияСловаВыбрать, ДлинаСловаВыбрать) = "ВЫБРАТЬ" Тогда
				ЭтоНачалоЗапроса = Истина;
			КонецЕсли;
		КонецЕсли;
			
		Если ЭтоНачалоЗапроса Тогда
			
			СчетчикВложенныхЗапросов = СчетчикВложенныхЗапросов + 1;
			
			ПредыдущееИмяЗапроса	= "" + ИмяЗапроса;							
			ИмяЗапроса				= "ВложенныйЗапросEDI_" + СчетчикВложенныхЗапросов + " ";
			
			СобранныеЗапросы.Вставить(ИмяЗапроса, "");
			
			ЭтоВложенныйЗапрос = Найти(СтрокаЗапроса, "(ВЫБРАТЬ") > 0; 
			
			Если ЭтоВложенныйЗапрос Тогда 				
				
				ОжидаемоеКоличествоОбратныхСкобок = 1;					
				
			КонецЕсли;
			
			РазбитьСтроку = СтрЗаменить(СтрокаЗапроса, "ВЫБРАТЬ", Символы.ПС);
						
			ЧастьПредыдущегоЗапроса	= "" + СтрПолучитьСтроку(РазбитьСтроку, 1);
		    ЧастьСледующегоЗапроса	= "ВЫБРАТЬ" + СтрПолучитьСтроку(РазбитьСтроку, 2);
			
			СобранныеЗапросы[ПредыдущееИмяЗапроса] = СобранныеЗапросы[ПредыдущееИмяЗапроса] + ЧастьПредыдущегоЗапроса + ИмяЗапроса;
			
			СобранныеЗапросы[ИмяЗапроса] = СобранныеЗапросы[ИмяЗапроса]  + ЧастьСледующегоЗапроса + " " ; 
			
		Иначе
			
			ЧастьСледующегоЗапроса = СтрокаЗапроса;
			
			Если ЭтоВложенныйЗапрос Тогда
				
				ОжидаемоеКоличествоОбратныхСкобок = ОжидаемоеКоличествоОбратныхСкобок + СтрЧислоВхождений(СтрокаЗапроса, "(") - СтрЧислоВхождений(СтрокаЗапроса, ")");
				
				Если ОжидаемоеКоличествоОбратныхСкобок = 0 Тогда
					ЭтоВложенныйЗапрос = Ложь;
					
					ПредыдущееИмяЗапросаБуфер	= "" + ИмяЗапроса;					
					ИмяЗапроса					= "" + ПредыдущееИмяЗапроса;
					ПредыдущееИмяЗапроса		= "" + ПредыдущееИмяЗапросаБуфер;
					
					РазбитьСтроку = СтрЗаменить(СтрокаЗапроса, ")", Символы.ПС + " ");
					КоличествоПодстрокПредыдущегоЗапроса = СтрЧислоСтрок(РазбитьСтроку) - 1;
					
					ЧастьПредыдущегоЗапроса	= "";
					Для СчетчкиПодСтрок = 1 ПО КоличествоПодстрокПредыдущегоЗапроса Цикл
						ЧастьПредыдущегоЗапроса = ЧастьПредыдущегоЗапроса + СтрПолучитьСтроку(РазбитьСтроку, СчетчкиПодСтрок) + ")"; 
					КонецЦикла;
					
					СобранныеЗапросы[ПредыдущееИмяЗапроса] = СобранныеЗапросы[ПредыдущееИмяЗапроса] + ЧастьПредыдущегоЗапроса;
					
					ЧастьСледующегоЗапроса = СтрПолучитьСтроку(РазбитьСтроку, КоличествоПодстрокПредыдущегоЗапроса + 1)
				КонецЕсли;
				
			КонецЕсли;
			
			СобранныеЗапросы[ИмяЗапроса] = СобранныеЗапросы[ИмяЗапроса] + ЧастьСледующегоЗапроса;
			
		КонецЕсли;
		
		СобранныеЗапросы[ИмяЗапроса] = СобранныеЗапросы[ИмяЗапроса] + Символы.ПС;
		
	КонецЦикла; 

КонецПроцедуры  

Процедура ЗаменитьТекстЗапросаПоРезультатамПроверкиМетаданных(ТекстЗапроса, ОписаниеТекстаПодмены)
	
	ВыполняетсяУсловиеНаМетаданные = Истина;
	
	КоличествоУсловий = СтрЧислоСтрок(ОписаниеТекстаПодмены.ВыражениеПоискаМетаданных);
	
	Для Сч_Условий = 1 По КоличествоУсловий Цикл
		
		СтрокаУсловия = СтрПолучитьСтроку(ОписаниеТекстаПодмены.ВыражениеПоискаМетаданных, Сч_Условий);
		
		Если ЗначениеЗаполнено(СтрокаУсловия) Тогда
			ВыполняетсяУсловиеНаМетаданные = ЕстьНеобходимыеМетаданные(СтрокаУсловия);
		КонецЕсли;
		
		Если ВыполняетсяУсловиеНаМетаданные = Ложь Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;  
	
	Если ВыполняетсяУсловиеНаМетаданные Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ОписаниеТекстаПодмены.ЧтоПодменять, ОписаниеТекстаПодмены.ВыражаниеЗаменыЕслиДа);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ОписаниеТекстаПодмены.ЧтоПодменять, ОписаниеТекстаПодмены.ВыражаниеЗаменыЕслиНет);
	КонецЕсли;
				
КонецПроцедуры

Процедура ОбработатьПодменыДляКонфигурации_КонтурEDI(ТекстЗапроса) Экспорт
	
	ТаблицаПодмен = ПолучитьТаблицуПодменДляКонфигурацииЗапроса_КонтурEDI();
	
	СтандартнаяОбработкаEDI = Истина;
	
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("ТекстЗапроса", ТекстЗапроса); 
	ПараметрыПМ.Вставить("ТаблицаПодмен", ТаблицаПодмен);
	
	ОбработкаСобытияПодключаемогоМодуля("ОбработатьПодменыДляКонфигурации", СтандартнаяОбработкаEDI, ПараметрыПМ);
	
	Если СтандартнаяОбработкаEDI = Ложь Тогда
		ТекстЗапроса = ПараметрыПМ.ТекстЗапроса;
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТаблицаПодмен) Тогда
		Возврат;
	КонецЕсли;
	
	ШаблоныЗапросов_ПодготовитьТекстЗапросаКПодмене_КонтурEDI(ТекстЗапроса);
	
	Для Каждого Подмена Из ТаблицаПодмен Цикл
		
		Если НЕ ЕстьСтрокаПодмены(ТекстЗапроса, Подмена.ЧтоПодменять, Подмена.В_какой_таблице_подменять) Тогда
			Продолжить;	
		КонецЕсли;
		
		СобранныеЗапросы = Новый Соответствие;
		
		СчетчикВложенныхЗапросов = 0;
		
		РазобратьТекстЗапроса(ТекстЗапроса, СобранныеЗапросы,  СчетчикВложенныхЗапросов);
		
		ТекстЗапроса = СобранныеЗапросы["ОсновнойЗапрос"];
		
		Для Счетчик = 1 ПО СчетчикВложенныхЗапросов Цикл
			
			ИмяЗапроса = КонтурСтандарт_СтрШаблон_("ВложенныйЗапросEDI_%1 ", Счетчик);
			
			ТекстЗапросаДляЗамены = СобранныеЗапросы[ИмяЗапроса];
			
			Если ЕстьСтрокаПодмены(ТекстЗапросаДляЗамены, Подмена.ЧтоПодменять, Подмена.В_какой_таблице_подменять) Тогда
				
				ЗаменитьТекстЗапросаПоРезультатамПроверкиМетаданных(ТекстЗапросаДляЗамены, Подмена);
				
			КонецЕсли;
			
			СобранныеЗапросы.Вставить(ИмяЗапроса, ТекстЗапросаДляЗамены);
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ИмяЗапроса, ТекстЗапросаДляЗамены);
			
		КонецЦикла;
		
	КонецЦикла;
		
КонецПроцедуры 

Функция ПолучитьТекстЗапросаПоТоварамДокумента(ТипСообщения, ДокументПроведен, ЗапросПолученИзШаблона = Истина, _ОсновнойДокумент = Неопределено, ВариантЗапроса = Неопределено)    
	
	ИдентификаторЗапроса = "ТекстЗапросаПоТоварамДля_" + Строка(ДокументПроведен) + Строка(ЗапросПолученИзШаблона) + Строка(ТипЗнч(_ОсновнойДокумент)) + Строка(ТипСообщения) + Строка(ВариантЗапроса);
	
	ТекстЗапроса = ЭДО_Кэш_Прочитать(ИдентификаторЗапроса);
	
	Если ТекстЗапроса = Неопределено Тогда  
		
		Если ЭтоВозвратТоваровОтКлиентаУФ_УТ(_ОсновнойДокумент) И ТипСообщения = "COINVOIC" Тогда 	
			ТекстЗапроса = УФ_УТ_ПолучитьТекстЗапросаТоваровВозвратТоваровОтПокупателя(_ОсновнойДокумент);
		Иначе 
			
			ВсеЗапросыПоТоварам = КэшШаблоновЗапросовПоТоварам(); 
			
			Если ТипЗнч(ВсеЗапросыПоТоварам) = Тип("Соответствие") Тогда		
				
				ЗапросыПоТоварамДляТипаСообщения = ВсеЗапросыПоТоварам[ТипСообщения];
				
				Если ЗапросыПоТоварамДляТипаСообщения <> Неопределено Тогда                  
					
					Если ЗначениеЗаполнено(ВариантЗапроса) Тогда
						ТекстЗапроса = ЗапросыПоТоварамДляТипаСообщения[ВариантЗапроса];
					Иначе
						Если ДокументПроведен Тогда
							ТекстЗапроса = ЗапросыПоТоварамДляТипаСообщения["_Проведен"];
						Иначе
							ТекстЗапроса = ЗапросыПоТоварамДляТипаСообщения["_НеПроведен"];
						КонецЕсли;
					КонецЕсли; 				
					
					Если ТекстЗапроса = Неопределено Тогда
						ТекстЗапроса = ЗапросыПоТоварамДляТипаСообщения[""];  				
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;  
			
			Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
				ОбработатьПодменыДляКонфигурации_КонтурEDI(ТекстЗапроса);
			ИначеЕсли ТипСообщения = "COINVOIC"  Тогда
				ЗапросПолученИзШаблона = Ложь;
				ТекстЗапроса = ПолучитьТекстЗапросаТоваровКорректировкиРеализации(ТипСообщения, _ОсновнойДокумент);
			КонецЕсли;  
		КонецЕсли; 
		
		ЭДО_Кэш_Поместить(ИдентификаторЗапроса, ТекстЗапроса);
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПолучитьТоварыРеализацииАлкогольнойПродукции(ДокументСсылка, Сообщение = Неопределено) Экспорт
	
	ТипРеализации		= ПолучитьТипЗначенияОбъекта("ИсходящееУведомлениеОбОтгрузке", Истина);
	ТипВозврата 		= ПолучитьТипЗначенияОбъекта("ВходящийВозврат", Истина);
	ТипСообщенияALCRPT 	= "ALCRPT";
	
	флСуммаВключаетНДС = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "СуммаВключаетНДС");
	
	Запрос = Новый Запрос();
	
	Если ИмяКонфигурации1С = "БП" ИЛИ ИмяКонфигурации1С = "УФ_БП" Тогда
		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеализацияТоваровУслугТовары.НомерСтроки,
		|	РеализацияТоваровУслугТовары.Номенклатура,
		|	РеализацияТоваровУслугТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	РеализацияТоваровУслугТовары.Номенклатура.Наименование КАК Наименование,
		|	РеализацияТоваровУслугТовары.Цена,
		|	РеализацияТоваровУслугТовары.СтавкаНДС,
		|	РеализацияТоваровУслугТовары.СтранаПроисхождения КАК Страна,
		|	РеализацияТоваровУслугТовары.НомерГТД КАК НомерГТД,
		|	РеализацияТоваровУслугТовары.Количество КАК Количество,
		|	ЛОЖЬ КАК Пометка,
		|	РеализацияТоваровУслугТовары.Сумма КАК Сумма
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
		|ГДЕ
		|	РеализацияТоваровУслугТовары.Ссылка = &Ссылка";
		
	ИначеЕсли ИмяКонфигурации1С = "УФ_УТ" Тогда
		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеализацияТоваровУслугТовары.НомерСтроки,
		|	РеализацияТоваровУслугТовары.Номенклатура,
		|	РеализацияТоваровУслугТовары.Характеристика КАК ХарактеристикаНоменклатуры,
       |	ВЫБОР
       |		КОГДА РеализацияТоваровУслугТовары.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиНоменклатуры.ПустаяСсылка)
       |			ТОГДА РеализацияТоваровУслугТовары.Номенклатура.ЕдиницаИзмерения
       |		ИНАЧЕ РеализацияТоваровУслугТовары.Упаковка
       |	КОНЕЦ КАК ЕдиницаИзмерения,
		|	РеализацияТоваровУслугТовары.Номенклатура.Наименование КАК Наименование,
		|	РеализацияТоваровУслугТовары.Цена,
		|	РеализацияТоваровУслугТовары.СтавкаНДС,
		|	"""" КАК СерияНоменклатуры,
		|	"""" КАК Страна,
		|	"""" КАК НомерГТД,
		|	РеализацияТоваровУслугТовары.КоличествоУпаковок - ЕСТЬNULL(ВозвратТоваровОтПокупателяТовары.КоличествоУпаковок, 0) КАК Количество,
		|	ЛОЖЬ КАК Пометка,
		|	РеализацияТоваровУслугТовары.Сумма - ЕСТЬNULL(ВозвратТоваровОтПокупателяТовары.Сумма, 0) КАК Сумма
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВозвратТоваровОтКлиента.Товары КАК ВозвратТоваровОтПокупателяТовары
		|		ПО РеализацияТоваровУслугТовары.Номенклатура = ВозвратТоваровОтПокупателяТовары.Номенклатура
		|			И РеализацияТоваровУслугТовары.Характеристика = ВозвратТоваровОтПокупателяТовары.Характеристика
		|			И РеализацияТоваровУслугТовары.Ссылка = ВозвратТоваровОтПокупателяТовары.ДокументРеализации
		|			И (ВозвратТоваровОтПокупателяТовары.Ссылка.Проведен)
		|ГДЕ
		|	РеализацияТоваровУслугТовары.Ссылка = &Ссылка";
		
		Если ОпределитьРелизКонфигурации() = "11.2" Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст,
									   "ЗНАЧЕНИЕ(Справочник.УпаковкиНоменклатуры.ПустаяСсылка)",
									   "ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)");
		КонецЕсли;
		
	ИначеЕсли ИмяКонфигурации1С = "УФ_Розница" Тогда
		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеализацияТоваровУслугТовары.НомерСтроки,
		|	РеализацияТоваровУслугТовары.Номенклатура,
		|	РеализацияТоваровУслугТовары.Характеристика,
		|	РеализацияТоваровУслугТовары.Упаковка КАК ЕдиницаИзмерения,
		|	РеализацияТоваровУслугТовары.Номенклатура.Наименование КАК Наименование,
		|	РеализацияТоваровУслугТовары.Цена,
		|	РеализацияТоваровУслугТовары.СтавкаНДС,
		|	"""" КАК Страна,
		|	"""" КАК НомерГТД,
		|	РеализацияТоваровУслугТовары.Количество * РеализацияТоваровУслугТовары.Упаковка.Коэффициент - ЕСТЬNULL(ВозвратТоваровОтПокупателяТовары.Количество, 0) * ЕСТЬNULL(ВозвратТоваровОтПокупателяТовары.Упаковка.Коэффициент, 0) КАК Количество,
		|	ЛОЖЬ КАК Пометка,
		|	РеализацияТоваровУслугТовары.Сумма - ЕСТЬNULL(ВозвратТоваровОтПокупателяТовары.Сумма, 0) КАК Сумма
		|ИЗ
		|	Документ.РеализацияТоваров.Товары КАК РеализацияТоваровУслугТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВозвратТоваровОтПокупателя.Товары КАК ВозвратТоваровОтПокупателяТовары
		|		ПО РеализацияТоваровУслугТовары.Номенклатура = ВозвратТоваровОтПокупателяТовары.Номенклатура
		|			И РеализацияТоваровУслугТовары.Характеристика = ВозвратТоваровОтПокупателяТовары.Характеристика
		|			И (ВозвратТоваровОтПокупателяТовары.ДокументПродажи = &Ссылка)
		|			И (ВозвратТоваровОтПокупателяТовары.Ссылка.Проведен)
		|ГДЕ
		|	РеализацияТоваровУслугТовары.Ссылка = &Ссылка";

	Иначе
		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеализацияТоваровУслугТовары.НомерСтроки,
		|	РеализацияТоваровУслугТовары.Номенклатура,
		|	РеализацияТоваровУслугТовары.ХарактеристикаНоменклатуры,
		|	РеализацияТоваровУслугТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	РеализацияТоваровУслугТовары.Номенклатура.Наименование КАК Наименование,
		|	РеализацияТоваровУслугТовары.Цена,
		|	РеализацияТоваровУслугТовары.СтавкаНДС,
		|	РеализацияТоваровУслугТовары.СерияНоменклатуры,
		|	ЕСТЬNULL(РеализацияТоваровУслугТовары.СерияНоменклатуры.СтранаПроисхождения, ЕСТЬNULL(РеализацияТоваровУслугТовары.Номенклатура.СтранаПроисхождения, """")) КАК Страна,
		|	ЕСТЬNULL(РеализацияТоваровУслугТовары.СерияНоменклатуры.НомерГТД.Код, ЕСТЬNULL(РеализацияТоваровУслугТовары.Номенклатура.НомерГТД.Код, """")) КАК НомерГТД,
		|	РеализацияТоваровУслугТовары.Количество * РеализацияТоваровУслугТовары.Коэффициент - ЕСТЬNULL(ВозвратТоваровОтПокупателяТовары.Количество, 0) * ЕСТЬNULL(ВозвратТоваровОтПокупателяТовары.Коэффициент, 0) КАК Количество,
		|	ЛОЖЬ КАК Пометка,
		|	РеализацияТоваровУслугТовары.Сумма - ЕСТЬNULL(ВозвратТоваровОтПокупателяТовары.Сумма, 0) КАК Сумма
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВозвратТоваровОтПокупателя.Товары КАК ВозвратТоваровОтПокупателяТовары
		|		ПО РеализацияТоваровУслугТовары.Номенклатура = ВозвратТоваровОтПокупателяТовары.Номенклатура
		|			И РеализацияТоваровУслугТовары.ХарактеристикаНоменклатуры = ВозвратТоваровОтПокупателяТовары.ХарактеристикаНоменклатуры
		|			И РеализацияТоваровУслугТовары.СерияНоменклатуры = ВозвратТоваровОтПокупателяТовары.СерияНоменклатуры
		|			И (ВозвратТоваровОтПокупателяТовары.ДокументПартии = &Ссылка)
		|			И (ВозвратТоваровОтПокупателяТовары.Ссылка.Проведен)
		|ГДЕ
		|	РеализацияТоваровУслугТовары.Ссылка = &Ссылка";
		
	КонецЕсли;			   
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	//конструктор
	Запрос.Текст=СтрЗаменить(Запрос.Текст,"Документ.РеализацияТоваровУслуг",ТипРеализации);
	Запрос.Текст=СтрЗаменить(Запрос.Текст,"Документ.ВозвратТоваровОтПокупателя",ТипВозврата);
	
	Источник = ПолучитьИсточникИсходящегоСообщенияПоТипуСообщения_КонтурEDI(ТипСообщенияALCRPT);
	
	СтандартнаяОбработкаEDI = Истина;
	
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("Документ", ДокументСсылка); 
	ПараметрыПМ.Вставить("ТипСообщения", ТипСообщенияALCRPT);
	ПараметрыПМ.Вставить("Источник", Источник);
	ПараметрыПМ.Вставить("Сообщение", Сообщение);
	ПараметрыПМ.Вставить("Запрос", Запрос);

	Товары = ОбработкаСобытияПодключаемогоМодуля("ПолучитьТоварыДокумента", СтандартнаяОбработкаEDI, ПараметрыПМ);
	
	Если СтандартнаяОбработкаEDI = Истина Тогда
		
		Если ИмяКонфигурации1С = "УФ_УНФ" Тогда 
			ВызватьИсключение ("Нет встроенного в модуль алгоритма получения алкореквизитов для УНФ.
								|Для отправки ALCRPT используйте подключаемый модуль.");
		КонецЕсли;
		
		Товары = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
	
	Партнер = ПолучитьПартнераПоДокументу(ДокументСсылка, "Реализация");
	
	// ... подготовить таблицу товаров к конвертации
	ДопПараметры = ПараметрыПодготовкиТаблицыТоваров();
	
	ДопПараметры.СуммаВключаетНДС = флСуммаВключаетНДС;
	ДопПараметры.ЭтоТиповойЗапросПоПроведенномуЗаказу_УТ_УПП_КА = 
	ЭтоТиповойЗапросПоПроведенномуЗаказу_УТ_УПП_КА(ТипСообщенияALCRPT, ДокументСсылка);
	
	ДопПараметры.Направление = "Исходящее";
	ДопПараметры.ТипСообщения = ТипСообщенияALCRPT;
	ДопПараметры.МыПоставщик = Истина;
	ДопПараметры.ЭтоОбратнаяОтгрузка = Ложь;
			
	ПодготовитьТаблицуТоваровККонвертации1СВEDI(Товары, Партнер, ТипСообщенияALCRPT, ДопПараметры);
	
	ПреобразоватьТоварыДокументаВEDI(Товары, ДокументСсылка, Источник, ТипСообщенияALCRPT);

	Возврат Товары;
	
КонецФункции

//На входе - ТаблицаЗначений с колонками "Цена","Сумма","СтавкаНДС","СуммаНДС", флаг "флСуммаВключаетНДС" и "Алгоритм" - откуда вызвана данная процедура
//На выходе - та же таблица с добавленными и рассчитанными колонками "ЦенаБезНДС,ЦенаСНДС,СуммаБезНДС,СуммаСНДС"
Процедура ДозаполнитьСуммыВТаблицеТоваров(Товары, РазрядностьОкругленияСуммИЦен) Экспорт
	
	// Будем рассчитывать суммы так же, как это сделано в печатных формах счетов-фактур и ТОРГ12
	// Самым правильным кажется вариант "ПолучитьТоварыРеализацииТоваров", его пока и оставим.
	
	// в некоторых случаях мы не можем в явном виде получить сумму НДС
	СчитатьОтСтавкиНДС = Ложь;
	Если (Товары.Колонки.Найти("СуммаНДС") = Неопределено)
		Или (Товары.Колонки.СуммаНДС.ТипЗначения = Новый ОписаниеТипов("Неопределено")) Тогда
		СчитатьОтСтавкиНДС = Истина;
	КонецЕсли;
		
	ДобавитьКолонкиВТаблицуЗначений(Товары, "ЦенаСНДС,ЦенаБезНДС,СуммаСНДС,СуммаБезНДС,СуммаНДС");
	ТипизироватьКолонкиВТаблицеЗначений(Товары, "ЦенаСНДС,ЦенаБезНДС,СуммаСНДС,СуммаБезНДС,СуммаНДС", ОписаниеТипаЧисло_КонтурEDI(15, РазрядностьОкругленияСуммИЦен));
		
	Для Каждого Стр Из Товары Цикл 		
		
		флСуммаВключаетНДС = Стр.СуммаВключаетНДС;
		
		// Определяем ставку, если нужно.
		Если ЗначениеЗаполнено(Стр.СтавкаНДС) Тогда
			СтавкаНДС = ПолучитьСтавкуНДС_КонтурEDI(Стр.СтавкаНДС);  
		Иначе
			СтавкаНДС = Неопределено;
		КонецЕсли;
		
		ПересчитатьСуммуНДС = Ложь;
		
		Если Стр.СуммаНДС = 0
			И Не Стр.Количество = 0
			И ТипЗнч(СтавкаНДС) = Тип("Число")
			И Не СтавкаНДС = 0 Тогда
			
			ПересчитатьСуммуНДС = Истина;
			
		КонецЕсли;
		
		Если СчитатьОтСтавкиНДС 
				ИЛИ ПересчитатьСуммуНДС
				ИЛИ (Стр.Количество = 0 И ТипЗнч(СтавкаНДС) = Тип("Число")) Тогда	
			ДозаполнитьЦеныВСтрокеТоваровОтСтавкиНДС(Стр, флСуммаВключаетНДС, СтавкаНДС, РазрядностьОкругленияСуммИЦен);
		Иначе
			ДозаполнитьЦеныВСтрокеТоваровОтСуммыНДС(Стр, флСуммаВключаетНДС, РазрядностьОкругленияСуммИЦен);
		КонецЕсли;
		 		
		// Расчитаем суммы
		Если СчитатьОтСтавкиНДС	ИЛИ ПересчитатьСуммуНДС Тогда
						   				
			ДозаполнитьСуммыВСтрокеТоваровОтСтавкиНДС(Стр, флСуммаВключаетНДС, СтавкаНДС, Ложь, РазрядностьОкругленияСуммИЦен);
			
		Иначе 		
			 
			ДозаполнитьСуммыВСтрокеТоваровОтСуммыНДС(Стр, флСуммаВключаетНДС, Ложь, РазрядностьОкругленияСуммИЦен);
			
		КонецЕсли;   	
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДозаполнитьЦеныВСтрокеТоваровОтСтавкиНДС(Строка, флСуммаВключаетНДС, СтавкаНДС, РазрядностьОкругленияСуммИЦен) Экспорт

	Если НЕ ЗначениеЗаполнено(СтавкаНДС) Тогда 
		Строка.ЦенаБезНДС    = Строка.Цена;
		Строка.ЦенаСНДС      = Строка.Цена;  
		Возврат;
	КонецЕсли;
	
	Если флСуммаВключаетНДС Тогда
		Строка.ЦенаБезНДС	= Окр((Строка.Цена * 100) / (100 + СтавкаНДС), РазрядностьОкругленияСуммИЦен, 1);
		Строка.ЦенаСНДС		= Строка.Цена;
	Иначе
		Строка.ЦенаСНДС		= Окр((Строка.Цена * (100 + СтавкаНДС)) / 100, РазрядностьОкругленияСуммИЦен, 1);
		Строка.ЦенаБезНДС	= Строка.Цена;
	КонецЕсли;
		
КонецПроцедуры 

Процедура ДозаполнитьСуммыВСтрокеТоваровОтСтавкиНДС(Строка, флСуммаВключаетНДС, СтавкаНДС, РасчитатьЦены = Истина, РазрядностьОкругленияСуммИЦен) Экспорт
	
	Если РасчитатьЦены Тогда
		
		ДозаполнитьЦеныВСтрокеТоваровОтСтавкиНДС(Строка, флСуммаВключаетНДС, СтавкаНДС, РазрядностьОкругленияСуммИЦен)
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтавкаНДС) Тогда 
		Строка.СуммаБезНДС  = Строка.Сумма;
		Строка.СуммаСНДС     = Строка.Сумма;
		Строка.СуммаНДС      = 0;
		Возврат;
	КонецЕсли;
	
	Если флСуммаВключаетНДС Тогда
		Строка.СуммаБезНДС	= Окр((Строка.Сумма * 100) / (100 + СтавкаНДС), РазрядностьОкругленияСуммИЦен, 1);
		Строка.СуммаСНДС   	= Строка.Сумма;
	Иначе
		Строка.СуммаСНДС	= Окр((Строка.Сумма * (100 + СтавкаНДС)) / 100, РазрядностьОкругленияСуммИЦен, 1);
		Строка.СуммаБезНДС 	= Строка.Сумма;
	КонецЕсли;
	
	Строка.СуммаНДС = Строка.СуммаСНДС - Строка.СуммаБезНДС; 
		
КонецПроцедуры

Процедура ДозаполнитьЦеныВСтрокеТоваровОтСуммыНДС(Строка, флСуммаВключаетНДС, РазрядностьОкругленияСуммИЦен) Экспорт
    		
	Если НЕ Строка.Количество = 0 Тогда
		
		Если Строка.Цена <> 0 Тогда
			
			Если флСуммаВключаетНДС Тогда
				Строка.ЦенаСНДС = Строка.Цена;
				Строка.ЦенаБезНДС	= Окр((Строка.Сумма - Строка.СуммаНДС) / Строка.Количество, РазрядностьОкругленияСуммИЦен, 1);
			Иначе
				Строка.ЦенаБезНДС	= Строка.Цена;
				Строка.ЦенаСНДС		= Окр((Строка.Сумма + Строка.СуммаНДС) / Строка.Количество, РазрядностьОкругленияСуммИЦен, 1);
			КонецЕсли; 	
			
		Иначе
			
			Строка.ЦенаБезНДС	= Окр((Строка.Сумма - ?(флСуммаВключаетНДС, Строка.СуммаНДС, 0)) / Строка.Количество, РазрядностьОкругленияСуммИЦен, 1);
			Строка.ЦенаСНДС		= Окр((Строка.Сумма + ?(флСуммаВключаетНДС, 0, Строка.СуммаНДС)) / Строка.Количество, РазрядностьОкругленияСуммИЦен, 1);
			
		КонецЕсли;
		
	Иначе
		
		Строка.ЦенаБезНДС 	= 0;
		Строка.ЦенаСНДС 	= 0;
		
	КонецЕсли;		

КонецПроцедуры                                          

Процедура ДозаполнитьСуммыВСтрокеТоваровОтСуммыНДС(Строка, флСуммаВключаетНДС, РасчитатьЦены = Истина, РазрядностьОкругленияСуммИЦен) Экспорт

	Если РасчитатьЦены Тогда
		
		ДозаполнитьЦеныВСтрокеТоваровОтСуммыНДС(Строка, флСуммаВключаетНДС, РазрядностьОкругленияСуммИЦен)
		
	КонецЕсли;
	
	Строка.СуммаБезНДС	= Строка.Сумма - ?(флСуммаВключаетНДС, Строка.СуммаНДС, 0);
	Строка.СуммаСНДС	= Строка.Сумма + ?(флСуммаВключаетНДС, 0, Строка.СуммаНДС);
	Строка.СуммаНДС 	= Строка.СуммаСНДС - Строка.СуммаБезНДС; 		

КонецПроцедуры

Функция ПолучитьПартнераПоДокументу(ДокументСсылка,ВидДокумента) Экспорт
	
	//Вохожее есть в КонвертироватьСообщениеEDIВ1С или в ОбработатьВходящееСообщение
	//Возможно, вообще нет смысла ходить по связкам документов, достаточно получить партнера напрямую из контрагента.
	
	//1. Поищем Партнера по входящему ORDERS
	Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_Сообщения.Партнер
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|ГДЕ
	|	КонтурEDI_Сообщения.Документ = &Документ
	|	И КонтурEDI_Сообщения.ТипСообщения = ""ORDERS""";
	
	ТипВходящийВозврат = ПолучитьТипЗначенияОбъекта("ВходящийВозврат",,);
	
	//а - это если Заказ
	Если ВидДокумента = "Заказ" Тогда
		
		Запрос.УстановитьПараметр("Документ",ПреобразоватьЗначениеДляВнешнегоХранилища(ДокументСсылка));
		
	//б - если это реализация	
	ИначеЕсли ЗначениеЗаполнено(ТипВходящийВозврат) И ТипЗнч(ДокументСсылка) = Тип(ТипВходящийВозврат)  Тогда
		
		Запрос.УстановитьПараметр("Документ",Неопределено);
		
	ИначеЕсли ВидДокумента = "Реализация" Тогда                         
		
		ТипИсходящийКСФ = ПолучитьТипЗначенияОбъекта("ИсходящийКСФ");
		
		Если ЕстьКоррИспрСФ
			И ЗначениеЗаполнено(ТипИсходящийКСФ)
			И ТипЗнч(ДокументСсылка) = Тип(ТипИсходящийКСФ) Тогда
			ДокументРеализации = ПолучитьИсходныйДокументОтгрузкиКорректировкиРеализации(ДокументСсылка);
			Заказ = НайтиСвязанныйДокументПоТипуСообщения(ДокументРеализации,"ORDERS");
        Иначе
			Заказ = НайтиСвязанныйДокументПоТипуСообщения(ДокументСсылка,"ORDERS");
		КонецЕсли;	
		Запрос.УстановитьПараметр("Документ",ПреобразоватьЗначениеДляВнешнегоХранилища(Заказ));
		
	КонецЕсли;
	
	ВладелецСпискаНоменклатуры=Неопределено;
	Если ЗначениеЗаполнено(Запрос.Параметры.Документ) Тогда
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			
			ВладелецСпискаНоменклатуры = Неопределено;
			
		Иначе
			
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			
			ВладелецСпискаНоменклатуры = Выборка.Партнер;
			
		КонецЕсли;
		
	КонецЕсли;

    ПартнерНайден = ?(ВнешнееХранилище,СоединениеСХранилищем.ЗначениеЗаполнено(ВладелецСпискаНоменклатуры),ЗначениеЗаполнено(ВладелецСпискаНоменклатуры));
	Если ПартнерНайден Тогда
		Если ВнешнееХранилище Тогда
			ВладелецСпискаНоменклатуры = СоединениеСХранилищем.ЗначениеВСтрокуВнутр(ВладелецСпискаНоменклатуры);
		КонецЕсли;
	Иначе
		//не нашли партнера по сообщению, поищем другим способом
		КонтрагентДокумента = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Контрагент");
		ВладелецСпискаНоменклатуры = ОпределитьПартнера(Новый Структура("ТипЗначения,ЮрФизЛицо", "ЮрФизЛицо", КонтрагентДокумента));
	КонецЕсли;
	
	Возврат ВладелецСпискаНоменклатуры;
	
КонецФункции

Процедура ПреобразоватьТоварыДокументаВEDI(
	ТаблицаТоваров,
	ДокументСсылка, 
	Источник, 
	ТипСообщения, 
	Сообщение = Неопределено, 
	флСуммаВключаетНДС = Истина) Экспорт
	
	Партнер = ОпределитьПартнераИзСообщенияИлиДокумента(Сообщение, ДокументСсылка);
	
	// ... подготовить таблицу товаров к конвертации
		
	ДопПараметры = ПараметрыПодготовкиТаблицыТоваров();
	
	ДопПараметры.СуммаВключаетНДС = флСуммаВключаетНДС;
	
	ДопПараметры.ЭтоТиповойЗапросПоПроведенномуЗаказу_УТ_УПП_КА = 
	ЭтоТиповойЗапросПоПроведенномуЗаказу_УТ_УПП_КА(ТипСообщения, ДокументСсылка);
	
	ДопПараметры.Направление = "Исходящее";
	ДопПараметры.ТипСообщения = ТипСообщения;
	
	ПараметрыОпределенияРежима = Новый Структура("Направление, ТипСообщения", "Исходящее", ТипСообщения) ;
		
	ДопПараметры.МыПоставщик = (ОпределитьКемМыЯвляемся(ПараметрыОпределенияРежима) = "Поставщик");

	ДопПараметры.ЭтоОбратнаяОтгрузка = ЭтоОбратнаяОтгрузка(ТипСообщения);
	
	ПодготовитьТаблицуТоваровККонвертации1СВEDI(ТаблицаТоваров, Партнер, ТипСообщения, ДопПараметры);
	
	// ... конвертировать
	КонвертироватьТовары1СвEDI(ТаблицаТоваров, Партнер, ДокументСсылка, ТипСообщения, Источник, ДопПараметры.ЭтоОбратнаяОтгрузка, Сообщение);
	
	СвернутьТаблицуТоваровДляСообщения(ТаблицаТоваров, Источник, ТипСообщения, Партнер);
	
	// ... после конвертации
	ПересчитатьТоварыСообщения(ТаблицаТоваров, Партнер, "ВEDI", Сообщение);
	      		
	УдалитьТоварыСНулевымКоличеством(ТаблицаТоваров, ТипСообщения, "Исходящее");	
		
	ДозаполнитьСуммыТоваров_КонтурEDI(Партнер, ТипСообщения, ТаблицаТоваров);
	
КонецПроцедуры

Процедура ДозаполнитьСуммыТоваров_КонтурEDI(Партнер, ТипСообщения, Товары)
	 		
	РазрядностьОкругленияСуммИЦен = ПолучитьРазрядностьОкругленияДляСуммИЦен(Партнер); 	
		
	ДозаполнитьСуммыВТаблицеТоваров(Товары, РазрядностьОкругленияСуммИЦен);
	
	Если ТипСообщения = "COINVOIC" Тогда			
		ДозаполнитьСуммыВТаблицеТоваровДляCOINVOIC(Товары, РазрядностьОкругленияСуммИЦен);						
	КонецЕсли;

КонецПроцедуры

//продолжаем декомпозицию метода "ПреобразоватьТоварыДокументаВEDI()
Процедура СвернутьТаблицуТоваровДляСообщения(ТаблицаТоваров, Источник, ТипСообщения, Партнер)
	//Свернем таблицу по тем полям, которые в ней есть. А количества/суммы сгруппируем.
	//Сворачивать надо по тем полям, которые присутствуют в XML
		
	КолонкиДляСуммирования = Новый Массив;
	КолонкиДляСуммирования.Добавить("Количество");
	КолонкиДляСуммирования.Добавить("Сумма");
	КолонкиДляСуммирования.Добавить("СуммаНДС");
	КолонкиДляСуммирования.Добавить("КоличествоДоКорректировки");
	КолонкиДляСуммирования.Добавить("СуммаДоКорректировки");
	КолонкиДляСуммирования.Добавить("СуммаНДСДоКорректировки");  
	КолонкиДляСуммирования.Добавить("СуммаВключаетНДС");
	                              
	КолонкиДляГруппировки = Новый Массив;
	КолонкиДляГруппировки.Добавить("GTIN");
	КолонкиДляГруппировки.Добавить("КодТовараПокупателя");
	КолонкиДляГруппировки.Добавить("КодТовараПоставщика");
	КолонкиДляГруппировки.Добавить("КодТовараВнутренний");  	
	КолонкиДляГруппировки.Добавить("КодЕдиницыИзмеренияEDI");
	КолонкиДляГруппировки.Добавить("Номенклатура");
	КолонкиДляГруппировки.Добавить("Наименование");
	КолонкиДляГруппировки.Добавить("ХарактеристикаНоменклатуры");
	КолонкиДляГруппировки.Добавить("СерияНоменклатуры");
	КолонкиДляГруппировки.Добавить("ЕдиницаИзмерения");
	КолонкиДляГруппировки.Добавить("Пометка");
	КолонкиДляГруппировки.Добавить("СтавкаНДС");
	КолонкиДляГруппировки.Добавить("Цена");
	КолонкиДляГруппировки.Добавить("ЦенаСНДС");
	КолонкиДляГруппировки.Добавить("ЦенаБезНДС");
	КолонкиДляГруппировки.Добавить("НомерГТД");
	КолонкиДляГруппировки.Добавить("Страна");
	КолонкиДляГруппировки.Добавить("ТипЕдиницы");
	КолонкиДляГруппировки.Добавить("ОтменаСуммированияПоПолям");
	КолонкиДляГруппировки.Добавить("КоэффициентEDIВ1С");
	КолонкиДляГруппировки.Добавить("УИД_СтрокиПредыдущегоСообщения");
	КолонкиДляГруппировки.Добавить("УИД_СтрокиПервоначальногоСообщения");
	КолонкиДляГруппировки.Добавить("ПредыдущееСообщение");
	КолонкиДляГруппировки.Добавить("ПервоначальноеСообщение");
	КолонкиДляГруппировки.Добавить("МногиеКоМногим");
	КолонкиДляГруппировки.Добавить("УИД_Свертки"); 	
	
	СтандартнаяОбработкаEDI = Истина;
	
	ОбработкаСобытияПодключаемогоМодуля("СвернутьТаблицуТоваровДляСообщения", СтандартнаяОбработкаEDI, 
	Новый Структура(
	"ТаблицаТоваров,Партнер,Источник,ТипСообщения,КолонкиДляСуммирования,КолонкиДляГруппировки", 
	ТаблицаТоваров, Партнер, Источник, ТипСообщения, КолонкиДляСуммирования, КолонкиДляГруппировки));	
	
	ОтменитьСворачиваниеТоваров = НЕ СтандартнаяОбработкаEDI
	ИЛИ Источник = "ОбработкаРасхожденийПриемки" 
	ИЛИ Источник = "ОбработкаРасхожденийОбратногоЗаказа"
	ИЛИ Источник = "ПодготовкаКорректировочногоСчетаФактурыКОтправке";
		
	Если ОтменитьСворачиваниеТоваров Тогда		
		Возврат;		
	КонецЕсли;
	
	// ... разделить таблицу товаров на строки для свертки и строки без свертки
	МассивСтрокДляСвертки = ТаблицаТоваров.НайтиСтроки(Новый Структура("ОтменаСуммированияПоПолям", Ложь));
	ТаблицаСоСтрокамиДляСвертки = ТаблицаТоваров.Скопировать(МассивСтрокДляСвертки);
	
	МассивСтрокБезСвертки = ТаблицаТоваров.НайтиСтроки(Новый Структура("ОтменаСуммированияПоПолям", Истина));
	ТаблицаСоСтрокамиБезСвертки = ТаблицаТоваров.Скопировать(МассивСтрокБезСвертки); 
	
	// ... определить имена колонок со своим и сторонним кодом
	Если ЭтоОбратнаяОтгрузка(ТипСообщения) Тогда
		ИмяСвоегоКода	= "КодТовараПокупателя";
		ИмяКодаПартнера	= "КодТовараПоставщика";
	Иначе
		ИмяСвоегоКода	= "КодТовараПоставщика";
		ИмяКодаПартнера	= "КодТовараПокупателя";
	КонецЕсли;
	
	// дополним таблицу колонками ключевых полей для свёртки
	ТаблицаСоСтрокамиДляСвертки.Колонки.Добавить("Обработана", 				Новый ОписаниеТипов("Булево"));
	ТаблицаСоСтрокамиДляСвертки.Колонки.Добавить("НоменклатураАналитика", 	ТаблицаСоСтрокамиДляСвертки.Колонки.Номенклатура.ТипЗначения);
	ТаблицаСоСтрокамиДляСвертки.Колонки.Добавить("ХарактеристикаАналитика", ТаблицаСоСтрокамиДляСвертки.Колонки.ХарактеристикаНоменклатуры.ТипЗначения); 
	ТаблицаСоСтрокамиДляСвертки.Колонки.Добавить("СерияАналитика", 			ТаблицаСоСтрокамиДляСвертки.Колонки.СерияНоменклатуры.ТипЗначения); 
	ТаблицаСоСтрокамиДляСвертки.Колонки.Добавить("УпаковкаАналитика", 		ТаблицаСоСтрокамиДляСвертки.Колонки.ЕдиницаИзмерения.ТипЗначения); 
	
	Для Каждого Стр Из ТаблицаСоСтрокамиДляСвертки Цикл
		
		ЕдинственнаяНоменклатура = Истина;
		
		Если НЕ (ЗначениеЗаполнено(Стр.GTIN) ИЛИ ЗначениеЗаполнено(Стр[ИмяКодаПартнера])) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Стр.Обработана Тогда
			Продолжить;
		КонецЕсли;

		СтруктураПоиска = Новый Структура();
		СтруктураПоиска.Вставить("GTIN", Стр.GTIN);
		СтруктураПоиска.Вставить(ИмяКодаПартнера, Стр[ИмяКодаПартнера]);
		СтруктураПоиска.Вставить("КодЕдиницыИзмеренияEDI", Стр.КодЕдиницыИзмеренияEDI);
		
		НайденныеСтроки = ТаблицаСоСтрокамиДляСвертки.НайтиСтроки(СтруктураПоиска);
		
		Если НайденныеСтроки.Количество() > 1 Тогда
			
			ЕдИзмеренияОбщая = НайденныеСтроки[0].ЕдиницаИзмерения;
			НоменклатураОбщая = Неопределено;
			
			ПерваяНоменклатура = НайденныеСтроки[0].Номенклатура;
			Для Каждого СтрокаНайденныхСтрок Из НайденныеСтроки Цикл
				Если СтрокаНайденныхСтрок.Номенклатура <> ПерваяНоменклатура Тогда
					ЕдинственнаяНоменклатура = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ЕдинственнаяНоменклатура Тогда
				НоменклатураОбщая = НайденныеСтроки[0].Номенклатура;
			КонецЕсли;	
			
			Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				
				НайденнаяСтрока.Обработана = Истина;
				
				// сохраним ключевые поля 
				НайденнаяСтрока.НоменклатураАналитика   = НайденнаяСтрока.Номенклатура;
				НайденнаяСтрока.ХарактеристикаАналитика = НайденнаяСтрока.ХарактеристикаНоменклатуры;
				НайденнаяСтрока.СерияАналитика		    = НайденнаяСтрока.СерияНоменклатуры;
				НайденнаяСтрока.УпаковкаАналитика		= НайденнаяСтрока.ЕдиницаИзмерения;				
				
				НайденнаяСтрока.Номенклатура = НоменклатураОбщая;
				НайденнаяСтрока.ХарактеристикаНоменклатуры = "";
				НайденнаяСтрока.ЕдиницаИзмерения = ЕдИзмеренияОбщая;
				
				Если НЕ ЕдинственнаяНоменклатура Тогда
					НайденнаяСтрока[ИмяСвоегоКода] = "";
				КонецЕсли;
				
				Если Источник = "ПодготовкаОтветаНаЗаказ" Тогда
					
					Если ЕдинственнаяНоменклатура Тогда  							
						СвойстваДляОчистки = "Страна,НомерГТД,СерияНоменклатуры";							
					Иначе  							
						СвойстваДляОчистки = "Страна,НомерГТД,ЕдиницаИзмерения,СерияНоменклатуры"; 							
					КонецЕсли; 						
					
					ЗаполнитьЗначенияСвойств(НайденнаяСтрока, Новый Структура(СвойстваДляОчистки));
					
				КонецЕсли;						
				
			КонецЦикла;	
			
		КонецЕсли;	
		
	КонецЦикла;
	ТаблицаСоСтрокамиДляСвертки.ЗаполнитьЗначения(Ложь, "Обработана");
	
	ГруппируемыеПоля = Новый Массив;
	СуммируемыеПоля = Новый Массив;
		
	Для Каждого Поле Из КолонкиДляСуммирования Цикл
		Если ТаблицаСоСтрокамиДляСвертки.Колонки.Найти(Поле) <> Неопределено Тогда 
			СуммируемыеПоля.Добавить(Поле);	
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Поле Из КолонкиДляГруппировки Цикл
		Если ТаблицаСоСтрокамиДляСвертки.Колонки.Найти(Поле) <> Неопределено Тогда 
			ГруппируемыеПоля.Добавить(Поле);	
		КонецЕсли;
	КонецЦикла;
	
	// ... восстановить таблицу из строк со сверткой и без свертки
	ТаблицаТоваров.Очистить();
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваров, "НомерСтроки", ОписаниеТипаЧисло_КонтурEDI());
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваров, "СписокНоменклатуры", Новый ОписаниеТипов("СписокЗначений"));
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаТоваров, "ИсходныеСтрокиТовара", Новый ОписаниеТипов("Массив"));

	НомерСтроки = 0;
	ГруппируемыеПоляСтрокой = КонтурСтандарт_СтрСоединить_(ГруппируемыеПоля, ",");
	
	Для Каждого Стр Из ТаблицаСоСтрокамиДляСвертки Цикл
		
		Если Стр.Обработана Тогда
			Продолжить;	
		КонецЕсли; 

		СтруктураПоиска = Новый Структура(ГруппируемыеПоляСтрокой);
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, Стр, ГруппируемыеПоляСтрокой);
		
		НайденныеСтроки = ТаблицаСоСтрокамиДляСвертки.НайтиСтроки(СтруктураПоиска);
		
		СтрокаТоваров = Неопределено;
		
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			
			НайденнаяСтрока.Обработана = Истина;
			
			Если СтрокаТоваров = Неопределено Тогда
				
				СтрокаТоваров = ТаблицаТоваров.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТоваров, НайденнаяСтрока);	
				
				НомерСтроки = НомерСтроки + 1;  
				СтрокаТоваров.НомерСтроки = НомерСтроки;	
				
			Иначе
				
				Для Каждого Поле Из СуммируемыеПоля Цикл
					
					СтрокаТоваров[Поле] = СтрокаТоваров[Поле] + НайденнаяСтрока[Поле]; 		
					
				КонецЦикла;
				
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(СтрокаТоваров.Номенклатура) Тогда 
				
				Если НайденныеСтроки.Количество() = 1 Тогда	  
					СтрокаТоваров.Номенклатура = НайденнаяСтрока.НоменклатураАналитика;
					СтрокаТоваров.ХарактеристикаНоменклатуры = НайденнаяСтрока.ХарактеристикаАналитика;
				ИначеЕсли СтрокаТоваров.СписокНоменклатуры.НайтиПоЗначению(НайденнаяСтрока.НоменклатураАналитика) = Неопределено Тогда
					СтрокаТоваров.СписокНоменклатуры.Добавить(НайденнаяСтрока.НоменклатураАналитика);
				КонецЕсли; 
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(НайденнаяСтрока.НоменклатураАналитика) Тогда
				
				ИсходнаяСтрока = ОсновныеПоляСтрокиТоваровСообщения(НайденнаяСтрока);
				
				ИсходнаяСтрока.Номенклатура   = НайденнаяСтрока.НоменклатураАналитика;
				ИсходнаяСтрока.Характеристика = НайденнаяСтрока.ХарактеристикаАналитика;	
				ИсходнаяСтрока.Серия 	      = НайденнаяСтрока.СерияАналитика;	
				ИсходнаяСтрока.Упаковка 	  = НайденнаяСтрока.УпаковкаАналитика;
				
				СтрокаТоваров.ИсходныеСтрокиТовара.Добавить(ИсходнаяСтрока);
				
			КонецЕсли;
			
		КонецЦикла;		
		
	КонецЦикла;
	
	Для Каждого СтрокаТовараБезСвертки Из ТаблицаСоСтрокамиБезСвертки Цикл
						
		СтрокаТоваров = ТаблицаТоваров.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТоваров, СтрокаТовараБезСвертки);
		
		НомерСтроки = НомерСтроки + 1;  
		СтрокаТоваров.НомерСтроки = НомерСтроки;
		
	КонецЦикла;

КонецПроцедуры

Функция ОсновныеПоляСтрокиТоваровСообщения(СтрокаТоваровСообщения)
	
	СтруктураОсновныхПолей = Новый Структура;
	
	СтруктураОсновныхПолей.Вставить("Номенклатура", СтрокаТоваровСообщения.Номенклатура);
	СтруктураОсновныхПолей.Вставить("Характеристика", СтрокаТоваровСообщения.ХарактеристикаНоменклатуры);
	СтруктураОсновныхПолей.Вставить("Серия", СтрокаТоваровСообщения.СерияНоменклатуры);
	СтруктураОсновныхПолей.Вставить("Упаковка", СтрокаТоваровСообщения.ЕдиницаИзмерения);
	СтруктураОсновныхПолей.Вставить("Количество", СтрокаТоваровСообщения.Количество);
	
	Если ЕстьКолонкаСтрокиТаблицы_КонтурEDI(СтрокаТоваровСообщения, "КоличествоДоКорректировки") Тогда
		СтруктураОсновныхПолей.Вставить("КоличествоДо", СтрокаТоваровСообщения.КоличествоДоКорректировки);
	КонецЕсли;
	
	Возврат СтруктураОсновныхПолей;
	
КонецФункции

Процедура ДобавитьОтсутствующийЭлементВСписок_КонтурEDI(Список, Значение)
	
		Если Список.НайтиПоЗначению(Значение) = Неопределено Тогда
			Список.Добавить(Значение);
		КонецЕсли;
	
КонецПроцедуры

//В зависимости от настроек: СвойСправочникТочекДоставки и ГрузополучательИзЮрФизЛицаТД
//извлекаем из документа 1С сущность Грузополучатель (в терминах 1С)
Функция ПолучитьГрузополучателя1СДокумента1С(ДокументСсылка, Партнер)
	
	// TODO разобрать и перенести это местов в ПолучитьРеквизитДокументаДляСообщения и порефачить
	
	СвойСправочникТД = ПолучитьКонстантуEDI("СвойСправочникТочекДоставки"); 
	ИспользуетсяСвойСправочникТД = ЗначениеЗаполнено(СвойСправочникТД);
	ГрузополучательИзЮрФизЛицаТД = ОпределитьЗначениеНастройкиГрузополучательИзЮрФизЛицаТД(Партнер);
	
	ЮрФизлицуТочкиДоставкиСоответствуетГрузополучатель = Не (ГрузополучательИзЮрФизЛицаТД = Ложь);
	ЮрФизлицуТочкиДоставкиСоответствуетКонтрагент = Не ЮрФизлицуТочкиДоставкиСоответствуетГрузополучатель;
	
	Если ИспользуетсяСвойСправочникТД Тогда
		// узнать имя реквизита документа
		
		РеквизитыШапки = ДокументСсылка.ПолучитьОбъект().Метаданные().Реквизиты;
		
		ГрузополучательЗначение = Неопределено; 
		
		Для Каждого Реквизит Из РеквизитыШапки Цикл
			
			ТипыРеквизита = Реквизит.Тип.Типы();  			
			
			Если Реквизит.Тип.СодержитТип(Тип("СправочникСсылка."+СвойСправочникТД))  Тогда
				
				// забрать значение, оно нужного нам типа
				ГрузополучательЗначение =  ДокументСсылка[Реквизит.Имя];
				
				Если ТипыРеквизита.Количество() = 1 Тогда
					
					Прервать;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Возврат ГрузополучательЗначение;
		
	ИначеЕсли  ЮрФизлицуТочкиДоставкиСоответствуетКонтрагент Тогда 
		
		Возврат ДокументСсылка.Контрагент;
		
	ИначеЕсли ПеременнаяСодержитСвойство(ДокументСсылка,"Грузополучатель",,Истина) Тогда  
		
		Возврат ДокументСсылка.Грузополучатель;
		
	ИначеЕсли ПеременнаяСодержитСвойство(ДокументСсылка,"Контрагент",,Истина) Тогда
		
		Возврат ДокументСсылка.Контрагент;
		
	КонецЕсли;
	
	Возврат Неопределено;//ничего не нашли
	
КонецФункции

//PORDERS
Функция ПодготовитьОбратныйЗаказ(ДокументСсылка, Сообщение)
	
	Если ИспользоватьМаппингМетаданных Тогда
		Маппинг_ПодготовитьОбратныйЗаказ(ДокументСсылка, Сообщение);
	    Возврат Неопределено;
	КонецЕсли;
	
	Сообщение.Документ1С 	= ДокументСсылка;
	
	Организация = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Организация");
	Сообщение.Отправитель1С = Организация;
	Сообщение.Продавец1С 	= Организация;
	
	Контрагент = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Контрагент");
	РезультатОпределения = ОпределитьПартнераИКонтрагентаДляИсходящегоСообщения(Контрагент, Сообщение);
	
	Сообщение.Партнер = РезультатОпределения.Партнер;
	Сообщение.Получатель1С = РезультатОпределения.Партнер;
	Сообщение.Покупатель1С = РезультатОпределения.Контрагент;
	
	Сообщение.Грузополучатель1С	= ПолучитьГрузополучателя1СДокумента1С(ДокументСсылка, Сообщение.Партнер);
	
	Сообщение.Комментарий 	= ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Комментарий");  		
	
	Сообщение.Договор		= ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Договор");
	Сообщение.Валюта1С		= ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Валюта");

	Сообщение.ДатаПоставки	= ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "ДатаОтгрузки");
	
	Товары = ПолучитьТоварыДокументаДляСообщения(ДокументСсылка, Истина, "ПодготовкаОбратногоЗаказа", , Сообщение);
	
	Для Каждого Стр Из Товары Цикл
		
		НоваяСтрока = Сообщение.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		НоваяСтрока.СтавкаНДС1С = Стр.СтавкаНДС;
		
		НоваяСтрока.ТекстПересчета = 
		ТекстПересчета_КонтурEDI(
		НоваяСтрока.ЕдиницаИзмерения, 
		НоваяСтрока.КодЕдиницыИзмеренияEDI, 
		НоваяСтрока.КоэффициентEDIВ1С);
		
	КонецЦикла;
	
	ЗаполнитьПредставлениеЕдиницыИзмеренияВТаблицеТоваров(Сообщение.Товары);
	
КонецФункции

Функция ОпределитьПартнераИКонтрагентаДляИсходящегоСообщения(Контрагент, Сообщение = Неопределено)
	
	РезультатОпределения = Новый Структура("Партнер,Контрагент");
	
	Партнер = ОпределитьПартнера(Новый Структура("ТипЗначения, ЮрФизЛицо, Сообщение", "ЮрФизЛицо", Контрагент, Сообщение));
	
	ОпределитьПартнераПоГоловномуКонтрагенту =
		НЕ ЗначениеЗаполнено(Партнер) 
		И ЗначениеЗаполнено(Контрагент)
		И ЕстьРеквизитОбъекта_Контур(Контрагент, "ГоловнойКонтрагент") 
		И ЗначениеЗаполнено(Контрагент.ГоловнойКонтрагент);
	
	Если ОпределитьПартнераПоГоловномуКонтрагенту Тогда
		
		Контрагент = Контрагент.ГоловнойКонтрагент;
		
		Партнер = ОпределитьПартнера(Новый Структура("ТипЗначения, ЮрФизЛицо, Сообщение", "ЮрФизЛицо", Контрагент, Сообщение));
		
	КонецЕсли; 
	
	РезультатОпределения.Партнер = Партнер;
	РезультатОпределения.Контрагент = Контрагент;
	
	Возврат РезультатОпределения;

КонецФункции

//ORDERS
Функция ПодготовитьЗаказ(ДокументСсылка, Сообщение, Параметры)
	
	Если ИспользоватьМаппингМетаданных Тогда
		Маппинг_ПодготовитьЗаказ(ДокументСсылка, Сообщение, Параметры);
		Возврат Неопределено;
	КонецЕсли;	
	
	Сообщение.Документ1С 	= ДокументСсылка;
	Сообщение.Заказ1С 		= ДокументСсылка;

	ОбратныйЗаказ1С = НайтиОбратныйЗаказ(ДокументСсылка);
	Если ЗначениеЗаполнено(ОбратныйЗаказ1С) Тогда
		Сообщение.ОбратныйЗаказ1С = ОбратныйЗаказ1С;
	КонецЕсли;
	
	Организация = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Организация");
	Сообщение.Отправитель1С 	= Организация;
	Сообщение.Покупатель1С 		= Организация;
	
	Сообщение.Продавец1С 		= ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Контрагент");
	Сообщение.Грузополучатель1С	= ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Склад");
	
	Сообщение.ДатаПоставки	= ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "ДатаОтгрузки");
	Сообщение.Комментарий 	= ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Комментарий");
	Сообщение.Договор 		= ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Договор");
	Сообщение.Валюта1С 		= ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Валюта");
	
	Товары = ПолучитьТоварыДокументаДляСообщения(ДокументСсылка, Истина, "ПодготовкаЗаказаПоставщику", , Сообщение);
	
	Для Каждого Стр Из Товары Цикл
		
		НоваяСтрока = Сообщение.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		НоваяСтрока.СтавкаНДС1С = Стр.СтавкаНДС;
		
		НоваяСтрока.ТекстПересчета = 
		ТекстПересчета_КонтурEDI(
		НоваяСтрока.ЕдиницаИзмерения, 
		НоваяСтрока.КодЕдиницыИзмеренияEDI, 
		НоваяСтрока.КоэффициентEDIВ1С);
		
	КонецЦикла;
	
	ЗаполнитьПредставлениеЕдиницыИзмеренияВТаблицеТоваров(Сообщение.Товары);
	
	Если ТипЗнч(Параметры) = Тип("Структура") Тогда
		Если Параметры.Свойство("Статус") И Параметры.Статус = "Отменить" Тогда
			Сообщение.Статус = "Отменен";
		ИначеЕсли Параметры.Свойство("Действие") И Параметры.Действие = "Переотправка" Тогда 
			Сообщение.Статус = "Уточнен";	
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

//ORDRSP
Функция ПодготовитьОтветНаЗаказ(ДокументСсылка,Сообщение,Параметры)
	  
	Если ИспользоватьМаппингМетаданных Тогда
		Сообщение = Маппинг_ПодготовитьОтветНаЗаказ(ДокументСсылка,Сообщение,Параметры);
		Возврат Сообщение;
	КонецЕсли;
	
	Если Параметры=Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;	
	
	Если Параметры.Свойство("ЭтоОтклонениеНезагруженногоЗаказа") 
		ИЛИ Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		
		// обнаружена проблема: надо бы еще помечать на удаление документ заказа. Или сообщение переводить в статус "Отклонен", чтобы не продолжать цепочку.   		
		// В этом случае мы просто берем входящий ORDERS, меняем тип сообщения на ORDRSP, меняем местами отправителей/получателей, обнуляем количества в строках и т.д.
		// В Параметры.ВходящийЗаказ должна быть именно Ссылка! (раньше была Структура - избыточно).
		
		Сообщение = ПолучитьВходящийЗаказ_КонтурEDI(Параметры, Сообщение);
		
		Если Параметры.Свойство("ПереотправляемоеСообщениеСсылка") Тогда 
			
			Сообщение.Вставить("ПереотправляемоеСообщениеСсылка", Параметры.ПереотправляемоеСообщениеСсылка);
			
		КонецЕсли;
		
		ИнвертироватьСтороныТранспортаСообщения(Сообщение);

		Сообщение.ТипСообщения		= "ORDRSP";
		Сообщение.Направление		= "Исходящее";
		Сообщение.ЗаказEDI			= КонтурСтандарт_СкопироватьСтруктуру(Сообщение.ДокументEDI, Неопределено);
		
		Если НЕ ЗначениеЗаполнено(Сообщение.ВалютаEDI) Тогда
			Сообщение.ВалютаEDI = "RUB";
		КонецЕсли;
		
		Сообщение.Статус = "Отклонен";
		Для каждого _Стр Из Сообщение.Товары Цикл
			_Стр.Статус = "Отклонен";
			Если Не Сообщение.Товары.Колонки.Найти("КоличествоЗаказанное") = Неопределено Тогда
				_Стр.КоличествоЗаказанное = _Стр.Количество;		
			КонецЕсли;
			_Стр.Количество = 0;
		КонецЦикла;
		
		Если Сообщение.Свойство("Архив") Тогда
			Сообщение.Архив = Ложь;
		КонецЕсли;
		
		Эталон = ПолучитьСтруктуруСообщения(Сообщение.ТипСообщения,Сообщение.Направление);
		ДополнитьСтруктуруСообщенияИзЭталона(Сообщение,Эталон);
		ИсправитьЗначенияПолейСтранаEDIНомерГТДEDI(Сообщение);
		Сообщение.Вставить("ИсходныйORDERS",Сообщение.СообщениеСсылка); // понадобится в процедуре СохранитьСообщение
		Сообщение.СообщениеСсылка = Неопределено; // это будет новое сообщение
		
		Возврат Сообщение;
		
	КонецЕсли;
	
	Сообщение.Документ1С 	= ДокументСсылка;
	Сообщение.Заказ1С		= НайтиСвязанныйДокументПоТипуСообщения(ДокументСсылка,"ORDERS");
	
	ВходящийЗаказ = ПолучитьВходящийЗаказ_КонтурEDI(Параметры, Сообщение); 
	
	Если ВходящийЗаказ <> Неопределено И ПеременнаяСодержитСвойство(ВходящийЗаказ, "ЭтоПредварительныйЗаказ") Тогда
		ЭтоПредварительныйЗаказ = ВходящийЗаказ.ЭтоПредварительныйЗаказ;
	Иначе
		ЭтоПредварительныйЗаказ = Ложь;
	КонецЕсли;
	
	Сообщение.Вставить("ЭтоПредварительныйЗаказ", ЭтоПредварительныйЗаказ);
	
	Организация = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Организация");
	Сообщение.Отправитель1С	= Организация;
	Сообщение.Продавец1С 	= Организация;
	
	Контрагент = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Контрагент");
	РезультатОпределения = ОпределитьПартнераИКонтрагентаДляИсходящегоСообщения(Контрагент, Сообщение);
	
	Сообщение.Партнер = РезультатОпределения.Партнер;
	Сообщение.Получатель1С = РезультатОпределения.Партнер;
	Сообщение.Покупатель1С = РезультатОпределения.Контрагент;   
	
	Сообщение.Грузоотправитель1С = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Грузоотправитель");
	Сообщение.Грузополучатель1С = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Грузополучатель");
	
	Сообщение.Договор 	= ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Договор");
	Сообщение.Валюта1С 	= ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Валюта");
	
	Если ВходящийЗаказ.Свойство("КонечныйГрузополучатель1С") И Сообщение.Свойство("КонечныйГрузополучатель1С") Тогда
		Сообщение.КонечныйГрузополучатель1С  = ВходящийЗаказ.КонечныйГрузополучатель1С;		
	КонецЕсли;
	
	Если ВходящийЗаказ.Свойство("Контракт") И Сообщение.Свойство("Контракт") Тогда
		Сообщение.Контракт  = ВходящийЗаказ.Контракт;		
	КонецЕсли;
	
	Если ВходящийЗаказ.Свойство("ПромежуточныйГрузополучатель1С") И Сообщение.Свойство("ПромежуточныйГрузополучатель1С") Тогда
		Сообщение.ПромежуточныйГрузополучатель1С  = ВходящийЗаказ.ПромежуточныйГрузополучатель1С;		
	КонецЕсли; 
	
	ОтдельныйORDRSPНаКаждыйДокументЗаказа = (ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, "ОтдельныйORDRSPНаКаждыйДокументЗаказа") = Истина);
	
	МассивСвязанныхДокументов = Новый Массив;
	
	Если НЕ ОтдельныйORDRSPНаКаждыйДокументЗаказа Тогда 
		
		ТабСвязанныхДокументов = ПолучитьТаблицуСвязанныхДокументовПоТипамСообщений(Сообщение.Заказ1С);
		Если ЗначениеЗаполнено(ТабСвязанныхДокументов) Тогда 		
			Для Каждого Стр Из ТабСвязанныхДокументов Цикл
				МассивСвязанныхДокументов.Добавить(Стр.Документ_ORDRSP);
			КонецЦикла;  		
		Иначе  		
			МассивСвязанныхДокументов.Добавить(Сообщение.Заказ1С); 		
		КонецЕсли;
		
	Иначе 
		МассивСвязанныхДокументов.Добавить(Сообщение.Заказ1С);
	КонецЕсли;
	
	ДатаПоставки = Дата(1, 1, 1);
	ДатаПоставкиИзмененная = Дата(1, 1, 1);
	
	Если ПроверитьСвойствоПоляВСтруктуре(Параметры, "ИзмененныеРеквизиты.ДатаПоставки", ДатаПоставкиИзмененная)
		И ЗначениеЗаполнено(ДатаПоставкиИзмененная) Тогда
		
		ДатаПоставки = ДатаПоставкиИзмененная;		
		
	Иначе
		
		ДатаПоставки = ОпределитьДатуПоставки(Сообщение, ВходящийЗаказ);
		
	КонецЕсли;
	
	Сообщение.ДатаПоставки = ДатаПоставки;
	
	ЗаполнитьЗначенияСвойствСтруктуры(Сообщение, ВходящийЗаказ, "КонтактноеЛицоФИО,КонтактноеЛицоТелефон,КонтактноеЛицоЭлПочта");
	Сообщение.ОтветственныйЗаДоставку = ВходящийЗаказ.ОтветственныйЗаДоставку;
	Сообщение.Фасовка = ВходящийЗаказ.Фасовка;
	
	Если ВходящийЗаказ.Свойство("ДатаВывозаОтПоставщика") И ЗначениеЗаполнено(ВходящийЗаказ.ДатаВывозаОтПоставщика) Тогда
		Сообщение.ДатаВывозаОтПоставщика = ВходящийЗаказ.ДатаВывозаОтПоставщика;
	КонецЕсли;	
	
	Партнер = ОпределитьПартнера(Новый Структура("ТипЗначения, ЮрФизЛицо, Сообщение", "ЮрФизЛицо", Сообщение.Покупатель1С, Сообщение));
	Если ЗначениеЗаполнено(Партнер) Тогда
		Сообщение.Получатель1С 	= Партнер;
		Сообщение.Партнер 		= Партнер;
	КонецЕсли;	
	
	ЕстьОтклонения 		= Ложь;
	ЕстьИзменения 		= Ложь;
	ЕстьПодтверждения 	= Ложь;
	
	// ... товары сообщения  		
	ПодготовитьТовары_ОтветНаЗаказ(МассивСвязанныхДокументов, ВходящийЗаказ, Сообщение, ЕстьОтклонения, ЕстьПодтверждения, ЕстьИзменения); 
	
	// ... 
	_СтатусChangedДляИзмененнойДатыПоставкиORDRSP = ПолучитьЗначениеСвойстваОбъектаEDI(Партнер, "СтатусChangedДляИзмененнойДатыПоставкиORDRSP");
	Если _СтатусChangedДляИзмененнойДатыПоставкиORDRSP = Истина Тогда
		Если ЗначениеЗаполнено(ВходящийЗаказ.ДатаПоставки) и ВходящийЗаказ.ДатаПоставки <> Сообщение.ДатаПоставки Тогда
	    	ЕстьИзменения = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если ЕстьИзменения ИЛИ (ЕстьПодтверждения И ЕстьОтклонения) Тогда
		Статус = "Уточнен";
	ИначеЕсли ЕстьПодтверждения Тогда
		Статус = "Подтвержден";
	Иначе
		Статус = "Отклонен";
	КонецЕсли;
	
	Сообщение.Статус = Статус;  
	
	Сообщение.Транспортировка.ДатаВремяПрибытия = ВходящийЗаказ.Транспортировка.ДатаВремяПрибытия;
	Сообщение.Транспортировка.ВремяНачалаПогрузки = ВходящийЗаказ.Транспортировка.ВремяНачалаПогрузки;
	Сообщение.Транспортировка.ВремяОкончанияПогрузки = ВходящийЗаказ.Транспортировка.ВремяОкончанияПогрузки;
	
	Сообщение.ТранспортныеУпаковки = ВходящийЗаказ.ТранспортныеУпаковки;
	
КонецФункции

Процедура ПодготовитьТовары_ОтветНаЗаказ(МассивСвязанныхДокументов, ВходящийЗаказ, Сообщение, ЕстьОтклонения, ЕстьПодтверждения, ЕстьИзменения)
	
	ТоварыЗаказа = ПолучитьТоварыДокументаДляСообщения(МассивСвязанныхДокументов,Истина,"ПодготовкаОтветаНаЗаказ",,Сообщение);
	
	ВходящийЗаказ = ПрочитатьСообщение(ВходящийЗаказ.СообщениеСсылка);
	
	ТоварыВходящегоЗаказа = ВходящийЗаказ.Товары;	
	
	СписокСвойствИзСтрокиВходящего = Новый Массив;
	СписокСвойствИзСтрокиВходящего.Добавить("КодТовараВнутренний");
	СписокСвойствИзСтрокиВходящего.Добавить("ФасовкаТовара");
	СписокСвойствИзСтрокиВходящего.Добавить("МаксимальныйВесПалеты");
	СписокСвойствИзСтрокиВходящего.Добавить("КодЕдиницыИзмеренияМаксимальногоВесаПалеты");
	СписокСвойствИзСтрокиВходящего.Добавить("МаксимальнаяВысотаПалеты");
	СписокСвойствИзСтрокиВходящего.Добавить("КодЕдиницыИзмеренияМаксимальнойВысотыПалеты");
	СписокСвойствИзСтрокиВходящего.Добавить("КоличествоВБлоке");
	СписокСвойствИзСтрокиВходящего.Добавить("КодЕдиницыИзмеренияКоличестваВБлоке");
	СписокСвойствИзСтрокиВходящего.Добавить("КонечныйГрузополучательGLN");
	
	сч = 0;
	
	МассивСопоставленныхСтрок = Новый Массив;
	
	ДопустимоеРасхождениеЦен = 0.01;
	
	НеОтправлятьКодПоставщика = (ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, "НеОтправлятьКодПоставщика") = Истина);
	
	ПоляИсключенияДляЗаполенияИзСтрокиВходящегоЗаказа = "СуммаБезНДС,СуммаСНДС,СуммаНДС,Количество";
	Если НеОтправлятьКодПоставщика Тогда
		
		ПоляИсключенияДляЗаполенияИзСтрокиВходящегоЗаказа = ПоляИсключенияДляЗаполенияИзСтрокиВходящегоЗаказа + ", КодТовараПоставщика";
		
	КонецЕсли;
	
	ПорогКоличестваСтрокБезИндексирования = 100;
	
	Если ТоварыЗаказа.Количество() > ПорогКоличестваСтрокБезИндексирования Тогда
		ТоварыЗаказа.Индексы.Добавить("УИД_СтрокиПредыдущегоСообщения");
	КонецЕсли;
	
	Для Каждого СтрокаВходящегоЗаказа Из ТоварыВходящегоЗаказа Цикл
		
		сч = сч + 1;
		
		НоваяСтрока = Сообщение.Товары.Добавить();
		
		НоваяСтрока.НомерСтроки = сч;
		
		СтрокиЗаказаПоСтрокеВходящего = ТоварыЗаказа.НайтиСтроки(Новый Структура("УИД_СтрокиПредыдущегоСообщения", СтрокаВходящегоЗаказа.УИД_СтрокиТовара));
		
		Если СтрокиЗаказаПоСтрокеВходящего.Количество() = 0 Тогда
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаВходящегоЗаказа, , ПоляИсключенияДляЗаполенияИзСтрокиВходящегоЗаказа);
			
			НоваяСтрока.УИД_СтрокиПредыдущегоСообщения = СтрокаВходящегоЗаказа.УИД_СтрокиТовара;
			
			НоваяСтрока.Статус	= "Отклонен";
			ЕстьОтклонения		= Истина;
			
		ИначеЕсли СтрокиЗаказаПоСтрокеВходящего.Количество() = 1 Тогда
			
			МассивСопоставленныхСтрок.Добавить(СтрокиЗаказаПоСтрокеВходящего[0]);
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокиЗаказаПоСтрокеВходящего[0]);
			
			НоваяСтрока.СтавкаНДС1С = СтрокиЗаказаПоСтрокеВходящего[0].СтавкаНДС;
			
		Иначе
			
			Количество = 0;
			СуммаБезНДС = 0;
			СуммаСНДС = 0;
			СуммаНДС = 0;
					
			СписокНоменклатуры = Новый СписокЗначений;
			СписокХарактеристикНоменклатуры = Новый СписокЗначений;
			СписокСерийНоменклатуры = Новый СписокЗначений;
			
			МинимальныйКоэффициентEDIВ1С = Неопределено;
			СоответствиеКоэффициентEDIВ1С = Новый Соответствие;
			
			Для Каждого СтрокаЗаказа Из СтрокиЗаказаПоСтрокеВходящего Цикл
												
				МассивСопоставленныхСтрок.Добавить(СтрокаЗаказа);
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗаказа, , "ЦенаБезНДС,ЦенаСНДС,СуммаБезНДС,СуммаСНДС,СуммаНДС,Количество");
				
				НоваяСтрока.СтавкаНДС1С = СтрокаЗаказа.СтавкаНДС;
				
				Количество	= Количество + СтрокаЗаказа.Количество;
				СуммаБезНДС = СуммаБезНДС + СтрокаЗаказа.СуммаБезНДС;
				СуммаСНДС	= СуммаСНДС + СтрокаЗаказа.СуммаСНДС;
				СуммаНДС	= СуммаНДС + СтрокаЗаказа.СуммаНДС;
				
				ДобавитьОтсутствующийЭлементВСписок_КонтурEDI(СписокНоменклатуры, СтрокаЗаказа.Номенклатура);
				ДобавитьОтсутствующийЭлементВСписок_КонтурEDI(СписокХарактеристикНоменклатуры, СтрокаЗаказа.ХарактеристикаНоменклатуры);
				
				Если ЕстьКолонкаСтрокиТаблицы_КонтурEDI(СтрокаЗаказа, "СерияНоменклатуры") Тогда
					ДобавитьОтсутствующийЭлементВСписок_КонтурEDI(СписокСерийНоменклатуры, СтрокаЗаказа.СерияНоменклатуры);
				КонецЕсли;
				
				Если МинимальныйКоэффициентEDIВ1С = Неопределено ИЛИ МинимальныйКоэффициентEDIВ1С > СтрокаЗаказа.КоэффициентEDIВ1С Тогда
					
					МинимальныйКоэффициентEDIВ1С = СтрокаЗаказа.КоэффициентEDIВ1С;
					
				КонецЕсли;
				
				СоответствиеКоэффициентEDIВ1С.Вставить(СтрокаЗаказа.КоэффициентEDIВ1С, СтрокаЗаказа.ЕдиницаИзмерения);
				
			КонецЦикла;
			
			НоваяСтрока.Количество = Количество;
			НоваяСтрока.СуммаБезНДС = СуммаБезНДС;
			НоваяСтрока.СуммаСНДС = СуммаСНДС;
			НоваяСтрока.СуммаНДС = СуммаНДС;
			
			Если Количество <> 0 Тогда
				НоваяСтрока.ЦенаБезНДС = СуммаБезНДС/Количество;
				НоваяСтрока.ЦенаСНДС = СуммаСНДС/Количество;
			Иначе
				НоваяСтрока.ЦенаБезНДС = 0;
				НоваяСтрока.ЦенаСНДС = 0;
			КонецЕсли;
			
			Если СписокНоменклатуры.Количество() > 1 Тогда
				
				НоваяСтрока.Номенклатура = Неопределено;
				НоваяСтрока.СписокНоменклатуры = СписокНоменклатуры;
				
				НоваяСтрока.КоэффициентEDIВ1С = 1;
				НоваяСтрока.ЕдиницаИзмерения = Неопределено;
				
			Иначе
				
				НоваяСтрока.КоэффициентEDIВ1С = МинимальныйКоэффициентEDIВ1С;
				НоваяСтрока.ЕдиницаИзмерения = СоответствиеКоэффициентEDIВ1С[МинимальныйКоэффициентEDIВ1С];
				
			КонецЕсли;
			
			Если СписокХарактеристикНоменклатуры.Количество() > 1 Тогда
				НоваяСтрока.ХарактеристикаНоменклатуры = Неопределено;
				НоваяСтрока.СписокХарактеристикНоменклатуры = СписокХарактеристикНоменклатуры;
			КонецЕсли;
			
			Если СписокСерийНоменклатуры.Количество() > 1 Тогда
				НоваяСтрока.СерияНоменклатуры = Неопределено;
				НоваяСтрока.СписокСерийНоменклатуры = СписокСерийНоменклатуры;
			КонецЕсли;
			 			 			
		КонецЕсли;
		
		НоваяСтрока.КоличествоЗаказанное = СтрокаВходящегоЗаказа.Количество;
		
		Для Каждого СвойствоСтрокиВходящего Из СписокСвойствИзСтрокиВходящего Цикл
			
			Если ЕстьКолонкаСтрокиТаблицы_КонтурEDI(СтрокаВходящегоЗаказа, СвойствоСтрокиВходящего)
				И ЕстьКолонкаСтрокиТаблицы_КонтурEDI(НоваяСтрока, СвойствоСтрокиВходящего) Тогда
				
				НоваяСтрока[СвойствоСтрокиВходящего] = СтрокаВходящегоЗаказа[СвойствоСтрокиВходящего];
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если СтрокиЗаказаПоСтрокеВходящего.Количество() > 0 Тогда
			
			// ... количество
			КоличествоПодтверждено = (НоваяСтрока.Количество = Число(СтрокаВходящегоЗаказа.Количество));
			
			// ... цены
			ЦенаБезНДСПодтверждена = 
			СтрокаВходящегоЗаказа.ЦенаБезНДС = 0
			ИЛИ (СтрокаВходящегоЗаказа.ЦенаБезНДС = НоваяСтрока.ЦенаБезНДС) 
			ИЛИ 
			(-1*ДопустимоеРасхождениеЦен <= Окр(СтрокаВходящегоЗаказа.ЦенаБезНДС - НоваяСтрока.ЦенаБезНДС, 2, 0) 
			И Окр(СтрокаВходящегоЗаказа.ЦенаБезНДС - НоваяСтрока.ЦенаБезНДС, 2, 0) <= ДопустимоеРасхождениеЦен);
			
			ЦенаСНДСПодтверждена = 
			СтрокаВходящегоЗаказа.ЦенаСНДС = 0
			ИЛИ (СтрокаВходящегоЗаказа.ЦенаСНДС = НоваяСтрока.ЦенаСНДС) 
			ИЛИ 
			(-1*ДопустимоеРасхождениеЦен <= Окр(СтрокаВходящегоЗаказа.ЦенаСНДС - НоваяСтрока.ЦенаСНДС, 2, 0) 
			И Окр(СтрокаВходящегоЗаказа.ЦенаСНДС - НоваяСтрока.ЦенаСНДС, 2, 0) <= ДопустимоеРасхождениеЦен);
			
			// ... ставка
			КодСтавкиНДС = КонвертироватьЗначение1СвEDI(НоваяСтрока.СтавкаНДС1С, "СтавкаНДС", "СтавкаНДС", Сообщение);
			
			СтавкаНДСПодверджена = 
			НЕ ЗначениеЗаполнено(СтрокаВходящегоЗаказа.СтавкаНДСEDI) 
			ИЛИ КодСтавкиНДС = СтрокаВходящегоЗаказа.СтавкаНДСEDI;
			
			СтрокаПодтверждена = 
			КоличествоПодтверждено 
			И ЦенаБезНДСПодтверждена
			И ЦенаСНДСПодтверждена
			И СтавкаНДСПодверджена;
			
			Если СтрокаПодтверждена Тогда 
				
				НоваяСтрока.Статус 		= "Подтвержден";
				ЕстьПодтверждения		= Истина;  
				
			ИначеЕсли НоваяСтрока.Количество = 0 Тогда 
				
				НоваяСтрока.Статус	= "Отклонен";
				ЕстьОтклонения		= Истина;
				
			Иначе	
				
				НоваяСтрока.Статус		= "Уточнен";
				ЕстьИзменения			= Истина; 				
				
			КонецЕсли;
			
		КонецЕсли;
				
		НоваяСтрока.УИД_СтрокиТовара = УИД_СтрокиТовара_КонтурEDI(сч, Сообщение.ТипСообщения);
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.УИД_СтрокиПервоначальногоСообщения) Тогда			
			НоваяСтрока.УИД_СтрокиПервоначальногоСообщения = НоваяСтрока.УИД_СтрокиТовара;			
		КонецЕсли; 
		
		НоваяСтрока.ТекстПересчета = 
		ТекстПересчета_КонтурEDI(
		НоваяСтрока.ЕдиницаИзмерения, 
		НоваяСтрока.КодЕдиницыИзмеренияEDI, 
		НоваяСтрока.КоэффициентEDIВ1С);
		
	КонецЦикла;
	
	Для Каждого СтрокаЗаказа Из ТоварыЗаказа Цикл
		
		Если МассивСопоставленныхСтрок.Найти(СтрокаЗаказа) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		сч = сч + 1;		
		
		НоваяСтрока = Сообщение.Товары.Добавить();
		
		НоваяСтрока.НомерСтроки = сч;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗаказа);
		
		Если ЕстьКолонкаСтрокиТаблицы_КонтурEDI(СтрокаЗаказа, "СтавкаНДС") Тогда
			НоваяСтрока.СтавкаНДС1С = СтрокаЗаказа.СтавкаНДС;
		КонецЕсли;
		
		НоваяСтрока.Статус			= "Уточнен";
		ЕстьИзменения 				= Истина;
		
		НоваяСтрока.УИД_СтрокиТовара = УИД_СтрокиТовара_КонтурEDI(сч, Сообщение.ТипСообщения);
	
		Если Не ЗначениеЗаполнено(НоваяСтрока.УИД_СтрокиПервоначальногоСообщения) Тогда			
			НоваяСтрока.УИД_СтрокиПервоначальногоСообщения = НоваяСтрока.УИД_СтрокиТовара;			
		КонецЕсли;
		
		НоваяСтрока.ТекстПересчета = 
		ТекстПересчета_КонтурEDI(
		НоваяСтрока.ЕдиницаИзмерения, 
		НоваяСтрока.КодЕдиницыИзмеренияEDI, 
		НоваяСтрока.КоэффициентEDIВ1С);
		
	КонецЦикла;
	
	Сообщение.Товары.Сортировать("УИД_СтрокиПервоначальногоСообщения,УИД_СтрокиПредыдущегоСообщения");
	
	ЗаполнитьПредставлениеЕдиницыИзмеренияВТаблицеТоваров(Сообщение.Товары);

КонецПроцедуры

Функция УИД_СтрокиТовара_КонтурEDI(Знач НомерСтроки, Знач ТипСообщения)
	
	УИД_СтрокиТовара = ТипСообщения + "_" + Формат(НомерСтроки, "ЧЦ=6; ЧВН=; ЧГ=") + "_" + Новый УникальныйИдентификатор;
	
	Возврат УИД_СтрокиТовара;

КонецФункции

Функция ПолучитьВходящийЗаказ_КонтурEDI(Параметры, Сообщение)
	
	Если Параметры.Свойство("ВходящийЗаказ") И ЗначениеЗаполнено(Параметры.ВходящийЗаказ) Тогда
		// указали ORDERS в явном виде	
		ВходящийЗаказ = ПрочитатьСообщение(Параметры.ВходящийЗаказ);
		
	ИначеЕсли ЗначениеЗаполнено(Сообщение.Заказ1С) Тогда
		// не указали, сами прочитаем
		
		Если Не Параметры.Свойство("Действие") Тогда
			Параметры.Вставить("Действие","ПодготовитьОтветНаЗаказ");
		КонецЕсли;	
		
		ВходящийЗаказ = ПрочитатьСообщение(, Сообщение.Заказ1С, "ORDERS", "Входящее", , Параметры);
		
	ИначеЕсли Сообщение.Свойство("ПереотправляемоеСообщениеСсылка") Тогда 
		
		ПереотправляемоеСообщение = ПрочитатьСообщение(Сообщение.ПереотправляемоеСообщениеСсылка);
		
		ВходящийЗаказ = ПрочитатьСообщение(ПереотправляемоеСообщение.ИсходныйORDERS);
		
	Иначе
		
		ВходящийЗаказ = Неопределено;
		
	КонецЕсли;
	
	Возврат ВходящийЗаказ;

КонецФункции

Процедура ИсправитьЗначенияПолейСтранаEDIНомерГТДEDI(Сообщение)
	
	Для каждого Строка Из Сообщение.Товары Цикл
		
		Если Строка.СтранаEDI = "ТаблицаЗначений" Тогда
			Строка.СтранаEDI = "";
		КонецЕсли;
		
		Если Строка.НомерГТДEDI = "ТаблицаЗначений" Тогда
			Строка.НомерГТДEDI = "";
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

//DESADV
Функция ПодготовитьУведомлениеОбОтгрузке(ДокументСсылка,Сообщение,Параметры)
	
	Если ИспользоватьМаппингМетаданных Тогда
		Маппинг_ПодготовитьУведомлениеОбОтгрузке(ДокументСсылка,Сообщение,Параметры);
		Возврат Неопределено;
	КонецЕсли;
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;	
	
	Сообщение.Документ1С 	= ДокументСсылка;
	Сообщение.Накладная1С 	= ДокументСсылка;
	Сообщение.Заказ1С		= НайтиСвязанныйДокументПоТипуСообщения(ДокументСсылка, "ORDERS");
	
	Организация = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Организация");
	Сообщение.Отправитель1С = Организация;
	Сообщение.Продавец1С 	= Организация;
	
	Контрагент = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Контрагент");
	РезультатОпределения = ОпределитьПартнераИКонтрагентаДляИсходящегоСообщения(Контрагент, Сообщение);
	
	Сообщение.Партнер = РезультатОпределения.Партнер;
	Сообщение.Получатель1С = РезультатОпределения.Партнер;
	Сообщение.Покупатель1С = РезультатОпределения.Контрагент; 
	
	Сообщение.Грузоотправитель1С = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Грузоотправитель");
	Сообщение.Грузополучатель1С = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Грузополучатель");
	
	Сообщение.Договор	= ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Договор");
	Сообщение.Валюта1С 	= ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Валюта");
	
	// заполним Сф
	СФ = ПолучитьСчетФактуруНакладной(ДокументСсылка);
	Если НЕ СФ =  Неопределено Тогда
		Сообщение.СчетФактура1С = СФ;	
	КонецЕсли;
	
	Сообщение.ДатаОтгрузки	= ДокументСсылка.Дата;
	Сообщение.ДатаПоставки	= ОпределитьДатуПоставки(Сообщение); //опирается на знание партнера сообщения
	
	ВходящийЗаказ = ПрочитатьСообщение(,Сообщение.Заказ1С,"ORDERS","Входящее");
	Если ЗначениеЗаполнено(ВходящийЗаказ) и ТипЗнч(ВходящийЗаказ) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойствСтруктуры(Сообщение, ВходящийЗаказ, "КонтактноеЛицоФИО,КонтактноеЛицоТелефон,КонтактноеЛицоЭлПочта");
	КонецЕсли;
	
	//при сохранении сообщения с SSCC может быть Changed в первом сообщении
	_СтатусChangedДляПовторныхDESADV = ПолучитьЗначениеСвойстваОбъектаEDI(Сообщение.Партнер, "СтатусChangedДляПовторныхDESADV");
	
	Если _СтатусChangedДляПовторныхDESADV = Истина Тогда
		ИсходноеСообщениеDESADV = НайтиСообщениеДокумента(ДокументСсылка,"DESADV");
		Если ИсходноеСообщениеDESADV <> Неопределено 
			И ИсходноеСообщениеDESADV.Статус <> "Сохранен" Тогда
			Сообщение.Статус = "Уточнен";
		КонецЕсли;
	КонецЕсли;
	
	ИсточникПодготовкиТоваров = "ПодготовитьУведомлениеОбОтгрузке";
	КонтекстСообщенияДляПодготовкиТоваров = Сообщение;
	
	Если ЗначениеЗаполнено(Параметры) Тогда
		
		Если ПеременнаяСодержитСвойство(Параметры, "ИсточникПодготовкиТоваров",,Истина) Тогда
			ИсточникПодготовкиТоваров = Параметры.ИсточникПодготовкиТоваров;
		КонецЕсли;
		
		Если ПеременнаяСодержитСвойство(Параметры, "КонтекстСообщенияДляПодготовкиТоваров",,Истина) Тогда 
			КонтекстСообщенияДляПодготовкиТоваров = Параметры.КонтекстСообщенияДляПодготовкиТоваров;
		КонецЕсли;
		
	КонецЕсли;
	
	Товары = ПолучитьТоварыДокументаДляСообщения(ДокументСсылка,
												 Истина,
												 ИсточникПодготовкиТоваров,,
												 КонтекстСообщенияДляПодготовкиТоваров);
	
	Для Каждого Стр Из Товары Цикл
		
		НоваяСтрока = Сообщение.Товары.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Стр);
		
		НоваяСтрока.СтавкаНДС1С = Стр.СтавкаНДС;
		НоваяСтрока.НомерГТД1С = Стр.НомерГТД;
		НоваяСтрока.Страна1С = Стр.Страна;
		
		НоваяСтрока.ТекстПересчета = 
		ТекстПересчета_КонтурEDI(
		НоваяСтрока.ЕдиницаИзмерения, 
		НоваяСтрока.КодЕдиницыИзмеренияEDI, 
		НоваяСтрока.КоэффициентEDIВ1С);
		
	КонецЦикла;
		
	ЗаполнитьПредставлениеЕдиницыИзмеренияВТаблицеТоваров(Сообщение.Товары);
	
	ДополнитьСообщениеСохраненнымиДанными(Сообщение, Параметры);
	
	ПараметрСтатус = Неопределено;
	Если ПеременнаяСодержитСвойство(Параметры, "Статус", ПараметрСтатус, Истина) Тогда
		
		Если Врег(ПараметрСтатус) = Врег("ОТМЕНИТЬ") 
			ИЛИ Врег(ПараметрСтатус) = Врег("ОТМЕНЕН") Тогда
			
			Сообщение.Статус = "Отменен";
			
			Сообщение.Товары.ЗаполнитьЗначения(0, "Количество");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

//ALCRPT
Функция ПодготовитьОтчетОПродажеАлкоголя(ДокументСсылка, Сообщение)
	
	Если ИспользоватьМаппингМетаданных Тогда
		Маппинг_ПодготовитьОтчетОПродажеАлкоголя(ДокументСсылка, Сообщение);
		Возврат Неопределено;
	КонецЕсли;	
	
	Сообщение.Документ1С 	= ДокументСсылка;
	Сообщение.Накладная1С	= ДокументСсылка;
	Сообщение.Заказ1С		= НайтиСвязанныйДокументПоТипуСообщения(ДокументСсылка, "ORDERS");
	
	Организация = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Организация");
	Сообщение.Отправитель1С = Организация;
	Сообщение.Продавец1С 	= Организация;
	
	Контрагент = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Контрагент");
	РезультатОпределения = ОпределитьПартнераИКонтрагентаДляИсходящегоСообщения(Контрагент, Сообщение);
	
	Сообщение.Партнер = РезультатОпределения.Партнер;
	Сообщение.Получатель1С = РезультатОпределения.Партнер;
	Сообщение.Покупатель1С = РезультатОпределения.Контрагент; 
	
	Сообщение.Грузоотправитель1С = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Грузоотправитель");
	Сообщение.Грузополучатель1С = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Грузополучатель");

	Сообщение.Договор		= ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Договор");
	Сообщение.Валюта1С		= ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Валюта");
	
	Товары = ПолучитьТоварыРеализацииАлкогольнойПродукции(ДокументСсылка, Сообщение);
	//Товары = ПолучитьТоварыДокументаДляСообщения(ДокументСсылка,,"ПолучитьТоварыРеализацииАлкогольнойПродукции",,Сообщение);	//TODO набросать запросы в СКД и тогда включить
	
	Для Каждого Стр Из Товары Цикл
		
		НоваяСтрока = Сообщение.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Стр);
		НоваяСтрока.СтавкаНДС1С = Стр.СтавкаНДС;
		
	КонецЦикла;
	
	БылОтправленALCRPT = ПолучитьЗначениеСвойстваОбъектаEDI(ДокументСсылка, "БылОтправленALCRPT");
	Сообщение.Вставить("БылОтправленALCRPT", (БылОтправленALCRPT = Истина));
	
КонецФункции

//RECADV
Функция ПодготовитьУведомлениеОПриемке(ДокументСсылка, Сообщение)
	
	Если ИспользоватьМаппингМетаданных Тогда
		Маппинг_ПодготовитьУведомлениеОПриемке(ДокументСсылка, Сообщение);
		Возврат Неопределено;
	КонецЕсли;	
	
	Сообщение.Документ1С 	= ДокументСсылка;
	Сообщение.Накладная1С 	= ДокументСсылка;
	Сообщение.Приемка1С 	= ДокументСсылка;
	Сообщение.Заказ1С 		= НайтиСвязанныйДокументПоТипуСообщения(ДокументСсылка, "ORDERS");
	
	Организация = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Организация");
	Сообщение.Отправитель1С = Организация;
	Сообщение.Покупатель1С = Организация;
	
	Сообщение.Продавец1С = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Контрагент");
	Сообщение.Грузополучатель1С	= ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Склад");	
	
	Сообщение.Валюта1С 			= ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Валюта");
	Сообщение.Договор 			= ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Договор");
	
	Товары = ПолучитьТоварыДокументаДляСообщения(ДокументСсылка, Истина, "ПодготовкаУведомленияОПриемке", , Сообщение);
	ЕстьСтавкаНДС = (Товары.Колонки.Найти("СтавкаНДС") <> Неопределено);
	
	Для Каждого Стр Из Товары Цикл
		
		НоваяСтрока = Сообщение.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Стр);
		
		Если ЕстьСтавкаНДС Тогда
			НоваяСтрока.СтавкаНДС1С = Стр.СтавкаНДС;
		КонецЕсли;
		
		НоваяСтрока.ТекстПересчета = 
		ТекстПересчета_КонтурEDI(
		НоваяСтрока.ЕдиницаИзмерения, 
		НоваяСтрока.КодЕдиницыИзмеренияEDI, 
		НоваяСтрока.КоэффициентEDIВ1С);
		
	КонецЦикла;
	
	ЗаполнитьПредставлениеЕдиницыИзмеренияВТаблицеТоваров(Сообщение.Товары);
	
КонецФункции

//RETANN
Процедура ПодготовитьУведомлениеОВозврате(ДокументСсылка, Сообщение)

	ПрисвоитьЕслиЗаполнено(Сообщение.Документ1С, ДокументСсылка);
	
	Валюта = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Валюта", Сообщение);
	ПрисвоитьЕслиЗаполнено(Сообщение.Валюта1С, Валюта);
	
	Договор  = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Договор", Сообщение); 
	ПрисвоитьЕслиЗаполнено(Сообщение.Договор, Договор);
	
	Организация = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Организация", Сообщение);  
	ПрисвоитьЕслиЗаполнено(Сообщение.Отправитель1С, Организация);
	ПрисвоитьЕслиЗаполнено(Сообщение.Покупатель1С, Организация);	
	
	Контрагент  = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Контрагент", Сообщение);
	ПрисвоитьЕслиЗаполнено(Сообщение.Продавец1С, Контрагент);
	ПрисвоитьЕслиЗаполнено(Сообщение.Грузополучатель1С, Контрагент);
	
	Склад = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Склад", Сообщение); 
	ПрисвоитьЕслиЗаполнено(Сообщение.Грузоотправитель1С, Склад);
	
	ДокументЗаказ     = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "ДокументЗаказ", Сообщение);
	ПрисвоитьЕслиЗаполнено(Сообщение.Заказ1С, ДокументЗаказ);
	
	ДокументНакладная = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "ДокументНакладная", Сообщение);
	ПрисвоитьЕслиЗаполнено(Сообщение.Накладная1С, ДокументНакладная);
	
	ТоварыДокумента = ПолучитьТоварыДокументаДляСообщения(ДокументСсылка, Истина, "ПодготовитьУведомлениеОВозврате", Сообщение);
	ЕстьКолонкаСтавкаНДС = ТоварыДокумента.Колонки.Найти("СтавкаНДС") <> Неопределено; 
	
	Для Каждого СтрокаТоваровДокумента Из ТоварыДокумента Цикл
		
		СтрокаТоваровСообщения = Сообщение.Товары.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаТоваровСообщения, СтрокаТоваровДокумента);
		
		Если ЕстьКолонкаСтавкаНДС Тогда
			СтрокаТоваровСообщения.СтавкаНДС1С = СтрокаТоваровДокумента.СтавкаНДС;
		КонецЕсли;
		
		СтрокаТоваровСообщения.ТекстПересчета = ТекстПересчета_КонтурEDI(
			СтрокаТоваровСообщения.ЕдиницаИзмерения, 
			СтрокаТоваровСообщения.КодЕдиницыИзмеренияEDI, 
			СтрокаТоваровСообщения.КоэффициентEDIВ1С);
		
	КонецЦикла;
	
	ЗаполнитьПредставлениеЕдиницыИзмеренияВТаблицеТоваров(Сообщение.Товары);

КонецПроцедуры	

//RETDES
Процедура ПодготовитьУведомлениеОбОтгрузкеВозврата(ДокументСсылка, Сообщение)
	
	ПрисвоитьЕслиЗаполнено(Сообщение.Документ1С, ДокументСсылка);
	
	Валюта = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Валюта", Сообщение);
	ПрисвоитьЕслиЗаполнено(Сообщение.Валюта1С, Валюта);
	
	Договор = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Договор", Сообщение);
	ПрисвоитьЕслиЗаполнено(Сообщение.Договор, Договор);
	
	Организация = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Организация", Сообщение);
	ПрисвоитьЕслиЗаполнено(Сообщение.Отправитель1С, Организация);
	ПрисвоитьЕслиЗаполнено(Сообщение.Продавец1С, Организация);
	
	Контрагент = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Контрагент", Сообщение); 
	ПрисвоитьЕслиЗаполнено(Сообщение.Покупатель1С, Контрагент);
	ПрисвоитьЕслиЗаполнено(Сообщение.Грузополучатель1С, Контрагент);
	
	Склад = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "Склад", Сообщение);
	ПрисвоитьЕслиЗаполнено(Сообщение.Грузоотправитель1С, Склад);
	
	ДокументЗаказ = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "ДокументЗаказ", Сообщение);
	ПрисвоитьЕслиЗаполнено(Сообщение.Заказ1С, ДокументЗаказ);
	
	ДокументНакладная = ПолучитьРеквизитДокументаДляСообщения(ДокументСсылка, "ДокументНакладная", Сообщение);
