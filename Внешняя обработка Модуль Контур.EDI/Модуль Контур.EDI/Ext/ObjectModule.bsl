		СтруктураТипа.ДлинаСтроки		= 0;
		СтруктураТипа.ДлинаЧисла    	= 0;
		СтруктураТипа.ТочностьЧисла    	= 0;
		СтруктураТипа.ЧастиДаты    		= Неопределено;
	ИначеЕсли Лев(ИмяТипа, 6) = "Строка" Тогда	
		СтруктураТипа.ИмяТипа			= "Строка";
		СтруктураТипа.ДлинаСтроки		= Число(Сред(ИмяТипа, 7));
		СтруктураТипа.ДлинаЧисла    	= 0;
		СтруктураТипа.ТочностьЧисла    	= 0;
		СтруктураТипа.ЧастиДаты    		= Неопределено; 
	ИначеЕсли ИмяТипа = "Булево" Тогда	
		СтруктураТипа.ИмяТипа			= "Булево";
		СтруктураТипа.ДлинаСтроки		= 0;
		СтруктураТипа.ДлинаЧисла    	= 0;
		СтруктураТипа.ТочностьЧисла    	= 0;
		СтруктураТипа.ЧастиДаты    		= Неопределено;  
	ИначеЕсли ИмяТипа = "УИД" Тогда
		СтруктураТипа.ИмяТипа			= "УникальныйИдентификатор";
		СтруктураТипа.ДлинаСтроки		= 0;
		СтруктураТипа.ДлинаЧисла    	= 0;
		СтруктураТипа.ТочностьЧисла    	= 0;
		СтруктураТипа.ЧастиДаты    		= Неопределено; 
	ИначеЕсли ИмяТипа = "ДатаВремя" Тогда
		СтруктураТипа.ИмяТипа			= "Дата";
		СтруктураТипа.ДлинаСтроки		= 0;
		СтруктураТипа.ДлинаЧисла    	= 0;
		СтруктураТипа.ТочностьЧисла    	= 0;
		СтруктураТипа.ЧастиДаты    		= ЧастиДаты.ДатаВремя;
