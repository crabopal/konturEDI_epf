Функция КонтурДиадокAPI_СписокДокументовПолный(Знач ДанныеАвторизацииДиадок, ИдентификаторЯщика, Категория, ОтветВЛокальныхИменах = Ложь) Экспорт
	
	КлючПостраничногоВывода 	= Неопределено;
	Результат 					= Новый Массив;
	ЕстьЕщеДокументы 			= Истина;

	Пока ЕстьЕщеДокументы Цикл 
		Ответ = КонтурДиадокAPI_СписокДокументов(ДанныеАвторизацииДиадок, ИдентификаторЯщика, Категория, КлючПостраничногоВывода, ОтветВЛокальныхИменах);				
		
		Если КонтурСтандарт_ЭтоСтруктура(Ответ)
			И Ответ.Свойство("Documents") Тогда  
			
			ЧастьДокументов = Ответ.Documents;
			Результат.Добавить(ЧастьДокументов);
			
			КоличествоЧастиДокументов	= ЧастьДокументов.Количество();
			TotalCount					= Ответ.TotalCount;
			
			Если TotalCount = 0 Тогда
				КлючПостраничногоВывода = "";
			Иначе
				КлючПостраничногоВывода = ЧастьДокументов[КоличествоЧастиДокументов - 1].IndexKey;
			КонецЕсли;
			
			ЕстьЕщеДокументы = TotalCount > КоличествоЧастиДокументов ИЛИ Ответ.HasMoreResults;
		Иначе 	
			Прервать;	
		КонецЕсли;	
		
	КонецЦикла;	
	
	Возврат Результат;	
	
КонецФункции

// Метод для получения списка документов из ящика Диадок с возможностью фильтрации по категории и постраничной навигации.
// Возвращает перечень документов, соответствующих заданным критериям отбора.
// В случае HTTP ответа отличного от "200", выбрасывает исключение.
//
// Параметры:
//   ДанныеАвторизацииДиадок   - Структура - см. метод КонтурДиадокAPI_НовыйДанныеАвторизации.
//   ИдентификаторЯщика        - Строка - Идентификатор ящика организации в Диадок.
//   Категория                 - Строка - Категория документов для фильтрации (например, "Inbound", "Outbound", "Internal").
//   КлючПостраничногоВывода   - Строка - Ключ для продолжения постраничного вывода, полученный в предыдущем ответе (необязательный).
//   ОтветВЛокальныхИменах     - Булево - Признак приведения имен свойств ответа к локальному формату (по умолчанию Ложь).
//
// Возвращаемое значение:
//   Структура - См. свойства в методе КонтурДиадокAPI_Схема_DocumentList.
//
Функция КонтурДиадокAPI_СписокДокументов(Знач ДанныеАвторизацииДиадок, ИдентификаторЯщика, Категория, КлючПостраничногоВывода = Неопределено, ОтветВЛокальныхИменах = Ложь) Экспорт
	
	КонтурДиадокAPI_УстановитьТокенДляЗапроса(ДанныеАвторизацииДиадок);
	
	МенеджерНастроек = КонтурДиадокAPI_МенеджерНастроек();
	
	ПараметрыСервиса = КонтурДиадокAPI_GetDocuments(); 
	
	ПараметрыСервиса.Параметры.boxId 			= ИдентификаторЯщика;
	ПараметрыСервиса.Параметры.filterCategory 	= Категория; 
	ПараметрыСервиса.Параметры.afterIndexKey 	= КлючПостраничногоВывода;

	ДополнительныеПараметры = Новый Структура("Заголовки", ПараметрыСервиса.Заголовки);
	
	Ответ = КонтурДиадокAPI_Get(ДанныеАвторизацииДиадок, ПараметрыСервиса.URL, ПараметрыСервиса.Параметры, ДополнительныеПараметры, МенеджерНастроек.Сессия); 	
	
	ПодготовленныйОтветКлиента = КонтурДиадокAPI_ОбработатьРезультатHTTPЗапроса(ПараметрыСервиса, Ответ);
	
	Возврат КонтурДиадокAPI_Привести("DocumentList", ПодготовленныйОтветКлиента.Результат, ОтветВЛокальныхИменах);	

КонецФункции

// Метод для генерации универсального сообщения на основе полученного документа в системе Диадок.
// Создает XML-файл ответного документа (уведомления, подтверждения и т.д.) на основе шаблона, переданного в теле запроса.
// В случае HTTP ответа отличного от "200", выбрасывает исключение.
//
// Параметры:
//   ДанныеАвторизацииДиадок - Структура - см. метод КонтурДиадокAPI_НовыйДанныеАвторизации.
//   ИдентификаторЯщика      - Строка - Идентификатор ящика организации в Диадок.
//   ИдентификаторСообщения  - Строка - Идентификатор сообщения, на которое формируется ответ.
//   ИдентификаторСущности   - Строка - Идентификатор сущности (документа), на которую формируется ответ.
//   ТелоЗапроса            - ДвоичныеДанные - Шаблон универсального сообщения в виде двоичных данных.
//
// Возвращаемое значение:
//   Строка - Сгенерированный XML универсального сообщения.
//
Функция КонтурДиадокAPI_СгенерироватьУниверсальноеСообщение(Знач ДанныеАвторизацииДиадок, ИдентификаторЯщика, ИдентификаторСообщения, ИдентификаторСущности, ТелоЗапроса) Экспорт
	
	КонтурДиадокAPI_УстановитьТокенДляЗапроса(ДанныеАвторизацииДиадок);
	
	МенеджерНастроек = КонтурДиадокAPI_МенеджерНастроек();
	
	ПараметрыСервиса = КонтурДиадокAPI_GenerateUniversalMessage();   
	
	ПараметрыСервиса.Параметры.boxId 		= ИдентификаторЯщика;
	ПараметрыСервиса.Параметры.messageId 	= ИдентификаторСообщения;
	ПараметрыСервиса.Параметры.attachmentId = ИдентификаторСущности;
	
	ДополнительныеПараметры = Новый Структура("Заголовки, ПараметрыЗапроса", ПараметрыСервиса.Заголовки, ПараметрыСервиса.Параметры);
	
	Ответ = КонтурДиадокAPI_Post(ДанныеАвторизацииДиадок, ПараметрыСервиса.URL, ТелоЗапроса, ДополнительныеПараметры, МенеджерНастроек.Сессия); 	
	
	ПодготовленныйОтветКлиента = КонтурДиадокAPI_ОбработатьРезультатHTTPЗапроса(ПараметрыСервиса, Ответ);
	
	Возврат ПодготовленныйОтветКлиента.Результат;	

КонецФункции

// Осуществляет попытку преобразования объекта в структуру, описанной схемой.  
// Список всех доступных схем см. КонтурEDIAPI_ИнициализироватьСхемы  
//
// Параметры:
//   Схема - Строка - Имя схемы по которой следует привести объект.	
//   ОбъектКонвертации - Структура - Входная структура для приведения по схеме 
//   ЛокальныеИмена - Булево - флаг отвечающий за локализацию ключей структуры ответа метода
//
// Возвращаемое значение:
//   Структура - приведенная модель по переданному объекту и схеме  
//
Функция КонтурДиадокAPI_Привести(Схема, ОбъектКонвертации, ЛокальныеИмена = Ложь) Экспорт  
	
	МенеджерНастроек = КонтурДиадокAPI_МенеджерНастроек();
	ХранилищеСхем	 = МенеджерНастроек.ХранилищеСхем;
	
	ПриведенныйОбъект = Неопределено;
	
	Если Схема = "PowerOfAttorneyToPost" 
		И НЕ ОбъектКонвертации = Неопределено Тогда  
		
		ПриведенныйОбъект = КонтурДиадокAPI_Привести_PowerOfAttorneyToPost(ХранилищеСхем, Схема, ОбъектКонвертации, ЛокальныеИмена);

	ИначеЕсли Схема = "PowerOfAttorneyToRegister"
		И НЕ ОбъектКонвертации = Неопределено Тогда
		
		ПриведенныйОбъект = КонтурДиадокAPI_Привести_PowerOfAttorneyToRegister(ХранилищеСхем, Схема, ОбъектКонвертации, ЛокальныеИмена);		
		
	Иначе
		
		ПриведенныйОбъект = ПостроительСхем_ПривестиПоСхеме(ХранилищеСхем, Схема, ОбъектКонвертации, ЛокальныеИмена);
		
	КонецЕсли;	
	
	Возврат ПриведенныйОбъект; 
	
КонецФункции

// Осуществляет попытку создать структуру, описанной схемой.  
//
// Параметры:
//   Схема - Строка - Имя схемы по которой следует создать структуру.	
//   ЛокальныеИмена - Булево - флаг отвечающий за локализацию ключей структуры ответа метода
//
// Возвращаемое значение:
//   Структура - приведенная модель по схеме  
//
Функция КонтурДиадокAPI_СоздатьПоСхеме(Схема, ЛокальныеИмена = Ложь) Экспорт
	
	МенеджерНастроек = КонтурДиадокAPI_МенеджерНастроек();
	ХранилищеСхем	 = МенеджерНастроек.ХранилищеСхем;
	
	СозданныйОбъект = Неопределено;
	
	СозданныйОбъект = ПостроительСхем_ПривестиПоСхеме(ХранилищеСхем, Схема, Неопределено, ЛокальныеИмена);
	
	Возврат СозданныйОбъект; 
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЙ ИНТЕРФЕЙС

Функция КонтурДиадокAPI_НовыйМенеджерНастроек()
	
	МенеджерНастроек = Новый Структура;
	
	МенеджерНастроек.Вставить("КлиентИД", "");
	МенеджерНастроек.Вставить("ТестовоеОкружение", Ложь);
	МенеджерНастроек.Вставить("Сессия", Неопределено);
	МенеджерНастроек.Вставить("КэшТокенов", Неопределено);
	МенеджерНастроек.Вставить("АдресСервера", "");
	МенеджерНастроек.Вставить("АдресаСерверов", Неопределено);
	МенеджерНастроек.Вставить("ХранилищеСхем", Неопределено);

	Возврат МенеджерНастроек;
	
КонецФункции

Процедура КонтурДиадокAPI_УстановитьЗаголовокАвторизации(ДанныеАвторизацииДиадок)
	
	МенеджерНастроек = КонтурДиадокAPI_МенеджерНастроек();
	
	ТипыАвторизации = КонтурДиадокAPI_ТипыАвторизации();
	
	Токен = Неопределено;
	
	Если НЕ ДанныеАвторизацииДиадок = Неопределено И КонтурСтандарт_ЭтоСтруктура(ДанныеАвторизацииДиадок) Тогда
		
		ДанныеАвторизацииДиадок.Свойство("Токен", Токен);
		
	КонецЕсли;
	
	ЗаголовокАвторизации = КонтурДиадокAPI_СформироватьТокен(МенеджерНастроек.КлиентИД, Токен); 	
	МенеджерНастроек.Сессия.Заголовки.Вставить("Authorization", ЗаголовокАвторизации); 

КонецПроцедуры

Функция КонтурДиадокAPI_СформироватьТокен(ClientID, ddauth_token = Неопределено)      
	
	Если ПустаяСтрока(ddauth_token) Тогда
		Токен  = КонтурСтандарт_СтрШаблон_("DiadocAuth ddauth_api_client_id=%1", ClientID);  
	Иначе    
		Токен  = КонтурСтандарт_СтрШаблон_("DiadocAuth ddauth_api_client_id=%1, ddauth_token=%2", ClientID, ddauth_token);	
	КонецЕсли;    
		
	Возврат Токен;
	
КонецФункции

Функция КонтурДиадокAPI_ТипыОтветаСервиса()   
	
	Структура = Новый Структура;
	
	Структура.Вставить("BASE64"	,	"BASE64");
	Структура.Вставить("BIN"	,	"BIN"	);
	Структура.Вставить("JSON"	,	"JSON"	);
	Структура.Вставить("STRING"	,	"STRING");
	
	Возврат Структура; 
	
КонецФункции

Функция КонтурДиадокAPI_НовыйПараметрыСервиса()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Сервер"							, КонтурДиадокAPI_АдресСервера());
	Результат.Вставить("Метод"							, ""						);
	Результат.Вставить("АдресРесурса"					, ""						);
	Результат.Вставить("URL"							, ""						);
	Результат.Вставить("ТелоЗапроса"					, Неопределено				);
	Результат.Вставить("Параметры"						, Новый Структура			);
	Результат.Вставить("Заголовки"						, Новый Соответствие		);
	Результат.Вставить("ДопустимыеКодыОтвета"			, Новый Массив				);
	Результат.Вставить("ТипОтвета"						, КонтурДиадокAPI_ТипыОтветаСервиса().JSON	);
	
	Результат.Заголовки.Вставить("Accept"		, "application/json");
	Результат.Заголовки.Вставить("Content-Type"	, "application/json;charset=utf-8");
	
	Возврат Результат;
	
КонецФункции

Функция КонтурДиадокAPI_АдресСервера()
	
	МенеджерНастроек = КонтурДиадокAPI_МенеджерНастроек();
	
	Если МенеджерНастроек.АдресСервера = Неопределено 
		ИЛИ ПустаяСтрока(МенеджерНастроек.АдресСервера) Тогда  
		
		АдресаСерверовДиадок = КонтурДиадокAPI_АдресаСерверов();
		
		МенеджерНастроек.АдресСервера = АдресаСерверовДиадок[0]; 
		
	КонецЕсли;	
		
	Возврат МенеджерНастроек.АдресСервера;
	
КонецФункции

Функция КонтурДиадокAPI_АдресаСерверов()
	
	МенеджерНастроек = КонтурДиадокAPI_МенеджерНастроек(); 
	АдресаСерверов = МенеджерНастроек.АдресаСерверов;
	
	Если МенеджерНастроек.АдресаСерверов = Неопределено Тогда
		
		ТестовыеСервера = КонтурСтандарт_МассивЗначений("diadoc-api-test.kontur.ru");
		ПродуктовыеСервера = КонтурСтандарт_МассивЗначений("diadoc-api.kontur.ru");
		
		АдресаСерверов = ?(МенеджерНастроек.ТестовоеОкружение = Истина,
								ТестовыеСервера,
								ПродуктовыеСервера);
								
		КонтурДиадокAPIПереопределяемый_АдресаСерверов(АдресаСерверов);	
		
		МенеджерНастроек.АдресаСерверов = АдресаСерверов; 
		
	КонецЕсли;
	
	Возврат АдресаСерверов;
	
КонецФункции

Функция КонтурДиадокAPI_Get(ДанныеАвторизацииДиадок, URL, ПараметрыЗапроса = Неопределено, ДополнительныеПараметры = Неопределено, Сессия = Неопределено)
	
	Ответ = КлиентHTTP_Get(URL, ПараметрыЗапроса, ДополнительныеПараметры, Сессия);
	
	Если КонтурДиадокAPI_КодСостояния_401(Ответ) Тогда
		
		КонтурДиадокAPI_ОбновитьТокенАвторизации(ДанныеАвторизацииДиадок);
		
		Ответ = КлиентHTTP_Get(URL, ПараметрыЗапроса, ДополнительныеПараметры, Сессия);
		
	ИначеЕсли КонтурДиадокAPI_ЭтоКодСостоянияДляСменыСервера(Ответ) Тогда
		
		ДоступенРезервныйАдрес = КонтурДиадокAPI_СменитьАдресСервераНаРезервный();
		
		Если ДоступенРезервныйАдрес Тогда
		
			РезервныйURL = КонтурДиадокAPI_ЗаменитьАдресСервераВURL(URL); 
		
			Ответ = КонтурДиадокAPI_Get(ДанныеАвторизацииДиадок, РезервныйURL, ПараметрыЗапроса, ДополнительныеПараметры, Сессия);	
		
		КонецЕсли;

	КонецЕсли; 
		
	Возврат Ответ; 
	
КонецФункции

Функция КонтурДиадокAPI_Post(ДанныеАвторизацииДиадок, URL, Данные = Неопределено, ДополнительныеПараметры = Неопределено, Сессия = Неопределено)
	
	Ответ = КлиентHTTP_Post(URL, Данные, ДополнительныеПараметры, Сессия);
	
	Если НЕ ДанныеАвторизацииДиадок = Неопределено 
		И КонтурДиадокAPI_КодСостояния_401(Ответ) Тогда
		
		КонтурДиадокAPI_ОбновитьТокенАвторизации(ДанныеАвторизацииДиадок);
		
		Ответ = КлиентHTTP_Post(URL, Данные, ДополнительныеПараметры, Сессия);
		
	ИначеЕсли КонтурДиадокAPI_ЭтоКодСостоянияДляСменыСервера(Ответ) Тогда
		
		ДоступенРезервныйАдрес = КонтурДиадокAPI_СменитьАдресСервераНаРезервный();
		
		Если ДоступенРезервныйАдрес Тогда
		
			РезервныйURL = КонтурДиадокAPI_ЗаменитьАдресСервераВURL(URL); 
		
			Ответ = КонтурДиадокAPI_Post(ДанныеАвторизацииДиадок, РезервныйURL, Данные, ДополнительныеПараметры, Сессия);	
		
		КонецЕсли;

	КонецЕсли;
	
	Возврат Ответ; 
	
КонецФункции 

Функция КонтурДиадокAPI_ЗаменитьАдресСервераВURL(URL)

	СтруктураURL = КлиентHTTP_РазобратьURL(URL);
		
	РезервныйURL = СтрЗаменить(URL, СтруктураURL.Сервер, КонтурДиадокAPI_АдресСервера());
	
	Возврат РезервныйURL;
	
КонецФункции

Функция КонтурДиадокAPI_ЭтоКодСостоянияДляСменыСервера(Ответ)
	
	Коды = КлиентHTTP_КодыСостоянияHTTP();
	
	Возврат Ответ.КодСостояния >= Коды.ВнутренняяОшибкаСервера_500; 
	
КонецФункции

Функция КонтурДиадокAPI_КодСостояния_401(Ответ)
	
	Коды = КлиентHTTP_КодыСостоянияHTTP();
	
	Возврат Ответ.КодСостояния = Коды.НеАвторизован_401;	
	
КонецФункции                

Функция КонтурДиадокAPI_ОбработатьРезультатHTTPЗапроса(ПараметрыСервиса, РезультатHTTP) 
	
	ТипыОтветаСервиса = КонтурДиадокAPI_ТипыОтветаСервиса();
	
	ОтветСервиса = Новый Структура("Успешно, Результат, ОписаниеОшибки");
	
	ДопустимыеКодыОтвета	= ПараметрыСервиса.ДопустимыеКодыОтвета;
	
	ОтветСервиса.Успешно = ДопустимыеКодыОтвета.Найти(Число(РезультатHTTP.КодСостояния)) <> Неопределено;
	
	Если ОтветСервиса.Успешно Тогда
		
		Если ПараметрыСервиса.ТипОтвета = ТипыОтветаСервиса.JSON Тогда 
			
			Результат = КлиентHTTP_КакJson(РезультатHTTP, Ложь);
			
		ИначеЕсли ПараметрыСервиса.ТипОтвета = ТипыОтветаСервиса.BASE64 Тогда
			
			Результат = Base64Значение(КлиентHTTP_КакТекст(РезультатHTTP));		  
			
		ИначеЕсли ПараметрыСервиса.ТипОтвета = ТипыОтветаСервиса.STRING Тогда
			
			Результат = КлиентHTTP_КакТекст(РезультатHTTP);
			
		Иначе    
			
			Результат = РезультатHTTP.Тело;	 
			
		КонецЕсли;
		
		ОтветСервиса.Результат = Результат;
		
	Иначе                     
		
		ВызватьИсключение КлиентHTTP_КакИсключение(РезультатHTTP);		  
	
	КонецЕсли;
	
	Возврат ОтветСервиса;
	
КонецФункции

Функция КонтурДиадокAPI_СменитьАдресСервераНаРезервный()
	
	АдресаСерверовДиадок = КонтурДиадокAPI_АдресаСерверов();
	
	АдресСервераДиадок = КонтурДиадокAPI_АдресСервера();
	
	ПорядокТекущегоАдреса = АдресаСерверовДиадок.Найти(АдресСервераДиадок);
	
	Если ПорядокТекущегоАдреса = АдресаСерверовДиадок.ВГраница() Тогда
		
		Возврат Ложь;	
		
	КонецЕсли;
	
	МенеджерНастроек = КонтурДиадокAPI_МенеджерНастроек();
	
	МенеджерНастроек.АдресСервера = АдресаСерверовДиадок[ПорядокТекущегоАдреса + 1];
	
	Возврат Истина;

КонецФункции

Процедура КонтурДиадокAPI_УстановитьТокенДляЗапроса(ДанныеАвторизацииДиадок)
	
	Если НЕ ЗначениеЗаполнено(ДанныеАвторизацииДиадок.Токен) Тогда
		
		ДанныеАвторизацииДиадок.Токен = КонтурДиадокAPI_ПрочитатьТокенИзКэша(ДанныеАвторизацииДиадок);	
			
		Если ПустаяСтрока(ДанныеАвторизацииДиадок.Токен) Тогда
			
			ЗашифрованныйКонтент = КонтурДиадокAPI_Авторизоваться(ДанныеАвторизацииДиадок);
			ТипыАвторизации = КонтурДиадокAPI_ТипыАвторизации();
			
			Если ДанныеАвторизацииДиадок.ТипАвторизации = ТипыАвторизации.Сертификат Тогда
				РасшифрованныйТокен = Криптография_Расшифровать(ЗашифрованныйКонтент, , ДанныеАвторизацииДиадок.ПарольЗакрытогоКлюча, ДанныеАвторизацииДиадок.Расположение);
				ДанныеАвторизацииДиадок.Токен = КонтурСтандарт_Base64Строка(РасшифрованныйТокен);
			ИначеЕсли ДанныеАвторизацииДиадок.ТипАвторизации = ТипыАвторизации.ЛогинПароль Тогда
				ДанныеАвторизацииДиадок.Токен = ЗашифрованныйКонтент;	
			Иначе         
				ВызватьИсключение "КонтурДиадокAPI: Неизвестный тип авторизации для получения токена";	
			КонецЕсли;		 
			
			КонтурДиадокAPI_ЗаписатьТокенВКэш(ДанныеАвторизацииДиадок);	
			
		КонецЕсли;
		
	КонецЕсли;
	
	КонтурДиадокAPI_УстановитьЗаголовокАвторизации(ДанныеАвторизацииДиадок);
	
КонецПроцедуры

Процедура КонтурДиадокAPI_ОбновитьТокенАвторизации(ДанныеАвторизацииДиадок)
	
	ТипыАвторизации = КонтурДиадокAPI_ТипыАвторизации();
		
	Если КонтурДиадокAPIПереопределяемый_ЭтоУправляемыеФормы() 
		И ДанныеАвторизацииДиадок.ТипАвторизации = ТипыАвторизации.Сертификат 
		И ДанныеАвторизацииДиадок.Расположение = "клиент" Тогда
		ВызватьИсключение КонтурДиадокAPI_ИдентификаторОшибкиОбновитьТокенАвторизации();
	КонецЕсли;
	
	ДанныеАвторизацииДиадок.Токен = "";
		
	КонтурДиадокAPI_ЗаписатьТокенВКэш(ДанныеАвторизацииДиадок);	
	
	КонтурДиадокAPI_УстановитьТокенДляЗапроса(ДанныеАвторизацииДиадок);
	
КонецПроцедуры

Процедура КонтурДиадокAPI_ЗаписатьТокенВКэш(ДанныеАвторизацииДиадок)
	
	МенеджерНастроек = КонтурДиадокAPI_МенеджерНастроек();
	
	КлючНастроек = КонтурДиадокAPI_КлючНастроекТокенаПоДаннымАвторизации(ДанныеАвторизацииДиадок);

	МенеджерНастроек.КэшТокенов.Вставить(КлючНастроек, ДанныеАвторизацииДиадок.Токен);

КонецПроцедуры

Функция КонтурДиадокAPI_ПрочитатьТокенИзКэша(ДанныеАвторизацииДиадок)
	
	МенеджерНастроек = КонтурДиадокAPI_МенеджерНастроек();
	
	КлючНастроек = КонтурДиадокAPI_КлючНастроекТокенаПоДаннымАвторизации(ДанныеАвторизацииДиадок);
	
	Токен = МенеджерНастроек.КэшТокенов.Получить(КлючНастроек);
	
	Возврат ?(Токен = Неопределено, "", Токен); 

КонецФункции

Функция КонтурДиадокAPI_КлючНастроекТокенаПоДаннымАвторизации(ДанныеАвторизацииДиадок)
	
	ТипыАвторизации = КонтурДиадокAPI_ТипыАвторизации();
		
	Если ДанныеАвторизацииДиадок.ТипАвторизации = ТипыАвторизации.ЛогинПароль Тогда
		КлючНастроек = ДанныеАвторизацииДиадок.Логин;	
	ИначеЕсли ДанныеАвторизацииДиадок.ТипАвторизации = ТипыАвторизации.Сертификат Тогда
		КлючНастроек = ДанныеАвторизацииДиадок.Отпечаток;	
	ИначеЕсли ДанныеАвторизацииДиадок.ТипАвторизации = ТипыАвторизации.ИдентификаторСессии Тогда
		КлючНастроек = ДанныеАвторизацииДиадок.ИдентификаторСессии;		
	Иначе	
		КлючНастроек = "";	
	КонецЕсли;
	
	Возврат КлючНастроек;
	
КонецФункции

Функция КонтурДиадокAPI_СертификатДоступенНаСервере(Знач ДанныеАвторизацииДиадок)
	
	Возврат ДанныеАвторизацииДиадок.ТипАвторизации = КонтурДиадокAPI_ТипыАвторизации().Сертификат 
	И (ДанныеАвторизацииДиадок.Расположение = "сервер" 
		ИЛИ НЕ ЭтоУФ() И ДанныеАвторизацииДиадок.Расположение = "клиент"
		ИЛИ КонтурСтандарт_ИнформационнаяБазаФайловая() И Не КонтурДиадокAPI_СеансПодключенЧерезВебСервер());	
	
КонецФункции

Функция КонтурДиадокAPI_СеансПодключенЧерезВебСервер()

	НавигационнаяСсылкаИБ = ПолучитьНавигационнуюСсылкуИнформационнойБазы();
	Возврат ЗначениеЗаполнено(НавигационнаяСсылкаИБ) И НРег(Лев(НавигационнаяСсылкаИБ, 4)) = "http"; 
    
КонецФункции

