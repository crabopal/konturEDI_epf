// синоним ПриПереходеНаНовуюВерсию
Функция ПроверитьЗапускНовойВерсииМодуля() Экспорт
	
	Результат = Новый Структура();
	Результат.Вставить("ПродолжитьЗапуск", Истина);
	Результат.Вставить("ТекстОшибки", "");
	
	ТекущаяВерсияМодуля = ПараметрыКлиентСервер.ОписаниеВерсии.ПолнаяСемантикВерсия;
	ВерсияМодуляВ1С = Строка(ПолучитьКонстантуEDI("НомерВерсии"));
	
	Если НЕ ЗначениеЗаполнено(ВерсияМодуляВ1С) Тогда
		
		УстановитьВерсиюМодуля(ТекущаяВерсияМодуля);
		ПроверкаНовойВерсии_НеОбновлятьВесьСписокНаУФ();

		Возврат Результат;
	
	КонецЕсли;
	
	Если СокрЛП(ВерсияМодуляВ1С) = СокрЛП(ТекущаяВерсияМодуля) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЗапускаетсяСтараяРедакцияМодуля = (ЗапускаетсяСтараяРедакцияМодуля(ВерсияМодуляВ1С, ТекущаяВерсияМодуля) = Истина);
	Если ЗапускаетсяСтараяРедакцияМодуля Тогда
		
		ТекстОшибки = "Вы запускаете старую редакцию модуля Контур.EDI " + ТекущаяВерсияМодуля +
			", последний раз была запущена версия " + ВерсияМодуляВ1С + ".
			|Делать это не рекомендуется из-за отсутствия обратной совместимости.
			|Запуск модуля Контур.EDI сейчас будет завершен.";
		Результат.ПродолжитьЗапуск = Ложь;
		Результат.ТекстОшибки = ТекстОшибки;
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);
		
		Возврат Результат;
		
	КонецЕсли;
	
	ЗапускаетсяСтарыйРелизМодуля = (ЗапускаетсяСтарыйРелизМодуля(ВерсияМодуляВ1С, ТекущаяВерсияМодуля) = Истина);
	Если ЗапускаетсяСтарыйРелизМодуля Тогда
		
		ТекстКомментария = "Вы запускаете старую версию модуля Контур.EDI " + ТекущаяВерсияМодуля + 
			", последний раз была запущена версия " + ВерсияМодуляВ1С + ".";
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Предупреждение, ТекстКомментария);
		Сообщить_КонтурEDI("ПРЕДУПРЕЖДЕНИЕ - " + ТекстКомментария);
		Метрика_Предупреждение("ПроверитьЗапускНовойВерсииМодуля", ТекстКомментария);
		
	КонецЕсли;
		
	Если ВерсияМодуляВ1С < "4.01.043.01" Тогда
		ПроверкаНовойВерсии_СоответствияТоваровВРазрезеПартнеров();
	КонецЕсли;
	
	Если ВерсияМодуляВ1С < "4.01.044.06" Тогда
		ПроверкаНовойВерсии_УстановкаGLNДляУчетнойЗаписи();
	КонецЕсли;
	
	Если ВерсияМодуляВ1С < "4.01.046.03" Тогда
		ПроверкаНовойВерсии_ОтправлятьВозвратнуюТаруВDESADV();
	КонецЕсли;
	
	Если ВерсияМодуляВ1С < "4.02.003.01" Тогда
		
		ПроверкаНовойВерсии_ПереходНаAPI(Результат);
		Если Результат.ПродолжитьЗапуск = Ложь Тогда
			Возврат Результат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ВерсияМодуляВ1С < "4.02.005.01" Тогда
		ПроверкаНовойВерсии_СконвертироватьНастройкиДокументовДляКонструктора();
	КонецЕсли;
	
	Если ВерсияМодуляВ1С < "4.03.001.01" Тогда
		ПроверкаНовойВерсии_ОбработкаСтатусныхAPI();
	КонецЕсли;
	
	Если ВерсияМодуляВ1С < "4.03.002.01" Тогда
		ПроверкаНовойВерсии_ЗаполнениеОрганизации();
	КонецЕсли;
	
	Если ВерсияМодуляВ1С < "4.03.003.01" Тогда
		ПроверкаНовойВерсии_ОтклонятьОтветыНаЗаказСДобавленнымТоваром();	
	КонецЕсли;
	
	Если ВерсияМодуляВ1С < "4.03.004.01" Тогда
		ПроверкаНовойВерсии_УстановкаПротоколаОбмена();			
	КонецЕсли;
	
	Если ВерсияМодуляВ1С < "4.03.014.01" Тогда
		
		ПроверкаНовойВерсии_ПереносОбщихНастроекВНастройкиПартнеров_4_03_014_01();
		// восстановлена работоспособность настройки "ОбновлятьВесьСписокПриРаботеСЗаказами"
		ПроверкаНовойВерсии_НеОбновлятьВесьСписокНаУФ();
		
	КонецЕсли;
	
	Если ВерсияМодуляВ1С < "4.03.019.01" Тогда
		ПроверкаНовойВерсии_УдалениеИдентификатораКлиентаИзСертификатов();
	КонецЕсли;
	
	Если ВерсияМодуляВ1С < "4.03.021.01" Тогда
		ПроверкаНовойВерсии_УстановкаВозвратныхСообщенийДляПартнеровПокупателей();
	КонецЕсли;
	
	Если ВерсияМодуляВ1С < "4.03.025.01" Тогда
		ПроверкаНовойВерсии_НовыйДокументПриобретениеТоваровУслуг();	
	КонецЕсли;
		
	Если ВерсияМодуляВ1С < "4.03.026.01" Тогда
		ПроверкаНовойВерсии_ПерезаполнитьТипЕдиницыПоУслугам();
	КонецЕсли;
	
	Если ВерсияМодуляВ1С < "4.39.0" Тогда
		ПроверкаНовойВерсии_НастройкиПредварительныхЗаказов();
	КонецЕсли;
		
	Если СравнитьСемантикВерсии(ВерсияМодуляВ1С, "4.41.0") = ВидСравнения.Меньше Тогда
		
		ПроверкаНовойВерсии_ДобавитьНомерПоследнейУпаковкиSSCC();
		
		ИдентификаторыРасширения = Новый Массив;
