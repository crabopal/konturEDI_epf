Функция СравнитьТаблицыЗначений(Таблица1, Таблица2) Экспорт
	
	ОбщиеКолонки = "";
	
	Для Каждого ТекущаяКолонка Из Таблица1.Колонки Цикл
		
		Если Таблица2.Колонки.Найти(ТекущаяКолонка.Имя) = Неопределено Тогда
			
			Возврат Ложь;

		Иначе
			
			Если ОбщиеКолонки = "" Тогда 
				
				ОбщиеКолонки = ТекущаяКолонка.Имя; 
				
			Иначе
				
				ОбщиеКолонки = ОбщиеКолонки + "," + ТекущаяКолонка.Имя;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ТекущаяКолонка Из Таблица2.Колонки Цикл
		
		Если Таблица1.Колонки.Найти(ТекущаяКолонка.Имя) = Неопределено Тогда
			
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаОтличий = Таблица1.Скопировать();
	
	ТаблицаОтличий.Колонки.Добавить("СчетчикСтрокСравниваемыхТаблиц", ОписаниеТипаЧисло_КонтурEDI());
	ТаблицаОтличий.ЗаполнитьЗначения(1, "СчетчикСтрокСравниваемыхТаблиц");
	
	Для Каждого СтрокаТаблицы Из Таблица2 Цикл
		
		НоваяСтрока = ТаблицаОтличий.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		
		НоваяСтрока.СчетчикСтрокСравниваемыхТаблиц = -1;
		
	КонецЦикла;
	
	ТаблицаОтличий.Свернуть(ОбщиеКолонки, "СчетчикСтрокСравниваемыхТаблиц");
	
	СтруктураПоиска = Новый Структура("СчетчикСтрокСравниваемыхТаблиц", 0);
	Строки = ТаблицаОтличий.НайтиСтроки(СтруктураПоиска);
	
	Возврат Строки.Количество() = ТаблицаОтличий.Количество();
	
КонецФункции

Функция СравнитьТаблицыТоваров(
	СтруктураТаблицы1,
	СтруктураТаблицы2,
	СравниваемыеПоля,
	РассчитыватьНДС =  Истина,
	ПропускатьНулевыеЗначения = Ложь,
	Сообщение1 = Неопределено,
	Сообщение2 = Неопределено,
	ПриравниватьДенежныеПоля = Истина) Экспорт
	
	Если СтруктураТаблицы1.Товары.Колонки.Найти("КонечныйГрузополучательGLN") <> Неопределено
		И СтруктураТаблицы2.Товары.Колонки.Найти("КонечныйГрузополучательGLN") <> Неопределено Тогда 
		
		СравнениеСУчетомКонечныйГрузополучательGLN = Истина;
		
	Иначе
		
		СравнениеСУчетомКонечныйГрузополучательGLN = Ложь;
		
	КонецЕсли;
	
	РезультатСравнения = Новый Структура();
	РезультатСравнения.Вставить("Успешно",Истина);
	РезультатСравнения.Вставить("ОписаниеОшибки");
	РезультатСравнения.Вставить("ЕстьРасхождения");
	РезультатСравнения.Вставить("ТаблицаСравнения");
	
	СтандартнаяОбработкаEDI = Истина;
	
	СтруктураПараметровДляПМ = Новый Структура("СтруктураТаблицы1,СтруктураТаблицы2,СравниваемыеПоля,РассчитыватьНДС,Сообщение1,Сообщение2",
			СтруктураТаблицы1,СтруктураТаблицы2,СравниваемыеПоля,РассчитыватьНДС,Сообщение1,Сообщение2);
			
	Результат = ОбработкаСобытияПодключаемогоМодуля("СравнитьТаблицыТоваров", СтандартнаяОбработкаEDI, СтруктураПараметровДляПМ);
			
    Если Не СтандартнаяОбработкаEDI Тогда
		Возврат Результат;
	КонецЕсли;
	
	// СтавкаНДС - тип EDI
	
	// Обязательные поля:
	// - GTIN
	// - КодТовараПокупателя
	// - КодТовараПоставщика
	
	// Сравниваемые поля:
	// - Количество
	// - СтавкаНДС
	// - ЦенаБезНДС
	// - ЦенаСНДС
	
	// Если РассчитыватьНДС = Истина, тогда в результирующую таблицу будут добавлены колонки "БазоваяЦена1" "БазоваяЦена2" с возможными значениями: "СНДС", "БезНДС", пусто.
	
	// *******
	
	// проверка входящих данных
	
	Если СтруктураТаблицы1.Вид = "Сообщение" Тогда
		ТипСообщения1 = СтруктураТаблицы1.ТипСообщения;
	Иначе
		ТипСообщения1 = "Документ";
	КонецЕсли;

	Если СтруктураТаблицы2.Вид = "Сообщение" Тогда
		ТипСообщения2 = СтруктураТаблицы2.ТипСообщения;
	Иначе
		ТипСообщения2 = "Документ";
	КонецЕсли;
	
	Если ТипСообщения1 = "ORDRSP" Тогда
		
		РезультатСравнения.Успешно = Ложь;
		РезультатСравнения.ОписаниеОшибки = "ORDRSP может быть передан как вторая таблица!";
		
		Возврат РезультатСравнения;
		
	ИначеЕсли ТипСообщения2 = "ORDRSP" И НЕ ТипСообщения1 = "ORDERS" Тогда
		
		РезультатСравнения.Успешно = Ложь;
		РезультатСравнения.ОписаниеОшибки = "ORDRSP можно сравнивать только с ORDERS!";
		
		Возврат РезультатСравнения;
		
	КонецЕсли;
			
	Таблица1 = СтруктураТаблицы1.Товары;
	Таблица2 = СтруктураТаблицы2.Товары;
	
	// подготовка таблицы сравнения
	
	ЕстьНоменклатура1 = НЕ Таблица1.Колонки.Найти("Номенклатура") = Неопределено;
	ЕстьНоменклатура2 = НЕ Таблица2.Колонки.Найти("Номенклатура") = Неопределено;
	
	ЕстьХарактеристикаНоменклатуры1 = НЕ Таблица1.Колонки.Найти("ХарактеристикаНоменклатуры") = Неопределено;
	
	ЕстьНаименование1 = НЕ Таблица1.Колонки.Найти("Наименование") = Неопределено;
	ЕстьНаименование2 = НЕ Таблица2.Колонки.Найти("Наименование") = Неопределено;
	
	ТаблицаСравнения = ТаблицаСравнение_КонтурEDI(СравнениеСУчетомКонечныйГрузополучательGLN, СравниваемыеПоля);   
	
	ИсходнаяТаблица = Таблица1;
	НужноОпределениеСтатуса = (ТипСообщения2 = "RETREC" ИЛИ ТипСообщения2 = "RETINS");
	Если НужноОпределениеСтатуса ИЛИ ТипСообщения2 = "ORDRSP"  Тогда
		
		ТаблицаСравнения.Колонки.Добавить("Статус");
		Если Таблица2.Колонки.Найти("Статус")  = Неопределено Тогда
			Таблица2.Колонки.Добавить("Статус");
		КонецЕсли;
				
	КонецЕсли;
	
	// заполнение таблицы
	Для Каждого Стр Из Таблица1 Цикл
		
		НоваяСтрока = ТаблицаСравнения.Добавить();
		
		Если ПеременнаяСодержитСвойство(Стр, "УИД_СтрокиТовара")
			И ЗначениеЗаполнено(Стр.УИД_СтрокиТовара) Тогда
			
			НоваяСтрока.УИД_СтрокиПредыдущегоСообщения = Стр.УИД_СтрокиТовара;
			
		ИначеЕсли ПеременнаяСодержитСвойство(Стр, "УИД_СтрокиПервоначальногоСообщения")
			И ЗначениеЗаполнено(Стр.УИД_СтрокиПервоначальногоСообщения) Тогда	
			
			НоваяСтрока.УИД_СтрокиПредыдущегоСообщения = Стр.УИД_СтрокиПервоначальногоСообщения;
		
		Иначе
			
			НоваяСтрока.УИД_СтрокиПредыдущегоСообщения = "";
			
		КонецЕсли;
		
		Если СравнениеСУчетомКонечныйГрузополучательGLN тогда
			НоваяСтрока.КонечныйГрузополучательGLN = Стр.КонечныйГрузополучательGLN;
		КонецЕсли;
		
		Если ЕстьНоменклатура1 Тогда
			НоваяСтрока.Номенклатура = Стр.Номенклатура;
		КонецЕсли;
		
		Если ЕстьХарактеристикаНоменклатуры1 Тогда
			НоваяСтрока.ХарактеристикаНоменклатуры = Стр.ХарактеристикаНоменклатуры;
		КонецЕсли;
		
		Если ЕстьНаименование1 Тогда
			НоваяСтрока.Наименование = Стр.Наименование;
		КонецЕсли;
		
		НоваяСтрока.GTIN				= Стр.GTIN;
		НоваяСтрока.КодТовараПокупателя = Стр.КодТовараПокупателя;
		НоваяСтрока.КодТовараПоставщика = Стр.КодТовараПоставщика;
		НоваяСтрока.КодЕдиницыИзмеренияEDI = Стр.КодЕдиницыИзмеренияEDI;
		
		Для Каждого Поле Из СравниваемыеПоля Цикл
		
			ИмяПоля = Поле.Значение;
			
			Если ИмяПоля = "Количество" Тогда
				
				НоваяСтрока.Количество1 = НоваяСтрока.Количество1 + Стр.Количество;
				
			ИначеЕсли Найти(ИмяПоля, "СтавкаНДС") <> 0 Тогда
				
				// ... заполнить ниже				
				
			ИначеЕсли ПеременнаяСодержитСвойство(НоваяСтрока, ИмяПоля + "1") 
				И ПеременнаяСодержитСвойство(Стр, ИмяПоля) Тогда
				
				НоваяСтрока[ИмяПоля + "1"] = Стр[ИмяПоля];
				
			КонецЕсли;
						
		КонецЦикла;
		
		// ... ставка ндс 1с
		Если ПеременнаяСодержитСвойство(Стр, "СтавкаНДС1С") Тогда
			
			НоваяСтрока.СтавкаНДС1С1 = Стр.СтавкаНДС1С;
			
		ИначеЕсли ПеременнаяСодержитСвойство(Стр, "СтавкаНДС") Тогда
			
			НоваяСтрока.СтавкаНДС1С1 = Стр.СтавкаНДС;
			
		ИначеЕсли ПеременнаяСодержитСвойство(Стр, "СтавкаНДСEDI") Тогда
			
			НоваяСтрока.СтавкаНДС1С1 = КонвертироватьЗначениеEDIв1С(Стр.СтавкаНДСEDI, "СтавкаНДС", "", "");
			
		КонецЕсли;
		
		// ... ставка ндс число
		Если ПеременнаяСодержитСвойство(Стр, "СтавкаНДСEDI", , Истина) Тогда
			
			НоваяСтрока.СтавкаНДС1 = Стр.СтавкаНДСEDI;
			
		ИначеЕсли ПеременнаяСодержитСвойство(НоваяСтрока, "СтавкаНДС1С1", , Истина) Тогда
			
			НоваяСтрока.СтавкаНДС1 = КонвертироватьЗначение1СвEDI(НоваяСтрока.СтавкаНДС1С1, "СтавкаНДС", "СтавкаНДС");
			
		КонецЕсли;
				
	КонецЦикла;
	
	// присоединение второй таблицы
	Для Каждого Стр Из Таблица2 Цикл
		
		Если ПеременнаяСодержитСвойство(Стр, "УИД_СтрокиПредыдущегоСообщения")
			И ЗначениеЗаполнено(Стр.УИД_СтрокиПредыдущегоСообщения) Тогда
			
			НайденнаяСтрока = ТаблицаСравнения.Найти(Стр.УИД_СтрокиПредыдущегоСообщения, "УИД_СтрокиПредыдущегоСообщения");
			
		ИначеЕсли ПеременнаяСодержитСвойство(Стр, "УИД_СтрокиТовара")
			И ЗначениеЗаполнено(Стр.УИД_СтрокиТовара)  Тогда
			
			НайденнаяСтрока = ТаблицаСравнения.Найти(Стр.УИД_СтрокиТовара, "УИД_СтрокиПредыдущегоСообщения");
			
			
		Иначе
			
			НайденнаяСтрока = Неопределено;
			
		КонецЕсли;
		
		Если НайденнаяСтрока = Неопределено Тогда
			
			Если СравнениеСУчетомКонечныйГрузополучательGLN тогда
				// Найдем строку с учетом СравнениеСУчетомКонечныйГрузополучательGLN
				ОтборНоменклатуры = Новый Структура;
				ОтборНоменклатуры.Вставить("КонечныйГрузополучательGLN", Стр.КонечныйГрузополучательGLN);   
				
				Если ЗначениеЗаполнено(Стр.GTIN) Тогда
					ОтборНоменклатуры.Вставить("GTIN", Стр.GTIN);   
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Стр.КодТовараПокупателя) Тогда
					ОтборНоменклатуры.Вставить("КодТовараПокупателя", Стр.КодТовараПокупателя);   
				КонецЕсли;
				
				НайденныеСтроки = ТаблицаСравнения.НайтиСтроки(ОтборНоменклатуры);
				
				Если НайденныеСтроки.Количество() = 1 Тогда 
					НайденнаяСтрока = НайденныеСтроки[0];
				Иначе
					НайденнаяСтрока = Неопределено;
				КонецЕсли;
				
			Иначе
				// типовой поиск
				
				Если ЗначениеЗаполнено(Стр.GTIN) Тогда
					НайденнаяСтрока = ТаблицаСравнения.Найти(Стр.GTIN,"GTIN");
				КонецЕсли;
				
				Если НайденнаяСтрока = Неопределено И ЗначениеЗаполнено(Стр.КодТовараПокупателя) Тогда
					НайденнаяСтрока = ТаблицаСравнения.Найти(Стр.КодТовараПокупателя, "КодТовараПокупателя");
				КонецЕсли;
				
				Если НайденнаяСтрока = Неопределено И ЗначениеЗаполнено(Стр.КодТовараПоставщика) Тогда
					НайденнаяСтрока = ТаблицаСравнения.Найти(Стр.КодТовараПоставщика, "КодТовараПоставщика");
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если НЕ НайденнаяСтрока = Неопределено Тогда
			
			НоваяСтрока = НайденнаяСтрока;
			
		Иначе
			
			НоваяСтрока = ТаблицаСравнения.Добавить();
			НоваяСтрока.GTIN				= Стр.GTIN;
			НоваяСтрока.КодТовараПокупателя = Стр.КодТовараПокупателя;
			НоваяСтрока.КодТовараПоставщика = Стр.КодТовараПоставщика;
			НоваяСтрока.КодЕдиницыИзмеренияEDI = Стр.КодЕдиницыИзмеренияEDI;
			
		КонецЕсли;
		
		Если ЕстьНоменклатура2 Тогда
			Если НЕ ЗначениеЗаполнено(НоваяСтрока.Номенклатура) Тогда
				НоваяСтрока.Номенклатура = Стр.Номенклатура;
			КонецЕсли;
		КонецЕсли;
		
		Если ЕстьНаименование2 Тогда
			Если НЕ ЗначениеЗаполнено(НоваяСтрока.Наименование) Тогда
				НоваяСтрока.Наименование = Стр.Наименование;
			КонецЕсли;
		КонецЕсли;  		
				
		Для Каждого Поле Из СравниваемыеПоля Цикл
			
			ИмяПоля = Поле.Значение;
			
			Если ИмяПоля = "Количество" Тогда
				
				НоваяСтрока.Количество2 = НоваяСтрока.Количество2 + Стр.Количество;
				
			ИначеЕсли Найти(ИмяПоля, "СтавкаНДС") <> 0 Тогда
				
				// ... заполнить ниже
				
			ИначеЕсли ПеременнаяСодержитСвойство(НоваяСтрока, ИмяПоля + "2") 
				И ПеременнаяСодержитСвойство(Стр, ИмяПоля) Тогда
				
				НоваяСтрока[ИмяПоля + "2"] = Стр[ИмяПоля];
				
			КонецЕсли;
			
		КонецЦикла;
		
		// ... ставка ндс 1с
		Если ПеременнаяСодержитСвойство(Стр, "СтавкаНДС1С") Тогда
			
			НоваяСтрока.СтавкаНДС1С2 = Стр.СтавкаНДС1С;
			
		ИначеЕсли ПеременнаяСодержитСвойство(Стр, "СтавкаНДС") Тогда
			
			НоваяСтрока.СтавкаНДС1С2 = Стр.СтавкаНДС;
			
		ИначеЕсли ПеременнаяСодержитСвойство(Стр, "СтавкаНДСEDI") Тогда
			
			НоваяСтрока.СтавкаНДС1С2 =  КонвертироватьЗначениеEDIв1С(Стр.СтавкаНДСEDI, "СтавкаНДС", "", "");
			
		КонецЕсли;
		
		// ... ставка ндс число
		Если ПеременнаяСодержитСвойство(Стр, "СтавкаНДСEDI", , Истина) Тогда
			
			НоваяСтрока.СтавкаНДС2 = Стр.СтавкаНДСEDI;
			
		ИначеЕсли ПеременнаяСодержитСвойство(НоваяСтрока, "СтавкаНДС1С2", , Истина) Тогда
			
			НоваяСтрока.СтавкаНДС2 = КонвертироватьЗначение1СвEDI(НоваяСтрока.СтавкаНДС1С1, "СтавкаНДС", "СтавкаНДС");
			
		КонецЕсли;
		
		Если ТипСообщения2 = "ORDRSP" Тогда
			
			НоваяСтрока.Статус = Стр.Статус; 
			
			Если НоваяСтрока.Статус = "Отклонен" Тогда
				
				НоваяСтрока.Количество2	= 0;
				
			КонецЕсли;
														
		КонецЕсли;
				
	КонецЦикла;
		
	МассивДенежныхПолей = МассивДенежныхПолейДляСравненияСообщений();
		
	ЕстьРасхождения = Ложь;
				
	// собственно сравнение
	Для каждого Стр ИЗ ТаблицаСравнения Цикл
								
		ЗаполнитьПоляВТаблицеСравнения_КонтурEDI(Стр, МассивДенежныхПолей, ПриравниватьДенежныеПоля); 
		
		Стр.ЕстьРасхождения = Ложь;
				
		Для каждого Поле Из СравниваемыеПоля Цикл
			
			ИмяПоля = Поле.Значение;
								
			_Значение1 = Стр[ИмяПоля + "1"];
			_Значение2 = Стр[ИмяПоля + "2"];
			
			ЭтоПолеКоличественногоТипа = (ИмяПоля = "Количество");
			ЭтоСписокЗначений = (ТипЗнч(_Значение1) = Тип("СписокЗначений") ИЛИ ТипЗнч(_Значение2) = Тип("СписокЗначений"));
			
			Если ЭтоПолеКоличественногоТипа Тогда 
				//неопределено считаем как 0 (сеть может прислать экстра строку с 0 в принятом количествве)
				
				Если Не ЗначениеЗаполнено(_Значение1) тогда
					_Значение1=0;
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(_Значение2) тогда
					_Значение2=0;
				КонецЕсли;
				
			КонецЕсли;
			
			ЗначенияРавны = Ложь;
			
			Если ЭтоСписокЗначений Тогда
				
				РезультатСравненияСписков = СравнитьСпискиЗначений(_Значение1,_Значение2);
				Если РезультатСравненияСписков.Успешно = Истина Тогда
					ЗначенияРавны = Не РезультатСравненияСписков.ЕстьРасхождения;
				КонецЕсли;
				
			Иначе
				
				ЗначенияРавны = _Значение1 = _Значение2;
				
			КонецЕсли;
			
			Если Не ЗначенияРавны Тогда
				
				ЭтоПолеДенежногоТипа = (МассивДенежныхПолей.Найти(ИмяПоля) <> Неопределено);
				
				Если ЭтоПолеДенежногоТипа
					И ПропускатьНулевыеЗначения
					И (Не ЗначениеЗаполнено(_Значение1) ИЛИ Не ЗначениеЗаполнено(_Значение2)) Тогда
					
					Продолжить;
					
				Иначе  					
					//если перед нами 2 числовых значения, и их разность не превышает 1 копейку, то считаем, что они совпадают 
					Если ЭтоПолеДенежногоТипа
						И ТипЗнч(_Значение1) = Тип("Число")
						И ТипЗнч(_Значение2) = Тип("Число") Тогда
						
						_Разность = _Значение2 - _Значение1;
						
						Если _Разность < 0 Тогда
							_Разность = -_Разность; 	
						КонецЕсли;
												
						Если _Разность >= 0.01 Тогда
							
							Стр.ЕстьРасхождения = Истина;
							
						КонецЕсли;
						
					Иначе
						
						Стр.ЕстьРасхождения = Истина;
												
					КонецЕсли; 					
					
				КонецЕсли;	
				
			КонецЕсли;
			
			Если НужноОпределениеСтатуса Тогда
				
				Если Не ЗначениеЗаполнено(Стр.Статус) ИЛИ Стр.Статус = "Подтвержден" Тогда
					
					Если Стр.ЕстьРасхождения Тогда
						
						Если ЗначениеЗаполнено(_Значение2) Тогда
							Стр.Статус = "Уточнен"; 
						Иначе
							Стр.Статус = "Отклонен";
						КонецЕсли;
						
					Иначе
						Стр.Статус = "Подтвержден";
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
						
		КонецЦикла;
		
		Если Стр.ЕстьРасхождения Тогда
			ЕстьРасхождения = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	РезультатСравнения.ЕстьРасхождения	= ЕстьРасхождения;
	РезультатСравнения.ТаблицаСравнения = ТаблицаСравнения;
	
	Результат = ОбработкаСобытияПодключаемогоМодуля("ПослеСравненияТаблицыТоваров", СтандартнаяОбработкаEDI,
	Новый Структура("РезультатСравнения,СтруктураТаблицы1,СтруктураТаблицы2,СравниваемыеПоля,РассчитыватьНДС,Сообщение1,Сообщение2",
	РезультатСравнения,СтруктураТаблицы1,СтруктураТаблицы2,СравниваемыеПоля,РассчитыватьНДС,Сообщение1,Сообщение2));
			
    Если Не СтандартнаяОбработкаEDI Тогда
		Возврат Результат;
	КонецЕсли;
	
	Возврат РезультатСравнения;
	
КонецФункции

Процедура ЗаполнитьПоляВТаблицеСравнения_КонтурEDI(Стр, МассивДенежныхПолей, ПриравниватьДенежныеПоля = Истина) Экспорт
	
	Если Стр.Количество1 > 0 Тогда
		
		ЗаполнитьСтавкуНДС_В_ТаблицеСравнения(Стр, "1", "2");
		ЗаполнитьЦенаБезНДС_В_ТаблицеСравнения(Стр, "1");	
		ЗаполнитьЦенаСНДС_В_ТаблицеСравнения(Стр, "1");
		ЗаполнитьСуммаСНДС_В_ТаблицеСравнения(Стр, "1");
		ЗаполнитьСуммаБезНДС_В_ТаблицеСравнения(Стр, "1");
			
	КонецЕсли;
	
	Если Стр.Количество2 > 0 Тогда
		
		ЗаполнитьСтавкуНДС_В_ТаблицеСравнения(Стр, "2", "1");
		ЗаполнитьЦенаБезНДС_В_ТаблицеСравнения(Стр, "2");
	 	ЗаполнитьЦенаСНДС_В_ТаблицеСравнения(Стр, "2");
	 	ЗаполнитьСуммаСНДС_В_ТаблицеСравнения(Стр, "2");
	 	ЗаполнитьСуммаБезНДС_В_ТаблицеСравнения(Стр, "2");

		Если ПриравниватьДенежныеПоля Тогда
			ПриравнятьПоляВСтрокаТаблицыРасхождений_КонтурEDI(МассивДенежныхПолей, Стр, "1", "2");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ТаблицаСравнение_КонтурEDI(СравнениеСУчетомКонечныйГрузополучательGLN, СравниваемыеПоля) Экспорт
		
	ТаблицаСравнения = Новый ТаблицаЗначений;	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаСравнения,
	"ЕстьРасхождения
	|Номенклатура
	|ХарактеристикаНоменклатуры
	|Наименование
	|УИД_СтрокиПредыдущегоСообщения
	|GTIN
	|КодТовараПокупателя
	|КодТовараПоставщика
	|КодЕдиницыИзмеренияEDI");   
	
	Если СравнениеСУчетомКонечныйГрузополучательGLN тогда
		ДобавитьКолонкиВТаблицуЗначений(ТаблицаСравнения,
		"КонечныйГрузополучательGLN");
	КонецЕсли; 
	
	// Добавить поля
	// ... поля по-умолчанию
	ТипСтавкаНДС = ПолучитьТип_КонтурEDI("СтавкаНДС");  	
	ТипЧислоКоличество = ПолучитьТип_КонтурEDI("ЧислоКоличество");
	
	ПоляПоУмолчанию = Новый Соответствие;
	
	ПоляПоУмолчанию.Вставить("СтавкаНДС1С", ТипСтавкаНДС);
	ПоляПоУмолчанию.Вставить("СтавкаНДС", ТипЧислоКоличество);
	
	ПоляПоУмолчанию.Вставить("БазоваяЦена", ТипЧислоКоличество);    
	ПоляПоУмолчанию.Вставить("ЦенаБезНДС", ТипЧислоКоличество);
	ПоляПоУмолчанию.Вставить("ЦенаСНДС", ТипЧислоКоличество);
	
	ПоляПоУмолчанию.Вставить("СуммаБезНДС", ТипЧислоКоличество);
	ПоляПоУмолчанию.Вставить("СуммаСНДС", ТипЧислоКоличество);
	
	ПоляПоУмолчанию.Вставить("Количество", ТипЧислоКоличество);
	
	Для Каждого ЭлементПоле Из ПоляПоУмолчанию Цикл
		
		ИмяПоля = ЭлементПоле.Ключ;
		ТипПоля = ЭлементПоле.Значение;
		
		ДобавляемыеПоля = ИмяПоля + "1" + "," + ИмяПоля + "2";  	
		ДобавитьКолонкиВТаблицуЗначений(ТаблицаСравнения, ДобавляемыеПоля, ТипПоля);
		
	КонецЦикла;
	
	// ... сравниваемые поля, в случае если нет в полях по-умолчанию		
	Для Каждого Стр Из СравниваемыеПоля Цикл
		
		ИмяПоля = Стр.Значение;
				
		Если ПоляПоУмолчанию[ИмяПоля] = Неопределено Тогда
			
			ДобавляемыеПоля = ИмяПоля + "1" + "," + ИмяПоля + "2";
			ДобавитьКолонкиВТаблицуЗначений(ТаблицаСравнения, ДобавляемыеПоля);
			
		КонецЕсли;
					
	КонецЦикла;
	
	Возврат ТаблицаСравнения;

КонецФункции

Процедура ЗаполнитьСуммаСНДС_В_ТаблицеСравнения(Стр, Суфикс)
	
	СуммаСНДС_ИмяПоля = "СуммаСНДС" + Суфикс;
	СуммаБезНДС_ИмяПоля = "СуммаБезНДС" + Суфикс;   
	
	ЦенаБезНДС_ИмяПоля = "ЦенаБезНДС" + Суфикс;
	ЦенаСНДС_ИмяПоля = "ЦенаСНДС" + Суфикс; 	
	
	Количество_ИмяПоля = "Количество" + Суфикс;
	
	СтавкаНДС_ИмяПоля = "СтавкаНДС" + Суфикс;
	
	Если Не ЗначениеЗаполнено(Стр[СуммаСНДС_ИмяПоля]) Тогда
		
		Если ЗначениеЗаполнено(Стр[ЦенаСНДС_ИмяПоля]) Тогда
			
			Стр[СуммаСНДС_ИмяПоля] = Окр(Стр[ЦенаСНДС_ИмяПоля]*Стр[Количество_ИмяПоля] , 2, 1);
			
		ИначеЕсли ЗначениеЗаполнено(Стр[СуммаБезНДС_ИмяПоля]) 
			И ЗначениеЗаполнено(Стр[СтавкаНДС_ИмяПоля]) Тогда
			
			Стр[СуммаСНДС_ИмяПоля]= Окр((Стр[СуммаБезНДС_ИмяПоля] * (100 + Стр[СтавкаНДС_ИмяПоля])) / 100,2,1);
			
		ИначеЕсли ЗначениеЗаполнено(Стр[ЦенаБезНДС_ИмяПоля]) 
			И ЗначениеЗаполнено(Стр[СтавкаНДС_ИмяПоля]) Тогда
			
			Стр[СуммаСНДС_ИмяПоля]= Окр(Стр[Количество_ИмяПоля]*(Стр[ЦенаБезНДС_ИмяПоля] * (100 + Стр[СтавкаНДС_ИмяПоля])) / 100, 2, 1);
		
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

