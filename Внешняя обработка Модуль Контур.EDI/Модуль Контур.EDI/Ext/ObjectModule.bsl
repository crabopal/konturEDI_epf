Функция НайтиСообщениеДокумента(ДокументСсылка,ТипСообщения,Направление = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(ДокументСсылка) Тогда
		
		Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
		Запрос.УстановитьПараметр("Объект", ПреобразоватьЗначениеДляВнешнегоХранилища(ДокументСсылка));
		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ 
		|	КонтурEDI_Сообщения.Ссылка
		|ИЗ Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
		|ГДЕ 
		|	КонтурEDI_Сообщения.Документ = &Объект 
		|	И КонтурEDI_Сообщения.ТипСообщения = """+ТипСообщения+"""";
		
		Если ЗначениеЗаполнено(Направление) Тогда
			Запрос.Текст = Запрос.Текст + "
			|	И КонтурEDI_Сообщения.Направление = """+Направление+"""";
		КонецЕсли;
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			
			Сообщение = Неопределено;
			
		Иначе
			
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			
			Сообщение = Выборка.Ссылка;
			
		КонецЕсли;
		
		Если ВнешнееХранилище И Сообщение<>Неопределено Тогда
			Сообщение = СоединениеСХранилищем.ЗначениеВСтрокуВнутр(Сообщение);
		КонецЕсли;
		
	Иначе
		
		Сообщение = Неопределено;
		
	КонецЕсли;
	
	Возврат Сообщение;
	
КонецФункции

Функция ПолучитьСписокФоновыхСообщенийОжидающихОтправки() Экспорт
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Документ");
	ТЗ.Колонки.Добавить("Примечание");
	
	ТабСтатусных = ПолучитьСообщенияПоКоторымНеОтправленыУведомления();
	Для каждого Стр Из ТабСтатусных Цикл
		НоваяСтрока = ТЗ.Добавить();
		Если Стр.ТипСообщения = "ORDERS" Тогда
			НоваяСтрока.Документ = Стр.Документ;
			НоваяСтрока.Примечание = "Статусное сообщение о прочтении заказа";
		ИначеЕсли Стр.ТипСообщения = "DESADV" Тогда
			НоваяСтрока.Документ = Стр.Документ;
			НоваяСтрока.Примечание = "Статусное сообщение о результате валидации уведомления об отгрузке";
		КонецЕсли;
	КонецЦикла;
	ТабАлко = ПолучитьДокументыПоКоторымНужноОтправитьALCRPT();
	Для каждого Стр Из ТабАлко Цикл
		НоваяСтрока = ТЗ.Добавить();
		НоваяСтрока.Документ = Стр.Документ;
		НоваяСтрока.Примечание = "ALCRPT - сведения о продаже алкогольной продукции";
	КонецЦикла;
	
	Возврат ТЗ;
	
КонецФункции

Функция МожноОтправлятьУведомлениеОбОтгрузке(Накладная,ВыводитьПредупреждение = Истина) Экспорт

	Заказ = Неопределено;
	
	ТекстОшибки = "Необходимо сначала отправить подтверждение заказа!";
	
	Если ЗначениеЗаполнено(Накладная) Тогда
		
		Заказ = НайтиСвязанныйДокументПоТипуСообщения(Накладная,"ORDRSP");
		
		Если ЗначениеЗаполнено(Заказ) Тогда
			
			СтатусДокумента = ПолучитьСтатусДокумента(Заказ,"Заказ");
			
			Если СтатусДокумента = "Отклонен" Тогда
				
				ТекстОшибки = "Вы отменили заказ по этой накладной!";
				
			ИначеЕсли СтатусДокумента = Неопределено Тогда
				
				Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
				Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	КонтурEDI_ДополнительныеРеквизиты.Значение КАК НужноОтправлятьОтветНаЗаказ 		
				|ИЗ
				|	РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеРеквизиты
				|ГДЕ
				|	КонтурEDI_ДополнительныеРеквизиты.Объект В		
				|		(ВЫБРАТЬ 
				|			КонтурEDI_Сообщения.Партнер КАК Партнер
				|		ИЗ 
				|			Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
				|		ГДЕ 
				|			КонтурEDI_Сообщения.Документ = &Объект 
				|			И КонтурEDI_Сообщения.ТипСообщения = ""ORDERS"")
				|	И КонтурEDI_ДополнительныеРеквизиты.Свойство = ""ORDRSP_Исходящее"""; 	
				Запрос.УстановитьПараметр("Объект", ПреобразоватьЗначениеДляВнешнегоХранилища(Заказ));
				РезультатЗапроса = Запрос.Выполнить();
				Если НЕ РезультатЗапроса.Пустой() Тогда
					Выборка = РезультатЗапроса.Выбрать();
					Выборка.Следующий();
					Если Выборка.НужноОтправлятьОтветНаЗаказ <> Истина Тогда
						Возврат Истина;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
				
			//проверим, нет ли у данного заказа дублей - повторных заказов с такими же номерами, но разными данными
			
				Запрос=Новый Запрос(
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	КонтурEDI_Сообщения.Ссылка КАК Ссылка,
				|	КонтурEDI_Сообщения.НомерДокумента,
				|	КонтурEDI_Сообщения.ДатаДокумента,
				|	КонтурEDI_Сообщения.ТипСообщения,
				|	КонтурEDI_Сообщения.Партнер,
				|	КонтурEDI_Сообщения.ID,
				|	КонтурEDI_Сообщения.ТочкаДоставки
				|ИЗ
				|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
				|ГДЕ
				|	КонтурEDI_Сообщения.Документ = &Объект
				|	И КонтурEDI_Сообщения.ТипСообщения = ""ORDERS"""
				);
				
				Запрос.УстановитьПараметр("Объект",Заказ);
				Выб=Запрос.Выполнить().Выбрать();
				Если Выб.Следующий() Тогда
					Дубли=ПолучитьДублирующиеСообщения(Выб.Ссылка);
					Если Дубли<>Неопределено 
						И Дубли.Количество()>1 
						Тогда
						Если Дубли.Найти(Ложь,"Загружен")<>Неопределено Тогда
							ВывестиПредупреждение_КонтурEDI("По заказу "+Выб.НомерДокумента+" зарегистрировано несколько незагруженных версий. 
							|Перед отправкой уведомления об отгрузке сначала актуализируйте заказ.");
							Возврат Ложь;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;	
				
			//КонецЕсли;

			Запрос = Новый Запрос();
			
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ 
			|	КонтурEDI_Сообщения.Статус КАК Статус
			|ИЗ Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
			|ГДЕ 
			|	КонтурEDI_Сообщения.Документ = &Объект 
			|	И КонтурEDI_Сообщения.ТипСообщения = ""ORDRSP""";
			
			Запрос.УстановитьПараметр("Объект",Заказ);
				
			РезультатЗапроса = Запрос.Выполнить();
			
			Если НЕ РезультатЗапроса.Пустой() Тогда
				
				Выборка = РезультатЗапроса.Выбрать();
				Выборка.Следующий();
				
				Если Выборка.Статус = "Доставлен" ИЛИ Выборка.Статус = "Доставлен с уточнением" ИЛИ Выборка.Статус = "Пропущен" ИЛИ Выборка.Статус = "Исходящее прошло проверку" Тогда
					Возврат Истина;
				КонецЕсли;
				
			КонецЕсли;
			
			//заглушка для случаев, когда ORDRSP по ТС не отправляем 
			СтрокаКэша = ТаблицаКэшПартнеровКонтрагентов.Найти(Заказ.Контрагент,"Контрагент");
			Если СтрокаКэша<>Неопределено
				И Не СтрокаКэша.ORDRSP Тогда
				Возврат Истина;
			КонецЕсли;	
			
		КонецЕсли;
	КонецЕсли;
	
	Если ВыводитьПредупреждение Тогда
		
		ВывестиПредупреждение_КонтурEDI(ТекстОшибки);
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Процедура ПропуститьСообщение(ДокументСсылка,ТипСообщения) Экспорт

	Если ВнешнееХранилище Тогда
		ПропущенноеСообщение = Справочники.КонтурEDI_Сообщения.СоздатьЭлемент();
	Иначе
		ПропущенноеСообщение = СоединениеСХранилищем.Справочники.КонтурEDI_Сообщения.СоздатьЭлемент();
	КонецЕсли;	
	
	ПропущенноеСообщение.Направление = "Исходящее";
	ПропущенноеСообщение.Документ = ПреобразоватьЗначениеДляВнешнегоХранилища(ДокументСсылка);
	ПропущенноеСообщение.ТипСообщения = ТипСообщения;
	ПропущенноеСообщение.Статус = "Пропущен";

	СохранитьОбъектСообщения(ПропущенноеСообщение);
		
КонецПроцедуры

Процедура ПрекратитьОбработкуВходящегоСообщения(СообщениеСсылка) Экспорт
	
	Статус = "ВходящийПропущен";
	
	НачатьТранзакцию();
	Попытка
		
		УстановитьСтатусСообщения(СообщениеСсылка, , , Статус);
		
		_Сообщение = ПолучитьОбъектСообщения(СообщениеСсылка);
		
		_ДокументСсылка = Неопределено;
		Если ЗначениеЗаполнено(_Сообщение.Документ) Тогда
			_ДокументСсылка = ?(ВнешнееХранилище,ЗначениеИзСтрокиВнутр(_Сообщение.Документ),_Сообщение.Документ);
			Если ЗначениеЗаполнено(_ДокументСсылка) Тогда
				ДокОбъект = _ДокументСсылка.ПолучитьОбъект();
				ДокОбъект.УстановитьПометкуУдаления(Истина);
			КонецЕсли;
		КонецЕсли;	
		
		Если СтрСодержит_КонтурEDI("ORDERS,PORDERS", _Сообщение.ТипСообщения)
			И _ДокументСсылка <> Неопределено Тогда
			
			ТабВиртуальныхСообщений = ПолучитьВиртуальныеСвязанныеORDERS(_Сообщение.Документ);

			Для Каждого Стр Из ТабВиртуальныхСообщений Цикл
				Если ЗначениеЗаполнено(Стр.ORDERS)
					И Стр.ORDERS <> СообщениеСсылка
					Тогда
					//УстановитьСтатусСообщения_БМИ(Стр.ORDERS, , "ORDERS", Статус);
					УстановитьСтатусСообщения(Стр.ORDERS, , "ORDERS", Статус);
					
					//ОбработкаСобытияПодключаемогоМодуля("ПриУстановкеСтатусаСообщения",,Новый Структура("СообщениеСсылка,ДокументСсылка,ТипСообщения,Статус",Стр.ORDERS, , "ORDERS", Статус));
					
					Если ЗначениеЗаполнено(Стр.Документ) Тогда

						_Документ = ?(ВнешнееХранилище,ЗначениеИзСтрокиВнутр(Стр.Документ),Стр.Документ);
						Если ЗначениеЗаполнено(_Документ) Тогда
							ДокОбъект = _Документ.ПолучитьОбъект();
							ДокОбъект.УстановитьПометкуУдаления(Истина);
						КонецЕсли;
					КонецЕсли;	
					
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	    Если ТранзакцияАктивна() Тогда
	        ЗафиксироватьТранзакцию();
		КонецЕсли;
		
	Исключение
		
	    Если ТранзакцияАктивна() Тогда
	        ОтменитьТранзакцию();
		КонецЕсли;
		
		ТекстОшибки = ОписаниеОшибки();

		ПодстрокаПоиска = "Ошибка при вызове метода контекста (УстановитьПометкуУдаления): ";
		НайденнаяПозиция = КонтурСтандарт_СтрНайти_(ТекстОшибки, ПодстрокаПоиска, "СКонца", СтрДлина(ТекстОшибки), 1);
		Если НайденнаяПозиция > 0 И НайденнаяПозиция < СтрДлина(ТекстОшибки) Тогда
			ТекстОшибки = Сред(ТекстОшибки, НайденнаяПозиция + СтрДлина(ПодстрокаПоиска));
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "Не удалось записать", "Не удалось пометить на удаление");
		КонецЕсли;
		
		ТекстОшибки = "Не удалось прекратить обработку входящего сообщения - " + ТекстОшибки;
		
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки); 
		ВызватьИсключение ТекстОшибки;
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ПрекратитьОбработкуНулевойСФ(Сообщение) Экспорт
	
	Если Сообщение.Товары = Неопределено Тогда
		МетаданныеСообщения = ПолучитьМетаданныеСообщения(Сообщение.ТипСообщения,Сообщение.Направление);
		Сообщение.Товары = ПолучитьСтруктуруТабличнойЧасти(МетаданныеСообщения, "Товары");
	КонецЕсли;
	
	СохранитьСообщение(Сообщение);
	УстановитьСтатусСообщения(Сообщение.СообщениеСсылка, , , "ИсходящийОтменен");
	
	СообщениеОбъект = ПолучитьОбъектСообщения(Сообщение.СообщениеСсылка);
	СообщениеОбъект.Архив = Истина;
	ОбработкаСобытияПодключаемогоМодуля("ПередЗаписьюОбъектаСообщения",,Новый Структура("СообщениеОбъект",СообщениеОбъект));
	СообщениеОбъект.Записать();

КонецПроцедуры

Функция МожноПрекратитьОбработкуВходящегоСообщения(Сообщение) Экспорт
	
	Если Сообщение = Неопределено Тогда
		Возврат Ложь;
	ИначеЕсли Сообщение.Свойство("СтатусСсылки") И Сообщение.СтатусСсылки = "Пропущен" Тогда
		Возврат Ложь;
	ИначеЕсли СтрСодержит_КонтурEDI("ORDERS,PORDERS,RECADV,RETANN,RETDES", Сообщение.ТипСообщения) 
		И Сообщение.Направление = "Входящее" Тогда
		
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция МожноПрекратитьОбработкуИсходящегоСообщения(Сообщение) Экспорт
	
	Если Сообщение = Неопределено Тогда
		Возврат Ложь;
	ИначеЕсли Сообщение.Свойство("Архив") И Сообщение.Архив = Истина Тогда
		Возврат Ложь;
	ИначеЕсли Сообщение.Направление = "Исходящее" Тогда
		
		МассивСтатусовПредусматривающихПрекращениеОбработки = Новый Массив;
		МассивСтатусовПредусматривающихПрекращениеОбработки.Добавить("Ожидает исправления ошибок");
		МассивСтатусовПредусматривающихПрекращениеОбработки.Добавить("Доставлен с уточнением");
		МассивСтатусовПредусматривающихПрекращениеОбработки.Добавить("Запрос аннулирования");
		МассивСтатусовПредусматривающихПрекращениеОбработки.Добавить("Запрос уточнения");
		МассивСтатусовПредусматривающихПрекращениеОбработки.Добавить("Аннулирован");
		МассивСтатусовПредусматривающихПрекращениеОбработки.Добавить("Отказано в подписи получателем");
		МассивСтатусовПредусматривающихПрекращениеОбработки.Добавить("Подписан и отправлен");
		МассивСтатусовПредусматривающихПрекращениеОбработки.Добавить("Подписан с разногласиями");
		
		
		Если Сообщение.Свойство("СообщениеСсылка") 
			И ЗначениеЗаполнено(Сообщение.СообщениеСсылка) Тогда
			ТекСсылкаНаСообщение = Сообщение.СообщениеСсылка;
		ИначеЕсли Сообщение.Свойство("ПереотправляемоеСообщениеСсылка") 
			И ЗначениеЗаполнено(Сообщение.ПереотправляемоеСообщениеСсылка) Тогда 
			ТекСсылкаНаСообщение = Сообщение.ПереотправляемоеСообщениеСсылка;
		КонецЕсли;
		
		ТекущийСтатусСообщения = ПолучитьСтатусСообщения(ТекСсылкаНаСообщение);
		
		Если МассивСтатусовПредусматривающихПрекращениеОбработки.Найти(ТекущийСтатусСообщения) <> Неопределено Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьСчетФактуруНакладной(Накладная) Экспорт
	//В действительности нам надо в большинстве случаев получать документы, соответствующие разным типам сообщений.
	//Конкретно здесь - из документа для DESADV перейти в документ для INVOIC.
	
	Возврат НайтиСвязанныйДокументПоТипуСообщения(Накладная,"INVOIC");
	
КонецФункции

Функция ПолучитьНакладнуюСчетаФактуры(СчетФактура) Экспорт
	
	Возврат НайтиСвязанныйДокументПоТипуСообщения(СчетФактура,"DESADV");
	
КонецФункции


// По номеру сообщения выдается список всех сообщений с таким же номером в пределах периода, указанного в настройках парнтера(плюс и минус), по умолчанию - 7 дней.
// В случае значения параметра "ВключатьВиртуальныеСообщения = Ложь":
// 	Из выборки исключаются "виртуальные" сообщения  
// 	Т.е. если вдруг было принято несколько версий сообщения, и по каждой из них создано несколько виртуальных для привязки к нескольким документам,
//	то будет выбрано по одной строке для каждого ID
Функция ПолучитьДублирующиеСообщения(СообщениеСсылка, ВключатьВиртуальныеСообщения = Ложь) Экспорт
		
	ПараметрыПМ = Новый Структура("Сообщение, ВключатьВиртуальныеСообщения", СообщениеСсылка, ВключатьВиртуальныеСообщения);
	
	РезультатПМ = ОбработкаСобытияПодключаемогоМодуля("ПолучитьДублирующиеСообщения", , ПараметрыПМ);

	Если НЕ РезультатПМ = Неопределено И ТипЗнч(РезультатПМ) = Тип("ТаблицаЗначений") Тогда
		Возврат РезультатПМ;
	КонецЕсли;
			
	// дубли достаточно нечастое явление, проверим по-быстрому есть ли намек на них
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	КонтурEDI_Сообщения.Ссылка
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|ГДЕ
	|	НЕ КонтурEDI_Сообщения.Ссылка = &Ссылка
	|	И (КонтурEDI_Сообщения.ТипСообщения = ""ORDERS""
	|			ИЛИ КонтурEDI_Сообщения.ТипСообщения = ""#ORDERS"")
	|	И КонтурEDI_Сообщения.Направление = ""Входящее""
	|	И КонтурEDI_Сообщения.НомерДокумента = &НомерДокументаСообщения
	|	И КонтурEDI_Сообщения.ДатаДокумента МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаДокументаСообщения, ДЕНЬ, -&ПериодПоискаДублейВходящегоСообщения) И ДОБАВИТЬКДАТЕ(&ДатаДокументаСообщения, ДЕНЬ, &ПериодПоискаДублейВходящегоСообщения)";
	
	РеквизитыСообщения = Новый Структура("НомерДокумента,ДатаДокумента");
	ЗаполнитьЗначенияСвойств(РеквизитыСообщения, СообщениеСсылка);
	
	Запрос.УстановитьПараметр("Ссылка", СообщениеСсылка);
	Запрос.УстановитьПараметр("НомерДокументаСообщения", РеквизитыСообщения.НомерДокумента);
	Запрос.УстановитьПараметр("ДатаДокументаСообщения", РеквизитыСообщения.ДатаДокумента);
	
	ПериодПоискаДублейВходящегоСообщения = 
	ПолучитьЗначениеСвойстваОбъектаEDI(СообщениеСсылка.Партнер, "ПериодПоискаДублейВходящегоСообщения");
	
	Если Не ЗначениеЗаполнено(ПериодПоискаДублейВходящегоСообщения) Тогда
		ПериодПоискаДублейВходящегоСообщения = 7;	
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ПериодПоискаДублейВходящегоСообщения", ПериодПоискаДублейВходящегоСообщения);		
	
	Если Запрос.Выполнить().Пустой() Тогда
		
		ТаблицаДублей = Новый ТаблицаЗначений;
		ТаблицаДублей.Колонки.Добавить("ID");
		
		Возврат Новый ТаблицаЗначений;
		
	КонецЕсли;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаСообщений.Ссылка КАК Ссылка,
	|	ТаблицаСообщений.Документ КАК Документ1С,
	|	ТаблицаСообщений.ДатаДокумента КАК ДатаДокумента,
	|	ТаблицаСообщений.ТипСообщения КАК ТипСообщения,
	|	ТаблицаСообщений.ID КАК ID,
	|	ТаблицаСообщений.ДатаЗагрузки КАК ДатаЗагрузки,
	|	ТаблицаСообщений.ДатаЗаказа КАК ДатаЗаказа,
	|	ВЫРАЗИТЬ("""" КАК СТРОКА(36)) КАК УникальныйИдентификатор,
	|	ТаблицаСообщений.Статус КАК Статус,
	|	ВЫБОР
	|		КОГДА ТаблицаСообщений.Статус = ""ВходящийОжидаетУстановкиСоответствий""
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Загружен
	|ПОМЕСТИТЬ табВозможныеДубли
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения КАК ТаблицаСообщений
	|ГДЕ
	|	ТаблицаСообщений.ТипСообщения В(&ТипыСообщения)
	|	И ТаблицаСообщений.Направление = ""Входящее""
	|	И ТаблицаСообщений.НомерДокумента = &НомерДокумента
	|	И ТаблицаСообщений.НомерСерииЗаказов = &НомерСерииЗаказов
	|	И ТаблицаСообщений.Партнер = &Партнер
	|	И ТаблицаСообщений.ТочкаДоставки = &ТочкаДоставки
	|	И ТаблицаСообщений.ДатаДокумента МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаДокумента, ДЕНЬ, -&ПериодПоискаДублейВходящегоСообщения) И ДОБАВИТЬКДАТЕ(&ДатаДокумента, ДЕНЬ, &ПериодПоискаДублейВходящегоСообщения)
	|	И (ТаблицаСообщений.ID <> &ID
	|			ИЛИ ТаблицаСообщений.Ссылка = &Ссылка)";
	
	ТекстЗапроса = ТекстЗапроса + 
	"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
	Если ВключатьВиртуальныеСообщения Тогда
		
		ТекстЗапроса = ТекстЗапроса + 
		"ВЫБРАТЬ
		|	табВозможныеДубли.Ссылка,
		|	табВозможныеДубли.Документ1С,
		|	табВозможныеДубли.ДатаДокумента,
		|	табВозможныеДубли.ТипСообщения,
		|	табВозможныеДубли.ID КАК ID,
		|	табВозможныеДубли.ДатаЗагрузки,
		|	табВозможныеДубли.ДатаЗаказа,
		|	табВозможныеДубли.УникальныйИдентификатор,
		|	табВозможныеДубли.Статус,
		|	табВозможныеДубли.Загружен
		|ИЗ
		|	табВозможныеДубли КАК табВозможныеДубли
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_Сообщения.ДополнительныеРеквизиты КАК КонтурEDI_СообщенияДополнительныеРеквизиты
		|		ПО табВозможныеДубли.Ссылка = КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка
		|			И (КонтурEDI_СообщенияДополнительныеРеквизиты.ИмяРеквизита = ""ЭтоПредварительныйЗаказ"")
		|ГДЕ
		|	ЕСТЬNULL(КонтурEDI_СообщенияДополнительныеРеквизиты.Значение, ЛОЖЬ) = &ЭтоПредварительныйЗаказ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ID";
		
	Иначе
		
		ТекстЗапроса = ТекстЗапроса + 
		"ВЫБРАТЬ
		|	МАКСИМУМ(табВозможныеДубли.Ссылка) КАК Ссылка,
		|	МАКСИМУМ(табВозможныеДубли.Документ1С) КАК Документ1С,
		|	МАКСИМУМ(табВозможныеДубли.ДатаДокумента) КАК ДатаДокумента,
		|	МАКСИМУМ(табВозможныеДубли.ТипСообщения) КАК ТипСообщения,
		|	табВозможныеДубли.ID КАК ID,
		|	МАКСИМУМ(табВозможныеДубли.ДатаЗагрузки) КАК ДатаЗагрузки,
		|	МАКСИМУМ(табВозможныеДубли.ДатаЗаказа) КАК ДатаЗаказа,
		|	МАКСИМУМ(табВозможныеДубли.УникальныйИдентификатор) КАК УникальныйИдентификатор,
		|	МАКСИМУМ(табВозможныеДубли.Статус) КАК Статус,
		|	МАКСИМУМ(табВозможныеДубли.Загружен) КАК Загружен
		|ИЗ
		|	табВозможныеДубли КАК табВозможныеДубли
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_Сообщения.ДополнительныеРеквизиты КАК КонтурEDI_СообщенияДополнительныеРеквизиты
		|		ПО табВозможныеДубли.Ссылка = КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка
		|			И (КонтурEDI_СообщенияДополнительныеРеквизиты.ИмяРеквизита = ""ЭтоПредварительныйЗаказ"")
		|ГДЕ
		|	ЕСТЬNULL(КонтурEDI_СообщенияДополнительныеРеквизиты.Значение, ЛОЖЬ) = &ЭтоПредварительныйЗаказ
		|
		|СГРУППИРОВАТЬ ПО
		|	табВозможныеДубли.ID
		|
		|УПОРЯДОЧИТЬ ПО
		|	ID";
		
	КонецЕсли;
		
	Если ДлительнаяОперация = Истина Тогда
		
		Запрос = КэшДлительнойОперации.Получить("КэшЗапросаДублей");
		
		Если Запрос = Неопределено Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = ТекстЗапроса;
			КэшДлительнойОперации.Вставить("КэшЗапросаДублей", Запрос);
		КонецЕсли;
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		
	КонецЕсли;
	
	ТипыСообщений = Новый Массив;
	ТипыСообщений.Добавить("ORDERS");
	ТипыСообщений.Добавить("#ORDERS");
	
	Запрос.Параметры.Вставить("ТипыСообщения", ТипыСообщений);
	Запрос.Параметры.Вставить("ID");
	Запрос.Параметры.Вставить("Ссылка");
	Запрос.Параметры.Вставить("Партнер");
	Запрос.Параметры.Вставить("ТочкаДоставки");
	Запрос.Параметры.Вставить("НомерДокумента");
	Запрос.Параметры.Вставить("НомерСерииЗаказов");
	Запрос.Параметры.Вставить("ДатаДокумента");
	Запрос.Параметры.Вставить("ЭтоПредварительныйЗаказ");
	Запрос.УстановитьПараметр("ПериодПоискаДублейВходящегоСообщения", ПериодПоискаДублейВходящегоСообщения);

	ЗаполнитьЗначенияСвойств(Запрос.Параметры, СообщениеСсылка);
	
	ЗапросПолей = Новый Запрос;
	ЗапросПолей.УстановитьПараметр("Ссылка", СообщениеСсылка);
	ЗапросПолей.Текст =
	"ВЫБРАТЬ
	|	КонтурEDI_СообщенияДополнительныеРеквизиты.Значение
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения.ДополнительныеРеквизиты КАК КонтурEDI_СообщенияДополнительныеРеквизиты
	|ГДЕ
	|	КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка = &Ссылка
	|	И КонтурEDI_СообщенияДополнительныеРеквизиты.ИмяРеквизита = ""ЭтоПредварительныйЗаказ""";
	
	РезультатЗапросаРеквизита = ЗапросПолей.Выполнить();
	
	Если НЕ РезультатЗапросаРеквизита.Пустой() Тогда 	
		
		Выборка = РезультатЗапросаРеквизита.Выбрать();
		Выборка.Следующий();
		Запрос.Параметры.ЭтоПредварительныйЗаказ = Выборка.Значение; 
		
	Иначе
		
		Запрос.Параметры.ЭтоПредварительныйЗаказ = Ложь;
		
	КонецЕсли;	
  		
	ТаблицаДублей = Запрос.Выполнить().Выгрузить();
	ТаблицаДублей.Сортировать("Ссылка");
	ТаблицаДублей.Колонки.Добавить("Представление");	
	
	Для НомерСтроки = 1 По ТаблицаДублей.Количество() Цикл
		
		СтрокаДубля = ТаблицаДублей[НомерСтроки - 1];
		СтрокаДубля.УникальныйИдентификатор = СтрокаДубля.Ссылка.УникальныйИдентификатор();
		ПредставлениеВерсии = "Версия " + НомерСтроки + " (" + Формат(СтрокаДубля.ДатаЗаказа,"ДФ=дд.ММ.гггг") + ")";
		Если Лев(СтрокаДубля.ТипСообщения,1) = "#" Тогда
			ПредставлениеВерсии = ПредставлениеВерсии + " (архив)";
		КонецЕсли;
		СтрокаДубля.Представление = ПредставлениеВерсии;
		
	КонецЦикла;	
		
	Возврат ТаблицаДублей;
	
КонецФункции	

//для случаев, когда ORDERS загружаются в документ РеализацияТоваровУслуг, но при этом поставщик разбивает одну накладную на несколько
//возвращает таблицу с колонками: ORDERS и ORDRSP - ссылка на одноименные сообщения, Документ - ссылка на реализацию
//используется только для своих объектов
Функция ПолучитьВиртуальныеСвязанныеORDERS(ДокументСсылка) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		//подстрахуемся, это важно. Вернем пустую ТЗ
		Таб = Новый ТаблицаЗначений;
		ДобавитьКолонкиВТаблицуЗначений(Таб,"ORDERS,ORDERS_ТипСообщения,ORDERS_Статус,Документ,ORDRSP,ORDRSP_Статус,ЭтоТекущийДокумент");
		
		Возврат Таб;
	КонецЕсли;
	 
	СтандартнаяОбработкаEDI = Истина;
	РезультатПМ = ОбработкаСобытияПодключаемогоМодуля("ПолучитьВиртуальныеСвязанныеORDERS",
														СтандартнаяОбработкаEDI,
														Новый Структура("ДокументСсылка", ДокументСсылка));

	Если НЕ СтандартнаяОбработкаEDI 
		И НЕ РезультатПМ = Неопределено
		И ТипЗнч(РезультатПМ) = Тип("ТаблицаЗначений") Тогда
		Возврат РезультатПМ;
	КонецЕсли;
		
	Запрос = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
	Запрос.УстановитьПараметр("Документ",ПреобразоватьЗначениеДляВнешнегоХранилища(ДокументСсылка));
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	КонтурEDI_Сообщения.Ссылка,
	|	КонтурEDI_Сообщения.ID
	|ПОМЕСТИТЬ ВТ_ИД_ORDERS
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|ГДЕ
	|	КонтурEDI_Сообщения.ТипСообщения = ""ORDERS""
	|	И КонтурEDI_Сообщения.Документ = &Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_Сообщения_ORDERS.Ссылка КАК ORDERS,
	|	КонтурEDI_Сообщения_ORDERS.ТипСообщения КАК ORDERS_ТипСообщения,
	|	КонтурEDI_Сообщения_ORDERS.Статус КАК ORDERS_Статус,
	|	КонтурEDI_Сообщения_ORDERS.Документ КАК Документ,
	|	ВЫБОР
	|		КОГДА КонтурEDI_Сообщения_ORDERS.Документ = &Документ
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоТекущийДокумент
	|ПОМЕСТИТЬ ВТ_ORDERS
	|ИЗ
	|	ВТ_ИД_ORDERS КАК ВТ_ИД_ORDERS
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения_ORDERS
	|		ПО ВТ_ИД_ORDERS.ID = КонтурEDI_Сообщения_ORDERS.ID
	|			И (КонтурEDI_Сообщения_ORDERS.ТипСообщения = ""ORDERS""
	|				ИЛИ КонтурEDI_Сообщения_ORDERS.ТипСообщения = ""#ORDERS"")
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ORDERS.ORDERS,
	|	ВТ_ORDERS.ORDERS_ТипСообщения,
	|	ВТ_ORDERS.ORDERS_Статус,
	|	ВТ_ORDERS.Документ,
	|	ВТ_ORDERS.ЭтоТекущийДокумент
	|ПОМЕСТИТЬ ВТ_ORDERS_БезПомеченных
	|ИЗ
	|	ВТ_ORDERS КАК ВТ_ORDERS
	|ГДЕ
	|	&УсловиеПометкаУдаленияДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_Сообщения_ORDRSP.Ссылка КАК ORDRSP,
	|	КонтурEDI_Сообщения_ORDRSP.Статус КАК ORDRSP_Статус,
	|	ВТ_ORDERS_БезПомеченных.ORDERS,
	|	ВТ_ORDERS_БезПомеченных.ORDERS_ТипСообщения,
	|	ВТ_ORDERS_БезПомеченных.ORDERS_Статус,
	|	ВТ_ORDERS_БезПомеченных.Документ,
	|	ВТ_ORDERS_БезПомеченных.ЭтоТекущийДокумент
	|ИЗ
	|	ВТ_ORDERS_БезПомеченных КАК ВТ_ORDERS_БезПомеченных
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения_ORDRSP
	|		ПО ВТ_ORDERS_БезПомеченных.Документ = КонтурEDI_Сообщения_ORDRSP.Документ
	|			И (КонтурEDI_Сообщения_ORDRSP.ТипСообщения = ""ORDRSP"")
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_ORDERS_БезПомеченных.ORDERS";
	
	//      
	
	ТипДокументаORDERS = ПолучитьТипЗначенияОбъекта("ВходящийЗаказПокупателя",Истина);
	
	Если ЗначениеЗаполнено(ТипДокументаORDERS) Тогда
		ТекстУсловиеПометкаУдаленияДокумента = "НЕ ВЫРАЗИТЬ(ВТ_ORDERS.Документ КАК " + ТипДокументаORDERS + ").ПометкаУдаления";
	Иначе
		ТекстУсловиеПометкаУдаленияДокумента = "ИСТИНА";
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПометкаУдаленияДокумента", ТекстУсловиеПометкаУдаленияДокумента);
	
	Таб = Запрос.Выполнить().Выгрузить();
	
	Если ВнешнееХранилище Тогда
		СтруктураКолонокПреобразуемыхВСсылки = Новый Структура;
		СтруктураКолонокПреобразуемыхВСсылки.Вставить("Документ",		Документы.ТипВсеСсылки());//на рефакторинг: тип брать из ТаблицаТипов
		Таб = ПолучитьТаблицуИзВнешнейБазы(Таб,СтруктураКолонокПреобразуемыхВСсылки);
	КонецЕсли;		
	
	Возврат Таб;
	
КонецФункции

Процедура УФ_ЗаполнитьСписокЕдиницИзмерения(Номенклатура,СписокВыбора = Неопределено)Экспорт
	
	ПараметрыВыбора = Новый Структура;
	ПараметрыВыбора.Вставить("Номенклатура",				Номенклатура);
	ПараметрыВыбора.Вставить("Отбор",						Новый Структура("Владелец", Номенклатура));
	ПараметрыВыбора.Вставить("ДобавлятьПустуюУпаковку",		Истина); 
	ПараметрыВыбора.Вставить("ВыборГруппИЭлементов",		ИспользованиеГруппИЭлементов.Элементы); 
	
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("Номенклатура", Номенклатура);
	ПараметрыПМ.Вставить("ПараметрыВыбора", ПараметрыВыбора);
	
	СтандартнаяОбработкаEDI = Истина;
	РезультатПМ = ОбработкаСобытияПодключаемогоМодуля("ЗаполнитьСписокЕдиницИзмерения", СтандартнаяОбработкаEDI, ПараметрыПМ); 
	
	Если СтандартнаяОбработкаEDI = Ложь 
		И ЗначениеЗаполнено(РезультатПМ)
		И ТипЗнч(РезультатПМ) = Тип("СписокЗначений") Тогда
		
		СписокВыбора = РезультатПМ;
		
	КонецЕсли;
	
	Если СтандартнаяОбработкаEDI Тогда
		
		ТипЕдиницИзмерения = ПолучитьТипЗначенияОбъекта("ЕдиницаИзмерения",,Истина);
		
		МассивТипов = EDI_РазложитьСтрокуВМассивСлов(ТипЕдиницИзмерения, ",");
		
		СписокВыбора = Новый СписокЗначений;
		
		Для Каждого Тип из МассивТипов Цикл
			
			СписокВыбораПромежуточный = Справочники[Тип].ПолучитьДанныеВыбора(ПараметрыВыбора);
			
			Для Каждого ЭлементСписка Из СписокВыбораПромежуточный Цикл
				Если ТипЗнч(ЭлементСписка.Значение)= Тип("Структура") Тогда
					СписокВыбора.Добавить(ЭлементСписка.Значение.Значение, ЭлементСписка.Представление);
				Иначе
					СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
		
		Если ИмяКонфигурации1С = "УФ_УНФ" ИЛИ ИмяКонфигурации1С="УФ_ДалионТРЕНД" Тогда
			СписокВыбора.Добавить(Номенклатура.ЕдиницаИзмерения, Номенклатура.ЕдиницаИзмерения.Наименование + " (ед. хранения)");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция УФ_ПолучитьБазовуюЕдиницуИзмерения(_Номенклатура) Экспорт
	
	ИмяРеквизитаЕдиницаИзмерения = Неопределено; 
	
	Если ИмяКонфигурации1С = "УФ_УТ" Тогда 
		
		ИмяРеквизитаЕдиницаИзмерения = "ЕдиницаИзмерения";
		
	ИначеЕсли ЕстьСправочникУпаковокУФ_БП() Тогда
		
		ИмяРеквизитаЕдиницаИзмерения = "ЕдОтпуска";
		
	КонецЕсли;
	
	РеквизитОбъектаМетаданных = КонтурСтандарт_СтрШаблон_("Справочники.%1.Реквизиты.%2", 
															_Номенклатура.Метаданные().Имя,
															ИмяРеквизитаЕдиницаИзмерения);
	
	Если ЕстьНеобходимыеМетаданные(РеквизитОбъектаМетаданных) Тогда
		Возврат _Номенклатура[ИмяРеквизитаЕдиницаИзмерения];
	КонецЕсли;		
	
	ИмяРеквизитаЕдиницаИзмерения = ПолучитьИмяРеквизитаВладельцаПоИмениТипа("Номенклатура", "ЕдиницаИзмерения");
	
	Если ЗначениеЗаполнено(ИмяРеквизитаЕдиницаИзмерения) Тогда
		
		ЕдиницаИзмерения = _Номенклатура[ИмяРеквизитаЕдиницаИзмерения];
		
	Иначе
		
		ЕдиницаИзмерения = _Номенклатура.ЕдиницаИзмерения;
		
	КонецЕсли;
	
	Возврат ЕдиницаИзмерения;
	
КонецФункции

Функция ЕстьСправочникУпаковокУФ_БП()
	
	Возврат ИмяКонфигурации1С = "УФ_БП" 
			И (ЕстьНеобходимыеМетаданные("Справочники.МОЛ_ЕдиницыИзмерений") 
				Или ЕстьНеобходимыеМетаданные("Справочники.УНИ_ЕдиницыИзмерений"));
	
КонецФункции

Функция НайтиТоварыПоШтрихкоду(Штрихкод, Партнер = Неопределено, КодПартнера = Неопределено) Экспорт
	
	СтандартнаяОбработкаEDI = Истина;
	Результат = ОбработкаСобытияПодключаемогоМодуля("ПолучитьТоварыПоШтрихкоду", СтандартнаяОбработкаEDI,
													Новый Структура("Штрихкод,Партнер,КодПартнера", Штрихкод, Партнер, КодПартнера));
	Если СтандартнаяОбработкаEDI=Ложь Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("ХарактеристикаНоменклатуры");
	Результат.Колонки.Добавить("ЕдиницаИзмерения");
	
	Если НЕ ИмяКонфигурации1С = "БП"
		И НЕ ИмяКонфигурации1С = "УФ_БП"
		И ЗначениеЗаполнено(Штрихкод) Тогда
		
		МассивШтрихкодов = Новый Массив;
		МассивШтрихкодов.Добавить(Штрихкод);
		МассивШтрихкодов.Добавить(УбратьЛидирующиеНулиВСтроке_КонтурEDI(Штрихкод));
						
		Запрос = Новый Запрос;
		Если  ИмяКонфигурации1С = "УФ_УТ" Тогда
			
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	Штрихкоды.Номенклатура КАК Номенклатура,
			|	Штрихкоды.Характеристика КАК ХарактеристикаНоменклатуры,
			|	ВЫБОР
			|		КОГДА Штрихкоды.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиНоменклатуры.ПустаяСсылка)
			|			ТОГДА Штрихкоды.Номенклатура.ЕдиницаИзмерения
			|		ИНАЧЕ Штрихкоды.Упаковка
			|	КОНЕЦ КАК ЕдиницаИзмерения
			|ИЗ
			|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
			|ГДЕ
			|	Штрихкоды.Штрихкод В (&Штрихкод)
			|	И &ПроверкаТипаВладельца";
			
			ПолеВладельца = "Штрихкоды.Номенклатура";
			
			Если ЕстьНеобходимыеМетаданные("Справочники.УпаковкиЕдиницыИзмерения") Тогда 
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "УпаковкиНоменклатуры", "УпаковкиЕдиницыИзмерения");
			КонецЕсли;
			
		ИначеЕсли ИмяКонфигурации1С = "УФ_УНФ" Тогда	
			
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура,
			|	ШтрихкодыНоменклатуры.Характеристика КАК ХарактеристикаНоменклатуры,
			|	ВЫБОР 
			|		КОГДА ШтрихкодыНоменклатуры.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка) 
			|			ТОГДА ШтрихкодыНоменклатуры.Номенклатура.ЕдиницаИзмерения
			|		ИНАЧЕ ШтрихкодыНоменклатуры.ЕдиницаИзмерения
			|	КОНЕЦ КАК ЕдиницаИзмерения
			|ИЗ
			|	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
			|ГДЕ
			|	ШтрихкодыНоменклатуры.Штрихкод В(&Штрихкод)
			|	И &ПроверкаТипаВладельца";
			
			ПолеВладельца = "ШтрихкодыНоменклатуры.Номенклатура";
			
		ИначеЕсли ИмяКонфигурации1С = "ТКПТ" Тогда
			
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	Штрихкоды.Объект КАК Номенклатура,
			|	Штрихкоды.ХарактеристикаНоменклатуры,
			|	Штрихкоды.ЕдиницаИзмерения
			|ИЗ
			|	РегистрСведений.Штрихкоды КАК Штрихкоды
			|ГДЕ
			|	Штрихкоды.ОсновнойШтрихкод В(&Штрихкод)
			|	И &ПроверкаТипаВладельца";
			
			ПолеВладельца = "Штрихкоды.Объект";
			
		ИначеЕсли ИмяКонфигурации1С = "АСТОР" Тогда
			
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	Штрихкоды.Номенклатура КАК Номенклатура,
			|	Штрихкоды.ХарактеристикаПартия КАК ХарактеристикаНоменклатуры,
			|	Штрихкоды.ЕдиницаИзмерения
			|ИЗ
			|	РегистрСведений.ШтриховыеКоды КАК Штрихкоды
			|ГДЕ
			|	Штрихкоды.Штрихкод В(&Штрихкод)
			|	И &ПроверкаТипаВладельца";
			
			ПолеВладельца = "Штрихкоды.Номенклатура";
			
		ИначеЕсли  ИмяКонфигурации1С = "ДалионУМ" Тогда
			
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	Штрихкоды.Номенклатура КАК Номенклатура,
			|	Штрихкоды.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
			|	Штрихкоды.ЕдиницаИзмерения
			|ИЗ
			|	РегистрСведений.Штрихкоды КАК Штрихкоды
			|ГДЕ
			|	Штрихкоды.Штрихкод В(&Штрихкод)
			|	И &ПроверкаТипаВладельца";
			
			ПолеВладельца = "Штрихкоды.Номенклатура";
			
		ИначеЕсли  ИмяКонфигурации1С = "ДалионТРЕНД" ИЛИ ИмяКонфигурации1С = "УФ_ДалионТРЕНД"  Тогда
			
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	Штрихкоды.Номенклатура КАК Номенклатура,
			|	Штрихкоды.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
			|	Штрихкоды.ЕдиницаИзмерения
			|ИЗ
			|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
			|ГДЕ
			|	Штрихкоды.Штрихкод В(&Штрихкод)
			|	И &ПроверкаТипаВладельца";
			
			ПолеВладельца = "Штрихкоды.Номенклатура";
			
		ИначеЕсли  ИмяКонфигурации1С = "УФ_Розница" Тогда
			
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|  Штрихкоды.Владелец КАК Номенклатура,
			|  Штрихкоды.Характеристика КАК ХарактеристикаНоменклатуры,
			|  ВЫБОР
			|      КОГДА Штрихкоды.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиНоменклатуры.ПустаяСсылка)
			|         ТОГДА Штрихкоды.Владелец.ЕдиницаИзмерения
			|      ИНАЧЕ Штрихкоды.Упаковка
			|  КОНЕЦ КАК ЕдиницаИзмерения
			|ИЗ
			|  РегистрСведений.Штрихкоды КАК Штрихкоды
			|ГДЕ
			|  Штрихкоды.Штрихкод В(&Штрихкод)
			|	И &ПроверкаТипаВладельца";
			
			ПолеВладельца = "Штрихкоды.Владелец";
			
		Иначе
			
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	Штрихкоды.Владелец КАК Номенклатура,
			|	Штрихкоды.ХарактеристикаНоменклатуры,
			|	Штрихкоды.ЕдиницаИзмерения
			|ИЗ
			|	РегистрСведений.Штрихкоды КАК Штрихкоды
			|ГДЕ
			|	Штрихкоды.Штрихкод В(&Штрихкод)
			|	И &ПроверкаТипаВладельца";
			
			ПолеВладельца = "Штрихкоды.Владелец";
			
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Штрихкод", МассивШтрихкодов);
		
		ТекстПроверкиТипа = "ИСТИНА"; 
		
		ИмяСправочникаНоменклатуры = ПолучитьТипЗначенияОбъекта("Номенклатура",,Истина);
		
		Если ЗначениеЗаполнено(ИмяСправочникаНоменклатуры) Тогда
			ТекстПроверкиТипа = ПолеВладельца + " ССЫЛКА Справочник." + ИмяСправочникаНоменклатуры;
		КонецЕсли;
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПроверкаТипаВладельца", ТекстПроверкиТипа);  
		
		Результат = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//***************************************************************
// Соответствие товаров
Функция СоответствиеТоваров_НайтиНоменклатуру(GTIN,Знач КодТовараПартнера,Знач Владелец) Экспорт
	
	ТаблицаТоваров = Новый ТаблицаЗначений;
	
	ТаблицаТоваров.Колонки.Добавить("GTIN", ОписаниеТипаСтрока_КонтурEDI(14));
	ТаблицаТоваров.Колонки.Добавить("КодТовараПокупателя", ОписаниеТипаСтрока_КонтурEDI(36));
	
	НоваяСтрока = ТаблицаТоваров.Добавить();
	НоваяСтрока.GTIN					= GTIN;
	НоваяСтрока.КодТовараПокупателя		= КодТовараПартнера;
	
	Возврат ПолучитьСоответствияТоваровДляПересчета(ТаблицаТоваров,Владелец);
		
КонецФункции

Функция ПолучитьПредставлениеНастроекСопоставленияПартнера(Партнер) Экспорт
	
	СинхронизироватьТоварыТолькоПоКодуПартнера = (ПолучитьЗначениеСвойстваОбъектаEDI(Партнер, "СинхронизироватьТоварыТолькоПоКодуПартнера") = Истина);
	СинхронизироватьТоварыТолькоПоGTIN = (ПолучитьЗначениеСвойстваОбъектаEDI(Партнер, "СинхронизироватьТоварыТолькоПоGTIN") = Истина);
	
	Если СинхронизироватьТоварыТолькоПоКодуПартнера Тогда
		НастройкиСопоставления = "Синхронизировать только по коду партнера";
	ИначеЕсли СинхронизироватьТоварыТолькоПоGTIN Тогда
		НастройкиСопоставления = "Синхронизировать только по коду GTIN";
	Иначе
		НастройкиСопоставления = "Синхронизировать по GTIN и коду партнера";	
	КонецЕсли;
	
	Возврат НастройкиСопоставления;
	
КонецФункции

Функция ПолучитьПодсказкуДляФормыСоответствия(ЕстьСоответствие, Направление) Экспорт
	
	Если ЕстьСоответствие Тогда
		Инфо = "Соответствие подобрано. 
				|Закройте форму и оно будет заполнено в сообщении.";
	Иначе
		Если Направление = "Входящее" Тогда
			Инфо =  "Не удалось подобрать соответствие номенклатуры для позиции сообщения.
			|Создайте новое соответствие или отредактируйте существующее.";
		Иначе
			Инфо =  "Не удалось подобрать соответствие EDI для строки документа 1С.
			|Проверьте, что данные в строке документа совпадают с соответствиями
			|номенклатуры для партнера EDI.";
		КонецЕсли;

	КонецЕсли;
	
	Возврат Инфо;                                                          
	
КонецФункции

// Возможным соответствием для отображения пользователю будем считать соответствия, в которых отличается единица измерения или характеристика
Функция НайтиВозможныеСоответствияТовара_ИсходящееСообщение(Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения, ВладелецНоменклатуры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтурEDI_СоответствияТоваров.Номенклатура КАК Номенклатура,
		|	КонтурEDI_СоответствияТоваров.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	КонтурEDI_СоответствияТоваров.Единица КАК ЕдиницаИзмерения,
		|	КонтурEDI_СоответствияТоваров.GTIN КАК GTIN,
		|	КонтурEDI_СоответствияТоваров.КодТовараПартнера КАК КодТовараПартнера,
		|	КонтурEDI_СоответствияТоваров.ЕдиницаEDI КАК ЕдиницаEDI,
		|	КонтурEDI_СоответствияТоваров.НаименованиеПартнера КАК НаименованиеПартнера
		|ИЗ
		|	РегистрСведений.КонтурEDI_СоответствияТоваров КАК КонтурEDI_СоответствияТоваров
		|ГДЕ
		|	КонтурEDI_СоответствияТоваров.Партнер = &Партнер
		|	И КонтурEDI_СоответствияТоваров.Номенклатура = &Номенклатура
		|	И (КонтурEDI_СоответствияТоваров.Единица = &ЕдиницаИзмерения
		|			ИЛИ (КонтурEDI_СоответствияТоваров.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
		|				ИЛИ КонтурEDI_СоответствияТоваров.ХарактеристикаНоменклатуры = НЕОПРЕДЕЛЕНО))";
	
	Запрос.УстановитьПараметр("Партнер", ВладелецНоменклатуры);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", ХарактеристикаНоменклатуры);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения", ЕдиницаИзмерения);
		
	ВозможныеСоответствия = Запрос.Выполнить().Выгрузить();
	
	ВозможныеСоответствия.Колонки.Добавить("ПолеНесоответствия");
	ВозможныеСоответствия.Колонки.Добавить("ИсходноеЗначение");
	ВозможныеСоответствия.Колонки.Добавить("ЗначениеВСоответствии");
	
	ЕстьПолноеСоответствие = Ложь;
	Для Каждого Стр Из ВозможныеСоответствия Цикл
		Если ЗначениеЗаполнено(Стр.ХарактеристикаНоменклатуры) И Стр.ХарактеристикаНоменклатуры <> ХарактеристикаНоменклатуры Тогда
			Стр.ПолеНесоответствия = "Характеристика";
			Стр.ИсходноеЗначение = ХарактеристикаНоменклатуры;
			Стр.ЗначениеВСоответствии = Стр.ХарактеристикаНоменклатуры;
		ИначеЕсли Стр.ЕдиницаИзмерения <> ЕдиницаИзмерения Тогда
			Стр.ПолеНесоответствия = "ЕдиницаИзмерения";
			Стр.ИсходноеЗначение = ЕдиницаИзмерения;
			Стр.ЗначениеВСоответствии = Стр.ЕдиницаИзмерения;
		Иначе
			ЕстьПолноеСоответствие = Истина;
		КонецЕсли;				
	КонецЦикла;
	
	ВозможныеСоответствия.Сортировать("ПолеНесоответствия");
	
	СтруктураРезультата = Новый Структура();
	СтруктураРезультата.Вставить("ЕстьПолноеСоответствие", ЕстьПолноеСоответствие);
	СтруктураРезультата.Вставить("ТаблицаСоответствий", ВозможныеСоответствия);
	
	Возврат СтруктураРезультата;
	
КонецФункции

// Возможным соответствием для отображения пользователю будем считать соответствия, в которых различаются единицы измерения EDI.
// При этом будем учитывать настройки соответствия партнера. Так же возможно подбирать соответствия, где отличается GTIN или Код партнера,
// но пока для простоты было решено убрать их.
Функция НайтиВозможныеСоответствияТовара_ВходящееСообщение(GTIN, КодТовараПартнера, КодЕдиницыИзмеренияEDI, ВладелецНоменклатуры) Экспорт
		
	СинхронизироватьТоварыТолькоПоКодуПартнера = (ПолучитьЗначениеСвойстваОбъектаEDI(ВладелецНоменклатуры, "СинхронизироватьТоварыТолькоПоКодуПартнера") = Истина);
	СинхронизироватьТоварыТолькоПоGTIN = (ПолучитьЗначениеСвойстваОбъектаEDI(ВладелецНоменклатуры, "СинхронизироватьТоварыТолькоПоGTIN") = Истина);
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтурEDI_СоответствияТоваров.Номенклатура КАК Номенклатура,
		|	КонтурEDI_СоответствияТоваров.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	КонтурEDI_СоответствияТоваров.Единица КАК ЕдиницаИзмерения,
		|	КонтурEDI_СоответствияТоваров.GTIN КАК GTIN,
		|	КонтурEDI_СоответствияТоваров.КодТовараПартнера КАК КодТовараПартнера,
		|	КонтурEDI_СоответствияТоваров.ЕдиницаEDI КАК ЕдиницаEDI,
		|	КонтурEDI_СоответствияТоваров.НаименованиеПартнера КАК НаименованиеПартнера,
		|	КонтурEDI_СоответствияТоваров.КоэффициентEDIВ1С КАК КоэффициентEDIВ1С,
		|	&ПолеТипЕдиницы КАК ТипЕдиницы
		|ИЗ
		|	РегистрСведений.КонтурEDI_СоответствияТоваров КАК КонтурEDI_СоответствияТоваров
		|ГДЕ
		|	КонтурEDI_СоответствияТоваров.Партнер = &Партнер
		|	И (КонтурEDI_СоответствияТоваров.GTIN = &GTIN
		|			ИЛИ &СинхронизироватьТоварыТолькоПоКодуПартнера)
		|	И (КонтурEDI_СоответствияТоваров.КодТовараПартнера = &КодТовараПартнера
		|			ИЛИ  &СинхронизироватьТоварыТолькоПоGTIN)
		|	И НЕ(&СинхронизироватьТоварыТолькоПоGTIN
		|				И КонтурEDI_СоответствияТоваров.GTIN = """")
		|	И НЕ(&СинхронизироватьТоварыТолькоПоКодуПартнера
		|				И КонтурEDI_СоответствияТоваров.КодТовараПартнера = """")";
	
	Запрос.УстановитьПараметр("Партнер", ВладелецНоменклатуры);
	Запрос.УстановитьПараметр("GTIN", GTIN);
	Запрос.УстановитьПараметр("КодТовараПартнера", КодТовараПартнера);
	Запрос.УстановитьПараметр("СинхронизироватьТоварыТолькоПоGTIN", СинхронизироватьТоварыТолькоПоGTIN);
	Запрос.УстановитьПараметр("СинхронизироватьТоварыТолькоПоКодуПартнера", СинхронизироватьТоварыТолькоПоКодуПартнера);
	
	Если ЕстьМетаданныеТипЕдиницы Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст , "&ПолеТипЕдиницы", "КонтурEDI_СоответствияТоваров.ТипЕдиницы");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст , "&ПолеТипЕдиницы", """""");
	КонецЕсли;
		
	ВозможныеСоответствия = Запрос.Выполнить().Выгрузить();
	
	ВозможныеСоответствия.Колонки.Добавить("ПолеНесоответствия");
	ВозможныеСоответствия.Колонки.Добавить("ИсходноеЗначение");
	ВозможныеСоответствия.Колонки.Добавить("ЗначениеВСоответствии");
	
	ЕстьПолноеСоответствие = Ложь;
	Для Каждого Стр Из ВозможныеСоответствия Цикл	
		Если Стр.ЕдиницаEDI <> "" И Стр.ЕдиницаEDI <> КодЕдиницыИзмеренияEDI Тогда
			Стр.ПолеНесоответствия = "ЕдиницаEDI";
			Стр.ИсходноеЗначение = КодЕдиницыИзмеренияEDI;
			Стр.ЗначениеВСоответствии = Стр.ЕдиницаEDI;
		Иначе
			ЕстьПолноеСоответствие = Истина;
		КонецЕсли;			
	КонецЦикла;
	
	ВозможныеСоответствия.Сортировать("ПолеНесоответствия");
	
	СтруктураРезультата = Новый Структура();
	СтруктураРезультата.Вставить("ЕстьПолноеСоответствие", ЕстьПолноеСоответствие);
	СтруктураРезультата.Вставить("ТаблицаСоответствий", ВозможныеСоответствия);
	
	Возврат СтруктураРезультата;
	
КонецФункции

Функция СоставитьСписокВыбораСоответствийПоТовару(GTIN, КодТовараПокупателя, КодЕдиницыИзмеренияEDI, Партнер) Экспорт
	
	СоответствиеТоваров = СоответствиеТоваров_НайтиНоменклатуру(GTIN, КодТовараПокупателя, Партнер);
	
	СписокВыбора = Новый СписокЗначений; 
	
	Для Каждого Стр Из СоответствиеТоваров Цикл
		
		СтруктураТовара = Новый Структура();
		
		ТекстПересчета = ТекстПересчета_КонтурEDI(Стр.ЕдиницаИзмерения, Стр.ЕдиницаEDI, Стр.КоэффициентEDIВ1С);
		
		СтруктураТовара.Вставить("Номенклатура", Стр.Номенклатура);
		СтруктураТовара.Вставить("ХарактеристикаНоменклатуры", Стр.ХарактеристикаНоменклатуры);
		СтруктураТовара.Вставить("ЕдиницаИзмерения", Стр.ЕдиницаИзмерения);
		СтруктураТовара.Вставить("КоэффициентEDIВ1С", Стр.КоэффициентEDIВ1С);
		СтруктураТовара.Вставить("КодЕдиницыИзмеренияEDI", Стр.ЕдиницаEDI);
		СтруктураТовара.Вставить("ТипЕдиницы", Стр.ТипЕдиницы);
		СтруктураТовара.Вставить("ТекстПересчета", ТекстПересчета);
		
		Представление = СокрЛП(Стр.Номенклатура);
		
		Если ЗначениеЗаполнено(Стр.ХарактеристикаНоменклатуры) Тогда
			Представление = Представление + ", " + СокрЛП(Стр.ХарактеристикаНоменклатуры);
		КонецЕсли;      
		
		Если ЗначениеЗаполнено(Стр.ЕдиницаИзмерения) Тогда
			Представление = Представление + ", " + СокрЛП(Стр.ЕдиницаИзмерения);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.ЕдиницаEDI) Тогда
			Представление = Представление + ", " + СокрЛП(Стр.ЕдиницаEDI);
		КонецЕсли; 
		
		Представление = Представление + ", " + ТекстПересчета;
		
		СписокВыбора.Добавить(СтруктураТовара, Представление);
		
	КонецЦикла;
		
	КартинкаНастроитьСоответствие = ПолучитьКартинкуEDI("ЭлементФормы", "КартинкаПривязатьСообщение");
	СписокВыбора.Добавить("Настроить соответствие товаров", , , КартинкаНастроитьСоответствие);
	
	Возврат СписокВыбора;
	
КонецФункции

Функция ПараметрыОтбораСоответствияТоваров(Владелец, СтрокаТаблицы, ЗначенияИзмеренийПоУмолчанию)
			
	ПараметрыОтбора = Новый Структура("Партнер,Номенклатура,Единица,ЕдиницаEDI");
	
	ПараметрыОтбора.Партнер			= Владелец;	
	ПараметрыОтбора.Номенклатура	= СтрокаТаблицы.Номенклатура;
	ПараметрыОтбора.Единица			= СтрокаТаблицы.ЕдиницаИзмерения;
	ПараметрыОтбора.ЕдиницаEDI		= СтрокаТаблицы.ЕдиницаEDI;
			
	ДополнитьПараметрыОтбораСоответствияТоваров(ПараметрыОтбора, СтрокаТаблицы, ЗначенияИзмеренийПоУмолчанию);
	
	Возврат ПараметрыОтбора;
	
КонецФункции
	
Процедура ДополнитьПараметрыОтбораСоответствияТоваров(ПараметрыОтбора, СтрокаТаблицы, ЗначенияИзмеренийПоУмолчанию)
	
	Для Каждого КлючЗначение Из ЗначенияИзмеренийПоУмолчанию Цикл
		
		ИмяИзмерения		= КлючЗначение.Ключ;
		ЗначениеИзмерения   = КлючЗначение.Значение;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы[ИмяИзмерения]) Тогда			
			ПараметрыОтбора.Вставить(ИмяИзмерения, СтрокаТаблицы[ИмяИзмерения]);			
		Иначе			
			ПараметрыОтбора.Вставить(ИмяИзмерения, ЗначениеИзмерения);		
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

Функция СформироватьТекстОшибкиСохраненияСоответствияТоваров_КонтурEDI(СтрокаНайденногоСоответствия, СтрокаСохраняемогоСоответствия)
	
	ЧастиТекстаОшибки = Новый Массив;
	
	ЧастьТекста = КонтурСтандарт_СтрШаблон_("Номенклатура ""%1"" с единицей измерения ""%2""", 
											СтрокаСохраняемогоСоответствия.Номенклатура,
											СтрокаСохраняемогоСоответствия.ЕдиницаИзмерения);
	
	ЧастиТекстаОшибки.Добавить(ЧастьТекста);			
	
	Если ЗначениеЗаполнено(СтрокаСохраняемогоСоответствия.ХарактеристикаНоменклатуры) Тогда
		ЧастьТекста = КонтурСтандарт_СтрШаблон_("и характеристикой ""%1""", СтрокаСохраняемогоСоответствия.ХарактеристикаНоменклатуры);
		ЧастиТекстаОшибки.Добавить(ЧастьТекста);
	КонецЕсли;
	
	ЧастьТекста = КонтурСтандарт_СтрШаблон_("уже сопоставлена с товаром ""%1""", СтрокаНайденногоСоответствия.НаименованиеПартнера);
											
	ЧастиТекстаОшибки.Добавить(ЧастьТекста);
	
	Если ЗначениеЗаполнено(СокрЛП(СтрокаНайденногоСоответствия.КодТовараПартнера)) Тогда
		ЧастьТекста = КонтурСтандарт_СтрШаблон_("с кодом ""%1""", СтрокаНайденногоСоответствия.КодТовараПартнера);
		ЧастиТекстаОшибки.Добавить(ЧастьТекста);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СокрЛП(СтрокаНайденногоСоответствия.GTIN)) Тогда
		ЧастьТекста = КонтурСтандарт_СтрШаблон_("и GTIN ""%1"".", СтрокаНайденногоСоответствия.GTIN);
		ЧастиТекстаОшибки.Добавить(ЧастьТекста);
	КонецЕсли;
	
	ТекстКонтрагентДоговор = "";
	
	Для Каждого ИмяКолонки Из КонтурСтандарт_СтрРазделить_("контрагент,договор", ",") Цикл
		
		Если ЗначениеЗаполнено(СтрокаСохраняемогоСоответствия[ИмяКолонки]) Тогда
			
			ЧастьТекста = КонтурСтандарт_СтрШаблон_(" %1: %2 (%3)", 
													ИмяКолонки, 
													СтрокаСохраняемогоСоответствия[ИмяКолонки], 
													СтрокаСохраняемогоСоответствия[ИмяКолонки].Код);
			
			ТекстКонтрагентДоговор = ТекстКонтрагентДоговор + ЧастьТекста;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ТекстКонтрагентДоговор) Тогда
		ЧастиТекстаОшибки.Добавить("В разрезе: " + ТекстКонтрагентДоговор);
	КонецЕсли;
	
	Возврат КонтурСтандарт_СтрСоединить_(ЧастиТекстаОшибки, " ");
			
КонецФункции

Функция СоответствиеТоваров_Сохранить(ТаблицаНоменклатуры,GTIN,КодТовараПартнера,Наименование,Знач Владелец,ТекущееСоответствие,ТипЕдиницы = "") Экспорт//+
	
	РезультатСохранения = ИнициализироватьСтруктуруРезультатаФункции();
	ЗапросПроверка = Новый Запрос;
	
	//сначала проверим: не затрет ли новое соответствие какое-либо другое, установленное ранее
	ЗапросПроверка.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_СоответствияТоваров.Номенклатура,
	|	КонтурEDI_СоответствияТоваров.ХарактеристикаНоменклатуры,
	|	КонтурEDI_СоответствияТоваров.Единица,
	|	КонтурEDI_СоответствияТоваров.GTIN,
	|	КонтурEDI_СоответствияТоваров.КодТовараПартнера,
	|	КонтурEDI_СоответствияТоваров.НаименованиеПартнера
	|ИЗ
	|	РегистрСведений.КонтурEDI_СоответствияТоваров КАК КонтурEDI_СоответствияТоваров
	|ГДЕ
	|	КонтурEDI_СоответствияТоваров.Партнер = &Партнер
	|	И КонтурEDI_СоответствияТоваров.Номенклатура = &Номенклатура
	|	И КонтурEDI_СоответствияТоваров.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
	|	И КонтурEDI_СоответствияТоваров.Единица = &Единица
	|	И КонтурEDI_СоответствияТоваров.ЕдиницаEDI = &ЕдиницаEDI
	|	И (&УсловиеGTIN
	|			ИЛИ &УсловиеКодТовараПартнера)
	|	И (КонтурEDI_СоответствияТоваров.GTIN <> &ТекущийGTIN
	|			ИЛИ КонтурEDI_СоответствияТоваров.КодТовараПартнера <> &ТекущийКодТовараПартнера)
	|	И &ДопУсловие";
	
	НастройкиСинхронизацииТоваров = НастройкиСинхронизацииТоваров(Владелец); 
	
	СинхронизироватьТоварыТолькоПоGTIN = НастройкиСинхронизацииТоваров.СинхронизироватьТоварыТолькоПоGTIN;
	СинхронизироватьТоварыТолькоПоКодуПартнера = НастройкиСинхронизацииТоваров.СинхронизироватьТоварыТолькоПоКодуПартнера;
		
	Если НЕ СинхронизироватьТоварыТолькоПоGTIN И СинхронизироватьТоварыТолькоПоКодуПартнера Тогда
		
		УсловиеGTIN = "Ложь";
		УсловиеКодТовараПартнера = "КонтурEDI_СоответствияТоваров.КодТовараПартнера <> &КодТовараПартнера"; 
		
	ИначеЕсли СинхронизироватьТоварыТолькоПоGTIN И НЕ СинхронизироватьТоварыТолькоПоКодуПартнера  Тогда
		
		УсловиеGTIN = "КонтурEDI_СоответствияТоваров.GTIN <> &GTIN";
		УсловиеКодТовараПартнера = "Ложь";
		
	Иначе
		
		УсловиеGTIN = "КонтурEDI_СоответствияТоваров.GTIN <> &GTIN";
		УсловиеКодТовараПартнера = "КонтурEDI_СоответствияТоваров.КодТовараПартнера <> &КодТовараПартнера"; 
		
	Конецесли;
	
	ЗапросПроверка.Текст = СтрЗаменить(ЗапросПроверка.Текст, "&УсловиеGTIN", УсловиеGTIN);
	ЗапросПроверка.Текст = СтрЗаменить(ЗапросПроверка.Текст, "&УсловиеКодТовараПартнера", УсловиеКодТовараПартнера);
	
	ТекстДопУсловия = " КонтурEDI_СоответствияТоваров.Контрагент = &Контрагент И КонтурEDI_СоответствияТоваров.Договор = &Договор ";
	
	ЗапросПроверка.Текст = СтрЗаменить(ЗапросПроверка.Текст, "&ДопУсловие", ТекстДопУсловия);
	
	ИзмеренияРегистра = Метаданные.РегистрыСведений.КонтурEDI_СоответствияТоваров.Измерения;
	
	ЗначенияИзмеренийПоУмолчанию = Новый Структура("ХарактеристикаНоменклатуры,Контрагент,Договор");
	
	Для Каждого КлючЗначение Из ЗначенияИзмеренийПоУмолчанию Цикл
		
		ИмяИзмерения = КлючЗначение.Ключ;
		ЗначенияИзмеренийПоУмолчанию[ИмяИзмерения] = ИзмеренияРегистра[ИмяИзмерения].Тип.ПривестиЗначение(Неопределено);
				
	КонецЦикла;
	
	Для Каждого Стр Из ТаблицаНоменклатуры Цикл
		
		ЗапросПроверка.УстановитьПараметр("Партнер"						, Владелец);
		ЗапросПроверка.УстановитьПараметр("GTIN"						, GTIN);
		ЗапросПроверка.УстановитьПараметр("КодТовараПартнера"			, КодТовараПартнера);
		ЗапросПроверка.УстановитьПараметр("ТекущийGTIN"					, ТекущееСоответствие.GTIN);
		ЗапросПроверка.УстановитьПараметр("ТекущийКодТовараПартнера"	, ТекущееСоответствие.КодТовараПартнера);
		
		ЗапросПроверка.УстановитьПараметр("Номенклатура"	, Стр.Номенклатура);
		ЗапросПроверка.УстановитьПараметр("Единица"			, Стр.ЕдиницаИзмерения);
		ЗапросПроверка.УстановитьПараметр("ЕдиницаEDI"		, Стр.ЕдиницаEDI);
					
		ДополнитьПараметрыОтбораСоответствияТоваров(ЗапросПроверка.Параметры, Стр, ЗначенияИзмеренийПоУмолчанию);
		
		Выб = ЗапросПроверка.Выполнить().Выбрать();
		
		Если Выб.Следующий() Тогда
			
			ТекстОшибки = СформироватьТекстОшибкиСохраненияСоответствияТоваров_КонтурEDI(Выб, Стр);
			
			ЗарегистрироватьОшибку(РезультатСохранения, ТекстОшибки);
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	Если РезультатСохранения.ТаблицаОшибок.Количество()>0 Тогда
		
		ТекстОшибки = "Зайдите в меню %1, откройте карточку партнера ""%2"" 
					  |и проверьте существующие соответствия товаров.";
		
		ТекстОшибки = КонтурСтандарт_СтрШаблон_(ТекстОшибки, "Торговые сети", Владелец);
		
		ЗарегистрироватьОшибку(РезультатСохранения, ТекстОшибки);
		ОповеститьОбОшибках(РезультатСохранения, "Не удалось сохранить соответствия товаров");
		
		Возврат РезультатСохранения;
		
	КонецЕсли;	
	
	//затрем текущие соответствия
	ТекущиеСоответствия = СоответствиеТоваров_НайтиНоменклатуру(GTIN,КодТовараПартнера,Владелец);
	
	МенеджерЗаписиСоответствийТоваров = РегистрыСведений.КонтурEDI_СоответствияТоваров.СоздатьМенеджерЗаписи();
	
	Для каждого Стр Из ТекущиеСоответствия Цикл
		
		ПараметрыОтбора = ПараметрыОтбораСоответствияТоваров(Владелец, Стр, ЗначенияИзмеренийПоУмолчанию);
		
		ЗаполнитьЗначенияСвойств(МенеджерЗаписиСоответствийТоваров, ПараметрыОтбора);
		
		Если ЕстьМетаданныеТипЕдиницы Тогда
			МенеджерЗаписиСоответствийТоваров.ТипЕдиницы = Стр.ТипЕдиницы;
		КонецЕсли;
		
		МенеджерЗаписиСоответствийТоваров.Прочитать();
		
		Если МенеджерЗаписиСоответствийТоваров.Выбран() Тогда
			МенеджерЗаписиСоответствийТоваров.Удалить();
		КонецЕсли;
		
	КонецЦикла;
	
	//Запишем обновленные соответствия
	Для Каждого Стр ИЗ ТаблицаНоменклатуры Цикл
		
		ПараметрыОтбора = ПараметрыОтбораСоответствияТоваров(Владелец, Стр, ЗначенияИзмеренийПоУмолчанию);
		
		ЗаполнитьЗначенияСвойств(МенеджерЗаписиСоответствийТоваров, ПараметрыОтбора);
				
		МенеджерЗаписиСоответствийТоваров.Прочитать();
		
		ЗаполнитьЗначенияСвойств(МенеджерЗаписиСоответствийТоваров, ПараметрыОтбора);
		
		Если ЕстьМетаданныеТипЕдиницы Тогда
			МенеджерЗаписиСоответствийТоваров.ТипЕдиницы = СокрЛП(ТипЕдиницы);
		КонецЕсли;
		
		МенеджерЗаписиСоответствийТоваров.ОсновноеСоответствие 	= Стр.Основной;
		МенеджерЗаписиСоответствийТоваров.КоэффициентEDIВ1С		= Стр.КоэффициентEDIВ1С;		
		МенеджерЗаписиСоответствийТоваров.КодТовараПартнера		= СокрЛП(КодТовараПартнера);
		МенеджерЗаписиСоответствийТоваров.GTIN					= СокрЛП(GTIN);
		МенеджерЗаписиСоответствийТоваров.НаименованиеПартнера	= Наименование;
		
		МенеджерЗаписиСоответствийТоваров.Записать();
		
	КонецЦикла;

	РезультатСохранения.Успешно = Истина;
	
	Возврат РезультатСохранения;
	
КонецФункции

Функция ПолучитьШтрихкодНоменклатуры(Параметры) Экспорт

	СтандартнаяОбработкаEDI = Истина;
	
	Штрихкод = ОбработкаСобытияПодключаемогоМодуля("ПолучитьШтрихкодНоменклатуры",СтандартнаяОбработкаEDI,
			Новый Структура("Параметры",
			Параметры));

	Если Не СтандартнаяОбработкаEDI Тогда
		Возврат Штрихкод;
	КонецЕсли;
	
//	Штрихкод = ПолучитьШтрихкодНоменклатуры(Параметры);

	Штрихкод = Неопределено;
	
	Если ИмяКонфигурации1С = "КА" ИЛИ
		 ИмяКонфигурации1С = "УПП" ИЛИ
		 ИмяКонфигурации1С = "УТ_10_3" ИЛИ
		 ИмяКонфигурации1С = "УТ_10_2" Тогда

		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Штрихкоды.Штрихкод
		|ИЗ
		|	РегистрСведений.Штрихкоды КАК Штрихкоды
		|ГДЕ
		|	Штрихкоды.Владелец = &Владелец
		|	И Штрихкоды.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
		|	И Штрихкоды.ЕдиницаИзмерения = &ЕдиницаИзмерения";
		Запрос.УстановитьПараметр("Владелец", 					Параметры.Номенклатура);
		Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", Параметры.ХарактеристикаНоменклатуры);   
		Запрос.УстановитьПараметр("ЕдиницаИзмерения", 			Параметры.ЕдиницаИзмерения);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			
			Штрихкод = Неопределено;
			
		Иначе
			
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			
			Штрихкод = Выборка.Штрихкод;
			
		КонецЕсли;
						 
	КонецЕсли;
	
	Возврат Штрихкод;
			  
КонецФункции

Функция ПолучитьСписокЕдиницEDI() Экспорт

	СписокЕдиницКлассификатора = ЗагрузитьКлассификаторИзМакета("КодЕдиницы");	
	
	СписокЕдиницEDI = Новый СписокЗначений;
	
	Для Каждого Эл Из СписокЕдиницКлассификатора Цикл
		СписокЕдиницEDI.Добавить(Эл.Значение,Эл.Значение+" ("+СокрЛП(Эл.Представление)+")");
	КонецЦикла;

	Возврат СписокЕдиницEDI;
	
КонецФункции

