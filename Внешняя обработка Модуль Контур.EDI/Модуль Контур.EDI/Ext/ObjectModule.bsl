// Получает значение функ. опции структуру баннера основной формы 
//
// Возвращаемое значение:
//   Структура - см. КонтурБаннерОсновнойФормы_НовыйСтруктураБаннераОсновнойФормы
//
Функция КонтурБаннерОсновнойФормы_СтруктураБаннераОсновнойФормы() Экспорт
	
	НовыйСтруктураБаннераОсновнойФормы = КонтурБаннерОсновнойФормы_НовыйСтруктураБаннераОсновнойФормы();
	
	ТекстБаннераОсновнойФормы = КонтурБаннерОсновнойФормы_ТекстБаннераОсновнойФормы();
	
	Если ЗначениеЗаполнено(ТекстБаннераОсновнойФормы) Тогда
		
		Попытка
			
			ЗначениеБаннераОсновнойФормы = КонтурСтандарт_ЗначениеИзСтрокиJSON(ТекстБаннераОсновнойФормы);
			
			НовыйСтруктураБаннераОсновнойФормы.ПоказатьБаннер = ЗначениеЗаполнено(ЗначениеБаннераОсновнойФормы.Text);
			НовыйСтруктураБаннераОсновнойФормы.Текст = ЗначениеБаннераОсновнойФормы.Text;
			НовыйСтруктураБаннераОсновнойФормы.Ссылка = ЗначениеБаннераОсновнойФормы.Link;
			НовыйСтруктураБаннераОсновнойФормы.ЗаголовокСсылки = ЗначениеБаннераОсновнойФормы.TitleLink;
			
		Исключение
			
			ОписаниеОшибки = ОписаниеОшибки();
			
			Метрика_Переменные = Неопределено;
			Метрика_ОтправитьСразу = Истина;
			Метрика_Ошибка("ЗначениеБаннераОсновнойФормы", ОписаниеОшибки, ИнформацияОбОшибке(), Метрика_Переменные, Метрика_ОтправитьСразу);
			
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат НовыйСтруктураБаннераОсновнойФормы;
	
КонецФункции


Функция КонтурБаннерОсновнойФормы_НовыйСтруктураБаннераОсновнойФормы()
	
	НовыйСтруктураБаннераОсновнойФормы = Новый Структура;
