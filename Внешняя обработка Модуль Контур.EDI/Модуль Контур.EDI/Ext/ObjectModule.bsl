// Подключаемый модуль

Функция ПолучитьСсылкуНаРСчет() Экспорт
	
	ИмяСправочника	= НастройкиМодуля.СоздаваемыйДокументРСчетВид;
	GUIDСсылка		= НастройкиМодуля.СоздаваемыйДокументРСчетGUID;

	Если НЕ ИмяСправочника = Неопределено И НЕ GUIDСсылка = Неопределено Тогда
		
		НовыйGUID = Новый УникальныйИдентификатор(GUIDСсылка);
		СсылкаМодуль = Справочники[ИмяСправочника].ПолучитьСсылку(НовыйGUID);
		
		Если ЗначениеЗаполнено(СсылкаМодуль) Тогда
			Возврат СсылкаМодуль;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции

Функция ПолучитьСсылкуНаПодключаемыйМодуль() Экспорт
	
	ИмяСправочника = НастройкиПодключаемогоМодуля.ПодключаемыйМодульВидСправочника;
	GUIDСсылка	   = НастройкиПодключаемогоМодуля.ПодключаемыйМодульGUID;
	
	ПодключаемыйМодульСсылка = НастройкиПодключаемогоМодуля.ПодключаемыйМодульСсылка;
	
	Если ЗначениеЗаполнено(ПодключаемыйМодульСсылка) Тогда
		
		Возврат ПодключаемыйМодульСсылка;
		
	ИначеЕсли НЕ ИмяСправочника = Неопределено И НЕ GUIDСсылка = Неопределено Тогда
		
		НовыйGUID = Новый УникальныйИдентификатор(GUIDСсылка);
		СсылкаМодуль = Справочники[ИмяСправочника].ПолучитьСсылку(НовыйGUID);
		
		Если ЗначениеЗаполнено(СсылкаМодуль) Тогда
			Возврат СсылкаМодуль;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ОбновитьКэшПартнеров(РежимРаботы = Неопределено) Экспорт
	
	Если Не РежимРаботы = "Поставщик" И Не РежимРаботы = "Покупатель" Тогда
		
		Если Не ЗначениеЗаполнено(НастройкиМодуля) Тогда
			РежимРаботы = "Поставщик";
		ИначеЕсли НастройкиМодуля.МыПоставщик = Истина Тогда
			РежимРаботы = "Поставщик";
		Иначе
			РежимРаботы = "Покупатель";
		КонецЕсли;
		
	КонецЕсли;	
	
	ДатаВремяОбновленияКэшаПартнеров = ЭДО_Кэш_Прочитать("ДатаВремяОбновленияКэшаПартнеров" + РежимРаботы);
	Если НЕ ДатаВремяОбновленияКэшаПартнеров = Неопределено Тогда
		
		ДатаВремяОбновленияПартнеровКонтрагентов = ПолучитьКонстантуEDI("ДатаВремяОбновленияПартнеровКонтрагентов");
		Если ЗначениеЗаполнено(ДатаВремяОбновленияПартнеровКонтрагентов) Тогда
			
			Если ДатаВремяОбновленияПартнеровКонтрагентов < ДатаВремяОбновленияКэшаПартнеров Тогда
				
				ТаблицаКэшПартнеров = ЭДО_Кэш_Прочитать("ТаблицаКэшПартнеров" + РежимРаботы);
				ТаблицаКэшПартнеровКонтрагентов = ЭДО_Кэш_Прочитать("ТаблицаКэшПартнеровКонтрагентов" + РежимРаботы);
				
				Если НЕ ТаблицаКэшПартнеров = Неопределено И НЕ ТаблицаКэшПартнеров = Неопределено Тогда
					Возврат;		
				КонецЕсли;
			КонецЕсли;
		Иначе
			УстановитьКонстантуEDI("ДатаВремяОбновленияПартнеровКонтрагентов", Формат(ТекущаяДата(),"ДФ=yyyyMMddHHmmss"));
		КонецЕсли;
	КонецЕсли;
	
	ИдентификаторыНастроек = ПолучитьТаблицуИдентификаторовНастроекСообщений().Скопировать();
	
	ДобавитьИдентификаторНастройкиСообщения(ИдентификаторыНастроек, РежимРаботы, "", "НеОтправлять_I_INVOIC");
	ДобавитьИдентификаторНастройкиСообщения(ИдентификаторыНастроек, РежимРаботы, "", "INVOICДоОбработкиRECADV");
	ДобавитьИдентификаторНастройкиСообщения(ИдентификаторыНастроек, РежимРаботы, "", "INVOICНеБлокируетсяПредыдущимиСообщениями");
	ДобавитьИдентификаторНастройкиСообщения(ИдентификаторыНастроек, РежимРаботы, "", "RETDESДоОбработкиRETINS");
	ДобавитьИдентификаторНастройкиСообщения(ИдентификаторыНастроек, РежимРаботы, "", "RETDESНеБлокируетсяПредыдущимиСообщениями");
	
	ЗапросСКэшемПартнеров = ИнициализироватьЗапрос_КонтурEDI(ВнешнееХранилище);
	ЗапросСКэшемПартнеров.Текст = 
	"ВЫБРАТЬ
	|	ИдентификаторыНастроек.ТипСообщения КАК ТипСообщения,
	|	ИдентификаторыНастроек.ИдентификаторНастройки КАК ИдентификаторНастройки
	|ПОМЕСТИТЬ ВТ_ИдентификаторыНастроекСообщений
	|ИЗ
	|	&ИдентификаторыНастроек КАК ИдентификаторыНастроек
	|ГДЕ
	|	ИдентификаторыНастроек.РежимРаботы = &РежимРаботы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтурEDI_ДополнительныеСправочники.Ссылка
	|ПОМЕСТИТЬ ВТ_Партнеры
	|ИЗ
	|	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
	|ГДЕ
	|	КонтурEDI_ДополнительныеСправочники.ИмяСправочника = ""Партнеры""
	|;
