	Результат.Метод = "GET";
	Результат.Заголовки = Заголовки;
	Результат.Параметры = ПараметрыЗапроса;
	
	Возврат Результат;
	
КонецФункции

Функция Аутентификатор_ЗапросВыйти(Сессия)
	
	Результат = Аутентификатор_МодельЗапрос();
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-Kontur-Apikey", КонфигурацияПриложения.Ключ);
		
	Результат.Хост = КонфигурацияПровайдера.Хост;
	Результат.Ресурс = КонтурСтандарт_СтрШаблон_("/grants/%1|%2/revoke", КонфигурацияПриложения.Имя, Сессия.ПортальныйИд);
	Результат.Метод = "POST";
	Результат.Адрес = КонтурСтандарт_СтрШаблон_("%1%2", Результат.Хост, Результат.Ресурс);
	Результат.Заголовки = Заголовки;
	
	Возврат Результат;
	
КонецФункции

