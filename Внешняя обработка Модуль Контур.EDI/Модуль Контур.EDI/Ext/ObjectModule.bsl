//возвращает товары за период
Функция Анализ_СформироватьИсходныеДанныеСервер(ДатаС,ДатаПо,ОтборПоДатеПоставки=Ложь) Экспорт
	
	ДлительнаяОперация_Начать();

	ДатаПо = КонецДня(ДатаПо);

	//Для начала соберем только заказы
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КонтурEDI_Сообщения.ТипСообщения,
	               |	КонтурEDI_Сообщения.Направление,
	               |	КонтурEDI_Сообщения.НомерДокумента,
	               |	КонтурEDI_Сообщения.ДатаДокумента,
	               |	КонтурEDI_Сообщения.НомерЗаказа,
	               |	КонтурEDI_Сообщения.ДатаЗаказа,
	               |	КонтурEDI_Сообщения.ДатаПоставки,
	               |	КонтурEDI_Сообщения.ТочкаДоставки,
	               |	КонтурEDI_Сообщения.Партнер,
	               |	КонтурEDI_Сообщения.Статус,
	               |	МАКСИМУМ(КонтурEDI_Сообщения.Ссылка) КАК Ссылка,
	               |	КонтурEDI_Сообщения.Организация,
	               |	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) КАК Номенклатура,
	               |	0 КАК Количество,
	               |	0 КАК ЦенаБезНДС,
	               |	0 КАК СуммаБезНДС,
	               |	0 КАК ЦенаСНДС,
	               |	0 КАК СуммаСНДС,
	               |	КонтурEDI_Сообщения.ТочкаДоставки.АдресДоставки КАК АдресДоставки
	               |ИЗ
	               |	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	               |ГДЕ
	               |	НЕ КонтурEDI_Сообщения.ПометкаУдаления
	               |	И НЕ КонтурEDI_Сообщения.ТипСообщения ПОДОБНО ""#""
	               |	И НЕ КонтурEDI_Сообщения.ОтклоненоОтправителем
	               |	И КонтурEDI_Сообщения.ДатаЗаказа МЕЖДУ &ДатаОт И &ДатаПо
	               |	И КонтурEDI_Сообщения.ТипСообщения = ""ORDERS""
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	КонтурEDI_Сообщения.ТипСообщения,
	               |	КонтурEDI_Сообщения.Направление,
	               |	КонтурEDI_Сообщения.НомерДокумента,
	               |	КонтурEDI_Сообщения.ДатаДокумента,
	               |	КонтурEDI_Сообщения.НомерЗаказа,
	               |	КонтурEDI_Сообщения.ДатаЗаказа,
	               |	КонтурEDI_Сообщения.ДатаПоставки,
	               |	КонтурEDI_Сообщения.ТочкаДоставки,
	               |	КонтурEDI_Сообщения.Партнер,
	               |	КонтурEDI_Сообщения.Статус,
	               |	КонтурEDI_Сообщения.Организация,
	               |	КонтурEDI_Сообщения.ТочкаДоставки.АдресДоставки";
	
	Если ОтборПоДатеПоставки = истина Тогда
		Запрос.Текст = 	СтрЗаменить(Запрос.Текст, "И КонтурEDI_Сообщения.ДатаЗаказа", "И КонтурEDI_Сообщения.ДатаПоставки");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДатаОт",ДатаС );
	Запрос.УстановитьПараметр("ДатаПо",ДатаПо);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ИзвлеченныеДанные = Новый ТаблицаЗначений;
	ИзвлеченныеДанные.Колонки.Добавить("ЕдиницаИзмерения",Новый ОписаниеТипов(ПолучитьТипЗначенияОбъекта("ЕдиницаИзмерения")));
	
	Для Каждого КолонкаТаблицы Из РезультатЗапроса.Колонки Цикл 
		ИзвлеченныеДанные.Колонки.Добавить(КолонкаТаблицы.Имя, КолонкаТаблицы.ТипЗначения);	
	КонецЦикла;
	
	Пока Выборка.Следующий() Цикл
		//Достаем из хранилища сообщение
		Сообщение = ПрочитатьСообщение(Выборка.Ссылка);
		ТоварыЗаказа = Сообщение.Товары;
		Если ТоварыЗаказа <> Неопределено Тогда 
			
			КонвертироватьТабличнуюЧастьСообщенияEDIв1С(Сообщение, "Товары");
			ТоварыЗаказа = Сообщение.Товары;
			
			Для Каждого ЗаказаннаяПозиция Из ТоварыЗаказа Цикл
				НоваяСтрокаДанных=ИзвлеченныеДанные.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаДанных,Выборка);
				ЗаполнитьЗначенияСвойств(НоваяСтрокаДанных,ЗаказаннаяПозиция,"Номенклатура,ЕдиницаИзмерения,Количество,ЦенаБезНДС,СуммаБезНДС,ЦенаСНДС,СуммаСНДС");
			КонецЦикла;
			
		ИНаче
			НоваяСтрокаДанных = ИзвлеченныеДанные.Добавить();
			НоваяСтрокаДанных.Партнер = "Ошибка чтения товаров заказа: "+Сообщение.ДокументEDI.Номер;
		КонецЕсли;
	КонецЦикла;
	
	ИзвлеченныеДанные.Сортировать("Номенклатура Убыв, ДатаПоставки Возр");
	
	ДлительнаяОперация_Завершить();

	Возврат ИзвлеченныеДанные;
	
КонецФункции // СформироватьИсходныеДанныеСервер()

//Преобразовывает товары сообщения в основные соответствия для отчетности
Процедура Анализ_ПреобразоватьТоварыВОсновныеСоответствия(ТоварыЗаказа,Сообщение) Экспорт
	
	ТаблицаТоваров = ТоварыЗаказа.Скопировать(,"GTIN, КодТовараПокупателя, КодТовараПоставщика,КодЕдиницыИзмеренияEDI");
		
		//+махинация
		ТаблицаТоваров.Колонки.Добавить("КодЕдиницыИзмеренияEDI_нов", ОписаниеТипаСтрока_КонтурEDI(3));
		ТаблицаТоваров.ЗагрузитьКолонку(ТаблицаТоваров.ВыгрузитьКолонку("КодЕдиницыИзмеренияEDI"),"КодЕдиницыИзмеренияEDI_нов");
		ТаблицаТоваров.Колонки.Удалить("КодЕдиницыИзмеренияEDI");
		ТаблицаТоваров.Колонки.КодЕдиницыИзмеренияEDI_Нов.Имя = "КодЕдиницыИзмеренияEDI";
		//-махинация
		
		ИмяКодТовараПокупателя = "КодТовараСторонний";
		ИмяКодТовараПоставщика = "КодТовараСвой";

		ТаблицаТоваров.Колонки.КодТовараПокупателя.Имя = ИмяКодТовараПокупателя;
		ТаблицаТоваров.Колонки.КодТовараПоставщика.Имя = ИмяКодТовараПоставщика;
		
		ТаблицаСоответствий = КонвертироватьТоварыEDIв1С(ТаблицаТоваров,Сообщение); // передаем сообщения, т.к. поиск номенклатуры может зависеть от полей шапки (контрагента, договора и проч.)

		//теперрь переустановим номенклатуру
		ТоварыЗаказа.Индексы.Добавить("GTIN, КодТовараПокупателя, КодТовараПоставщика");
		
		Для Каждого Стр Из ТаблицаСоответствий Цикл
			Если ЗначениеЗаполнено(Стр.Номенклатура) Тогда
				СтруктураОтбора = Новый Структура;
				СтруктураОтбора.Вставить("GTIN",				Стр.GTIN);
				СтруктураОтбора.Вставить("КодТовараПокупателя",	Стр.КодТовараСторонний);
				СтруктураОтбора.Вставить("КодТовараПоставщика",	Стр.КодТовараСвой);
				
				НайденныеСтроки = ТоварыЗаказа.НайтиСтроки(СтруктураОтбора);
				Для Каждого СтрокаТоваров Из НайденныеСтроки Цикл
					
					СтрокаТоваров.Номенклатура					= Стр.Номенклатура;
					СтрокаТоваров.ХарактеристикаНоменклатуры	= Неопределено;
					СтрокаТоваров.ЕдиницаИзмерения				= Неопределено;
					
					Если ЗначениеЗаполнено(Стр.ХарактеристикаНоменклатуры) Тогда
						СтрокаТоваров.ХарактеристикаНоменклатуры	= Стр.ХарактеристикаНоменклатуры;
					КонецЕсли;
					
					Если ЗначениеЗаполнено(Стр.ЕдиницаИзмерения) Тогда
						СтрокаТоваров.ЕдиницаИзмерения				= Стр.ЕдиницаИзмерения;
					КонецЕсли;
					
					//СтрокаТоваров.КоэффициентEDIВ1С				= Стр.КоэффициентEDIВ1С;
					//код единицы измерения мы можем взять и из входящего сообщения. А коэффициент - только из 1С.
					
				КонецЦикла;		
			КонецЕсли;
		КонецЦикла;		
		
		
		//теперь еще рассчитать недостающие значения
	Для Каждого СтрокаТоваров из ТоварыЗаказа Цикл	
		ЗаполнитьНедостающиеПоляСтрокиТоваров(СтрокаТоваров);
	КонецЦикла;
	
КонецПроцедуры

// за указанный период по !!ДАТЕ ЗАКАЗА!! обновляет регистр статистики
Процедура Отчетность_ПересчитатьСтатистикуSLСервер(ДатаС, ДатаПо) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_Сообщения.Ссылка
	|ПОМЕСТИТЬ СообщенияВИнтервале
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|ГДЕ
	|	КонтурEDI_Сообщения.ДатаЗаказа МЕЖДУ &ДатаС И &ДатаПо
	|	И КонтурEDI_Сообщения.ТипСообщения В(&ВсеТипыСообщенийСтатистики)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	КонтурEDI_Сообщения.НомерЗаказа
	|ПОМЕСТИТЬ НомераЗаказов
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|ГДЕ
	|	КонтурEDI_Сообщения.ДатаЗаказа МЕЖДУ &ДатаС И &ДатаПо
	|	И КонтурEDI_Сообщения.ТипСообщения = ""ORDERS""
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_Сообщения.Ссылка,
	|	КонтурEDI_Сообщения.НомерЗаказа
	|ПОМЕСТИТЬ ПриемкиСПустойДатойЗаказаОтбор
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|ГДЕ
	|	КонтурEDI_Сообщения.ТипСообщения = ""RECADV""
	|	И КонтурEDI_Сообщения.ДатаЗаказа = &ПустаяДатаЗаказа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПриемкиСПустойДатойЗаказаОтбор.Ссылка
	|ПОМЕСТИТЬ ПриемкиСПустойДатойЗаказа
	|ИЗ
	|	НомераЗаказов КАК НомераЗаказов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПриемкиСПустойДатойЗаказаОтбор КАК ПриемкиСПустойДатойЗаказаОтбор
	|		ПО НомераЗаказов.НомерЗаказа = ПриемкиСПустойДатойЗаказаОтбор.НомерЗаказа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурEDI_Сообщения.Ссылка
	|ПОМЕСТИТЬ СообщенияБезДатыИНомераЗаказа
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|ГДЕ
	|	КонтурEDI_Сообщения.ДатаЗаказа = &ПустаяДатаЗаказа
	|	И КонтурEDI_Сообщения.НомерЗаказа = &ПустойНомерЗаказа
	|	И КонтурEDI_Сообщения.ТипСообщения В(&ТипыСообщенийБезORDERS)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Статистика.СообщениеСсылка КАК Ссылка
	|ПОМЕСТИТЬ СообщенияСРешеткой
	|ИЗ
	|	РегистрСведений.КонтурEDI_Статистика КАК Статистика
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_Сообщения КАК Сообщения
	|		ПО Статистика.СообщениеСсылка = Сообщения.Ссылка
	|			И (Статистика.ДатаЗаказа МЕЖДУ &ДатаС И &ДатаПо)
	|			И (НЕ Статистика.ТипСообщения = Сообщения.ТипСообщения)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СообщенияВИнтервале.Ссылка
	|ИЗ
	|	СообщенияВИнтервале КАК СообщенияВИнтервале
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПриемкиСПустойДатойЗаказа.Ссылка
	|ИЗ
	|	ПриемкиСПустойДатойЗаказа КАК ПриемкиСПустойДатойЗаказа
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СообщенияСРешеткой.Ссылка
	|ИЗ
	|	СообщенияСРешеткой КАК СообщенияСРешеткой
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СообщенияБезДатыИНомераЗаказа.Ссылка
	|ИЗ
	|	СообщенияБезДатыИНомераЗаказа КАК СообщенияБезДатыИНомераЗаказа";
	
	Запрос.УстановитьПараметр("ДатаС", ДатаС);
	Запрос.УстановитьПараметр("ДатаПо", ДатаПо);
	Запрос.УстановитьПараметр("ВсеТипыСообщенийСтатистики", МассивТиповСообщенийEDIДляОтраженияСтатистики());
	
	ТипыСообщенийБезORDERS = Новый Массив;
	ТипыСообщенийБезORDERS.Добавить("ORDRSP");
	ТипыСообщенийБезORDERS.Добавить("DESADV");
	ТипыСообщенийБезORDERS.Добавить("RECADV");
	
	Запрос.УстановитьПараметр("ТипыСообщенийБезORDERS", ТипыСообщенийБезORDERS);
	Запрос.УстановитьПараметр("ПустойНомерЗаказа", "");
	Запрос.УстановитьПараметр("ПустаяДатаЗаказа", Дата(1, 1, 1));
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	СообщенияДляОбработки = Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ПараметрыОтраженияСтатистики = Отчетность_ПараметрыОтраженияСтатистики();
	Отчетность_ЗаполнитьПараметрыОтраженияСтатистики(ПараметрыОтраженияСтатистики);
	
	ИдентификаторыВиртуальныхСообщений = Отчетность_ПолучитьИдентификаторыВиртуальныхORDERS(СообщенияДляОбработки);
	ИдентификаторыОбработанныхСообщений = Новый Массив;
	
	Сч = 1;
	Всего = СообщенияДляОбработки.Количество();
	
	Для каждого Сообщение Из СообщенияДляОбработки Цикл
		
		#Если Клиент Тогда
			Состояние("Рассчитываю статистику за интервал. Сообщение " + Сч + " из " + Всего);
			Сч = Сч + 1;
		#КонецЕсли
		
		Если Не ИдентификаторыОбработанныхСообщений.Найти(Сообщение.ID) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ИдентификаторыОбработанныхСообщений.Добавить(Сообщение.ID);
		
		СообщениеОбъект = Сообщение.ПолучитьОбъект();
		
		ПараметрыОтраженияСтатистики.ЕстьВиртуальныеORDERS = Не ИдентификаторыВиртуальныхСообщений.Найти(СообщениеОбъект.ID) = Неопределено;
		
		Отчетность_ОтразитьСтатистикуСообщения(СообщениеОбъект, ПараметрыОтраженияСтатистики);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Отчетность_ОтразитьСтатистикуСообщения(СообщениеОбъект, ПараметрыОтраженияСтатистики) Экспорт
	
	Если СокрЛП(СообщениеОбъект.НомерЗаказа) = "" 
		ИЛИ СообщениеОбъект.ДатаЗаказа = Дата(1, 1, 1) Тогда
		
		Отчетность_РозыскНомераЗаказаСообщения(СообщениеОбъект); 
		
	КонецЕсли;
	
	Если ПеременнаяСодержитСвойство(ПараметрыОтраженияСтатистики, "ЕстьВиртуальныеORDERS")
			И ПараметрыОтраженияСтатистики.ЕстьВиртуальныеORDERS = Истина Тогда
			
		Отчетность_ОтразитьСтатистикуВиртуальногоСообщения(СообщениеОбъект, ПараметрыОтраженияСтатистики);
		
	Иначе
	
		НаборЗаписей = РегистрыСведений.КонтурEDI_Статистика.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.СообщениеСсылка.Установить(СообщениеОбъект.Ссылка);
		
		СообщениеСтруктура = СообщениеОбъект.Хранилище.Получить();
		
		Если СообщениеСтруктура <> Неопределено
			И ПеременнаяСодержитСвойство(СообщениеСтруктура, "Товары", , Истина)
			И СообщениеСтруктура.Товары.Количество() <> 0 Тогда  
			
			Отчетность_ЗаполнитьЗаписиНабораПоСообщению(НаборЗаписей, 
														СообщениеОбъект, 
														СообщениеСтруктура, 
														ПараметрыОтраженияСтатистики);
			
		КонецЕсли;
		
		ЗамещатьСуществующиеЗаписи = Истина;
		НаборЗаписей.Записать(ЗамещатьСуществующиеЗаписи);
		
		// удалим признак неотраженной статистики
		НайденнаяСтрока = СообщениеОбъект.ДополнительныеРеквизиты.Найти("НеОтраженаСтатистика", "ИмяРеквизита");
		Если НЕ НайденнаяСтрока = Неопределено Тогда
			СообщениеОбъект.ДополнительныеРеквизиты.Удалить(НайденнаяСтрока);
			СообщениеОбъект.Записать();
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

Процедура Отчетность_ОтразитьСтатистикуВиртуальногоСообщения(СообщениеОбъект, ПараметрыОтраженияСтатистики)
	
	Отчетность_ОчиститьСтатистикуПоВиртуальнымСообщениям(СообщениеОбъект.ID, 
														 СообщениеОбъект.ТипСообщения);

	Отчетность_СоздатьЗаписиРегистраПоВиртуальнымСообщениям(СообщениеОбъект, 
															СообщениеОбъект.Хранилище.Получить(), 
															ПараметрыОтраженияСтатистики);
															
	Отчетность_УдалитьПризнакНеотраженнойСтатистикиПоВиртуальнымСообщениям(СообщениеОбъект.ID, 
																		   СообщениеОбъект.ТипСообщения);
															
КонецПроцедуры

Процедура Отчетность_ОчиститьСтатистикуПоВиртуальнымСообщениям(ИдентификаторСообщения, ТипСообщения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	КонтурEDI_Сообщения.Ссылка
		               |ИЗ
		               |	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
		               |ГДЕ
		               |	КонтурEDI_Сообщения.ID = &ID
		               |	И КонтурEDI_Сообщения.ТипСообщения = &ТипСообщения";
	Запрос.УстановитьПараметр("ID", ИдентификаторСообщения);
	Запрос.УстановитьПараметр("ТипСообщения", ТипСообщения);
	Результат = Запрос.Выполнить();
		
	Если Не Результат.Пустой() Тогда
		
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			НаборЗаписей = РегистрыСведений.КонтурEDI_Статистика.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.СообщениеСсылка.Установить(Выборка.Ссылка);
			НаборЗаписей.Записать();
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Отчетность_УдалитьПризнакНеотраженнойСтатистикиПоВиртуальнымСообщениям(ИдентификаторСообщения, ТипСообщения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка
	               |ИЗ
	               |	Справочник.КонтурEDI_Сообщения.ДополнительныеРеквизиты КАК КонтурEDI_СообщенияДополнительныеРеквизиты
	               |ГДЕ
	               |	КонтурEDI_СообщенияДополнительныеРеквизиты.ИмяРеквизита = ""НеОтраженаСтатистика""
	               |	И КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка.ТипСообщения = &ТипСообщения
				   |	И КонтурEDI_СообщенияДополнительныеРеквизиты.Ссылка.ID = &ID";
	
	Запрос.УстановитьПараметр("ID", 		  ИдентификаторСообщения);
	Запрос.УстановитьПараметр("ТипСообщения", ТипСообщения);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;	
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СообщениеДляОтраженияСтатистики = Выборка.Ссылка.ПолучитьОбъект();
		НайденнаяСтрока = СообщениеДляОтраженияСтатистики.ДополнительныеРеквизиты.Найти("НеОтраженаСтатистика", "ИмяРеквизита");
		СообщениеДляОтраженияСтатистики.ДополнительныеРеквизиты.Удалить(НайденнаяСтрока);
		СообщениеДляОтраженияСтатистики.Записать();
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура Отчетность_РозыскНомераЗаказаСообщения(СообщениеОбъект);

	// Если есть документ 1С - то ищем по нему
	Если ЗначениеЗаполнено(СообщениеОбъект.Документ) Тогда 
		
		СтрокиДерева = ПолучитьСвязанныеСообщения(, СообщениеОбъект.Документ).Строки;
		
		Если СтрокиДерева.Количество() > 0 Тогда 
			
			ОтборЗаказа = Новый Структура;
			ОтборЗаказа.Вставить("ТипСообщения", "ORDERS");
			ОтборЗаказа.Вставить("Вид", "Сообщение");
			
			СтрокиЗаказа = СтрокиДерева.НайтиСтроки(ОтборЗаказа, Истина);
			
			Если СтрокиЗаказа.Количество() > 0 Тогда
				
				СообщениеЗаказСсылка = СтрокиЗаказа[0].Ссылка;
				
				Если ЗначениеЗаполнено(СообщениеЗаказСсылка) Тогда
					
					СообщениеОбъект.НомерЗаказа = СообщениеЗаказСсылка.НомерЗаказа;
					СообщениеОбъект.ДатаЗаказа = СообщениеЗаказСсылка.ДатаЗаказа;
					
				КонецЕсли;
				
			Конецесли;
			
		Конецесли;
		
	КонецЕсли;

КонецПроцедуры

Процедура Отчетность_ЗаполнитьЗаписиНабораПоСообщению(НаборЗаписей, СообщениеОбъект, СообщениеСтруктура, ПараметрыОтраженияСтатистики)
	
	Анализ_ПреобразоватьТоварыВОсновныеСоответствия(СообщениеСтруктура.Товары, СообщениеСтруктура);
	
	СчетчикСтрок = 1; 
	Пользователь1С = ПолучитьТекущегоПользователя1С();
		
	Для Каждого СтрокаТабЧастиСообщения Из СообщениеСтруктура.Товары Цикл
		
		ЗаписьНабора = НаборЗаписей.Добавить();
		
		ПараметрыДобавленияЗаписи = Новый Структура;
		ПараметрыДобавленияЗаписи.Вставить("ЗаписьНабора", ЗаписьНабора);
		ПараметрыДобавленияЗаписи.Вставить("СообщениеОбъект", СообщениеОбъект); 
		ПараметрыДобавленияЗаписи.Вставить("СообщениеСсылка", СообщениеОбъект.Ссылка);
		ПараметрыДобавленияЗаписи.Вставить("Документ1С", СообщениеОбъект.Документ);
		ПараметрыДобавленияЗаписи.Вставить("СтрокаТоваровСообщения", СтрокаТабЧастиСообщения);
		ПараметрыДобавленияЗаписи.Вставить("НомерСтрокиСообщения", СчетчикСтрок);
		ПараметрыДобавленияЗаписи.Вставить("Пользователь1С", Пользователь1С);
		ПараметрыДобавленияЗаписи.Вставить("ПараметрыОтраженияСтатистики", ПараметрыОтраженияСтатистики);
		
		Отчетность_ЗаполнитьЗаписьНабораПоСтрокеТоваров(ПараметрыДобавленияЗаписи);
		
		СчетчикСтрок = СчетчикСтрок + 1;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Отчетность_СоздатьЗаписиРегистраПоВиртуальнымСообщениям(СообщениеОбъект, СообщениеСтруктура, ПараметрыОтраженияСтатистики)
	
	МассивСвязанныхДокументов = Новый Массив;
	
	СообщениеСтруктура.Товары.Колонки.Добавить("Документ");
	СообщениеСтруктура.Товары.Колонки.Добавить("СообщениеСсылка");
	СообщениеСтруктура.Товары.ЗаполнитьЗначения(СообщениеОбъект.Документ, "Документ");
	СообщениеСтруктура.Товары.ЗаполнитьЗначения(СообщениеОбъект.Ссылка, "СообщениеСсылка");

	ТоварыДокументов = СообщениеСтруктура.Товары.Скопировать();
	ТоварыДокументов.Очистить();                  
	
	ТаблицаВиртуальныхСообщений = ПолучитьВиртуальныеСвязанныеORDERS(СообщениеОбъект.Документ);
	
	Для каждого СтрокаВиртуальныхСообщений Из ТаблицаВиртуальныхСообщений Цикл
		
		ВиртуальноеСообщение = СтрокаВиртуальныхСообщений[СообщениеОбъект.ТипСообщения];
		ДокументВиртуальногоСообщения = СтрокаВиртуальныхСообщений.Документ;
		
		Если Не ЗначениеЗаполнено(ВиртуальноеСообщение) ИЛИ Не ЗначениеЗаполнено(ДокументВиртуальногоСообщения) Тогда
			Продолжить;
		КонецЕсли;
		
		ТоварыДокумента = ПолучитьТоварыДокументаДляСообщения(ДокументВиртуальногоСообщения, Истина, "ПодготовкаОтветаНаЗаказ");
		
		Для каждого СтрокаТоваров Из ТоварыДокумента Цикл
			
			СтрокаОбщейТаблицы = ТоварыДокументов.Добавить();
			СтрокаОбщейТаблицы.Документ = ДокументВиртуальногоСообщения;
			СтрокаОбщейТаблицы.СообщениеСсылка = ВиртуальноеСообщение;
			
			ЗаполнитьЗначенияСвойств(СтрокаОбщейТаблицы, СтрокаТоваров);
			
		КонецЦикла;

	КонецЦикла; 
	
	Анализ_ПреобразоватьТоварыВОсновныеСоответствия(СообщениеСтруктура.Товары, СообщениеСтруктура);
	Анализ_ПреобразоватьТоварыВОсновныеСоответствия(ТоварыДокументов, СообщениеСтруктура);
    
	СчетчикСтрокСообщения = 1; 
	Пользователь1С = ПолучитьТекущегоПользователя1С();
	
	Для Каждого СтрокаТоваровСообщения Из СообщениеСтруктура.Товары Цикл
		
		ОтборСтрокДокументов = Новый Структура;
		ОтборСтрокДокументов.Вставить("УИД_СтрокиПервоначальногоСообщения", СтрокаТоваровСообщения.УИД_СтрокиПервоначальногоСообщения);
		
		СтрокиДляЗаписиВРегистр = ТоварыДокументов.НайтиСтроки(ОтборСтрокДокументов);
		
		Если СтрокиДляЗаписиВРегистр.Количество() = 0 Тогда
			СтрокиДляЗаписиВРегистр.Добавить(СтрокаТоваровСообщения);
		КонецЕсли;
		
		Для каждого СтрокаДляЗаписиВРегистр Из СтрокиДляЗаписиВРегистр Цикл
			
			МенеджерЗаписи = РегистрыСведений.КонтурEDI_Статистика.СоздатьМенеджерЗаписи();
			
			ПараметрыДобавленияЗаписи = Новый Структура;
			ПараметрыДобавленияЗаписи.Вставить("ЗаписьНабора", МенеджерЗаписи);
			ПараметрыДобавленияЗаписи.Вставить("СообщениеОбъект", СообщениеОбъект);
			ПараметрыДобавленияЗаписи.Вставить("СообщениеСсылка", СтрокаДляЗаписиВРегистр.СообщениеСсылка);
			ПараметрыДобавленияЗаписи.Вставить("Документ1С", СтрокаДляЗаписиВРегистр.Документ);
			ПараметрыДобавленияЗаписи.Вставить("СтрокаТоваровСообщения", СтрокаТоваровСообщения);
			ПараметрыДобавленияЗаписи.Вставить("НомерСтрокиСообщения", СчетчикСтрокСообщения);
			ПараметрыДобавленияЗаписи.Вставить("Пользователь1С", Пользователь1С);
			ПараметрыДобавленияЗаписи.Вставить("ПараметрыОтраженияСтатистики", ПараметрыОтраженияСтатистики);
			
			Отчетность_ЗаполнитьЗаписьНабораПоСтрокеТоваров(ПараметрыДобавленияЗаписи);
						
			МенеджерЗаписи.Записать(Истина);
			
		КонецЦикла;
		
		СчетчикСтрокСообщения = СчетчикСтрокСообщения + 1;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Отчетность_ЗаполнитьЗаписьНабораПоСтрокеТоваров(ПараметрыДобавленияЗаписи) 
	
	ЗаписьНабора 	 = ПараметрыДобавленияЗаписи.ЗаписьНабора;
	Сообщение		 = ПараметрыДобавленияЗаписи.СообщениеОбъект;
	СообщениеСсылка  = ПараметрыДобавленияЗаписи.СообщениеСсылка;
	Документ1С 		 = ПараметрыДобавленияЗаписи.Документ1С;
	СтрокаТоваров	 = ПараметрыДобавленияЗаписи.СтрокаТоваровСообщения;
	НомерСтроки		 = ПараметрыДобавленияЗаписи.НомерСтрокиСообщения;
	Пользователь1С	 = ПараметрыДобавленияЗаписи.Пользователь1С; 
	
	ПараметрыОтраженияСтатистики = ПараметрыДобавленияЗаписи.ПараметрыОтраженияСтатистики;
	
	ПоляСообщения = "Организация, ТипСообщения, НомерЗаказа, ДатаЗаказа, Партнер, ТочкаДоставки, ДатаПоставки, Направление";
	ПоляСтрокиТоваров = "Номенклатура, Количество, СуммаБезНДС, СуммаСНДС, СуммаНДС, ЦенаБезНДС, ЦенаСНДС";
	
	ЗаполнитьЗначенияСвойств(ЗаписьНабора, Сообщение, ПоляСообщения);
	ЗаполнитьЗначенияСвойств(ЗаписьНабора, СтрокаТоваров, ПоляСтрокиТоваров);
	
	Если ПараметрыОтраженияСтатистики.ЕстьДополнительнаяСтатистикаПоТоварам = Истина Тогда
		
		ЗаполнитьЗначенияСвойств(ЗаписьНабора, СтрокаТоваров, "КодТовараПоставщика, КодТовараПокупателя, GTIN, Наименование, ЕдиницаИзмерения");
		ЗаписьНабора.ЕдиницаEDI = СтрокаТоваров.КодЕдиницыИзмеренияEDI;
		
	КонецЕсли;
	
	ЗаписьНабора.СообщениеСсылка 	 = СообщениеСсылка;
	ЗаписьНабора.Документ1С 	 	 = Документ1С; 
    ЗаписьНабора.СтатусСтрокиТоваров = СтрокаТоваров.Статус;	
	ЗаписьНабора.НомерСтрокиТоваров  = НомерСтроки;
	ЗаписьНабора.Пользователь 		 = Пользователь1С;
	ЗаписьНабора.ДатаЗаписи 		 = ТекущаяДата();
	
	Статус = Сообщение.Статус;
	Если Статус = "Исходящее прошло проверку" Тогда
		Статус = "Доставлен";
	КонецЕсли;
	
	ЗаписьНабора.Статус = Статус;
	
КонецПроцедуры

