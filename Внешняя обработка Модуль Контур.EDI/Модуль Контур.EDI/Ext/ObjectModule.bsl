Функция ПодключитьВнешнююКомпоненту_КонтурEDI(ИмяКомпоненты, Местоположение = Неопределено, ТипВнешнейКомпонентыКонтурEDI = Неопределено, ТипПодключенияКомпонентыКонтурEDI = Неопределено) Экспорт
	
	Результат = Неопределено;
	СистемнаяИнформация = Новый СистемнаяИнформация;
	
	Платформа_8_1 = (Лев(СистемнаяИнформация.ВерсияПриложения, 3) = "8.1"
		ИЛИ Лев(СистемнаяИнформация.ВерсияПриложения, 1) = "1");
		
	Если Платформа_8_1 = Истина Тогда
		Попытка
			Выполнить("ПодключитьВнешнююКомпоненту("""+ИмяКомпоненты+""");");
			Возврат Истина;
		Исключение
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;
	
	Если Местоположение = Неопределено Тогда
		Возврат ПодключитьВнешнююКомпоненту(ИмяКомпоненты);
	КонецЕсли;
	
	Если Не ТипВнешнейКомпонентыКонтурEDI = Неопределено И ТипЗнч(ТипВнешнейКомпонентыКонтурEDI) = Тип("Строка") Тогда
		ТипВнешнейКомпонентыКонтурEDI = ТипВнешнейКомпоненты[ТипВнешнейКомпонентыКонтурEDI];
	КонецЕсли;
	
	//Начиная с платформы 8.3.21
	Если ТипПодключенияКомпонентыКонтурEDI = Неопределено Тогда
		Попытка
			ТипПодключенияКомпонентыКонтурEDI = Вычислить("ТипПодключенияВнешнейКомпоненты.НеИзолированно");
		Исключение
			ТипПодключенияКомпонентыКонтурEDI = Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Если ТипПодключенияКомпонентыКонтурEDI = Неопределено Тогда
		ТекстПодключенияКомпоненты = "ПодключитьВнешнююКомпоненту(Местоположение, ИмяКомпоненты, ТипВнешнейКомпонентыКонтурEDI)";
	Иначе
		ТекстПодключенияКомпоненты = "ПодключитьВнешнююКомпоненту(Местоположение, ИмяКомпоненты, ТипВнешнейКомпонентыКонтурEDI, ТипПодключенияКомпонентыКонтурEDI)";
	КонецЕсли;
	
	Возврат Вычислить(ТекстПодключенияКомпоненты);
	
КонецФункции

//готовит текстовый файл с основными настройками модуля для отправки на диагностику
Функция ПодготовитьФайлНастроекМодуля()  Экспорт
	
	Перем ПутьКФайлуНастроек;
	
	Попытка
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтурEDI_ДополнительныеРеквизиты.Свойство КАК ИмяСвойства	
		|ИЗ
		|	РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеРеквизиты
		|ГДЕ
		|	КонтурEDI_ДополнительныеРеквизиты.Объект = НЕОПРЕДЕЛЕНО
		|
		|УПОРЯДОЧИТЬ ПО
		|	ИмяСвойства";
		
		СписокИменСвойств = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИмяСвойства");
		
		СписокЗначенийСвойствКонтурEDI = ПолучитьСписокСвойствEDI(СписокИменСвойств);
		
		// удаляем свойства которые не нужно передавать
		ИсключаемыеСвойства = "ЛогинСлужебныйДиадок,ПарольСлужебныйДиадок";
		Для Каждого ИсключаемоеСвойство Из КонтурСтандарт_РазложитьСтрокуВМассивСлов(ИсключаемыеСвойства, ",") Цикл
			СписокЗначенийСвойствКонтурEDI.Удалить(ИсключаемоеСвойство);	
		КонецЦикла;
		
		//создадим файл
		ПутьКФайлуНастроек = КаталогВременныхФайлов() + "КонтурEDI_НастройкиМодуля.txt";
		
		Текст = Новый ТекстовыйДокумент;
		
		Текст.ДобавитьСтроку("Информация об 1С");
		
		Текст.ДобавитьСтроку("	Конфигурация = " + Метаданные.Синоним);
		Текст.ДобавитьСтроку("	Версия = " + Метаданные.Версия);
		
		Текст.ДобавитьСтроку("Информация о модуле:");
		
		Текст.ДобавитьСтроку("	Версия = " + ОписаниеВерсииСтрокойСОсобенностями_КонтурEDI());
		Текст.ДобавитьСтроку("	ВариантХраненияДанных = " + ?(ВнешнееХранилище, "ВнешнееХранилище", "СвоиОбъекты"));
		
		Текст.ДобавитьСтроку("Настройки модуля:");
		
		Для каждого КлючЗначение из СписокЗначенийСвойствКонтурEDI Цикл
			
			ИмяСвойства 		= КлючЗначение.Ключ;
			ЗначениеСвойства 	= КлючЗначение.Значение;
			
			Текст.ДобавитьСтроку("	" + ИмяСвойства + " = " + СокрЛП(ЗначениеСвойства));
			
		КонецЦикла;
		
		Текст.Записать(ПутьКФайлуНастроек);
		
	Исключение
		
		ТекстОшибки = НСтр("ru = 'Не удалось получить путь к файлу настроек модуля по причине: '");
		
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки + ОписаниеОшибки());
		
	КонецПопытки;
	
	Возврат ПутьКФайлуНастроек;
	
КонецФункции

Функция ДоступныеРежимыРаботы() Экспорт
	
	ДоступныеРежимыРаботы = Новый Структура;
	ДоступныеРежимыРаботы.Вставить("Поставщик", Ложь);
	ДоступныеРежимыРаботы.Вставить("Покупатель", Ложь);
	
	ШаблонПоставщик = СокрЛП(ПолучитьКонстантуEDI("ШаблонЦепочкиДокументов_Поставщик"));
	ШаблонПокупатель = СокрЛП(ПолучитьКонстантуEDI("ШаблонЦепочкиДокументов_Покупатель"));
	
	Если НастройкиМодуля.МыПоставщик И ЗначениеЗаполнено(ШаблонПоставщик) Тогда
		ДоступныеРежимыРаботы.Поставщик = Истина;
	КонецЕсли;
	
	Если НастройкиМодуля.МыТорговаяСеть И ЗначениеЗаполнено(ШаблонПокупатель) Тогда
		ДоступныеРежимыРаботы.Покупатель = Истина;
	КонецЕсли;
	
	Возврат ДоступныеРежимыРаботы;
	
КонецФункции

Процедура ПереключитьРежимНаДоступныйПриНеобходимости(РежимРаботы) Экспорт
	
	ДоступныеРежимыРаботы = ДоступныеРежимыРаботы();
	
	Если Не ПеременнаяСодержитСвойство(ДоступныеРежимыРаботы, РежимРаботы) Тогда
		РежимРаботы = "Поставщик";
	КонецЕсли;
	
	Если Не ДоступныеРежимыРаботы[РежимРаботы] = Истина Тогда	
		
		РежимРаботы = "Неизвестно";
		
		Для каждого КлючЗначение Из ДоступныеРежимыРаботы Цикл
			Если КлючЗначение.Значение = Истина Тогда
				РежимРаботы = КлючЗначение.Ключ;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ТекущийВариантИнтерфейсаКлиентскогоПриложения_КонтурEDI()
	
	ВерсияПлатформы1С = ПараметрыКлиентСервер.ВерсияПлатформы1С;
			
	КлиентскоеПриложение_ТекущийВариантИнтерфейса = Неопределено;
	
	Если КонтурСтандарт_ВерсияПлатформыНеНижеУказанной("8.3.10") Тогда
		
		КлиентскоеПриложение_ТекущийВариантИнтерфейса = Вычислить("КлиентскоеПриложение.ТекущийВариантИнтерфейса()");
		
	ИначеЕсли КонтурСтандарт_ВерсияПлатформыНеНижеУказанной("8.3.3") Тогда
		
		КлиентскоеПриложение_ТекущийВариантИнтерфейса = Вычислить("ТекущийВариантИнтерфейсаКлиентскогоПриложения()");
		
	КонецЕсли;		
	
	ВариантыИнтерфейсаКлиентскогоПриложения = ПеречисленияEDI_ВариантыИнтерфейсаКлиентскогоПриложения();
	
	Возврат ВариантыИнтерфейсаКлиентскогоПриложения.Получить(КлиентскоеПриложение_ТекущийВариантИнтерфейса);
			
КонецФункции

// РАБОТА С ДИАДОКОМ

//Блок работы через компоненту dll  
//Устарела. Используется сейчас только для Отчета по Сверке на Обычных формах
Процедура ИнициализироватьРаботуСДиадоком() Экспорт
	
	КомпонентаDiadocInvoiceAPI = ПолучитьВнешнююКомпонентуDiadocInvoiceAPI();
	
    // и дадим все нужные настройки/объекты модулю
	Если НЕ КомпонентаDiadocInvoiceAPI = Неопределено Тогда
		
		РаботаССерверомДиадок.Используется = Истина;
		
		// создание объекта контекста API
		ДиадокАПИ = КомпонентаDiadocInvoiceAPI.CreateObject();
		
		//Задаем параметры подлючения к серверу
		ДиадокАПИ.ApiClientId = API_КлючРазработчика_Диадок();
		ДиадокАПИ.ServerUrl   = ДиадокСерверAPI() + ":443";
		
		РаботаССерверомДиадок.АПИ = ДиадокАПИ;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьВнешнююКомпонентуDiadocInvoiceAPI()
	
	Попытка
		ВнешняяКомпонента = Новый("AddIn.DiadocInvoiceAPI");
		Возврат ВнешняяКомпонента;
	Исключение
		КомментарийЗаписи = "Не удалось инициализировать компоненту для работы с Диадок, попытка подключения... " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Информация, КомментарийЗаписи);	
	КонецПопытки;	
	
	ИнформацияОСистеме = Новый СистемнаяИнформация;
	
	ЭтоLinux = (Найти(Строка(ИнформацияОСистеме.ТипПлатформы), "Linux" ) <> 0);
	
	Если ЭтоLinux = Истина Тогда
		ВызватьИсключение "Не реализовано на Linux.";
	КонецЕсли;			
	
	ЭтоX64 = (Найти(Строка(ИнформацияОСистеме.ТипПлатформы), "64" ) <> 0);
	
	Если ЭтоX64 = Истина Тогда
		КраткоеИмяДиадок = "Diadoc_latest_x64";
	Иначе
		КраткоеИмяДиадок = "Diadoc_latest";
	КонецЕсли;	
		
	Сообщить_КонтурEDI("Загрузка компоненты Диадок с сервера...");
	ДвоичныеДанныеФайла = ПолучитьФайл_EDI("/1c/support/" + КраткоеИмяДиадок + ".zip");
	
	Если ДвоичныеДанныеФайла = Неопределено Тогда
		ТекстОшибки = "Не удалось загрузить компоненту для работы с Диадок с сервера.";
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);	
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	ИмяВременногоФайлаАрхива = КаталогВременныхФайлов() + КраткоеИмяДиадок + ".zip";
	
	ДвоичныеДанныеФайла.Записать(ИмяВременногоФайлаАрхива);
	Зип = Новый ЧтениеZipФайла(ИмяВременногоФайлаАрхива);
	Эл 	= Зип.Элементы[0];
	
	ИмяВременногоФайлаКомпоненты = КаталогВременныхФайлов() + Эл.ПолноеИмя;
	ФайлКомпоненты = Новый Файл(ИмяВременногоФайлаКомпоненты);
	
	Если НЕ ФайлКомпоненты.Существует() Тогда
		Зип.Извлечь(Эл, КаталогВременныхФайлов());
	КонецЕсли;
	
	УдалитьФайлы(ИмяВременногоФайлаАрхива);
	
	ПодключениеВыполнено = Ложь;
	
	Попытка
		ЗагрузитьВнешнююКомпоненту(ИмяВременногоФайлаКомпоненты);
		ПодключениеВыполнено = ПодключитьВнешнююКомпоненту_КонтурEDI("AddIn.DiadocInvoiceAPI");
	Исключение
		ТекстОшибки = "Не удалось подключить компоненту для работы с Диадок - " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);	
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	
	ВнешняяКомпонента = Новый("AddIn.DiadocInvoiceAPI");
	
	Возврат ВнешняяКомпонента;
		
КонецФункции

//Устарела. Используется сейчас только для Отчета по Сверке на Обычных формах
Функция УстановитьСоединениеСДиадокомПоЛогину(Логин,Пароль)
	
	Если НЕ РаботаССерверомДиадок.Используется Тогда
		ИнициализироватьРаботуСДиадоком();
	КонецЕсли;
	
	Если НЕ РаботаССерверомДиадок.Используется Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		ДиадокСоединение = РаботаССерверомДиадок.АПИ.CreateConnectionByLogin(Логин,Пароль);
		РаботаССерверомДиадок.Соединение = ДиадокСоединение;         
	Исключение
		РаботаССерверомДиадок.Используется = Ложь;
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

//Устарела. Используется сейчас только для Отчета по Сверке на Обычных формах
Функция УстановитьСоединениеСДиадокомПоУмолчанию(ВыводитьПредупреждения = Истина) Экспорт
	
	Если РаботаССерверомДиадок.Используется Тогда
		Возврат Истина;
	КонецЕсли;
	
	Логин = ПараметрыПользователяEDI.ЛогинСлужебныйДиадок;
	Пароль = ПараметрыПользователяEDI.ПарольСлужебныйДиадок;
	
	Если ЗначениеЗаполнено(Логин) и ЗначениеЗаполнено(Пароль) Тогда
		Если УстановитьСоединениеСДиадокомПоЛогину(Логин,Пароль) Тогда
			Возврат Истина;
		Иначе
			Если ВыводитьПредупреждения Тогда
				ВывестиПредупреждение_КонтурEDI("Не удалось установить соединение с Диадоком! 
				|Проверьте параметры подключения в настройках модуля на вкладке ЭДО (Диадок).");
			КонецЕсли;
		КонецЕсли;	
	Иначе
		Если ВыводитьПредупреждения Тогда
			ВывестиПредупреждение_КонтурEDI("Не указаны параметры подключения к Диадоку! 
			|Введите логин и пароль в меню настроек на вкладке ЭДО (Диадок).");
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции
