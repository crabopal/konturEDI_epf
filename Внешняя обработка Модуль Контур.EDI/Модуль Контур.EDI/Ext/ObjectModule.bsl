Функция ПолучитьМакетыПечатныхФорм_КонтурEDI(ГдеПолучитьМакет = Неопределено)
			
	Если ГдеПолучитьМакет = Неопределено Тогда
		ГдеПолучитьМакет = Новый Структура("ВнешнийМодуль, МакетССервера, МакетОбработки");		
	КонецЕсли;     	
	                               
	Кэшировать 	= Истина;
	
	Для каждого Эл Из ГдеПолучитьМакет Цикл
		
		ИскатьНаСервере 		= Эл.Ключ = "МакетССервера";
		ИскатьВОсновномМодуле 	= Эл.Ключ = "МакетОбработки";
	 	ИскатьВоВнешнемМодуле 	= Эл.Ключ = "ВнешнийМодуль";
		
		Макет = ПолучитьМакет_КонтурEDI("ПечатныеФормы_КонтурEDI", "xml", Кэшировать, ИскатьНаСервере, ИскатьВОсновномМодуле, ИскатьВоВнешнемМодуле);
		
		ГдеПолучитьМакет.Вставить(Эл.Ключ, Макет);
		
	КонецЦикла;
	
	Возврат ГдеПолучитьМакет;

КонецФункции

Процедура ДополнитьСтруктуруПечатныхФормИзВложенныхСхемСКД(ШаблоныЗапросовСКД_КонтурEDI, СтруктураПечатныхФорм)

	Для Каждого ВложеннаяСхема Из ШаблоныЗапросовСКД_КонтурEDI.ВложенныеСхемыКомпоновкиДанных Цикл
		
		Если Не СтруктураПечатныхФорм.Свойство(ВложеннаяСхема.Имя) Тогда
			 СтруктураПечатныхФорм.Вставить(ВложеннаяСхема.Имя, ВложеннаяСхема.Схема);
		КонецЕсли;
				
	КонецЦикла;
	
КонецПроцедуры  

Функция ПолучитьПечатныеФормыИзМакетаСКД_КонтурEDI()
	
	//Где будет поиск
	МакетыПечатныхФорм = ПолучитьМакетыПечатныхФорм_КонтурEDI();
	
	СтруктураПечатныхФорм = Новый Структура(); 	
	
	Если МакетыПечатныхФорм.Свойство("ВнешнийМодуль") И МакетыПечатныхФорм.ВнешнийМодуль <> Неопределено Тогда
		ДополнитьСтруктуруПечатныхФормИзВложенныхСхемСКД(МакетыПечатныхФорм.ВнешнийМодуль, СтруктураПечатныхФорм);
	КонецЕсли;
	
	Если МакетыПечатныхФорм.Свойство("МакетССервера") И МакетыПечатныхФорм.МакетССервера <> Неопределено Тогда
		ДополнитьСтруктуруПечатныхФормИзВложенныхСхемСКД(МакетыПечатныхФорм.МакетССервера, СтруктураПечатныхФорм);  
	КонецЕсли;
	
	Если МакетыПечатныхФорм.Свойство("МакетОбработки") И МакетыПечатныхФорм.МакетОбработки <> Неопределено Тогда
		ДополнитьСтруктуруПечатныхФормИзВложенныхСхемСКД(МакетыПечатныхФорм.МакетОбработки, СтруктураПечатныхФорм); 
	КонецЕсли;
	
	Возврат СтруктураПечатныхФорм;	
	
КонецФункции

Функция КэшПечатныхФормСообщений() Экспорт
	
	Результат = ЭДО_Кэш_Прочитать("КэшПечатныхФормСообщений");
	
	Если Результат = Неопределено Тогда
		
		//переинициализируем кэш
		Результат = ПолучитьПечатныеФормыИзМакетаСКД_КонтурEDI();
		
		ЭДО_Кэш_Поместить("КэшПечатныхФормСообщений", Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

Процедура ДобавитьКолонкиИзНабораДанных(ТаблицаИсточникДанных_Сообщение, НаборДанных)

	Для Каждого Поле Из НаборДанных.Поля Цикл
		
		Если Поле.Поле = "ПолеДляСвязиНаборов" Тогда
			Продолжить;
		КонецЕсли; 
		
		ПутьКДанным = Поле.ПутьКДанным;
		
		ДобавитьКолонкиВТаблицуЗначений(ТаблицаИсточникДанных_Сообщение, ПутьКДанным);
		
	КонецЦикла;   	

КонецПроцедуры 

Функция СобратьДанныеПолейНабораИзИсточника(Источник, ИмяИсточкника, ПоляНабораДанных)
	
	ЗначенияДляЗаписиВТаблицу = Новый Структура;
	
	Для Каждого Поле Из ПоляНабораДанных Цикл
		
		Если Поле.Поле = "ПолеДляСвязиНаборов" Тогда
			Продолжить;
		КонецЕсли; 
		
		ПутьКДанным = Поле.ПутьКДанным;
		
		ВыражениеПредставления = СокрЛП(Поле.ВыражениеПредставления); 		
		ВыражениеПредставления = СтрЗаменить(ВыражениеПредставления, ИмяИсточкника, "Источник");
		
		Если ВыражениеПредставления <> "" Тогда
			ЗначениеПоля = Вычислить(Вычислить(ВыражениеПредставления));
		Иначе
			ЗначениеПоля =  Вычислить("Источник." + Поле.Поле); // "СтрокаТоваров" "Сообщение"				
		КонецЕсли;
		
		ЗначенияДляЗаписиВТаблицу.Вставить(ПутьКДанным,ЗначениеПоля);
		
	КонецЦикла;   	
	
	Возврат ЗначенияДляЗаписиВТаблицу; 
	
КонецФункции

Функция ПолучитьТаблицуИсточникДанныхДляСКД_Из_Сообщения(Сообщение, НаборДанных)
	
	ТаблицаИсточникДанных_Сообщение = Новый ТаблицаЗначений;
	ДобавитьКолонкиИзНабораДанных(ТаблицаИсточникДанных_Сообщение, НаборДанных);
	
	Если НаборДанных.Имя = "табСообщенияТовары" Тогда 		
				
		Для Каждого СтрокаТоваров Из Сообщение.Товары Цикл
			
			СтрокаИсточника = ТаблицаИсточникДанных_Сообщение.Добавить();
			
			ЗначенияДляЗаписиВТаблицу = СобратьДанныеПолейНабораИзИсточника(СтрокаТоваров, "СтрокаТоваров", НаборДанных.Поля);
			ЗаполнитьЗначенияСвойств(СтрокаИсточника,ЗначенияДляЗаписиВТаблицу);
			
		КонецЦикла;
						
	Иначе
		
		СтрокаИсточника = ТаблицаИсточникДанных_Сообщение.Добавить();
		
		ЗначенияДляЗаписиВТаблицу = СобратьДанныеПолейНабораИзИсточника(Сообщение, "Сообщение", НаборДанных.Поля);
		ЗаполнитьЗначенияСвойств(СтрокаИсточника,ЗначенияДляЗаписиВТаблицу);       
		        				
	КонецЕсли;
	
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаИсточникДанных_Сообщение, "ПолеДляСвязиНаборов", Новый ОписаниеТипов("Булево"));
	 
	Возврат ТаблицаИсточникДанных_Сообщение; 
		
КонецФункции
  
Функция ПолучитьВнешниеНаборыДанныхИзСообщения_ДляСКД(Сообщение, СхемаКомпоновки)
	
	ВнешниеНаборыДанных = Новый Структура;
	
	Для Каждого НаборДанных Из СхемаКомпоновки.НаборыДанных Цикл
		Если ТипЗнч(НаборДанных) = Тип("НаборДанныхОбъектСхемыКомпоновкиДанных") Тогда
			ВнешниеНаборыДанных.Вставить(НаборДанных.Имя, ПолучитьТаблицуИсточникДанныхДляСКД_Из_Сообщения(Сообщение, НаборДанных));
		КонецЕсли;
	КонецЦикла;
		
	Возврат ВнешниеНаборыДанных;

КонецФункции 

Функция ПолучитьСхемуКомпоновкиПечатнойФормы_КонтурEDI(ИмяПечатнойФормы)
	
	ПечатныеФормы = КэшПечатныхФормСообщений();
	
	Если ПечатныеФормы.Свойство(ИмяПечатнойФормы) Тогда
		Возврат ПечатныеФормы[ИмяПечатнойФормы];
	Иначе
		Возврат Неопределено;
	КонецЕсли; 	
	
КонецФункции

Функция ПолучитьКомпоновкиДанных_КонтурEDI(СхемаКомпоновки, НастройкиКомпоновкиДанных)
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
    Макет = КомпоновщикМакета.Выполнить(СхемаКомпоновки, НастройкиКомпоновкиДанных);
	
	Возврат Макет;

КонецФункции

Функция ПолучитьПроцессорКомпоновки_КонтурEDI(Макет, ВнешниеНаборыДанных)

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
    ПроцессорКомпоновки.Инициализировать(Макет, ВнешниеНаборыДанных);
    ПроцессорКомпоновки.Сбросить();

	Возврат ПроцессорКомпоновки;
	
КонецФункции // ПолучитьПроцессорКомпоновки_КонтурEDI()

Процедура ВывестиТабДокЧерезПроцессорВыводаКомпоновки_КонтурEDI(ТабДок, ПроцессорКомпоновки)

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
    
    ПроцессорВывода.УстановитьДокумент(ТабДок);
    ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры 

Процедура ЗаполнитьТаблицуМакетовИзМакетаСКД_КонтурEDI(МакетКомпоновки, ТаблицаМакетов, Знач Фиксировать = Ложь) 
	
	Для Каждого ЭлементТела из МакетКомпоновки.Тело Цикл
		
		ТипЭлементаТела = ТипЗнч(ЭлементТела);
		
		Если ТипЭлементаТела = Тип("ГруппировкаМакетаКомпоновкиДанных") Тогда
			
			ЗаполнитьТаблицуМакетовИзМакетаСКД_КонтурEDI(ЭлементТела, ТаблицаМакетов, Найти(ЭлементТела.Имя, "Фиксировать") > 0)
			
		ИначеЕсли ТипЭлементаТела = Тип("МакетОбластиМакетаКомпоновкиДанных") Тогда
			
			СтрокаТаблицы = ТаблицаМакетов.Добавить();
			
			СтрокаТаблицы.Макет = ЭлементТела.Макет;
			СтрокаТаблицы.Фиксировать = Фиксировать;
			
		ИначеЕсли ТипЭлементаТела = Тип("ТаблицаМакетаКомпоновкиДанных") Тогда
			// пока ничего не делаем
		КонецЕсли; 		
		
	КонецЦикла;
			
КонецПроцедуры

Функция ОпределитьФиксированныеОбластиМакет_КонтурEDI(ТаблицаМакетов, Макет)
	
	МассивФиксированныхОбластей = Новый Массив;
	
	НачальнаяСтрока = 1;
	Для Каждого СтрМакет Из ТаблицаМакетов Цикл
		
		МакетПоСтроке = Макет.Макеты.Найти(СтрМакет.Макет);
		
		Если МакетПоСтроке <> Неопределено
			И ТипЗнч(МакетПоСтроке.Макет) = Тип("МакетОбластиКомпоновкиДанных") Тогда
			
			КоличествоСтрок = МакетПоСтроке.Макет.Количество();
			
			Если СтрМакет.Фиксировать Тогда
				МассивФиксированныхОбластей.Добавить(Новый Структура("НачальнаяСтрокаОбласти, КонечнаяСтрокаОбласти", НачальнаяСтрока, НачальнаяСтрока + КоличествоСтрок - 1));
			КонецЕсли;
			
			НачальнаяСтрока = НачальнаяСтрока + КоличествоСтрок;
			
		КонецЕсли;
				
	КонецЦикла;
		
	Возврат МассивФиксированныхОбластей;	

КонецФункции 

Процедура НастроитьТабличныйДокумент_КонтурEDI(ТабДок, Макет)
	
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОтображатьСетку = Ложь;
	
	// Верхний колонтитул 
	ТабДок.ВерхнийКолонтитул.Выводить = Истина;
	ТабДок.ВерхнийКолонтитул.НачальнаяСтраница = 1;
	ТабДок.ВерхнийКолонтитул.ТекстВЦентре = "Стр. [&НомерСтраницы] из [&СтраницВсего]";
	ТабДок.ВерхнийКолонтитул.ТекстСправа = "Дата/время печати: [&Дата]/[&Время]";
	
	//Фиксация шапки
	ТаблицаМакетов = Новый ТаблицаЗначений;
	ДобавитьКолонкиВТаблицуЗначений(ТаблицаМакетов, "Макет,Фиксировать");
	
	ЗаполнитьТаблицуМакетовИзМакетаСКД_КонтурEDI(Макет, ТаблицаМакетов);
	
	МассивФиксированныхОбластей = ОпределитьФиксированныеОбластиМакет_КонтурEDI(ТаблицаМакетов, Макет);
		
	Для Каждого ФиксированнаяОбласть Из МассивФиксированныхОбластей Цикл 
		ТабДок.ПовторятьПриПечатиСтроки = ТабДок.Область(ФиксированнаяОбласть.НачальнаяСтрокаОбласти,,ФиксированнаяОбласть.КонечнаяСтрокаОбласти,);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьПечатнуюФормуСообщения(Знач ИмяПечатнойФормы, Знач Сообщение) Экспорт

	Результат = Новый Структура("Успешно, ТабДок", Истина, Неопределено);
	
	СхемаКомпоновки = ПолучитьСхемуКомпоновкиПечатнойФормы_КонтурEDI(ИмяПечатнойФормы);
	
	Если СхемаКомпоновки = Неопределено Тогда
		Результат.Успешно = Ложь;
		Возврат Результат;
	КонецЕсли;   	
		
	// настройки
	НастройкиКомпоновкиДанных = СхемаКомпоновки.НастройкиПоУмолчанию;
		
	// макет
	Макет = ПолучитьКомпоновкиДанных_КонтурEDI(СхемаКомпоновки, НастройкиКомпоновкиДанных); 
	
	// исполняем макет 
	Если ТипЗнч(Сообщение) = Тип("СправочникСсылка.КонтурEDI_Сообщения") Тогда
		Сообщение = ПрочитатьСообщение(Сообщение);  
	КонецЕсли;  
	ВнешниеНаборыДанных = ПолучитьВнешниеНаборыДанныхИзСообщения_ДляСКД(Сообщение, СхемаКомпоновки); 
		
    ПроцессорКомпоновки = ПолучитьПроцессорКомпоновки_КонтурEDI(Макет, ВнешниеНаборыДанных);
	    
    // выводим результат 
	ТабДок = Новый ТабличныйДокумент;
	
	ВывестиТабДокЧерезПроцессорВыводаКомпоновки_КонтурEDI(ТабДок, ПроцессорКомпоновки); 
    	
	НастроитьТабличныйДокумент_КонтурEDI(ТабДок, Макет);    	
		
	Результат.ТабДок = ТабДок;
	
	Возврат Результат; 

КонецФункции // ПолучитьПечатнуюФормуСообщения()

