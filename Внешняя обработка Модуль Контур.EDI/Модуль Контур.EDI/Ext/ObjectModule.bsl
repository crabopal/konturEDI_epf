Функция МенеджерКриптографии1С_КонтурEDI(ДанныеАвторизации) Экспорт
	
	ПарольКонтейнера = "";
	ДанныеАвторизации.Свойство("ПарольКонтейнера", ПарольКонтейнера); 
		
	МенеджерКриптографии1С = Криптография_ИнициализироватьМенеджерКриптографии(ПарольКонтейнера);
	
	Возврат МенеджерКриптографии1С;
	
КонецФункции

Функция ХранилищеСертификатов1С_КонутрEDI(МенеджерКриптографии1С) Экспорт
	
	Попытка
		ХранилищеСертификатов1С = МенеджерКриптографии1С.ПолучитьХранилищеСертификатов(ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты); //ПолучитьХранилищеСертификатов()
	Исключение
		
		_ОписаниеОшибки = ОписаниеОшибки();
		ТекстСообщения = "Не удалось инициализировать серверное хранилище сертификатов по причине:
							|" + _ОписаниеОшибки;
		Сообщить(ТекстСообщения);
		
	КонецПопытки;
		
	Возврат ХранилищеСертификатов1С;	
	
КонецФункции

