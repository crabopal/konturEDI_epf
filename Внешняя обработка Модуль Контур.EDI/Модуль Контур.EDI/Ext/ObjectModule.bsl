// Функция создает новый вариант пользовательского поля выбора компоновки данных.
//
// Параметры:
//   ПользовательскоеПоле - ПользовательскоеПолеВыборКомпоновкиДанных - Пользовательское поле выбора, для которого создается вариант
//   Значение - Произвольный - Значение варианта
//   Отбор - ОтборКомпоновкиДанных - Отбор для варианта
//
// Возвращаемое значение:
//   ПользовательскийВариантПоляВыборКомпоновкиДанных - новый вариант пользовательского поля выбора компоновки данных
Функция КонтурСКД_НовыйВариантПользовательскогоПоляВыбор(ПользовательскоеПоле, Значение = Неопределено, Отбор = Неопределено) Экспорт
	
	НовыйВариант = ПользовательскоеПоле.Варианты.Элементы.Добавить();
	
	Если Значение <> Неопределено Тогда
		НовыйВариант.Значение = Значение;
	КонецЕсли;
	
	Если Отбор <> Неопределено Тогда
		КонтурСКД_СкопироватьОтборКомпоновкиДанныхРекурсивно(НовыйВариант.Отбор, Отбор);
	КонецЕсли;
	
	Возврат НовыйВариант;
	
КонецФункции

// Функция создает новую схему компоновки данных и настройки компоновки по умолчанию для запроса.
//
// Параметры:
//   ТекстЗапроса - Строка - Текст запроса
//
// Возвращаемое значение:
//   Структура - Структура с полями "СхемаКомпоновки" и "НастройкиКомпоновки"
Функция КонтурСКД_НовыйСхемаКомпоновкиЗапросПоУмолчанию(ТекстЗапроса)
	
	Результат = Новый Структура("СхемаКомпоновки, НастройкиКомпоновки");

	Результат.СхемаКомпоновки = КонтурСКД_НовыйСхемаКомпоновки();
	КонтурСКД_НовыйИсточникДанных(Результат.СхемаКомпоновки);
	КонтурСКД_НовыйНаборДанныхЗапрос(Результат.СхемаКомпоновки, ТекстЗапроса);
	
	Результат.НастройкиКомпоновки = КонтурСКД_НастройкиКомопновкиПоУмолчанию(Результат.СхемаКомпоновки);
	КонтурСКД_НовыйГруппировкаКомпоновкиДанных(Результат.НастройкиКомпоновки, Истина);
	
	Возврат Результат;
	
КонецФункции

// Функция создает новый отбор компоновки данных
//
// Возвращаемое значение:
//   ОтборКомпоновкиДанных - Созданный отбор компоновки данных
Функция КонтурСКД_НовыйОтборКомпоновкиДанных()
	
	Попытка
		Отбор = Новый(Тип("ОтборКомпоновкиДанных"));
	Исключение
		КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
		Отбор = КомпоновщикНастроек.Настройки.Отбор;
	КонецПопытки;
	
	Возврат Отбор;
	
КонецФункции

// Функция создает новый элемент отбора компоновки данных.
//
// Параметры:
//   ОтборКомопновки - ОтборКомпоновкиДанных - Отбор компоновки данных, в который добавляется элемент отбора
//   ЛевоеЗначение - ПолеКомпоновкиДанных, Строка - Левое значение отбора, можно указать поле компоновки или путь к данным
//   ПравоеЗначение - Произвольный - Правое значение отбора
//   ВидСравнения - ВидСравненияКомпоновкиДанных - Вид сравнения отбора, по умолчанию будет установлено Равно или ВСписке (при указании коллекции в правом значении)
//
// Возвращаемое значение:
//   ЭлементОтбораКомпоновкиДанных - Созданный элемент отбора компоновки данных
Функция КонтурСКД_НовыйЭлементОтбораКомпоновки(ОтборКомопновки, ЛевоеЗначение = Неопределено, ПравоеЗначение = Неопределено, ВидСравнения = Неопределено) Экспорт
	
	ЭлементОтбора = ОтборКомопновки.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	
	Если ЛевоеЗначение <> Неопределено Тогда
		Если ТипЗнч(ЛевоеЗначение) = Тип("ПолеКомпоновкиДанных") Тогда
			ЭлементОтбора.ЛевоеЗначение = ЛевоеЗначение;
		Иначе
			ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ЛевоеЗначение);
		КонецЕсли;
	КонецЕсли;
	
	ЭлементОтбора.ПравоеЗначение = ПравоеЗначение;
			
	Если ВидСравнения = Неопределено Тогда
		
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		
		Если ТипЗнч(ПравоеЗначение) = Тип("Массив") ИЛИ ТипЗнч(ПравоеЗначение) = Тип("СписокЗначений") Тогда
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		КонецЕсли;
		
	Иначе
		ЭлементОтбора.ВидСравнения = ВидСравнения;
	КонецЕсли;
	
	Возврат ЭлементОтбора;
	
КонецФункции

// Функция создает новую группу отбора компоновки данных.
//
// Параметры:
//   ОтборКомпоновки - ОтборКомпоновкиДанных - Отбор компоновки данных, в который добавляется группа отбора
//   ТипГруппы - ТипГруппыЭлементовОтбораКомпоновкиДанных - Тип группы отбора
//
// Возвращаемое значение:
//   ГруппаЭлементовОтбораКомпоновкиДанных - Созданная группа отбора компоновки данных
Функция КонтурСКД_НоваяГруппаОтбораКомпоновки(ОтборКомпоновки, ТипГруппы = Неопределено) Экспорт
	
	ГруппаОтбора = ОтборКомпоновки.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));	
	
	Если ТипГруппы <> Неопределено Тогда
		ГруппаОтбора.ТипГруппы = ТипГруппы;
	КонецЕсли;
	
	Возврат ГруппаОтбора;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Программный интерфейс вывода результата компоновки данных

// Функция выводит данные из схемы компоновки в таблицу значений.
//
// Параметры:
//   СхемаКомпоновки - СхемаКомпоновкиДанных - Схема компоновки данных
//   НастройкиКомпоновки - НастройкиКомпоновкиДанных - Настройки компоновки данных (необязательный)
//
// Возвращаемое значение:
//   ТаблицаЗначений - Результат вывода в таблицу значений
Функция КонтурСКД_ВывестиВТаблицуЗначений(СхемаКомпоновки, НастройкиКомпоновки = Неопределено) Экспорт
	
	Результат = Новый ТаблицаЗначений;
	ВывестиВКоллекцию = Истина;
	
	МакетКомпоновки = КонтурСКД_НовыйМакетКомпоновкиДанных(СхемаКомпоновки, НастройкиКомпоновки, ВывестиВКоллекцию);
	ПроцессорКомпоновки = КонтурСКД_НовыйПроцессорКомпоновки(МакетКомпоновки);
	ПроцессорВывода = КонтурСКД_НовыйПроцессорВывода(ПроцессорКомпоновки, Результат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

    Возврат Результат;	
	
КонецФункции

// Функция выводит данные из схемы компоновки в дерево значений.
//
// Параметры:
//   СхемаКомпоновки - СхемаКомпоновкиДанных - Схема компоновки данных
//   НастройкиКомпоновки - НастройкиКомпоновкиДанных - Настройки компоновки данных (необязательный)
//
// Возвращаемое значение:
//   ДеревоЗначений - Результат вывода в дерево значений
Функция КонтурСКД_ВывестиВДеревоЗначений(СхемаКомпоновки, НастройкиКомпоновки = Неопределено) Экспорт

	Результат = Новый ДеревоЗначений;
	ВывестиВКоллекцию = Истина;
	
	МакетКомпоновки = КонтурСКД_НовыйМакетКомпоновкиДанных(СхемаКомпоновки, НастройкиКомпоновки, ВывестиВКоллекцию);
	ПроцессорКомпоновки = КонтурСКД_НовыйПроцессорКомпоновки(МакетКомпоновки);
	ПроцессорВывода = КонтурСКД_НовыйПроцессорВывода(ПроцессорКомпоновки, Результат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

    Возврат Результат;	
	
КонецФункции

// Функция выводит данные из схемы компоновки в табличный документ.
//
// Параметры:
//   СхемаКомпоновки - СхемаКомпоновкиДанных - Схема компоновки данных
//   НастройкиКомпоновки - НастройкиКомпоновкиДанных - Настройки компоновки данных (необязательный)
//
// Возвращаемое значение:
//   ТабличныйДокумент - Результат вывода в табличный документ
Функция КонтурСКД_ВывестиВТабличныйДокумент(СхемаКомпоновки, НастройкиКомпоновки = Неопределено) Экспорт

	Результат = Новый ТабличныйДокумент;
	
	МакетКомпоновки = КонтурСКД_НовыйМакетКомпоновкиДанных(СхемаКомпоновки, НастройкиКомпоновки);
	ПроцессорКомпоновки = КонтурСКД_НовыйПроцессорКомпоновки(МакетКомпоновки);
	ПроцессорВывода = КонтурСКД_НовыйПроцессорВывода(ПроцессорКомпоновки, Результат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

    Возврат Результат;	
	
КонецФункции

// Функция создает новый макет компоновки данных.
//
// Параметры:
//   СхемаКомпоновки - СхемаКомпоновкиДанных - Схема компоновки данных
//   НастройкиКомпоновки - НастройкиКомпоновкиДанных - Настройки компоновки данных
//   ВывестиВКоллекцию - Булево - Флаг вывода в коллекцию значений
//
// Возвращаемое значение:
//   МакетКомпоновкиДанных - Макет компоновки данных
Функция КонтурСКД_НовыйМакетКомпоновкиДанных(СхемаКомпоновки, НастройкиКомпоновки = Неопределено, ВывестиВКоллекцию = Ложь) Экспорт
	
	НастройкиДляМакета = НастройкиКомпоновки;
	
	Если НастройкиДляМакета = Неопределено Тогда
		НастройкиДляМакета = КонтурСКД_НастройкиКомопновкиПоУмолчанию(СхемаКомпоновки);
	КонецЕсли;
	
	ТипГенератора = Тип("ГенераторМакетаКомпоновкиДанных");
	Если ВывестиВКоллекцию Тогда
		ТипГенератора = Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений");
	КонецЕсли;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновки, НастройкиДляМакета, , , ТипГенератора, Ложь);
	
	Возврат МакетКомпоновки;
	
КонецФункции

// Функция создает новый процессор компоновки данных.
//
// Параметры:
//   МакетКомпоновки - МакетКомпоновкиДанных - Макет компоновки данных
//
// Возвращаемое значение:
//   ПроцессорКомпоновкиДанных - Процессор компоновки данных
Функция КонтурСКД_НовыйПроцессорКомпоновки(МакетКомпоновки) Экспорт

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	
	Возврат ПроцессорКомпоновки;
	
КонецФункции

// Функция создает новый процессор вывода результата компоновки данных.
//
// Параметры:
//   ПроцессорКомпоновки - ПроцессорКомпоновкиДанных - Процессор компоновки данных
//   ОбъектВывода - ТаблицаЗначений, ДеревоЗначений, ТабличныйДокумент - Объект, в который будет осуществляться вывод
//   ВывестиВКоллекцию - Булево - Флаг вывода в коллекцию значений
//
// Возвращаемое значение:
//   ПроцессорВыводаРезультатаКомпоновкиДанных - Процессор вывода результата компоновки данных
Функция КонтурСКД_НовыйПроцессорВывода(ПроцессорКомпоновки, ОбъектВывода) Экспорт
	
	Если ТипЗнч(ОбъектВывода) = Тип("ТабличныйДокумент") Тогда
	    ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
		ПроцессорВывода.УстановитьДокумент(ОбъектВывода);
	Иначе
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		ПроцессорВывода.УстановитьОбъект(ОбъектВывода);
	КонецЕсли;
	
	Возврат ПроцессорВывода;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Программный интерфейс общего назначения

// Функция рекурсивно копирует отбор компоновки данных из одного объекта в другой.
//
// Параметры:
//   ОтборПриемник - ОтборКомпоновкиДанных - Отбор, в который будет скопированы данные из источника
//   ОтборИсточник - ОтборКомпоновкиДанных - Отбор, из которого будет скопированы данные в приемник 
Процедура КонтурСКД_СкопироватьОтборКомпоновкиДанныхРекурсивно(ОтборПриемник, ОтборИсточник) Экспорт
	
	Для Каждого ЭлементИсточника Из ОтборИсточник.Элементы Цикл
		
		Если ТипЗнч(ЭлементИсточника) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			
			НовыйЭлементПриемника = КонтурСКД_НоваяГруппаОтбораКомпоновки(ОтборПриемник);
			ЗаполнитьЗначенияСвойств(НовыйЭлементПриемника, ЭлементИсточника);
			КонтурСКД_СкопироватьОтборКомпоновкиДанныхРекурсивно(НовыйЭлементПриемника, ЭлементИсточника);
			
		Иначе
			
			Если ЭлементИсточника.ЛевоеЗначение = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			НовыйЭлементПриемника = КонтурСКД_НовыйЭлементОтбораКомпоновки(ОтборПриемник, ЭлементИсточника.ЛевоеЗначение, ЭлементИсточника.ПравоеЗначение);
			ЗаполнитьЗначенияСвойств(НовыйЭлементПриемника, ЭлементИсточника);
						
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Функция создает новый компоновщик настроек компоновки данных.
//
// Параметры:
//   СхемаКомпоновки - СхемаКомпоновкиДанных - Схема компоновки данных
//   НастройкиКомпоновки - НастройкиКомпоновкиДанных - Настройки компоновки данных
//   АдресСхемыВоВременномХранилище - УникальныйИдентификатор, Строка - Адрес или уникальный идентификатор формы которые будут использованы при помещении схемы компоновки в хранилище
//
// Возвращаемое значение:
//   КомпоновщикНастроекКомпоновкиДанных - Созданный компоновщик настроек компоновки данных
Функция КонтурСКД_НовыйКомпоновщикНастроек(СхемаКомпоновки, 
										   НастройкиКомпоновки = Неопределено, 
										   АдресСхемыВоВременномХранилище = Неопределено) Экспорт
										   
	Если АдресСхемыВоВременномХранилище <> Неопределено Тогда
		ИсточникНастроек = ПоместитьВоВременноеХранилище(СхемаКомпоновки, АдресСхемыВоВременномХранилище);
	Иначе
		ИсточникНастроек = СхемаКомпоновки;
	КонецЕсли;
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(ИсточникНастроек));
	
	Если НастройкиКомпоновки = Неопределено Тогда
		НастройкиКомпоновкиПоУмолчанию = КонтурСКД_НастройкиКомопновкиПоУмолчанию(СхемаКомпоновки);
		КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиКомпоновкиПоУмолчанию);
	Иначе
		КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиКомпоновки);
	КонецЕсли;
	
	Возврат КомпоновщикНастроек;
	
КонецФункции

// Функция находит пользовательское поле в настройках компоновки данных по заголовку поля.
//
// Параметры:
//   НастройкиКомпоновки - НастройкиКомпоновкиДанных - Настройки компоновки данных
//   ЗаголовокПоля - Строка - Заголовок поля для поиска
//
// Возвращаемое значение:
//   ПользовательскоеПолеВыборКомпоновкиДанных, ПользовательскоеПолеВыражениеКомпоновкиДанных - Найденное пользовательское поле или Неопределено, если поле не найдено
Функция КонтурСКД_НайтиПользовательскоеПоле(НастройкиКомпоновки, ЗаголовокПоля) Экспорт
	
	НайденноеПоле = Неопределено;

	Для каждого ПользовательскоеПоле Из НастройкиКомпоновки.ПользовательскиеПоля.Элементы Цикл
		Если ПользовательскоеПоле.Заголовок = ЗаголовокПоля Тогда
			НайденноеПоле = ПользовательскоеПоле;
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	
	Возврат НайденноеПоле;
	
КонецФункции

