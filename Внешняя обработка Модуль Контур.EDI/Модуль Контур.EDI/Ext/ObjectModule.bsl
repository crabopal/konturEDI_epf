Функция ТипыТранспортныхУпаковок_КонтурEDI() Экспорт
	
	ТипыТранспортныхУпаковок = ЭДО_Кэш_Прочитать("ТипыТранспортныхУпаковок");
	
	Если ТипыТранспортныхУпаковок = Неопределено Тогда
		
		ТипыТранспортныхУпаковок = Новый Структура;
			
		ТипыТранспортныхУпаковок.Вставить("Код200", Свойства_1_2_Европалеты());
		ТипыТранспортныхУпаковок.Вставить("Код201", Свойства_Европалета());
