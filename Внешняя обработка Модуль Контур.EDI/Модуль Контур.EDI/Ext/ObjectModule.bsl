//Добавляет Колонки в Таблица.
//В Колонки допускается массив, Строка с разделителями "," или Символы.ПС
Процедура ДобавитьКолонкиВТаблицуЗначений(Таблица,Колонки,ОписаниеТипов = Неопределено) Экспорт
	
	Если ТипЗнч(Колонки) = Тип("Массив") Тогда
		МассивИменКолонок = Колонки;
	Иначе
		МассивИменКолонок = EDI_РазложитьСтрокуВМассивСлов(Колонки,",;");
	КонецЕсли;
	
	НеобходимоТипизировать = ТипЗнч(ОписаниеТипов) = Тип("ОписаниеТипов");
	МассивНеТипизированныхКолонок = Новый Массив;
	
	Для Каждого ИмяКолонки Из МассивИменКолонок Цикл
		
		Колонка = Таблица.Колонки.Найти(ИмяКолонки);
		
		Если Колонка = Неопределено Тогда
			Колонка = Таблица.Колонки.Добавить(ИмяКолонки,ОписаниеТипов);
		КонецЕсли;	
		
		Если НеобходимоТипизировать Тогда
			
			Если ОписаниеТипов.КвалификаторыСтроки.Длина <> 0
				И Колонка.ТипЗначения.КвалификаторыСтроки.Длина >= ОписаниеТипов.КвалификаторыСтроки.Длина Тогда
				
				МассивНеТипизированныхКолонок.Добавить(ИмяКолонки);
				
			Иначе
				
				Для Каждого ЭлементТип Из ОписаниеТипов.Типы() Цикл
					
					Если НЕ Колонка.ТипЗначения.СодержитТип(ЭлементТип) Тогда
						МассивНеТипизированныхКолонок.Добавить(ИмяКолонки);
						Прервать;
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
				
	КонецЦикла;
	
	Если НеобходимоТипизировать И МассивНеТипизированныхКолонок.Количество() > 0 Тогда
		
		Для Каждого НеТипизированнаяКолонка Из МассивНеТипизированныхКолонок Цикл
			
			ТипизироватьКолонкиВТаблицеЗначений(Таблица, НеТипизированнаяКолонка, ОписаниеТипов);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ТипизироватьКолонкиВТаблицеЗначений(ТаблицаЗначений, ИмяКолонокДляТипизации, ОписаниеТипов)  Экспорт
		
	ИмяКолонокДляТипизации =  СтрЗаменить(ИмяКолонокДляТипизации, ",", Символы.ПС);
	
	Для НомерСтроки = 1 По СтрЧислоСтрок(ИмяКолонокДляТипизации) Цикл
		
		ИмяКолонкиДляТипизации = СтрПолучитьСтроку(ИмяКолонокДляТипизации, НомерСтроки); 		
		ИмяКолонкиТипизированная = ИмяКолонкиДляТипизации + "_Типизированная"; 
		
		Колонка = ТаблицаЗначений.Колонки.Найти(ИмяКолонкиДляТипизации);
		
		Если Колонка = Неопределено Тогда
			
			Колонка = ТаблицаЗначений.Колонки.Добавить(ИмяКолонкиДляТипизации,ОписаниеТипов);
						
		Иначе
			
			Колонка = ТаблицаЗначений.Колонки.Добавить(ИмяКолонкиТипизированная,ОписаниеТипов);
									
			ТаблицаЗначений.ЗагрузитьКолонку(ТаблицаЗначений.ВыгрузитьКолонку(ИмяКолонкиДляТипизации), ИмяКолонкиТипизированная);
			
			ТаблицаЗначений.Колонки.Удалить(ИмяКолонкиДляТипизации);
			
			ТаблицаЗначений.Колонки.Найти(ИмяКолонкиТипизированная).Имя = ИмяКолонкиДляТипизации; 
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОставитьТолькоЧислаВЧисловыхКолонках(ТаблицаТоваров, ИмяКолонокДляТипизации) Экспорт
	
	ИмяКолонокДляТипизации =  СтрЗаменить(ИмяКолонокДляТипизации, ",", Символы.ПС);
	
	ИменаКолонокСЧисловымТипом = Новый Массив;
	
	Для НомерСтроки = 1 По СтрЧислоСтрок(ИмяКолонокДляТипизации) Цикл
		
		ИменаКолонокСЧисловымТипом.Добавить(СтрПолучитьСтроку(ИмяКолонокДляТипизации, НомерСтроки));
		
	КонецЦикла;
	
	Для Каждого ИмяКолонки Из ИменаКолонокСЧисловымТипом Цикл
		
		Колонка = ТаблицаТоваров.Колонки.Найти(ИмяКолонки);
		
		Если Колонка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеТипаКолонки = Колонка.ТипЗначения;
		ТипыКолонки = ОписаниеТипаКолонки.Типы();
		
		ВычитаемыеТипы = Новый Массив;  		
		
		ЕстьЧисло = Ложь;
		
		Для Каждого ЭлементТип Из ТипыКолонки Цикл
			
			Если ЭлементТип <> Тип("Число") Тогда
				
				ВычитаемыеТипы.Добавить(ЭлементТип);
				
			Иначе
				
				ЕстьЧисло = Истина;   
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если НЕ ЕстьЧисло Тогда
			
			ОписаниеТипаТолькоЧисло = ОписаниеТипаЧисло_КонтурEDI(15, 3);
			
		ИначеЕсли ВычитаемыеТипы.Количество() > 0 Тогда
			
			ОписаниеТипаТолькоЧисло = Новый ОписаниеТипов(ОписаниеТипаКолонки, , ВычитаемыеТипы);
			
		Иначе
			
			ОписаниеТипаТолькоЧисло = Неопределено;
			
		КонецЕсли;  
		
		Если ОписаниеТипаТолькоЧисло <> Неопределено Тогда
			
			ТипизироватьКолонкиВТаблицеЗначений(ТаблицаТоваров, ИмяКолонки, ОписаниеТипаТолькоЧисло);
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьЗначенияСвойствСтруктуры(СтруктураПриемник, СтруктураИсточник, СписокСвойствСтрокой) Экспорт
	
	СпСвойств = РазложитьСтроку(СписокСвойствСтрокой,",");
	Для Сч = 0 по СпСвойств.Количество()-1 Цикл
		текСвойство = СпСвойств.Получить(Сч);
		текЗначение = Неопределено;
		Если СтруктураИсточник.Свойство(текСвойство, текЗначение) Тогда
			СтруктураПриемник.Вставить(текСвойство, текЗначение);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// ********************************************************************
//	СТАТУСЫ

//суффикс БМИ - функция располагалась в базовом модуле интеграции
//с основной функцией большая разница в параметрах, поэтому объединять сложно
Процедура УстановитьСтатусСообщения_БМИ(Знач СообщениеСсылка = Неопределено, ДокументСсылка =  Неопределено, ТипСообщения, Статус)
	
	СообщениеОбъект = Неопределено;
	
	Если СообщениеСсылка <> Неопределено Тогда
		
		СообщениеОбъект = ПолучитьОбъектСообщения(СообщениеСсылка);
		
	Иначе
		
		НайденноеСообщение = НайтиСообщениеДокумента(ДокументСсылка,ТипСообщения);
		Если НайденноеСообщение = Неопределено Тогда
			Сообщить_КонтурEDI("Не найдено сообщение "+ТипСообщения+" для документа "+ДокументСсылка);
			Возврат;
		КонецЕсли;
		
		СообщениеОбъект = ПолучитьОбъектСообщения(НайденноеСообщение);
		
	КонецЕсли;
	
	Если СообщениеОбъект <> Неопределено Тогда
				
		СообщениеОбъект.Статус = Статус;
		
		СохранитьОбъектСообщения(СообщениеОбъект);
		
		//логика для обработки виртуальных ORDRSP
		Если СообщениеОбъект.ТипСообщения = "ORDRSP" Тогда
			
			ТаблицаВиртуальныхСообщений = ПолучитьВиртуальныеСвязанныеORDERS(ДокументСсылка);
			Для Каждого Стр Из ТаблицаВиртуальныхСообщений Цикл
				Если СообщениеОбъект.Ссылка <> Стр.ORDRSP//текущий документ мы уже обработали
					И ЗначениеЗаполнено(Стр.ORDRSP) Тогда
					
					ВиртуальныйORDRSP = ПолучитьОбъектСообщения(Стр.ORDRSP);
					ВиртуальныйORDRSP.Статус = Статус;
					СохранитьОбъектСообщения(ВиртуальныйORDRSP);
					
				КонецЕсли;	
			КонецЦикла;	
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

//суффикс БМИ - функция располагалась в базовом модуле интеграции
//с основной функцией большая разница в параметрах, поэтому объединять сложно
Процедура УстановитьСтатусДокумента_БМИ(ДокументСсылка,Статус,ИмяСтатуса = Неопределено)
	
	Если ВнешнееХранилище Тогда
		Запись = СоединениеСХранилищем.РегистрыСведений.КонтурEDI_СтатусыДокументов.СоздатьМенеджерЗаписи();
	Иначе
		Запись = РегистрыСведений.КонтурEDI_СтатусыДокументов.СоздатьМенеджерЗаписи();
	КонецЕсли;
	
	Запись.Документ	= ПреобразоватьЗначениеДляВнешнегоХранилища(ДокументСсылка);
	Запись.Статус	= Статус;
	
	Если НЕ ИмяСтатуса = Неопределено Тогда
		Запись.ИмяСтатуса = СокрЛП(ИмяСтатуса);
	КонецЕсли;
	
	Попытка
		Запись.Записать();
	Исключение
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, "Не удалось установить статус документа - " + ОписаниеОшибки());	
	КонецПопытки;
	
КонецПроцедуры

Функция ПрочитатьСообщение_БМИ(ЗНАЧ СообщениеСсылка =  Неопределено, ДокументСсылка =  Неопределено, ТипСообщения = Неопределено,Направление = Неопределено,Статусное = Неопределено,Параметры = Неопределено) Экспорт
	
	//Оставлено для совместимости с ПМ
	
	Если Не ЗначениеЗаполнено(СообщениеСсылка) Тогда
		СообщениеСсылка = НайтиСообщениеДокумента(ДокументСсылка,ТипСообщения,Направление);
	КонецЕсли;
	
	Если СообщениеСсылка <> Неопределено Тогда
		
		ТекСообщениеСсылка = ПреобразоватьЗначениеДляВнешнегоХранилища(СообщениеСсылка);
		
		Если ВнешнееХранилище Тогда
			
			СохраненноеСообщение = ЗначениеИзСтрокиВнутр(ТекСообщениеСсылка.Хранилище.Получить());
			
			Если ЗначениеЗаполнено(ТекСообщениеСсылка.Документ) Тогда
				ДокументСообщения = ЗначениеИзСтрокиВнутр(ТекСообщениеСсылка.Документ);
			Иначе
				ДокументСообщения = Неопределено;
			КонецЕсли;
			
		Иначе	
			
			СохраненноеСообщение = СообщениеСсылка.Хранилище.Получить();
			ДокументСообщения = ТекСообщениеСсылка.Документ;	
			
		КонецЕсли;
		
		Если ТипЗнч(СохраненноеСообщение) = Тип("Структура") Тогда
			
			СохраненноеСообщение.Вставить("ДокументСсылка",		ДокументСообщения); 		
			СохраненноеСообщение.Вставить("СтатусСсылки",		ТекСообщениеСсылка.Статус);
			СохраненноеСообщение.Вставить("Архив",				ТекСообщениеСсылка.Архив);
			СохраненноеСообщение.Вставить("СообщениеСсылка",	СообщениеСсылка);
			СохраненноеСообщение.Вставить("Документ1С",			СохраненноеСообщение.ДокументСсылка);
			
			// приведем структуру сообщения в соответствие с маппингом
			// дополним рекурсивно старые сообщения новыми полями во вложенных структурах, таблицах, деревьях
			Эталон = ПолучитьСтруктуруСообщения(СохраненноеСообщение.ТипСообщения, СохраненноеСообщение.Направление);
			ДополнитьСтруктуруСообщенияИзЭталона(СохраненноеСообщение, Эталон); 
			КонвертироватьУстаревшиеСтруктурыСообщения(СохраненноеСообщение);
			
		Иначе
			
			СохраненноеСообщение = Неопределено;
			
		КонецЕсли; 		
		
	Иначе	
		
		СохраненноеСообщение = Неопределено;
		
	КонецЕсли;
	
	Возврат СохраненноеСообщение;
	
КонецФункции

Процедура КонвертироватьУстаревшиеСтруктурыСообщения(Сообщение)

	Если НЕ ЗначениеЗаполнено(Сообщение) Тогда
		Возврат;
	КонецЕсли;
	
	ТипСообщения = Сообщение.ТипСообщения;
	Направление = Сообщение.Направление;
	
	Если ПолучитьМассивТиповСообщенийEDI().Найти(ТипСообщения) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Сообщение.Свойство("Товары")
		И ТипЗнч(Сообщение.Товары) = Тип("ТаблицаЗначений")
		И НЕ Сообщение.Товары.Колонки.Найти("НеЗагружать") = Неопределено
		И Сообщение.Товары.Колонки.НеЗагружать.ТипЗначения.Типы().Количество() = 0 Тогда
		
		Для каждого Строка Из Сообщение.Товары Цикл
		
			Строка.НеЗагружать = (Строка.НеЗагружать = Истина);			
		
		КонецЦикла;
		
	КонецЕсли;
	
	Если Сообщение.Свойство("НомерИсправления")
		И Сообщение.Свойство("ДатаИсправления") Тогда
		
		Сообщение.ДокументEDI.Вставить("НомерИсправления", Сообщение.НомерИсправления);
		Сообщение.ДокументEDI.Вставить("ДатаИсправления", Сообщение.ДатаИсправления);
		
	КонецЕсли;
	
	Если СокрЛП(Сообщение.ВерсияМодуля) <= "4.03.026.00" Тогда 
		
		// исправляем ошибки
		Если (ТипСообщения = "ORDERS" И Направление = "Входящее")
			ИЛИ (СтрСодержит_КонтурEDI("ORDRSP,DESADV", ТипСообщения) И Направление = "Исходящее") Тогда
			
			КолонкаМаксимальныйВесПалеты 		= Сообщение.Товары.Колонки.Найти("МаксимальныйВесПалеты");
			КолонкаМаксимальнаяВысотаПалеты 	= Сообщение.Товары.Колонки.Найти("МаксимальнаяВысотаПалеты");
			КолонкаКоличествоВБлоке 			= Сообщение.Товары.Колонки.Найти("КоличествоВБлоке");
			
			ОписаниеТипаСтруктура = Новый ОписаниеТипов("Структура");
			
			Если НЕ КолонкаМаксимальныйВесПалеты = Неопределено
				И КолонкаМаксимальныйВесПалеты.ТипЗначения = ОписаниеТипаСтруктура Тогда
				МассивЗначений = Сообщение.Товары.ВыгрузитьКолонку("МаксимальныйВесПалеты");
				Сообщение.Товары.Колонки.Удалить(КолонкаМаксимальныйВесПалеты);
				Сообщение.Товары.Колонки.Добавить("МаксимальныйВесПалеты", ПолучитьТип_КонтурEDI("ЧислоКоличество"));
				Сч = 0;
				Для каждого Эл Из МассивЗначений Цикл
					Если ЗначениеЗаполнено(Эл) Тогда
						Сообщение.Товары[Сч].МаксимальныйВесПалеты 						= Эл.Количество;
						Сообщение.Товары[Сч].КодЕдиницыИзмеренияМаксимальногоВесаПалеты	= Эл.КодЕдиницыИзмерения;
					КонецЕсли;
					Сч = Сч + 1;
				КонецЦикла;
			КонецЕсли;
			Если НЕ КолонкаМаксимальнаяВысотаПалеты = Неопределено
				И КолонкаМаксимальнаяВысотаПалеты.ТипЗначения = ОписаниеТипаСтруктура Тогда
				МассивЗначений = Сообщение.Товары.ВыгрузитьКолонку("МаксимальнаяВысотаПалеты");
				Сообщение.Товары.Колонки.Удалить(КолонкаМаксимальнаяВысотаПалеты);
				Сообщение.Товары.Колонки.Добавить("МаксимальнаяВысотаПалеты", ПолучитьТип_КонтурEDI("ЧислоКоличество"));
				Сч = 0;
				Для каждого Эл Из МассивЗначений Цикл
					Если ЗначениеЗаполнено(Эл) Тогда
						Сообщение.Товары[Сч].МаксимальнаяВысотаПалеты 						= Эл.Количество;
						Сообщение.Товары[Сч].КодЕдиницыИзмеренияМаксимальнойВысотыПалеты	= Эл.КодЕдиницыИзмерения;
					КонецЕсли;
					Сч = Сч + 1;
				КонецЦикла;
			КонецЕсли;
			Если НЕ КолонкаКоличествоВБлоке = Неопределено
				И КолонкаКоличествоВБлоке.ТипЗначения = ОписаниеТипаСтруктура Тогда
				МассивЗначений = Сообщение.Товары.ВыгрузитьКолонку("КоличествоВБлоке");
				Сообщение.Товары.Колонки.Удалить(КолонкаКоличествоВБлоке);
				Сообщение.Товары.Колонки.Добавить("КоличествоВБлоке", ПолучитьТип_КонтурEDI("ЧислоКоличество"));
				Сч = 0;
				Для каждого Эл Из МассивЗначений Цикл
					Если ЗначениеЗаполнено(Эл) Тогда
						Сообщение.Товары[Сч].КоличествоВБлоке 						= Эл.Количество;
						Сообщение.Товары[Сч].КодЕдиницыИзмеренияКоличестваВБлоке	= Эл.КодЕдиницыИзмерения;
					КонецЕсли;
					Сч = Сч + 1;
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
				
		// исправляем ошибки
		Если Сообщение.Свойство("Фасовка") 
			И ЗначениеЗаполнено(Сообщение.Фасовка) Тогда 
			
			КолонкаКоличествоВОднойУпаковке = Сообщение.Фасовка.Колонки.Найти("КоличествоВОднойУпаковке");
			КолонкаКоличествоСлоев 			= Сообщение.Фасовка.Колонки.Найти("КоличествоСлоев");
			КолонкаКоличествоВСлое 			= Сообщение.Фасовка.Колонки.Найти("КоличествоВСлое");
			
			ОписаниеТипаСтруктура = Новый ОписаниеТипов("Структура");
			
			Если НЕ КолонкаКоличествоВОднойУпаковке = Неопределено
				И КолонкаКоличествоВОднойУпаковке.ТипЗначения = ОписаниеТипаСтруктура Тогда
				МассивЗначений = Сообщение.Фасовка.ВыгрузитьКолонку("КоличествоВОднойУпаковке");
				Сообщение.Фасовка.Колонки.Удалить(КолонкаКоличествоВОднойУпаковке);
				Сообщение.Фасовка.Колонки.Добавить("КоличествоВОднойУпаковке", ПолучитьТип_КонтурEDI("ЧислоКоличество"));
				Сч = 0;
				Для каждого Эл Из МассивЗначений Цикл
					Если ЗначениеЗаполнено(Эл) Тогда
						Сообщение.Фасовка[Сч].КоличествоВОднойУпаковке 						= Эл.Количество;
						Сообщение.Фасовка[Сч].КодЕдиницыИзмеренияКоличестваВОднойУпаковке 	= Эл.КодЕдиницыИзмерения;
					КонецЕсли;
					Сч = Сч + 1;
				КонецЦикла;
			КонецЕсли;
			Если НЕ КолонкаКоличествоСлоев = Неопределено
				И КолонкаКоличествоСлоев.ТипЗначения = ОписаниеТипаСтруктура Тогда
				МассивЗначений = Сообщение.Фасовка.ВыгрузитьКолонку("КоличествоСлоев");
				Сообщение.Фасовка.Колонки.Удалить(КолонкаКоличествоСлоев);
				Сообщение.Фасовка.Колонки.Добавить("КоличествоСлоев", ПолучитьТип_КонтурEDI("ЧислоКоличество"));
				Сч = 0;
				Для каждого Эл Из МассивЗначений Цикл
					Если ЗначениеЗаполнено(Эл) Тогда
						Сообщение.Фасовка[Сч].КоличествоСлоев 						= Эл.Количество;
						Сообщение.Фасовка[Сч].КодЕдиницыИзмеренияКоличестваСлоев 	= Эл.КодЕдиницыИзмерения;
					КонецЕсли;
					Сч = Сч + 1;
				КонецЦикла;
			КонецЕсли;
			Если НЕ КолонкаКоличествоВСлое = Неопределено
				И КолонкаКоличествоВСлое.ТипЗначения = ОписаниеТипаСтруктура Тогда
				МассивЗначений = Сообщение.Фасовка.ВыгрузитьКолонку("КоличествоВСлое");
				Сообщение.Фасовка.Колонки.Удалить(КолонкаКоличествоВСлое);
				Сообщение.Фасовка.Колонки.Добавить("КоличествоВСлое", ПолучитьТип_КонтурEDI("ЧислоКоличество"));
				Сч = 0;
				Для каждого Эл Из МассивЗначений Цикл
					Если ЗначениеЗаполнено(Эл) Тогда
						Сообщение.Фасовка[Сч].КоличествоВСлое 						= Эл.Количество;
						Сообщение.Фасовка[Сч].КодЕдиницыИзмеренияКоличестваВСлое 	= Эл.КодЕдиницыИзмерения;
					КонецЕсли;
					Сч = Сч + 1;
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
		
		// ранее "Фасовка" была таблицей в сроке товара, сейчас это отдельная таблица
		Если Сообщение.Свойство("Фасовка") 
			И НЕ ЗначениеЗаполнено(Сообщение.Фасовка)
			И НЕ Сообщение.Товары.Колонки.Найти("Фасовка") = Неопределено Тогда
			
			Для каждого Строка Из Сообщение.Товары Цикл
				
				Если ЗначениеЗаполнено(Строка.Фасовка)
					И ТипЗнч(Строка.Фасовка) = Тип("ТаблицаЗначений") Тогда
					
					НовыйУИД = Новый УникальныйИдентификатор;
					Строка.ФасовкаТовара = НовыйУИД;
					
					ЕстьКолонкаКоличество		= НЕ Строка.Фасовка.Колонки.Найти("Количество") = Неопределено; 
					ЕстьКолонкаКоличествоСлоев 	= НЕ Строка.Фасовка.Колонки.Найти("КоличествоСлоев") = Неопределено; 
					ЕстьКолонкаКоличествоВСлое 	= НЕ Строка.Фасовка.Колонки.Найти("КоличествоВСлое") = Неопределено; 
					
					Для каждого СтрокаФасовки Из Строка.Фасовка Цикл
						НоваяСтрока = Сообщение.Фасовка.Добавить();
						
						НоваяСтрока.ФасовкаТовара 	= НовыйУИД;
						НоваяСтрока.КодТипаУпаковки = СтрокаФасовки.КодТипаУпаковки;
						Если ЕстьКолонкаКоличество Тогда
							НоваяСтрока.Количество 	= СтрокаФасовки.Количество;
						КонецЕсли;
						НоваяСтрока.КоличествоВОднойУпаковке = СтрокаФасовки.КоличествоВОднойУпаковке;
						НоваяСтрока.КодЕдиницыИзмеренияКоличестваВОднойУпаковке = СтрокаФасовки.ЕдиницаИзмеренияКоличестваВОднойУпаковке;
						Если ЕстьКолонкаКоличествоСлоев Тогда
							Если ТипЗнч(СтрокаФасовки.КоличествоСлоев) = Тип("Структура") Тогда
								Если СтрокаФасовки.КоличествоСлоев.Свойство("Количество") Тогда
									НоваяСтрока.КоличествоСлоев						= СтрокаФасовки.КоличествоСлоев.Количество;
								КонецЕсли;
								Если СтрокаФасовки.КоличествоСлоев.Свойство("КодЕдиницыИзмерения") Тогда
									НоваяСтрока.КодЕдиницыИзмеренияКоличестваСлоев	= СтрокаФасовки.КоличествоСлоев.КодЕдиницыИзмерения;
								КонецЕсли;
							Иначе		
								НоваяСтрока.КоличествоСлоев 					= СтрокаФасовки.КоличествоСлоев;
								НоваяСтрока.КодЕдиницыИзмеренияКоличестваСлоев 	= СтрокаФасовки.КодЕдиницыИзмеренияКоличестваСлоев;
							КонецЕсли;
						КонецЕсли;
						Если ЕстьКолонкаКоличествоВСлое Тогда
							Если ТипЗнч(СтрокаФасовки.КоличествоВСлое) = Тип("Структура") Тогда
								Если СтрокаФасовки.КоличествоВСлое.Свойство("Количество") Тогда
									НоваяСтрока.КоличествоВСлое						= СтрокаФасовки.КоличествоВСлое.Количество;
								КонецЕсли;
								Если СтрокаФасовки.КоличествоВСлое.Свойство("КодЕдиницыИзмерения") Тогда
									НоваяСтрока.КодЕдиницыИзмеренияКоличестваВСлое	= СтрокаФасовки.КоличествоВСлое.КодЕдиницыИзмерения;
								КонецЕсли;
							Иначе		
								НоваяСтрока.КоличествоВСлое 					= СтрокаФасовки.КоличествоВСлое;
								НоваяСтрока.КодЕдиницыИзмеренияКоличестваВСлое 	= СтрокаФасовки.КодЕдиницыИзмеренияКоличестваВСлое;
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если Сообщение.Свойство("ТранспортныеУпаковки") 
			И ЗначениеЗаполнено(Сообщение.ТранспортныеУпаковки) Тогда
			
			Для каждого Строка Из Сообщение.ТранспортныеУпаковки.Строки Цикл
				
				Если ЗначениеЗаполнено(Строка.ВесНетто) 
					И НЕ ЗначениеЗаполнено(Строка.КодЕдиницыИзмеренияВесаНетто) Тогда
					Строка.КодЕдиницыИзмеренияВесаНетто = "KGM";
				КонецЕсли;
				Если ЗначениеЗаполнено(Строка.ВесБрутто) 
					И НЕ ЗначениеЗаполнено(Строка.КодЕдиницыИзмеренияВесаБрутто) Тогда
					Строка.КодЕдиницыИзмеренияВесаБрутто = "KGM";
				КонецЕсли;
				Если ЗначениеЗаполнено(Строка.Длина) 
					И НЕ ЗначениеЗаполнено(Строка.КодЕдиницыИзмеренияДлины) Тогда
					Строка.КодЕдиницыИзмеренияДлины = "MTR";
				КонецЕсли;
				Если ЗначениеЗаполнено(Строка.Ширина) 
					И НЕ ЗначениеЗаполнено(Строка.КодЕдиницыИзмеренияШирины) Тогда
					Строка.КодЕдиницыИзмеренияШирины = "MTR";
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;

	Если СокрЛП(Сообщение.ВерсияМодуля) < "4.39.0" Тогда 
		
		ДополнитьСтруктуруГрузополучателиEDIЛогистическихСообщений(Сообщение);
			
	КонецЕсли;
	
	Если СокрЛП(Сообщение.ВерсияМодуля) < "4.46.0" Тогда
		
		ПеревестиТипКодовМаркировкиEDIв1С(Сообщение);
		
	КонецЕсли;
	
КонецПроцедуры

// Релиз 4.39.0
//
Процедура ДополнитьСтруктуруГрузополучателиEDIЛогистическихСообщений(Сообщение)
	
	Если НЕ ЭтоТипЛогистическогоСообщения(Сообщение.ТипСообщения) Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого Строка Из Сообщение.Грузополучатели Цикл
		
		Если ТипЗнч(Строка.ГрузополучательEDI) = Тип("Структура")
			И НЕ Строка.ГрузополучательEDI.Свойство("КоррСчет") Тогда
			
			Строка.ГрузополучательEDI.Вставить("КоррСчет");
			
		КонецЕсли;
	
	КонецЦикла;	
	
КонецПроцедуры

// Совместимость при переходе с расширения на типовое решение
//
Процедура ПеревестиТипКодовМаркировкиEDIв1С(Сообщение)
	
	Если (Сообщение.ТипСообщения = "DESADV" ИЛИ Сообщение.ТипСообщения = "INVOIC")
		И Сообщение.Товары.Колонки.Найти("КодыМаркировки") <> Неопределено
		И Сообщение.Товары.Колонки.КодыМаркировки.ТипЗначения.СодержитТип(Тип("СписокЗначений")) Тогда
		
		ЕстьКолонкаТипКодовМаркировки = Сообщение.Товары.Колонки.Найти("ТипКодовМаркировки") <> Неопределено;
		
		Для каждого Строка Из Сообщение.Товары Цикл
			
			Если НЕ ЗначениеЗаполнено(Строка.КодыМаркировки) Тогда
				Продолжить;		
			КонецЕсли;
			
			ВидКодаEDI_Общий = "";
			
			Если ЕстьКолонкаТипКодовМаркировки Тогда
				ВидКодаEDI_Общий = Строка.ТипКодовМаркировки;
			КонецЕсли;
			
			Для каждого Элемент Из Строка.КодыМаркировки Цикл
				
				ВидКодаEDI = Элемент.Представление;
				
				Если НЕ ЗначениеЗаполнено(ВидКодаEDI) Тогда
					ВидКодаEDI = ВидКодаEDI_Общий;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ВидКодаEDI) Тогда
					
					ВидКода = ПолучитьПредставлениеПеречисленияEDI(ВидКодаEDI, "ВидыКодовМаркировки");
					Если ЗначениеЗаполнено(ВидКода) Тогда
						Элемент.Представление =	ВидКода;
					Иначе
						Элемент.Представление = ВидКодаEDI;
					КонецЕсли;
					
				КонецЕсли; 	
			
			КонецЦикла;
		
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

