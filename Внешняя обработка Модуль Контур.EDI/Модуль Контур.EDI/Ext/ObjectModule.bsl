//ОСНОВНЫЕ ПРОЦЕДУРЫ/ФУНКЦИИ РАБОТЫ С МЕТРИКОЙ

// Отправляет данные напрямую в Контур.Метрика
//
// Параметры:
//  Событие	- Соответствие, Событие - Метрика описанная через объектную модель
//  Топик	- Строка				- топик, в который надо отправить событие
//
Функция Метрика_ОтправитьСобытие(Метрика_Событие, Топик) Экспорт

	Результат	= Новый Массив;
	Результат.Добавить(Метрика_ПроверитьИДозаполнить(Метрика_Событие));
	
	Данные				= Метрика_ПреобразоватьВJSON(Результат);
	РезультатОтправки 	= Метрика_ОтправитьHTTPЗапрос(ПараметрыКлиентСерверМетрика.URLАдреса[Топик], Данные);
	
	Возврат РезультатОтправки;

КонецФункции // Метрка_ОтправитьСобытие()

Функция Метрика_ПроверитьИДозаполнить(ГотоваяМетрика) Экспорт
	
	Метрика = Новый Соответствие;
	Метрика.Вставить("Id"			   	 , Метрика_НовыйУИД());
	Метрика.Вставить("ClientInstanceID"	 , ГотоваяМетрика["ClientInstanceID"]);
	Метрика.Вставить("Time"			   	 , Метрика_ПодготовитьВремя(ГотоваяМетрика["Time"]));
	Метрика.Вставить("Path"			   	 , Метрика_ПодготовитьСоставСобытия(ГотоваяМетрика["Path"]));
	Метрика.Вставить("TraceID"			 , ГотоваяМетрика["TraceID"]);
	Метрика.Вставить("Session"		   	 , Метрика_ПодготовитьСессию(ГотоваяМетрика["Session"]));
	Метрика.Вставить("AppContext"		 , ГотоваяМетрика["AppContext"]);	
	Метрика.Вставить("Variables"		 , Метрика_ПодготовитьПеременные(ГотоваяМетрика["Variables"]));
	Метрика.Вставить("ClientInfo"		 , ГотоваяМетрика["ClientInfo"]);
	
	ДолжныБытьНеПустые = Новый Массив;
	ДолжныБытьНеПустые.Добавить("Session");
	ДолжныБытьНеПустые.Добавить("AppContext");
	ДолжныБытьНеПустые.Добавить("Variables");
	ДолжныБытьНеПустые.Добавить("TraceID");
	ДолжныБытьНеПустые.Добавить("ClientInfo");
	
	Для Каждого Поле из ДолжныБытьНеПустые Цикл
		Если Метрика[Поле] = Неопределено Тогда
			Метрика.Удалить(Поле);
		КонецЕсли;
	КонецЦикла;
	
	ПолеКатегория = Метрика["Path"]["Category"];
	Если ПолеКатегория = Неопределено Тогда
		Метрика["Path"]["Category"] = "ПоУмолчанию";	
	КонецЕсли;
	
	Возврат Метрика;
	
КонецФункции

// Отправляет пакет данных напрямую в Контур.Метрика 
// 
// Параметры: 
//  ПакетСобытий  - Массив   - массив событий для отправки.  
//                  События должны принадлежать одному топику 
//  Топик      - Строка  - топик, в который надо отправить событие 
// 
Функция Метрика_ОтправитьПакетСобытий(ПакетСобытий, Топик) Экспорт

	ПакетСобытийНаОтправку	= Метрика_ПроверитьИДозаполнитьПакет(ПакетСобытий);
	
	Если РежимЗапускаПриложения() = "Регламентное задание" Тогда
	
		Попытка
		
			Результат = Метрика_ОбработатьОтложеннуюОтправку(ПакетСобытийНаОтправку, Топик);
			
			Если Результат.Успешно Тогда
				Если ЗначениеЗаполнено(Результат.Данные) Тогда // пакет событий дополнен отложенными ранее
					ПакетСобытийНаОтправку = Результат.Данные;
				Иначе // отправка отложена
					Возврат Результат;
				КонецЕсли;
			КонецЕсли;
			
		Исключение

			_ОписаниеОшибки = "Не удалось обработать отложенную отправку метрик - " + ОписаниеОшибки();
			Метрика_Переменные = Неопределено;
			Метрика_ОтправитьСразу = Истина;
			Метрика_Ошибка("ОбработкаОтложеннойОтправкиМетрик", _ОписаниеОшибки, ИнформацияОбОшибке(), Метрика_Переменные, Метрика_ОтправитьСразу);	
	
		КонецПопытки;
		
	КонецЕсли;
	
	Данные				= Метрика_ПреобразоватьВJSON(ПакетСобытийНаОтправку);
	РезультатОтправки 	= Метрика_ОтправитьHTTPЗапрос(ПараметрыКлиентСерверМетрика.URLАдреса[Топик], Данные);
	
	Возврат РезультатОтправки;

КонецФункции // Метрка_ОтправитьСобытие()

// Отправляет пакет данных напрямую в Контур.Метрика отдельно по событиям 
// 
// Параметры: 
//  ПакетСобытий  - Массив   - массив событий для отправки.  
//                  События должны принадлежать одному топику 
//  Топик      - Строка  - топик, в который надо отправить событие 
// 
Функция Метрика_ОтправитьПакетСобытийРаздельно(ПакетСобытий, Топик) Экспорт 
	
	Если ПакетСобытий.Количество() = 0 Тогда //пустой пакет 
		Возврат Истина; 
	КонецЕсли; 
	
	ЕстьОшибка = Ложь; 
	Для каждого Событие Из ПакетСобытий Цикл 
		РезультатОтправки = Метрика_ОтправитьСобытие(Событие, Топик); 
		ЕстьОшибка = ЕстьОшибка  
		Или НЕ РезультатОтправки.Успешно; 
	КонецЦикла; 
	
	Возврат НЕ ЕстьОшибка; 
   
КонецФункции // Метрка_ОтправитьСобытие() 

Функция Метрика_ПроверитьИДозаполнитьПакет(Знач Метрика_ПакетСобытий)
	
	МассивПроверенных = Новый Массив;
	
	Для каждого Событие Из Метрика_ПакетСобытий Цикл
		МассивПроверенных.Добавить(Метрика_ПроверитьИДозаполнить(Событие));
	КонецЦикла;
	
	Возврат МассивПроверенных;	
	
КонецФункции

// Вместо отправки, аккумулирует события в стек, для пакетной отправки 
// 
// Параметры: 
//  Метрика    - Соответствие - подготовленная пользователем метрика 
//  Топик    - Строка - топик, к которому относиться метрика 
// 
// Возвращаемое значение: 
//   Число    - количество событий, помещенных в стек 
// 
Функция Метрика_ПоместитьСобытиеВСтек(Метрика, Топик) Экспорт
	
	СтекСобытий = Метрика_ИзвлечьИзВХ("СтекСобытий");
	Если СтекСобытий = Неопределено Тогда
		СтекСобытий = Новый Массив;
	КонецЕсли;
	
	СтекСобытий.Добавить(Новый Структура("Топик, Метрика", 
											Топик, 
											Метрика));
	
	Метрика_ПоместитьВоВХ("СтекСобытий", СтекСобытий);
	
	Возврат СтекСобытий.Количество();
	
КонецФункции // Метрика_ПоместитьСобытиеВСтек()

// Пакетная отправка событий в метрику 
// 
// Параметры: 
//  СтекСобытийКлиент  - массив - массив подготовленных метрик с клиента 
// 
// Возвращаемое значение: 
//   Булево   - признак удачной отправки 
// 
Функция Метрика_ОтправитьВсеСобытияСтека(СтекСобытийКлиент = Неопределено) Экспорт
	
	СтекСобытий = Метрика_ИзвлечьИзВХ("СтекСобытий");
	
	Если НЕ ЗначениеЗаполнено(СтекСобытий)
		И НЕ ЗначениеЗаполнено(СтекСобытийКлиент) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Метрика_ПоместитьВоВХ("СтекСобытий", Новый Массив);
	
	СобытияПоТопикам = Метрика_ПодготовитьСтруктуруДляПакетнойОтправкиСобытий();
	
	Если ЗначениеЗаполнено(СтекСобытий) Тогда
		Метрика_РазобратьСобытияПоТопикам(СобытияПоТопикам, СтекСобытий);
	КонецЕсли;
	Если ЗначениеЗаполнено(СтекСобытийКлиент) Тогда
		Метрика_РазобратьСобытияПоТопикам(СобытияПоТопикам, СтекСобытийКлиент);
	КонецЕсли;
	
	Для каждого Эл Из СобытияПоТопикам Цикл
		ПакетСобытий 				= Эл.Значение;
		Топик 						= Эл.Ключ;
		
		Если Не ЗначениеЗаполнено(ПакетСобытий) Или ПакетСобытий.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		РезультатОтправкиПакета = Метрика_ОтправитьПакетСобытий(ПакетСобытий, Топик);
		Если НЕ РезультатОтправкиПакета.Успешно Тогда //если пакет не ушел целиком, отправим отдельно по событиям
			РезультатОтправкиПакета.Успешно = Метрика_ОтправитьПакетСобытийРаздельно(ПакетСобытий, Топик);
		КонецЕсли;
	КонецЦикла;
	
	Возврат РезультатОтправкиПакета;
	
КонецФункции

Процедура Метрика_РазобратьСобытияПоТопикам(СобытияПоТопикам, Знач СтекСобытий)
	
	Для каждого Событие Из СтекСобытий Цикл
		Если СобытияПоТопикам[Событие.Топик] = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СобытияПоТопикам[Событие.Топик].Добавить(Событие.Метрика);
	КонецЦикла;
	
КонецПроцедуры

Функция Метрика_ПодготовитьСтруктуруДляПакетнойОтправкиСобытий()
	
	СтруктураДляПакетнойОтправки = Новый Соответствие;
	Топики = Метрика_Топики();
	
	Для каждого ИмяТопика Из Топики Цикл
		СтруктураДляПакетнойОтправки.Вставить(ИмяТопика, Новый Массив);		
	КонецЦикла;
	
	Возврат СтруктураДляПакетнойОтправки;
	
КонецФункции

//ОБЕРТКИ

// Если необходимо передать весь дополнительный контекст работы модуля, например, при начале работы или в момент ошибки
// Контекст формируется в функции Метрика_СформироватьКонтекстМодуля()
// Параметры:
//  Категория	  	- Строка		- Имя метода или глобальной категории событий 
//  Метка			- Строка		- произвольная строка
//	Представление	- Строка		- имя формы, в которой произошло событие
//	ОтправитьСразу	- Булево		- отправить сразу или положить в стек событий для отложенной отправки
//
Процедура Метрика_КонтекстМодуля(Категория, 
									Метка = Неопределено, 
									Представление = Неопределено,
									ОтправитьСразу = Ложь) Экспорт
															
 	Событие = Метрика_НовыйСобытие(Категория, "moduleContext", Метка, Представление);
	
	Переменные = Метрика_ИзвлечьИзВХ("КонтекстМодуля");
	
	Метрика_ЗарегистрироватьСобытие("Statistics",
									Событие, 
									, 
									Переменные, 
									Истина,
									ОтправитьСразу);

КонецПроцедуры // Метрика_ПередатьКонтекстРаботыМодуля

// Можно использовать при необходимости передать установленные настройки всех партнеров
//
// Параметры:
//  Категория	  	- Строка		- Имя метода или глобальной категории событий 
//  Метка			- Строка		- произвольная строка
//	Представление	- Строка		- имя формы, в которой произошло событие
//	ОтправитьСразу	- Булево		- отправить сразу или положить в стек событий для отложенной отправки
//
Процедура Метрика_НастройкиПартнеров(Категория,
										Метка = Неопределено,
										Представление = Неопределено,
										ОтправитьСразу = Ложь) Экспорт
											
	ФильтрПартнеров = Неопределено;									
	НастройкиПартнеров = ПолучитьЗначенияНастроекПартнеров(ФильтрПартнеров, Истина);

	ПакетыНастроек = Новый Массив;
	РазмерПакета = 20; // укладываемся в лимит принимающей инфраструктуры 450кб на одно событие
	
	Если НастройкиПартнеров.Количество() <= РазмерПакета Тогда
		ПакетыНастроек.Добавить(НастройкиПартнеров);		
	Иначе
		
		ПакетНастроекПартнеров = Новый Соответствие;
		Для Каждого НастройкаПартнера Из НастройкиПартнеров Цикл
			
			Если ПакетНастроекПартнеров.Количество() = РазмерПакета Тогда
				ПакетыНастроек.Добавить(ПакетНастроекПартнеров);	
				ПакетНастроекПартнеров = Новый Соответствие;
			КонецЕсли;
			
			ПакетНастроекПартнеров.Вставить(НастройкаПартнера.Ключ, НастройкаПартнера.Значение);	
			
		КонецЦикла;
			
		Если ПакетНастроекПартнеров.Количество() > 0 Тогда
			ПакетыНастроек.Добавить(ПакетНастроекПартнеров);
		КонецЕсли;
	КонецЕсли;
	
	КоличествоПакетов = ПакетыНастроек.Количество();
	
	Для НомерПакета = 1 По КоличествоПакетов Цикл
		
		Если КоличествоПакетов > 1 Тогда
			Метка = "Часть " + НомерПакета + " из " + КоличествоПакетов;
		КонецЕсли;

		Событие = Метрика_НовыйСобытие(Категория, "partnersSettings", Метка, Представление);
	
		Метрика_ЗарегистрироватьСобытие("Statistics",
										Событие,
										,
										ПакетыНастроек[НомерПакета - 1],
										,
										ОтправитьСразу);
	КонецЦикла;
										
КонецПроцедуры

Процедура Метрика_НачалоСеанса() Экспорт

	Событие = Метрика_НовыйСобытие("session", "start", , );
	
	Метрика_ЗарегистрироватьСобытие("Behavior",
									Событие, 
									, 
									ПараметрыКлиентСерверМетрика.ДополнительныеСвойстваКонфигурации, 
									Истина,
									);

КонецПроцедуры // Метрика_НачалоСеанса()

Процедура Метрика_КонецСеанса() Экспорт

	Событие = Метрика_НовыйСобытие("session", "finish", , );
	
	Метрика_ЗарегистрироватьСобытие("Behavior",
									Событие, 
									, 
									, 
									,
									Истина);

КонецПроцедуры // Метрика_КонецСеанса()

Процедура Метрика_ДобавитьПеременную(Переменные, ИмяПеременной, Переменная)

	Если Переменные = Неопределено Тогда
		Переменные = Новый Структура;
	КонецЕсли;
	
	Переменные.Вставить(ИмяПеременной, Переменная);

КонецПроцедуры // Метрика_ДобавитьПеременную()

Функция Метрика_ПодготовитьПеременныеДля(Категория = Неопределено, Знач Параметры = Неопределено) Экспорт
	
	Метрика_Переменные = Новый Структура;
	
	Если Категория = "ПостроитьСписокЗадач_Сервер" Тогда
		
		Метрика_Переменные.Вставить("РежимРаботы", 						Параметры["РежимРаботы"]);
		Метрика_Переменные.Вставить("НачалоПериода", 					Параметры["НачалоПериода"]);
		Метрика_Переменные.Вставить("КонецПериода", 					Параметры["КонецПериода"]);
		
		//Метрика_Переменные.Вставить("МассивОрганизаций", 				Параметры["МассивОрганизаций"]);
		МассивОрганизаций = Параметры["МассивОрганизаций"];
		Метрика_Переменные.Вставить("КоличествоОрганизаций", 			МассивОрганизаций.Количество());
		
		//Метрика_Переменные.Вставить("МассивПартнеров", 				Параметры["МассивПартнеров"]);
		МассивПартнеров = Параметры["МассивПартнеров"];
		Метрика_Переменные.Вставить("КоличествоПартнеров", 				МассивПартнеров.Количество());
		
		Метрика_Переменные.Вставить("МассивТиповСообщений", 			Параметры["МассивТиповСообщений"]);
		Метрика_Переменные.Вставить("МассивТребуемыхДействий", 			Параметры["МассивТребуемыхДействий"]);
		Метрика_Переменные.Вставить("КоличествоСтрок", 					Параметры["КоличествоСтрок"]);
		Метрика_Переменные.Вставить("ПоказыватьЗавершенные", 			Параметры["ПоказыватьЗавершенные"]);
		
		ПодсчитанныеКоличестваВОтборах = Новый Структура;
		ВремПодсчитанныеКоличестваВОтборах = Параметры["ПодсчитанныеКоличестваВОтборах"];

		Если НЕ ВремПодсчитанныеКоличестваВОтборах = Неопределено Тогда
			
			//ПодсчитанныеКоличестваВОтборах.Вставить("КоличествоОрганизаций",		ТаблицаЗначенийВМассив_КонтурEDI(ВремПодсчитанныеКоличестваВОтборах.ТабКоличествоОрганизаций));
			//ПодсчитанныеКоличестваВОтборах.Вставить("КоличествоПартнеров", 		ТаблицаЗначенийВМассив_КонтурEDI(ВремПодсчитанныеКоличестваВОтборах.ТабКоличествоПартнеров));
			
			КоличествоСообщений = Неопределено;
			Если ЗначениеЗаполнено(ВремПодсчитанныеКоличестваВОтборах.ТабКоличествоСообщений) Тогда
				КоличествоСообщений = ТаблицаЗначенийВМассив_КонтурEDI(ВремПодсчитанныеКоличестваВОтборах.ТабКоличествоСообщений);
			КонецЕсли;
			ПодсчитанныеКоличестваВОтборах.Вставить("КоличествоСообщений", КоличествоСообщений);
			
			КоличествоТребуемыхДействий = Неопределено;
			Если ЗначениеЗаполнено(ВремПодсчитанныеКоличестваВОтборах.ТабКоличествоТребуемыхДействий) Тогда
				КоличествоТребуемыхДействий = ТаблицаЗначенийВМассив_КонтурEDI(ВремПодсчитанныеКоличестваВОтборах.ТабКоличествоТребуемыхДействий);
			КонецЕсли;
			ПодсчитанныеКоличестваВОтборах.Вставить("КоличествоТребуемыхДействий", КоличествоТребуемыхДействий);
			
		КонецЕсли;
		Метрика_Переменные.Вставить("ПодсчитанныеКоличестваВОтборах", 	ПодсчитанныеКоличестваВОтборах);
	КонецЕсли;
	
	Возврат Метрика_Переменные;
	
КонецФункции

Процедура Метрика_ЗарегистрироватьСобытие(Топик,
											Событие, 
											TraceID = Неопределено, 
											Переменные = Неопределено, 
											ДобавитьСистемнуюИнформацию = Ложь,
											ОтправитьСразу = Ложь) Экспорт
										
	Если Топик = Неопределено 
		ИЛИ Событие = Неопределено 
		ИЛИ ПараметрыКлиентСерверМетрика = Неопределено
		ИЛИ ПараметрыКлиентСерверМетрика.URLАдреса = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторКлиента 	= ПараметрыКлиентСерверМетрика.ИдентификаторКлиента; 
	МоментВремени			= Метрика_НовыйМоментВремениВозникновения(); 
	Сессия					= Метрика_НовыйСессия(ПараметрыКлиентСерверМетрика.ИдентификаторСессии,
								ПараметрыКлиентСерверМетрика.СессияОбщепродуктовая,
								ПараметрыКлиентСерверМетрика.СессияNormative,
								,,
								ПараметрыКлиентСерверМетрика.СессияEDI); 

	КонтекстПриложения 		= ?(ДобавитьСистемнуюИнформацию, ПараметрыКлиентСерверМетрика.КонтекстПриложенияСервер, Неопределено);
	
	Метрика = Метрика_НовыйМетрика(ИдентификаторКлиента, 
									МоментВремени, 
									Событие, 
									TraceID,
									Сессия, 
									КонтекстПриложения, 
									Переменные);
										
	Если ОтправитьСразу Тогда
		Метрика_ОтправитьСобытие(Метрика, Топик);
	Иначе
		Метрика_ПоместитьСобытиеВСтек(Метрика, Топик);
	КонецЕсли;	
		
КонецПроцедуры

Функция Метрика_ОтметкаВремени() Экспорт
	
	ОтметкаВремени = Неопределено;
	
	Попытка
		Выполнить("ОтметкаВремени = ТекущаяУниверсальнаяДатаВМиллисекундах()");
	Исключение
		ОтметкаВремени = ТекущаяДата();
	КонецПопытки;
	
	Возврат ОтметкаВремени;
	
КонецФункции

Процедура Метрика_ВремяНачалаЗамера(TraceID, ВремяНачала)

	Замеры = Метрика_ИзвлечьИзВХ("Замеры");
	
	Если Замеры = Неопределено Тогда
		Замеры = Новый Соответствие;
	КонецЕсли;
	
	Замеры.Вставить(TraceID, ВремяНачала);
	
	Метрика_ПоместитьВоВХ("Замеры", Замеры);
	
КонецПроцедуры

Функция Метрика_Длительность(ВремяНачала, ВремяОкончания) Экспорт
	
	Знаменатель = ?(ТипЗнч(ВремяНачала) = Тип("Число"), 1000, 1);
	Возврат (ВремяОкончания - ВремяНачала) / Знаменатель; 
	
КонецФункции

Функция Метрика_ДлительностьЗамера(TraceID, ВремяОкончания)
	
	Длительность = Неопределено;

	Замеры = Метрика_ИзвлечьИзВХ("Замеры");
	
	Если Замеры = Неопределено Тогда
		Замеры = Новый Соответствие;
	КонецЕсли;
	
	ВремяНачала = Замеры[TraceID];
	
	Если ТипЗнч(ВремяНачала) = Тип("Число") Тогда
		Замеры.Удалить(TraceID);
		Длительность = Метрика_Длительность(ВремяНачала, ВремяОкончания);
	КонецЕсли;
	
	Метрика_ПоместитьВоВХ("Замеры", Замеры);
		
	Возврат Длительность;

КонецФункции

// Переменные:
// TraceID 						- Строка 		- обязателен, идентификатор события замера
// Категория    				- Строка 		- обязателен, название для группировки событий
// ВремяНачала                  - Число			- время начала в тиках ТекущаяУниверсальнаяДатаВМиллисекундах()
// Представление 				- Строка 		- указание места сбора метрики, МодульОбъекта или имя формы
// Метка            			- Строка 		- произвольная метка
// Переменные       			- Структура  	- набор дополнительных переменных
// ДобавитьСистемнуюИнформацию  - Булево		- нужно добавить системную информацию к этому событию?
// ОтправитьСразу				- Булево		- нужно сразу отправить или поместить в стек для отложенной отправки?
//
Процедура Метрика_НачатьЗамер(TraceID,
							Категория,
							ВремяНачала = Неопределено,
							Представление = "МодульОбъекта",
							Метка = Неопределено,
							Переменные = Неопределено, 
							ДобавитьСистемнуюИнформацию = Ложь, 
							ОтправитьСразу = Ложь) Экспорт

	Если ВремяНачала = Неопределено Тогда
		ВремяНачала = Метрика_ОтметкаВремени();	
	КонецЕсли;
	Метрика_ВремяНачалаЗамера(TraceID, ВремяНачала);	
	
	Событие = Метрика_НовыйСобытие(Категория, "start", Метка, Представление);
	
	Метрика_ЗарегистрироватьСобытие("Health",
									Событие, 
									TraceID, 
									Переменные, 
									ДобавитьСистемнуюИнформацию,
									ОтправитьСразу);

КонецПроцедуры // Метрика_НачатьЗамер()

// Переменные:
// TraceID 						- Строка 		- обязателен, идентификатор события замера
// Категория    				- Строка 		- обязателен, название для группировки событий
// ВремяОкончания               - Число			- время окончания в тиках ТекущаяУниверсальнаяДатаВМиллисекундах()
// Представление 				- Строка 		- указание места сбора метрики, МодульОбъекта или имя формы
// Метка            			- Строка 		- произвольная метка
// Переменные       			- Структура  	- набор дополнительных переменных
// ДобавитьСистемнуюИнформацию  - Булево		- нужно добавить системную информацию к этому событию?
// ОтправитьСразу				- Булево		- нужно сразу отправить или поместить в стек для отложенной отправки?
//
Процедура Метрика_ЗакончитьЗамер(TraceID, 
									Категория, 
									ВремяОкончания = Неопределено,
									Представление = "МодульОбъекта",
									Метка = Неопределено,
									Переменные = Неопределено, 
									ДобавитьСистемнуюИнформацию = Ложь, 
									ОтправитьСразу = Ложь) Экспорт
									
	Если ВремяОкончания = Неопределено Тогда
		ВремяОкончания = Метрика_ОтметкаВремени();	
	КонецЕсли;
	
	Длительность = Метрика_ДлительностьЗамера(TraceID, ВремяОкончания);
	Метрика_ДобавитьПеременную(Переменные, "Длительность", Длительность);
	
	Событие = Метрика_НовыйСобытие(Категория, "finish", Метка, Представление);
	
	Метрика_ЗарегистрироватьСобытие("Health",
									Событие, 
									TraceID, 
									Переменные, 
									ДобавитьСистемнуюИнформацию,
									ОтправитьСразу);
	
КонецПроцедуры // Метрика_ЗакончитьЗамер()

// Аналог ЗаписьЖурналаРегистрации. Параметры имеют примерно тот же смысл.
//
// Параметры:
//  МестоОшибки  	- Строка		- Действие или имя метода 
//  Уровень			- Строка		- категория события: error, info
//	ОписаниеОшибки	- Строка		- результат ОписаниеОшибки()
//	Представление	- Структура		- имя формы, модуля
//	Переменные		- Структура		- произвольная информация
//	ОтправитьСразу	- Булево		- отправить сразу или положить в стек событий для отложенной отправки
//
Процедура Метрика_ЗаписьЖурнала(МестоОшибки,
									УровеньЗаписи, 
									КомментарийЗаписи, 
									Представление = "МодульОбъекта",
									Переменные = Неопределено,
									ОтправитьСразу = Ложь,
									ИдентификаторТрассировки = Неопределено) Экспорт
							
	Событие = Метрика_НовыйСобытие(МестоОшибки, УровеньЗаписи, КомментарийЗаписи, Представление);
	
	ДобавитьСистемнуюИнформацию = Истина;
	Метрика_ЗарегистрироватьСобытие("Log",
									Событие, 
									ИдентификаторТрассировки, 
									Переменные, 
									ДобавитьСистемнуюИнформацию,
									ОтправитьСразу);

КонецПроцедуры // Метрика_ЗаписьЖурнала
								
// На вход подается объект ИнформацияОбОшибке()
// на выходе Структура с полями: ИмяМодуля, ИсходнаяСтрока, НомерСтроки, Описание, ПричинаОписание
// так должно быть удобнее отслеживать ошибки в метрике
//
Функция Метрика_СформироватьПодробноеОписаниеОшибки(ИнформацияОбОшибке = Неопределено) Экспорт

	Если ИнформацияОбОшибке = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПодробноеОписаниеОшибки = Новый Структура;
	
	ПодробноеОписаниеОшибки.Вставить("ИмяМодуля",			ИнформацияОбОшибке.ИмяМодуля);
	ПодробноеОписаниеОшибки.Вставить("ИсходнаяСтрока",		ИнформацияОбОшибке.ИсходнаяСтрока);
	ПодробноеОписаниеОшибки.Вставить("НомерСтроки",			ИнформацияОбОшибке.НомерСтроки);
	ПодробноеОписаниеОшибки.Вставить("Описание",			ИнформацияОбОшибке.Описание);
	ПричинаОписание = Неопределено;
	Если НЕ ИнформацияОбОшибке.Причина = Неопределено Тогда  
		ПричинаОписание = ИнформацияОбОшибке.Причина.Описание;
    КонецЕсли;
	ПодробноеОписаниеОшибки.Вставить("ПричинаОписание",		ПричинаОписание);
	
	Возврат ПодробноеОписаниеОшибки;

КонецФункции // Метрика_СформироватьПодробноеОписаниеОшибки()

// Отправляет данные о возникшей ошибке
//
// Параметры:
//  МестоОшибки			- Строка - событие, вызвавшее ошибку, например АвтообновлениеМодуля
//  ОписаниеОшибки  	- Строка - описание возникшей ошибки, например из ОписаниеОшибки()
//  ИнформацияОбОшибке  - ИнформацияОбОшибке - см. в справке встроенный тип ИнформацияОбОшибке().
//												Разбирается на структуру и передаётся как доп. переменная см. Переменные
//	Переменные			- Структура - произвольные переменные в формате имя-значение
//  ОтправитьСразу		- Булево - по умолчанию событие будет добавлено в стек и отправлено позже. 
// 									Для незамедлительной отправки нужно установить Истина.
//	ИдентификаторТрассировки - УникальныйИдентификатор, Строка - позволяет добавить сквозной идентификатор для цепочки событий
//
Процедура Метрика_Ошибка(МестоОшибки,
							ОписаниеОшибки,
							ИнформацияОбОшибке = Неопределено,
							Переменные = Неопределено, 
							ОтправитьСразу = Ложь,
							ИдентификаторТрассировки = Неопределено) Экспорт

	Событие = Метрика_НовыйСобытие(МестоОшибки, "error", ОписаниеОшибки, "МодульОбъекта");
	
	Метрика_ДобавитьПеременную(Переменные, "ИнформацияОбОшибке", Метрика_СформироватьПодробноеОписаниеОшибки(ИнформацияОбОшибке));
	
	Если ПараметрыКлиентСерверМетрика <> Неопределено Тогда
		Метрика_ДобавитьПеременную(Переменные, "КонтекстМодуля", Метрика_ИзвлечьИзВХ("КонтекстМодуля"));
	КонецЕсли;
	
	ДобавитьСистемнуюИнформацию = Истина;
	
	Метрика_ЗарегистрироватьСобытие("Log",
									Событие, 
									ИдентификаторТрассировки, 
									Переменные, 
									ДобавитьСистемнуюИнформацию,
									ОтправитьСразу);

КонецПроцедуры // Метрика_Ошибка

// Отправляет данные о предупреждении
//
// Параметры:
//  МестоПредупреждения		- Строка - событие, вызвавшее предупреждение, например АвтообновлениеМодуля
//  ОписаниеПредупреждения 	- Строка - описание возникшего предупреждения
//	Переменные				- Структура - произвольные переменные в формате имя-значение
//  ОтправитьСразу			- Булево - по умолчанию событие будет добавлено в стек и отправлено позже. 
// 										Для незамедлительной отправки нужно установить Истина.
//	ИдентификаторТрассировки - УникальныйИдентификатор, Строка - позволяет добавить сквозной идентификатор для цепочки событий
//
Процедура Метрика_Предупреждение(МестоПредупреждения,
									ОписаниеПредупреждения,
									Переменные = Неопределено,
									ОтправитьСразу = Ложь,
									ИдентификаторТрассировки = Неопределено) Экспорт

	Событие = Метрика_НовыйСобытие(МестоПредупреждения, "warning", ОписаниеПредупреждения, "МодульОбъекта");
	
	Если ПараметрыКлиентСерверМетрика <> Неопределено Тогда
		Метрика_ДобавитьПеременную(Переменные, "КонтекстМодуля", Метрика_ИзвлечьИзВХ("КонтекстМодуля"));
	КонецЕсли;
	
	ДобавитьСистемнуюИнформацию = Истина;
	
	Метрика_ЗарегистрироватьСобытие("Log",
									Событие, 
									ИдентификаторТрассировки, 
									Переменные, 
									ДобавитьСистемнуюИнформацию,
									ОтправитьСразу);

КонецПроцедуры // Метрика_Предупреждение

// Отправляет произвольную информацию
//
// Параметры:
//  Место			- Строка - событие для регистрации, например АвтообновлениеМодуля
//  Информация 		- Строка - произвольная информация
//	Переменные		- Структура - произвольные переменные в формате имя-значение
//  ОтправитьСразу	- Булево - по умолчанию событие будет добавлено в стек и отправлено позже. 
// 								Для незамедлительной отправки нужно установить Истина.
//	ИдентификаторТрассировки - УникальныйИдентификатор, Строка - позволяет добавить сквозной идентификатор для цепочки событий
//
Процедура Метрика_Информация(Место,
								Информация,
								Переменные = Неопределено, 
								ОтправитьСразу = Ложь,
								ИдентификаторТрассировки = Неопределено) Экспорт

	Событие = Метрика_НовыйСобытие(Место, "info", Информация, "МодульОбъекта");
	
	Если ПараметрыКлиентСерверМетрика <> Неопределено Тогда
		Метрика_ДобавитьПеременную(Переменные, "КонтекстМодуля", Метрика_ИзвлечьИзВХ("КонтекстМодуля"));
	КонецЕсли;
	
	ДобавитьСистемнуюИнформацию = Истина;
	
	Метрика_ЗарегистрироватьСобытие("Log",
									Событие, 
									ИдентификаторТрассировки, 
									Переменные, 
									ДобавитьСистемнуюИнформацию,
									ОтправитьСразу);

КонецПроцедуры // Метрика_Информация

Процедура Метрика_ОбработатьРезультатАвтообновления(Место, Результат) Экспорт

	Если Результат.Свойство("ОбновленныеРасширения") Тогда
		Метрика_Переменные = Новый Структура("ОбновленныеРасширения", Результат.ОбновленныеРасширения);
	Иначе
		Метрика_Переменные = Неопределено;		
	КонецЕсли;		
	
	Метрика_ОтправитьСразу = Истина;
	
	Если Не Результат.Успешно Тогда

		Метрика_Ошибка(Место, Результат.ТекстОшибки, , Метрика_Переменные, Метрика_ОтправитьСразу);
			
		ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Ошибка, Результат.ТекстОшибки);
		
	ИначеЕсли Результат.Свойство("ОбновленныеРасширения") Тогда	
		
		Метрика_Информация(Место, "Автообновление расширений выполнено успешно", Метрика_Переменные, Метрика_ОтправитьСразу);
		
	КонецЕсли;
	
КонецПроцедуры

//ИЗ ГЛОБАЛЬНЫХ МОДУЛЕЙ

// Адрес на который надо отправлять данные для фиксации в метрике.
//
//
// Возвращаемое значение:
//   Строка   - полный адрес
//
Функция Метрика_АдресДляОтправкиДанныхОСобытии(topic)
	
	ИмяТопика = topic; 
	
	Если Метрика_ЭтоМетрикаEDI(ИмяТопика) Тогда
		ИмяТопика = КонтурСтандарт_СтрШаблон_("%1_%2", Метрика_Модуль(), ИмяТопика); 	
	КонецЕсли;
	        
	Возврат КонтурСтандарт_СтрШаблон_("/metrika-pipe/v1/sources/1CModule/topics/%1/events", ИмяТопика);
	
КонецФункции // АдресДляОтправкиДанныхОСобытии()

Процедура Метрика_ОбновлениеМодуля(КонтекстОбновленияМодуля, ТекстОшибки = "", ТипОбновления = "Полуавтоматически") Экспорт
	
	// Метод присутствует в клиентском и серверном модулях

	Переменные = Новый Структура;
	Переменные.Вставить("НоваяВерсия"	, КонтекстОбновленияМодуля.НоваяВерсия);
	Переменные.Вставить("СтараяВерсия"	, КонтекстОбновленияМодуля.Версия);
	Переменные.Вставить("ТипОбновления" , ТипОбновления);     
	
	Для Каждого КлючЗначение Из КонтекстОбновленияМодуля Цикл
		
		Переменные.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		
	КонецЦикла;
		
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Метрика_Ошибка("АвтообновлениеМодуля", ТекстОшибки, , Переменные, Истина);
	Иначе
		Метрика_Информация("АвтообновлениеМодуля", "" , Переменные, Истина);
	КонецЕсли;
	
КонецПроцедуры

// Для какого модуля собираются метрики 
// 
// Возвращаемое значение: 
//   Строка   - имя модуля EDI, Mercury, Sverka, Focus, Extern, DD 
// 
Функция Метрика_Модуль() Экспорт
	Возврат "EDI";
КонецФункции  

Функция Метрика_ЭтоМетрикаEDI(topic) Экспорт
	
	ЭтоМетрикаEDI = Истина;
	
	Если ВРег(СокрЛП(topic)) = ВРег(МетрикаКонтурСлужебный_CommonStatistics()) Тогда
		ЭтоМетрикаEDI = Ложь;
	КонецЕсли;
	
	Возврат ЭтоМетрикаEDI;
	
КонецФункции	
		
Функция Метрика_ТиповаяСтруктураМетрики() Экспорт
	
	СтруктураСобытия = Новый Соответствие;
	
	//Обязательные поля
	
	СтруктураСобытия.Вставить("Id", 					Метрика_НовыйУИД());
	СтруктураСобытия.Вставить("ClientInstanceID");
	СтруктураСобытия.Вставить("Time");
	СтруктураСобытия.Вставить("Path");
	СтруктураСобытия.Вставить("Variables");
	СтруктураСобытия.Вставить("Session", 				Метрика_НовыйСессия(ПараметрыКлиентСерверМетрика.ИдентификаторСессии,
														ПараметрыКлиентСерверМетрика.СессияОбщепродуктовая,
														ПараметрыКлиентСерверМетрика.СессияNormative,
														,,
														ПараметрыКлиентСерверМетрика.СессияEDI));
	СтруктураСобытия.Вставить("TraceID");
	СтруктураСобытия.Вставить("AppContext");
	
	СтруктураСобытия.Вставить("Topic"); //Этого поля в структуре метрики нет, нужно для фиксации топика
	
	Возврат СтруктураСобытия;
	
КонецФункции

Функция Метрика_ПреобразоватьВерсиюВСемантик(Знач Версия) Экспорт
	
	Если Не ЗначениеЗаполнено(Версия) Тогда
		Возврат "0.0.0";
	КонецЕсли;
	
	Версия 			= Строка(Версия);	
	МассивРазрядов 	= EDI_РазложитьСтрокуВМассивСлов(Версия, "./");
	СемантикВерсия	= "";
	
	Сч = 0;
	Разделитель = "";
	ТекРазряд = "";
	Для каждого Разряд Из МассивРазрядов Цикл
		Сч = Сч + 1;
		Если Сч < 4 Тогда
			ТекРазряд = ?(ТолькоЦифрыВСтроке_КонтурEDI(Разряд), Разряд, "0");
		Иначе
			ТекРазряд = СтрЗаменить(Разряд, " ", "");
		КонецЕсли;	
		СемантикВерсия = СемантикВерсия + Разделитель + ТекРазряд;
		Если Сч < 3 Тогда
			Разделитель = ".";
		ИначеЕсли Сч = 3 Тогда
			Разделитель = "-";
		Иначе
			Разделитель = "";
		КонецЕсли;
	КонецЦикла;
	
	Пока Сч < 3 Цикл
		СемантикВерсия = СемантикВерсия + ".0";
		Сч = Сч + 1;
	КонецЦикла;	
	
	Возврат СемантикВерсия;
	
КонецФункции

Функция Метрика_СформироватьСтруктуруОписанияЗначения(Значение) Экспорт
	
	Результат = Новый Структура("value, type");
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Результат.value = "null";
		Результат.type	= "string";
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Результат.value = Формат(Значение, "ЧН=; ЧГ=");
		Результат.type	= "number";
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Результат.value = Значение;
		Результат.type	= "string";
	ИначеЕсли ТипЗнч(Значение) = Тип("УникальныйИдентификатор") Тогда
		Результат.value = Строка(Значение);
		Результат.type	= "uuid";
	ИначеЕсли ТипЗнч(Значение) = Тип("ДвоичныеДанные") Тогда
		Результат.value = Base64Строка(Значение);
		Результат.type	= "base64";
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Результат.value = Формат(Значение, "БЛ=false; БИ=true");
		Результат.type	= "string";
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		Результат.value = Формат(Значение, "ДЛФ=DT; ДП=");
		Результат.type	= "string";
	Иначе
		Попытка
			Результат.value = Метрика_ПреобразоватьВJSON(Значение);
			Результат.type	= "string";
		Исключение
			Результат.value = "convert_error";
			Результат.type	= "string";
		КонецПопытки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Метрика_НовыйМетрика(ClientInstanceID, 
								МоментВремени, 
								Событие, 
								TraceID				= Неопределено,
								Сессия				= Неопределено, 
								КонтекстПриложения 	= Неопределено, 
								Переменные 			= Неопределено) Экспорт
	
	Перем Variables;
	
	Метрика = Новый Соответствие;
	Метрика.Вставить("Id"			   	 , Метрика_НовыйУИД());
	Метрика.Вставить("ClientInstanceID"	 , ClientInstanceID);
	Метрика.Вставить("Time"			   	 , МоментВремени);	
	Метрика.Вставить("Path"			   	 , Событие);
	Метрика.Вставить("TraceID"			 , Строка(TraceID));
	Метрика.Вставить("Session"		   	 , Сессия);
	Метрика.Вставить("AppContext"		 , КонтекстПриложения);	
		
	// Преобразовать Variables
	
	Метрика.Вставить("Variables", Переменные);
	
	// Капризная
	
	Если Сессия = Неопределено Тогда
		Метрика.Удалить("Session");			
	КонецЕсли;
	
	Если КонтекстПриложения = Неопределено Тогда
		Метрика.Удалить("AppContext");			
	КонецЕсли;
	
	Если Переменные = Неопределено Тогда
		Метрика.Удалить("Variables");			
	КонецЕсли;
	
	Если TraceID = Неопределено Тогда
		Метрика.Удалить("TraceID");			
	КонецЕсли;	
	
	Возврат Метрика;
	
КонецФункции

Функция Метрика_НовыйСобытие(Знач Category = Неопределено, 
								Знач Action = Неопределено, 
								Знач Label = Неопределено, 
								Знач View = Неопределено) Экспорт
		
	Событие = Новый Соответствие;
	Событие.Вставить("Category"	, Category);
	Событие.Вставить("Action"	, Action);
	
	Если ЗначениеЗаполнено(View) Тогда
		Событие.Вставить("View"	, View);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Label) Тогда
		Событие.Вставить("Label", Label);
	КонецЕсли;
	
	Возврат Событие;
	
КонецФункции

Функция Метрика_НовыйМоментВремени(Знач ClientTime = Неопределено, Знач SendFromClientTime = Неопределено) Экспорт
	
	ТекущаяДатаСеанса = ТекущаяДатаСеанса();
		
	Если ClientTime = Неопределено Тогда
		ClientTime = ТекущаяДатаСеанса;
	КонецЕсли;
	
	Если SendFromClientTime = Неопределено Тогда
		SendFromClientTime = ТекущаяДатаСеанса;	
	КонецЕсли;	
	
	МоментВремени = Новый Соответствие;
	МоментВремени.Вставить("ClientTime"		   , ДатаВФормате_ISO8601(УниверсальноеВремя(ClientTime)));
	МоментВремени.Вставить("SendFromClientTime", ДатаВФормате_ISO8601(УниверсальноеВремя(SendFromClientTime)));
	
	Возврат МоментВремени;
	
КонецФункции

Функция Метрика_НовыйМоментВремениВозникновения() Экспорт
	
	МоментВремени = Новый Соответствие;
	МоментВремени.Вставить("ClientTime", ТекущаяДатаСеанса());
	
	Возврат МоментВремени;
	
КонецФункции

Функция Метрика_ПолучитьНастройку(ИмяНастройки)
	
	ЗначениеНастройки = Неопределено;
	
	Если КонтурEDI_ВерсияПлатформы()<>"81" Тогда
		Попытка
			Выполнить("ЗначениеНастройки = ХранилищеОбщихНастроек.Загрузить(Метрика_ИмяНастроекМетрик(),ИмяНастройки);");
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Возврат ЗначениеНастройки;

КонецФункции

Процедура Метрика_УстановитьНастройку(ИмяНастройки,Значение)
	
	Если КонтурEDI_ВерсияПлатформы()<>"81" Тогда
		Попытка
			Выполнить("ХранилищеОбщихНастроек.Сохранить(Метрика_ИмяНастроекМетрик(),ИмяНастройки,Значение);");
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Функция Метрика_ПолучитьИдентификаторТекущегоСобытия()
	
	ТекИД = Неопределено;
	
	ИмяФайла = ПолучитьИмяВременногоФайла();
	
	Результат = ПолучитьФайл_EDI("/1c/KonturEDI_82/templates/metrika_settings.txt");
	
	Если Результат = Неопределено Тогда 
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Результат.Записать(ИмяФайла);
	
	ТекстДок = Новый ТекстовыйДокумент();
	ТекстДок.Прочитать(ИмяФайла);
	ТекИД = ТекстДок.ПолучитьТекст();
	УдалитьФайлы(ИмяФайла);	
		
	Возврат ТекИД;
	
КонецФункции

Функция Метрика_ПолучитьТекущееРасширение()
	
	ИмяФайла = КаталогВременныхФайлов()+Метрика_ИмяНастроекМетрик()+".epf";
	
	Результат = ПолучитьФайл_EDI("/1c/KonturEDI_82/templates/metrika.zip");
	
	Если Результат = Неопределено Тогда 
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Результат.Записать(ИмяФайла);

	Возврат ИмяФайла;
	
КонецФункции

Функция Метрика_ИмяНастроекМетрик()
	
	Возврат "КонтурМетрика_ПодключаемыйМодуль";
	
КонецФункции

Функция Метрика_ПолучитьКастомныеПараметры()
	
	СтруктураПараметров = Новый Структура("Успешно, ИД, Параметры",Ложь,"","");
	
	Если КонтурEDI_ВерсияПлатформы() = "81" Тогда
		Возврат СтруктураПараметров;
	КонецЕсли;
	
	ДатаПоследнегоСобытия = Метрика_ПолучитьНастройку("ДатаПоследнегоСобытия");
	Если НЕ ДатаПоследнегоСобытия = Неопределено Тогда
		Если (ДатаПоследнегоСобытия + 3600)>ТекущаяДата() Тогда
			Возврат СтруктураПараметров;
		КонецЕсли;
	КонецЕсли;
	
	Метрика_УстановитьНастройку("ДатаПоследнегоСобытия",ТекущаяДата());
	
	ИДПоследнегоСобытия	= Метрика_ПолучитьНастройку("ИДПоследнегоСобытия");
	ИДТекущегоСобытия	= Метрика_ПолучитьИдентификаторТекущегоСобытия();

	Если НЕ ЗначениеЗаполнено(ИДТекущегоСобытия) Тогда
		Возврат СтруктураПараметров;
	КонецЕсли;
	
	СтруктураПараметров.ИД = ИДТекущегоСобытия;
	
	Если ИДПоследнегоСобытия = ИДТекущегоСобытия Тогда
		Возврат СтруктураПараметров;
	КонецЕсли;
	
	Расширение				= Метрика_ПолучитьТекущееРасширение();
	РезультатИнициализации	= ИнициализироватьИнтерфейсРасширения(Расширение,Неопределено,Истина);
	
	Если НЕ РезультатИнициализации.Успешно Тогда
		СтруктураПараметров.Параметры = РезультатИнициализации.ОписаниеОшибки;
		Возврат СтруктураПараметров;
	КонецЕсли;
	
	ПараметрыМетрики = Неопределено;
	ТекстОшибки = "";
	Попытка
		ПараметрыМетрики = РезультатИнициализации.Интерфейс.ПолучитьМетрику();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
		
	Если ТипЗнч(ПараметрыМетрики) = Тип("Структура") Тогда
		Если ПараметрыМетрики.Свойство("Успешно") И ПараметрыМетрики.Свойство("Данные") Тогда
			СтруктураПараметров.Успешно = ПараметрыМетрики.Успешно;
			СтруктураПараметров.Параметры = ПараметрыМетрики.Данные;
		Иначе
			СтруктураПараметров.Параметры = "101 "+ТекстОшибки;
		КонецЕсли;
	Иначе
		СтруктураПараметров.Параметры = "100 "+ТекстОшибки;
	КонецЕсли;
	
	Метрика_УстановитьНастройку("ИДПоследнегоСобытия",ИДТекущегоСобытия);
	
	Возврат СтруктураПараметров;
	
КонецФункции

//Сессия
Функция Метрика_НовыйСессия(CustomSessionId, 
							СессияКонтурЭкстерн = Неопределено, 
							СессияНорматив = Неопределено, 
							СессияПортал = Неопределено, 
							СессияПаспорт = Неопределено, 
							СессияEDI = Неопределено) Экспорт
	
	Сессия = Новый Соответствие;	
	Сессия.Вставить("CustomSessionId",				CustomSessionId);	
	
	Если ЗначениеЗаполнено(СессияКонтурЭкстерн) Тогда
		Сессия.Вставить("KeSession",				СессияКонтурЭкстерн);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СессияНорматив) Тогда
		Сессия.Вставить("NormativeSession",			СессияНорматив);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СессияПортал) Тогда
		Сессия.Вставить("PortalSession",			СессияПортал);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СессияПаспорт) Тогда
		Сессия.Вставить("KonturPassportSession",	СессияПаспорт);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СессияEDI) Тогда
		Сессия.Вставить("EDISession",				СессияEDI);
	КонецЕсли;
	
	Возврат Сессия;
	
КонецФункции

Функция Метрика_НовыйСессияКонтурЭкстерн(AbonId = Неопределено, OrgId = Неопределено, UserId = Неопределено) Экспорт
	
