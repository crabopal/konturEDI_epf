Функция ОперацииОбмена_ПринятьВходящиеСообщенияАвтоматически(Параметры, АдресРезультатаФонового = Неопределено) Экспорт

	Если Параметры.ВОтдельномФоновомЗадании Тогда
		
		Идентификатор = "ПринятьВходящиеСообщенияАвтоматически";
		
		// ... инициализировать
		Метрика_ИдЗамера = ФоновыеЗаданияКонтурEDI_ИнициализироватьМодульКонтурEDI(Идентификатор);
		ДлительнаяОперация_Начать();
		
	КонецЕсли;
	
	КоличествоПотоковНаТипСообщения = ОперацииОбмена_КоличествоПотоковДляОперацииАвтоматическиПриниматьСообщения();
	СообщенияПринятьАвтоматически = ОперацииОбмена_СообщенияПринятьАвтоматически(КоличествоПотоковНаТипСообщения);
	
	Для Каждого КлючЗначения Из СообщенияПринятьАвтоматически Цикл
		
		ТипСообщения = КлючЗначения.Ключ;
		Потоки = КлючЗначения.Значение;
		
		ЕстьАктивноеЗаданиеПоТипуСообщения = Ложь;
		Для Каждого ПотокиПоСообщению Из Потоки Цикл 
			
			НомерПотока = ПотокиПоСообщению.Ключ;
			ИдентификаторЗадания = КонтурСтандарт_СтрШаблон_("ОперацииОбмена_ПринятьВходящиеСообщенияАвтоматическиПоТипуСообщения_%1_%2", ТипСообщения, НомерПотока);
			
			Если ФоновыеЗаданияКонтурEDI_ЕстьАктивноеЗадание(ИдентификаторЗадания) Тогда
				ЕстьАктивноеЗаданиеПоТипуСообщения = Истина;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЕстьАктивноеЗаданиеПоТипуСообщения Тогда
			ТекстПредупреждения = КонтурСтандарт_СтрШаблон_("Есть активное задание: %1", ИдентификаторЗадания);
			ЗаписьЖурналаРегистрации_КонтурEDI(УровеньЖурналаРегистрации.Предупреждение, ТекстПредупреждения);
			Прервать;
		КонецЕсли;
		
		Для Каждого ПотокиПоСообщению Из Потоки Цикл 
			
			НомерПотока = ПотокиПоСообщению.Ключ;
			СообщенияПоТипуСообщения = ПотокиПоСообщению.Значение;
			ИдентификаторЗадания = КонтурСтандарт_СтрШаблон_("ОперацииОбмена_ПринятьВходящиеСообщенияАвтоматическиПоТипуСообщения_%1_%2", ТипСообщения, НомерПотока);
			
			ПараметрыВыполненияПоТипуСообщения = Новый Структура("ВОтдельномФоновомЗадании,ИдентификаторЗадания,ТипСообщения,Сообщения");
			ПараметрыВыполненияПоТипуСообщения.ВОтдельномФоновомЗадании = Параметры.ВОтдельномФоновомЗадании;
			ПараметрыВыполненияПоТипуСообщения.ИдентификаторЗадания = ИдентификаторЗадания;
			ПараметрыВыполненияПоТипуСообщения.ТипСообщения = ТипСообщения;
			ПараметрыВыполненияПоТипуСообщения.Сообщения = СообщенияПоТипуСообщения;
			
			ОперацииОбмена_ЗапуститьОперацию("ОперацииОбмена_ПринятьВходящиеСообщенияАвтоматическиПоТипуСообщения", ПараметрыВыполненияПоТипуСообщения);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если Параметры.ВОтдельномФоновомЗадании Тогда
		
		// ... финализировать
		ФоновыеЗаданияКонтурEDI_ФинализироватьМодульКонтурEDI(Метрика_ИдЗамера, Идентификатор);
		ДлительнаяОперация_Завершить();
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

