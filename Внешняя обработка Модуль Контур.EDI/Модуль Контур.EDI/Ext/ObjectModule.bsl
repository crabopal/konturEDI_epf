КонецФункции


Функция КонтурЛогистика_РезультатИнициализацииВнешнейОбработки()
	
	РезультатИнициализации = Новый Структура("Успешно, ОписаниеОшибки, Интерфейс, ИмяФайла", Ложь, "", Неопределено);
	Возврат РезультатИнициализации;

КонецФункции

Функция КонтурЛогистика_ИдентификаторСправочникаМастераУстановки()
	
	Возврат "МастерУстановкиКонтурЛогистика";
	
КонецФункции

Функция КонтурЛогистика_РезультатЗагрузкиМастераУстановки()
	
	РезультатЗагрузкиМастераУстановкиЛогистики = Новый Структура;
	РезультатЗагрузкиМастераУстановкиЛогистики.Вставить("МастерУстановкиКонтурЛогистикаСсылка");
	РезультатЗагрузкиМастераУстановкиЛогистики.Вставить("НомерСтрокиРеквизитаИнтерфейс");
	РезультатЗагрузкиМастераУстановкиЛогистики.Вставить("ДатаОбновления", Дата(1, 1, 1));
	РезультатЗагрузкиМастераУстановкиЛогистики.Вставить("ЗначениеХранилищеЗначения");
	
	КонтурЛогистика_ЗаполнитьРезультатЗагрузкиМастераУстановки(РезультатЗагрузкиМастераУстановкиЛогистики);
	
	Если РезультатЗагрузкиМастераУстановкиЛогистики.МастерУстановкиКонтурЛогистикаСсылка = Неопределено
		ИЛИ РезультатЗагрузкиМастераУстановкиЛогистики.ЗначениеХранилищеЗначения.Получить() = Неопределено
		ИЛИ НачалоДня(РезультатЗагрузкиМастераУстановкиЛогистики.ДатаОбновления) < НачалоДня(ТекущаяДата()) Тогда
		
		КонтурЛогистика_ЗагрузитьМастерУстановки(РезультатЗагрузкиМастераУстановкиЛогистики.МастерУстановкиКонтурЛогистикаСсылка);
		
		КонтурЛогистика_ЗаполнитьРезультатЗагрузкиМастераУстановки(РезультатЗагрузкиМастераУстановкиЛогистики);
				
	КонецЕсли;
	
	Возврат РезультатЗагрузкиМастераУстановкиЛогистики;

КонецФункции

Процедура КонтурЛогистика_ЗаполнитьРезультатЗагрузкиМастераУстановки(РезультатЗагрузкиМастераУстановкиЛогистики)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтурEDI_ДополнительныеСправочники.Ссылка КАК МастерУстановкиКонтурЛогистикаСсылка
	|ПОМЕСТИТЬ МастерУстановкиКонтурЛогистика
	|ИЗ
	|	Справочник.КонтурEDI_ДополнительныеСправочники КАК КонтурEDI_ДополнительныеСправочники
	|ГДЕ
	|	НЕ КонтурEDI_ДополнительныеСправочники.ПометкаУдаления
	|	И КонтурEDI_ДополнительныеСправочники.ИмяСправочника = ""МастерУстановкиКонтурЛогистика""
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ДополнительныеРеквизиты_Интерфейс.НомерСтроки, НЕОПРЕДЕЛЕНО) КАК НомерСтрокиРеквизитаИнтерфейс,
	|	ДополнительныеРеквизиты_Интерфейс.ЗначениеХранилищеЗначения КАК ЗначениеХранилищеЗначения,
	|	ЕСТЬNULL(ДополнительныеРеквизиты_ДатаОбновления.Значение, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОбновления,
	|	МастерУстановкиКонтурЛогистика.МастерУстановкиКонтурЛогистикаСсылка КАК МастерУстановкиКонтурЛогистикаСсылка
	|ИЗ
	|	МастерУстановкиКонтурЛогистика КАК МастерУстановкиКонтурЛогистика
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК ДополнительныеРеквизиты_Интерфейс
	|		ПО (ДополнительныеРеквизиты_Интерфейс.ИмяРеквизита = ""Интерфейс"")
	|			И (МастерУстановкиКонтурЛогистика.МастерУстановкиКонтурЛогистикаСсылка.Ссылка = ДополнительныеРеквизиты_Интерфейс.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_ДополнительныеСправочники.ДополнительныеРеквизиты КАК ДополнительныеРеквизиты_ДатаОбновления
	|		ПО (ДополнительныеРеквизиты_ДатаОбновления.ИмяРеквизита = ""ДатаОбновления"")
	|			И (МастерУстановкиКонтурЛогистика.МастерУстановкиКонтурЛогистикаСсылка.Ссылка = ДополнительныеРеквизиты_ДатаОбновления.Ссылка)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(РезультатЗагрузкиМастераУстановкиЛогистики, ВыборкаДетальныеЗаписи);
	КонецЦикла;

КонецПроцедуры

Процедура КонтурЛогистика_ЗагрузитьМастерУстановки(МастерУстановкиКонтурЛогистикаСсылка)
	
	КонтекстМастераУстановкиВСервисеОбновлений = КонтурЛогистика_КонтекстМастераУстановкиВСервисеОбновлений();
	
	Попытка
		
		Ответ =
		КлиентСервисОбновлений_СкачатьКонтентВерсии(
		КонтекстМастераУстановкиВСервисеОбновлений.НоваяВерсия, 
		КонтекстМастераУстановкиВСервисеОбновлений.ИмяКонтента, 
		КонтекстМастераУстановкиВСервисеОбновлений.ИмяПродукта);
		
		ИмяФайла = Ответ.ИмяФайла;
		ДвоичныеДанные = Ответ.ДвоичныеДанные;
		
		Если МастерУстановкиКонтурЛогистикаСсылка <> Неопределено Тогда
			МастерУстановкиКонтурЛогистикаОбъект = МастерУстановкиКонтурЛогистикаСсылка.ПолучитьОбъект();
		Иначе
			МастерУстановкиКонтурЛогистикаОбъект = Справочники.КонтурEDI_ДополнительныеСправочники.СоздатьЭлемент();
		КонецЕсли;
		
		МастерУстановкиКонтурЛогистикаОбъект.Наименование = КонтурЛогистика_ИдентификаторСправочникаМастераУстановки();
		МастерУстановкиКонтурЛогистикаОбъект.ИмяСправочника = КонтурЛогистика_ИдентификаторСправочникаМастераУстановки();
		
		// Интерфейс
		СтрокаРеквизитаИнтерфейс = МастерУстановкиКонтурЛогистикаОбъект.ДополнительныеРеквизиты.Найти("Интерфейс", "ИмяРеквизита");
		Если СтрокаРеквизитаИнтерфейс = Неопределено Тогда
			СтрокаРеквизитаИнтерфейс = МастерУстановкиКонтурЛогистикаОбъект.ДополнительныеРеквизиты.Добавить();
			СтрокаРеквизитаИнтерфейс.ИмяРеквизита = "Интерфейс";
		КонецЕсли;
		
		СтрокаРеквизитаИнтерфейс.Значение = Истина;
		СтрокаРеквизитаИнтерфейс.ЗначениеХранилищеЗначения = Новый ХранилищеЗначения(ДвоичныеДанные);
		
		// ДатаОбновления
		СтрокаРеквизитаДатаОбновления = МастерУстановкиКонтурЛогистикаОбъект.ДополнительныеРеквизиты.Найти("ДатаОбновления", "ИмяРеквизита");
		Если СтрокаРеквизитаДатаОбновления = Неопределено Тогда
			СтрокаРеквизитаДатаОбновления = МастерУстановкиКонтурЛогистикаОбъект.ДополнительныеРеквизиты.Добавить();
			СтрокаРеквизитаДатаОбновления.ИмяРеквизита = "ДатаОбновления";
		КонецЕсли;
		
		СтрокаРеквизитаДатаОбновления.Значение = ТекущаяДата();
		
		// Версия
		СтрокаРеквизитаВерсия = МастерУстановкиКонтурЛогистикаОбъект.ДополнительныеРеквизиты.Найти("Версия", "ИмяРеквизита");
		Если СтрокаРеквизитаВерсия = Неопределено Тогда
			СтрокаРеквизитаВерсия = МастерУстановкиКонтурЛогистикаОбъект.ДополнительныеРеквизиты.Добавить();
			СтрокаРеквизитаВерсия.ИмяРеквизита = "Версия";
		КонецЕсли;
		
		СтрокаРеквизитаВерсия.Значение = КонтекстМастераУстановкиВСервисеОбновлений.НоваяВерсия;
		
		МастерУстановкиКонтурЛогистикаОбъект.Записать();
		
	Исключение
		
		_ОписаниеОшибки = 
		КонтурСтандарт_СтрШаблон_("Не удалось загрузить файл контента из сервиса обновлений: %1 (ver. %2)", 
		КонтекстМастераУстановкиВСервисеОбновлений.ИмяПродукта, КонтекстМастераУстановкиВСервисеОбновлений.НоваяВерсия);
		
		_ИнформацияОбОшибке = ИнформацияОбОшибке();
		
		Метрика_Переменные = Новый Структура;
		Метрика_Переменные.Вставить("Версия", КонтекстМастераУстановкиВСервисеОбновлений.НоваяВерсия);
		Метрика_ОтправитьСразу = Ложь;
		Метрика_Ошибка("СкачатьКонтентВерсии_МастерУстановкиЛогистики", _ОписаниеОшибки, _ИнформацияОбОшибке, Метрика_Переменные, Метрика_ОтправитьСразу);
		
	КонецПопытки;

КонецПроцедуры

Функция КонтурЛогистика_КонтекстМастераУстановкиВСервисеОбновлений()
	
	КонтекстМастераУстановкиВСервисеОбновлений = Новый Структура;
	КонтекстМастераУстановкиВСервисеОбновлений.Вставить("ИмяПродукта", "logist_installer");
	КонтекстМастераУстановкиВСервисеОбновлений.Вставить("ИмяКонтента", "data-processor");
	
	МенеджерНастроек = КонтурЛогистика_МенеджерНастройкиМастераУстановкиЛогистики(КонтекстМастераУстановкиВСервисеОбновлений);
	
	ИнформацияОбновления = КлиентСервисОбновлений_ПроверитьОбновление(МенеджерНастроек);
	
	Если ЗначениеЗаполнено(ИнформацияОбновления.name) Тогда
		КонтекстМастераУстановкиВСервисеОбновлений.Вставить("НоваяВерсия", ИнформацияОбновления.name);
	Иначе
		КонтекстМастераУстановкиВСервисеОбновлений.Вставить("НоваяВерсия", МенеджерНастроек.ВерсияПродукта);
	КонецЕсли;
			
	Возврат КонтекстМастераУстановкиВСервисеОбновлений;	
	
КонецФункции

Функция КонтурЛогистика_МенеджерНастройкиМастераУстановкиЛогистики(КонтекстМастераУстановкиВСервисеОбновлений)
	
	МенеджерНастроек = КлиентСервисОбновлений_НовыйМенеджерНастроек();
	
	МенеджерНастроек.ИмяПродукта = КонтекстМастераУстановкиВСервисеОбновлений.ИмяПродукта; 
	МенеджерНастроек.ИдентификаторИБ = ПараметрыКлиентСервер.ИдентификаторБазы; 
	МенеджерНастроек.ВерсияПродукта = "1.0.0"; 
	МенеджерНастроек.ТестовоеОкружение = ЭтоТестовыйAPI();
	МенеджерНастроек.Сессия.Прокси = ПолучитьИнтернетПрокси();
	
	Возврат МенеджерНастроек;

КонецФункции

