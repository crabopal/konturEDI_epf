Функция КлиентСервисОбновленийПереопределяемый_МенеджерНастроек(МенеджерНастроек = Неопределено) Экспорт 

	Возврат МенеджерНастроекСервисаОбновленийМодуля();			

КонецФункции

Процедура КлиентСервисОбновленийПереопределяемый_УстановитьЗаголовокАвторизации(МенеджерНастроек)
	
	ИмяЗаголовкаАвторизации = "X-Customer-Secret-Key";   
	
	Если ЗначениеЗаполнено(МенеджерНастроек.Сессия.Заголовки[ИмяЗаголовкаАвторизации]) Тогда
		Возврат;	
	КонецЕсли; 
	
	КлючДоступаКлиента = КлючДоступаКлиентаСервисОбновлений(МенеджерНастроек.ИмяПродукта);
	
	Если ЗначениеЗаполнено(КлючДоступаКлиента) Тогда
		МенеджерНастроек.Сессия.Заголовки[ИмяЗаголовкаАвторизации] = КлючДоступаКлиента;
		Возврат;
	КонецЕсли;
	
	Попытка
		
		ОсновнойGLN = ПолучитьКонстантуEDI("GLN_Основной");
		УчетнаяЗапись = НайтиУчетнуюЗаписьПоGLN_КонтурEDI(ОсновнойGLN);
		
		Если ЗначениеЗаполнено(УчетнаяЗапись) Тогда 
			Результат = DD_API_Authenticate(,УчетнаяЗапись.Логин, УчетнаяЗапись.Пароль);
			Токен = Результат.ТелоОтвета;
			ЗаголовокАвторизацииДиадока = КонтурСтандарт_СтрШаблон_("DiadocAuth ddauth_api_client_id=%1,ddauth_token=%2", API_КлючРазработчика_Диадок(), Токен);
			МенеджерНастроек.Сессия.Заголовки.Вставить("Authorization", ЗаголовокАвторизацииДиадока);	
		КонецЕсли;                                               
		КлючДоступаКлиента = "";
		Результат = КлиентСервисОбновлений_ЗарегистрироватьБазу(МенеджерНастроек);
		Если Результат.Свойство("token", КлючДоступаКлиента) И Не ЗначениеЗаполнено(КлючДоступаКлиента) Тогда
			Результат = КлиентСервисОбновлений_СоздатьКлючБазы("Автоматическая генерация ключа доступа клиента.");
			КлючДоступаКлиента = Результат.token;
		КонецЕсли;  
		
		ЗаписатьКлючДоступаКлиентаСервисОбновлений(МенеджерНастроек.ИмяПродукта, КлючДоступаКлиента);
		МенеджерНастроек.Сессия.Заголовки[ИмяЗаголовкаАвторизации] = КлючДоступаКлиента;
		
	Исключение   
		ОписаниеОшибки = ОписаниеОшибки();	
	КонецПопытки;
	
КонецПроцедуры

