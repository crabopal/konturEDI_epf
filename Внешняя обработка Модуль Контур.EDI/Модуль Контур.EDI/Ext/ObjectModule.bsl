Процедура ПриИзмененииНоменклатурыВСтрокеДокументаУФ_УТ_КонтурEDI(Знач ДокументОбъект, Знач СтрокаТабЧасти)
	
	Перем СтрокаТабЧастиСтруктура, СтруктураДействий, СтруктураПересчетаСуммы;
	
	СтрокаТабЧастиСтруктура = СтруктураИзСтрокиТабЧасти_КонтурEDI(СтрокаТабЧасти);
	СтрокаТабЧастиСтруктура.Вставить("БезВозвратнойТары");
	ЗаполнитьЗначенияСвойств(СтрокаТабЧастиСтруктура,СтрокаТабЧасти);
	
	СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер_ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ДокументОбъект);
	
	СтруктураДействий = Новый Структура;
	
	ДобавитьЗаполнениеСтавкиНДСВСтруктуруДействийУФ_УТ(СтруктураДействий, ДокументОбъект);
	
	УчитыватьВозвратнуюТару = Ложь;
	
	Если ПеременнаяСодержитСвойство(ДокументОбъект, "ВернутьМногооборотнуюТару") 
		И ДокументОбъект.ВернутьМногооборотнуюТару = Истина Тогда
		
		УчитыватьВозвратнуюТару = Истина;
		
		Если Не СтрокаТабЧастиСтруктура.Свойство("ТипНоменклатуры") Тогда
			СтрокаТабЧастиСтруктура.Вставить("ТипНоменклатуры");
			СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры", Новый Структура("Номенклатура", "ТипНоменклатуры")); 
		КонецЕсли;
		
	КонецЕсли;	
	
	СтруктураДействий.Вставить("ЗаполнитьСтавкуНДСВозвратнойТары",	УчитыватьВозвратнуюТару);
	СтруктураДействий.Вставить("ЗаполнитьПризнакБезВозвратнойТары",	УчитыватьВозвратнуюТару);
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС",							СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС",							СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСумму");
	
	Если ПеременнаяСодержитСвойство(СтрокаТабЧастиСтруктура, "СуммаРучнойСкидки") Тогда
		СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки",			Новый Структура("Очищать", Истина));
	КонецЕсли;	
	Если ПеременнаяСодержитСвойство(СтрокаТабЧастиСтруктура, "СуммаАвтоматическойСкидки") Тогда
		СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки",	Новый Структура("Очищать", Истина));
	КонецЕсли;
	Если ПеременнаяСодержитСвойство(СтрокаТабЧастиСтруктура, "СуммаВзаиморасчетов") Тогда
		СтруктураДействий.Вставить("ОчиститьСуммуВзаиморасчетов");
	КонецЕсли;	
	
	ОбработкаТабличнойЧастиСервер_ОбработатьСтрокуТЧ(СтрокаТабЧастиСтруктура, СтруктураДействий, Неопределено);
	
	ЗаполнитьЗначенияСвойств(СтрокаТабЧасти,СтрокаТабЧастиСтруктура);

КонецПроцедуры

Процедура ПриИзмененииНоменклатурыВСтрокеДокументаУФ_Розница_КонтурEDI(ДокументОбъект, СтрокаТабЧасти)
	                     		
	СтрокаТабЧастиСтруктура = СтруктураИзСтрокиТабЧасти_КонтурEDI(СтрокаТабЧасти);
	СтрокаТабЧастиСтруктура.Вставить("ИспользоватьСерийныеНомера");
	СтрокаТабЧастиСтруктура.Вставить("ТипНоменклатуры");
	ЗаполнитьЗначенияСвойств(СтрокаТабЧастиСтруктура,СтрокаТабЧасти); 
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ЗаполнитьТипНоменклатуры"); 
	Попытка
		СтруктураДействий.Вставить("ПроверитьСерийныеНомераПоВладельцу",			Вычислить("ОбработкаТабличнойЧастиТоварыКлиентСервер.ПолучитьСтруктуруПроверкиСерийныхНомеровПоВладельцу(СтрокаТабЧастиСтруктура, ДокументОбъект.СерийныеНомера)"));
	Исключение
		СтруктураДействий.Вставить("ПроверитьСерийныеНомераПоВладельцу",			Вычислить("ОбработкаТабличнойЧастиТоварыКлиентСервер.СтруктураПроверкиСерийныхНомеровПоВладельцу(СтрокаТабЧастиСтруктура, ДокументОбъект.СерийныеНомера)"));
	КонецПопытки;

	СтруктураДействий.Вставить("ПроверитьХарактеристикуПоВладельцу"   ,			СтрокаТабЧастиСтруктура.Характеристика);
	СтруктураДействий.Вставить("ПроверитьЗаполнитьУпаковкуПоВладельцу",			СтрокаТабЧастиСтруктура.Упаковка);
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
	СтруктураДействий.Вставить("ЗаполнитьЦенуПродажи" ,							Вычислить("ОбработкаТабличнойЧастиТоварыКлиентСервер.ПолучитьСтруктуруЗаполненияЦеныПродажиВСтрокеТЧ(ДокументОбъект, Истина)"));
	
	СтруктураПараметровСтавкиНДС = Новый Структура;
	СтруктураПараметровСтавкиНДС.Вставить("Дата"       ,						ДокументОбъект.Дата);
	СтруктураПараметровСтавкиНДС.Вставить("Организация",						ДокументОбъект.Организация);
	СтруктураПараметровСтавкиНДС.Вставить("Склад"      ,						ДокументОбъект.Склад);
	
	СтруктураДействий.Вставить("ЗаполнитьСтавкуНДССкладВШапке",					СтруктураПараметровСтавкиНДС);
	СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС",							ДокументОбъект.УчитыватьНДС);
	
	СтруктураПересчетаСуммы = Неопределено;
	
	Попытка
		СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер_ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ДокументОбъект);
	Исключение
		Выполнить("СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиТоварыКлиентСервер.СтруктураПересчетаСуммыНДСВСтрокеТЧ(ДокументОбъект)");	
	КонецПопытки;
	
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС",							СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСумму");
	СтруктураДействий.Вставить("ПроставитьПродавца",							ДокументОбъект.Продавец);
	СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки",			Новый Структура("Очищать", Истина));
	СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки",	Новый Структура("Очищать", Истина));
	
	СтруктураТЧ = Новый Структура;
	СтруктураТЧ.Вставить("СтрокиТЧ" , ДокументОбъект.Товары);
	
	КэшированныеЗначения = Неопределено;    
	Попытка
		Выполнить("КэшированныеЗначения = ОбработкаТабличнойЧастиТоварыКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();");
	Исключение
		Выполнить("КэшированныеЗначения = ОбработкаТабличнойЧастиТоварыКлиентСервер.СтруктураКэшируемыхЗначений();");
	КонецПопытки; 
	
	Попытка	
		Выполнить("ОбработкаТабличнойЧастиТоварыСервер.ОбработатьСтрокуТЧСервер(СтрокаТабЧастиСтруктура, СтруктураДействий, КэшированныеЗначения);"); 
	Исключение
		СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", Новый Структура("УчитыватьНДС, Дата", ДокументОбъект.УчитыватьНДС, ТекущаяДатаСеанса()));
		Выполнить("ОбработкаТабличнойЧастиТоварыСервер.ОбработатьСтрокуТЧСервер(СтрокаТабЧастиСтруктура, СтруктураДействий, КэшированныеЗначения);");
	КонецПопытки;
	
	ЗаполнитьЗначенияСвойств(СтрокаТабЧасти,СтрокаТабЧастиСтруктура);

КонецПроцедуры 

Функция ОбщийМодульОбработкаТабличнойЧасти_УФ_УТ(ИмяОбщегоМодуля)
	
	КлючКэша = "ОбщийМодульУФУТ_" + ИмяОбщегоМодуля;
	ОбщийМодульОбработкаТабличнойЧасти = ЭДО_Кэш_Прочитать(КлючКэша);
	
	Если Не ОбщийМодульОбработкаТабличнойЧасти = Неопределено Тогда
		Возврат ОбщийМодульОбработкаТабличнойЧасти;
	КонецЕсли;
	
	ВерсияКонфигурации1С = ВерсияКонфигурации1С_КонтурEDI();
	
	МладшаяВерсияКонфигурацииСПакетнойОбработкой = 5;
	ВерсияРелизаКонфигурацииСПакетнойОбработкой = 21;
	МодульОбработкаТабличнойЧасти = ИмяОбщегоМодуля;
	МодульПакетнаяОбработкаТабличнойЧасти = "Пакетная" + ИмяОбщегоМодуля;
	
	ПорядокПроверкиНаличияОбщихМодулей = Новый Массив;
	
	Если ВерсияКонфигурации1С.Младшая = МладшаяВерсияКонфигурацииСПакетнойОбработкой 
		И ВерсияКонфигурации1С.Релиз < ВерсияРелизаКонфигурацииСПакетнойОбработкой Тогда
		ПорядокПроверкиНаличияОбщихМодулей.Добавить(МодульОбработкаТабличнойЧасти);
		ПорядокПроверкиНаличияОбщихМодулей.Добавить(МодульПакетнаяОбработкаТабличнойЧасти);
	Иначе
		ПорядокПроверкиНаличияОбщихМодулей.Добавить(МодульПакетнаяОбработкаТабличнойЧасти);
		ПорядокПроверкиНаличияОбщихМодулей.Добавить(МодульОбработкаТабличнойЧасти);
	КонецЕсли;
	
	ОбщийМодульОбработкаТабличнойЧасти = ОбщийМодуль1С_КонтурEDI(ПорядокПроверкиНаличияОбщихМодулей[0]);
	Если ОбщийМодульОбработкаТабличнойЧасти = Неопределено Тогда
		ОбщийМодульОбработкаТабличнойЧасти = ОбщийМодуль1С_КонтурEDI(ПорядокПроверкиНаличияОбщихМодулей[1]);
	КонецЕсли;
	
	ЭДО_Кэш_Поместить(КлючКэша, ОбщийМодульОбработкаТабличнойЧасти);
	
	Возврат ОбщийМодульОбработкаТабличнойЧасти;
	
КонецФункции

Процедура ОбработкаТабличнойЧастиСервер_ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения) 
	
	ОбщийМодуль_ОбработкаТабличнойЧастиСервер = ОбщийМодульОбработкаТабличнойЧасти_УФ_УТ("ОбработкаТабличнойЧастиСервер");
	
	Если Не ОбщийМодуль_ОбработкаТабличнойЧастиСервер = Неопределено Тогда
		ОбщийМодуль_ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	КонецЕсли;
	
КонецПроцедуры 

Процедура ОбработкаТабличнойЧастиСервер_ОбработатьТЧ(ТЧ, СтруктураДействий, КэшированныеЗначения) 
	
	ОбщийМодуль_ОбработкаТабличнойЧастиСервер = ОбщийМодульОбработкаТабличнойЧасти_УФ_УТ("ОбработкаТабличнойЧастиСервер");
	
	Если Не ОбщийМодуль_ОбработкаТабличнойЧастиСервер = Неопределено Тогда
		ОбщийМодуль_ОбработкаТабличнойЧастиСервер.ОбработатьТЧ(ТЧ, СтруктураДействий, КэшированныеЗначения);
	КонецЕсли;
	
КонецПроцедуры 

Функция ОбработкаТабличнойЧастиКлиентСервер_ПолучитьСтруктуруКэшируемыеЗначения()
	
	КэшируемыеЗначения = Неопределено;
	
	ОбщийМодуль_ОбработкаТабличнойЧастиКлиентСервер = ОбщийМодульОбработкаТабличнойЧасти_УФ_УТ("ОбработкаТабличнойЧастиКлиентСервер");
	
	Если Не ОбщийМодуль_ОбработкаТабличнойЧастиКлиентСервер	= Неопределено Тогда
		КэшируемыеЗначения = ОбщийМодуль_ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	КонецЕсли;
	
	Возврат КэшируемыеЗначения;
	
КонецФункции

Функция ОбработкаТабличнойЧастиКлиентСервер_ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект)
	
	ПараметрыПересчета = Неопределено;
	
	ОбщийМодуль_ОбработкаТабличнойЧастиКлиентСервер = ОбщийМодульОбработкаТабличнойЧасти_УФ_УТ("ОбработкаТабличнойЧастиКлиентСервер");
	
	Если Не ОбщийМодуль_ОбработкаТабличнойЧастиКлиентСервер = Неопределено Тогда 
	
		Попытка
			ПараметрыПересчета = ОбщийМодуль_ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);
		Исключение                         
			ПараметрыПересчета = ОбщийМодуль_ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруПересчетаСуммыНДСВСтрокеТЧ(Объект);	
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат ПараметрыПересчета;

КонецФункции

Функция ОбработкаТабличнойЧастиКлиентСервер_ПараметрыЗаполненияСтавкиНДС(Объект = Неопределено)
	
	ПараметрыЗаполненияСтавкиНДС = Неопределено;  
	
	ОбщийМодуль_ОбработкаТабличнойЧастиКлиентСервер = ОбщийМодульОбработкаТабличнойЧасти_УФ_УТ("ОбработкаТабличнойЧастиКлиентСервер");
	
	Если Не ОбщийМодуль_ОбработкаТабличнойЧастиКлиентСервер = Неопределено Тогда
		                                         
		ПараметрыЗаполненияСтавкиНДС = ОбщийМодуль_ОбработкаТабличнойЧастиКлиентСервер.ПараметрыЗаполненияСтавкиНДС(Объект);
		
	КонецЕсли;
	
	Возврат ПараметрыЗаполненияСтавкиНДС; 
	
КонецФункции

//типовой механизм пересчета цен/сумм в документе
Процедура ПересчитатьСтрокуДокумента(НайденнаяСтрока,Док) Экспорт
	
	ИмяТабличнойЧасти = Метаданные.НайтиПоТипу(ТипЗнч(НайденнаяСтрока)).Имя;
	
	СтандартнаяОбработкаEDI = Истина;
    ОбработкаСобытияПодключаемогоМодуля("ПересчитатьСтрокуДокумента",
	СтандартнаяОбработкаEDI,
	Новый Структура("СтрокаДокумента,ДокументОбъект,ИмяТабличнойЧасти", НайденнаяСтрока, Док, ИмяТабличнойЧасти));
    
	Если СтандартнаяОбработкаEDI = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяКонфигурации1С = "УТ_10_2" ИЛИ ИмяКонфигурации1С = "RIT" Тогда
		
		Выполнить("РассчитатьКоличествоМестТабЧасти(НайденнаяСтрока, Док);");
		Выполнить("РассчитатьСуммуТабЧасти(НайденнаяСтрока, Док);");
		Если ИмяТабличнойЧасти<>"ВозвратнаяТара" Тогда
			Выполнить("РассчитатьСуммуНДСТабЧасти(НайденнаяСтрока, Док);");
		КонецЕсли;
		
	ИначеЕсли ИмяКонфигурации1С = "ТКПТ" Тогда 
		
		Выполнить("Док.ОбработкаРеквизита(""Товары.Количество"",НайденнаяСтрока);");
		
		//блок УФ
	ИначеЕсли ИмяКонфигурации1С = "УФ_УТ" Тогда
		
		Выполнить("Ценообразование.ПересчитатьСуммыВСтроке(НайденнаяСтрока,ложь,ложь,ложь,Док.ЦенаВключаетНДС)");
		//очистим СуммаВзаиморасчетов по тч (пересчитаем после обхода стандартным образом)
		
		Если ПеременнаяСодержитСвойство(НайденнаяСтрока, "СуммаВзаиморасчетов") Тогда
			НайденнаяСтрока.СуммаВзаиморасчетов = 0;
		КонецЕсли;
			
	ИначеЕсли ИмяКонфигурации1С = "УФ_БП" Тогда
		
		Выполнить("ОбработкаТабличныхЧастейКлиентСервер.РассчитатьСуммуТабЧасти(НайденнаяСтрока, 0)");
		
		Если ПеременнаяСодержитСвойство(НайденнаяСтрока, "СуммаНДС") Тогда
			Выполнить("ОбработкаТабличныхЧастейКлиентСервер.РассчитатьСуммуНДСТабЧасти(НайденнаяСтрока, Док.СуммаВключаетНДС)");
		КонецЕсли;  	
		//итоги пересчитаются в конф-ции при записи
		
	ИначеЕсли ИмяКонфигурации1С = "УФ_УНФ" Тогда
		
		//нет нормальной серверной функции ОМ .хмммм
		
		НайденнаяСтрока.Сумма = НайденнаяСтрока.Цена * НайденнаяСтрока.Количество;						  
		СтавкаНДС = 18;
		Выполнить("СтавкаНДС = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеСтавкиНДС(НайденнаяСтрока.СтавкаНДС)");
		НайденнаяСтрока.СуммаНДС = ?(Док.СуммаВключаетНДС, 
									  НайденнаяСтрока.Сумма - (НайденнаяСтрока.Сумма) / ((СтавкаНДС + 100) / 100),
									  НайденнаяСтрока.Сумма * СтавкаНДС / 100);
									  
		НайденнаяСтрока.Всего = НайденнаяСтрока.Сумма + ?(Док.СуммаВключаетНДС, 0, НайденнаяСтрока.СуммаНДС);						  

	ИначеЕсли ИмяКонфигурации1С = "УФ_ДалионТРЕНД" Тогда
		
		ОбщийМодуль_ОбработкаТабличнойЧастиТоварыКлиентСервер = ОбщийМодуль1С_КонтурEDI("ОбработкаТабличнойЧастиТоварыКлиентСервер");
		ОбщийМодуль_ОбработкаТабличнойЧастиТоварыСервер = ОбщийМодуль1С_КонтурEDI("ОбработкаТабличнойЧастиТоварыСервер");
		
		
		Если НЕ ОбщийМодуль_ОбработкаТабличнойЧастиТоварыКлиентСервер = Неопределено
			И НЕ ОбщийМодуль_ОбработкаТабличнойЧастиТоварыСервер = Неопределено Тогда 
			
			СтруктураПересчетаСуммыНДС 				= ОбщийМодуль_ОбработкаТабличнойЧастиТоварыКлиентСервер.ПолучитьСтруктуруПересчетаСуммыНДСВСтрокеТЧ(Док);	
			
			СтруктураДействий = Новый Структура;
			
			СтруктураДействий.Вставить("ПересчитатьСумму"				, ОбщийМодуль_ОбработкаТабличнойЧастиТоварыКлиентСервер.ПолучитьСтруктуруПересчетаСуммовыхКолонок(Док));
			СтруктураДействий.Вставить("ПересчитатьСуммуНДС"			, СтруктураПересчетаСуммыНДС);
			СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницИзмерения", "");
			
			КэшированныеЗначения = ОбщийМодуль_ОбработкаТабличнойЧастиТоварыКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
			ОбщийМодуль_ОбработкаТабличнойЧастиТоварыСервер.ОбработатьСтрокуТЧСервер(НайденнаяСтрока, СтруктураДействий, КэшированныеЗначения);
			
		КонецЕсли;	

	ИначеЕсли ИмяКонфигурации1С = "ДалионУМ" Тогда
		
		СвойстваТЧТовары = Новый Структура;
		СвойстваТЧТовары.Вставить("ИмяТЧ", "Товары");
		СвойстваТЧТовары.Вставить("ХарактеристикаНоменклатуры");
		СвойстваТЧТовары.Вставить("ЕдиницаИзмерения");
		СвойстваТЧТовары.Вставить("Цена");
		Если ТипЗнч(Док) = Тип("ДокументСсылка.РасходнаяНакладная") или
			 ТипЗнч(Док) = Тип("ДокументОбъект.РасходнаяНакладная") Тогда
			Выполнить("тчПриИзмененииКоличестваТабЧастиРасходнойНакладной(НайденнаяСтрока, Док, СвойстваТЧТовары);");
		Иначе
			Выполнить("тчПриИзмененииКоличестваТабЧасти(НайденнаяСтрока, Док, СвойстваТЧТовары);");
		КонецЕсли;
		Выполнить("тчПриИзмененииСтавкиНДСТабЧасти(НайденнаяСтрока, Док, СвойстваТЧТовары);");
	ИначеЕсли ИмяКонфигурации1С = "УФ_Розница" Тогда
		
		Попытка
			Выполнить("НайденнаяСтрока.СуммаНДС = ОбработкаТабличнойЧастиТоварыСервер.РассчитатьСуммуНДС(НайденнаяСтрока.Сумма, НайденнаяСтрока.СтавкаНДС, Док.ЦенаВключаетНДС)");
		Исключение
			Выполнить("НайденнаяСтрока.СуммаНДС = ОбработкаТабличнойЧастиТоварыКлиентСервер.СуммаНДС(НайденнаяСтрока.Сумма, НайденнаяСтрока.СтавкаНДС, Док.ЦенаВключаетНДС)");
		КонецПопытки;

		Выполнить("ОбработкаТабличнойЧастиТоварыСервер.ОбработатьСтрокуТЧСервер(НайденнаяСтрока, Новый Структура(""ПересчитатьСумму""), Неопределено)");
		
	Иначе//остальные типовые конфигурации
		
		Если ИмяКонфигурации1С <> "БП" Тогда
			Выполнить("ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(НайденнаяСтрока, Док);");
		КонецЕсли;
		
		Выполнить("ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НайденнаяСтрока, Док);");
		
		Если ИмяТабличнойЧасти<>"ВозвратнаяТара" Тогда
			Выполнить("ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НайденнаяСтрока, Док);");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры	

//находит в табличной части Товары документа Док строку, соответствующую СтрокаСоответствий
Функция НайтиСоответствиеСтрокиВДокументе(
	СтрокаСоответствий, 
	Док, 
	ИмяТабЧасти = "", 
	ТаблицыДокумента = Неопределено, 
	СуммаВключаетНДС = Неопределено) Экспорт
	
	НайденнаяСтрока = Неопределено;
	
	Если СуммаВключаетНДС = Неопределено Тогда
		СуммаВключаетНДС = ПолучитьРеквизитДокументаДляСообщения(Док, "СуммаВключаетНДС");
	КонецЕсли;
	
	Если ТаблицыДокумента = Неопределено Тогда		
		ТаблицыДокумента = ТаблицыДокумента_КонтурEDI(Док);   		
	КонецЕсли;
	
	РезультатПоискаСтроки =	
	ПоискСтрокиВДокументе_КонтурEDI(СтрокаСоответствий, ТаблицыДокумента, СуммаВключаетНДС);
	
	НайденнаяСтрока = РезультатПоискаСтроки.НайденнаяСтрока;
	
	Возврат НайденнаяСтрока; 
	
КонецФункции	

Функция ТаблицыДокумента_КонтурEDI(Док, РаботаСУслугами = Истина, РаботаСВозвратнойТарой = Истина) Экспорт
	
	// ... товары
	ТоварыДокумента = ТабЧастьДокумента_Товары_КонтурEDI(Док); 
	
	КопияТоваров = КопияТабЧастиДокумента_КонтурEDI(ТоварыДокумента);
    	
	// ... тара 	
	ТараДокумента = Неопределено;
	
	Если РаботаСВозвратнойТарой Тогда
		
		ТараДокумента = ТабЧастьДокумента_Тара_КонтурEDI(Док); 
		
		Если ТараДокумента = Неопределено Тогда
			
			ДокументРеализации = Неопределено;
			
			ЕстьДокументРеализации = ПеременнаяСодержитСвойство(Док, "ДокументРеализации", ДокументРеализации, Истина);
			
			Если ЕстьДокументРеализации Тогда
				
				ТараДокумента = ТабЧастьДокумента_Тара_КонтурEDI(ДокументРеализации);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	КопияТары = КопияТабЧастиДокумента_КонтурEDI(ТараДокумента);
			
	// ... услуги  	
	УслугиДокумента = Неопределено;   
	
	Если РаботаСУслугами Тогда
		
		УслугиДокумента = ТабЧастьДокумента_Услуги_КонтурEDI(Док);
			
	КонецЕсли;
	
	КопияУслуг = КопияТабЧастиДокумента_КонтурEDI(УслугиДокумента);

	// ... возврат результата
	Результат = Новый Структура;
	
	Результат.Вставить("ТоварыДокумента", ТоварыДокумента);
	Результат.Вставить("КопияТоваров", КопияТоваров);
	
	Результат.Вставить("ТараДокумента", ТараДокумента);
	Результат.Вставить("КопияТары", КопияТары);
	
	Результат.Вставить("УслугиДокумента", УслугиДокумента);
	Результат.Вставить("КопияУслуг", КопияУслуг);    	
	
	Возврат Результат;

КонецФункции

Функция ТабЧастьДокумента_Услуги_КонтурEDI(Док)
	
	УслугиДокумента = Неопределено;
	
	ПеременнаяСодержитСвойство(Док, "Услуги", УслугиДокумента);

	Возврат УслугиДокумента;

КонецФункции  

Функция ТабЧастьДокумента_Тара_КонтурEDI(Док)
	
	ТараДокумента = Неопределено;
	
	ПеременнаяСодержитСвойство(Док, "ВозвратнаяТара", ТараДокумента);
	
	Возврат ТараДокумента;

КонецФункции

Функция КопияТабЧастиДокумента_КонтурEDI(ТабЧасть)
	
	КопияТабЧасти = Неопределено;
	
	Если ТабЧасть <> Неопределено Тогда
		
		КопияТабЧасти = ТабЧасть.Выгрузить();
		
		ТипЧисло = ОписаниеТипаЧисло_КонтурEDI(15, 3);
		
		ДобавитьКолонкиВТаблицуЗначений(КопияТабЧасти, "НеСопоставлено", ТипЧисло);
		
		КопияТабЧасти.ЗагрузитьКолонку(КопияТабЧасти.ВыгрузитьКолонку("Количество") , "НеСопоставлено");
		
	КонецЕсли;
	
	Возврат КопияТабЧасти;

КонецФункции

Функция ТабЧастьДокумента_Товары_КонтурEDI(Документ)
	
	ТоварыДокумента = Неопределено;
	
	ВозможныеНазванияТабличныхЧастей = Новый Массив;
	ВозможныеНазванияТабличныхЧастей.Добавить("Товары");
	ВозможныеНазванияТабличныхЧастей.Добавить("Запасы");
	ВозможныеНазванияТабличныхЧастей.Добавить("Состав");
	
	Для каждого НазваниеТабличнойЧасти Из ВозможныеНазванияТабличныхЧастей Цикл
		
		Если ПеременнаяСодержитСвойство(Документ, НазваниеТабличнойЧасти, ТоварыДокумента) Тогда
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТоварыДокумента;

КонецФункции

Функция ПоискСтрокиВДокументе_КонтурEDI(
	СтрокаСоответствий, 
	ТаблицыДокумента, 
	СуммаВключаетНДС,
	ВернутьКопиюСтроки = Ложь) Экспорт
	
	НашлиВТоварах = Ложь;
	НашлиВУслугах = Ложь;
	НашлиВТаре = Ложь;
	 	
	СтрокаВКопии = ПоискСтрокиВТаблицеДокумента_КонтурEDI(ТаблицыДокумента.КопияТоваров, СтрокаСоответствий, СуммаВключаетНДС);
	
	НашлиВТоварах = (СтрокаВКопии <> Неопределено);
	
	Если СтрокаВКопии = Неопределено
		И ТаблицыДокумента.КопияТары <> Неопределено Тогда
		
		СтрокаВКопии = ПоискСтрокиВТаблицеДокумента_КонтурEDI(ТаблицыДокумента.КопияТары, СтрокаСоответствий, СуммаВключаетНДС);
		
		НашлиВТаре = (СтрокаВКопии <> Неопределено);
		
	КонецЕсли;
	
	Если СтрокаВКопии = Неопределено
		И ТаблицыДокумента.КопияУслуг <> Неопределено Тогда
		
		СтрокаВКопии = ПоискСтрокиВТаблицеДокумента_КонтурEDI(ТаблицыДокумента.КопияУслуг, СтрокаСоответствий, СуммаВключаетНДС);
		
		НашлиВУслугах = (СтрокаВКопии <> Неопределено);
		
	КонецЕсли;
	
	ТабличнаяЧастьСтроки = Неопределено;
	НайденнаяСтрока = Неопределено;
	
	Если СтрокаВКопии <> Неопределено Тогда
				
		Если НашлиВТоварах Тогда
			
			ТабличнаяЧастьСтроки = ТаблицыДокумента.ТоварыДокумента;
			
		ИначеЕсли НашлиВТаре Тогда
			
			ТабличнаяЧастьСтроки = ТаблицыДокумента.ТараДокумента;
			
		ИначеЕсли НашлиВУслугах Тогда
			
			ТабличнаяЧастьСтроки = ТаблицыДокумента.УслугиДокумента;
			
		Иначе
			
			ТабличнаяЧастьСтроки = Неопределено;
			
		КонецЕсли;
		
		Если ВернутьКопиюСтроки Тогда
			
			НайденнаяСтрока = СтрокаВКопии;
			
		Иначе
			
			НайденнаяСтрока = ТабличнаяЧастьСтроки.Найти(СтрокаВКопии.НомерСтроки, "НомерСтроки");
			
		КонецЕсли;
		
	КонецЕсли;
	
	РезультатПоискаСтроки = Новый Структура;
	
	РезультатПоискаСтроки.Вставить("НайденнаяСтрока", НайденнаяСтрока);
	РезультатПоискаСтроки.Вставить("НашлиВТоварах", НашлиВТоварах);
	РезультатПоискаСтроки.Вставить("НашлиВУслугах", НашлиВУслугах);
	РезультатПоискаСтроки.Вставить("НашлиВТаре", НашлиВТаре);
	РезультатПоискаСтроки.Вставить("ТабличнаяЧастьСтроки", ТабличнаяЧастьСтроки);
	
	Возврат РезультатПоискаСтроки;

КонецФункции

Функция ПоискСтрокиВТаблицеДокумента_КонтурEDI(
	ТаблицаДокумента, 
	СтрокаПоиска, 
	СуммаВключаетНДС) Экспорт
	
	НайденнаяСтрока = Неопределено;
			
	НайденныеСтроки = НайденныеСтрокиВДокументе_КонтурEDI(ТаблицаДокумента, СтрокаПоиска); 
		
	Если ПеременнаяСодержитСвойство(СтрокаПоиска, "КоличествоВНакладной") Тогда
		Суффикс = "ВНакладной";
	Иначе
		Суффикс = "1";
	КонецЕсли;

	Если СуммаВключаетНДС Тогда
		Цена = СтрокаПоиска["ЦенаСНДС" + Суффикс];	
	Иначе
		Цена = СтрокаПоиска["ЦенаБезНДС" + Суффикс];
	КонецЕсли;
	
	МаксимальныйПриоритет = 0;
	ПриоритетнаяСтрока = Неопределено;
		
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		
		ПриоритетСтроки = 0;
		
		Если НайденнаяСтрока.НеСопоставлено > 0 Тогда
			
			ПриоритетСтроки = ПриоритетСтроки + 1000;
			
		КонецЕсли;
		
		Если НайденнаяСтрока.Цена = Цена Тогда
			
			ПриоритетСтроки = ПриоритетСтроки + 100;
			
		КонецЕсли;
		
		Если НайденнаяСтрока.НеСопоставлено = СтрокаПоиска["Количество" + Суффикс] Тогда
			
			ПриоритетСтроки = ПриоритетСтроки + 10;
			
		КонецЕсли;

		Если МаксимальныйПриоритет < ПриоритетСтроки Тогда
			
			ПриоритетнаяСтрока = НайденнаяСтрока;
			
			МаксимальныйПриоритет = ПриоритетСтроки;

		КонецЕсли;
				
	КонецЦикла;
	
	Если ПриоритетнаяСтрока <> Неопределено Тогда
		
		НайденнаяСтрока = ПриоритетнаяСтрока;
		
	КонецЕсли;
	
	Если НайденнаяСтрока <> Неопределено Тогда
		
		НайденнаяСтрока.НеСопоставлено = 
		НайденнаяСтрока.НеСопоставлено - СтрокаПоиска["Количество" + Суффикс];
		
	КонецЕсли;
	
	Возврат НайденнаяСтрока;

КонецФункции

Функция НайденныеСтрокиВДокументе_КонтурEDI(ТаблицаДокумента, СтрокаСоответствий)
	
	Если ТаблицаДокумента.Колонки.Найти("ХарактеристикаНоменклатуры") <> Неопределено Тогда    		
		ИмяРеквизитаХарактеристика 	= "ХарактеристикаНоменклатуры";   	
	ИначеЕсли ТаблицаДокумента.Колонки.Найти("Характеристика") <> Неопределено Тогда 		
		ИмяРеквизитаХарактеристика 	= "Характеристика";
	Иначе    		
		ИмяРеквизитаХарактеристика 	= "";
	КонецЕсли;
	
	Если ТаблицаДокумента.Колонки.Найти("СерияНоменклатуры") <> Неопределено Тогда    		
		ИмяРеквизитаСерия 	= "СерияНоменклатуры";   	
	ИначеЕсли ТаблицаДокумента.Колонки.Найти("Серия") <> Неопределено Тогда 		
		ИмяРеквизитаСерия 	= "Серия";
	Иначе    		
		ИмяРеквизитаСерия 	= "";
	КонецЕсли;
	
	СтруктураПоиска = СтруктураПоискаСтрокиВДокументе_КонтурEDI(СтрокаСоответствий, ТаблицаДокумента, ИмяРеквизитаХарактеристика, ИмяРеквизитаСерия);
	 	
	СписокСвойств = Новый Массив;
	СписокСвойств.Добавить("Номенклатура");
	СписокСвойств.Добавить(ИмяРеквизитаХарактеристика);
	СписокСвойств.Добавить(ИмяРеквизитаСерия);
			 	
	ВариантыПоиска = ВариантыПоискаВТаблице_КонтурEDI(ТаблицаДокумента, СписокСвойств); 	  
	
	НайденныеСтроки = НайтиСтрокиВТаблицеПоВариантамПоиска(ТаблицаДокумента, СтруктураПоиска, ВариантыПоиска);
	
	Возврат НайденныеСтроки;

КонецФункции

Функция СтруктураПоискаСтрокиВДокументе_КонтурEDI(СтрокаПоиска, ТоварыДокумента, ИмяРеквизитаХарактеристика, ИмяРеквизитаСерия)
	
	СтруктураПоиска = Новый Структура;
	
	// ... номенклатура
	Если ПеременнаяСодержитСвойство(ТоварыДокумента.Колонки, "Номенклатура") Тогда
		
		СтруктураПоиска.Вставить("Номенклатура", СтрокаПоиска.Номенклатура);
		
	КонецЕсли;
	
	// ... характеристика
	Если ЗначениеЗаполнено(ИмяРеквизитаХарактеристика) 
		И ПеременнаяСодержитСвойство(ТоварыДокумента.Колонки, ИмяРеквизитаХарактеристика) Тогда
		 				
		Если ПеременнаяСодержитСвойство(СтрокаПоиска, "ХарактеристикаНоменклатуры") Тогда
			
			СтруктураПоиска.Вставить(ИмяРеквизитаХарактеристика, СтрокаПоиска.ХарактеристикаНоменклатуры); 
			
		Иначе
			
			СтруктураПоиска.Вставить(ИмяРеквизитаХарактеристика);
			
		КонецЕсли;     		
		
	КонецЕсли;
	
	// ... серия
	Если ЗначениеЗаполнено(ИмяРеквизитаСерия)
		И ПеременнаяСодержитСвойство(ТоварыДокумента.Колонки, ИмяРеквизитаСерия) Тогда
		
		Если ПеременнаяСодержитСвойство(СтрокаПоиска, "СерияНоменклатуры") Тогда
			СтруктураПоиска.Вставить(ИмяРеквизитаСерия, СтрокаПоиска.СерияНоменклатуры);
		Иначе
			СтруктураПоиска.Вставить(ИмяРеквизитаСерия);
		КонецЕсли; 		
		
	КонецЕсли;
	
	Возврат СтруктураПоиска;

КонецФункции	

//Таб - ДеревоЗначений из формы ОбработкаРасхожденийПриемки (обычной или управляемой)
//В нем содержатся строки из исходного сообщения и соответствующие им строки из документа (Реализация,Заказ).
Процедура ЗаполнитьДеревоРасхожденийДокумента(Таб, Документ, ИсточникРасхождений, Успешно, ТоварыСообщения = Неопределено, СообщениеСсылка) Экспорт

	Таб.Строки.Очистить();   	
	
	Если ИсточникРасхождений = "ОбратныйЗаказ" Тогда
		
		Параметры = Неопределено;
		ТипВходящегоСообщения = "ORDERS";
		Источник = "ОбработкаРасхожденийОбратногоЗаказа";
			
	Иначе
		
		Параметры = Новый Структура("ИсточникРасхождений", ИсточникРасхождений);
		ТипВходящегоСообщения = "RECADV";
		Источник = "ОбработкаРасхожденийПриемки";
				
	КонецЕсли;    	
	
	Сообщение = ПрочитатьСообщение(СообщениеСсылка, Документ, ТипВходящегоСообщения, "Входящее",, Параметры);
			
	Если Сообщение = Неопределено Тогда
		ВывестиПредупреждение_КонтурEDI("Не удалось прочитать сообщение!");
		Успешно = Ложь;
		Возврат;
	КонецЕсли;
	
	НастройкиСравненияRECADV = ПолучитьСписокСвойствEDI("СверятьВRECADVЦеныИСтавки
														|СверятьВRECADVКодыМаркировки
														|КодыМаркировкиВDESADV
														|КодыМаркировкиВINVOIC",
														Сообщение.Партнер); 
	ТоварыДокумента = Неопределено;														
	СверятьКодыМаркировки = Ложь;
	
	Если ИсточникРасхождений = "Приемка" 
		И НастройкиСравненияRECADV.СверятьВRECADVКодыМаркировки = Истина Тогда

		ПараметрыПодготовкиИсходящегоСообщения = ПараметрыПодготовкиСообщенияДляОбработкиПриемки(Сообщение);
		ПараметрыПодготовкиИсходящегоСообщения.Вставить("ИгнорироватьНастройкиОтправкиКодовМаркировки", Истина);
		
		ТипСообщенияСКодамиМаркировки = "DESADV";
		ДокументСКодамиМаркировки = Документ;
		
		СообщениеСКодамиМаркировки = ПолучитьСообщениеСКодамиМаркировкиДляОбработкиПриемки(Документ, НастройкиСравненияRECADV);
				
		Если ЗначениеЗаполнено(СообщениеСКодамиМаркировки) Тогда
			
			ПараметрыПодготовкиИсходящегоСообщения.Вставить("СообщениеСсылка", СообщениеСКодамиМаркировки);
			
			ТипСообщенияСКодамиМаркировки = СообщениеСКодамиМаркировки.ТипСообщения;
			ДокументСКодамиМаркировки = СообщениеСКодамиМаркировки.Документ;
			
		КонецЕсли;
		
		СообщениеДляСравнения = ПодготовитьИсходящееСообщение(ТипСообщенияСКодамиМаркировки, 
															  ДокументСКодамиМаркировки, 
															  ПараметрыПодготовкиИсходящегоСообщения);
															  
		ТоварыДокумента = СообщениеДляСравнения.Товары;
		ТоварыДокумента.Колонки.Добавить("Пометка", Новый ОписаниеТипов("Булево"));
		
		СверятьКодыМаркировки = Истина;
		
	ИначеЕсли ИсточникРасхождений = "ОбратныйЗаказ" Тогда
		
		СообщениеДляСравнения = ПодготовитьИсходящееСообщение("ORDRSP", Документ);
		ТоварыДокумента = СообщениеДляСравнения.Товары;
		
		ТоварыДокумента.Колонки.Добавить("Пометка", Новый ОписаниеТипов("Булево"));

	Иначе
		
		ТоварыДокумента	= ПолучитьТоварыДокументаДляСообщения(Документ, Истина, Источник,, Сообщение);
		
	КонецЕсли;												
	
	// ... здесь нужно перечитать
	Сообщение = ПрочитатьСообщение(СообщениеСсылка, Документ, ТипВходящегоСообщения, "Входящее",, Параметры);
	
	ТоварыСообщения = Сообщение.Товары;	
	
	МассивДенежныхПолей = МассивДенежныхПолейДляСравненияСообщений();  	
	МассивПолейДляСравнения = МассивПолейДляСравненияСообщений(НастройкиСравненияRECADV.СверятьВRECADVЦеныИСтавки,
															   СверятьКодыМаркировки); 
	
	флЕстьРасхождения = Ложь;
	
	Для Каждого Стр Из ТоварыСообщения Цикл
		
		Если Стр.НеЗагружать = Истина Тогда 
			Продолжить; 
		КонецЕсли;
		
		ЗаполнитьНедостающиеПоляСтрокиТоваров(Стр);
					
		НоваяСтрока = Таб.Строки.Добавить();
		НоваяСтрока.НомерСтроки = Стр.НомерСтроки;
		
		Для Каждого Поле Из МассивПолейДляСравнения Цикл
			НоваяСтрока[Поле + "Принято"] = Стр[Поле];
		КонецЦикла;
		
		НоваяСтрока.GTIN					= Стр.GTIN;
		НоваяСтрока.КодТовараПокупателя		= Стр.КодТовараПокупателя;
		НоваяСтрока.КодТовараПоставщика		= Стр.КодТовараПоставщика;
		НоваяСтрока.КодЕдиницыИзмеренияEDI	= Стр.КодЕдиницыИзмеренияEDI;
		
		НайденныеСтрокиРеализации = ТоварыДокумента.НайтиСтроки(Новый Структура("УИД_СтрокиПредыдущегоСообщения", Стр.УИД_СтрокиТовара));
		
		ЗаполнитьСтрокуДереваРасхожденийПоСтрокамДокумента(НоваяСтрока, Стр, НайденныеСтрокиРеализации, МассивДенежныхПолей, МассивПолейДляСравнения);
		
		Если ИсточникРасхождений = "Приемка" Тогда
			ЗаполнитьКомментарийКСтрокеРасхождений(НоваяСтрока, Стр, ТоварыСообщения);
		КонецЕсли;
		
		Если СверятьКодыМаркировки Тогда
			
			НоваяСтрока.КодыМаркировкиВНакладнойПредставление = "Количество: " + НоваяСтрока.КодыМаркировкиВНакладной.Количество();
			НоваяСтрока.КодыМаркировкиПринятоПредставление = "Количество: " + НоваяСтрока.КодыМаркировкиПринято.Количество();
			
			РезультатСравненияКодовМаркировки = СравнитьСпискиЗначений(НоваяСтрока.КодыМаркировкиВНакладной, НоваяСтрока.КодыМаркировкиПринято);
			
			Если Не РезультатСравненияКодовМаркировки.Успешно ИЛИ РезультатСравненияКодовМаркировки.ЕстьРасхождения Тогда
				НоваяСтрока.ЕстьРасхожденияВКодахМаркировки = Истина;	
			КонецЕсли;
			
		КонецЕсли;
		
		НоваяСтрока.ЕстьРасхождения = ЕстьРасхожденияВСтроках(НоваяСтрока, МассивПолейДляСравнения);
		флЕстьРасхождения = флЕстьРасхождения ИЛИ НоваяСтрока.ЕстьРасхождения;

	КонецЦикла;
	
	// Теперь пройдемся еще раз по товарам из Реализации и посмотрим, какие строки у нас не распределились по товарам из RECADV.
	// И докинем их в таблицу на форме.
	
	НераспределенныеСтроки = ТоварыДокумента.НайтиСтроки(Новый Структура("Пометка", Ложь));
	
	флЕстьРасхождения = флЕстьРасхождения ИЛИ НераспределенныеСтроки.Количество() <> 0; 
	
	Для Каждого Стр Из НераспределенныеСтроки Цикл
		
		НоваяСтрока = Таб.Строки.Добавить();  
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр, 
		"Номенклатура,ЕдиницаИзмерения,ХарактеристикаНоменклатуры,СерияНоменклатуры,GTIN,КодТовараПокупателя,КодТовараПоставщика,КодЕдиницыИзмеренияEDI");
		
		Для Каждого Поле Из МассивПолейДляСравнения Цикл
			НоваяСтрока[Поле + "ВНакладной"] = Стр[Поле];
		КонецЦикла;
		
		НоваяСтрока.ЕстьРасхождения = Истина;
		
		Если СверятьКодыМаркировки Тогда
			
			НоваяСтрока.КодыМаркировкиВНакладнойПредставление = "Количество: " + НоваяСтрока.КодыМаркировкиВНакладной.Количество();
			НоваяСтрока.КодыМаркировкиПринятоПредставление = "Количество: 0";
			
			Если НоваяСтрока.КодыМаркировкиВНакладной.Количество() > 0 Тогда
				НоваяСтрока.ЕстьРасхожденияВКодахМаркировки = Истина;	
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
			
	Если Не флЕстьРасхождения Тогда
		
		// расхождений уже нет, сразу установим нужный статус
		УстановитьСтатусДокумента(Документ, "НакладнаяПринятЧастичноОбработан", "Приемка", СообщениеСсылка);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ЕстьРасхожденияВСтроках(ПроверяемаяСтрока, МассивПолейСравнения)
	
	флЕстьРасхождения = Ложь;
	
	Для Каждого Поле Из МассивПолейСравнения Цикл
		
		ЗначениеНакладной = ПроверяемаяСтрока[Поле + "ВНакладной"];
		ЗначениеПринято = ПроверяемаяСтрока[Поле + "Принято"];
		
		Если ТипЗнч(ЗначениеНакладной) = Тип("СписокЗначений") Тогда
			
			РезультатСравнения = СравнитьСпискиЗначений(ЗначениеНакладной, ЗначениеПринято);
			Если НЕ РезультатСравнения.Успешно ИЛИ РезультатСравнения.ЕстьРасхождения Тогда
				
				флЕстьРасхождения = Истина;
				Прервать;
				
			КонецЕсли;
			
		ИначеЕсли Не ЗначениеНакладной = ЗначениеПринято Тогда
			
			флЕстьРасхождения = Истина;
			Прервать;	
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат флЕстьРасхождения;

КонецФункции

Процедура ЗаполнитьКомментарийКСтрокеРАсхождений(НоваяСтрока, Стр, ТоварыСообщения)
	
	ТекКомментарий = "";
	
	Если ТоварыСообщения.Колонки.Найти("КоличествоКВозвратуИПричина1С") <> Неопределено
		И ЗначениеЗаполнено(Стр.КоличествоКВозвратуИПричина1С) Тогда
		
		ТекКомментарий = ТекКомментарий + "К возврату: ";
		Для Каждого Строка Из Стр.КоличествоКВозвратуИПричина1С Цикл
			ТекКомментарий = ТекКомментарий + Строка.ПричинаВозврата + "-" + Строка.КоличествоКВозврату + "; ";	
		КонецЦикла;
		
	КонецЕсли;
	
	Если ТоварыСообщения.Колонки.Найти("КоличествоСверхпоставки") <> Неопределено
		И ЗначениеЗаполнено(Стр.КоличествоСверхпоставки) Тогда
		ТекКомментарий = ТекКомментарий + "Сверхпоставка: " + Стр.КоличествоСверхпоставки + "; ";	
	КонецЕсли;
	
	Если ТоварыСообщения.Колонки.Найти("КоличествоНедопоставки") <> Неопределено
		И ЗначениеЗаполнено(Стр.КоличествоНедопоставки) Тогда
		ТекКомментарий = ТекКомментарий + "Недопоставка: " + Стр.КоличествоНедопоставки + "; ";	
	КонецЕсли;
	
	ТекКомментарий = ТекКомментарий + Стр.Комментарий;
	НоваяСтрока.Комментарий = ТекКомментарий;

КонецПроцедуры

Процедура ЗаполнитьСтрокуДереваРасхожденийПоСтрокамДокумента(
	СтрокаТаблицыРасхождений, 
	СтрокаСообщения, 
	НайденныеСтрокиРеализации, 
	МассивДенежныхПолей, 
	МассивПолейДляСравнения)
	
	Если НайденныеСтрокиРеализации.Количество() = 0 Тогда
		
		Если ЗначениеЗаполнено(СтрокаСообщения.Номенклатура) Тогда
			СтрокаТаблицыРасхождений.Номенклатура = СтрокаСообщения.Номенклатура;
		Иначе
			СтрокаТаблицыРасхождений.Номенклатура = СтрокаСообщения.Наименование;
		КонецЕсли;
		
		Если ПеременнаяСодержитСвойство(СтрокаСообщения, "ХарактеристикаНоменклатуры") Тогда
			СтрокаТаблицыРасхождений.ХарактеристикаНоменклатуры = СтрокаСообщения.ХарактеристикаНоменклатуры;
		КонецЕсли;
		
		СтрокаТаблицыРасхождений.ЕдиницаИзмерения = СтрокаСообщения.ЕдиницаИзмерения;
		
		СтрокаТаблицыРасхождений.КоэффициентEDIВ1С = 1;
		
		СтрокаТаблицыРасхождений.ТекстПересчета = ТекстПересчета_КонтурEDI(
		СтрокаТаблицыРасхождений.ЕдиницаИзмерения, 
		СтрокаТаблицыРасхождений.КодЕдиницыИзмеренияEDI, 
		СтрокаТаблицыРасхождений.КоэффициентEDIВ1С);
		
	ИначеЕсли НайденныеСтрокиРеализации.Количество() = 1 Тогда
		
		СтрРеализации = НайденныеСтрокиРеализации[0];
		СтрРеализации.Пометка = Истина;
		
		Если ЗначениеЗаполнено(СтрРеализации.Номенклатура) Тогда
			СтрокаТаблицыРасхождений.Номенклатура = СтрРеализации.Номенклатура;
		Иначе
			СтрокаТаблицыРасхождений.Номенклатура = СтрРеализации.Наименование;
		КонецЕсли; 	
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицыРасхождений, СтрРеализации, 
		"ЕдиницаИзмерения,ХарактеристикаНоменклатуры,СерияНоменклатуры,КоэффициентEDIВ1С");
		
		СтрокаТаблицыРасхождений.ТекстПересчета = ТекстПересчета_КонтурEDI(
		СтрокаТаблицыРасхождений.ЕдиницаИзмерения, 
		СтрокаТаблицыРасхождений.КодЕдиницыИзмеренияEDI, 
		СтрокаТаблицыРасхождений.КоэффициентEDIВ1С);
		
		Для Каждого Поле Из МассивПолейДляСравнения Цикл
			СтрокаТаблицыРасхождений[Поле + "ВНакладной"] = СтрРеализации[Поле];
		КонецЦикла;
		
		ПриравнятьПоляВСтрокаТаблицыРасхождений_КонтурEDI(МассивДенежныхПолей, СтрокаТаблицыРасхождений);		
		
	Иначе
		// ситуация, когда одна строка из RECADV соответствует нескольким строкам из Реализации.
		// сделать отдельную ветку в дереве Таб и закинем в нее соответствующие строки Реализации.
		ОстатокКоличества = СтрокаТаблицыРасхождений.КоличествоПринято;
		
		ИтогКоличество = 0; 
		ИтогСуммаБезНДС = 0;
		ИтогСуммаСНДС = 0;  
		ИтогКодыМаркировки = Новый СписокЗначений;
		
		НоваяСтрокаРеализации = Неопределено;
		
		СверятьКодыМаркировки = Не МассивПолейДляСравнения.Найти("КодыМаркировки") = Неопределено;
		
		Для Каждого СтрРеализации Из НайденныеСтрокиРеализации Цикл
			
			СтрРеализации.Пометка = Истина;
			
			НоваяСтрокаРеализации = СтрокаТаблицыРасхождений.Строки.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрокаРеализации, СтрРеализации, 
			"Номенклатура,ЕдиницаИзмерения,ХарактеристикаНоменклатуры,СерияНоменклатуры,КоэффициентEDIВ1С");
			
			НоваяСтрокаРеализации.ТекстПересчета = ТекстПересчета_КонтурEDI(
			НоваяСтрокаРеализации.ЕдиницаИзмерения, 
			НоваяСтрокаРеализации.КодЕдиницыИзмеренияEDI, 
			НоваяСтрокаРеализации.КоэффициентEDIВ1С);    
			
			Для Каждого Поле Из МассивПолейДляСравнения Цикл
				НоваяСтрокаРеализации[Поле+"ВНакладной"]	= СтрРеализации[Поле];
			КонецЦикла;
			
			Если ОстатокКоличества > СтрРеализации.Количество Тогда
				НоваяСтрокаРеализации.КоличествоПринято = СтрРеализации.Количество;
				ОстатокКоличества = ОстатокКоличества - СтрРеализации.Количество;
			ИначеЕсли ОстатокКоличества > 0 Тогда
				НоваяСтрокаРеализации.КоличествоПринято = ОстатокКоличества;
				ОстатокКоличества = 0;
			КонецЕсли;
			
			НоваяСтрокаРеализации.ЦенаБезНДСПринято = СтрокаСообщения.ЦенаБезНДС;
			НоваяСтрокаРеализации.ЦенаСНДСПринято = СтрокаСообщения.ЦенаСНДС;
			
			НоваяСтрокаРеализации.СуммаБезНДСПринято = НоваяСтрокаРеализации.ЦенаБезНДСПринято*НоваяСтрокаРеализации.КоличествоПринято;
			НоваяСтрокаРеализации.СуммаСНДСПринято = НоваяСтрокаРеализации.ЦенаСНДСПринято*НоваяСтрокаРеализации.КоличествоПринято;
			
			ПриравнятьПоляВСтрокаТаблицыРасхождений_КонтурEDI(МассивДенежныхПолей, НоваяСтрокаРеализации);
			 			
			ИтогКоличество = ИтогКоличество + СтрРеализации.Количество; 
			ИтогСуммаБезНДС = ИтогСуммаБезНДС + СтрРеализации.СуммаБезНДС;
			ИтогСуммаСНДС = ИтогСуммаСНДС + СтрРеализации.СуммаСНДС;
			
			Если СверятьКодыМаркировки Тогда
				ИтогКодыМаркировки = ОбъединитьСпискиЗначений(ИтогКодыМаркировки, СтрРеализации.КодыМаркировки, Истина);	
			КонецЕсли;
			
		КонецЦикла;
		
		Если ОстатокКоличества <> 0 И НоваяСтрокаРеализации <> Неопределено Тогда
			
			НоваяСтрокаРеализации.КоличествоПринято = НоваяСтрокаРеализации.КоличествоПринято + ОстатокКоличества;
			
			НоваяСтрокаРеализации.СуммаБезНДСПринято = НоваяСтрокаРеализации.ЦенаБезНДСПринято*НоваяСтрокаРеализации.КоличествоПринято;
			НоваяСтрокаРеализации.СуммаСНДСПринято = НоваяСтрокаРеализации.ЦенаСНДСПринято*НоваяСтрокаРеализации.КоличествоПринято;
			
			ПриравнятьПоляВСтрокаТаблицыРасхождений_КонтурEDI(МассивДенежныхПолей, НоваяСтрокаРеализации);
			
		КонецЕсли;
		
		СтрокаТаблицыРасхождений.КоличествоВНакладной = ИтогКоличество;
		СтрокаТаблицыРасхождений.СуммаБезНДСВНакладной = ИтогСуммаБезНДС;
		СтрокаТаблицыРасхождений.СуммаСНДСВНакладной = ИтогСуммаСНДС;
		
		Если СверятьКодыМаркировки Тогда
			СтрокаТаблицыРасхождений.КодыМаркировкиВНакладной = ИтогКодыМаркировки;
		КонецЕсли;
		
		Если СтрокаТаблицыРасхождений.КоличествоВНакладной <> 0 Тогда
			
			Если СтрокаТаблицыРасхождений.ЦенаБезНДСВНакладной = 0 Тогда
				СтрокаТаблицыРасхождений.ЦенаБезНДСВНакладной = СтрокаТаблицыРасхождений.СуммаБезНДСВНакладной/СтрокаТаблицыРасхождений.КоличествоВНакладной;
			КонецЕсли;
			
			Если СтрокаТаблицыРасхождений.ЦенаСНДСВНакладной = 0 Тогда
				СтрокаТаблицыРасхождений.ЦенаСНДСВНакладной = СтрокаТаблицыРасхождений.СуммаСНДСВНакладной/СтрокаТаблицыРасхождений.КоличествоВНакладной; 
			КонецЕсли;
			
		КонецЕсли; 
		
		СтрокаТаблицыРасхождений.Номенклатура = ?(ЗначениеЗаполнено(СтрокаСообщения.Номенклатура), СтрокаСообщения.Номенклатура, СтрокаСообщения.Наименование);
		СтрокаТаблицыРасхождений.ГруппаНоменклатур = Истина;
		
	КонецЕсли;

КонецПроцедуры

Процедура ПриравнятьПоляВСтрокаТаблицыРасхождений_КонтурEDI(
	МассивДенежныхПолей, 
	СтрокаТаблицыРасхождений, 
	Суффикс1 = "ВНакладной", 
	Суффикс2 = "Принято")
	
	Если СтрокаТаблицыРасхождений["Количество" + Суффикс1] = СтрокаТаблицыРасхождений["Количество" + Суффикс2] Тогда
		
		ПриравнятьДенежныеПоляПоНеобходимости(МассивДенежныхПолей, СтрокаТаблицыРасхождений, Суффикс1, Суффикс2);
		
	Иначе
		
		Если ПеременнаяСодержитСвойство(СтрокаТаблицыРасхождений, "СуммаБезНДС" + Суффикс2) 
			И НЕ ЗначениеЗаполнено(СтрокаТаблицыРасхождений["СуммаБезНДС" + Суффикс2]) Тогда
			
			СтрокаТаблицыРасхождений["СуммаБезНДС" + Суффикс2] = 
			СтрокаТаблицыРасхождений["ЦенаБезНДС" + Суффикс2]*СтрокаТаблицыРасхождений["Количество" + Суффикс2];
			 			
		КонецЕсли;
		
		Если ПеременнаяСодержитСвойство(СтрокаТаблицыРасхождений, "СуммаСНДС" + Суффикс2) 
			И НЕ ЗначениеЗаполнено(СтрокаТаблицыРасхождений["СуммаСНДС" + Суффикс2]) Тогда
			
			СтрокаТаблицыРасхождений["СуммаСНДС" + Суффикс2] = 
			СтрокаТаблицыРасхождений["ЦенаСНДС" + Суффикс2]*СтрокаТаблицыРасхождений["Количество" + Суффикс2];
			
		КонецЕсли;
		
		МассивПолей_Цены = Новый Массив;
		МассивПолей_Суммы = Новый Массив;
		
		Для Каждого Поле Из МассивДенежныхПолей Цикл
			
			Если Найти(Поле, "Цена") <> 0 Тогда
				МассивПолей_Цены.Добавить(Поле);
			ИначеЕсли Найти(Поле, "Сумма") <> 0 Тогда
				МассивПолей_Суммы.Добавить(Поле);
			КонецЕсли;
			
		КонецЦикла;
		
		ПриравнятьДенежныеПоляПоНеобходимости(МассивПолей_Цены, СтрокаТаблицыРасхождений, Суффикс1, Суффикс2);
		ПриравнятьДенежныеПоляПоНеобходимости(МассивПолей_Суммы, СтрокаТаблицыРасхождений, Суффикс1, Суффикс2);
		
	КонецЕсли;

КонецПроцедуры

Функция МассивПолейДляСравненияСообщений(СверятьЦены, СверятьКодыМаркировки)
	
	МассивПолей = Новый Массив;
	МассивПолей.Добавить("Количество");
	
	Если СверятьЦены = Истина Тогда  
		
		МассивПолей.Добавить("ЦенаБезНДС");
		МассивПолей.Добавить("ЦенаСНДС");
		МассивПолей.Добавить("СуммаБезНДС");
		МассивПолей.Добавить("СуммаСНДС"); 
		
	КонецЕсли;
	
	Если СверятьКодыМаркировки = Истина Тогда
		
		МассивПолей.Добавить("КодыМаркировки");
		
	КонецЕсли;
	
	Возврат МассивПолей;

КонецФункции

Функция МассивДенежныхПолейДляСравненияСообщений()
	
	МассивДенежныхПолей = Новый Массив;
	МассивДенежныхПолей.Добавить("ЦенаБезНДС");
	МассивДенежныхПолей.Добавить("ЦенаСНДС");
	МассивДенежныхПолей.Добавить("СуммаБезНДС");
	МассивДенежныхПолей.Добавить("СуммаСНДС");
		
	Возврат МассивДенежныхПолей;

КонецФункции

