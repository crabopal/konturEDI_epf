		ПараметрыУчетнойПолитики = ОбщийМодуль_ОбщегоНазначенияДУМ.ПолучитьПараметрыУчетнойПолитики(Документ.Дата, Документ.Организация, Документ.Склад);
		
		ЗаполнитьЗначенияСвойств(Документ, ПараметрыУчетнойПолитики);
		
