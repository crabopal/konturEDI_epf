			ДобавитьОписаниеПоля(ТабОписания,"КатегорииТовара",						ИмяДокумента+".productsCategory");
			ДобавитьОписаниеПоля(ТабОписания,"ОсобыеУказания",						ИмяДокумента+".specialInstructions");
		КонецЕсли;
		
		//врата		
		Если СтрСодержит_КонтурEDI("ORDERS,ORDRSP,DESADV", ТипСообщения) Тогда
			ДобавитьОписаниеПоля(ТабОписания,"Транспортировка", 		ИмяДокумента+".deliveryInfo.transportation",	"Транспортировка",		истина);
		КонецЕсли;
			
		Если СтрСодержит_КонтурEDI("ORDERS,ORDRSP", ТипСообщения) Тогда
