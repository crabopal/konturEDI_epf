// ОБРАБОТЧИКИ ДЕЙСТВИЙ ФОРМ

Процедура ДействиеФормыНачалоВыбора(ИмяФормы,ВсеЭлементыФормы,Элемент,ИмяПоля,СтандартнаяОбработка) Экспорт
	
	Если ИмяФормы = "ФормаИсходящегоДокумента"  Тогда
		Если ИмяПоля = "ЕдиницаИзмерения" ИЛИ ИмяПоля = "ХарактеристикаНоменклатуры" Тогда
			
			ТекущиеДанные = ВсеЭлементыФормы.Товары.ТекущиеДанные;
			
			Если НЕ ТекущиеДанные = Неопределено Тогда
				
				Если ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
				
					Элемент.ВыборПоВладельцу = ТекущиеДанные.Номенклатура;
					
				Иначе
					
					ВывестиПредупреждение_КонтурEDI("Не выбрана номенклатура!");
					
					СтандартнаяОбработка = Ложь;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
	ИначеЕсли ИмяФормы = "ФормаСопоставленияНоменклатуры" Тогда
		Если ИмяПоля = "ЕдиницаИзмерения" ИЛИ ИмяПоля = "ХарактеристикаНоменклатуры" Тогда
			
			ТекущиеДанные = ВсеЭлементыФормы.СписокНоменклатуры.ТекущиеДанные;
			
			Если НЕ ТекущиеДанные = Неопределено Тогда
				
				Если ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
					
					ПараметрыВыбора = Новый Структура;
					ПараметрыВыбора.Вставить("Номенклатура",            ТекущиеДанные.Номенклатура);
					ПараметрыВыбора.Вставить("Отбор",                   Новый Структура("Владелец", ТекущиеДанные.Номенклатура));
					ПараметрыВыбора.Вставить("ДобавлятьПустуюУпаковку", Истина); 
					ПараметрыВыбора.Вставить("ВыборГруппИЭлементов",    ИспользованиеГруппИЭлементов.Элементы);
					
					ПараметрыПМ = Новый Структура;
					ПараметрыПМ.Вставить("Номенклатура", ТекущиеДанные.Номенклатура);
					ПараметрыПМ.Вставить("ПараметрыВыбора", ПараметрыВыбора);
					
					СтандартнаяОбработкаEDI = Истина;
					РезультатПМ = ОбработкаСобытияПодключаемогоМодуля("ЗаполнитьСписокЕдиницИзмерения", СтандартнаяОбработкаEDI, ПараметрыПМ);
					
					Если СтандартнаяОбработкаEDI = Ложь
						И ЗначениеЗаполнено(РезультатПМ)
						И ТипЗнч(РезультатПМ) = Тип("СписокЗначений") Тогда
						
						Элемент.СписокВыбора = РезультатПМ;
						СтандартнаяОбработка = Ложь;
						
					КонецЕсли;
					
					Если СтандартнаяОбработкаEDI Тогда
						
						Элемент.ВыборПоВладельцу = ТекущиеДанные.Номенклатура;
						
					КонецЕсли;
					
				Иначе
					
					ВывестиПредупреждение_КонтурEDI("Не выбрана номенклатура!");
					
					СтандартнаяОбработка = Ложь;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция СоставитьСписокВыбораПоСтрокеТоваров(GTIN, КодТовараСторонний, Отправитель1С, Направление = "Исходящее", ПараметрыПоискаСоответствий = Неопределено) Экспорт
	
	СоответствиеТоваров = СоответствиеТоваров_НайтиНоменклатуру(GTIN, КодТовараСторонний, Отправитель1С);
	
	СписокВыбора = Новый СписокЗначений;
	
	Для Каждого Стр Из СоответствиеТоваров Цикл
		
		ДобавитьТоварВСписокВыбора(СписокВыбора,
								   Стр.Номенклатура,
								   Стр.ХарактеристикаНоменклатуры,
								   Стр.ЕдиницаИзмерения,
								   Стр.ЕдиницаEDI,
								   Стр.КоэффициентEDIВ1С,
								   Стр.ТипЕдиницы);
		
	КонецЦикла;
			
	Если Не Направление = "Исходящее" 
		И Не ЗначениеЗаполнено(ПараметрыПоискаСоответствий.Номенклатура) 
		И СписокВыбора.Количество() = 0
	Тогда
	
		ДобавитьТоварВСписокВыбора(СписокВыбора, 
								   ПараметрыПоискаСоответствий.Наименование, 
								   "", 
								   "", 
								   ПараметрыПоискаСоответствий.КодЕдиницыИзмеренияEDI, 
								   "", 
								   "", 
								   "СоздатьНовинку");
	КонецЕсли;
	
	СписокВыбора.Добавить("Настроить соответствие товаров",,,);
	
	Возврат СписокВыбора;
	
КонецФункции 

Процедура ДобавитьТоварВСписокВыбора(СписокВыбора, Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения, ЕдиницаEDI, КоэффициентEDIВ1С, ТипЕдиницы, Действие = "ПодставитьСоответствие")
	
	СтруктураТовара = Новый Структура();
	
	СтруктураТовара.Вставить("Номенклатура",				Номенклатура);
	СтруктураТовара.Вставить("ХарактеристикаНоменклатуры",	ХарактеристикаНоменклатуры);
	СтруктураТовара.Вставить("ЕдиницаИзмерения",			ЕдиницаИзмерения);
	СтруктураТовара.Вставить("КодЕдиницыИзмеренияEDI",		ЕдиницаEDI);
	СтруктураТовара.Вставить("КоэффициентEDIВ1С",			КоэффициентEDIВ1С);
	СтруктураТовара.Вставить("ТипЕдиницы",					ТипЕдиницы);
	СтруктураТовара.Вставить("Действие",					Действие);
	
	Представление = СокрЛП(Номенклатура);
	Если ЗначениеЗаполнено(ХарактеристикаНоменклатуры) Тогда
		Представление = Представление+", "+СокрЛП(ХарактеристикаНоменклатуры);
	КонецЕсли;
	Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
		Представление = Представление + ", " + СокрЛП(ЕдиницаИзмерения);
	КонецЕсли;
	Если ЗначениеЗаполнено(ЕдиницаEDI) Тогда
		Представление = Представление + ", " + СокрЛП(ЕдиницаEDI);
	КонецЕсли;
	Если ЗначениеЗаполнено(КоэффициентEDIВ1С) Тогда
		Представление = Представление + ", коэф. " + СокрЛП(КоэффициентEDIВ1С);
	КонецЕсли;
	
	Если Действие = "СоздатьСоответствие" Тогда
		Представление = "Создать соответствие: " + Представление;
	ИначеЕсли Действие = "СоздатьНовинку"  Тогда
		Представление = "Создать новую номенклатуру: " + Представление;
	КонецЕсли;
	
	СписокВыбора.Добавить(СтруктураТовара,Представление); 

КонецПроцедуры
