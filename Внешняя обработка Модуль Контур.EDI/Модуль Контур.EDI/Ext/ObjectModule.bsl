// Метод для получения всех событий в ящике.
// В случае HTTP ответа отличного от "200", выбрасывает исключение.
//
// Параметры:
//   ДанныеАвторизацииEDI - Структура - см. метод КонтурEDIAPI_НовыйДанныеАвторизации.	
//   boxId - Строка - Идентификатор ящика
//	 exclusiveEventId - Строка - Указатель на последнее обработанное событие 
//   fromDateTime - Дата - момент времени с которого нужно получить события
//	 count - Число - Количество события в ответе метода
//
// Возвращаемое значение:
//   Структура - См. свойства в методе КонтурEDIAPI_Схема_MessageBoxEventBatch 
//
Функция КонтурEDIAPI_СобытияЯщика(Знач ДанныеАвторизацииEDI, boxId, exclusiveEventId = Неопределено, fromDateTime = Неопределено, count = 100, ОтветВЛокальныхИменах = Ложь) Экспорт

	КонтурEDIAPI_УстановитьТокенДляЗапроса(ДанныеАвторизацииEDI);
	
	МенеджерНастроек = КонтурEDIAPI_МенеджерНастроек();
	
	Если ЗначениеЗаполнено(exclusiveEventId) Тогда         
		
		ПараметрыСервиса =  КонтурEDIAPI_GetEvents();
		ПараметрыСервиса.Параметры.exclusiveEventId = exclusiveEventId;
		
	ИначеЕсли ЗначениеЗаполнено(fromDateTime) Тогда
		
		ПараметрыСервиса =  КонтурEDIAPI_GetEventsFrom();
		ПараметрыСервиса.Параметры.fromDateTime = КонтурEDIAPI_ДатаВФормате_ISO8601(fromDateTime);
		
	Иначе 
		
		ВызватьИсключение "Не указан один из параметров запроса";
		
	КонецЕсли;

	ПараметрыСервиса.Параметры.boxId = boxId;
	ПараметрыСервиса.Параметры.count = count;
	
	Ответ = КонтурEDIAPI_Get(ДанныеАвторизацииEDI, ПараметрыСервиса.URL, ПараметрыСервиса.Параметры, , МенеджерНастроек.Сессия);
	
	ПодготовленныйОтветКлиента = КонтурEDIAPI_ОбработатьРезультатHTTPЗапроса(ПараметрыСервиса, Ответ);	
	
	Возврат КонтурEDIAPI_Привести("MessageBoxEventBatch", ПодготовленныйОтветКлиента.Результат, ОтветВЛокальныхИменах); 
	
КонецФункции

