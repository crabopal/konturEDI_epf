			ДобавитьОписаниеПоля(ТабОписания,"НомерНакладной",		ИмяДокумента+".despatchIdentificator.number");
			ДобавитьОписаниеПоля(ТабОписания,"ДатаНакладной",		ИмяДокумента+".despatchIdentificator.date");
		КонецЕсли;
		
