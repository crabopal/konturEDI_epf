Процедура ПроверкаНовойВерсии_ОбновитьТиповоеРасширениеКодыМаркировки()
	
	ИдентификаторыРасширений = Новый Массив;
	ИдентификаторыРасширений.Добавить("ControlIdentificationMarks");
	ИдентификаторыРасширений.Добавить("ControlIdentificationMarks_standard_filling");
	ИдентификаторыРасширений.Добавить("ControlIdentificationMarks_COINVOIC");
	
	РезультатОбновления = ОбновитьРасширенияПоИдентификаторам(ИдентификаторыРасширений);
	
	ЕстьНеОбновленные = Ложь;
	
	Для Каждого ОбновлениеРасширения Из РезультатОбновления Цикл
		
		Если ОбновлениеРасширения.Значение.ЕстьВБазе И НЕ ОбновлениеРасширения.Значение.Обновлен Тогда
			
			ЕстьНеОбновленные = Истина;
			
			Сообщить(
			ОбновлениеРасширения.Ключ + ". 
			|Неудачная попытка обновления расширения.
			|" + ОбновлениеРасширения.Значение.Описание, 
			СтатусСообщения.Внимание);
			
